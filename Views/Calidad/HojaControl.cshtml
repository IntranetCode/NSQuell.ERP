@model ERP.NSQuell.Models.ViewModels.CalidadHCCPlantillaViewModel
@{
    Layout = "_Layout";
    ViewData["Title"] = $"HCC {Model.NumeroParte}";
}
<link rel="stylesheet" href="~/css/calidad-hcc-v2.css" asp-append-version="true" />
<div class="hcc-page">
    <section class="hcc-document-head">
        <div class="hcc-doc-brand"><span class="hcc-doc-logo">NS</span><div><small>HOJA DE CONTROL DE CALIDAD</small><h1>@(string.IsNullOrWhiteSpace(Model.CodigoFormato) ? "GQ-F-CA01" : Model.CodigoFormato)</h1></div></div>
        <div class="hcc-doc-version"><small>Versión</small><strong>@(string.IsNullOrWhiteSpace(Model.VersionFormato) ? "—" : Model.VersionFormato)</strong><span>@(Model.FechaModificacionFormato?.ToString("dd/MM/yyyy") ?? "Sin fecha")</span></div>
    </section>
    <div class="hcc-doc-actions"><a class="hcc-btn hcc-btn-light" asp-action="HojasControl"><i class="fa-solid fa-arrow-left"></i> Bandeja operativa</a><a class="hcc-btn hcc-btn-light" asp-action="HCCPlantillas"><i class="fa-solid fa-book-open"></i> Biblioteca</a></div>

    <section class="hcc-tech-grid">
        <div><small>Cliente</small><strong>@Model.Cliente</strong></div><div><small>No. de dibujo</small><strong>@Model.NumeroDibujo</strong></div><div><small>Proceso</small><strong>@Model.Proceso</strong></div>
        <div><small>No. de parte</small><strong>@Model.NumeroParte</strong></div><div><small>No. HCC</small><strong>@Model.NumeroHCC</strong></div><div><small>Referencia plan de control</small><strong>@Model.ReferenciaPlanControl</strong></div>
        <div><small>Descripción</small><strong>@(string.IsNullOrWhiteSpace(Model.Descripcion) ? Model.Designacion : Model.Descripcion)</strong></div><div><small>Código de resina</small><strong>@Model.CodigoResina</strong></div><div><small>Materia prima</small><strong>@Model.MateriaPrima</strong></div>
        <div><small>Tiempo de secado</small><strong>@Model.TiempoSecadoTexto</strong></div><div><small>Cavidades/posiciones detectadas</small><strong>@(Model.CavidadesDisponibles.Any() ? string.Join(", ", Model.CavidadesDisponibles) : (Model.CavidadesDeclaradas?.ToString() ?? "—"))</strong></div><div><small>Nomenclatura</small><strong>✓ Aceptado · X Rechazado · NA No aplica</strong></div>
    </section>

    <section class="hcc-section-head"><div><span class="hcc-section-kicker">CARACTERÍSTICAS A VERIFICAR</span><h2>Dimensiones, criterios e instrumentos</h2></div><span class="hcc-count">@Model.Caracteristicas.Count características</span></section>
    <div class="hcc-character-list">
        @foreach (var c in Model.Caracteristicas)
        {
            <article class="hcc-character-card">
                <div class="hcc-character-number">@c.Orden</div>
                <div class="hcc-character-main"><div class="hcc-character-top"><span class="hcc-type">@c.TipoCaracteristica</span><h3>@c.Nombre</h3></div><p>@c.EspecificacionTexto</p><div class="hcc-spec-row"><span><small>Especificación</small><strong>@c.RangoTexto</strong></span><span><small>Instrumento / Gauge</small><strong>@(string.IsNullOrWhiteSpace(c.Instrumento) ? "Visual / según formato" : c.Instrumento)</strong></span><span><small>Cavidad / posición</small><strong>@(c.Cavidades.Any() ? string.Join(", ", c.Cavidades) : "Configuración de máquina")</strong></span></div></div>
            </article>
        }
    </div>

    <section class="hcc-section-head"><div><span class="hcc-section-kicker">CHECKLIST</span><h2>Verificaciones complementarias</h2></div></section>
    <div class="hcc-check-preview">@foreach(var k in Model.Checklist){<div><span>@k.Orden</span><strong>@k.Descripcion</strong><em>OK / NOK@(k.PermiteNA ? " / NA" : "")</em></div>}</div>

    <div class="hcc-source-note"><i class="fa-solid fa-database"></i><div><strong>Fuente técnica importada</strong><span>@Model.ArchivoOrigen · hoja @Model.HojaOrigen</span></div></div>
</div>
