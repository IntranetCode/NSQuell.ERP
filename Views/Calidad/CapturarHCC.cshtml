@model ERP.NSQuell.Models.ViewModels.CalidadHCCCapturaViewModel
@{ViewData["Title"]="Captura HCC"; var p=Model.Plantilla!;}
<div class="container-fluid py-4"><h1 class="h3 fw-bold">Captura HCC · @p.NumeroParte</h1><p class="text-secondary">@p.Designacion · @p.VersionFormato · @p.NumeroHCC</p>
<form asp-action="GuardarHCC" method="post">@Html.AntiForgeryToken()<input asp-for="PlantillaHCCID" type="hidden"/><input asp-for="ParteID" type="hidden"/><input asp-for="InspeccionID" type="hidden"/>
<div asp-validation-summary="All" class="text-danger"></div><div class="card card-body mb-3"><div class="row g-3"><div class="col-md-2"><label class="form-label">Fecha</label><input asp-for="Fecha" type="date" class="form-control"/></div><div class="col-md-2"><label class="form-label">Turno</label><input asp-for="Turno" class="form-control"/></div><div class="col-md-2"><label class="form-label">Hora</label><input asp-for="Hora" type="time" class="form-control"/></div><div class="col-md-2"><label class="form-label">Evento</label><select asp-for="TipoEvento" class="form-select"><option value="L">Liberación (L)</option><option value="M">Monitoreo (M)</option><option value="RL">Reliberación (RL)</option></select></div><div class="col-md-4"><label class="form-label">OF</label><input asp-for="OrdenFabricacion" class="form-control"/></div><div class="col-md-4"><label class="form-label">Máquina</label><input asp-for="MaquinaTexto" class="form-control"/></div><div class="col-md-4"><label class="form-label">Operador</label><input asp-for="OperadorTexto" class="form-control"/></div><div class="col-md-4"><label class="form-label">Auditor</label><input asp-for="AuditorTexto" class="form-control"/></div></div></div>
<div class="card mb-3"><div class="card-header fw-bold">Mediciones por tiro y cavidad</div><div class="table-responsive"><table class="table table-sm align-middle"><thead><tr><th>Característica</th><th>Tiro</th><th>Cavidad</th><th>Valor numérico</th><th>Valor / atributo</th><th>Resultado</th></tr></thead><tbody>@for(int i=0;i<Model.Mediciones.Count;i++){var m=Model.Mediciones[i];var c=p.Caracteristicas.First(x=>x.CaracteristicaHCCID==m.CaracteristicaHCCID);<tr><td>@c.Nombre<input asp-for="Mediciones[i].CaracteristicaHCCID" type="hidden"/></td><td>@m.NumeroTiro<input asp-for="Mediciones[i].NumeroTiro" type="hidden"/></td><td>@m.NumeroCavidad<input asp-for="Mediciones[i].NumeroCavidad" type="hidden"/></td><td><input asp-for="Mediciones[i].ValorNumerico" class="form-control form-control-sm"/></td><td><input asp-for="Mediciones[i].ValorTexto" class="form-control form-control-sm"/></td><td><select asp-for="Mediciones[i].Resultado" class="form-select form-select-sm"><option>OK</option><option>NOK</option><option>NA</option></select></td></tr>}</tbody></table></div></div>
<div class="card mb-3"><div class="card-header fw-bold">Checklist</div><div class="table-responsive"><table class="table table-sm"><tbody>@for(int i=0;i<Model.Checklist.Count;i++){var x=Model.Checklist[i];var def=p.Checklist.First(c=>c.ChecklistHCCID==x.ChecklistHCCID);<tr><td>@def.Descripcion<input asp-for="Checklist[i].ChecklistHCCID" type="hidden"/></td><td style="width:180px"><select asp-for="Checklist[i].Resultado" class="form-select"><option>OK</option><option>NOK</option><option>NA</option></select></td></tr>}</tbody></table></div></div>
<div class="card card-body mb-3"><label class="form-label">Observaciones / defecto encontrado / solución</label><textarea asp-for="Observaciones" rows="4" class="form-control"></textarea></div><div class="d-flex justify-content-end gap-2"><a asp-action="HojaControl" asp-route-id="@Model.PlantillaHCCID" asp-route-parteId="@Model.ParteID" class="btn btn-outline-secondary">Cancelar</a><button class="btn btn-primary" type="submit">Guardar HCC</button></div></form></div>
