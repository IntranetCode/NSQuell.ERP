        color: #ea580c;
    }

    .quality-area-btn.history .quality-area-icon {
        background: #e5e7eb;
        color: #475569;
    }

    html[data-nsq-theme="dark"] .quality-index-page {
        --quality-text: #e5e7eb;
        --quality-muted: #94a3b8;
        --quality-border: rgba(255, 255, 255, .10);
