<script>
    document.addEventListener('DOMContentLoaded', function () {
        const form = document.querySelector('[data-quality-scan-form]');
        const input = form?.querySelector('[data-quality-scan-input]');
        const submit = form?.querySelector('[data-quality-scan-submit]');
        if (!form || !input) return;
        input.focus();
        input.select();
        form.addEventListener('submit', function (event) {
            if (!input.value.trim()) {
                event.preventDefault();
                input.focus();
                return;
            }
            if (submit) {
                submit.disabled = true;
                submit.innerHTML = '<i class="fa-solid fa-spinner fa-spin"></i> Recibiendo...';
            }
        });
    });
</script>

