        border-color: rgba(255, 255, 255, .10);
    }

    html[data-nsq-theme="dark"] .quality-hero-side,
    html[data-nsq-theme="dark"] .quality-list-header,
    html[data-nsq-theme="dark"] .quality-table th {
        background: #0e1828;
        border-color: rgba(255, 255, 255, .08);
    }

        html[data-nsq-theme="dark"] .quality-hero h1,
        html[data-nsq-theme="dark"] .quality-hero-side strong,
        html[data-nsq-theme="dark"] .quality-summary-content strong,
        html[data-nsq-theme="dark"] .quality-list-header h2,
        html[data-nsq-theme="dark"] .quality-primary-text,
        html[data-nsq-theme="dark"] .quality-empty h3 {
            color: #f8fafc;
        }

    html[data-nsq-theme="dark"] .quality-search-input,
    html[data-nsq-theme="dark"] .quality-filter-select {
        background: #0b1422;
        color: #f8fafc;
        border-color: rgba(255, 255, 255, .13);
    }

    html[data-nsq-theme="dark"] .quality-table td {
        color: #cbd5e1;
        border-bottom-color: rgba(255, 255, 255, .08);
    }

    html[data-nsq-theme="dark"] .quality-table tbody tr:hover {
        background: rgba(249, 115, 22, .08);
    }

    html[data-nsq-theme="dark"] .quality-btn-light {
        background: #0e1828;
        color: #e2e8f0;
        border-color: rgba(255, 255, 255, .12);
    }

    html[data-nsq-theme="dark"] .quality-result-count,
    html[data-nsq-theme="dark"] .quality-program-badge {
        background: #0e1828;
        color: #cbd5e1;
        border-color: rgba(255, 255, 255, .10);
    }


    html[data-nsq-theme="dark"] .quality-area-btn {
        background: #111c2d;
        border-color: rgba(255, 255, 255, .10);
        color: #e5e7eb;
    }

