        border-color: #fecaca;
    }

    .quality-status-info {
        background: #eaf5ff;
        color: #075985;
        border-color: #bae6fd;
    }

    .quality-status-success {
        background: #eafbf1;
        color: #166534;
        border-color: #bbf7d0;
    }

    .quality-status-dark {
        background: #e5e7eb;
        color: #1f2937;
        border-color: #cbd5e1;
    }

    .quality-status-neutral {
        background: #f1f5f9;
        color: #475569;
        border-color: #dbe3ec;
    }

    .quality-invalidated {
        display: inline-flex;
        align-items: center;
        gap: 5px;
        margin-top: 7px;
        color: #b91c1c;
        font-size: .7rem;
        font-weight: 800;
    }

    .quality-empty {
