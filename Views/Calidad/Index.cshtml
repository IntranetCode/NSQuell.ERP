        width: 64px;
        height: 64px;
        display: grid;
        place-items: center;
        margin: 0 auto 15px;
        border-radius: 18px;
        background: #fff1e6;
        color: var(--quality-orange);
        font-size: 27px;
    }

    .quality-empty h3 {
        margin: 0;
        color: var(--quality-navy);
        font-size: 1.08rem;
        font-weight: 850;
    }

    .quality-empty p {
        max-width: 560px;
        margin: 8px auto 0;
        line-height: 1.55;
    }


    .quality-area-nav {
        display: grid;
        grid-template-columns: repeat(5, minmax(0, 1fr));
        gap: 12px;
        margin-bottom: 20px;
    }

    .quality-area-btn {
        position: relative;
        min-height: 92px;
        display: grid;
        grid-template-columns: 44px minmax(0, 1fr) auto;
        align-items: center;
        gap: 11px;
        padding: 14px;
        border: 1px solid var(--quality-border);
        border-radius: 15px;
        background: var(--quality-card);
        color: var(--quality-text);
        text-decoration: none;
        box-shadow: 0 6px 18px rgba(15, 23, 42, .045);
