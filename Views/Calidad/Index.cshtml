        padding: 0 7px;
        border-radius: 999px;
        background: #f8fafc;
        color: #334155;
        font-size: .76rem;
        font-weight: 900;
    }

    .quality-area-btn.pending .quality-area-icon {
        background: #fff7dc;
        color: #b45309;
    }

    .quality-area-btn.process .quality-area-icon {
        background: #eaf5ff;
        color: #0369a1;
    }

    .quality-area-btn.boxes .quality-area-icon {
        background: #f3e8ff;
        color: #7e22ce;
    }

    .quality-area-btn.gp12 .quality-area-icon {
