    }

    html[data-nsq-theme="dark"] .quality-hero,
    html[data-nsq-theme="dark"] .quality-summary-card,
    html[data-nsq-theme="dark"] .quality-toolbar,
    html[data-nsq-theme="dark"] .quality-list-card {
