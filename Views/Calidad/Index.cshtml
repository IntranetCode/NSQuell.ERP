@model ERP.NSQuell.Models.ViewModels.CalidadIndexViewModel
@using ERP.NSQuell.Models

@{
    ViewData["Title"] = "Bandeja de Calidad";

    var estadoFiltro = (Model.EstadoFiltro ?? string.Empty)
        .Trim()
        .ToUpperInvariant();

    string Mostrar(string? valor)
    {
        return string.IsNullOrWhiteSpace(valor)
            ? "—"
            : valor.Trim();
    }

    string EstadoTexto(string? estado)
    {
        estado = (estado ?? string.Empty)
            .Trim()
            .ToUpperInvariant();

        return estado switch
        {
            CalidadEstados.PendientePrearranque =>
                "Pendiente de prearranque",

            CalidadEstados.DevueltoPrearranque =>
                "Devuelto a Producción",

            CalidadEstados.ArranqueAutorizado =>
                "Arranque autorizado",

            CalidadEstados.PendientePrimerasPiezas =>
                "Primeras piezas",

            CalidadEstados.AjustesSolicitados =>
                "Ajustes solicitados",

            CalidadEstados.ProduccionLiberada =>
                "Producción liberada",

            CalidadEstados.MonitoreoActivo =>
                "Monitoreo horario activo",

            CalidadEstados.PendienteLiberacionCaja =>
                "Pendiente de liberación de caja",

            CalidadEstados.PendienteReliberacion =>
                "Pendiente de reliberación",

            CalidadEstados.PendienteGP12 =>
                "Pendiente de GP12",

            CalidadEstados.EnGP12 =>
                "En GP12",

            CalidadEstados.MaterialLiberado =>
                "Material liberado",

            CalidadEstados.MaterialNoConforme =>
                "Material no conforme",

            CalidadEstados.Cerrada =>
                "Cerrada",

            CalidadEstados.LegacyAbierta =>
                "Registro anterior abierto",

            CalidadEstados.LegacyLiberada =>
                "Registro anterior liberado",

            CalidadEstados.LegacyGPI2 =>
                "Registro anterior GPI2",

            CalidadEstados.LegacyContencion =>
                "Registro anterior en contención",

            CalidadEstados.LegacyScrap =>
                "Registro anterior marcado como scrap",

            CalidadEstados.LegacyDetenida =>
                "Registro anterior detenido",

            _ => string.IsNullOrWhiteSpace(estado)
                ? "Sin estado"
                : estado.Replace("_", " ")
        };
    }

    string EstadoClase(string? estado)
    {
        estado = (estado ?? string.Empty)
            .Trim()
            .ToUpperInvariant();

        return estado switch
        {
            CalidadEstados.PendientePrearranque =>
                "quality-status-warning",

            CalidadEstados.DevueltoPrearranque =>
                "quality-status-danger",

            CalidadEstados.ArranqueAutorizado =>
                "quality-status-info",

            CalidadEstados.PendientePrimerasPiezas =>
                "quality-status-info",

            CalidadEstados.AjustesSolicitados =>
                "quality-status-danger",

            CalidadEstados.ProduccionLiberada =>
                "quality-status-success",

            CalidadEstados.MonitoreoActivo =>
                "quality-status-info",

            CalidadEstados.PendienteLiberacionCaja =>
                "quality-status-warning",

            CalidadEstados.PendienteReliberacion =>
                "quality-status-danger",

            CalidadEstados.MaterialLiberado =>
                "quality-status-success",

            CalidadEstados.PendienteGP12 =>
                "quality-status-warning",

            CalidadEstados.EnGP12 =>
                "quality-status-warning",

            CalidadEstados.MaterialNoConforme =>
                "quality-status-danger",

            CalidadEstados.Cerrada =>
                "quality-status-dark",

            CalidadEstados.LegacyLiberada =>
                "quality-status-success",

            CalidadEstados.LegacyScrap =>
                "quality-status-danger",

            _ => "quality-status-neutral"
        };
    }

    string EstadoIcono(string? estado)
    {
        estado = (estado ?? string.Empty)
            .Trim()
            .ToUpperInvariant();

        return estado switch
        {
            CalidadEstados.PendientePrearranque =>
                "fa-hourglass-start",

            CalidadEstados.DevueltoPrearranque =>
                "fa-rotate-left",

            CalidadEstados.ArranqueAutorizado =>
                "fa-power-off",

            CalidadEstados.PendientePrimerasPiezas =>
                "fa-vial-circle-check",

            CalidadEstados.AjustesSolicitados =>
                "fa-screwdriver-wrench",

            CalidadEstados.ProduccionLiberada =>
                "fa-circle-check",

            CalidadEstados.MonitoreoActivo =>
                "fa-clock",

            CalidadEstados.PendienteLiberacionCaja =>
                "fa-box",

            CalidadEstados.PendienteReliberacion =>
                "fa-rotate",

            CalidadEstados.PendienteGP12 =>
                "fa-magnifying-glass-plus",

            CalidadEstados.EnGP12 =>
                "fa-microscope",

            CalidadEstados.MaterialLiberado =>
                "fa-box-open",

            CalidadEstados.MaterialNoConforme =>
                "fa-ban",

            CalidadEstados.Cerrada =>
                "fa-lock",

            _ => "fa-circle-info"
        };
    }

    string TarjetaActiva(params string[] estados)
    {
        return estados.Contains(
            estadoFiltro,
            StringComparer.OrdinalIgnoreCase
        )
            ? "is-active"
            : string.Empty;
    }

    var totalPrimerasPiezas =
        Model.TotalPendientePrimerasPiezas +
        Model.TotalAjustesSolicitados;

    var totalGP12 =
        Model.TotalPendienteGP12 +
        Model.TotalEnGP12;

    var grupoCalidad = (ViewBag.GrupoCalidad as string ?? "PENDIENTES")
        .Trim()
        .ToUpperInvariant();

    var totalPendientes =
        Model.TotalPendientePrearranque +
        Model.TotalDevueltoPrearranque +
        Model.TotalPendientePrimerasPiezas +
        Model.TotalAjustesSolicitados +
        Model.TotalPendienteReliberacion;

    var totalProceso =
        Model.TotalArranqueAutorizado +
        Model.TotalProduccionLiberada +
        Model.TotalMonitoreoActivo;
}

<style>
    .quality-index-page {
        --quality-orange: #f97316;
        --quality-orange-dark: #c2410c;
        --quality-navy: #14213d;
        --quality-text: #1e293b;
        --quality-muted: #64748b;
        --quality-border: #dfe5ec;
        --quality-card: #ffffff;
        --quality-background: #f4f6f8;
        min-height: calc(100vh - 80px);
        padding: 25px 12px 55px;
        color: var(--quality-text);
    }

    .quality-index-shell {
        max-width: 1540px;
        margin: 0 auto;
    }

    .quality-hero {
        display: grid;
        grid-template-columns: minmax(0, 1.35fr) minmax(380px, .65fr);
        gap: 22px;
        padding: 28px;
        margin-bottom: 20px;
        overflow: hidden;
        border: 1px solid var(--quality-border);
        border-radius: 20px;
        background: var(--quality-card);
        box-shadow: 0 14px 40px rgba(15, 23, 42, .07);
    }

    .quality-hero-main {
        display: flex;
        align-items: flex-start;
        gap: 20px;
        min-width: 0;
    }

    .quality-hero-icon {
        width: 64px;
        height: 64px;
        flex: 0 0 64px;
        display: grid;
        place-items: center;
        border-radius: 18px;
        background: #fff1e6;
        color: var(--quality-orange);
        font-size: 28px;
    }

    .quality-hero h1 {
        margin: 0;
        color: var(--quality-navy);
        font-size: clamp(1.65rem, 2.6vw, 2.3rem);
        font-weight: 850;
        letter-spacing: -.02em;
    }

    .quality-hero p {
        max-width: 800px;
        margin: 9px 0 0;
        color: var(--quality-muted);
        font-size: .95rem;
        line-height: 1.65;
    }

    .quality-origin-note {
        display: inline-flex;
        align-items: center;
        gap: 8px;
        padding: 8px 12px;
        margin-top: 16px;
        border: 1px solid #fed7aa;
        border-radius: 999px;
        background: #fff7ed;
        color: #9a3412;
        font-size: .78rem;
        font-weight: 800;
    }

    .quality-hero-side {
        display: flex;
        flex-direction: column;
        justify-content: center;
        gap: 12px;
        padding: 18px;
        border: 1px solid #e8edf2;
        border-radius: 16px;
        background: #fbfcfd;
    }

    .quality-hero-side-label {
        color: var(--quality-muted);
        font-size: .72rem;
        font-weight: 850;
        letter-spacing: .05em;
        text-transform: uppercase;
    }

    .quality-hero-side strong {
        color: var(--quality-navy);
        font-size: 2rem;
        font-weight: 900;
    }

    .quality-hero-side p {
        margin: 0;
        font-size: .82rem;
        line-height: 1.5;
    }

    .quality-alert {
        display: flex;
        align-items: flex-start;
        gap: 12px;
        padding: 15px 18px;
        margin-bottom: 18px;
        border: 1px solid;
        border-radius: 12px;
    }

    .quality-alert-success {
        background: #effcf4;
        color: #166534;
        border-color: #bbf7d0;
    }

    .quality-alert-danger {
        background: #fff1f1;
        color: #991b1b;
        border-color: #fecaca;
    }

    .quality-summary-grid {
        display: grid;
        grid-template-columns: repeat(4, minmax(0, 1fr));
        gap: 14px;
        margin-bottom: 20px;
    }

    .quality-summary-card {
        position: relative;
        min-height: 128px;
        display: flex;
        align-items: center;
        gap: 15px;
        padding: 18px;
        overflow: hidden;
        border: 1px solid var(--quality-border);
        border-radius: 15px;
        background: var(--quality-card);
        color: inherit;
        text-decoration: none;
        box-shadow: 0 8px 24px rgba(15, 23, 42, .045);
        transition: transform .16s ease, border-color .16s ease, box-shadow .16s ease;
    }

        .quality-summary-card:hover {
            transform: translateY(-2px);
            border-color: rgba(249, 115, 22, .48);
            box-shadow: 0 14px 30px rgba(15, 23, 42, .08);
        }

        .quality-summary-card.is-active {
            border-color: var(--quality-orange);
            box-shadow: 0 0 0 3px rgba(249, 115, 22, .12);
        }

    .quality-summary-icon {
        width: 48px;
        height: 48px;
        flex: 0 0 48px;
        display: grid;
        place-items: center;
        border-radius: 14px;
        font-size: 20px;
    }

        .quality-summary-icon.warning {
            background: #fff7dc;
            color: #b45309;
        }

        .quality-summary-icon.danger {
            background: #fff0f0;
            color: #b91c1c;
        }

        .quality-summary-icon.info {
            background: #eaf5ff;
            color: #0369a1;
        }

        .quality-summary-icon.success {
            background: #eafbf1;
            color: #15803d;
        }

        .quality-summary-icon.dark {
            background: #e5e7eb;
            color: #334155;
        }

    .quality-summary-content {
        min-width: 0;
    }

        .quality-summary-content span {
            display: block;
            color: var(--quality-muted);
            font-size: .72rem;
            font-weight: 850;
            letter-spacing: .04em;
            text-transform: uppercase;
        }

        .quality-summary-content strong {
            display: block;
            margin-top: 4px;
            color: var(--quality-navy);
            font-size: 1.7rem;
            font-weight: 900;
        }

    .quality-toolbar {
        padding: 18px;
        margin-bottom: 20px;
        border: 1px solid var(--quality-border);
        border-radius: 16px;
        background: var(--quality-card);
    }

    .quality-filter-form {
        display: grid;
        grid-template-columns: minmax(280px, 1fr) minmax(250px, 350px) auto;
        gap: 12px;
        align-items: center;
    }

    .quality-search-wrap {
        position: relative;
    }

        .quality-search-wrap i {
            position: absolute;
            top: 50%;
            left: 15px;
            color: #94a3b8;
            transform: translateY(-50%);
            pointer-events: none;
        }

    .quality-search-input,
    .quality-filter-select {
        width: 100%;
        min-height: 46px;
        border: 1px solid #cfd8e3;
        border-radius: 10px;
        background: #fff;
        color: var(--quality-text);
        outline: none;
    }

    .quality-search-input {
        padding: 10px 14px 10px 43px;
    }

    .quality-filter-select {
        padding: 10px 12px;
    }

        .quality-search-input:focus,
        .quality-filter-select:focus {
            border-color: var(--quality-orange);
            box-shadow: 0 0 0 3px rgba(249, 115, 22, .12);
        }

    .quality-toolbar-actions {
        display: flex;
        align-items: center;
        gap: 9px;
    }

    .quality-btn {
        min-height: 44px;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: 8px;
        padding: 10px 16px;
        border: 1px solid transparent;
        border-radius: 10px;
        font-size: .85rem;
        font-weight: 800;
        text-decoration: none;
        white-space: nowrap;
        transition: transform .15s ease;
    }

        .quality-btn:hover {
            transform: translateY(-1px);
        }

    .quality-btn-primary {
        background: var(--quality-orange);
        color: #fff;
        border-color: var(--quality-orange);
    }

    .quality-btn-light {
        background: #fff;
        color: #334155;
        border-color: var(--quality-border);
    }

    .quality-list-card {
        overflow: hidden;
        border: 1px solid var(--quality-border);
        border-radius: 17px;
        background: var(--quality-card);
        box-shadow: 0 10px 28px rgba(15, 23, 42, .045);
    }

    .quality-list-header {
        display: flex;
        justify-content: space-between;
        align-items: center;
        gap: 18px;
        padding: 18px 20px;
        border-bottom: 1px solid var(--quality-border);
        background: #fbfcfd;
    }

        .quality-list-header h2 {
            display: flex;
            align-items: center;
            gap: 10px;
            margin: 0;
            color: var(--quality-navy);
            font-size: 1.03rem;
            font-weight: 850;
        }

            .quality-list-header h2 i {
                color: var(--quality-orange);
            }

    .quality-result-count {
        display: inline-flex;
        align-items: center;
        gap: 7px;
        padding: 7px 11px;
        border-radius: 999px;
        background: #f1f5f9;
        color: #475569;
        font-size: .76rem;
        font-weight: 800;
    }

    .quality-table-wrap {
        overflow-x: auto;
    }

    .quality-table {
        width: 100%;
        min-width: 1260px;
        border-collapse: collapse;
    }

        .quality-table th,
        .quality-table td {
            padding: 14px 15px;
            border-bottom: 1px solid #e8edf2;
            text-align: left;
            vertical-align: middle;
        }

        .quality-table th {
            background: #f7f9fb;
            color: #475569;
            font-size: .7rem;
            font-weight: 900;
            letter-spacing: .04em;
            text-transform: uppercase;
        }

        .quality-table td {
            color: #334155;
            font-size: .83rem;
        }

        .quality-table tbody tr {
            transition: background .14s ease;
        }

            .quality-table tbody tr:hover {
                background: #fffaf5;
            }

            .quality-table tbody tr:last-child td {
                border-bottom: 0;
            }

    .quality-primary-text {
        display: block;
        color: var(--quality-navy);
        font-weight: 850;
    }

    .quality-secondary-text {
        display: block;
        margin-top: 4px;
        color: var(--quality-muted);
        font-size: .76rem;
        line-height: 1.4;
    }

    .quality-program-badge {
        display: inline-flex;
        align-items: center;
        gap: 6px;
        padding: 5px 9px;
        margin-top: 7px;
        border: 1px solid #dbe5ef;
        border-radius: 999px;
        background: #f8fafc;
        color: #475569;
        font-size: .69rem;
        font-weight: 800;
    }

        .quality-program-badge.legacy {
            border-color: #fed7aa;
            background: #fff7ed;
            color: #9a3412;
        }

    .quality-status {
        display: inline-flex;
        align-items: center;
        gap: 7px;
        padding: 7px 11px;
