        height: 44px;
        display: grid;
        place-items: center;
        border-radius: 12px;
        font-size: 18px;
    }

    .quality-area-info {
        min-width: 0;
    }

        .quality-area-info strong {
            display: block;
            color: var(--quality-navy);
            font-size: .88rem;
