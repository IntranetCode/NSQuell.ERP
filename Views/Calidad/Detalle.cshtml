                                                    </div>
                                                </div>
                                                <div class="col-md-2 d-flex align-items-end">
                                                    <button type="submit"
                                                            class="quality-btn quality-btn-success w-100"
                                                            data-submit-confirm="¿Confirmas el resultado final de la reinspección?">
                                                        <i class="fa-solid fa-check"></i>
