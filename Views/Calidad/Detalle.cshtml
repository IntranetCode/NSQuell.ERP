@model ERP.NSQuell.Models.ViewModels.CalidadDetalleViewModel
@using ERP.NSQuell.Models
@{
    ViewData["Title"] = "Detalle de Calidad";

    var estado = (Model.Estado ?? string.Empty).Trim().ToUpperInvariant();
    var esReliberacion = Model.EsReliberacion;

    var puedeLiberarProduccion =
        !Model.ConfiguracionInvalidada &&
        (
            estado == CalidadEstados.PendientePrimerasPiezas ||
            estado == CalidadEstados.AjustesSolicitados ||
            estado == CalidadEstados.LegacyAbierta
        );

    var datosSuficientesLiberacion =
        Model.CincoDisparosSegregados &&
        Model.CantidadDisparosConformes >= 3 &&
        Model.ValidacionDimensional == true &&
        Model.ValidacionApariencia == true &&
        Model.ValidacionGauge != false &&
        Model.ValidacionConductividad != false;

    var reliberacionListaParaAutorizar =
        !esReliberacion || Model.TieneReliberacionPendiente;

    var puedeTomarDisposicion =
        estado == CalidadEstados.LegacyAbierta ||
        estado == CalidadEstados.LegacyLiberada ||
        estado == CalidadEstados.LegacyGPI2 ||
        estado == CalidadEstados.LegacyContencion;

    var tabInicial = "liberacion";

    if (estado == CalidadEstados.MonitoreoActivo)
    {
        tabInicial = Model.DisposicionesPendientes > 0
            ? "disposiciones"
            : "monitoreo";
    }
    else if (estado == CalidadEstados.PendienteLiberacionCaja ||
             estado == CalidadEstados.CajaLiberada ||
             estado == CalidadEstados.PendienteGP12 ||
             estado == CalidadEstados.EnGP12)
    {
        tabInicial = "cajas";
    }
    else if (estado == CalidadEstados.MaterialLiberado ||
             estado == CalidadEstados.MaterialNoConforme)
    {
        tabInicial = Model.Cierre.PuedeCerrar
            ? "cierre"
            : Model.DisposicionesPendientes > 0
                ? "disposiciones"
                : "cajas";
    }
    else if (estado == CalidadEstados.Cerrada)
    {
        tabInicial = "historial";
    }

    var confirmacionLiberacion = esReliberacion
        ? "¿Confirmas que las primeras piezas cumplen y deseas autorizar la reliberación?"
        : "¿Confirmas que las primeras piezas cumplen y deseas liberar la producción?";
}
<style>
    .quality-detail-page {
        --qd-orange: #f97316;
        --qd-navy: #14213d;
        --qd-text: #1e293b;
        --qd-muted: #64748b;
        --qd-border: #dfe5ec;
        --qd-bg: #f4f6f8;
        min-height: 100%;
        padding: 24px 12px 50px;
        background: var(--qd-bg);
        color: var(--qd-text)
    }

    .quality-detail-shell {
        max-width: 1500px;
        margin: 0 auto
    }

    .quality-tabs {
        position: sticky;
        top: 0;
        z-index: 30;
        display: flex;
        gap: 4px;
        margin: 0 0 20px;
        padding: 6px;
        border: 1px solid var(--qd-border);
        border-radius: 12px;
        background: #fff;
        overflow-x: auto;
        scrollbar-width: thin
    }

    .quality-tab {
        flex: 0 0 auto;
        min-height: 42px;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: 8px;
        padding: 9px 14px;
        border: 0;
        border-radius: 8px;
        background: transparent;
        color: #475569;
        font-size: .82rem;
        font-weight: 800;
        white-space: nowrap;
        cursor: pointer
    }

        .quality-tab:hover {
            background: #f8fafc;
            color: var(--qd-navy)
        }

        .quality-tab.is-active {
            background: var(--qd-navy);
            color: #fff
        }

    .quality-tab-badge {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        min-width: 22px;
        height: 22px;
        padding: 0 7px;
        border-radius: 999px;
        background: rgba(148,163,184,.18);
        font-size: .7rem;
        font-weight: 850
    }

    .quality-tab.is-active .quality-tab-badge {
        background: rgba(255,255,255,.18)
    }

    .quality-tab-panel {
        display: none
    }

        .quality-tab-panel.is-active {
            display: block
        }

    .quality-operational-actions {
        margin: 0 0 20px;
        padding: 16px 18px;
        border: 1px solid var(--qd-border);
        border-radius: 12px;
        background: #fff
    }

    .quality-operational-actions-head {
        display: flex;
        justify-content: space-between;
        align-items: flex-start;
        gap: 16px;
        margin-bottom: 14px
    }

    .quality-operational-actions h2 {
        margin: 0;
        color: var(--qd-navy);
        font-size: 1rem;
        font-weight: 850
    }

    .quality-operational-actions p {
        margin: 5px 0 0;
        color: var(--qd-muted);
        font-size: .8rem
    }

    .quality-actions-row {
        display: flex;
        flex-wrap: wrap;
        align-items: flex-end;
        gap: 12px
    }

    .quality-action-form {
        display: flex;
        flex: 1 1 300px;
        align-items: flex-end;
        gap: 10px
    }

    .quality-action-field {
        flex: 1 1 240px
    }

    .quality-action-label {
        display: block;
        margin-bottom: 5px;
        color: #475569;
        font-size: .72rem;
        font-weight: 800;
        text-transform: uppercase
    }

    .quality-action-input {
        width: 100%;
        min-height: 40px;
        padding: 8px 11px;
        border: 1px solid #cfd8e3;
        border-radius: 8px;
        background: #fff;
        color: #1e293b
    }

    .quality-action-button {
        min-height: 40px;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: 8px;
        padding: 9px 14px;
        border: 1px solid transparent;
        border-radius: 8px;
        font-size: .82rem;
        font-weight: 800;
        white-space: nowrap;
        cursor: pointer
    }

        .quality-action-button.is-success {
            background: #15803d;
            color: #fff;
            border-color: #15803d
        }

        .quality-action-button.is-warning {
            background: #d97706;
            color: #fff;
            border-color: #d97706
        }

        .quality-action-button.is-danger {
            background: #b91c1c;
            color: #fff;
            border-color: #b91c1c
        }

        .quality-action-button:disabled {
            cursor: not-allowed;
            opacity: .48
        }

    .quality-action-help {
        width: 100%;
        margin-top: 2px;
        color: var(--qd-muted);
        font-size: .76rem;
        line-height: 1.45
    }

    .quality-invalid-notice {
        padding: 14px 16px;
        border: 1px solid #fecaca;
        border-radius: 10px;
        background: #fff1f1;
        color: #991b1b;
        font-weight: 700
    }

    html[data-nsq-theme="dark"] .quality-detail-page {
        --qd-text: #e5e7eb;
        --qd-muted: #94a3b8;
        --qd-border: rgba(255,255,255,.10);
        --qd-bg: #0b1220;
        background: #0b1220
    }

    html[data-nsq-theme="dark"] .quality-tabs, html[data-nsq-theme="dark"] .quality-operational-actions {
        background: #111c2d
    }

    html[data-nsq-theme="dark"] .quality-tab {
        color: #cbd5e1
    }

        html[data-nsq-theme="dark"] .quality-tab:hover {
            background: #0e1828;
            color: #fff
        }

    html[data-nsq-theme="dark"] .quality-action-input {
        background: #0b1422;
        color: #f8fafc;
        border-color: rgba(255,255,255,.13)
    }

    @@media(max-width:760px) {
        .quality-detail-page {
            padding-left: 4px;
            padding-right: 4px
        }

        .quality-tabs {
            border-radius: 8px
        }

        .quality-tab {
            padding: 9px 11px
        }

        .quality-operational-actions-head {
            flex-direction: column
        }

        .quality-action-form {
            flex-direction: column;
            align-items: stretch
        }

        .quality-action-button {
            width: 100%
        }
    }
</style>

<div class="quality-detail-page" data-quality-detail data-initial-tab="@tabInicial">
    <div class="quality-detail-shell">
        <partial name="_ResumenCorrida" model="Model" />

        <nav class="quality-tabs" aria-label="Secciones del detalle de Calidad" data-quality-tabs>
            <button type="button" class="quality-tab" data-quality-tab="liberacion">
                <i class="fa-solid fa-circle-check"></i>
                Liberación
            </button>
            <button type="button" class="quality-tab" data-quality-tab="monitoreo">
                <i class="fa-solid fa-clock"></i>
                Monitoreo
                @if (Model.MonitoreosDisponiblesCaptura > 0)
                {
                    <span class="quality-tab-badge">@Model.MonitoreosDisponiblesCaptura</span>
                }
            </button>
            <button type="button" class="quality-tab" data-quality-tab="disposiciones">
                <i class="fa-solid fa-boxes-stacked"></i>
                Disposiciones
                @if (Model.DisposicionesPendientes > 0)
                {
                    <span class="quality-tab-badge">@Model.DisposicionesPendientes</span>
                }
            </button>
            <button type="button" class="quality-tab" data-quality-tab="cajas">
                <i class="fa-solid fa-box"></i>
                Cajas y GP12
                @if (Model.Cierre.CajasPendientesCalidad > 0 || Model.Cierre.GP12Abiertos > 0)
                {
                    <span class="quality-tab-badge">@(Model.Cierre.CajasPendientesCalidad + Model.Cierre.GP12Abiertos)</span>
                }
            </button>
            <button type="button" class="quality-tab" data-quality-tab="cierre">
                <i class="fa-solid fa-box-archive"></i>
                Cierre
            </button>
            <button type="button" class="quality-tab" data-quality-tab="historial">
                <i class="fa-solid fa-clock-rotate-left"></i>
                Historial
                @if (Model.Historial != null && Model.Historial.Any())
                {
                    <span class="quality-tab-badge">@Model.Historial.Count</span>
                }
            </button>
        </nav>

        <section class="quality-tab-panel" data-quality-panel="liberacion">
            <partial name="_Liberacion" model="Model" />

            @if (Model.ConfiguracionInvalidada)
            {
                <div class="quality-invalid-notice">
                    <i class="fa-solid fa-ban me-1"></i>
                    Las acciones operativas permanecen bloqueadas hasta que Producción corrija la configuración y genere una nueva solicitud.
                </div>
            }
            else if (puedeLiberarProduccion || puedeTomarDisposicion)
            {
                <section class="quality-operational-actions">
                    <div class="quality-operational-actions-head">
                        <div>
                            <h2>Acciones operativas</h2>
                            <p>Acciones que modifican el resultado o la condición del material.</p>
                        </div>
                    </div>

                    <div class="quality-actions-row">
                        @if (puedeLiberarProduccion)
                        {
                            <form asp-controller="Calidad"
                                  asp-action="LiberarProduccionFlujo"
                                  method="post"
                                  class="quality-action-form"
                                  data-confirm="@confirmacionLiberacion">
                                @Html.AntiForgeryToken()
                                <input type="hidden" name="id" value="@Model.InspeccionID" />
                                <button type="submit"
                                        class="quality-action-button is-success"
                                        disabled="@(!datosSuficientesLiberacion || !reliberacionListaParaAutorizar)">
                                    <i class="fa-solid fa-circle-check"></i>
                                    @(esReliberacion ? "Autorizar reliberación" : "Liberar con etiqueta verde")
                                </button>

                                @if (!datosSuficientesLiberacion)
                                {
                                    <div class="quality-action-help">
                                        Se requieren cinco disparos segregados, al menos tres conformes, dimensional y apariencia aprobados, sin resultados NOK en gauge o conductividad.
                                    </div>
                                }
                                else if (esReliberacion && !reliberacionListaParaAutorizar)
                                {
                                    <div class="quality-action-help text-danger fw-bold">
                                        Guarda una nueva validación de primeras piezas para dejar la solicitud de reliberación pendiente.
                                    </div>
                                }
                            </form>
                        }

                        @if (puedeTomarDisposicion)
                        {
                            <form asp-controller="Calidad"
                                  asp-action="EnviarGP12"
                                  method="post"
                                  class="quality-action-form"
                                  data-confirm="¿Confirmas el envío del material a GP12?">
                                @Html.AntiForgeryToken()
                                <input type="hidden" name="id" value="@Model.InspeccionID" />
                                <div class="quality-action-field">
                                    <label class="quality-action-label">Motivo de GP12</label>
                                    <input type="text"
                                           name="comentario"
                                           class="quality-action-input"
                                           maxlength="1000"
                                           placeholder="Motivo del envío a inspección reforzada..." />
                                </div>
                                <button type="submit" class="quality-action-button is-warning">
                                    <i class="fa-solid fa-magnifying-glass-plus"></i>
                                    Enviar a GP12
                                </button>
                            </form>

                            <form asp-controller="Calidad"
                                  asp-action="EnviarContencion"
                                  method="post"
                                  class="quality-action-form"
                                  data-confirm="¿Confirmas que el material debe identificarse como no conforme?">
                                @Html.AntiForgeryToken()
                                <input type="hidden" name="id" value="@Model.InspeccionID" />
                                <div class="quality-action-field">
                                    <label class="quality-action-label">Motivo de contención</label>
                                    <input type="text"
                                           name="comentario"
                                           class="quality-action-input"
                                           maxlength="1000"
                                           placeholder="Describe la no conformidad..." />
                                </div>
                                <button type="submit" class="quality-action-button is-danger">
                                    <i class="fa-solid fa-ban"></i>
                                    Bloquear material
                                </button>
                            </form>
                        }
                    </div>
                </section>
            }
        </section>

        <section class="quality-tab-panel" data-quality-panel="monitoreo">
            <partial name="_Monitoreo" model="Model" />
        </section>

        <section class="quality-tab-panel" data-quality-panel="disposiciones">
            <partial name="_Disposiciones" model="Model" />
        </section>

        <section class="quality-tab-panel" data-quality-panel="cajas">
            <partial name="_CajasGp12" model="Model" />
        </section>

        <section class="quality-tab-panel" data-quality-panel="cierre">
            <partial name="_Cierre" model="Model" />
        </section>

        <section class="quality-tab-panel" data-quality-panel="historial">
            <partial name="_Historial" model="Model" />
        </section>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        document.addEventListener('DOMContentLoaded', function () {
            const page = document.querySelector('[data-quality-detail]');
            if (!page) return;

            const buttons = Array.from(page.querySelectorAll('[data-quality-tab]'));
            const panels = Array.from(page.querySelectorAll('[data-quality-panel]'));
            const storageKey = 'calidad-detalle-tab-@Model.InspeccionID';

            function existeTab(nombre) {
                return buttons.some(function (button) {
                    return button.dataset.qualityTab === nombre;
                });
            }

            function activarTab(nombre, actualizarUrl) {
                if (!existeTab(nombre)) {
                    nombre = page.dataset.initialTab || 'liberacion';
                }

                buttons.forEach(function (button) {
                    const activo = button.dataset.qualityTab === nombre;
                    button.classList.toggle('is-active', activo);
                    button.setAttribute('aria-selected', activo ? 'true' : 'false');
                    button.setAttribute('tabindex', activo ? '0' : '-1');
                });

                panels.forEach(function (panel) {
                    const activo = panel.dataset.qualityPanel === nombre;
                    panel.classList.toggle('is-active', activo);
                    panel.hidden = !activo;
                });

                try {
                    sessionStorage.setItem(storageKey, nombre);
                } catch (_) {
                }

                if (actualizarUrl) {
                    const url = new URL(window.location.href);
                    url.hash = nombre;
                    window.history.replaceState(null, '', url);
                }

                window.setTimeout(function () {
                    window.dispatchEvent(new Event('resize'));
                }, 0);
            }

            buttons.forEach(function (button, index) {
                button.setAttribute('role', 'tab');

                button.addEventListener('click', function () {
                    activarTab(button.dataset.qualityTab, true);
                });

                button.addEventListener('keydown', function (event) {
                    if (event.key !== 'ArrowLeft' && event.key !== 'ArrowRight') return;

                    event.preventDefault();
                    const desplazamiento = event.key === 'ArrowRight' ? 1 : -1;
                    const siguiente = (index + desplazamiento + buttons.length) % buttons.length;
                    buttons[siguiente].focus();
                    activarTab(buttons[siguiente].dataset.qualityTab, true);
                });
            });

            panels.forEach(function (panel) {
                panel.setAttribute('role', 'tabpanel');
            });

            let tabInicial = window.location.hash.replace('#', '');

            if (!existeTab(tabInicial)) {
                try {
                    tabInicial = sessionStorage.getItem(storageKey) || '';
                } catch (_) {
                    tabInicial = '';
                }
            }

            if (!existeTab(tabInicial)) {
                tabInicial = page.dataset.initialTab || 'liberacion';
            }

            activarTab(tabInicial, false);

            page.querySelectorAll('form[data-confirm]').forEach(function (form) {
                if (form.dataset.confirmInitialized === 'true') return;
                form.dataset.confirmInitialized = 'true';

                form.addEventListener('submit', function (event) {
                    const mensaje = form.dataset.confirm;
                    if (mensaje && !window.confirm(mensaje)) {
                        event.preventDefault();
                    }
                });
            });

            const primerInvalido = page.querySelector('.input-validation-error, .is-invalid, [aria-invalid="true"]');

            if (primerInvalido) {
                const panel = primerInvalido.closest('[data-quality-panel]');
                if (panel) {
                    activarTab(panel.dataset.qualityPanel, true);
                    window.setTimeout(function () {
                        primerInvalido.scrollIntoView({ behavior: 'smooth', block: 'center' });
                        if (typeof primerInvalido.focus === 'function') primerInvalido.focus();
                    }, 80);
                }
            }

            window.addEventListener('hashchange', function () {
                const nombre = window.location.hash.replace('#', '');
                if (existeTab(nombre)) activarTab(nombre, false);
            });
        });
    </script>
}
