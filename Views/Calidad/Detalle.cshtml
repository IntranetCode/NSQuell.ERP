                @if (puedePrearranque && Model.ChecklistArranqueID.HasValue && Model.PreguntasChecklistCalidad.Any())
                {
                    <section class="quality-card">
                        <div class="quality-card-header">
                            <h2>
                                <i class="fa-solid fa-list-check"></i>
                                Sección del auditor de Calidad
                            </h2>
                        </div>

                        <div class="quality-card-body">
                            <form asp-controller="Calidad"
                                  asp-action="GuardarChecklistCalidad"
                                  method="post">
                                @Html.AntiForgeryToken()

                                <input type="hidden" name="InspeccionID" value="@Model.InspeccionID" />
                                <input type="hidden" name="ChecklistArranqueID" value="@Model.ChecklistArranqueID" />

                                <div class="quality-checklist-instructions">
                                    <i class="fa-solid fa-circle-info"></i>
                                    <span>
                                        Todas las respuestas nuevas comienzan en <strong>OK</strong>.
                                        Cambia el interruptor a <strong>NOK</strong> o marca <strong>N/A</strong>
                                        para habilitar las observaciones.
                                    </span>
                                </div>

                                @for (var i = 0; i < Model.PreguntasChecklistCalidad.Count; i++)
                                {
                                    var pregunta = Model.PreguntasChecklistCalidad[i];
                                    var resultadoActual = string.IsNullOrWhiteSpace(pregunta.Resultado)
                                        ? "OK"
                                        : pregunta.Resultado.Trim().ToUpperInvariant();
                                    var esNa = resultadoActual == "NA";
                                    var esNok = resultadoActual == "NOK";
                                    var esOk = !esNa && !esNok;
                                    var observacionesHabilitadas = esNok || esNa;

                                    <input type="hidden"
                                           name="Respuestas[@i].ChecklistArranqueDetalleID"
                                           value="@pregunta.ChecklistArranqueDetalleID" />

                                    <div class="quality-side-action quality-checklist-item mb-3"
                                         data-quality-result>
                                        <h3>@pregunta.OrdenPregunta. @pregunta.TextoPregunta</h3>

                                        <input type="hidden"
                                               name="Respuestas[@i].Resultado"
                                               value="@resultadoActual"
                                               data-result-value />

                                        <div class="quality-form-grid quality-checklist-grid">
                                            <div>
                                                <label class="quality-form-label">Resultado</label>

                                                <div class="quality-result-selector">
                                                    <div class="quality-result-switch-group">
                                                        <span class="quality-result-option quality-result-option-nok">
                                                            NOK
                                                        </span>

                                                        <label class="quality-toggle-switch"
                                                               title="Cambiar entre NOK y OK">
                                                            <input type="checkbox"
                                                                   data-result-switch
                                                                   checked="@(esOk ? "checked" : null)"
                                                                   disabled="@(esNa ? "disabled" : null)" />
                                                            <span class="quality-toggle-slider"></span>
                                                        </label>

                                                        <span class="quality-result-option quality-result-option-ok">
                                                            OK
                                                        </span>
                                                    </div>

                                                    <label class="quality-na-option">
                                                        <input type="checkbox"
                                                               data-result-na
                                                               checked="@(esNa ? "checked" : null)" />
                                                        <span>N/A</span>
                                                    </label>
                                                </div>

                                                <div class="quality-result-current"
                                                     data-result-caption>
                                                    @(esNa ? "No aplica" : esNok ? "No conforme" : "Conforme")
                                                </div>
                                            </div>

                                            <div>
                                                <label class="quality-form-label">Observaciones</label>
                                                <textarea name="Respuestas[@i].Observaciones"
                                                          class="quality-form-control quality-result-observation @(observacionesHabilitadas ? "" : "is-locked")"
                                                          maxlength="500"
                                                          data-result-observation
                                                          readonly="@(!observacionesHabilitadas ? "readonly" : null)"
                                                          aria-readonly="@(!observacionesHabilitadas ? "true" : "false")"
                                                          placeholder="@(esNok ? "Describe la no conformidad (obligatorio)..." : esNa ? "Explica por qué no aplica (opcional)..." : "Se habilita al seleccionar NOK o N/A")">@pregunta.Observaciones</textarea>
                                                <div class="quality-observation-help" data-observation-help>
                                                    @(esNok
                                                        ? "La observación es obligatoria para un resultado NOK."
                                                        : esNa
                                                            ? "Puedes documentar por qué esta validación no aplica."
                                                            : "El campo se habilitará cuando el resultado sea NOK o N/A.")
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                }

                                <label class="quality-form-label">Observaciones generales de Calidad</label>
                                <textarea name="ObservacionesCalidad"
                                          class="quality-form-control"
                                          maxlength="1000"
                                          placeholder="Observaciones generales de la revisión..."></textarea>

                                <button type="submit" class="quality-btn quality-btn-primary mt-3">
                                    <i class="fa-solid fa-floppy-disk"></i>
                                    Guardar sección de Calidad
                                </button>
                            </form>
                        </div>
                    </section>
                }

                @if (puedePrearranque)
