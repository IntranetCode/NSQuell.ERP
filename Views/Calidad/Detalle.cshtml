    @@media (max-width: 991.98px) {
        .quality-reliberation-grid {
            grid-template-columns: repeat(2, minmax(0, 1fr));
        }
    }

    @@media (max-width: 767.98px) {
        .quality-monitor-result-grid,
        .quality-monitor-treatment-grid,
        .quality-box-validation-grid,
        .quality-reliberation-grid {
            grid-template-columns: 1fr;
        }

        .quality-reliberation-header,
        .quality-reliberation-history-item {
            flex-direction: column;
        }
    }

</style>

<div class="quality-detail-page">
    <div class="quality-detail-shell">

        @if (TempData["Mensaje"] != null)
        {
            <div class="quality-alert quality-alert-success" role="alert">
                <i class="fa-solid fa-circle-check mt-1"></i>
                <div>@TempData["Mensaje"]</div>
            </div>
        }

        @if (TempData["Error"] != null)
        {
            <div class="quality-alert quality-alert-danger" role="alert">
                <i class="fa-solid fa-triangle-exclamation mt-1"></i>
                <div>@TempData["Error"]</div>
            </div>
        }

        @if (Model.ConfiguracionInvalidada)
        {
            <div class="quality-alert quality-alert-danger">
                <i class="fa-solid fa-ban mt-1"></i>
                <div>
                    <strong>La configuración validada fue invalidada.</strong>
                    <div class="mt-1">
                        @Mostrar(Model.MotivoInvalidacion)
                    </div>

                    @if (Model.FechaInvalidacion.HasValue)
                    {
                        <div class="mt-1 small">
                            Fecha:
                            @Model.FechaInvalidacion.Value.ToString("dd/MM/yyyy HH:mm")
                        </div>
                    }
                </div>
            </div>
        }

        <header class="quality-detail-header">
            <div class="quality-detail-header-main">
                <div class="quality-detail-icon">
                    <i class="fa-solid fa-microscope"></i>
                </div>

                <div>
                    <h1 class="quality-detail-title">
                        @(esReliberacion ? "Reliberación de corrida" : "Liberación de corrida")
                    </h1>

                    <p class="quality-detail-subtitle">
                        Inspección #@Model.InspeccionID
                        · @(Model.ProgramaProduccionID.HasValue
                        ? $"Programa {Model.ProgramaProduccionID.Value}"
                        : "Registro anterior sin vínculo a Planeación")
                        · OF @Mostrar(Model.OrdenTrabajo)
                    </p>
                </div>
            </div>

            <div class="quality-header-actions">
                <span class="quality-state @estadoClase">
                    <i class="fa-solid fa-circle"></i>
                    @estadoTexto
                </span>

                <a asp-controller="Calidad"
                   asp-action="Index"
                   class="quality-btn quality-btn-light">
                    <i class="fa-solid fa-arrow-left"></i>
                    Volver
                </a>
            </div>
        </header>

        <section class="quality-progress" aria-label="Avance de liberación">
            @for (var i = 0; i < pasos.Length; i++)
            {
                var numeroPaso = i + 1;

                var clasePaso = numeroPaso < pasoActual
                    ? "is-done"
                    : numeroPaso == pasoActual
                        ? "is-active"
                        : "";

                <div class="quality-progress-step @clasePaso">
                    <div class="quality-progress-circle">
                        @if (numeroPaso < pasoActual)
                        {
                            <i class="fa-solid fa-check"></i>
                        }
                        else
                        {
                            @numeroPaso
                        }
                    </div>

                    <span>@pasos[i]</span>
                </div>
            }
        </section>

        @if (esReliberacion)
        {
            <section class="quality-reliberation-panel">
                <div class="quality-reliberation-header">
                    <div>
                        <h2 class="quality-reliberation-title">
                            <i class="fa-solid fa-rotate"></i>
                            Reliberación obligatoria por paro mayor a 15 minutos
                        </h2>
                        <div class="quality-help mt-2">
                            La liberación anterior dejó de ser válida. Producción no debe reiniciar la serie
                            hasta completar nuevamente prearranque, primeras piezas y autorización de Calidad.
                        </div>
                    </div>

                    @if (ultimaReliberacion != null)
                    {
                        <span class="badge @ultimaReliberacion.ResultadoBadgeClase">
                            @ultimaReliberacion.ResultadoTexto
                        </span>
                    }
                    else
                    {
                        <span class="badge bg-danger">Sin solicitud vinculada</span>
                    }
                </div>

                <div class="quality-reliberation-body">
                    @if (ultimaReliberacion != null)
                    {
                        <div class="quality-reliberation-grid">
                            <div class="quality-reliberation-data">
                                <div class="quality-data-label">Reliberación</div>
                                <div class="fw-bold">#@ultimaReliberacion.NumeroReliberacion</div>
                            </div>

                            <div class="quality-reliberation-data">
                                <div class="quality-data-label">Paro relacionado</div>
                                <div class="fw-bold">#@ultimaReliberacion.ParoID</div>
                            </div>

                            <div class="quality-reliberation-data">
                                <div class="quality-data-label">Duración</div>
                                <div class="fw-bold text-danger">@ultimaReliberacion.DuracionTexto</div>
                            </div>

                            <div class="quality-reliberation-data">
                                <div class="quality-data-label">Solicitud</div>
                                <div class="fw-bold">@ultimaReliberacion.FechaSolicitud.ToString("dd/MM/yyyy HH:mm")</div>
                            </div>

                            <div class="quality-reliberation-data" style="grid-column: span 2;">
                                <div class="quality-data-label">Horario del paro</div>
                                <div class="fw-semibold">@ultimaReliberacion.RangoParo</div>
                            </div>

                            <div class="quality-reliberation-data" style="grid-column: span 2;">
                                <div class="quality-data-label">Motivo del paro</div>
                                <div class="fw-semibold">
                                    @Mostrar(ultimaReliberacion.MotivoParoTexto ?? ultimaReliberacion.Motivo)
                                </div>
                            </div>
                        </div>

                        @if (!string.IsNullOrWhiteSpace(ultimaReliberacion.DescripcionParo))
                        {
                            <div class="quality-reliberation-data mt-3">
                                <div class="quality-data-label">Descripción registrada por Producción</div>
                                <div>@ultimaReliberacion.DescripcionParo</div>
                            </div>
                        }

                        @if (ultimaReliberacion.EsPendiente)
                        {
                            <div class="quality-reliberation-message is-pending">
                                <i class="fa-solid fa-clock me-1"></i>
                                Pendiente: Calidad debe validar las nuevas primeras piezas y autorizar la reliberación.
                            </div>
                        }
                        else if (ultimaReliberacion.EsRechazada)
                        {
                            <div class="quality-reliberation-message is-rejected">
                                <i class="fa-solid fa-circle-xmark me-1"></i>
                                Rechazada: Producción debe corregir el proceso y presentar un nuevo intento de primeras piezas.
                            </div>
                        }
                        else if (ultimaReliberacion.EsAutorizada)
                        {
                            <div class="quality-reliberation-message is-authorized">
                                <i class="fa-solid fa-circle-check me-1"></i>
                                Autorizada: la corrida cuenta nuevamente con etiqueta verde para reiniciar la serie.
                                @if (ultimaReliberacion.FechaValidacion.HasValue)
                                {
                                    <span> Validada el @ultimaReliberacion.FechaValidacion.Value.ToString("dd/MM/yyyy HH:mm").</span>
                                }
                            </div>
                        }

                        @if (!string.IsNullOrWhiteSpace(ultimaReliberacion.Observaciones))
                        {
                            <div class="quality-reliberation-data mt-3">
                                <div class="quality-data-label">Seguimiento de Calidad</div>
                                <div style="white-space: pre-line;">@ultimaReliberacion.Observaciones</div>
                            </div>
                        }

                        @if (Model.Reliberaciones.Count > 1)
                        {
                            <details class="mt-3">
                                <summary class="fw-bold">Historial de reliberaciones de esta inspección</summary>

                                <div class="quality-reliberation-history">
                                    @foreach (var reliberacion in Model.Reliberaciones)
                                    {
                                        <div class="quality-reliberation-history-item @reliberacion.ResultadoBordeClase">
                                            <div>
                                                <div class="fw-bold">
                                                    Reliberación #@reliberacion.NumeroReliberacion · Paro #@reliberacion.ParoID
                                                </div>
                                                <div class="quality-help">
                                                    @reliberacion.FechaSolicitud.ToString("dd/MM/yyyy HH:mm") · @reliberacion.DuracionTexto
                                                </div>
                                            </div>
                                            <span class="badge @reliberacion.ResultadoBadgeClase">
                                                @reliberacion.ResultadoTexto
                                            </span>
                                        </div>
                                    }
                                </div>
                            </details>
                        }
                    }
                    else
                    {
                        <div class="quality-reliberation-message is-rejected">
                            No se encontró el registro de reliberación asociado al paro. Recarga la vista para
                            volver a sincronizarlo antes de tomar una decisión.
                        </div>
                    }
                </div>
            </section>
        }

        <div class="quality-grid">
            <main class="quality-column">

                <section class="quality-card">
                    <div class="quality-card-header">
                        <h2>
                            <i class="fa-solid fa-industry"></i>
                            Información de la corrida
                        </h2>
                    </div>

                    <div class="quality-card-body">
                        <div class="quality-data-grid">
                            <div class="quality-data-item">
                                <span class="quality-data-label">Programa</span>
                                <span class="quality-data-value">
                                    @(Model.ProgramaProduccionID?.ToString() ?? "—")
                                </span>
                            </div>

                            <div class="quality-data-item">
                                <span class="quality-data-label">Orden de fabricación</span>
                                <span class="quality-data-value">
                                    @Mostrar(Model.OrdenTrabajo)
                                </span>
                            </div>

                            <div class="quality-data-item">
                                <span class="quality-data-label">Cliente</span>
                                <span class="quality-data-value">
                                    @Mostrar(Model.ClienteNombre)
                                </span>
                            </div>

                            <div class="quality-data-item">
                                <span class="quality-data-label">Número de parte</span>
                                <span class="quality-data-value">
                                    @Mostrar(Model.NumeroParte)
                                </span>
                            </div>

                            <div class="quality-data-item wide">
                                <span class="quality-data-label">Material</span>
                                <span class="quality-data-value">
