                                        var esObservacionGeneradaPorSistema =
                                            string.Equals(
                                                observacionActual,
                                                observacionInicialSistema,
                                                StringComparison.OrdinalIgnoreCase) ||
                                            (!string.IsNullOrWhiteSpace(observacionActual) &&
                                             observacionActual.StartsWith(
                                                 prefijoReliberacionSistema,
                                                 StringComparison.OrdinalIgnoreCase));

                                        var observacionesPrimerasPiezas =
                                            esObservacionGeneradaPorSistema
                                                ? string.Empty
                                                : Model.Observaciones;
                                    }

                                    <div class="quality-field-full">
                                        <label class="quality-form-label">
                                            Observaciones generales
                                        </label>

                                        <textarea name="Observaciones"
                                                  class="quality-form-control quality-result-observation @(habilitarObsPrimerasPiezas ? string.Empty : "is-locked")"
                                                  maxlength="1000"
                                                  data-first-general-observation
                                                  readonly="@(!habilitarObsPrimerasPiezas ? "readonly" : null)"
                                                  aria-readonly="@(!habilitarObsPrimerasPiezas ? "true" : "false")"
                                                  placeholder="@(habilitarObsPrimerasPiezas ? "Describe el motivo del No cumple, del No aplica o los ajustes necesarios..." : "Se habilita cuando exista algún No cumple, No aplica o menos de 3 disparos conformes")">@observacionesPrimerasPiezas</textarea>

                                        <div class="quality-observation-help" data-first-general-help>
                                            @(habilitarObsPrimerasPiezas
                                                ? "Documenta aquí cualquier resultado No cumple, campo No aplica o ajuste requerido."
                                                : "Las observaciones se habilitarán cuando exista un No cumple, un No aplica o menos de 3 disparos conformes.")
                                        </div>
                                    </div>
                                </div>

                                <div class="quality-form-actions">
                                    <button type="submit"
                                            formaction="@Url.Action("SolicitarAjustesFlujo", "Calidad")"
                                            class="quality-btn quality-btn-danger"
                                            data-firstpieces-action="ajustes"
                                            data-submit-confirm="@confirmacionAjustes">
                                        <i class="fa-solid fa-screwdriver-wrench"></i>
                                        @(esReliberacion ? "Rechazar reliberación" : "Solicitar ajustes")
                                    </button>

                                    <button type="submit"
                                            formaction="@Url.Action("RegistrarPrimerasPiezasFlujo", "Calidad")"
                                            class="quality-btn quality-btn-primary"
                                            data-firstpieces-action="guardar"
                                            data-submit-confirm="¿Confirmas que deseas guardar esta validación?">
                                        <i class="fa-solid fa-floppy-disk"></i>
                                        Guardar validación
                                    </button>
                                </div>
                            </form>
                        </div>
                    </section>
                }

                @if (hayValidacionPrimerasPiezas)
                {
                    <section class="quality-card">
                        <div class="quality-card-header">
                            <h2>
                                <i class="fa-solid fa-chart-simple"></i>
                                Resultado de primeras piezas
                            </h2>
                        </div>

                        <div class="quality-card-body">
                            <div class="quality-validation-list">
                                <div class="quality-validation-item">
                                    <span>Primeros cinco disparos segregados</span>
                                    <strong class="@(Model.CincoDisparosSegregados ? "quality-result-ok" : "quality-result-nok")">
                                        @(Model.CincoDisparosSegregados ? "Sí" : "No")
                                    </strong>
                                </div>

                                <div class="quality-validation-item">
                                    <span>Disparos conformes</span>
                                    <strong class="@(Model.CantidadDisparosConformes >= 3 ? "quality-result-ok" : "quality-result-nok")">
                                        @Model.CantidadDisparosConformes de 5
                                    </strong>
                                </div>

                                <div class="quality-validation-item">
                                    <span>Dimensional</span>
                                    <strong class="@ClaseResultadoNullable(Model.ValidacionDimensional)">
                                        @ResultadoNullable(Model.ValidacionDimensional)
                                    </strong>
                                </div>

                                <div class="quality-validation-item">
                                    <span>Apariencia</span>
                                    <strong class="@ClaseResultadoNullable(Model.ValidacionApariencia)">
                                        @ResultadoNullable(Model.ValidacionApariencia)
                                    </strong>
                                </div>

                                <div class="quality-validation-item">
                                    <span>Gauge</span>
                                    <strong class="@ClaseResultadoNullable(Model.ValidacionGauge)">
                                        @ResultadoNullable(Model.ValidacionGauge)
                                    </strong>
                                </div>

                                <div class="quality-validation-item">
                                    <span>Conductividad</span>
                                    <strong class="@ClaseResultadoNullable(Model.ValidacionConductividad)">
                                        @ResultadoNullable(Model.ValidacionConductividad)
                                    </strong>
                                </div>
                            </div>

                            @if (Model.FechaValidacionPrimerasPiezas.HasValue)
                            {
                                <div class="quality-help mt-3">
                                    Última validación:
                                    @Model.FechaValidacionPrimerasPiezas.Value.ToString("dd/MM/yyyy HH:mm")
                                </div>
                            }
                        </div>
                    </section>
                }

                @if (Model.IntentosPrimerasPiezas.Any())
                {
                    <section class="quality-card">
                        <div class="quality-card-header">
                            <h2>
                                <i class="fa-solid fa-vials"></i>
                                Intentos de primeras piezas
                            </h2>
                        </div>

                        <div class="quality-card-body table-responsive">
                            <table class="table table-sm align-middle">
                                <thead>
                                    <tr>
                                        <th>Intento</th>
                                        <th>Disparos</th>
                                        <th>Dimensional</th>
                                        <th>Apariencia</th>
                                        <th>Gauge</th>
                                        <th>Conductividad</th>
                                        <th>Resultado</th>
                                        <th>Fecha</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var intento in Model.IntentosPrimerasPiezas)
                                    {
                                        <tr>
                                            <td>#@intento.NumeroIntento</td>
                                            <td>@intento.CantidadDisparosPresentados</td>
                                            <td>@ResultadoNullable(intento.ValidacionDimensional)</td>
                                            <td>@ResultadoNullable(intento.ValidacionApariencia)</td>
                                            <td>@ResultadoNullable(intento.ValidacionGauge)</td>
                                            <td>@ResultadoNullable(intento.ValidacionConductividad)</td>
                                            <td><strong>@intento.Resultado</strong></td>
                                            <td>@intento.FechaInicio.ToString("dd/MM/yyyy HH:mm")</td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    </section>
                }

                @if (estado == CalidadEstados.MonitoreoActivo || Model.Monitoreos.Any())
                {
                    <section class="quality-card" id="monitoreos-calidad">
                        <div class="quality-card-header">
                            <div>
                                <h2>
                                    <i class="fa-solid fa-clock"></i>
                                    Monitoreos de proceso cada hora
                                </h2>
                                <div class="quality-help">
                                    Calidad revisa cada periodo disponible y registra el resultado sin modificar la captura original.
                                </div>
                            </div>

                            @if (estado == CalidadEstados.MonitoreoActivo)
                            {
                                <form asp-controller="Calidad"
                                      asp-action="SincronizarMonitoreosCalidad"
                                      method="post">
                                    @Html.AntiForgeryToken()
                                    <input type="hidden" name="id" value="@Model.InspeccionID" />
                                    <button type="submit"
                                            class="quality-btn quality-btn-light"
                                            data-submit-confirm="¿Actualizar los periodos y vincular las capturas horarias disponibles?">
                                        <i class="fa-solid fa-arrows-rotate"></i>
                                        Actualizar periodos
                                    </button>
                                </form>
                            }
                        </div>

                        <div class="quality-card-body">
                            @if (!Model.Monitoreos.Any())
                            {
                                <div class="quality-monitor-empty">
                                    <i class="fa-solid fa-clock-rotate-left fa-2x mb-2"></i>
                                    <div class="fw-bold mb-1">Todavía no hay periodos programados.</div>
                                    <div>
                                        Usa <strong>Actualizar periodos</strong> para reconstruir el seguimiento horario de Calidad.
                                    </div>
                                </div>
                            }
                            else
                            {
                                <div class="row g-3 mb-3">
                                    <div class="col-6 col-lg-2">
                                        <div class="border rounded-3 p-3 h-100">
                                            <div class="quality-data-label">Programados</div>
                                            <div class="fs-4 fw-bold">@Model.TotalMonitoreos</div>
                                        </div>
                                    </div>
                                    <div class="col-6 col-lg-2">
                                        <div class="border rounded-3 p-3 h-100">
                                            <div class="quality-data-label">Disponibles</div>
                                            <div class="fs-4 fw-bold text-primary">@Model.MonitoreosDisponiblesCaptura</div>
                                        </div>
                                    </div>
                                    <div class="col-6 col-lg-2">
                                        <div class="border rounded-3 p-3 h-100">
                                            <div class="quality-data-label">Esperando captura</div>
                                            <div class="fs-4 fw-bold text-secondary">@Model.MonitoreosEsperandoProduccion</div>
                                        </div>
                                    </div>
                                    <div class="col-6 col-lg-2">
                                        <div class="border rounded-3 p-3 h-100">
                                            <div class="quality-data-label">Conformes</div>
                                            <div class="fs-4 fw-bold text-success">@Model.MonitoreosConformes</div>
                                        </div>
                                    </div>
                                    <div class="col-6 col-lg-2">
                                        <div class="border rounded-3 p-3 h-100">
                                            <div class="quality-data-label">Hallazgos</div>
                                            <div class="fs-4 fw-bold text-danger">@Model.MonitoreosConHallazgo</div>
                                        </div>
                                    </div>
                                    <div class="col-6 col-lg-2">
                                        <div class="border rounded-3 p-3 h-100">
                                            <div class="quality-data-label">Disposiciones pendientes</div>
                                            <div class="fs-4 fw-bold text-warning">@Model.DisposicionesPendientes</div>
                                        </div>
                                    </div>
                                </div>

                                <div class="row g-3 mb-4">
                                    <div class="col-md-4">
                                        <div class="border rounded-3 p-3 h-100">
                                            <div class="quality-data-label">Avance de revisiones</div>
                                            <div class="d-flex justify-content-between gap-3 mb-2">
                                                <strong>@Model.MonitoreosAtendidos de @Model.TotalMonitoreos</strong>
                                                <strong>@Model.PorcentajeMonitoreosAtendidos.ToString("0.#")%</strong>
                                            </div>
                                            <div class="quality-monitor-progress">
                                                <span style="width:@porcentajeMonitoreoCss%"></span>
                                            </div>
                                        </div>
                                    </div>
                                    <div class="col-md-3">
                                        <div class="border rounded-3 p-3 h-100">
                                            <div class="quality-data-label">Muestra revisada acumulada</div>
                                            <div class="fs-4 fw-bold">@Model.TotalMuestraRevisada</div>
                                        </div>
                                    </div>
                                    <div class="col-md-3">
                                        <div class="border rounded-3 p-3 h-100">
                                            <div class="quality-data-label">Material afectado acumulado</div>
                                            <div class="fs-4 fw-bold text-danger">@Model.TotalMaterialAfectado</div>
                                        </div>
                                    </div>
                                    <div class="col-md-2">
                                        <div class="border rounded-3 p-3 h-100">
                                            <div class="quality-data-label">Próximo</div>
                                            <div class="fw-bold">
                                                @(Model.ProximoMonitoreo?.ToString("dd/MM HH:mm") ?? "Sin pendiente")
                                            </div>
                                        </div>
                                    </div>
                                </div>

                                <div class="d-grid gap-3">
                                    @foreach (var monitor in Model.Monitoreos)
                                    {
                                        var monitorClase = monitor.Resultado switch
                                        {
                                            CalidadResultadoMonitoreo.Conforme => "border-success",
                                            CalidadResultadoMonitoreo.Sospechoso => "border-warning",
                                            CalidadResultadoMonitoreo.NoConforme => "border-danger",
                                            CalidadResultadoMonitoreo.Reinspeccion => "border-info",
                                            _ when monitor.EstaVencido => "border-danger",
                                            _ => "border-secondary"
                                        };

                                        <article class="border @monitorClase rounded-3 p-3">
                                            <div class="d-flex flex-wrap justify-content-between align-items-start gap-3 mb-3">
                                                <div>
                                                    <h3 class="h6 fw-bold mb-1">
                                                        Revisión hora @monitor.NumeroHora
                                                    </h3>
                                                    <div class="quality-help">
                                                        Programada: @monitor.FechaHoraProgramada.ToString("dd/MM/yyyy HH:mm")
                                                        @if (monitor.EstaVencido)
                                                        {
                                                            <span class="text-danger fw-bold"> · Vencida</span>
                                                        }
                                                    </div>
                                                </div>
                                                <span class="badge @monitor.ResultadoBadgeClase">
                                                    @monitor.ResultadoTexto
                                                </span>
                                            </div>

                                            <div class="row g-3 mb-3">
                                                <div class="col-md-3">
                                                    <div class="quality-data-label">Captura vinculada</div>
                                                    <div class="fw-semibold">@monitor.RangoProduccion</div>
                                                </div>
                                                <div class="col-md-2">
                                                    <div class="quality-data-label">OK reportado</div>
                                                    <div class="fw-bold text-success">@monitor.CantidadOKProduccion</div>
                                                </div>
                                                <div class="col-md-2">
                                                    <div class="quality-data-label">Sospechoso reportado</div>
                                                    <div class="fw-bold text-warning">@monitor.CantidadSospechosaProduccion</div>
                                                </div>
                                                <div class="col-md-2">
                                                    <div class="quality-data-label">Scrap reportado</div>
                                                    <div class="fw-bold text-danger">@monitor.CantidadScrapProduccion</div>
                                                </div>
                                                <div class="col-md-3">
                                                    <div class="quality-data-label">Total del periodo</div>
                                                    <div class="fw-bold">@monitor.CantidadProducidaPeriodo</div>
                                                </div>
                                            </div>

                                            @if (!string.IsNullOrWhiteSpace(monitor.ObservacionesProduccion))
                                            {
                                                <div class="alert alert-info py-2 mb-3">
                                                    <strong>Observación de Producción:</strong>
                                                    <span style="white-space: pre-wrap;">@monitor.ObservacionesProduccion</span>
                                                </div>
                                            }

                                            @if (monitor.PuedeCapturar && estado == CalidadEstados.MonitoreoActivo)
                                            {
                                                <form asp-controller="Calidad"
                                                      asp-action="RegistrarMonitoreo"
                                                      method="post"
                                                      class="monitor-form"
                                                      data-monitor-form
                                                      data-max-produccion="@monitor.CantidadProducidaPeriodo">
                                                    @Html.AntiForgeryToken()
                                                    <input type="hidden" name="MonitoreoID" value="@monitor.MonitoreoID" />
                                                    <input type="hidden" name="InspeccionID" value="@Model.InspeccionID" />
                                                    <input type="hidden" name="Resultado" value="" data-monitor-result-value />

                                                    <div class="row g-3">
                                                        <div class="col-md-3">
                                                            <label class="form-label fw-semibold">Muestra revisada</label>
                                                            <input type="number"
                                                                   name="CantidadRevisadaMuestra"
                                                                   min="1"
                                                                   max="@monitor.CantidadProducidaPeriodo"
                                                                   class="form-control"
                                                                   data-monitor-muestra
                                                                   required />
                                                            <div class="quality-help">
                                                                Máximo disponible: @monitor.CantidadProducidaPeriodo.
                                                            </div>
                                                        </div>

                                                        <div class="col-md-9">
                                                            <label class="form-label fw-semibold">Resultado de la revisión</label>
                                                            <div class="quality-monitor-result-grid">
                                                                <label class="quality-monitor-result-choice is-conforme">
                                                                    <input type="radio"
                                                                           name="ResultadoVisual_@monitor.MonitoreoID"
                                                                           value="@CalidadResultadoMonitoreo.Conforme"
                                                                           data-monitor-result-option />
                                                                    <span class="quality-monitor-result-card">
                                                                        <strong><i class="fa-solid fa-circle-check"></i> Conforme</strong>
                                                                        <small>La muestra no presenta hallazgos.</small>
                                                                    </span>
                                                                </label>

                                                                <label class="quality-monitor-result-choice is-sospechoso">
                                                                    <input type="radio"
                                                                           name="ResultadoVisual_@monitor.MonitoreoID"
                                                                           value="@CalidadResultadoMonitoreo.Sospechoso"
                                                                           data-monitor-result-option />
                                                                    <span class="quality-monitor-result-card">
                                                                        <strong><i class="fa-solid fa-triangle-exclamation"></i> Sospechoso</strong>
                                                                        <small>Se separa material para selección o retrabajo.</small>
                                                                    </span>
                                                                </label>

                                                                <label class="quality-monitor-result-choice is-noconforme">
                                                                    <input type="radio"
                                                                           name="ResultadoVisual_@monitor.MonitoreoID"
                                                                           value="@CalidadResultadoMonitoreo.NoConforme"
                                                                           data-monitor-result-option />
                                                                    <span class="quality-monitor-result-card">
                                                                        <strong><i class="fa-solid fa-circle-xmark"></i> No conforme</strong>
                                                                        <small>El hallazgo requiere bloqueo y disposición.</small>
                                                                    </span>
                                                                </label>
                                                            </div>
                                                        </div>
                                                    </div>

                                                    <div class="row g-3 mt-1"
                                                         data-monitor-hallazgo
                                                         hidden>
                                                        <div class="col-md-4">
                                                            <label class="form-label fw-semibold">Defecto del catálogo</label>
                                                            <select name="DefectoCodigo"
                                                                    class="form-select"
                                                                    data-monitor-defecto-codigo>
                                                                <option value="">Selecciona...</option>
                                                                @foreach (var defecto in Model.CatalogoDefectos)
                                                                {
                                                                    <option value="@defecto.Codigo">@defecto.Texto</option>
                                                                }
                                                            </select>
                                                        </div>
                                                        <div class="col-md-4">
                                                            <label class="form-label fw-semibold">Descripción adicional</label>
                                                            <input type="text"
                                                                   name="DefectoDescripcion"
                                                                   maxlength="500"
                                                                   class="form-control"
                                                                   data-monitor-defecto-descripcion
                                                                   placeholder="Detalle adicional del hallazgo..." />
                                                        </div>
                                                        <div class="col-md-2">
                                                            <label class="form-label fw-semibold">Cantidad sospechosa</label>
                                                            <input type="number"
                                                                   name="CantidadSospechosa"
                                                                   min="0"
                                                                   max="@monitor.CantidadProducidaPeriodo"
                                                                   value="0"
                                                                   class="form-control"
                                                                   data-monitor-sospechosa />
                                                        </div>
                                                        <div class="col-md-2">
                                                            <label class="form-label fw-semibold">No recuperable</label>
                                                            <input type="number"
                                                                   name="CantidadNoRecuperable"
                                                                   min="0"
                                                                   max="@monitor.CantidadProducidaPeriodo"
                                                                   value="0"
                                                                   class="form-control"
                                                                   data-monitor-norecuperable />
                                                        </div>

                                                        <div class="col-md-6">
                                                            <label class="form-label fw-semibold">Tratamiento principal</label>
                                                            <input type="hidden"
                                                                   name="RequiereSeleccion"
                                                                   value="false"
                                                                   data-monitor-seleccion-value />
                                                            <input type="hidden"
                                                                   name="RequiereRetrabajo"
                                                                   value="false"
                                                                   data-monitor-retrabajo-value />

                                                            <div class="quality-monitor-treatment-grid">
                                                                <label class="quality-monitor-treatment-option">
                                                                    <input type="radio"
                                                                           name="TratamientoVisual_@monitor.MonitoreoID"
                                                                           value="SELECCION"
                                                                           data-monitor-treatment />
                                                                    <span>
                                                                        <strong>Selección</strong><br />
                                                                        <small class="text-muted">Calidad separa y revisa el material.</small>
                                                                    </span>
                                                                </label>

                                                                <label class="quality-monitor-treatment-option">
                                                                    <input type="radio"
                                                                           name="TratamientoVisual_@monitor.MonitoreoID"
                                                                           value="RETRABAJO"
                                                                           data-monitor-treatment />
                                                                    <span>
                                                                        <strong>Retrabajo</strong><br />
                                                                        <small class="text-muted">Se corrige el material antes de reinspección.</small>
                                                                    </span>
                                                                </label>
                                                            </div>
                                                        </div>

                                                        <div class="col-md-6"
                                                             data-monitor-responsable
                                                             hidden>
                                                            <label class="form-label fw-semibold">Responsable del retrabajo</label>
                                                            <select name="ResponsableRetrabajo"
                                                                    class="form-select"
                                                                    data-monitor-responsable-select>
                                                                <option value="">Selecciona...</option>
                                                                <option value="@CalidadResponsable.Produccion">Producción</option>
                                                                <option value="@CalidadResponsable.Calidad">Calidad</option>
                                                            </select>
                                                        </div>
                                                    </div>

                                                    <div class="mt-3">
                                                        <label class="form-label fw-semibold">Observaciones de Calidad</label>
                                                        <textarea name="Observaciones"
                                                                  rows="3"
                                                                  maxlength="1000"
                                                                  class="form-control"
                                                                  data-monitor-observaciones
                                                                  placeholder="Describe mediciones, hallazgos o evidencia de la revisión..."></textarea>
                                                        <div class="quality-help">
                                                            Obligatorio para resultados no conformes.
                                                        </div>
                                                    </div>

                                                    <div class="mt-3 text-end">
                                                        <button type="submit"
                                                                class="quality-btn quality-btn-primary"
                                                                data-submit-confirm="¿Confirmas el resultado de esta revisión horaria?">
                                                            <i class="fa-solid fa-floppy-disk"></i>
                                                            Guardar revisión
                                                        </button>
                                                    </div>
                                                </form>
                                            }
                                            else if (monitor.EsPendiente && !monitor.TieneRegistroProduccion)
                                            {
                                                <div class="alert alert-secondary mb-0">
                                                    <i class="fa-solid fa-hourglass-half"></i>
                                                    Este periodo está esperando una captura horaria para habilitar la revisión de Calidad.
                                                </div>
                                            }
                                            else if (monitor.EsPendiente && monitor.TieneRegistroProduccion && monitor.CantidadProducidaPeriodo <= 0)
                                            {
                                                <div class="alert alert-warning mb-0">
                                                    La captura vinculada no contiene piezas producidas. No hay muestra disponible para revisar.
                                                </div>
                                            }
                                            else
                                            {
                                                <div class="row g-3">
                                                    <div class="col-md-2">
                                                        <div class="quality-data-label">Muestra</div>
                                                        <div class="fw-bold">@monitor.CantidadRevisadaMuestra</div>
                                                    </div>
                                                    <div class="col-md-3">
                                                        <div class="quality-data-label">Defecto</div>
                                                        <div class="fw-semibold">@Mostrar(monitor.DefectoCodigo)</div>
                                                        <div class="quality-help">@Mostrar(monitor.DefectoDescripcion)</div>
                                                    </div>
                                                    <div class="col-md-2">
                                                        <div class="quality-data-label">Afectado</div>
                                                        <div class="fw-bold">@monitor.CantidadAfectadaCalidad</div>
                                                    </div>
                                                    <div class="col-md-2">
                                                        <div class="quality-data-label">Tratamiento</div>
                                                        <div class="fw-semibold">
                                                            @(monitor.RequiereRetrabajo ? "Retrabajo" : monitor.RequiereSeleccion ? "Selección" : "No aplica")
                                                        </div>
                                                        @if (!string.IsNullOrWhiteSpace(monitor.ResponsableRetrabajo))
                                                        {
                                                            <div class="quality-help">Responsable: @monitor.ResponsableRetrabajo</div>
                                                        }
                                                    </div>
                                                    <div class="col-md-3">
                                                        <div class="quality-data-label">Revisado</div>
                                                        <div class="fw-semibold">
                                                            @(monitor.FechaHoraRevision?.ToString("dd/MM/yyyy HH:mm") ?? "Pendiente")
                                                        </div>
                                                    </div>
                                                </div>
