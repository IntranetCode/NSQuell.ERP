    .quality-tab.is-active .quality-tab-badge {
        background: rgba(255,255,255,.18)
    }

    .quality-tab-panel {
        display: none
    }

        .quality-tab-panel.is-active {
            display: block
        }

    .quality-operational-actions {
        margin: 0 0 20px;
        padding: 16px 18px;
        border: 1px solid var(--qd-border);
        border-radius: 12px;
        background: #fff
    }

    .quality-operational-actions-head {
        display: flex;
        justify-content: space-between;
        align-items: flex-start;
        gap: 16px;
        margin-bottom: 14px
    }

    .quality-operational-actions h2 {
        margin: 0;
        color: var(--qd-navy);
        font-size: 1rem;
        font-weight: 850
    }

    .quality-operational-actions p {
        margin: 5px 0 0;
        color: var(--qd-muted);
        font-size: .8rem
    }

    .quality-actions-row {
        display: flex;
        flex-wrap: wrap;
        align-items: flex-end;
        gap: 12px
    }

    .quality-action-form {
        display: flex;
        flex: 1 1 300px;
        align-items: flex-end;
        gap: 10px
    }

    .quality-action-field {
        flex: 1 1 240px
    }

    .quality-action-label {
        display: block;
        margin-bottom: 5px;
        color: #475569;
        font-size: .72rem;
        font-weight: 800;
        text-transform: uppercase
    }

    .quality-action-input {
        width: 100%;
        min-height: 40px;
        padding: 8px 11px;
        border: 1px solid #cfd8e3;
        border-radius: 8px;
        background: #fff;
        color: #1e293b
    }

    .quality-action-button {
        min-height: 40px;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: 8px;
        padding: 9px 14px;
        border: 1px solid transparent;
        border-radius: 8px;
        font-size: .82rem;
        font-weight: 800;
        white-space: nowrap;
        cursor: pointer
    }

        .quality-action-button.is-success {
            background: #15803d;
            color: #fff;
            border-color: #15803d
        }

        .quality-action-button.is-warning {
            background: #d97706;
            color: #fff;
            border-color: #d97706
        }

        .quality-action-button.is-danger {
            background: #b91c1c;
            color: #fff;
            border-color: #b91c1c
        }

        .quality-action-button:disabled {
            cursor: not-allowed;
            opacity: .48
        }

    .quality-action-help {
        width: 100%;
        margin-top: 2px;
        color: var(--qd-muted);
        font-size: .76rem;
        line-height: 1.45
    }

    .quality-invalid-notice {
        padding: 14px 16px;
        border: 1px solid #fecaca;
        border-radius: 10px;
        background: #fff1f1;
        color: #991b1b;
        font-weight: 700
    }

