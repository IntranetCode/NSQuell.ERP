    }

    .quality-reliberation-data {
        min-width: 0;
        padding: 13px 14px;
        border: 1px solid #fed7aa;
        border-radius: 12px;
        background: rgba(255, 255, 255, .88);
    }

    .quality-reliberation-message {
        margin-top: 14px;
        padding: 13px 15px;
        border-radius: 12px;
        font-weight: 600;
    }

    .quality-reliberation-message.is-pending {
        color: #854d0e;
        border: 1px solid #fde68a;
