    @@media (max-width: 1100px) {
        .quality-grid {
            grid-template-columns: 1fr;
        }

        .quality-data-grid {
            grid-template-columns: repeat(2, minmax(0, 1fr));
        }
    }

    @@media (max-width: 720px) {
        .quality-detail-page {
            padding-left: 4px;
            padding-right: 4px;
        }

        .quality-detail-header {
            flex-direction: column;
            padding: 20px;
        }

        .quality-header-actions {
            width: 100%;
            justify-content: flex-start;
        }

        .quality-progress {
            padding: 18px 8px;
        }

        .quality-progress-step {
            font-size: .68rem;
        }

        .quality-progress-circle {
            width: 31px;
            height: 31px;
        }

        .quality-progress-step:not(:last-child)::after {
            top: 15px;
            left: calc(50% + 18px);
            width: calc(100% - 36px);
        }

        .quality-data-grid,
        .quality-form-grid {
            grid-template-columns: 1fr;
        }

        .quality-data-item.wide {
            grid-column: auto;
        }

        .quality-card-body {
            padding: 15px;
        }

        .quality-form-actions {
            flex-direction: column;
        }

        .quality-form-actions .quality-btn {
            width: 100%;
        }
    }


    .quality-monitor-result-grid {
        display: grid;
        grid-template-columns: repeat(3, minmax(0, 1fr));
        gap: 10px;
    }

    .quality-monitor-result-choice {
        position: relative;
        cursor: pointer;
        margin: 0;
    }

    .quality-monitor-result-choice > input {
        position: absolute;
        opacity: 0;
        pointer-events: none;
    }

    .quality-monitor-result-card {
        min-height: 82px;
        border: 1px solid var(--quality-border);
        border-radius: 12px;
        padding: 12px;
        display: flex;
        flex-direction: column;
        justify-content: center;
        gap: 4px;
        background: #fff;
        transition: border-color .18s ease, box-shadow .18s ease, transform .18s ease;
    }

    .quality-monitor-result-card strong {
        font-size: .92rem;
    }

    .quality-monitor-result-card small {
        color: var(--quality-muted);
        line-height: 1.25;
    }

    .quality-monitor-result-choice:hover .quality-monitor-result-card {
        transform: translateY(-1px);
        box-shadow: 0 7px 18px rgba(15, 23, 42, .08);
    }

    .quality-monitor-result-choice.is-conforme > input:checked + .quality-monitor-result-card {
        border-color: #16a34a;
        box-shadow: 0 0 0 3px rgba(22, 163, 74, .13);
        background: #f0fdf4;
    }

    .quality-monitor-result-choice.is-sospechoso > input:checked + .quality-monitor-result-card {
        border-color: #d97706;
        box-shadow: 0 0 0 3px rgba(217, 119, 6, .13);
        background: #fffbeb;
    }

    .quality-monitor-result-choice.is-noconforme > input:checked + .quality-monitor-result-card {
        border-color: #dc2626;
        box-shadow: 0 0 0 3px rgba(220, 38, 38, .13);
        background: #fef2f2;
    }

    .quality-monitor-treatment-grid {
        display: grid;
        grid-template-columns: repeat(2, minmax(0, 1fr));
        gap: 10px;
    }

    .quality-monitor-treatment-option {
        border: 1px solid var(--quality-border);
        border-radius: 10px;
        padding: 10px 12px;
        display: flex;
        align-items: center;
        gap: 8px;
        cursor: pointer;
        background: #fff;
    }

    .quality-monitor-treatment-option:has(input:checked) {
        border-color: var(--quality-orange);
        box-shadow: 0 0 0 3px rgba(249, 115, 22, .12);
        background: #fff7ed;
    }

    .quality-monitor-empty {
        border: 1px dashed #94a3b8;
        border-radius: 12px;
        padding: 24px;
        text-align: center;
        color: var(--quality-muted);
        background: #f8fafc;
    }

    .quality-monitor-progress {
        height: 8px;
        border-radius: 999px;
        overflow: hidden;
        background: #e2e8f0;
    }

    .quality-monitor-progress > span {
        display: block;
        height: 100%;
        border-radius: inherit;
        background: var(--quality-orange);
    }

    .quality-disposition-balance {
        border-radius: 10px;
        padding: 10px 12px;
        background: #f8fafc;
        border: 1px solid var(--quality-border);
        font-weight: 600;
    }

    .quality-disposition-balance.is-complete {
        color: #166534;
        border-color: #86efac;
        background: #f0fdf4;
    }

    .quality-disposition-balance.is-invalid {
        color: #991b1b;
        border-color: #fca5a5;
        background: #fef2f2;
    }

    .quality-box-validation-grid {
        display: grid;
        grid-template-columns: repeat(3, minmax(0, 1fr));
        gap: 12px;
    }

    .quality-box-validation-item {
        border: 1px solid var(--quality-border);
        border-radius: 12px;
        padding: 12px;
        background: #fff;
    }

    .quality-box-validation-item.is-complete {
        border-color: #86efac;
        background: #f0fdf4;
    }

    .quality-box-validation-item.is-incomplete {
        border-color: #fca5a5;
        background: #fef2f2;
    }

    .quality-box-panel {
        border: 1px solid var(--quality-border);
        border-radius: 12px;
        padding: 14px;
        background: #f8fafc;
    }

    .quality-box-panel[hidden],
    .quality-gp12-defects[hidden] {
        display: none !important;
    }

    .quality-box-submit-note,
    .quality-gp12-balance {
        border-radius: 10px;
        padding: 10px 12px;
        border: 1px solid var(--quality-border);
        background: #f8fafc;
        font-weight: 600;
    }

    .quality-box-submit-note.is-ready,
    .quality-gp12-balance.is-complete {
        color: #166534;
        border-color: #86efac;
        background: #f0fdf4;
    }

    .quality-box-submit-note.is-warning,
    .quality-gp12-balance.is-invalid {
        color: #991b1b;
        border-color: #fca5a5;
        background: #fef2f2;
    }

    .quality-reliberation-panel {
        margin-bottom: 20px;
        border: 1px solid #fdba74;
        border-left: 6px solid #f97316;
        border-radius: 18px;
        background: linear-gradient(135deg, #fff7ed 0%, #ffffff 65%);
        box-shadow: 0 12px 30px rgba(194, 65, 12, .08);
        overflow: hidden;
    }

    .quality-reliberation-header {
        display: flex;
        justify-content: space-between;
        align-items: flex-start;
        gap: 18px;
        padding: 22px 24px 14px;
    }

    .quality-reliberation-title {
        margin: 0;
        color: #9a3412;
        font-size: 1.1rem;
        font-weight: 800;
    }

    .quality-reliberation-title i {
        margin-right: 8px;
    }

    .quality-reliberation-body {
        padding: 0 24px 22px;
    }

    .quality-reliberation-grid {
        display: grid;
        grid-template-columns: repeat(4, minmax(0, 1fr));
