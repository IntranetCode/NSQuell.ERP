                                                        <span class="quality-result-option quality-result-option-ok">Cumple</span>
                                                    </div>
                                                    <div class="quality-result-current" data-box-validation-caption>
                                                        Pendiente de revisión
                                                    </div>
                                                </div>

                                                <div class="quality-box-validation-item" data-box-validation-item>
                                                    <input type="hidden"
                                                           name="TecnicoConfirmoInformacion"
                                                           value="false"
