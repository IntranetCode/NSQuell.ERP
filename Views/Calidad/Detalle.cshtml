                                </div>
                            }

                            @if (puedeTomarDisposicion)
                            {
                                <div class="quality-side-action">
                                    <h3>Enviar a GP12</h3>

                                    <p>
                                        Mantiene el material bloqueado y lo dirige
                                        a inspección reforzada.
                                    </p>

                                    <form asp-controller="Calidad"
                                          asp-action="EnviarGP12"
                                          method="post"
                                          data-confirm="¿Confirmas el envío del material a GP12?">

                                        @Html.AntiForgeryToken()

                                        <input type="hidden"
                                               name="id"
                                               value="@Model.InspeccionID" />

                                        <textarea name="comentario"
                                                  class="quality-form-control mb-3"
                                                  maxlength="1000"
                                                  placeholder="Motivo del envío a GP12..."></textarea>

                                        <button type="submit"
                                                class="quality-btn quality-btn-warning">
                                            <i class="fa-solid fa-magnifying-glass-plus"></i>
                                            Enviar a GP12
                                        </button>
                                    </form>
                                </div>

                                <div class="quality-side-action">
                                    <h3>Material no conforme</h3>

                                    <p>
                                        Bloquea el material mediante etiqueta roja.
                                        Esta acción no lo convierte automáticamente en scrap.
                                    </p>

                                    <form asp-controller="Calidad"
                                          asp-action="EnviarContencion"
                                          method="post"
                                          data-confirm="¿Confirmas que el material debe identificarse como no conforme?">

                                        @Html.AntiForgeryToken()

                                        <input type="hidden"
                                               name="id"
                                               value="@Model.InspeccionID" />

                                        <textarea name="comentario"
                                                  class="quality-form-control mb-3"
                                                  maxlength="1000"
                                                  placeholder="Describe la no conformidad..."></textarea>

                                        <button type="submit"
                                                class="quality-btn quality-btn-danger">
                                            <i class="fa-solid fa-ban"></i>
                                            Bloquear material
                                        </button>
                                    </form>
                                </div>
                            }

                            <div class="quality-side-action">
                                <h3>Cierre final</h3>

                                <p>
                                    @(puedeCerrar
                                        ? "Todos los requisitos están completos. Revisa la sección final y confirma el cierre."
                                        : "Consulta los requisitos pendientes y completa el resguardo de muestras.")
                                </p>

                                <a href="#cierre-calidad"
                                   class="quality-btn @(puedeCerrar ? "quality-btn-dark" : "quality-btn-warning")">
                                    <i class="fa-solid @(puedeCerrar ? "fa-lock" : "fa-list-check")"></i>
                                    @(puedeCerrar ? "Ir al cierre" : "Revisar pendientes")
                                </a>
                            </div>

                        }
                    </div>
                </section>

                <section class="quality-card">
                    <div class="quality-card-header">
                        <h2>
                            <i class="fa-solid fa-flag"></i>
                            Resultado actual
                        </h2>
                    </div>

                    <div class="quality-card-body">
                        <div class="quality-data-grid"
                             style="grid-template-columns: 1fr;">
                            <div class="quality-data-item">
                                <span class="quality-data-label">Resultado</span>
                                <span class="quality-data-value">
                                    @Mostrar(Model.ResultadoCalidad)
                                </span>
                            </div>

                            <div class="quality-data-item">
                                <span class="quality-data-label">Etiqueta</span>
                                <span class="quality-data-value">
                                    @Mostrar(Model.Etiqueta)
                                </span>
                            </div>

                            <div class="quality-data-item">
                                <span class="quality-data-label">Requiere GP12</span>
                                <span class="quality-data-value">
                                    @(Model.RequiereGP12 ? "Sí" : "No")
                                </span>
                            </div>

                            <div class="quality-data-item">
                                <span class="quality-data-label">En contención</span>
                                <span class="quality-data-value">
                                    @(Model.EnContencion ? "Sí" : "No")
                                </span>
                            </div>

                            <div class="quality-data-item">
                                <span class="quality-data-label">Fecha de liberación</span>
                                <span class="quality-data-value">
                                    @(Model.FechaLiberacionProduccion?.ToString("dd/MM/yyyy HH:mm") ?? "—")
                                </span>
                            </div>

                            <div class="quality-data-item">
                                <span class="quality-data-label">Fecha de cierre</span>
                                <span class="quality-data-value">
                                    @(Model.FechaCierre?.ToString("dd/MM/yyyy HH:mm") ?? "—")
                                </span>
                            </div>
                        </div>
                    </div>
                </section>

                @if (!string.IsNullOrWhiteSpace(Model.Observaciones))
                {
                    <section class="quality-card">
                        <div class="quality-card-header">
                            <h2>
                                <i class="fa-solid fa-note-sticky"></i>
                                Observaciones
                            </h2>
                        </div>

                        <div class="quality-card-body">
                            <div style="white-space: pre-wrap; overflow-wrap: anywhere;">
                                @Model.Observaciones
                            </div>
                        </div>
                    </section>
                }

                <section class="quality-card">
                    <div class="quality-card-header">
                        <h2>
                            <i class="fa-solid fa-circle-info"></i>
                            Auditoría
                        </h2>
                    </div>

                    <div class="quality-card-body">
                        <div class="quality-data-grid"
                             style="grid-template-columns: 1fr;">
                            <div class="quality-data-item">
                                <span class="quality-data-label">Creación</span>
                                <span class="quality-data-value">
                                    @Model.FechaCreacion.ToString("dd/MM/yyyy HH:mm")
                                </span>
                            </div>

                            <div class="quality-data-item">
                                <span class="quality-data-label">Usuario creador</span>
                                <span class="quality-data-value">
                                    @(Model.UsuarioCreacionID?.ToString() ?? "—")
                                </span>
                            </div>

                            <div class="quality-data-item">
                                <span class="quality-data-label">Última modificación</span>
                                <span class="quality-data-value">
                                    @(Model.FechaModificacion?.ToString("dd/MM/yyyy HH:mm") ?? "—")
                                </span>
                            </div>

                            <div class="quality-data-item">
                                <span class="quality-data-label">Usuario modificación</span>
                                <span class="quality-data-value">
                                    @(Model.UsuarioModificacionID?.ToString() ?? "—")
                                </span>
                            </div>
                        </div>
                    </div>
                </section>
            </aside>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />

    <script>
        document.addEventListener('DOMContentLoaded', function () {
            function actualizarResultadoChecklist(contenedor) {
                const interruptor = contenedor.querySelector('[data-result-switch]');
                const noAplica = contenedor.querySelector('[data-result-na]');
                const valor = contenedor.querySelector('[data-result-value]');
                const observacion = contenedor.querySelector('[data-result-observation]');
                const leyenda = contenedor.querySelector('[data-result-caption]');
                const ayuda = contenedor.querySelector('[data-observation-help]');

                if (!interruptor || !noAplica || !valor || !observacion) {
                    return;
                }

                let resultado;

                if (noAplica.checked) {
                    resultado = 'NA';
                    interruptor.disabled = true;
                } else {
                    interruptor.disabled = false;
                    resultado = interruptor.checked ? 'OK' : 'NOK';
                }

                valor.value = resultado;
                contenedor.classList.toggle('is-nok', resultado === 'NOK');
                contenedor.classList.toggle('is-na', resultado === 'NA');

                const habilitarObservacion = resultado === 'NOK' || resultado === 'NA';
                observacion.readOnly = !habilitarObservacion;
                observacion.setAttribute('aria-readonly', habilitarObservacion ? 'false' : 'true');
                observacion.classList.toggle('is-locked', !habilitarObservacion);

                if (resultado === 'NOK') {
                    observacion.placeholder = 'Describe la no conformidad (obligatorio)...';
                    if (leyenda) leyenda.textContent = 'No conforme';
                    if (ayuda) ayuda.textContent = 'La observación es obligatoria para un resultado NOK.';
                } else if (resultado === 'NA') {
                    observacion.placeholder = 'Explica por qué no aplica (opcional)...';
                    if (leyenda) leyenda.textContent = 'No aplica';
                    if (ayuda) ayuda.textContent = 'Puedes documentar por qué esta validación no aplica.';
                } else {
                    observacion.placeholder = 'Se habilita al seleccionar NOK o N/A';
                    if (leyenda) leyenda.textContent = 'Conforme';
                    if (ayuda) ayuda.textContent = 'El campo se habilitará cuando el resultado sea NOK o N/A.';
                }
            }

            document.querySelectorAll('[data-quality-result]').forEach(function (contenedor) {
                const interruptor = contenedor.querySelector('[data-result-switch]');
                const noAplica = contenedor.querySelector('[data-result-na]');

                if (!interruptor || !noAplica) {
                    return;
                }

                actualizarResultadoChecklist(contenedor);

                interruptor.addEventListener('change', function () {
                    actualizarResultadoChecklist(contenedor);
                });

                noAplica.addEventListener('change', function () {
                    if (noAplica.checked) {
                        contenedor.dataset.resultadoAnterior = interruptor.checked ? 'OK' : 'NOK';
                    } else {
                        interruptor.checked = contenedor.dataset.resultadoAnterior !== 'NOK';
                    }

                    actualizarResultadoChecklist(contenedor);
                });
            });

            document.querySelectorAll('form').forEach(function (form) {
                if (!form.querySelector('[data-quality-result]')) {
                    return;
                }

                form.addEventListener('submit', function (event) {
                    let primerError = null;

                    form.querySelectorAll('[data-quality-result]').forEach(function (contenedor) {
                        const valor = contenedor.querySelector('[data-result-value]');
                        const observacion = contenedor.querySelector('[data-result-observation]');

                        if (!valor || !observacion) {
                            return;
                        }

                        const requiereObservacion = valor.value === 'NOK';
                        const faltaObservacion = requiereObservacion && !observacion.value.trim();

                        observacion.classList.toggle('is-invalid', faltaObservacion);

                        if (faltaObservacion && !primerError) {
                            primerError = observacion;
                        }
                    });

                    if (primerError) {
                        event.preventDefault();
                        primerError.focus();
                        primerError.scrollIntoView({ behavior: 'smooth', block: 'center' });
                        window.alert('Las respuestas NOK requieren una observación antes de guardar.');
                    }
                });
            });

            document.querySelectorAll('[data-firstpieces-form]').forEach(function (contenedorFormulario) {
                const formulario = contenedorFormulario.closest('form');
                const observacionGeneral = contenedorFormulario.querySelector('[data-first-general-observation]');
                const ayudaGeneral = contenedorFormulario.querySelector('[data-first-general-help]');
                const contador = contenedorFormulario.querySelector('[data-first-count]');
                const leyendaContador = contenedorFormulario.querySelector('[data-first-count-caption]');
                const ayudaContador = contenedorFormulario.querySelector('[data-first-count-help]');

                function actualizarItemPrimerasPiezas(item) {
                    const interruptor = item.querySelector('[data-first-switch]');
                    const noAplica = item.querySelector('[data-first-na]');
                    const valor = item.querySelector('[data-first-value]');
                    const leyenda = item.querySelector('[data-first-caption]');

                    if (!interruptor || !valor) {
                        return;
                    }

                    let resultado;
                    if (noAplica && noAplica.checked) {
                        resultado = '';
                        interruptor.disabled = true;
                    } else {
                        if (noAplica) {
                            interruptor.disabled = false;
                        }
                        resultado = interruptor.checked ? 'true' : 'false';
                    }

                    valor.value = resultado;
                    item.classList.toggle('is-nok', resultado === 'false');
                    item.classList.toggle('is-na', !!(noAplica && noAplica.checked));

                    if (leyenda) {
                        leyenda.textContent = noAplica && noAplica.checked
                            ? 'No aplica'
                            : (interruptor.checked ? 'Cumple' : 'No cumple');
                    }
                }

                function actualizarFormularioPrimerasPiezas() {
                    let hayNok = false;
                    let hayNa = false;

                    contenedorFormulario.querySelectorAll('[data-first-piece-result]').forEach(function (item) {
                        const valor = item.querySelector('[data-first-value]');
                        if (!valor) {
                            return;
                        }

                        if (valor.value === 'false') {
                            hayNok = true;
                        }
                        if (valor.value === '') {
                            hayNa = true;
                        }
                    });

                    const cantidad = contador ? (parseInt(contador.value || '0', 10) || 0) : 0;
                    const cantidadInsuficiente = cantidad < 3;
                    const habilitarObservacion = hayNok || hayNa || cantidadInsuficiente;

                    if (leyendaContador) {
                        leyendaContador.textContent = cantidadInsuficiente ? 'Menos de 3 conformes' : 'Cumple mínimo';
                        leyendaContador.classList.toggle('quality-result-ok', !cantidadInsuficiente);
                        leyendaContador.classList.toggle('quality-result-nok', cantidadInsuficiente);
                    }

                    if (ayudaContador) {
                        ayudaContador.textContent = cantidadInsuficiente
                            ? 'Debes documentar el motivo: se requieren al menos tres disparos conformes.'
                            : 'Se cumplen los disparos mínimos requeridos para continuar.';
                    }

                    if (observacionGeneral) {
                        observacionGeneral.readOnly = !habilitarObservacion;
                        observacionGeneral.setAttribute('aria-readonly', habilitarObservacion ? 'false' : 'true');
                        observacionGeneral.classList.toggle('is-locked', !habilitarObservacion);

                        if (hayNok || cantidadInsuficiente) {
                            observacionGeneral.placeholder = 'Describe la no conformidad o el ajuste requerido...';
                            if (ayudaGeneral) {
                                ayudaGeneral.textContent = 'Documenta aquí la causa del No cumple o por qué hay menos de 3 disparos conformes.';
                            }
                        } else if (hayNa) {
                            observacionGeneral.placeholder = 'Explica por qué la validación no aplica...';
                            if (ayudaGeneral) {
                                ayudaGeneral.textContent = 'Documenta aquí el motivo por el que no aplica.';
                            }
                        } else {
                            observacionGeneral.placeholder = 'Se habilita cuando exista algún No cumple, No aplica o menos de 3 disparos conformes';
                            if (ayudaGeneral) {
                                ayudaGeneral.textContent = 'Las observaciones se habilitarán cuando exista un No cumple, un No aplica o menos de 3 disparos conformes.';
                            }
                        }
                    }
                }

                contenedorFormulario.querySelectorAll('[data-first-piece-result]').forEach(function (item) {
                    const interruptor = item.querySelector('[data-first-switch]');
                    const noAplica = item.querySelector('[data-first-na]');

                    actualizarItemPrimerasPiezas(item);

                    if (interruptor) {
                        interruptor.addEventListener('change', function () {
                            actualizarItemPrimerasPiezas(item);
                            actualizarFormularioPrimerasPiezas();
                        });
                    }

                    if (noAplica) {
                        noAplica.addEventListener('change', function () {
                            if (noAplica.checked) {
                                item.dataset.resultadoAnterior = interruptor && interruptor.checked ? 'OK' : 'NOK';
                            } else if (interruptor) {
                                interruptor.checked = item.dataset.resultadoAnterior !== 'NOK';
                            }

                            actualizarItemPrimerasPiezas(item);
                            actualizarFormularioPrimerasPiezas();
                        });
                    }
                });

                if (contador) {
                    contador.addEventListener('input', actualizarFormularioPrimerasPiezas);
                    contador.addEventListener('change', actualizarFormularioPrimerasPiezas);
                }

                actualizarFormularioPrimerasPiezas();

                if (formulario) {
                    formulario.addEventListener('submit', function (event) {
                        const submitter = event.submitter;
                        if (!submitter) {
                            return;
                        }

                        const accion = submitter.dataset.firstpiecesAction;
                        const observaciones = (observacionGeneral && observacionGeneral.value ? observacionGeneral.value.trim() : '');
                        const segregadosValor = contenedorFormulario.querySelector('input[name="CincoDisparosSegregados"]')?.value;
                        const cantidad = contador ? (parseInt(contador.value || '0', 10) || 0) : 0;

                        if (accion === 'guardar' && segregadosValor !== 'true') {
                            event.preventDefault();
                            window.alert('Debes confirmar que los primeros cinco disparos fueron segregados para guardar la validación.');
                            return;
                        }

                        if (accion === 'ajustes' && !observaciones) {
                            event.preventDefault();
                            if (observacionGeneral) {
                                observacionGeneral.focus();
                            }
                            window.alert('Describe los ajustes requeridos antes de enviar la solicitud a Producción.');
                        }
                    });
                }
            });

            document.querySelectorAll('[data-sample-form]').forEach(function (form) {
                const qualityConfirm = form.querySelector('[data-sample-confirm="quality"]');
                const productionConfirm = form.querySelector('[data-sample-confirm="production"]');
                const qualityLocation = form.querySelector('[data-sample-location="quality"]');
                const productionLocation = form.querySelector('[data-sample-location="production"]');

                function sincronizarMuestra() {
                    if (qualityLocation && qualityConfirm) {
                        qualityLocation.required = qualityConfirm.checked;
                        qualityLocation.classList.toggle(
                            'is-invalid',
                            qualityConfirm.checked && !qualityLocation.value.trim());
                    }

                    if (productionLocation && productionConfirm) {
                        productionLocation.required = productionConfirm.checked;
                        productionLocation.classList.toggle(
                            'is-invalid',
                            productionConfirm.checked && !productionLocation.value.trim());
                    }
                }

                [qualityConfirm, productionConfirm, qualityLocation, productionLocation]
                    .filter(Boolean)
                    .forEach(function (element) {
                        element.addEventListener('change', sincronizarMuestra);
                        element.addEventListener('input', sincronizarMuestra);
                    });

                sincronizarMuestra();

                form.addEventListener('submit', function (event) {
                    const qualityChecked = !!(qualityConfirm && qualityConfirm.checked);
                    const productionChecked = !!(productionConfirm && productionConfirm.checked);

                    sincronizarMuestra();

                    if (!qualityChecked && !productionChecked) {
                        event.preventDefault();
                        window.alert('Confirma al menos una muestra antes de guardar el resguardo.');
                        return;
                    }

                    if ((qualityChecked && qualityLocation && !qualityLocation.value.trim()) ||
                        (productionChecked && productionLocation && !productionLocation.value.trim())) {
                        event.preventDefault();
                        window.alert('Captura la ubicación de cada muestra confirmada.');
                    }
                });
            });

            document.querySelectorAll('form[data-confirm]').forEach(function (form) {
                form.addEventListener('submit', function (event) {
                    const message = form.dataset.confirm;

                    if (message && !window.confirm(message)) {
                        event.preventDefault();
                    }
                });
            });

            document.querySelectorAll('[data-submit-confirm]').forEach(function (button) {
                button.addEventListener('click', function (event) {
                    const message = button.dataset.submitConfirm;

                    if (message && !window.confirm(message)) {
                        event.preventDefault();
                    }
                });
            });
        });
    </script>
}