@model ERP.NSQuell.Models.ViewModels.CalidadDetalleViewModel
@using ERP.NSQuell.Models

@{
    ViewData["Title"] = "Detalle de Calidad";

    string Mostrar(string? valor)
    {
        return string.IsNullOrWhiteSpace(valor)
            ? "—"
            : valor;
    }

    string ResultadoNullable(bool? valor)
    {
        return valor switch
        {
            true => "Cumple",
            false => "No cumple",
            _ => "No aplica / pendiente"
        };
    }

    string ClaseResultadoNullable(bool? valor)
    {
        return valor switch
        {
            true => "quality-result-ok",
            false => "quality-result-nok",
            _ => "quality-result-na"
        };
    }

    string ClaseEstadoCaja(int estadoCajaId)
    {
        return estadoCajaId switch
        {
            2 => "bg-warning text-dark",
            3 => "bg-success",
            4 => "bg-warning text-dark",
            5 => "bg-success",
            6 => "bg-primary",
            _ => "bg-secondary"
        };
    }

    var estado = (Model.Estado ?? string.Empty)
        .Trim()
        .ToUpperInvariant();

    var esReliberacion = Model.EsReliberacion;
    var ultimaReliberacion = Model.UltimaReliberacion;
    var muestraFinProduccion = Model.MuestraFinProduccion;

    var confirmacionAjustes = esReliberacion
        ? "¿Confirmas que deseas rechazar la reliberación y solicitar nuevas primeras piezas?"
        : "¿Confirmas que deseas solicitar ajustes a Producción?";

    var confirmacionLiberacion = esReliberacion
        ? "¿Confirmas que las primeras piezas cumplen y deseas autorizar la reliberación?"
        : "¿Confirmas que las primeras piezas cumplen y deseas liberar la producción?";

    var estadoTexto = estado switch
    {
        CalidadEstados.PendientePrearranque =>
            "Pendiente de prearranque",

        CalidadEstados.DevueltoPrearranque =>
            "Devuelto a Producción",

        CalidadEstados.ArranqueAutorizado =>
            "Arranque autorizado",

        CalidadEstados.PendientePrimerasPiezas =>
            "Primeras piezas en revisión",

        CalidadEstados.AjustesSolicitados =>
            "Ajustes solicitados",

        CalidadEstados.ProduccionLiberada =>
            "Producción liberada",

        CalidadEstados.MonitoreoActivo =>
            "Monitoreo horario activo",

        CalidadEstados.PendienteLiberacionCaja =>
            "Pendiente de liberación de caja",

        CalidadEstados.CajaLiberada =>
            "Caja liberada",

        CalidadEstados.PendienteReliberacion =>
            "Pendiente de reliberación",

        CalidadEstados.PendienteGP12 =>
            "Pendiente de GP12",

        CalidadEstados.EnGP12 =>
            "En GP12",

        CalidadEstados.MaterialLiberado =>
            "Material liberado",

        CalidadEstados.MaterialNoConforme =>
            "Material no conforme",

        CalidadEstados.Cerrada =>
            "Cerrada",

        CalidadEstados.LegacyAbierta =>
            "Inspección abierta",

        CalidadEstados.LegacyLiberada =>
            "Liberada",

        CalidadEstados.LegacyGPI2 =>
            "GPI2 / registro anterior",

        CalidadEstados.LegacyContencion =>
            "Contención",

        CalidadEstados.LegacyScrap =>
            "Scrap / registro anterior",

        CalidadEstados.LegacyDetenida =>
            "Detenida",

        _ => string.IsNullOrWhiteSpace(estado)
            ? "Sin estado"
            : estado.Replace("_", " ")
    };

    var estadoClase = estado switch
    {
        CalidadEstados.PendientePrearranque =>
            "quality-state-warning",

        CalidadEstados.DevueltoPrearranque =>
            "quality-state-danger",

        CalidadEstados.ArranqueAutorizado =>
            "quality-state-info",

        CalidadEstados.PendientePrimerasPiezas =>
            "quality-state-info",

        CalidadEstados.AjustesSolicitados =>
            "quality-state-danger",

        CalidadEstados.ProduccionLiberada =>
            "quality-state-success",

        CalidadEstados.MonitoreoActivo =>
            "quality-state-success",

        CalidadEstados.PendienteLiberacionCaja =>
            "quality-state-warning",

        CalidadEstados.CajaLiberada =>
            "quality-state-success",

        CalidadEstados.PendienteReliberacion =>
            "quality-state-danger",

        CalidadEstados.MaterialLiberado =>
            "quality-state-success",

        CalidadEstados.PendienteGP12 =>
            "quality-state-warning",

        CalidadEstados.EnGP12 =>
            "quality-state-warning",

        CalidadEstados.MaterialNoConforme =>
            "quality-state-danger",

        CalidadEstados.Cerrada =>
            "quality-state-dark",

        _ => "quality-state-neutral"
    };

    var puedePrearranque =
        !Model.ConfiguracionInvalidada &&
        (
            estado == CalidadEstados.PendientePrearranque ||
            estado == CalidadEstados.DevueltoPrearranque
        );

    var puedeRegistrarPrimerasPiezas =
        !Model.ConfiguracionInvalidada &&
        (
            estado == CalidadEstados.ArranqueAutorizado ||
            estado == CalidadEstados.PendientePrimerasPiezas ||
            estado == CalidadEstados.AjustesSolicitados
        );

    var puedeLiberarProduccion =
        !Model.ConfiguracionInvalidada &&
        (
            estado == CalidadEstados.PendientePrimerasPiezas ||
            estado == CalidadEstados.AjustesSolicitados ||
            estado == CalidadEstados.LegacyAbierta
        );

    var datosSuficientesLiberacion =
        Model.CincoDisparosSegregados &&
        Model.CantidadDisparosConformes >= 3 &&
        Model.ValidacionDimensional == true &&
        Model.ValidacionApariencia == true &&
        Model.ValidacionGauge != false &&
        Model.ValidacionConductividad != false;

    var reliberacionListaParaAutorizar =
        !esReliberacion || Model.TieneReliberacionPendiente;

    // En el flujo nuevo GP12 se decide por caja, despues del monitoreo y empaque.
    // Las acciones antiguas solo permanecen visibles para registros heredados.
    var puedeTomarDisposicion =
        estado == CalidadEstados.LegacyAbierta ||
        estado == CalidadEstados.LegacyLiberada ||
        estado == CalidadEstados.LegacyGPI2 ||
        estado == CalidadEstados.LegacyContencion;

    var puedeCerrar =
        estado != CalidadEstados.Cerrada &&
        Model.Cierre.PuedeCerrar;

    var hayValidacionPrimerasPiezas =
        Model.FechaValidacionPrimerasPiezas.HasValue ||
        Model.CincoDisparosSegregados ||
        Model.CantidadDisparosConformes > 0 ||
        Model.ValidacionDimensional.HasValue ||
        Model.ValidacionApariencia.HasValue ||
        Model.ValidacionGauge.HasValue ||
        Model.ValidacionConductividad.HasValue;

    var porcentajeMonitoreoCss =
        Model.PorcentajeMonitoreosAtendidos
            .ToString("0.#", System.Globalization.CultureInfo.InvariantCulture);

    var pasoActual = 1;

    if (estado == CalidadEstados.DevueltoPrearranque ||
        estado == CalidadEstados.ArranqueAutorizado)
    {
        pasoActual = 2;
    }

    if (estado == CalidadEstados.PendientePrimerasPiezas ||
        estado == CalidadEstados.AjustesSolicitados)
    {
        pasoActual = 3;
    }

    if (estado == CalidadEstados.ProduccionLiberada ||
        estado == CalidadEstados.MonitoreoActivo ||
        estado == CalidadEstados.PendienteLiberacionCaja ||
        estado == CalidadEstados.CajaLiberada ||
        estado == CalidadEstados.PendienteReliberacion ||
        estado == CalidadEstados.PendienteGP12 ||
        estado == CalidadEstados.EnGP12 ||
        estado == CalidadEstados.MaterialLiberado ||
        estado == CalidadEstados.MaterialNoConforme ||
        estado == CalidadEstados.Cerrada ||
        estado == CalidadEstados.LegacyLiberada)
    {
        pasoActual = 4;
    }

    var pasos = esReliberacion
        ? new[]
        {
            "Paro mayor a 15 min",
            "Prearranque",
            "Primeras piezas",
            "Reliberación"
        }
        : new[]
        {
            "Notificación",
            "Prearranque",
            "Primeras piezas",
            "Liberación"
        };
}

<style>
    .quality-detail-page {
        --quality-orange: #f97316;
        --quality-orange-dark: #c2410c;
        --quality-navy: #14213d;
        --quality-text: #1e293b;
        --quality-muted: #64748b;
        --quality-border: #dfe5ec;
        --quality-bg: #f4f6f8;
        --quality-card: #ffffff;
        padding: 24px 12px 50px;
        color: var(--quality-text);
    }

    .quality-detail-shell {
        max-width: 1500px;
        margin: 0 auto;
    }

    .quality-detail-header {
        display: flex;
        justify-content: space-between;
        align-items: flex-start;
        gap: 24px;
        padding: 28px;
        margin-bottom: 20px;
        border: 1px solid var(--quality-border);
        border-radius: 18px;
        background: var(--quality-card);
        box-shadow: 0 12px 35px rgba(15, 23, 42, .07);
    }

    .quality-detail-header-main {
        display: flex;
        align-items: flex-start;
        gap: 18px;
        min-width: 0;
    }

    .quality-detail-icon {
        width: 58px;
        height: 58px;
        flex: 0 0 58px;
        display: grid;
        place-items: center;
        border-radius: 16px;
        background: #fff2e7;
        color: var(--quality-orange);
        font-size: 25px;
    }

    .quality-detail-title {
        margin: 0;
        color: var(--quality-navy);
        font-size: clamp(1.45rem, 2.2vw, 2rem);
        font-weight: 800;
    }

    .quality-detail-subtitle {
        margin: 8px 0 0;
        color: var(--quality-muted);
        font-size: .95rem;
    }

    .quality-header-actions {
        display: flex;
        align-items: center;
        flex-wrap: wrap;
        justify-content: flex-end;
        gap: 10px;
    }

    .quality-state {
        display: inline-flex;
        align-items: center;
        gap: 8px;
        min-height: 38px;
        padding: 8px 14px;
        border-radius: 999px;
        border: 1px solid transparent;
        font-size: .82rem;
        font-weight: 800;
        letter-spacing: .02em;
        text-transform: uppercase;
    }

    .quality-state-warning {
        background: #fff7dc;
        color: #92400e;
        border-color: #fde68a;
    }

    .quality-state-danger {
        background: #fff0f0;
        color: #b91c1c;
        border-color: #fecaca;
    }

    .quality-state-info {
        background: #eaf5ff;
        color: #075985;
        border-color: #bae6fd;
    }

    .quality-state-success {
        background: #eafbf1;
        color: #166534;
        border-color: #bbf7d0;
    }

    .quality-state-dark {
        background: #e5e7eb;
        color: #1f2937;
        border-color: #cbd5e1;
    }

    .quality-state-neutral {
        background: #f1f5f9;
        color: #475569;
        border-color: #dbe3ec;
    }

    .quality-btn {
        min-height: 40px;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: 8px;
        padding: 9px 15px;
        border-radius: 10px;
        border: 1px solid transparent;
        font-size: .88rem;
        font-weight: 750;
        text-decoration: none;
        transition: transform .15s ease, box-shadow .15s ease;
    }

    .quality-btn:hover {
        transform: translateY(-1px);
    }

    .quality-btn-light {
        background: #fff;
        color: #334155;
        border-color: var(--quality-border);
    }

    .quality-btn-primary {
        background: var(--quality-orange);
        color: #fff;
        border-color: var(--quality-orange);
    }

    .quality-btn-success {
        background: #15803d;
        color: #fff;
        border-color: #15803d;
    }

    .quality-btn-warning {
        background: #d97706;
        color: #fff;
        border-color: #d97706;
    }

    .quality-btn-danger {
        background: #b91c1c;
        color: #fff;
        border-color: #b91c1c;
    }

    .quality-btn-dark {
        background: var(--quality-navy);
        color: #fff;
        border-color: var(--quality-navy);
    }

    .quality-btn:disabled {
        cursor: not-allowed;
        opacity: .48;
        transform: none;
    }

    .quality-alert {
        display: flex;
        align-items: flex-start;
        gap: 12px;
        padding: 15px 17px;
        margin-bottom: 18px;
        border-radius: 12px;
        border: 1px solid;
    }

    .quality-alert-success {
        background: #effcf4;
        color: #166534;
        border-color: #bbf7d0;
    }

    .quality-alert-danger {
        background: #fff1f1;
        color: #991b1b;
        border-color: #fecaca;
    }

    .quality-alert-warning {
        background: #fff8e6;
        color: #92400e;
        border-color: #fde68a;
    }

    .quality-progress {
        display: grid;
        grid-template-columns: repeat(4, minmax(0, 1fr));
        gap: 0;
        padding: 22px;
        margin-bottom: 20px;
        border: 1px solid var(--quality-border);
        border-radius: 16px;
        background: var(--quality-card);
    }

    .quality-progress-step {
        position: relative;
        display: flex;
        flex-direction: column;
        align-items: center;
        gap: 8px;
        color: #94a3b8;
        text-align: center;
        font-size: .78rem;
        font-weight: 700;
    }

    .quality-progress-step:not(:last-child)::after {
        content: "";
        position: absolute;
        top: 17px;
        left: calc(50% + 22px);
        width: calc(100% - 44px);
        height: 3px;
        border-radius: 999px;
        background: #e2e8f0;
    }

    .quality-progress-circle {
        position: relative;
        z-index: 2;
        width: 36px;
        height: 36px;
        display: grid;
        place-items: center;
        border-radius: 50%;
        background: #e2e8f0;
        color: #64748b;
        font-weight: 850;
    }

    .quality-progress-step.is-done,
    .quality-progress-step.is-active {
        color: var(--quality-navy);
    }

    .quality-progress-step.is-done .quality-progress-circle {
        background: #15803d;
        color: #fff;
    }

    .quality-progress-step.is-done:not(:last-child)::after {
        background: #86efac;
    }

    .quality-progress-step.is-active .quality-progress-circle {
        background: var(--quality-orange);
        color: #fff;
        box-shadow: 0 0 0 5px rgba(249, 115, 22, .14);
    }

    .quality-grid {
        display: grid;
        grid-template-columns: minmax(0, 1.8fr) minmax(320px, .8fr);
        gap: 20px;
        align-items: start;
    }

    .quality-column {
        min-width: 0;
    }

    .quality-card {
        margin-bottom: 20px;
        overflow: hidden;
        border: 1px solid var(--quality-border);
        border-radius: 16px;
        background: var(--quality-card);
        box-shadow: 0 8px 25px rgba(15, 23, 42, .045);
    }

    .quality-card-header {
        display: flex;
        justify-content: space-between;
        align-items: center;
        gap: 14px;
        padding: 17px 20px;
        border-bottom: 1px solid var(--quality-border);
        background: #fbfcfd;
    }

    .quality-card-header h2 {
        display: flex;
        align-items: center;
        gap: 10px;
        margin: 0;
        color: var(--quality-navy);
        font-size: 1rem;
        font-weight: 800;
    }

    .quality-card-header h2 i {
        color: var(--quality-orange);
    }

    .quality-card-body {
        padding: 20px;
    }

    .quality-data-grid {
        display: grid;
        grid-template-columns: repeat(3, minmax(0, 1fr));
        gap: 14px;
    }

    .quality-data-item {
        min-width: 0;
        padding: 14px;
        border: 1px solid #e9edf2;
        border-radius: 12px;
        background: #fbfcfe;
    }

    .quality-data-item.wide {
        grid-column: span 2;
    }

    .quality-data-label {
        display: block;
        margin-bottom: 6px;
        color: var(--quality-muted);
        font-size: .72rem;
        font-weight: 800;
        letter-spacing: .04em;
        text-transform: uppercase;
    }

    .quality-data-value {
        display: block;
        overflow-wrap: anywhere;
        color: var(--quality-text);
        font-size: .92rem;
        font-weight: 700;
    }

    .quality-doc-list,
    .quality-validation-list {
        display: grid;
        gap: 10px;
    }

    .quality-doc-item,
    .quality-validation-item {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 14px;
        padding: 12px 14px;
        border: 1px solid #e8edf2;
        border-radius: 10px;
        background: #fbfcfd;
    }

    .quality-doc-name {
        display: flex;
        align-items: center;
        gap: 9px;
        color: #334155;
        font-size: .88rem;
        font-weight: 700;
    }

    .quality-check {
        display: inline-flex;
        align-items: center;
        gap: 6px;
        font-size: .78rem;
        font-weight: 800;
    }

    .quality-check-ok {
        color: #15803d;
    }

    .quality-check-pending {
        color: #b45309;
    }

    .quality-result-ok {
        color: #15803d;
    }

    .quality-result-nok {
        color: #b91c1c;
    }

    .quality-result-na {
        color: #64748b;
    }

    .quality-form-grid {
        display: grid;
        grid-template-columns: repeat(2, minmax(0, 1fr));
        gap: 15px;
    }

    .quality-field-full {
        grid-column: 1 / -1;
    }

    .quality-form-label {
        display: block;
        margin-bottom: 6px;
        color: #334155;
        font-size: .82rem;
        font-weight: 750;
    }

    .quality-form-control,
    .quality-form-select {
        width: 100%;
        min-height: 44px;
        padding: 9px 12px;
        border: 1px solid #cfd8e3;
        border-radius: 9px;
        background: #fff;
        color: #1e293b;
        outline: none;
    }

    textarea.quality-form-control {
        min-height: 92px;
        resize: vertical;
    }

    .quality-form-control:focus,
    .quality-form-select:focus {
        border-color: var(--quality-orange);
        box-shadow: 0 0 0 3px rgba(249, 115, 22, .12);
    }

    .quality-checklist-instructions {
        display: flex;
        align-items: flex-start;
        gap: 10px;
        margin-bottom: 14px;
        padding: 11px 13px;
        border: 1px solid #bfdbfe;
        border-radius: 10px;
        background: #eff6ff;
        color: #1e3a5f;
        font-size: .8rem;
        line-height: 1.45;
    }

    .quality-checklist-instructions i {
        margin-top: 2px;
        color: #2563eb;
    }

    .quality-checklist-item {
        transition: border-color .2s ease, box-shadow .2s ease;
    }

    .quality-checklist-item.is-nok {
        border-color: #fca5a5;
        box-shadow: 0 0 0 2px rgba(220, 38, 38, .07);
    }

    .quality-checklist-item.is-na {
        border-color: #cbd5e1;
        box-shadow: 0 0 0 2px rgba(100, 116, 139, .07);
    }

    .quality-checklist-grid {
        align-items: start;
    }

    .quality-result-selector {
        min-height: 48px;
        display: flex;
        flex-wrap: wrap;
        align-items: center;
        justify-content: space-between;
        gap: 12px;
        padding: 9px 12px;
        border: 1px solid #dbe3eb;
        border-radius: 10px;
        background: #fff;
    }

    .quality-result-switch-group {
        display: inline-flex;
        align-items: center;
        gap: 9px;
    }

    .quality-result-option {
        min-width: 35px;
        font-size: .77rem;
        font-weight: 850;
        letter-spacing: .02em;
        text-align: center;
        transition: opacity .2s ease, color .2s ease;
    }

    .quality-result-option-nok {
        color: #b91c1c;
    }

    .quality-result-option-ok {
        color: #15803d;
    }

    .quality-toggle-switch {
        position: relative;
        display: inline-flex;
        width: 50px;
        height: 27px;
        margin: 0;
        cursor: pointer;
    }

    .quality-toggle-switch input {
        position: absolute;
        width: 1px;
        height: 1px;
        opacity: 0;
        pointer-events: none;
    }

    .quality-toggle-slider {
        position: absolute;
        inset: 0;
        border-radius: 999px;
        background: #dc2626;
        box-shadow: inset 0 0 0 1px rgba(15, 23, 42, .12);
        transition: background .2s ease, opacity .2s ease;
    }

    .quality-toggle-slider::before {
        content: "";
        position: absolute;
        top: 4px;
        left: 4px;
        width: 19px;
        height: 19px;
        border-radius: 50%;
        background: #fff;
        box-shadow: 0 1px 4px rgba(15, 23, 42, .28);
        transition: transform .2s ease;
    }

    .quality-toggle-switch input:checked + .quality-toggle-slider {
        background: #16a34a;
    }

    .quality-toggle-switch input:checked + .quality-toggle-slider::before {
        transform: translateX(23px);
    }

    .quality-toggle-switch input:focus-visible + .quality-toggle-slider {
        box-shadow: 0 0 0 3px rgba(249, 115, 22, .22);
    }

    .quality-toggle-switch input:disabled + .quality-toggle-slider {
        opacity: .42;
        cursor: not-allowed;
    }

    .quality-na-option {
        display: inline-flex;
        align-items: center;
        gap: 7px;
        margin: 0;
        padding: 6px 9px;
        border: 1px solid #cbd5e1;
        border-radius: 8px;
        background: #f8fafc;
        color: #475569;
        font-size: .78rem;
        font-weight: 800;
        cursor: pointer;
        user-select: none;
    }

    .quality-na-option input {
        width: 17px;
        height: 17px;
        margin: 0;
        accent-color: #64748b;
    }

    .quality-result-current {
        margin-top: 7px;
        color: #15803d;
        font-size: .75rem;
        font-weight: 800;
    }

    .quality-checklist-item.is-nok .quality-result-current {
        color: #b91c1c;
    }

    .quality-checklist-item.is-na .quality-result-current {
        color: #64748b;
    }

    .quality-result-observation {
        transition: background .2s ease, border-color .2s ease, opacity .2s ease;
    }

    .quality-result-observation.is-locked {
        background: #f1f5f9;
        color: #94a3b8;
        cursor: not-allowed;
        opacity: .78;
    }

    .quality-observation-help {
        margin-top: 6px;
        color: var(--quality-muted);
        font-size: .73rem;
        line-height: 1.35;
    }

    .quality-checklist-item.is-nok .quality-observation-help {
        color: #b91c1c;
        font-weight: 700;
    }

    .quality-form-actions {
        display: flex;
        flex-wrap: wrap;
        justify-content: flex-end;
        gap: 10px;
        margin-top: 18px;
    }

    .quality-form-check {
        min-height: 46px;
        display: flex;
        align-items: center;
        gap: 10px;
        padding: 10px 12px;
        border: 1px solid #dbe3eb;
        border-radius: 9px;
        background: #fbfcfe;
    }

    .quality-form-check input {
        width: 18px;
        height: 18px;
        accent-color: var(--quality-orange);
    }

    .quality-help {
        margin-top: 8px;
        color: var(--quality-muted);
        font-size: .78rem;
        line-height: 1.45;
    }

    .quality-side-action {
        padding: 16px;
        margin-bottom: 12px;
        border: 1px solid #e6ebf1;
        border-radius: 12px;
        background: #fbfcfd;
    }

    .quality-side-action h3 {
        margin: 0 0 7px;
        color: var(--quality-navy);
        font-size: .91rem;
        font-weight: 800;
    }

    .quality-side-action p {
        margin: 0 0 12px;
        color: var(--quality-muted);
        font-size: .8rem;
        line-height: 1.5;
    }

    .quality-side-action .quality-btn {
        width: 100%;
    }

    .quality-history-wrap {
        overflow-x: auto;
    }

    .quality-history-table {
        width: 100%;
        min-width: 850px;
        border-collapse: collapse;
    }

    .quality-history-table th,
    .quality-history-table td {
        padding: 12px 14px;
        border-bottom: 1px solid #e8edf2;
        text-align: left;
        vertical-align: top;
        font-size: .82rem;
    }

    .quality-history-table th {
        background: #f7f9fb;
        color: #475569;
        font-size: .72rem;
        font-weight: 850;
        letter-spacing: .03em;
        text-transform: uppercase;
    }

    .quality-history-table tbody tr:last-child td {
        border-bottom: 0;
    }

    .quality-history-movement {
        color: var(--quality-navy);
        font-weight: 800;
    }

    .quality-empty {
        padding: 34px 20px;
        color: var(--quality-muted);
        text-align: center;
    }

    html[data-nsq-theme="dark"] .quality-detail-page {
