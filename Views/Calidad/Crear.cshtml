@model ERP.NSQuell.Models.ViewModels.CalidadFormViewModel

@{
    ViewData["Title"] = "Nueva inspección de calidad";
}

<div class="calidad-form-page">

    <div class="calidad-form-header">
        <div>
            <h1>Nueva inspección</h1>
            <p>Registro inicial de inspección, trazabilidad, documentación y resultado de calidad.</p>
        </div>

        <a asp-controller="Calidad" asp-action="Index" class="btn-light-calidad">
            ← Volver
        </a>
    </div>

    <form asp-controller="Calidad" asp-action="Crear" method="post" class="form-card-calidad">
        @Html.AntiForgeryToken()

        <div asp-validation-summary="ModelOnly" class="validation-summary-calidad"></div>

        <div class="form-section-title">
            <h2>Datos de identificación</h2>
            <span>Información base del material, orden, parte o proceso revisado.</span>
        </div>

        <div class="form-grid-calidad">
            <div class="form-group-calidad">
                <label asp-for="CodigoBarras">Código de barras</label>
                <input asp-for="CodigoBarras" class="input-calidad" placeholder="Escanea o captura el código..." autofocus />
                <span asp-validation-for="CodigoBarras" class="field-error-calidad"></span>
            </div>

            <div class="form-group-calidad">
                <label asp-for="OrdenTrabajo">Orden de trabajo</label>
                <input asp-for="OrdenTrabajo" class="input-calidad" placeholder="Orden / OF / referencia..." />
                <span asp-validation-for="OrdenTrabajo" class="field-error-calidad"></span>
            </div>

            <div class="form-group-calidad">
                <label asp-for="NumeroParte">Número de parte</label>
                <input asp-for="NumeroParte" class="input-calidad" placeholder="Número de parte..." />
                <span asp-validation-for="NumeroParte" class="field-error-calidad"></span>
            </div>

            <div class="form-group-calidad">
                <label asp-for="Material">Material</label>
                <input asp-for="Material" class="input-calidad" placeholder="Material revisado..." />
                <span asp-validation-for="Material" class="field-error-calidad"></span>
            </div>

            <div class="form-group-calidad">
                <label asp-for="Proceso">Proceso</label>
                <input asp-for="Proceso" class="input-calidad" placeholder="Inspección, liberación, retrabajo..." />
                <span asp-validation-for="Proceso" class="field-error-calidad"></span>
            </div>

            <div class="form-group-calidad">
                <label asp-for="Maquina">Máquina</label>
                <input asp-for="Maquina" class="input-calidad" placeholder="Máquina relacionada..." />
                <span asp-validation-for="Maquina" class="field-error-calidad"></span>
            </div>
        </div>

        <div class="form-section-title">
            <h2>Cantidades revisadas</h2>
            <span>Control de cuánto material se revisó y cuánto queda pendiente.</span>
        </div>

        <div class="form-grid-calidad form-grid-3">
            <div class="form-group-calidad">
                <label asp-for="CantidadTotal">Cantidad total</label>
                <input asp-for="CantidadTotal" type="number" step="0.001" min="0" class="input-calidad" id="cantidadTotal" />
                <span asp-validation-for="CantidadTotal" class="field-error-calidad"></span>
            </div>

            <div class="form-group-calidad">
                <label asp-for="CantidadRevisada">Cantidad revisada</label>
                <input asp-for="CantidadRevisada" type="number" step="0.001" min="0" class="input-calidad" id="cantidadRevisada" />
                <span asp-validation-for="CantidadRevisada" class="field-error-calidad"></span>
            </div>

            <div class="form-group-calidad">
                <label>Cantidad pendiente</label>
                <input type="text" class="input-calidad input-readonly" id="cantidadPendiente" value="0.000" readonly />
                <small>Se calcula automáticamente al guardar.</small>
            </div>
        </div>

        <div class="form-section-title">
            <h2>Validación documental</h2>
            <span>Checklist, hoja de inspección y hoja de validación de calidad.</span>
        </div>

        <div class="checks-calidad">
            <label class="check-card-calidad">
                <input asp-for="ChecklistValidado" />
                <div>
                    <strong>Checklist validado</strong>
                    <span>Confirma que el checklist fue revisado.</span>
                </div>
            </label>

            <label class="check-card-calidad">
                <input asp-for="HojaInspeccionProducto" />
                <div>
                    <strong>Hoja de inspección del producto</strong>
                    <span>Confirma que la hoja de inspección está disponible y revisada.</span>
                </div>
            </label>

            <label class="check-card-calidad">
                <input asp-for="HojaValidacionCalidad" />
                <div>
                    <strong>Hoja de validación de calidad</strong>
                    <span>Confirma que la hoja de validación fue revisada.</span>
                </div>
            </label>
        </div>

        <div class="form-section-title">
            <h2>Resultado de calidad</h2>
            <span>Asignación de etiqueta según el resultado de la inspección.</span>
        </div>

        <div class="resultado-grid-calidad">
            <div class="form-group-calidad">
                <label asp-for="ResultadoCalidad">Resultado</label>
                <select asp-for="ResultadoCalidad" class="input-calidad" id="resultadoCalidad">
                    <option value="">Sin resultado todavía</option>
                    <option value="VERDE">Verde - Todo bien / liberar</option>
                    <option value="AMARILLO">Amarillo - Se puede mejorar / GPI2</option>
                    <option value="ROJO">Rojo - Scrap / contención</option>
                </select>
                <span asp-validation-for="ResultadoCalidad" class="field-error-calidad"></span>
            </div>

            <div class="resultado-preview" id="resultadoPreview">
                <span class="badge-preview badge-neutral">Sin etiqueta</span>
                <p>Selecciona un resultado para asignar una etiqueta.</p>
            </div>
        </div>

        <div class="form-group-calidad">
            <label asp-for="Observaciones">Observaciones</label>
            <textarea asp-for="Observaciones"
                      class="input-calidad textarea-calidad"
                      placeholder="Agrega observaciones de la inspección, defecto, retrabajo, contención o liberación..."></textarea>
            <span asp-validation-for="Observaciones" class="field-error-calidad"></span>
        </div>

        <div class="form-actions-calidad">
            <a asp-controller="Calidad" asp-action="Index" class="btn-light-calidad">
                Cancelar
            </a>

            <button type="submit" class="btn-primary-calidad">
                Guardar inspección
            </button>
        </div>
    </form>
</div>

<style>
    .calidad-form-page {
        padding: 24px;
        color: #1f2937;
    }

    .calidad-form-header {
        display: flex;
        justify-content: space-between;
        align-items: center;
        gap: 16px;
        margin-bottom: 24px;
    }

    .calidad-form-header h1 {
        margin: 0;
        font-size: 28px;
        font-weight: 700;
        color: #0f172a;
    }

    .calidad-form-header p {
        margin: 6px 0 0;
        color: #64748b;
        font-size: 14px;
    }

    .form-card-calidad {
        background: #ffffff;
        border: 1px solid #e2e8f0;
        border-radius: 16px;
        padding: 24px;
        box-shadow: 0 4px 14px rgba(15, 23, 42, 0.06);
    }

    .form-section-title {
        margin: 8px 0 18px;
        padding-bottom: 10px;
        border-bottom: 1px solid #e2e8f0;
    }

    .form-section-title h2 {
        margin: 0;
        font-size: 18px;
        font-weight: 700;
        color: #0f172a;
    }

    .form-section-title span {
        display: block;
        margin-top: 4px;
        color: #64748b;
        font-size: 13px;
    }

    .form-grid-calidad {
        display: grid;
        grid-template-columns: repeat(2, minmax(0, 1fr));
        gap: 16px;
        margin-bottom: 28px;
    }

    .form-grid-3 {
        grid-template-columns: repeat(3, minmax(0, 1fr));
    }

    .form-group-calidad {
        display: flex;
        flex-direction: column;
        gap: 6px;
        margin-bottom: 18px;
    }

    .form-group-calidad label {
        font-size: 13px;
        font-weight: 700;
        color: #334155;
    }

    .form-group-calidad small {
        color: #64748b;
        font-size: 12px;
    }

    .input-calidad {
        width: 100%;
        border: 1px solid #cbd5e1;
        border-radius: 10px;
        padding: 10px 12px;
        font-size: 14px;
        outline: none;
        background: #ffffff;
        color: #0f172a;
        transition: all .2s ease;
    }

    .input-calidad:focus {
        border-color: #2563eb;
        box-shadow: 0 0 0 3px rgba(37, 99, 235, .12);
    }

    .input-readonly {
        background: #f8fafc;
        color: #475569;
    }

    .textarea-calidad {
        min-height: 120px;
        resize: vertical;
    }

    .checks-calidad {
        display: grid;
        grid-template-columns: repeat(3, minmax(0, 1fr));
        gap: 14px;
        margin-bottom: 28px;
    }

    .check-card-calidad {
        display: flex;
        align-items: flex-start;
        gap: 12px;
        border: 1px solid #e2e8f0;
        border-radius: 14px;
        padding: 16px;
        cursor: pointer;
        transition: all .2s ease;
        background: #ffffff;
    }

    .check-card-calidad:hover {
        border-color: #93c5fd;
        background: #f8fafc;
    }

    .check-card-calidad input {
        width: 18px;
        height: 18px;
        margin-top: 2px;
        accent-color: #2563eb;
    }

    .check-card-calidad strong {
        display: block;
        font-size: 14px;
        color: #0f172a;
        margin-bottom: 4px;
    }

    .check-card-calidad span {
        font-size: 12px;
        color: #64748b;
        line-height: 1.4;
    }

    .resultado-grid-calidad {
        display: grid;
        grid-template-columns: 1fr 320px;
        gap: 16px;
        align-items: end;
        margin-bottom: 18px;
    }

    .resultado-preview {
        border: 1px solid #e2e8f0;
        border-radius: 14px;
        padding: 14px;
        background: #f8fafc;
    }

    .resultado-preview p {
        margin: 8px 0 0;
        color: #64748b;
        font-size: 13px;
    }

    .badge-preview {
        display: inline-flex;
        padding: 6px 12px;
        border-radius: 999px;
        font-size: 12px;
        font-weight: 800;
    }

    .badge-neutral {
        background: #e2e8f0;
        color: #475569;
    }

    .badge-verde {
        background: #dcfce7;
        color: #166534;
    }

    .badge-amarilla {
        background: #fef3c7;
        color: #92400e;
    }

    .badge-roja {
        background: #fee2e2;
        color: #991b1b;
    }

    .validation-summary-calidad {
        color: #991b1b;
        background: #fee2e2;
        border: 1px solid #fecaca;
        border-radius: 12px;
        padding: 12px 16px;
        margin-bottom: 18px;
        font-weight: 600;
    }

    .validation-summary-calidad:empty {
        display: none;
    }

    .field-error-calidad {
        color: #dc2626;
        font-size: 12px;
        font-weight: 600;
    }

    .form-actions-calidad {
        display: flex;
        justify-content: flex-end;
        gap: 10px;
        padding-top: 18px;
        border-top: 1px solid #e2e8f0;
        margin-top: 24px;
    }

    .btn-primary-calidad,
    .btn-light-calidad {
        border: none;
        border-radius: 10px;
        padding: 10px 16px;
        text-decoration: none;
        font-weight: 600;
        font-size: 14px;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        cursor: pointer;
        transition: all .2s ease;
        white-space: nowrap;
    }

    .btn-primary-calidad {
        background: #0f172a;
        color: #ffffff;
    }

    .btn-primary-calidad:hover {
        background: #1e293b;
        color: #ffffff;
    }

    .btn-light-calidad {
        background: #f1f5f9;
        color: #334155;
    }

    .btn-light-calidad:hover {
        background: #e2e8f0;
        color: #334155;
    }

    @@media (max-width: 992px) {
        .form-grid-calidad,
        .form-grid-3,
        .checks-calidad,
        .resultado-grid-calidad {
            grid-template-columns: 1fr;
        }

        .calidad-form-header {
            flex-direction: column;
            align-items: flex-start;
        }
    }
</style>

<script>
    document.addEventListener('DOMContentLoaded', function () {
        const cantidadTotal = document.getElementById('cantidadTotal');
        const cantidadRevisada = document.getElementById('cantidadRevisada');
        const cantidadPendiente = document.getElementById('cantidadPendiente');
        const resultadoCalidad = document.getElementById('resultadoCalidad');
        const resultadoPreview = document.getElementById('resultadoPreview');

        function calcularPendiente() {
            const total = parseFloat(cantidadTotal.value) || 0;
            const revisada = parseFloat(cantidadRevisada.value) || 0;
            let pendiente = total - revisada;

            if (pendiente < 0) {
                pendiente = 0;
            }

            cantidadPendiente.value = pendiente.toFixed(3);
        }

        function actualizarResultado() {
            const valor = resultadoCalidad.value;

            if (valor === 'VERDE') {
                resultadoPreview.innerHTML = `
                    <span class="badge-preview badge-verde">Etiqueta verde</span>
                    <p>Todo bien. El proceso puede quedar liberado.</p>
                `;
            } else if (valor === 'AMARILLO') {
                resultadoPreview.innerHTML = `
                    <span class="badge-preview badge-amarilla">Etiqueta amarilla</span>
                    <p>Se puede mejorar. Se enviará a GPI2 / retrabajo.</p>
                `;
            } else if (valor === 'ROJO') {
                resultadoPreview.innerHTML = `
                    <span class="badge-preview badge-roja">Etiqueta roja</span>
                    <p>Scrap. El material queda marcado como rechazo / contención.</p>
                `;
            } else {
                resultadoPreview.innerHTML = `
                    <span class="badge-preview badge-neutral">Sin etiqueta</span>
                    <p>Selecciona un resultado para asignar una etiqueta.</p>
                `;
            }
        }

        cantidadTotal.addEventListener('input', calcularPendiente);
        cantidadRevisada.addEventListener('input', calcularPendiente);
        resultadoCalidad.addEventListener('change', actualizarResultado);

        calcularPendiente();
        actualizarResultado();
    });
</script>