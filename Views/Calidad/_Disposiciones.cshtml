@model ERP.NSQuell.Models.ViewModels.CalidadDetalleViewModel
@using ERP.NSQuell.Models
@{
    string Mostrar(string? valor) => string.IsNullOrWhiteSpace(valor) ? "—" : valor.Trim();

    string EstadoTratamientoTexto(string? estado) => (estado ?? CalidadEstadoTratamiento.PendienteAsignacion).Trim().ToUpperInvariant() switch
    {
        CalidadEstadoTratamiento.PendienteAsignacion => "Pendiente de asignación",
        CalidadEstadoTratamiento.Asignada => "Asignada",
        CalidadEstadoTratamiento.PendienteReinspeccion => "Entregada a Calidad",
        CalidadEstadoTratamiento.Concluida => "Concluida",
        _ => "Pendiente"
    };

    string EstadoTratamientoBadge(string? estado) => (estado ?? CalidadEstadoTratamiento.PendienteAsignacion).Trim().ToUpperInvariant() switch
    {
        CalidadEstadoTratamiento.PendienteAsignacion => "bg-secondary",
        CalidadEstadoTratamiento.Asignada => "bg-primary",
        CalidadEstadoTratamiento.PendienteReinspeccion => "bg-info text-dark",
        CalidadEstadoTratamiento.Concluida => "bg-success",
        _ => "bg-secondary"
    };

    var disposicionesActivas = Model.Disposiciones
        .Where(x => x.EsPendiente)
        .OrderBy(x => x.FechaInicio)
        .ThenBy(x => x.DisposicionID)
        .ToList();

    var disposicionesHistorial = Model.Disposiciones
        .Where(x => !x.EsPendiente)
        .OrderByDescending(x => x.FechaFin ?? x.FechaInicio)
        .ThenByDescending(x => x.DisposicionID)
        .ToList();
}
<style>
    .quality-dispositions {
        --qd-border: #dfe5ec;
        --qd-text: #1e293b;
        --qd-muted: #64748b;
        --qd-navy: #14213d;
        --qd-orange: #f97316;
        color: var(--qd-text)
    }

        .quality-dispositions .quality-card {
            margin-bottom: 20px;
            overflow: hidden;
            border: 1px solid var(--qd-border);
            border-radius: 14px;
            background: #fff
        }

        .quality-dispositions .quality-card-header {
            display: flex;
            justify-content: space-between;
            align-items: flex-start;
            gap: 16px;
            padding: 17px 20px;
            border-bottom: 1px solid var(--qd-border);
            background: #fbfcfd
        }

            .quality-dispositions .quality-card-header h2 {
                display: flex;
                align-items: center;
                gap: 10px;
                margin: 0;
                color: var(--qd-navy);
                font-size: 1rem;
                font-weight: 800
            }

                .quality-dispositions .quality-card-header h2 i {
                    color: var(--qd-orange)
                }

        .quality-dispositions .quality-card-body {
            padding: 20px
        }

        .quality-dispositions .quality-help {
            margin-top: 6px;
            color: var(--qd-muted);
            font-size: .78rem;
            line-height: 1.45
        }

        .quality-dispositions .quality-data-label {
            display: block;
            margin-bottom: 5px;
            color: var(--qd-muted);
            font-size: .7rem;
            font-weight: 800;
            letter-spacing: .035em;
            text-transform: uppercase
        }

        .quality-dispositions article {
            background: #fff
        }

        .quality-dispositions .quality-disposition-balance {
            padding: 10px 12px;
            border: 1px solid var(--qd-border);
            border-radius: 9px;
            background: #f8fafc;
            font-weight: 700
        }

            .quality-dispositions .quality-disposition-balance.is-complete {
                color: #166534;
                border-color: #86efac;
                background: #f0fdf4
            }

            .quality-dispositions .quality-disposition-balance.is-invalid {
                color: #991b1b;
                border-color: #fca5a5;
                background: #fef2f2
            }

        .quality-dispositions .quality-btn {
            min-height: 40px;
            display: inline-flex;
            align-items: center;
            justify-content: center;
            gap: 8px;
            padding: 9px 15px;
            border: 1px solid transparent;
            border-radius: 9px;
            font-size: .86rem;
            font-weight: 750;
            text-decoration: none
        }

        .quality-dispositions .quality-btn-primary {
            background: #1d4ed8;
            color: #fff;
            border-color: #1d4ed8
        }

        .quality-dispositions .quality-btn-info {
            background: #0369a1;
            color: #fff;
            border-color: #0369a1
        }

        .quality-dispositions .quality-btn-success {
            background: #15803d;
            color: #fff;
            border-color: #15803d
        }

        .quality-dispositions .quality-btn:disabled {
            opacity: .55;
            cursor: not-allowed
        }

        .quality-dispositions .quality-step {
            position: relative;
            padding: 12px 14px;
            border: 1px solid var(--qd-border);
            border-radius: 10px;
            background: #f8fafc
        }

        .quality-dispositions .quality-step-title {
            display: flex;
            align-items: center;
            gap: 8px;
            font-size: .82rem;
            font-weight: 800;
            color: var(--qd-navy)
        }

        .quality-dispositions .quality-assignment {
            padding: 14px;
            border: 1px dashed #cbd5e1;
            border-radius: 10px;
            background: #f8fafc
        }

        .quality-dispositions .quality-inline-error {
            display: none;
            margin-top: 10px;
            padding: 9px 11px;
            border: 1px solid #fca5a5;
            border-radius: 8px;
            background: #fef2f2;
            color: #991b1b;
            font-size: .82rem;
            font-weight: 700
        }

            .quality-dispositions .quality-inline-error.is-visible {
                display: block
            }

        .quality-dispositions .quality-origin {
            display: flex;
            align-items: center;
            gap: 12px;
            margin-bottom: 14px;
            padding: 12px 14px;
            border: 1px solid var(--qd-border);
            border-radius: 10px;
            background: #f8fafc
        }

        .quality-dispositions .quality-origin-icon {
            width: 42px;
            height: 42px;
            flex: 0 0 42px;
            display: flex;
            align-items: center;
            justify-content: center;
            border-radius: 10px;
            font-size: 1.45rem;
            background: #fff;
            border: 1px solid var(--qd-border)
        }

        .quality-dispositions .quality-origin-title {
            margin-bottom: 2px;
            color: var(--qd-muted);
            font-size: .68rem;
            font-weight: 850;
            letter-spacing: .04em;
            text-transform: uppercase
        }

        .quality-dispositions .quality-origin-name {
            color: var(--qd-navy);
            font-size: .9rem;
            font-weight: 850
        }

        .quality-dispositions .quality-origin-detail {
            margin-top: 2px;
            color: var(--qd-muted);
            font-size: .79rem
        }

        .quality-dispositions .quality-origin-production {
            border-color: #93c5fd;
            background: #eff6ff
        }

        .quality-dispositions .quality-origin-quality {
            border-color: #c4b5fd;
            background: #f5f3ff
        }

        .quality-dispositions .quality-source-warning {
            margin-top: 8px;
            font-size: .76rem;
            color: #92400e
        }

        .quality-dispositions .quality-history-card {
            border: 1px solid var(--qd-border);
            border-left: 4px solid #16a34a;
            border-radius: 11px;
            background: #f8fafc;
            padding: 15px 16px
        }

        .quality-dispositions .quality-history-title {
            color: var(--qd-navy);
            font-size: .92rem;
            font-weight: 850
        }

        .quality-dispositions .quality-history-meta {
            margin-top: 3px;
            color: var(--qd-muted);
            font-size: .76rem
        }

        .quality-dispositions .quality-history-grid {
            display: grid;
            grid-template-columns: repeat(6,minmax(0,1fr));
            gap: 10px;
            margin-top: 13px
        }

        .quality-dispositions .quality-history-item {
            min-width: 0;
            padding: 10px 11px;
            border: 1px solid var(--qd-border);
            border-radius: 9px;
            background: #fff
        }

        .quality-dispositions .quality-history-observations {
            margin-top: 12px;
            padding: 10px 12px;
            border: 1px solid var(--qd-border);
            border-radius: 9px;
            background: #fff;
            white-space: pre-wrap
        }

        .quality-dispositions .quality-history-accordion {
            display: grid;
            gap: 10px
        }

        .quality-dispositions .quality-history-accordion-item {
            overflow: hidden;
            border: 1px solid var(--qd-border);
            border-left: 4px solid #16a34a;
            border-radius: 11px;
            background: #f8fafc
        }

        .quality-dispositions .quality-history-accordion-button {
            width: 100%;
            display: grid;
            grid-template-columns: minmax(0,1fr) auto;
            align-items: center;
            gap: 14px;
            padding: 14px 16px;
            border: 0;
            background: transparent;
            color: inherit;
            text-align: left;
            cursor: pointer
        }

            .quality-dispositions .quality-history-accordion-button:hover {
                background: rgba(15,23,42,.03)
            }

        .quality-dispositions .quality-history-summary {
            min-width: 0
        }

        .quality-dispositions .quality-history-summary-top {
            display: flex;
            flex-wrap: wrap;
            align-items: center;
            gap: 8px
        }

        .quality-dispositions .quality-history-summary-bottom {
            display: flex;
            flex-wrap: wrap;
            gap: 12px;
            margin-top: 5px;
            color: var(--qd-muted);
            font-size: .75rem
        }

        .quality-dispositions .quality-history-toggle {
            display: inline-flex;
            align-items: center;
            gap: 8px;
            color: var(--qd-muted);
            font-size: .76rem;
            font-weight: 800;
            white-space: nowrap
        }

            .quality-dispositions .quality-history-toggle i {
                transition: transform .18s ease
            }

        .quality-dispositions .quality-history-accordion-button[aria-expanded="true"] .quality-history-toggle i {
            transform: rotate(180deg)
        }

        .quality-dispositions .quality-history-accordion-body {
            display: none;
            padding: 0 16px 16px;
            border-top: 1px solid var(--qd-border)
        }

            .quality-dispositions .quality-history-accordion-body.is-open {
                display: block
            }


        .quality-dispositions .quality-scrap-status {
            margin-top: 12px;
            padding: 12px 14px;
            border: 1px solid var(--qd-border);
            border-radius: 10px;
            background: #fff7ed
        }

        .quality-dispositions .quality-scrap-status-title {
            display: flex;
            align-items: center;
            gap: 8px;
            margin-bottom: 8px;
            color: #9a3412;
            font-size: .82rem;
            font-weight: 850
        }

        .quality-dispositions .quality-scrap-status-grid {
            display: grid;
            grid-template-columns: repeat(4,minmax(0,1fr));
            gap: 10px
        }

        .quality-dispositions .quality-scrap-status-item {
            min-width: 0;
            padding: 9px 10px;
            border: 1px solid rgba(249,115,22,.18);
            border-radius: 8px;
            background: rgba(255,255,255,.72)
        }

        .quality-dispositions .quality-scrap-missing {
            margin-top: 12px;
            padding: 11px 13px;
            border: 1px solid #fecaca;
            border-radius: 9px;
            background: #fef2f2;
            color: #991b1b;
            font-size: .82rem;
            font-weight: 750
        }

    html[data-nsq-theme="dark"] .quality-dispositions {
        --qd-border: rgba(255,255,255,.10);
        --qd-text: #e5e7eb;
        --qd-muted: #94a3b8;
        --qd-navy: #f8fafc
    }

        html[data-nsq-theme="dark"] .quality-dispositions .quality-card,
        html[data-nsq-theme="dark"] .quality-dispositions article {
            background: #111c2d
        }

        html[data-nsq-theme="dark"] .quality-dispositions .quality-card-header {
            background: #0e1828
        }

        html[data-nsq-theme="dark"] .quality-dispositions .form-control,
        html[data-nsq-theme="dark"] .quality-dispositions .form-select {
            background: #0b1422;
            color: #f8fafc;
            border-color: rgba(255,255,255,.13)
        }

        html[data-nsq-theme="dark"] .quality-dispositions .quality-step,
        html[data-nsq-theme="dark"] .quality-dispositions .quality-assignment,
        html[data-nsq-theme="dark"] .quality-dispositions .quality-origin,
        html[data-nsq-theme="dark"] .quality-dispositions .quality-origin-icon {
            background: #0e1828
        }

        html[data-nsq-theme="dark"] .quality-dispositions .quality-history-card {
            background: #0e1828;
            border-color: rgba(255,255,255,.10);
            border-left-color: #22c55e
        }

        html[data-nsq-theme="dark"] .quality-dispositions .quality-history-item,
        html[data-nsq-theme="dark"] .quality-dispositions .quality-history-observations {
            background: #111c2d;
            border-color: rgba(255,255,255,.10)
        }


        html[data-nsq-theme="dark"] .quality-dispositions .quality-scrap-status {
            background: #1f1a14;
            border-color: rgba(249,115,22,.28)
        }

        html[data-nsq-theme="dark"] .quality-dispositions .quality-scrap-status-title {
            color: #fdba74
        }

        html[data-nsq-theme="dark"] .quality-dispositions .quality-scrap-status-item {
            background: #111c2d;
            border-color: rgba(249,115,22,.22)
        }

        html[data-nsq-theme="dark"] .quality-dispositions .quality-scrap-missing {
            background: #2a1518;
            border-color: rgba(248,113,113,.28);
            color: #fecaca
        }

    @@media(max-width:991.98px) {
        .quality-dispositions .quality-history-grid {
            grid-template-columns: repeat(3,minmax(0,1fr))
        }

        .quality-dispositions .quality-scrap-status-grid {
            grid-template-columns: repeat(2,minmax(0,1fr))
        }
    }

    @@media(max-width:767.98px) {
        .quality-dispositions .quality-card-header {
            flex-direction: column
        }

        .quality-dispositions .quality-card-body {
            padding: 15px
        }

        .quality-dispositions .quality-history-grid {
            grid-template-columns: 1fr 1fr
        }
    }

    @@media(max-width:479.98px) {
        .quality-dispositions .quality-history-grid,
        .quality-dispositions .quality-scrap-status-grid {
            grid-template-columns: 1fr
        }
    }
</style>

<div class="quality-dispositions"
     data-departamentos-url="@Url.Action("ObtenerDepartamentosDisposicion", "Calidad")"
     data-usuarios-url="@Url.Action("ObtenerUsuariosDepartamentoDisposicion", "Calidad")">

    @if (disposicionesActivas.Any())
    {
        <section class="quality-card" id="disposiciones-material">
            <div class="quality-card-header">
                <div>
                    <h2>
                        <i class="fa-solid fa-boxes-stacked"></i>
                        Material separado, tratamiento y reinspección
                    </h2>
                    <div class="quality-help">
                        Aquí aparece únicamente el material que, después de la revisión de Calidad, requiere selección o retrabajo. Cada disposición conserva su origen para evitar mezclar piezas reportadas por Producción con hallazgos nuevos de Calidad.
                    </div>
                </div>

                @if (Model.DisposicionesPendientes > 0)
                {
                    <span class="badge bg-warning text-dark">
                        @Model.DisposicionesPendientes pendiente(s)
                    </span>
                }
            </div>

            <div class="quality-card-body d-grid gap-3">
                @foreach (var disposicion in disposicionesActivas)
                {
                    var estadoTratamiento = (disposicion.EstadoTratamiento ?? CalidadEstadoTratamiento.PendienteAsignacion).Trim().ToUpperInvariant();
                    var origenHallazgo = (disposicion.OrigenHallazgo ?? "CALIDAD").Trim().ToUpperInvariant();
                    var esOrigenProduccion = origenHallazgo == "PRODUCCION";
                    var esOrigenCalidad = origenHallazgo == "CALIDAD";
                    var esPendienteAsignacion = estadoTratamiento == CalidadEstadoTratamiento.PendienteAsignacion;
                    var esAsignada = estadoTratamiento == CalidadEstadoTratamiento.Asignada;
                    var esPendienteReinspeccion = estadoTratamiento == CalidadEstadoTratamiento.PendienteReinspeccion;
                    var esConcluida = estadoTratamiento == CalidadEstadoTratamiento.Concluida || !disposicion.EsPendiente;

                    <article class="border rounded-3 p-3 @disposicion.ResultadoFinalBordeClase">
                        <div class="d-flex flex-wrap justify-content-between gap-3 mb-3">
                            <div>
                                <h3 class="h6 fw-bold mb-1">
                                    Disposición #@disposicion.DisposicionID
                                    @if (disposicion.NumeroHora.HasValue)
                                    {
                                        <span> · Revisión hora @disposicion.NumeroHora.Value</span>
                                    }
                                </h3>

                                <div class="quality-help">
                                    MonitoreoID:
                                    @(disposicion.MonitoreoID?.ToString() ?? "—")
                                    · Inicio:
                                    @disposicion.FechaInicio.ToString("dd/MM/yyyy HH:mm")

                                    @if (disposicion.FechaHoraRevision.HasValue)
                                    {
                                        <span>
                                            · Monitoreo capturado:
                                            @disposicion.FechaHoraRevision.Value.ToString("dd/MM/yyyy HH:mm")
                                        </span>
                                    }

                                    @if (disposicion.FechaFin.HasValue)
                                    {
                                        <span>
                                            · Cierre:
                                            @disposicion.FechaFin.Value.ToString("dd/MM/yyyy HH:mm")
                                        </span>
                                    }
                                </div>
                            </div>

                            <div class="d-flex flex-wrap gap-2">
                                <span class="badge @EstadoTratamientoBadge(estadoTratamiento)">
                                    @EstadoTratamientoTexto(estadoTratamiento)
                                </span>

                                <span class="badge @disposicion.ResultadoFinalBadgeClase">
                                    @disposicion.ResultadoFinalTexto
                                </span>
                            </div>
                        </div>

                        @if (esOrigenProduccion)
                        {
                            <div class="quality-origin quality-origin-production">
                                <div class="quality-origin-icon">🧑‍🏭</div>

                                <div>
                                    <div class="quality-origin-title">
                                        Origen del hallazgo
                                    </div>

                                    <div class="quality-origin-name">
                                        Reportado por Producción
                                    </div>

                                    <div class="quality-origin-detail">
                                        @if (disposicion.NumeroHora.HasValue)
                                        {
                                            <span>
                                                Hora @disposicion.NumeroHora.Value
                                            </span>
                                        }

                                        @if (disposicion.RegistroHoraID.HasValue)
                                        {
                                            <span>
                                                · RegistroHoraID @disposicion.RegistroHoraID.Value
                                            </span>
                                        }

                                        @if (disposicion.MonitoreoID.HasValue)
                                        {
                                            <span>
                                                · Revisado en MonitoreoID @disposicion.MonitoreoID.Value
                                            </span>
                                        }
                                    </div>
                                </div>
                            </div>
                        }
                        else if (esOrigenCalidad)
                        {
                            <div class="quality-origin quality-origin-quality">
                                <div class="quality-origin-icon">🔬</div>

                                <div>
                                    <div class="quality-origin-title">
                                        Origen del hallazgo
                                    </div>

                                    <div class="quality-origin-name">
                                        Detectado por Calidad
                                    </div>

                                    <div class="quality-origin-detail">
                                        @if (disposicion.NumeroHora.HasValue)
                                        {
                                            <span>
                                                Monitoreo hora @disposicion.NumeroHora.Value
                                            </span>
                                        }

                                        @if (disposicion.MonitoreoID.HasValue)
                                        {
                                            <span>
                                                · MonitoreoID @disposicion.MonitoreoID.Value
                                            </span>
                                        }

                                        @if (disposicion.RegistroHoraID.HasValue)
                                        {
                                            <span>
                                                · Captura Producción @disposicion.RegistroHoraID.Value
                                            </span>
                                        }
                                    </div>
                                </div>
                            </div>
                        }
                        else
                        {
                            <div class="quality-origin">
                                <div class="quality-origin-icon">📋</div>

                                <div>
                                    <div class="quality-origin-title">
                                        Origen del hallazgo
                                    </div>

                                    <div class="quality-origin-name">
                                        Origen no identificado
                                    </div>

                                    <div class="quality-origin-detail">
                                        Valor recibido: @Mostrar(disposicion.OrigenHallazgo)
                                    </div>
                                </div>
                            </div>
                        }

                        @if (disposicion.EsPendiente)
                        {
                            <div class="alert alert-warning py-2 mb-3">
                                <i class="fa-solid fa-lock me-1"></i>

                                <strong>
                                    @disposicion.CantidadAfectada pieza(s) bloqueada(s).
                                </strong>

                                No pueden considerarse liberadas hasta concluir el tratamiento y la reinspección de Calidad.
                            </div>
                        }

                        <div class="row g-3 mb-3">
                            <div class="col-md-2">
                                <div class="quality-data-label">
                                    Tipo de material
                                </div>

                                <div class="fw-semibold">
                                    @disposicion.TipoMaterial.Replace("_", " ")
                                </div>
                            </div>

                            <div class="col-md-2">
                                <div class="quality-data-label">
                                    Etiqueta actual
                                </div>

                                <div class="fw-semibold">
                                    @Mostrar(disposicion.Etiqueta)
                                </div>
                            </div>

                            <div class="col-md-2">
                                <div class="quality-data-label">
                                    Cantidad afectada
                                </div>

                                <div class="fw-bold">
                                    @disposicion.CantidadAfectada
                                </div>
                            </div>

                            <div class="col-md-3">
                                <div class="quality-data-label">
                                    Tratamiento
                                </div>

                                <div class="fw-semibold">
                                    @disposicion.TratamientoTexto
                                </div>

                                <div class="quality-help">
                                    Responsable:
                                    @disposicion.ResponsableTexto
                                </div>
                            </div>

                            <div class="col-md-3">
                                <div class="quality-data-label">
                                    Defecto de origen
                                </div>

                                @if (esOrigenCalidad)
                                {
                                    <div class="fw-semibold">
                                        @if (!string.IsNullOrWhiteSpace(disposicion.DefectoCodigo))
                                        {
                                            <span>
                                                @disposicion.DefectoCodigo -
                                            </span>
                                        }

                                    @(string.IsNullOrWhiteSpace(disposicion.DefectoDescripcion)
                                                                ? "Sin descripción registrada"
                                                                : disposicion.DefectoDescripcion)
                        </div>
                                                }
                                else
                                {
                                    <div class="fw-semibold">
                                        Material segregado por Producción
                                    </div>

                                    <div class="quality-help">
                                        La disposición corresponde al material previamente reportado por el operador, no a un hallazgo nuevo de la muestra de Calidad.
                                    </div>
                                }
                            </div>
                        </div>

                        @if (disposicion.EsPendiente)
                        {
                            <div class="row g-3 mb-3">
                                <div class="col-md-4">
                                    <div class="quality-step h-100">
                                        <div class="quality-step-title">
                                            <i class="fa-solid fa-user-check"></i>
                                            Asignación
                                        </div>

                                        <div class="quality-help">
                                            @if (disposicion.DepartamentoResponsableID.HasValue && disposicion.UsuarioResponsableID.HasValue)
                                            {
                                                <span>
                                                    @disposicion.ResponsableTexto
                                                </span>
                                            }
                                            else
                                            {
                                                <span>
                                                    Pendiente de seleccionar departamento y usuario.
                                                </span>
                                            }
                                        </div>
                                    </div>
                                </div>

                                <div class="col-md-4">
                                    <div class="quality-step h-100">
                                        <div class="quality-step-title">
                                            <i class="fa-solid fa-screwdriver-wrench"></i>
                                            Tratamiento
                                        </div>

                                        <div class="quality-help">
                                            @if (esPendienteAsignacion)
                                            {
                                                <span>
                                                    Pendiente de asignar responsable.
                                                </span>
                                            }
                                            else if (esAsignada)
                                            {
                                                <span>
                                                    Asignado. Esperando devolución física del material a Calidad.
                                                </span>
                                            }
                                            else if (esPendienteReinspeccion)
                                            {
                                                <span>
                                                    Tratamiento terminado y material recibido por Calidad.
                                                </span>
                                            }
                                            else
                                            {
                                                <span>
                                                    Tratamiento concluido.
                                                </span>
                                            }
                                        </div>
                                    </div>
                                </div>

                                <div class="col-md-4">
                                    <div class="quality-step h-100">
                                        <div class="quality-step-title">
                                            <i class="fa-solid fa-microscope"></i>
                                            Calidad
                                        </div>

                                        <div class="quality-help">
                                            @if (esPendienteReinspeccion)
                                            {
                                                <span>
                                                    Material recibido y listo para reinspección.
                                                </span>
                                            }
                                            else if (esConcluida)
                                            {
                                                <span>
                                                    Reinspección concluida.
                                                </span>
                                            }
                                            else
                                            {
                                                <span>
                                                    Esperando recepción física del material.
                                                </span>
                                            }
                                        </div>
                                    </div>
                                </div>
                            </div>
                        }

                        @if (disposicion.EsPendiente && (esPendienteAsignacion || esAsignada))
                        {
                            <div class="quality-assignment mb-3">
                                <div class="fw-bold mb-2">
                                    <i class="fa-solid fa-user-tag me-1"></i>
                                    Asignar responsable del tratamiento
                                </div>

                                <form asp-controller="Calidad"
                                      asp-action="AsignarResponsableDisposicion"
                                      method="post"
                                      data-assignment-form
                                      data-departamento-actual="@(disposicion.DepartamentoResponsableID?.ToString()??"")"
                                      data-usuario-actual="@(disposicion.UsuarioResponsableID?.ToString()??"")">

                                    @Html.AntiForgeryToken()

                                    <input type="hidden"
                                           name="disposicionID"
                                           value="@disposicion.DisposicionID" />

                                    <input type="hidden"
                                           name="inspeccionID"
                                           value="@Model.InspeccionID" />

                                    <div class="row g-3 align-items-end">
                                        <div class="col-md-4">
                                            <label class="form-label fw-semibold">
                                                Departamento
                                            </label>

                                            <select name="departamentoResponsableID"
                                                    class="form-select"
                                                    data-departamento-select
                                                    required>
                                                <option value="">
                                                    Cargando departamentos...
                                                </option>
                                            </select>
                                        </div>

                                        <div class="col-md-4">
                                            <label class="form-label fw-semibold">
                                                Usuario responsable
                                            </label>

                                            <select name="usuarioResponsableID"
                                                    class="form-select"
                                                    data-usuario-select
                                                    required
                                                    disabled>
                                                <option value="">
                                                    Selecciona primero un departamento
                                                </option>
                                            </select>
                                        </div>

                                        <div class="col-md-4">
                                            <button type="submit"
                                                    class="quality-btn quality-btn-primary w-100">
                                                <i class="fa-solid fa-floppy-disk"></i>
                                                @(esAsignada ? "Reasignar" : "Asignar")
                                            </button>
                                        </div>
                                    </div>

                                    <div class="quality-inline-error"
                                         data-assignment-error>
                                    </div>
                                </form>
                            </div>
                        }

                        @if (disposicion.EsPendiente && esAsignada)
                        {
                            <div class="quality-assignment mb-3">
                                <div class="fw-bold mb-2">
                                    <i class="fa-solid fa-box-open me-1"></i>
                                    Recepción del material en Calidad
                                </div>

                                <div class="quality-help mb-3">
                                    Confirma esta acción únicamente cuando el departamento responsable haya terminado la selección o retrabajo y entregue físicamente el material a Calidad. Esta acción no libera las piezas; solamente las deja listas para reinspección.
                                </div>

                                <form asp-controller="Calidad"
                                      asp-action="RecibirDisposicionParaReinspeccion"
                                      method="post">

                                    @Html.AntiForgeryToken()

                                    <input type="hidden"
                                           name="disposicionID"
                                           value="@disposicion.DisposicionID" />

                                    <input type="hidden"
                                           name="inspeccionID"
                                           value="@Model.InspeccionID" />

                                    <div class="row g-3 align-items-end">
                                        <div class="col-md-8">
                                            <label class="form-label fw-semibold">
                                                Observaciones de recepción
                                            </label>

                                            <textarea name="observaciones"
                                          rows="3"
                                          maxlength="1000"
                                          class="form-control"
                                          placeholder="Ej. Producción entrega material después de retrabajo. Se recibe identificado y separado para reinspección."></textarea>
                                        </div>

                                        <div class="col-md-4">
                                            <button type="submit"
                                                    class="quality-btn quality-btn-info w-100">
                                                <i class="fa-solid fa-box-open"></i>
                                                Recibir para reinspección
                                            </button>
                                        </div>
                                    </div>
                                </form>
                            </div>
                        }

                        @if (disposicion.EsPendiente && esPendienteReinspeccion)
                        {
                            <div class="alert alert-info mb-3">
                                <i class="fa-solid fa-circle-check me-1"></i>

                                <strong>
                                    Material recibido por Calidad para reinspección.
                                </strong>

                                @if (disposicion.FechaFinTratamiento.HasValue)
                                {
                                    <span>
                                        Recibido el
                                        @disposicion.FechaFinTratamiento.Value.ToString("dd/MM/yyyy HH:mm").
                                    </span>
                                }

                                Las piezas siguen bloqueadas hasta registrar el resultado de la reinspección.
                            </div>

                            <form asp-controller="Calidad"
                                  asp-action="ResolverDisposicion"
                                  method="post"
                                  data-disposition-form
                                  data-afectada="@disposicion.CantidadAfectada">

                                @Html.AntiForgeryToken()

                                <input type="hidden"
                                       name="DisposicionID"
                                       value="@disposicion.DisposicionID" />

                                <input type="hidden"
                                       name="InspeccionID"
                                       value="@Model.InspeccionID" />

                                <div class="row g-3">
                                    <div class="col-md-3">
                                        <label class="form-label fw-semibold">
                                            Cantidad liberada
                                        </label>

                                        <input type="number"
                                               name="CantidadLiberada"
                                               min="0"
                                               max="@disposicion.CantidadAfectada"
                                               value="0"
                                               class="form-control"
                                               data-disposition-liberada
                                               required />
                                    </div>

                                    <div class="col-md-3">
                                        <label class="form-label fw-semibold">
                                            Cantidad scrap
                                        </label>

                                        <input type="number"
                                               name="CantidadScrap"
                                               min="0"
                                               max="@disposicion.CantidadAfectada"
                                               value="0"
                                               class="form-control"
                                               data-disposition-scrap
                                               required />
                                    </div>

                                    <div class="col-md-4">
                                        <label class="form-label fw-semibold">
                                            Resultado de reinspección
                                        </label>

                                        <textarea name="Observaciones"
                                      rows="3"
                                      maxlength="1000"
                                      class="form-control"
                                      data-disposition-observations
                                      placeholder="Documenta el resultado. Es obligatorio cuando exista scrap."></textarea>

                                        <div class="quality-help">
                                            Liberado + scrap debe ser igual a @disposicion.CantidadAfectada.
                                        </div>
                                    </div>

                                    <div class="col-md-2 d-flex align-items-end">
                                        <button type="submit"
                                                class="quality-btn quality-btn-success w-100">
                                            <i class="fa-solid fa-check"></i>
                                            Resolver
                                        </button>
                                    </div>
                                </div>

                                <div class="quality-disposition-balance mt-3"
                                     data-disposition-balance>
                                    Pendiente por distribuir: @disposicion.CantidadAfectada
                                </div>

                                <div class="quality-help mt-2"
                                     data-disposition-preview>
                                    Captura las cantidades para obtener el resultado final.
                                </div>

                                <div class="quality-inline-error"
                                     data-disposition-error>
                                </div>
                            </form>
                        }

                        @if (!disposicion.EsPendiente)
                        {
                            <div class="row g-3 mb-3">
                                <div class="col-md-4">
                                    <div class="border rounded-3 p-3 h-100">
                                        <div class="quality-data-label">
                                            Resultado de reinspección
                                        </div>

                                        <div class="fw-bold">
                                            @disposicion.ResultadoFinalTexto
                                        </div>
                                    </div>
                                </div>

                                <div class="col-md-4">
                                    <div class="border rounded-3 p-3 h-100">
                                        <div class="quality-data-label">
                                            Liberado
                                        </div>

                                        <div class="fs-5 fw-bold text-success">
                                            @disposicion.CantidadLiberada
                                        </div>
                                    </div>
                                </div>

                                <div class="col-md-4">
                                    <div class="border rounded-3 p-3 h-100">
                                        <div class="quality-data-label">
                                            Scrap documentado
                                        </div>

                                        <div class="fs-5 fw-bold text-danger">
                                            @disposicion.CantidadScrap
                                        </div>
                                    </div>
                                </div>
                            </div>
                        }

                        @if (!disposicion.EsPendiente && disposicion.CantidadScrap > 0)
                        {
                            if (disposicion.EntregaScrap == null)
                            {
                                <div class="quality-scrap-missing">
                                    <i class="fa-solid fa-triangle-exclamation me-1"></i>
                                    Scrap documentado sin entrega física generada. Revisa la trazabilidad de esta disposición.
                                </div>
                            }
                            else
                            {
                                <div class="quality-scrap-status">
                                    <div class="quality-scrap-status-title">
                                        <i class="fa-solid fa-recycle"></i>
                                        Trazabilidad física del scrap
                                    </div>
                                    <div class="quality-scrap-status-grid">
                                        <div class="quality-scrap-status-item">
                                            <span class="quality-data-label">Estado</span>
                                            <span class="badge @disposicion.EntregaScrap.EstadoBadgeClase">@disposicion.EntregaScrap.EstadoTexto</span>
                                        </div>
                                        <div class="quality-scrap-status-item">
                                            <span class="quality-data-label">Cantidad</span>
                                            <div class="fw-bold text-danger">@disposicion.EntregaScrap.CantidadScrap pieza(s)</div>
                                        </div>
                                        <div class="quality-scrap-status-item">
                                            <span class="quality-data-label">Recepción Almacén</span>
                                            <div class="fw-semibold">@(disposicion.EntregaScrap.FechaRecepcion?.ToString("dd/MM/yyyy HH:mm") ?? "Pendiente")</div>
                                        </div>
                                        <div class="quality-scrap-status-item">
                                            <span class="quality-data-label">Ubicación</span>
                                            <div class="fw-semibold">@Mostrar(disposicion.EntregaScrap.UbicacionScrap)</div>
                                        </div>
                                    </div>
                                    @if (disposicion.EntregaScrap.EstaMolido)
                                    {
                                        <div class="quality-help mt-2">
                                            <i class="fa-solid fa-gears me-1"></i>
                                            Molienda registrada: @(disposicion.EntregaScrap.FechaMolienda?.ToString("dd/MM/yyyy HH:mm") ?? "—")
                                            @if (disposicion.EntregaScrap.CantidadMolida.HasValue)
                                            {
                                                <span> · Cantidad molida: @disposicion.EntregaScrap.CantidadMolida.Value.ToString("0.####")</span>
                                            }
                                        </div>
                                    }
                                </div>
                            }
                        }

                        @if (!string.IsNullOrWhiteSpace(disposicion.Observaciones))
                        {
                            <div class="alert alert-light border py-2 mb-0">
                                <strong>Seguimiento:</strong>

                                <div style="white-space:pre-wrap">
                                    @disposicion.Observaciones
                                </div>
                            </div>
                        }
                    </article>
                }
            </div>
        </section>
    }
    else if (disposicionesHistorial.Any())
    {
        <section class="quality-card">
            <div class="quality-card-body">
                <div class="text-center py-3">
                    <i class="fa-solid fa-circle-check text-success fs-4"></i>
                    <div class="fw-bold mt-2">No hay disposiciones pendientes.</div>
                    <div class="quality-help">Todas las disposiciones registradas para esta inspección ya fueron resueltas.</div>
                </div>
            </div>
        </section>
    }

    @if (disposicionesHistorial.Any())
    {
        <section class="quality-card" id="historial-disposiciones">
            <div class="quality-card-header">
                <div>
                    <h2>
                        <i class="fa-solid fa-clock-rotate-left"></i>
                        Historial de disposiciones resueltas
                    </h2>
                    <div class="quality-help">
                        Las disposiciones concluidas se muestran compactadas. Selecciona una para consultar su tratamiento, cantidades, responsable y seguimiento.
                    </div>
                </div>
                <span class="badge bg-success">@disposicionesHistorial.Count resuelta(s)</span>
            </div>

            <div class="quality-card-body">
                <div class="quality-history-accordion" data-history-accordion>
                    @foreach (var disposicion in disposicionesHistorial)
                    {
                        var estadoHistorial = (disposicion.EstadoTratamiento ?? CalidadEstadoTratamiento.Concluida).Trim().ToUpperInvariant();
                        var origenHistorial = (disposicion.OrigenHallazgo ?? "CALIDAD").Trim().ToUpperInvariant();
                        var textoOrigenHistorial = origenHistorial == "PRODUCCION"
                        ? "Producción"
                        : origenHistorial == "CALIDAD"
                        ? "Calidad"
                        : Mostrar(disposicion.OrigenHallazgo);
                        var accordionId = $"historial-disposicion-{disposicion.DisposicionID}";

                        <article class="quality-history-accordion-item @disposicion.ResultadoFinalBordeClase">
                            <button type="button"
                                    class="quality-history-accordion-button"
                                    aria-expanded="false"
                                    aria-controls="@accordionId"
                                    data-history-toggle>
                                <div class="quality-history-summary">
                                    <div class="quality-history-summary-top">
                                        <span class="quality-history-title">
                                            Disposición #@disposicion.DisposicionID
                                            @if (disposicion.NumeroHora.HasValue)
                                            {
                                                <span> · Revisión hora @disposicion.NumeroHora.Value</span>
                                            }
                                        </span>

                                        <span class="badge @EstadoTratamientoBadge(estadoHistorial)">
                                            @EstadoTratamientoTexto(estadoHistorial)
                                        </span>

                                        <span class="badge @disposicion.ResultadoFinalBadgeClase">
                                            @disposicion.ResultadoFinalTexto
                                        </span>

                                        @if (disposicion.CantidadScrap > 0)
                                        {
                                            if (disposicion.EntregaScrap == null)
                                            {
                                                <span class="badge bg-danger">Scrap sin entrega</span>
                                            }
                                            else
                                            {
                                                <span class="badge @disposicion.EntregaScrap.EstadoBadgeClase">@disposicion.EntregaScrap.EstadoTexto</span>
                                            }
                                        }
                                    </div>

                                    <div class="quality-history-summary-bottom">
                                        <span>
                                            <i class="fa-regular fa-calendar-check me-1"></i>
                                            @(disposicion.FechaFin?.ToString("dd/MM/yyyy HH:mm") ?? disposicion.FechaInicio.ToString("dd/MM/yyyy HH:mm"))
                                        </span>

                                        <span>
                                            <i class="fa-solid fa-cubes-stacked me-1"></i>
                                            @disposicion.CantidadAfectada afectada(s)
                                        </span>

                                        <span class="text-success">
                                            <i class="fa-solid fa-check me-1"></i>
                                            @disposicion.CantidadLiberada liberada(s)
                                        </span>

                                        <span class="text-danger">
                                            <i class="fa-solid fa-ban me-1"></i>
                                            @disposicion.CantidadScrap scrap
                                        </span>

                                        <span>
                                            <i class="fa-solid fa-location-dot me-1"></i>
                                            @textoOrigenHistorial
                                        </span>
                                    </div>
                                </div>

                                <span class="quality-history-toggle">
                                    Ver detalle
                                    <i class="fa-solid fa-chevron-down"></i>
                                </span>
                            </button>

                            <div id="@accordionId"
                                 class="quality-history-accordion-body"
                                 data-history-body>
                                <div class="quality-history-grid">
                                    <div class="quality-history-item">
                                        <span class="quality-data-label">Origen</span>
                                        <div class="fw-semibold">@textoOrigenHistorial</div>
                                    </div>

                                    <div class="quality-history-item">
                                        <span class="quality-data-label">Tipo de material</span>
                                        <div class="fw-semibold">@disposicion.TipoMaterial.Replace("_", " ")</div>
                                    </div>

                                    <div class="quality-history-item">
                                        <span class="quality-data-label">Etiqueta</span>
                                        <div class="fw-semibold">@Mostrar(disposicion.Etiqueta)</div>
                                    </div>

                                    <div class="quality-history-item">
                                        <span class="quality-data-label">Afectadas</span>
                                        <div class="fw-bold">@disposicion.CantidadAfectada</div>
                                    </div>

                                    <div class="quality-history-item">
                                        <span class="quality-data-label">Liberadas</span>
                                        <div class="fw-bold text-success">@disposicion.CantidadLiberada</div>
                                    </div>

                                    <div class="quality-history-item">
                                        <span class="quality-data-label">Scrap</span>
                                        <div class="fw-bold text-danger">@disposicion.CantidadScrap</div>
                                    </div>
                                </div>

                                <div class="row g-3 mt-1">
                                    <div class="col-md-6">
                                        <span class="quality-data-label">Tratamiento</span>
                                        <div class="fw-semibold">@disposicion.TratamientoTexto</div>
                                    </div>

                                    <div class="col-md-6">
                                        <span class="quality-data-label">Responsable</span>
                                        <div class="fw-semibold">@disposicion.ResponsableTexto</div>
                                    </div>

                                    <div class="col-md-6">
                                        <span class="quality-data-label">Fecha inicio</span>
                                        <div class="fw-semibold">@disposicion.FechaInicio.ToString("dd/MM/yyyy HH:mm")</div>
                                    </div>

                                    <div class="col-md-6">
                                        <span class="quality-data-label">Fecha cierre</span>
                                        <div class="fw-semibold">@(disposicion.FechaFin?.ToString("dd/MM/yyyy HH:mm") ?? "—")</div>
                                    </div>

                                    @if (disposicion.MonitoreoID.HasValue)
                                    {
                                        <div class="col-md-6">
                                            <span class="quality-data-label">Monitoreo</span>
                                            <div class="fw-semibold">MonitoreoID @disposicion.MonitoreoID.Value</div>
                                        </div>
                                    }

                                    @if (disposicion.RegistroHoraID.HasValue)
                                    {
                                        <div class="col-md-6">
                                            <span class="quality-data-label">Registro de Producción</span>
                                            <div class="fw-semibold">RegistroHoraID @disposicion.RegistroHoraID.Value</div>
                                        </div>
                                    }
                                </div>

                                @if (disposicion.CantidadScrap > 0)
                                {
                                    if (disposicion.EntregaScrap == null)
                                    {
                                        <div class="quality-scrap-missing">
                                            <i class="fa-solid fa-triangle-exclamation me-1"></i>
                                            Scrap documentado sin entrega física generada.
                                        </div>
                                    }
                                    else
                                    {
                                        <div class="quality-scrap-status">
                                            <div class="quality-scrap-status-title">
                                                <i class="fa-solid fa-recycle"></i>
                                                Trazabilidad física del scrap
                                            </div>
                                            <div class="quality-scrap-status-grid">
                                                <div class="quality-scrap-status-item"><span class="quality-data-label">Entrega Scrap</span><div class="fw-semibold">#@disposicion.EntregaScrap.ScrapEntregaID</div></div>
                                                <div class="quality-scrap-status-item"><span class="quality-data-label">Estado</span><span class="badge @disposicion.EntregaScrap.EstadoBadgeClase">@disposicion.EntregaScrap.EstadoTexto</span></div>
                                                <div class="quality-scrap-status-item"><span class="quality-data-label">Cantidad</span><div class="fw-bold text-danger">@disposicion.EntregaScrap.CantidadScrap pieza(s)</div></div>
                                                <div class="quality-scrap-status-item"><span class="quality-data-label">Ubicación</span><div class="fw-semibold">@Mostrar(disposicion.EntregaScrap.UbicacionScrap)</div></div>
                                                <div class="quality-scrap-status-item"><span class="quality-data-label">Fecha entrega</span><div class="fw-semibold">@(disposicion.EntregaScrap.FechaEntrega?.ToString("dd/MM/yyyy HH:mm") ?? "—")</div></div>
                                                <div class="quality-scrap-status-item"><span class="quality-data-label">Fecha recepción</span><div class="fw-semibold">@(disposicion.EntregaScrap.FechaRecepcion?.ToString("dd/MM/yyyy HH:mm") ?? "Pendiente")</div></div>
                                                <div class="quality-scrap-status-item"><span class="quality-data-label">Fecha molienda</span><div class="fw-semibold">@(disposicion.EntregaScrap.FechaMolienda?.ToString("dd/MM/yyyy HH:mm") ?? "—")</div></div>
                                                <div class="quality-scrap-status-item"><span class="quality-data-label">Cantidad molida</span><div class="fw-semibold">@(disposicion.EntregaScrap.CantidadMolida?.ToString("0.####") ?? "—")</div></div>
                                            </div>
                                            @if (!string.IsNullOrWhiteSpace(disposicion.EntregaScrap.Observaciones))
                                            {
                                                <div class="quality-help mt-2"><strong>Observaciones Scrap:</strong> @disposicion.EntregaScrap.Observaciones</div>
                                            }
                                        </div>
                                    }
                                }

                                @if (!string.IsNullOrWhiteSpace(disposicion.Observaciones))
                                {
                                    <div class="quality-history-observations">
                                        <span class="quality-data-label">Seguimiento / observaciones</span>
                                        @disposicion.Observaciones
                                    </div>
                                }
                            </div>
                        </article>
                    }
                </div>
            </div>
        </section>
    }
</div>

<script>
    (function(){
        const root=document.querySelector('.quality-dispositions');

        if(
            !root||
            root.dataset.initialized==='true'
        )
            return;

        root.dataset.initialized='true';

        const departamentosUrl=
            root.dataset.departamentosUrl;

        const usuariosUrl=
            root.dataset.usuariosUrl;

        let departamentosCache=null;

        async function obtenerDepartamentos(){
            if(departamentosCache)
                return departamentosCache;

            const response=
                await fetch(
                    departamentosUrl,
                    {
                        headers:{
                            'X-Requested-With':'XMLHttpRequest'
                        }
                    });

            if(!response.ok)
                throw new Error(
                    'No fue posible consultar los departamentos.'
                );

            const data=
                await response.json();

            departamentosCache=
                Array.isArray(data.departamentos)
                    ?data.departamentos
                    :[];

            return departamentosCache;
        }

        async function cargarUsuarios(
            selectUsuario,
            departamentoID,
            usuarioActual){

            selectUsuario.innerHTML=
                '<option value="">Cargando usuarios...</option>';

            selectUsuario.disabled=true;

            if(!departamentoID){
                selectUsuario.innerHTML=
                    '<option value="">Selecciona primero un departamento</option>';

                return;
            }

            const response=
                await fetch(
                    usuariosUrl+
                    '?departamentoID='+
                    encodeURIComponent(departamentoID),
                    {
                        headers:{
                            'X-Requested-With':'XMLHttpRequest'
                        }
                    });

            if(!response.ok)
                throw new Error(
                    'No fue posible consultar los usuarios del departamento.'
                );

            const data=
                await response.json();

            const usuarios=
                Array.isArray(data.usuarios)
                    ?data.usuarios
                    :[];

            selectUsuario.innerHTML=
                '<option value="">Selecciona un usuario</option>';

            usuarios.forEach(function(usuario){
                const option=
                    document.createElement('option');

                option.value=
                    usuario.usuarioID;

                option.textContent=
                    usuario.nombre+
                    (
                        usuario.username
                            ?' ('+usuario.username+')'
                            :''
                    );

                if(
                    String(usuario.usuarioID)===
                    String(usuarioActual||'')
                )
                    option.selected=true;

                selectUsuario.appendChild(option);
            });

            selectUsuario.disabled=false;
        }

        root.querySelectorAll(
            '[data-assignment-form]'
        ).forEach(async function(form){

            const departamentoSelect=
                form.querySelector(
                    '[data-departamento-select]'
                );

            const usuarioSelect=
                form.querySelector(
                    '[data-usuario-select]'
                );

            const error=
                form.querySelector(
                    '[data-assignment-error]'
                );

            const departamentoActual=
                form.dataset.departamentoActual||'';

            const usuarioActual=
                form.dataset.usuarioActual||'';

            try{
                const departamentos=
                    await obtenerDepartamentos();

                departamentoSelect.innerHTML=
                    '<option value="">Selecciona un departamento</option>';

                departamentos.forEach(function(departamento){
                    const option=
                        document.createElement('option');

                    option.value=
                        departamento.departamentoID;

                    option.textContent=
                        departamento.nombreDepartamento;

                    if(
                        String(departamento.departamentoID)===
                        String(departamentoActual)
                    )
                        option.selected=true;

                    departamentoSelect.appendChild(option);
                });

                if(departamentoActual)
                    await cargarUsuarios(
                        usuarioSelect,
                        departamentoActual,
                        usuarioActual
                    );
            }
            catch(ex){
                error.textContent=
                    ex.message||
                    'No fue posible cargar los responsables.';

                error.classList.add(
                    'is-visible'
                );
            }

            departamentoSelect.addEventListener(
                'change',
                async function(){

                    error.classList.remove(
                        'is-visible'
                    );

                    try{
                        await cargarUsuarios(
                            usuarioSelect,
                            departamentoSelect.value,
                            ''
                        );
                    }
                    catch(ex){
                        error.textContent=
                            ex.message||
                            'No fue posible cargar los usuarios.';

                        error.classList.add(
                            'is-visible'
                        );
                    }
                });

            form.addEventListener(
                'submit',
                function(event){

                    error.classList.remove(
                        'is-visible'
                    );

                    if(
                        !departamentoSelect.value||
                        !usuarioSelect.value
                    ){
                        event.preventDefault();

                        error.textContent=
                            'Selecciona departamento y usuario responsable.';

                        error.classList.add(
                            'is-visible'
                        );
                    }
                });
        });

        root.querySelectorAll(
            '[data-disposition-form]'
        ).forEach(function(form){

            const cantidadAfectada=
                Number(
                    form.dataset.afectada||'0'
                );

            const liberada=
                form.querySelector(
                    '[data-disposition-liberada]'
                );

            const scrap=
                form.querySelector(
                    '[data-disposition-scrap]'
                );

            const observaciones=
                form.querySelector(
                    '[data-disposition-observations]'
                );

            const balance=
                form.querySelector(
                    '[data-disposition-balance]'
                );

            const preview=
                form.querySelector(
                    '[data-disposition-preview]'
                );

            const error=
                form.querySelector(
                    '[data-disposition-error]'
                );

            function actualizarBalance(){
                const cantidadLiberada=
                    Number(
                        liberada?.value||'0'
                    );

                const cantidadScrap=
                    Number(
                        scrap?.value||'0'
                    );

                const total=
                    cantidadLiberada+
                    cantidadScrap;

                const pendiente=
                    cantidadAfectada-total;

                balance?.classList.toggle(
                    'is-complete',
                    pendiente===0
                );

                balance?.classList.toggle(
                    'is-invalid',
                    pendiente<0
                );

                if(balance){
                    if(pendiente===0)
                        balance.textContent=
                            'Distribución completa: '+
                            total+
                            ' de '+
                            cantidadAfectada+
                            '.';

                    else if(pendiente<0)
                        balance.textContent=
                            'La distribución excede la cantidad afectada por '+
                            Math.abs(pendiente)+
                            '.';

                    else
                        balance.textContent=
                            'Pendiente por distribuir: '+
                            pendiente+
                            ' de '+
                            cantidadAfectada+
                            '.';
                }

                if(preview){
                    if(pendiente!==0)
                        preview.textContent=
                            'Captura las cantidades hasta completar el material afectado.';

                    else if(
                        cantidadLiberada===cantidadAfectada&&
                        cantidadScrap===0
                    )
                        preview.textContent=
                            'Resultado: liberación total del material.';

                    else if(
                        cantidadLiberada>0&&
                        cantidadScrap>0
                    )
                        preview.textContent=
                            'Resultado: liberación parcial con scrap documentado.';

                    else if(
                        cantidadLiberada===0&&
                        cantidadScrap===cantidadAfectada
                    )
                        preview.textContent=
                            'Resultado: scrap total.';

                    else
                        preview.textContent=
                            'Revisa la distribución capturada.';
                }
            }

            liberada?.addEventListener(
                'input',
                actualizarBalance
            );

            scrap?.addEventListener(
                'input',
                actualizarBalance
            );

            form.addEventListener(
                'submit',
                function(event){

                    error?.classList.remove(
                        'is-visible'
                    );

                    const cantidadLiberada=
                        Number(
                            liberada?.value||'0'
                        );

                    const cantidadScrap=
                        Number(
                            scrap?.value||'0'
                        );

                    if(
                        cantidadLiberada+
                        cantidadScrap!==
                        cantidadAfectada
                    ){
                        event.preventDefault();

                        if(error){
                            error.textContent=
                                'Liberado + scrap debe ser igual a la cantidad afectada.';

                            error.classList.add(
                                'is-visible'
                            );
                        }

                        return;
                    }

                    if(
                        cantidadScrap>0&&
                        !observaciones?.value.trim()
                    ){
                        event.preventDefault();

                        observaciones?.focus();

                        if(error){
                            error.textContent=
                                'Documenta el motivo o resultado cuando exista cantidad scrap.';

                            error.classList.add(
                                'is-visible'
                            );
                        }
                    }
                });

            actualizarBalance();
        });

        root.querySelectorAll('[data-history-toggle]').forEach(function(button){
            button.addEventListener('click',function(){
                const bodyId=button.getAttribute('aria-controls');
                const body=bodyId?document.getElementById(bodyId):null;
                const estaAbierto=button.getAttribute('aria-expanded')==='true';

                root.querySelectorAll('[data-history-toggle]').forEach(function(otherButton){
                    otherButton.setAttribute('aria-expanded','false');
                });

                root.querySelectorAll('[data-history-body]').forEach(function(otherBody){
                    otherBody.classList.remove('is-open');
                });

                if(!estaAbierto&&body){
                    button.setAttribute('aria-expanded','true');
                    body.classList.add('is-open');
                }
            });
        });
    })();
</script>