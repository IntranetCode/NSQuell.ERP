            }

        .quality-liberacion .quality-history-row {
            grid-template-columns: 1fr;
            gap: 5px;
        }

        .quality-liberacion .quality-history-grid {
            grid-template-columns: 1fr;
        }
    }
</style>
<div class="quality-liberacion">
    <section class="quality-card">
        <div class="quality-card-header">
            <h2>
                <i class="fa-solid fa-file-circle-check"></i>
                Documentación y preparación
            </h2>
        </div>

        <div class="quality-card-body">
            <div class="quality-doc-list">
                <div class="quality-doc-item">
                    <span class="quality-doc-name">
                        <i class="fa-solid fa-list-check"></i>
                        Checklist de Producción
                    </span>

                    @if (Model.ChecklistValidado)
                    {
                        <span class="quality-check quality-check-ok">
                            <i class="fa-solid fa-check"></i>
                            Validado
                        </span>
                    }
                    else
                    {
                        <span class="quality-check quality-check-pending">
                            <i class="fa-solid fa-clock"></i>
                            Pendiente
                        </span>
                    }
                </div>

                <div class="quality-doc-item">
                    <span class="quality-doc-name">
                        <i class="fa-solid fa-clipboard-check"></i>
                        Hoja de inspección del producto
                    </span>

                    @if (Model.HojaInspeccionProducto)
                    {
                        <span class="quality-check quality-check-ok">
                            <i class="fa-solid fa-check"></i>
                            Disponible
                        </span>
                    }
                    else
                    {
                        <span class="quality-check quality-check-pending">
                            <i class="fa-solid fa-clock"></i>
                            Pendiente
                        </span>
                    }
                </div>

                <div class="quality-doc-item">
                    <span class="quality-doc-name">
                        <i class="fa-solid fa-shield-halved"></i>
                        Hoja de validación de Calidad
                    </span>

                    @if (Model.HojaValidacionCalidad)
                    {
                        <span class="quality-check quality-check-ok">
                            <i class="fa-solid fa-check"></i>
                            Disponible
                        </span>
                    }
                    else
                    {
                        <span class="quality-check quality-check-pending">
                            <i class="fa-solid fa-clock"></i>
                            Pendiente
                        </span>
                    }
                </div>
            </div>
        </div>
    </section>

    @if (hayRespuestasPrevias)
    {
        <section class="quality-card quality-history-card" data-history-section>
            <div class="quality-card-header quality-history-header">
                <div>
                    <h2><i class="fa-solid fa-clock-rotate-left"></i> Lo que ya respondiste</h2>
                    <div class="quality-help mt-1">Consulta tus respuestas guardadas anteriormente. Esta sección es solo de lectura.</div>
                </div>
                <div class="d-flex align-items-center gap-2 flex-wrap">
                    <span class="quality-history-summary">
                        <i class="fa-solid fa-floppy-disk"></i>
                        @if (respuestasChecklistGuardadas.Any())
                        {
                            <text>@respuestasChecklistGuardadas.Count respuesta(s) de checklist</text>
                        }
                        else if (hayValidacionPrimerasPiezas)
                        {
                            <text>Validación registrada</text>
                        }
                        else
                        {
                            <text>Información registrada</text>
                        }
                    </span>
                    <button type="button" class="quality-history-toggle" data-history-toggle aria-expanded="false">
                        <i class="fa-solid fa-chevron-down" data-history-toggle-icon></i>
                        <span data-history-toggle-text>Ver respuestas</span>
                    </button>
                </div>
            </div>

            <div class="quality-card-body quality-history-content is-collapsed" data-history-content>
                @if (respuestasChecklistGuardadas.Any())
                {
                    var gruposHistorialChecklist = respuestasChecklistGuardadas
                    .GroupBy(x => new { x.OrdenSeccion, Seccion = string.IsNullOrWhiteSpace(x.Seccion) ? "VALIDACIÓN DE CALIDAD" : x.Seccion.Trim() })
                    .OrderBy(x => x.Key.OrdenSeccion)
                    .ToList();

                    <div class="quality-history-group">
                        <div class="quality-history-group-header">
                            <strong><i class="fa-solid fa-list-check"></i> Checklist del auditor de Calidad</strong>
                            <span class="small text-muted">@respuestasChecklistGuardadas.Count respuesta(s)</span>
                        </div>
                        @foreach (var grupoHistorial in gruposHistorialChecklist)
                        {
                            <div class="quality-checklist-section mb-0 border-0 rounded-0">
                                <div class="quality-checklist-section-header">
                                    <strong><i class="fa-solid fa-clipboard-check"></i> @grupoHistorial.Key.Seccion</strong>
                                    <span>@grupoHistorial.Count() pregunta(s)</span>
                                </div>
                                <div class="quality-history-list">
                                    @foreach (var respuesta in grupoHistorial)
                                    {
                                        var resultadoHistorial = (respuesta.Resultado ?? string.Empty).Trim().ToUpperInvariant();
                                        if (resultadoHistorial == "N/A" || resultadoHistorial == "NA") resultadoHistorial = "NO_APLICA";
                                        var claseHistorial = resultadoHistorial == "OK" ? "quality-result-ok" : resultadoHistorial == "NOK" ? "quality-result-nok" : "quality-result-na";
                                        var textoHistorial = resultadoHistorial == "OK" ? "OK" : resultadoHistorial == "NOK" ? "NOK" : "NO APLICA";
                                        <div class="quality-history-row">
                                            <div class="quality-history-question">@respuesta.OrdenPregunta. @respuesta.TextoPregunta</div>
                                            <div class="quality-history-answer @claseHistorial">@textoHistorial</div>
                                            <div class="quality-history-observation">
                                                @if (!string.IsNullOrWhiteSpace(respuesta.Observaciones))
                                                {
                                                    <span>@respuesta.Observaciones</span>
                                                }
                                                else
                                                {
                                                    <span class="quality-history-empty">Sin observaciones</span>
                                                }
                                            </div>
                                        </div>
                                    }
                                </div>
                            </div>
                        }
                        @if (!string.IsNullOrWhiteSpace(Model.ObservacionesChecklistCalidad))
                        {
                            <div class="p-3 border-top">
                                <div class="small text-muted fw-bold text-uppercase mb-1">Observaciones generales de Calidad</div>
                                <div>@Model.ObservacionesChecklistCalidad</div>
                            </div>
                        }
                    </div>
                }

                @if (Model.AyudaVisualColocada || Model.HIPColocada || Model.HCCColocada || Model.MatrizPolivalenciaValidada || Model.AlertaCalidadAplica.HasValue || Model.AlertaCalidadColocada.HasValue || !string.IsNullOrWhiteSpace(Model.MotivoDevolucion))
                {
                    <div class="quality-history-group">
                        <div class="quality-history-group-header">
                            <strong><i class="fa-solid fa-power-off"></i> Revisión de prearranque</strong>
                            <span class="small text-muted">Datos registrados</span>
                        </div>
                        <div class="quality-history-grid">
                            <div class="quality-history-stat"><small>Ayuda visual</small><strong class="@(Model.AyudaVisualColocada ? "quality-result-ok" : "quality-result-nok")">@(Model.AyudaVisualColocada ? "Colocada" : "No colocada")</strong></div>
                            <div class="quality-history-stat"><small>HIP</small><strong class="@(Model.HIPColocada ? "quality-result-ok" : "quality-result-nok")">@(Model.HIPColocada ? "Colocada" : "No colocada")</strong></div>
                            <div class="quality-history-stat"><small>HCC</small><strong class="@(Model.HCCColocada ? "quality-result-ok" : "quality-result-nok")">@(Model.HCCColocada ? "Colocada" : "No colocada")</strong></div>
                            <div class="quality-history-stat"><small>Matriz de polivalencia</small><strong class="@(Model.MatrizPolivalenciaValidada ? "quality-result-ok" : "quality-result-nok")">@(Model.MatrizPolivalenciaValidada ? "Validada" : "No validada")</strong></div>
                            <div class="quality-history-stat"><small>Alerta de Calidad</small><strong class="@ClaseResultadoNullable(Model.AlertaCalidadAplica)">@(Model.AlertaCalidadAplica == true ? "Sí aplica" : Model.AlertaCalidadAplica == false ? "No aplica" : "Sin respuesta")</strong></div>
                            <div class="quality-history-stat"><small>Alerta colocada</small><strong class="@ClaseResultadoNullable(Model.AlertaCalidadColocada)">@ResultadoNullable(Model.AlertaCalidadColocada)</strong></div>
                        </div>
                        @if (!string.IsNullOrWhiteSpace(Model.MotivoDevolucion))
                        {
                            <div class="p-3 border-top">
                                <div class="small text-muted fw-bold text-uppercase mb-1">Último motivo de devolución</div>
                                <div>@Model.MotivoDevolucion</div>
                            </div>
                        }
                    </div>
                }

                @if (hayValidacionPrimerasPiezas)
                {
                    <div class="quality-history-group">
                        <div class="quality-history-group-header">
                            <strong><i class="fa-solid fa-vial-circle-check"></i> Última validación de primeras piezas</strong>
                            @if (Model.FechaValidacionPrimerasPiezas.HasValue)
                            {
                                <span class="small text-muted">@Model.FechaValidacionPrimerasPiezas.Value.ToString("dd/MM/yyyy HH:mm")</span>
                            }
                        </div>
                        <div class="quality-history-grid">
                            <div class="quality-history-stat"><small>Cinco disparos segregados</small><strong class="@(Model.CincoDisparosSegregados ? "quality-result-ok" : "quality-result-nok")">@(Model.CincoDisparosSegregados ? "Sí" : "No")</strong></div>
                            <div class="quality-history-stat"><small>Disparos conformes</small><strong class="@(Model.CantidadDisparosConformes >= 3 ? "quality-result-ok" : "quality-result-nok")">@Model.CantidadDisparosConformes de 5</strong></div>
                            <div class="quality-history-stat"><small>Dimensional</small><strong class="@ClaseResultadoNullable(Model.ValidacionDimensional)">@ResultadoNullable(Model.ValidacionDimensional)</strong></div>
                            <div class="quality-history-stat"><small>Apariencia</small><strong class="@ClaseResultadoNullable(Model.ValidacionApariencia)">@ResultadoNullable(Model.ValidacionApariencia)</strong></div>
                            <div class="quality-history-stat"><small>Gauge</small><strong class="@ClaseResultadoNullable(Model.ValidacionGauge)">@ResultadoNullable(Model.ValidacionGauge)</strong></div>
                            <div class="quality-history-stat"><small>Conductividad</small><strong class="@ClaseResultadoNullable(Model.ValidacionConductividad)">@ResultadoNullable(Model.ValidacionConductividad)</strong></div>
                        </div>
                        @if (!string.IsNullOrWhiteSpace(Model.Observaciones))
                        {
                            <div class="p-3 border-top">
                                <div class="small text-muted fw-bold text-uppercase mb-1">Observaciones de la validación</div>
                                <div>@Model.Observaciones</div>
                            </div>
                        }
                    </div>
                }

                @if (Model.IntentosPrimerasPiezas.Any())
                {
                    <div class="quality-history-group">
                        <div class="quality-history-group-header">
                            <strong><i class="fa-solid fa-vials"></i> Intentos registrados</strong>
                            <span class="small text-muted">@Model.IntentosPrimerasPiezas.Count intento(s)</span>
                        </div>
                        <div class="table-responsive">
                            <table class="table table-sm align-middle mb-0">
                                <thead>
                                    <tr>
                                        <th>Intento</th>
                                        <th>Disparos</th>
                                        <th>Dimensional</th>
                                        <th>Apariencia</th>
                                        <th>Gauge</th>
                                        <th>Conductividad</th>
                                        <th>Resultado</th>
                                        <th>Fecha</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var intento in Model.IntentosPrimerasPiezas.OrderByDescending(x => x.NumeroIntento))
                                    {
                                        <tr>
                                            <td>#@intento.NumeroIntento</td>
                                            <td>@intento.CantidadDisparosPresentados</td>
                                            <td>@ResultadoNullable(intento.ValidacionDimensional)</td>
                                            <td>@ResultadoNullable(intento.ValidacionApariencia)</td>
                                            <td>@ResultadoNullable(intento.ValidacionGauge)</td>
                                            <td>@ResultadoNullable(intento.ValidacionConductividad)</td>
                                            <td><strong>@intento.Resultado</strong></td>
                                            <td>@intento.FechaInicio.ToString("dd/MM/yyyy HH:mm")</td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    </div>
                }
            </div>
        </section>
    }

    @if (puedePrearranque && Model.ChecklistArranqueID.HasValue && Model.PreguntasChecklistCalidad.Any())
    {
        var seccionesChecklistCalidad = Model.PreguntasChecklistCalidad
        .OrderBy(x => x.OrdenSeccion)
        .ThenBy(x => x.OrdenPregunta)
        .ThenBy(x => x.PreguntaID)
        .GroupBy(x => new { x.OrdenSeccion, Seccion = string.IsNullOrWhiteSpace(x.Seccion) ? "VALIDACIÓN DE CALIDAD" : x.Seccion.Trim() })
        .ToList();
        var indiceRespuestaCalidad = 0;

        <section class="quality-card quality-auditor-card" data-auditor-section>
            <div class="quality-card-header">
                <h2><i class="fa-solid fa-list-check"></i> Sección del auditor de Calidad</h2>
                <span class="quality-auditor-summary" data-auditor-summary>
                    <i class="fa-solid @(preguntasCalidadPendientes > 0 ? "fa-clock" : preguntasCalidadNok > 0 ? "fa-triangle-exclamation" : "fa-circle-check")"></i>
                    <span data-auditor-summary-text>
                        @if (preguntasCalidadPendientes > 0)
                        {
                            <text>@preguntasCalidadRespondidas de @totalPreguntasCalidad guardadas</text>
                        }
                        else if (preguntasCalidadNok > 0)
                        {
                            <text>@preguntasCalidadNok NOK</text>
                        }
                        else
                        {
                            <text>Checklist guardado</text>
                        }
                    </span>
                </span>
                <button type="button" class="quality-auditor-toggle" data-auditor-toggle aria-expanded="@(!seccionCalidadGuardada ? "true" : "false")">
                    <i class="fa-solid @(seccionCalidadGuardada ? "fa-pen-to-square" : "fa-chevron-up")" data-auditor-toggle-icon></i>
                    <span data-auditor-toggle-text>@(seccionCalidadGuardada ? "Ver o editar" : "Comprimir")</span>
                </button>
            </div>
            <div class="quality-card-body quality-auditor-content @(seccionCalidadGuardada ? "is-collapsed" : string.Empty)" data-auditor-content>
                <form asp-controller="Calidad" asp-action="GuardarChecklistAuditor" method="post" data-auditor-form>
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="InspeccionID" value="@Model.InspeccionID" />
                    <input type="hidden" name="ChecklistArranqueID" value="@Model.ChecklistArranqueID" />
                    <div class="quality-checklist-instructions">
                        <i class="fa-solid fa-circle-info"></i>
                        <span>
                            Las preguntas pendientes se muestran inicialmente en <strong>OK</strong> solo como propuesta visual.
                            <strong>No se guardan</strong> hasta presionar <strong>Guardar sección de Calidad</strong>.
                            Cambia a <strong>NOK</strong> o <strong>NO APLICA</strong> cuando corresponda.
                        </span>
                    </div>
                    <div class="quality-checklist-progress">
                        <span><strong data-checklist-count>@preguntasCalidadRespondidas de @totalPreguntasCalidad</strong> guardadas</span>
                        <span data-checklist-status>
                            @if (preguntasCalidadPendientes > 0)
                            {
                                <text>@preguntasCalidadPendientes pendiente(s) de guardar</text>
                            }
                            else if (preguntasCalidadNok > 0)
                            {
                                <text>@preguntasCalidadNok NOK</text>
                            }
                            else
                            {
                                <text>Guardado completo</text>
                            }
                        </span>
                    </div>

                    @foreach (var grupo in seccionesChecklistCalidad)
                    {
                        <div class="quality-checklist-section">
                            <div class="quality-checklist-section-header">
                                <strong><i class="fa-solid fa-clipboard-check"></i> @grupo.Key.Seccion</strong>
                                <span>@grupo.Count() pregunta(s)</span>
                            </div>
                            <div class="quality-checklist-section-body">
                                @foreach (var pregunta in grupo)
                                {
                                    var resultadoGuardado = (pregunta.Resultado ?? string.Empty).Trim().ToUpperInvariant();
                                    if (resultadoGuardado == "N/A" || resultadoGuardado == "NA") resultadoGuardado = "NO_APLICA";
                                    var tieneResultadoGuardado = resultadoGuardado == "OK" || resultadoGuardado == "NOK" || resultadoGuardado == "NO_APLICA";
                                    var resultadoVisual = tieneResultadoGuardado ? resultadoGuardado : "OK";
                                    var esOk = resultadoVisual == "OK";
                                    var esNok = resultadoVisual == "NOK";
                                    var esNa = resultadoVisual == "NO_APLICA";
                                    var indiceActual = indiceRespuestaCalidad++;

                                    <input type="hidden" name="Respuestas[@indiceActual].ChecklistArranqueDetalleID" value="@pregunta.ChecklistArranqueDetalleID" />
                                    <div class="quality-side-action quality-checklist-item @(!tieneResultadoGuardado ? "is-default-visual" : esNok ? "is-nok" : esNa ? "is-na" : string.Empty)"
                                         data-quality-result data-saved="@(tieneResultadoGuardado ? "true" : "false")">
                                        <h3>@pregunta.OrdenPregunta. @pregunta.TextoPregunta</h3>
                                        <div class="quality-form-grid quality-checklist-grid">
                                            <div>
                                                <label class="quality-form-label">Resultado</label>
                                                <select name="Respuestas[@indiceActual].Resultado" class="quality-form-select" data-result-select required>
                                                    <option value="OK" selected="@(esOk ? "selected" : null)">OK</option>
                                                    <option value="NOK" selected="@(esNok ? "selected" : null)">NOK</option>
                                                    <option value="NO_APLICA" selected="@(esNa ? "selected" : null)">NO APLICA</option>
                                                </select>
                                                <div class="quality-result-current" data-result-caption>@(esNok ? "No conforme" : esNa ? "No aplica" : "Conforme")</div>
                                                @if (!tieneResultadoGuardado)
                                                {
                                                    <div class="quality-default-note" data-default-note>
                                                        <i class="fa-solid fa-circle-info"></i>
                                                        OK sugerido visualmente · pendiente de guardar
                                                    </div>
                                                }
                                            </div>
                                            <div>
                                                <label class="quality-form-label">Observaciones</label>
                                                <textarea name="Respuestas[@indiceActual].Observaciones"
                                              class="quality-form-control quality-result-observation @(esNok || esNa ? string.Empty : "is-locked")"
                                              maxlength="500" rows="2" data-result-observation
                                              readonly="@(esNok || esNa ? null : "readonly")"
                                              placeholder="@(esNok ? "Describe la no conformidad (obligatorio)..." : esNa ? "Explica por qué no aplica (opcional)..." : "Se habilita al seleccionar NOK o NO APLICA")">@pregunta.Observaciones</textarea>
                                                <div class="quality-observation-help" data-observation-help>@(esNok ? "La observación es obligatoria para un resultado NOK." : esNa ? "Puedes documentar por qué esta validación no aplica." : "El campo se habilitará cuando el resultado sea NOK o NO APLICA.")</div>
                                            </div>
                                        </div>
                                    </div>
                                }
                            </div>
                        </div>
                    }

                    <div class="quality-checklist-message" data-checklist-message role="alert"></div>
                    <label class="quality-form-label">Observaciones generales de Calidad</label>
                    <textarea name="ObservacionesCalidad" class="quality-form-control quality-general-observation" maxlength="1000" rows="2" placeholder="Observaciones generales de la revisión...">@Model.ObservacionesChecklistCalidad</textarea>
                    <button type="submit" class="quality-btn quality-btn-primary mt-3" data-auditor-submit>
                        <i class="fa-solid fa-floppy-disk"></i>
                        <span data-auditor-submit-text>Guardar sección de Calidad</span>
                    </button>
                </form>
            </div>
        </section>
    }

    @if (puedePrearranque)
    {
        <section class="quality-card">
            <div class="quality-card-header">
                <h2>
                    <i class="fa-solid fa-power-off"></i>
                    Decisión de prearranque
                </h2>
            </div>

            <div class="quality-card-body">
                <div class="quality-alert quality-alert-warning">
                    <i class="fa-solid fa-circle-info mt-1"></i>
                    <div>
                        Verifica que la OF, máquina, molde, material,
                        documentación y personal correspondan con la corrida.
                    </div>
                </div>

                <div class="quality-form-grid">
                    <form asp-controller="Calidad"
                          asp-action="AutorizarPrearranqueFlujo"
                          method="post"
                          class="quality-side-action"
                          data-confirm="¿Confirmas que la máquina está lista para realizar el arranque controlado?">

                        @Html.AntiForgeryToken()

                        <input type="hidden"
                               name="InspeccionID"
                               value="@Model.InspeccionID" />

                        <h3>Autorizar arranque</h3>

                        <p>
                            Permite a Producción poner en funcionamiento la máquina
                            para generar las primeras piezas.
                        </p>

                        <div class="quality-form-check mb-2">
                            <input asp-for="AyudaVisualColocada" class="form-check-input" />
                            <label asp-for="AyudaVisualColocada">Ayuda visual colocada</label>
                        </div>

                        <div class="quality-form-check mb-2">
                            <input asp-for="HIPColocada" class="form-check-input" />
                            <label asp-for="HIPColocada">HIP colocado</label>
                        </div>

                        <div class="quality-form-check mb-2">
                            <input asp-for="HCCColocada" class="form-check-input" />
                            <label asp-for="HCCColocada">HCC colocada</label>
                        </div>

                        <div class="quality-form-check mb-3">
                            <input asp-for="MatrizPolivalenciaValidada" class="form-check-input" />
                            <label asp-for="MatrizPolivalenciaValidada">Matriz de polivalencia validada</label>
                        </div>

                        <label class="quality-form-label">¿Aplica alerta de Calidad?</label>
                        <select asp-for="AlertaCalidadAplica" class="quality-form-select mb-2">
                            <option value="">Selecciona</option>
                            <option value="false">No aplica</option>
                            <option value="true">Sí aplica</option>
                        </select>

                        <label class="quality-form-label">Alerta colocada</label>
                        <select asp-for="AlertaCalidadColocada" class="quality-form-select mb-3">
                            <option value="">No aplica / pendiente</option>
                            <option value="false">No</option>
                            <option value="true">Sí</option>
                        </select>

                        <label class="quality-form-label">
                            Comentario opcional
                        </label>

                        <textarea name="Motivo"
                              class="quality-form-control"
                              placeholder="Observaciones de la autorización..."></textarea>

                        <button type="submit"
                                class="quality-btn quality-btn-success mt-3"
                                disabled="@(!checklistCalidadPuedeAutorizar)">
                            <i class="fa-solid fa-circle-check"></i>
                            Autorizar prearranque
                        </button>
                        @if (!checklistCalidadPuedeAutorizar)
                        {
                            <div class="quality-prearranque-help">
                                @if (preguntasCalidadPendientes > 0)
                                {
                                    <text>Faltan @preguntasCalidadPendientes pregunta(s) del checklist de Calidad por responder y guardar.</text>
                                }
                                else if (preguntasCalidadNok > 0)
                                {
                                    <text>Existen @preguntasCalidadNok resultado(s) NOK. No se puede autorizar el prearranque.</text>
                                }
                            </div>
                        }
                    </form>

                    <form asp-controller="Calidad"
                          asp-action="DevolverPrearranqueFlujo"
                          method="post"
                          class="quality-side-action"
                          data-confirm="¿Confirmas que deseas devolver esta revisión a Producción?">

                        @Html.AntiForgeryToken()

                        <input type="hidden"
                               name="InspeccionID"
                               value="@Model.InspeccionID" />

                        <h3>Devolver a Producción</h3>

                        <p>
                            Utiliza esta acción cuando exista información,
                            documentación o preparación pendiente.
                        </p>

                        <label class="quality-form-label">
                            Motivo obligatorio
                        </label>

                        <textarea name="Motivo"
                              class="quality-form-control"
                              required
                              maxlength="1000"
                              placeholder="Describe exactamente qué debe corregirse...">@Model.MotivoDevolucion</textarea>

                        <button type="submit"
                                class="quality-btn quality-btn-danger mt-3">
                            <i class="fa-solid fa-rotate-left"></i>
                            Devolver revisión
                        </button>
                    </form>
                </div>
            </div>
        </section>
    }

    @if (puedeRegistrarPrimerasPiezas && !validacionListaParaDecision)
    {
        <section class="quality-card quality-firstpieces-card">
            <div class="quality-card-header">
                <h2>
                    <i class="fa-solid fa-vial-circle-check"></i>
                    @(esReliberacion
                                    ? "Validación de primeras piezas para reliberación"
                                    : "Validación de primeras piezas")
            </h2>
        </div>

            <div class="quality-card-body">
                <form method="post">
                    @Html.AntiForgeryToken()

                    <input type="hidden"
                           name="InspeccionID"
                           value="@Model.InspeccionID" />

                @{
                        var resultadoSegregados = Model.CincoDisparosSegregados ? "OK" : "NOK";
                        var resultadoDimensional = Model.ValidacionDimensional == false ? "NOK" : "OK";
                        var resultadoApariencia = Model.ValidacionApariencia == false ? "NOK" : "OK";
                        var resultadoGauge = Model.ValidacionGauge == false ? "NOK" : "OK";
                        var resultadoConductividad = Model.ValidacionConductividad == false ? "NOK" : "OK";
                        var habilitarObsPrimerasPiezas = !Model.CincoDisparosSegregados
                        || Model.CantidadDisparosConformes < 3
                        || Model.ValidacionDimensional == false
                        || Model.ValidacionApariencia == false
                        || Model.ValidacionGauge == false
                        || Model.ValidacionConductividad == false;
                    }

                    <div class="quality-checklist-instructions mb-3">
                        <i class="fa-solid fa-circle-info"></i>
                        <span>
                            @if (esReliberacion)
                            {
                                <text>
                                    La corrida fue detenida por un paro mayor a 15 minutos. Valida nuevamente los
                                    cinco disparos antes de autorizar el reinicio de la serie. Cada validación inicia
                                    en <strong>Cumple</strong>; cambia a <strong>No cumple</strong> o marca
                                    <strong>No aplica</strong> cuando corresponda.
                                </text>
                            }
                            else
                            {
                                <text>
                                    Cada validación inicia en <strong>Cumple</strong>. Cambia el interruptor a
                                    <strong>No cumple</strong> o marca <strong>No aplica</strong> cuando corresponda.
                                    Las observaciones generales se habilitan cuando exista una no conformidad,
                                    un campo que no aplica o menos de 3 disparos conformes.
                                </text>
                            }
                        </span>
                    </div>

                    <div class="quality-form-grid quality-firstpieces-grid" data-firstpieces-form>
                        <div class="quality-side-action quality-checklist-item"
                             data-first-piece-result>
                            <h3>1. Primeros cinco disparos segregados</h3>

                            <input type="hidden"
                                   name="CincoDisparosSegregados"
                                   value="@(Model.CincoDisparosSegregados ? "true" : "false")"
                                   data-first-value />

                            <div class="quality-result-selector">
                                <div class="quality-result-switch-group">
                                    <span class="quality-result-option quality-result-option-nok">No segregados</span>

                                    <label class="quality-toggle-switch" title="Cambiar entre NOK y OK">
                                        <input type="checkbox"
                                               data-first-switch
                                               checked="@(Model.CincoDisparosSegregados ? "checked" : null)" />
                                        <span class="quality-toggle-slider"></span>
                                    </label>

                                    <span class="quality-result-option quality-result-option-ok">Segregados</span>
                                </div>
                            </div>

                            <div class="quality-result-current" data-first-caption>
                                @(Model.CincoDisparosSegregados ? "Disparos segregados" : "Disparos no segregados")
                            </div>

                            <div class="quality-help">
                                Debe confirmarse que los primeros cinco disparos fueron segregados antes de continuar.
                            </div>
                        </div>

                        <div>
                            <label asp-for="CantidadDisparosConformes"
                                   class="quality-form-label">
                                Disparos conformes presentados
                            </label>

                            <input asp-for="CantidadDisparosConformes"
                                   type="number"
                                   min="0"
                                   max="5"
                                   class="quality-form-control"
                                   data-first-count />

                            <div class="quality-result-current">
                                <strong class="@(Model.CantidadDisparosConformes >= 3 ? "quality-result-ok" : "quality-result-nok")"
                                        data-first-count-caption>
                                    @(Model.CantidadDisparosConformes >= 3 ? "Cumple mínimo" : "Menos de 3 conformes")
                                </strong>
                            </div>

                            <div class="quality-help" data-first-count-help>
                                Se requieren al menos tres disparos conformes para liberar la producción.
                            </div>
                        </div>

                        <div class="quality-side-action quality-checklist-item"
                             data-first-piece-result>
                            <h3>2. Validación dimensional</h3>

                            <input type="hidden"
                                   name="ValidacionDimensional"
                                   value="@(Model.ValidacionDimensional == false ? "false" : "true")"
                                   data-first-value />

                            <div class="quality-result-selector">
                                <div class="quality-result-switch-group">
                                    <span class="quality-result-option quality-result-option-nok">No cumple</span>
                                    <label class="quality-toggle-switch" title="Cambiar entre NOK y OK">
                                        <input type="checkbox"
                                               data-first-switch
                                               checked="@(Model.ValidacionDimensional != false ? "checked" : null)" />
                                        <span class="quality-toggle-slider"></span>
                                    </label>
                                    <span class="quality-result-option quality-result-option-ok">Cumple</span>
                                </div>

                                <label class="quality-na-option">
                                    <input type="checkbox" data-first-na />
                                    <span>No aplica</span>
                                </label>
                            </div>

                            <div class="quality-result-current" data-first-caption>
                                @(resultadoDimensional == "NOK" ? "No cumple" : "Cumple")
                            </div>
                        </div>

                        <div class="quality-side-action quality-checklist-item"
                             data-first-piece-result>
                            <h3>3. Apariencia</h3>

                            <input type="hidden"
                                   name="ValidacionApariencia"
                                   value="@(Model.ValidacionApariencia == false ? "false" : "true")"
                                   data-first-value />

                            <div class="quality-result-selector">
                                <div class="quality-result-switch-group">
                                    <span class="quality-result-option quality-result-option-nok">No cumple</span>
                                    <label class="quality-toggle-switch" title="Cambiar entre NOK y OK">
                                        <input type="checkbox"
                                               data-first-switch
                                               checked="@(Model.ValidacionApariencia != false ? "checked" : null)" />
                                        <span class="quality-toggle-slider"></span>
                                    </label>
                                    <span class="quality-result-option quality-result-option-ok">Cumple</span>
                                </div>

                                <label class="quality-na-option">
                                    <input type="checkbox" data-first-na />
                                    <span>No aplica</span>
                                </label>
                            </div>

                            <div class="quality-result-current" data-first-caption>
                                @(resultadoApariencia == "NOK" ? "No cumple" : "Cumple")
                            </div>
                        </div>

                        <div class="quality-side-action quality-checklist-item"
                             data-first-piece-result>
                            <h3>4. Gauge</h3>

                            <input type="hidden"
                                   name="ValidacionGauge"
                                   value="@(Model.ValidacionGauge == false ? "false" : "true")"
                                   data-first-value />

                            <div class="quality-result-selector">
                                <div class="quality-result-switch-group">
                                    <span class="quality-result-option quality-result-option-nok">No cumple</span>
                                    <label class="quality-toggle-switch" title="Cambiar entre NOK y OK">
                                        <input type="checkbox"
                                               data-first-switch
                                               checked="@(Model.ValidacionGauge != false ? "checked" : null)" />
                                        <span class="quality-toggle-slider"></span>
                                    </label>
                                    <span class="quality-result-option quality-result-option-ok">Cumple</span>
                                </div>

                                <label class="quality-na-option">
                                    <input type="checkbox" data-first-na />
                                    <span>No aplica</span>
                                </label>
                            </div>

                            <div class="quality-result-current" data-first-caption>
                                @(resultadoGauge == "NOK" ? "No cumple" : "Cumple")
                            </div>
                        </div>

                        <div class="quality-side-action quality-checklist-item"
                             data-first-piece-result>
                            <h3>5. Conductividad</h3>

                            <input type="hidden"
                                   name="ValidacionConductividad"
                                   value="@(Model.ValidacionConductividad == false ? "false" : "true")"
                                   data-first-value />

                            <div class="quality-result-selector">
                                <div class="quality-result-switch-group">
                                    <span class="quality-result-option quality-result-option-nok">No cumple</span>
                                    <label class="quality-toggle-switch" title="Cambiar entre NOK y OK">
                                        <input type="checkbox"
                                               data-first-switch
                                               checked="@(Model.ValidacionConductividad != false ? "checked" : null)" />
                                        <span class="quality-toggle-slider"></span>
                                    </label>
                                    <span class="quality-result-option quality-result-option-ok">Cumple</span>
                                </div>

                                <label class="quality-na-option">
                                    <input type="checkbox" data-first-na />
                                    <span>No aplica</span>
                                </label>
                            </div>

                            <div class="quality-result-current" data-first-caption>
                                @(resultadoConductividad == "NOK" ? "No cumple" : "Cumple")
                            </div>
                        </div>

                        @{
                            const string observacionInicialSistema =
                            "Solicitud recibida desde Producción para revisión de prearranque.";

                            const string prefijoReliberacionSistema =
                            "Solicitud automática de reliberación por paro mayor a 15 minutos.";

                            var observacionActual = Model.Observaciones?.Trim();
                            var esObservacionGeneradaPorSistema =
                            string.Equals(
                            observacionActual,
                            observacionInicialSistema,
                            StringComparison.OrdinalIgnoreCase) ||
                            (!string.IsNullOrWhiteSpace(observacionActual) &&
                            observacionActual.StartsWith(
                            prefijoReliberacionSistema,
                            StringComparison.OrdinalIgnoreCase));

                            var observacionesPrimerasPiezas =
                            esObservacionGeneradaPorSistema
                            ? string.Empty
                            : Model.Observaciones;
                        }

                    <div class="quality-field-full quality-firstpieces-full">
                        <label class="quality-form-label">
                            Observaciones generales
                        </label>

                        <textarea name="Observaciones"
                                  class="quality-form-control quality-result-observation @(habilitarObsPrimerasPiezas ? string.Empty : "is-locked")"
                                  maxlength="1000"
                                  data-first-general-observation
                                  readonly="@(!habilitarObsPrimerasPiezas ? "readonly" : null)"
                                  aria-readonly="@(!habilitarObsPrimerasPiezas ? "true" : "false")"
                                  placeholder="@(habilitarObsPrimerasPiezas ? "Describe el motivo del No cumple, del No aplica o los ajustes necesarios..." : "Se habilita cuando exista algún No cumple, No aplica o menos de 3 disparos conformes")">@observacionesPrimerasPiezas</textarea>

                        <div class="quality-observation-help" data-first-general-help>
                            @(habilitarObsPrimerasPiezas
                                                        ? "Documenta aquí cualquier resultado No cumple, campo No aplica o ajuste requerido."
                                                        : "Las observaciones se habilitarán cuando exista un No cumple, un No aplica o menos de 3 disparos conformes.")
                        </div>
                    </div>
                </div>

                    <div class="quality-form-actions">
                        <button type="submit"
                                formaction="@Url.Action("SolicitarAjustesFlujo", "Calidad")"
                                class="quality-btn quality-btn-danger"
                                data-firstpieces-action="ajustes"
                                data-submit-confirm="@confirmacionAjustes">
                            <i class="fa-solid fa-screwdriver-wrench"></i>
                            @(esReliberacion ? "Rechazar reliberación" : "Solicitar ajustes")
                        </button>

                        <button type="submit"
                                formaction="@Url.Action("RegistrarPrimerasPiezasFlujo", "Calidad")"
                                class="quality-btn quality-btn-primary"
                                data-firstpieces-action="guardar"
                                data-submit-confirm="¿Confirmas que deseas guardar esta validación?">
                            <i class="fa-solid fa-floppy-disk"></i>
                            Guardar validación
                        </button>
                    </div>
                </form>
            </div>
        </section>
        }

    @if (validacionListaParaDecision)
    {
        <section class="quality-card quality-decision-card">
            <div class="quality-card-header">
                <h2>
                    <i class="fa-solid fa-scale-balanced"></i>
                    Decisión de reliberación
                </h2>
            </div>

            <div class="quality-card-body">
                <div class="quality-decision-summary">
                    <div class="quality-decision-status">
                        <strong>
                            <i class="fa-solid fa-circle-check"></i>
                            Validación guardada - intento #@intentoPendienteActual!.NumeroIntento
                        </strong>
                        <div>
                            Ya no necesitas volver a guardar el formulario.
                            Calidad debe decidir si autoriza el reinicio de la serie
                            o rechaza la reliberación para solicitar nuevas primeras piezas.
                        </div>
                    </div>

                    <div class="quality-decision-actions">
                        @if (datosSuficientesLiberacion)
                        {
                            <form asp-controller="Calidad"
                                  asp-action="LiberarProduccionFlujo"
                                  method="post"
                                  data-confirm="¿Confirmas que las primeras piezas son conformes y deseas autorizar la reliberación? Producción podrá reiniciar la serie.">
                                @Html.AntiForgeryToken()
                                <input type="hidden" name="id" value="@Model.InspeccionID" />

                                <button type="submit"
                                        class="quality-btn quality-btn-success">
                                    <i class="fa-solid fa-circle-check"></i>
                                    Autorizar reliberación
                                </button>
                            </form>
                        }
                        else
                        {
                            <div class="quality-decision-disabled">
                                <strong>No se puede autorizar todavía.</strong><br />
                                La validación guardada contiene un resultado que no cumple
                                los requisitos de liberación. Debe rechazarse y solicitar nuevas piezas.
                            </div>
                        }

                        <div class="quality-reject-box">
                            <form asp-controller="Calidad"
                                  asp-action="SolicitarAjustesFlujo"
                                  method="post"
                                  data-confirm="¿Confirmas que deseas rechazar la reliberación? Producción tendrá que corregir y presentar nuevas primeras piezas.">
                                @Html.AntiForgeryToken()

                                <input type="hidden" name="InspeccionID" value="@Model.InspeccionID" />
                                <input type="hidden" name="CincoDisparosSegregados" value="@(Model.CincoDisparosSegregados ? "true" : "false")" />
                                <input type="hidden" name="CantidadDisparosConformes" value="@Model.CantidadDisparosConformes" />
                                <input type="hidden" name="ValidacionDimensional" value="@ValorBoolNullable(Model.ValidacionDimensional)" />
                                <input type="hidden" name="ValidacionApariencia" value="@ValorBoolNullable(Model.ValidacionApariencia)" />
                                <input type="hidden" name="ValidacionGauge" value="@ValorBoolNullable(Model.ValidacionGauge)" />
                                <input type="hidden" name="ValidacionConductividad" value="@ValorBoolNullable(Model.ValidacionConductividad)" />

                                <label class="quality-form-label">
                                    Motivo del rechazo
                                </label>

                                <textarea name="Observaciones"
                                      class="quality-form-control"
                                      required
                                      maxlength="1000"
                                      placeholder="Describe qué debe corregir Producción antes de presentar nuevas primeras piezas..."></textarea>

                                <button type="submit"
                                        class="quality-btn quality-btn-danger">
                                    <i class="fa-solid fa-xmark"></i>
                                    Rechazar reliberación
                                </button>
                            </form>
                        </div>
                    </div>
                </div>
            </div>
        </section>
    }

    @if (hayValidacionPrimerasPiezas)
    {
        <section class="quality-card">
            <div class="quality-card-header">
                <h2>
                    <i class="fa-solid fa-chart-simple"></i>
                    Resultado de primeras piezas
                </h2>
            </div>

            <div class="quality-card-body">
                <div class="quality-validation-list">
                    <div class="quality-validation-item">
                        <span>Primeros cinco disparos segregados</span>
                        <strong class="@(Model.CincoDisparosSegregados ? "quality-result-ok" : "quality-result-nok")">
                            @(Model.CincoDisparosSegregados ? "Sí" : "No")
                        </strong>
                    </div>

                    <div class="quality-validation-item">
                        <span>Disparos conformes</span>
                        <strong class="@(Model.CantidadDisparosConformes >= 3 ? "quality-result-ok" : "quality-result-nok")">
                            @Model.CantidadDisparosConformes de 5
                        </strong>
                    </div>

                    <div class="quality-validation-item">
                        <span>Dimensional</span>
                        <strong class="@ClaseResultadoNullable(Model.ValidacionDimensional)">
                            @ResultadoNullable(Model.ValidacionDimensional)
                        </strong>
                    </div>

                    <div class="quality-validation-item">
                        <span>Apariencia</span>
                        <strong class="@ClaseResultadoNullable(Model.ValidacionApariencia)">
                            @ResultadoNullable(Model.ValidacionApariencia)
                        </strong>
                    </div>

                    <div class="quality-validation-item">
                        <span>Gauge</span>
                        <strong class="@ClaseResultadoNullable(Model.ValidacionGauge)">
                            @ResultadoNullable(Model.ValidacionGauge)
                        </strong>
                    </div>

                    <div class="quality-validation-item">
                        <span>Conductividad</span>
                        <strong class="@ClaseResultadoNullable(Model.ValidacionConductividad)">
                            @ResultadoNullable(Model.ValidacionConductividad)
                        </strong>
                    </div>
                </div>

                @if (Model.FechaValidacionPrimerasPiezas.HasValue)
                {
                    <div class="quality-help mt-3">
                        Última validación:
                        @Model.FechaValidacionPrimerasPiezas.Value.ToString("dd/MM/yyyy HH:mm")
                    </div>
                }
            </div>
        </section>
    }

    @if (Model.IntentosPrimerasPiezas.Any())
    {
        <section class="quality-card">
            <div class="quality-card-header">
                <h2>
                    <i class="fa-solid fa-vials"></i>
                    Intentos de primeras piezas
                </h2>
            </div>

            <div class="quality-card-body table-responsive">
                <table class="table table-sm align-middle">
                    <thead>
                        <tr>
                            <th>Intento</th>
                            <th>Disparos</th>
                            <th>Dimensional</th>
                            <th>Apariencia</th>
                            <th>Gauge</th>
                            <th>Conductividad</th>
                            <th>Resultado</th>
                            <th>Fecha</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var intento in Model.IntentosPrimerasPiezas)
                        {
                            <tr>
                                <td>#@intento.NumeroIntento</td>
                                <td>@intento.CantidadDisparosPresentados</td>
                                <td>@ResultadoNullable(intento.ValidacionDimensional)</td>
                                <td>@ResultadoNullable(intento.ValidacionApariencia)</td>
                                <td>@ResultadoNullable(intento.ValidacionGauge)</td>
                                <td>@ResultadoNullable(intento.ValidacionConductividad)</td>
                                <td><strong>@intento.Resultado</strong></td>
                                <td>@intento.FechaInicio.ToString("dd/MM/yyyy HH:mm")</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </section>
    }
</div>
<script>
    document.addEventListener('DOMContentLoaded',function(){
    document.querySelectorAll('.quality-liberacion [data-history-section]').forEach(function(section){
        const toggle=section.querySelector('[data-history-toggle]');
        const content=section.querySelector('[data-history-content]');
        const text=section.querySelector('[data-history-toggle-text]');
        const icon=section.querySelector('[data-history-toggle-icon]');
        function actualizarHistorial(){
            if(!toggle||!content)return;
            const collapsed=content.classList.contains('is-collapsed');
            toggle.setAttribute('aria-expanded',collapsed?'false':'true');
            if(text)text.textContent=collapsed?'Ver respuestas':'Ocultar respuestas';
            if(icon){
                icon.classList.toggle('fa-chevron-down',collapsed);
                icon.classList.toggle('fa-chevron-up',!collapsed);
            }
        }
        toggle?.addEventListener('click',function(){content?.classList.toggle('is-collapsed');actualizarHistorial();});
        actualizarHistorial();
    });
    function actualizarChecklistAuditor(){
        document.querySelectorAll('.quality-liberacion [data-auditor-section]').forEach(function(section){
            const items=Array.from(section.querySelectorAll('[data-quality-result]'));
            let guardadas=0,nokGuardadas=0;
            items.forEach(function(item){
                const select=item.querySelector('[data-result-select]');
                const obs=item.querySelector('[data-result-observation]');
                const caption=item.querySelector('[data-result-caption]');
                const help=item.querySelector('[data-observation-help]');
                const note=item.querySelector('[data-default-note]');
                if(!select||!obs)return;
                const r=select.value;
                const guardada=item.dataset.saved==='true';
                if(guardada)guardadas++;
                if(guardada&&r==='NOK')nokGuardadas++;
                item.classList.toggle('is-nok',r==='NOK');
                item.classList.toggle('is-na',r==='NO_APLICA');
                item.classList.toggle('is-default-visual',!guardada);
                const habilitar=r==='NOK'||r==='NO_APLICA';
                obs.readOnly=!habilitar;
                obs.classList.toggle('is-locked',!habilitar);
                if(note){
                    note.style.display=guardada?'none':'inline-flex';
                    if(!guardada)note.innerHTML='<i class="fa-solid fa-circle-info"></i> '+(r==='OK'?'OK sugerido visualmente':'Cambio pendiente')+' · pendiente de guardar';
                }
                if(r==='NOK'){
                    obs.placeholder='Describe la no conformidad (obligatorio)...';
                    if(caption)caption.textContent='No conforme';
                    if(help)help.textContent='La observación es obligatoria para un resultado NOK.';
                }else if(r==='NO_APLICA'){
                    obs.placeholder='Explica por qué no aplica (opcional)...';
                    if(caption)caption.textContent='No aplica';
                    if(help)help.textContent='Puedes documentar por qué esta validación no aplica.';
                }else{
                    if(caption)caption.textContent='Conforme';
                    if(help)help.textContent='El campo se habilitará cuando el resultado sea NOK o NO APLICA.';
                }
            });
            const total=items.length;
            const pendientesGuardar=total-guardadas;
            const count=section.querySelector('[data-checklist-count]');
            const status=section.querySelector('[data-checklist-status]');
            const summary=section.querySelector('[data-auditor-summary-text]');
            if(count)count.textContent=guardadas+' de '+total;
            if(status)status.textContent=pendientesGuardar>0?pendientesGuardar+' pendiente(s) de guardar':nokGuardadas>0?nokGuardadas+' NOK':'Guardado completo';
            if(summary)summary.textContent=pendientesGuardar>0?guardadas+' de '+total+' guardadas':nokGuardadas>0?nokGuardadas+' NOK':'Checklist guardado';
        });
    }
    document.querySelectorAll('.quality-liberacion [data-result-select]').forEach(function(select){
        select.addEventListener('change',function(){
            const item=select.closest('[data-quality-result]');
            if(item)item.dataset.saved='false';
            actualizarChecklistAuditor();
        });
    });
    document.querySelectorAll('.quality-liberacion [data-result-observation]').forEach(function(obs){
        obs.addEventListener('input',function(){
            const item=obs.closest('[data-quality-result]');
            if(item)item.dataset.saved='false';
            actualizarChecklistAuditor();
        });
    });
    document.querySelectorAll('.quality-liberacion [data-auditor-form]').forEach(function(form){
        form.addEventListener('submit',function(e){
            const message=form.querySelector('[data-checklist-message]');
            let nokSinObs=0;
            let primeraObs=null;
            form.querySelectorAll('[data-quality-result]').forEach(function(item){
                const select=item.querySelector('[data-result-select]');
                const obs=item.querySelector('[data-result-observation]');
                if(!select||!obs)return;
                if(select.value==='NOK'&&!obs.value.trim()){
                    nokSinObs++;
                    obs.classList.add('is-invalid');
                    if(!primeraObs)primeraObs=obs;
                }else{
                    obs.classList.remove('is-invalid');
                }
            });
            if(nokSinObs>0){
                e.preventDefault();
                if(message){
                    message.textContent='Toda respuesta NOK requiere una observación.';
                    message.classList.add('is-visible');
                }
                primeraObs?.focus();
                primeraObs?.scrollIntoView({behavior:'smooth',block:'center'});
                return;
            }
            if(message)message.classList.remove('is-visible');
        });
    });
