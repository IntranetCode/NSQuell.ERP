@model ERP.NSQuell.Models.ViewModels.CalidadDetalleViewModel
@using ERP.NSQuell.Models
@{
    string ResultadoNullable(bool? valor) => valor switch { true => "Cumple", false => "No cumple", _ => "No aplica / pendiente" };
    string ClaseResultadoNullable(bool? valor) => valor switch { true => "quality-result-ok", false => "quality-result-nok", _ => "quality-result-na" };
    var estado = (Model.Estado ?? string.Empty).Trim().ToUpperInvariant();
    var esReliberacion = Model.EsReliberacion;
    var puedePrearranque = !Model.ConfiguracionInvalidada && (estado == CalidadEstados.PendientePrearranque || estado == CalidadEstados.DevueltoPrearranque);
    var puedeRegistrarPrimerasPiezas = !Model.ConfiguracionInvalidada && (estado == CalidadEstados.ArranqueAutorizado || estado == CalidadEstados.PendientePrimerasPiezas || estado == CalidadEstados.AjustesSolicitados || estado == CalidadEstados.PendienteReliberacion);
    var hayValidacionPrimerasPiezas = Model.FechaValidacionPrimerasPiezas.HasValue || Model.CincoDisparosSegregados || Model.CantidadDisparosConformes > 0 || Model.ValidacionDimensional.HasValue || Model.ValidacionApariencia.HasValue || Model.ValidacionGauge.HasValue || Model.ValidacionConductividad.HasValue;

    var intentoPendienteActual = Model.IntentosPrimerasPiezas
        .Where(x => x.Resultado == CalidadResultadoIntento.Pendiente)
        .OrderByDescending(x => x.NumeroIntento)
        .FirstOrDefault();

    var validacionListaParaDecision =
        esReliberacion &&
        estado == CalidadEstados.PendienteReliberacion &&
        intentoPendienteActual != null &&
        hayValidacionPrimerasPiezas;

    var datosSuficientesLiberacion =
        Model.CincoDisparosSegregados &&
        Model.CantidadDisparosConformes >= 3 &&
        Model.ValidacionDimensional == true &&
        Model.ValidacionApariencia == true &&
        Model.ValidacionGauge != false &&
        Model.ValidacionConductividad != false;

    string ValorBoolNullable(bool? valor) =>
        valor.HasValue ? (valor.Value ? "true" : "false") : string.Empty;

    var confirmacionAjustes = esReliberacion ? "¿Confirmas que deseas rechazar la reliberación y solicitar nuevas primeras piezas?" : "¿Confirmas que deseas solicitar ajustes a Producción?";
    var seccionCalidadGuardada = Model.PreguntasChecklistCalidad.Any()
        && Model.PreguntasChecklistCalidad.All(x => !string.IsNullOrWhiteSpace(x.Resultado));
}
<style>
    .quality-liberacion {
        display: grid;
        gap: 18px
    }

        .quality-liberacion .quality-card {
            margin: 0;
            border: 1px solid var(--quality-border,#dfe5ec);
            border-radius: 10px;
            background: var(--quality-card,#fff);
            box-shadow: none;
            overflow: hidden
        }

        .quality-liberacion .quality-card-header {
            padding: 14px 18px;
            border-bottom: 1px solid var(--quality-border,#dfe5ec);
            background: transparent
        }

            .quality-liberacion .quality-card-header h2 {
                margin: 0;
                font-size: 1rem;
                font-weight: 800;
                color: var(--quality-navy,#14213d)
            }

        .quality-liberacion .quality-card-body {
            padding: 18px
        }

        .quality-liberacion .quality-doc-list, .quality-liberacion .quality-validation-list {
            display: grid;
            gap: 8px
        }

        .quality-liberacion .quality-doc-item, .quality-liberacion .quality-validation-item {
            display: flex;
            justify-content: space-between;
            align-items: center;
            gap: 12px;
            padding: 10px 0;
            border: 0;
            border-bottom: 1px solid #eef1f5;
            border-radius: 0;
            background: transparent
        }

            .quality-liberacion .quality-doc-item:last-child, .quality-liberacion .quality-validation-item:last-child {
                border-bottom: 0
            }

        .quality-liberacion .quality-side-action {
            padding: 14px;
            border: 1px solid #e6ebf1;
            border-radius: 9px;
            background: #fbfcfd
        }

        .quality-liberacion .quality-form-grid {
            display: grid;
            grid-template-columns: repeat(2,minmax(0,1fr));
            gap: 14px
        }

        .quality-liberacion .quality-field-full {
            grid-column: 1/-1
        }

        .quality-liberacion .quality-form-control, .quality-liberacion .quality-form-select {
            width: 100%;
            min-height: 42px;
            padding: 9px 11px;
            border: 1px solid #cfd8e3;
            border-radius: 8px;
            background: #fff
        }

        .quality-liberacion textarea.quality-form-control {
            min-height: 90px
        }

        .quality-liberacion .quality-form-actions {
            display: flex;
            justify-content: flex-end;
            flex-wrap: wrap;
            gap: 10px;
            margin-top: 16px
        }

        .quality-liberacion .quality-btn {
            display: inline-flex;
            align-items: center;
            justify-content: center;
            gap: 8px;
            min-height: 40px;
            padding: 9px 14px;
            border-radius: 8px;
            border: 1px solid transparent;
            font-weight: 750
        }

        .quality-liberacion .quality-btn-primary {
            background: #f97316;
            color: #fff
        }

        .quality-liberacion .quality-btn-success {
            background: #15803d;
            color: #fff
        }

        .quality-liberacion .quality-btn-danger {
            background: #b91c1c;
            color: #fff
        }

        .quality-liberacion .quality-checklist-instructions {
            display: flex;
            gap: 10px;
            padding: 11px 13px;
            margin-bottom: 14px;
            border: 1px solid #bfdbfe;
            border-radius: 8px;
            background: #eff6ff;
            color: #1e3a5f
        }

        .quality-liberacion .quality-result-selector {
            display: flex;
            align-items: center;
            justify-content: space-between;
            gap: 12px;
            min-height: 46px;
            padding: 8px 11px;
            border: 1px solid #dbe3eb;
            border-radius: 8px;
            background: #fff
        }

        .quality-liberacion .quality-result-switch-group {
            display: inline-flex;
            align-items: center;
            gap: 9px
        }

        .quality-liberacion .quality-toggle-switch {
            position: relative;
            display: inline-flex;
            width: 50px;
            height: 27px;
            cursor: pointer
        }

            .quality-liberacion .quality-toggle-switch input {
                position: absolute;
                width: 1px;
                height: 1px;
                opacity: 0
            }

        .quality-liberacion .quality-toggle-slider {
            position: absolute;
            inset: 0;
            border-radius: 999px;
            background: #dc2626
        }

            .quality-liberacion .quality-toggle-slider:before {
                content: "";
                position: absolute;
                top: 4px;
                left: 4px;
                width: 19px;
                height: 19px;
                border-radius: 50%;
                background: #fff;
                transition: transform .2s
            }

        .quality-liberacion .quality-toggle-switch input:checked + .quality-toggle-slider {
            background: #16a34a
        }

            .quality-liberacion .quality-toggle-switch input:checked + .quality-toggle-slider:before {
                transform: translateX(23px)
            }

        .quality-liberacion .quality-na-option {
            display: inline-flex;
            align-items: center;
            gap: 7px;
            padding: 6px 9px;
            border: 1px solid #cbd5e1;
            border-radius: 8px;
            background: #f8fafc
        }

        .quality-liberacion .quality-result-observation.is-locked {
            background: #f1f5f9;
            color: #94a3b8
        }

        .quality-liberacion .quality-checklist-item.is-nok {
            border-color: #fca5a5
        }

        .quality-liberacion .quality-checklist-item.is-na {
            border-color: #cbd5e1
        }

        .quality-liberacion .quality-result-ok {
            color: #15803d
        }

        .quality-liberacion .quality-result-nok {
            color: #b91c1c
        }

        .quality-liberacion .quality-result-na {
            color: #64748b
        }


        /* Sección del auditor compacta */
        .quality-liberacion .quality-auditor-card .quality-card-header {
            display: flex;
            align-items: center;
            justify-content: space-between;
            gap: 12px;
            padding: 10px 14px
        }

        .quality-liberacion .quality-auditor-card .quality-card-body {
            padding: 11px 14px 14px
        }

        .quality-liberacion .quality-auditor-toggle {
            display: inline-flex;
            align-items: center;
            gap: 7px;
            min-height: 34px;
            padding: 6px 10px;
            border: 1px solid #cbd5e1;
            border-radius: 8px;
            background: #f8fafc;
            color: #14213d;
            font-size: .82rem;
            font-weight: 800
        }

            .quality-liberacion .quality-auditor-toggle:hover {
                background: #eef4fb
            }

        .quality-liberacion .quality-auditor-summary {
            display: inline-flex;
            align-items: center;
            gap: 7px;
            margin-left: auto;
            padding: 5px 9px;
            border-radius: 999px;
            background: #ecfdf3;
            color: #067647;
            font-size: .76rem;
            font-weight: 850
        }

        .quality-liberacion .quality-auditor-content.is-collapsed {
            display: none
        }

        .quality-liberacion .quality-auditor-card .quality-checklist-instructions {
            padding: 8px 10px;
            margin-bottom: 9px;
            font-size: .86rem
        }

        .quality-liberacion .quality-auditor-card .quality-checklist-item {
            padding: 9px 10px;
            margin-bottom: 8px !important
        }

            .quality-liberacion .quality-auditor-card .quality-checklist-item h3 {
                margin: 0 0 7px;
                font-size: 1rem;
                line-height: 1.25
            }

        .quality-liberacion .quality-auditor-card .quality-checklist-grid {
            grid-template-columns: minmax(250px,.9fr) minmax(320px,1.1fr);
            gap: 10px
        }

        .quality-liberacion .quality-auditor-card .quality-result-selector {
            min-height: 38px;
            padding: 5px 9px
        }

        .quality-liberacion .quality-auditor-card textarea.quality-result-observation {
            min-height: 54px;
            height: 54px;
            padding: 7px 9px
        }

        .quality-liberacion .quality-auditor-card .quality-result-current,
        .quality-liberacion .quality-auditor-card .quality-observation-help {
            margin-top: 3px;
            font-size: .78rem;
            line-height: 1.2
        }

        .quality-liberacion .quality-auditor-card .quality-general-observation {
            min-height: 58px;
            height: 58px
        }

        .quality-liberacion .quality-decision-card {
            border-color: #bbf7d0;
            background: #fbfffc;
        }

        .quality-liberacion .quality-decision-summary {
            display: grid;
            grid-template-columns: minmax(0, 1.2fr) minmax(280px, .8fr);
            gap: 12px;
            align-items: stretch;
        }

        .quality-liberacion .quality-decision-status {
            padding: 12px;
            border: 1px solid #bbf7d0;
            border-radius: 9px;
            background: #f0fdf4;
            color: #14532d;
        }

            .quality-liberacion .quality-decision-status strong {
                display: block;
                margin-bottom: 4px;
                font-size: .94rem;
            }

        .quality-liberacion .quality-decision-actions {
            display: grid;
            gap: 9px;
        }

            .quality-liberacion .quality-decision-actions form {
                margin: 0;
            }

            .quality-liberacion .quality-decision-actions .quality-btn {
                width: 100%;
            }

        .quality-liberacion .quality-reject-box {
            padding: 10px;
            border: 1px solid #fecaca;
            border-radius: 9px;
            background: #fffafa;
        }

            .quality-liberacion .quality-reject-box textarea {
                min-height: 58px;
                height: 58px;
                margin-bottom: 7px;
            }

        .quality-liberacion .quality-decision-disabled {
            padding: 9px 10px;
            border: 1px solid #fed7aa;
            border-radius: 8px;
            background: #fff7ed;
            color: #9a3412;
            font-size: .8rem;
            line-height: 1.25;
        }

        .quality-liberacion .quality-submit-disabled {
            opacity: .7;
            cursor: not-allowed;
            pointer-events: none
        }

        /* ============================================================
                   PRIMERAS PIEZAS / RELIBERACIÓN - VISTA COMPACTA
                   Reduce scroll sin cambiar nombres de campos ni comportamiento.
                   ============================================================ */
        .quality-liberacion .quality-firstpieces-card .quality-card-header {
            padding: 9px 14px;
        }

        .quality-liberacion .quality-firstpieces-card .quality-card-body {
            padding: 12px 14px 14px;
        }

        .quality-liberacion .quality-firstpieces-card .quality-checklist-instructions {
            padding: 7px 10px;
            margin-bottom: 10px !important;
            gap: 8px;
            font-size: .82rem;
            line-height: 1.25;
        }

        .quality-liberacion .quality-firstpieces-grid {
            grid-template-columns: repeat(2, minmax(0, 1fr));
            gap: 9px 10px;
            align-items: start;
        }

            .quality-liberacion .quality-firstpieces-grid .quality-checklist-item {
                grid-column: auto;
                padding: 8px 10px;
                margin-bottom: 0 !important;
                min-height: 0;
            }

                .quality-liberacion .quality-firstpieces-grid .quality-checklist-item h3 {
                    margin: 0 0 6px;
                    font-size: .94rem;
                    line-height: 1.15;
                }

            .quality-liberacion .quality-firstpieces-grid .quality-result-selector {
                min-height: 34px;
                padding: 4px 8px;
                gap: 8px;
            }

            .quality-liberacion .quality-firstpieces-grid .quality-result-switch-group {
                gap: 6px;
                font-size: .78rem;
            }

            .quality-liberacion .quality-firstpieces-grid .quality-toggle-switch {
                width: 40px;
                height: 22px;
            }

            .quality-liberacion .quality-firstpieces-grid .quality-toggle-slider:before {
                top: 3px;
                left: 3px;
                width: 16px;
                height: 16px;
            }

            .quality-liberacion .quality-firstpieces-grid .quality-toggle-switch input:checked + .quality-toggle-slider:before {
                transform: translateX(18px);
            }

            .quality-liberacion .quality-firstpieces-grid .quality-na-option {
                padding: 3px 7px;
                gap: 5px;
                font-size: .76rem;
            }

            .quality-liberacion .quality-firstpieces-grid .quality-result-current,
            .quality-liberacion .quality-firstpieces-grid .quality-help,
            .quality-liberacion .quality-firstpieces-grid .quality-observation-help {
                margin-top: 3px;
                font-size: .74rem;
                line-height: 1.18;
            }

            .quality-liberacion .quality-firstpieces-grid .quality-form-label {
                margin-bottom: 4px;
                font-size: .78rem;
                font-weight: 800;
            }

            .quality-liberacion .quality-firstpieces-grid .quality-form-control {
                min-height: 34px;
                padding: 5px 8px;
            }

            .quality-liberacion .quality-firstpieces-grid .quality-firstpieces-full {
                grid-column: 1 / -1;
            }

        .quality-liberacion .quality-firstpieces-card .quality-form-actions {
            margin-top: 10px;
            gap: 8px;
        }

        .quality-liberacion .quality-firstpieces-card .quality-btn {
            min-height: 34px;
            padding: 6px 11px;
            font-size: .82rem;
        }

        .quality-liberacion .quality-firstpieces-card textarea.quality-result-observation {
            min-height: 54px;
            height: 54px;
            padding: 6px 8px;
        }

    @@media(max-width:720px) {
        .quality-liberacion .quality-form-grid {
            grid-template-columns: 1fr
        }


        .quality-liberacion .quality-auditor-card .quality-checklist-grid {
            grid-template-columns: 1fr
        }

        .quality-liberacion .quality-auditor-card .quality-card-header {
            align-items: flex-start;
            flex-wrap: wrap
        }

        .quality-liberacion .quality-firstpieces-grid {
            grid-template-columns: 1fr;
        }

        .quality-liberacion .quality-decision-summary {
            grid-template-columns: 1fr;
        }

        .quality-liberacion .quality-firstpieces-grid .quality-firstpieces-full {
            grid-column: auto;
        }

        .quality-liberacion .quality-form-actions {
            flex-direction: column
        }

            .quality-liberacion .quality-form-actions .quality-btn {
                width: 100%
            }
    }
</style>
<div class="quality-liberacion">
    <section class="quality-card">
        <div class="quality-card-header">
            <h2>
                <i class="fa-solid fa-file-circle-check"></i>
                Documentación y preparación
            </h2>
        </div>

        <div class="quality-card-body">
            <div class="quality-doc-list">
                <div class="quality-doc-item">
                    <span class="quality-doc-name">
                        <i class="fa-solid fa-list-check"></i>
                        Checklist de Producción
                    </span>

                    @if (Model.ChecklistValidado)
                    {
                        <span class="quality-check quality-check-ok">
                            <i class="fa-solid fa-check"></i>
                            Validado
                        </span>
                    }
                    else
                    {
                        <span class="quality-check quality-check-pending">
                            <i class="fa-solid fa-clock"></i>
                            Pendiente
                        </span>
                    }
                </div>

                <div class="quality-doc-item">
                    <span class="quality-doc-name">
                        <i class="fa-solid fa-clipboard-check"></i>
                        Hoja de inspección del producto
                    </span>

                    @if (Model.HojaInspeccionProducto)
                    {
                        <span class="quality-check quality-check-ok">
                            <i class="fa-solid fa-check"></i>
                            Disponible
                        </span>
                    }
                    else
                    {
                        <span class="quality-check quality-check-pending">
                            <i class="fa-solid fa-clock"></i>
                            Pendiente
                        </span>
                    }
                </div>

                <div class="quality-doc-item">
                    <span class="quality-doc-name">
                        <i class="fa-solid fa-shield-halved"></i>
                        Hoja de validación de Calidad
                    </span>

                    @if (Model.HojaValidacionCalidad)
                    {
                        <span class="quality-check quality-check-ok">
                            <i class="fa-solid fa-check"></i>
                            Disponible
                        </span>
                    }
                    else
                    {
                        <span class="quality-check quality-check-pending">
                            <i class="fa-solid fa-clock"></i>
                            Pendiente
                        </span>
                    }
                </div>
            </div>
        </div>
    </section>

    @if (puedePrearranque && Model.ChecklistArranqueID.HasValue && Model.PreguntasChecklistCalidad.Any())
    {
        <section class="quality-card quality-auditor-card" data-auditor-section>
            <div class="quality-card-header">
                <h2>
                    <i class="fa-solid fa-list-check"></i>
                    Sección del auditor de Calidad
                </h2>

                @if (seccionCalidadGuardada)
                {
                    <span class="quality-auditor-summary">
                        <i class="fa-solid fa-circle-check"></i>
                        Sección guardada
                    </span>
                }

                <button type="button"
                        class="quality-auditor-toggle"
                        data-auditor-toggle
                        aria-expanded="@(!seccionCalidadGuardada ? "true" : "false")">
                    <i class="fa-solid @(seccionCalidadGuardada ? "fa-pen-to-square" : "fa-chevron-up")"
                       data-auditor-toggle-icon></i>
                    <span data-auditor-toggle-text>
                        @(seccionCalidadGuardada ? "Ver o editar" : "Comprimir")
                    </span>
                </button>
            </div>

            <div class="quality-card-body quality-auditor-content @(seccionCalidadGuardada ? "is-collapsed" : string.Empty)"
                 data-auditor-content>
                <form asp-controller="Calidad"
                      asp-action="GuardarChecklistCalidad"
                      method="post"
                      data-auditor-form>
                    @Html.AntiForgeryToken()

                    <input type="hidden" name="InspeccionID" value="@Model.InspeccionID" />
                    <input type="hidden" name="ChecklistArranqueID" value="@Model.ChecklistArranqueID" />

                    <div class="quality-checklist-instructions">
                        <i class="fa-solid fa-circle-info"></i>
                        <span>
                            Las respuestas nuevas comienzan en <strong>OK</strong>.
                            Cambia a <strong>NOK</strong> o marca <strong>N/A</strong> para habilitar observaciones.
                        </span>
                    </div>

                    @for (var i = 0; i < Model.PreguntasChecklistCalidad.Count; i++)
                    {
                        var pregunta = Model.PreguntasChecklistCalidad[i];
                        var resultadoActual = string.IsNullOrWhiteSpace(pregunta.Resultado)
                        ? "OK"
                        : pregunta.Resultado.Trim().ToUpperInvariant();
                        var esNa = resultadoActual == "NA";
                        var esNok = resultadoActual == "NOK";
                        var esOk = !esNa && !esNok;
                        var observacionesHabilitadas = esNok || esNa;

                        <input type="hidden"
                               name="Respuestas[@i].ChecklistArranqueDetalleID"
                               value="@pregunta.ChecklistArranqueDetalleID" />

                        <div class="quality-side-action quality-checklist-item"
                             data-quality-result>
                            <h3>@pregunta.OrdenPregunta. @pregunta.TextoPregunta</h3>

                            <input type="hidden"
                                   name="Respuestas[@i].Resultado"
                                   value="@resultadoActual"
                                   data-result-value />

                            <div class="quality-form-grid quality-checklist-grid">
                                <div>
                                    <label class="quality-form-label">Resultado</label>

                                    <div class="quality-result-selector">
                                        <div class="quality-result-switch-group">
                                            <span class="quality-result-option quality-result-option-nok">NOK</span>

                                            <label class="quality-toggle-switch"
                                                   title="Cambiar entre NOK y OK">
                                                <input type="checkbox"
                                                       data-result-switch
                                                       checked="@(esOk ? "checked" : null)"
                                                       disabled="@(esNa ? "disabled" : null)" />
                                                <span class="quality-toggle-slider"></span>
                                            </label>

                                            <span class="quality-result-option quality-result-option-ok">OK</span>
                                        </div>

                                        <label class="quality-na-option">
                                            <input type="checkbox"
                                                   data-result-na
                                                   checked="@(esNa ? "checked" : null)" />
                                            <span>N/A</span>
                                        </label>
                                    </div>

                                    <div class="quality-result-current"
                                         data-result-caption>
                                        @(esNa ? "No aplica" : esNok ? "No conforme" : "Conforme")
                                    </div>
                                </div>

                                <div>
                                    <label class="quality-form-label">Observaciones</label>
                                    <textarea name="Respuestas[@i].Observaciones"
                                      class="quality-form-control quality-result-observation @(observacionesHabilitadas ? "" : "is-locked")"
                                      maxlength="500"
                                      rows="2"
                                      data-result-observation
                                      readonly="@(!observacionesHabilitadas ? "readonly" : null)"
                                      aria-readonly="@(!observacionesHabilitadas ? "true" : "false")"
                                      placeholder="@(esNok ? "Describe la no conformidad (obligatorio)..." : esNa ? "Explica por qué no aplica (opcional)..." : "Se habilita al seleccionar NOK o N/A")">@pregunta.Observaciones</textarea>
                                    <div class="quality-observation-help" data-observation-help>
                                        @(esNok
                                                                        ? "La observación es obligatoria para un resultado NOK."
                                                                        : esNa
                                                                        ? "Puedes documentar por qué esta validación no aplica."
                                                                        : "El campo se habilitará cuando el resultado sea NOK o N/A.")
                            </div>
                        </div>
                    </div>
                </div>
                                }

                    <label class="quality-form-label">Observaciones generales de Calidad</label>
                    <textarea name="ObservacionesCalidad"
                          class="quality-form-control quality-general-observation"
                          maxlength="1000"
                          rows="2"
                          placeholder="Observaciones generales de la revisión..."></textarea>

                    <button type="submit"
                            class="quality-btn quality-btn-primary mt-3"
                            data-auditor-submit>
                        <i class="fa-solid fa-floppy-disk"></i>
                        <span data-auditor-submit-text>Guardar sección de Calidad</span>
                    </button>
                </form>
            </div>
        </section>
    }

    @if (puedePrearranque)
    {
        <section class="quality-card">
            <div class="quality-card-header">
                <h2>
                    <i class="fa-solid fa-power-off"></i>
                    Decisión de prearranque
                </h2>
            </div>

            <div class="quality-card-body">
                <div class="quality-alert quality-alert-warning">
                    <i class="fa-solid fa-circle-info mt-1"></i>
                    <div>
                        Verifica que la OF, máquina, molde, material,
                        documentación y personal correspondan con la corrida.
                    </div>
                </div>

                <div class="quality-form-grid">
                    <form asp-controller="Calidad"
                          asp-action="AutorizarPrearranqueFlujo"
                          method="post"
                          class="quality-side-action"
                          data-confirm="¿Confirmas que la máquina está lista para realizar el arranque controlado?">

                        @Html.AntiForgeryToken()

                        <input type="hidden"
                               name="InspeccionID"
                               value="@Model.InspeccionID" />

                        <h3>Autorizar arranque</h3>

                        <p>
                            Permite a Producción poner en funcionamiento la máquina
                            para generar las primeras piezas.
                        </p>

                        <div class="quality-form-check mb-2">
                            <input asp-for="AyudaVisualColocada" class="form-check-input" />
                            <label asp-for="AyudaVisualColocada">Ayuda visual colocada</label>
                        </div>

                        <div class="quality-form-check mb-2">
                            <input asp-for="HIPColocada" class="form-check-input" />
                            <label asp-for="HIPColocada">HIP colocado</label>
                        </div>

                        <div class="quality-form-check mb-2">
                            <input asp-for="HCCColocada" class="form-check-input" />
                            <label asp-for="HCCColocada">HCC colocada</label>
                        </div>

                        <div class="quality-form-check mb-3">
                            <input asp-for="MatrizPolivalenciaValidada" class="form-check-input" />
                            <label asp-for="MatrizPolivalenciaValidada">Matriz de polivalencia validada</label>
                        </div>

                        <label class="quality-form-label">¿Aplica alerta de Calidad?</label>
                        <select asp-for="AlertaCalidadAplica" class="quality-form-select mb-2">
                            <option value="">Selecciona</option>
                            <option value="false">No aplica</option>
                            <option value="true">Sí aplica</option>
                        </select>

                        <label class="quality-form-label">Alerta colocada</label>
                        <select asp-for="AlertaCalidadColocada" class="quality-form-select mb-3">
                            <option value="">No aplica / pendiente</option>
                            <option value="false">No</option>
                            <option value="true">Sí</option>
                        </select>

                        <label class="quality-form-label">
                            Comentario opcional
                        </label>

                        <textarea name="Motivo"
                              class="quality-form-control"
                              placeholder="Observaciones de la autorización..."></textarea>

                        <button type="submit"
                                class="quality-btn quality-btn-success mt-3">
                            <i class="fa-solid fa-circle-check"></i>
                            Autorizar prearranque
                        </button>
                    </form>

                    <form asp-controller="Calidad"
                          asp-action="DevolverPrearranqueFlujo"
                          method="post"
                          class="quality-side-action"
                          data-confirm="¿Confirmas que deseas devolver esta revisión a Producción?">

                        @Html.AntiForgeryToken()

                        <input type="hidden"
                               name="InspeccionID"
                               value="@Model.InspeccionID" />

                        <h3>Devolver a Producción</h3>

                        <p>
                            Utiliza esta acción cuando exista información,
                            documentación o preparación pendiente.
                        </p>

                        <label class="quality-form-label">
                            Motivo obligatorio
                        </label>

                        <textarea name="Motivo"
                              class="quality-form-control"
                              required
                              maxlength="1000"
                              placeholder="Describe exactamente qué debe corregirse...">@Model.MotivoDevolucion</textarea>

                        <button type="submit"
                                class="quality-btn quality-btn-danger mt-3">
                            <i class="fa-solid fa-rotate-left"></i>
                            Devolver revisión
                        </button>
                    </form>
                </div>
            </div>
        </section>
    }

    @if (puedeRegistrarPrimerasPiezas && !validacionListaParaDecision)
    {
        <section class="quality-card quality-firstpieces-card">
            <div class="quality-card-header">
                <h2>
                    <i class="fa-solid fa-vial-circle-check"></i>
                    @(esReliberacion
                                    ? "Validación de primeras piezas para reliberación"
                                    : "Validación de primeras piezas")
            </h2>
        </div>

            <div class="quality-card-body">
                <form method="post">
                    @Html.AntiForgeryToken()

                    <input type="hidden"
                           name="InspeccionID"
                           value="@Model.InspeccionID" />

                @{
                        var resultadoSegregados = Model.CincoDisparosSegregados ? "OK" : "NOK";
                        var resultadoDimensional = Model.ValidacionDimensional == false ? "NOK" : "OK";
                        var resultadoApariencia = Model.ValidacionApariencia == false ? "NOK" : "OK";
                        var resultadoGauge = Model.ValidacionGauge == false ? "NOK" : "OK";
                        var resultadoConductividad = Model.ValidacionConductividad == false ? "NOK" : "OK";
                        var habilitarObsPrimerasPiezas = !Model.CincoDisparosSegregados
                        || Model.CantidadDisparosConformes < 3
                        || Model.ValidacionDimensional == false
                        || Model.ValidacionApariencia == false
                        || Model.ValidacionGauge == false
                        || Model.ValidacionConductividad == false;
                    }

                    <div class="quality-checklist-instructions mb-3">
                        <i class="fa-solid fa-circle-info"></i>
                        <span>
                            @if (esReliberacion)
                            {
                                <text>
                                    La corrida fue detenida por un paro mayor a 15 minutos. Valida nuevamente los
                                    cinco disparos antes de autorizar el reinicio de la serie. Cada validación inicia
                                    en <strong>Cumple</strong>; cambia a <strong>No cumple</strong> o marca
                                    <strong>No aplica</strong> cuando corresponda.
                                </text>
                            }
                            else
                            {
                                <text>
                                    Cada validación inicia en <strong>Cumple</strong>. Cambia el interruptor a
                                    <strong>No cumple</strong> o marca <strong>No aplica</strong> cuando corresponda.
                                    Las observaciones generales se habilitan cuando exista una no conformidad,
                                    un campo que no aplica o menos de 3 disparos conformes.
                                </text>
                            }
                        </span>
                    </div>

                    <div class="quality-form-grid quality-firstpieces-grid" data-firstpieces-form>
                        <div class="quality-side-action quality-checklist-item"
                             data-first-piece-result>
                            <h3>1. Primeros cinco disparos segregados</h3>

                            <input type="hidden"
                                   name="CincoDisparosSegregados"
                                   value="@(Model.CincoDisparosSegregados ? "true" : "false")"
                                   data-first-value />

                            <div class="quality-result-selector">
                                <div class="quality-result-switch-group">
                                    <span class="quality-result-option quality-result-option-nok">No segregados</span>

                                    <label class="quality-toggle-switch" title="Cambiar entre NOK y OK">
                                        <input type="checkbox"
                                               data-first-switch
                                               checked="@(Model.CincoDisparosSegregados ? "checked" : null)" />
                                        <span class="quality-toggle-slider"></span>
                                    </label>

                                    <span class="quality-result-option quality-result-option-ok">Segregados</span>
                                </div>
                            </div>

                            <div class="quality-result-current" data-first-caption>
                                @(Model.CincoDisparosSegregados ? "Disparos segregados" : "Disparos no segregados")
                            </div>

                            <div class="quality-help">
                                Debe confirmarse que los primeros cinco disparos fueron segregados antes de continuar.
                            </div>
                        </div>

                        <div>
                            <label asp-for="CantidadDisparosConformes"
                                   class="quality-form-label">
                                Disparos conformes presentados
                            </label>

                            <input asp-for="CantidadDisparosConformes"
                                   type="number"
                                   min="0"
                                   max="5"
                                   class="quality-form-control"
                                   data-first-count />

                            <div class="quality-result-current">
                                <strong class="@(Model.CantidadDisparosConformes >= 3 ? "quality-result-ok" : "quality-result-nok")"
                                        data-first-count-caption>
                                    @(Model.CantidadDisparosConformes >= 3 ? "Cumple mínimo" : "Menos de 3 conformes")
                                </strong>
                            </div>

                            <div class="quality-help" data-first-count-help>
                                Se requieren al menos tres disparos conformes para liberar la producción.
                            </div>
                        </div>

                        <div class="quality-side-action quality-checklist-item"
                             data-first-piece-result>
                            <h3>2. Validación dimensional</h3>

                            <input type="hidden"
                                   name="ValidacionDimensional"
                                   value="@(Model.ValidacionDimensional == false ? "false" : "true")"
                                   data-first-value />

                            <div class="quality-result-selector">
                                <div class="quality-result-switch-group">
                                    <span class="quality-result-option quality-result-option-nok">No cumple</span>
                                    <label class="quality-toggle-switch" title="Cambiar entre NOK y OK">
                                        <input type="checkbox"
                                               data-first-switch
                                               checked="@(Model.ValidacionDimensional != false ? "checked" : null)" />
                                        <span class="quality-toggle-slider"></span>
                                    </label>
                                    <span class="quality-result-option quality-result-option-ok">Cumple</span>
                                </div>

                                <label class="quality-na-option">
                                    <input type="checkbox" data-first-na />
                                    <span>No aplica</span>
                                </label>
                            </div>

                            <div class="quality-result-current" data-first-caption>
                                @(resultadoDimensional == "NOK" ? "No cumple" : "Cumple")
                            </div>
                        </div>

                        <div class="quality-side-action quality-checklist-item"
                             data-first-piece-result>
                            <h3>3. Apariencia</h3>

                            <input type="hidden"
                                   name="ValidacionApariencia"
                                   value="@(Model.ValidacionApariencia == false ? "false" : "true")"
                                   data-first-value />

                            <div class="quality-result-selector">
                                <div class="quality-result-switch-group">
                                    <span class="quality-result-option quality-result-option-nok">No cumple</span>
                                    <label class="quality-toggle-switch" title="Cambiar entre NOK y OK">
                                        <input type="checkbox"
                                               data-first-switch
                                               checked="@(Model.ValidacionApariencia != false ? "checked" : null)" />
                                        <span class="quality-toggle-slider"></span>
                                    </label>
                                    <span class="quality-result-option quality-result-option-ok">Cumple</span>
                                </div>

                                <label class="quality-na-option">
                                    <input type="checkbox" data-first-na />
                                    <span>No aplica</span>
                                </label>
                            </div>

                            <div class="quality-result-current" data-first-caption>
                                @(resultadoApariencia == "NOK" ? "No cumple" : "Cumple")
                            </div>
                        </div>

                        <div class="quality-side-action quality-checklist-item"
                             data-first-piece-result>
                            <h3>4. Gauge</h3>

                            <input type="hidden"
                                   name="ValidacionGauge"
                                   value="@(Model.ValidacionGauge == false ? "false" : "true")"
                                   data-first-value />

                            <div class="quality-result-selector">
                                <div class="quality-result-switch-group">
                                    <span class="quality-result-option quality-result-option-nok">No cumple</span>
                                    <label class="quality-toggle-switch" title="Cambiar entre NOK y OK">
                                        <input type="checkbox"
                                               data-first-switch
                                               checked="@(Model.ValidacionGauge != false ? "checked" : null)" />
                                        <span class="quality-toggle-slider"></span>
                                    </label>
                                    <span class="quality-result-option quality-result-option-ok">Cumple</span>
                                </div>

                                <label class="quality-na-option">
                                    <input type="checkbox" data-first-na />
                                    <span>No aplica</span>
                                </label>
                            </div>

                            <div class="quality-result-current" data-first-caption>
                                @(resultadoGauge == "NOK" ? "No cumple" : "Cumple")
                            </div>
                        </div>

                        <div class="quality-side-action quality-checklist-item"
                             data-first-piece-result>
                            <h3>5. Conductividad</h3>

                            <input type="hidden"
                                   name="ValidacionConductividad"
                                   value="@(Model.ValidacionConductividad == false ? "false" : "true")"
                                   data-first-value />

                            <div class="quality-result-selector">
                                <div class="quality-result-switch-group">
                                    <span class="quality-result-option quality-result-option-nok">No cumple</span>
                                    <label class="quality-toggle-switch" title="Cambiar entre NOK y OK">
                                        <input type="checkbox"
                                               data-first-switch
                                               checked="@(Model.ValidacionConductividad != false ? "checked" : null)" />
                                        <span class="quality-toggle-slider"></span>
                                    </label>
                                    <span class="quality-result-option quality-result-option-ok">Cumple</span>
                                </div>

                                <label class="quality-na-option">
                                    <input type="checkbox" data-first-na />
                                    <span>No aplica</span>
                                </label>
                            </div>

                            <div class="quality-result-current" data-first-caption>
                                @(resultadoConductividad == "NOK" ? "No cumple" : "Cumple")
                            </div>
                        </div>

                        @{
                            const string observacionInicialSistema =
                            "Solicitud recibida desde Producción para revisión de prearranque.";

                            const string prefijoReliberacionSistema =
                            "Solicitud automática de reliberación por paro mayor a 15 minutos.";

                            var observacionActual = Model.Observaciones?.Trim();
                            var esObservacionGeneradaPorSistema =
                            string.Equals(
                            observacionActual,
                            observacionInicialSistema,
                            StringComparison.OrdinalIgnoreCase) ||
                            (!string.IsNullOrWhiteSpace(observacionActual) &&
                            observacionActual.StartsWith(
                            prefijoReliberacionSistema,
                            StringComparison.OrdinalIgnoreCase));

                            var observacionesPrimerasPiezas =
                            esObservacionGeneradaPorSistema
                            ? string.Empty
                            : Model.Observaciones;
                        }

                    <div class="quality-field-full quality-firstpieces-full">
                        <label class="quality-form-label">
                            Observaciones generales
                        </label>

                        <textarea name="Observaciones"
                                  class="quality-form-control quality-result-observation @(habilitarObsPrimerasPiezas ? string.Empty : "is-locked")"
                                  maxlength="1000"
                                  data-first-general-observation
                                  readonly="@(!habilitarObsPrimerasPiezas ? "readonly" : null)"
                                  aria-readonly="@(!habilitarObsPrimerasPiezas ? "true" : "false")"
                                  placeholder="@(habilitarObsPrimerasPiezas ? "Describe el motivo del No cumple, del No aplica o los ajustes necesarios..." : "Se habilita cuando exista algún No cumple, No aplica o menos de 3 disparos conformes")">@observacionesPrimerasPiezas</textarea>

                        <div class="quality-observation-help" data-first-general-help>
                            @(habilitarObsPrimerasPiezas
                                                        ? "Documenta aquí cualquier resultado No cumple, campo No aplica o ajuste requerido."
                                                        : "Las observaciones se habilitarán cuando exista un No cumple, un No aplica o menos de 3 disparos conformes.")
                        </div>
                    </div>
                </div>

                    <div class="quality-form-actions">
                        <button type="submit"
                                formaction="@Url.Action("SolicitarAjustesFlujo", "Calidad")"
                                class="quality-btn quality-btn-danger"
                                data-firstpieces-action="ajustes"
                                data-submit-confirm="@confirmacionAjustes">
                            <i class="fa-solid fa-screwdriver-wrench"></i>
                            @(esReliberacion ? "Rechazar reliberación" : "Solicitar ajustes")
                        </button>

                        <button type="submit"
                                formaction="@Url.Action("RegistrarPrimerasPiezasFlujo", "Calidad")"
                                class="quality-btn quality-btn-primary"
                                data-firstpieces-action="guardar"
                                data-submit-confirm="¿Confirmas que deseas guardar esta validación?">
                            <i class="fa-solid fa-floppy-disk"></i>
                            Guardar validación
                        </button>
                    </div>
                </form>
            </div>
        </section>
        }

    @if (validacionListaParaDecision)
    {
        <section class="quality-card quality-decision-card">
            <div class="quality-card-header">
                <h2>
                    <i class="fa-solid fa-scale-balanced"></i>
                    Decisión de reliberación
                </h2>
            </div>

            <div class="quality-card-body">
                <div class="quality-decision-summary">
                    <div class="quality-decision-status">
                        <strong>
                            <i class="fa-solid fa-circle-check"></i>
                            Validación guardada - intento #@intentoPendienteActual!.NumeroIntento
                        </strong>
                        <div>
                            Ya no necesitas volver a guardar el formulario.
                            Calidad debe decidir si autoriza el reinicio de la serie
                            o rechaza la reliberación para solicitar nuevas primeras piezas.
                        </div>
                    </div>

                    <div class="quality-decision-actions">
                        @if (datosSuficientesLiberacion)
                        {
                            <form asp-controller="Calidad"
                                  asp-action="LiberarProduccionFlujo"
                                  method="post"
                                  data-confirm="¿Confirmas que las primeras piezas son conformes y deseas autorizar la reliberación? Producción podrá reiniciar la serie.">
                                @Html.AntiForgeryToken()
                                <input type="hidden" name="id" value="@Model.InspeccionID" />

                                <button type="submit"
                                        class="quality-btn quality-btn-success">
                                    <i class="fa-solid fa-circle-check"></i>
                                    Autorizar reliberación
                                </button>
                            </form>
                        }
                        else
                        {
                            <div class="quality-decision-disabled">
                                <strong>No se puede autorizar todavía.</strong><br />
                                La validación guardada contiene un resultado que no cumple
                                los requisitos de liberación. Debe rechazarse y solicitar nuevas piezas.
                            </div>
                        }

                        <div class="quality-reject-box">
                            <form asp-controller="Calidad"
                                  asp-action="SolicitarAjustesFlujo"
                                  method="post"
                                  data-confirm="¿Confirmas que deseas rechazar la reliberación? Producción tendrá que corregir y presentar nuevas primeras piezas.">
                                @Html.AntiForgeryToken()

                                <input type="hidden" name="InspeccionID" value="@Model.InspeccionID" />
                                <input type="hidden" name="CincoDisparosSegregados" value="@(Model.CincoDisparosSegregados ? "true" : "false")" />
                                <input type="hidden" name="CantidadDisparosConformes" value="@Model.CantidadDisparosConformes" />
                                <input type="hidden" name="ValidacionDimensional" value="@ValorBoolNullable(Model.ValidacionDimensional)" />
                                <input type="hidden" name="ValidacionApariencia" value="@ValorBoolNullable(Model.ValidacionApariencia)" />
                                <input type="hidden" name="ValidacionGauge" value="@ValorBoolNullable(Model.ValidacionGauge)" />
                                <input type="hidden" name="ValidacionConductividad" value="@ValorBoolNullable(Model.ValidacionConductividad)" />

                                <label class="quality-form-label">
                                    Motivo del rechazo
                                </label>

                                <textarea name="Observaciones"
                                      class="quality-form-control"
                                      required
                                      maxlength="1000"
                                      placeholder="Describe qué debe corregir Producción antes de presentar nuevas primeras piezas..."></textarea>

                                <button type="submit"
                                        class="quality-btn quality-btn-danger">
                                    <i class="fa-solid fa-xmark"></i>
                                    Rechazar reliberación
                                </button>
                            </form>
                        </div>
                    </div>
                </div>
            </div>
        </section>
    }

    @if (hayValidacionPrimerasPiezas)
    {
        <section class="quality-card">
            <div class="quality-card-header">
                <h2>
                    <i class="fa-solid fa-chart-simple"></i>
                    Resultado de primeras piezas
                </h2>
            </div>

            <div class="quality-card-body">
                <div class="quality-validation-list">
                    <div class="quality-validation-item">
                        <span>Primeros cinco disparos segregados</span>
                        <strong class="@(Model.CincoDisparosSegregados ? "quality-result-ok" : "quality-result-nok")">
                            @(Model.CincoDisparosSegregados ? "Sí" : "No")
                        </strong>
                    </div>

                    <div class="quality-validation-item">
                        <span>Disparos conformes</span>
                        <strong class="@(Model.CantidadDisparosConformes >= 3 ? "quality-result-ok" : "quality-result-nok")">
                            @Model.CantidadDisparosConformes de 5
                        </strong>
                    </div>

                    <div class="quality-validation-item">
                        <span>Dimensional</span>
                        <strong class="@ClaseResultadoNullable(Model.ValidacionDimensional)">
                            @ResultadoNullable(Model.ValidacionDimensional)
                        </strong>
                    </div>

                    <div class="quality-validation-item">
                        <span>Apariencia</span>
                        <strong class="@ClaseResultadoNullable(Model.ValidacionApariencia)">
                            @ResultadoNullable(Model.ValidacionApariencia)
                        </strong>
                    </div>

                    <div class="quality-validation-item">
                        <span>Gauge</span>
                        <strong class="@ClaseResultadoNullable(Model.ValidacionGauge)">
                            @ResultadoNullable(Model.ValidacionGauge)
                        </strong>
                    </div>

                    <div class="quality-validation-item">
                        <span>Conductividad</span>
                        <strong class="@ClaseResultadoNullable(Model.ValidacionConductividad)">
                            @ResultadoNullable(Model.ValidacionConductividad)
                        </strong>
                    </div>
                </div>

                @if (Model.FechaValidacionPrimerasPiezas.HasValue)
                {
                    <div class="quality-help mt-3">
                        Última validación:
                        @Model.FechaValidacionPrimerasPiezas.Value.ToString("dd/MM/yyyy HH:mm")
                    </div>
                }
            </div>
        </section>
    }

    @if (Model.IntentosPrimerasPiezas.Any())
    {
        <section class="quality-card">
            <div class="quality-card-header">
                <h2>
                    <i class="fa-solid fa-vials"></i>
                    Intentos de primeras piezas
                </h2>
            </div>

            <div class="quality-card-body table-responsive">
                <table class="table table-sm align-middle">
                    <thead>
                        <tr>
                            <th>Intento</th>
                            <th>Disparos</th>
                            <th>Dimensional</th>
                            <th>Apariencia</th>
                            <th>Gauge</th>
                            <th>Conductividad</th>
                            <th>Resultado</th>
                            <th>Fecha</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var intento in Model.IntentosPrimerasPiezas)
                        {
                            <tr>
                                <td>#@intento.NumeroIntento</td>
                                <td>@intento.CantidadDisparosPresentados</td>
                                <td>@ResultadoNullable(intento.ValidacionDimensional)</td>
                                <td>@ResultadoNullable(intento.ValidacionApariencia)</td>
                                <td>@ResultadoNullable(intento.ValidacionGauge)</td>
                                <td>@ResultadoNullable(intento.ValidacionConductividad)</td>
                                <td><strong>@intento.Resultado</strong></td>
                                <td>@intento.FechaInicio.ToString("dd/MM/yyyy HH:mm")</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </section>
    }
</div>
<script>
    document.addEventListener('DOMContentLoaded',function(){
    function actualizarResultadoChecklist(c){const i=c.querySelector('[data-result-switch]'),n=c.querySelector('[data-result-na]'),v=c.querySelector('[data-result-value]'),o=c.querySelector('[data-result-observation]'),l=c.querySelector('[data-result-caption]'),a=c.querySelector('[data-observation-help]');if(!i||!n||!v||!o)return;let r;if(n.checked){r='NA';i.disabled=true}else{i.disabled=false;r=i.checked?'OK':'NOK'}v.value=r;c.classList.toggle('is-nok',r==='NOK');c.classList.toggle('is-na',r==='NA');const h=r==='NOK'||r==='NA';o.readOnly=!h;o.setAttribute('aria-readonly',h?'false':'true');o.classList.toggle('is-locked',!h);if(r==='NOK'){o.placeholder='Describe la no conformidad (obligatorio)...';if(l)l.textContent='No conforme';if(a)a.textContent='La observación es obligatoria para un resultado NOK.'}else if(r==='NA'){o.placeholder='Explica por qué no aplica (opcional)...';if(l)l.textContent='No aplica';if(a)a.textContent='Puedes documentar por qué esta validación no aplica.'}else{o.placeholder='Se habilita al seleccionar NOK o N/A';if(l)l.textContent='Conforme';if(a)a.textContent='El campo se habilitará cuando el resultado sea NOK o N/A.'}}
    document.querySelectorAll('.quality-liberacion [data-quality-result]').forEach(function(c){const i=c.querySelector('[data-result-switch]'),n=c.querySelector('[data-result-na]');if(!i||!n)return;actualizarResultadoChecklist(c);i.addEventListener('change',()=>actualizarResultadoChecklist(c));n.addEventListener('change',function(){if(n.checked)c.dataset.resultadoAnterior=i.checked?'OK':'NOK';else i.checked=c.dataset.resultadoAnterior!=='NOK';actualizarResultadoChecklist(c)})});
    document.querySelectorAll('.quality-liberacion form').forEach(function(f){if(!f.querySelector('[data-quality-result]'))return;f.addEventListener('submit',function(e){let p=null;f.querySelectorAll('[data-quality-result]').forEach(function(c){const v=c.querySelector('[data-result-value]'),o=c.querySelector('[data-result-observation]');if(!v||!o)return;const x=v.value==='NOK'&&!o.value.trim();o.classList.toggle('is-invalid',x);if(x&&!p)p=o});if(p){e.preventDefault();p.focus();p.scrollIntoView({behavior:'smooth',block:'center'});alert('Las respuestas NOK requieren una observación antes de guardar.')}})});
    document.querySelectorAll('.quality-liberacion [data-auditor-section]').forEach(function(section){
        const toggle=section.querySelector('[data-auditor-toggle]');
        const content=section.querySelector('[data-auditor-content]');
        const text=section.querySelector('[data-auditor-toggle-text]');
        const icon=section.querySelector('[data-auditor-toggle-icon]');
        const form=section.querySelector('[data-auditor-form]');
        const submit=form?.querySelector('[data-auditor-submit]');
        const submitText=form?.querySelector('[data-auditor-submit-text]');

        function actualizarToggle(){
            if(!toggle||!content)return;
            const collapsed=content.classList.contains('is-collapsed');
            toggle.setAttribute('aria-expanded',collapsed?'false':'true');
            if(text)text.textContent=collapsed?'Ver o editar':'Comprimir';
            if(icon){
                icon.classList.toggle('fa-pen-to-square',collapsed);
                icon.classList.toggle('fa-chevron-up',!collapsed);
            }
        }

        toggle?.addEventListener('click',function(){
            content?.classList.toggle('is-collapsed');
            actualizarToggle();
        });

        form?.addEventListener('submit',function(e){
            if(e.defaultPrevented||!submit)return;
            submit.disabled=true;
            submit.classList.add('quality-submit-disabled');
            if(submitText)submitText.textContent='Guardando sección...';
            const submitIcon=submit.querySelector('i');
            if(submitIcon){
                submitIcon.className='fa-solid fa-spinner fa-spin';
            }
        });

        actualizarToggle();
    });
    document.querySelectorAll('.quality-liberacion [data-firstpieces-form]').forEach(function(c){const f=c.closest('form'),o=c.querySelector('[data-first-general-observation]'),a=c.querySelector('[data-first-general-help]'),n=c.querySelector('[data-first-count]'),lc=c.querySelector('[data-first-count-caption]'),ac=c.querySelector('[data-first-count-help]');function item(x){const i=x.querySelector('[data-first-switch]'),na=x.querySelector('[data-first-na]'),v=x.querySelector('[data-first-value]'),l=x.querySelector('[data-first-caption]');if(!i||!v)return;let r;if(na&&na.checked){r='';i.disabled=true}else{if(na)i.disabled=false;r=i.checked?'true':'false'}v.value=r;x.classList.toggle('is-nok',r==='false');x.classList.toggle('is-na',!!(na&&na.checked));if(l)l.textContent=na&&na.checked?'No aplica':i.checked?'Cumple':'No cumple'}function all(){let nok=false,na=false;c.querySelectorAll('[data-first-piece-result]').forEach(function(x){const v=x.querySelector('[data-first-value]');if(v?.value==='false')nok=true;if(v?.value==='')na=true});const q=n?(parseInt(n.value||'0',10)||0):0,b=q<3,h=nok||na||b;if(lc){lc.textContent=b?'Menos de 3 conformes':'Cumple mínimo';lc.classList.toggle('quality-result-ok',!b);lc.classList.toggle('quality-result-nok',b)}if(ac)ac.textContent=b?'Debes documentar el motivo: se requieren al menos tres disparos conformes.':'Se cumplen los disparos mínimos requeridos para continuar.';if(o){o.readOnly=!h;o.setAttribute('aria-readonly',h?'false':'true');o.classList.toggle('is-locked',!h);if(nok||b){o.placeholder='Describe la no conformidad o el ajuste requerido...';if(a)a.textContent='Documenta aquí la causa del No cumple o por qué hay menos de 3 disparos conformes.'}else if(na){o.placeholder='Explica por qué la validación no aplica...';if(a)a.textContent='Documenta aquí el motivo por el que no aplica.'}else{o.placeholder='Se habilita cuando exista algún No cumple, No aplica o menos de 3 disparos conformes';if(a)a.textContent='Las observaciones se habilitarán cuando exista un No cumple, un No aplica o menos de 3 disparos conformes.'}}}c.querySelectorAll('[data-first-piece-result]').forEach(function(x){const i=x.querySelector('[data-first-switch]'),na=x.querySelector('[data-first-na]');item(x);i?.addEventListener('change',()=>{item(x);all()});na?.addEventListener('change',()=>{if(na.checked)x.dataset.resultadoAnterior=i&&i.checked?'OK':'NOK';else if(i)i.checked=x.dataset.resultadoAnterior!=='NOK';item(x);all()})});n?.addEventListener('input',all);n?.addEventListener('change',all);all();f?.addEventListener('submit',function(e){const s=e.submitter;if(!s)return;const acn=s.dataset.firstpiecesAction,obs=o?.value?.trim()||'',seg=c.querySelector('input[name="CincoDisparosSegregados"]')?.value;if(acn==='guardar'&&seg!=='true'){e.preventDefault();alert('Debes confirmar que los primeros cinco disparos fueron segregados para guardar la validación.');return}if(acn==='ajustes'&&!obs){e.preventDefault();o?.focus();alert('Describe los ajustes requeridos antes de enviar la solicitud a Producción.')}})});
    });
</script>