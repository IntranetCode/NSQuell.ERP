arán cuando exista un No cumple, un No aplica o menos de 3 disparos conformes.'}}}c.querySelectorAll('[data-first-piece-result]').forEach(function(x){const i=x.querySelector('[data-first-switch]'),na=x.querySelector('[data-first-na]');item(x);i?.addEventListener('change',()=>{item(x);all()});na?.addEventListener('change',()=>{if(na.checked)x.dataset.resultadoAnterior=i&&i.checked?'OK':'NOK';else if(i)i.checked=x.dataset.resultadoAnterior!=='NOK';item(x);all()})});n?.addEventListener('input',all);n?.addEventListener('change',all);all();f?.addEventListener('submit',function(e){const s=e.submitter;if(!s)return;const acn=s.dataset.firstpiecesAction,obs=o?.value?.trim()||'',seg=c.querySelector('input[name="CincoDisparosSegregados"]')?.value;if(acn==='guardar'&&seg!=='true'){e.preventDefault();alert('Debes confirmar que los primeros cinco disparos fueron segregados para guardar la validación.');return}if(acn==='ajustes'&&!obs){e.preventDefault();o?.focus();alert('Describe los ajustes requeridos antes de enviar la solicitud a Producción.')}})});
