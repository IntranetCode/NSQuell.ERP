@model ERP.NSQuell.Models.ViewModels.CalidadDetalleViewModel
@using ERP.NSQuell.Models
@{
    string ResultadoNullable(bool? valor) => valor switch { true => "Cumple", false => "No cumple", _ => "No aplica / pendiente" };
    string ClaseResultadoNullable(bool? valor) => valor switch { true => "quality-result-ok", false => "quality-result-nok", _ => "quality-result-na" };
    var estado = (Model.Estado ?? string.Empty).Trim().ToUpperInvariant();
    var esReliberacion = Model.EsReliberacion;
    var puedePrearranque = !Model.ConfiguracionInvalidada && (estado == CalidadEstados.PendientePrearranque || estado == CalidadEstados.DevueltoPrearranque);
    var puedeRegistrarPrimerasPiezas = !Model.ConfiguracionInvalidada && (estado == CalidadEstados.ArranqueAutorizado || estado == CalidadEstados.PendientePrimerasPiezas || estado == CalidadEstados.AjustesSolicitados || estado == CalidadEstados.PendienteReliberacion);
    var hayValidacionPrimerasPiezas = Model.FechaValidacionPrimerasPiezas.HasValue || Model.CincoDisparosSegregados || Model.CantidadDisparosConformes > 0 || Model.ValidacionDimensional.HasValue || Model.ValidacionApariencia.HasValue || Model.ValidacionGauge.HasValue || Model.ValidacionConductividad.HasValue;

    var intentoPendienteActual = Model.IntentosPrimerasPiezas
        .Where(x => x.Resultado == CalidadResultadoIntento.Pendiente)
        .OrderByDescending(x => x.NumeroIntento)
        .FirstOrDefault();

    var validacionListaParaDecision =
        esReliberacion &&
        estado == CalidadEstados.PendienteReliberacion &&
        intentoPendienteActual != null &&
        hayValidacionPrimerasPiezas;

    var datosSuficientesLiberacion =
        Model.CincoDisparosSegregados &&
        Model.CantidadDisparosConformes >= 3 &&
        Model.ValidacionDimensional == true &&
        Model.ValidacionApariencia == true &&
        Model.ValidacionGauge != false &&
        Model.ValidacionConductividad != false;

    string ValorBoolNullable(bool? valor) =>
        valor.HasValue ? (valor.Value ? "true" : "false") : string.Empty;

    var confirmacionAjustes = esReliberacion ? "¿Confirmas que deseas rechazar la reliberación y solicitar nuevas primeras piezas?" : "¿Confirmas que deseas solicitar ajustes a Producción?";
    var totalPreguntasCalidad = Model.PreguntasChecklistCalidad.Count;
    var preguntasCalidadRespondidas = Model.PreguntasChecklistCalidad.Count(x =>
        !string.IsNullOrWhiteSpace(x.Resultado) &&
        new[] { "OK", "NOK", "NO_APLICA", "N/A", "NA" }.Contains(x.Resultado.Trim().ToUpperInvariant()));
    var preguntasCalidadPendientes = totalPreguntasCalidad - preguntasCalidadRespondidas;
    var preguntasCalidadNok = Model.PreguntasChecklistCalidad.Count(x =>
        string.Equals(x.Resultado?.Trim(), "NOK", StringComparison.OrdinalIgnoreCase));
    var seccionCalidadGuardada = totalPreguntasCalidad > 0 && preguntasCalidadPendientes == 0;
    var checklistCalidadPuedeAutorizar = seccionCalidadGuardada && preguntasCalidadNok == 0;
    var respuestasChecklistGuardadas = Model.PreguntasChecklistCalidad
        .Where(x => !string.IsNullOrWhiteSpace(x.Resultado) && new[] { "OK", "NOK", "NO_APLICA", "N/A", "NA" }.Contains(x.Resultado.Trim().ToUpperInvariant()))
        .OrderBy(x => x.OrdenSeccion)
        .ThenBy(x => x.OrdenPregunta)
        .ThenBy(x => x.PreguntaID)
        .ToList();
    var hayRespuestasPrevias = respuestasChecklistGuardadas.Any() || hayValidacionPrimerasPiezas || Model.AyudaVisualColocada || Model.HIPColocada || Model.HCCColocada || Model.MatrizPolivalenciaValidada || Model.AlertaCalidadAplica.HasValue || Model.AlertaCalidadColocada.HasValue || !string.IsNullOrWhiteSpace(Model.MotivoDevolucion);
}
