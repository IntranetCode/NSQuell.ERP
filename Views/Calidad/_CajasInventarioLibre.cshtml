@model ERP.NSQuell.Models.ViewModels.CalidadCajasInventarioLibreVm

<section class="quality-list-card mb-4" id="cajas-inventario-libre">
    <div class="quality-list-header">
        <div>
            <h2>
                <i class="fa-solid fa-barcode"></i>
                Inventario libre de cajas en Calidad
            </h2>
            <div class="quality-help">
                Escanea varias etiquetas y conviértelas con la misma estructura usada por Almacén PT.
                No se exige que la caja esté ligada a una ejecución/OF del ERP ni que corresponda a una caja completa.
            </div>
        </div>

        <span class="quality-result-count">
            <i class="fa-solid fa-boxes-stacked"></i>
            @Model.TotalCajas caja(s) · @Model.TotalPiezas.ToString("N0") pieza(s)
        </span>
    </div>

    <div class="p-3 p-lg-4 border-bottom">
        <form asp-controller="Calidad"
              asp-action="RegistrarCajasInventarioLibre"
              method="post"
              id="formCajasInventarioLibre">
            @Html.AntiForgeryToken()

            <label class="form-label fw-bold">
                Etiquetas a escanear
            </label>

            <textarea name="codigosEscaneados"
                      id="codigosCajasInventarioLibre"
                      rows="7"
                      class="form-control"
                      autocomplete="off"
                      placeholder="Escanea una etiqueta por línea..."></textarea>

            <div class="d-flex gap-2 flex-wrap mt-3">
                <button type="button"
                        class="quality-btn quality-btn-light"
                        id="btnConvertirCajasInventarioLibre">
                    <i class="fa-solid fa-wand-magic-sparkles"></i>
                    Convertir etiquetas
                </button>

                <button type="submit"
                        class="quality-btn quality-btn-primary">
                    <i class="fa-solid fa-box-archive"></i>
                    Registrar en inventario de Calidad
                </button>
            </div>
        </form>

        <div id="resultadoConversionCajasInventarioLibre"
             class="mt-3"
             hidden>
        </div>
    </div>

    <form asp-controller="Calidad"
          asp-action="EnviarCajasInventarioLibreAlmacen"
          method="post">
        @Html.AntiForgeryToken()

        <div class="p-3 border-bottom bg-light">
            <div class="row g-2 align-items-end">
                <div class="col-lg-7">
                    <label class="form-label fw-bold">
                        Ubicación destino en Almacén PT
                    </label>

                    <select name="ubicacionId"
                            class="form-select"
                            required>
                        <option value="">
                            -- Selecciona ubicación --
                        </option>

                        @foreach (var ubicacion in Model.Ubicaciones)
                        {
                            <option value="@ubicacion.UbicacionID">
                                @ubicacion.Texto
                            </option>
                        }
                    </select>
                </div>

                <div class="col-lg-5 text-lg-end">
                    <button type="submit"
                            class="quality-btn quality-btn-primary">
                        <i class="fa-solid fa-truck-ramp-box"></i>
                        Enviar seleccionadas a Almacén PT
                    </button>
                </div>
            </div>

            <div class="quality-help mt-2">
                Al enviar se crea la caja real de Almacén PT y su movimiento de entrada.
                SolicitudProduccionID queda NULL; la OF de la etiqueta es solo trazabilidad.
            </div>
        </div>

        @if (!Model.Items.Any())
        {
            <div class="quality-empty">
                <div class="quality-empty-icon">
                    <i class="fa-solid fa-box-open"></i>
                </div>

                <h3>No hay cajas en el inventario libre</h3>

                <p>
                    Escanea etiquetas para registrarlas en Calidad.
                </p>
            </div>
        }
        else
        {
            <div class="quality-table-wrap">
                <table class="quality-table">
                    <thead>
                        <tr>
                            <th style="width:55px;">Sel.</th>
                            <th>Etiqueta</th>
                            <th>Parte</th>
                            <th>OF etiqueta</th>
                            <th>Designación</th>
                            <th>Cantidad</th>
                            <th>Lote / caja</th>
                            <th>Estado</th>
                            <th>Fecha</th>
                        </tr>
                    </thead>

                    <tbody>
                    @foreach (var item in Model.Items)
                    {
                        var disponible =
                            string.Equals(
                                item.Estado,
                                "EN_CALIDAD",
                                StringComparison.OrdinalIgnoreCase);

                        <tr>
                            <td>
                                @if (disponible)
                                {
                                    <input type="checkbox"
                                           class="form-check-input"
                                           name="cajaInventarioIds"
                                           value="@item.CalidadCajaInventarioID" />
                                }
                            </td>

                            <td>
                                <span class="quality-primary-text">
                                    @item.CodigoBarras
                                </span>

                                <span class="quality-secondary-text">
                                    ID @item.CalidadCajaInventarioID
                                </span>
                            </td>

                            <td>
                                <span class="quality-primary-text">
                                    @item.NumeroParteCatalogo
                                </span>

                                <span class="quality-secondary-text">
                                    Etiqueta: @item.NumeroParteEtiqueta
                                </span>
                            </td>

                            <td>
                                @(string.IsNullOrWhiteSpace(item.NumeroOF)
                                    ? "—"
                                    : item.NumeroOF)
                            </td>

                            <td>
                                @(string.IsNullOrWhiteSpace(item.DesignacionEtiqueta)
                                    ? item.DescripcionCatalogo
                                    : item.DesignacionEtiqueta)
                            </td>

                            <td class="fw-bold">
                                @item.Cantidad.ToString("N0")
                            </td>

                            <td>
                                @(string.IsNullOrWhiteSpace(item.LoteEtiqueta)
                                    ? "—"
                                    : item.LoteEtiqueta)
                            </td>

                            <td>
                                @if (disponible)
                                {
                                    <span class="quality-status quality-status-warning">
                                        <i class="fa-solid fa-box"></i>
                                        En Calidad
                                    </span>
                                }
                                else
                                {
                                    <span class="quality-status quality-status-success">
                                        <i class="fa-solid fa-warehouse"></i>
                                        Enviada a Almacén
                                    </span>

                                    @if (item.AlmacenPTCajaID.HasValue)
                                    {
                                        <span class="quality-secondary-text">
                                            Caja PT #@item.AlmacenPTCajaID
                                        </span>
                                    }
                                }
                            </td>

                            <td>
                                @item.FechaEscaneoCalidad.ToString("dd/MM/yyyy HH:mm")
                            </td>
                        </tr>
                    }
                    </tbody>
                </table>
            </div>
        }
    </form>
</section>

<script>
(() => {
    const form =
        document.getElementById(
            'formCajasInventarioLibre');

    const button =
        document.getElementById(
            'btnConvertirCajasInventarioLibre');

    const result =
        document.getElementById(
            'resultadoConversionCajasInventarioLibre');

    if (!form || !button || !result)
        return;

    button.addEventListener(
        'click',
        async () => {

            const textarea =
                document.getElementById(
                    'codigosCajasInventarioLibre');

            const token =
                form.querySelector(
                    'input[name="__RequestVerificationToken"]');

            if (!textarea?.value.trim())
            {
                result.hidden=false;
                result.innerHTML=
                    '<div class="alert alert-warning mb-0">Escanea al menos una etiqueta.</div>';
                return;
            }

            button.disabled=true;
            button.innerHTML=
                '<i class="fa-solid fa-spinner fa-spin"></i> Convirtiendo...';

            try
            {
                const data=
                    new FormData();

                data.append(
                    'codigosEscaneados',
                    textarea.value);

                if (token)
                {
                    data.append(
                        '__RequestVerificationToken',
                        token.value);
                }

                const response=
                    await fetch(
                        '@Url.Action("ConvertirCajasInventarioLibre","Calidad")',
                        {
                            method:'POST',
                            body:data,
                            credentials:'same-origin'
                        });

                const json=
                    await response.json();

                if (!response.ok || !json.ok)
                {
                    throw new Error(
                        json.mensaje
                        || 'No fue posible convertir las etiquetas.');
                }

                const rows=
                    (json.items || [])
                    .map(x => `
                        <tr>
                            <td>${x.renglon}</td>
                            <td class="text-break">${escapeHtml(x.codigoOriginal)}</td>
                            <td>${escapeHtml(x.numeroParte || '')}</td>
                            <td>${Number(x.cantidad || 0).toLocaleString()}</td>
                            <td>${escapeHtml(x.lote || '')}</td>
                            <td>
                                <span class="badge ${x.valido ? 'bg-success' : 'bg-danger'}">
                                    ${x.valido ? 'Válida' : 'Revisar'}
                                </span>
                                <div class="small mt-1">${escapeHtml(x.mensaje || '')}</div>
                            </td>
                        </tr>`)
                    .join('');

                result.hidden=false;
                result.innerHTML=`
                    <div class="alert alert-info">
                        Conversión: <strong>${json.validas}</strong> válida(s),
                        <strong>${json.invalidas}</strong> por revisar.
                    </div>
                    <div class="table-responsive">
                        <table class="table table-sm align-middle">
                            <thead>
                                <tr>
                                    <th>#</th>
                                    <th>Etiqueta</th>
                                    <th>Parte</th>
                                    <th>Cantidad</th>
                                    <th>Lote</th>
                                    <th>Resultado</th>
                                </tr>
                            </thead>
                            <tbody>${rows}</tbody>
                        </table>
                    </div>`;
            }
            catch (error)
            {
                result.hidden=false;
                result.innerHTML=
                    `<div class="alert alert-danger mb-0">${escapeHtml(error.message || String(error))}</div>`;
            }
            finally
            {
                button.disabled=false;
                button.innerHTML=
                    '<i class="fa-solid fa-wand-magic-sparkles"></i> Convertir etiquetas';
            }
        });

    function escapeHtml(value)
    {
        return String(value ?? '')
            .replaceAll('&','&amp;')
            .replaceAll('<','&lt;')
            .replaceAll('>','&gt;')
            .replaceAll('"','&quot;')
            .replaceAll("'","&#039;");
    }
})();
</script>