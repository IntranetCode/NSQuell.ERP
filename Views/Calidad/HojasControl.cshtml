@model ERP.NSQuell.Models.ViewModels.CalidadHCCIndexViewModel
@{
    ViewData["Title"] = "Hojas de Control de Calidad";
}
<div class="container-fluid py-4">
    <div class="d-flex flex-wrap justify-content-between align-items-center gap-3 mb-4">
        <div>
            <h1 class="h3 fw-bold mb-1">Hojas de Control de Calidad</h1>
            <div class="text-secondary">Plantillas HCC vinculadas a cada número de parte del ERP.</div>
        </div>
        <a asp-action="Index" class="btn btn-outline-secondary">Volver a Calidad</a>
    </div>

    <form method="get" class="card card-body mb-3">
        <div class="input-group">
            <input name="busqueda" value="@Model.Busqueda" class="form-control"
                   placeholder="Número de parte, referencia SAP, designación o cliente" />
            <button class="btn btn-primary" type="submit">Buscar</button>
            <a asp-action="HojasControl" class="btn btn-outline-secondary">Limpiar</a>
        </div>
    </form>

    <div class="card">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead>
                    <tr>
                        <th>Parte</th><th>Designación</th><th>Cliente</th><th>HCC / Revisión</th>
                        <th>Contenido</th><th>Vínculo</th><th class="text-end">Acciones</th>
                    </tr>
                </thead>
                <tbody>
                @foreach (var x in Model.Plantillas)
                {
                    <tr>
                        <td>
                            <strong>@x.NumeroParte</strong><br />
                            @if (x.ParteActiva)
                            { <span class="badge text-bg-success">Activa</span> }
                            else
                            { <span class="badge text-bg-secondary">Histórica/Inactiva</span> }
                            @if (x.EsRelacionPrincipal)
                            { <span class="badge text-bg-primary">Principal</span> }
                        </td>
                        <td>@x.Designacion</td>
                        <td>@x.Cliente</td>
                        <td>
                            <strong>@x.NumeroHCC</strong><br />
                            <small>Rev. @x.VersionFormato @x.FechaModificacionFormato?.ToString("yyyy-MM-dd")</small>
                        </td>
                        <td><small>@x.Caracteristicas características · @x.Checklist checklist</small></td>
                        <td>
                            <small>@x.MetodoMapeo</small>
                            @if (x.ConfianzaMapeo.HasValue)
                            { <div><span class="badge text-bg-info">@x.ConfianzaMapeo.Value.ToString("0.##")%</span></div> }
                        </td>
                        <td class="text-end text-nowrap">
                            <a asp-action="HojaControl" asp-route-id="@x.PlantillaHCCID" asp-route-parteId="@x.ParteID"
                               class="btn btn-sm btn-outline-primary">Ver</a>
                            <a asp-action="CapturarHCC" asp-route-id="@x.PlantillaHCCID" asp-route-parteId="@x.ParteID"
                               class="btn btn-sm btn-primary">Capturar</a>
                        </td>
                    </tr>
                }
                @if (!Model.Plantillas.Any())
                {
                    <tr><td colspan="7" class="text-center text-secondary py-5">No se encontraron HCC vinculadas.</td></tr>
                }
                </tbody>
            </table>
        </div>
    </div>
</div>
