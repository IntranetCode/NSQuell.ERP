@model ERP.NSQuell.Models.ViewModels.Almacen.AlmacenPTMovimientoFormVm
@{ Layout = "~/Views/Shared/_AlmacenLayout.cshtml"; ViewData["Title"] = "Movimiento PT"; }
<section class="alm-hero"><div><small>PRODUCTO TERMINADO</small><h1>Movimiento PT</h1><p>Salida, embarque, retención, liberación, retorno, scrap o ajuste.</p></div></section><section class="alm-card"><form method="post" class="alm-form"><div asp-validation-summary="ModelOnly" class="alm-field full"></div><div class="alm-field full"><label asp-for="ParteID"></label><select asp-for="ParteID" class="alm-select"><option value="">Selecciona</option>@foreach(var x in Model.Partes){<option value="@x.Id">@x.Texto</option>}</select></div><div class="alm-field full"><label asp-for="CajaID"></label><select asp-for="CajaID" class="alm-select"><option value="">Movimiento general por parte</option>@foreach(var x in Model.Cajas){<option value="@x.Id">@x.Texto</option>}</select></div><div class="alm-field"><label asp-for="TipoMovimiento"></label><select asp-for="TipoMovimiento" class="alm-select">@foreach(var x in Model.TiposMovimiento){<option value="@x.Extra">@x.Texto</option>}</select></div><div class="alm-field"><label asp-for="Cantidad"></label><input asp-for="Cantidad" class="alm-input"/></div><div class="alm-field"><label asp-for="UbicacionID"></label><select asp-for="UbicacionID" class="alm-select"><option value="">Sin ubicación</option>@foreach(var x in Model.Ubicaciones){<option value="@x.Id">@x.Texto</option>}</select></div><div class="alm-field"><label asp-for="NumeroOF"></label><input asp-for="NumeroOF" class="alm-input"/></div><div class="alm-field"><label asp-for="EstadoCalidad"></label><select asp-for="EstadoCalidad" class="alm-select"><option value="">Sin cambio</option>@foreach(var x in Model.EstadosCalidad){<option value="@x.Extra">@x.Texto</option>}</select></div><div class="alm-field full"><label asp-for="Observaciones"></label><textarea asp-for="Observaciones" class="alm-textarea"></textarea></div><div class="alm-field full"><button class="alm-btn">Guardar movimiento</button></div></form></section>
