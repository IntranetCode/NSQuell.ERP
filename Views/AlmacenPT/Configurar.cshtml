<section class="alm-hero"><div><small>@Model.NumeroParte</small><h1>Niveles de stock PT</h1><p>@Model.Descripcion</p></div><a class="alm-btn secondary" asp-action="Index">Volver</a></section><section class="alm-card"><form method="post" class="alm-form"><input asp-for="ParteID" type="hidden"/><input asp-for="NumeroParte" type="hidden"/><input asp-for="Descripcion" type="hidden"/><div asp-validation-summary="ModelOnly" class="alm-field full"></div><div class="alm-field"><label asp-for="StockMinimo"></label><input asp-for="StockMinimo" class="alm-input"/></div><div class="alm-field"><label asp-for="StockAviso"></label><input asp-for="StockAviso" class="alm-input"/></div><div class="alm-field full"><button class="alm-btn">Guardar niveles</button></div></form></section>
