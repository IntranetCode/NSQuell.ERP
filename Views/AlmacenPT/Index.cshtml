@model ERP.NSQuell.Models.ViewModels.Almacen.AlmacenPTIndexVm
@{
    Layout = "~/Views/Shared/_AlmacenLayout.cshtml";
    ViewData["Title"] = "Inventario PT";

    string NombreClienteCatalogo(string? nombre)
    {
        var valor = string.IsNullOrWhiteSpace(nombre)
            ? "Sin cliente"
            : nombre.Trim();

        if (valor.Equals("A&P", System.StringComparison.OrdinalIgnoreCase))
            return "A&P SOLUTIONS";

        return valor;
    }

    var gruposClientes = Model.Existencias
        .GroupBy(x => NombreClienteCatalogo(x.Cliente), System.StringComparer.OrdinalIgnoreCase)
        .OrderBy(x => x.Key)
        .ToList();

    string InicialCliente(string? nombre)
    {
        if (string.IsNullOrWhiteSpace(nombre) || nombre == "Sin cliente")
            return "?";

        return nombre.Trim().Substring(0, 1).ToUpperInvariant();
    }

    string IdCliente(int index) => $"pt_cliente_{index}";
    var busquedaActiva = !string.IsNullOrWhiteSpace(Model.Busqueda);
}

<style>
    .pt-search-result-card {
        border: 2px solid #0d6efd;
        box-shadow: 0 0 0 4px rgba(13, 110, 253, .10), 0 14px 30px rgba(15, 35, 65, .10);
    }

    .pt-search-result-card .pt-client-head {
        background: linear-gradient(90deg, rgba(13, 110, 253, .10), rgba(255, 255, 255, .98));
    }

    .pt-search-result-row > td {
        background: #fff8dc;
    }

    .pt-search-result-row .pt-part-link strong,
    .pt-search-result-row .pt-truncate-link {
        font-weight: 800;
    }
</style>

<section class="alm-hero">
    <div>
        <small>PRODUCTO TERMINADO</small>
        <h1>Inventario PT</h1>
        <p>Inventario organizado por cliente, mostrando únicamente el stock utilizable.</p>
    </div>
    <div class="alm-actions">
        <a class="alm-btn" asp-action="Entrada">
            <i class="fa-solid fa-barcode"></i>
            Recibir cajas
        </a>        <a class="alm-btn secondary" asp-action="Cajas">
            <i class="fa-solid fa-box"></i>
            Cajas
        </a>
        <a class="alm-btn secondary" asp-action="NivelesStock">
            <i class="fa-solid fa-sliders"></i>
            Niveles de stock
        </a>
        <a class="alm-btn secondary" asp-action="Historial">
            <i class="fa-solid fa-clock-rotate-left"></i>
            Historial
        </a>
    </div>
</section>

@if (!Model.Configurado)
{
    <div class="alm-alert warning">@Model.MensajeConfiguracion</div>
}

<section class="alm-card pt-client-catalog stock-only-catalog">
    <header>
        <span><i class="fa-solid fa-users-rectangle"></i> Catálogo PT por cliente</span>
        <span id="ptClientSummary">
            @Model.Existencias.Count.ToString("N0") parte@(Model.Existencias.Count == 1 ? "" : "s")
            · @gruposClientes.Count.ToString("N0") cliente@(gruposClientes.Count == 1 ? "" : "s")
        </span>
    </header>

    <form method="get" class="alm-filter pt-client-filter">
        <div class="alm-field">
            <label for="q">Número de parte, descripción o cliente</label>
            <div class="alm-smart-search" data-alm-smart-search data-alm-smart-submit="true">
                <input id="q"
                       class="alm-input"
                       type="search"
                       name="q"
                       value="@Model.Busqueda"
                       placeholder="Escribe una parte, descripción o cliente"
                       autocomplete="off"
                       data-alm-smart-input />
                <div class="alm-smart-search__menu" data-alm-smart-menu hidden>
                    @foreach (var item in Model.Existencias)
                    {
                        var textoBusqueda = $"{item.NumeroParte} {item.Descripcion} {item.Cliente}";
                        <button type="button" class="alm-smart-search__option"
                                data-alm-smart-option data-alm-smart-value="@item.NumeroParte" data-alm-smart-text="@textoBusqueda">
                            <strong>@item.NumeroParte</strong>
                            <span>@item.Descripcion</span>
                            <small>@item.Cliente</small>
                        </button>
                    }
                    <div class="alm-smart-search__empty" data-alm-smart-empty hidden>Sin coincidencias.</div>
                </div>
            </div>
        </div>
        <div class="alm-field">
            <label for="estado">Nivel de stock</label>
            <select id="estado" class="alm-select" name="estado">
                <option value="" selected="@(string.IsNullOrWhiteSpace(Model.Estado))">Todos los niveles</option>
                <option value="ROJO" selected="@(Model.Estado == "ROJO")">Crítico</option>
                <option value="AMARILLO" selected="@(Model.Estado == "AMARILLO")">Aviso</option>
                <option value="VERDE" selected="@(Model.Estado == "VERDE")">Disponible</option>
                <option value="SIN_CONFIGURAR" selected="@(Model.Estado == "SIN_CONFIGURAR")">Sin configurar</option>
            </select>
        </div>
        <div class="alm-field">
            <label for="ptClientFilter">Cliente visible</label>
            <select id="ptClientFilter" class="alm-select">
                <option value="">Todos los clientes</option>
                @foreach (var grupo in gruposClientes)
                {
                    <option value="@grupo.Key">@grupo.Key (@grupo.Count())</option>
                }
            </select>
        </div>
        <button class="alm-btn" type="submit"><i class="fa-solid fa-filter"></i> Filtrar</button>
        <a class="alm-btn secondary" asp-action="Index"><i class="fa-solid fa-filter-circle-xmark"></i> Limpiar</a>
    </form>

    @if (gruposClientes.Any())
    {
        <div class="pt-client-list" id="ptClientList">
            @{ var clienteIndex = 0; }
            @foreach (var grupo in gruposClientes)
            {
                clienteIndex++;
                var collapseId = IdCliente(clienteIndex);
                var partesCliente = grupo.OrderBy(x => x.NumeroParte).ThenBy(x => x.Descripcion).ToList();
                var stockCliente = partesCliente.Sum(x => (long)Math.Max(0, x.Disponible));

                <article class="pt-client-card@(busquedaActiva ? " pt-search-result-card" : "")"
                         data-pt-client-card
                         data-client="@grupo.Key"
                         data-part-count="@partesCliente.Count">
                    <button type="button"
                            class="pt-client-head"
                            data-bs-toggle="collapse"
                            data-bs-target="#@collapseId"
                            aria-expanded="@(busquedaActiva ? "true" : "false")"
                            aria-controls="@collapseId">
                        <span class="pt-client-head-main">
                            <span class="pt-client-avatar" aria-hidden="true">@InicialCliente(grupo.Key)</span>
                            <span class="pt-client-copy">
                                <strong>@grupo.Key</strong>
                                <small>@partesCliente.Count.ToString("N0") número@(partesCliente.Count == 1 ? "" : "s") de parte</small>
                            </span>
                        </span>
                        <span class="pt-client-metrics">
                            <span class="pt-client-pill"><small>Partes</small><strong>@partesCliente.Count.ToString("N0")</strong></span>
                            <span class="pt-client-pill is-available"><small>Stock</small><strong>@stockCliente.ToString("N0")</strong></span>
                            <span class="pt-client-chevron" aria-hidden="true"><i class="fa-solid fa-chevron-down"></i></span>
                        </span>
                    </button>

                    <div id="@collapseId" class="collapse@(busquedaActiva ? " show" : "")">
                        <div class="pt-client-body">
                            <div class="alm-table-wrap pt-client-table-wrap">
                                <table class="alm-table alm-table-fit pt-client-table stock-only-table">
                                    <colgroup>
                                        <col class="stock-col-code" />
                                        <col class="stock-col-description" />
                                        <col class="stock-col-quantity" />
                                        <col class="stock-col-date" />
                                        <col class="stock-col-actions" />
                                    </colgroup>
                                    <thead>
                                        <tr>
                                            <th>Número de parte</th>
                                            <th>Descripción</th>
                                            <th>Stock</th>
                                            <th>Último movimiento</th>
                                            <th aria-label="Acciones"></th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        @foreach (var x in partesCliente)
                                        {
                                            <tr class="@(busquedaActiva ? "pt-search-result-row" : "")">
                                                <td>
                                                    <a class="pt-part-link" asp-action="Historial" asp-route-parte="@x.NumeroParte" title="Ver trazabilidad de @x.NumeroParte">
                                                        <strong>@x.NumeroParte</strong>
                                                        <small>@x.Cajas caja(s)</small>
                                                    </a>
                                                </td>
                                                <td>
                                                    <a class="pt-truncate-link" asp-action="Historial" asp-route-parte="@x.NumeroParte" title="@x.Descripcion">@x.Descripcion</a>
                                                </td>
                                                <td class="pt-stock" data-label="Stock">
                                                    <span class="pt-stock-badge @x.Semaforo">
                                                        <strong>@Math.Max(0, x.Disponible).ToString("N0") PZA</strong>
                                                    </span>
                                                </td>
                                                <td class="pt-last-movement">
                                                    @if (x.UltimoMovimiento.HasValue)
                                                    {
                                                        <strong>@x.UltimoMovimiento.Value.ToString("dd/MM/yyyy")</strong>
                                                        <small>@x.UltimoMovimiento.Value.ToString("HH:mm")</small>
                                                    }
                                                    else
                                                    {
                                                        <span class="pt-empty-value">Sin movimientos</span>
                                                    }
                                                </td>
                                                <td>
                                                    <div class="pt-actions">
                                                        <a class="pt-action" asp-action="Configurar" asp-route-id="@x.ParteID" title="Configurar niveles de stock" aria-label="Configurar niveles de stock">
                                                            <i class="fa-solid fa-sliders"></i>
                                                        </a>
                                                        <a class="pt-action pt-action-history" asp-action="Historial" asp-route-parte="@x.NumeroParte" title="Ver historial de movimientos" aria-label="Ver historial de movimientos">
                                                            <i class="fa-solid fa-clock-rotate-left"></i>
                                                        </a>
                                                    </div>
                                                </td>
                                            </tr>
                                        }
                                    </tbody>
                                </table>
                            </div>
                        </div>
                    </div>
                </article>
            }
        </div>

        <div class="alm-empty pt-client-no-results" id="ptClientNoResults" hidden>
            No hay partes para el cliente seleccionado.
        </div>
    }
    else
    {
        <div class="alm-empty">No hay stock PT para los filtros seleccionados.</div>
    }
</section>

<section class="alm-card">
    <header>
        <span>@(busquedaActiva ? $"Movimientos recientes PT · {Model.Busqueda}" : "Movimientos recientes PT")</span>
        <a class="alm-header-link" asp-action="Historial">Ver historial completo <i class="fa-solid fa-arrow-right"></i></a>
    </header>
    <div class="alm-table-wrap">
        <table class="alm-table alm-table-movements">
            <thead>
                <tr>
                    <th>Fecha</th>
                    <th>Parte</th>
                    <th>Etiqueta</th>
                    <th>Tipo</th>
                    <th>Cantidad</th>
                    <th>Ubicación</th>
                    <th>OF</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var x in Model.Movimientos)
                {
                    <tr>
                        <td>@x.FechaMovimiento.ToString("dd/MM/yyyy HH:mm")</td>
                        <td><a class="alm-trace-link" asp-action="Historial" asp-route-parte="@x.NumeroParte">@x.NumeroParte · @x.Descripcion</a></td>
                        <td>@x.Etiqueta</td>
                        <td>@x.TipoMovimiento</td>
                        <td>@x.Cantidad</td>
                        <td>@x.Ubicacion</td>
                        <td>@x.NumeroOF</td>
                    </tr>
                }
                @if (!Model.Movimientos.Any())
                {
                    <tr><td colspan="7" class="alm-empty">No hay movimientos PT.</td></tr>
                }
            </tbody>
        </table>
    </div>
</section>

@section Scripts {
    <script>
        (() => {
            const select = document.getElementById('ptClientFilter');
            const cards = Array.from(document.querySelectorAll('[data-pt-client-card]'));
            const summary = document.getElementById('ptClientSummary');
            const noResults = document.getElementById('ptClientNoResults');

            if (!select || cards.length === 0) return;

            const normalize = value => (value || '')
                .toString()
                .toLocaleLowerCase('es-MX')
                .normalize('NFD')
                .replace(/[\u0300-\u036f]/g, '')
                .trim();

            const applyClientFilter = () => {
                const selected = normalize(select.value);
                let visibleClients = 0;
                let visibleParts = 0;

                cards.forEach(card => {
                    const client = normalize(card.dataset.client);
                    const visible = !selected || client === selected;
                    card.hidden = !visible;

                    if (visible) {
                        visibleClients++;
                        visibleParts += Number(card.dataset.partCount || 0);

                        if (selected && window.bootstrap) {
                            const collapseElement = card.querySelector('.collapse');
                            if (collapseElement) {
                                bootstrap.Collapse.getOrCreateInstance(collapseElement, { toggle: false }).show();
                            }
                        }
                    }
                });

                if (summary) {
                    summary.textContent =
                        `${visibleParts.toLocaleString('es-MX')} ${visibleParts === 1 ? 'parte' : 'partes'} · ` +
                        `${visibleClients.toLocaleString('es-MX')} ${visibleClients === 1 ? 'cliente' : 'clientes'}`;
                }

                if (noResults) {
                    noResults.hidden = visibleClients !== 0;
                }
            };

            select.addEventListener('change', applyClientFilter);
            applyClientFilter();
        })();
    </script>
}
