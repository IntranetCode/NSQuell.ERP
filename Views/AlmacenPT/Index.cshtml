@model ERP.NSQuell.Models.ViewModels.Almacen.AlmacenPTIndexVm
@{
    Layout = "~/Views/Shared/_AlmacenLayout.cshtml";
    ViewData["Title"] = "Inventario PT";
}

<section class="alm-hero">
    <div>
        <small>PRODUCTO TERMINADO</small>
        <h1>Inventario PT</h1>
        <p>Inventario por numero de parte. La existencia representa las piezas fisicamente registradas en Almacen PT.</p>
    </div>

    <div class="alm-actions">
        <a class="alm-btn" asp-action="Entrada">
            <i class="fa-solid fa-box"></i>
            Entrada PT
        </a>
        <a class="alm-btn secondary" asp-action="Movimiento">Movimiento</a>
        <a class="alm-btn secondary" asp-action="NivelesStock">
            <i class="fa-solid fa-sliders"></i>
            Niveles de stock
        </a>
        <a class="alm-btn secondary" asp-action="Historial">
            <i class="fa-solid fa-clock-rotate-left"></i>
            Historial
        </a>
        <a class="alm-btn secondary" asp-action="Movimiento" asp-route-tipo="AjustePositivo">Ajuste +</a>
        <a class="alm-btn secondary" asp-action="Movimiento" asp-route-tipo="AjusteNegativo">Ajuste −</a>
    </div>
</section>

@if (!Model.Configurado)
{
    <div class="alm-alert warning">@Model.MensajeConfiguracion</div>
}

<!-- ALMACEN_PT_KPIS_OPERATIVOS_V1_0 -->
<section class="alm-grid alm-grid-6">
    <div class="alm-kpi alm-kpi-demand">
        <small>Solicitado pendiente</small>
        <strong>
            @(Model.PiezasSolicitadasPendientes > 0
                ? $"-{Model.PiezasSolicitadasPendientes:N0}"
                : "0")
        </strong>
        <span class="alm-kpi-note">Piezas de OF programadas todavía no recibidas.</span>
    </div>

    <div class="alm-kpi">
        <small>OF pendientes PT</small>
        <strong>@Model.OFPendientesRecepcion.ToString("N0")</strong>
        <span class="alm-kpi-note">Órdenes con producto pendiente de ingresar.</span>
    </div>

    <div class="alm-kpi">
        <small>Cajas recibidas hoy</small>
        <strong>@Model.CajasRecibidasHoy.ToString("N0")</strong>
        <span class="alm-kpi-note">Cajas escaneadas con movimiento de entrada.</span>
    </div>

    <div class="alm-kpi">
        <small>Piezas recibidas hoy</small>
        <strong>@Model.PiezasRecibidasHoy.ToString("N0")</strong>
        <span class="alm-kpi-note">Total ingresado desde Producción.</span>
    </div>

    <div class="alm-kpi alm-kpi-out">
        <small>Salidas de hoy</small>
        <strong>
            @(Model.PiezasSalidasHoy > 0
                ? $"-{Model.PiezasSalidasHoy:N0}"
                : "0")
        </strong>
        <span class="alm-kpi-note">Salidas y embarques registrados hoy.</span>
    </div>

    <div class="alm-kpi alm-kpi-critical">
        <small>Partes críticas</small>
        <strong>@Model.Criticos.ToString("N0")</strong>
        <span class="alm-kpi-note">Partes en semáforo rojo.</span>
    </div>
</section>

<section class="alm-card">
    <header>
        <span>Existencias PT</span>
        <span>Catálogo base: ERP_Partes</span>
    </header>

    <form method="get" class="alm-filter">
        <div class="alm-field">
            <label for="q">Número de parte</label>
            <input id="q"
                   class="alm-input"
                   type="search"
                   name="q"
                   value="@Model.Busqueda"
                   list="inventario-pt-opciones"
                   placeholder="Escribe o selecciona una parte"
                   autocomplete="off" />

            <datalist id="inventario-pt-opciones">
                @foreach (var item in Model.Existencias)
                {
                    <option value="@item.NumeroParte">@item.NumeroParte · @item.Descripcion</option>
                }
            </datalist>
        </div>

        <select class="alm-select" name="estado">
            <option value="">Todos los niveles de stock</option>
            <option value="ROJO">Crítico</option>
            <option value="AMARILLO">Aviso</option>
            <option value="VERDE">Disponible</option>
            <option value="SIN_CONFIGURAR">Sin configurar</option>
        </select>

        <button class="alm-btn">Filtrar</button>
    </form>

    <div class="alm-table-wrap alm-table-wrap-fit">
        <table class="alm-table alm-table-fit alm-table-pt-final-v2">
            <colgroup>
                <col class="pt2-col-part" />
                <col class="pt2-col-description" />
                <col class="pt2-col-client" />
                <col class="pt2-col-stock" />
                <col class="pt2-col-requested" /><col class="pt2-col-price" />
                <col class="pt2-col-actions" />
            </colgroup>

            <thead>
                <tr>
                    <th>Número de parte</th>
                    <th>Descripción</th>
                    <th>Cliente</th>
                    <th>Existencia</th>
                    <th>Solicitado</th><th>Último movimiento</th>
                    <th aria-label="Acciones"></th>
                </tr>
            </thead>

            <tbody>
                @foreach (var x in Model.Existencias)
                {
                    <tr>
                        <td>
                            <a class="pt-part-link"
                               asp-action="Historial"
                               asp-route-parte="@x.NumeroParte"
                               title="Ver trazabilidad de @x.NumeroParte">
                                <strong>@x.NumeroParte</strong>
                                <small>@x.Cajas caja(s)</small>
                            </a>
                        </td>

                        <td>
                            <a class="pt-truncate-link"
                               asp-action="Historial"
                               asp-route-parte="@x.NumeroParte"
                               title="@x.Descripcion">
                                @x.Descripcion
                            </a>
                        </td>

                        <td>
                            <span class="pt-truncate" title="@x.Cliente">@x.Cliente</span>
                        </td>

                        <td class="pt-stock"
                            title="Existencia física: @x.SaldoFisico · Disponible real: @x.Disponible">
                            <span class="pt-stock-badge @x.Semaforo"
                                  title="Existencia física: @x.SaldoFisico · Disponible real: @x.Disponible">
                                <strong>@x.SaldoFisico</strong>
                            </span>
                        </td>

                        <!-- ALMACEN_PT_SOLICITADO_CELDA_V1_0 -->
                        <td class="pt-requested">
                            @if (x.Solicitado > 0)
                            {
                                <strong>-@x.Solicitado.ToString("N0")</strong>
                                <small>Pendiente</small>
                            }
                            else
                            {
                                <span class="pt-empty-value">0</span>
                            }
                        </td>
                        <td class="pt-last-movement">
                            @if (x.UltimoMovimiento.HasValue)
                            {
                                <strong>@x.UltimoMovimiento.Value.ToString("dd/MM/yyyy")</strong>
                                <small>@x.UltimoMovimiento.Value.ToString("HH:mm")</small>
                            }
                            else
                            {
                                <span class="pt-empty-value">Sin movimientos</span>
                            }
                        </td>                        <td>
                            <div class="pt-actions">
                                <a class="pt-action"
                                   asp-action="Movimiento"
                                   asp-route-parteId="@x.ParteID"
                                   title="Registrar movimiento"
                                   aria-label="Registrar movimiento">
                                    <i class="fa-solid fa-arrow-right-arrow-left"></i>
                                </a>

                                <a class="pt-action"
                                   asp-action="Configurar"
                                   asp-route-id="@x.ParteID"
                                   title="Configurar niveles de stock"
                                   aria-label="Configurar niveles de stock">
                                    <i class="fa-solid fa-sliders"></i>
                                </a>
                            </div>
                        </td>
                    </tr>
                }

                @if (!Model.Existencias.Any())
                {
                    <tr>
                        <td colspan="7" class="alm-empty">No hay existencias PT registradas.</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</section>

<section class="alm-card">
    <header>
        <span>Movimientos recientes PT</span>
        <a class="alm-header-link" asp-action="Historial">
            Ver historial completo
            <i class="fa-solid fa-arrow-right"></i>
        </a>
    </header>

    <div class="alm-table-wrap">
        <table class="alm-table alm-table-movements">
            <thead>
                <tr>
                    <th>Fecha</th>
                    <th>Parte</th>
                    <th>Etiqueta</th>
                    <th>Tipo</th>
                    <th>Cantidad</th>
                    <th>Calidad</th>
                    <th>Ubicación</th>
                    <th>OF</th>
                </tr>
            </thead>

            <tbody>
                @foreach (var x in Model.Movimientos)
                {
                    <tr>
                        <td>@x.FechaMovimiento.ToString("dd/MM/yyyy HH:mm")</td>
                        <td>
                            <a class="alm-trace-link"
                               asp-action="Historial"
                               asp-route-parte="@x.NumeroParte">
                                @x.NumeroParte · @x.Descripcion
                            </a>
                        </td>
                        <td>@x.Etiqueta</td>
                        <td>@x.TipoMovimiento</td>
                        <td>@x.Cantidad</td>
                        <td>@x.EstadoCalidad</td>
                        <td>@x.Ubicacion</td>
                        <td>@x.NumeroOF</td>
                    </tr>
                }

                @if (!Model.Movimientos.Any())
                {
                    <tr>
                        <td colspan="7" class="alm-empty">No hay movimientos PT.</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</section>



