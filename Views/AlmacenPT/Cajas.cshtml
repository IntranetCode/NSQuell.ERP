@* LOGISTICA_UX_RAPIDA_V1_4 *@
@model ERP.NSQuell.Models.ViewModels.Almacen.AlmacenPTCajasVm
@{
    Layout = "~/Views/Shared/_Layout.cshtml";
    ViewData["Title"] = "Lotes PT";
    var anterior = Math.Max(1, Model.Pagina - 1);
    var siguiente = Math.Min(Model.TotalPaginas, Model.Pagina + 1);
}

@section Styles {
    <link rel="stylesheet" href="~/css/Almacen/almacen-navegacion.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/nsquell-erp-theme.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/Almacen/almacen.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/Almacen/almacen-vistas.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/Almacen/almacen-temas.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/Almacen/almacen-pt-cajas.css" asp-append-version="true" />
}


@section Scripts {
    <script src="~/js/Almacen/almacen-vistas.js" asp-append-version="true"></script>
}


@await Html.PartialAsync("_AlmacenNavegacion")

@await Html.PartialAsync("_AlmacenMensajes")


<section class="ptl-head">
    <div>
        <span>PRODUCTO TERMINADO</span>
        <h1>Lotes PT</h1>
        <p>El lote de la etiqueta es el identificador operativo. El número interno de caja queda solo como referencia técnica.</p>
    </div>
    <div class="ptl-head-actions">
        <a class="alm-btn" asp-action="Entrada"><i class="fa-solid fa-barcode"></i> Recibir / escanear</a>
        <a class="alm-btn secondary" asp-action="Index"><i class="fa-solid fa-boxes-stacked"></i> Inventario PT</a>
    </div>
</section>

@if (!Model.Configurado)
{
    <div class="alm-alert warning">@Model.MensajeConfiguracion</div>
}
else
{
    <form method="get" class="ptl-filters">
        <div class="ptl-search">
            <i class="fa-solid fa-magnifying-glass"></i>
            <input type="search" name="q" value="@Model.Busqueda" placeholder="Lote, etiqueta, parte, cliente u OF" autocomplete="off" />
        </div>
        <input type="search" name="numeroOF" value="@Model.NumeroOF" placeholder="OF, ej. 0812/26" />
        <select name="estadoCalidad">
            <option value="">Calidad: todas</option>
            @foreach (var estado in Model.EstadosCalidadFiltro)
            {
                if (Model.EstadoCalidad == estado) { <option value="@estado" selected>@estado</option> }
                else { <option value="@estado">@estado</option> }
            }
        </select>
        <button class="alm-btn" type="submit"><i class="fa-solid fa-filter"></i> Filtrar</button>
        <a class="alm-btn secondary" asp-action="Cajas">Limpiar</a>
        <span class="ptl-count">@Model.TotalRegistros.ToString("N0") lote(s)</span>
    </form>

    <section class="ptl-table-shell">
        <div class="ptl-table-wrap">
            <table class="ptl-table">
                <thead>
                    <tr>
                        <th>Lote / etiqueta</th>
                        <th>Parte</th>
                        <th>Cliente</th>
                        <th>OF vinculada</th>
                        <th class="num">Disponible</th>
                        <th>Calidad</th>
                        <th>Ubicación</th>
                        <th>Entrada</th>
                        <th></th>
                    </tr>
                </thead>
                <tbody>
                @foreach (var x in Model.Cajas)
                {
                    var lote = string.IsNullOrWhiteSpace(x.LoteEtiqueta) ? x.Etiqueta : x.LoteEtiqueta;
                    <tr>
                        <td>
                            <div class="ptl-lote">
                                <span>LOTE</span>
                                <strong>@lote</strong>
                                <small>@x.Etiqueta</small>
                                <em>Caja interna #@x.NumeroCaja</em>
                            </div>
                        </td>
                        <td>
                            <a class="ptl-part" asp-action="Historial" asp-route-parte="@x.NumeroParte" asp-route-periodo="TODO">
                                <strong>@x.NumeroParte</strong>
                                <small>@x.Descripcion</small>
                            </a>
                        </td>
                        <td><span class="ptl-client">@(string.IsNullOrWhiteSpace(x.Cliente) ? "Sin cliente" : x.Cliente)</span></td>
                        <td>
                            @if (x.SolicitudProduccionID.HasValue)
                            {
                                <a class="ptl-of linked" asp-controller="AlmacenOF" asp-action="Detalle" asp-route-id="@x.SolicitudProduccionID.Value">
                                    <strong>@(string.IsNullOrWhiteSpace(x.NumeroOF) ? $"OF-ID-{x.SolicitudProduccionID.Value}" : x.NumeroOF)</strong>
                                    <small><i class="fa-solid fa-link"></i> enlazada</small>
                                </a>
                            }
                            else
                            {
                                <div class="ptl-of unlinked">
                                    <strong>@(string.IsNullOrWhiteSpace(x.NumeroOF) ? "Sin OF" : x.NumeroOF)</strong>
                                    <small><i class="fa-solid fa-link-slash"></i> sin vínculo interno</small>
                                </div>
                            }
                        </td>
                        <td class="num">
                            <strong class="ptl-stock">@x.Disponible.ToString("N0") PZA</strong>
                            <small>Físico @x.SaldoFisico.ToString("N0") · Ret. @x.Retenido.ToString("N0")</small>
                        </td>
                        <td><span class="ptl-quality ptl-quality-@x.EstadoCalidad.ToLowerInvariant()">@x.EstadoCalidad</span></td>
                        <td>@(string.IsNullOrWhiteSpace(x.Ubicacion) ? "Sin ubicación" : x.Ubicacion)</td>
                        <td><strong>@x.FechaEntrada.ToString("dd/MM/yy HH:mm")</strong><small>Últ. @(x.UltimoMovimiento?.ToString("dd/MM/yy HH:mm") ?? "—")</small></td>
                        <td>
                            <a class="ptl-trace" asp-action="Historial" asp-route-etiquetaLote="@lote" asp-route-periodo="TODO" title="Trazabilidad del lote"><i class="fa-solid fa-clock-rotate-left"></i></a>
                        </td>
                    </tr>
                }
                @if (!Model.Cajas.Any())
                {
                    <tr><td colspan="9" class="ptl-empty">No se encontraron lotes PT con los filtros seleccionados.</td></tr>
                }
                </tbody>
            </table>
        </div>

        @if (Model.TotalPaginas > 1)
        {
            <nav class="ptl-pager">
                <a class="alm-btn secondary small @(Model.Pagina <= 1 ? "disabled" : "")" asp-action="Cajas" asp-route-pagina="@anterior" asp-route-q="@Model.Busqueda" asp-route-numeroOF="@Model.NumeroOF" asp-route-estadoCalidad="@Model.EstadoCalidad">Anterior</a>
                <span>Página <b>@Model.Pagina</b> de <b>@Model.TotalPaginas</b></span>
                <a class="alm-btn secondary small @(Model.Pagina >= Model.TotalPaginas ? "disabled" : "")" asp-action="Cajas" asp-route-pagina="@siguiente" asp-route-q="@Model.Busqueda" asp-route-numeroOF="@Model.NumeroOF" asp-route-estadoCalidad="@Model.EstadoCalidad">Siguiente</a>
            </nav>
        }
    </section>
}
