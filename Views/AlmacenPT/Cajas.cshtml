@model ERP.NSQuell.Models.ViewModels.Almacen.AlmacenPTCajasVm
@{
    Layout = "~/Views/Shared/_AlmacenLayout.cshtml";
    ViewData["Title"] = "Cajas PT";
    var anterior = Math.Max(1, Model.Pagina - 1);
    var siguiente = Math.Min(Model.TotalPaginas, Model.Pagina + 1);
}

<section class="alm-hero">
    <div>
        <small>PRODUCTO TERMINADO</small>
        <h1>Cajas PT</h1>
        <p>Consulta cada caja recibida, su etiqueta, existencia actual y la orden de fabricación a la que quedó vinculada.</p>
    </div>
    <div class="alm-actions">
        <a class="alm-btn" asp-action="Entrada"><i class="fa-solid fa-barcode"></i> Recibir cajas</a>
        <a class="alm-btn secondary" asp-action="Index"><i class="fa-solid fa-boxes-stacked"></i> Inventario PT</a>
        <a class="alm-btn secondary" asp-action="Historial"><i class="fa-solid fa-clock-rotate-left"></i> Historial PT</a>
    </div>
</section>

@if (!Model.Configurado)
{
    <div class="alm-alert warning">@Model.MensajeConfiguracion</div>
}
else
{
    <section class="alm-card">
        <header>
            <span><i class="fa-solid fa-box"></i> Cajas registradas</span>
            <span>@Model.TotalRegistros.ToString("N0") caja(s)</span>
        </header>

        <form method="get" class="alm-filter alm-filter-history">
            <div class="alm-field">
                <label for="q">Caja, etiqueta, parte o cliente</label>
                <div class="alm-smart-search" data-alm-smart-search data-alm-smart-limit="10">
                    <input id="q" class="alm-input" type="search" name="q" value="@Model.Busqueda"
                           placeholder="Etiqueta, parte, descripción o cliente" autocomplete="off" data-alm-smart-input />
                    <div class="alm-smart-search__menu" data-alm-smart-menu hidden>
                        @foreach (var x in Model.Cajas)
                        {
                            var texto = $"{x.Etiqueta} {x.NumeroParte} {x.Descripcion} {x.Cliente} {x.NumeroOF}";
                            <button type="button" class="alm-smart-search__option"
                                    data-alm-smart-option data-alm-smart-value="@x.Etiqueta" data-alm-smart-text="@texto">
                                <strong>@x.Etiqueta</strong>
                                <span>@x.NumeroParte · @x.Descripcion</span>
                                <small>@(string.IsNullOrWhiteSpace(x.NumeroOF) ? "Sin OF" : x.NumeroOF)</small>
                            </button>
                        }
                        <div class="alm-smart-search__empty" data-alm-smart-empty hidden>Sin coincidencias.</div>
                    </div>
                </div>
            </div>

            <div class="alm-field">
                <label for="numeroOF">Orden de fabricación</label>
                <div class="alm-smart-search" data-alm-smart-search data-alm-smart-limit="10">
                    <input id="numeroOF" class="alm-input" type="search" name="numeroOF" value="@Model.NumeroOF"
                           placeholder="Todas las OF" autocomplete="off" data-alm-smart-input />
                    <div class="alm-smart-search__menu" data-alm-smart-menu hidden>
                        @foreach (var item in Model.OrdenesFiltro)
                        {
                            <button type="button" class="alm-smart-search__option"
                                    data-alm-smart-option data-alm-smart-value="@item" data-alm-smart-text="@item">
                                <strong>@item</strong><span>Orden de fabricación</span><small>PT</small>
                            </button>
                        }
                        <div class="alm-smart-search__empty" data-alm-smart-empty hidden>Sin coincidencias.</div>
                    </div>
                </div>
            </div>

            <div class="alm-field">
                <label for="estadoCalidad">Estado de calidad</label>
                <select id="estadoCalidad" class="alm-select" name="estadoCalidad">
                    <option value="">Todos</option>
                    @foreach (var estado in Model.EstadosCalidadFiltro)
                    {
                        <option value="@estado" selected="@(Model.EstadoCalidad == estado)">@estado</option>
                    }
                </select>
            </div>

            <div class="alm-filter-actions">
                <button class="alm-btn" type="submit"><i class="fa-solid fa-filter"></i> Filtrar</button>
                <a class="alm-btn secondary" asp-action="Cajas"><i class="fa-solid fa-filter-circle-xmark"></i> Limpiar</a>
            </div>
        </form>
    </section>

    <section class="alm-card">
        <header>
            <span>Detalle de cajas PT</span>
            <span>Página @Model.Pagina de @Model.TotalPaginas</span>
        </header>

        <div class="alm-table-wrap">
            <table class="alm-table pt-box-table">
                <thead>
                    <tr>
                        <th>Caja / etiqueta</th>
                        <th>Parte / cliente</th>
                        <th>Existencia</th>
                        <th>Calidad / lote</th>
                        <th>Orden de fabricación</th>
                        <th>Ubicación</th>
                        <th>Entrada / último movimiento</th>
                        <th></th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var x in Model.Cajas)
                    {
                        <tr>
                            <td>
                                <div class="pt-box-id">
                                    <strong>Caja @x.NumeroCaja</strong>
                                    <small>@x.Etiqueta</small>
                                </div>
                            </td>
                            <td>
                                <div class="pt-box-part">
                                    <a class="alm-trace-link" asp-action="Historial" asp-route-parte="@x.NumeroParte" asp-route-periodo="TODO">
                                        <strong>@x.NumeroParte</strong>
                                    </a>
                                    <small>@x.Descripcion</small>
                                    <small>@(string.IsNullOrWhiteSpace(x.Cliente) ? "Sin cliente" : x.Cliente)</small>
                                </div>
                            </td>
                            <td class="alm-number">
                                <strong>@x.Disponible.ToString("N0") PZA</strong>
                                <small class="alm-subtext">Físico @x.SaldoFisico.ToString("N0") · Retenido @x.Retenido.ToString("N0")</small>
                            </td>
                            <td>
                                <strong>@x.EstadoCalidad</strong>
                                <small class="alm-subtext">@(string.IsNullOrWhiteSpace(x.LoteEtiqueta) ? "Sin lote" : x.LoteEtiqueta)</small>
                            </td>
                            <td>
                                <div class="pt-box-of">
                                    @if (x.SolicitudProduccionID.HasValue)
                                    {
                                        <a class="pt-box-of-link" asp-controller="AlmacenOF" asp-action="Detalle" asp-route-id="@x.SolicitudProduccionID.Value">
                                            <strong>@(string.IsNullOrWhiteSpace(x.NumeroOF) ? $"OF-ID-{x.SolicitudProduccionID.Value}" : x.NumeroOF)</strong>
                                        </a>
                                        <span class="pt-box-link-state linked">OF vinculada</span>
                                    }
                                    else
                                    {
                                        <strong>@(string.IsNullOrWhiteSpace(x.NumeroOF) ? "Sin OF" : x.NumeroOF)</strong>
                                        <span class="pt-box-link-state unlinked">Sin vínculo interno</span>
                                    }
                                </div>
                            </td>
                            <td>@(string.IsNullOrWhiteSpace(x.Ubicacion) ? "Sin ubicación" : x.Ubicacion)</td>
                            <td>
                                <strong>@x.FechaEntrada.ToString("dd/MM/yyyy HH:mm")</strong>
                                <small class="alm-subtext">Último: @(x.UltimoMovimiento?.ToString("dd/MM/yyyy HH:mm") ?? "Sin movimientos")</small>
                            </td>
                            <td>
                                <a class="pt-action" asp-action="Historial" asp-route-etiquetaLote="@x.Etiqueta" asp-route-periodo="TODO" title="Ver trazabilidad de la caja">
                                    <i class="fa-solid fa-clock-rotate-left"></i>
                                </a>
                            </td>
                        </tr>
                    }
                    @if (!Model.Cajas.Any())
                    {
                        <tr><td colspan="8" class="alm-empty">No se encontraron cajas PT con los filtros seleccionados.</td></tr>
                    }
                </tbody>
            </table>
        </div>

        @if (Model.TotalPaginas > 1)
        {
            <nav class="alm-pager" aria-label="Paginación de cajas PT">
                <a class="alm-btn secondary small @(Model.Pagina <= 1 ? "disabled" : "")"
                   asp-action="Cajas" asp-route-pagina="@anterior" asp-route-q="@Model.Busqueda"
                   asp-route-numeroOF="@Model.NumeroOF" asp-route-estadoCalidad="@Model.EstadoCalidad">Anterior</a>
                <span>Página <strong>@Model.Pagina</strong> de <strong>@Model.TotalPaginas</strong></span>
                <a class="alm-btn secondary small @(Model.Pagina >= Model.TotalPaginas ? "disabled" : "")"
                   asp-action="Cajas" asp-route-pagina="@siguiente" asp-route-q="@Model.Busqueda"
                   asp-route-numeroOF="@Model.NumeroOF" asp-route-estadoCalidad="@Model.EstadoCalidad">Siguiente</a>
            </nav>
        }
    </section>
}
