@model ERP.NSQuell.Models.ViewModels.Almacen.AlmacenPTEntradaFormVm
@{ Layout = "~/Views/Shared/_AlmacenLayout.cshtml"; ViewData["Title"] = "Entrada PT"; }
<section class="alm-hero"><div><small>PRODUCTO TERMINADO</small><h1>Entrada de producto</h1><p>Registra la caja física y genera simultáneamente el movimiento de entrada.</p></div></section><section class="alm-card"><form method="post" class="alm-form"><div asp-validation-summary="ModelOnly" class="alm-field full"></div><div class="alm-field full"><label asp-for="ParteID"></label><select asp-for="ParteID" class="alm-select"><option value="">Selecciona</option>@foreach(var x in Model.Partes){<option value="@x.Id">@x.Texto</option>}</select></div><div class="alm-field"><label asp-for="Etiqueta"></label><input asp-for="Etiqueta" class="alm-input"/></div><div class="alm-field"><label asp-for="NumeroCaja"></label><input asp-for="NumeroCaja" class="alm-input"/></div><div class="alm-field"><label asp-for="Cantidad"></label><input asp-for="Cantidad" class="alm-input"/></div><div class="alm-field"><label asp-for="LoteEtiqueta"></label><input asp-for="LoteEtiqueta" class="alm-input"/></div><div class="alm-field"><label asp-for="NumeroOF"></label><input asp-for="NumeroOF" class="alm-input"/></div><div class="alm-field"><label asp-for="EstadoCalidad"></label><select asp-for="EstadoCalidad" class="alm-select">@foreach(var x in Model.EstadosCalidad){<option value="@x.Extra">@x.Texto</option>}</select></div><div class="alm-field full"><label asp-for="UbicacionID"></label><select asp-for="UbicacionID" class="alm-select"><option value="">Sin ubicación</option>@foreach(var x in Model.Ubicaciones){<option value="@x.Id">@x.Texto</option>}</select></div><div class="alm-field full"><label asp-for="Observaciones"></label><textarea asp-for="Observaciones" class="alm-textarea"></textarea></div><div class="alm-field full"><button class="alm-btn">Registrar entrada PT</button></div></form></section>
