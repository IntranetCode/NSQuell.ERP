@model ERP.NSQuell.Models.ViewModels.Almacen.AlmacenUbicacionesIndexVm
@{ Layout = "~/Views/Shared/_AlmacenLayout.cshtml"; ViewData["Title"] = "Ubicaciones"; }
<section class="alm-hero"><div><small>ERP_UBICACIONES</small><h1>Ubicaciones de almacén</h1><p>Catálogo compartido para MP, PT, cuarentena, scrap y ubicaciones generales.</p></div><a class="alm-btn" asp-action="Editar">Nueva ubicación</a></section><section class="alm-card"><div class="alm-table-wrap"><table class="alm-table"><thead><tr><th>Almacén</th><th>Rack</th><th>Nivel</th><th>Posición</th><th>Activo</th><th></th></tr></thead><tbody>@foreach(var x in Model.Ubicaciones){<tr><td>@x.Almacen</td><td>@x.Rack</td><td>@x.Nivel</td><td>@x.Posicion</td><td>@(x.Activo?"Sí":"No")</td><td><a class="alm-btn secondary" asp-action="Editar" asp-route-id="@x.UbicacionID">Editar</a></td></tr>}</tbody></table></div></section>
