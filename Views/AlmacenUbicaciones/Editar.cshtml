@model ERP.NSQuell.Models.ViewModels.Almacen.AlmacenUbicacionVm
@{ Layout = "~/Views/Shared/_AlmacenLayout.cshtml"; ViewData["Title"] = Model.UbicacionID.HasValue ? "Editar ubicación" : "Nueva ubicación"; }
<section class="alm-hero"><div><small>ERP_UBICACIONES</small><h1>@ViewData["Title"]</h1><p>Evita duplicar la combinación almacén, rack, nivel y posición.</p></div></section><section class="alm-card"><form method="post" class="alm-form"><input asp-for="UbicacionID" type="hidden"/><div asp-validation-summary="ModelOnly" class="alm-field full"></div><div class="alm-field"><label asp-for="Almacen"></label><select asp-for="Almacen" class="alm-select"><option>MP</option><option>EMBALAJES</option><option>PT</option><option>GENERAL</option><option>CUARENTENA</option><option>SCRAP</option></select></div><div class="alm-field"><label asp-for="Rack"></label><input asp-for="Rack" class="alm-input"/></div><div class="alm-field"><label asp-for="Nivel"></label><input asp-for="Nivel" class="alm-input"/></div><div class="alm-field"><label asp-for="Posicion"></label><input asp-for="Posicion" class="alm-input"/></div><div class="alm-field"><label><input asp-for="Activo"/> Activo</label></div><div class="alm-field full"><button class="alm-btn">Guardar ubicación</button></div></form></section>
