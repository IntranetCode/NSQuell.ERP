@model ERP.NSQuell.Models.ViewModels.GP12RecepcionCalidadVm

@* NSQ_GP12_RECEPCION_CALIDAD_V1_3 *@

<section class="gp12-quality-intake">
    <div class="gp12-quality-head">
        <div>
            <span class="gp12-quality-eyebrow">CAJAS DESDE CALIDAD</span>
            <h2>Recepción física GP12</h2>
            <p>
                Calidad ya decidió qué cajas amarillas deben venir a GP12.
                Aquí GP12 solamente confirma que la caja llegó físicamente y después inicia su revisión.
            </p>
        </div>

        <div class="gp12-quality-kpis">
            <div>
                <span>Pendientes</span>
                <strong>@Model.Pendientes</strong>
            </div>
            <div>
                <span>En GP12</span>
                <strong>@Model.EnGP12</strong>
            </div>
        </div>
    </div>

    <form asp-controller="GP12"
          asp-action="RecibirCajaCalidadEscaneada"
          method="post"
          id="gp12QualityScanForm"
          class="gp12-quality-scan">
        @Html.AntiForgeryToken()

        <label for="gp12QualityScanInput">
            Escanea la etiqueta física de la caja
        </label>

        <div class="gp12-quality-scan-row">
            <i class="fa-solid fa-barcode"></i>
            <input id="gp12QualityScanInput"
                   name="codigoBarras"
                   type="text"
                   autocomplete="off"
                   inputmode="none"
                   autofocus
                   placeholder="Escanea y la pistola enviará ENTER o TAB..." />

            <button type="submit">
                Recibir caja
            </button>
        </div>

        <small>
            ENTER o TAB envía automáticamente la lectura. No existe recepción por clic desde la tabla.
        </small>
    </form>

    @if (Model.Items.Count == 0)
    {
        <div class="gp12-quality-empty">
            No hay cajas amarillas pendientes o en proceso provenientes de Calidad.
        </div>
    }
    else
    {
        <div class="gp12-quality-table-wrap">
            <table class="gp12-quality-table">
                <thead>
                    <tr>
                        <th>Solicitud</th>
                        <th>Caja / etiqueta</th>
                        <th>OF</th>
                        <th>Parte</th>
                        <th>Piezas</th>
                        <th>Estado físico</th>
                        <th>Acción</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model.Items)
                    {
                        <tr>
                            <td>
                                <strong>#@item.SolicitudGP12ID</strong>
                            </td>

                            <td>
                                <strong>@item.CodigoBarras</strong>
                                <small>
                                    Caja Calidad #@item.CalidadCajaInventarioID
                                    @if (!string.IsNullOrWhiteSpace(item.Lote))
                                    {
                                        <text> · Lote @item.Lote</text>
                                    }
                                </small>
                            </td>

                            <td>
                                @(string.IsNullOrWhiteSpace(item.NumeroOF)
                                    ? "-"
                                    : item.NumeroOF)
                            </td>

                            <td>
                                <strong>@item.NumeroParte</strong>
                                <small>@item.Designacion</small>
                            </td>

                            <td>
                                <strong>@item.Cantidad.ToString("N0")</strong>
                            </td>

                            <td>
                                @if (item.Estado == "PENDIENTE_GP12")
                                {
                                    <span class="gp12-quality-state pending">
                                        Pendiente de recibir
                                    </span>
                                }
                                else
                                {
                                    <span class="gp12-quality-state received">
                                        Caja en GP12
                                    </span>
                                    @if (item.FechaRecepcionGP12.HasValue)
                                    {
                                        <small>
                                            @item.FechaRecepcionGP12.Value.ToString("dd/MM HH:mm")
                                        </small>
                                    }
                                }
                            </td>

                            <td>
                                @if (item.PuedeIniciarRevision)
                                {
                                    <form asp-controller="GP12"
                                          asp-action="IniciarRevisionCalidad"
                                          method="post">
                                        @Html.AntiForgeryToken()
                                        <input type="hidden"
                                               name="solicitudGP12ID"
                                               value="@item.SolicitudGP12ID" />

                                        <button type="submit"
                                                class="gp12-quality-action primary">
                                            Iniciar revisión
                                        </button>
                                    </form>
                                }
                                else if (item.Estado == "EN_GP12")
                                {
                                    <a asp-controller="GP12"
                                       asp-action="Detalle"
                                       asp-route-id="@item.SolicitudGP12ID"
                                       class="gp12-quality-action">
                                        Abrir revisión
                                    </a>
                                }
                                else
                                {
                                    <span class="gp12-quality-wait">
                                        Escanea la caja
                                    </span>
                                }
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</section>

<style>
    .gp12-quality-intake{margin:18px 0;padding:20px;border:1px solid #d8e3ef;border-radius:16px;background:#fff;box-shadow:0 10px 24px rgba(10,46,82,.07)}
    .gp12-quality-head{display:flex;justify-content:space-between;gap:18px;align-items:flex-start;margin-bottom:16px}
    .gp12-quality-eyebrow{display:inline-flex;padding:5px 9px;border-radius:999px;background:#fff4cc;color:#7a5900;font-size:10px;font-weight:900;letter-spacing:.05em}
    .gp12-quality-head h2{margin:7px 0 4px;color:#17233b;font-size:21px}
    .gp12-quality-head p{margin:0;max-width:820px;color:#667085;font-size:12px;line-height:1.5}
    .gp12-quality-kpis{display:flex;gap:8px}.gp12-quality-kpis div{min-width:95px;padding:10px 12px;border:1px solid #e1e7ef;border-radius:12px;background:#f8fafc;text-align:center}.gp12-quality-kpis span{display:block;color:#667085;font-size:10px;font-weight:800;text-transform:uppercase}.gp12-quality-kpis strong{display:block;margin-top:3px;color:#0b3558;font-size:22px}
    .gp12-quality-scan{margin-bottom:16px;padding:14px;border:1px solid #dbe4ee;border-radius:13px;background:#f8fafc}.gp12-quality-scan label{display:block;margin-bottom:7px;font-weight:850;color:#17233b}.gp12-quality-scan-row{display:grid;grid-template-columns:auto 1fr auto;gap:10px;align-items:center}.gp12-quality-scan-row i{font-size:20px;color:#0d5cab}.gp12-quality-scan-row input{width:100%;min-height:44px;padding:10px 12px;border:1px solid #cbd5e1;border-radius:10px;background:#fff}.gp12-quality-scan-row button{min-height:44px;padding:0 16px;border:0;border-radius:10px;background:#0d5cab;color:#fff;font-weight:850;cursor:pointer}.gp12-quality-scan small{display:block;margin-top:7px;color:#667085}
    .gp12-quality-table-wrap{overflow:auto;border:1px solid #e2e8f0;border-radius:12px}.gp12-quality-table{width:100%;border-collapse:collapse}.gp12-quality-table th,.gp12-quality-table td{padding:11px 12px;border-bottom:1px solid #edf1f5;text-align:left;vertical-align:middle}.gp12-quality-table th{background:#f8fafc;color:#475467;font-size:10px;text-transform:uppercase}.gp12-quality-table td{color:#17233b;font-size:12px}.gp12-quality-table td small{display:block;margin-top:3px;color:#7b889a}
    .gp12-quality-state{display:inline-flex;padding:6px 9px;border-radius:999px;font-size:10px;font-weight:900}.gp12-quality-state.pending{background:#fff4cc;color:#7a5900}.gp12-quality-state.received{background:#dcfce7;color:#166534}
    .gp12-quality-action{display:inline-flex;align-items:center;justify-content:center;min-height:34px;padding:0 11px;border:1px solid #cbd5e1;border-radius:9px;background:#fff;color:#0b3558;font-size:11px;font-weight:850;text-decoration:none;cursor:pointer}.gp12-quality-action.primary{border-color:#0d5cab;background:#0d5cab;color:#fff}.gp12-quality-wait{font-size:11px;font-weight:800;color:#7a5900}.gp12-quality-empty{padding:22px;border:1px dashed #cbd5e1;border-radius:12px;color:#667085;text-align:center}
    html[data-nsq-theme="dark"] .gp12-quality-intake{border-color:#2b3c53;background:#111c2c}.gp12-quality-intake form{margin:0}
    @@media(max-width:760px){.gp12-quality-head{flex-direction:column}.gp12-quality-kpis{width:100%}.gp12-quality-kpis div{flex:1}.gp12-quality-scan-row{grid-template-columns:auto 1fr}.gp12-quality-scan-row button{grid-column:1/-1}.gp12-quality-table{min-width:900px}}
</style>

<script>
(() => {
    const form = document.getElementById('gp12QualityScanForm');
    const input = document.getElementById('gp12QualityScanInput');

    if (!form || !input) return;

    input.addEventListener('keydown', event => {
        if (event.key === 'Enter' || event.key === 'Tab') {
            event.preventDefault();

            if (!input.value.trim()) {
                input.focus();
                return;
            }

            form.requestSubmit();
        }
    });

    window.setTimeout(() => input.focus(), 80);
})();
</script>