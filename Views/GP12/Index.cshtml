<div class="gp12-index-page">

    @if (TempData["Mensaje"] != null)
    {
        <div class="alert alert-success">
            @TempData["Mensaje"]
        </div>
    }

    @if (TempData["Error"] != null)
    {
        <div class="alert alert-error">
            @TempData["Error"]
        </div>
    }

    <!-- ======================================================
         HERO
         ====================================================== -->

    <section class="gp12-hero">

        <div class="industrial-grid"></div>

        <div class="hero-orb"></div>

        <div class="hero-ring"></div>

        <div class="scanner"></div>

        <div class="hero-content">

            <div>

                <div class="hero-badge">
                    <span class="hero-badge-dot"></span>
                    Departamento GP12
                </div>

                <h1 class="hero-title">
                    Centro de
                    <span>Contención</span>
                    y Retrabajo
                </h1>

                <p class="hero-description">
                    Control integral del material recibido por GP12:
                    programación de carga, asignación de personal,
                    inspección, retrabajo, consolidación y trazabilidad
                    hasta su salida.
                </p>

                <div class="hero-actions">

                    <a asp-controller="GP12"
                       asp-action="Crear"
                       class="btn btn-new">
                        + Nueva solicitud
                    </a>

                    <a asp-controller="GP12"
                       asp-action="Almacen"
                       class="btn btn-refresh">
                        ▣ Almacén GP12
                    </a>

                    <a asp-controller="GP12"
                       asp-action="Index"
                       class="btn btn-refresh">
                        ↻ Actualizar operación
                    </a>

                </div>

            </div>

            <div class="hero-monitor">

                <div class="monitor-header">

                    <span class="monitor-label">
                        Pulso operativo
                    </span>

                    <span class="monitor-live">
                        <span class="monitor-live-dot"></span>
                        Sistema activo
                    </span>

                </div>

                <div class="monitor-stats">

                    <div class="monitor-stat">
                        <small>
                            Pendientes
                        </small>

                        <strong>
                            @(Model.TotalRecibidos
                                                        + Model.TotalPendientesProgramar
                                                        + Model.TotalProgramados
                                                        + Model.TotalAsignados)
                        </strong>
                    </div>

                    <div class="monitor-stat">
                        <small>
                            En ejecución
                        </small>

                        <strong>
                            @(Model.TotalEnInspeccion
                                                        + Model.TotalInspeccionPausada
                                                        + Model.TotalInspeccionTerminada
                                                        + Model.TotalEnTarima
                                                        + Model.TotalSalidaRegistrada)
                        </strong>
                    </div>

                    <div class="monitor-stat">
                        <small>
                            Cerrados
                        </small>

                        <strong>
                            @Model.TotalCerrados
                        </strong>
                    </div>

                </div>

            </div>

        </div>

    </section>

    <!-- ======================================================
         FLUJO VISUAL
         ====================================================== -->

    <section class="flow-shell">

        <div class="flow-header">

            <div>
                <div class="section-eyebrow">
                    Flujo GP12
                </div>

                <h2 class="section-title">
                    Recorrido operativo
                </h2>
            </div>

            <div class="flow-note">
                @totalEnProceso solicitud(es) actualmente en proceso
            </div>

        </div>

        <div class="flow-track">

            <div class="flow-step">
                <div class="flow-node">
                    @Model.TotalRecibidos
                </div>

                <strong>
                    Recepción
                </strong>

                <span>
                    Entrada de material
                </span>
            </div>

            <div class="flow-step">
                <div class="flow-node">
                    @(Model.TotalPendientesProgramar
                                        + Model.TotalProgramados)
                </div>

                <strong>
                    Programación
                </strong>

                <span>
                    Carga y prioridad
                </span>
            </div>

            <div class="flow-step">
                <div class="flow-node">
                    @Model.TotalAsignados
                </div>

                <strong>
                    Asignación
                </strong>

                <span>
                    Personal GP12
                </span>
            </div>

            <div class="flow-step">
                <div class="flow-node">
                    @(Model.TotalEnInspeccion
                                        + Model.TotalInspeccionPausada
                                        + Model.TotalInspeccionTerminada)
                </div>

                <strong>
                    Inspección
                </strong>

                <span>
                    Revisión / retrabajo
                </span>
            </div>

            <div class="flow-step">
                <div class="flow-node">
                    @Model.TotalEnTarima
                </div>

                <strong>
                    Consolidación
                </strong>

                <span>
                    Cajas y tarimas
                </span>
            </div>

            <div class="flow-step">
                <div class="flow-node">
                    @Model.TotalSalidaRegistrada
                </div>

                <strong>
                    Salida
                </strong>

                <span>
                    Cierre operativo
                </span>
            </div>

        </div>

    </section>

    <!-- ======================================================
         WORKSPACE
         ====================================================== -->

    <section class="workspace">

        <!-- BANDEJA -->

        <main class="panel">

            <div class="panel-header">

                <div>

                    <h2 class="panel-title">
                        Bandeja de trabajo GP12
                    </h2>

                    <p class="panel-description">
                        Consulta, priorización y seguimiento de material en contención.
                    </p>

                </div>

                <span class="results-count">
                    @Model.TotalMostrados resultado(s)
                </span>

            </div>

            <div class="panel-body">

                <form asp-controller="GP12"
                      asp-action="Index"
                      method="get"
                      class="filters">

                    <input type="text"
                           class="control"
                           name="busqueda"
                           value="@Model.Busqueda"
                           placeholder="OF, parte, cliente, material o motivo..." />

                    <select asp-for="EstatusID"
                            name="estatusID"
                            class="control">

                        <option value="">
                            Todos los estados
                        </option>

                        <option value="1">
                            Recibido
                        </option>

                        <option value="2">
                            Pendiente de programar
                        </option>

                        <option value="3">
                            Programado
                        </option>

                        <option value="4">
                            Asignado
                        </option>

                        <option value="5">
                            En inspección
                        </option>

                        <option value="6">
                            Inspección pausada
                        </option>

                        <option value="7">
                            Inspección terminada
                        </option>

                        <option value="8">
                            En tarima
                        </option>

                        <option value="9">
                            Salida registrada
                        </option>

                        <option value="10">
                            Cerrado
                        </option>

                        <option value="90">
                            Cancelado
                        </option>

                    </select>

                    <select asp-for="Origen"
                            name="origen"
                            class="control">

                        <option value="">
                            Todos los orígenes
                        </option>

                        <option value="PLANEACION">
                            Planeación
                        </option>

                        <option value="PRODUCCION">
                            Producción
                        </option>

                        <option value="CALIDAD">
                            Calidad
                        </option>

                        <option value="MANUAL">
                            Manual
                        </option>

                    </select>

                    <button type="submit"
                            class="btn-search">
                        Buscar
                    </button>

                </form>

                @if (
                                Model.Solicitudes == null ||
                                Model.Solicitudes.Count == 0
                                )
                {
                    <div class="empty">

                        <div class="empty-icon">
                            ◈
                        </div>

                        <strong>
                            Bandeja sin solicitudes
                        </strong>

                        No existen registros GP12
                        que coincidan con los filtros actuales.

                    </div>
                }
                else
                {
                    <div class="table-wrap">

                        <table>

                            <thead>
                                <tr>
                                    <th>ID</th>
                                    <th>Origen</th>
                                    <th>OF</th>
                                    <th>Parte</th>
                                    <th>Cliente</th>
                                    <th>Solicitado</th>
                                    <th>Recibido</th>
                                    <th>Procesado</th>
                                    <th>Estado</th>
                                    <th>Fecha</th>
                                    <th></th>
                                </tr>
                            </thead>

                            <tbody>

                                @foreach (
                                                            var item
                                                            in Model.Solicitudes
                                                            )
                                {
                                    <tr>

                                        <td>
                                            <span class="request-id">
                                                #@item.SolicitudGP12ID
                                            </span>
                                        </td>

                                        <td>

                                            <span class="
                                                    pill
                                                    @OrigenClase(item.Origen)">

                                                @GP12Origen.Nombre(
                                                item.Origen)

                                    </span>

                                </td>

                                <td>

                                    @(string.IsNullOrWhiteSpace(
                                                                        item.OrdenFabricacion)

                                                                        ? "-"

                                                                        : item.OrdenFabricacion)

                                </td>

                                <td>

                                    <div class="part">

                                        @(string.IsNullOrWhiteSpace(
                                                                                item.NumeroParte)

                                                                                ? "-"

                                                                                : item.NumeroParte)

                                    </div>

                                    @if (
                                                                        !string.IsNullOrWhiteSpace(
                                                                        item.DescripcionParte)
                                                                        )
                                            {
                                                <div class="description">
                                                    @item.DescripcionParte
                                                </div>
                                            }

                                    </td>

                                    <td>

                                        @(string.IsNullOrWhiteSpace(
                                                                            item.ClienteNombre)

                                                                            ? "-"

                                                                            : item.ClienteNombre)

                                </td>

                                        <td class="number">
                                            @(item.CantidadSolicitada.ToString("N4"))
                                        </td>

                                        <td class="number">
                                            @(item.CantidadRecibida.ToString("N4"))
                                        </td>

                                        <td class="number">
                                            @(item.CantidadProcesada.ToString("N4"))
                                        </td>

                                        <td>

                                            <span class="
                                                    pill
                                                    @EstatusClase(
                                                                                          item.EstatusID)">

                                        @item.EstatusNombre

                                    </span>

                                </td>

                                <td>
                                    <div class="table-date">
                                        <strong>
                                            @(item.FechaSolicitud.ToString("dd/MM/yyyy"))
                                        </strong>
                                        <span>
                                            @(item.FechaSolicitud.ToString("HH:mm"))
                                        </span>
                                    </div>
                                </td>

                                <td>

                                    <a asp-controller="GP12"
                                       asp-action="Detalle"
                                       asp-route-id="@item.SolicitudGP12ID"
                                       class="btn-open">

                                        Abrir →

                                    </a>

                                </td>

                            </tr>
                                                        }

                            </tbody>

                        </table>

                    </div>
                }

            </div>

        </main>

        <!-- LATERAL -->

        <aside class="panel side-panel">

            <div class="side-section">

                <div class="side-eyebrow">
                    Control operativo
                </div>

                <h3 class="side-title">
                    Puntos de atención
                </h3>

                <div class="focus-item"
                     style="--focus-color:#2563eb;">

                    <strong>
                        Recepción física
                    </strong>

                    <span>
                        Las cajas enviadas por Calidad se reciben físicamente desde el detalle de la solicitud mediante escaneo de la misma etiqueta de Producción.
                    </span>

                </div>

                <div class="focus-item"
                     style="--focus-color:#8b5cf6;">

                    <strong>
                        Carga de trabajo
                    </strong>

                    <span>
                        Programar y asignar solamente
                        cantidades disponibles.
                    </span>

                </div>

                <div class="focus-item"
                     style="--focus-color:#f59e0b;">

                    <strong>
                        Contención
                    </strong>

                    <span>
                        Próxima etapa:
                        inspección, D1-D15
                        y retrabajo.
                    </span>

                </div>

            </div>

            <div class="side-section">

                <div class="formula-box">

                    <small>
                        Fase actual
                    </small>

                    <strong>
                        Recepción → Programación →
                        Asignación
                    </strong>

                </div>

            </div>

        </aside>

    </section>

</div>
