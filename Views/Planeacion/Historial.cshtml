@model ERP.NSQuell.Models.PlaneacionOFHistorialIndexVm
@using System.Linq

@{
    Layout = "~/Views/Shared/_Layout.cshtml";
    ViewData["Title"] = "Historial de OF | ERP QUELL";

    var items = Model?.Items ?? new List<ERP.NSQuell.Models.PlaneacionOFHistorialItemVm>();

    var total = items.Count;
    var cerradas = items.Count(x => x.EstatusID == ERP.NSQuell.Models.PlaneacionOFEstatus.Cerrada);
    var canceladas = items.Count(x => x.EstatusID == ERP.NSQuell.Models.PlaneacionOFEstatus.Cancelada);
    var conEjecucion = items.Count(x => x.TotalEjecuciones > 0);
    var ok = items.Sum(x => x.CantidadOK);
    var scrap = items.Sum(x => x.CantidadScrap);
}

@section Styles {
<style>
    .hof-shell{max-width:1650px;margin:0 auto;padding:1.2rem}
    .hof-hero{border:1px solid #dbe5f1;border-radius:24px;background:linear-gradient(135deg,#fff 0%,#f6f9fe 72%,#eef5ff 100%);padding:1.35rem 1.5rem;margin-bottom:1rem}
    .hof-hero-top{display:flex;justify-content:space-between;gap:1rem;align-items:flex-start;flex-wrap:wrap}
    .hof-title{font-size:clamp(1.7rem,3vw,2.6rem);font-weight:900;letter-spacing:-.04em;color:#0f1d33;margin:0}
    .hof-sub{color:#52647f;margin:.35rem 0 0;font-weight:600}
    .hof-stats{display:grid;grid-template-columns:repeat(5,minmax(115px,1fr));gap:.65rem;margin-top:1rem}
    .hof-stat{border:1px solid #dbe5f1;border-radius:16px;background:#fff;padding:.8rem 1rem}
    .hof-stat strong{display:block;font-size:1.35rem;color:#0c4a8a}
    .hof-stat span{font-size:.77rem;font-weight:800;color:#63738a;text-transform:uppercase;letter-spacing:.04em}
    .hof-toolbar{display:grid;grid-template-columns:minmax(250px,1fr) 170px 170px 190px 190px auto;gap:.65rem;align-items:end;background:#fff;border:1px solid #dbe5f1;border-radius:18px;padding:.85rem;margin-bottom:1rem}
    .hof-field label{display:block;font-size:.72rem;font-weight:900;color:#40516b;margin:0 0 .3rem;text-transform:uppercase}
    .hof-field input,.hof-field select{width:100%;min-height:42px;border:1px solid #cfd9e7;border-radius:11px;padding:.55rem .7rem;background:#fff}
    .hof-actions{display:flex;gap:.5rem;justify-content:flex-end}
    .hof-btn{min-height:42px;border-radius:11px;padding:.55rem .8rem;border:1px solid #cfd9e7;background:#fff;font-weight:800;text-decoration:none;color:#17304f;display:inline-flex;align-items:center;gap:.45rem}
    .hof-btn-primary{background:#0759a8;color:#fff;border-color:#0759a8}
    .hof-table-wrap{background:#fff;border:1px solid #dbe5f1;border-radius:20px;overflow:auto;box-shadow:0 12px 30px rgba(15,31,52,.05)}
    .hof-table{width:100%;border-collapse:separate;border-spacing:0;min-width:1350px}
    .hof-table thead th{position:sticky;top:0;z-index:2;background:#eef5ff;color:#123b6d;font-size:.72rem;text-transform:uppercase;letter-spacing:.035em;padding:.75rem;border-bottom:1px solid #d7e2f0;white-space:nowrap}
    .hof-table td{padding:.78rem .75rem;border-bottom:1px solid #edf1f6;vertical-align:top;color:#26374e}
    .hof-table tbody tr:hover{background:#fafcff}
    .hof-of{font-weight:900;color:#074f98}
    .hof-muted{font-size:.78rem;color:#718096}
    .hof-pill{display:inline-flex;align-items:center;border-radius:999px;padding:.28rem .55rem;font-size:.72rem;font-weight:900;background:#eaf2ff;color:#1956a0}
    .hof-pill.ok{background:#e8f8ef;color:#19733f}.hof-pill.bad{background:#feecec;color:#ae2626}.hof-pill.warn{background:#fff5d8;color:#856100}
    .hof-parts{max-width:360px;font-size:.82rem;line-height:1.35}
    .hof-personal{max-width:280px;font-size:.8rem;line-height:1.35}
    .hof-qty{font-variant-numeric:tabular-nums;font-weight:800;white-space:nowrap}
    .hof-no-results{padding:2rem;text-align:center;color:#66758d;font-weight:700}
    @@media(max-width:1100px){.hof-stats{grid-template-columns:repeat(2,1fr)}.hof-toolbar{grid-template-columns:1fr 1fr}.hof-actions{justify-content:flex-start}}
</style>
}

@await Html.PartialAsync("_PlaneacionNavbar")

<main class="hof-shell">
    <section class="hof-hero">
        <div class="hof-hero-top">
            <div>
                <h1 class="hof-title"><i class="fa-solid fa-clock-rotate-left me-2"></i>Historial de Órdenes de Fabricación</h1>
                <p class="hof-sub">
                    Producciones anteriores con ejecución real, además de OF cerradas o canceladas.
                    Consulta lo planeado contra el resultado registrado por Producción.
                </p>
            </div>

            <a asp-controller="Planeacion" asp-action="Index" class="hof-btn">
                <i class="fa-solid fa-arrow-left"></i>Volver a OF activas
            </a>
        </div>

        <div class="hof-stats">
            <div class="hof-stat"><strong>@total.ToString("N0")</strong><span>OF históricas</span></div>
            <div class="hof-stat"><strong>@conEjecucion.ToString("N0")</strong><span>Con producción</span></div>
            <div class="hof-stat"><strong>@cerradas.ToString("N0")</strong><span>Cerradas</span></div>
            <div class="hof-stat"><strong>@ok.ToString("N0")</strong><span>Piezas OK</span></div>
            <div class="hof-stat"><strong>@scrap.ToString("N0")</strong><span>Scrap</span></div>
        </div>
    </section>

    <form method="get" asp-controller="Planeacion" asp-action="Historial" class="hof-toolbar">
        <div class="hof-field">
            <label>Buscar</label>
            <input name="busqueda" value="@Model.Busqueda"
                   placeholder="OF, cliente, parte, máquina o personal..." />
        </div>

        <div class="hof-field">
            <label>Desde</label>
            <input type="date" name="fechaDesde"
                   value="@(Model.FechaDesde?.ToString("yyyy-MM-dd"))" />
        </div>

        <div class="hof-field">
            <label>Hasta</label>
            <input type="date" name="fechaHasta"
                   value="@(Model.FechaHasta?.ToString("yyyy-MM-dd"))" />
        </div>

        <div class="hof-field">
            <label>Tipo OF</label>
            <select id="hofTipo">
                <option value="">Todos</option>
                <option value="RELEASE">Release</option>
                <option value="ENSAMBLE">Ensamble</option>
                <option value="PRUEBA">Prueba</option>
                <option value="MP EXTRA">MP extra</option>
            </select>
        </div>

        <div class="hof-field">
            <label>Estatus</label>
            <select id="hofEstatus">
                <option value="">Todos</option>
                <option value="10">Cerrada</option>
                <option value="99">Cancelada</option>
                <option value="produccion">Con ejecución de Producción</option>
            </select>
        </div>

        <div class="hof-actions">
            <a asp-controller="Planeacion" asp-action="Historial" class="hof-btn">
                <i class="fa-solid fa-eraser"></i>Limpiar
            </a>
            <button class="hof-btn hof-btn-primary" type="submit">
                <i class="fa-solid fa-filter"></i>Consultar
            </button>
        </div>
    </form>

    <div class="hof-table-wrap">
        <table class="hof-table">
            <thead>
                <tr>
                    <th>OF</th>
                    <th>Fecha producción</th>
                    <th>Cliente</th>
                    <th>Parte(s)</th>
                    <th>Máquina(s)</th>
                    <th>Personal</th>
                    <th>Planeado</th>
                    <th>OK</th>
                    <th>Sospechoso</th>
                    <th>Scrap</th>
                    <th>Rendimiento</th>
                    <th>Estatus</th>
                    <th></th>
                </tr>
            </thead>
            <tbody id="hofBody">
                @foreach (var item in items)
                {
                    var statusClass =
                        item.EstatusID == ERP.NSQuell.Models.PlaneacionOFEstatus.Cerrada
                            ? "ok"
                            : item.EstatusID == ERP.NSQuell.Models.PlaneacionOFEstatus.Cancelada
                                ? "bad"
                                : "warn";

                    <tr data-hof-row
                        data-type="@item.TipoOF.Trim().ToUpperInvariant()"
                        data-status="@item.EstatusID"
                        data-executions="@item.TotalEjecuciones">
                        <td>
                            <div class="hof-of">@item.FolioSolicitud</div>
                            <div class="hof-muted">@(string.IsNullOrWhiteSpace(item.NumeroOFRecibida) ? $"ID {item.SolicitudProduccionID}" : item.NumeroOFRecibida)</div>
                            <div class="hof-muted">@item.TipoOF</div>
                        </td>

                        <td>
                            <strong>@item.FechaReferencia.ToString("dd/MM/yyyy")</strong>
                            <div class="hof-muted">Inicio real: @(item.FechaInicioReal?.ToString("dd/MM HH:mm") ?? "Sin inicio real")</div>
                            <div class="hof-muted">Fin real: @(item.FechaFinReal?.ToString("dd/MM HH:mm") ?? "Sin cierre real")</div>
                        </td>

                        <td><strong>@item.Cliente</strong></td>
                        <td><div class="hof-parts">@item.Partes</div></td>
                        <td><div class="hof-parts">@item.Maquinas</div></td>
                        <td><div class="hof-personal">@item.Personal</div></td>

                        <td class="hof-qty">@item.CantidadPlaneada.ToString("N0")</td>
                        <td class="hof-qty">@item.CantidadOK.ToString("N0")</td>
                        <td class="hof-qty">@item.CantidadSospechosa.ToString("N0")</td>
                        <td class="hof-qty">@item.CantidadScrap.ToString("N0")</td>

                        <td>
                            <span class="hof-pill @(item.RendimientoOK >= 95m ? "ok" : item.RendimientoOK > 0 ? "warn" : "")">
                                @item.RendimientoOK.ToString("N2")%
                            </span>
                        </td>

                        <td>
                            <span class="hof-pill @statusClass">@item.EstatusNombre</span>
                            <div class="hof-muted mt-1">@item.TotalEjecuciones ejecución(es)</div>
                        </td>

                        <td>
                            <a asp-controller="Planeacion"
                               asp-action="Detalle"
                               asp-route-id="@item.SolicitudProduccionID"
                               class="hof-btn">
                                <i class="fa-solid fa-eye"></i>Detalle
                            </a>
                        </td>
                    </tr>
                }

                <tr id="hofNoResults" style="display:@(items.Count == 0 ? "table-row" : "none")">
                    <td colspan="13" class="hof-no-results">
                        No se encontraron órdenes históricas con los filtros seleccionados.
                    </td>
                </tr>
            </tbody>
        </table>
    </div>
</main>

@section Scripts {
<script>
(() => {
    const tipo = document.getElementById('hofTipo');
    const estatus = document.getElementById('hofEstatus');
    const rows = [...document.querySelectorAll('[data-hof-row]')];
    const noResults = document.getElementById('hofNoResults');

    const apply = () => {
        const typeValue = tipo?.value || '';
        const statusValue = estatus?.value || '';
        let visible = 0;

        rows.forEach(row => {
            const typeOk = !typeValue || row.dataset.type === typeValue;

            let statusOk = true;

            if (statusValue === 'produccion') {
                statusOk = Number(row.dataset.executions || 0) > 0;
            } else if (statusValue) {
                statusOk = row.dataset.status === statusValue;
            }

            const show = typeOk && statusOk;
            row.style.display = show ? '' : 'none';

            if (show) visible++;
        });

        if (noResults) {
            noResults.style.display = visible === 0 ? 'table-row' : 'none';
        }
    };

    tipo?.addEventListener('change', apply);
    estatus?.addEventListener('change', apply);
})();
</script>
}
