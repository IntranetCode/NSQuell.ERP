@model ERP.NSQuell.Models.PlaneacionOFHistorialIndexVm
@using System.Linq

@{
    Layout = "~/Views/Shared/_Layout.cshtml";
    ViewData["Title"] = "Historial de OF | ERP QUELL";

    var items = Model?.Items ?? new List<ERP.NSQuell.Models.PlaneacionOFHistorialItemVm>();

    var total = items.Count;
    var cerradas = items.Count(x => x.EstatusID == ERP.NSQuell.Models.PlaneacionOFEstatus.Cerrada);
    var canceladas = items.Count(x => x.EstatusID == ERP.NSQuell.Models.PlaneacionOFEstatus.Cancelada);
    var conEjecucion = items.Count(x => x.TotalEjecuciones > 0);
    var ok = items.Sum(x => x.CantidadOK);
    var scrap = items.Sum(x => x.CantidadScrap);
}

@section Styles {
<style>
    .hof-shell{max-width:1650px;margin:0 auto;padding:1.2rem}
    .hof-hero{border:1px solid #dbe5f1;border-radius:24px;background:linear-gradient(135deg,#fff 0%,#f6f9fe 72%,#eef5ff 100%);padding:1.35rem 1.5rem;margin-bottom:1rem}
    .hof-hero-top{display:flex;justify-content:space-between;gap:1rem;align-items:flex-start;flex-wrap:wrap}
    .hof-title{font-size:clamp(1.7rem,3vw,2.6rem);font-weight:900;letter-spacing:-.04em;color:#0f1d33;margin:0}
    .hof-sub{color:#52647f;margin:.35rem 0 0;font-weight:600}
    .hof-stats{display:grid;grid-template-columns:repeat(5,minmax(115px,1fr));gap:.65rem;margin-top:1rem}
    .hof-stat{border:1px solid #dbe5f1;border-radius:16px;background:#fff;padding:.8rem 1rem}
    .hof-stat strong{display:block;font-size:1.35rem;color:#0c4a8a}
    .hof-stat span{font-size:.77rem;font-weight:800;color:#63738a;text-transform:uppercase;letter-spacing:.04em}
    .hof-toolbar{display:grid;grid-template-columns:minmax(250px,1fr) 170px 170px 190px 190px auto;gap:.65rem;align-items:end;background:#fff;border:1px solid #dbe5f1;border-radius:18px;padding:.85rem;margin-bottom:1rem}
    .hof-field label{display:block;font-size:.72rem;font-weight:900;color:#40516b;margin:0 0 .3rem;text-transform:uppercase}
    .hof-field input,.hof-field select{width:100%;min-height:42px;border:1px solid #cfd9e7;border-radius:11px;padding:.55rem .7rem;background:#fff}
    .hof-actions{display:flex;gap:.5rem;justify-content:flex-end}
    .hof-btn{min-height:42px;border-radius:11px;padding:.55rem .8rem;border:1px solid #cfd9e7;background:#fff;font-weight:800;text-decoration:none;color:#17304f;display:inline-flex;align-items:center;gap:.45rem}
    .hof-btn-primary{background:#0759a8;color:#fff;border-color:#0759a8}
    .hof-table-wrap{background:#fff;border:1px solid #dbe5f1;border-radius:20px;overflow:auto;box-shadow:0 12px 30px rgba(15,31,52,.05)}
    .hof-table{width:100%;border-collapse:separate;border-spacing:0;min-width:1350px}
    .hof-table thead th{position:sticky;top:0;z-index:2;background:#eef5ff;color:#123b6d;font-size:.72rem;text-transform:uppercase;letter-spacing:.035em;padding:.75rem;border-bottom:1px solid #d7e2f0;white-space:nowrap}
    .hof-table td{padding:.78rem .75rem;border-bottom:1px solid #edf1f6;vertical-align:top;color:#26374e}
    .hof-table tbody tr:hover{background:#fafcff}
    .hof-of{font-weight:900;color:#074f98}
    .hof-muted{font-size:.78rem;color:#718096}
    .hof-pill{display:inline-flex;align-items:center;border-radius:999px;padding:.28rem .55rem;font-size:.72rem;font-weight:900;background:#eaf2ff;color:#1956a0}
    .hof-pill.ok{background:#e8f8ef;color:#19733f}.hof-pill.bad{background:#feecec;color:#ae2626}.hof-pill.warn{background:#fff5d8;color:#856100}
    .hof-parts{max-width:360px;font-size:.82rem;line-height:1.35}
    .hof-personal{max-width:280px;font-size:.8rem;line-height:1.35}
    .hof-qty{font-variant-numeric:tabular-nums;font-weight:800;white-space:nowrap}
    .hof-no-results{padding:2rem;text-align:center;color:#66758d;font-weight:700}
    /* NSQ_PRECOMMIT_HISTORIAL_CARDS_V2 */
    .hof-table-wrap{
        background:transparent;
        border:0;
        border-radius:0;
        box-shadow:none;
        overflow:visible;
    }
    .hof-table{display:block;width:100%;min-width:0;border:0}
    .hof-table thead{display:none}
    .hof-table tbody{display:grid;gap:.9rem}
    .hof-table tr[data-hof-row]{
        display:grid;
        grid-template-columns:170px 180px minmax(220px,1fr) minmax(150px,.8fr) minmax(150px,.8fr);
        gap:.7rem;
        padding:1rem 1.05rem;
        border:1px solid #dbe5f1;
        border-radius:18px;
        background:#fff;
        box-shadow:0 8px 24px rgba(15,31,52,.055);
        align-items:start;
    }
    .hof-table tr[data-hof-row]:hover{
        border-color:#bfd3ea;
        box-shadow:0 12px 28px rgba(15,31,52,.09);
        background:#fff;
    }
    .hof-table tr[data-hof-row] td{
        display:block;
        min-width:0;
        padding:.1rem;
        border:0;
        background:transparent;
    }
    .hof-table tr[data-hof-row] td:nth-child(1){grid-column:1}
    .hof-table tr[data-hof-row] td:nth-child(2){grid-column:2}
    .hof-table tr[data-hof-row] td:nth-child(3){grid-column:3 / 5}
    .hof-table tr[data-hof-row] td:nth-child(12){grid-column:5}
    .hof-table tr[data-hof-row] td:nth-child(4){grid-column:1 / 3}
    .hof-table tr[data-hof-row] td:nth-child(5){grid-column:3}
    .hof-table tr[data-hof-row] td:nth-child(6){grid-column:4 / 6}

    .hof-table tr[data-hof-row] td:nth-child(n+7):nth-child(-n+11){
        padding:.7rem .75rem;
        border:1px solid #e5edf6;
        border-radius:12px;
        background:#f8fbff;
        font-size:.88rem;
    }
    .hof-table tr[data-hof-row] td:nth-child(7){grid-column:1}
    .hof-table tr[data-hof-row] td:nth-child(8){grid-column:2}
    .hof-table tr[data-hof-row] td:nth-child(9){grid-column:3}
    .hof-table tr[data-hof-row] td:nth-child(10){grid-column:4}
    .hof-table tr[data-hof-row] td:nth-child(11){grid-column:5}

    .hof-table tr[data-hof-row] td:nth-child(7)::before,
    .hof-table tr[data-hof-row] td:nth-child(8)::before,
    .hof-table tr[data-hof-row] td:nth-child(9)::before,
    .hof-table tr[data-hof-row] td:nth-child(10)::before,
    .hof-table tr[data-hof-row] td:nth-child(11)::before{
        display:block;
        margin-bottom:.18rem;
        color:#6b7c94;
        font-size:.62rem;
        font-weight:900;
        text-transform:uppercase;
        letter-spacing:.045em;
    }
    .hof-table tr[data-hof-row] td:nth-child(7)::before{content:"Planeado"}
    .hof-table tr[data-hof-row] td:nth-child(8)::before{content:"OK"}
    .hof-table tr[data-hof-row] td:nth-child(9)::before{content:"Sospechoso"}
    .hof-table tr[data-hof-row] td:nth-child(10)::before{content:"Scrap"}
    .hof-table tr[data-hof-row] td:nth-child(11)::before{content:"Rendimiento"}

    .hof-table tr[data-hof-row] td:nth-child(13){
        grid-column:1 / -1;
        padding-top:.7rem;
        margin-top:.15rem;
        border-top:1px solid #e6edf5;
    }
    .hof-table tr[data-hof-row] td:nth-child(13)>div{
        flex-direction:row!important;
        flex-wrap:wrap;
        align-items:center;
    }
    .hof-table tr[data-hof-row] td:nth-child(13) form{margin:0}
    .hof-table tr[data-hof-row] td:nth-child(13) .hof-btn{min-height:36px}

    #hofNoResults{display:block!important}
    #hofNoResults[style*="none"]{display:none!important}

    @@media(max-width:1050px){
        .hof-table tr[data-hof-row]{
            grid-template-columns:repeat(2,minmax(0,1fr));
        }
        .hof-table tr[data-hof-row] td{grid-column:auto!important}
        .hof-table tr[data-hof-row] td:nth-child(3),
        .hof-table tr[data-hof-row] td:nth-child(4),
        .hof-table tr[data-hof-row] td:nth-child(6),
        .hof-table tr[data-hof-row] td:nth-child(13){grid-column:1 / -1!important}
    }
    @@media(max-width:650px){
        .hof-shell{padding:.65rem}
        .hof-table tr[data-hof-row]{grid-template-columns:1fr}
        .hof-table tr[data-hof-row] td{grid-column:1!important}
        .hof-toolbar{grid-template-columns:1fr}
        .hof-stats{grid-template-columns:1fr 1fr}
    }
    @@media(max-width:1100px){.hof-stats{grid-template-columns:repeat(2,1fr)}.hof-toolbar{grid-template-columns:1fr 1fr}.hof-actions{justify-content:flex-start}}
</style>
}

@await Html.PartialAsync("_PlaneacionNavbar")

<main class="hof-shell">
    <section class="hof-hero">
        <div class="hof-hero-top">
            <div>
                <h1 class="hof-title"><i class="fa-solid fa-clock-rotate-left me-2"></i>Historial de Órdenes de Fabricación</h1>
                <p class="hof-sub">
                    Todas las Órdenes de Fabricación registradas en Planeación, tengan o no ejecución de Producción.
                    Consulta lo planeado y, cuando exista, el resultado registrado por Producción.
                </p>
            </div>

            <a asp-controller="Planeacion" asp-action="Index" class="hof-btn">
                <i class="fa-solid fa-arrow-left"></i>Volver a OF activas
            </a>
        </div>

        <div class="hof-stats">
            <div class="hof-stat"><strong>@total.ToString("N0")</strong><span>OF históricas</span></div>
            <div class="hof-stat"><strong>@conEjecucion.ToString("N0")</strong><span>Con producción</span></div>
            <div class="hof-stat"><strong>@cerradas.ToString("N0")</strong><span>Cerradas</span></div>
            <div class="hof-stat"><strong>@ok.ToString("N0")</strong><span>Piezas OK</span></div>
            <div class="hof-stat"><strong>@scrap.ToString("N0")</strong><span>Scrap</span></div>
        </div>
    </section>

    <form method="get" asp-controller="Planeacion" asp-action="Historial" class="hof-toolbar">
        <div class="hof-field">
            <label>Buscar</label>
            <input name="busqueda" value="@Model.Busqueda"
                   placeholder="OF, cliente, parte, máquina o personal..." />
        </div>

        <div class="hof-field">
            <label>Desde</label>
            <input type="date" name="fechaDesde"
                   value="@(Model.FechaDesde?.ToString("yyyy-MM-dd"))" />
        </div>

        <div class="hof-field">
            <label>Hasta</label>
            <input type="date" name="fechaHasta"
                   value="@(Model.FechaHasta?.ToString("yyyy-MM-dd"))" />
        </div>

        <div class="hof-field">
            <label>Tipo OF</label>
            <select id="hofTipo">
                <option value="">Todos</option>
                <option value="RELEASE">Release</option>
                <option value="ENSAMBLE">Ensamble</option>
                <option value="PRUEBA">Prueba</option>
                <option value="MP EXTRA">MP extra</option>
            </select>
        </div>

        <div class="hof-field">
            <label>Estatus</label>
            <select id="hofEstatus">
                <option value="">Todos</option>
                <option value="10">Cerrada</option>
                <option value="99">Cancelada</option>
                <option value="produccion">Con ejecución de Producción</option>
            </select>
        </div>

        <div class="hof-actions">
            <a asp-controller="Planeacion" asp-action="Historial" class="hof-btn">
                <i class="fa-solid fa-eraser"></i>Limpiar
            </a>
            <button class="hof-btn hof-btn-primary" type="submit">
                <i class="fa-solid fa-filter"></i>Consultar
            </button>
        </div>
    </form>

    <div class="hof-table-wrap">
        <table class="hof-table">
            <thead>
                <tr>
                    <th>OF</th>
                    <th>Fecha producción</th>
                    <th>Cliente</th>
                    <th>Parte(s)</th>
                    <th>Máquina(s)</th>
                    <th>Personal</th>
                    <th>Planeado</th>
                    <th>OK</th>
                    <th>Sospechoso</th>
                    <th>Scrap</th>
                    <th>Rendimiento</th>
                    <th>Estatus</th>
                    <th></th>
                </tr>
            </thead>
            <tbody id="hofBody">
                @foreach (var item in items)
                {
                    var statusClass =
                        item.EstatusID == ERP.NSQuell.Models.PlaneacionOFEstatus.Cerrada
                            ? "ok"
                            : item.EstatusID == ERP.NSQuell.Models.PlaneacionOFEstatus.Cancelada
                                ? "bad"
                                : "warn";

                    <tr data-hof-row
                        data-type="@item.TipoOF.Trim().ToUpperInvariant()"
                        data-status="@item.EstatusID"
                        data-executions="@item.TotalEjecuciones">
                        <td>
                            <div class="hof-of">@item.FolioSolicitud</div>
                            <div class="hof-muted">@(string.IsNullOrWhiteSpace(item.NumeroOFRecibida) ? $"ID {item.SolicitudProduccionID}" : item.NumeroOFRecibida)</div>
                            <div class="hof-muted">@item.TipoOF</div>
                        </td>

                        <td>
                            <strong>@item.FechaReferencia.ToString("dd/MM/yyyy")</strong>
                            <div class="hof-muted">Inicio real: @(item.FechaInicioReal?.ToString("dd/MM HH:mm") ?? "Sin inicio real")</div>
                            <div class="hof-muted">Fin real: @(item.FechaFinReal?.ToString("dd/MM HH:mm") ?? "Sin cierre real")</div>
                        </td>

                        <td><strong>@item.Cliente</strong></td>
                        <td><div class="hof-parts">@item.Partes</div></td>
                        <td><div class="hof-parts">@item.Maquinas</div></td>
                        <td><div class="hof-personal">@item.Personal</div></td>

                        <td class="hof-qty">@item.CantidadPlaneada.ToString("N0")</td>
                        <td class="hof-qty">@item.CantidadOK.ToString("N0")</td>
                        <td class="hof-qty">@item.CantidadSospechosa.ToString("N0")</td>
                        <td class="hof-qty">@item.CantidadScrap.ToString("N0")</td>

                        <td>
                            <span class="hof-pill @(item.RendimientoOK >= 95m ? "ok" : item.RendimientoOK > 0 ? "warn" : "")">
                                @item.RendimientoOK.ToString("N2")%
                            </span>
                        </td>

                        <td>
                            <span class="hof-pill @statusClass">@item.EstatusNombre</span>
                            <div class="hof-muted mt-1">@item.TotalEjecuciones ejecución(es)</div>
                        </td>

                        <td>
                            <div class="d-flex flex-column gap-1" style="min-width:155px">
                                <a asp-controller="Planeacion" asp-action="Detalle" asp-route-id="@item.SolicitudProduccionID" class="hof-btn"><i class="fa-solid fa-eye"></i>Ver / gestionar</a>
                                <a asp-controller="Planeacion" asp-action="Detalle" asp-route-id="@item.SolicitudProduccionID" asp-route-autoPrint="1" class="hof-btn"><i class="fa-solid fa-print"></i>Imprimir OF</a>
                                @if (item.TotalEjecuciones == 0 && item.EstatusID != ERP.NSQuell.Models.PlaneacionOFEstatus.Cancelada)
                                {
                                    <a asp-controller="Planeacion" asp-action="Editar" asp-route-id="@item.SolicitudProduccionID" class="hof-btn"><i class="fa-solid fa-pen-to-square"></i>Editar</a>
                                }
                                @if (item.TotalEjecuciones > 0 && !item.FechaFinReal.HasValue && item.EstatusID != ERP.NSQuell.Models.PlaneacionOFEstatus.Cancelada)
                                {
                                    <button type="button" class="hof-btn" data-hof-extension data-solicitud-id="@item.SolicitudProduccionID"><i class="fa-solid fa-plus-minus"></i>Extender</button>
                                }
                                @if (item.EstatusID != ERP.NSQuell.Models.PlaneacionOFEstatus.Cancelada)
                                {
                                    <form method="post" asp-controller="Planeacion" asp-action="CancelarOF" onsubmit="return hofConfirmarCancelacion(this);">
                                        @Html.AntiForgeryToken()
                                        <input type="hidden" name="id" value="@item.SolicitudProduccionID" />
                                        <input type="hidden" name="motivoCancelacion" value="" />
                                        <button type="submit" class="hof-btn w-100 text-danger"><i class="fa-solid fa-ban"></i>Cancelar</button>
                                    </form>
                                }
                            </div>
                        </td>
                    </tr>
                }

                <tr id="hofNoResults" style="display:@(items.Count == 0 ? "table-row" : "none")">
                    <td colspan="13" class="hof-no-results">
                        No se encontraron órdenes históricas con los filtros seleccionados.
                    </td>
                </tr>
            </tbody>
        </table>
    </div>
    @* NSQ_LAURA_HISTORIAL_ACCIONES_V1 *@
    <div class="modal fade" id="hofExtensionModal" tabindex="-1" aria-hidden="true">
      <div class="modal-dialog modal-lg modal-dialog-centered"><div class="modal-content border-0 rounded-4 shadow-lg">
        <div class="modal-header"><div><h5 class="modal-title fw-bold">Extender Orden de Fabricación</h5><div class="small text-muted" id="hofExtHeader">Cargando...</div></div><button type="button" class="btn-close" data-bs-dismiss="modal"></button></div>
        <div class="modal-body"><form id="hofExtensionForm">@Html.AntiForgeryToken()
          <input type="hidden" name="SolicitudProduccionID" id="hofExtSolicitudID" />
          <div class="alert alert-danger d-none" id="hofExtError"></div>
          <div class="row g-2 mb-3">
            <div class="col-md-6"><label class="form-label fw-bold">Motivo</label><select class="form-select" name="Motivo" id="hofExtMotivo" required><option value="">Selecciona...</option><option value="CONTINUIDAD_MAQUINA">Continuar producción sin detener máquina</option><option value="ADELANTO_RELEASE">Adelanto / faltante de piezas de Release</option></select></div>
            <div class="col-md-3"><label class="form-label fw-bold">Piezas adicionales</label><input type="number" min="1" step="1" class="form-control" name="CantidadAdicional" id="hofExtCantidad" /></div>
            <div class="col-md-3"><label class="form-label fw-bold">Horas adicionales</label><input type="number" min="0" step="0.0001" class="form-control" name="HorasAdicionales" id="hofExtHoras" /></div>
          </div>
          <div class="mb-3 d-none" id="hofExtReleaseWrap"><label class="form-label fw-bold">Entrega Release de origen</label><select class="form-select" name="ReleaseDetalleOrigenID" id="hofExtRelease"></select><div class="form-text">Se reutiliza el flujo oficial de extensión de Planeación.</div></div>
          <div class="alert alert-secondary mb-0" id="hofExtResumen">Selecciona un motivo.</div>
        </form></div>
        <div class="modal-footer"><button type="button" class="btn btn-light" data-bs-dismiss="modal">Cerrar</button><button type="button" class="btn btn-primary fw-bold" id="hofExtAplicar"><i class="fa-solid fa-check me-1"></i>Aplicar extensión</button></div>
      </div></div>
    </div>
</main>

@section Scripts {
<script>
(() => {
    const tipo = document.getElementById('hofTipo');
    const estatus = document.getElementById('hofEstatus');
    const rows = [...document.querySelectorAll('[data-hof-row]')];
    const noResults = document.getElementById('hofNoResults');

    const apply = () => {
        const typeValue = tipo?.value || '';
        const statusValue = estatus?.value || '';
        let visible = 0;

        rows.forEach(row => {
            const typeOk = !typeValue || row.dataset.type === typeValue;

            let statusOk = true;

            if (statusValue === 'produccion') {
                statusOk = Number(row.dataset.executions || 0) > 0;
            } else if (statusValue) {
                statusOk = row.dataset.status === statusValue;
            }

            const show = typeOk && statusOk;
            row.style.display = show ? '' : 'none';

            if (show) visible++;
        });

        if (noResults) {
            noResults.style.display = visible === 0 ? 'table-row' : 'none';
        }
    };

    // NSQ_LAURA_HISTORIAL_ACCIONES_V1
    window.hofConfirmarCancelacion = form => {
        const motivo=window.prompt('Motivo de cancelación de la OF (mínimo 5 caracteres):','');
        if(!motivo||motivo.trim().length<5)return false;
        const input=form.querySelector('input[name="motivoCancelacion"]');if(input)input.value=motivo.trim();return true;
    };
    const hxEl=document.getElementById('hofExtensionModal');
    const hxModal=hxEl?bootstrap.Modal.getOrCreateInstance(hxEl):null;
    const hxForm=document.getElementById('hofExtensionForm');
    const hxHeader=document.getElementById('hofExtHeader');const hxError=document.getElementById('hofExtError');
    const hxId=document.getElementById('hofExtSolicitudID');const hxMotivo=document.getElementById('hofExtMotivo');
    const hxCantidad=document.getElementById('hofExtCantidad');const hxHoras=document.getElementById('hofExtHoras');
    const hxWrap=document.getElementById('hofExtReleaseWrap');const hxRelease=document.getElementById('hofExtRelease');
    const hxResumen=document.getElementById('hofExtResumen');const hxAplicar=document.getElementById('hofExtAplicar');
    const origenId=o=>o.releaseDetalleID??o.ReleaseDetalleID??'';
    const disponible=o=>Number(o.cantidadTransferible??o.CantidadTransferible??o.disponibleLibre??o.DisponibleLibre??0);
    const fecha=o=>o.fechaRequerida??o.FechaRequerida??null;
    const clearError=()=>hxError?.classList.add('d-none');
    const showError=m=>{if(hxError){hxError.textContent=m||'Ocurrió un error.';hxError.classList.remove('d-none')}};
    function configExt(){const m=hxMotivo?.value||'';const rel=m==='ADELANTO_RELEASE';const con=m==='CONTINUIDAD_MAQUINA';hxWrap?.classList.toggle('d-none',!rel);if(hxCantidad){hxCantidad.required=!!m;hxCantidad.min='1'}if(hxHoras){hxHoras.required=!!m;hxHoras.min=rel?'0':'0.0001';if(rel&&hxHoras.value==='')hxHoras.value='0'}if(hxRelease){hxRelease.required=rel;hxRelease.disabled=!rel}if(hxResumen)hxResumen.textContent=rel?'Selecciona una entrega Release y captura las piezas.':con?'Captura piezas y horas adicionales.':'Selecciona un motivo.'}
    function loadOrigins(items){if(!hxRelease)return;hxRelease.innerHTML='<option value="">Selecciona una entrega...</option>';for(const o of(items||[])){const id=origenId(o);if(!id)continue;const op=document.createElement('option');op.value=String(id);const disp=disponible(o);op.dataset.disponible=String(disp);const f=fecha(o);op.textContent=`Entrega ${id}${f?' · '+new Date(f).toLocaleDateString('es-MX'):''} · libre ${disp.toLocaleString('es-MX')} pzas`;hxRelease.appendChild(op)}}
    document.querySelectorAll('[data-hof-extension]').forEach(btn=>btn.addEventListener('click',async()=>{const id=Number(btn.dataset.solicitudId||0);if(!id)return;clearError();if(hxId)hxId.value=String(id);if(hxMotivo)hxMotivo.value='';if(hxCantidad)hxCantidad.value='';if(hxHoras)hxHoras.value='';configExt();try{const r=await fetch(`/PlaneacionPrograma/ObtenerExtensionOF?solicitudProduccionId=${encodeURIComponent(id)}`,{headers:{'X-Requested-With':'XMLHttpRequest'}});const d=await r.json();if(!r.ok||!d.ok)throw new Error(d.mensaje||'No fue posible consultar la extensión.');if(hxHeader)hxHeader.textContent=`${d.folio||'OF'} · ${d.parte||'-'} · ${d.maquina||'-'}`;loadOrigins(d.origenes||[]);hxModal?.show()}catch(e){window.alert(e.message||'No fue posible abrir la extensión.')}}));
    hxMotivo?.addEventListener('change',configExt);
    hxRelease?.addEventListener('change',()=>{const op=hxRelease.selectedOptions?.[0];if(!op||!hxCantidad)return;const d=Number(op.dataset.disponible||0);if(d>0)hxCantidad.max=String(d);else hxCantidad.removeAttribute('max')});
    hxAplicar?.addEventListener('click',async()=>{if(!hxForm||!hxForm.reportValidity())return;clearError();if(hxMotivo?.value==='ADELANTO_RELEASE'&&!hxRelease?.value){showError('Selecciona la entrega Release de origen.');return}hxAplicar.disabled=true;const old=hxAplicar.innerHTML;hxAplicar.innerHTML='<span class="spinner-border spinner-border-sm me-1"></span>Aplicando...';try{const r=await fetch('/PlaneacionPrograma/AplicarExtensionOF',{method:'POST',body:new FormData(hxForm),headers:{'X-Requested-With':'XMLHttpRequest'}});const d=await r.json();if(!r.ok||!d.ok)throw new Error(d.mensaje||'No fue posible aplicar la extensión.');hxModal?.hide();window.location.reload()}catch(e){showError(e.message||'No fue posible aplicar la extensión.')}finally{hxAplicar.disabled=false;hxAplicar.innerHTML=old}});
    tipo?.addEventListener('change', apply);
    estatus?.addEventListener('change', apply);
})();
</script>
}
