@model ERP.NSQuell.Models.PlaneacionOFDetalleVm

@{
    Layout = null;

    string Valor(string? valor)
    {
        return string.IsNullOrWhiteSpace(valor) ? "-" : valor;
    }

    string Fecha(DateTime? fecha)
    {
        return fecha.HasValue ? fecha.Value.ToString("dd/MM/yyyy") : "-";
    }

    string FechaHora(DateTime? fecha)
    {
        return fecha.HasValue ? fecha.Value.ToString("dd/MM/yyyy HH:mm") : "-";
    }

    string Decimal2(decimal? valor)
    {
        return valor.HasValue ? valor.Value.ToString("N2") : "-";
    }

    string Decimal4(decimal? valor)
    {
        return valor.HasValue ? valor.Value.ToString("N4") : "-";
    }

    string Decimal6(decimal? valor)
    {
        return valor.HasValue ? valor.Value.ToString("N6") : "-";
    }

    string Moneda(decimal? valor, string? moneda = null)
    {
        if (!valor.HasValue)
            return "-";

        var textoMoneda = string.IsNullOrWhiteSpace(moneda) ? "" : $" {moneda}";
        return $"${valor.Value:N2}{textoMoneda}";
    }

    string Entero(int? valor)
    {
        return valor.HasValue ? valor.Value.ToString("N0") : "-";
    }

    string Hora(TimeSpan? hora)
    {
        return hora.HasValue ? hora.Value.ToString(@"hh\:mm") : "-";
    }

    string EstatusClase(int estatusId)
    {
        return estatusId switch
        {
            1 => "badge-capturada",
            2 => "badge-planeada",
            3 => "badge-produccion",
            9 => "badge-cerrada",
            99 => "badge-cancelada",
            _ => "badge-default"
        };
    }

    string NombreEstatus(int? estatusId)
    {
        if (!estatusId.HasValue)
            return "-";

        return ERP.NSQuell.Models.PlaneacionOFEstatus.Nombre(estatusId.Value);
    }

    string TipoOFNormalizado(string? tipoOF)
    {
        if (string.IsNullOrWhiteSpace(tipoOF))
            return "RELEASE";

        var valor = tipoOF.Trim().ToUpperInvariant()
            .Replace("Á", "A")
            .Replace("É", "E")
            .Replace("Í", "I")
            .Replace("Ó", "O")
            .Replace("Ú", "U");

        return valor switch
        {
            "RELEASE" => "RELEASE",
            "ENSAMBLE" => "ENSAMBLE",
            "PRUEBA" => "PRUEBA",
            "MP EXTRA" => "MP EXTRA",
            "MPEXTRA" => "MP EXTRA",
            "MP_EXTRA" => "MP EXTRA",
            _ => "RELEASE"
        };
    }

    string TextoTipoOF(string? tipoOF)
    {
        return TipoOFNormalizado(tipoOF) switch
        {
            "ENSAMBLE" => "Ensamble",
            "PRUEBA" => "Prueba",
            "MP EXTRA" => "MP extra",
            _ => "Release"
        };
    }

    string ClaseTipoOF(string? tipoOF)
    {
        return TipoOFNormalizado(tipoOF) switch
        {
            "ENSAMBLE" => "tipo-ensamble",
            "PRUEBA" => "tipo-prueba",
            "MP EXTRA" => "tipo-mp-extra",
            _ => "tipo-release"
        };
    }

    string IconoTipoOF(string? tipoOF)
    {
        return TipoOFNormalizado(tipoOF) switch
        {
            "ENSAMBLE" => "fa-layer-group",
            "PRUEBA" => "fa-flask-vial",
            "MP EXTRA" => "fa-boxes-stacked",
            _ => "fa-industry"
        };
    }

    var tipoOFActual = TipoOFNormalizado(Model.TipoOF);
    var textoTipoOFActual = TextoTipoOF(Model.TipoOF);

    var totalPiezas = Model.Detalles?.Sum(x => x.CantidadPiezas) ?? 0;
    var totalHoras = Model.Detalles?.Where(x => x.HorasPlaneadas.HasValue).Sum(x => x.HorasPlaneadas!.Value) ?? 0;
    var totalMp = Model.Detalles?.Where(x => x.CantidadMpKg.HasValue).Sum(x => x.CantidadMpKg!.Value) ?? 0;
    var totalEmbalajes = Model.Detalles?.Where(x => x.CantidadEmbalajes.HasValue).Sum(x => x.CantidadEmbalajes!.Value) ?? 0;
    var totalRenglones = Model.Detalles?.Count ?? 0;
    var monedaCosto = Model.MonedaCosto ?? "MXN";
    var totalCostoMP = Model.CostoMPTotal;
    var totalCostoEmbalaje = Model.CostoEmbalajeTotal;
    var totalCostoOF = Model.CostoTotalOF;
    var totalVentaOF = Model.VentaTotalOF;
    var totalUtilidadOF = Model.UtilidadEstimadaOF;
}

<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <title>Detalle OF | Planeación</title>
    <meta name="viewport" content="width=device-width, initial-scale=1" />

    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.2/css/all.min.css" rel="stylesheet">

    <style>
