            z-index: 20;
        }

        .print-area {
            display: none;
        }

        .print-sheet {
            background: #fff;
            color: #111827;
            font-family: "Segoe UI", Arial, sans-serif;
        }

        .print-top {
            display: flex;
            justify-content: space-between;
            align-items: flex-start;
