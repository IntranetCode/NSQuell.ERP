                font-size: 1.65rem;
                margin: 0;
                font-weight: 900;
            }

            .erp-header p {
                margin: 7px 0 0 0;
                opacity: .9;
            }

        .header-badge {
            display: inline-flex;
            align-items: center;
            gap: 7px;
            background: rgba(255,255,255,.16);
            color: white;
            border: 1px solid rgba(255,255,255,.28);
            border-radius: 999px;
            padding: 7px 12px;
            font-size: .82rem;
            font-weight: 800;
            margin-top: 12px;
            margin-right: 6px;
        }

        .tipo-of-badge {
            display: inline-flex;
            align-items: center;
            gap: 7px;
            border-radius: 999px;
            padding: 7px 12px;
            font-size: .8rem;
            font-weight: 900;
            border: 1px solid transparent;
            white-space: nowrap;
        }

        .tipo-release {
            background: #eef6ff;
            color: #175cd3;
            border-color: #b2ddff;
        }

        .tipo-ensamble {
            background: #f4f3ff;
            color: #5925dc;
            border-color: #d9d6fe;
        }

        .tipo-prueba {
            background: #fff7ed;
            color: #b54708;
            border-color: #fed7aa;
        }

        .tipo-mp-extra {
            background: #ecfdf3;
            color: #027a48;
            border-color: #abefc6;
        }

        .tipo-of-panel {
            border: 1px solid var(--erp-border);
            border-radius: 18px;
            background: linear-gradient(180deg, #ffffff, #f8fbff);
            padding: 16px;
            height: 100%;
        }

            .tipo-of-panel .tipo-of-badge {
                margin-bottom: 10px;
            }

        .tipo-of-note {
            color: var(--erp-muted);
            font-size: .86rem;
            line-height: 1.35;
        }

        .erp-card {
            background: white;
            border: 1px solid var(--erp-border);
            border-radius: 20px;
            box-shadow: 0 10px 24px rgba(30, 55, 90, .08);
            margin-bottom: 20px;
            overflow: hidden;
        }

        .erp-card-header {
            padding: 18px 22px;
            border-bottom: 1px solid var(--erp-border);
            display: flex;
            justify-content: space-between;
            align-items: center;
            gap: 14px;
            flex-wrap: wrap;
