        }

        .section-title {
            font-size: .82rem;
            font-weight: 950;
            color: var(--erp-blue-dark);
            text-transform: uppercase;
            letter-spacing: .045em;
            margin: 18px 0 12px 0;
            padding-bottom: 8px;
            border-bottom: 1px solid #edf1f6;
        }

        .info-pill {
            display: inline-flex;
            align-items: center;
            gap: 6px;
            border-radius: 999px;
            padding: 5px 10px;
            background: #f2f4f7;
            color: #344054;
            font-size: .78rem;
            font-weight: 800;
        }

        .timeline {
            position: relative;
            padding-left: 28px;
        }

            .timeline:before {
                content: "";
                position: absolute;
                left: 9px;
                top: 6px;
                bottom: 6px;
                width: 2px;
                background: #d9e1ec;
            }

        .timeline-item {
            position: relative;
            background: #fff;
            border: 1px solid var(--erp-border);
            border-radius: 16px;
            padding: 14px 16px;
            margin-bottom: 14px;
        }

            .timeline-item:before {
                content: "";
                position: absolute;
                left: -25px;
                top: 18px;
                width: 12px;
                height: 12px;
                border-radius: 50%;
                background: var(--erp-blue);
                box-shadow: 0 0 0 4px #eaf2ff;
