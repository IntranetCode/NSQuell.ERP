            }

        .print-notes {
            border: 1px solid #d9e1ec;
            padding: 6px 8px;
            font-size: 9px;
            min-height: 35px;
        }

        .print-footer {
            margin-top: 8px;
            display: flex;
            justify-content: space-between;
            gap: 8px;
            color: #667085;
            font-size: 8px;
        }

        @@media (max-width: 768px) {
            .erp-shell {
                padding: 16px;
            }

            .erp-header {
                padding: 22px;
            }

                .erp-header h1 {
                    font-size: 1.32rem;
                }

            .erp-card-body {
                padding: 16px;
            }
        }

        @@media print {
            @@page {
                size: letter landscape;
                margin: 8mm;
            }

            html,
            body {
                background: white !important;
                width: 100%;
                height: auto;
                -webkit-print-color-adjust: exact !important;
                print-color-adjust: exact !important;
            }

            .screen-area,
            .no-print,
            .modal,
            .modal-backdrop {
                display: none !important;
            }

            .print-area {
                display: block !important;
            }

            .print-sheet {
                display: block !important;
                width: 100%;
                margin: 0;
                padding: 0;
                box-shadow: none;
            }

            .print-section-title {
                page-break-after: avoid;
            }

            .print-table {
                page-break-inside: auto;
            }

                .print-table tr {
                    page-break-inside: avoid;
                    page-break-after: auto;
                }
        }
    </style>
</head>

<body>
    <div class="screen-area">
        <div class="erp-shell">

            <div class="erp-header">
                <div class="d-flex justify-content-between align-items-start gap-3 flex-wrap">
                    <div>
                        <h1>
                            <i class="fa-solid fa-clipboard-list me-2"></i>
                            Detalle de OF
                        </h1>
                        <p>
                            Consulta general de la orden de fabricación, datos técnicos, asignación de máquina e historial.
                        </p>

                        <div>
                            <span class="header-badge">
                                <i class="fa-solid fa-hashtag"></i>
                                Folio interno: @(Model.FolioSolicitud ?? "Sin folio")
                            </span>

                            <span class="header-badge">
                                <i class="fa-solid fa-file-signature"></i>
                                OF Dirección: @(Model.NumeroOFRecibida ?? "Sin OF")
                            </span>

                            <span class="header-badge">
                                <i class="fa-solid @IconoTipoOF(Model.TipoOF)"></i>
                                Tipo OF: @textoTipoOFActual
                            </span>


                        </div>
                    </div>

                    <div class="d-flex gap-2 flex-wrap">
                        <a asp-controller="Planeacion" asp-action="Index" class="btn btn-light fw-bold rounded-3">
                            <i class="fa-solid fa-arrow-left me-1"></i>
                            Volver
                        </a>

                        <button type="button" class="btn btn-light fw-bold rounded-3" onclick="imprimirOF()">
                            <i class="fa-solid fa-print me-1"></i>
                            Imprimir OF
                        </button>

                        @if (Model.PermiteEditarOF)
                        {
                            <a asp-controller="Planeacion"
                               asp-action="Editar"
                               asp-route-id="@Model.SolicitudProduccionID"
                               class="btn btn-warning rounded-3 fw-bold">
                                <i class="fa-solid fa-pen-to-square me-1"></i>
                                Editar OF
                            </a>
                        }
                        else
                        {
                            <div class="alert alert-info rounded-4 fw-semibold mb-0">
                                <i class="fa-solid fa-circle-info me-2"></i>
                                Esta OF nació desde un Release/Programa. Para modificarla, edita el Release y recalcula la planeación.
                            </div>
                        }
                        else if (!string.IsNullOrWhiteSpace(Model.MotivoNoEditable))
                        {
                            <span class="badge bg-secondary align-self-center">
                                <i class="fa-solid fa-lock me-1"></i>
                                @Model.MotivoNoEditable
                            </span>
                        }

                        <button type="button"
                                class="btn btn-danger rounded-3 fw-bold"
                                data-bs-toggle="modal"
                                data-bs-target="#modalCancelarOF">
                            <i class="fa-solid fa-ban me-1"></i>
                            Cancelar OF
                        </button>

                    </div>
                </div>
            </div>

            @if (TempData["Success"] != null)
            {
                <div class="alert alert-success rounded-4 fw-semibold">
                    <i class="fa-solid fa-circle-check me-2"></i>
                    @TempData["Success"]
                </div>
            }

            @if (TempData["Error"] != null)
            {
                <div class="alert alert-danger rounded-4 fw-semibold">
                    <i class="fa-solid fa-triangle-exclamation me-2"></i>
                    @TempData["Error"]
                </div>
            }

            <div class="row g-3 mb-3">
                <div class="col-md-3">
                    <div class="metric-card">
                        <div class="metric-icon">
                            <i class="fa-solid fa-layer-group"></i>
                        </div>
                        <div class="metric-label">Renglones</div>
                        <div class="metric-value">@totalRenglones</div>
