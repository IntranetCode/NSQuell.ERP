            font-size: 10px;
            color: #344054;
            margin-top: 3px;
        }

        .print-section-title {
            background: #eef3fb;
            color: #00347a;
            border: 1px solid #cfd8e6;
            font-weight: 900;
            font-size: 10px;
            padding: 5px 7px;
            margin-top: 8px;
            text-transform: uppercase;
            letter-spacing: .03em;
        }

        .print-grid {
            display: grid;
            grid-template-columns: repeat(4, 1fr);
            border-left: 1px solid #d9e1ec;
            border-top: 1px solid #d9e1ec;
        }

        .print-cell {
            border-right: 1px solid #d9e1ec;
            border-bottom: 1px solid #d9e1ec;
            padding: 5px 7px;
            min-height: 34px;
        }

        .print-label {
            font-size: 8px;
            color: #667085;
            text-transform: uppercase;
            font-weight: 800;
            letter-spacing: .03em;
        }

        .print-value {
            font-size: 10px;
            font-weight: 700;
            color: #111827;
            margin-top: 1px;
        }

        .print-metrics {
            display: grid;
            grid-template-columns: repeat(4, 1fr);
            gap: 6px;
            margin-top: 8px;
        }

        .print-metric {
            border: 1px solid #d9e1ec;
            border-radius: 8px;
            padding: 6px 8px;
            background: #f8fafc;
        }

        .print-metric-label {
            font-size: 8px;
            color: #667085;
            text-transform: uppercase;
            font-weight: 800;
        }

        .print-metric-value {
            font-size: 14px;
            color: #00347a;
            font-weight: 900;
            line-height: 1.15;
        }

        .print-table {
            width: 100%;
            border-collapse: collapse;
            margin-top: 0;
            table-layout: fixed;
        }

            .print-table th {
                background: #eef3fb;
                color: #00347a;
                border: 1px solid #cfd8e6;
                font-size: 8px;
                padding: 4px;
                text-transform: uppercase;
            }

            .print-table td {
                border: 1px solid #d9e1ec;
                font-size: 8px;
                padding: 4px;
                vertical-align: top;
