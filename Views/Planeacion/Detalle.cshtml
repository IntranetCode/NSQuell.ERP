        .print-brand {
            font-weight: 900;
            font-size: 18px;
            color: #004AAD;
        }

        .print-subtitle {
            font-size: 10px;
            color: #667085;
            margin-top: 2px;
        }

        .print-title {
            text-align: right;
            font-weight: 900;
            font-size: 15px;
            color: #00347a;
        }

        .print-folio {
