                            {
                                <div class="empty-state">
                                    <i class="fa-solid fa-clock-rotate-left"></i>
                                    <div class="fw-bold">No hay historial registrado.</div>
                                </div>
                            }
                        </div>
                    </div>
                </div>
            </div>

            <div class="sticky-actions no-print">
                <div class="d-flex justify-content-between gap-2 flex-wrap">
                    <a asp-controller="Planeacion" asp-action="Index" class="btn btn-erp-light">
                        <i class="fa-solid fa-arrow-left me-1"></i>
                        Volver a Planeación
                    </a>

                    <div class="d-flex gap-2 flex-wrap">
                        <button type="button" class="btn btn-erp-light" onclick="imprimirOF()">
                            <i class="fa-solid fa-print me-1"></i>
                            Imprimir OF
                        </button>

                       
                    </div>
                </div>
            </div>
        </div>

       
    </div>

    <div class="print-area">
        <div class="print-sheet">
            <div class="print-top">
                <div>
                    <div class="print-brand">ERP QUELL</div>
                    <div class="print-subtitle">Planeación / Orden de Fabricación</div>
                </div>

                <div>
                    <div class="print-title">ORDEN DE FABRICACIÓN</div>
                    <div class="print-folio">
                        Folio interno: @Valor(Model.FolioSolicitud)<br />
                        OF Dirección: @Valor(Model.NumeroOFRecibida)<br />
                        Tipo OF: @textoTipoOFActual
                    </div>
                </div>
            </div>

            <div class="print-section-title">Encabezado</div>
            <div class="print-grid">
                <div class="print-cell">
                    <div class="print-label">Cliente</div>
                    <div class="print-value">@Valor(Model.Cliente)</div>
                </div>

                <div class="print-cell">
                    <div class="print-label">Estatus</div>
                    <div class="print-value">@Valor(Model.EstatusNombre)</div>
                </div>

                <div class="print-cell">
                    <div class="print-label">Responsable</div>
                    <div class="print-value">@Valor(Model.ResponsablePlaneacionNombre)</div>
                </div>

                <div class="print-cell">
                    <div class="print-label">Fecha solicitud</div>
                    <div class="print-value">@Model.FechaSolicitud.ToString("dd/MM/yyyy")</div>
                </div>

                <div class="print-cell">
                    <div class="print-label">Fecha requerida</div>
                    <div class="print-value">@Fecha(Model.FechaRequerida)</div>
                </div>

                <div class="print-cell">
                    <div class="print-label">Inicio planeado</div>
                    <div class="print-value">@FechaHora(Model.FechaInicioPlaneada)</div>
                </div>

                <div class="print-cell">
                    <div class="print-label">Fin planeado</div>
                    <div class="print-value">@FechaHora(Model.FechaFinPlaneada)</div>
                </div>

                <div class="print-cell">
                    <div class="print-label">Tipo OF</div>
                    <div class="print-value">@textoTipoOFActual</div>
                </div>

                <div class="print-cell">
                    <div class="print-label">Motivo tipo OF</div>
                    <div class="print-value">@Valor(Model.MotivoTipoOF)</div>
                </div>

                <div class="print-cell">
                    <div class="print-label">Fecha impresión</div>
                    <div class="print-value">@DateTime.Now.ToString("dd/MM/yyyy HH:mm")</div>
                </div>
            </div>

            <div class="print-metrics">
                <div class="print-metric">
                    <div class="print-metric-label">Renglones</div>
                    <div class="print-metric-value">@totalRenglones</div>
                </div>

                <div class="print-metric">
                    <div class="print-metric-label">Total piezas</div>
                    <div class="print-metric-value">@totalPiezas.ToString("N0")</div>
                </div>

                <div class="print-metric">
                    <div class="print-metric-label">Horas planeadas</div>
                    <div class="print-metric-value">@totalHoras.ToString("N2")</div>
                </div>

                <div class="print-metric">
                    <div class="print-metric-label">MP requerida kg</div>
                    <div class="print-metric-value">@totalMp.ToString("N4")</div>
                </div>
            </div>

            <div class="print-section-title">Detalle de producción</div>
            <table class="print-table">
                <thead>
                    <tr>
                        <th style="width:4%;">Ren.</th>
                        <th style="width:10%;">Referencia</th>
                        <th style="width:19%;">Descripción</th>
                        <th style="width:7%;">Cantidad</th>
                        <th style="width:7%;">Horas</th>
                        <th style="width:9%;">Máquina</th>
                        <th style="width:8%;">Molde</th>
                        <th style="width:7%;">Color</th>
                        <th style="width:11%;">Material</th>
                        <th style="width:7%;">MP kg</th>
                        <th style="width:8%;">Emb.</th>
                        <th style="width:7%;">Cant. emb.</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model.Detalles != null && Model.Detalles.Any())
                    {
                        foreach (var d in Model.Detalles)
                        {
                            var asignacion = d.AsignacionesMaquina?.FirstOrDefault();

                            <tr>
                                <td>@d.Renglon</td>
                                <td>@Valor(d.ReferenciaSAP)</td>
                                <td>@Valor(d.DesignacionDescripcionSAP)</td>
                                <td>@d.CantidadPiezas.ToString("N0")</td>
                                <td>@Decimal2(d.HorasPlaneadas)</td>
                                <td>@Valor(asignacion?.Maquina)</td>
                                <td>@Valor(d.Molde ?? asignacion?.Molde)</td>
                                <td>@Valor(d.Color)</td>
                                <td>
                                    <strong>@Valor(d.MaterialCodigo)</strong><br />
                                    @Valor(d.MaterialDescripcion)
                                </td>
                                <td>@Decimal4(d.CantidadMpKg)</td>
                                <td>
                                    <strong>@Valor(d.EmbalajeCodigo)</strong><br />
                                    @Valor(d.EmbalajeDescripcion)
                                </td>

                                <td>@Decimal4(d.CantidadEmbalajes)</td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="12">No hay renglones registrados.</td>
                        </tr>
                    }
                </tbody>
            </table>

            <div class="print-section-title">Notas generales</div>
            <div class="print-notes">
                @Valor(Model.NotasGenerales)
            </div>

            <div class="print-footer">
                <div>
                    Documento generado desde ERP QUELL.
                </div>
                <div>
                    Impreso: @DateTime.Now.ToString("dd/MM/yyyy HH:mm")
                </div>
            </div>
        </div>
    </div>

    <div class="modal fade" id="modalCancelarOF" tabindex="-1" aria-labelledby="modalCancelarOFLabel" aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content rounded-4 border-0 shadow-lg">
                <div class="modal-header bg-danger text-white rounded-top-4">
                    <h5 class="modal-title fw-bold" id="modalCancelarOFLabel">
                        <i class="fa-solid fa-ban me-2"></i>
                        Cancelar OF
                    </h5>
                    <button type="button"
                            class="btn-close btn-close-white"
                            data-bs-dismiss="modal"
                            aria-label="Cerrar"></button>
                </div>

                <form asp-controller="Planeacion"
                      asp-action="CancelarOF"
                      method="post">
                    @Html.AntiForgeryToken()

                    <input type="hidden" name="id" value="@Model.SolicitudProduccionID" />

                    <div class="modal-body">
                        <div class="alert alert-warning rounded-4 fw-semibold">
                            <i class="fa-solid fa-triangle-exclamation me-2"></i>
                            Esta acción cancelará la OF. Captura el motivo para dejar evidencia.
                        </div>

                        <label class="form-label fw-bold">
                            Motivo de cancelación
                        </label>

                        <textarea name="motivoCancelacion"
                                  class="form-control rounded-3"
                                  rows="4"
                                  maxlength="500"
                                  required
                                  placeholder="Ej. Cliente canceló pedido, duplicidad de OF, error de captura, cambio de release..."></textarea>

                        <div class="text-muted small mt-2">
                            Mínimo 5 caracteres, máximo 500.
                        </div>
                    </div>

                    <div class="modal-footer border-0">
                        <button type="button"
                                class="btn btn-light rounded-3 fw-bold"
                                data-bs-dismiss="modal">
                            Regresar
                        </button>

                        <button type="submit"
                                class="btn btn-danger rounded-3 fw-bold">
                            <i class="fa-solid fa-ban me-1"></i>
                            Confirmar cancelación
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>

    <script>
        function imprimirOF() {
            window.print();
        }
    </script>
</body>
</html>