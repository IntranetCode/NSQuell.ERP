            align-items: center;
            border-radius: 999px;
            padding: 7px 12px;
            font-size: .78rem;
            font-weight: 900;
            border: 1px solid transparent;
        }

        .badge-capturada {
            background: #eef6ff;
            color: #175cd3;
            border-color: #b2ddff;
        }

        .badge-planeada {
            background: #f4f3ff;
            color: #5925dc;
            border-color: #d9d6fe;
        }

        .badge-produccion {
            background: #fff7ed;
            color: #b54708;
            border-color: #fed7aa;
        }

        .badge-cerrada {
            background: #ecfdf3;
            color: #027a48;
            border-color: #abefc6;
        }

        .badge-cancelada {
            background: #fef3f2;
            color: #b42318;
            border-color: #fecdca;
        }

        .badge-default {
            background: #f2f4f7;
            color: #344054;
            border-color: #d0d5dd;
        }

        .btn-erp-primary {
