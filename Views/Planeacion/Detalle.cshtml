        }

        .erp-shell {
            max-width: 1600px;
            margin: 0 auto;
            padding: 28px;
        }

        .erp-header {
            background: linear-gradient(135deg, var(--erp-blue), var(--erp-blue-dark));
            color: white;
            border-radius: 22px;
            padding: 28px 32px;
            box-shadow: 0 16px 36px rgba(0, 74, 173, .23);
            margin-bottom: 22px;
        }

