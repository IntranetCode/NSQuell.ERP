@model List<ERP.NSQuell.Models.PlaneacionOFIndexVm>
@using System.Linq

@functions {
    public static string Texto(string? valor) => string.IsNullOrWhiteSpace(valor) ? "Sin definir" : valor.Trim();
    public static string Fecha(DateTime? valor) => valor.HasValue ? valor.Value.ToString("dd/MM/yyyy") : "Sin fecha";
    public static string FechaHora(DateTime? valor) => valor.HasValue ? valor.Value.ToString("dd/MM/yyyy HH:mm") : "Sin definir";

    public static string PrioridadNormalizada(string? prioridad)
    {
        return string.IsNullOrWhiteSpace(prioridad) ? "NORMAL" : prioridad.Trim().ToUpperInvariant();
    }

    public static int OrdenPrioridad(string? prioridad)
    {
        return PrioridadNormalizada(prioridad) switch
        {
            "URGENTE" => 1,
            "ALTA" => 2,
            "MEDIA" => 3,
            "NORMAL" => 4,
            "BAJA" => 5,
            _ => 6
        };
    }

    public static string ClasePrioridad(string? prioridad)
    {
        return PrioridadNormalizada(prioridad) switch
        {
            "URGENTE" => "priority-urgent",
            "ALTA" => "priority-high",
            "MEDIA" => "priority-medium",
            "BAJA" => "priority-low",
            _ => "priority-normal"
        };
    }

    public static string IconoPrioridad(string? prioridad)
    {
        return PrioridadNormalizada(prioridad) switch
        {
            "URGENTE" => "fa-bolt",
            "ALTA" => "fa-arrow-up",
            "MEDIA" => "fa-minus",
            "BAJA" => "fa-arrow-down",
            _ => "fa-circle"
        };
    }

    public static string ClaseFecha(DateTime? fecha)
    {
        if (!fecha.HasValue) return "date-none";

        var dias = (fecha.Value.Date - DateTime.Today).Days;
        if (dias < 0) return "date-overdue";
        if (dias == 0) return "date-today";
        if (dias <= 3) return "date-soon";
        return "date-ok";
    }

    public static string TextoFechaEntrega(DateTime? fecha)
    {
        if (!fecha.HasValue) return "Sin fecha de entrega";

        var dias = (fecha.Value.Date - DateTime.Today).Days;
        if (dias < 0) return $"Vencida hace {Math.Abs(dias)} día(s)";
        if (dias == 0) return "Entrega hoy";
        if (dias == 1) return "Entrega mañana";
        return $"Entrega en {dias} día(s)";
    }

    public static string ClaseEstatus(int estatusId)
    {
        return estatusId switch
        {
            3 or 4 or 5 => "status-danger",
            6 or 7 or 8 or 10 => "status-success",
            9 => "status-purple",
            11 => "status-muted",
            _ => "status-info"
        };
    }
}

@{
    Layout = null;

    var success = TempData["Success"] as string;
    var error = TempData["Error"] as string;
    var lista = Model ?? new List<ERP.NSQuell.Models.PlaneacionOFIndexVm>();

    var pendientesGenerarOF = lista.Count(x => x.SolicitudProduccionID < 0);
    var ofGeneradas = lista.Count(x => x.SolicitudProduccionID > 0);
    var totalPiezas = lista.Sum(x => x.TotalPiezas);
    var vencidas = lista.Count(x => x.FechaRequerida.HasValue && x.FechaRequerida.Value.Date < DateTime.Today);

    var clientes = lista
        .GroupBy(x => Texto(x.Cliente))
        .OrderBy(x => x.Key)
        .ToList();
}

<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <title>Bandeja de OF | ERP QUELL</title>
    <meta name="viewport" content="width=device-width, initial-scale=1" />

    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet" />
    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.2/css/all.min.css" rel="stylesheet" />

    <style>
        :root {
            --blue: #004aad;
            --blue-dark: #07376f;
            --blue-soft: #edf5ff;
            --background: #f4f7fb;
            --border: #dce5f0;
            --text: #203047;
            --muted: #6b7a90;
            --shadow: 0 10px 26px rgba(28, 51, 84, .08);
        }

        * {
            box-sizing: border-box;
        }

        body {
            margin: 0;
            background: radial-gradient(circle at top left, rgba(0, 74, 173, .09), transparent 28%), var(--background);
            color: var(--text);
            font-family: "Segoe UI", Arial, sans-serif;
        }

        .page-shell {
            width: min(1680px, calc(100% - 32px));
            margin: 0 auto;
            padding: 24px 0 40px;
        }

        .hero {
            background: linear-gradient(135deg, var(--blue), var(--blue-dark));
            color: #fff;
            border-radius: 24px;
            padding: 24px;
            box-shadow: 0 16px 38px rgba(0, 74, 173, .20);
            margin-bottom: 18px;
        }

        .hero-layout {
            display: flex;
            align-items: flex-start;
            justify-content: space-between;
            gap: 20px;
            flex-wrap: wrap;
        }

        .hero h1 {
            margin: 0;
            font-size: clamp(1.35rem, 2.5vw, 2rem);
            font-weight: 900;
        }

        .hero p {
            margin: 7px 0 0;
            max-width: 760px;
            opacity: .9;
        }

        .hero-stats {
            display: grid;
            grid-template-columns: repeat(4, minmax(120px, 1fr));
            gap: 9px;
        }

        .stat {
            min-width: 125px;
            padding: 12px 14px;
            border-radius: 15px;
            background: rgba(255,255,255,.13);
            border: 1px solid rgba(255,255,255,.22);
        }

        .stat-value {
            font-size: 1.3rem;
            font-weight: 950;
            line-height: 1;
        }

        .stat-label {
            margin-top: 5px;
            font-size: .72rem;
            font-weight: 750;
            opacity: .88;
        }

        .toolbar {
            background: #fff;
            border: 1px solid var(--border);
            border-radius: 18px;
            padding: 14px;
            box-shadow: var(--shadow);
            margin-bottom: 18px;
        }

        .toolbar-layout {
            display: flex;
            align-items: center;
            justify-content: space-between;
            gap: 12px;
            flex-wrap: wrap;
        }

        .search-wrap {
            position: relative;
            flex: 1 1 420px;
        }

            .search-wrap i {
                position: absolute;
                left: 14px;
                top: 50%;
                transform: translateY(-50%);
                color: #8694a8;
            }

        .search-input {
            width: 100%;
            min-height: 44px;
            padding: 10px 14px 10px 40px;
            border: 1px solid var(--border);
            border-radius: 13px;
            outline: none;
        }

            .search-input:focus {
                border-color: #8fb9ee;
                box-shadow: 0 0 0 4px rgba(0, 74, 173, .08);
            }

        .btn-erp {
            min-height: 42px;
            display: inline-flex;
            align-items: center;
            justify-content: center;
            gap: 7px;
            border-radius: 12px;
            padding: 9px 14px;
            font-weight: 800;
            text-decoration: none;
            white-space: nowrap;
        }

        .btn-erp-primary {
            border: 1px solid var(--blue);
            background: var(--blue);
            color: #fff;
        }

            .btn-erp-primary:hover {
                color: #fff;
                background: var(--blue-dark);
            }

        .btn-erp-light {
            border: 1px solid var(--border);
            background: #fff;
            color: var(--blue-dark);
        }

            .btn-erp-light:hover {
                color: var(--blue-dark);
                background: #f0f5fb;
            }

        .client-section {
            background: #fff;
            border: 1px solid var(--border);
            border-radius: 22px;
            overflow: hidden;
            box-shadow: var(--shadow);
            margin-bottom: 18px;
        }

        .client-header {
            width: 100%;
            padding: 16px 18px;
            border: 0;
            background: linear-gradient(180deg, #fff, #f8fbff);
            display: flex;
            align-items: center;
            justify-content: space-between;
            gap: 14px;
            flex-wrap: wrap;
            text-align: left;
            color: inherit;
            cursor: pointer;
        }

            .client-header:hover {
                background: linear-gradient(180deg, #fff, #f1f7ff);
            }

            .client-header:focus-visible {
                outline: 3px solid rgba(0, 74, 173, .18);
                outline-offset: -3px;
            }

        .client-header-main {
            display: flex;
            align-items: center;
            justify-content: space-between;
            gap: 14px;
            flex: 1 1 640px;
            min-width: 0;
        }

        .client-toggle {
            width: 34px;
            height: 34px;
            flex: 0 0 34px;
            border-radius: 11px;
            display: grid;
            place-items: center;
            color: var(--blue);
            background: var(--blue-soft);
            transition: transform .2s ease, background .2s ease;
        }

        .client-section.is-open .client-toggle {
            transform: rotate(180deg);
            background: #dcecff;
        }

        .client-body {
            display: none;
            border-top: 1px solid var(--border);
        }

        .client-section.is-open .client-body {
            display: block;
        }

        .client-identification {
            display: flex;
            align-items: center;
            gap: 12px;
        }

        .client-icon {
            width: 42px;
            height: 42px;
            border-radius: 13px;
            display: grid;
            place-items: center;
            background: var(--blue-soft);
            color: var(--blue);
        }

        .client-title {
            margin: 0;
            color: var(--blue-dark);
            font-size: 1.05rem;
            font-weight: 950;
        }

        .client-subtitle {
            color: var(--muted);
            font-size: .82rem;
            margin-top: 2px;
        }

        .client-summary {
            display: flex;
            gap: 8px;
            flex-wrap: wrap;
        }

        .summary-chip {
            border-radius: 999px;
            padding: 6px 10px;
            font-size: .74rem;
            font-weight: 850;
            background: #f4f7fb;
            border: 1px solid var(--border);
            color: #4b607c;
        }

        .priority-group {
            padding: 14px 16px 16px;
            border-bottom: 1px solid #edf1f6;
        }

            .priority-group:last-child {
                border-bottom: 0;
            }

        .priority-heading {
            display: flex;
            align-items: center;
            justify-content: space-between;
            gap: 12px;
            margin-bottom: 10px;
        }

        .priority-label {
            display: inline-flex;
            align-items: center;
            gap: 7px;
            padding: 6px 10px;
            border-radius: 999px;
            font-size: .77rem;
            font-weight: 900;
            border: 1px solid transparent;
        }

        .priority-urgent {
            background: #fff0ef;
            color: #b42318;
            border-color: #f3b4ae;
        }

        .priority-high {
            background: #fff5e8;
            color: #a45f00;
            border-color: #f1d09c;
        }

        .priority-medium {
            background: #fffbe8;
            color: #827000;
            border-color: #e8dd9e;
        }

        .priority-normal {
            background: #edf5ff;
            color: #0659bd;
            border-color: #bdd8f7;
        }

        .priority-low {
            background: #effaf5;
            color: #147a4b;
            border-color: #bee6d2;
        }

        .priority-count {
            color: var(--muted);
            font-size: .78rem;
            font-weight: 750;
        }

        .of-grid {
            display: grid;
            grid-template-columns: repeat(auto-fill, minmax(310px, 1fr));
            gap: 12px;
        }

        .of-card {
            background: #fff;
            border: 1px solid var(--border);
            border-radius: 17px;
            padding: 14px;
            transition: transform .18s ease, box-shadow .18s ease, border-color .18s ease;
        }

            .of-card:hover {
                transform: translateY(-2px);
                border-color: #b8cae1;
                box-shadow: 0 12px 24px rgba(30, 55, 90, .10);
            }

            .of-card.is-program {
                background: #fffdf8;
                border-color: #f0d9ac;
            }

        .card-top {
            display: flex;
            align-items: flex-start;
            justify-content: space-between;
            gap: 10px;
        }

        .origin-badge {
            display: inline-flex;
            align-items: center;
            gap: 6px;
            border-radius: 999px;
            padding: 5px 8px;
            font-size: .68rem;
            font-weight: 900;
        }

        .origin-of {
            color: #0758b5;
            background: #edf5ff;
            border: 1px solid #c3dcfb;
        }

        .origin-program {
            color: #9a5a00;
            background: #fff4df;
            border: 1px solid #f1d09c;
        }

        .folio {
            margin-top: 9px;
            font-size: 1rem;
            font-weight: 950;
            color: #15385f;
            overflow-wrap: anywhere;
        }

        .of-number {
            color: var(--muted);
            font-size: .78rem;
            margin-top: 2px;
        }

        .status-pill {
            max-width: 155px;
            display: inline-flex;
            align-items: center;
            gap: 5px;
            padding: 5px 8px;
            border-radius: 999px;
            font-size: .67rem;
            font-weight: 900;
            text-align: left;
        }

        .status-info {
            color: #0758b5;
            background: #edf5ff;
        }

        .status-danger {
            color: #a92920;
            background: #fff0ef;
        }

        .status-success {
            color: #147a4b;
            background: #edfaf3;
        }

        .status-purple {
            color: #6540b4;
            background: #f1edff;
        }

        .status-muted {
            color: #697386;
            background: #f1f3f5;
        }

        .date-banner {
            margin-top: 12px;
            border-radius: 12px;
            padding: 9px 10px;
            display: flex;
            align-items: center;
            justify-content: space-between;
            gap: 8px;
            font-size: .75rem;
            font-weight: 850;
        }

        .date-overdue {
            color: #a92920;
            background: #fff0ef;
            border: 1px solid #f3b4ae;
        }

        .date-today {
            color: #9c5700;
            background: #fff4df;
            border: 1px solid #f1d09c;
        }

        .date-soon {
            color: #765f00;
            background: #fffbe8;
            border: 1px solid #e8dd9e;
        }

        .date-ok {
            color: #147a4b;
            background: #effaf5;
            border: 1px solid #bee6d2;
        }

        .date-none {
            color: #677488;
            background: #f3f5f8;
            border: 1px solid #dce3ec;
        }

        .data-row {
            display: grid;
            grid-template-columns: repeat(2, minmax(0, 1fr));
            gap: 8px;
            margin-top: 10px;
        }

        .data-box {
            padding: 8px 9px;
            border-radius: 11px;
            background: #f8fafc;
            border: 1px solid #e8edf4;
            min-width: 0;
        }

        .data-label {
            color: var(--muted);
            font-size: .64rem;
            font-weight: 850;
            text-transform: uppercase;
            letter-spacing: .04em;
        }

        .data-value {
            color: #263b56;
            font-size: .82rem;
            font-weight: 850;
            margin-top: 2px;
            overflow-wrap: anywhere;
        }

        .card-footer-custom {
            margin-top: 11px;
            padding-top: 10px;
            border-top: 1px solid #e9eef5;
            display: flex;
            align-items: center;
            justify-content: space-between;
            gap: 9px;
        }

        .responsible {
            color: var(--muted);
            font-size: .73rem;
            overflow: hidden;
            text-overflow: ellipsis;
            white-space: nowrap;
        }

        .card-action {
            flex: 0 0 auto;
            min-height: 34px;
            padding: 6px 10px;
            font-size: .75rem;
            border-radius: 10px;
        }

        .empty-state, .no-results {
            background: #fff;
            border: 1px dashed #cbd7e6;
            border-radius: 20px;
            padding: 52px 20px;
            text-align: center;
            color: var(--muted);
        }

            .empty-state i {
                display: block;
                margin-bottom: 12px;
                font-size: 2.6rem;
                color: #aebdce;
            }

        .no-results {
            display: none;
            padding: 32px 18px;
        }

        @@media (max-width: 980px) {
            .hero-stats {
                grid-template-columns: repeat(2, minmax(125px, 1fr));
                width: 100%;
            }
        }

        @@media (max-width: 620px) {
            .page-shell {
                width: min(100% - 20px, 1680px);
                padding-top: 12px;
            }

            .hero {
                border-radius: 18px;
                padding: 19px;
            }

            .hero-stats {
                grid-template-columns: repeat(2, minmax(0, 1fr));
            }

            .stat {
                min-width: 0;
            }

            .toolbar-layout {
                align-items: stretch;
            }

            .toolbar-actions {
                width: 100%;
                display: grid !important;
                grid-template-columns: 1fr;
            }

            .of-grid {
                grid-template-columns: 1fr;
            }

            .client-header {
                align-items: flex-start;
            }
        }
    </style>
</head>
<body>
    <main class="page-shell">
        <section class="hero">
            <div class="hero-layout">
                <div>
                    <h1><i class="fa-solid fa-industry me-2"></i>Órdenes de Fabricación</h1>
                    <p>OF organizadas por cliente y prioridad, ordenadas por la fecha de entrega más próxima.</p>
                </div>

                <div class="hero-stats">
                    <div class="stat"><div class="stat-value">@ofGeneradas.ToString("N0")</div><div class="stat-label">OF generadas</div></div>
                    <div class="stat"><div class="stat-value">@pendientesGenerarOF.ToString("N0")</div><div class="stat-label">Pendientes de generar</div></div>
                    <div class="stat"><div class="stat-value">@totalPiezas.ToString("N0")</div><div class="stat-label">Piezas totales</div></div>
                    <div class="stat"><div class="stat-value">@vencidas.ToString("N0")</div><div class="stat-label">Entregas vencidas</div></div>
                </div>
            </div>
        </section>

        @if (!string.IsNullOrWhiteSpace(success))
        {
            <div class="alert alert-success alert-dismissible fade show rounded-4 fw-semibold" role="alert">
                <i class="fa-solid fa-circle-check me-2"></i>@success
                <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
            </div>
        }

        @if (!string.IsNullOrWhiteSpace(error))
        {
            <div class="alert alert-danger alert-dismissible fade show rounded-4 fw-semibold" role="alert">
                <i class="fa-solid fa-triangle-exclamation me-2"></i>@error
                <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
            </div>
        }

        <section class="toolbar">
            <div class="toolbar-layout">
                <div class="search-wrap">
                    <i class="fa-solid fa-magnifying-glass"></i>
                    <input id="txtBuscar" class="search-input" type="search" autocomplete="off"
                           placeholder="Buscar cliente, folio, OF, responsable, prioridad o estatus..." />
                </div>

                <div class="toolbar-actions d-flex gap-2 flex-wrap">
                    <a href="/Menu/Grupo/3" class="btn-erp btn-erp-light"><i class="fa-solid fa-arrow-left"></i>Volver</a>
                    <a asp-controller="Planeacion" asp-action="Crear" class="btn-erp btn-erp-primary"><i class="fa-solid fa-plus"></i>Nueva OF manual</a>
                </div>
            </div>
        </section>

        @if (!lista.Any())
        {
            <section class="empty-state">
                <i class="fa-regular fa-folder-open"></i>
                <h5 class="fw-bold">No hay órdenes de fabricación</h5>
                <p class="mb-3">Cuando exista una OF o un programa de máquina pendiente, aparecerá en esta bandeja.</p>
                <a asp-controller="PlaneacionPrograma" asp-action="Index" class="btn-erp btn-erp-primary">
                    <i class="fa-solid fa-list-check"></i>Ir al programa de planeación
                </a>
            </section>
        }
        else
        {
            <div id="contenedorOF">
                @foreach (var cliente in clientes)
                {
                    var ordenesCliente = cliente
                    .OrderBy(x => OrdenPrioridad(x.Prioridad))
                    .ThenBy(x => x.FechaRequerida ?? DateTime.MaxValue)
                    .ThenBy(x => x.FolioSolicitud)
                    .ToList();

                    var piezasCliente = ordenesCliente.Sum(x => x.TotalPiezas);
                    var pendientesCliente = ordenesCliente.Count(x => x.SolicitudProduccionID < 0);

                    var clienteDomId = $"cliente-{Math.Abs(cliente.Key.GetHashCode())}";

                    <section class="client-section" data-client-section>
                        <button type="button" class="client-header" data-client-toggle aria-expanded="false" aria-controls="@clienteDomId">
                            <div class="client-header-main">
                                <div class="client-identification">
                                    <div class="client-icon"><i class="fa-solid fa-building"></i></div>
                                    <div>
                                        <h2 class="client-title">@cliente.Key</h2>
                                        <div class="client-subtitle">Haz clic para consultar prioridades y órdenes</div>
                                    </div>
                                </div>

                                <div class="client-summary">
                                    <span class="summary-chip"><i class="fa-solid fa-file-lines me-1"></i>@ordenesCliente.Count.ToString("N0") registro(s)</span>
                                    <span class="summary-chip"><i class="fa-solid fa-cubes me-1"></i>@piezasCliente.ToString("N0") piezas</span>
                                    @if (pendientesCliente > 0)
                                    {
                                        <span class="summary-chip"><i class="fa-solid fa-gears me-1"></i>@pendientesCliente pendiente(s)</span>
                                    }
                                </div>
                            </div>
                            <span class="client-toggle" aria-hidden="true"><i class="fa-solid fa-chevron-down"></i></span>
                        </button>

                        <div class="client-body" id="@clienteDomId" data-client-body>
                            @foreach (var prioridad in ordenesCliente
                                                .GroupBy(x => PrioridadNormalizada(x.Prioridad))
                                                .OrderBy(x => OrdenPrioridad(x.Key)))
                            {
                                <div class="priority-group" data-priority-group>
                                    <div class="priority-heading">
                                        <span class="priority-label @ClasePrioridad(prioridad.Key)">
                                            <i class="fa-solid @IconoPrioridad(prioridad.Key)"></i>@prioridad.Key
                                        </span>
                                        <span class="priority-count">@prioridad.Count().ToString("N0") orden(es)</span>
                                    </div>

                                    <div class="of-grid">
                                        @foreach (var item in prioridad
                                                                    .OrderBy(x => x.FechaRequerida ?? DateTime.MaxValue)
                                                                    .ThenBy(x => x.FolioSolicitud))
                                        {
                                            var esPendientePrograma = item.SolicitudProduccionID < 0;
                                            var programaProduccionId = Math.Abs(item.SolicitudProduccionID);
                                            var textoBusqueda = string.Join(" ", new[]
                                            {
                                                        cliente.Key,
                                                        item.FolioSolicitud,
                                                        item.NumeroOFRecibida,
                                                        item.Prioridad,
                                                        item.EstatusNombre,
                                                        item.ResponsablePlaneacionNombre,
                                                        Fecha(item.FechaRequerida)
                                                        }).ToLowerInvariant();

                                            <article class="of-card @(esPendientePrograma ? "is-program" : "")"
                                                     data-of-card data-search="@textoBusqueda">
                                                <div class="card-top">
                                                    <div>
                                                        @if (esPendientePrograma)
                                                        {
                                                            <span class="origin-badge origin-program"><i class="fa-solid fa-gears"></i>Programa</span>
                                                        }
                                                        else
                                                        {
                                                            <span class="origin-badge origin-of"><i class="fa-solid fa-file-lines"></i>OF</span>
                                                        }

                                                        <div class="folio">@Texto(item.FolioSolicitud)</div>
                                                        <div class="of-number">
                                                            @if (esPendientePrograma)
                                                            {
                                                                <span>Programa #@programaProduccionId</span>
                                                            }
                                                            else
                                                            {
                                                                <span>@Texto(item.NumeroOFRecibida)</span>
                                                            }
                                                        </div>
                                                    </div>

                                                    <span class="status-pill @ClaseEstatus(item.EstatusID)">
                                                        <i class="fa-solid fa-circle"></i>@Texto(item.EstatusNombre)
                                                    </span>
                                                </div>

                                                <div class="date-banner @ClaseFecha(item.FechaRequerida)">
                                                    <span><i class="fa-regular fa-calendar me-1"></i>@TextoFechaEntrega(item.FechaRequerida)</span>
                                                    <strong>@Fecha(item.FechaRequerida)</strong>
                                                </div>

                                                <div class="data-row">
                                                    <div class="data-box"><div class="data-label">Piezas</div><div class="data-value">@item.TotalPiezas.ToString("N0")</div></div>
                                                    <div class="data-box"><div class="data-label">Renglones</div><div class="data-value">@item.TotalRenglones.ToString("N0")</div></div>
                                                    <div class="data-box"><div class="data-label">Inicio planeado</div><div class="data-value">@FechaHora(item.FechaInicioPlaneada)</div></div>
                                                    <div class="data-box"><div class="data-label">Fin planeado</div><div class="data-value">@FechaHora(item.FechaFinPlaneada)</div></div>
                                                </div>

                                                <footer class="card-footer-custom">
                                                    <div class="responsible" title="@Texto(item.ResponsablePlaneacionNombre)">
                                                        <i class="fa-regular fa-user me-1"></i>@Texto(item.ResponsablePlaneacionNombre)
                                                    </div>

                                                    @if (esPendientePrograma)
                                                    {
                                                        <form asp-controller="PlaneacionPrograma" asp-action="GenerarOF" method="post" class="m-0">
                                                            @Html.AntiForgeryToken()
                                                            <input type="hidden" name="programaProduccionId" value="@programaProduccionId" />
                                                            <button type="submit" class="btn-erp btn-erp-primary card-action">
                                                                <i class="fa-solid fa-file-circle-plus"></i>Generar OF
                                                            </button>
                                                        </form>
                                                    }
                                                    else
                                                    {
                                                        <a asp-controller="Planeacion" asp-action="Detalle" asp-route-id="@item.SolicitudProduccionID"
                                                           class="btn-erp btn-erp-light card-action">
                                                            <i class="fa-regular fa-eye"></i>Ver
                                                        </a>
                                                    }
                                                </footer>
                                            </article>
                                        }
                                    </div>
                                </div>
                            }
                        </div>
                    </section>
                }
            </div>

            <section id="sinResultados" class="no-results">
                <i class="fa-solid fa-magnifying-glass mb-2 fs-3"></i>
                <h5 class="fw-bold">No encontramos coincidencias</h5>
                <div>Prueba con otro cliente, folio, responsable, prioridad o estatus.</div>
            </section>
        }
    </main>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
    <script>
        (() => {
            const input = document.getElementById('txtBuscar');
            const cards = [...document.querySelectorAll('[data-of-card]')];
            const clientSections = [...document.querySelectorAll('[data-client-section]')];
            const noResults = document.getElementById('sinResultados');
            const clientToggles = [...document.querySelectorAll('[data-client-toggle]')];

            const setClientOpen = (section, open) => {
                const toggle = section.querySelector('[data-client-toggle]');
                section.classList.toggle('is-open', open);
                if (toggle) toggle.setAttribute('aria-expanded', open ? 'true' : 'false');
            };

            clientToggles.forEach(toggle => {
                toggle.addEventListener('click', () => {
                    const section = toggle.closest('[data-client-section]');
                    if (!section) return;
                    setClientOpen(section, !section.classList.contains('is-open'));
                });
            });

            if (!input || cards.length === 0) return;

            const normalize = value => (value || '')
                .toLowerCase()
                .normalize('NFD')
                .replace(/[\u0300-\u036f]/g, '')
                .trim();

            const applyFilter = () => {
                const query = normalize(input.value);
                let visibleCards = 0;

                cards.forEach(card => {
                    const searchableText = normalize(`${card.dataset.search || ''} ${card.innerText || ''}`);
                    const visible = searchableText.includes(query);
                    card.style.display = visible ? '' : 'none';
                    if (visible) visibleCards++;
                });

                document.querySelectorAll('[data-priority-group]').forEach(group => {
                    const hasVisibleCard = [...group.querySelectorAll('[data-of-card]')]
                        .some(card => card.style.display !== 'none');
                    group.style.display = hasVisibleCard ? '' : 'none';
                });

                clientSections.forEach(section => {
                    const hasVisibleGroup = [...section.querySelectorAll('[data-priority-group]')]
                        .some(group => group.style.display !== 'none');
                    section.style.display = hasVisibleGroup ? '' : 'none';

                    if (query && hasVisibleGroup) {
                        setClientOpen(section, true);
                    } else if (!query) {
                        setClientOpen(section, false);
                    }
                });

                if (noResults) noResults.style.display = visibleCards === 0 ? 'block' : 'none';
            };

            input.addEventListener('input', applyFilter);
        })();
    </script>
</body>
</html>
