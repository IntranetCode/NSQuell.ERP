@model List<ERP.NSQuell.Models.PlaneacionOFIndexVm>
@using System.Linq

@functions {
    public static string Texto(string? valor) => string.IsNullOrWhiteSpace(valor) ? "Sin definir" : valor.Trim();
    public static string Fecha(DateTime? valor) => valor.HasValue ? valor.Value.ToString("dd/MM/yyyy") : "Sin fecha";
    public static string FechaHora(DateTime? valor) => valor.HasValue ? valor.Value.ToString("dd/MM/yyyy HH:mm") : "Sin definir";

    public static string PrioridadNormalizada(string? prioridad)
    {
        return string.IsNullOrWhiteSpace(prioridad) ? "NORMAL" : prioridad.Trim().ToUpperInvariant();
    }

    public static int OrdenPrioridad(string? prioridad)
    {
        return PrioridadNormalizada(prioridad) switch
        {
            "URGENTE" => 1,
            "ALTA" => 2,
            "MEDIA" => 3,
            "NORMAL" => 4,
            "BAJA" => 5,
            _ => 6
        };
    }

    public static string ClasePrioridad(string? prioridad)
    {
        return PrioridadNormalizada(prioridad) switch
        {
            "URGENTE" => "priority-urgent",
            "ALTA" => "priority-high",
            "MEDIA" => "priority-medium",
            "BAJA" => "priority-low",
            _ => "priority-normal"
        };
    }

    public static string IconoPrioridad(string? prioridad)
    {
        return PrioridadNormalizada(prioridad) switch
        {
            "URGENTE" => "fa-bolt",
            "ALTA" => "fa-arrow-up",
            "MEDIA" => "fa-minus",
            "BAJA" => "fa-arrow-down",
            _ => "fa-circle"
        };
    }

    public static string ClaseFecha(DateTime? fecha)
    {
        if (!fecha.HasValue) return "date-none";

        var dias = (fecha.Value.Date - DateTime.Today).Days;
        if (dias < 0) return "date-overdue";
        if (dias == 0) return "date-today";
        if (dias <= 3) return "date-soon";
        return "date-ok";
    }

    public static string TextoFechaEntrega(DateTime? fecha)
    {
        if (!fecha.HasValue) return "Sin fecha de entrega";

        var dias = (fecha.Value.Date - DateTime.Today).Days;
        if (dias < 0) return $"Vencida hace {Math.Abs(dias)} día(s)";
        if (dias == 0) return "Entrega hoy";
        if (dias == 1) return "Entrega mañana";
        return $"Entrega en {dias} día(s)";
    }

    public static string ClaseEstatus(int estatusId)
    {
        return estatusId switch
        {
            3 or 4 or 5 => "status-danger",
            6 or 7 or 8 or 10 => "status-success",
            9 => "status-purple",
            11 => "status-muted",
            _ => "status-info"
        };
    }

    public static string TipoOFNormalizado(string? tipoOF)
    {
        if (string.IsNullOrWhiteSpace(tipoOF))
            return "RELEASE";

        var valor = tipoOF.Trim().ToUpperInvariant()
            .Replace("Á", "A")
            .Replace("É", "E")
            .Replace("Í", "I")
            .Replace("Ó", "O")
            .Replace("Ú", "U");

        return valor switch
        {
            "RELEASE" => "RELEASE",
            "ENSAMBLE" => "ENSAMBLE",
            "PRUEBA" => "PRUEBA",
            "MP EXTRA" => "MP EXTRA",
            "MPEXTRA" => "MP EXTRA",
            "MP_EXTRA" => "MP EXTRA",
            _ => "RELEASE"
        };
    }

    public static string TextoTipoOF(string? tipoOF)
    {
        return TipoOFNormalizado(tipoOF) switch
        {
            "ENSAMBLE" => "Ensamble",
            "PRUEBA" => "Prueba",
            "MP EXTRA" => "MP extra",
            _ => "Release"
        };
    }

    public static string ClaseTipoOF(string? tipoOF)
    {
        return TipoOFNormalizado(tipoOF) switch
        {
            "ENSAMBLE" => "type-ensamble",
            "PRUEBA" => "type-prueba",
            "MP EXTRA" => "type-mp-extra",
            _ => "type-release"
        };
    }

    public static string IconoTipoOF(string? tipoOF)
    {
        return TipoOFNormalizado(tipoOF) switch
        {
            "ENSAMBLE" => "fa-layer-group",
            "PRUEBA" => "fa-flask-vial",
            "MP EXTRA" => "fa-boxes-stacked",
            _ => "fa-industry"
        };
    }
}

@{
    Layout = "~/Views/Shared/_Layout.cshtml";
    ViewData["Title"] = "Bandeja de OF | ERP QUELL";

    var success = TempData["Success"] as string;
    var error = TempData["Error"] as string;
    // NSQ_PLANEACION_EXTENSION_OF_V2
    // La bandeja muestra programas sin OF + OF generadas que aun no han sido despachadas completamente.
    var lista = (Model ?? new List<ERP.NSQuell.Models.PlaneacionOFIndexVm>())
        .ToList();

    var pendientesGenerarOF = lista.Count(x => x.SolicitudProduccionID < 0);
    var ofGeneradas = lista.Count(x => x.SolicitudProduccionID > 0);
    var totalPiezas = lista.Sum(x => x.TotalPiezas);
    var vencidas = lista.Count(x =>
        x.FechaRequerida.HasValue &&
        x.FechaRequerida.Value.Date < DateTime.Today);

    var releaseCount = lista.Count(x => TipoOFNormalizado(x.TipoOF) == "RELEASE");
    var ensambleCount = lista.Count(x => TipoOFNormalizado(x.TipoOF) == "ENSAMBLE");
    var pruebaCount = lista.Count(x => TipoOFNormalizado(x.TipoOF) == "PRUEBA");
    var mpExtraCount = lista.Count(x => TipoOFNormalizado(x.TipoOF) == "MP EXTRA");

    var maquinas = lista
        .GroupBy(x => new
        {
            Codigo = string.IsNullOrWhiteSpace(x.MaquinaCodigo)
                ? "SIN MAQUINA"
                : x.MaquinaCodigo.Trim(),
            Nombre = string.IsNullOrWhiteSpace(x.MaquinaNombre)
                ? "Sin asignacion de maquina"
                : x.MaquinaNombre.Trim()
        })
        .OrderBy(x => x.Key.Codigo == "SIN MAQUINA" ? 1 : 0)
        .ThenBy(x => x.Key.Codigo)
        .ThenBy(x => x.Key.Nombre)
        .ToList();
}


    <!-- NSQ_PLANEACION_EXTENSION_OF_V2 -->
    <div class="modal fade" id="modalExtensionOF" tabindex="-1" aria-hidden="true">
        <div class="modal-dialog modal-lg modal-dialog-centered modal-dialog-scrollable">
            <div class="modal-content border-0 rounded-4 shadow-lg">
                <div class="modal-header">
                    <div>
                        <h5 class="modal-title fw-bold">Extension de Orden de Fabricacion</h5>
                        <div class="text-muted small">Actualiza la misma OF y propaga el cambio a Planeacion, Produccion, Calidad y Almacen.</div>
                    </div>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Cerrar"></button>
                </div>
                <div class="modal-body">
                    <form id="formExtensionOF">
                        @Html.AntiForgeryToken()
                        <input type="hidden" id="extSolicitudProduccionID" name="SolicitudProduccionID" />

                        <div id="extError" class="alert alert-danger d-none"></div>

                        <div class="row g-3 mb-3">
                            <div class="col-md-3"><label class="form-label fw-semibold">OF</label><div id="extOF" class="form-control bg-light">-</div></div>
                            <div class="col-md-3"><label class="form-label fw-semibold">Maquina</label><div id="extMaquina" class="form-control bg-light">-</div></div>
                            <div class="col-md-3"><label class="form-label fw-semibold">Cliente</label><div id="extCliente" class="form-control bg-light">-</div></div>
                            <div class="col-md-3"><label class="form-label fw-semibold">Parte</label><div id="extParte" class="form-control bg-light">-</div></div>
                        </div>

                        <div class="row g-3 mb-3">
                            <div class="col-md-4"><label class="form-label fw-semibold">Cantidad actual</label><div id="extCantidadActual" class="form-control bg-light">-</div></div>
                            <div class="col-md-4"><label class="form-label fw-semibold">Horas actuales</label><div id="extHorasActuales" class="form-control bg-light">-</div></div>
                            <div class="col-md-4"><label class="form-label fw-semibold">Fin programado</label><div id="extFinActual" class="form-control bg-light">-</div></div>
                        </div>

                        <div class="mb-3">
                            <label class="form-label fw-semibold" for="extMotivo">Motivo de la extension</label>
                            <select class="form-select" id="extMotivo" name="Motivo" required>
                                <option value="">Selecciona...</option>
                                <option value="CONTINUIDAD_MAQUINA">1. No detener maquina, continuar con la produccion</option>
                                <option value="ADELANTO_RELEASE">2. Adelanto de piezas para el cliente / la OF tiene menos piezas de las requeridas</option>
                            </select>
                        </div>

                        <div id="extBloqueComun" class="row g-3 d-none">
                            <div class="col-md-6">
                                <label class="form-label fw-semibold" for="extCantidadAdicional">Piezas adicionales</label>
                                <input type="number" min="1" step="1" class="form-control" id="extCantidadAdicional" name="CantidadAdicional" />
                            </div>
                            <div class="col-md-6" id="extHorasWrap">
                                <label class="form-label fw-semibold" for="extHorasAdicionales">Horas adicionales</label>
                                <input type="number" min="0.0001" step="0.0001" class="form-control" id="extHorasAdicionales" name="HorasAdicionales" />
                                <div class="form-text">Para continuidad de maquina se capturan manualmente.</div>
                            </div>
                        </div>

                        <div id="extReleaseWrap" class="mt-3 d-none">
                            <label class="form-label fw-semibold" for="extReleaseOrigen">Fila/entrega Release de origen</label>
                            <select class="form-select" id="extReleaseOrigen" name="ReleaseDetalleOrigenID"></select>
                            <div class="form-text">Solo aparecen entregas compatibles del mismo Release/renglon con cantidad libre.</div>
                            <div id="extReleaseInfo" class="alert alert-info mt-2 mb-0 d-none"></div>
                        </div>

                        <div id="extResumen" class="alert alert-secondary mt-3 d-none"></div>
                    </form>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn-erp btn-erp-light" data-bs-dismiss="modal">Cancelar</button>
                    <button type="button" id="btnAplicarExtensionOF" class="btn-erp btn-erp-primary">
                        <i class="fa-solid fa-check"></i> Aplicar extension
                    </button>
                </div>
            </div>
        </div>
    </div>

@section Scripts {
    <script>
        (() => {
            const input = document.getElementById('txtBuscar');
            const selectMaquina = document.getElementById('selectMaquina');
            const selectTipoOF = document.getElementById('selectTipoOF');
            const cards = [...document.querySelectorAll('[data-of-card]')];
            const machineSections = [...document.querySelectorAll('[data-machine-section]')];
            const noResults = document.getElementById('sinResultados');
            const machineToggles = [...document.querySelectorAll('[data-machine-toggle]')];

            const modalElement = document.getElementById('modalGenerarOF');
            const modalGenerarOF = modalElement
                ? bootstrap.Modal.getOrCreateInstance(modalElement)
                : null;

            const confirmButton = document.getElementById('btnConfirmarGenerarOF');
            let pendingForm = null;

            const setMachineOpen = (section, open) => {
                const toggle = section.querySelector('[data-machine-toggle]');
                section.classList.toggle('is-open', open);
                if (toggle) {
                    toggle.setAttribute('aria-expanded', open ? 'true' : 'false');
                }
            };

            machineToggles.forEach(toggle => {
                toggle.addEventListener('click', () => {
                    const section = toggle.closest('[data-machine-section]');
                    if (!section) return;
                    setMachineOpen(section, !section.classList.contains('is-open'));
                });
            });

            const normalize = value => (value || '')
                .toString()
                .toLowerCase()
                .normalize('NFD')
                .replace(/[\u0300-\u036f]/g, '')
                .trim();

            const applyFilter = () => {
                const query = normalize(input?.value);
                const selectedMachine = selectMaquina?.value || '';
                const selectedTipoOF = selectTipoOF?.value || '';
                let visibleCards = 0;

                machineSections.forEach(section => {
                    const machineMatches = !selectedMachine ||
                        section.dataset.machine === selectedMachine;

                    const sectionCards = [...section.querySelectorAll('[data-of-card]')];

                    sectionCards.forEach(card => {
                        const searchableText = normalize(
                            `${card.dataset.search || ''} ${card.innerText || ''}`);

                        const typeMatches = !selectedTipoOF ||
                            card.dataset.type === selectedTipoOF;

                        const visible = machineMatches &&
                            typeMatches &&
                            (!query || searchableText.includes(query));

                        card.style.display = visible ? '' : 'none';
                        if (visible) visibleCards++;
                    });

                    section.querySelectorAll('[data-priority-group]').forEach(group => {
                        const hasVisibleCard = [...group.querySelectorAll('[data-of-card]')]
                            .some(card => card.style.display !== 'none');
                        group.style.display = hasVisibleCard ? '' : 'none';
                    });

                    const hasVisibleGroup = [...section.querySelectorAll('[data-priority-group]')]
                        .some(group => group.style.display !== 'none');

                    section.style.display = hasVisibleGroup ? '' : 'none';

                    if ((query || selectedMachine || selectedTipoOF) && hasVisibleGroup) {
                        setMachineOpen(section, true);
                    } else if (!query && !selectedMachine && !selectedTipoOF) {
                        setMachineOpen(section, true);
                    }
                });

                if (noResults) {
                    noResults.style.display = visibleCards === 0 ? 'block' : 'none';
                }
            };

            input?.addEventListener('input', applyFilter);
            selectMaquina?.addEventListener('change', applyFilter);
            selectTipoOF?.addEventListener('change', applyFilter);

            document.querySelectorAll('[data-generar-of]').forEach(button => {
                button.addEventListener('click', () => {
                    const formId = button.dataset.formId;
                    pendingForm = formId ? document.getElementById(formId) : null;

                    document.getElementById('confirmPrograma').textContent =
                        button.dataset.programa || '-';
                    document.getElementById('confirmFolio').textContent =
                        button.dataset.folio || '-';
                    document.getElementById('confirmCliente').textContent =
                        button.dataset.cliente || '-';
                    document.getElementById('confirmMaquina').textContent =
                        button.dataset.maquina || '-';
                    document.getElementById('confirmTipoOF').textContent =
                        button.dataset.tipoOf || '-';
                    document.getElementById('confirmPiezas').textContent =
                        button.dataset.piezas || '-';
                    document.getElementById('confirmFecha').textContent =
                        button.dataset.fecha || '-';

                    if (confirmButton) {
                        confirmButton.disabled = false;
                        confirmButton.innerHTML =
                            '<i class="fa-solid fa-check"></i> Sí, generar OF';
                    }

                    modalGenerarOF?.show();
                });
            });

            confirmButton?.addEventListener('click', () => {
                if (!pendingForm) return;

                confirmButton.disabled = true;
                confirmButton.innerHTML =
                    '<span class="spinner-border spinner-border-sm" aria-hidden="true"></span> Generando...';

                pendingForm.submit();
            });


            // NSQ_PLANEACION_EXTENSION_OF_V2
            const extModalElement = document.getElementById('modalExtensionOF');
            const extModal = extModalElement ? bootstrap.Modal.getOrCreateInstance(extModalElement) : null;
            const extForm = document.getElementById('formExtensionOF');
            const extMotivo = document.getElementById('extMotivo');
            const extCantidad = document.getElementById('extCantidadAdicional');
            const extHoras = document.getElementById('extHorasAdicionales');
            const extHorasWrap = document.getElementById('extHorasWrap');
            const extReleaseWrap = document.getElementById('extReleaseWrap');
            const extReleaseOrigen = document.getElementById('extReleaseOrigen');
            const extReleaseInfo = document.getElementById('extReleaseInfo');
            const extBloqueComun = document.getElementById('extBloqueComun');
            const extResumen = document.getElementById('extResumen');
            const extError = document.getElementById('extError');
            const extAplicar = document.getElementById('btnAplicarExtensionOF');
            let extData = null;

            const extFmtNumber = value => Number(value || 0).toLocaleString('es-MX', { maximumFractionDigits: 4 });
            const extFmtDate = value => value ? new Date(value).toLocaleString('es-MX') : '-';
            const extShowError = message => {
                if (!extError) return;
                extError.textContent = message || 'Ocurrio un error.';
                extError.classList.remove('d-none');
            };
            const extClearError = () => extError?.classList.add('d-none');

            const extOrigenId = o => o.releaseDetalleID ?? o.ReleaseDetalleID ?? '';
            const extOrigenDisponible = o => o.cantidadTransferible ?? o.CantidadTransferible ?? o.disponibleLibre ?? o.DisponibleLibre ?? 0;
            const extOrigenFecha = o => o.fechaRequerida ?? o.FechaRequerida ?? null;
            const extOrigenParte = o => o.numeroParte ?? o.NumeroParte ?? o.referenciaSAP ?? o.ReferenciaSAP ?? '';

            const extActualizarResumen = () => {
                if (!extData || !extResumen) return;
                const piezas = Number(extCantidad?.value || 0);
                const motivo = extMotivo?.value || '';
                if (piezas <= 0 || !motivo) {
                    extResumen.classList.add('d-none');
                    return;
                }

                let horasExtra = Number(extHoras?.value || 0);
                if (motivo === 'ADELANTO_RELEASE') {
                    const objetivo = Number(extData.objetivoHora || 0);
                    horasExtra = objetivo > 0 ? piezas / objetivo : 0;
                }

                const nueva = Number(extData.cantidadActual || 0) + piezas;
                const horasNuevas = Number(extData.horasActuales || 0) + horasExtra;
                extResumen.innerHTML = `<strong>Resultado:</strong> ${extFmtNumber(extData.cantidadActual)} + ${extFmtNumber(piezas)} = <strong>${extFmtNumber(nueva)} piezas</strong>. Horas adicionales: <strong>${extFmtNumber(horasExtra)}</strong>. Horas totales estimadas: <strong>${extFmtNumber(horasNuevas)}</strong>.`;
                extResumen.classList.remove('d-none');
            };

            const extConfigurarMotivo = () => {
                const motivo = extMotivo?.value || '';
                extBloqueComun?.classList.toggle('d-none', !motivo);
                extClearError();

                const esRelease = motivo === 'ADELANTO_RELEASE';
                extReleaseWrap?.classList.toggle('d-none', !esRelease);
                extHorasWrap?.classList.toggle('d-none', esRelease);

                if (extHoras) {
                    extHoras.required = motivo === 'CONTINUIDAD_MAQUINA';
                    if (esRelease) extHoras.value = '';
                }
                if (extReleaseOrigen) extReleaseOrigen.required = esRelease;

                if (esRelease && extData && !extData.tieneRelease) {
                    extShowError('Esta OF no tiene una fila Release relacionada. No puede usar el motivo 2.');
                }

                extActualizarResumen();
            };

            extMotivo?.addEventListener('change', extConfigurarMotivo);
            extCantidad?.addEventListener('input', extActualizarResumen);
            extHoras?.addEventListener('input', extActualizarResumen);
            extReleaseOrigen?.addEventListener('change', () => {
                const selected = (extData?.origenes || []).find(o => String(extOrigenId(o)) === String(extReleaseOrigen.value));
                if (selected && extReleaseInfo) {
                    extReleaseInfo.textContent = `Disponible para transferir: ${extFmtNumber(extOrigenDisponible(selected))} piezas.`;
                    extReleaseInfo.classList.remove('d-none');
                    if (extCantidad) extCantidad.max = String(extOrigenDisponible(selected));
                } else {
                    extReleaseInfo?.classList.add('d-none');
                    if (extCantidad) extCantidad.removeAttribute('max');
                }
                extActualizarResumen();
            });

            document.querySelectorAll('[data-extension-of]').forEach(button => {
                button.addEventListener('click', async () => {
                    extClearError();
                    extData = null;
                    extForm?.reset();
                    extBloqueComun?.classList.add('d-none');
                    extReleaseWrap?.classList.add('d-none');
                    extResumen?.classList.add('d-none');
                    extReleaseInfo?.classList.add('d-none');

                    if (extAplicar) {
                        extAplicar.disabled = true;
                        extAplicar.innerHTML = '<span class="spinner-border spinner-border-sm"></span> Cargando...';
                    }

                    extModal?.show();

                    try {
                        const solicitudId = button.dataset.solicitudId;
                        const response = await fetch(`/PlaneacionPrograma/ObtenerExtensionOF?solicitudProduccionId=${encodeURIComponent(solicitudId)}`, {
                            headers: { 'X-Requested-With': 'XMLHttpRequest' }
                        });
                        const data = await response.json();
                        if (!response.ok || !data.ok) throw new Error(data.mensaje || 'No fue posible cargar la OF.');
                        extData = data;

                        document.getElementById('extSolicitudProduccionID').value = data.solicitudProduccionId;
                        document.getElementById('extOF').textContent = data.folio || button.dataset.folio || '-';
                        document.getElementById('extMaquina').textContent = data.maquina || button.dataset.maquina || '-';
                        document.getElementById('extCliente').textContent = data.cliente || button.dataset.cliente || '-';
                        document.getElementById('extParte').textContent = data.parte || '-';
                        document.getElementById('extCantidadActual').textContent = `${extFmtNumber(data.cantidadActual)} pzas`;
                        document.getElementById('extHorasActuales').textContent = `${extFmtNumber(data.horasActuales)} h`;
                        document.getElementById('extFinActual').textContent = extFmtDate(data.fechaFinProgramada);

                        if (extReleaseOrigen) {
                            extReleaseOrigen.innerHTML = '<option value="">Selecciona una entrega...</option>';
                            (data.origenes || []).forEach(o => {
                                const option = document.createElement('option');
                                option.value = extOrigenId(o);
                                const parte = extOrigenParte(o);
                                const fecha = extOrigenFecha(o);
                                const disponible = extOrigenDisponible(o);
                                option.textContent = `Fila ${extOrigenId(o)}${parte ? ' | ' + parte : ''}${fecha ? ' | ' + extFmtDate(fecha) : ''} | Disponible: ${extFmtNumber(disponible)}`;
                                extReleaseOrigen.appendChild(option);
                            });
                        }

                        if (extAplicar) {
                            extAplicar.disabled = false;
                            extAplicar.innerHTML = '<i class="fa-solid fa-check"></i> Aplicar extension';
                        }
                    } catch (error) {
                        extShowError(error.message || String(error));
                        if (extAplicar) {
                            extAplicar.disabled = true;
                            extAplicar.innerHTML = '<i class="fa-solid fa-ban"></i> Extension bloqueada';
                        }
                    }
                });
            });

            extAplicar?.addEventListener('click', async () => {
                extClearError();
                if (!extForm || !extData) return;
                if (!extForm.reportValidity()) return;

                const motivo = extMotivo?.value || '';
                if (!motivo) {
                    extShowError('Selecciona el motivo de la extension.');
                    return;
                }

                const piezas = Number(extCantidad?.value || 0);
                if (!Number.isInteger(piezas) || piezas <= 0) {
                    extShowError('Captura una cantidad entera de piezas mayor a cero.');
                    return;
                }

                if (motivo === 'ADELANTO_RELEASE') {
                    const selected = (extData.origenes || []).find(o => String(extOrigenId(o)) === String(extReleaseOrigen?.value || ''));
                    if (!selected) {
                        extShowError('Selecciona una fila Release de origen.');
                        return;
                    }
                    if (piezas > Number(extOrigenDisponible(selected) || 0)) {
                        extShowError('La cantidad solicitada supera el pendiente libre de la fila Release seleccionada.');
                        return;
                    }
                }

                extAplicar.disabled = true;
                extAplicar.innerHTML = '<span class="spinner-border spinner-border-sm"></span> Aplicando...';

                try {
                    const formData = new FormData(extForm);
                    const response = await fetch('/PlaneacionPrograma/AplicarExtensionOF', {
                        method: 'POST',
                        body: formData,
                        headers: { 'X-Requested-With': 'XMLHttpRequest' }
                    });
                    const result = await response.json();
                    if (!response.ok || !result.ok) throw new Error(result.mensaje || 'No fue posible aplicar la extension.');

                    extModal?.hide();
                    window.location.reload();
                } catch (error) {
                    extShowError(error.message || String(error));
                    extAplicar.disabled = false;
                    extAplicar.innerHTML = '<i class="fa-solid fa-check"></i> Aplicar extension';
                }
            });
            modalElement?.addEventListener('hidden.bs.modal', () => {
                pendingForm = null;

                if (confirmButton) {
                    confirmButton.disabled = false;
                    confirmButton.innerHTML =
                        '<i class="fa-solid fa-check"></i> Sí, generar OF';
                }
            });
        })();
    </script>
}


@section Styles {
    <link rel="stylesheet" href="~/css/Planeacion/index.css" asp-append-version="true" />
}


    @* PLANEACION_NAVBAR_INJECT_V1_0 *@
    @await Html.PartialAsync("_PlaneacionNavbar")
    <main class="page-shell">
        <section class="hero">
            <div class="hero-layout">
                <div>
                    <h1><i class="fa-solid fa-industry me-2"></i>Ordenes de fabricacion activas</h1>
                    <p>Programas pendientes de generar y OF en proceso. Una OF pasa al historial solo al completar su despacho al cliente.</p>
                </div>

                <div class="hero-stats">

                    <div class="stat"><div class="stat-value">@pendientesGenerarOF.ToString("N0")</div><div class="stat-label">Pendientes de generar</div></div>
                    <div class="stat"><div class="stat-value">@ofGeneradas.ToString("N0")</div><div class="stat-label">OF activas</div></div>
                    <div class="stat"><div class="stat-value">@vencidas.ToString("N0")</div><div class="stat-label">Entregas vencidas</div></div>
                </div>
            </div>
        </section>

        @if (!string.IsNullOrWhiteSpace(success))
        {
            <div class="alert alert-success alert-dismissible fade show rounded-4 fw-semibold" role="alert">
                <i class="fa-solid fa-circle-check me-2"></i>@success
                <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
            </div>
        }

        @if (!string.IsNullOrWhiteSpace(error))
        {
            <div class="alert alert-danger alert-dismissible fade show rounded-4 fw-semibold" role="alert">
                <i class="fa-solid fa-triangle-exclamation me-2"></i>@error
                <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
            </div>
        }

        <section class="toolbar">
            <div class="toolbar-layout">
                <div class="search-wrap">
                    <i class="fa-solid fa-magnifying-glass"></i>
                    <input id="txtBuscar"
                           class="search-input"
                           type="search"
                           autocomplete="off"
                           placeholder="Buscar máquina, cliente, folio, OF, tipo de OF, responsable, prioridad o estatus..." />
                </div>

                <div class="machine-filter-wrap">
                    <label class="machine-filter-label" for="selectMaquina">Filtrar por máquina</label>
                    <select id="selectMaquina" class="machine-select">
                        <option value="">Todas las máquinas</option>
                        @foreach (var maquina in maquinas)
                        {
                            var etiquetaMaquina = string.IsNullOrWhiteSpace(maquina.Key.Nombre) ||
                            string.Equals(maquina.Key.Codigo, maquina.Key.Nombre, StringComparison.OrdinalIgnoreCase)
                            ? maquina.Key.Codigo
                            : $"{maquina.Key.Codigo} | {maquina.Key.Nombre}";

                            <option value="@maquina.Key.Codigo">@etiquetaMaquina</option>
                        }
                    </select>
                </div>

                <div class="type-filter-wrap">
                    <label class="machine-filter-label" for="selectTipoOF">Filtrar por tipo de OF</label>
                    <select id="selectTipoOF" class="machine-select">
                        <option value="">Todos los tipos</option>
                        <option value="RELEASE">Release (@releaseCount.ToString("N0"))</option>
                        <option value="ENSAMBLE">Ensamble (@ensambleCount.ToString("N0"))</option>
                        <option value="PRUEBA">Prueba (@pruebaCount.ToString("N0"))</option>
                        <option value="MP EXTRA">MP extra (@mpExtraCount.ToString("N0"))</option>
                    </select>
                </div>

                <div class="toolbar-actions d-flex gap-2 flex-wrap">
                    <a href="/Menu/Grupo/3" class="btn-erp btn-erp-light">
                        <i class="fa-solid fa-arrow-left"></i>Volver
                    </a>
                                        <a asp-controller="Planeacion"
                       asp-action="Historial"
                       class="btn-erp btn-erp-light"> @* NSQ_HISTORIAL_OF_BUTTON_V2 *@
                        <i class="fa-solid fa-clock-rotate-left"></i>Historial de OF
                    </a><a asp-controller="Planeacion"
                       asp-action="Crear"
                       class="btn-erp btn-erp-primary">
                        <i class="fa-solid fa-plus"></i>Nueva OF manual
                    </a>
                </div>
            </div>
        </section>

        @if (!lista.Any())
        {
            <section class="empty-state">
                <i class="fa-regular fa-folder-open"></i>
                <h5 class="fw-bold">No hay OF activas en Planeacion</h5>
                <p class="mb-3">No existen programas pendientes de generar ni OF pendientes de completar su despacho al cliente.</p>
                <a asp-controller="PlaneacionPrograma"
                   asp-action="Index"
                   class="btn-erp btn-erp-primary">
                    <i class="fa-solid fa-list-check"></i>Ir al programa de planeación
                </a>
            </section>
        }
        else
        {
            <div id="contenedorOF">
                @{
                    var maquinaIndex = 0;
                }

                @foreach (var maquina in maquinas)
                {
                    maquinaIndex++;

                    var ordenesMaquina = maquina
                    .OrderBy(x => OrdenPrioridad(x.Prioridad))
                    .ThenBy(x => x.FechaRequerida ?? DateTime.MaxValue)
                    .ThenBy(x => x.FolioSolicitud)
                    .ToList();

                    var piezasMaquina = ordenesMaquina.Sum(x => x.TotalPiezas);
                    var pendientesMaquina = ordenesMaquina.Count(x => x.SolicitudProduccionID < 0);
                    var clientesMaquina = ordenesMaquina
                    .Select(x => Texto(x.Cliente))
                    .Distinct(StringComparer.OrdinalIgnoreCase)
                    .Count();

                    var maquinaDomId = $"maquina-{maquinaIndex}";

                    <section class="machine-section is-open"
                             data-machine-section
                             data-machine="@maquina.Key.Codigo">
                        <button type="button"
                                class="machine-header"
                                data-machine-toggle
                                aria-expanded="true"
                                aria-controls="@maquinaDomId">
                            <div class="machine-header-main">
                                <div class="machine-identification">
                                    <div class="machine-icon">
                                        <i class="fa-solid fa-gears"></i>
                                    </div>
                                    <div>
                                        <h2 class="machine-title">@maquina.Key.Codigo</h2>
                                        <div class="machine-subtitle">
                                            @maquina.Key.Nombre · OF pendientes visibles sin abrir la maquina
                                        </div>
                                    </div>
                                </div>

                                <div class="machine-summary">
                                    <span class="summary-chip">
                                        <i class="fa-solid fa-file-lines me-1"></i>
                                        @ordenesMaquina.Count.ToString("N0") registro(s)
                                    </span>
                                    <span class="summary-chip">
                                        <i class="fa-solid fa-cubes me-1"></i>
                                        @piezasMaquina.ToString("N0") piezas
                                    </span>
                                    <span class="summary-chip">
                                        <i class="fa-solid fa-building me-1"></i>
                                        @clientesMaquina cliente(s)
                                    </span>
                                    <span class="summary-chip">
                                        <i class="fa-solid fa-tags me-1"></i>
                                        @ordenesMaquina.Select(x => TipoOFNormalizado(x.TipoOF)).Distinct().Count().ToString("N0") tipo(s) OF
                                    </span>
                                    @if (pendientesMaquina > 0)
                                    {
                                        <span class="summary-chip">
                                            <i class="fa-solid fa-gears me-1"></i>
                                            @pendientesMaquina pendiente(s)
                                        </span>
                                    }
                                </div>
                            </div>
                            <span class="machine-toggle" aria-hidden="true">
                                <i class="fa-solid fa-chevron-down"></i>
                            </span>
                        </button>

                        <div class="machine-body" id="@maquinaDomId" data-machine-body>
                            @foreach (var prioridad in ordenesMaquina
                                                .GroupBy(x => PrioridadNormalizada(x.Prioridad))
                                                .OrderBy(x => OrdenPrioridad(x.Key)))
                            {
                                <div class="priority-group" data-priority-group>
                                    <div class="priority-heading">
                                        <span class="priority-label @ClasePrioridad(prioridad.Key)">
                                            <i class="fa-solid @IconoPrioridad(prioridad.Key)"></i>
                                            @prioridad.Key
                                        </span>
                                        <span class="priority-count">
                                            @prioridad.Count().ToString("N0") orden(es)
                                        </span>
                                    </div>

                                    <div class="of-grid">
                                        <div class="of-table-head" aria-hidden="true">
                                            <div>Orden / origen</div>
                                            <div>Cliente</div>
                                            <div>Tipo</div>
                                            <div>Entrega</div>
                                            <div>Piezas</div>
                                            <div>Planeación</div>
                                            <div>Responsable</div>
                                            <div>Estatus</div>
                                            <div>Acción</div>
                                        </div>

                                        @foreach (var item in prioridad
                                                                    .OrderBy(x => x.FechaRequerida ?? DateTime.MaxValue)
                                                                    .ThenBy(x => x.FolioSolicitud))
                                        {
                                            var esPendientePrograma = item.SolicitudProduccionID < 0;
                                            var programaProduccionId = Math.Abs(item.SolicitudProduccionID);
                                            var formGenerarId = $"form-generar-of-{programaProduccionId}";
                                            var tipoOF = TipoOFNormalizado(item.TipoOF);
                                            var tipoOFTexto = TextoTipoOF(item.TipoOF);

                                            var textoBusqueda = string.Join(" ", new[]
                                            {
                                                        maquina.Key.Codigo,
                                                        maquina.Key.Nombre,
                                                        item.Cliente,
                                                        item.FolioSolicitud,
                                                        item.NumeroOFRecibida,
                                                        item.Prioridad,
                                                        item.TipoOF,
                                                        TextoTipoOF(item.TipoOF),
                                                        item.MotivoTipoOF,
                                                        item.EstatusNombre,
                                                        item.ResponsablePlaneacionNombre,
                                                        Fecha(item.FechaRequerida)
                                                        }).ToLowerInvariant();

                                            <article class="of-card @(esPendientePrograma ? "is-program" : "")"
                                                     data-of-card
                                                     data-type="@tipoOF"
                                                     data-search="@textoBusqueda">

                                                <div class="of-cell">
                                                    <span class="row-label-mobile">Orden / origen</span>
                                                    <div class="row-badges">
                                                        @if (esPendientePrograma)
                                                        {
                                                            <span class="origin-badge origin-program">
                                                                <i class="fa-solid fa-gears"></i>Programa
                                                            </span>
                                                        }
                                                        else
                                                        {
                                                            <span class="origin-badge origin-of">
                                                                <i class="fa-solid fa-file-lines"></i>OF
                                                            </span>
                                                        }
                                                    </div>

                                                    <div class="row-title">@Texto(item.FolioSolicitud)</div>
                                                    <div class="row-subtitle">
                                                        @if (esPendientePrograma)
                                                        {
                                                            <span>Programa #@programaProduccionId</span>
                                                        }
                                                        else
                                                        {
                                                            <span>@Texto(item.NumeroOFRecibida)</span>
                                                        }
                                                    </div>
                                                </div>

                                                <div class="of-cell">
                                                    <span class="row-label-mobile">Cliente</span>
                                                    <div class="row-primary">@Texto(item.Cliente)</div>
                                                </div>

                                                <div class="of-cell">
                                                    <span class="row-label-mobile">Tipo</span>
                                                    <span class="type-badge @ClaseTipoOF(item.TipoOF)"
                                                          title="@Texto(item.MotivoTipoOF)">
                                                        <i class="fa-solid @IconoTipoOF(item.TipoOF)"></i>
                                                        @tipoOFTexto
                                                    </span>
                                                </div>

                                                <div class="of-cell">
                                                    <span class="row-label-mobile">Entrega</span>
                                                    <div class="delivery-pill @ClaseFecha(item.FechaRequerida)">
                                                        <span>
                                                            <i class="fa-regular fa-calendar me-1"></i>
                                                            @TextoFechaEntrega(item.FechaRequerida)
                                                        </span>
                                                        <strong>@Fecha(item.FechaRequerida)</strong>
                                                    </div>
                                                </div>

                                                <div class="of-cell">
                                                    <span class="row-label-mobile">Piezas</span>
                                                    <div class="row-primary">@item.TotalPiezas.ToString("N0")</div>
                                                    <div class="row-secondary">@item.TotalRenglones.ToString("N0") renglón(es)</div>
                                                </div>

                                                <div class="of-cell">
                                                    <span class="row-label-mobile">Planeación</span>
                                                    <div class="planning-stack">
                                                        <div class="planning-line">
                                                            <span>Inicio</span>
                                                            <strong>@FechaHora(item.FechaInicioPlaneada)</strong>
                                                        </div>
                                                        <div class="planning-line">
                                                            <span>Fin</span>
                                                            <strong>@FechaHora(item.FechaFinPlaneada)</strong>
                                                        </div>
                                                    </div>
                                                </div>

                                                <div class="of-cell">
                                                    <span class="row-label-mobile">Responsable</span>
                                                    <div class="row-responsible"
                                                         title="@Texto(item.ResponsablePlaneacionNombre)">
                                                        <i class="fa-regular fa-user"></i>
                                                        <span>@Texto(item.ResponsablePlaneacionNombre)</span>
                                                    </div>
                                                </div>

                                                <div class="of-cell">
                                                    <span class="row-label-mobile">Estatus</span>
                                                    <span class="status-pill @ClaseEstatus(item.EstatusID)">
                                                        <i class="fa-solid fa-circle"></i>
                                                        @Texto(item.EstatusNombre)
                                                    </span>
                                                </div>

                                                <div class="of-cell of-cell-action">
                                                    <span class="row-label-mobile">Acción</span>
                                                    @if (esPendientePrograma)
                                                    {
                                                        <form id="@formGenerarId"
                                                              asp-controller="PlaneacionPrograma"
                                                              asp-action="GenerarOF"
                                                              method="post"
                                                              class="m-0">
                                                            @Html.AntiForgeryToken()
                                                            <input type="hidden"
                                                                   name="programaProduccionId"
                                                                   value="@programaProduccionId" />

                                                            <button type="button"
                                                                    class="btn-erp btn-erp-primary row-action"
                                                                    data-generar-of
                                                                    data-form-id="@formGenerarId"
                                                                    data-programa="@programaProduccionId"
                                                                    data-folio="@Texto(item.FolioSolicitud)"
                                                                    data-cliente="@Texto(item.Cliente)"
                                                                    data-maquina="@maquina.Key.Codigo"
                                                                    data-tipo-of="@tipoOFTexto"
                                                                    data-piezas="@item.TotalPiezas.ToString("N0")"
                                                                    data-fecha="@Fecha(item.FechaRequerida)">
                                                                <i class="fa-solid fa-file-circle-plus"></i>
                                                                Generar
                                                            </button>
                                                        </form>
                                                    }
                                                    else
                                                    {
                                                        <div class="d-flex gap-1 flex-wrap justify-content-end">
                                                            <a asp-controller="Planeacion"
                                                               asp-action="Detalle"
                                                               asp-route-id="@item.SolicitudProduccionID"
                                                               class="btn-erp btn-erp-light row-action">
                                                                <i class="fa-regular fa-eye"></i>Ver
                                                            </a>
                                                            <button type="button"
                                                                    class="btn-erp btn-erp-primary row-action"
                                                                    data-extension-of
                                                                    data-solicitud-id="@item.SolicitudProduccionID"
                                                                    data-folio="@Texto(item.NumeroOFRecibida)"
                                                                    data-cliente="@Texto(item.Cliente)"
                                                                    data-maquina="@maquina.Key.Codigo">
                                                                <i class="fa-solid fa-plus"></i>Extension
                                                            </button>
                                                        </div>
                                                    }
                                                </div>
                                            </article>
                                        }
                                    </div>
                                </div>
                            }
                        </div>
                    </section>
                }
            </div>

            <section id="sinResultados" class="no-results">
                <i class="fa-solid fa-magnifying-glass mb-2 fs-3"></i>
                <h5 class="fw-bold">No encontramos coincidencias</h5>
                <div>Prueba con otra máquina, cliente, folio, responsable, prioridad o estatus.</div>
            </section>
        }
    </main>

    <div class="modal fade"
         id="modalGenerarOF"
         tabindex="-1"
         aria-labelledby="modalGenerarOFLabel"
         aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content border-0 rounded-4 shadow-lg">
                <div class="modal-header border-0 pb-0">
                    <div class="d-flex align-items-center gap-3">
                        <div class="modal-confirm-icon">
                            <i class="fa-solid fa-file-circle-plus"></i>
                        </div>
                        <div>
                            <h5 class="modal-title fw-bold text-primary" id="modalGenerarOFLabel">
                                Confirmar generación de OF
                            </h5>
                            <div class="text-muted small">
                                Revisa la información antes de continuar.
                            </div>
                        </div>
                    </div>
                    <button type="button"
                            class="btn-close"
                            data-bs-dismiss="modal"
                            aria-label="Cerrar"></button>
                </div>

                <div class="modal-body pt-3">
                    <p class="mb-0">
                        Se generará automáticamente una Orden de Fabricación para el programa seleccionado.
                    </p>

                    <div class="modal-detail-grid">
                        <div class="modal-detail-item">
                            <div class="modal-detail-label">Programa</div>
                            <div class="modal-detail-value" id="confirmPrograma">-</div>
                        </div>
                        <div class="modal-detail-item">
                            <div class="modal-detail-label">Folio</div>
                            <div class="modal-detail-value" id="confirmFolio">-</div>
                        </div>
                        <div class="modal-detail-item">
                            <div class="modal-detail-label">Cliente</div>
                            <div class="modal-detail-value" id="confirmCliente">-</div>
                        </div>
                        <div class="modal-detail-item">
                            <div class="modal-detail-label">Máquina</div>
                            <div class="modal-detail-value" id="confirmMaquina">-</div>
                        </div>
                        <div class="modal-detail-item">
                            <div class="modal-detail-label">Tipo de OF</div>
                            <div class="modal-detail-value" id="confirmTipoOF">-</div>
                        </div>
                        <div class="modal-detail-item">
                            <div class="modal-detail-label">Piezas</div>
                            <div class="modal-detail-value" id="confirmPiezas">-</div>
                        </div>
                        <div class="modal-detail-item">
                            <div class="modal-detail-label">Fecha requerida</div>
                            <div class="modal-detail-value" id="confirmFecha">-</div>
                        </div>
                    </div>

                    <div class="modal-warning-note">
                        <i class="fa-solid fa-triangle-exclamation me-1"></i>
                        Al confirmar se crearán el encabezado, el detalle y la asignación de máquina de la OF.
                    </div>
                </div>

                <div class="modal-footer border-0 pt-0">
                    <button type="button"
                            class="btn-erp btn-erp-light"
                            data-bs-dismiss="modal">
                        Cancelar
                    </button>
                    <button type="button"
                            id="btnConfirmarGenerarOF"
                            class="btn-erp btn-erp-primary">
                        <i class="fa-solid fa-check"></i>
                        Sí, generar OF
                    </button>
                </div>
            </div>
        </div>
    </div>
