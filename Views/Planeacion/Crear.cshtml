@model ERP.NSQuell.Models.PlaneacionOFCrearVm

@{
    Layout = "~/Views/Shared/_Layout.cshtml";
    ViewData["Title"] = "Nueva OF | Planeación";

    var clientesData = Model.Clientes.Select(x => new { value = x.Value, text = x.Text }).ToList();
    var partesData = Model.Partes.Select(x => new { value = x.Value, text = x.Text }).ToList();
    // LITZI_OF_ENSAMBLES_V1
    var ensamblesData = Model.Ensambles.Select(x => new { value = x.Value, text = x.Text }).ToList();
    var moldesData = Model.Moldes.Select(x => new { value = x.Value, text = x.Text }).ToList();
    var maquinasData = Model.Maquinas.Select(x => new { value = x.Value, text = x.Text }).ToList();

    var clientesJson = System.Text.Json.JsonSerializer.Serialize(clientesData);
    var partesJson = System.Text.Json.JsonSerializer.Serialize(partesData);
    var ensamblesJson = System.Text.Json.JsonSerializer.Serialize(ensamblesData);
    var moldesJson = System.Text.Json.JsonSerializer.Serialize(moldesData);
    var maquinasJson = System.Text.Json.JsonSerializer.Serialize(maquinasData);

    var tipoOFActual = string.IsNullOrWhiteSpace(Model.TipoOF)
        ? "RELEASE"
        : Model.TipoOF.Trim().ToUpperInvariant();

    if (tipoOFActual == "MPEXTRA" || tipoOFActual == "MP_EXTRA")
    {
        tipoOFActual = "MP EXTRA";
    }

    var requiereMotivoInicial = tipoOFActual == "PRUEBA" || tipoOFActual == "MP EXTRA";
}

@section Scripts {
    <script>
                const clientesData = @Html.Raw(clientesJson);
                const partesData = @Html.Raw(partesJson);
                const ensamblesData = @Html.Raw(ensamblesJson);
                const moldesData = @Html.Raw(moldesJson);
                const maquinasData = @Html.Raw(maquinasJson);

                let partesFiltradasData = [];

                const urlParteInfo = '@Url.Action("ObtenerParteInfo", "Planeacion")';
                // NSQ_56_AUTORELLENO_ENSAMBLE_V2
                const urlEnsambleInfo = '@Url.Action("ObtenerEnsambleInfo", "Planeacion")';
                const urlCalcular = '@Url.Action("CalcularDatosOF", "Planeacion")';
                const urlValidarAlmacen = '@Url.Action("ValidarDisponibilidadAlmacen", "Planeacion")';
                const urlPartesPorCliente = '@Url.Action("ObtenerPartesPorCliente", "Planeacion")';

                const tipoOFInputs = [...document.querySelectorAll('[data-tipo-of]')];
                const motivoTipoOFInput = document.getElementById('MotivoTipoOF');
                const motivoTipoOFBox = document.getElementById('motivoTipoOFBox');
                const motivoTipoOFRequired = document.getElementById('motivoTipoOFRequired');
                const motivoTipoOFHelp = document.getElementById('motivoTipoOFHelp');

                function escapeHtml(value) {
                    return String(value ?? '')
                        .replaceAll('&', '&amp;')
                        .replaceAll('<', '&lt;')
                        .replaceAll('>', '&gt;')
                        .replaceAll('"', '&quot;')
                        .replaceAll("'", '&#039;')
                        .replaceAll('`', '&#096;');
                }

                function crearOptions(data, placeholder) {
                    let html = `<option value="">${escapeHtml(placeholder)}</option>`;

                    data.forEach(x => {
                        html += `<option value="${escapeHtml(x.value)}">${escapeHtml(x.text)}</option>`;
                    });

                    return html;
                }

                function getTipoOFSeleccionado() {
                    const seleccionado = tipoOFInputs.find(x => x.checked);
                    return (seleccionado?.value || 'RELEASE').toUpperCase();
                }

                function tipoOFRequiereMotivo(tipoOF) {
                    return tipoOF === 'PRUEBA' || tipoOF === 'MP EXTRA';
                }

                function aplicarVisualTipoOF() {
                    const tipo = getTipoOFSeleccionado();
                    const requiereMotivo = tipoOFRequiereMotivo(tipo);
                    const esEnsamble = tipo === 'ENSAMBLE';

                    document.querySelectorAll('.parte-selector').forEach(x => x.classList.toggle('d-none', esEnsamble));
                    document.querySelectorAll('.ensamble-selector').forEach(x => x.classList.toggle('d-none', !esEnsamble));

                    document.querySelectorAll('.renglon-item').forEach(card => {
                        const parte = card.querySelector('.parte-select');
                        const ensamble = card.querySelector('.ensamble-select');

                        if (esEnsamble && parte) {
                            parte.value = '';
                        }
                        if (!esEnsamble && ensamble) {
                            ensamble.value = '';
                        }
                    });

                    if (motivoTipoOFBox) {
                        motivoTipoOFBox.classList.toggle('visible', requiereMotivo || !!motivoTipoOFInput?.value?.trim());
                    }

                    if (motivoTipoOFRequired) {
                        motivoTipoOFRequired.classList.toggle('d-none', !requiereMotivo);
                    }

                    if (motivoTipoOFHelp) {
                        motivoTipoOFHelp.textContent = requiereMotivo
                            ? 'Este tipo de OF requiere motivo obligatorio.'
                            : 'Motivo opcional para aclaraciones internas.';
                    }
                }

                function validarTipoOFAntesDeGuardar() {
                    const tipo = getTipoOFSeleccionado();
                    const motivo = (motivoTipoOFInput?.value || '').trim();

                    if (tipoOFRequiereMotivo(tipo) && motivo.length < 5) {
                        alert('Captura el motivo para el tipo de OF seleccionado.');
                        motivoTipoOFBox?.classList.add('visible');
                        motivoTipoOFInput?.focus();
                        return false;
                    }

                    return true;
                }

                // NSQ_55_LIMPIAR_CAMBIO_TIPO_OF_V1
                function limpiarFormularioAlCambiarTipoOF() {
                    const contenedor = document.getElementById('contenedorRenglones');

                    // Limpia campos generales que dependen del tipo de OF.
                    const cliente = document.getElementById('ClienteID');
                    const clienteNombre = document.getElementById('ClienteNombre');

                    if (cliente) {
                        cliente.value = '';
                    }

                    if (clienteNombre) {
                        clienteNombre.value = '';
                    }

                    if (motivoTipoOFInput) {
                        motivoTipoOFInput.value = '';
                    }

                    [
                        'FechaRequerida',
                        'FechaInicioPlaneada',
                        'FechaFinPlaneada',
                        'NotasGenerales'
                    ].forEach(function (id) {
                        const campo = document.getElementById(id);

                        if (campo) {
                            campo.value = '';
                        }
                    });

                    if (!contenedor) {
                        return;
                    }

                    // Al cambiar de tipo dejamos un solo renglon limpio.
                    const renglones = [...contenedor.querySelectorAll('.renglon-item')];

                    renglones.slice(1).forEach(function (card) {
                        card.remove();
                    });

                    const card = contenedor.querySelector('.renglon-item');

                    if (!card) {
                        return;
                    }

                    card.querySelectorAll('input, select, textarea').forEach(function (campo) {
                        // El numero de renglon se restaura abajo.
                        if (campo.classList.contains('input-renglon')) {
                            return;
                        }

                        if (campo.type === 'hidden') {
                            campo.value = '';
                            return;
                        }

                        if (campo.tagName === 'SELECT') {
                            campo.selectedIndex = 0;
                            return;
                        }

                        if (
                            campo.type === 'checkbox' ||
                            campo.type === 'radio'
                        ) {
                            campo.checked = false;
                            return;
                        }

                        campo.value = '';
                    });

                    const inputRenglon = card.querySelector('.input-renglon');
                    if (inputRenglon) {
                        inputRenglon.value = '1';
                    }

                    const numeroRenglon = card.querySelector('.numero-renglon');
                    if (numeroRenglon) {
                        numeroRenglon.textContent = '1';
                    }

                    // El listado de partes vuelve al catalogo completo.
                    // Si despues se selecciona cliente, se filtrara normalmente.
                    limpiarPartesDeTodosLosRenglones();

                    // El selector de ensamble queda en blanco.
                    card.querySelectorAll('.ensamble-select').forEach(function (select) {
                        select.value = '';
                    });

                    // Restablece selectores y campos que no forman parte
                    // de limpiarDatosParte().
                    card.querySelectorAll('.molde-select').forEach(function (select) {
                        select.value = '';
                    });

                    card.querySelectorAll('.maquina-select').forEach(function (select) {
                        select.value = '';
                    });

                    card.querySelectorAll('.cantidad-input, .cantidad-asignada-input, .horas-input').forEach(function (campo) {
                        campo.value = '';
                    });

                    card.querySelectorAll(
                        'input[name*="FechaProgramadaTentativa"],' +
                        'input[name*="HoraInicioTentativa"],' +
                        'input[name*="HoraFinTentativa"],' +
                        'input[name*="Observaciones"],' +
                        'textarea[name*=".Notas"]'
                    ).forEach(function (campo) {
                        campo.value = '';
                    });

                    card.querySelectorAll(
                        'select[name*="CondicionProduccion"]'
                    ).forEach(function (select) {
                        select.value = '';
                    });

                    const secuencia = card.querySelector(
                        'input[name*="AsignacionesMaquina"][name*=".Secuencia"]'
                    );

                    if (secuencia) {
                        secuencia.value = '1';
                    }

                    if (typeof limpiarValidacionAlmacen === 'function') {
                        limpiarValidacionAlmacen(card);
                    }

                    renumerarRenglones();
                }

                tipoOFInputs.forEach(input => {
                    input.addEventListener('change', function () {
                        limpiarFormularioAlCambiarTipoOF();
                        aplicarVisualTipoOF();
                    });
                });

                motivoTipoOFInput?.addEventListener('input', aplicarVisualTipoOF);
                aplicarVisualTipoOF();

                const moldesOptions = crearOptions(moldesData, '-- Selecciona molde --');
                const maquinasOptions = crearOptions(maquinasData, '-- Selecciona máquina --');
                const ensamblesOptions = crearOptions(ensamblesData, '-- Selecciona ensamble --');

                function agregarRenglon() {
                    const contenedor = document.getElementById('contenedorRenglones');
                    const index = contenedor.querySelectorAll('.renglon-item').length;

                    contenedor.insertAdjacentHTML('beforeend', crearHtmlRenglon(index));
                    renumerarRenglones();
                    aplicarVisualTipoOF();

                    const clienteId = document.getElementById('ClienteID')?.value;
                    if (partesFiltradasData.length) {
                        const nuevo = contenedor.querySelector('.renglon-item:last-child');
                        const select = nuevo.querySelector('.parte-select');
                        if (select) {
                            select.innerHTML = crearOptions(partesFiltradasData, '-- Selecciona parte --');
                        }
                    }
                }

                function crearHtmlRenglon(i) {
                    return `
        <div class="renglon-card renglon-item" data-index="${i}">
            <div class="renglon-header">
                <div class="d-flex align-items-center gap-2">
                    <span class="badge-renglon">Renglón <span class="numero-renglon">${i + 1}</span></span>
                    <span class="erp-muted">Producto / parte</span>
                </div>

                <button type="button" class="btn btn-sm btn-erp-danger" onclick="eliminarRenglon(this)">
                    <i class="fa-regular fa-trash-can me-1"></i>
                    Quitar
                </button>
            </div>

            <div class="renglon-body">
                <input type="hidden" name="Detalles[${i}].Renglon" value="${i + 1}" class="input-renglon" />
                <input type="hidden" name="Detalles[${i}].MaterialID" class="material-id-input" />
                <input type="hidden" name="Detalles[${i}].OrigenSurtido" class="origen-surtido-input" />
                <input type="hidden" name="Detalles[${i}].PTDisponibleAlCrear" class="pt-disponible-input" />
                <input type="hidden" name="Detalles[${i}].MPDisponibleKgAlCrear" class="mp-disponible-input" />
                <input type="hidden" name="Detalles[${i}].AlmacenValidado" class="almacen-validado-input" value="false" />
                <input type="hidden" name="Detalles[${i}].MensajeAlmacen" class="mensaje-almacen-input" />

                <div class="row g-3">
                    <div class="col-md-6">
