                function filtrarPartesEnRenglon(input) {
                    const card = input.closest('.renglon-item');
                    const select = card.querySelector('.parte-select');

                    if (!select) return;

                    const filtro = input.value.toLowerCase().trim();

                    const base = partesFiltradasData && partesFiltradasData.length
                        ? partesFiltradasData
                        : [];

                    const filtradas = !filtro
                        ? base
                        : base.filter(x => String(x.text).toLowerCase().includes(filtro));

                    select.innerHTML = crearOptions(filtradas, '-- Selecciona parte --');
                }
