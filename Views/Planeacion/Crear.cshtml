            }

            if (
                e.target.classList.contains('cantidad-input') ||
                e.target.classList.contains('horas-input') ||
                e.target.classList.contains('objetivo-input') ||
                e.target.classList.contains('piezas-embalaje-input') ||
                e.target.classList.contains('peso-input')
            ) {
                const card = e.target.closest('.renglon-item');

                calcularRenglon(card);

                if (e.target.classList.contains('cantidad-input')) {
                    const asignada = card.querySelector('.cantidad-asignada-input');

                    if (asignada && e.target.value && Number(e.target.value) > 0) {
                        asignada.value = e.target.value;
                    }
                }

            }
        });

        function programarValidacionAutomatica(card) {
            if (!card) return;

            const parteId = getValue(card, '.parte-select');
            const cantidad = getValue(card, '.cantidad-input');

            if (!parteId || Number(parteId) <= 0) {
                return;
            }

            if (!cantidad || Number(cantidad) <= 0) {
                return;
            }

            const timerAnterior = timersValidacionAlmacen.get(card);

            if (timerAnterior) {
                clearTimeout(timerAnterior);
            }

                   const nuevoTimer = setTimeout(async function () {
            await validarAlmacenRenglon(card, false);
        }, 450);

            timersValidacionAlmacen.set(card, nuevoTimer);
        }

                async function cargarInfoParte(select) {
                    const parteId = select.value;
                    const card = select.closest('.renglon-item');

                    if (!parteId) {
                        limpiarDatosParte(card);
                        return;
                    }

                    try {
                        const resp = await fetch(`${urlParteInfo}?parteId=${encodeURIComponent(parteId)}`);
                        const data = await resp.json();

                        if (!data.ok) {
                            alert(data.mensaje || 'No se encontró la información de la parte.');
                            return;
                        }

                        setValue(card, '.referencia-input', data.referenciaSAP);
                        setValue(card, '.designacion-input', data.designacionDescripcionSAP);
                        setValue(card, '.color-input', data.color);
                        setValue(card, '.cavidades-input', data.cavidades);
                        setValue(card, '.objetivo-input', data.objetivoHora);
                        setValue(card, '.piezas-caja-input', data.piezasPorCaja);
                        setValue(card, '.ciclo-input', data.ciclo);
                        setValue(card, '.tipo-secado-input', data.tipoSecado);
                        setValue(card, '.horas-secado-input', data.horasSecado);
                        setValue(card, '.peso-input', data.pesoBrutoPieza);
                        setValue(card, '.piezas-embalaje-input', data.piezasPorEmbalaje);
                        setValue(card, '.material-codigo-input', data.materialCodigo);
                        setValue(card, '.material-desc-input', data.materialDescripcion);
                        setValue(card, '.material-id-input', data.materialID);
                        setValue(card, '.embalaje-codigo-input', data.embalajeCodigo);
                        setValue(card, '.embalaje-desc-input', data.embalajeDescripcion);

                        limpiarValidacionAlmacen(card);

                        const moldeSelect = card.querySelector('.molde-select');
                        if (moldeSelect && data.moldeID) {
                            moldeSelect.value = data.moldeID;
                        }

                        const maquinaSelect = card.querySelector('.maquina-select');
                        if (maquinaSelect && data.maquinaPrincipalID) {
                            maquinaSelect.value = data.maquinaPrincipalID;
                        }

                        const clienteSelect = document.getElementById('ClienteID');
                        const clienteNombre = document.getElementById('ClienteNombre');

                        if (clienteSelect && !clienteSelect.value && data.clienteID) {
                            clienteSelect.value = data.clienteID;
                        }

                        if (clienteNombre && data.clienteNombre) {
                            clienteNombre.value = data.clienteNombre;
                        }

                                await calcularRenglon(card);
                    } catch (err) {
                        console.error(err);
                        alert('No se pudo cargar la información técnica de la parte.');
                    }
                }

                async function calcularRenglon(card) {
                    if (!card) return;

                    const cantidad = getValue(card, '.cantidad-input');
                    const horas = getValue(card, '.horas-input');
                    const objetivo = getValue(card, '.objetivo-input');
                    const piezasEmbalaje = getValue(card, '.piezas-embalaje-input');
                    const peso = getValue(card, '.peso-input');

                    const qs = new URLSearchParams({
                        cantidadPiezas: cantidad || '',
                        horasPlaneadas: horas || '',
                        objetivoHora: objetivo || '',
                        piezasPorEmbalaje: piezasEmbalaje || '',
                        pesoBrutoPieza: peso || ''
                    });

                    try {
                        const resp = await fetch(`${urlCalcular}?${qs.toString()}`);
                        const data = await resp.json();

                        if (!data.ok) return;

                                        const cantidadInput = card.querySelector('.cantidad-input');
        const cantidadAsignadaInput = card.querySelector('.cantidad-asignada-input');
        const horasInput = card.querySelector('.horas-input');
        const embalajesInput = card.querySelector('.cantidad-embalajes-input');
        const mpInput = card.querySelector('.cantidad-mp-input');

               if (cantidadAsignadaInput && cantidadInput?.value && Number(cantidadInput.value) > 0) {
            cantidadAsignadaInput.value = cantidadInput.value;
        }

        if (horasInput && data.horasPlaneadas !== null && data.horasPlaneadas !== undefined) {
            horasInput.value = data.horasPlaneadas;
        }

        if (embalajesInput) {
            embalajesInput.value = data.cantidadEmbalajes ?? '';
        }

        if (mpInput) {
            mpInput.value = data.cantidadMpKg ?? '';
        }
                    } catch (err) {
                        console.error(err);
                    }
                }

                               async function cargarPartesPorCliente(clienteId) {
            try {
                console.log('Cliente seleccionado:', clienteId);

                if (!clienteId || Number(clienteId) <= 0) {
                    limpiarPartesDeTodosLosRenglones();
                    return;
                }

                const url = `${urlPartesPorCliente}?clienteId=${encodeURIComponent(clienteId)}`;
                console.log('URL partes:', url);

                const resp = await fetch(url);
                console.log('Status partes:', resp.status);

                if (!resp.ok) {
                    alert('No se pudieron cargar las partes del cliente. Respuesta del servidor: ' + resp.status);
                    return;
                }

                const data = await resp.json();
                console.log('Respuesta partes:', data);

                if (!data.ok) {
                    alert(data.mensaje || 'No se pudieron cargar las partes del cliente.');
                    return;
                }

                partesFiltradasData = data.partes || [];
                console.log('Total partes recibidas:', partesFiltradasData.length);

                const options = crearOptions(partesFiltradasData, '-- Selecciona parte --');

                       document.querySelectorAll('.parte-select').forEach(function (select) {
            const valorActual = select.getAttribute('data-valor-actual') || select.value || '';

            select.innerHTML = options;

            if (valorActual) {
                select.value = valorActual;
            } else {
                select.value = '';
            }
        });

        document.querySelectorAll('.renglon-item').forEach(function (card) {
            const parteSelect = card.querySelector('.parte-select');
            const valorActual = parteSelect?.getAttribute('data-valor-actual') || parteSelect?.value || '';

            if (!valorActual) {
                limpiarDatosParte(card);
            }
        });

                if (!partesFiltradasData.length) {
                    alert('El cliente seleccionado no tiene partes activas registradas.');
                }

            } catch (err) {
                console.error(err);
                alert('Error al cargar partes del cliente.');
            }
        }

                function filtrarPartesEnRenglon(input) {
                    const card = input.closest('.renglon-item');
                    const select = card.querySelector('.parte-select');

                    if (!select) return;

                    const filtro = input.value.toLowerCase().trim();

                    const base = partesFiltradasData && partesFiltradasData.length
                        ? partesFiltradasData
                        : [];

                    const filtradas = !filtro
                        ? base
                        : base.filter(x => String(x.text).toLowerCase().includes(filtro));

                    select.innerHTML = crearOptions(filtradas, '-- Selecciona parte --');
                }

                function limpiarPartesDeTodosLosRenglones() {
                    partesFiltradasData = [];

                    document.querySelectorAll('.parte-select').forEach(select => {
                        select.innerHTML = '<option value="">-- Selecciona cliente primero --</option>';
                        select.value = '';
                    });

                    limpiarDatosParteDeTodosLosRenglones();
                }

                function limpiarDatosParteDeTodosLosRenglones() {
                    document.querySelectorAll('.renglon-item').forEach(card => limpiarDatosParte(card));
                }

                function limpiarDatosParte(card) {
                    if (!card) return;

                    setValue(card, '.referencia-input', '');
                    setValue(card, '.designacion-input', '');
                    setValue(card, '.color-input', '');
                    setValue(card, '.cavidades-input', '');
                    setValue(card, '.objetivo-input', '');
                    setValue(card, '.piezas-caja-input', '');
                    setValue(card, '.ciclo-input', '');
                    setValue(card, '.tipo-secado-input', '');
                    setValue(card, '.horas-secado-input', '');
                    setValue(card, '.peso-input', '');
                    setValue(card, '.piezas-embalaje-input', '');
                    setValue(card, '.cantidad-embalajes-input', '');
                    setValue(card, '.cantidad-mp-input', '');
                    setValue(card, '.material-codigo-input', '');
                    setValue(card, '.material-desc-input', '');
                    setValue(card, '.material-id-input', '');
                    setValue(card, '.embalaje-codigo-input', '');
                    setValue(card, '.embalaje-desc-input', '');
                    limpiarValidacionAlmacen(card);
                }

                async function validarAlmacenRenglon(card, mostrarModal) {
                    if (!card) return false;

                    const parteId = getValue(card, '.parte-select');
                    const cantidad = getValue(card, '.cantidad-input');

                    if (!parteId || Number(parteId) <= 0) {
                        return false;
                    }

                    if (!cantidad || Number(cantidad) <= 0) {
                        return false;
                    }

                    const qs = new URLSearchParams({
                        parteId: parteId,
                        cantidadPiezas: cantidad
                    });

                    try {
                        const resp = await fetch(`${urlValidarAlmacen}?${qs.toString()}`);
                        const data = await resp.json();

                        if (!data.ok) {
                            alert(data.mensaje || 'No se pudo validar almacén.');
                            return false;
                        }

                        aplicarResultadoAlmacen(card, data);

                                if (data.bloquear) {
            mostrarModalAlmacen(data);
        }

                        if (data.bloquear) {
                            return false;
                        }

                        return true;
                    } catch (err) {
                        console.error(err);
                        alert('No se pudo validar la disponibilidad de almacén.');
                        return false;
                    }
                }

                        function aplicarResultadoAlmacen(card, data) {
            setValue(card, '.origen-surtido-input', data.decision);
            setValue(card, '.pt-disponible-input', data.pt?.disponible ?? 0);
            setValue(card, '.mp-disponible-input', data.mp?.disponibleKg ?? 0);
            setValue(card, '.mensaje-almacen-input', data.mensaje);
            setValue(card, '.almacen-validado-input', 'true');

            if (data.mp?.materialId) {
                setValue(card, '.material-id-input', data.mp.materialId);
            }

            card.dataset.origenSurtido = data.decision || '';

            const box = card.querySelector('.almacen-status');
            const text = card.querySelector('.almacen-status-text');

            if (!box || !text) return;

            box.classList.remove('pt', 'mp', 'error', 'visible');

            let clase = 'error';

            if (data.decision === 'PT') {
                clase = 'pt';
                desactivarControlesMP(card, true);
            } else if (data.decision === 'MP') {
                clase = 'mp';
                desactivarControlesMP(card, false);
            } else {
                clase = 'error';
                desactivarControlesMP(card, true);
            }

            box.classList.add(clase, 'visible');
            text.innerHTML = construirResumenAlmacen(data);
        }

        function desactivarControlesMP(card, desactivar) {
            if (!card) return;

            card.querySelectorAll('.mp-only').forEach(function (el) {
                el.disabled = desactivar;
            });
        }

                function limpiarValidacionAlmacen(card) {
                    if (!card) return;

                    setValue(card, '.origen-surtido-input', '');
                    setValue(card, '.pt-disponible-input', '');
                    setValue(card, '.mp-disponible-input', '');
                    setValue(card, '.mensaje-almacen-input', '');
                    setValue(card, '.almacen-validado-input', 'false');

                    const box = card.querySelector('.almacen-status');
                    const text = card.querySelector('.almacen-status-text');

                    if (box) {
                        box.classList.remove('pt', 'mp', 'error', 'visible');
                    }

                    if (text) {
                        text.innerHTML = 'Pendiente de validar.';
                    }
                }

                                       function construirResumenAlmacen(data) {
            const pt = data.pt || {};
            const mp = data.mp || {};
            const embalaje = data.embalaje || {};

            let badgeClase = 'bg-secondary';
            let decisionTexto = data.decision || 'PENDIENTE';

            if (data.decision === 'PT') {
                badgeClase = 'bg-success';
                decisionTexto = 'Surtir desde PT';
            } else if (data.decision === 'MP') {
                badgeClase = 'bg-primary';
                decisionTexto = 'Producir con MP';
            } else {
                badgeClase = 'bg-danger';
                decisionTexto = 'Revisar existencias';
            }

            let claseEmbalaje = 'text-secondary';
            let iconoEmbalaje = 'fa-circle-info';

            if (embalaje.semaforo === 'VERDE' || embalaje.suficiente === true) {
                claseEmbalaje = 'text-success';
                iconoEmbalaje = 'fa-circle-check';
            } else if (embalaje.semaforo === 'AMARILLO') {
                claseEmbalaje = 'text-warning';
                iconoEmbalaje = 'fa-triangle-exclamation';
            } else {
                claseEmbalaje = 'text-danger';
                iconoEmbalaje = 'fa-circle-exclamation';
            }

            return `
                <div class="d-flex justify-content-between align-items-start gap-2 flex-wrap mb-2">
                    <div class="fw-bold">
                        ${escapeHtml(data.mensaje ?? 'Validación realizada.')}
                    </div>
                    <span class="badge ${badgeClase}">
                        ${escapeHtml(decisionTexto)}
                    </span>
                </div>

                <div class="row g-2">
                    <div class="col-md-4">
                        <div class="p-2 rounded-3 border bg-white">
                            <div class="fw-bold text-success">
                                <i class="fa-solid fa-boxes-stacked me-1"></i>
                                Producto terminado
                            </div>
                            <div class="small">
                                Disponible:
                                <strong>${escapeHtml(pt.disponible ?? 0)}</strong>
                            </div>
                            <div class="small">
                                Requerido:
                                <strong>${escapeHtml(pt.requerido ?? 0)}</strong>
                            </div>
                        </div>
                    </div>

                    <div class="col-md-4">
                        <div class="p-2 rounded-3 border bg-white">
                            <div class="fw-bold text-primary">
                                <i class="fa-solid fa-industry me-1"></i>
                                Materia prima
                            </div>
                            <div class="small">
                                ${escapeHtml(mp.codigo ?? '')}
                                ${escapeHtml(mp.material ?? '')}
                            </div>
                            <div class="small">
                                Disponible:
                                <strong>${escapeHtml(mp.disponibleKg ?? 0)} ${escapeHtml(mp.unidad ?? '')}</strong>
                            </div>
                            <div class="small">
                                Requerido:
                                <strong>${escapeHtml(mp.requeridoKg ?? 0)} kg</strong>
                            </div>
                        </div>
                    </div>

                    <div class="col-md-4">
                        <div class="p-2 rounded-3 border bg-white">
                            <div class="fw-bold ${claseEmbalaje}">
                                <i class="fa-solid ${iconoEmbalaje} me-1"></i>
                                Embalaje
                            </div>
                            <div class="small">
                                ${escapeHtml(embalaje.codigo ?? '')}
                                ${escapeHtml(embalaje.nombre ?? '')}
                            </div>
                            <div class="small">
                                Disponible:
                                <strong>${escapeHtml(embalaje.disponible ?? 0)} ${escapeHtml(embalaje.unidad ?? '')}</strong>
                            </div>
                            <div class="small">
                                Requerido:
                                <strong>${escapeHtml(embalaje.requerido ?? 0)} ${escapeHtml(embalaje.unidad ?? '')}</strong>
                            </div>
                            <div class="small mt-1 ${claseEmbalaje}">
                                ${escapeHtml(embalaje.mensaje ?? '')}
                            </div>
                        </div>
                    </div>
                </div>
            `;
        }

        function mostrarModalAlmacen(data) {
            const modalTitle = document.getElementById('modalAlmacenTitle');
            const modalBody = document.getElementById('modalAlmacenBody');
            const modalIcon = document.getElementById('modalAlmacenIcon');
            const modalElement = document.getElementById('modalAlmacen');

            if (!modalTitle || !modalBody || !modalIcon || !modalElement) {
                alert(data.mensaje || 'Validación de almacén realizada.');
                return;
            }

            modalIcon.className = 'fa-solid me-2';

            if (data.decision === 'PT') {
                modalIcon.classList.add('fa-boxes-stacked', 'text-success');
                modalTitle.innerText = 'Producto terminado disponible';
            } else if (data.decision === 'MP') {
                modalIcon.classList.add('fa-industry', 'text-primary');
                modalTitle.innerText = 'Materia prima suficiente';
            } else {
                modalIcon.classList.add('fa-triangle-exclamation', 'text-danger');
                modalTitle.innerText = 'Validación de almacén';
            }

            modalBody.innerHTML = construirResumenAlmacen(data);

            const modal = bootstrap.Modal.getOrCreateInstance(modalElement, {
                backdrop: true,
                keyboard: true,
                focus: true
            });

            modal.show();
        }

                const modalAlmacenElement = document.getElementById('modalAlmacen');

        if (modalAlmacenElement) {
            modalAlmacenElement.addEventListener('hidden.bs.modal', function () {
                document.querySelectorAll('.modal-backdrop').forEach(function (backdrop) {
                    backdrop.remove();
                });

                document.body.classList.remove('modal-open');
                document.body.style.removeProperty('overflow');
                document.body.style.removeProperty('padding-right');
            });
        }

                function setValue(card, selector, value) {
                    const input = card.querySelector(selector);
                    if (!input) return;

                    input.value = value ?? '';
                }

                function getValue(card, selector) {
                    const input = card.querySelector(selector);
                    return input ? input.value : '';
                }

                const clienteSelect = document.getElementById('ClienteID');
                const clienteNombre = document.getElementById('ClienteNombre');

                if (clienteSelect && clienteNombre) {
                    clienteSelect.addEventListener('change', async function () {
                        const selected = this.options[this.selectedIndex];
                        clienteNombre.value = selected ? selected.text : '';

                        const clienteId = this.value;

                        if (!clienteId) {
                            limpiarPartesDeTodosLosRenglones();
                            return;
                        }

                        await cargarPartesPorCliente(clienteId);
                    });
                }

                const formCrearOF = document.getElementById('formCrearOF');

                if (formCrearOF) {
                    formCrearOF.addEventListener('submit', async function (e) {
                        e.preventDefault();

                        if (!validarTipoOFAntesDeGuardar()) {
                            return;
                        }

                        const renglones = document.querySelectorAll('.renglon-item');

                        if (!renglones.length) {
                            alert('Debes capturar al menos un renglón.');
                            return;
                        }

                        for (const card of renglones) {
                            const parteId = getValue(card, '.parte-select');
                            const cantidad = getValue(card, '.cantidad-input');

                            if (!parteId || Number(parteId) <= 0) {
                                alert('Todos los renglones deben tener una parte seleccionada.');
                                return;
                            }

                            if (!cantidad || Number(cantidad) <= 0) {
                                alert('Todos los renglones deben tener cantidad mayor a cero.');
                                return;
                            }
                        }

                        this.submit();
                    });
                }

                        document.addEventListener('DOMContentLoaded', async function () {
            const clienteIdInicial = document.getElementById('ClienteID')?.value;

            if (clienteIdInicial && Number(clienteIdInicial) > 0) {
                await cargarPartesPorCliente(clienteIdInicial);
            } else {
                limpiarPartesDeTodosLosRenglones();
            }
        });
    </script>
</body>
</html>