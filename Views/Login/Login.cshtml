@model ERP.NSQuell.Models.UsuarioModel
@{
    Layout = null;
}
<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Acceso ERP | NSQuell</title>

    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet" />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap" rel="stylesheet" />
    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" rel="stylesheet" />
    <link href="~/css/stylesLoginLogin.css" rel="stylesheet" />

    <style>
        :root {
            --ns-blue-1: #04173b;
            --ns-blue-2: #063f63;
            --ns-blue-3: #0d0e68;
            --ns-dark: #172033;
            --ns-dark-2: #222b3d;
            --ns-orange: #db5f13;
            --ns-orange-soft: rgba(219, 95, 19, 0.10);
            --ns-orange-soft-2: rgba(219, 95, 19, 0.06);
            --ns-bg: #ece9e2;
            --ns-card: #ffffff;
            --ns-text: #111827;
            --ns-muted: #6b7280;
            --ns-line: #e5e7eb;
            --ns-border: #d1d5db;
            --ns-danger-bg: #fff7ed;
            --ns-danger-line: #fed7aa;
            --ns-danger-text: #9a3412;
        }

        * {
            box-sizing: border-box;
        }

        html,
        body {
            width: 100%;
            min-height: 100%;
            margin: 0;
            padding: 0;
        }

        body {
            min-height: 100vh;
            font-family: 'Inter', sans-serif;
            background: var(--ns-bg) !important;
            color: var(--ns-text);
            display: block !important;
            align-items: initial !important;
            justify-content: initial !important;
            overflow-x: hidden !important;
            overflow-y: auto !important;
        }

        body::before,
        body::after {
            display: none !important;
            content: none !important;
        }

        .login-layout {
            width: 100vw;
            min-height: 100vh;
            display: grid;
            grid-template-columns: 420px minmax(0, 1fr);
            background: var(--ns-bg);
        }

        /* Panel izquierdo */
        .login-info {
            width: 470px;
            min-height: 100vh;
            background: linear-gradient(180deg, #101b31 0%, #172b49 100%);
            color: #ffffff;
            padding: 3rem 2.6rem;
            display: flex;
            flex-direction: column;
            justify-content: space-between;
            position: relative;
            z-index: 3;
        }

        .brand-block {
            display: flex;
            align-items: center;
            gap: .9rem;
        }

        .brand-logo {
            width: 54px;
            height: 54px;
            border-radius: 14px;
            background: #ffffff;
            padding: .35rem;
            overflow: hidden;
            flex: 0 0 auto;
        }

        .brand-logo img {
            width: 100%;
            height: 100%;
            object-fit: cover;
            border-radius: 10px;
        }

        .brand-name {
            margin: 0;
            font-size: 1.15rem;
            font-weight: 800;
            letter-spacing: -.03em;
        }

        .brand-system {
            margin: .15rem 0 0;
            font-size: .82rem;
            font-weight: 600;
            color: #cbd5e1;
        }

        .info-content {
            max-width: 310px;
        }

        .info-label {
            color: var(--ns-orange);
            font-size: .78rem;
            font-weight: 800;
            letter-spacing: .12em;
            text-transform: uppercase;
            margin-bottom: 1rem;
        }

        .info-title {
            margin: 0 0 1rem;
            font-size: 2.08rem;
            line-height: 1.08;
            font-weight: 800;
            letter-spacing: -.05em;
        }

        .info-text {
            margin: 0;
            color: #d6deea;
            font-size: .95rem;
            line-height: 1.68;
            font-weight: 500;
        }

        .info-list {
            display: grid;
            gap: .9rem;
            margin-top: 1.8rem;
        }

        .info-item {
            display: flex;
            align-items: center;
            gap: .7rem;
            color: #edf2f7;
            font-size: .88rem;
            font-weight: 600;
        }

        .info-item i {
            width: 18px;
            color: var(--ns-orange);
        }

        .info-footer {
            color: #9fb0c7;
            font-size: .78rem;
            font-weight: 600;
        }

        /* Área derecha */
        .login-area {
            width: 100%;
            min-width: 0;
            min-height: 100vh;
            display: flex;
            align-items: center;
            justify-content: center;
            padding: 2rem;
            position: relative;
            overflow: hidden;
            background: var(--ns-bg);
        }

        /* Fondo ejecutivo, técnico y limpio */
        .login-area::before {
            content: "";
            position: absolute;
            inset: 0;
            background:
                linear-gradient(90deg, rgba(255,255,255,0.08) 0%, rgba(255,255,255,0.08) 100%),
                linear-gradient(180deg, rgba(255,255,255,0.05), rgba(255,255,255,0.02));
            z-index: 0;
            pointer-events: none;
        }

        .executive-bg {
            position: absolute;
            inset: 0;
            z-index: 0;
            pointer-events: none;
            overflow: hidden;
        }

        .grid-line-v,
        .grid-line-h {
            position: absolute;
            background: rgba(23, 32, 51, 0.035);
        }

        .grid-line-v {
            width: 1px;
            height: 100%;
            top: 0;
        }

        .grid-line-h {
            height: 1px;
            width: 100%;
            left: 0;
        }

        .v1 { left: 18%; }
        .v2 { left: 48%; }
        .v3 { left: 78%; }

        .h1 { top: 22%; }
        .h2 { top: 52%; }
        .h3 { top: 78%; }

        .tech-line {
            position: absolute;
            border-top: 1.5px solid rgba(219, 95, 19, 0.12);
            z-index: 0;
        }

        .tech-line.line-1 {
            width: 240px;
            top: 28%;
            left: 16%;
            transform: rotate(8deg);
        }

        .tech-line.line-2 {
            width: 220px;
            bottom: 24%;
            right: 14%;
            transform: rotate(-8deg);
        }

        .tech-dot {
            position: absolute;
            width: 8px;
            height: 8px;
            border-radius: 50%;
            background: rgba(219, 95, 19, 0.28);
            z-index: 0;
        }

        .dot-1 { top: 26%; left: 15%; }
        .dot-2 { top: 30%; left: 39%; }
        .dot-3 { bottom: 22%; right: 13%; }
        .dot-4 { bottom: 26%; right: 31%; }

        /* Solo 3 coches sutiles */
        .car-outline {
            position: absolute;
            color: rgba(219, 95, 19, 0.10);
            user-select: none;
            z-index: 0;
        }

        .car-outline.small { font-size: 2rem; }
        .car-outline.medium { font-size: 2.6rem; }
        .car-outline.large { font-size: 3rem; }

        .car-a {
            top: 14%;
            right: 18%;
        }

        .car-b {
            bottom: 16%;
            right: 10%;
        }

        .car-c {
            bottom: 20%;
            left: 20%;
        }

        .login-card {
            width: 100%;
            max-width: 455px;
            background: var(--ns-card) !important;
            border: 1px solid rgba(229, 231, 235, .95);
            border-radius: 18px;
            padding: 2rem;
            box-shadow: 0 18px 42px rgba(17, 24, 39, .10);
            position: relative;
            z-index: 2;
            overflow: visible;
        }

        .login-card::before {
            display: none !important;
        }

        .login-header {
            margin-bottom: 1.55rem;
        }

        .login-header h1 {
            margin: 0;
            color: var(--ns-text);
            font-size: 1.55rem;
            font-weight: 800;
            letter-spacing: -.04em;
        }

        .login-header p {
            margin: .4rem 0 0;
            color: var(--ns-muted);
            font-size: .9rem;
            line-height: 1.5;
            font-weight: 500;
        }

        .module-row {
            display: grid;
            grid-template-columns: repeat(3, 1fr);
            gap: .55rem;
            margin-bottom: 1.35rem;
        }

        .module-item {
            border: 1px solid var(--ns-line);
            border-radius: 12px;
            padding: .7rem .35rem;
            text-align: center;
            color: #475569;
            background: #fafafa;
            font-size: .72rem;
            font-weight: 700;
        }

        .module-item i {
            display: block;
            color: var(--ns-orange);
            font-size: .92rem;
            margin-bottom: .3rem;
        }

        .alert-custom {
            background: var(--ns-danger-bg);
            color: var(--ns-danger-text);
            border: 1px solid var(--ns-danger-line);
            border-radius: 12px;
            padding: .9rem 1rem;
            margin-bottom: 1rem;
            font-size: .84rem;
            font-weight: 600;
        }

        .alert-title {
            font-weight: 800;
            margin-bottom: .3rem;
        }

        .error-message {
            color: #dc2626;
            font-size: .84rem;
            margin-top: .2rem;
        }

        .input-group-custom {
            position: relative;
            margin-bottom: 1rem;
        }

        .input-group-custom .form-control {
            width: 100%;
            height: 54px;
            border-radius: 12px;
            border: 1px solid var(--ns-border);
            background: #ffffff;
            color: var(--ns-text);
            font-size: .95rem;
            font-weight: 600;
            padding: 1.15rem 3rem .45rem 2.75rem;
            box-shadow: none;
            transition: border-color .15s ease, box-shadow .15s ease;
            transform: none !important;
        }

        .input-group-custom .form-control:focus {
            border-color: var(--ns-orange);
            background: #ffffff;
            box-shadow: 0 0 0 3px rgba(219, 95, 19, .12);
            outline: none;
        }

        .input-icon {
            position: absolute;
            left: 1rem;
            top: 50%;
            transform: translateY(-50%) !important;
            color: #9ca3af;
            font-size: 1rem;
            z-index: 2;
            pointer-events: none;
        }

        .input-group-custom.focused .input-icon {
            color: var(--ns-orange);
        }

        .input-group-custom label {
            position: absolute;
            left: 2.75rem;
            top: 50%;
            transform: translateY(-50%);
            color: #9ca3af;
            font-size: .9rem;
            font-weight: 600;
            pointer-events: none;
            transition: .15s ease;
            background: transparent;
            padding: 0;
        }

        .input-group-custom.focused label,
        .input-group-custom.has-value label,
        .input-group-custom .form-control:not(:placeholder-shown) + .input-icon + label {
            top: .62rem;
            transform: none;
            font-size: .68rem;
            color: var(--ns-orange);
            text-transform: uppercase;
            letter-spacing: .04em;
            background: transparent;
        }

        .password-toggle {
            position: absolute;
            right: .65rem;
            top: 50%;
            transform: translateY(-50%);
            width: 38px;
            height: 38px;
            border: 0;
            border-radius: 10px;
            background: transparent;
            color: #9ca3af;
            display: grid;
            place-items: center;
            z-index: 3;
            cursor: pointer;
        }

        .password-toggle:hover {
            background: rgba(219, 95, 19, 0.08);
            color: var(--ns-orange);
        }

        .validation-error {
            display: block;
            color: #dc2626;
            font-size: .75rem;
            font-weight: 700;
            margin-top: .3rem;
        }

        .btn-login {
            width: 100%;
            height: 54px;
            border: 0;
            border-radius: 12px;
            background: linear-gradient(135deg, #121360 0%, #063f63 50%, #0d0e68 100%);
            color: #ffffff;
            font-size: .92rem;
            font-weight: 800;
            letter-spacing: .02em;
            transition: .15s ease;
            position: relative;
            overflow: hidden;
            box-shadow: 0 10px 25px rgba(18, 19, 96, .20);
            cursor: pointer;
        }

        .btn-login:hover {
            filter: brightness(1.03);
        }

        .btn-login.loading {
            pointer-events: none;
            opacity: .88;
        }

        .btn-login.loading::after {
            content: "";
            width: 17px;
            height: 17px;
            border: 2px solid rgba(255,255,255,.45);
            border-top-color: #ffffff;
            border-radius: 50%;
            position: absolute;
            right: 1rem;
            top: 50%;
            transform: translateY(-50%);
            animation: spin .8s linear infinite;
        }

        .forgot-password-wrapper {
            text-align: center;
            margin-top: 1rem;
        }

        .forgot-password-link {
            color: var(--ns-dark);
            font-size: .86rem;
            font-weight: 700;
            text-decoration: none;
        }

        .forgot-password-link:hover {
            color: var(--ns-orange);
            text-decoration: underline;
        }

        .security-note {
            margin-top: 1.1rem;
            padding: .82rem .9rem;
            border-radius: 12px;
            background: #f8fafc;
            border: 1px solid var(--ns-line);
            color: var(--ns-muted);
            font-size: .76rem;
            line-height: 1.45;
            font-weight: 600;
            display: flex;
            gap: .55rem;
        }

        .security-note i {
            color: var(--ns-orange);
            margin-top: .12rem;
        }

        .footer-section {
            margin-top: 1.3rem;
            padding-top: 1rem;
            border-top: 1px solid var(--ns-line);
            text-align: center;
        }

        .footer-text {
            margin: 0;
            color: #9ca3af;
            font-size: .76rem;
            font-weight: 600;
        }

        @@keyframes spin {
            to {
                transform: translateY(-50%) rotate(360deg);
            }
        }

        @@media (max-width: 900px) {
            .login-layout {
                width: 100%;
                grid-template-columns: 1fr;
            }

            .login-info {
                width: 100%;
                min-height: auto;
                padding: 1.6rem;
                gap: 2rem;
            }

            .info-content {
                max-width: 100%;
            }

            .info-title {
                font-size: 1.8rem;
            }

            .info-footer {
                display: none;
            }

            .login-area {
                min-height: auto;
                padding: 1.2rem;
                align-items: flex-start;
            }

            .v2, .v3, .h2, .h3,
            .line-2, .car-b, .car-c {
                display: none;
            }
        }

        @@media (max-width: 480px) {
            .login-card {
                padding: 1.35rem;
            }

            .module-row {
                grid-template-columns: 1fr;
            }
        }
    </style>
</head>

<body>
    <div class="login-layout">

        <aside class="login-info">
            <div class="brand-block">
                <div class="brand-logo">
                    <img src="~/Imagenes/logo-quell.png" alt="Logo NSQuell" />
                </div>

                <div>
                    <p class="brand-name">NSQuell ERP</p>
                    <p class="brand-system">Sistema interno de operación</p>
                </div>
            </div>

            <div class="info-content">
                <div class="info-label">Manufactura automotriz</div>

                <h2 class="info-title">
                    Control de producción y trazabilidad.
                </h2>

                <p class="info-text">
                    Plataforma para administrar procesos internos de inyección de plásticos, almacén, operación y reportes.
                </p>

                <div class="info-list">
                    <div class="info-item">
                        <i class="fas fa-industry"></i>
                        Producción
                    </div>

                    <div class="info-item">
                        <i class="fas fa-boxes-stacked"></i>
                        Inventario y materiales
                    </div>

                    <div class="info-item">
                        <i class="fas fa-chart-line"></i>
                        Indicadores operativos
                    </div>
                </div>
            </div>

            <div class="info-footer">
                © @DateTime.Now.Year NSQuell. Todos los derechos reservados.
            </div>
        </aside>

        <main class="login-area">

            <div class="executive-bg" aria-hidden="true">
                <span class="grid-line-v v1"></span>
                <span class="grid-line-v v2"></span>
                <span class="grid-line-v v3"></span>

                <span class="grid-line-h h1"></span>
                <span class="grid-line-h h2"></span>
                <span class="grid-line-h h3"></span>

                <span class="tech-line line-1"></span>
                <span class="tech-line line-2"></span>

                <span class="tech-dot dot-1"></span>
                <span class="tech-dot dot-2"></span>
                <span class="tech-dot dot-3"></span>
                <span class="tech-dot dot-4"></span>

                <i class="fas fa-car-side car-outline medium car-a"></i>
                <i class="fas fa-car car-outline large car-b"></i>
                <i class="fas fa-car-side car-outline small car-c"></i>
            </div>

            <section class="login-card">

                <div class="login-header">
                    <h1>Iniciar sesión</h1>
                    <p>Ingresa tus credenciales para acceder al ERP.</p>
                </div>

                <div class="module-row">
                    <div class="module-item">
                        <i class="fas fa-industry"></i>
                        Producción
                    </div>

                    <div class="module-item">
                        <i class="fas fa-boxes-stacked"></i>
                        Almacén
                    </div>

                    <div class="module-item">
                        <i class="fas fa-chart-line"></i>
                        Reportes
                    </div>
                </div>

                @if (TempData["InfoMessage"] != null)
                {
                    <div class="alert alert-info rounded-3 fw-semibold">
                        <i class="fas fa-circle-info me-2"></i>
                        @TempData["InfoMessage"]
                    </div>
                }

                @if (!ViewData.ModelState.IsValid)
                {
                    <div class="alert-custom">
                        <div class="alert-title">
                            <i class="fas fa-exclamation-triangle me-2"></i>
                            Error de autenticación
                        </div>

                        @foreach (var error in ViewData.ModelState.Values.SelectMany(v => v.Errors))
                        {
                            <div class="error-message">@error.ErrorMessage</div>
                        }
                    </div>
                }

                <form asp-action="Login"
                      asp-controller="Login"
                      method="post"
                      novalidate
                      autocomplete="off"
                      class="form-section">

                    @Html.AntiForgeryToken()

                    <div class="input-group-custom">
                        <input asp-for="Username"
                               class="form-control"
                               placeholder=" "
                               autocomplete="username"
                               required />

                        <i class="fas fa-user input-icon"></i>
                        <label asp-for="Username">Usuario</label>
                        <span asp-validation-for="Username" class="validation-error"></span>
                    </div>

                    <div class="input-group-custom password-field">
                        <input asp-for="Password"
                               class="form-control"
                               type="password"
                               placeholder=" "
                               autocomplete="current-password"
                               required
                               id="passwordField" />

                        <i class="fas fa-lock input-icon"></i>
                        <label asp-for="Password">Contraseña</label>

                        <button type="button"
                                class="password-toggle"
                                id="togglePassword"
                                aria-label="Mostrar u ocultar contraseña">
                            <i class="fas fa-eye" id="toggleIcon"></i>
                        </button>

                        <span asp-validation-for="Password" class="validation-error"></span>
                    </div>

                    <button type="submit" class="btn-login" id="loginBtn">
                        <span class="btn-text">
                            <i class="fas fa-right-to-bracket me-2"></i>
                            Ingresar
                        </span>
                    </button>

                    <div class="forgot-password-wrapper">
                        <a href="@Url.Action("RecuperarPassword", "Login")" class="forgot-password-link">
                            ¿Olvidaste tu contraseña?
                        </a>
                    </div>

                    <div class="security-note">
                        <i class="fas fa-shield-halved"></i>
                        <span>
                            Acceso exclusivo para usuarios autorizados.
                        </span>
                    </div>
                </form>

                <div class="footer-section">
                    <p class="footer-text">
                        ERP NSQuell · @DateTime.Now.Year
                    </p>
                </div>

            </section>
        </main>
    </div>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>

    <script>
        document.addEventListener('DOMContentLoaded', function () {
            const form = document.querySelector('form');
            const loginBtn = document.getElementById('loginBtn');
            const inputs = document.querySelectorAll('.form-control');
            const passwordField = document.getElementById('passwordField');
            const togglePassword = document.getElementById('togglePassword');
            const toggleIcon = document.getElementById('toggleIcon');

            if (togglePassword && passwordField && toggleIcon) {
                togglePassword.addEventListener('click', function () {
                    const type = passwordField.getAttribute('type') === 'password' ? 'text' : 'password';
                    passwordField.setAttribute('type', type);

                    if (type === 'text') {
                        toggleIcon.classList.remove('fa-eye');
                        toggleIcon.classList.add('fa-eye-slash');
                    } else {
                        toggleIcon.classList.remove('fa-eye-slash');
                        toggleIcon.classList.add('fa-eye');
                    }
                });
            }

            if (form && loginBtn) {
                form.addEventListener('submit', function () {
                    loginBtn.classList.add('loading');

                    const btnText = loginBtn.querySelector('.btn-text');
                    if (btnText) {
                        btnText.innerHTML = '<i class="fas fa-circle-notch me-2"></i>Validando...';
                    }
                });
            }

            inputs.forEach(input => {
                if (input.value && input.value.length > 0) {
                    input.parentElement.classList.add('has-value');
                }

                input.addEventListener('focus', function () {
                    this.parentElement.classList.add('focused');
                });

                input.addEventListener('blur', function () {
                    this.parentElement.classList.remove('focused');
                });

                input.addEventListener('input', function () {
                    if (this.value.length > 0) {
                        this.parentElement.classList.add('has-value');
                    } else {
                        this.parentElement.classList.remove('has-value');
                    }
                });
            });

            const firstEmptyInput = Array.from(inputs).find(input => !input.value);
            if (firstEmptyInput) {
                setTimeout(() => firstEmptyInput.focus(), 250);
            }
        });
    </script>
</body>
</html>