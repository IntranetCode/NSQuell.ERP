@using System.Globalization
@using EscalaVM = ERP.NSQuell.Models.EscalaPersonal
@model EscalaVM.IndexVM

@{
    ViewData["Title"] = "Escala de Personal";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

@section Styles {
    <link rel="stylesheet" href="~/css/EscalaPersonal/escala-navegacion.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/EscalaPersonal/index.css" asp-append-version="true" />
}


<div class="container-fluid escala-page">
    <partial name="_EscalaNavegacion" />
    <div class="ep-header">
        <div>
            <div class="ep-eyebrow">Recursos Humanos</div>
            <h1 class="ep-title">Escala de Personal</h1>
            <p class="ep-subtitle">
                Programa turnos, funciones y novedades del personal por semana.
            </p>
        </div>

        @if (Model.PuedeAdministrar)
        {
            <a asp-controller="EscalaPersonal"
               asp-action="Crear"
               class="ep-btn-primary">
                <span aria-hidden="true">＋</span>
                Nueva escala
            </a>
        }
    </div>

    @if (TempData["Exito"] != null)
    {
        <div class="ep-alert ep-alert-success" role="alert">
            @TempData["Exito"]
        </div>
    }

    @if (TempData["Error"] != null)
    {
        <div class="ep-alert ep-alert-error" role="alert">
            @TempData["Error"]
        </div>
    }

    @if (Model.EscalaSemanaActual != null)
    {
        var actual = Model.EscalaSemanaActual;
        <section class="ep-current" aria-label="Escala de la semana actual">
            <div>
                <div class="ep-current-label">Semana en curso</div>
                <h2 class="ep-current-title">
                    Semana @actual.NumeroSemana · @actual.Folio
                </h2>
                <p class="ep-current-meta">
                    @actual.FechaInicio.ToString("dd MMM", new CultureInfo("es-MX"))
                    —
                    @actual.FechaFin.ToString("dd MMM yyyy", new CultureInfo("es-MX"))
                    · @actual.TotalPersonas personas · @actual.Estado
                </p>
            </div>
            <div class="ep-current-actions">
                @if (actual.Estado == EscalaVM.Estados.Borrador)
                {
                    <a asp-action="Editor"
                       asp-route-id="@actual.EscalaID"
                       class="ep-btn-light">
                        Continuar edición
                    </a>
                }
                <a asp-action="Detalle"
                   asp-route-id="@actual.EscalaID"
                   class="ep-btn-outline-light">
                    Ver detalle
                </a>
            </div>
        </section>
    }

    <section class="ep-stats" aria-label="Resumen de escalas">
        <article class="ep-stat">
            <div class="ep-stat-head">
                <p class="ep-stat-label">Total de escalas</p>
                <span class="ep-stat-dot" data-nsq-style-id="nsq-si-dc5df9395a"></span>
            </div>
            <div class="ep-stat-value">@Model.Escalas.Count</div>
        </article>
        <article class="ep-stat">
            <div class="ep-stat-head">
                <p class="ep-stat-label">Borradores</p>
                <span class="ep-stat-dot" data-nsq-style-id="nsq-si-ec3cc5f2e4"></span>
            </div>
            <div class="ep-stat-value">@Model.TotalBorradores</div>
        </article>
        <article class="ep-stat">
            <div class="ep-stat-head">
                <p class="ep-stat-label">Publicadas</p>
                <span class="ep-stat-dot" data-nsq-style-id="nsq-si-0c1c5cce5c"></span>
            </div>
            <div class="ep-stat-value">@Model.TotalPublicadas</div>
        </article>
        <article class="ep-stat">
            <div class="ep-stat-head">
                <p class="ep-stat-label">Canceladas</p>
                <span class="ep-stat-dot" data-nsq-style-id="nsq-si-2d50da91fd"></span>
            </div>
            <div class="ep-stat-value">@Model.TotalCanceladas</div>
        </article>
    </section>

    @if (Model.PuedeAdministrar)
    {
        <nav class="ep-tools" aria-label="Configuración del módulo">
            <a asp-action="Turnos" class="ep-tool">
                <span class="ep-tool-mark">TU</span>
                <span>
                    <span class="ep-tool-title">Configurar turnos</span>
                    <span class="ep-tool-text d-block">
                        Edita horarios regulares, mixtos y especiales.
                    </span>
                </span>
            </a>
            <a asp-action="Funciones" class="ep-tool">
                <span class="ep-tool-mark">FR</span>
                <span>
                    <span class="ep-tool-title">Configurar funciones</span>
                    <span class="ep-tool-text d-block">
                        Administra roles y requerimientos por departamento.
                    </span>
                </span>
            </a>
            <a asp-action="Crear" class="ep-tool">
                <span class="ep-tool-mark">NS</span>
                <span>
                    <span class="ep-tool-title">Preparar nueva semana</span>
                    <span class="ep-tool-text d-block">
                        Genera el encabezado y selecciona los turnos aplicables.
                    </span>
                </span>
            </a>
            <a asp-action="Polivalencia" class="ep-tool">
                <span class="ep-tool-mark">PV</span>
                <span>
                    <span class="ep-tool-title">Matriz de polivalencia</span>
                    <span class="ep-tool-text d-block">
                        Consulta operadores evaluados por número de parte y nivel N1–N4.
                    </span>
                </span>
            </a>
        </nav>
    }

    <section class="ep-panel">
        <div class="ep-panel-head">
            <h2 class="ep-panel-title">Programaciones registradas</h2>
            @if (Model.Escalas.Count > 0)
            {
                <div class="ep-filters">
                    <input id="filtroEscalas"
                           class="ep-input"
                           type="search"
                           placeholder="Buscar folio, año o semana"
                           autocomplete="off" />
                    <select id="filtroEstado" class="ep-select">
                        <option value="">Todos los estados</option>
                        <option value="borrador">Borrador</option>
                        <option value="publicada">Publicada</option>
                        <option value="cancelada">Cancelada</option>
                    </select>
                </div>
            }
        </div>

        @if (Model.Escalas.Count == 0)
        {
            <div class="ep-empty">
                <div class="ep-empty-mark">EP</div>
                <div class="ep-empty-title">Todavía no hay escalas registradas</div>
                <div class="ep-empty-text">
                    Crea la primera programación semanal para comenzar a asignar personal.
                </div>
                @if (Model.PuedeAdministrar)
                {
                    <a asp-action="Crear" class="ep-btn-primary">Crear primera escala</a>
                }
            </div>
        }
        else
        {
            <div class="ep-table-wrap">
                <table class="ep-table">
                    <thead>
                        <tr>
                            <th>Folio</th>
                            <th>Semana</th>
                            <th>Periodo</th>
                            <th>Estado</th>
                            <th>Personal</th>
                            <th>Asignaciones</th>
                            <th>Novedades</th>
                            <th>Elaboró</th>
                            <th class="text-end">Acciones</th>
                        </tr>
                    </thead>
                    <tbody id="tablaEscalas">
                        @foreach (var escala in Model.Escalas)
                        {
                            var estadoClase = escala.Estado == EscalaVM.Estados.Publicada
                                ? "ep-badge-published"
                                : escala.Estado == EscalaVM.Estados.Cancelada
                                    ? "ep-badge-cancelled"
                                    : "ep-badge-draft";
                            var textoBusqueda =
                                $"{escala.Folio} {escala.Anio} {escala.NumeroSemana} {escala.Estado}"
                                    .ToLowerInvariant();

                            <tr data-search="@textoBusqueda"
                                data-status="@escala.Estado.ToLowerInvariant()">
                                <td>
                                    <span class="ep-folio">@escala.Folio</span>
                                    <div class="ep-muted">
                                        @escala.CodigoDocumento · V.@escala.VersionDocumento
                                    </div>
                                </td>
                                <td>
                                    <strong>@escala.NumeroSemana</strong>
                                    <span class="ep-muted"> / @escala.Anio</span>
                                </td>
                                <td>
                                    @escala.FechaInicio.ToString("dd/MM/yyyy")
                                    <div class="ep-muted">
                                        al @escala.FechaFin.ToString("dd/MM/yyyy")
                                    </div>
                                </td>
                                <td>
                                    <span class="ep-badge @estadoClase">@escala.Estado</span>
                                </td>
                                <td>@escala.TotalPersonas</td>
                                <td>@escala.TotalAsignaciones</td>
                                <td>@escala.TotalNovedades</td>
                                <td>
                                    @(string.IsNullOrWhiteSpace(escala.ElaboradoPorNombre)
                                        ? "Usuario del sistema"
                                        : escala.ElaboradoPorNombre)
                                    <div class="ep-muted">
                                        @escala.FechaElaboracion.ToString("dd/MM/yyyy")
                                    </div>
                                </td>
                                <td>
                                    <div class="ep-actions">
                                        @if (escala.Estado == EscalaVM.Estados.Borrador
                                            && Model.PuedeAdministrar)
                                        {
                                            <a asp-action="Editor"
                                               asp-route-id="@escala.EscalaID"
                                               class="ep-action">
                                                Editar
                                            </a>
                                            <a asp-action="Novedades"
                                               asp-route-id="@escala.EscalaID"
                                               class="ep-action">
                                                Novedades
                                            </a>
                                        }
                                        <a asp-action="Detalle"
                                           asp-route-id="@escala.EscalaID"
                                           class="ep-action">
                                            Detalle
                                        </a>
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
            <div id="sinResultados" class="ep-empty d-none">
                <div class="ep-empty-title">No se encontraron coincidencias</div>
                <div class="ep-empty-text mb-0">
                    Modifica la búsqueda o selecciona otro estado.
                </div>
            </div>
        }
    </section>
</div>

@section Scripts {
    <script>
        (() => {
            const searchInput = document.getElementById('filtroEscalas');
            const statusSelect = document.getElementById('filtroEstado');
            const rows = Array.from(document.querySelectorAll('#tablaEscalas tr'));
            const emptyMessage = document.getElementById('sinResultados');

            if (!searchInput || !statusSelect || rows.length === 0) {
                return;
            }

            const normalize = value => (value || '')
                .toString()
                .normalize('NFD')
                .replace(/[\u0300-\u036f]/g, '')
                .toLowerCase()
                .trim();

            const applyFilters = () => {
                const term = normalize(searchInput.value);
                const status = normalize(statusSelect.value);
                let visible = 0;

                rows.forEach(row => {
                    const rowText = normalize(row.dataset.search);
                    const rowStatus = normalize(row.dataset.status);
                    const matchesText = !term || rowText.includes(term);
                    const matchesStatus = !status || rowStatus === status;
                    const show = matchesText && matchesStatus;

                    row.classList.toggle('ep-hidden-row', !show);
                    if (show) {
                        visible += 1;
                    }
                });

                if (emptyMessage) {
                    emptyMessage.classList.toggle('d-none', visible > 0);
                }
            };

            searchInput.addEventListener('input', applyFilters);
            statusSelect.addEventListener('change', applyFilters);
        })();
    </script>
}
