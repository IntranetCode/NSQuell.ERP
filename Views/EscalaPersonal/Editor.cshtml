@using System
@using System.Linq
@using EscalaVM = ERP.NSQuell.Models.EscalaPersonal
@model EscalaVM.EditorVM

@{
    ViewData["Title"] = $"Editor {Model.Escala.Folio}";
    Layout = "~/Views/Shared/_Layout.cshtml";

    var todasLasAsignaciones = Model.Grupos
        .SelectMany(g => g.Celdas)
        .SelectMany(c => c.Asignaciones)
        .ToList();

    var totalPersonas = todasLasAsignaciones
        .Select(a => a.PersonalID)
        .Distinct()
        .Count();

    var totalColumnas = Math.Max(3, Model.Turnos.Count + 2);
    var departamentoActual = string.Empty;
}

@section Scripts {
    <script src="~/js/shared/nsq-dynamic-style.js" asp-append-version="true"></script>
}


@section Styles {
    <link rel="stylesheet" href="~/css/EscalaPersonal/escala-navegacion.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/EscalaPersonal/editor.css" asp-append-version="true" />
}


<div class="escala-editor">
    <partial name="_EscalaNavegacion" />
    <div class="ee-header">
        <div>
            <div class="ee-eyebrow">Programación semanal</div>
            <h1 class="ee-title">Editor de Escala de Personal</h1>
            <p class="ee-subtitle">
                Asigna al personal por área, función, máquina y horario de trabajo.
            </p>
        </div>

        <div class="ee-header-actions">
            <a asp-action="Index" class="ee-btn ee-btn-light">Volver</a>
            <a asp-action="Novedades"
               asp-route-id="@Model.Escala.EscalaID"
               class="ee-btn ee-btn-light">
                Novedades (@Model.Novedades.Count)
            </a>
            <a asp-action="Detalle"
               asp-route-id="@Model.Escala.EscalaID"
               class="ee-btn ee-btn-light">
                Vista previa
            </a>

            @if (Model.PuedeEditar)
            {
                <button type="button"
                        class="ee-btn ee-btn-primary"
                        data-open-assignment>
                    Agregar persona
                </button>
            }
        </div>
    </div>

    @if (TempData["Exito"] != null)
    {
        <div class="ee-alert ee-alert-success" role="alert">
            @TempData["Exito"]
        </div>
    }

    @if (TempData["Error"] != null)
    {
        <div class="ee-alert ee-alert-error" role="alert">
            @TempData["Error"]
        </div>
    }

    @if (!Model.PuedeEditar)
    {
        <div class="ee-readonly-note">
            Esta escala está en estado <strong>@Model.Escala.Estado</strong>.
            La información se muestra en modo de consulta.
        </div>
    }

    <section class="ee-summary" aria-label="Resumen de la escala">
        <div class="ee-summary-main">
            <span class="ee-summary-label">Folio de la escala</span>
            <span class="ee-summary-value ee-summary-folio">@Model.Escala.Folio</span>
        </div>
        <div class="ee-summary-item">
            <span class="ee-summary-label">Semana</span>
            <span class="ee-summary-value">
                @Model.Escala.NumeroSemana / @Model.Escala.Anio
            </span>
        </div>
        <div class="ee-summary-item">
            <span class="ee-summary-label">Periodo</span>
            <span class="ee-summary-value">
                @Model.Escala.FechaInicio.ToString("dd/MM") –
                @Model.Escala.FechaFin.ToString("dd/MM/yyyy")
            </span>
        </div>
        <div class="ee-summary-item">
            <span class="ee-summary-label">Documento</span>
            <span class="ee-summary-value">
                @Model.Escala.CodigoDocumento · V@Model.Escala.VersionDocumento
            </span>
        </div>
        <div class="ee-summary-item">
            <span class="ee-summary-label">Elaboración</span>
            <span class="ee-summary-value">
                @Model.Escala.FechaElaboracion.ToString("dd/MM/yyyy")
            </span>
        </div>
        <div class="ee-summary-item">
            <span class="ee-summary-label">Estado</span>
            <span class="ee-status ee-status-@Model.Escala.Estado.ToLowerInvariant()">
                @Model.Escala.Estado
            </span>
        </div>
    </section>

    <section class="ee-kpis" aria-label="Totales">
        <div class="ee-kpi">
            <span class="ee-kpi-mark">P</span>
            <span>
                <span class="ee-kpi-value">@totalPersonas</span>
                <span class="ee-kpi-label">Personas programadas</span>
            </span>
        </div>
        <div class="ee-kpi">
            <span class="ee-kpi-mark">A</span>
            <span>
                <span class="ee-kpi-value">@todasLasAsignaciones.Count</span>
                <span class="ee-kpi-label">Asignaciones activas</span>
            </span>
        </div>
        <div class="ee-kpi">
            <span class="ee-kpi-mark">T</span>
            <span>
                <span class="ee-kpi-value">@Model.Turnos.Count</span>
                <span class="ee-kpi-label">Horarios configurados</span>
            </span>
        </div>
        <div class="ee-kpi">
            <span class="ee-kpi-mark">N</span>
            <span>
                <span class="ee-kpi-value">@Model.Novedades.Count</span>
                <span class="ee-kpi-label">Novedades de la semana</span>
            </span>
        </div>
    </section>

    <div class="ee-toolbar">
        <div class="ee-search">
            <input type="search"
                   id="boardSearch"
                   placeholder="Buscar persona, función o máquina..."
                   autocomplete="off" />
        </div>
        <p class="ee-toolbar-note">
            Los totales se calculan automáticamente con las asignaciones activas.
        </p>
    </div>

    <section class="ee-board">
        <div class="ee-board-head">
            <div>
                <h2 class="ee-board-title">Distribución semanal del personal</h2>
                <p class="ee-board-help">
                    Las columnas corresponden a los horarios creados en esta escala.
                </p>
            </div>

            @if (Model.Escala.Estado == EscalaVM.Estados.Borrador)
            {
                <div class="ee-header-actions">
                    @if (Model.PuedePublicar)
                    {
                        <button type="button"
                                class="ee-btn ee-btn-dark ee-btn-sm"
                                data-open-state="publishModal">
                            Publicar escala
                        </button>
                    }
                    <button type="button"
                            class="ee-btn ee-btn-danger ee-btn-sm"
                            data-open-state="cancelModal">
                        Cancelar escala
                    </button>
                </div>
            }
            else if (Model.Escala.Estado == EscalaVM.Estados.Publicada)
            {
                <button type="button"
                        class="ee-btn ee-btn-light ee-btn-sm"
                        data-open-state="draftModal">
                    Regresar a borrador
                </button>
            }
        </div>

        @if (Model.Turnos.Count == 0)
        {
            <div class="ee-empty">
                <div class="ee-empty-mark">T</div>
                <h3 class="ee-empty-title">La escala no tiene horarios</h3>
                <p class="ee-empty-text">
                    No es posible asignar personal hasta que la escala tenga por lo menos un horario configurado.
                </p>
            </div>
        }
        else if (Model.Grupos.Count == 0)
        {
            <div class="ee-empty">
                <div class="ee-empty-mark">+</div>
                <h3 class="ee-empty-title">Aún no hay personal asignado</h3>
                <p class="ee-empty-text">
                    Comienza agregando una persona y selecciona la función, máquina y horario que le corresponden.
                </p>
                @if (Model.PuedeEditar)
                {
                    <button type="button"
                            class="ee-btn ee-btn-primary"
                            data-open-assignment>
                        Agregar primera persona
                    </button>
                }
            </div>
        }
        else
        {
            <div class="ee-table-wrap">
                <table class="ee-table" id="assignmentBoard">
                    <thead>
                        <tr>
                            <th class="ee-col-role">Función / rol</th>
                            <th class="ee-col-machine">Máquina</th>
                            @foreach (var turno in Model.Turnos.OrderBy(t => t.Orden))
                            {
                                <th class="ee-turn-head"
                                    data-nsq-style="--turn-color: @turno.Color;">
                                    <span class="ee-turn-name">@turno.Nombre</span>
                                    <span class="ee-turn-time">
                                        @turno.HorarioTexto
                                        @if (turno.CruzaDiaSiguiente)
                                        {
                                            <text> · día siguiente</text>
                                        }
                                    </span>
                                </th>
                            }
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var grupo in Model.Grupos)
                        {
                            if (!string.Equals(
                                departamentoActual,
                                grupo.NombreDepartamento,
                                StringComparison.OrdinalIgnoreCase))
                            {
                                departamentoActual = grupo.NombreDepartamento;
                                <tr class="ee-department-row"
                                    data-search-row="@grupo.NombreDepartamento">
                                    <td colspan="@totalColumnas">
                                        @grupo.NombreDepartamento
                                    </td>
                                </tr>
                            }

                            var textoGrupo = string.Join(
                                " ",
                                grupo.NombreDepartamento,
                                grupo.NombreFuncion,
                                grupo.NombreMaquina,
                                string.Join(
                                    " ",
                                    grupo.Celdas
                                        .SelectMany(c => c.Asignaciones)
                                        .Select(a => $"{a.NumeroEmpleado} {a.NombrePersona}")));

                            <tr class="ee-assignment-row"
                                data-search-row="@textoGrupo">
                                <td class="ee-col-role">
                                    <span class="ee-role-name">@grupo.NombreFuncion</span>
                                    <span class="ee-role-meta">
                                        @grupo.Celdas.Sum(c => c.Asignaciones.Count)
                                        asignación(es)
                                    </span>
                                </td>
                                <td class="ee-col-machine">
                                    @if (string.IsNullOrWhiteSpace(grupo.NombreMaquina))
                                    {
                                        <span class="ee-role-meta">No aplica</span>
                                    }
                                    else
                                    {
                                        <span class="ee-role-name">@grupo.NombreMaquina</span>
                                    }
                                </td>

                                @foreach (var celda in grupo.Celdas)
                                {
                                    <td class="ee-cell"
                                        data-nsq-style="--turn-color: @celda.Color;">
                                        <div class="ee-person-list">
                                            @foreach (var asignacion in celda.Asignaciones)
                                            {
                                                <article class="ee-person">
                                                    <div class="ee-person-main">
                                                        <div>
                                                            <p class="ee-person-name">
                                                                @asignacion.NombrePersona
                                                            </p>
                                                            <span class="ee-person-number">
                                                                ID @asignacion.NumeroEmpleado
                                                            </span>
                                                        </div>

                                                        @if (Model.PuedeEditar)
                                                        {
                                                            <div class="ee-person-actions">
                                                                <button type="button"
                                                                        class="ee-icon-btn"
                                                                        title="Editar asignación"
                                                                        data-edit-assignment
                                                                        data-assignment-id="@asignacion.AsignacionID"
                                                                        data-person-id="@asignacion.PersonalID"
                                                                        data-function-id="@asignacion.FuncionID"
                                                                        data-machine-id="@asignacion.MaquinaID"
                                                                        data-turn-id="@asignacion.EscalaTurnoID"
                                                                        data-start="@asignacion.FechaInicio.ToString("yyyy-MM-dd")"
                                                                        data-end="@asignacion.FechaFin.ToString("yyyy-MM-dd")"
                                                                        data-observations="@asignacion.Observaciones">
                                                                    Editar
                                                                </button>
                                                                <form asp-action="EliminarAsignacion"
                                                                      method="post"
                                                                      onsubmit="return confirm('¿Eliminar esta asignación de la escala?');">
                                                                    @Html.AntiForgeryToken()
                                                                    <input type="hidden"
                                                                           name="asignacionID"
                                                                           value="@asignacion.AsignacionID" />
                                                                    <input type="hidden"
                                                                           name="escalaID"
                                                                           value="@Model.Escala.EscalaID" />
                                                                    <button type="submit"
                                                                            class="ee-icon-btn ee-icon-btn-danger"
                                                                            title="Eliminar asignación">
                                                                        Quitar
                                                                    </button>
                                                                </form>
                                                            </div>
                                                        }
                                                    </div>
                                                    <div class="ee-person-dates">
                                                        @if (asignacion.FechaInicio.Date == Model.Escala.FechaInicio.Date
                                                            && asignacion.FechaFin.Date == Model.Escala.FechaFin.Date)
                                                        {
                                                            <text>Toda la semana</text>
                                                        }
                                                        else
                                                        {
                                                            <text>
                                                                @asignacion.FechaInicio.ToString("dd/MM")
                                                                –
                                                                @asignacion.FechaFin.ToString("dd/MM")
                                                            </text>
                                                        }
                                                    </div>
                                                </article>
                                            }
                                        </div>

                                        @if (Model.PuedeEditar)
                                        {
                                            <button type="button"
                                                    class="ee-cell-add"
                                                    data-open-assignment
                                                    data-function-id="@grupo.FuncionID"
                                                    data-machine-id="@grupo.MaquinaID"
                                                    data-turn-id="@celda.EscalaTurnoID">
                                                + Agregar en este horario
                                            </button>
                                        }
                                    </td>
                                }
                            </tr>
                        }
                    </tbody>
                    <tfoot>
                        <tr class="ee-footer-total">
                            <th colspan="2">Total por horario</th>
                            @foreach (var turno in Model.Turnos.OrderBy(t => t.Orden))
                            {
                                var totalTurno = Model.Grupos
                                    .SelectMany(g => g.Celdas)
                                    .Where(c => c.EscalaTurnoID == turno.EscalaTurnoID)
                                    .Sum(c => c.Asignaciones.Count);

                                <td>@totalTurno</td>
                            }
                        </tr>
                    </tfoot>
                </table>
            </div>
        }
    </section>

    <section class="ee-novedades">
        <div class="ee-novedades-head">
            <div>
                <h2 class="ee-board-title">Novedades de la semana</h2>
                <p class="ee-board-help">
                    Ingresos, bajas, incapacidades y vacaciones registradas.
                </p>
            </div>
            <a asp-action="Novedades"
               asp-route-id="@Model.Escala.EscalaID"
               class="ee-btn ee-btn-light ee-btn-sm">
                Administrar novedades
            </a>
        </div>

        @if (Model.Novedades.Count == 0)
        {
            <div class="ee-empty" data-nsq-style-id="nsq-si-6e930cb59a">
                <p class="ee-empty-text" data-nsq-style-id="nsq-si-648149cea2">
                    No hay novedades registradas para esta semana.
                </p>
            </div>
        }
        else
        {
            <div class="ee-novedades-grid">
                @foreach (var novedad in Model.Novedades.Take(8))
                {
                    <article class="ee-novedad">
                        <span class="ee-novedad-type">@novedad.TipoNovedad</span>
                        <span class="ee-novedad-name">@novedad.NombrePersona</span>
                        <span class="ee-novedad-date">
                            @novedad.FechaInicio.ToString("dd/MM/yyyy")
                            @if (novedad.FechaFin.HasValue
                                && novedad.FechaFin.Value.Date != novedad.FechaInicio.Date)
                            {
                                <text> – @novedad.FechaFin.Value.ToString("dd/MM/yyyy")</text>
                            }
                        </span>
                    </article>
                }
            </div>
        }
    </section>

    @if (Model.PuedeEditar)
    {
        <div class="ee-modal"
             id="assignmentModal"
             role="dialog"
             aria-modal="true"
             aria-labelledby="assignmentModalTitle">
            <div class="ee-modal-dialog">
                <form asp-action="GuardarAsignacion"
                      method="post"
                      id="assignmentForm">
                    @Html.AntiForgeryToken()
                    <input type="hidden"
                           name="EscalaID"
                           value="@Model.Escala.EscalaID" />
                    <input type="hidden"
                           name="AsignacionID"
                           id="assignmentId" />

                    <div class="ee-modal-head">
                        <div>
                            <h2 class="ee-modal-title" id="assignmentModalTitle">
                                Agregar persona a la escala
                            </h2>
                            <p class="ee-modal-subtitle">
                                Completa la asignación de trabajo para esta semana.
                            </p>
                        </div>
                        <button type="button"
                                class="ee-modal-close"
                                data-close-modal
                                aria-label="Cerrar">
                            ×
                        </button>
                    </div>

                    <div class="ee-modal-body">
                        <div class="ee-form-grid">
                            <div class="ee-col-12">
                                <label for="personSearch" class="ee-label">
                                    Buscar persona
                                </label>
                                <input type="search"
                                       id="personSearch"
                                       class="ee-control ee-person-search"
                                       placeholder="Escribe el nombre o número..."
                                       autocomplete="off" />

                                <label for="personalId"
                                       class="ee-label ee-label-required">
                                    Persona
                                </label>
                                <select name="PersonalID"
                                        id="personalId"
                                        class="ee-control"
                                        required>
                                    <option value="">Selecciona una persona</option>
                                    @foreach (var persona in Model.Personas)
                                    {
                                        <option value="@persona.PersonalID"
                                                data-search="@($"{persona.NumeroEmpleado} {persona.NombreCompleto} {persona.Puesto}".ToLowerInvariant())">
                                            @persona.Texto
                                            @if (!string.IsNullOrWhiteSpace(persona.Puesto))
                                            {
                                                <text> · @persona.Puesto</text>
                                            }
                                        </option>
                                    }
                                </select>
                            </div>

                            <div class="ee-col-6">
                                <label for="functionId"
                                       class="ee-label ee-label-required">
                                    Función o rol
                                </label>
                                <select name="FuncionID"
                                        id="functionId"
                                        class="ee-control"
                                        required>
                                    <option value="">Selecciona una función</option>
                                    @foreach (var funcion in Model.Funciones.OrderBy(f => f.Orden))
                                    {
                                        <option value="@funcion.FuncionID"
                                                data-requires-machine="@funcion.RequiereMaquina.ToString().ToLowerInvariant()">
                                            @funcion.Nombre
                                        </option>
                                    }
                                </select>
                                <p class="ee-field-help">
                                    Se muestran todas las funciones activas disponibles.
                                </p>
                            </div>

                            <div class="ee-col-6">
                                <label for="machineId" class="ee-label">
                                    Máquina
                                </label>
                                <select name="MaquinaID"
                                        id="machineId"
                                        class="ee-control">
                                    <option value="">No aplica</option>
                                    @foreach (var maquina in Model.Maquinas)
                                    {
                                        <option value="@maquina.MaquinaID"
                                                data-area="@maquina.Area">
                                            @maquina.Texto
                                        </option>
                                    }
                                </select>
                                <p class="ee-machine-required" id="machineRequired">
                                    La función seleccionada requiere una máquina.
                                </p>
                            </div>

                            <div class="ee-col-6">
                                <label for="turnId"
                                       class="ee-label ee-label-required">
                                    Horario
                                </label>
                                <select name="EscalaTurnoID"
                                        id="turnId"
                                        class="ee-control"
                                        required>
                                    <option value="">Selecciona un horario</option>
                                    @foreach (var turno in Model.Turnos.OrderBy(t => t.Orden))
                                    {
                                        <option value="@turno.EscalaTurnoID">
                                            @turno.Nombre · @turno.HorarioTexto
                                        </option>
                                    }
                                </select>
                            </div>

                            <div class="ee-col-6">
                                <label for="startDate"
                                       class="ee-label ee-label-required">
                                    Desde
                                </label>
                                <input type="date"
                                       name="FechaInicio"
                                       id="startDate"
                                       class="ee-control"
                                       min="@Model.Escala.FechaInicio.ToString("yyyy-MM-dd")"
                                       max="@Model.Escala.FechaFin.ToString("yyyy-MM-dd")"
                                       value="@Model.Escala.FechaInicio.ToString("yyyy-MM-dd")"
                                       required />
                            </div>

                            <div class="ee-col-6">
                                <label for="endDate"
                                       class="ee-label ee-label-required">
                                    Hasta
                                </label>
                                <input type="date"
                                       name="FechaFin"
                                       id="endDate"
                                       class="ee-control"
                                       min="@Model.Escala.FechaInicio.ToString("yyyy-MM-dd")"
                                       max="@Model.Escala.FechaFin.ToString("yyyy-MM-dd")"
                                       value="@Model.Escala.FechaFin.ToString("yyyy-MM-dd")"
                                       required />
                            </div>

                            <div class="ee-col-12">
                                <label for="assignmentObservations"
                                       class="ee-label">
                                    Observaciones
                                </label>
                                <textarea name="Observaciones"
                                          id="assignmentObservations"
                                          class="ee-control"
                                          maxlength="500"
                                          placeholder="Información adicional de la asignación..."></textarea>
                            </div>
                        </div>
                    </div>

                    <div class="ee-modal-footer">
                        <button type="button"
                                class="ee-btn ee-btn-light"
                                data-close-modal>
                            Cancelar
                        </button>
                        <button type="submit"
                                class="ee-btn ee-btn-primary"
                                id="saveAssignmentButton">
                            Guardar asignación
                        </button>
                    </div>
                </form>
            </div>
        </div>
    }

    @if (Model.PuedePublicar)
    {
        <div class="ee-modal"
             id="publishModal"
             role="dialog"
             aria-modal="true"
             aria-labelledby="publishModalTitle">
            <div class="ee-modal-dialog ee-modal-sm">
                <form asp-action="Publicar" method="post">
                    @Html.AntiForgeryToken()
                    <input type="hidden"
                           name="escalaID"
                           value="@Model.Escala.EscalaID" />
                    <div class="ee-modal-head">
                        <div>
                            <h2 class="ee-modal-title" id="publishModalTitle">
                                Publicar escala
                            </h2>
                            <p class="ee-modal-subtitle">
                                Después de publicar, la programación quedará bloqueada para edición.
                            </p>
                        </div>
                        <button type="button"
                                class="ee-modal-close"
                                data-close-modal
                                aria-label="Cerrar">
                            ×
                        </button>
                    </div>
                    <div class="ee-modal-body">
                        <label for="publishComment" class="ee-label">
                            Comentario
                        </label>
                        <textarea id="publishComment"
                                  name="comentario"
                                  class="ee-control"
                                  maxlength="500"
                                  placeholder="Comentario opcional de publicación..."></textarea>
                    </div>
                    <div class="ee-modal-footer">
                        <button type="button"
                                class="ee-btn ee-btn-light"
                                data-close-modal>
                            Volver
                        </button>
                        <button type="submit" class="ee-btn ee-btn-dark">
                            Confirmar publicación
                        </button>
                    </div>
                </form>
            </div>
        </div>
    }

    @if (Model.Escala.Estado == EscalaVM.Estados.Borrador)
    {
        <div class="ee-modal"
             id="cancelModal"
             role="dialog"
             aria-modal="true"
             aria-labelledby="cancelModalTitle">
            <div class="ee-modal-dialog ee-modal-sm">
                <form asp-action="Cancelar" method="post">
                    @Html.AntiForgeryToken()
                    <input type="hidden"
                           name="escalaID"
                           value="@Model.Escala.EscalaID" />
                    <div class="ee-modal-head">
                        <div>
                            <h2 class="ee-modal-title" id="cancelModalTitle">
                                Cancelar escala
                            </h2>
                            <p class="ee-modal-subtitle">
                                La escala se conservará en el historial con estado Cancelada.
                            </p>
                        </div>
                        <button type="button"
                                class="ee-modal-close"
                                data-close-modal
                                aria-label="Cerrar">
                            ×
                        </button>
                    </div>
                    <div class="ee-modal-body">
                        <label for="cancelComment" class="ee-label">
                            Motivo o comentario
                        </label>
                        <textarea id="cancelComment"
                                  name="comentario"
                                  class="ee-control"
                                  maxlength="500"
                                  placeholder="Indica el motivo de la cancelación..."></textarea>
                    </div>
                    <div class="ee-modal-footer">
                        <button type="button"
                                class="ee-btn ee-btn-light"
                                data-close-modal>
                            Volver
                        </button>
                        <button type="submit" class="ee-btn ee-btn-danger">
                            Confirmar cancelación
                        </button>
                    </div>
                </form>
            </div>
        </div>
    }

    @if (Model.Escala.Estado == EscalaVM.Estados.Publicada)
    {
        <div class="ee-modal"
             id="draftModal"
             role="dialog"
             aria-modal="true"
             aria-labelledby="draftModalTitle">
            <div class="ee-modal-dialog ee-modal-sm">
                <form asp-action="RegresarABorrador" method="post">
                    @Html.AntiForgeryToken()
                    <input type="hidden"
                           name="escalaID"
                           value="@Model.Escala.EscalaID" />
                    <div class="ee-modal-head">
                        <div>
                            <h2 class="ee-modal-title" id="draftModalTitle">
                                Regresar a borrador
                            </h2>
                            <p class="ee-modal-subtitle">
                                La programación volverá a estar disponible para edición.
                            </p>
                        </div>
                        <button type="button"
                                class="ee-modal-close"
                                data-close-modal
                                aria-label="Cerrar">
                            ×
                        </button>
                    </div>
                    <div class="ee-modal-body">
                        <label for="draftComment" class="ee-label">
                            Motivo del cambio
                        </label>
                        <textarea id="draftComment"
                                  name="comentario"
                                  class="ee-control"
                                  maxlength="500"
                                  placeholder="Describe el ajuste que se realizará..."></textarea>
                    </div>
                    <div class="ee-modal-footer">
                        <button type="button"
                                class="ee-btn ee-btn-light"
                                data-close-modal>
                            Volver
                        </button>
                        <button type="submit" class="ee-btn ee-btn-dark">
                            Regresar a borrador
                        </button>
                    </div>
                </form>
            </div>
        </div>
    }
</div>

<script>
    document.addEventListener('DOMContentLoaded', function () {
        const editor = document.querySelector('.escala-editor');
        if (!editor) {
            return;
        }

        const assignmentModal = document.getElementById('assignmentModal');
        const assignmentForm = document.getElementById('assignmentForm');
        const assignmentId = document.getElementById('assignmentId');
        const modalTitle = document.getElementById('assignmentModalTitle');
        const saveButton = document.getElementById('saveAssignmentButton');
        const personalSelect = document.getElementById('personalId');
        const personSearch = document.getElementById('personSearch');
        const functionSelect = document.getElementById('functionId');
        const machineSelect = document.getElementById('machineId');
        const machineRequired = document.getElementById('machineRequired');
        const turnSelect = document.getElementById('turnId');
        const startDate = document.getElementById('startDate');
        const endDate = document.getElementById('endDate');
        const observations = document.getElementById('assignmentObservations');
        const boardSearch = document.getElementById('boardSearch');
        const scaleStart = '@Model.Escala.FechaInicio.ToString("yyyy-MM-dd")';
        const scaleEnd = '@Model.Escala.FechaFin.ToString("yyyy-MM-dd")';

        function openModal(modal) {
            if (!modal) {
                return;
            }

            modal.classList.add('is-open');
            document.body.classList.add('ee-no-scroll');
        }

        function closeModal(modal) {
            if (!modal) {
                return;
            }

            modal.classList.remove('is-open');
            if (!document.querySelector('.ee-modal.is-open')) {
                document.body.classList.remove('ee-no-scroll');
            }
        }

        function setSelectValue(select, value) {
            if (!select) {
                return;
            }

            select.value = value || '';
        }

        function setFunctionValue(selectedValue) {
            if (!functionSelect) {
                return;
            }

            Array.from(functionSelect.options).forEach(function (option) {
                option.hidden = false;
                option.disabled = false;
            });

            functionSelect.value = selectedValue
                ? String(selectedValue)
                : '';

            updateMachineRequirement();
        }

        function updateMachineRequirement() {
            if (!functionSelect || !machineSelect || !machineRequired) {
                return;
            }

            const selectedOption =
                functionSelect.options[functionSelect.selectedIndex];
            const requiresMachine = selectedOption
                && selectedOption.dataset.requiresMachine === 'true';

            machineSelect.required = Boolean(requiresMachine);
            machineRequired.style.display =
                requiresMachine ? 'block' : 'none';
        }

        function resetAssignmentForm() {
            if (!assignmentForm) {
                return;
            }

            assignmentForm.reset();
            assignmentId.value = '';
            startDate.value = scaleStart;
            endDate.value = scaleEnd;
            modalTitle.textContent = 'Agregar persona a la escala';
            saveButton.textContent = 'Guardar asignación';
            personSearch.value = '';

            if (personalSelect) {
                Array.from(personalSelect.options).forEach(function (option) {
                    option.hidden = false;
                });
            }

            setFunctionValue('');
        }

        function openNewAssignment(button) {
            if (!assignmentModal) {
                return;
            }

            resetAssignmentForm();

            const functionId = button.dataset.functionId || '';
            const machineId = button.dataset.machineId || '';
            const turnId = button.dataset.turnId || '';

            setFunctionValue(functionId);
            setSelectValue(machineSelect, machineId);
            setSelectValue(turnSelect, turnId);
            updateMachineRequirement();

            openModal(assignmentModal);
            window.setTimeout(function () {
                personSearch?.focus();
            }, 50);
        }

        function openEditAssignment(button) {
            if (!assignmentModal) {
                return;
            }

            resetAssignmentForm();

            assignmentId.value = button.dataset.assignmentId || '';
            setSelectValue(personalSelect, button.dataset.personId);
            setFunctionValue(button.dataset.functionId);
            setSelectValue(machineSelect, button.dataset.machineId);
            setSelectValue(turnSelect, button.dataset.turnId);
            startDate.value = button.dataset.start || scaleStart;
            endDate.value = button.dataset.end || scaleEnd;
            observations.value = button.dataset.observations || '';

            modalTitle.textContent = 'Editar asignación';
            saveButton.textContent = 'Guardar cambios';
            updateMachineRequirement();
            openModal(assignmentModal);
        }

        editor.querySelectorAll('[data-open-assignment]').forEach(function (button) {
            button.addEventListener('click', function () {
                openNewAssignment(button);
            });
        });

        editor.querySelectorAll('[data-edit-assignment]').forEach(function (button) {
            button.addEventListener('click', function () {
                openEditAssignment(button);
            });
        });

        editor.querySelectorAll('[data-open-state]').forEach(function (button) {
            button.addEventListener('click', function () {
                openModal(document.getElementById(button.dataset.openState));
            });
        });

        editor.querySelectorAll('[data-close-modal]').forEach(function (button) {
            button.addEventListener('click', function () {
                closeModal(button.closest('.ee-modal'));
            });
        });

        editor.querySelectorAll('.ee-modal').forEach(function (modal) {
            modal.addEventListener('click', function (event) {
                if (event.target === modal) {
                    closeModal(modal);
                }
            });
        });

        document.addEventListener('keydown', function (event) {
            if (event.key === 'Escape') {
                const open = document.querySelector('.ee-modal.is-open');
                closeModal(open);
            }
        });

        functionSelect?.addEventListener('change', updateMachineRequirement);

        personSearch?.addEventListener('input', function () {
            if (!personalSelect) {
                return;
            }

            const term = personSearch.value.trim().toLowerCase();
            Array.from(personalSelect.options).forEach(function (option) {
                if (!option.value) {
                    option.hidden = false;
                    return;
                }

                option.hidden = term.length > 0
                    && !(option.dataset.search || '').includes(term);
            });
        });

        startDate?.addEventListener('change', function () {
            if (endDate && endDate.value < startDate.value) {
                endDate.value = startDate.value;
            }
            if (endDate) {
                endDate.min = startDate.value || scaleStart;
            }
        });

        assignmentForm?.addEventListener('submit', function (event) {
            if (startDate.value > endDate.value) {
                event.preventDefault();
                window.alert(
                    'La fecha final no puede ser anterior a la fecha inicial.');
                endDate.focus();
            }
        });

        boardSearch?.addEventListener('input', function () {
            const term = boardSearch.value.trim().toLowerCase();
            const rows = Array.from(
                document.querySelectorAll('.ee-assignment-row'));

            rows.forEach(function (row) {
                const text = (row.dataset.searchRow || '').toLowerCase();
                row.style.display = !term || text.includes(term)
                    ? ''
                    : 'none';
            });

            const departmentRows = Array.from(
                document.querySelectorAll('.ee-department-row'));

            departmentRows.forEach(function (departmentRow) {
                let next = departmentRow.nextElementSibling;
                let hasVisibleRow = false;

                while (next
                    && !next.classList.contains('ee-department-row')) {
                    if (next.classList.contains('ee-assignment-row')
                        && next.style.display !== 'none') {
                        hasVisibleRow = true;
                    }
                    next = next.nextElementSibling;
                }

                departmentRow.style.display = hasVisibleRow ? '' : 'none';
            });
        });
    });
</script>
