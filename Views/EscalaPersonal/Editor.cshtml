        --ee-primary-dark: #0f263a;
        --ee-primary-soft: #eaf0f5;
        --ee-accent: #e87524;
        --ee-accent-dark: #c95d13;
        --ee-success: #238657;
        --ee-danger: #c93d3d;
        --ee-warning: #b46d00;
        --ee-text: #243447;
        --ee-muted: #6b7a8c;
        --ee-border: #dfe6ed;
