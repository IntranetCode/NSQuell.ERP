        .escala-novedades .en-control,
        .escala-novedades .en-select,
        .escala-novedades .en-textarea {
            background: var(--en-surface);
            border: 1px solid #cfd9e2;
            border-radius: .55rem;
            color: var(--en-text);
            font-size: .8rem;
            min-height: 40px;
            outline: none;
            padding: .55rem .7rem;
            transition: border-color .15s ease, box-shadow .15s ease;
            width: 100%;
        }

            .escala-novedades .en-control:focus,
            .escala-novedades .en-select:focus,
            .escala-novedades .en-textarea:focus {
                border-color: var(--en-accent);
                box-shadow: 0 0 0 3px rgba(232, 117, 36, .12);
            }

        .escala-novedades .en-textarea {
            min-height: 86px;
            resize: vertical;
        }

        .escala-novedades .en-table-wrap {
            overflow-x: auto;
        }

        .escala-novedades .en-table {
            border-collapse: collapse;
            font-size: .78rem;
            min-width: 850px;
            width: 100%;
        }

            .escala-novedades .en-table th {
                background: #f1f5f8;
                border-bottom: 1px solid var(--en-border);
                color: var(--en-primary);
                font-size: .67rem;
                font-weight: 800;
                letter-spacing: .045em;
                padding: .7rem .75rem;
                text-align: left;
                text-transform: uppercase;
                white-space: nowrap;
            }

            .escala-novedades .en-table td {
                border-bottom: 1px solid #e9eef3;
                padding: .78rem .75rem;
                vertical-align: middle;
            }

            .escala-novedades .en-table tbody tr:last-child td {
                border-bottom: 0;
            }

            .escala-novedades .en-table tbody tr:hover {
                background: #fafcfd;
            }

        .escala-novedades .en-person {
            align-items: center;
            display: flex;
            gap: .62rem;
            min-width: 210px;
        }

        .escala-novedades .en-avatar {
