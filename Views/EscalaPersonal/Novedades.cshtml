            border-radius: 50%;
            color: var(--en-primary);
            display: inline-flex;
            flex: 0 0 34px;
            font-size: .72rem;
            font-weight: 850;
            height: 34px;
            justify-content: center;
            text-transform: uppercase;
        }

        .escala-novedades .en-person-name {
            color: var(--en-primary);
            display: block;
            font-weight: 760;
            line-height: 1.25;
        }

        .escala-novedades .en-person-number {
            color: var(--en-muted);
            display: block;
            font-size: .68rem;
            margin-top: .12rem;
        }

        .escala-novedades .en-badge {
            border: 1px solid transparent;
            border-radius: 999px;
            display: inline-flex;
            font-size: .68rem;
            font-weight: 800;
            padding: .28rem .55rem;
            white-space: nowrap;
        }

        .escala-novedades .en-badge-ingreso {
            background: var(--en-success-soft);
            border-color: #c6e7d5;
            color: #17613e;
        }

        .escala-novedades .en-badge-baja {
            background: var(--en-danger-soft);
            border-color: #efcaca;
            color: #8b2929;
        }

        .escala-novedades .en-badge-incapacidad {
            background: var(--en-warning-soft);
            border-color: #efd49f;
            color: #7c4a00;
        }

        .escala-novedades .en-badge-vacaciones {
            background: var(--en-info-soft);
            border-color: #c8dfef;
            color: #255d85;
        }

        .escala-novedades .en-badge-otra {
            background: var(--en-purple-soft);
            border-color: #ddd0ef;
            color: #60428c;
        }

        .escala-novedades .en-date {
            color: var(--en-text);
            white-space: nowrap;
        }

        .escala-novedades .en-date-muted,
        .escala-novedades .en-cell-muted {
            color: var(--en-muted);
        }

        .escala-novedades .en-reason {
