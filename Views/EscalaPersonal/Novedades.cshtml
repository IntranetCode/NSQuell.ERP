        }

        .escala-novedades .en-title {
            color: var(--en-primary);
            font-size: clamp(1.45rem, 2.5vw, 2rem);
            font-weight: 780;
            letter-spacing: -.025em;
            margin: 0;
        }

        .escala-novedades .en-subtitle {
            color: var(--en-muted);
            font-size: .88rem;
            margin: .35rem 0 0;
        }

        .escala-novedades .en-header-actions,
        .escala-novedades .en-modal-actions {
            align-items: center;
            display: flex;
            flex-wrap: wrap;
            gap: .5rem;
            justify-content: flex-end;
        }

        .escala-novedades .en-btn {
