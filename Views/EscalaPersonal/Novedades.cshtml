@using System
@using System.Linq
@using EscalaVM = ERP.NSQuell.Models.EscalaPersonal
@model EscalaVM.NovedadesVM

@{
    ViewData["Title"] = $"Novedades {Model.Escala.Folio}";
    Layout = "_Layout";

    var fechaMinima = Model.Escala.FechaInicio.ToString("yyyy-MM-dd");
    var fechaMaxima = Model.Escala.FechaFin.ToString("yyyy-MM-dd");

    var totalIngresos = Model.Novedades.Count(x =>
        x.TipoNovedad == EscalaVM.TiposNovedad.Ingreso);
    var totalBajas = Model.Novedades.Count(x =>
        x.TipoNovedad == EscalaVM.TiposNovedad.Baja);
    var totalIncapacidades = Model.Novedades.Count(x =>
        x.TipoNovedad == EscalaVM.TiposNovedad.Incapacidad);
    var totalVacaciones = Model.Novedades.Count(x =>
        x.TipoNovedad == EscalaVM.TiposNovedad.Vacaciones);
    var totalOtras = Model.Novedades.Count(x =>
        x.TipoNovedad == EscalaVM.TiposNovedad.Otra);

    var estadoClase = "en-status-draft";
    if (Model.Escala.Estado == EscalaVM.Estados.Publicada)
    {
        estadoClase = "en-status-published";
    }
    else if (Model.Escala.Estado == EscalaVM.Estados.Cancelada)
    {
        estadoClase = "en-status-cancelled";
    }
}

<style>
    .escala-novedades {
        --en-primary: #17324d;
        --en-primary-dark: #0f263a;
        --en-primary-soft: #eaf0f5;
        --en-accent: #e87524;
        --en-accent-dark: #c95d13;
        --en-success: #238657;
        --en-success-soft: #edf8f2;
        --en-danger: #c93d3d;
        --en-danger-soft: #fff0f0;
        --en-warning: #b46d00;
        --en-warning-soft: #fff6e7;
        --en-info: #2d6f9f;
        --en-info-soft: #edf6fc;
        --en-purple: #7451a6;
        --en-purple-soft: #f4effb;
        --en-text: #243447;
        --en-muted: #6b7a8c;
        --en-border: #dfe6ed;
        --en-surface: #ffffff;
        --en-bg: #f5f7fa;
        color: var(--en-text);
        padding: 1.35rem 0 2.5rem;
    }

