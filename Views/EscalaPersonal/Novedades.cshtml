            color: #774c00;
        }

        .escala-novedades .en-status-published {
            background: #d8f3e5;
            color: #17613e;
        }

        .escala-novedades .en-status-cancelled {
            background: #f8dada;
            color: #8b2929;
        }

        .escala-novedades .en-kpis {
            display: grid;
            gap: .75rem;
            grid-template-columns: repeat(5, minmax(0, 1fr));
            margin-bottom: 1rem;
        }

        .escala-novedades .en-kpi {
            background: var(--en-surface);
            border: 1px solid var(--en-border);
            border-radius: .78rem;
            box-shadow: 0 6px 18px rgba(23, 50, 77, .05);
            min-width: 0;
            overflow: hidden;
            padding: .82rem .9rem .82rem 1rem;
            position: relative;
        }

            .escala-novedades .en-kpi::before {
                background: var(--kpi-color);
                bottom: 0;
                content: "";
                left: 0;
                position: absolute;
                top: 0;
                width: 4px;
            }

        .escala-novedades .en-kpi-ingreso {
            --kpi-color: var(--en-success);
        }

        .escala-novedades .en-kpi-baja {
            --kpi-color: var(--en-danger);
        }

        .escala-novedades .en-kpi-incapacidad {
            --kpi-color: var(--en-warning);
        }

        .escala-novedades .en-kpi-vacaciones {
            --kpi-color: var(--en-info);
        }

        .escala-novedades .en-kpi-otra {
            --kpi-color: var(--en-purple);
        }

        .escala-novedades .en-kpi-label {
            color: var(--en-muted);
            display: block;
            font-size: .68rem;
            font-weight: 750;
            margin-bottom: .18rem;
            text-transform: uppercase;
        }

        .escala-novedades .en-kpi-value {
            color: var(--en-primary);
            display: block;
            font-size: 1.4rem;
            font-weight: 800;
            line-height: 1;
        }

        .escala-novedades .en-panel {
            background: var(--en-surface);
            border: 1px solid var(--en-border);
            border-radius: .85rem;
            box-shadow: 0 8px 22px rgba(23, 50, 77, .06);
            overflow: hidden;
        }

        .escala-novedades .en-panel-head {
            align-items: center;
            border-bottom: 1px solid var(--en-border);
            display: flex;
            gap: 1rem;
            justify-content: space-between;
            padding: .9rem 1rem;
        }

        .escala-novedades .en-panel-title {
            color: var(--en-primary);
            font-size: .98rem;
            font-weight: 780;
            margin: 0;
        }

        .escala-novedades .en-panel-subtitle {
            color: var(--en-muted);
            font-size: .75rem;
