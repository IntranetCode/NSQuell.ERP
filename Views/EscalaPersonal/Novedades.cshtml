            display: block;
            font-size: .68rem;
            line-height: 1.35;
            margin-top: .16rem;
        }

        .escala-novedades .en-actions {
            align-items: center;
            display: flex;
            gap: .35rem;
            justify-content: flex-end;
            white-space: nowrap;
        }

        .escala-novedades .en-empty {
            padding: 3.3rem 1.2rem;
