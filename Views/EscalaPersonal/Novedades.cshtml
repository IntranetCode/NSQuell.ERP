@using System
@using System.Linq
@using EscalaVM = ERP.NSQuell.Models.EscalaPersonal
@model EscalaVM.NovedadesVM

@{
    ViewData["Title"] = $"Novedades {Model.Escala.Folio}";
    Layout = "~/Views/Shared/_Layout.cshtml";

    var fechaMinima = Model.Escala.FechaInicio.ToString("yyyy-MM-dd");
    var fechaMaxima = Model.Escala.FechaFin.ToString("yyyy-MM-dd");

    var totalIngresos = Model.Novedades.Count(x =>
        x.TipoNovedad == EscalaVM.TiposNovedad.Ingreso);
    var totalBajas = Model.Novedades.Count(x =>
        x.TipoNovedad == EscalaVM.TiposNovedad.Baja);
    var totalIncapacidades = Model.Novedades.Count(x =>
        x.TipoNovedad == EscalaVM.TiposNovedad.Incapacidad);
    var totalVacaciones = Model.Novedades.Count(x =>
        x.TipoNovedad == EscalaVM.TiposNovedad.Vacaciones);
    var totalOtras = Model.Novedades.Count(x =>
        x.TipoNovedad == EscalaVM.TiposNovedad.Otra);

    var estadoClase = "en-status-draft";
    if (Model.Escala.Estado == EscalaVM.Estados.Publicada)
    {
        estadoClase = "en-status-published";
    }
    else if (Model.Escala.Estado == EscalaVM.Estados.Cancelada)
    {
        estadoClase = "en-status-cancelled";
    }
}

@section Styles {
    <link rel="stylesheet" href="~/css/EscalaPersonal/escala-navegacion.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/EscalaPersonal/novedades.css" asp-append-version="true" />
}


<div class="escala-novedades" id="novedadesPage">
    <partial name="_EscalaNavegacion" />
    <header class="en-header">
        <div>
            <div class="en-eyebrow">Escala de personal</div>
            <h1 class="en-title">Novedades de la semana</h1>
            <p class="en-subtitle">
                Registra ingresos, bajas, incapacidades, vacaciones y otras incidencias del personal.
            </p>
        </div>

        <div class="en-header-actions">
            <a asp-action="Editor"
               asp-route-id="@Model.Escala.EscalaID"
               class="en-btn en-btn-light">
                Volver al editor
            </a>
            <a asp-action="Detalle"
               asp-route-id="@Model.Escala.EscalaID"
               class="en-btn en-btn-light">
                Ver detalle
            </a>
            @if (Model.PuedeEditar)
            {
                <button type="button"
                        class="en-btn en-btn-primary"
                        data-new-novedad>
                    Registrar novedad
                </button>
            }
        </div>
    </header>

    @if (TempData["Exito"] != null)
    {
        <div class="en-alert en-alert-success" role="alert">
            @TempData["Exito"]
        </div>
    }

    @if (TempData["Error"] != null)
    {
        <div class="en-alert en-alert-error" role="alert">
            @TempData["Error"]
        </div>
    }

    @if (!Model.PuedeEditar)
    {
        <div class="en-readonly">
            <span class="en-readonly-icon">i</span>
            <div>
                <strong>Escala en modo de consulta</strong>
                <p>
                    Solo las escalas en estado Borrador permiten registrar, modificar o eliminar novedades.
                </p>
            </div>
        </div>
    }

    <section class="en-summary" aria-label="Resumen de la escala">
        <div class="en-summary-item en-summary-main">
            <span class="en-summary-label">Folio de escala</span>
            <span class="en-summary-value en-summary-folio">@Model.Escala.Folio</span>
        </div>
        <div class="en-summary-item">
            <span class="en-summary-label">Estado</span>
            <span class="en-status @estadoClase">@Model.Escala.Estado</span>
        </div>
        <div class="en-summary-item">
            <span class="en-summary-label">Semana</span>
            <span class="en-summary-value">@Model.Escala.NumeroSemana / @Model.Escala.Anio</span>
        </div>
        <div class="en-summary-item">
            <span class="en-summary-label">Periodo</span>
            <span class="en-summary-value">
                @Model.Escala.FechaInicio.ToString("dd/MM/yyyy") -
                @Model.Escala.FechaFin.ToString("dd/MM/yyyy")
            </span>
        </div>
        <div class="en-summary-item">
            <span class="en-summary-label">Total de novedades</span>
            <span class="en-summary-value">@Model.Novedades.Count registro(s)</span>
        </div>
    </section>

    <section class="en-kpis" aria-label="Novedades por tipo">
        <article class="en-kpi en-kpi-ingreso">
            <span class="en-kpi-label">Ingresos</span>
            <span class="en-kpi-value">@totalIngresos</span>
        </article>
        <article class="en-kpi en-kpi-baja">
            <span class="en-kpi-label">Bajas</span>
            <span class="en-kpi-value">@totalBajas</span>
        </article>
        <article class="en-kpi en-kpi-incapacidad">
            <span class="en-kpi-label">Incapacidades</span>
            <span class="en-kpi-value">@totalIncapacidades</span>
        </article>
        <article class="en-kpi en-kpi-vacaciones">
            <span class="en-kpi-label">Vacaciones</span>
            <span class="en-kpi-value">@totalVacaciones</span>
        </article>
        <article class="en-kpi en-kpi-otra">
            <span class="en-kpi-label">Otras</span>
            <span class="en-kpi-value">@totalOtras</span>
        </article>
    </section>

    <section class="en-panel">
        <div class="en-panel-head">
            <div>
                <h2 class="en-panel-title">Registros de la escala</h2>
                <p class="en-panel-subtitle">
                    Consulta y administra las incidencias registradas durante el periodo.
                </p>
            </div>
            <div class="en-tools">
                <input type="search"
                       id="novedadSearch"
                       class="en-control"
                       placeholder="Buscar por persona, número o motivo..."
                       autocomplete="off" />
                <select id="novedadTypeFilter" class="en-select">
                    <option value="">Todos los tipos</option>
                    <option value="@EscalaVM.TiposNovedad.Ingreso">Ingreso</option>
                    <option value="@EscalaVM.TiposNovedad.Baja">Baja</option>
                    <option value="@EscalaVM.TiposNovedad.Incapacidad">Incapacidad</option>
                    <option value="@EscalaVM.TiposNovedad.Vacaciones">Vacaciones</option>
                    <option value="@EscalaVM.TiposNovedad.Otra">Otra</option>
                </select>
            </div>
        </div>

        @if (Model.Novedades.Any())
        {
            <div class="en-table-wrap">
                <table class="en-table">
                    <thead>
                        <tr>
                            <th>Persona</th>
                            <th>Tipo</th>
                            <th>Fecha inicial</th>
                            <th>Fecha final</th>
                            <th>Motivo / observaciones</th>
                            @if (Model.PuedeEditar)
                            {
                                <th data-nsq-style-id="nsq-si-a527bac1ee">Acciones</th>
                            }
                        </tr>
                    </thead>
                    <tbody id="novedadesBody">
                        @foreach (var novedad in Model.Novedades)
                        {
                            var badgeClass = "en-badge-otra";
                            if (novedad.TipoNovedad == EscalaVM.TiposNovedad.Ingreso)
                            {
                                badgeClass = "en-badge-ingreso";
                            }
                            else if (novedad.TipoNovedad == EscalaVM.TiposNovedad.Baja)
                            {
                                badgeClass = "en-badge-baja";
                            }
                            else if (novedad.TipoNovedad == EscalaVM.TiposNovedad.Incapacidad)
                            {
                                badgeClass = "en-badge-incapacidad";
                            }
                            else if (novedad.TipoNovedad == EscalaVM.TiposNovedad.Vacaciones)
                            {
                                badgeClass = "en-badge-vacaciones";
                            }

                            var partesNombre = (novedad.NombrePersona ?? string.Empty)
                                .Split(' ', StringSplitOptions.RemoveEmptyEntries);
                            var iniciales = partesNombre.Length == 0
                                ? "?"
                                : string.Concat(partesNombre.Take(2).Select(x => x[0]));
                            var textoBusqueda = string.Join(
                                " ",
                                novedad.NombrePersona,
                                novedad.NumeroEmpleado,
                                novedad.TipoNovedad,
                                novedad.Motivo,
                                novedad.Observaciones).ToLowerInvariant();

                            <tr data-novedad-row
                                data-type="@novedad.TipoNovedad"
                                data-search="@textoBusqueda">
                                <td>
                                    <div class="en-person">
                                        <span class="en-avatar">@iniciales</span>
                                        <span>
                                            <span class="en-person-name">@novedad.NombrePersona</span>
                                            <span class="en-person-number">
                                                ID @novedad.NumeroEmpleado
                                            </span>
                                        </span>
                                    </div>
                                </td>
                                <td>
                                    <span class="en-badge @badgeClass">
                                        @novedad.TipoNovedad
                                    </span>
                                </td>
                                <td>
                                    <span class="en-date">
                                        @novedad.FechaInicio.ToString("dd/MM/yyyy")
                                    </span>
                                </td>
                                <td>
                                    @if (novedad.TipoNovedad == EscalaVM.TiposNovedad.Baja)
                                    {
                                        <span class="en-cell-muted">No aplica</span>
                                    }
                                    else if (novedad.FechaFin.HasValue)
                                    {
                                        <span class="en-date">
                                            @novedad.FechaFin.Value.ToString("dd/MM/yyyy")
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="en-cell-muted">Sin fecha final</span>
                                    }
                                </td>
                                <td>
                                    <div class="en-reason">
                                        <span class="en-reason-main">
                                            @(string.IsNullOrWhiteSpace(novedad.Motivo)
                                                ? "Sin motivo especificado"
                                                : novedad.Motivo)
                                        </span>
                                        @if (!string.IsNullOrWhiteSpace(novedad.Observaciones))
                                        {
                                            <span class="en-reason-note">
                                                @novedad.Observaciones
                                            </span>
                                        }
                                    </div>
                                </td>
                                @if (Model.PuedeEditar)
                                {
                                    <td>
                                        <div class="en-actions">
                                            <button type="button"
                                                    class="en-btn en-btn-light en-btn-icon"
                                                    data-edit-novedad
                                                    data-id="@novedad.NovedadID"
                                                    data-person="@novedad.PersonalID"
                                                    data-type="@novedad.TipoNovedad"
                                                    data-start="@novedad.FechaInicio.ToString("yyyy-MM-dd")"
                                                    data-end="@(novedad.FechaFin?.ToString("yyyy-MM-dd") ?? string.Empty)"
                                                    data-reason="@novedad.Motivo"
                                                    data-notes="@novedad.Observaciones">
                                                Editar
                                            </button>
                                            <button type="button"
                                                    class="en-btn en-btn-danger en-btn-icon"
                                                    data-delete-novedad
                                                    data-id="@novedad.NovedadID"
                                                    data-name="@novedad.NombrePersona"
                                                    data-type="@novedad.TipoNovedad">
                                                Eliminar
                                            </button>
                                        </div>
                                    </td>
                                }
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
            <div class="en-no-results" id="novedadesNoResults">
                No hay novedades que coincidan con la búsqueda o el filtro seleccionado.
            </div>
        }
        else
        {
            <div class="en-empty">
                <span class="en-empty-icon">0</span>
                <h3 class="en-empty-title">Aún no hay novedades registradas</h3>
                <p class="en-empty-text">
                    Esta escala no tiene ingresos, bajas, incapacidades, vacaciones
                    ni otras incidencias durante el periodo.
                </p>
                @if (Model.PuedeEditar)
                {
                    <button type="button"
                            class="en-btn en-btn-primary"
                            data-nsq-style-id="nsq-si-27320245e9"
                            data-new-novedad>
                        Registrar la primera novedad
                    </button>
                }
            </div>
        }
    </section>

    @if (Model.PuedeEditar)
    {
        <div class="en-modal"
             id="novedadModal"
             role="dialog"
             aria-modal="true"
             aria-labelledby="novedadModalTitle"
             aria-hidden="true">
            <div class="en-modal-dialog">
                <form asp-action="GuardarNovedad"
                      method="post"
                      id="novedadForm">
                    @Html.AntiForgeryToken()
                    <input type="hidden"
                           name="EscalaID"
                           value="@Model.Escala.EscalaID" />
                    <input type="hidden"
                           name="NovedadID"
                           id="novedadId" />

                    <div class="en-modal-head">
                        <div>
                            <h2 class="en-modal-title" id="novedadModalTitle">
                                Registrar novedad
                            </h2>
                            <p class="en-modal-subtitle">
                                Las fechas deben encontrarse dentro del periodo
                                @Model.Escala.FechaInicio.ToString("dd/MM/yyyy") -
                                @Model.Escala.FechaFin.ToString("dd/MM/yyyy").
                            </p>
                        </div>
                        <button type="button"
                                class="en-modal-close"
                                data-close-modal
                                aria-label="Cerrar">
                            ×
                        </button>
                    </div>

                    <div class="en-modal-body">
                        <div class="en-form-grid">
                            <div class="en-field en-col-12">
                                <label for="personaSearch">
                                    Buscar persona
                                </label>
                                <input type="search"
                                       id="personaSearch"
                                       class="en-control"
                                       placeholder="Escribe el nombre, número de empleado o puesto..."
                                       autocomplete="off" />
                                <span class="en-field-help">
                                    La búsqueda reduce las opciones disponibles en el selector.
                                </span>
                            </div>

                            <div class="en-field en-col-8">
                                <label for="personalId">
                                    Persona <span class="en-required">*</span>
                                </label>
                                <select name="PersonalID"
                                        id="personalId"
                                        class="en-select"
                                        required>
                                    <option value="">Selecciona una persona</option>
                                    @foreach (var persona in Model.Personas)
                                    {
                                        <option value="@persona.PersonalID"
                                                data-search="@($"{persona.NumeroEmpleado} {persona.NombreCompleto} {persona.Puesto} {persona.NombreDepartamento}".ToLowerInvariant())">
                                            @persona.Texto
                                            @if (!string.IsNullOrWhiteSpace(persona.Puesto))
                                            {
                                                <text> · @persona.Puesto</text>
                                            }
                                        </option>
                                    }
                                </select>
                            </div>

                            <div class="en-field en-col-4">
                                <label for="tipoNovedad">
                                    Tipo <span class="en-required">*</span>
                                </label>
                                <select name="TipoNovedad"
                                        id="tipoNovedad"
                                        class="en-select"
                                        required>
                                    <option value="">Selecciona un tipo</option>
                                    <option value="@EscalaVM.TiposNovedad.Ingreso">Ingreso</option>
                                    <option value="@EscalaVM.TiposNovedad.Baja">Baja</option>
                                    <option value="@EscalaVM.TiposNovedad.Incapacidad">Incapacidad</option>
                                    <option value="@EscalaVM.TiposNovedad.Vacaciones">Vacaciones</option>
                                    <option value="@EscalaVM.TiposNovedad.Otra">Otra</option>
                                </select>
                            </div>

                            <div class="en-field en-col-6">
                                <label for="fechaInicio">
                                    Fecha inicial <span class="en-required">*</span>
                                </label>
                                <input type="date"
                                       name="FechaInicio"
                                       id="fechaInicio"
                                       class="en-control"
                                       min="@fechaMinima"
                                       max="@fechaMaxima"
                                       required />
                            </div>

                            <div class="en-field en-col-6" id="fechaFinField">
                                <label for="fechaFin">Fecha final</label>
                                <input type="date"
                                       name="FechaFin"
                                       id="fechaFin"
                                       class="en-control"
                                       min="@fechaMinima"
                                       max="@fechaMaxima" />
                                <span class="en-field-help">
                                    Déjala vacía cuando la novedad corresponda a un solo día.
                                </span>
                            </div>

                            <div class="en-field en-col-6">
                                <label for="motivo">Motivo</label>
                                <input type="text"
                                       name="Motivo"
                                       id="motivo"
                                       class="en-control"
                                       maxlength="300"
                                       placeholder="Motivo breve de la novedad" />
                            </div>

                            <div class="en-field en-col-6">
                                <label for="observaciones">Observaciones</label>
                                <textarea name="Observaciones"
                                          id="observaciones"
                                          class="en-textarea"
                                          maxlength="500"
                                          placeholder="Información adicional para RR. HH. o Planeación"></textarea>
                            </div>
                        </div>

                        <div class="en-type-help" id="typeHelp">
                            Selecciona el tipo de novedad para ver la indicación correspondiente.
                        </div>
                    </div>

                    <div class="en-modal-footer">
                        <button type="button"
                                class="en-btn en-btn-light"
                                data-close-modal>
                            Cancelar
                        </button>
                        <button type="submit"
                                class="en-btn en-btn-primary"
                                id="saveNovedadButton">
                            Guardar novedad
                        </button>
                    </div>
                </form>
            </div>
        </div>

        <div class="en-modal"
             id="deleteModal"
             role="dialog"
             aria-modal="true"
             aria-labelledby="deleteModalTitle"
             aria-hidden="true">
            <div class="en-modal-dialog en-modal-small">
                <form asp-action="EliminarNovedad"
                      method="post">
                    @Html.AntiForgeryToken()
                    <input type="hidden"
                           name="escalaID"
                           value="@Model.Escala.EscalaID" />
                    <input type="hidden"
                           name="novedadID"
                           id="deleteNovedadId" />

                    <div class="en-modal-head">
                        <div>
                            <h2 class="en-modal-title" id="deleteModalTitle">
                                Eliminar novedad
                            </h2>
                            <p class="en-modal-subtitle">
                                Confirma la eliminación del registro seleccionado.
                            </p>
                        </div>
                        <button type="button"
                                class="en-modal-close"
                                data-close-modal
                                aria-label="Cerrar">
                            ×
                        </button>
                    </div>

                    <div class="en-modal-body">
                        <p class="en-delete-text">
                            Se eliminará la novedad
                            <strong id="deleteNovedadType"></strong>
                            de
                            <span class="en-delete-name" id="deleteNovedadName"></span>.
                            Esta acción retirará el registro de la escala.
                        </p>
                    </div>

                    <div class="en-modal-footer">
                        <button type="button"
                                class="en-btn en-btn-light"
                                data-close-modal>
                            Conservar
                        </button>
                        <button type="submit"
                                class="en-btn en-btn-danger">
                            Sí, eliminar
                        </button>
                    </div>
                </form>
            </div>
        </div>
    }
</div>

@section Scripts {
    <script>
        (function () {
            'use strict';

            const page = document.getElementById('novedadesPage');
            if (!page) {
                return;
            }

            const searchInput = document.getElementById('novedadSearch');
            const typeFilter = document.getElementById('novedadTypeFilter');
            const rows = Array.from(page.querySelectorAll('[data-novedad-row]'));
            const noResults = document.getElementById('novedadesNoResults');

            function normalize(value) {
                return (value || '')
                    .toString()
                    .normalize('NFD')
                    .replace(/[\u0300-\u036f]/g, '')
                    .toLowerCase()
                    .trim();
            }

            function filterRows() {
                const term = normalize(searchInput ? searchInput.value : '');
                const selectedType = typeFilter ? typeFilter.value : '';
                let visible = 0;

                rows.forEach(function (row) {
                    const searchText = normalize(row.dataset.search);
                    const rowType = row.dataset.type || '';
                    const matchesText = !term || searchText.includes(term);
                    const matchesType = !selectedType || rowType === selectedType;
                    const shouldShow = matchesText && matchesType;

                    row.hidden = !shouldShow;
                    if (shouldShow) {
                        visible += 1;
                    }
                });

                if (noResults) {
                    noResults.style.display = rows.length > 0 && visible === 0
                        ? 'block'
                        : 'none';
                }
            }

            if (searchInput) {
                searchInput.addEventListener('input', filterRows);
            }

            if (typeFilter) {
                typeFilter.addEventListener('change', filterRows);
            }

            const novedadModal = document.getElementById('novedadModal');
            const deleteModal = document.getElementById('deleteModal');
            const form = document.getElementById('novedadForm');
            const modalTitle = document.getElementById('novedadModalTitle');
            const saveButton = document.getElementById('saveNovedadButton');
            const novedadId = document.getElementById('novedadId');
            const personaSelect = document.getElementById('personalId');
            const personaSearch = document.getElementById('personaSearch');
            const typeSelect = document.getElementById('tipoNovedad');
            const startInput = document.getElementById('fechaInicio');
            const endInput = document.getElementById('fechaFin');
            const endField = document.getElementById('fechaFinField');
            const reasonInput = document.getElementById('motivo');
            const notesInput = document.getElementById('observaciones');
            const typeHelp = document.getElementById('typeHelp');
            const minDate = '@fechaMinima';

            function openModal(modal) {
                if (!modal) {
                    return;
                }

                modal.classList.add('is-open');
                modal.setAttribute('aria-hidden', 'false');
                document.body.classList.add('en-modal-open');
            }

            function closeModal(modal) {
                if (!modal) {
                    return;
                }

                modal.classList.remove('is-open');
                modal.setAttribute('aria-hidden', 'true');

                if (!page.querySelector('.en-modal.is-open')) {
                    document.body.classList.remove('en-modal-open');
                }
            }

            function updateTypeRules() {
                if (!typeSelect || !endInput || !endField || !typeHelp) {
                    return;
                }

                const selectedType = typeSelect.value;
                const isBaja = selectedType === '@EscalaVM.TiposNovedad.Baja';

                endInput.disabled = isBaja;
                endField.style.opacity = isBaja ? '.55' : '1';
                if (isBaja) {
                    endInput.value = '';
                }

                const helpByType = {
                    '@EscalaVM.TiposNovedad.Ingreso':
                        'Ingreso: registra la fecha desde la que la persona se incorpora a la escala.',
                    '@EscalaVM.TiposNovedad.Baja':
                        'Baja: solo requiere fecha inicial; la fecha final no aplica.',
                    '@EscalaVM.TiposNovedad.Incapacidad':
                        'Incapacidad: captura el intervalo cubierto por el documento correspondiente.',
                    '@EscalaVM.TiposNovedad.Vacaciones':
                        'Vacaciones: indica el primer y último día dentro del periodo de esta escala.',
                    '@EscalaVM.TiposNovedad.Otra':
                        'Otra: describe claramente el motivo y agrega observaciones cuando sea necesario.'
                };

                typeHelp.textContent = helpByType[selectedType]
                    || 'Selecciona el tipo de novedad para ver la indicación correspondiente.';
            }

            function restorePersonOptions() {
                if (!personaSelect) {
                    return;
                }

                Array.from(personaSelect.options).forEach(function (option, index) {
                    option.hidden = false;
                    if (index > 0) {
                        option.disabled = false;
                    }
                });
            }

            function filterPersonOptions() {
                if (!personaSelect || !personaSearch) {
                    return;
                }

                const term = normalize(personaSearch.value);
                const currentValue = personaSelect.value;

                Array.from(personaSelect.options).forEach(function (option, index) {
                    if (index === 0) {
                        option.hidden = false;
                        return;
                    }

                    const matches = !term
                        || normalize(option.dataset.search || option.textContent).includes(term);
                    const isSelected = option.value === currentValue;

                    option.hidden = !matches && !isSelected;
                    option.disabled = !matches && !isSelected;
                });
            }

            function resetForm() {
                if (!form) {
                    return;
                }

                form.reset();
                if (novedadId) {
                    novedadId.value = '';
                }
                if (startInput) {
                    startInput.value = minDate;
                }
                if (personaSearch) {
                    personaSearch.value = '';
                }

                restorePersonOptions();
                updateTypeRules();
            }

            function openNewNovedad() {
                resetForm();
                if (modalTitle) {
                    modalTitle.textContent = 'Registrar novedad';
                }
                if (saveButton) {
                    saveButton.textContent = 'Guardar novedad';
                }
                openModal(novedadModal);
                window.setTimeout(function () {
                    if (personaSearch) {
                        personaSearch.focus();
                    }
                }, 40);
            }

            page.querySelectorAll('[data-new-novedad]').forEach(function (button) {
                button.addEventListener('click', openNewNovedad);
            });

            page.querySelectorAll('[data-edit-novedad]').forEach(function (button) {
                button.addEventListener('click', function () {
                    resetForm();

                    if (novedadId) {
                        novedadId.value = button.dataset.id || '';
                    }
                    if (personaSelect) {
                        personaSelect.value = button.dataset.person || '';
                    }
                    if (typeSelect) {
                        typeSelect.value = button.dataset.type || '';
                    }
                    if (startInput) {
                        startInput.value = button.dataset.start || minDate;
                    }
                    if (endInput) {
                        endInput.value = button.dataset.end || '';
                    }
                    if (reasonInput) {
                        reasonInput.value = button.dataset.reason || '';
                    }
                    if (notesInput) {
                        notesInput.value = button.dataset.notes || '';
                    }
                    if (modalTitle) {
                        modalTitle.textContent = 'Editar novedad';
                    }
                    if (saveButton) {
                        saveButton.textContent = 'Guardar cambios';
                    }

                    updateTypeRules();
                    openModal(novedadModal);
                });
            });

            page.querySelectorAll('[data-delete-novedad]').forEach(function (button) {
                button.addEventListener('click', function () {
                    const idInput = document.getElementById('deleteNovedadId');
                    const typeText = document.getElementById('deleteNovedadType');
                    const nameText = document.getElementById('deleteNovedadName');

                    if (idInput) {
                        idInput.value = button.dataset.id || '';
                    }
                    if (typeText) {
                        typeText.textContent = button.dataset.type || '';
                    }
                    if (nameText) {
                        nameText.textContent = button.dataset.name || '';
                    }

                    openModal(deleteModal);
                });
            });

            if (personaSearch) {
                personaSearch.addEventListener('input', filterPersonOptions);
            }

            if (typeSelect) {
                typeSelect.addEventListener('change', updateTypeRules);
            }

            if (startInput && endInput) {
                startInput.addEventListener('change', function () {
                    endInput.min = startInput.value || minDate;
                    if (endInput.value && endInput.value < endInput.min) {
                        endInput.value = startInput.value;
                    }
                });
            }

            page.querySelectorAll('[data-close-modal]').forEach(function (button) {
                button.addEventListener('click', function () {
                    closeModal(button.closest('.en-modal'));
                });
            });

            page.querySelectorAll('.en-modal').forEach(function (modal) {
                modal.addEventListener('click', function (event) {
                    if (event.target === modal) {
                        closeModal(modal);
                    }
                });
            });

            document.addEventListener('keydown', function (event) {
                if (event.key !== 'Escape') {
                    return;
                }

                page.querySelectorAll('.en-modal.is-open').forEach(closeModal);
            });

            updateTypeRules();
        })();
    </script>
}
