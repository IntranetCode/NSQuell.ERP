@{
    // NSQ_RRHH_ESCALA_OPERADORES_INTEGRACION_V1_0
    var action = ViewContext.RouteData.Values["action"]?.ToString() ?? string.Empty;
    var esProgramacion =
        action == "Index" ||
        action == "Historial" ||
        action == "Crear" ||
        action == "Editor" ||
        action == "Novedades" ||
        action == "Detalle";

    var mostrarFlujo = esProgramacion;

    var paso = action switch
    {
        "Crear" => 1,
        "Editor" => 2,
        "Novedades" => 2,
        "Detalle" => 3,
        _ => 0
    };
}

<div class="escala-ux-shell">
    <nav class="escala-ux-nav" aria-label="Recursos Humanos - personal de Producción">
        <a asp-controller="EscalaPersonal"
           asp-action="Index"
           class="eux-link @(esProgramacion ? "is-active" : "")">
            <span class="eux-icon">HR</span>
            <span>
                <strong>Programación semanal</strong>
                <small>Horarios de operadores</small>
            </span>
        </a>

        <a asp-controller="EscalaPersonal"
           asp-action="Operadores"
           class="eux-link @(action == "Operadores" ? "is-active" : "")">
            <span class="eux-icon">OP</span>
            <span>
                <strong>Operadores</strong>
                <small>Altas, bajas y cuentas</small>
            </span>
        </a>

        <a asp-controller="EscalaPersonal"
           asp-action="Polivalencia"
           class="eux-link @(action == "Polivalencia" || action == "PolivalenciaDetalle" ? "is-active" : "")">
            <span class="eux-icon">PV</span>
            <span>
                <strong>Polivalencia</strong>
                <small>Niveles por pieza</small>
            </span>
        </a>
    </nav>

    @if (mostrarFlujo)
    {
        <section class="escala-ux-flow" aria-label="Flujo de trabajo de Recursos Humanos">
            <div class="escala-ux-flow-head">
                <p class="escala-ux-flow-title">Flujo semanal para operadores</p>
                <p class="escala-ux-flow-note">
                    RH define quién trabaja y en qué horario. Producción y Planeación asignan las máquinas según esa disponibilidad.
                </p>
            </div>

            <div class="escala-ux-steps">
                <div class="escala-ux-step @(paso == 1 ? "is-active" : "")">
                    <span class="eux-number">1</span>
                    <span><strong>Elegir semana</strong><small>Los horarios base se cargan automáticamente.</small></span>
                </div>
                <div class="escala-ux-step @(paso == 2 ? "is-active" : "")">
                    <span class="eux-number">2</span>
                    <span><strong>Asignar operadores</strong><small>Arrastra el personal a su horario semanal.</small></span>
                </div>
                <div class="escala-ux-step @(paso == 3 ? "is-active" : "")">
                    <span class="eux-number">3</span>
                    <span><strong>Publicar</strong><small>La semana queda disponible para Producción y Planeación.</small></span>
                </div>
            </div>
        </section>
    }
</div>