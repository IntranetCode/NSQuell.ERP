@{
    var action = ViewContext.RouteData.Values["action"]?.ToString() ?? string.Empty;
    var mostrarFlujo = action == "Index" || action == "Crear" || action == "Editor" ||
                       action == "Novedades" || action == "Detalle";

    var paso = action switch
    {
        "Crear" => 1,
        "Editor" => 2,
        "Novedades" => 3,
        "Detalle" => 4,
        _ => 0
    };
}

<style>
    .escala-ux-shell {
        --eux-primary: #17324d;
        --eux-accent: #e87524;
        --eux-border: #dfe6ed;
        --eux-muted: #6b7a8c;
        --eux-surface: #ffffff;
        margin: 0 0 1rem;
    }

    .escala-ux-nav {
        align-items: stretch;
        background: var(--eux-surface);
        border: 1px solid var(--eux-border);
        border-radius: 14px;
        display: grid;
        gap: 6px;
        grid-template-columns: repeat(auto-fit, minmax(150px, 1fr));
        padding: 7px;
    }

    .escala-ux-nav .eux-link {
        align-items: center;
        border: 1px solid transparent;
        border-radius: 10px;
        color: #344054;
        display: flex;
        gap: 9px;
        min-height: 52px;
        padding: 8px 10px;
        text-decoration: none;
        transition: .15s ease;
    }

    .escala-ux-nav .eux-link:hover {
        background: #f6f9fc;
        border-color: #cbd8e5;
        color: var(--eux-primary);
    }

    .escala-ux-nav .eux-link.is-active {
        background: #edf4fb;
        border-color: #aac4dc;
        color: var(--eux-primary);
        box-shadow: inset 3px 0 0 var(--eux-accent);
    }

    .escala-ux-nav .eux-icon {
        align-items: center;
        background: #eef3f7;
        border-radius: 9px;
        color: var(--eux-primary);
        display: inline-flex;
        flex: 0 0 34px;
        font-size: .66rem;
        font-weight: 900;
        height: 34px;
        justify-content: center;
        letter-spacing: .03em;
    }

    .escala-ux-nav strong,
    .escala-ux-nav small {
        display: block;
        line-height: 1.15;
    }

    .escala-ux-nav strong {
        font-size: .78rem;
        font-weight: 800;
    }

    .escala-ux-nav small {
        color: var(--eux-muted);
        font-size: .64rem;
        margin-top: 3px;
    }

    .escala-ux-flow {
        background: #fbfcfd;
        border: 1px solid var(--eux-border);
        border-radius: 14px;
        margin-top: 8px;
        padding: 12px 14px;
    }

    .escala-ux-flow-head {
        align-items: center;
        display: flex;
        gap: 10px;
        justify-content: space-between;
        margin-bottom: 9px;
    }

    .escala-ux-flow-title {
        color: var(--eux-primary);
        font-size: .76rem;
        font-weight: 850;
        margin: 0;
    }

    .escala-ux-flow-note {
        color: var(--eux-muted);
        font-size: .66rem;
        margin: 0;
    }

    .escala-ux-steps {
        display: grid;
        gap: 7px;
        grid-template-columns: repeat(4, minmax(0, 1fr));
    }

    .escala-ux-step {
        align-items: center;
        background: #fff;
        border: 1px solid #dbe3ea;
        border-radius: 10px;
        display: flex;
        gap: 8px;
        min-width: 0;
        padding: 8px 9px;
    }

    .escala-ux-step .eux-number {
        align-items: center;
        background: #eef3f7;
        border-radius: 50%;
        color: var(--eux-primary);
        display: inline-flex;
        flex: 0 0 28px;
        font-size: .7rem;
        font-weight: 900;
        height: 28px;
        justify-content: center;
    }

    .escala-ux-step strong,
    .escala-ux-step small {
        display: block;
        line-height: 1.15;
    }

    .escala-ux-step strong {
        color: #344054;
        font-size: .7rem;
        font-weight: 800;
    }

    .escala-ux-step small {
        color: var(--eux-muted);
        font-size: .61rem;
        margin-top: 2px;
    }

    .escala-ux-step.is-active {
        background: #fff7ed;
        border-color: #f5bd86;
        box-shadow: inset 3px 0 0 var(--eux-accent);
    }

    .escala-ux-step.is-active .eux-number {
        background: var(--eux-accent);
        color: #fff;
    }

    @@media (max-width: 850px) {
        .escala-ux-steps {
            grid-template-columns: repeat(2, minmax(0, 1fr));
        }

        .escala-ux-flow-head {
            align-items: flex-start;
            flex-direction: column;
            gap: 3px;
        }
    }

    @@media (max-width: 520px) {
        .escala-ux-nav,
        .escala-ux-steps {
            grid-template-columns: 1fr;
        }
    }

    html[data-bs-theme="dark"] .escala-ux-shell,
    body.dark-mode .escala-ux-shell {
        --eux-primary: #e3edf6;
        --eux-border: #34495d;
        --eux-muted: #9fb0c0;
        --eux-surface: #172534;
    }

    html[data-bs-theme="dark"] .escala-ux-nav .eux-link,
    html[data-bs-theme="dark"] .escala-ux-step,
    body.dark-mode .escala-ux-nav .eux-link,
    body.dark-mode .escala-ux-step {
        color: #dce5ed;
    }

    html[data-bs-theme="dark"] .escala-ux-flow,
    html[data-bs-theme="dark"] .escala-ux-step,
    body.dark-mode .escala-ux-flow,
    body.dark-mode .escala-ux-step {
        background: #13212e;
        border-color: #34495d;
    }
</style>

<div class="escala-ux-shell">
    <nav class="escala-ux-nav" aria-label="Navegacion del modulo Escala">
        <a asp-controller="EscalaPersonal"
           asp-action="Index"
           class="eux-link @(action == "Index" || action == "Detalle" || action == "Editor" || action == "Novedades" ? "is-active" : "")">
            <span class="eux-icon">IN</span>
            <span>
                <strong>Escalas</strong>
                <small>Semanas y seguimiento</small>
            </span>
        </a>

        <a asp-controller="EscalaPersonal"
           asp-action="Crear"
           class="eux-link @(action == "Crear" ? "is-active" : "")">
            <span class="eux-icon">+</span>
            <span>
                <strong>Nueva semana</strong>
                <small>Periodo y horarios</small>
            </span>
        </a>

        <a asp-controller="EscalaPersonal"
           asp-action="Turnos"
           class="eux-link @(action == "Turnos" ? "is-active" : "")">
            <span class="eux-icon">TU</span>
            <span>
                <strong>Turnos</strong>
                <small>Catalogo de horarios</small>
            </span>
        </a>

        <a asp-controller="EscalaPersonal"
           asp-action="Funciones"
           class="eux-link @(action == "Funciones" ? "is-active" : "")">
            <span class="eux-icon">FN</span>
            <span>
                <strong>Funciones</strong>
                <small>Roles de personal</small>
            </span>
        </a>

        <a asp-controller="EscalaPersonal"
           asp-action="Polivalencia"
           class="eux-link @(action == "Polivalencia" ? "is-active" : "")">
            <span class="eux-icon">PV</span>
            <span>
                <strong>Polivalencia</strong>
                <small>Niveles por pieza</small>
            </span>
        </a>
    </nav>

    @if (mostrarFlujo)
    {
        <section class="escala-ux-flow" aria-label="Flujo recomendado de Escala">
            <div class="escala-ux-flow-head">
                <p class="escala-ux-flow-title">Flujo recomendado de trabajo</p>
                <p class="escala-ux-flow-note">Las funciones actuales se conservan; esta guia solo ordena el proceso visualmente.</p>
            </div>
            <div class="escala-ux-steps">
                <div class="escala-ux-step @(paso == 1 ? "is-active" : "")">
                    <span class="eux-number">1</span>
                    <span><strong>Crear semana</strong><small>Define periodo y horarios.</small></span>
                </div>
                <div class="escala-ux-step @(paso == 2 ? "is-active" : "")">
                    <span class="eux-number">2</span>
                    <span><strong>Asignar personal</strong><small>Persona, funcion, maquina y turno.</small></span>
                </div>
                <div class="escala-ux-step @(paso == 3 ? "is-active" : "")">
                    <span class="eux-number">3</span>
                    <span><strong>Registrar novedades</strong><small>Vacaciones, bajas e incidencias.</small></span>
                </div>
                <div class="escala-ux-step @(paso == 4 ? "is-active" : "")">
                    <span class="eux-number">4</span>
                    <span><strong>Revisar y publicar</strong><small>Valida la escala antes de liberarla.</small></span>
                </div>
            </div>
        </section>
    }
</div>