@model ERP.NSQuell.Models.PolivalenciaOperadorDetalleVm
@{
    ViewData["Title"] = "Detalle de Polivalencia";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

@section Styles {
    <link rel="stylesheet" href="~/css/EscalaPersonal/escala-navegacion.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/EscalaPersonal/polivalenciadetalle.css" asp-append-version="true" />
}


<div class="pd-page">
    <partial name="_EscalaNavegacion" />
    <a asp-action="Polivalencia" class="pd-back">← Volver a Matriz de Polivalencia</a>

    @if (!Model.Configurado)
    {
        <div class="alert alert-warning mt-3">
            El módulo de Polivalencia no está configurado en la base de datos.
        </div>
    }
    else
    {
        <section class="pd-hero">
            <div>
                <div class="pd-kicker">Perfil de competencia · Control @Model.NumeroControl</div>
                <h1 class="pd-title">@Model.Nombre</h1>
                <div class="pd-meta">@Model.Puesto · PersonaID @Model.PersonalID</div>
            </div>
            <div class="pd-level-big">@($"N{Model.NivelMaximo}")</div>
        </section>

        <section class="pd-stats">
            <div class="pd-stat"><small>Partes ERP evaluadas</small><strong>@Model.PartesEvaluadas</strong></div>
            <div class="pd-stat"><small>Nivel máximo</small><strong>@($"N{Model.NivelMaximo}")</strong></div>
            <div class="pd-stat"><small>N4</small><strong>@Model.Nivel4</strong></div>
            <div class="pd-stat"><small>N3</small><strong>@Model.Nivel3</strong></div>
            <div class="pd-stat"><small>N2</small><strong>@Model.Nivel2</strong></div>
            <div class="pd-stat"><small>N1</small><strong>@Model.Nivel1</strong></div>
        </section>

        @if (Model.EnEscalaActual)
        {
            <div class="pd-scale">
                <strong>Asignación actual en Escala:</strong>
                @Model.EscalaFolio
                @if (!string.IsNullOrWhiteSpace(Model.FuncionActual)) { <text> · @Model.FuncionActual</text> }
                @if (!string.IsNullOrWhiteSpace(Model.MaquinaActual)) { <text> · @Model.MaquinaActual</text> }
                @if (!string.IsNullOrWhiteSpace(Model.TurnoActual)) { <text> · @Model.TurnoActual</text> }
            </div>
        }

        <div class="pd-source">
            Cada renglón está ligado por <strong>ParteID</strong> al catálogo <strong>ERP_Partes</strong>. Número de parte, SAP, designación, descripción, cliente y datos técnicos se leen del maestro que utiliza Producción.
        </div>

        <section class="pd-panel">
            <div class="pd-head">
                <div>
                    <h2>Piezas asociadas a este operador</h2>
                    <small>Filtra por nivel o busca número de parte, SAP, designación, cliente, proceso o máquina.</small>
                </div>
                <form method="get" class="pd-filter">
                    <input type="hidden" name="personalId" value="@Model.PersonalID" />
                    <select name="nivel">
                        <option value="">Todos los niveles</option>
                        @for (var n = 4; n >= 1; n--)
                        {
                            <option value="@n" selected="@(Model.NivelFiltro == n ? "selected" : null)">@($"N{n}")</option>
                        }
                    </select>
                    <input type="search" name="q" value="@Model.Busqueda" placeholder="Parte, SAP, cliente, máquina..." />
                    <button type="submit" class="btn btn-primary">Filtrar</button>
                    <a asp-action="PolivalenciaDetalle"
                       asp-route-personalId="@Model.PersonalID"
                       class="btn btn-outline-secondary">Limpiar</a>
                </form>
            </div>

            <div class="table-responsive">
                <table class="pd-table">
                    <thead>
                        <tr>
                            <th>Nivel</th>
                            <th>Parte ERP</th>
                            <th>Designación / descripción</th>
                            <th>Cliente</th>
                            <th>Proceso / máquina</th>
                            <th>Material</th>
                            <th>Objetivo</th>
                            <th></th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var parte in Model.Partes)
                        {
                            <tr>
                                <td><span class="pd-level n@(parte.Nivel)">@($"N{parte.Nivel}")</span></td>
                                <td class="pd-part">
                                    <strong>@parte.NumeroParte</strong>
                                    <div class="pd-muted">ParteID @parte.ParteID</div>
                                    @if (!string.IsNullOrWhiteSpace(parte.ReferenciaSAP))
                                    {
                                        <div class="pd-muted">SAP @parte.ReferenciaSAP</div>
                                    }
                                </td>
                                <td>
                                    @if (!string.IsNullOrWhiteSpace(parte.Designacion))
                                    {
                                        <strong>@parte.Designacion</strong>
                                    }
                                    <div class="pd-muted">@parte.Descripcion</div>
                                </td>
                                <td>
                                    @if (!string.IsNullOrWhiteSpace(parte.ClienteCodigo))
                                    {
                                        <strong>@parte.ClienteCodigo</strong>
                                    }
                                    <div class="pd-muted">@parte.ClienteNombre</div>
                                </td>
                                <td>
                                    @if (!string.IsNullOrWhiteSpace(parte.TipoProceso))
                                    {
                                        <strong>@parte.TipoProceso</strong>
                                    }
                                    <div class="pd-muted">Principal: @(string.IsNullOrWhiteSpace(parte.MaquinaPrincipal) ? "-" : parte.MaquinaPrincipal)</div>
                                    @if (!string.IsNullOrWhiteSpace(parte.MaquinaSustituta))
                                    {
                                        <div class="pd-muted">Sustituta: @parte.MaquinaSustituta</div>
                                    }
                                    @if (!string.IsNullOrWhiteSpace(parte.Ciclo))
                                    {
                                        <div class="pd-muted">Ciclo: @parte.Ciclo</div>
                                    }
                                </td>
                                <td>
                                    @if (!string.IsNullOrWhiteSpace(parte.MaterialCodigo))
                                    {
                                        <strong>@parte.MaterialCodigo</strong>
                                    }
                                    <div class="pd-muted">@parte.MaterialDescripcion</div>
                                </td>
                                <td>@(parte.ObjetivoHora.HasValue ? $"{parte.ObjetivoHora} pza/h" : "-")</td>
                                <td>
                                    <a asp-controller="Produccion"
                                       asp-action="Index"
                                       asp-route-busqueda="@parte.NumeroParte"
                                       class="pd-prod">Ver en Producción</a>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>

            @if (!Model.Partes.Any())
            {
                <div class="pd-empty">No hay piezas que coincidan con el filtro.</div>
            }
        </section>
    }
</div>
