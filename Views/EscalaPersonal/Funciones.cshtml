@using EscalaVM = ERP.NSQuell.Models.EscalaPersonal
@model EscalaVM.CatalogoFuncionesVM

@{
    ViewData["Title"] = "Catálogo de funciones";
    Layout = "~/Views/Shared/_Layout.cshtml";

    var totalFunciones = Model.Funciones.Count;
    var funcionesActivas = Model.Funciones.Count(x => x.Activo);
    var funcionesConMaquina = Model.Funciones.Count(x => x.RequiereMaquina);
    var funcionesGenerales = Model.Funciones.Count(x => !x.DepartamentoID.HasValue);
    var mostrarModalPorErrores = !ViewData.ModelState.IsValid;
}

@section Styles {
    <link rel="stylesheet" href="~/css/EscalaPersonal/escala-navegacion.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/EscalaPersonal/funciones.css" asp-append-version="true" />
}


<div class="funciones-page">
    <partial name="_EscalaNavegacion" />
    <header class="cf-header">
        <div>
            <div class="cf-eyebrow">Escala de personal · Configuración</div>
            <h1 class="cf-title">Catálogo de funciones</h1>
            <p class="cf-subtitle">
                Define las funciones o roles que podrán asignarse al personal en cada escala.
            </p>
        </div>

        <div class="cf-actions">
            <a asp-action="Index" class="cf-btn cf-btn-secondary">
                <span class="cf-mark">←</span>
                Volver
            </a>
            <button type="button"
                    class="cf-btn cf-btn-primary"
                    data-new-function>
                <span class="cf-mark">+</span>
                Nueva función
            </button>
        </div>
    </header>

    @if (TempData["Exito"] != null)
    {
        <div class="cf-alert cf-alert-success" role="status">
            @TempData["Exito"]
        </div>
    }

    @if (TempData["Error"] != null)
    {
        <div class="cf-alert cf-alert-error" role="alert">
            @TempData["Error"]
        </div>
    }

    <div class="cf-note">
        <span class="cf-note-mark">i</span>
        <span>
            El departamento es opcional y solo define el alcance de la función.
            Una persona puede asignarse a la escala aunque no tenga departamento registrado.
        </span>
    </div>

    <section class="cf-stats" aria-label="Resumen de funciones">
        <article class="cf-stat">
            <span class="cf-stat-mark">FR</span>
            <span>
                <strong class="cf-stat-value">@totalFunciones</strong>
                <span class="cf-stat-label">Funciones registradas</span>
            </span>
        </article>
        <article class="cf-stat">
            <span class="cf-stat-mark">AC</span>
            <span>
                <strong class="cf-stat-value">@funcionesActivas</strong>
                <span class="cf-stat-label">Funciones activas</span>
            </span>
        </article>
        <article class="cf-stat">
            <span class="cf-stat-mark">MQ</span>
            <span>
                <strong class="cf-stat-value">@funcionesConMaquina</strong>
                <span class="cf-stat-label">Requieren máquina</span>
            </span>
        </article>
        <article class="cf-stat">
            <span class="cf-stat-mark">GL</span>
            <span>
                <strong class="cf-stat-value">@funcionesGenerales</strong>
                <span class="cf-stat-label">De alcance general</span>
            </span>
        </article>
    </section>

    <section class="cf-panel">
        <div class="cf-toolbar">
            <input type="search"
                   id="functionSearch"
                   class="cf-control cf-search"
                   placeholder="Buscar por función o descripción..."
                   autocomplete="off" />

            <select id="functionDepartmentFilter"
                    class="cf-control"
                    aria-label="Filtrar por departamento">
                <option value="">Todos los alcances</option>
                <option value="general">Alcance general</option>
                @foreach (var departamento in Model.Departamentos
                    .Where(x => !string.IsNullOrWhiteSpace(x.Value)))
                {
                    <option value="@departamento.Value">@departamento.Text</option>
                }
            </select>

            <select id="functionMachineFilter"
                    class="cf-control"
                    aria-label="Filtrar por uso de máquina">
                <option value="">Con o sin máquina</option>
                <option value="si">Requiere máquina</option>
                <option value="no">No requiere máquina</option>
            </select>

            <select id="functionStatusFilter"
                    class="cf-control"
                    aria-label="Filtrar por estado">
                <option value="">Todos los estados</option>
                <option value="activo">Activas</option>
                <option value="inactivo">Inactivas</option>
            </select>
        </div>

        @if (Model.Funciones.Any())
        {
            <div class="cf-table-wrap">
                <table class="cf-table">
                    <thead>
                        <tr>
                            <th>Función o rol</th>
                            <th>Descripción</th>
                            <th>Alcance</th>
                            <th>Máquina</th>
                            <th>Orden</th>
                            <th>Estado</th>
                            <th class="text-end">Acciones</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var funcion in Model.Funciones
                            .OrderByDescending(x => x.Activo)
                            .ThenBy(x => x.Orden)
                            .ThenBy(x => x.Nombre))
                        {
                            var estado = funcion.Activo ? "activo" : "inactivo";
                            var maquina = funcion.RequiereMaquina ? "si" : "no";
                            var alcance = funcion.DepartamentoID?.ToString() ?? "general";
                            var textoBusqueda =
                                $"{funcion.Nombre} {funcion.Descripcion} {funcion.NombreDepartamento}";
                            var iniciales = string.Concat(
                                funcion.Nombre
                                    .Split(' ', StringSplitOptions.RemoveEmptyEntries)
                                    .Take(2)
                                    .Select(x => char.ToUpperInvariant(x[0])));

                            <tr data-function-row
                                data-search="@textoBusqueda"
                                data-department="@alcance"
                                data-machine="@maquina"
                                data-status="@estado">
                                <td>
                                    <div class="cf-name-wrap">
                                        <span class="cf-avatar">@iniciales</span>
                                        <span>
                                            <span class="cf-name">@funcion.Nombre</span>
                                            <span class="cf-id">ID @funcion.FuncionID</span>
                                        </span>
                                    </div>
                                </td>
                                <td>
                                    <span class="cf-description"
                                          title="@funcion.Descripcion">
                                        @(string.IsNullOrWhiteSpace(funcion.Descripcion)
                                            ? "Sin descripción"
                                            : funcion.Descripcion)
                                    </span>
                                </td>
                                <td>
                                    <span class="cf-badge cf-badge-scope">
                                        @funcion.NombreDepartamento
                                    </span>
                                </td>
                                <td>
                                    <span class="cf-badge @(funcion.RequiereMaquina ? "cf-badge-machine" : "cf-badge-free")">
                                        @(funcion.RequiereMaquina
                                            ? "Requiere máquina"
                                            : "No requiere")
                                    </span>
                                </td>
                                <td>@funcion.Orden</td>
                                <td>
                                    <span class="cf-badge @(funcion.Activo ? "cf-badge-active" : "cf-badge-inactive")">
                                        @(funcion.Activo ? "Activa" : "Inactiva")
                                    </span>
                                </td>
                                <td>
                                    <div class="cf-row-actions">
                                        <button type="button"
                                                class="cf-link-btn"
                                                data-edit-function
                                                data-id="@funcion.FuncionID"
                                                data-name="@funcion.Nombre"
                                                data-description="@funcion.Descripcion"
                                                data-department="@(funcion.DepartamentoID?.ToString() ?? string.Empty)"
                                                data-machine="@funcion.RequiereMaquina.ToString().ToLowerInvariant()"
                                                data-order="@funcion.Orden">
                                            Editar
                                        </button>

                                        <form asp-action="CambiarEstadoFuncion"
                                              method="post"
                                              class="cf-state-form"
                                              data-state-form
                                              data-name="@funcion.Nombre"
                                              data-active="@funcion.Activo.ToString().ToLowerInvariant()">
                                            @Html.AntiForgeryToken()
                                            <input type="hidden"
                                                   name="funcionID"
                                                   value="@funcion.FuncionID" />
                                            <button type="submit"
                                                    class="cf-link-btn @(funcion.Activo ? "cf-link-danger" : string.Empty)">
                                                @(funcion.Activo ? "Desactivar" : "Activar")
                                            </button>
                                        </form>
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>

            <div class="cf-empty" id="functionFilterEmpty" hidden>
                <div class="cf-empty-mark">?</div>
                <h2 class="cf-empty-title">No hay coincidencias</h2>
                <p class="cf-empty-text">
                    Ajusta la búsqueda o cambia los filtros seleccionados.
                </p>
            </div>
        }
        else
        {
            <div class="cf-empty">
                <div class="cf-empty-mark">FR</div>
                <h2 class="cf-empty-title">Todavía no hay funciones registradas</h2>
                <p class="cf-empty-text">
                    Crea el primer rol para comenzar a distribuir al personal.
                </p>
                <button type="button"
                        class="cf-btn cf-btn-primary mt-3"
                        data-new-function>
                    Nueva función
                </button>
            </div>
        }
    </section>

    <div class="cf-modal"
         id="functionModal"
         role="dialog"
         aria-modal="true"
         aria-labelledby="functionModalTitle"
         hidden>
        <div class="cf-modal-dialog">
            <form asp-action="GuardarFuncion"
                  method="post"
                  id="functionForm">
                @Html.AntiForgeryToken()
                <input asp-for="Formulario.FuncionID"
                       type="hidden"
                       id="functionId" />

                <header class="cf-modal-header">
                    <div>
                        <h2 class="cf-modal-title" id="functionModalTitle">
                            Nueva función
                        </h2>
                        <p class="cf-modal-subtitle">
                            Configura el rol que desempeñará el personal dentro de la escala.
                        </p>
                    </div>
                    <button type="button"
                            class="cf-modal-close"
                            data-close-function
                            aria-label="Cerrar">
                        ×
                    </button>
                </header>

                <div class="cf-modal-body">
                    <div asp-validation-summary="ModelOnly"
                         class="cf-validation-summary"></div>

                    <div class="cf-form-grid">
                        <div class="cf-field-full">
                            <label asp-for="Formulario.Nombre"
                                   class="cf-label cf-required"></label>
                            <input asp-for="Formulario.Nombre"
                                   id="functionName"
                                   class="cf-control"
                                   maxlength="120"
                                   autocomplete="off"
                                   placeholder="Ej. Operador de inyección" />
                            <span asp-validation-for="Formulario.Nombre"
                                  class="cf-validation"></span>
                        </div>

                        <div class="cf-field-full">
                            <label asp-for="Formulario.Descripcion"
                                   class="cf-label"></label>
                            <textarea asp-for="Formulario.Descripcion"
                                      id="functionDescription"
                                      class="cf-control"
                                      maxlength="500"
                                      placeholder="Describe brevemente las responsabilidades de esta función."></textarea>
                            <span asp-validation-for="Formulario.Descripcion"
                                  class="cf-validation"></span>
                        </div>

                        <div>
                            <label asp-for="Formulario.DepartamentoID"
                                   class="cf-label">
                                Alcance por departamento
                            </label>
                            <select asp-for="Formulario.DepartamentoID"
                                    asp-items="Model.Departamentos"
                                    id="functionDepartment"
                                    class="cf-control"></select>
                            <span class="cf-help">
                                Es opcional. Déjalo en alcance general para usarla con cualquier persona.
                            </span>
                            <span asp-validation-for="Formulario.DepartamentoID"
                                  class="cf-validation"></span>
                        </div>

                        <div>
                            <label asp-for="Formulario.Orden"
                                   class="cf-label"></label>
                            <input asp-for="Formulario.Orden"
                                   id="functionOrder"
                                   class="cf-control"
                                   type="number"
                                   min="0"
                                   step="1" />
                            <span class="cf-help">
                                Controla la posición de la función en los listados.
                            </span>
                            <span asp-validation-for="Formulario.Orden"
                                  class="cf-validation"></span>
                        </div>

                        <div class="cf-field-full">
                            <label class="cf-check-card">
                                <input asp-for="Formulario.RequiereMaquina"
                                       id="functionMachine"
                                       type="checkbox" />
                                <span>
                                    <span class="cf-check-title">
                                        Esta función requiere seleccionar una máquina
                                    </span>
                                    <span class="cf-check-text">
                                        Al asignarla en una escala se deberá indicar la máquina correspondiente.
                                    </span>
                                </span>
                            </label>
                        </div>
                    </div>
                </div>

                <footer class="cf-modal-footer">
                    <button type="button"
                            class="cf-btn cf-btn-secondary"
                            data-close-function>
                        Cancelar
                    </button>
                    <button type="submit"
                            class="cf-btn cf-btn-primary">
                        Guardar función
                    </button>
                </footer>
            </form>
        </div>
    </div>
</div>

<script>
    document.addEventListener('DOMContentLoaded', function () {
        const modal = document.getElementById('functionModal');
        const form = document.getElementById('functionForm');
        const modalTitle = document.getElementById('functionModalTitle');
        const idInput = document.getElementById('functionId');
        const nameInput = document.getElementById('functionName');
        const descriptionInput = document.getElementById('functionDescription');
        const departmentInput = document.getElementById('functionDepartment');
        const machineInput = document.getElementById('functionMachine');
        const orderInput = document.getElementById('functionOrder');
        const searchInput = document.getElementById('functionSearch');
        const departmentFilter =
            document.getElementById('functionDepartmentFilter');
        const machineFilter =
            document.getElementById('functionMachineFilter');
        const statusFilter =
            document.getElementById('functionStatusFilter');
        const emptyFilter =
            document.getElementById('functionFilterEmpty');
        const openWithErrors =
            @mostrarModalPorErrores.ToString().ToLowerInvariant();

        if (!modal || !form) {
            return;
        }

        function normalize(value) {
            return (value || '')
                .toLocaleLowerCase('es')
                .normalize('NFD')
                .replace(/[\u0300-\u036f]/g, '')
                .trim();
        }

        function openModal() {
            modal.hidden = false;
            document.body.classList.add('cf-modal-open');
            window.setTimeout(function () {
                nameInput.focus();
            }, 40);
        }

        function closeModal() {
            modal.hidden = true;
            document.body.classList.remove('cf-modal-open');
        }

        function prepareNew() {
            form.reset();
            idInput.value = '0';
            nameInput.value = '';
            descriptionInput.value = '';
            departmentInput.value = '';
            machineInput.checked = false;
            orderInput.value = '0';
            modalTitle.textContent = 'Nueva función';
            openModal();
        }

        function prepareEdit(button) {
            form.reset();
            idInput.value = button.dataset.id || '0';
            nameInput.value = button.dataset.name || '';
            descriptionInput.value = button.dataset.description || '';
            departmentInput.value = button.dataset.department || '';
            machineInput.checked = button.dataset.machine === 'true';
            orderInput.value = button.dataset.order || '0';
            modalTitle.textContent = 'Editar función';
            openModal();
        }

        function filterRows() {
            const rows = document.querySelectorAll('[data-function-row]');
            const query = normalize(searchInput ? searchInput.value : '');
            const selectedDepartment =
                departmentFilter ? departmentFilter.value : '';
            const selectedMachine =
                machineFilter ? machineFilter.value : '';
            const selectedStatus =
                statusFilter ? statusFilter.value : '';
            let visible = 0;

            rows.forEach(function (row) {
                const matchesSearch =
                    !query || normalize(row.dataset.search).includes(query);
                const matchesDepartment =
                    !selectedDepartment
                    || row.dataset.department === selectedDepartment;
                const matchesMachine =
                    !selectedMachine
                    || row.dataset.machine === selectedMachine;
                const matchesStatus =
                    !selectedStatus
                    || row.dataset.status === selectedStatus;
                const show =
                    matchesSearch
                    && matchesDepartment
                    && matchesMachine
                    && matchesStatus;

                row.hidden = !show;
                if (show) {
                    visible += 1;
                }
            });

            if (emptyFilter) {
                emptyFilter.hidden = visible !== 0;
            }
        }

        document.querySelectorAll('[data-new-function]').forEach(function (button) {
            button.addEventListener('click', prepareNew);
        });

        document.querySelectorAll('[data-edit-function]').forEach(function (button) {
            button.addEventListener('click', function () {
                prepareEdit(button);
            });
        });

        document.querySelectorAll('[data-close-function]').forEach(function (button) {
            button.addEventListener('click', closeModal);
        });

        document.querySelectorAll('[data-state-form]').forEach(function (stateForm) {
            stateForm.addEventListener('submit', function (event) {
                const isActive = stateForm.dataset.active === 'true';
                const action = isActive ? 'desactivar' : 'activar';
                const name = stateForm.dataset.name || 'esta función';

                if (!window.confirm(
                    '¿Deseas ' + action + ' la función "' + name + '"?')) {
                    event.preventDefault();
                }
            });
        });

        [
            searchInput,
            departmentFilter,
            machineFilter,
            statusFilter
        ].forEach(function (control) {
            if (!control) {
                return;
            }

            control.addEventListener(
                control.tagName === 'INPUT' ? 'input' : 'change',
                filterRows);
        });

        modal.addEventListener('click', function (event) {
            if (event.target === modal) {
                closeModal();
            }
        });

        document.addEventListener('keydown', function (event) {
            if (event.key === 'Escape' && !modal.hidden) {
                closeModal();
            }
        });

        if (openWithErrors) {
            openModal();
        }
    });
</script>
