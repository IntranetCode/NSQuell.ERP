@* NSQ_RRHH_EDITOR_COMPACTO_PDF_MODAL_V2_5 *@

@using System
@using System.Linq
@using EscalaVM = ERP.NSQuell.Models.EscalaPersonal
@model EscalaVM.EditorVM

@{
    ViewData["Title"] = $"Programación RH · {Model.Escala.Folio}";
    Layout = "~/Views/Shared/_Layout.cshtml";

    var asignaciones = Model.Grupos
        .SelectMany(g => g.Celdas.SelectMany(c =>
            c.Asignaciones.Select(a => new
            {
                Asignacion = a,
                Grupo = g,
                Celda = c
            })))
        .ToList();

    var asignadas = asignaciones
        .Select(x => x.Asignacion.PersonalID)
        .Distinct()
        .ToHashSet();

    var funcionesTabla = Model.Funciones.Where(x => x.Activo)
        .Select(x => new { x.FuncionID, x.Nombre, x.Orden, Editable = true })
        .Concat(Model.Grupos.Where(g => !Model.Funciones.Any(f => f.Activo && f.FuncionID == g.FuncionID))
            .Select(g => new { g.FuncionID, Nombre = g.NombreFuncion, Orden = g.OrdenFuncion, Editable = false }))
        .GroupBy(x => x.FuncionID).Select(g => g.First()).OrderBy(x => x.Orden).ThenBy(x => x.Nombre).ToList();

}

@section Styles {
    <link rel="stylesheet"
          href="~/css/EscalaPersonal/escala-navegacion.css"
          asp-append-version="true" />
    <link rel="stylesheet"
          href="~/css/EscalaPersonal/editor-rrhh-v20.css"
          asp-append-version="true" />
    <link rel="stylesheet" href="~/css/EscalaPersonal/editor-arrastre-v1.css" asp-append-version="true" />
}

@section Scripts {
    <script src="~/js/EscalaPersonal/editor-arrastre-v1.js"
            asp-append-version="true"></script>
}

<div class="rrhh20"
     data-escala-id="@Model.Escala.EscalaID"
     data-editable="@Model.PuedeEditar.ToString().ToLowerInvariant()">

    <partial name="_EscalaNavegacion" />

    <section class="rrhh20-hero">
        <div>
            <span class="rrhh20-eyebrow">Recursos Humanos · Programación semanal</span>
            <h1>Escala de personal · Semana @Model.Escala.NumeroSemana</h1>
            <p>
                Arrastra a las personas a su horario en la tabla.
                Cada movimiento se guarda al confirmarlo el sistema.
            </p>
        </div>

        <div class="rrhh20-hero-actions">
            <a asp-action="Index" class="rrhh20-btn rrhh20-btn-light">Volver</a>

            <a asp-action="Operadores"
               class="rrhh20-btn rrhh20-btn-light">
                Directorio de operadores
            </a>

            <button type="button"
                    class="rrhh20-btn rrhh20-btn-dark"
                    id="rrhh20OpenPdf"
                    data-preview-url="@Url.Action("VistaPdfV21", "EscalaPersonal", new { id = Model.Escala.EscalaID })"
                    data-download-url="@Url.Action("DescargarPdfV20", "EscalaPersonal", new { id = Model.Escala.EscalaID })">
                Vista previa PDF
            </button>
        </div>
    </section>

    @if (TempData["Exito"] != null)
    {
        <div class="rrhh20-alert success">@TempData["Exito"]</div>
    }

    @if (TempData["Error"] != null)
    {
        <div class="rrhh20-alert error">@TempData["Error"]</div>
    }

    <section class="rrhh20-summary">
        <article>
            <span>Folio</span>
            <strong>@Model.Escala.Folio</strong>
        </article>
        <article>
            <span>Periodo</span>
            <strong>
                @Model.Escala.FechaInicio.ToString("dd/MM/yyyy")
                -
                @Model.Escala.FechaFin.ToString("dd/MM/yyyy")
            </strong>
        </article>
        <article>
            <span>Estado</span>
            <strong>@Model.Escala.Estado</strong>
        </article>
        <article>
            <span>Personal con horario</span>
            <strong id="rhAssignedCount">@asignadas.Count</strong>
        </article>
    </section>

    @if (!Model.PuedeEditar)
    {
        <div class="rrhh20-alert info">
            Esta escala está publicada o cerrada. Para modificar horarios primero
            debes regresarla a Borrador.
        </div>
    }

    @* NSQ_RH_ARRASTRE_HISTORIAL_V1_0 *@
    <form id="rhDragSave" asp-action="GuardarAsignacionesMasivasV20" method="post" hidden>
        @Html.AntiForgeryToken()
    </form>
    <section class="rrhh20-panel rh-catalog-panel" aria-labelledby="rhPeopleTitle">
        <div class="rrhh20-panel-head">
            <div><span class="rrhh20-step">1</span><div><h2 id="rhPeopleTitle">Personal sin horario</h2><p>Al asignar un horario, el nombre sale de esta lista. Los asignados se pueden mover entre horarios desde la tabla.</p></div></div>
            @if (Model.PuedeEditar){<button type="button" class="rrhh20-btn rrhh20-btn-light" id="rrhh20CopyPrevious">Copiar semana anterior</button>}
        </div>
        <div class="rh-search">
            <input type="search" id="rhSearch" aria-label="Buscar personal" placeholder="Buscar por nombre, número de control o puesto…" />
            <span class="rh-filter">Sólo personas pendientes de asignar</span>
            <button type="button" class="rrhh20-btn rrhh20-btn-light" id="rhClearSelection">Limpiar selección</button>
        </div>
        <div class="rh-people-grid" id="rhCatalog">
            @foreach (var persona in Model.Personas.Where(x => x.Activo).OrderBy(x => x.NombreCompleto)){
                var actuales = asignaciones.Where(x => x.Asignacion.PersonalID == persona.PersonalID).ToList();
                var textoActual = actuales.Count == 0 ? "Sin horario asignado" : string.Join(" / ", actuales.Select(x => $"{x.Grupo.NombreFuncion} · {x.Celda.NombreTurno}").Distinct());
                <button type="button" class="rh-person" data-rh-person="@persona.PersonalID" data-assigned="@(actuales.Count > 0 ? "true" : "false")" hidden="@(actuales.Count > 0)"
                        data-search="@($"{persona.NumeroEmpleado} {persona.NombreCompleto} {persona.Puesto}")"
                        draggable="@(Model.PuedeEditar ? "true" : "false")" aria-pressed="false" @(Model.PuedeEditar ? null : "disabled")>
                    <strong>@persona.NombreCompleto</strong><small>@persona.NumeroEmpleado @if(!string.IsNullOrWhiteSpace(persona.Puesto)){<text> · @persona.Puesto</text>}</small>
                    <span class="rh-current">@textoActual</span>
                </button>
            }
        </div>
        <p class="rh-empty-catalog" id="rhNoPeople" hidden>Todas las personas disponibles ya tienen horario. Puedes moverlas directamente en la tabla.</p>
    </section>
    <div class="rh-status" id="rhStatus" role="status" aria-live="polite">@(Model.PuedeEditar ? "Arrastra una persona al horario que le corresponde." : "Consulta de horarios: esta escala no permite cambios.")</div>
    <section class="rrhh20-panel" aria-labelledby="rhBoardTitle">
        <div class="rrhh20-panel-head"><div><span class="rrhh20-step">2</span><div><h2 id="rhBoardTitle">Tabla de horarios</h2><p>Las filas son funciones y las columnas son horarios. Puedes mover a una persona de un turno a otro.</p></div></div>
            <a asp-action="Novedades" asp-route-id="@Model.Escala.EscalaID" class="rrhh20-btn rrhh20-btn-light">Novedades (@Model.Novedades.Count)</a>
        </div>
        @if(Model.Turnos.Count == 0){<div class="rrhh20-empty">Esta escala no tiene horarios configurados.</div>}
        else{
        <div class="rrhh20-matrix-wrap rh-board-wrap">
            <table class="rh-board"><thead><tr><th scope="col">Función</th>@foreach(var turno in Model.Turnos.OrderBy(x=>x.Orden)){<th scope="col"><strong>@turno.Nombre</strong><small>@turno.HorarioTexto</small></th>}</tr></thead><tbody>
            @foreach(var funcion in funcionesTabla){
                <tr><th scope="row">@funcion.Nombre</th>
                @foreach(var turno in Model.Turnos.OrderBy(x=>x.Orden)){
                    var personasCelda = asignaciones.Where(x=>x.Grupo.FuncionID==funcion.FuncionID && x.Celda.EscalaTurnoID==turno.EscalaTurnoID).Select(x=>x.Asignacion).GroupBy(x=>x.PersonalID).Select(x=>x.First()).OrderBy(x=>x.NombrePersona).ToList();
                    <td><div class="rh-drop" data-rh-drop data-disabled="@((!funcion.Editable).ToString().ToLowerInvariant())" data-function="@funcion.FuncionID" data-turn="@turno.EscalaTurnoID" data-label="@($"{funcion.Nombre} · {turno.Nombre} · {turno.HorarioTexto}")">
                        <div class="rh-cell-head"><span data-rh-count>@personasCelda.Count</span> personas<button type="button" class="rh-assign-here" data-rh-assign disabled>Asignar aquí</button></div>
                        <div class="rh-cell-people">
                        @foreach(var persona in personasCelda){
                            var disponible = Model.PuedeEditar && Model.Personas.Any(x=>x.PersonalID==persona.PersonalID && x.Activo);
                            <button type="button" class="rh-person rh-assigned" data-rh-person="@persona.PersonalID" draggable="@(disponible ? "true" : "false")" aria-pressed="false" @(disponible ? null : "disabled")><strong>@persona.NombrePersona</strong><small>@persona.NumeroEmpleado</small></button>
                        }
                        </div><p class="rh-drop-hint">Arrastra los nombres aquí</p>
                    </div></td>
                }
                </tr>
            }
            </tbody></table>
        </div>
        }
        @if(Model.PuedeEditar){
        <div class="rh-unassign rh-drop" data-rh-drop data-function="0" data-turn="0" data-label="Sin horario asignado"><strong>Sin horario</strong><span>Arrastra aquí para quitar el horario de esta semana.</span><button type="button" class="rh-assign-here" data-rh-assign disabled>Quitar horario a la selección</button></div>
        }
    </section>

    <section class="rrhh20-panel">
        <div class="rrhh20-panel-head">
            <div>
                <h2>Novedades de la semana</h2>
                <p>Bajas, ingresos, incapacidades, vacaciones y otros movimientos de RH.</p>
            </div>

            <a asp-action="Novedades"
               asp-route-id="@Model.Escala.EscalaID"
               class="rrhh20-btn rrhh20-btn-light">
                Administrar novedades
            </a>
        </div>

        @if (Model.Novedades.Count == 0)
        {
            <div class="rrhh20-empty">No hay novedades registradas.</div>
        }
        else
        {
            <div class="rrhh20-news">
                @foreach (var novedad in Model.Novedades
                    .OrderBy(x => x.TipoNovedad)
                    .ThenBy(x => x.FechaInicio))
                {
                    <article>
                        <strong>@novedad.TipoNovedad</strong>
                        <span>@novedad.NombrePersona</span>
                        <small>
                            @novedad.FechaInicio.ToString("dd/MM/yyyy")
                            @if (novedad.FechaFin.HasValue)
                            {
                                <text> - @novedad.FechaFin.Value.ToString("dd/MM/yyyy")</text>
                            }
                            @if (!string.IsNullOrWhiteSpace(novedad.Motivo))
                            {
                                <text> · @novedad.Motivo</text>
                            }
                        </small>
                    </article>
                }
            </div>
        }
    </section>

    <section class="rrhh20-footer-actions">
        @if (Model.PuedeEditar)
        {
            <form asp-action="Publicar" method="post" data-rh-publish-form>
                @Html.AntiForgeryToken()
                <input type="hidden"
                       name="escalaID"
                       value="@Model.Escala.EscalaID" />
                <button type="submit" id="rhPublish" disabled="@(asignadas.Count == 0)"
                        class="rrhh20-btn rrhh20-btn-primary">
                    Publicar escala
                </button>
            </form>
        }

        @if (Model.Escala.Estado == EscalaVM.Estados.Publicada)
        {
            <form asp-action="RegresarABorrador" method="post">
                @Html.AntiForgeryToken()
                <input type="hidden"
                       name="escalaID"
                       value="@Model.Escala.EscalaID" />
                <button type="submit"
                        class="rrhh20-btn rrhh20-btn-light">
                    Regresar a borrador
                </button>
            </form>
        }

        @if (Model.Escala.Estado == EscalaVM.Estados.Borrador)
        {
            <form asp-action="Cancelar" method="post"
                  onsubmit="return confirm('¿Cancelar esta escala?');">
                @Html.AntiForgeryToken()
                <input type="hidden"
                       name="escalaID"
                       value="@Model.Escala.EscalaID" />
                <button type="submit"
                        class="rrhh20-btn rrhh20-btn-danger">
                    Cancelar escala
                </button>
            </form>
        }
    </section>


    <div class="rrhh20-pdf-modal"
         id="rrhh20PdfModal"
         aria-hidden="true"
         role="dialog"
         aria-modal="true"
         aria-labelledby="rrhh20PdfTitle">
        <div class="rrhh20-pdf-dialog">
            <div class="rrhh20-pdf-head">
                <div>
                    <span>Documento semanal</span>
                    <strong id="rrhh20PdfTitle">Escala de personal · Semana @Model.Escala.NumeroSemana</strong>
                </div>

                <div class="rrhh20-pdf-actions">
                    <a id="rrhh20PdfDownload"
                       class="rrhh20-btn rrhh20-btn-primary"
                       href="#">
                        Descargar PDF
                    </a>
                    <button type="button"
                            class="rrhh20-pdf-close"
                            id="rrhh20PdfClose"
                            aria-label="Cerrar vista previa">
                        ×
                    </button>
                </div>
            </div>

            <div class="rrhh20-pdf-body">
                <div class="rrhh20-pdf-loading" id="rrhh20PdfLoading">
                    Preparando vista previa...
                </div>
                <iframe id="rrhh20PdfFrame"
                        title="Vista previa de la escala semanal"></iframe>
            </div>
        </div>
    </div>
</div>