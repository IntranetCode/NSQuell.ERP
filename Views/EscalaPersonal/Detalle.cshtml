@using System
@using System.Linq
@using EscalaVM = ERP.NSQuell.Models.EscalaPersonal
@model EscalaVM.DetalleVM

@{
    ViewData["Title"] = $"Detalle {Model.Escala.Folio}";
    Layout = "~/Views/Shared/_Layout.cshtml";

    var asignaciones = Model.Grupos
        .SelectMany(grupo => grupo.Celdas)
        .SelectMany(celda => celda.Asignaciones)
        .ToList();

    var totalPersonas = asignaciones
        .Select(x => x.PersonalID)
        .Distinct()
        .Count();

    var estado = Model.Escala.Estado ?? string.Empty;
    var puedeEditar = estado == EscalaVM.Estados.Borrador;
    var puedeRegresar = estado == EscalaVM.Estados.Publicada;
    var puedeCancelar = estado != EscalaVM.Estados.Cancelada;

    var estadoClase = "ed-status-borrador";
    if (estado == EscalaVM.Estados.Publicada)
    {
        estadoClase = "ed-status-publicada";
    }
    else if (estado == EscalaVM.Estados.Cancelada)
    {
        estadoClase = "ed-status-cancelada";
    }
}

@section Scripts {
    <script src="~/js/shared/nsq-dynamic-style.js" asp-append-version="true"></script>
}


@section Styles {
    <link rel="stylesheet" href="~/css/EscalaPersonal/escala-navegacion.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/EscalaPersonal/detalle.css" asp-append-version="true" />
}


<div class="escala-detalle">
    <partial name="_EscalaNavegacion" />
    <div class="ed-header">
        <div>
            <div class="ed-eyebrow">Escala de personal</div>
            <h1 class="ed-title">Detalle de la escala</h1>
            <p class="ed-subtitle">
                Consulta general de horarios, asignaciones, novedades e historial.
            </p>
        </div>

        <div class="ed-header-actions ed-print-hide">
            <a asp-action="Index" class="ed-btn ed-btn-light">Volver</a>

            @if (puedeEditar)
            {
                <a asp-action="Editor"
                   asp-route-id="@Model.Escala.EscalaID"
                   class="ed-btn ed-btn-primary">
                    Editar escala
                </a>

                <a asp-action="Novedades"
                   asp-route-id="@Model.Escala.EscalaID"
                   class="ed-btn ed-btn-light">
                    Novedades
                </a>
            }

            <button type="button"
                    class="ed-btn ed-btn-dark"
                    onclick="window.print()">
                Imprimir
            </button>
        </div>
    </div>

    @if (TempData["Exito"] != null)
    {
        <div class="ed-alert ed-alert-success">@TempData["Exito"]</div>
    }

    @if (TempData["Error"] != null)
    {
        <div class="ed-alert ed-alert-error">@TempData["Error"]</div>
    }

    <section class="ed-summary">
        <div class="ed-summary-main">
            <span class="ed-summary-label">Folio</span>
            <span class="ed-summary-value ed-summary-folio">@Model.Escala.Folio</span>
        </div>
        <div class="ed-summary-item">
            <span class="ed-summary-label">Estado</span>
            <span class="ed-status @estadoClase">@Model.Escala.Estado</span>
        </div>
        <div class="ed-summary-item">
            <span class="ed-summary-label">Semana</span>
            <span class="ed-summary-value">@Model.Escala.NumeroSemana / @Model.Escala.Anio</span>
        </div>
        <div class="ed-summary-item">
            <span class="ed-summary-label">Periodo</span>
            <span class="ed-summary-value">
                @Model.Escala.FechaInicio.ToString("dd/MM/yyyy") - @Model.Escala.FechaFin.ToString("dd/MM/yyyy")
            </span>
        </div>
        <div class="ed-summary-item">
            <span class="ed-summary-label">Documento</span>
            <span class="ed-summary-value">@Model.Escala.CodigoDocumento</span>
        </div>
        <div class="ed-summary-item">
            <span class="ed-summary-label">Version</span>
            <span class="ed-summary-value">@Model.Escala.VersionDocumento</span>
        </div>
    </section>

    <section class="ed-stats">
        <article class="ed-stat">
            <p class="ed-stat-label">Asignaciones</p>
            <p class="ed-stat-value">@asignaciones.Count</p>
        </article>
        <article class="ed-stat">
            <p class="ed-stat-label">Personas</p>
            <p class="ed-stat-value">@totalPersonas</p>
        </article>
        <article class="ed-stat">
            <p class="ed-stat-label">Horarios</p>
            <p class="ed-stat-value">@Model.Turnos.Count</p>
        </article>
        <article class="ed-stat">
            <p class="ed-stat-label">Novedades</p>
            <p class="ed-stat-value">@Model.Novedades.Count</p>
        </article>
    </section>

    <div class="ed-grid">
        <main>
            <section class="ed-panel">
                <div class="ed-panel-head">
                    <div>
                        <h2 class="ed-panel-title">Horarios de la escala</h2>
                        <p class="ed-panel-subtitle">
                            Horarios creados especificamente para esta semana.
                        </p>
                    </div>
                </div>
                <div class="ed-panel-body">
                    @if (Model.Turnos.Any())
                    {
                        <div class="ed-turnos">
                            @foreach (var turno in Model.Turnos.OrderBy(x => x.Orden))
                            {
                                <article class="ed-turno" data-nsq-style="--turno-color: @turno.Color;">
                                    <span class="ed-turno-name">@turno.Nombre</span>
                                    <span class="ed-turno-time">@turno.HorarioTexto</span>
                                    <span class="ed-turno-meta">
                                        @turno.TipoTurno
                                        @if (turno.CruzaDiaSiguiente)
                                        {
                                            <text> · Termina al dia siguiente</text>
                                        }
                                        @if (turno.EsFlexible)
                                        {
                                            <text> · Flexible</text>
                                        }
                                    </span>
                                </article>
                            }
                        </div>
                    }
                    else
                    {
                        <div class="ed-empty">
                            Esta escala no tiene horarios configurados.
                        </div>
                    }
                </div>
            </section>

            <section class="ed-panel">
                <div class="ed-panel-head">
                    <div>
                        <h2 class="ed-panel-title">Programacion por area</h2>
                        <p class="ed-panel-subtitle">
                            Matriz de personal asignado por departamento, funcion, maquina y horario.
                        </p>
                    </div>
                    @if (puedeEditar)
                    {
                        <a asp-action="Editor"
                           asp-route-id="@Model.Escala.EscalaID"
                           class="ed-btn ed-btn-primary ed-print-hide">
                            Editar programacion
                        </a>
                    }
                </div>
                <div class="ed-panel-body">
                    @if (Model.Grupos.Any() && Model.Turnos.Any())
                    {
                        <div class="ed-table-wrap">
                            <table class="ed-table">
                                <thead>
                                    <tr>
                                        <th>Departamento</th>
                                        <th>Funcion / Maquina</th>
                                        @foreach (var turno in Model.Turnos.OrderBy(x => x.Orden))
                                        {
                                            <th>@turno.Nombre</th>
                                        }
                                        <th>Total</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var grupo in Model.Grupos)
                                    {
                                        var totalGrupo = grupo.Celdas.Sum(x => x.TotalPersonas);
                                        <tr>
                                            <td>
                                                <span class="ed-row-title">@grupo.NombreDepartamento</span>
                                            </td>
                                            <td>
                                                <span class="ed-row-title">@grupo.NombreFuncion</span>
                                                <span class="ed-row-muted">
                                                    @(string.IsNullOrWhiteSpace(grupo.NombreMaquina)
                                                        ? "Sin maquina"
                                                        : grupo.NombreMaquina)
                                                </span>
                                            </td>
                                            @foreach (var celda in grupo.Celdas.OrderBy(c => Model.Turnos.FirstOrDefault(t => t.EscalaTurnoID == c.EscalaTurnoID)?.Orden ?? 0))
                                            {
                                                <td>
                                                    @if (celda.Asignaciones.Any())
                                                    {
                                                        foreach (var asignacion in celda.Asignaciones)
                                                        {
                                                            <div class="ed-person" data-nsq-style="--person-color: @asignacion.ColorTurno;">
                                                                <span class="ed-person-name">@asignacion.NombrePersona</span>
                                                                <span class="ed-person-meta">
                                                                    @asignacion.NumeroEmpleado ·
                                                                    @asignacion.FechaInicio.ToString("dd/MM") - @asignacion.FechaFin.ToString("dd/MM")
                                                                </span>
                                                                @if (!string.IsNullOrWhiteSpace(asignacion.Observaciones))
                                                                {
                                                                    <span class="ed-person-meta">@asignacion.Observaciones</span>
                                                                }
                                                            </div>
                                                        }
                                                    }
                                                    else
                                                    {
                                                        <span class="ed-cell-empty">Sin personal</span>
                                                    }
                                                </td>
                                            }
                                            <td>
                                                <strong>@totalGrupo</strong>
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    }
                    else
                    {
                        <div class="ed-empty">
                            Aun no hay programacion capturada para esta escala.
                        </div>
                    }
                </div>
            </section>
        </main>

        <aside>
            <section class="ed-panel">
                <div class="ed-panel-head">
                    <div>
                        <h2 class="ed-panel-title">Datos del documento</h2>
                        <p class="ed-panel-subtitle">Informacion general de control.</p>
                    </div>
                </div>
                <div class="ed-panel-body">
                    <div class="ed-list">
                        <div class="ed-list-item">
                            <p class="ed-list-title">Elaborado por</p>
                            <p class="ed-list-meta">
                                @(string.IsNullOrWhiteSpace(Model.Escala.ElaboradoPorNombre)
                                    ? "Sin dato"
                                    : Model.Escala.ElaboradoPorNombre)
                            </p>
                        </div>
                        <div class="ed-list-item">
                            <p class="ed-list-title">Fecha de elaboracion</p>
                            <p class="ed-list-meta">@Model.Escala.FechaElaboracion.ToString("dd/MM/yyyy")</p>
                        </div>
                        <div class="ed-list-item">
                            <p class="ed-list-title">Periodo de trabajo</p>
                            <p class="ed-list-meta">@Model.Escala.PeriodoTrabajo</p>
                        </div>
                        @if (Model.Escala.FechaPublicacion.HasValue)
                        {
                            <div class="ed-list-item">
                                <p class="ed-list-title">Publicado por</p>
                                <p class="ed-list-meta">
                                    @(string.IsNullOrWhiteSpace(Model.Escala.PublicadoPorNombre)
                                        ? "Sin dato"
                                        : Model.Escala.PublicadoPorNombre)
                                </p>
                                <p class="ed-list-meta">
                                    @Model.Escala.FechaPublicacion.Value.ToString("dd/MM/yyyy HH:mm")
                                </p>
                            </div>
                        }
                    </div>

                    @if (!string.IsNullOrWhiteSpace(Model.Escala.Observaciones))
                    {
                        <div class="ed-comment">
                            <strong>Observaciones:</strong><br />
                            @Model.Escala.Observaciones
                        </div>
                    }
                </div>
            </section>

            <section class="ed-panel">
                <div class="ed-panel-head">
                    <div>
                        <h2 class="ed-panel-title">Novedades</h2>
                        <p class="ed-panel-subtitle">Movimientos registrados en la semana.</p>
                    </div>
                    @if (puedeEditar)
                    {
                        <a asp-action="Novedades"
                           asp-route-id="@Model.Escala.EscalaID"
                           class="ed-btn ed-btn-light ed-print-hide">
                            Abrir
                        </a>
                    }
                </div>
                <div class="ed-panel-body">
                    @if (Model.Novedades.Any())
                    {
                        <div class="ed-list">
                            @foreach (var novedad in Model.Novedades)
                            {
                                var fechaFinal = novedad.FechaFin ?? novedad.FechaInicio;
                                var badgeClass = novedad.TipoNovedad == EscalaVM.TiposNovedad.Baja
                                    ? "ed-badge-danger"
                                    : "ed-badge-info";

                                <article class="ed-list-item">
                                    <span class="ed-badge @badgeClass">@novedad.TipoNovedad</span>
                                    <p class="ed-list-title" data-nsq-style-id="nsq-si-566aa0a80b">
                                        @novedad.NombrePersona
                                    </p>
                                    <p class="ed-list-meta">
                                        @novedad.NumeroEmpleado ·
                                        @novedad.FechaInicio.ToString("dd/MM")
                                        @if (fechaFinal.Date != novedad.FechaInicio.Date)
                                        {
                                            <text> - @fechaFinal.ToString("dd/MM")</text>
                                        }
                                    </p>
                                    @if (!string.IsNullOrWhiteSpace(novedad.Motivo))
                                    {
                                        <p class="ed-list-meta">@novedad.Motivo</p>
                                    }
                                </article>
                            }
                        </div>
                    }
                    else
                    {
                        <div class="ed-empty">No hay novedades registradas.</div>
                    }
                </div>
            </section>

            <section class="ed-panel ed-print-hide">
                <div class="ed-panel-head">
                    <div>
                        <h2 class="ed-panel-title">Control de estado</h2>
                        <p class="ed-panel-subtitle">Publicacion y seguimiento del borrador.</p>
                    </div>
                </div>
                <div class="ed-panel-body">
                    <div class="ed-form-actions">
                        @if (puedeEditar)
                        {
                            <form asp-action="Publicar" method="post">
                                @Html.AntiForgeryToken()
                                <input type="hidden" name="escalaID" value="@Model.Escala.EscalaID" />
                                <input type="hidden" name="comentario" value="Publicacion desde detalle." />
                                <button type="submit" class="ed-btn ed-btn-primary">
                                    Publicar
                                </button>
                            </form>
                        }

                        @if (puedeRegresar)
                        {
                            <form asp-action="RegresarABorrador" method="post">
                                @Html.AntiForgeryToken()
                                <input type="hidden" name="escalaID" value="@Model.Escala.EscalaID" />
                                <input type="hidden" name="comentario" value="Regreso a borrador desde detalle." />
                                <button type="submit" class="ed-btn ed-btn-warning">
                                    Regresar a borrador
                                </button>
                            </form>
                        }

                        @if (puedeCancelar)
                        {
                            <form asp-action="Cancelar"
                                  method="post"
                                  onsubmit="return confirm('¿Deseas cancelar esta escala?');">
                                @Html.AntiForgeryToken()
                                <input type="hidden" name="escalaID" value="@Model.Escala.EscalaID" />
                                <input type="hidden" name="comentario" value="Cancelacion desde detalle." />
                                <button type="submit" class="ed-btn ed-btn-danger">
                                    Cancelar
                                </button>
                            </form>
                        }
                    </div>
                </div>
            </section>

            <section class="ed-panel">
                <div class="ed-panel-head">
                    <div>
                        <h2 class="ed-panel-title">Historial</h2>
                        <p class="ed-panel-subtitle">Ultimos movimientos de la escala.</p>
                    </div>
                </div>
                <div class="ed-panel-body">
                    @if (Model.Historial.Any())
                    {
                        <div class="ed-list">
                            @foreach (var movimiento in Model.Historial)
                            {
                                <article class="ed-list-item">
                                    <p class="ed-list-title">
                                        @(string.IsNullOrWhiteSpace(movimiento.EstadoAnterior)
                                            ? "Creacion"
                                            : $"{movimiento.EstadoAnterior} -> {movimiento.EstadoNuevo}")
                                    </p>
                                    <p class="ed-list-meta">
                                        @movimiento.FechaMovimiento.ToString("dd/MM/yyyy HH:mm")
                                        · @movimiento.NombreUsuario
                                    </p>
                                    @if (!string.IsNullOrWhiteSpace(movimiento.Comentario))
                                    {
                                        <p class="ed-list-meta">@movimiento.Comentario</p>
                                    }
                                </article>
                            }
                        </div>
                    }
                    else
                    {
                        <div class="ed-empty">No hay historial disponible.</div>
                    }
                </div>
            </section>
        </aside>
    </div>
</div>
