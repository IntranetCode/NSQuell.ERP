@using EscalaVM = ERP.NSQuell.Models.EscalaPersonal
@model EscalaVM.CatalogoTurnosVM

@{
    ViewData["Title"] = "Catálogo de turnos";
    Layout = "~/Views/Shared/_Layout.cshtml";

    var totalTurnos = Model.Turnos.Count;
    var turnosActivos = Model.Turnos.Count(x => x.Activo);
    var turnosFlexibles = Model.Turnos.Count(x => x.EsFlexible);
    var mostrarModalPorErrores = !ViewData.ModelState.IsValid;

    string HoraInput(TimeSpan? hora)
    {
        return hora.HasValue
            ? hora.Value.ToString(@"hh\:mm")
            : string.Empty;
    }
}

@section Scripts {
    <script src="~/js/shared/nsq-dynamic-style.js" asp-append-version="true"></script>
}


@section Styles {
    <link rel="stylesheet" href="~/css/EscalaPersonal/escala-navegacion.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/EscalaPersonal/turnos.css" asp-append-version="true" />
}


<div class="turnos-page">
    <partial name="_EscalaNavegacion" />
    <header class="ct-header">
        <div>
            <div class="ct-eyebrow">Escala de personal · Configuración</div>
            <h1 class="ct-title">Catálogo de turnos</h1>
            <p class="ct-subtitle">
                Administra los horarios disponibles para construir las escalas semanales.
            </p>
        </div>

        <div class="ct-actions">
            <a asp-action="Index" class="ct-btn ct-btn-secondary">
                <span class="ct-mark">←</span>
                Volver
            </a>
            <button type="button"
                    class="ct-btn ct-btn-primary"
                    data-new-turn>
                <span class="ct-mark">+</span>
                Nuevo turno
            </button>
        </div>
    </header>

    @if (TempData["Exito"] != null)
    {
        <div class="ct-alert ct-alert-success" role="status">
            @TempData["Exito"]
        </div>
    }

    @if (TempData["Error"] != null)
    {
        <div class="ct-alert ct-alert-error" role="alert">
            @TempData["Error"]
        </div>
    }

    <section class="ct-stats" aria-label="Resumen de turnos">
        <article class="ct-stat">
            <span class="ct-stat-mark">TU</span>
            <span>
                <strong class="ct-stat-value">@totalTurnos</strong>
                <span class="ct-stat-label">Turnos registrados</span>
            </span>
        </article>
        <article class="ct-stat">
            <span class="ct-stat-mark">AC</span>
            <span>
                <strong class="ct-stat-value">@turnosActivos</strong>
                <span class="ct-stat-label">Disponibles para nuevas escalas</span>
            </span>
        </article>
        <article class="ct-stat">
            <span class="ct-stat-mark">FL</span>
            <span>
                <strong class="ct-stat-value">@turnosFlexibles</strong>
                <span class="ct-stat-label">Horarios flexibles</span>
            </span>
        </article>
    </section>

    <section class="ct-panel">
        <div class="ct-toolbar">
            <input type="search"
                   id="turnSearch"
                   class="ct-control ct-search"
                   placeholder="Buscar por nombre, tipo u horario..."
                   autocomplete="off" />

            <select id="turnTypeFilter" class="ct-control" aria-label="Filtrar por tipo">
                <option value="">Todos los tipos</option>
                @foreach (var tipo in Model.TiposTurno)
                {
                    <option value="@tipo.Value">@tipo.Text</option>
                }
            </select>

            <select id="turnStatusFilter" class="ct-control" aria-label="Filtrar por estado">
                <option value="">Todos los estados</option>
                <option value="activo">Activos</option>
                <option value="inactivo">Inactivos</option>
            </select>
        </div>

        @if (Model.Turnos.Any())
        {
            <div class="ct-table-wrap">
                <table class="ct-table">
                    <thead>
                        <tr>
                            <th>Turno</th>
                            <th>Tipo</th>
                            <th>Horario</th>
                            <th>Características</th>
                            <th>Orden</th>
                            <th>Estado</th>
                            <th class="text-end">Acciones</th>
                        </tr>
                    </thead>
                    <tbody id="turnRows">
                        @foreach (var turno in Model.Turnos
                            .OrderByDescending(x => x.Activo)
                            .ThenBy(x => x.Orden)
                            .ThenBy(x => x.Nombre))
                        {
                            var estado = turno.Activo ? "activo" : "inactivo";
                            var textoBusqueda =
                                $"{turno.Nombre} {turno.TipoTurno} {turno.HorarioTexto}";

                            <tr data-turn-row
                                data-search="@textoBusqueda"
                                data-type="@turno.TipoTurno"
                                data-status="@estado">
                                <td>
                                    <div class="ct-name-wrap">
                                        <span class="ct-color"
                                              data-nsq-style="background-color:@turno.Color"></span>
                                        <span>
                                            <span class="ct-name">@turno.Nombre</span>
                                            <span class="ct-id">ID @turno.TurnoID</span>
                                        </span>
                                    </div>
                                </td>
                                <td>
                                    <span class="ct-badge ct-badge-type">
                                        @(turno.TipoTurno == EscalaVM.TiposTurno.DocePorDoce
                                            ? "12 x 12"
                                            : turno.TipoTurno)
                                    </span>
                                </td>
                                <td>
                                    <span class="ct-time">@turno.HorarioTexto</span>
                                </td>
                                <td>
                                    <div class="ct-feature-list">
                                        @if (turno.EsFlexible)
                                        {
                                            <span class="ct-feature">Flexible</span>
                                        }
                                        @if (turno.CruzaDiaSiguiente)
                                        {
                                            <span class="ct-feature">Termina al día siguiente</span>
                                        }
                                        @if (!turno.EsFlexible && !turno.CruzaDiaSiguiente)
                                        {
                                            <span class="ct-feature">Horario fijo</span>
                                        }
                                    </div>
                                </td>
                                <td>@turno.Orden</td>
                                <td>
                                    <span class="ct-badge @(turno.Activo ? "ct-badge-active" : "ct-badge-inactive")">
                                        @(turno.Activo ? "Activo" : "Inactivo")
                                    </span>
                                </td>
                                <td>
                                    <div class="ct-row-actions">
                                        <button type="button"
                                                class="ct-link-btn"
                                                data-edit-turn
                                                data-id="@turno.TurnoID"
                                                data-name="@turno.Nombre"
                                                data-start="@HoraInput(turno.HoraInicio)"
                                                data-end="@HoraInput(turno.HoraFin)"
                                                data-next-day="@turno.CruzaDiaSiguiente.ToString().ToLowerInvariant()"
                                                data-flexible="@turno.EsFlexible.ToString().ToLowerInvariant()"
                                                data-type="@turno.TipoTurno"
                                                data-color="@turno.Color"
                                                data-order="@turno.Orden">
                                            Editar
                                        </button>

                                        <form asp-action="CambiarEstadoTurno"
                                              method="post"
                                              class="ct-state-form"
                                              data-state-form
                                              data-name="@turno.Nombre"
                                              data-active="@turno.Activo.ToString().ToLowerInvariant()">
                                            @Html.AntiForgeryToken()
                                            <input type="hidden"
                                                   name="turnoID"
                                                   value="@turno.TurnoID" />
                                            <button type="submit"
                                                    class="ct-link-btn @(turno.Activo ? "ct-link-danger" : string.Empty)">
                                                @(turno.Activo ? "Desactivar" : "Activar")
                                            </button>
                                        </form>
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>

            <div class="ct-empty" id="turnFilterEmpty" hidden>
                <div class="ct-empty-mark">?</div>
                <h2 class="ct-empty-title">No hay coincidencias</h2>
                <p class="ct-empty-text">
                    Ajusta la búsqueda o cambia los filtros seleccionados.
                </p>
            </div>
        }
        else
        {
            <div class="ct-empty">
                <div class="ct-empty-mark">TU</div>
                <h2 class="ct-empty-title">Todavía no hay turnos registrados</h2>
                <p class="ct-empty-text">
                    Crea el primer horario para comenzar a organizar las escalas.
                </p>
                <button type="button"
                        class="ct-btn ct-btn-primary mt-3"
                        data-new-turn>
                    Nuevo turno
                </button>
            </div>
        }
    </section>

    <div class="ct-modal"
         id="turnModal"
         role="dialog"
         aria-modal="true"
         aria-labelledby="turnModalTitle"
         hidden>
        <div class="ct-modal-dialog">
            <form asp-action="GuardarTurno"
                  method="post"
                  id="turnForm">
                @Html.AntiForgeryToken()
                <input asp-for="Formulario.TurnoID" type="hidden" id="turnId" />

                <header class="ct-modal-header">
                    <div>
                        <h2 class="ct-modal-title" id="turnModalTitle">
                            Nuevo turno
                        </h2>
                        <p class="ct-modal-subtitle">
                            Define el horario que podrá utilizarse en nuevas escalas.
                        </p>
                    </div>
                    <button type="button"
                            class="ct-modal-close"
                            data-close-turn
                            aria-label="Cerrar">
                        ×
                    </button>
                </header>

                <div class="ct-modal-body">
                    <div asp-validation-summary="ModelOnly"
                         class="ct-validation-summary"></div>

                    <div class="ct-form-grid">
                        <div class="ct-field-full">
                            <label asp-for="Formulario.Nombre"
                                   class="ct-label ct-required"></label>
                            <input asp-for="Formulario.Nombre"
                                   id="turnName"
                                   class="ct-control"
                                   maxlength="100"
                                   autocomplete="off"
                                   placeholder="Ej. Primer turno" />
                            <span asp-validation-for="Formulario.Nombre"
                                  class="ct-validation"></span>
                        </div>

                        <div>
                            <label asp-for="Formulario.TipoTurno"
                                   class="ct-label ct-required"></label>
                            <select asp-for="Formulario.TipoTurno"
                                    asp-items="Model.TiposTurno"
                                    id="turnType"
                                    class="ct-control"></select>
                            <span asp-validation-for="Formulario.TipoTurno"
                                  class="ct-validation"></span>
                        </div>

                        <div>
                            <label asp-for="Formulario.Orden"
                                   class="ct-label"></label>
                            <input asp-for="Formulario.Orden"
                                   id="turnOrder"
                                   class="ct-control"
                                   type="number"
                                   min="0"
                                   step="1" />
                            <span class="ct-help">
                                Controla la posición del turno en la escala.
                            </span>
                            <span asp-validation-for="Formulario.Orden"
                                  class="ct-validation"></span>
                        </div>

                        <div>
                            <label asp-for="Formulario.HoraInicio"
                                   class="ct-label ct-required"
                                   id="startTimeLabel"></label>
                            <input asp-for="Formulario.HoraInicio"
                                   id="turnStart"
                                   class="ct-control"
                                   type="time"
                                   step="60" />
                            <span asp-validation-for="Formulario.HoraInicio"
                                  class="ct-validation"></span>
                        </div>

                        <div>
                            <label asp-for="Formulario.HoraFin"
                                   class="ct-label ct-required"
                                   id="endTimeLabel"></label>
                            <input asp-for="Formulario.HoraFin"
                                   id="turnEnd"
                                   class="ct-control"
                                   type="time"
                                   step="60" />
                            <span asp-validation-for="Formulario.HoraFin"
                                  class="ct-validation"></span>
                        </div>

                        <div class="ct-field-full">
                            <div class="ct-checks">
                                <label class="ct-check-card">
                                    <input asp-for="Formulario.CruzaDiaSiguiente"
                                           id="turnNextDay"
                                           type="checkbox" />
                                    <span>
                                        <span class="ct-check-title">
                                            Termina al día siguiente
                                        </span>
                                        <span class="ct-check-text">
                                            Úsalo para turnos nocturnos.
                                        </span>
                                    </span>
                                </label>

                                <label class="ct-check-card">
                                    <input asp-for="Formulario.EsFlexible"
                                           id="turnFlexible"
                                           type="checkbox" />
                                    <span>
                                        <span class="ct-check-title">
                                            Horario flexible
                                        </span>
                                        <span class="ct-check-text">
                                            No requiere hora inicial ni final.
                                        </span>
                                    </span>
                                </label>
                            </div>
                        </div>

                        <div class="ct-field-full">
                            <label asp-for="Formulario.Color"
                                   class="ct-label ct-required"></label>
                            <div class="ct-color-row">
                                <input asp-for="Formulario.Color"
                                       id="turnColor"
                                       class="ct-control ct-color-input"
                                       type="color" />
                                <input type="text"
                                       id="turnColorText"
                                       class="ct-control"
                                       maxlength="7"
                                       pattern="^#[0-9A-Fa-f]{6}$"
                                       placeholder="#6C757D" />
                            </div>
                            <span asp-validation-for="Formulario.Color"
                                  class="ct-validation"></span>
                        </div>
                    </div>
                </div>

                <footer class="ct-modal-footer">
                    <button type="button"
                            class="ct-btn ct-btn-secondary"
                            data-close-turn>
                        Cancelar
                    </button>
                    <button type="submit"
                            class="ct-btn ct-btn-primary">
                        Guardar turno
                    </button>
                </footer>
            </form>
        </div>
    </div>
</div>

<script>
    document.addEventListener('DOMContentLoaded', function () {
        const modal = document.getElementById('turnModal');
        const form = document.getElementById('turnForm');
        const modalTitle = document.getElementById('turnModalTitle');
        const idInput = document.getElementById('turnId');
        const nameInput = document.getElementById('turnName');
        const startInput = document.getElementById('turnStart');
        const endInput = document.getElementById('turnEnd');
        const nextDayInput = document.getElementById('turnNextDay');
        const flexibleInput = document.getElementById('turnFlexible');
        const typeInput = document.getElementById('turnType');
        const colorInput = document.getElementById('turnColor');
        const colorText = document.getElementById('turnColorText');
        const orderInput = document.getElementById('turnOrder');
        const searchInput = document.getElementById('turnSearch');
        const typeFilter = document.getElementById('turnTypeFilter');
        const statusFilter = document.getElementById('turnStatusFilter');
        const emptyFilter = document.getElementById('turnFilterEmpty');
        const openWithErrors = @mostrarModalPorErrores.ToString().ToLowerInvariant();

        if (!modal || !form) {
            return;
        }

        function normalize(value) {
            return (value || '')
                .toLocaleLowerCase('es')
                .normalize('NFD')
                .replace(/[\u0300-\u036f]/g, '')
                .trim();
        }

        function updateTimeState() {
            const flexible = flexibleInput.checked;
            startInput.disabled = flexible;
            endInput.disabled = flexible;
            nextDayInput.disabled = flexible;
            startInput.required = !flexible;
            endInput.required = !flexible;

            if (flexible) {
                startInput.value = '';
                endInput.value = '';
                nextDayInput.checked = false;
            }
        }

        function syncColorFromPicker() {
            colorText.value = colorInput.value.toUpperCase();
        }

        function syncColorFromText() {
            const value = colorText.value.trim();
            if (/^#[0-9A-Fa-f]{6}$/.test(value)) {
                colorInput.value = value;
            }
        }

        function openModal() {
            modal.hidden = false;
            document.body.classList.add('ct-modal-open');
            window.setTimeout(function () {
                nameInput.focus();
            }, 40);
        }

        function closeModal() {
            modal.hidden = true;
            document.body.classList.remove('ct-modal-open');
        }

        function prepareNew() {
            form.reset();
            idInput.value = '0';
            modalTitle.textContent = 'Nuevo turno';
            typeInput.value = '@EscalaVM.TiposTurno.Regular';
            colorInput.value = '#6C757D';
            colorText.value = '#6C757D';
            orderInput.value = '0';
            updateTimeState();
            openModal();
        }

        function prepareEdit(button) {
            form.reset();
            idInput.value = button.dataset.id || '0';
            nameInput.value = button.dataset.name || '';
            startInput.value = button.dataset.start || '';
            endInput.value = button.dataset.end || '';
            nextDayInput.checked = button.dataset.nextDay === 'true';
            flexibleInput.checked = button.dataset.flexible === 'true';
            typeInput.value = button.dataset.type || '@EscalaVM.TiposTurno.Regular';
            colorInput.value = button.dataset.color || '#6C757D';
            colorText.value = (button.dataset.color || '#6C757D').toUpperCase();
            orderInput.value = button.dataset.order || '0';
            modalTitle.textContent = 'Editar turno';
            updateTimeState();
            openModal();
        }

        function filterRows() {
            const rows = document.querySelectorAll('[data-turn-row]');
            const query = normalize(searchInput ? searchInput.value : '');
            const selectedType = typeFilter ? typeFilter.value : '';
            const selectedStatus = statusFilter ? statusFilter.value : '';
            let visible = 0;

            rows.forEach(function (row) {
                const matchesSearch =
                    !query || normalize(row.dataset.search).includes(query);
                const matchesType =
                    !selectedType || row.dataset.type === selectedType;
                const matchesStatus =
                    !selectedStatus || row.dataset.status === selectedStatus;
                const show = matchesSearch && matchesType && matchesStatus;

                row.hidden = !show;
                if (show) {
                    visible += 1;
                }
            });

            if (emptyFilter) {
                emptyFilter.hidden = visible !== 0;
            }
        }

        document.querySelectorAll('[data-new-turn]').forEach(function (button) {
            button.addEventListener('click', prepareNew);
        });

        document.querySelectorAll('[data-edit-turn]').forEach(function (button) {
            button.addEventListener('click', function () {
                prepareEdit(button);
            });
        });

        document.querySelectorAll('[data-close-turn]').forEach(function (button) {
            button.addEventListener('click', closeModal);
        });

        document.querySelectorAll('[data-state-form]').forEach(function (stateForm) {
            stateForm.addEventListener('submit', function (event) {
                const isActive = stateForm.dataset.active === 'true';
                const action = isActive ? 'desactivar' : 'activar';
                const name = stateForm.dataset.name || 'este turno';

                if (!window.confirm(
                    '¿Deseas ' + action + ' el turno "' + name + '"?')) {
                    event.preventDefault();
                }
            });
        });

        flexibleInput.addEventListener('change', updateTimeState);
        colorInput.addEventListener('input', syncColorFromPicker);
        colorText.addEventListener('input', syncColorFromText);

        [searchInput, typeFilter, statusFilter].forEach(function (control) {
            if (!control) {
                return;
            }

            control.addEventListener(
                control.tagName === 'INPUT' ? 'input' : 'change',
                filterRows);
        });

        modal.addEventListener('click', function (event) {
            if (event.target === modal) {
                closeModal();
            }
        });

        document.addEventListener('keydown', function (event) {
            if (event.key === 'Escape' && !modal.hidden) {
                closeModal();
            }
        });

        if (openWithErrors) {
            colorText.value = colorInput.value.toUpperCase();
            updateTimeState();
            openModal();
        }
    });
</script>

