@model ERP.NSQuell.Models.ReleasePendientesValidarVm

@{
    Layout = "~/Views/Shared/_Layout.cshtml";
    ViewData["Title"] = "Pendientes de validar | Releases";
}

@section Styles {
    <link rel="stylesheet" href="~/css/PlaneacionRelease/pendientesvalidar.css" asp-append-version="true" />
}


@* PLANEACION_NAVBAR_INJECT_V1_0 *@
    @await Html.PartialAsync("_PlaneacionNavbar")
<div class="page">
    <section class="hero mb-4">
        <div class="d-flex justify-content-between align-items-start gap-3 flex-wrap">
            <div>
                <div class="small fw-bold text-uppercase opacity-75 mb-2">Planeación / Releases</div>
                <h1 class="h3 fw-bold mb-2"><i class="fa-solid fa-list-check me-2"></i>Pendientes de validar</h1>
                <p class="mb-0 opacity-75">Documentos conservados que necesitan identificar uno o más números de parte.</p>
            </div>
            <div class="d-flex gap-2">
                <a asp-action="Crear" class="btn btn-light fw-bold">Cargar documentos</a>
                <a asp-action="Index" class="btn btn-outline-light fw-bold">Volver</a>
            </div>
        </div>
    </section>

    <div class="alert alert-info fw-semibold">Total pendiente: @Model.TotalPendientes</div>

    @if (!Model.Lotes.Any())
    {
        <div class="batch p-5 text-center text-muted">
            <i class="fa-solid fa-circle-check fa-2x text-success mb-3"></i>
            <h2 class="h5 fw-bold">No hay documentos pendientes</h2>
            <p class="mb-0">Todos los lotes analizados están validados, guardados u omitidos.</p>
        </div>
    }
    else
    {
        <div class="d-grid gap-3">
            @foreach (var lote in Model.Lotes)
            {
                <section class="batch">
                    <div class="p-4 border-bottom d-flex justify-content-between align-items-center gap-3 flex-wrap">
                        <div>
                            <h2 class="h5 fw-bold text-primary mb-1">Lote @lote.LoteID</h2>
                            <div class="text-muted small">@lote.FechaProceso.ToString("dd/MM/yyyy HH:mm") · @lote.Pendientes pendiente(s)</div>
                        </div>
                        <a asp-action="ValidacionLote" asp-route-loteId="@lote.LoteID" class="btn btn-main"><i class="fa-solid fa-pen-to-square me-1"></i>Abrir lote</a>
                    </div>
                    <div class="table-responsive">
                        <table class="table align-middle mb-0">
                            <thead><tr><th>Archivo</th><th>Cliente</th><th>Referencias pendientes</th><th>Mensaje</th></tr></thead>
                            <tbody>
                            @foreach (var documento in lote.Documentos.Where(x => x.Estado == ERP.NSQuell.Models.ReleaseValidacionEstados.Pendiente))
                            {
                                <tr>
                                    <td><strong>@documento.Archivo</strong><div class="small text-muted">@documento.Plantilla.Replace("GOLDEN", "GOLDE")</div></td>
                                    <td>@(documento.Cliente ?? "-")</td>
                                    <td>@string.Join(", ", documento.ReleasePreparado.Renglones.Where(x => !x.ParteID.HasValue).Select(x => x.NumeroParte ?? x.ReferenciaSAP ?? "-"))</td>
                                    <td>@documento.Mensaje</td>
                                </tr>
                            }
                            </tbody>
                        </table>
                    </div>
                </section>
            }
        </div>
    }
</div>
