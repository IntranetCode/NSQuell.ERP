@model ERP.NSQuell.Models.ReleaseValidacionLoteVm

@{
    Layout = null;
    string Badge(string estado) => estado switch
    {
        ERP.NSQuell.Models.ReleaseValidacionEstados.Validado => "text-bg-success",
        ERP.NSQuell.Models.ReleaseValidacionEstados.Pendiente => "text-bg-warning",
        ERP.NSQuell.Models.ReleaseValidacionEstados.Guardado => "text-bg-primary",
        ERP.NSQuell.Models.ReleaseValidacionEstados.Omitido => "text-bg-secondary",
        _ => "text-bg-danger"
    };
    string EstadoTexto(string estado) => estado switch
    {
        ERP.NSQuell.Models.ReleaseValidacionEstados.Validado => "Validado",
        ERP.NSQuell.Models.ReleaseValidacionEstados.Pendiente => "Pendiente de validar",
        ERP.NSQuell.Models.ReleaseValidacionEstados.Guardado => "Guardado",
        ERP.NSQuell.Models.ReleaseValidacionEstados.Omitido => "Omitido",
        ERP.NSQuell.Models.ReleaseValidacionEstados.NoSoportado => "No soportado",
        _ => "Error"
    };
}

<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Validación de Releases</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet" />
    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.2/css/all.min.css" rel="stylesheet" />
    <style>
        :root { --blue:#004aad; --blue-dark:#063875; --bg:#f1f5f9; --border:#d8e2ee; }
        body { background:var(--bg); font-family:"Segoe UI",Arial,sans-serif; color:#1f2937; }
        .page { max-width:1750px; margin:0 auto; padding:26px; }
        .hero { padding:26px 30px; border-radius:26px; color:#fff; background:linear-gradient(135deg,var(--blue),var(--blue-dark)); box-shadow:0 18px 45px rgba(0,74,173,.22); }
        .card-modern { border:1px solid var(--border); border-radius:22px; box-shadow:0 10px 28px rgba(16,24,40,.07); overflow:hidden; }
        .metric { height:100%; padding:16px; border:1px solid var(--border); border-radius:18px; background:#fff; }
        .metric strong { display:block; font-size:1.55rem; color:var(--blue-dark); }
        .metric span { color:#667085; font-size:.75rem; font-weight:850; text-transform:uppercase; }
        .btn-main { border:0; border-radius:13px; background:var(--blue); color:#fff; font-weight:850; }
        .btn-main:hover { background:var(--blue-dark); color:#fff; }
        .table th { background:#eef4ff; color:var(--blue-dark); white-space:nowrap; }
        .pending-box { min-width:310px; }
        .file-name { min-width:220px; max-width:320px; overflow-wrap:anywhere; }
    
        /* DETALLE_DOCUMENTO_MODAL_V1_0_1 */
        .file-detail-link {
            display: inline-flex;
            align-items: flex-start;
            gap: 8px;
            max-width: 100%;
            padding: 0;
            border: 0;
            background: transparent;
            color: var(--blue);
            font: inherit;
            font-weight: 850;
            line-height: 1.25;
            text-align: left;
            text-decoration: underline;
            text-decoration-thickness: 1px;
            text-underline-offset: 3px;
            cursor: pointer;
        }

        .file-detail-link:hover,
        .file-detail-link:focus {
            color: var(--blue-dark);
        }

        .file-detail-link span {
            overflow-wrap: anywhere;
        }

        .document-summary-grid {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(190px, 1fr));
            gap: 12px;
        }

        .document-summary-box {
            min-width: 0;
            padding: 13px;
            border: 1px solid var(--border);
            border-radius: 15px;
            background: #f8fafc;
        }

        .document-summary-label {
            margin-bottom: 4px;
            color: #667085;
            font-size: .68rem;
            font-weight: 900;
            letter-spacing: .04em;
            text-transform: uppercase;
        }

        .document-summary-value {
            color: #1f2937;
            font-size: .88rem;
            font-weight: 750;
            overflow-wrap: anywhere;
        }

        .document-part-card {
            overflow: hidden;
            border: 1px solid var(--border);
            border-radius: 17px;
            background: #fff;
        }

        .document-part-header {
            padding: 13px 15px;
            border-bottom: 1px solid var(--border);
            background: #eef4ff;
            color: var(--blue-dark);
        }

        .document-part-body {
            padding: 15px;
        }

        .document-part-meta {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(180px, 1fr));
            gap: 10px;
        }

        .document-delivery-table th {
            background: #f8fafc;
            color: #475467;
            font-size: .72rem;
            white-space: nowrap;
        }

        .document-delivery-table td {
            font-size: .82rem;
        }

        .document-empty {
            padding: 24px;
            border: 1px dashed var(--border);
            border-radius: 16px;
            background: #f8fafc;
            color: #667085;
            text-align: center;
        }
        /* MODAL_EDICION_DOCUMENTO_V2_0 */
        .edit-grid{display:grid;grid-template-columns:repeat(auto-fit,minmax(210px,1fr));gap:12px}
        .edit-field label{display:block;margin-bottom:5px;color:#475467;font-size:.72rem;font-weight:850}
        .edit-part{overflow:hidden;border:1px solid var(--border);border-radius:18px;background:#fff}
        .edit-part-head{padding:12px 15px;border-bottom:1px solid var(--border);background:#eef4ff;color:var(--blue-dark);font-weight:850}
        .edit-part-body{padding:15px}
        .modal-xl{--bs-modal-width:1500px}</style>
</head>
<body>
<div class="page">
    <section class="hero mb-4">
        <div class="d-flex justify-content-between align-items-start gap-3 flex-wrap">
            <div>
                <div class="small fw-bold text-uppercase opacity-75 mb-2">Lote @Model.LoteID</div>
                <h1 class="h3 fw-bold mb-2"><i class="fa-solid fa-clipboard-check me-2"></i>Resultado de validación</h1>
                <p class="mb-0 opacity-75">Revisar no guarda cambios. Selecciona únicamente los documentos validados y confirma el guardado.</p>
            </div>
            <div class="d-flex gap-2 flex-wrap">
                <a asp-action="PendientesValidar" class="btn btn-light fw-bold"><i class="fa-solid fa-list-check me-1"></i>Pendientes de validar</a>
                <a asp-action="Crear" class="btn btn-outline-light fw-bold"><i class="fa-solid fa-plus me-1"></i>Nuevo lote</a>
            </div>
        </div>
    </section>

    @if (TempData["Success"] != null) { <div class="alert alert-success fw-semibold">@TempData["Success"]</div> }
    @if (TempData["Error"] != null) { <div class="alert alert-danger fw-semibold">@TempData["Error"]</div> }
    @if (!string.IsNullOrWhiteSpace(Model.ErrorGeneral)) { <div class="alert alert-danger fw-semibold">@Model.ErrorGeneral</div> }
    @if (!string.IsNullOrWhiteSpace(Model.NotaGeneral)) { <div class="alert alert-info fw-semibold">@Model.NotaGeneral</div> }

    <div class="row g-3 mb-4">
        <div class="col-6 col-xl"><div class="metric"><strong>@Model.Total</strong><span>Documentos</span></div></div>
        <div class="col-6 col-xl"><div class="metric"><strong>@Model.Validados</strong><span>Validados</span></div></div>
        <div class="col-6 col-xl"><div class="metric"><strong>@Model.Pendientes</strong><span>Pendientes</span></div></div>
        <div class="col-6 col-xl"><div class="metric"><strong>@Model.Omitidos</strong><span>Omitidos</span></div></div>
        <div class="col-6 col-xl"><div class="metric"><strong>@Model.Errores</strong><span>Errores</span></div></div>
        <div class="col-6 col-xl"><div class="metric"><strong>@Model.Guardados</strong><span>Guardados</span></div></div>
    </div>

    <section class="card card-modern">
            <div class="card-header bg-white border-0 p-4">
                <div class="d-flex justify-content-between align-items-center gap-3 flex-wrap">
                    <div>
                        <h2 class="h5 fw-bold text-primary mb-1">Documentos analizados</h2>
                        <div class="text-muted small">Los pendientes pueden vincularse escribiendo el número de parte ERP.</div>
                    </div>
                    <button type="button" id="openConfirm" class="btn btn-main px-4" data-bs-toggle="modal" data-bs-target="#confirmModal" @(Model.Validados == 0 ? "disabled" : "")>
                        <i class="fa-solid fa-floppy-disk me-1"></i>Guardar documentos validados
                    </button>
                </div>
            </div>

            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead><tr><th>Guardar</th><th>Estado</th><th>Archivo</th><th>Cliente</th><th>Partes</th><th>Entregas</th><th>Piezas</th><th>Resultado / validación</th></tr></thead>
                    <tbody>
                    @foreach (var documento in Model.Documentos)
                    {
                        <tr>
                            <td class="text-center">
                                @if (documento.Estado == ERP.NSQuell.Models.ReleaseValidacionEstados.Validado)
                                {
                                    <input type="checkbox" class="form-check-input document-check" form="saveForm" name="documentosSeleccionados" value="@documento.DocumentoID" form="saveForm" checked />
                                }
                                else { <span class="text-muted">—</span> }
                            </td>
                            <td><span class="badge @Badge(documento.Estado)">@EstadoTexto(documento.Estado)</span></td>
                            <td class="file-name">
                                <button type="button"
                                        class="file-detail-link"
                                        data-bs-toggle="modal"
                                        data-bs-target="#detalleDocumento_@documento.DocumentoID"
                                        aria-label="Ver desglose de @documento.Archivo"
                                        title="Ver toda la información que se agregará">
                                    <i class="fa-solid fa-file-circle-info"></i>
                                    <span>@documento.Archivo</span>
                                </button>

                                <div class="small text-muted">
                                    @documento.Plantilla.Replace("GOLDEN", "GOLDE")
                                </div>
                            </td>
                            <td><div class="fw-bold">@(documento.Cliente ?? "-")</div><div class="small text-muted">@(documento.FolioCliente ?? "-")</div></td>
                            <td>
                                <div>@(string.IsNullOrWhiteSpace(documento.PartesTexto) ? "-" : documento.PartesTexto)</div>
                                @if (documento.PartesPendientes > 0) { <div class="small text-warning-emphasis fw-bold">@documento.PartesPendientes pendiente(s)</div> }
                            </td>
                            <td>@documento.TotalEntregas.ToString("N0")</td>
                            <td>@documento.TotalPiezas.ToString("N0")</td>
                            <td class="pending-box">
                                <div class="mb-2">@documento.Mensaje</div>
                                @if (documento.Advertencias.Any())
                                {
                                    <ul class="small text-warning-emphasis ps-3">
                                        @foreach (var warning in documento.Advertencias) { <li>@warning</li> }
                                    </ul>
                                }
                                @if (documento.Estado == ERP.NSQuell.Models.ReleaseValidacionEstados.Pendiente)
                                {
                                    for (var i = 0; i < documento.ReleasePreparado.Renglones.Count; i++)
                                    {
                                        var renglon = documento.ReleasePreparado.Renglones[i];
                                        if (!renglon.ParteID.HasValue)
                                        {
                                            <div class="border rounded-3 p-3 bg-light mb-2">
                                                <div class="small fw-bold mb-2">Referencia recibida: <span class="text-primary">@(renglon.NumeroParte ?? renglon.ReferenciaSAP ?? "-")</span></div>
                                                <form asp-action="VincularPartePendiente" method="post">
                                                    @Html.AntiForgeryToken()
                                                    <input type="hidden" name="loteId" value="@Model.LoteID" />
                                                    <input type="hidden" name="documentoId" value="@documento.DocumentoID" />
                                                    <input type="hidden" name="renglonIndex" value="@i" />
                                                    <div class="input-group">
                                                        @* PARTES_VALIDACION_SELECT_V1_0_4 *@
                                                        <select name="numeroParte"
                                                                class="form-select parte-validacion-select"
                                                                data-cliente-id="@documento.ClienteID"
                                                                required>
                                                            <option value="">
                                                                Cargando números de parte...
                                                            </option>
                                                        </select>
                                                        <button type="submit" class="btn btn-outline-primary fw-bold">Validar parte</button>
                                                    </div>
                                                </form>
                                            </div>
                                        }
                                    }
                                }
                            </td>
                        </tr>
                    }
                    </tbody>
                </table>
            </div>
    </section>

            @* MODAL_EDICION_DOCUMENTO_V2_0 *@
    @foreach (var documento in Model.Documentos)
    {
        var preparado = documento.ReleasePreparado;

        <div class="modal fade document-edit-modal"
             id="detalleDocumento_@documento.DocumentoID"
             tabindex="-1"
             aria-hidden="true">

            <div class="modal-dialog modal-xl modal-dialog-centered modal-dialog-scrollable">
                <div class="modal-content border-0 rounded-4 shadow">
                    <form asp-action="GuardarEdicionDocumentoPreparado" method="post">
                        @Html.AntiForgeryToken()

                        <input type="hidden" name="LoteID" value="@Model.LoteID" />
                        <input type="hidden" name="DocumentoID" value="@documento.DocumentoID" />

                        <div class="modal-header border-0 pb-0">
                            <div>
                                <div class="small text-muted fw-bold text-uppercase">
                                    Vista previa editable antes de agregar
                                </div>
                                <h2 class="modal-title h5 fw-bold text-primary">
                                    <i class="fa-solid fa-file-pen me-2"></i>@documento.Archivo
                                </h2>
                            </div>
                            <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                        </div>

                        <div class="modal-body">
                            <div class="alert alert-info fw-semibold">
                                Guardar aqui solo modifica el lote preparado. Todavia no crea el Release.
                            </div>

                            <h3 class="h6 fw-bold text-primary mb-3">Datos generales</h3>

                            <div class="edit-grid mb-3">
                                <div class="edit-field">
                                    <label>Cliente</label>
                                    <select name="ClienteID"
                                            class="form-select edit-client-select"
                                            data-current="@documento.ClienteID"
                                            required>
                                        <option value="">Cargando clientes...</option>
                                    </select>
                                </div>

                                <div class="edit-field">
                                    <label>Folio cliente / contrato / schedule</label>
                                    <input name="FolioCliente"
                                           class="form-control"
                                           value="@(documento.FolioCliente ?? preparado.FolioCliente)"
                                           maxlength="150" />
                                </div>

                                <div class="edit-field">
                                    <label>Version / semana</label>
                                    <input name="Version"
                                           class="form-control"
                                           value="@(documento.Version ?? preparado.VersionRelease)"
                                           maxlength="100" />
                                </div>

                                <div class="edit-field">
                                    <label>Fecha del documento</label>
                                    <input name="FechaDocumento"
                                           type="date"
                                           class="form-control"
                                           value="@(documento.FechaDocumento?.ToString("yyyy-MM-dd"))" />
                                </div>

                                <div class="edit-field">
                                    <label>Fecha de recepcion</label>
                                    <input name="FechaRecepcion"
                                           type="date"
                                           class="form-control"
                                           value="@preparado.FechaRecepcion.ToString("yyyy-MM-dd")"
                                           required />
                                </div>
                            </div>

                            <div class="edit-field mb-4">
                                <label>Observaciones del Release</label>
                                <textarea name="Observaciones"
                                          class="form-control"
                                          rows="3"
                                          maxlength="2000">@preparado.Observaciones</textarea>
                            </div>

                            <h3 class="h5 fw-bold text-primary mb-3">
                                Partes y entregas que se agregaran
                            </h3>

                            <div class="d-grid gap-3">
                                @for (var i = 0; i < preparado.Renglones.Count; i++)
                                {
                                    var renglon = preparado.Renglones[i];

                                    <article class="edit-part">
                                        <div class="edit-part-head">
                                            Parte @(i + 1)
                                            · @(renglon.NumeroParte ?? renglon.ReferenciaSAP ?? "Sin parte")
                                        </div>

                                        <div class="edit-part-body">
                                            <div class="edit-grid mb-3">
                                                <div class="edit-field">
                                                    <label>Numero de parte</label>
                                                    <input name="Renglones[@i].NumeroParte"
                                                           class="form-control"
                                                           value="@renglon.NumeroParte"
                                                           maxlength="150" />
                                                </div>

                                                <div class="edit-field">
                                                    <label>Referencia SAP</label>
                                                    <input name="Renglones[@i].ReferenciaSAP"
                                                           class="form-control"
                                                           value="@renglon.ReferenciaSAP"
                                                           maxlength="150" />
                                                </div>

                                                <div class="edit-field">
                                                    <label>Descripcion / designacion</label>
                                                    <input name="Renglones[@i].DesignacionDescripcionSAP"
                                                           class="form-control"
                                                           value="@renglon.DesignacionDescripcionSAP"
                                                           maxlength="300" />
                                                </div>

                                                <div class="edit-field">
                                                    <label>Unidad de medida</label>
                                                    <input name="Renglones[@i].UnidadMedidaCliente"
                                                           class="form-control"
                                                           value="@renglon.UnidadMedidaCliente"
                                                           maxlength="100" />
                                                </div>

                                                <div class="edit-field">
                                                    <label>Contrato cliente</label>
                                                    <input name="Renglones[@i].ContratoCliente"
                                                           class="form-control"
                                                           value="@renglon.ContratoCliente"
                                                           maxlength="150" />
                                                </div>
                                            </div>

                                            <div class="edit-field mb-3">
                                                <label>Observaciones de la parte</label>
                                                <textarea name="Renglones[@i].Observaciones"
                                                          class="form-control"
                                                          rows="2"
                                                          maxlength="1000">@renglon.Observaciones</textarea>
                                            </div>

                                            <div class="table-responsive">
                                                <table class="table table-sm table-bordered align-middle mb-0">
                                                    <thead>
                                                        <tr>
                                                            <th>Fecha requerida</th>
                                                            <th>Fecha de carga</th>
                                                            <th>Cantidad</th>
                                                        </tr>
                                                    </thead>
                                                    <tbody>
                                                        @for (var j = 0; j < renglon.Entregas.Count; j++)
                                                        {
                                                            var entrega = renglon.Entregas[j];

                                                            <tr>
                                                                <td>
                                                                    <input name="Renglones[@i].Entregas[@j].FechaRequerida"
                                                                           type="date"
                                                                           class="form-control form-control-sm"
                                                                           value="@(entrega.FechaRequerida?.ToString("yyyy-MM-dd"))"
                                                                           required />
                                                                </td>
                                                                <td>
                                                                    <input name="Renglones[@i].Entregas[@j].FechaCarga"
                                                                           type="date"
                                                                           class="form-control form-control-sm"
                                                                           value="@(entrega.FechaCarga?.ToString("yyyy-MM-dd"))" />
                                                                </td>
                                                                <td>
                                                                    <input name="Renglones[@i].Entregas[@j].CantidadRequerida"
                                                                           type="number"
                                                                           class="form-control form-control-sm"
                                                                           value="@entrega.CantidadRequerida"
                                                                           min="1"
                                                                           step="1"
                                                                           required />
                                                                </td>
                                                            </tr>
                                                        }
                                                    </tbody>
                                                </table>
                                            </div>
                                        </div>
                                    </article>
                                }
                            </div>
                        </div>

                        <div class="modal-footer border-0">
                            <button type="button"
                                    class="btn btn-outline-secondary fw-bold"
                                    data-bs-dismiss="modal">
                                Cerrar
                            </button>

                            <button type="submit"
                                    class="btn btn-main px-4"
                                    @(documento.Estado == ERP.NSQuell.Models.ReleaseValidacionEstados.Guardado ? "disabled" : "")>
                                <i class="fa-solid fa-floppy-disk me-1"></i>
                                Guardar cambios
                            </button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    }
<div id="validationTableContainer">
        @Html.AntiForgeryToken()
        <input type="hidden" name="loteId" value="@Model.LoteID" />
    </div>

    <div class="d-flex justify-content-end gap-2 mt-4"><a asp-action="Index" class="btn btn-outline-secondary fw-bold">Volver a Releases</a></div>
</div>

<form asp-action="ConfirmarImportacionValidada"
      method="post"
      id="saveForm"
      class="d-none">
    @Html.AntiForgeryToken()
    <input type="hidden" name="loteId" value="@Model.LoteID" />
</form>
<div class="modal fade" id="confirmModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content border-0 rounded-4 shadow">
            <div class="modal-header border-0"><h2 class="modal-title h5 fw-bold text-primary">Confirmar guardado</h2><button type="button" class="btn-close" data-bs-dismiss="modal"></button></div>
            <div class="modal-body">
                <p>Se crearán <strong id="selectedCount">0</strong> Release(s) validados.</p>
                <div class="alert alert-warning mb-0">Las versiones anteriores correspondientes pueden cerrarse. Los documentos pendientes, omitidos o con error no se guardarán.</div>
            </div>
            <div class="modal-footer border-0">
                <button type="button" class="btn btn-light fw-bold" data-bs-dismiss="modal">Cancelar</button>
                <button type="button" id="confirmSave" class="btn btn-main px-4">Sí, guardar cambios</button>
            </div>
        </div>
    </div>
</div>

<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
<script>
    const checks = Array.from(document.querySelectorAll('.document-check'));
    const selectedCount = document.getElementById('selectedCount');
    const confirmSave = document.getElementById('confirmSave');
    const saveForm = document.getElementById('saveForm');
    function updateCount() { selectedCount.textContent = checks.filter(x => x.checked).length; }
    checks.forEach(x => x.addEventListener('change', updateCount));
    document.getElementById('openConfirm')?.addEventListener('click', updateCount);
    confirmSave?.addEventListener('click', () => {
        if (checks.filter(x => x.checked).length === 0) { alert('Selecciona al menos un documento validado.'); return; }
        confirmSave.disabled = true;
        confirmSave.innerHTML = '<span class="spinner-border spinner-border-sm me-2"></span>Guardando...';
        saveForm.submit();
    });
    updateCount();

    // PARTES_VALIDACION_SELECT_SCRIPT_V1_0_4
    const loteValidacionId = '@Model.LoteID';

    const urlPartesValidacion =
        '@Url.Action("ObtenerPartesValidacion", "PlaneacionRelease")';

    const urlRevalidarGolde =
        '@Url.Action("RevalidarLoteGolde", "PlaneacionRelease")';

    const partesPorCliente = new Map();

    async function obtenerPartesCliente(clienteId) {
        const key = String(clienteId);

        if (partesPorCliente.has(key)) {
            return partesPorCliente.get(key);
        }

        const response = await fetch(
            `${urlPartesValidacion}?clienteId=${encodeURIComponent(clienteId)}`
        );

        const data = await response.json();

        if (!response.ok || !data.ok) {
            throw new Error(
                data.mensaje ||
                'No se pudo cargar el catálogo de partes.'
            );
        }

        const partes = data.partes || [];
        partesPorCliente.set(key, partes);

        return partes;
    }

    async function cargarListadosPartes() {
        const selects = Array.from(
            document.querySelectorAll(
                '.parte-validacion-select'
            )
        );

        for (const select of selects) {
            const clienteId =
                select.dataset.clienteId;

            if (!clienteId) {
                select.innerHTML =
                    '<option value="">Cliente no identificado</option>';

                select.disabled = true;
                continue;
            }

            try {
                const partes =
                    await obtenerPartesCliente(clienteId);

                select.innerHTML =
                    '<option value="">-- Número de parte | Referencia SAP | Designación --</option>';

                for (const parte of partes) {
                    const option =
                        document.createElement('option');

                    option.value =
                        parte.value || '';

                    option.textContent =
                        parte.text ||
                        parte.value ||
                        '';

                    select.appendChild(option);
                }

                if (partes.length === 0) {
                    select.innerHTML =
                        '<option value="">No hay partes activas para este cliente</option>';

                    select.disabled = true;
                }
            }
            catch (error) {
                console.error(error);

                select.innerHTML =
                    '<option value="">Error al cargar las partes</option>';

                select.disabled = true;
            }
        }
    }

    async function revalidarGolde() {
        const token =
            document.querySelector(
                'input[name="__RequestVerificationToken"]'
            )?.value;

        if (!token || !loteValidacionId) {
            return;
        }

        const body =
            new URLSearchParams();

        body.set(
            'loteId',
            loteValidacionId
        );

        const response = await fetch(
            urlRevalidarGolde,
            {
                method: 'POST',
                headers: {
                    'Content-Type':
                        'application/x-www-form-urlencoded;charset=UTF-8',
                    'RequestVerificationToken':
                        token
                },
                body: body.toString()
            }
        );

        const data = await response.json();

        if (!response.ok || !data.ok) {
            console.error(
                data.mensaje ||
                'No se pudo revalidar GOLDE.'
            );

            return;
        }

        if ((data.actualizadas || 0) > 0) {
            window.location.reload();
        }
    }

    document.addEventListener(
        'DOMContentLoaded',
        async () => {
            await revalidarGolde();
            await cargarListadosPartes();
        }
    );
    // MODAL_EDICION_DOCUMENTO_V2_0
    const urlClientesModalEdicion =
        '@Url.Action("ObtenerClientesValidacionEdicion", "PlaneacionRelease")';

    let clientesModalEdicion = null;

    async function cargarClientesModalEdicion() {
        if (!clientesModalEdicion) {
            const response = await fetch(urlClientesModalEdicion);
            const data = await response.json();

            if (!response.ok || !data.ok) {
                throw new Error(data.mensaje || 'No se pudieron cargar los clientes.');
            }

            clientesModalEdicion = data.clientes || [];
        }

        for (const select of document.querySelectorAll('.edit-client-select')) {
            if (select.dataset.loaded === '1') {
                continue;
            }

            const current = String(select.dataset.current || '');
            select.innerHTML = '<option value="">-- Selecciona cliente --</option>';

            for (const cliente of clientesModalEdicion) {
                const option = document.createElement('option');
                option.value = cliente.id;
                option.textContent = cliente.text || `Cliente ${cliente.id}`;
                option.selected = String(cliente.id) === current;
                select.appendChild(option);
            }

            select.dataset.loaded = '1';
        }
    }

    document.addEventListener('shown.bs.modal', async event => {
        if (!event.target.classList.contains('document-edit-modal')) {
            return;
        }

        try {
            await cargarClientesModalEdicion();
        }
        catch (error) {
            alert(error.message);
        }
    });</script>
</body>
</html>