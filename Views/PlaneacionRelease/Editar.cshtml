@model ERP.NSQuell.Models.PlaneacionReleaseEditarVm

@{
    Layout = null;
}

<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Editar Release | Planeación</title>

    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet" />
    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.2/css/all.min.css" rel="stylesheet" />

    <style>
        :root {
            --blue:#004aad;
            --blue-dark:#063875;
            --bg:#eef3f9;
            --border:#d8e2ee;
            --text:#1f2937;
            --muted:#667085;
            --warning:#b54708;
        }

        * { box-sizing:border-box; }

        body {
            margin:0;
            min-height:100vh;
            font-family:"Segoe UI",Arial,sans-serif;
            color:var(--text);
            background:
                radial-gradient(circle at top left,rgba(0,74,173,.12),transparent 28%),
                linear-gradient(180deg,#f8fbff,var(--bg));
        }

        .page {
            max-width:1600px;
            margin:0 auto;
            padding:26px;
        }

        .hero {
            padding:28px 30px;
            border-radius:28px;
            color:#fff;
            background:linear-gradient(135deg,var(--blue),var(--blue-dark));
            box-shadow:0 22px 55px rgba(0,74,173,.23);
        }

        .hero h1 {
            margin:0;
            font-size:1.8rem;
            font-weight:950;
        }

        .hero p {
            margin:7px 0 0;
            color:rgba(255,255,255,.85);
        }

        .btn-glass {
            display:inline-flex;
            align-items:center;
            gap:7px;
            padding:10px 14px;
            border:1px solid rgba(255,255,255,.35);
            border-radius:14px;
            background:rgba(255,255,255,.14);
            color:#fff;
            text-decoration:none;
            font-weight:850;
        }

        .btn-glass:hover {
            background:#fff;
            color:var(--blue);
        }

        .card-main {
            margin-top:20px;
            border:1px solid var(--border);
            border-radius:24px;
            background:#fff;
            box-shadow:0 14px 38px rgba(16,24,40,.08);
            overflow:hidden;
        }

        .card-head {
            padding:18px 22px;
            border-bottom:1px solid var(--border);
            background:linear-gradient(135deg,#fff,#f7fbff);
        }

        .card-body-modern {
            padding:22px;
        }

        .form-control,
        .form-select {
            min-height:45px;
            border-radius:13px;
            border-color:var(--border);
        }

        .label {
            margin-bottom:6px;
            color:#344054;
            font-size:.8rem;
            font-weight:850;
        }

        .row-card {
            margin-bottom:18px;
            border:1px solid var(--border);
            border-radius:20px;
            background:#fff;
            overflow:hidden;
            box-shadow:0 8px 22px rgba(16,24,40,.05);
        }

        .row-head {
            display:flex;
            justify-content:space-between;
            align-items:center;
            gap:12px;
            flex-wrap:wrap;
            padding:14px 17px;
            background:#eef5ff;
            border-bottom:1px solid var(--border);
        }

        .row-body { padding:18px; }

        .delivery {
            padding:13px;
            margin-bottom:10px;
            border:1px solid var(--border);
            border-radius:15px;
            background:#fbfdff;
        }

        .btn-main {
            border:0;
            border-radius:13px;
            background:var(--blue);
            color:#fff;
            font-weight:850;
        }

        .btn-main:hover {
            background:var(--blue-dark);
            color:#fff;
        }

        .sticky-actions {
            position:sticky;
            bottom:0;
            z-index:20;
            margin-top:20px;
            padding:13px;
            border:1px solid var(--border);
            border-radius:18px;
            background:rgba(255,255,255,.94);
            backdrop-filter:blur(12px);
            box-shadow:0 14px 34px rgba(16,24,40,.10);
        }

        .impact {
            border:1px solid #fed7aa;
            background:#fff7ed;
            color:#9a3412;
            border-radius:18px;
            padding:16px;
            font-weight:700;
        }

        @@media(max-width:768px) {
            .page { padding:14px; }
            .hero { border-radius:22px; }
        }
    </style>
</head>

<body>
<div class="page">
    <section class="hero">
        <div class="d-flex justify-content-between align-items-start gap-3 flex-wrap">
            <div>
                <div class="small fw-bold text-uppercase opacity-75 mb-2">
                    Planeación / Releases
                </div>
                <h1>
                    <i class="fa-solid fa-pen-to-square me-2"></i>
                    Editar Release @Model.FolioRelease
                </h1>
                <p>
                    Los cambios recalculan las necesidades del Release y pueden invalidar programación pendiente relacionada.
                </p>
            </div>

            <a asp-action="Detalle"
               asp-route-id="@Model.ReleaseID"
               class="btn-glass">
                <i class="fa-solid fa-arrow-left"></i>
                Volver al detalle
            </a>
        </div>
    </section>

    @if (Model.TieneProgramaBloqueado)
    {
        <div class="alert alert-danger rounded-4 fw-semibold mt-3">
            <i class="fa-solid fa-ban me-2"></i>
            Este Release tiene producción en proceso, terminada o cerrada.
            La edición está bloqueada para proteger el historial productivo.
        </div>
    }
    else if (Model.TienePlaneacionVinculada)
    {
        <div class="impact mt-3">
            <i class="fa-solid fa-triangle-exclamation me-2"></i>
            Este Release tiene @Model.ProgramasVinculados programa(s) pendiente(s).
            Al guardar se cancelarán esas programaciones y las necesidades deberán generarse nuevamente con la información corregida.
        </div>
    }

    <form asp-action="Editar"
          method="post"
          id="editForm">
        @Html.AntiForgeryToken()

        <input asp-for="ReleaseID" type="hidden" />
        <input asp-for="ConfirmarImpacto" type="hidden" id="ConfirmarImpacto" />
        <input asp-for="ArchivoOrigenNombre" type="hidden" />
        <input asp-for="PlantillaImportacion" type="hidden" />
        <input asp-for="ImportadoDesdeArchivo" type="hidden" />
        <input asp-for="EstatusID" type="hidden" />

        <div asp-validation-summary="All"
             class="alert alert-danger rounded-4 fw-semibold mt-3"></div>

        <section class="card-main">
            <div class="card-head">
                <h2 class="h5 fw-bold text-primary mb-1">
                    <i class="fa-solid fa-file-lines me-2"></i>
                    Encabezado
                </h2>
                <div class="text-muted small">
                    Información general del Release.
                </div>
            </div>

            <div class="card-body-modern">
                <div class="row g-3">
                    <div class="col-md-6 col-xl-3">
                        <label asp-for="ClienteID" class="label">Cliente</label>
                        <select asp-for="ClienteID"
                                class="form-select"
                                id="ClienteID"
                                required>
                            <option value="">-- Selecciona cliente --</option>
                            @foreach (var cliente in Model.Clientes)
                            {
                                <option value="@cliente.Value"
                                        selected="@(cliente.Value == Model.ClienteID?.ToString())">
                                    @cliente.Text
                                </option>
                            }
                        </select>
                        <input asp-for="ClienteNombre"
                               type="hidden"
                               id="ClienteNombre" />
                    </div>

                    <div class="col-md-6 col-xl-3">
                        <label asp-for="FolioRelease" class="label">Folio interno</label>
                        <input asp-for="FolioRelease"
                               class="form-control"
                               maxlength="40" />
                    </div>

                    <div class="col-md-6 col-xl-3">
                        <label asp-for="FolioCliente" class="label">
                            Folio cliente / Schedule / Contrato
                        </label>
                        <input asp-for="FolioCliente"
                               class="form-control"
                               maxlength="100" />
                    </div>

                    <div class="col-md-6 col-xl-3">
                        <label asp-for="FechaRecepcion" class="label">Fecha de recepción</label>
                        <input asp-for="FechaRecepcion"
                               type="date"
                               class="form-control"
                               required />
                    </div>

                    <div class="col-md-6 col-xl-3">
                        <label asp-for="VersionRelease" class="label">Semana / versión</label>
                        <input asp-for="VersionRelease"
                               class="form-control"
                               maxlength="50" />
                    </div>

                    <div class="col-md-6 col-xl-3">
                        <label class="label">Origen</label>
                        <input class="form-control"
                               value="@(Model.ImportadoDesdeArchivo ? "Archivo" : "Manual")"
                               readonly />
                    </div>

                    <div class="col-md-6 col-xl-6">
                        <label class="label">Archivo / plantilla</label>
                        <input class="form-control"
                               value="@($"{Model.ArchivoOrigenNombre ?? "-"} · {Model.PlantillaImportacion ?? "-"}")"
                               readonly />
                    </div>

                    <div class="col-12">
                        <label asp-for="Observaciones" class="label">Observaciones</label>
                        <textarea asp-for="Observaciones"
                                  class="form-control"
                                  maxlength="500"
                                  rows="3"></textarea>
                    </div>
                </div>
            </div>
        </section>

        <section class="card-main">
            <div class="card-head d-flex justify-content-between align-items-center gap-3 flex-wrap">
                <div>
                    <h2 class="h5 fw-bold text-primary mb-1">
                        <i class="fa-solid fa-list-ol me-2"></i>
                        Renglones y entregas
                    </h2>
                    <div class="text-muted small">
                        Modifica parte, contrato, fechas o cantidades.
                    </div>
                </div>

                <button type="button"
                        id="addRow"
                        class="btn btn-main">
                    <i class="fa-solid fa-plus me-1"></i>
                    Agregar renglón
                </button>
            </div>

            <div class="card-body-modern" id="rowsContainer">
                @for (var i = 0; i < Model.Renglones.Count; i++)
                {
                    var renglon = Model.Renglones[i];

                    <article class="row-card release-row" data-index="@i">
                        <div class="row-head">
                            <strong>
                                Renglón <span class="row-number">@(i + 1)</span>
                            </strong>

                            <div class="d-flex gap-2">
                                <button type="button"
                                        class="btn btn-sm btn-outline-primary add-delivery">
                                    <i class="fa-solid fa-calendar-plus me-1"></i>
                                    Agregar entrega
                                </button>

                                <button type="button"
                                        class="btn btn-sm btn-outline-danger remove-row">
                                    <i class="fa-regular fa-trash-can"></i>
                                </button>
                            </div>
                        </div>

                        <div class="row-body">
                            <input type="hidden"
                                   class="row-sequence"
                                   name="Renglones[@i].Renglon"
                                   value="@(i + 1)" />

                            <input type="hidden"
                                   class="numero-parte"
                                   name="Renglones[@i].NumeroParte"
                                   value="@renglon.NumeroParte" />

                            <input type="hidden"
                                   class="referencia-sap"
                                   name="Renglones[@i].ReferenciaSAP"
                                   value="@renglon.ReferenciaSAP" />

                            <input type="hidden"
                                   class="descripcion-parte"
                                   name="Renglones[@i].DesignacionDescripcionSAP"
                                   value="@renglon.DesignacionDescripcionSAP" />

                            <div class="row g-3 mb-3">
                                <div class="col-lg-5">
                                    <label class="label">Parte</label>
                                    <select name="Renglones[@i].ParteID"
                                            class="form-select part-select"
                                            data-selected="@renglon.ParteID"
                                            required>
                                        <option value="">-- Selecciona parte --</option>
                                        @foreach (var parte in Model.Partes)
                                        {
                                            <option value="@parte.Value"
                                                    selected="@(parte.Value == renglon.ParteID?.ToString())">
                                                @parte.Text
                                            </option>
                                        }
                                    </select>
                                </div>

                                <div class="col-lg-3">
                                    <label class="label">Unidad cliente</label>
                                    <input name="Renglones[@i].UnidadMedidaCliente"
                                           value="@renglon.UnidadMedidaCliente"
                                           class="form-control unit-input"
                                           maxlength="30" />
                                </div>

                                <div class="col-lg-4">
                                    <label class="label">Contrato / orden cliente</label>
                                    <input name="Renglones[@i].ContratoCliente"
                                           value="@renglon.ContratoCliente"
                                           class="form-control contract-input"
                                           maxlength="100" />
                                </div>

                                <div class="col-12">
                                    <div class="small text-muted part-description">
                                        @(renglon.DesignacionDescripcionSAP ?? renglon.ReferenciaSAP ?? renglon.NumeroParte ?? "Sin descripción")
                                    </div>
                                </div>
                            </div>

                            <div class="deliveries">
                                @for (var j = 0; j < renglon.Entregas.Count; j++)
                                {
                                    var entrega = renglon.Entregas[j];

                                    <div class="delivery delivery-item" data-index="@j">
                                        <input type="hidden"
                                               class="delivery-sequence"
                                               name="Renglones[@i].Entregas[@j].SecuenciaEntrega"
                                               value="@(j + 1)" />

                                        <div class="row g-2 align-items-end">
                                            <div class="col-md-4">
                                                <label class="label">Fecha carga</label>
                                                <input name="Renglones[@i].Entregas[@j].FechaCarga"
                                                       type="date"
                                                       value="@(entrega.FechaCarga?.ToString("yyyy-MM-dd"))"
                                                       class="form-control load-date" />
                                            </div>

                                            <div class="col-md-4">
                                                <label class="label">Fecha requerida</label>
                                                <input name="Renglones[@i].Entregas[@j].FechaRequerida"
                                                       type="date"
                                                       value="@(entrega.FechaRequerida?.ToString("yyyy-MM-dd"))"
                                                       class="form-control required-date"
                                                       required />
                                            </div>

                                            <div class="col-md-3">
                                                <label class="label">Cantidad</label>
                                                <input name="Renglones[@i].Entregas[@j].CantidadRequerida"
                                                       type="number"
                                                       min="1"
                                                       step="1"
                                                       value="@entrega.CantidadRequerida"
                                                       class="form-control quantity"
                                                       required />
                                            </div>

                                            <div class="col-md-1 d-grid">
                                                <button type="button"
                                                        class="btn btn-outline-danger remove-delivery">
                                                    <i class="fa-regular fa-trash-can"></i>
                                                </button>
                                            </div>
                                        </div>
                                    </div>
                                }
                            </div>
                        </div>
                    </article>
                }
            </div>
        </section>

        <div class="sticky-actions">
            <div class="d-flex justify-content-end gap-2 flex-wrap">
                <a asp-action="Detalle"
                   asp-route-id="@Model.ReleaseID"
                   class="btn btn-light border fw-bold">
                    Cancelar
                </a>

                <button type="button"
                        id="openConfirm"
                        class="btn btn-main px-4"
                        @(Model.TieneProgramaBloqueado ? "disabled" : "")>
                    <i class="fa-solid fa-floppy-disk me-1"></i>
                    Guardar cambios
                </button>
            </div>
        </div>
    </form>
</div>

<div class="modal fade"
     id="confirmModal"
     tabindex="-1"
     aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content border-0 rounded-4 shadow">
            <div class="modal-header border-0">
                <h2 class="modal-title h5 fw-bold text-primary">
                    Confirmar edición del Release
                </h2>
                <button type="button"
                        class="btn-close"
                        data-bs-dismiss="modal"></button>
            </div>

            <div class="modal-body">
                <p class="fw-semibold">
                    ¿Estás seguro de guardar estos cambios?
                </p>

                <div class="alert alert-warning mb-0">
                    Se recalcularán las necesidades del Release.
                    La programación pendiente y las asignaciones relacionadas
                    se cancelarán para generar nuevamente el flujo con los datos corregidos.
                </div>
            </div>

            <div class="modal-footer border-0">
                <button type="button"
                        class="btn btn-light border fw-bold"
                        data-bs-dismiss="modal">
                    Cancelar
                </button>

                <button type="button"
                        id="confirmSave"
                        class="btn btn-main px-4">
                    Sí, guardar cambios
                </button>
            </div>
        </div>
    </div>
</div>

<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>

<script>
(() => {
    const form = document.getElementById('editForm');
    const rowsContainer = document.getElementById('rowsContainer');
    const clientSelect = document.getElementById('ClienteID');
    const clientName = document.getElementById('ClienteNombre');
    const confirmInput = document.getElementById('ConfirmarImpacto');
    const confirmModal = new bootstrap.Modal(
        document.getElementById('confirmModal')
    );

    const urlParts = '@Url.Action("ObtenerPartesPorCliente", "PlaneacionRelease")';
    const urlPartInfo = '@Url.Action("ObtenerParteInfoRelease", "PlaneacionRelease")';

    let parts = [];

    function escapeHtml(value) {
        return String(value ?? '')
            .replaceAll('&', '&amp;')
            .replaceAll('<', '&lt;')
            .replaceAll('>', '&gt;')
            .replaceAll('"', '&quot;')
            .replaceAll("'", '&#039;');
    }

    function localDate() {
        const now = new Date();
        const adjusted = new Date(
            now.getTime() - now.getTimezoneOffset() * 60000
        );
        return adjusted.toISOString().slice(0, 10);
    }

    function options(selected) {
        let html = '<option value="">-- Selecciona parte --</option>';

        for (const part of parts) {
            const isSelected =
                String(part.value) === String(selected ?? '');

            html += `<option value="${escapeHtml(part.value)}" ${isSelected ? 'selected' : ''}>${escapeHtml(part.text)}</option>`;
        }

        return html;
    }

    function deliveryHtml(rowIndex, deliveryIndex) {
        return `
            <div class="delivery delivery-item" data-index="${deliveryIndex}">
                <input type="hidden"
                       class="delivery-sequence"
                       name="Renglones[${rowIndex}].Entregas[${deliveryIndex}].SecuenciaEntrega"
                       value="${deliveryIndex + 1}" />

                <div class="row g-2 align-items-end">
                    <div class="col-md-4">
                        <label class="label">Fecha carga</label>
                        <input name="Renglones[${rowIndex}].Entregas[${deliveryIndex}].FechaCarga"
                               type="date"
                               class="form-control load-date" />
                    </div>

                    <div class="col-md-4">
                        <label class="label">Fecha requerida</label>
                        <input name="Renglones[${rowIndex}].Entregas[${deliveryIndex}].FechaRequerida"
                               type="date"
                               value="${localDate()}"
                               class="form-control required-date"
                               required />
                    </div>

                    <div class="col-md-3">
                        <label class="label">Cantidad</label>
                        <input name="Renglones[${rowIndex}].Entregas[${deliveryIndex}].CantidadRequerida"
                               type="number"
                               min="1"
                               step="1"
                               class="form-control quantity"
                               required />
                    </div>

                    <div class="col-md-1 d-grid">
                        <button type="button"
                                class="btn btn-outline-danger remove-delivery">
                            <i class="fa-regular fa-trash-can"></i>
                        </button>
                    </div>
                </div>
            </div>`;
    }

    function rowHtml(index) {
        return `
            <article class="row-card release-row" data-index="${index}">
                <div class="row-head">
                    <strong>
                        Renglón <span class="row-number">${index + 1}</span>
                    </strong>

                    <div class="d-flex gap-2">
                        <button type="button"
                                class="btn btn-sm btn-outline-primary add-delivery">
                            <i class="fa-solid fa-calendar-plus me-1"></i>
                            Agregar entrega
                        </button>

                        <button type="button"
                                class="btn btn-sm btn-outline-danger remove-row">
                            <i class="fa-regular fa-trash-can"></i>
                        </button>
                    </div>
                </div>

                <div class="row-body">
                    <input type="hidden"
                           class="row-sequence"
                           name="Renglones[${index}].Renglon"
                           value="${index + 1}" />

                    <input type="hidden"
                           class="numero-parte"
                           name="Renglones[${index}].NumeroParte" />

                    <input type="hidden"
                           class="referencia-sap"
                           name="Renglones[${index}].ReferenciaSAP" />

                    <input type="hidden"
                           class="descripcion-parte"
                           name="Renglones[${index}].DesignacionDescripcionSAP" />

                    <div class="row g-3 mb-3">
                        <div class="col-lg-5">
                            <label class="label">Parte</label>
                            <select name="Renglones[${index}].ParteID"
                                    class="form-select part-select"
                                    required>
                                ${options('')}
                            </select>
                        </div>

                        <div class="col-lg-3">
                            <label class="label">Unidad cliente</label>
                            <input name="Renglones[${index}].UnidadMedidaCliente"
                                   class="form-control unit-input"
                                   maxlength="30" />
                        </div>

                        <div class="col-lg-4">
                            <label class="label">Contrato / orden cliente</label>
                            <input name="Renglones[${index}].ContratoCliente"
                                   class="form-control contract-input"
                                   maxlength="100" />
                        </div>

                        <div class="col-12">
                            <div class="small text-muted part-description">
                                Sin descripción
                            </div>
                        </div>
                    </div>

                    <div class="deliveries">
                        ${deliveryHtml(index, 0)}
                    </div>
                </div>
            </article>`;
    }

    function renumber() {
        const rows = Array.from(
            rowsContainer.querySelectorAll('.release-row')
        );

        rows.forEach((row, rowIndex) => {
            row.dataset.index = rowIndex;
            row.querySelector('.row-number').textContent =
                rowIndex + 1;

            const sequence = row.querySelector('.row-sequence');
            sequence.name = `Renglones[${rowIndex}].Renglon`;
            sequence.value = rowIndex + 1;

            const part = row.querySelector('.part-select');
            part.name = `Renglones[${rowIndex}].ParteID`;

            row.querySelector('.numero-parte').name =
                `Renglones[${rowIndex}].NumeroParte`;

            row.querySelector('.referencia-sap').name =
                `Renglones[${rowIndex}].ReferenciaSAP`;

            row.querySelector('.descripcion-parte').name =
                `Renglones[${rowIndex}].DesignacionDescripcionSAP`;

            row.querySelector('.unit-input').name =
                `Renglones[${rowIndex}].UnidadMedidaCliente`;

            row.querySelector('.contract-input').name =
                `Renglones[${rowIndex}].ContratoCliente`;

            const deliveries = Array.from(
                row.querySelectorAll('.delivery-item')
            );

            deliveries.forEach((delivery, deliveryIndex) => {
                delivery.dataset.index = deliveryIndex;

                const deliverySequence =
                    delivery.querySelector('.delivery-sequence');

                deliverySequence.name =
                    `Renglones[${rowIndex}].Entregas[${deliveryIndex}].SecuenciaEntrega`;

                deliverySequence.value =
                    deliveryIndex + 1;

                delivery.querySelector('.load-date').name =
                    `Renglones[${rowIndex}].Entregas[${deliveryIndex}].FechaCarga`;

                delivery.querySelector('.required-date').name =
                    `Renglones[${rowIndex}].Entregas[${deliveryIndex}].FechaRequerida`;

                delivery.querySelector('.quantity').name =
                    `Renglones[${rowIndex}].Entregas[${deliveryIndex}].CantidadRequerida`;
            });

            row.querySelectorAll('.remove-delivery')
                .forEach(button => {
                    button.disabled = deliveries.length <= 1;
                });
        });

        rowsContainer.querySelectorAll('.remove-row')
            .forEach(button => {
                button.disabled = rows.length <= 1;
            });
    }

    async function loadParts(clientId, preserve = true) {
        if (!clientId) {
            parts = [];
            return;
        }

        const response = await fetch(
            `${urlParts}?clienteId=${encodeURIComponent(clientId)}`
        );

        const data = await response.json();

        if (!response.ok || !data.ok) {
            throw new Error(
                data.mensaje ||
                'No se pudieron cargar las partes.'
            );
        }

        parts = data.partes || [];

        document.querySelectorAll('.part-select')
            .forEach(select => {
                const selected = preserve
                    ? (select.value || select.dataset.selected || '')
                    : '';

                select.innerHTML = options(selected);
                select.value = selected;
            });
    }

    async function loadPartInfo(select) {
        const row = select.closest('.release-row');
        if (!row || !select.value) {
            return;
        }

        const response = await fetch(
            `${urlPartInfo}?parteId=${encodeURIComponent(select.value)}`
        );

        const data = await response.json();

        if (!response.ok || !data.ok) {
            throw new Error(
                data.mensaje ||
                'No se pudo leer la parte.'
            );
        }

        row.querySelector('.numero-parte').value =
            data.numeroParte || '';

        row.querySelector('.referencia-sap').value =
            data.referenciaSAP || '';

        row.querySelector('.descripcion-parte').value =
            data.designacionDescripcionSAP || '';

        row.querySelector('.part-description').textContent =
            data.designacionDescripcionSAP ||
            data.referenciaSAP ||
            data.numeroParte ||
            'Sin descripción';
    }

    document.getElementById('addRow')
        .addEventListener('click', () => {
            const index =
                rowsContainer.querySelectorAll('.release-row').length;

            rowsContainer.insertAdjacentHTML(
                'beforeend',
                rowHtml(index)
            );

            renumber();
        });

    rowsContainer.addEventListener('click', event => {
        const removeRow =
            event.target.closest('.remove-row');

        if (removeRow) {
            const rows =
                rowsContainer.querySelectorAll('.release-row');

            if (rows.length > 1) {
                removeRow.closest('.release-row').remove();
                renumber();
            }

            return;
        }

        const addDelivery =
            event.target.closest('.add-delivery');

        if (addDelivery) {
            const row =
                addDelivery.closest('.release-row');

            const rowIndex =
                Number(row.dataset.index || 0);

            const container =
                row.querySelector('.deliveries');

            const deliveryIndex =
                container.querySelectorAll('.delivery-item').length;

            container.insertAdjacentHTML(
                'beforeend',
                deliveryHtml(rowIndex, deliveryIndex)
            );

            renumber();
            return;
        }

        const removeDelivery =
            event.target.closest('.remove-delivery');

        if (removeDelivery) {
            const row =
                removeDelivery.closest('.release-row');

            const deliveries =
                row.querySelectorAll('.delivery-item');

            if (deliveries.length > 1) {
                removeDelivery.closest('.delivery-item').remove();
                renumber();
            }
        }
    });

    rowsContainer.addEventListener('change', async event => {
        if (!event.target.classList.contains('part-select')) {
            return;
        }

        try {
            await loadPartInfo(event.target);
        }
        catch (error) {
            alert(error.message);
        }
    });

    clientSelect.addEventListener('change', async () => {
        const option =
            clientSelect.options[clientSelect.selectedIndex];

        clientName.value =
            clientSelect.value && option
                ? option.text
                : '';

        try {
            await loadParts(clientSelect.value, false);
        }
        catch (error) {
            alert(error.message);
        }
    });

    document.getElementById('openConfirm')
        ?.addEventListener('click', () => {
            renumber();

            if (!form.reportValidity()) {
                return;
            }

            confirmModal.show();
        });

    document.getElementById('confirmSave')
        .addEventListener('click', () => {
            confirmInput.value = 'true';

            const button =
                document.getElementById('confirmSave');

            button.disabled = true;
            button.innerHTML =
                '<span class="spinner-border spinner-border-sm me-2"></span>Guardando...';

            form.submit();
        });

    document.addEventListener(
        'DOMContentLoaded',
        async () => {
            renumber();

            try {
                await loadParts(clientSelect.value, true);
            }
            catch (error) {
                console.error(error);
            }
        });
})();
</script>
</body>
</html>