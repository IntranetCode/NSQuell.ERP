                color: var(--blue);
            }

        .btn-main {
            background: var(--blue);
            border: 1px solid var(--blue);
            color: white;
            border-radius: 15px;
            padding: 10px 15px;
            font-weight: 900;
            text-decoration: none;
            display: inline-flex;
            align-items: center;
            gap: 6px;
        }

            .btn-main:hover {
                background: var(--blue-dark);
                border-color: var(--blue-dark);
                color: white;
            }

        .btn-light-main {
            background: white;
            border: 1px solid var(--border);
            color: var(--blue-dark);
            border-radius: 15px;
