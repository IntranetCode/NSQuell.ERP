            background: var(--blue-soft);
            color: var(--blue);
            border-color: #B2DDFF;
        }

        .pill-warning {
            background: var(--orange-soft);
            color: #B54708;
            border-color: #FED7AA;
        }

        .pill-danger {
            background: var(--red-soft);
            color: var(--red);
            border-color: #FECDCA;
        }

        .pill-purple {
            background: var(--purple-soft);
            color: var(--purple);
            border-color: #D6BBFB;
        }

        .pill-muted {
            background: #F2F4F7;
            color: #475467;
            border-color: #D0D5DD;
        }

        .client-list {
            display: grid;
            gap: 18px;
        }

        .client-card {
            background: white;
            border: 1px solid var(--border);
            border-radius: 30px;
            box-shadow: var(--shadow-soft);
            overflow: hidden;
        }

        .client-head {
