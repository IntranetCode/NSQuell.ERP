@model List<ERP.NSQuell.Models.PlaneacionReleaseIndexVm>

@{
    Layout = null;
}

<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <title>Release | Planeación</title>
    <meta name="viewport" content="width=device-width, initial-scale=1" />

    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.2/css/all.min.css" rel="stylesheet">

    <style>
        :root {
            --erp-blue: #004AAD;
            --erp-blue-dark: #00347a;
            --erp-gray: #f3f5f8;
            --erp-border: #d9e1ec;
            --erp-text: #263238;
            --erp-muted: #667085;
            --erp-green: #107c41;
            --erp-orange: #b54708;
            --erp-red: #b42318;
        }

        body {
            background: var(--erp-gray);
            color: var(--erp-text);
            font-family: "Segoe UI", Arial, sans-serif;
        }

        .erp-shell {
            max-width: 1500px;
            margin: 0 auto;
            padding: 28px;
        }

        .erp-header {
            background: linear-gradient(135deg, var(--erp-blue), var(--erp-blue-dark));
            color: white;
            border-radius: 22px;
            padding: 28px 32px;
            box-shadow: 0 16px 36px rgba(0, 74, 173, .23);
            margin-bottom: 22px;
        }

        .erp-header h1 {
            font-size: 1.65rem;
            margin: 0;
            font-weight: 900;
        }

        .erp-header p {
            margin: 7px 0 0 0;
            opacity: .92;
        }

        .erp-card {
            background: white;
            border: 1px solid var(--erp-border);
            border-radius: 20px;
            box-shadow: 0 10px 24px rgba(30, 55, 90, .08);
            overflow: hidden;
        }

        .erp-card-header {
            padding: 18px 22px;
            border-bottom: 1px solid var(--erp-border);
            display: flex;
            justify-content: space-between;
            align-items: center;
            gap: 14px;
            flex-wrap: wrap;
        }

        .erp-card-body {
            padding: 22px;
        }

        .btn-erp-primary {
            background: var(--erp-blue);
            border-color: var(--erp-blue);
            color: white;
            font-weight: 800;
            border-radius: 13px;
            padding: 10px 15px;
        }

        .btn-erp-primary:hover {
            background: var(--erp-blue-dark);
            border-color: var(--erp-blue-dark);
            color: white;
        }

        .btn-erp-light {
            background: white;
            border: 1px solid var(--erp-border);
            color: var(--erp-blue-dark);
            font-weight: 800;
            border-radius: 13px;
            padding: 10px 15px;
        }

        .metric-card {
            background: white;
            border: 1px solid var(--erp-border);
            border-radius: 18px;
            padding: 18px;
            box-shadow: 0 8px 20px rgba(30, 55, 90, .07);
            height: 100%;
        }

        .metric-label {
            color: var(--erp-muted);
            font-size: .78rem;
            font-weight: 800;
            text-transform: uppercase;
            letter-spacing: .04em;
        }

        .metric-value {
            font-size: 1.45rem;
            font-weight: 900;
            color: var(--erp-blue-dark);
        }

        .table thead th {
            background: #eef3fb;
            color: #00347a;
            font-size: .78rem;
            white-space: nowrap;
            text-transform: uppercase;
            letter-spacing: .03em;
        }

        .table td {
            font-size: .88rem;
            vertical-align: middle;
        }

        .badge-status {
            display: inline-flex;
            align-items: center;
            border-radius: 999px;
            padding: 7px 12px;
            font-size: .78rem;
            font-weight: 900;
            border: 1px solid transparent;
            background: #eef6ff;
            color: #175cd3;
            border-color: #b2ddff;
        }

        .empty-state {
            text-align: center;
            padding: 42px 18px;
            color: var(--erp-muted);
        }

        .empty-state i {
            font-size: 2.3rem;
            color: #98a2b3;
            margin-bottom: 10px;
        }
    </style>
</head>

<body>
    <div class="erp-shell">

        <div class="erp-header">
            <div class="d-flex justify-content-between align-items-start gap-3 flex-wrap">
                <div>
                    <h1>
                        <i class="fa-solid fa-calendar-check me-2"></i>
                        Release / Programa de Planeación
                    </h1>
                    <p>
                        Recepción de demanda del cliente y cálculo inicial de necesidades de producción.
                    </p>
                </div>

                <div class="d-flex gap-2 flex-wrap">
                    <a asp-controller="Menu" asp-action="Grupo" asp-route-id="3" class="btn btn-light fw-bold rounded-3">
                        <i class="fa-solid fa-arrow-left me-1"></i>
                        Volver
                    </a>

                    <a asp-controller="PlaneacionRelease" asp-action="Crear" class="btn btn-light fw-bold rounded-3">
                        <i class="fa-solid fa-plus me-1"></i>
                        Nuevo Release
                    </a>
                </div>
            </div>
        </div>

        @if (TempData["Success"] != null)
        {
            <div class="alert alert-success rounded-4 fw-semibold">
                <i class="fa-solid fa-circle-check me-2"></i>
                @TempData["Success"]
            </div>
        }

        @if (TempData["Error"] != null)
        {
            <div class="alert alert-danger rounded-4 fw-semibold">
                <i class="fa-solid fa-triangle-exclamation me-2"></i>
                @TempData["Error"]
            </div>
        }

        @{
            var totalReleases = Model?.Count ?? 0;
            var totalRenglones = Model?.Sum(x => x.TotalRenglones) ?? 0;
            var totalRequeridas = Model?.Sum(x => x.TotalPiezasRequeridas) ?? 0;
            var totalProducir = Model?.Sum(x => x.TotalPiezasAProducir) ?? 0;
        }

        <div class="row g-3 mb-3">
            <div class="col-md-3">
                <div class="metric-card">
                    <div class="metric-label">Releases</div>
                    <div class="metric-value">@totalReleases</div>
                </div>
            </div>

            <div class="col-md-3">
                <div class="metric-card">
                    <div class="metric-label">Renglones</div>
                    <div class="metric-value">@totalRenglones</div>
                </div>
            </div>

            <div class="col-md-3">
                <div class="metric-card">
                    <div class="metric-label">Piezas requeridas</div>
                    <div class="metric-value">@totalRequeridas.ToString("N0")</div>
                </div>
            </div>

            <div class="col-md-3">
                <div class="metric-card">
                    <div class="metric-label">Piezas a producir</div>
                    <div class="metric-value">@totalProducir.ToString("N0")</div>
                </div>
            </div>
        </div>

        <div class="erp-card">
            <div class="erp-card-header">
                <div>
                    <h2 class="h5 fw-bold m-0 text-primary">
                        <i class="fa-solid fa-list-check me-2"></i>
                        Releases capturados
                    </h2>
                    <div class="text-muted small">
                        Releases recibidos del cliente y calculados por Planeación.
                    </div>
                </div>
            </div>

            <div class="erp-card-body">
                @if (Model != null && Model.Any())
                {
                    <div class="table-responsive">
                        <table class="table table-bordered table-hover align-middle">
                            <thead>
                                <tr>
                                    <th>Folio</th>
                                    <th>Cliente</th>
                                    <th>Recepción</th>
                                    <th>Versión</th>
                                    <th>Estatus</th>
                                    <th>Renglones</th>
                                    <th>Req.</th>
                                    <th>A producir</th>
                                    <th>Creado</th>
                                    <th class="text-center">Acciones</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var item in Model)
                                {
                                    <tr>
                                        <td>
                                            <strong>@(item.FolioRelease ?? "-")</strong>
                                        </td>
                                        <td>@(item.ClienteNombre ?? "-")</td>
                                        <td>@item.FechaRecepcion.ToString("dd/MM/yyyy")</td>
                                        <td>@(item.VersionRelease ?? "-")</td>
                                        <td>
                                            <span class="badge-status">
                                                <i class="fa-solid fa-circle me-2" style="font-size:.45rem;"></i>
                                                @item.EstatusNombre
                                            </span>
                                        </td>
                                        <td>@item.TotalRenglones.ToString("N0")</td>
                                        <td>@item.TotalPiezasRequeridas.ToString("N0")</td>
                                        <td>
                                            <strong>@item.TotalPiezasAProducir.ToString("N0")</strong>
                                        </td>
                                        <td>@item.FechaCreacion.ToString("dd/MM/yyyy HH:mm")</td>
                                        <td class="text-center">
                                            <a asp-controller="PlaneacionRelease"
                                               asp-action="Detalle"
                                               asp-route-id="@item.ReleaseID"
                                               class="btn btn-sm btn-erp-primary">
                                                <i class="fa-solid fa-eye me-1"></i>
                                                Ver
                                            </a>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }
                else
                {
                    <div class="empty-state">
                        <i class="fa-regular fa-folder-open"></i>
                        <div class="fw-bold">No hay releases capturados.</div>
                        <div class="small">Comienza capturando el primer Release del cliente.</div>
                        <div class="mt-3">
                            <a asp-controller="PlaneacionRelease" asp-action="Crear" class="btn btn-erp-primary">
                                <i class="fa-solid fa-plus me-1"></i>
                                Crear Release
                            </a>
                        </div>
                    </div>
                }
            </div>
        </div>

    </div>
</body>
</html>