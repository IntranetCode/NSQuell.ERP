        }

        .hero-counter-label {
            color: rgba(255,255,255,.82);
            font-size: .72rem;
            font-weight: 950;
            text-transform: uppercase;
            letter-spacing: .05em;
            margin-top: 6px;
        }

        .btn-glass {
            border: 1px solid rgba(255,255,255,.35);
            background: rgba(255,255,255,.14);
