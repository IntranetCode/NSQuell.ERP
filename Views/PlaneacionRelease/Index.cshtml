        }

        .panel-body {
            padding: 22px;
        }

        .input-modern {
            border-radius: 15px;
            border: 1px solid var(--border);
            padding: 11px 13px;
            box-shadow: none;
        }

            .input-modern:focus {
                border-color: rgba(0,74,173,.45);
                box-shadow: 0 0 0 .2rem rgba(0,74,173,.12);
            }

        .pill {
            border-radius: 999px;
            padding: 7px 11px;
            font-size: .74rem;
            font-weight: 950;
            display: inline-flex;
            align-items: center;
            gap: 6px;
            border: 1px solid transparent;
            white-space: nowrap;
        }

        .pill-success {
            background: var(--green-soft);
            color: var(--green);
