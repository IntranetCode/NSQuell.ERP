        /* RELEASES COMO FILAS COMPACTAS */
        .release-list {
            width: 100%;
            border: 1px solid var(--border);
            border-radius: 18px;
            overflow: hidden;
            background: white;
        }

        .release-list-header,
        .release-row {
            display: grid;
            grid-template-columns:
                minmax(175px, 1.15fr)
                minmax(135px, .90fr)
                105px
                100px
                minmax(190px, 1.30fr)
                135px
                105px
                96px;
            gap: 12px;
            align-items: center;
        }

        .release-list-header {
            padding: 11px 14px;
            background: #F5F7FA;
            border-bottom: 1px solid var(--border);
            color: var(--muted);
            font-size: .68rem;
            font-weight: 900;
            text-transform: uppercase;
            letter-spacing: .04em;
        }

        .release-row {
            min-width: 0;
            padding: 12px 14px;
            border-bottom: 1px solid #EAECF0;
            background: white;
            transition: background-color .15s ease, box-shadow .15s ease;
        }

        .release-row:last-child {
            border-bottom: none;
        }

        .release-row:hover {
            background: #F8FBFF;
            box-shadow: inset 3px 0 0 var(--blue);
        }

        .release-row.hidden-by-filter,
        .client-card.hidden-by-filter {
            display: none !important;
        }

        .release-cell {
            min-width: 0;
            color: var(--text);
            font-size: .82rem;
        }

        .release-main-title {
            color: var(--blue-dark);
            font-size: .88rem;
            font-weight: 900;
            line-height: 1.25;
            overflow-wrap: anywhere;
        }

        .release-main-subtitle {
            margin-top: 3px;
            color: var(--muted);
            font-size: .70rem;
            font-weight: 650;
        }

        .release-value {
            font-weight: 750;
            overflow-wrap: anywhere;
        }

        .release-template,
        .release-file {
            display: block;
            min-width: 0;
            overflow: hidden;
            text-overflow: ellipsis;
            white-space: nowrap;
        }

        .release-template {
            color: var(--text);
            font-weight: 750;
        }

        .release-file {
            margin-top: 4px;
            color: var(--muted);
            font-size: .70rem;
            font-weight: 650;
        }

        .release-row-actions {
            display: flex;
            justify-content: flex-end;
            gap: 6px;
        }

        .release-action-btn {
            width: 36px;
            height: 34px;
            border: 1px solid var(--border);
            border-radius: 10px;
            background: white;
            color: var(--blue-dark);
            display: inline-flex;
            align-items: center;
            justify-content: center;
            text-decoration: none;
            transition: background-color .15s ease, color .15s ease, border-color .15s ease;
        }

        .release-action-btn:hover {
            border-color: var(--blue);
            background: var(--blue);
            color: white;
        }

        .release-action-btn.primary {
            border-color: var(--blue);
            background: var(--blue);
            color: white;
        }

        .release-action-btn.primary:hover {
            border-color: var(--blue-dark);
            background: var(--blue-dark);
        }

        @@media (max-width: 1380px) {
            .release-list {
                overflow-x: auto;
            }

            .release-list-header,
            .release-row {
                min-width: 1120px;
            }
        }

        @@media (max-width: 768px) {
            .release-list {
                border: none;
                border-radius: 0;
                overflow: visible;
                background: transparent;
            }

            .release-list-header {
                display: none;
            }

            .release-row {
                min-width: 0;
                grid-template-columns: 1fr 1fr;
                gap: 10px 14px;
                margin-bottom: 9px;
                padding: 13px;
                border: 1px solid var(--border);
                border-radius: 14px;
            }

            .release-row:last-child {
                border-bottom: 1px solid var(--border);
            }

            .release-cell::before {
                display: block;
                margin-bottom: 2px;
                color: var(--muted);
                font-size: .62rem;
                font-weight: 900;
                text-transform: uppercase;
            }

            .release-cell-release,
            .release-cell-plantilla {
                grid-column: 1 / -1;
            }

            .release-cell-release::before {
                content: "Release";
            }

            .release-cell-folio::before {
                content: "Folio cliente";
            }

            .release-cell-recepcion::before {
                content: "Recepción";
            }

            .release-cell-semana::before {
                content: "Semana";
            }

            .release-cell-plantilla::before {
                content: "Plantilla / archivo";
            }

            .release-cell-creado::before {
                content: "Creado";
            }

            .release-cell-origen::before {
                content: "Origen";
            }

            .release-cell-acciones {
                display: flex;
                align-items: flex-end;
                justify-content: flex-end;
            }

            .release-row-actions {
                width: 100%;
            }

            .release-action-btn {
                flex: 1;
            }
        }

        .empty-state {
            background: white;
            border: 1px dashed var(--border);
            border-radius: 30px;
            box-shadow: var(--shadow-soft);
            padding: 54px 20px;
            text-align: center;
            color: var(--muted);
        }

        .results-summary {
            color: var(--muted);
            font-size: .84rem;
            font-weight: 800;
        }

        .sticky-actions {
            position: sticky;
            bottom: 18px;
            z-index: 20;
            margin-top: 24px;
            background: rgba(255,255,255,.92);
            backdrop-filter: blur(14px);
            border: 1px solid var(--border);
            border-radius: 22px;
            padding: 12px;
            box-shadow: var(--shadow);
        }

        @@media (max-width: 768px) {
            .page {
                padding: 16px;
            }

            .hero {
                padding: 24px;
                border-radius: 24px;
            }

                .hero h1 {
                    font-size: 1.55rem;
                }

        }
    
</style>
</head>

<body>
    <div class="page">

        <section class="hero">
            <div class="d-flex justify-content-between align-items-start gap-4 flex-wrap">
                <div>
                    <div class="stage-label">
                        <i class="fa-solid fa-flag-checkered"></i>
                        Etapa 1 · Releases de Cliente
                    </div>

                    <h1>
                        <i class="fa-solid fa-inbox me-2"></i>
                        Releases de Cliente
                    </h1>

                    <p>
                        Bandeja de releases capturados por cliente.
                    </p>

                    <div class="d-flex gap-2 flex-wrap mt-3">
                        <span class="pill pill-primary">
                            <i class="fa-solid fa-file-lines"></i>
                            @totalReleases release@(totalReleases == 1 ? "" : "s")
                        </span>
                        
                    </div>
                </div>

                <div class="hero-actions d-flex gap-3 align-items-start flex-wrap">
                    <div class="hero-counter">
                        <div class="hero-counter-value">@totalReleases.ToString("N0")</div>
                        <div class="hero-counter-label">Releases</div>
                    </div>

                    <div class="d-flex gap-2 flex-wrap">
                        <a asp-controller="Menu"
                           asp-action="Grupo"
                           asp-route-id="3"
                           class="btn-glass">
                            <i class="fa-solid fa-arrow-left"></i>
                            Volver
                        </a>
@*
                        <a asp-controller="PlaneacionPanorama"
                           asp-action="Index"
                           class="btn-glass">
                            <i class="fa-solid fa-chart-line"></i>
                            Panorama
                        </a>
*@
                        <a asp-controller="PlaneacionPrograma"
                           asp-action="Index"
                           class="btn-glass">
                            <i class="fa-solid fa-list-check"></i>
                            Programa de Planeación
                        </a>

                        <a asp-controller="PlaneacionRelease"
                           asp-action="Crear"
                           class="btn-glass">
                            <i class="fa-solid fa-plus"></i>
                            Nuevo release
                        </a>
                    </div>
                </div>
            </div>
        </section>

        @if (TempData["Success"] != null)
        {
            <div class="alert alert-success fw-semibold">
                <i class="fa-solid fa-circle-check me-2"></i>
                @TempData["Success"]
            </div>
        }

        @if (TempData["Error"] != null)
        {
            <div class="alert alert-danger fw-semibold">
                <i class="fa-solid fa-triangle-exclamation me-2"></i>
                @TempData["Error"]
            </div>
        }

        <section class="panel">
            <div class="panel-header">
                <div>
                    <h2 class="h5 fw-bold text-primary m-0">
                        <i class="fa-solid fa-inbox me-2"></i>
                        Bandeja
                    </h2>
                    <div class="text-muted small">
                        Releases agrupados por cliente. Abre cada cliente para ver sus releases.
                    </div>
                </div>

                <div id="resultsSummary" class="results-summary">
                    @totalReleases registro@(totalReleases == 1 ? "" : "s")
                </div>
            </div>

            <div class="panel-body">
                @if (releases.Any())
                {
                    <div class="row g-3 align-items-end mb-4">
                        <div class="col-lg-8">
                            <label for="releaseSearch" class="form-label small fw-bold text-muted">Buscar</label>
                            <div class="input-group">
                                <span class="input-group-text bg-white border-end-0 rounded-start-4">
                                    <i class="fa-solid fa-magnifying-glass text-muted"></i>
                                </span>
                                <input id="releaseSearch"
                                       type="search"
                                       class="form-control input-modern border-start-0"
                                       placeholder="Buscar folio, cliente, archivo, plantilla o semana..." />
                            </div>
                        </div>

                        <div class="col-lg-4 d-grid">
                            <button id="clearFilters" type="button" class="btn btn-light-main justify-content-center">
                                <i class="fa-solid fa-filter-circle-xmark me-1"></i>
                                Limpiar búsqueda
                            </button>
                        </div>
                    </div>

                    <div class="client-list" id="clientList">
                        @{
                            var clienteIndex = 0;
                        }

                        @foreach (var grupo in gruposClientes)
                        {
                            clienteIndex++;

                            var collapseId = IdSeguro("cliente", clienteIndex);
                            var releasesCliente = grupo
                            .OrderByDescending(x => x.FechaRecepcion)
                            .ThenByDescending(x => x.FechaCreacion)
                            .ToList();

                            var searchCliente = string.Join(" ",
                            grupo.Key.ClienteNombre ?? string.Empty,
                            string.Join(" ", releasesCliente.Select(DataSearch))
                            ).ToLowerInvariant();

                            <article class="client-card"
                                     data-client-card
                                     data-search="@searchCliente">

                                <div class="client-head"
                                     data-bs-toggle="collapse"
                                     data-bs-target="#@collapseId"
                                     aria-expanded="false"
                                     aria-controls="@collapseId">

                                    <div class="d-flex justify-content-between align-items-start gap-3 flex-wrap">
                                        <div class="d-flex align-items-center gap-3">
                                            <div class="client-avatar">
                                                @InicialCliente(grupo.Key.ClienteNombre)
                                            </div>

                                            <div>
                                                <h3 class="client-title">
                                                    @grupo.Key.ClienteNombre
                                                </h3>
                                                <div class="client-sub">
                                                    @releasesCliente.Count.ToString("N0") release@(releasesCliente.Count == 1 ? "" : "s") en bandeja
                                                </div>
                                            </div>
                                        </div>

                                        <div class="d-flex gap-2 flex-wrap position-relative" style="z-index:2;">
                                            <span class="pill pill-primary">
                                                <i class="fa-solid fa-file-lines"></i>
                                                @releasesCliente.Count.ToString("N0")
                                            </span>

                                            <a asp-controller="PlaneacionRelease"
                                               asp-action="Historico"
                                               asp-route-clienteId="@grupo.Key.ClienteID"
                                               class="pill pill-warning text-decoration-none"
                                               onclick="event.stopPropagation();">
                                                <i class="fa-solid fa-clock-rotate-left"></i>
                                                Histórico
                                            </a>

                                            <span class="pill pill-muted">
                                                <i class="fa-solid fa-chevron-down"></i>
                                                Abrir
                                            </span>
                                        </div>
                                    </div>
                                </div>

                                <div id="@collapseId" class="collapse">
                                    <div class="client-body">
                                        <div class="release-list">
                                            <div class="release-list-header">
                                                <div>Release</div>
                                                <div>Folio cliente</div>
                                                <div>Recepción</div>
                                                <div>Semana</div>
                                                <div>Plantilla / archivo</div>
                                                <div>Creado</div>
                                                <div>Origen</div>
                                                <div class="text-end">Acciones</div>
                                            </div>

                                            @foreach (var item in releasesCliente)
                                            {
                                                var versionTexto = SemanaRelease(item.FechaRecepcion);
                                                var originText = TextoOrigen(item.ImportadoDesdeArchivo);
                                                var originIcon = IconoOrigen(item.ImportadoDesdeArchivo);
                                                var searchableText = DataSearch(item) + " " + versionTexto.ToLowerInvariant();

                                                <div class="release-row"
                                                     data-release-card
                                                     data-search="@searchableText">

                                                    <div class="release-cell release-cell-release">
                                                        <div class="release-main-title">
                                                            @(item.FolioRelease ?? "-")
                                                        </div>
                                                        <div class="release-main-subtitle">
                                                            ID @item.ReleaseID
                                                        </div>
                                                    </div>

                                                    <div class="release-cell release-cell-folio">
                                                        <div class="release-value">
                                                            @(item.FolioCliente ?? "-")
                                                        </div>
                                                    </div>

                                                    <div class="release-cell release-cell-recepcion">
                                                        <div class="release-value">
                                                            @item.FechaRecepcion.ToString("dd/MM/yyyy")
                                                        </div>
                                                    </div>

                                                    <div class="release-cell release-cell-semana">
                                                        <div class="release-value">
                                                            @versionTexto
                                                        </div>
                                                    </div>

                                                    <div class="release-cell release-cell-plantilla">
                                                        <span class="release-template"
                                                              title="@Valor(item.PlantillaImportacion)">
                                                            @Valor(item.PlantillaImportacion)
                                                        </span>

                                                        @if (!string.IsNullOrWhiteSpace(item.ArchivoOrigenNombre))
                                                        {
                                                            <span class="release-file"
                                                                  title="@item.ArchivoOrigenNombre">
                                                                <i class="fa-regular fa-file-lines me-1"></i>
                                                                @item.ArchivoOrigenNombre
                                                            </span>
                                                        }
                                                    </div>

                                                    <div class="release-cell release-cell-creado">
                                                        <div class="release-value">
                                                            @item.FechaCreacion.ToString("dd/MM/yyyy HH:mm")
                                                        </div>
                                                    </div>

                                                    <div class="release-cell release-cell-origen">
                                                        <span class="pill @(item.ImportadoDesdeArchivo ? "pill-success" : "pill-muted")">
                                                            <i class="fa-solid @originIcon"></i>
                                                            @originText
                                                        </span>
                                                    </div>

                                                    <div class="release-cell release-cell-acciones">
                                                        <div class="release-row-actions">
                                                            <a asp-controller="PlaneacionRelease"
                                                               asp-action="Detalle"
                                                               asp-route-id="@item.ReleaseID"
                                                               class="release-action-btn primary"
                                                               title="Ver detalle"
                                                               aria-label="Ver detalle del release">
                                                                <i class="fa-solid fa-eye"></i>
                                                            </a>

                                                            <a asp-controller="PlaneacionRelease"
                                                               asp-action="Editar"
                                                               asp-route-id="@item.ReleaseID"
                                                               class="release-action-btn"
                                                               title="Editar"
                                                               aria-label="Editar release">
                                                                <i class="fa-solid fa-pen-to-square"></i>
                                                            </a>
                                                        </div>
                                                    </div>
                                                </div>
                                            }
                                        </div>
                                    </div>
                                </div>
                            </article>
                        }
                    </div>

                    <div id="noFilterResults" class="empty-state d-none mt-3">
                        <i class="fa-solid fa-magnifying-glass fa-3x mb-3"></i>
                        <h3 class="fw-bold text-primary">No se encontraron releases</h3>
                        <p class="mb-0">
                            Cambia o limpia la búsqueda para volver a mostrar la bandeja.
                        </p>
                    </div>
                }
                else
                {
                    <div class="empty-state">
                        <i class="fa-regular fa-folder-open fa-3x mb-3"></i>
                        <h3 class="fw-bold text-primary">No hay releases capturados</h3>
                        <p class="mb-0">Comienza registrando la demanda recibida del cliente.</p>
                        <div class="mt-3">
                            <a asp-controller="PlaneacionRelease"
                               asp-action="Crear"
                               class="btn btn-main">
                                <i class="fa-solid fa-plus me-1"></i>
                                Crear primer release
                            </a>
                        </div>
                    </div>
                }
            </div>
        </section>

        <section class="sticky-actions">
            <div class="d-flex justify-content-between gap-2 flex-wrap">
                <a asp-controller="Menu"
                   asp-action="Grupo"
                   asp-route-id="3"
                   class="btn btn-light-main">
                    <i class="fa-solid fa-arrow-left me-1"></i>
                    Volver
                </a>
                @*

                <div class="d-flex gap-2 flex-wrap">
                    <a asp-controller="PlaneacionPanorama"
                       asp-action="Index"
                       class="btn btn-light-main">
                        <i class="fa-solid fa-chart-line me-1"></i>
                        Panorama
                    </a>*@

                    <a asp-controller="PlaneacionPrograma"
                       asp-action="Index"
                       class="btn btn-light-main">
                        <i class="fa-solid fa-list-check me-1"></i>
                        Programa de Planeación
                    </a>

                    <a asp-controller="PlaneacionRelease"
                       asp-action="Crear"
                       class="btn btn-main">
                        <i class="fa-solid fa-plus me-1"></i>
                        Nuevo release
                    </a>
                </div>
            </div>
        </section>

    </div>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>

    <script>
        document.addEventListener("DOMContentLoaded", function () {
            const searchInput = document.getElementById("releaseSearch");
            const clearButton = document.getElementById("clearFilters");
            const clientCards = Array.from(document.querySelectorAll("[data-client-card]"));
            const releaseCards = Array.from(document.querySelectorAll("[data-release-card]"));
            const noResults = document.getElementById("noFilterResults");
            const resultsSummary = document.getElementById("resultsSummary");

            if (!searchInput || clientCards.length === 0) return;

            function normalize(value) {
                return (value || "")
                    .toString()
                    .toLowerCase()
                    .normalize("NFD")
                    .replace(/[\u0300-\u036f]/g, "")
                    .trim();
            }

            function applyFilters() {
                const searchValue = normalize(searchInput.value);
                let visibleReleaseCount = 0;
                let visibleClientCount = 0;

                clientCards.forEach(function (client) {
                    const releases = Array.from(client.querySelectorAll("[data-release-card]"));
                    let clientHasVisibleRelease = false;

                    releases.forEach(function (release) {
                        const releaseSearch = normalize(release.dataset.search);
                        const clientSearch = normalize(client.dataset.search);

                        const isVisible = !searchValue ||
                            releaseSearch.includes(searchValue) ||
                            clientSearch.includes(searchValue);

                        release.classList.toggle("hidden-by-filter", !isVisible);

                        if (isVisible) {
                            clientHasVisibleRelease = true;
                            visibleReleaseCount++;
                        }
                    });

                    client.classList.toggle("hidden-by-filter", !clientHasVisibleRelease);

                    if (clientHasVisibleRelease) {
                        visibleClientCount++;
                    }
                });

                if (noResults) noResults.classList.toggle("d-none", visibleReleaseCount !== 0);

                if (resultsSummary) {
                    resultsSummary.textContent =
                        visibleReleaseCount + (visibleReleaseCount === 1 ? " registro" : " registros") +
                        " · " +
                        visibleClientCount + (visibleClientCount === 1 ? " cliente" : " clientes");
                }
            }

            searchInput.addEventListener("input", applyFilters);

            if (clearButton) {
                clearButton.addEventListener("click", function () {
                    searchInput.value = "";
                    applyFilters();
                    searchInput.focus();
                });
            }
        });
    </script>

</body>
</html>
