@model ERP.NSQuell.Models.PlaneacionReleaseCrearVm

@{
    Layout = null;

    var clientesData = Model.Clientes.Select(x => new { value = x.Value, text = x.Text }).ToList();
    var partesData = Model.Partes.Select(x => new { value = x.Value, text = x.Text }).ToList();

    var clientesJson = System.Text.Json.JsonSerializer.Serialize(clientesData);
    var partesJson = System.Text.Json.JsonSerializer.Serialize(partesData);
}

<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <title>Nuevo Release | Planeación</title>
    <meta name="viewport" content="width=device-width, initial-scale=1" />

    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.2/css/all.min.css" rel="stylesheet">

    <style>
        :root {
            --erp-blue: #004AAD;
            --erp-blue-dark: #00347a;
            --erp-gray: #f3f5f8;
            --erp-border: #d9e1ec;
            --erp-text: #263238;
        }

        body {
            background: var(--erp-gray);
            color: var(--erp-text);
            font-family: "Segoe UI", Arial, sans-serif;
        }

        .erp-shell {
            max-width: 1550px;
            margin: 0 auto;
            padding: 28px;
        }

        .erp-header {
            background: linear-gradient(135deg, var(--erp-blue), var(--erp-blue-dark));
            color: white;
            border-radius: 22px;
            padding: 28px 32px;
            box-shadow: 0 16px 36px rgba(0, 74, 173, .23);
            margin-bottom: 22px;
        }

            .erp-header h1 {
                font-size: 1.65rem;
                margin: 0;
                font-weight: 900;
            }

        .erp-card {
            background: white;
            border: 1px solid var(--erp-border);
            border-radius: 20px;
            box-shadow: 0 10px 24px rgba(30, 55, 90, .08);
            margin-bottom: 20px;
            overflow: hidden;
        }

        .erp-card-header {
            padding: 18px 22px;
            border-bottom: 1px solid var(--erp-border);
            display: flex;
            justify-content: space-between;
            align-items: center;
            gap: 14px;
            flex-wrap: wrap;
        }

        .erp-card-body {
            padding: 22px;
        }

        .erp-label {
            font-weight: 800;
            color: #33465f;
            font-size: .82rem;
            margin-bottom: 6px;
        }

        .erp-input,
        .erp-select,
        .erp-textarea {
            border-radius: 12px;
            border: 1px solid var(--erp-border);
            padding: 10px 12px;
        }

        .btn-erp-primary {
            background: var(--erp-blue);
            border-color: var(--erp-blue);
            color: white;
            font-weight: 800;
            border-radius: 13px;
            padding: 10px 15px;
        }

            .btn-erp-primary:hover {
                background: var(--erp-blue-dark);
                border-color: var(--erp-blue-dark);
                color: white;
            }

        .btn-erp-light {
            background: white;
            border: 1px solid var(--erp-border);
            color: var(--erp-blue-dark);
            font-weight: 800;
            border-radius: 13px;
            padding: 10px 15px;
        }

        .btn-erp-danger {
            background: white;
            border: 1px solid #f2b8b5;
            color: #b42318;
            font-weight: 800;
            border-radius: 13px;
            padding: 10px 15px;
        }

        .renglon-card {
            border: 1px solid var(--erp-border);
            border-radius: 18px;
            overflow: hidden;
            margin-bottom: 18px;
            background: white;
        }

        .renglon-header {
            background: #eef3fb;
            padding: 14px 16px;
            border-bottom: 1px solid var(--erp-border);
            display: flex;
            justify-content: space-between;
            align-items: center;
            gap: 12px;
            flex-wrap: wrap;
        }

        .renglon-body {
            padding: 18px;
        }

        .badge-renglon {
            background: var(--erp-blue);
            color: white;
            border-radius: 999px;
            padding: 6px 12px;
            font-weight: 900;
        }

        .small-help {
            font-size: .78rem;
            color: #758397;
        }

        .sticky-actions {
            position: sticky;
            bottom: 0;
            background: rgba(243, 245, 248, .92);
            backdrop-filter: blur(10px);
            padding: 14px 0;
            z-index: 20;
        }
    </style>
</head>

<body>
    <div class="erp-shell">

        <div class="erp-header">
            <div class="d-flex justify-content-between align-items-start gap-3 flex-wrap">
                <div>
                    <h1>
                        <i class="fa-solid fa-calendar-plus me-2"></i>
                        Nuevo Release
                    </h1>
                    <p class="mb-0 mt-2">
                        Captura la demanda recibida del cliente. El sistema calculará PT disponible, piezas a producir, MP, embalaje y capacidad inicial.
                    </p>
                </div>

                <div>
                    <a asp-controller="PlaneacionRelease" asp-action="Index" class="btn btn-light fw-bold rounded-3">
                        <i class="fa-solid fa-arrow-left me-1"></i>
                        Volver
                    </a>
                </div>
            </div>
        </div>

        <form asp-controller="PlaneacionRelease" asp-action="Crear" method="post" id="formRelease">
            @Html.AntiForgeryToken()

            <div asp-validation-summary="ModelOnly" class="alert alert-danger"></div>

            <div class="erp-card">
                <div class="erp-card-header">
                    <div>
                        <h2 class="h5 fw-bold m-0 text-primary">
                            <i class="fa-solid fa-file-lines me-2"></i>
                            Encabezado del Release
                        </h2>
                        <div class="text-muted small">
                            Información general recibida del cliente.
                        </div>
                    </div>
                </div>

                <div class="erp-card-body">
                    <div class="row g-3">
                        <div class="col-md-3">
                            <label class="erp-label">Folio Release</label>
                            <input asp-for="FolioRelease" class="form-control erp-input" />
                        </div>

                        <div class="col-md-3">
                            <label class="erp-label">Fecha recepción</label>
                            <input asp-for="FechaRecepcion" type="date" class="form-control erp-input" />
                        </div>

                        <div class="col-md-3">
                            <label class="erp-label">Versión release</label>
                            <input asp-for="VersionRelease" class="form-control erp-input" placeholder="Ej. Semana 30 / Julio / Rev. 1" />
                        </div>

                        <div class="col-md-3">
                            <label class="erp-label">Cliente</label>
                            <select asp-for="ClienteID" class="form-select erp-select" id="ClienteID">
                                <option value="">-- Selecciona cliente --</option>
                                @foreach (var c in Model.Clientes)
                                {
                                    <option value="@c.Value">@c.Text</option>
                                }
                            </select>
                            <input asp-for="ClienteNombre" type="hidden" id="ClienteNombre" />
                        </div>

                        <div class="col-12">
                            <label class="erp-label">Observaciones</label>
                            <textarea asp-for="Observaciones"
                                      class="form-control erp-textarea"
                                      rows="2"
                                      placeholder="Notas del release, archivo origen, correo, versión enviada por cliente..."></textarea>
                        </div>
                    </div>
                </div>
            </div>

            <div class="erp-card">
                <div class="erp-card-header">
                    <div>
                        <h2 class="h5 fw-bold m-0 text-primary">
                            <i class="fa-solid fa-layer-group me-2"></i>
                            Renglones del Release
                        </h2>
                        <div class="text-muted small">
                            Captura parte, fecha requerida y cantidad solicitada.
                        </div>
                    </div>

                    <button type="button" class="btn btn-erp-primary" onclick="agregarRenglon()">
                        <i class="fa-solid fa-plus me-1"></i>
                        Agregar renglón
                    </button>
                </div>

                <div class="erp-card-body">
                    <div id="contenedorRenglones">
                        @for (var i = 0; i < Model.Detalles.Count; i++)
                        {
                            <div class="renglon-card renglon-item" data-index="@i">
                                <div class="renglon-header">
                                    <div class="d-flex align-items-center gap-2">
                                        <span class="badge-renglon">
                                            Renglón <span class="numero-renglon">@(i + 1)</span>
                                        </span>
                                        <span class="text-muted small fw-semibold">Demanda del cliente</span>
                                    </div>

                                    <button type="button" class="btn btn-sm btn-erp-danger" onclick="eliminarRenglon(this)">
                                        <i class="fa-regular fa-trash-can me-1"></i>
                                        Quitar
                                    </button>
                                </div>

                                <div class="renglon-body">
                                    <input type="hidden" name="Detalles[@i].Renglon" value="@(i + 1)" class="input-renglon" />

                                    <div class="row g-3">
                                        <div class="col-md-6">
                                            <label class="erp-label">Parte</label>
                                            <select name="Detalles[@i].ParteID" class="form-select erp-select parte-select">
                                                <option value="">-- Selecciona cliente primero --</option>
                                            </select>
                                            <div class="small-help">
                                                Se usará para buscar PT, MP, embalaje, máquina y molde.
                                            </div>
                                        </div>

                                        <div class="col-md-3">
                                            <label class="erp-label">Fecha requerida</label>
                                            <input name="Detalles[@i].FechaRequerida"
                                                   type="date"
                                                   value="@(Model.Detalles[i].FechaRequerida?.ToString("yyyy-MM-dd"))"
                                                   class="form-control erp-input fecha-requerida-input" />
                                        </div>

                                        <div class="col-md-3">
                                            <label class="erp-label">Cantidad requerida</label>
                                            <input name="Detalles[@i].CantidadRequerida"
                                                   type="number"
                                                   min="0"
                                                   value="@Model.Detalles[i].CantidadRequerida"
                                                   class="form-control erp-input cantidad-input" />
                                        </div>

                                        <div class="col-md-4">
                                            <label class="erp-label">Referencia SAP / cliente</label>
                                            <input name="Detalles[@i].ReferenciaSAP"   class="form-control erp-input referencia-input" />
                                        </div>

                                        <div class="col-md-8">
                                            <label class="erp-label">Designación / descripción</label>
                                            <input name="Detalles[@i].DesignacionDescripcionSAP"    class="form-control erp-input designacion-input" />
                                        </div>
                                    </div>
                                </div>
                            </div>
                        }
                    </div>

                    <button type="button" class="btn btn-erp-light" onclick="agregarRenglon()">
                        <i class="fa-solid fa-plus me-1"></i>
                        Agregar otro renglón
                    </button>
                </div>
            </div>

            <div class="sticky-actions">
                <div class="d-flex justify-content-end gap-2">
                    <a asp-controller="PlaneacionRelease" asp-action="Index" class="btn btn-erp-light">
                        Cancelar
                    </a>

                    <button type="submit" class="btn btn-erp-primary">
                        <i class="fa-solid fa-calculator me-1"></i>
                        Guardar y calcular necesidades
                    </button>
                </div>
            </div>
        </form>
    </div>

    <script>
        const clientesData = @Html.Raw(clientesJson);
        const partesData = @Html.Raw(partesJson);
        const urlParteInfoRelease = '@Url.Action("ObtenerParteInfoRelease", "PlaneacionRelease")';
        const urlPartesPorCliente = '@Url.Action("ObtenerPartesPorCliente", "PlaneacionRelease")';

        function escapeHtml(value) {
            return String(value ?? '')
                .replaceAll('&', '&amp;')
                .replaceAll('<', '&lt;')
                .replaceAll('>', '&gt;')
                .replaceAll('"', '&quot;')
                .replaceAll("'", '&#039;')
                .replaceAll('`', '&#096;');
        }

        function crearOptionsPartes() {
            let html = '<option value="">-- Selecciona parte --</option>';

            partesData.forEach(x => {
                html += `<option value="${escapeHtml(x.value)}">${escapeHtml(x.text)}</option>`;
            });

            return html;
        }

                function agregarRenglon() {
            const contenedor = document.getElementById('contenedorRenglones');
            const index = contenedor.querySelectorAll('.renglon-item').length;

            contenedor.insertAdjacentHTML('beforeend', crearHtmlRenglon(index));
            renumerarRenglones();

            const clienteId = document.getElementById('ClienteID')?.value;

            if (clienteId && Number(clienteId) > 0) {
                cargarPartesPorCliente(clienteId);
            }
        }

        function crearHtmlRenglon(i) {
            const hoy = new Date().toISOString().slice(0, 10);

            return `
                <div class="renglon-card renglon-item" data-index="${i}">
                    <div class="renglon-header">
                        <div class="d-flex align-items-center gap-2">
                            <span class="badge-renglon">
                                Renglón <span class="numero-renglon">${i + 1}</span>
                            </span>
                            <span class="text-muted small fw-semibold">Demanda del cliente</span>
                        </div>

                        <button type="button" class="btn btn-sm btn-erp-danger" onclick="eliminarRenglon(this)">
                            <i class="fa-regular fa-trash-can me-1"></i>
                            Quitar
                        </button>
                    </div>

                    <div class="renglon-body">
                        <input type="hidden" name="Detalles[${i}].Renglon" value="${i + 1}" class="input-renglon" />

                        <div class="row g-3">
                            <div class="col-md-6">
                                <label class="erp-label">Parte</label>
                                        <select name="Detalles[${i}].ParteID" class="form-select erp-select parte-select">
            <option value="">-- Selecciona cliente primero --</option>
        </select>
                                <div class="small-help">
                                    Se usará para buscar PT, MP, embalaje, máquina y molde.
                                </div>
                            </div>

                            <div class="col-md-3">
                                <label class="erp-label">Fecha requerida</label>
                                <input name="Detalles[${i}].FechaRequerida"
                                       type="date"
                                       value="${hoy}"
                                       class="form-control erp-input fecha-requerida-input" />
                            </div>

                            <div class="col-md-3">
                                <label class="erp-label">Cantidad requerida</label>
                                <input name="Detalles[${i}].CantidadRequerida"
                                       type="number"
                                       min="0"
                                       class="form-control erp-input cantidad-input" />
                            </div>

                            <div class="col-md-4">
                                <label class="erp-label">Referencia SAP / cliente</label>
                                <input name="Detalles[${i}].ReferenciaSAP" class="form-control erp-input referencia-input" />
                            </div>

                            <div class="col-md-8">
                                <label class="erp-label">Designación / descripción</label>
                                <input name="Detalles[${i}].DesignacionDescripcionSAP" class="form-control erp-input designacion-input" />
                            </div>
                        </div>
                    </div>
                </div>`;
        }

        function eliminarRenglon(btn) {
            const contenedor = document.getElementById('contenedorRenglones');
            const total = contenedor.querySelectorAll('.renglon-item').length;

            if (total <= 1) {
                alert('Debe quedar al menos un renglón.');
                return;
            }

            btn.closest('.renglon-item').remove();
            renumerarRenglones();
        }

        function renumerarRenglones() {
            const renglones = document.querySelectorAll('.renglon-item');

            renglones.forEach((card, index) => {
                card.dataset.index = index;

                const numero = card.querySelector('.numero-renglon');
                if (numero) numero.innerText = index + 1;

                const inputRenglon = card.querySelector('.input-renglon');
                if (inputRenglon) inputRenglon.value = index + 1;

                card.querySelectorAll('[name]').forEach(el => {
                    el.name = el.name.replace(/Detalles\[\d+\]/g, `Detalles[${index}]`);
                });
            });
        }

                const clienteSelect = document.getElementById('ClienteID');
        const clienteNombre = document.getElementById('ClienteNombre');

        if (clienteSelect && clienteNombre) {
            clienteSelect.addEventListener('change', async function () {
                const selected = this.options[this.selectedIndex];
                clienteNombre.value = selected ? selected.text : '';

                await cargarPartesPorCliente(this.value);
            });
        }

        const formRelease = document.getElementById('formRelease');

        if (formRelease) {
            formRelease.addEventListener('submit', function (e) {
                const renglones = document.querySelectorAll('.renglon-item');

                if (!renglones.length) {
                    e.preventDefault();
                    alert('Debes capturar al menos un renglón.');
                    return;
                }

                for (const card of renglones) {
                    const parte = card.querySelector('.parte-select')?.value;
                    const fecha = card.querySelector('.fecha-requerida-input')?.value;
                    const cantidad = card.querySelector('.cantidad-input')?.value;

                    if (!parte) {
                        e.preventDefault();
                        alert('Todos los renglones deben tener una parte seleccionada.');
                        return;
                    }

                    if (!fecha) {
                        e.preventDefault();
                        alert('Todos los renglones deben tener fecha requerida.');
                        return;
                    }

                    if (!cantidad || Number(cantidad) <= 0) {
                        e.preventDefault();
                        alert('Todos los renglones deben tener cantidad requerida mayor a cero.');
                        return;
                    }
                }
            });
        }

                document.addEventListener('change', async function (e) {
            if (e.target.classList.contains('parte-select')) {
                await cargarInfoParteRelease(e.target);
            }
        });

                async function cargarInfoParteRelease(select) {
            const parteId = select.value;
            const card = select.closest('.renglon-item');

            if (!card) return;

            if (!parteId) {
                setValue(card, '.referencia-input', '');
                setValue(card, '.designacion-input', '');
                return;
            }

            try {
                const resp = await fetch(`${urlParteInfoRelease}?parteId=${encodeURIComponent(parteId)}`);
                const data = await resp.json();

                if (!data.ok) {
                    alert(data.mensaje || 'No se encontró la información de la parte.');
                    return;
                }

                setValue(card, '.referencia-input', data.referenciaSAP);
                setValue(card, '.designacion-input', data.designacionDescripcionSAP);

            } catch (err) {
                console.error(err);
                alert('No se pudo cargar la información de la parte.');
            }
        }

        function setValue(card, selector, value) {
            const input = card.querySelector(selector);
            if (input) {
                input.value = value ?? '';
            }
        }

                async function cargarPartesPorCliente(clienteId) {
            limpiarPartesDeTodosLosRenglones();

            if (!clienteId || Number(clienteId) <= 0) {
                return;
            }

            try {
                const resp = await fetch(`${urlPartesPorCliente}?clienteId=${encodeURIComponent(clienteId)}`);
                const data = await resp.json();

                if (!data.ok) {
                    alert(data.mensaje || 'No se pudieron cargar las partes del cliente.');
                    return;
                }

                const partes = data.partes || [];
                const opciones = crearOptionsDesdeLista(partes, '-- Selecciona parte --');

                document.querySelectorAll('.parte-select').forEach(function (select) {
                    select.innerHTML = opciones;
                });

            } catch (err) {
                console.error(err);
                alert('No se pudieron cargar las partes del cliente.');
            }
        }

        function crearOptionsDesdeLista(data, placeholder) {
            let html = `<option value="">${escapeHtml(placeholder)}</option>`;

            data.forEach(x => {
                html += `<option value="${escapeHtml(x.value)}">${escapeHtml(x.text)}</option>`;
            });

            return html;
        }

        function limpiarPartesDeTodosLosRenglones() {
            document.querySelectorAll('.renglon-item').forEach(function (card) {
                const parteSelect = card.querySelector('.parte-select');

                if (parteSelect) {
                    parteSelect.innerHTML = '<option value="">-- Selecciona cliente primero --</option>';
                    parteSelect.value = '';
                }

                setValue(card, '.referencia-input', '');
                setValue(card, '.designacion-input', '');
            });
        }

    </script>
</body>
</html>