@model ERP.NSQuell.Models.PlaneacionReleaseDetalleVm

@{
    Layout = "~/Views/Shared/_Layout.cshtml";
    ViewData["Title"] = "Detalle Release | Planeación";

    string Valor(string? valor) => string.IsNullOrWhiteSpace(valor) ? "-" : valor.Replace("GOLDEN", "GOLDE");
    string Fecha(DateTime? fecha) => fecha.HasValue ? fecha.Value.ToString("dd/MM/yyyy") : "-";
    string TextoImportado(bool importado) => importado ? "Desde archivo" : "Captura manual";

    string Unidad(string? unidad)
    {
        return string.IsNullOrWhiteSpace(unidad) ? "pzas" : unidad.Trim();
    }

    int NumeroSemana(DateTime fecha)
    {
        return System.Globalization.CultureInfo.InvariantCulture.Calendar.GetWeekOfYear(
            fecha,
            System.Globalization.CalendarWeekRule.FirstFourDayWeek,
            DayOfWeek.Monday
        );
    }

    DateTime InicioSemana(DateTime fecha)
    {
        var diasDesdeLunes = ((int)fecha.DayOfWeek + 6) % 7;
        return fecha.Date.AddDays(-diasDesdeLunes);
    }

    string TextoSemana(DateTime fecha)
    {
        return "Semana " + NumeroSemana(fecha).ToString("00") + " / " + fecha.Year.ToString();
    }

    string SugerenciaEntrega(ERP.NSQuell.Models.PlaneacionReleaseDetalleRenglonVm entrega)
    {
        if (entrega.CantidadRequerida <= 0)
            return "Revisar cantidad requerida.";

        if (entrega.FechaRequerida.Date < DateTime.Today)
            return "Fecha requerida vencida; revisar prioridad.";

        if (string.IsNullOrWhiteSpace(entrega.UnidadMedidaCliente))
            return "Capturar unidad de medida.";

        if (!entrega.ParteID.HasValue || entrega.ParteID.Value <= 0)
            return "Vincular parte antes de continuar.";

        return "Entrega capturada correctamente.";
    }

    string SugerenciaRenglon(IEnumerable<ERP.NSQuell.Models.PlaneacionReleaseDetalleRenglonVm> entregasRenglon)
    {
        var lista = entregasRenglon.ToList();

        if (!lista.Any())
            return "Sin entregas capturadas.";

        if (lista.Any(x => x.CantidadRequerida <= 0))
            return "Hay entregas con cantidad en cero; revisar captura.";

        if (lista.Any(x => x.FechaRequerida.Date < DateTime.Today))
            return "Tiene entregas vencidas; revisar prioridad.";

        if (lista.Any(x => string.IsNullOrWhiteSpace(x.UnidadMedidaCliente)))
            return "Falta unidad de medida en una o más entregas.";

        if (lista.Any(x => !x.ParteID.HasValue || x.ParteID.Value <= 0))
            return "Falta vincular parte en el renglón.";

        return "Renglón completo para consulta de demanda.";
    }

    var detalles = Model.Detalles ?? new List<ERP.NSQuell.Models.PlaneacionReleaseDetalleRenglonVm>();

    var grupos = detalles
        .GroupBy(x => new
        {
            x.ReleaseRenglonID,
            x.Renglon,
            x.ParteID,
            x.NumeroParte,
            x.ReferenciaSAP,
            x.DesignacionDescripcionSAP,
            x.UnidadMedidaCliente,
            x.ContratoCliente
        })
        .OrderBy(g => g.Key.Renglon)
        .ToList();

    var totalEntregas = detalles.Count;
    var totalPiezasRelease = detalles.Sum(x => x.CantidadRequerida);
    var renglonesSinUnidad = detalles.Count(x => string.IsNullOrWhiteSpace(x.UnidadMedidaCliente));
    var entregasVencidas = detalles.Count(x => x.FechaRequerida.Date < DateTime.Today);
    var renglonesSinParte = detalles.Count(x => !x.ParteID.HasValue || x.ParteID.Value <= 0);

    var semanaBase = detalles.Any()
        ? InicioSemana(detalles.Min(x => x.FechaRequerida))
        : InicioSemana(Model.FechaRecepcion);

    var semanaBaseFin = semanaBase.AddDays(6);

    var piezasSemanaRelease = detalles
        .Where(x => InicioSemana(x.FechaRequerida) == semanaBase)
        .Sum(x => x.CantidadRequerida);

    var entregasSemanaRelease = detalles
        .Count(x => InicioSemana(x.FechaRequerida) == semanaBase);

    var unidadesSemanaRelease = detalles
        .Where(x => InicioSemana(x.FechaRequerida) == semanaBase)
        .Select(x => Unidad(x.UnidadMedidaCliente))
        .Distinct()
        .ToList();

    var unidadSemanaTexto = unidadesSemanaRelease.Count == 1
        ? unidadesSemanaRelease.First()
        : "pzas";

    var esPdfOriginal = Model.ImportadoDesdeArchivo &&
        !string.IsNullOrWhiteSpace(Model.ArchivoOrigenNombre) &&
        Model.ArchivoOrigenNombre.EndsWith(".pdf", StringComparison.OrdinalIgnoreCase);
}

@section Styles {
    <link rel="stylesheet" href="~/css/PlaneacionRelease/detalle.css" asp-append-version="true" />
}


@* PLANEACION_NAVBAR_INJECT_V1_0 *@
    @await Html.PartialAsync("_PlaneacionNavbar")
    <div class="erp-shell">
        <div class="erp-header">
            <div class="d-flex justify-content-between align-items-start gap-3 flex-wrap">
                <div>
                    <h1>
                        <i class="fa-solid fa-file-lines me-2"></i>
                        Detalle del Release
                    </h1>

                    <p>
                        Consulta la demanda capturada por renglón y entrega. El cálculo operativo se realiza en Programa de Planeación.
                    </p>

                    <div>
                        <span class="header-badge"><i class="fa-solid fa-hashtag"></i>@(Model.FolioRelease ?? "Sin folio")</span>
                        <span class="header-badge"><i class="fa-solid fa-barcode"></i>@(Model.FolioCliente ?? "Sin folio cliente")</span>
                        <span class="header-badge"><i class="fa-solid fa-building"></i>@(Model.ClienteNombre ?? "Sin cliente")</span>
                        <span class="header-badge"><i class="fa-solid fa-circle-info"></i>@Model.EstatusNombre</span>
                    </div>
                </div>

                <div class="d-flex gap-2 flex-wrap">
                    @if (Model.ImportadoDesdeArchivo && !string.IsNullOrWhiteSpace(Model.ArchivoOrigenNombre))
                    {
                        <a asp-controller="PlaneacionRelease"
                           asp-action="DescargarDocumentoImportado"
                           asp-route-id="@Model.ReleaseID"
                           target="_blank"
                           rel="noopener"
                           class="btn btn-light fw-bold rounded-3">
                            <i class="fa-solid @(esPdfOriginal ? "fa-file-pdf" : "fa-eye") me-1"></i>
                            Ver Archivo Original
                        </a>
                    }

                    <a asp-controller="PlaneacionRelease"
                       asp-action="Editar"
                       asp-route-id="@Model.ReleaseID"
                       class="btn btn-warning fw-bold rounded-3">
                        <i class="fa-solid fa-pen-to-square me-1"></i>
                        Editar Release
                    </a>

                    <a asp-controller="PlaneacionRelease" asp-action="Index" class="btn btn-light fw-bold rounded-3">
                        <i class="fa-solid fa-arrow-left me-1"></i>
                        Volver
                    </a>
                </div>
            </div>
        </div>

        @if (TempData["Success"] != null)
        {
            <div class="alert alert-success rounded-4 fw-semibold">
                <i class="fa-solid fa-circle-check me-2"></i>
                @TempData["Success"]
            </div>
        }

        @if (TempData["Error"] != null)
        {
            <div class="alert alert-danger rounded-4 fw-semibold">
                <i class="fa-solid fa-triangle-exclamation me-2"></i>
                @TempData["Error"]
            </div>
        }

        @if (Model.ImportadoDesdeArchivo &&
             Model.EstatusID == ERP.NSQuell.Models.PlaneacionReleaseEstatus.Capturado)
        {
            <div class="alert alert-warning rounded-4 fw-semibold d-flex justify-content-between align-items-center gap-3 flex-wrap">
                <div>
                    <i class="fa-solid fa-triangle-exclamation me-2"></i>
                    Este release fue conservado, pero tiene datos pendientes de vincular. No debe avanzar hasta completar sus partes.
                </div>
                <a asp-controller="PlaneacionRelease"
                   asp-action="VincularPartes"
                   asp-route-id="@Model.ReleaseID"
                   class="btn btn-warning fw-bold rounded-3">
                    <i class="fa-solid fa-link me-1"></i>
                    Vincular partes
                </a>
            </div>
        }

        <div class="erp-card">
            <div class="erp-card-header">
                <div>
                    <h2 class="h5 fw-bold m-0 text-primary">
                        <i class="fa-solid fa-lightbulb me-2"></i>
                        Sugerencias del release
                    </h2>
                    <div class="text-muted small">
                        Las piezas por semana se calculan aquí solo como resumen visual del release.
                    </div>
                </div>
            </div>

            <div class="erp-card-body">
                <div class="suggestion-grid">
                    <div class="suggestion-card week">
                        <div class="k">Piezas requeridas de la semana</div>
                        <div class="v">@piezasSemanaRelease.ToString("N0") @unidadSemanaTexto</div>
                        <div class="s">@TextoSemana(semanaBase) · @semanaBase.ToString("dd/MM/yyyy") al @semanaBaseFin.ToString("dd/MM/yyyy") · @entregasSemanaRelease.ToString("N0") entrega(s)</div>
                    </div>

                    <div class="suggestion-card info">
                        <div class="k">Demanda total release</div>
                        <div class="v">@totalPiezasRelease.ToString("N0") pzas</div>
                        <div class="s">@grupos.Count.ToString("N0") renglón(es) · @totalEntregas.ToString("N0") entrega(s)</div>
                    </div>

                   

                    <div class="suggestion-card @(entregasVencidas > 0 || renglonesSinParte > 0 ? "warn" : "ok")">
                        <div class="k">Acción sugerida</div>
                        <div class="v">
                            @if (renglonesSinParte > 0)
                            {
                                @:Vincular partes
                            }
                            else if (entregasVencidas > 0)
                            {
                                @:Revisar fechas
                            }
                            else
                            {
                                @:Listo para consulta
                            }
                        </div>
                        <div class="s">El cálculo operativo se revisa en Programa de Planeación.</div>
                    </div>
                </div>
            </div>
        </div>

        <div class="erp-card">
            <div class="erp-card-header">
                <div>
                    <h2 class="h5 fw-bold m-0 text-primary">
                        <i class="fa-solid fa-file-lines me-2"></i>
                        Encabezado
                    </h2>
                    <div class="text-muted small">Información general del release recibido.</div>
                </div>
            </div>

            <div class="erp-card-body">
                <div class="row g-3">
                    <div class="col-md-3"><div class="erp-label">Folio interno</div><div class="erp-value">@Valor(Model.FolioRelease)</div></div>
                    <div class="col-md-3"><div class="erp-label">Folio cliente / Schedule / Contrato</div><div class="erp-value">@Valor(Model.FolioCliente)</div></div>
                    <div class="col-md-3"><div class="erp-label">Cliente</div><div class="erp-value">@Valor(Model.ClienteNombre)</div></div>
                    <div class="col-md-3"><div class="erp-label">Fecha recepción</div><div class="erp-value">@Model.FechaRecepcion.ToString("dd/MM/yyyy")</div></div>
                    <div class="col-md-3"><div class="erp-label">Semana / versión</div><div class="erp-value">@Valor(Model.VersionRelease)</div></div>
                    <div class="col-md-3"><div class="erp-label">Archivo origen</div><div class="erp-value">@Valor(Model.ArchivoOrigenNombre)</div></div>
                    <div class="col-md-3"><div class="erp-label">Plantilla importación</div><div class="erp-value">@Valor(Model.PlantillaImportacion)</div></div>
                    <div class="col-md-3"><div class="erp-label">Origen</div><div class="erp-value">@TextoImportado(Model.ImportadoDesdeArchivo)</div></div>
                    <div class="col-md-12"><div class="erp-label">Observaciones</div><div class="erp-value">@Valor(Model.Observaciones)</div></div>
                </div>
            </div>
        </div>

        @if (grupos.Any())
        {
            foreach (var grupo in grupos)
            {
                var entregas = grupo
                    .OrderBy(x => x.SecuenciaEntrega ?? 9999)
                    .ThenBy(x => x.FechaRequerida)
                    .ToList();

                var totalReqGrupo = entregas.Sum(x => x.CantidadRequerida);
                var unidadGrupo = Unidad(grupo.Key.UnidadMedidaCliente);
                var sugerenciaRenglon = SugerenciaRenglon(entregas);

                <div class="renglon-card">
                    <div class="renglon-header">
                        <div>
                            <div class="renglon-title">Renglón @grupo.Key.Renglon · @Valor(grupo.Key.ReferenciaSAP ?? grupo.Key.NumeroParte)</div>
                            <div class="small-muted">@Valor(grupo.Key.DesignacionDescripcionSAP)</div>
                        </div>

                        <div class="d-flex gap-2 flex-wrap">
                            <span class="summary-chip"><i class="fa-solid fa-ruler"></i>UM: @unidadGrupo</span>
                            <span class="summary-chip"><i class="fa-solid fa-file-contract"></i>Contrato: @Valor(grupo.Key.ContratoCliente)</span>
                            <span class="summary-chip"><i class="fa-solid fa-truck"></i>@entregas.Count entrega(s)</span>
                            <span class="summary-chip"><i class="fa-solid fa-cubes"></i>Req: @totalReqGrupo.ToString("N0") @unidadGrupo</span>
                        </div>
                    </div>

                    <div class="renglon-body">
                        <div class="suggestion-strip">
                            <i class="fa-solid fa-lightbulb mt-1"></i>
                            <div>
                                <div class="fw-bold">Sugerencia del renglón</div>
                                <div>@sugerenciaRenglon</div>
                            </div>
                        </div>

                        <div class="row g-3 mb-3">
                            <div class="col-md-3"><div class="erp-label">No. parte</div><div class="erp-value">@Valor(grupo.Key.NumeroParte)</div></div>
                            <div class="col-md-3"><div class="erp-label">Referencia SAP / cliente</div><div class="erp-value">@Valor(grupo.Key.ReferenciaSAP)</div></div>
                            <div class="col-md-3"><div class="erp-label">Unidad cliente</div><div class="erp-value">@unidadGrupo</div></div>
                            <div class="col-md-3"><div class="erp-label">Contrato / orden cliente</div><div class="erp-value">@Valor(grupo.Key.ContratoCliente)</div></div>
                            <div class="col-md-12"><div class="erp-label">Designación / descripción</div><div class="erp-value">@Valor(grupo.Key.DesignacionDescripcionSAP)</div></div>
                        </div>

                        <div class="table-responsive">
                            <table class="table table-bordered table-hover align-middle">
                                <thead>
                                    <tr>
                                        <th>Entrega</th>
                                        <th>Fecha carga</th>
                                        <th>Fecha requerida</th>
                                        <th>Cantidad requerida</th>
                                        <th>Unidad</th>
                                        <th>Sugerencia</th>
                                    </tr>
                                </thead>

                                <tbody>
                                    @for (var i = 0; i < entregas.Count; i++)
                                    {
                                        var d = entregas[i];
                                        var secuencia = d.SecuenciaEntrega ?? (i + 1);
                                        var unidadEntrega = Unidad(d.UnidadMedidaCliente);

                                        <tr>
                                            <td><strong>@secuencia</strong></td>
                                            <td>@Fecha(d.FechaCarga)</td>
                                            <td>@d.FechaRequerida.ToString("dd/MM/yyyy")</td>
                                            <td><strong>@d.CantidadRequerida.ToString("N0")</strong></td>
                                            <td>@unidadEntrega</td>
                                            <td>@SugerenciaEntrega(d)</td>
                                        </tr>
                                    }
                                </tbody>

                                <tfoot>
                                    <tr class="fw-bold">
                                        <td colspan="3" class="text-end">Total renglón</td>
                                        <td>@totalReqGrupo.ToString("N0")</td>
                                        <td>@unidadGrupo</td>
                                        <td></td>
                                    </tr>
                                </tfoot>
                            </table>
                        </div>
                    </div>
                </div>
            }
        }
        else
        {
            <div class="erp-card">
                <div class="erp-card-body text-center text-muted py-5">
                    <i class="fa-solid fa-inbox fa-2x mb-3"></i>
                    <div class="fw-bold">No hay renglones en este release.</div>
                </div>
            </div>
        }

        <div class="sticky-actions">
            <div class="d-flex justify-content-between gap-2 flex-wrap">
                <a asp-controller="PlaneacionRelease" asp-action="Index" class="btn btn-erp-light">
                    <i class="fa-solid fa-arrow-left me-1"></i>
                    Volver a Releases
                </a>

                <a asp-controller="PlaneacionRelease"
                   asp-action="Editar"
                   asp-route-id="@Model.ReleaseID"
                   class="btn btn-erp-primary">
                    <i class="fa-solid fa-pen-to-square me-1"></i>
                    Editar Release
                </a>
            </div>
        </div>
    </div>
