@model ERP.NSQuell.Models.PlaneacionReleaseDetalleVm

@{
    Layout = null;

    string Valor(string? valor) => string.IsNullOrWhiteSpace(valor) ? "-" : valor;
    string Fecha(DateTime? fecha) => fecha.HasValue ? fecha.Value.ToString("dd/MM/yyyy") : "-";
    string FechaHora(DateTime? fecha) => fecha.HasValue ? fecha.Value.ToString("dd/MM/yyyy HH:mm") : "-";
    string Entero(int? valor) => valor.HasValue ? valor.Value.ToString("N0") : "-";
    string Decimal2(decimal? valor) => valor.HasValue ? valor.Value.ToString("N2") : "-";
    string Decimal4(decimal? valor) => valor.HasValue ? valor.Value.ToString("N4") : "-";

    string ClaseTiempo(bool? daTiempo)
    {
        if (daTiempo == true) return "badge-ok";
        if (daTiempo == false) return "badge-no";
        return "badge-warn";
    }

    string TextoTiempo(bool? daTiempo)
    {
        if (daTiempo == true) return "Sí da tiempo";
        if (daTiempo == false) return "No da tiempo";
        return "Sin validar";
    }
}

<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <title>Detalle Release | Planeación</title>
    <meta name="viewport" content="width=device-width, initial-scale=1" />

    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.2/css/all.min.css" rel="stylesheet">

    <style>
        :root {
            --erp-blue: #004AAD;
            --erp-blue-dark: #00347a;
            --erp-gray: #f3f5f8;
            --erp-border: #d9e1ec;
            --erp-text: #263238;
            --erp-muted: #667085;
            --erp-green: #107c41;
            --erp-red: #b42318;
            --erp-orange: #b54708;
        }

        body {
            background: var(--erp-gray);
            color: var(--erp-text);
            font-family: "Segoe UI", Arial, sans-serif;
        }

        .erp-shell {
            max-width: 1600px;
            margin: 0 auto;
            padding: 28px;
        }

        .erp-header {
            background: linear-gradient(135deg, var(--erp-blue), var(--erp-blue-dark));
            color: white;
            border-radius: 22px;
            padding: 28px 32px;
            box-shadow: 0 16px 36px rgba(0, 74, 173, .23);
            margin-bottom: 22px;
        }

            .erp-header h1 {
                font-size: 1.65rem;
                margin: 0;
                font-weight: 900;
            }

        .header-badge {
            display: inline-flex;
            align-items: center;
            gap: 7px;
            background: rgba(255,255,255,.16);
            color: white;
            border: 1px solid rgba(255,255,255,.28);
            border-radius: 999px;
            padding: 7px 12px;
            font-size: .82rem;
            font-weight: 800;
            margin-top: 12px;
            margin-right: 6px;
        }

        .erp-card {
            background: white;
            border: 1px solid var(--erp-border);
            border-radius: 20px;
            box-shadow: 0 10px 24px rgba(30, 55, 90, .08);
            margin-bottom: 20px;
            overflow: hidden;
        }

        .erp-card-header {
            padding: 18px 22px;
            border-bottom: 1px solid var(--erp-border);
            display: flex;
            justify-content: space-between;
            align-items: center;
            gap: 14px;
            flex-wrap: wrap;
        }

        .erp-card-body {
            padding: 22px;
        }

        .erp-label {
            font-weight: 800;
            color: #33465f;
            font-size: .78rem;
            text-transform: uppercase;
            letter-spacing: .035em;
            margin-bottom: 4px;
        }

        .erp-value {
            color: #263238;
            font-weight: 650;
            min-height: 24px;
        }

        .metric-card {
            background: white;
            border: 1px solid var(--erp-border);
            border-radius: 18px;
            padding: 18px;
            box-shadow: 0 8px 20px rgba(30, 55, 90, .07);
            height: 100%;
        }

        .metric-label {
            color: var(--erp-muted);
            font-size: .78rem;
            font-weight: 800;
            text-transform: uppercase;
            letter-spacing: .04em;
        }

        .metric-value {
            font-size: 1.35rem;
            font-weight: 900;
            color: var(--erp-blue-dark);
        }

        .btn-erp-primary {
            background: var(--erp-blue);
            border-color: var(--erp-blue);
            color: white;
            font-weight: 800;
            border-radius: 13px;
            padding: 10px 15px;
        }

            .btn-erp-primary:hover {
                background: var(--erp-blue-dark);
                border-color: var(--erp-blue-dark);
                color: white;
            }

        .btn-erp-light {
            background: white;
            border: 1px solid var(--erp-border);
            color: var(--erp-blue-dark);
            font-weight: 800;
            border-radius: 13px;
            padding: 10px 15px;
        }

        .badge-calc {
            display: inline-flex;
            align-items: center;
            border-radius: 999px;
            padding: 7px 12px;
            font-size: .78rem;
            font-weight: 900;
            border: 1px solid transparent;
        }

        .badge-ok {
            background: #ecfdf3;
            color: #027a48;
            border-color: #abefc6;
        }

        .badge-no {
            background: #fef3f2;
            color: #b42318;
            border-color: #fecdca;
        }

        .badge-warn {
            background: #fff7ed;
            color: #b54708;
            border-color: #fed7aa;
        }

        .table thead th {
            background: #eef3fb;
            color: #00347a;
            font-size: .76rem;
            white-space: nowrap;
            text-transform: uppercase;
            letter-spacing: .03em;
            vertical-align: middle;
        }

        .table td {
            font-size: .84rem;
            vertical-align: middle;
        }

        .small-muted {
            color: var(--erp-muted);
            font-size: .78rem;
        }

        .sticky-actions {
            position: sticky;
            bottom: 0;
            background: rgba(243, 245, 248, .92);
            backdrop-filter: blur(10px);
            padding: 14px 0;
            z-index: 20;
        }
    </style>
</head>

<body>
    <div class="erp-shell">

        <div class="erp-header">
            <div class="d-flex justify-content-between align-items-start gap-3 flex-wrap">
                <div>
                    <h1>
                        <i class="fa-solid fa-calculator me-2"></i>
                        Detalle Release / Calculadora de necesidades
                    </h1>

                    <div>
                        <span class="header-badge">
                            <i class="fa-solid fa-hashtag"></i>
                            @(Model.FolioRelease ?? "Sin folio")
                        </span>

                        <span class="header-badge">
                            <i class="fa-solid fa-building"></i>
                            @(Model.ClienteNombre ?? "Sin cliente")
                        </span>

                        <span class="header-badge">
                            <i class="fa-solid fa-circle-info"></i>
                            @Model.EstatusNombre
                        </span>
                    </div>
                </div>

                <div class="d-flex gap-2 flex-wrap">
                    <a asp-controller="PlaneacionRelease" asp-action="Index" class="btn btn-light fw-bold rounded-3">
                        <i class="fa-solid fa-arrow-left me-1"></i>
                        Volver
                    </a>

                    <form asp-controller="PlaneacionRelease" asp-action="Recalcular" method="post" class="d-inline">
                        @Html.AntiForgeryToken()
                        <input type="hidden" name="id" value="@Model.ReleaseID" />
                        <button type="submit" class="btn btn-light fw-bold rounded-3">
                            <i class="fa-solid fa-rotate me-1"></i>
                            Recalcular
                        </button>
                    </form>
                </div>
            </div>
        </div>

        @if (TempData["Success"] != null)
        {
            <div class="alert alert-success rounded-4 fw-semibold">
                <i class="fa-solid fa-circle-check me-2"></i>
                @TempData["Success"]
            </div>
        }

        @if (TempData["Error"] != null)
        {
            <div class="alert alert-danger rounded-4 fw-semibold">
                <i class="fa-solid fa-triangle-exclamation me-2"></i>
                @TempData["Error"]
            </div>
        }

        <div class="row g-3 mb-3">
            <div class="col-md-2">
                <div class="metric-card">
                    <div class="metric-label">Renglones</div>
                    <div class="metric-value">@Model.TotalRenglones</div>
                </div>
            </div>

            <div class="col-md-2">
                <div class="metric-card">
                    <div class="metric-label">Requeridas</div>
                    <div class="metric-value">@Model.TotalPiezasRequeridas.ToString("N0")</div>
                </div>
            </div>

            <div class="col-md-2">
                <div class="metric-card">
                    <div class="metric-label">Desde PT</div>
                    <div class="metric-value">@Model.TotalPiezasDesdePT.ToString("N0")</div>
                </div>
            </div>

            <div class="col-md-2">
                <div class="metric-card">
                    <div class="metric-label">A producir</div>
                    <div class="metric-value">@Model.TotalPiezasAProducir.ToString("N0")</div>
                </div>
            </div>

            <div class="col-md-2">
                <div class="metric-card">
                    <div class="metric-label">MP kg</div>
                    <div class="metric-value">@Model.TotalMPRequeridaKg.ToString("N4")</div>
                </div>
            </div>

            <div class="col-md-2">
                <div class="metric-card">
                    <div class="metric-label">Horas</div>
                    <div class="metric-value">@Model.TotalHorasNecesarias.ToString("N2")</div>
                </div>
            </div>
        </div>

        <div class="erp-card">
            <div class="erp-card-header">
                <div>
                    <h2 class="h5 fw-bold m-0 text-primary">
                        <i class="fa-solid fa-file-lines me-2"></i>
                        Encabezado
                    </h2>
                    <div class="text-muted small">
                        Información general del release recibido.
                    </div>
                </div>
            </div>

            <div class="erp-card-body">
                <div class="row g-3">
                    <div class="col-md-3">
                        <div class="erp-label">Folio</div>
                        <div class="erp-value">@Valor(Model.FolioRelease)</div>
                    </div>

                    <div class="col-md-3">
                        <div class="erp-label">Cliente</div>
                        <div class="erp-value">@Valor(Model.ClienteNombre)</div>
                    </div>

                    <div class="col-md-3">
                        <div class="erp-label">Fecha recepción</div>
                        <div class="erp-value">@Model.FechaRecepcion.ToString("dd/MM/yyyy")</div>
                    </div>

                    <div class="col-md-3">
                        <div class="erp-label">Versión</div>
                        <div class="erp-value">@Valor(Model.VersionRelease)</div>
                    </div>

                    <div class="col-md-12">
                        <div class="erp-label">Observaciones</div>
                        <div class="erp-value">@Valor(Model.Observaciones)</div>
                    </div>
                </div>
            </div>
        </div>

        <div class="erp-card">
            <div class="erp-card-header">
                <div>
                    <h2 class="h5 fw-bold m-0 text-primary">
                        <i class="fa-solid fa-table-list me-2"></i>
                        Calculadora de necesidades
                    </h2>
                    <div class="text-muted small">
                        Requerido contra PT disponible, producción pendiente, MP, embalaje y capacidad inicial.
                    </div>
                </div>
            </div>

            <div class="erp-card-body">
                <div class="table-responsive">
                    <table class="table table-bordered table-hover align-middle">
                        <thead>
                            <tr>
                                <th>Ren.</th>
                                <th>Parte</th>
                                <th>Fecha req.</th>
                                <th>Req.</th>
                                <th>PT disp.</th>
                                <th>Prog. pend.</th>
                                <th>Desde PT</th>
                                <th>A producir</th>
                                <th>MP req.</th>
                                <th>MP disp.</th>
                                <th>Emb. req.</th>
                                <th>Emb. disp.</th>
                                <th>Máquina</th>
                                <th>Molde</th>
                                <th>Horas</th>
                                <th>Fin estimado</th>
                                <th>Resultado</th>
                            </tr>
                        </thead>
                        <tbody>
                            @if (Model.Detalles != null && Model.Detalles.Any())
                            {
                                foreach (var d in Model.Detalles)
                                {
                                    <tr>
                                        <td>@d.Renglon</td>
                                        <td>
                                            <strong>@Valor(d.ReferenciaSAP ?? d.NumeroParte)</strong><br />
                                            <span class="small-muted">@Valor(d.DesignacionDescripcionSAP)</span>
                                        </td>
                                        <td>@d.FechaRequerida.ToString("dd/MM/yyyy")</td>
                                        <td>@d.CantidadRequerida.ToString("N0")</td>
                                        <td>@Entero(d.PTDisponibleAlCalcular)</td>
                                        <td>@Entero(d.ProduccionProgramadaPendiente)</td>
                                        <td>
                                            <strong>@Entero(d.PiezasDesdePT)</strong>
                                        </td>
                                        <td>
                                            <strong>@Entero(d.PiezasAProducir)</strong>
                                        </td>
                                        <td>@Decimal4(d.MPRequeridaKg)</td>
                                        <td>@Decimal4(d.MPDisponibleKg)</td>
                                        <td>@Decimal4(d.EmbalajeRequerido)</td>
                                        <td>@Decimal4(d.EmbalajeDisponible)</td>
                                        <td>
                                            <strong>@Valor(d.MaquinaSugeridaCodigo)</strong><br />
                                            <span class="small-muted">@Valor(d.MaquinaSugeridaNombre)</span>
                                        </td>
                                        <td>@Valor(d.MoldeCodigo)</td>
                                        <td>@Decimal2(d.HorasNecesarias)</td>
                                        <td>@FechaHora(d.FechaFinEstimada)</td>
                                        <td>
                                            <span class="badge-calc @ClaseTiempo(d.DaTiempo)">
                                                @TextoTiempo(d.DaTiempo)
                                            </span>
                                            <div class="small-muted mt-1">
                                                @Valor(d.MensajeCapacidad)
                                            </div>
                                        </td>
                                    </tr>
                                }
                            }
                            else
                            {
                                <tr>
                                    <td colspan="17" class="text-center text-muted">
                                        No hay renglones en este release.
                                    </td>
                                </tr>
                            }
                        </tbody>
                        <tfoot>
                            <tr class="fw-bold">
                                <td colspan="3" class="text-end">Totales</td>
                                <td>@Model.TotalPiezasRequeridas.ToString("N0")</td>
                                <td></td>
                                <td></td>
                                <td>@Model.TotalPiezasDesdePT.ToString("N0")</td>
                                <td>@Model.TotalPiezasAProducir.ToString("N0")</td>
                                <td>@Model.TotalMPRequeridaKg.ToString("N4")</td>
                                <td></td>
                                <td></td>
                                <td></td>
                                <td colspan="2"></td>
                                <td>@Model.TotalHorasNecesarias.ToString("N2")</td>
                                <td colspan="2"></td>
                            </tr>
                        </tfoot>
                    </table>
                </div>
            </div>
        </div>

        <div class="sticky-actions">
            <div class="d-flex justify-content-between gap-2 flex-wrap">
                <a asp-controller="PlaneacionRelease" asp-action="Index" class="btn btn-erp-light">
                    <i class="fa-solid fa-arrow-left me-1"></i>
                    Volver a Releases
                </a>

                <div class="d-flex gap-2 flex-wrap">
                    <form asp-controller="PlaneacionRelease" asp-action="Recalcular" method="post">
                        @Html.AntiForgeryToken()
                        <input type="hidden" name="id" value="@Model.ReleaseID" />
                        <button type="submit" class="btn btn-erp-light">
                            <i class="fa-solid fa-rotate me-1"></i>
                            Recalcular
                        </button>
                    </form>

                    <button type="button" class="btn btn-erp-primary" disabled>
                        <i class="fa-solid fa-industry me-1"></i>
                        Generar programa
                    </button>

                    <button type="button" class="btn btn-erp-primary" disabled>
                        <i class="fa-solid fa-file-circle-plus me-1"></i>
                        Generar OF
                    </button>
                </div>
            </div>
        </div>

    </div>
</body>
</html>