@model ERP.NSQuell.Models.PlaneacionReleaseDetalleVm

@{
    Layout = null;

    string Valor(string? valor) => string.IsNullOrWhiteSpace(valor) ? "-" : valor;
    string Fecha(DateTime? fecha) => fecha.HasValue ? fecha.Value.ToString("dd/MM/yyyy") : "-";
    string FechaHora(DateTime? fecha) => fecha.HasValue ? fecha.Value.ToString("dd/MM/yyyy HH:mm") : "-";
    string Entero(int? valor) => valor.HasValue ? valor.Value.ToString("N0") : "-";
    string Decimal2(decimal? valor) => valor.HasValue ? valor.Value.ToString("N2") : "-";
    string Decimal4(decimal? valor) => valor.HasValue ? valor.Value.ToString("N4") : "-";

    string ClaseTiempo(bool? daTiempo)
    {
        if (daTiempo == true) return "badge-ok";
        if (daTiempo == false) return "badge-no";
        return "badge-warn";
    }

    string TextoTiempo(bool? daTiempo)
    {
        if (daTiempo == true) return "Sí da tiempo";
        if (daTiempo == false) return "No da tiempo";
        return "Sin validar";
    }

    string TextoImportado(bool importado) => importado ? "Desde archivo" : "Captura manual";

    var grupos = (Model.Detalles ?? new List<ERP.NSQuell.Models.PlaneacionReleaseDetalleRenglonVm>())
        .GroupBy(x => new
        {
            x.ReleaseRenglonID,
            x.Renglon,
            x.ParteID,
            x.NumeroParte,
            x.ReferenciaSAP,
            x.DesignacionDescripcionSAP,
            x.UnidadMedidaCliente,
            x.ContratoCliente
        })
        .OrderBy(g => g.Key.Renglon)
        .ToList();

    var totalEntregas = Model.Detalles?.Count ?? 0;
    var esPdfOriginal = Model.ImportadoDesdeArchivo &&
        !string.IsNullOrWhiteSpace(Model.ArchivoOrigenNombre) &&
        Model.ArchivoOrigenNombre.EndsWith(".pdf", StringComparison.OrdinalIgnoreCase);
}

<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <title>Detalle Release | Planeación</title>
    <meta name="viewport" content="width=device-width, initial-scale=1" />

    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.2/css/all.min.css" rel="stylesheet">

    <style>
        :root {
            --erp-blue: #004AAD;
            --erp-blue-dark: #00347a;
            --erp-gray: #f3f5f8;
            --erp-border: #d9e1ec;
            --erp-text: #263238;
            --erp-muted: #667085;
            --erp-green: #107c41;
            --erp-red: #b42318;
            --erp-orange: #b54708;
        }

        body {
            background: var(--erp-gray);
            color: var(--erp-text);
            font-family: "Segoe UI", Arial, sans-serif;
        }

        .erp-shell {
            max-width: 1600px;
            margin: 0 auto;
            padding: 28px;
        }

        .erp-header {
            background: linear-gradient(135deg, var(--erp-blue), var(--erp-blue-dark));
            color: white;
            border-radius: 22px;
            padding: 28px 32px;
            box-shadow: 0 16px 36px rgba(0, 74, 173, .23);
            margin-bottom: 22px;
        }

            .erp-header h1 {
                font-size: 1.65rem;
                margin: 0;
                font-weight: 900;
            }

            .erp-header p {
                margin: 7px 0 0 0;
                opacity: .92;
            }

        .header-badge {
            display: inline-flex;
            align-items: center;
            gap: 7px;
            background: rgba(255,255,255,.16);
            color: white;
            border: 1px solid rgba(255,255,255,.28);
            border-radius: 999px;
            padding: 7px 12px;
            font-size: .82rem;
            font-weight: 800;
            margin-top: 12px;
            margin-right: 6px;
        }

        .erp-card {
            background: white;
            border: 1px solid var(--erp-border);
            border-radius: 20px;
            box-shadow: 0 10px 24px rgba(30, 55, 90, .08);
            margin-bottom: 20px;
            overflow: hidden;
        }

        .erp-card-header {
            padding: 18px 22px;
            border-bottom: 1px solid var(--erp-border);
            display: flex;
            justify-content: space-between;
            align-items: center;
            gap: 14px;
            flex-wrap: wrap;
        }

        .erp-card-body {
            padding: 22px;
        }

        .erp-label {
            font-weight: 800;
            color: #33465f;
            font-size: .78rem;
            text-transform: uppercase;
            letter-spacing: .035em;
            margin-bottom: 4px;
        }

        .erp-value {
            color: #263238;
            font-weight: 650;
            min-height: 24px;
        }

        .metric-card {
            background: white;
            border: 1px solid var(--erp-border);
            border-radius: 18px;
            padding: 18px;
            box-shadow: 0 8px 20px rgba(30, 55, 90, .07);
            height: 100%;
        }

        .metric-label {
            color: var(--erp-muted);
            font-size: .78rem;
            font-weight: 800;
            text-transform: uppercase;
            letter-spacing: .04em;
        }

        .metric-value {
            font-size: 1.35rem;
            font-weight: 900;
            color: var(--erp-blue-dark);
        }

        .btn-erp-primary {
            background: var(--erp-blue);
            border-color: var(--erp-blue);
            color: white;
            font-weight: 800;
            border-radius: 13px;
            padding: 10px 15px;
        }

            .btn-erp-primary:hover {
                background: var(--erp-blue-dark);
                border-color: var(--erp-blue-dark);
                color: white;
            }

        .btn-erp-light {
            background: white;
            border: 1px solid var(--erp-border);
            color: var(--erp-blue-dark);
            font-weight: 800;
            border-radius: 13px;
            padding: 10px 15px;
        }

        .badge-calc {
            display: inline-flex;
            align-items: center;
            border-radius: 999px;
            padding: 7px 12px;
            font-size: .78rem;
            font-weight: 900;
            border: 1px solid transparent;
            white-space: nowrap;
        }

        .badge-ok {
            background: #ecfdf3;
            color: #027a48;
            border-color: #abefc6;
        }

        .badge-no {
            background: #fef3f2;
            color: #b42318;
            border-color: #fecdca;
        }

        .badge-warn {
            background: #fff7ed;
            color: #b54708;
            border-color: #fed7aa;
        }

        .renglon-card {
            border: 1px solid var(--erp-border);
            border-radius: 18px;
            background: #fff;
            overflow: hidden;
            margin-bottom: 18px;
        }

        .renglon-header {
            background: #eef3fb;
            border-bottom: 1px solid var(--erp-border);
            padding: 16px 18px;
            display: flex;
            justify-content: space-between;
            gap: 14px;
            flex-wrap: wrap;
            align-items: center;
        }

        .renglon-title {
            font-weight: 900;
            color: var(--erp-blue-dark);
            font-size: 1rem;
        }

        .renglon-body {
            padding: 18px;
        }

        .summary-chip {
            display: inline-flex;
            align-items: center;
            gap: 7px;
            padding: 7px 11px;
            border: 1px solid var(--erp-border);
            border-radius: 999px;
            background: white;
            color: #475467;
            font-size: .78rem;
            font-weight: 800;
        }

        .table thead th {
            background: #eef3fb;
            color: #00347a;
            font-size: .76rem;
            white-space: nowrap;
            text-transform: uppercase;
            letter-spacing: .03em;
            vertical-align: middle;
        }

        .table td {
            font-size: .84rem;
            vertical-align: middle;
        }

        .small-muted {
            color: var(--erp-muted);
            font-size: .78rem;
        }

        .sticky-actions {
            position: sticky;
            bottom: 0;
            background: rgba(243, 245, 248, .92);
            backdrop-filter: blur(10px);
            padding: 14px 0;
            z-index: 20;
        }

        @@media (max-width: 767.98px) {
            .erp-shell {
                padding: 16px;
            }

            .erp-header {
                padding: 22px;
                border-radius: 18px;
            }

            .erp-card-body {
                padding: 17px;
            }
        }
    
        /* RELEASE_DETAIL_RESTORED_V1_7 */
        .erp-header {
            position: relative;
            overflow: hidden;
        }

        .erp-header::after {
            content: "";
            position: absolute;
            right: -75px;
            top: -105px;
            width: 270px;
            height: 270px;
            border-radius: 999px;
            background: rgba(255,255,255,.09);
            pointer-events: none;
        }

        .erp-header > * {
            position: relative;
            z-index: 2;
        }

        .metric-card {
            position: relative;
            overflow: hidden;
            border-radius: 20px;
        }

        .metric-card::before {
            content: "";
            position: absolute;
            left: 0;
            top: 0;
            bottom: 0;
            width: 5px;
            background: linear-gradient(180deg, #004aad, #2f80ed);
        }

        .renglon-card {
            border-radius: 24px;
            box-shadow: 0 14px 34px rgba(31, 63, 104, .09);
        }

        .renglon-header {
            padding: 20px 22px;
            background:
                radial-gradient(circle at 92% 10%, rgba(0,74,173,.10), transparent 26%),
                linear-gradient(135deg, #eef5ff, #ffffff);
        }

        .renglon-body {
            padding: 22px;
        }

        .table-responsive {
            border: 1px solid #dbe4f0;
            border-radius: 16px;
            box-shadow: 0 8px 20px rgba(31, 63, 104, .05);
        }

        .table {
            margin-bottom: 0;
        }

        .table thead th {
            padding: 13px 10px;
            background: linear-gradient(135deg, #e8f1ff, #eef4fd);
            border-bottom: 2px solid #c9d8eb;
        }

        .table tbody td {
            padding: 12px 9px;
        }

        .table tbody tr:nth-child(even) td {
            background: #f9fbfe;
        }

        .table tbody tr:hover td {
            background: #eef6ff;
        }

        .table tfoot td {
            padding: 13px 9px;
            background: #eaf3ff;
            color: #00347a;
        }

        .badge-calc {
            box-shadow: inset 0 0 0 1px rgba(255,255,255,.55);
        }
    </style>
</head>

<body>
    <div class="erp-shell">
        <div class="erp-header">
            <div class="d-flex justify-content-between align-items-start gap-3 flex-wrap">
                <div>
                    <h1>
                        <i class="fa-solid fa-file-lines me-2"></i>
                        Detalle del Release
                    </h1>

                    <p>
                        Consulta la demanda capturada por renglón y sus entregas, con fecha de carga, fecha requerida y cálculo inicial.
                    </p>

                    <div>
                        <span class="header-badge"><i class="fa-solid fa-hashtag"></i>@(Model.FolioRelease ?? "Sin folio")</span>
                        <span class="header-badge"><i class="fa-solid fa-barcode"></i>@(Model.FolioCliente ?? "Sin folio cliente")</span>
                        <span class="header-badge"><i class="fa-solid fa-building"></i>@(Model.ClienteNombre ?? "Sin cliente")</span>
                        <span class="header-badge"><i class="fa-solid fa-circle-info"></i>@Model.EstatusNombre</span>
                    </div>
                </div>

                <div class="d-flex gap-2 flex-wrap">
                    @if (Model.ImportadoDesdeArchivo && !string.IsNullOrWhiteSpace(Model.ArchivoOrigenNombre))
                    {
                        <a asp-controller="PlaneacionRelease"
                           asp-action="DescargarDocumentoImportado"
                           asp-route-id="@Model.ReleaseID"
                           target="_blank"
                           rel="noopener"
                           class="btn btn-light fw-bold rounded-3">
                            <i class="fa-solid @(esPdfOriginal ? "fa-file-pdf" : "fa-download") me-1"></i>
                            @(esPdfOriginal ? "Ver PDF original" : "Descargar archivo original")
                        </a>
                    }

                    <a asp-controller="PlaneacionRelease" asp-action="Index" class="btn btn-light fw-bold rounded-3">
                        <i class="fa-solid fa-arrow-left me-1"></i>
                        Volver
                    </a>

                    <form asp-controller="PlaneacionRelease" asp-action="Recalcular" method="post" class="d-inline">
                        @Html.AntiForgeryToken()
                        <input type="hidden" name="id" value="@Model.ReleaseID" />
                        <button type="submit" class="btn btn-light fw-bold rounded-3">
                            <i class="fa-solid fa-rotate me-1"></i>
                            Recalcular
                        </button>
                    </form>
                </div>
            </div>
        </div>

        @if (TempData["Success"] != null)
        {
            <div class="alert alert-success rounded-4 fw-semibold">
                <i class="fa-solid fa-circle-check me-2"></i>
                @TempData["Success"]
            </div>
        }

        @if (TempData["Error"] != null)
        {
            <div class="alert alert-danger rounded-4 fw-semibold">
                <i class="fa-solid fa-triangle-exclamation me-2"></i>
                @TempData["Error"]
            </div>
        }

        @if (Model.ImportadoDesdeArchivo &&
             Model.EstatusID == ERP.NSQuell.Models.PlaneacionReleaseEstatus.Capturado)
        {
            <div class="alert alert-warning rounded-4 fw-semibold d-flex justify-content-between align-items-center gap-3 flex-wrap">
                <div>
                    <i class="fa-solid fa-triangle-exclamation me-2"></i>
                    Este Release fue conservado, pero tiene datos pendientes de vincular. No debe pasar a Planeacion hasta completar sus partes.
                </div>
                <a asp-controller="PlaneacionRelease"
                   asp-action="VincularPartes"
                   asp-route-id="@Model.ReleaseID"
                   class="btn btn-warning fw-bold rounded-3">
                    <i class="fa-solid fa-link me-1"></i>
                    Vincular partes
                </a>
            </div>
        }
        <div class="row g-3 mb-3">
            <div class="col-md-2"><div class="metric-card"><div class="metric-label">Renglones</div><div class="metric-value">@grupos.Count.ToString("N0")</div></div></div>
            <div class="col-md-2"><div class="metric-card"><div class="metric-label">Entregas</div><div class="metric-value">@totalEntregas.ToString("N0")</div></div></div>
            <div class="col-md-2"><div class="metric-card"><div class="metric-label">Requeridas</div><div class="metric-value">@Model.TotalPiezasRequeridas.ToString("N0")</div></div></div>
            <div class="col-md-2"><div class="metric-card"><div class="metric-label">Desde PT</div><div class="metric-value">@Model.TotalPiezasDesdePT.ToString("N0")</div></div></div>
            <div class="col-md-2"><div class="metric-card"><div class="metric-label">A producir</div><div class="metric-value">@Model.TotalPiezasAProducir.ToString("N0")</div></div></div>
            <div class="col-md-2"><div class="metric-card"><div class="metric-label">Horas</div><div class="metric-value">@Model.TotalHorasNecesarias.ToString("N2")</div></div></div>
        </div>

        <div class="erp-card">
            <div class="erp-card-header">
                <div>
                    <h2 class="h5 fw-bold m-0 text-primary"><i class="fa-solid fa-file-lines me-2"></i>Encabezado</h2>
                    <div class="text-muted small">Información general del release recibido.</div>
                </div>
            </div>

            <div class="erp-card-body">
                <div class="row g-3">
                    <div class="col-md-3"><div class="erp-label">Folio interno</div><div class="erp-value">@Valor(Model.FolioRelease)</div></div>
                    <div class="col-md-3"><div class="erp-label">Folio cliente / Schedule / Contrato</div><div class="erp-value">@Valor(Model.FolioCliente)</div></div>
                    <div class="col-md-3"><div class="erp-label">Cliente</div><div class="erp-value">@Valor(Model.ClienteNombre)</div></div>
                    <div class="col-md-3"><div class="erp-label">Fecha recepción</div><div class="erp-value">@Model.FechaRecepcion.ToString("dd/MM/yyyy")</div></div>
                    <div class="col-md-3"><div class="erp-label">Semana / versión</div><div class="erp-value">@Valor(Model.VersionRelease)</div></div>
                    <div class="col-md-3"><div class="erp-label">Archivo origen</div><div class="erp-value">@Valor(Model.ArchivoOrigenNombre)</div></div>
                    <div class="col-md-3"><div class="erp-label">Plantilla importación</div><div class="erp-value">@Valor(Model.PlantillaImportacion)</div></div>
                    <div class="col-md-3"><div class="erp-label">Origen</div><div class="erp-value">@TextoImportado(Model.ImportadoDesdeArchivo)</div></div>
                    <div class="col-md-12"><div class="erp-label">Observaciones</div><div class="erp-value">@Valor(Model.Observaciones)</div></div>
                </div>
            </div>
        </div>

        @if (grupos.Any())
        {
            foreach (var grupo in grupos)
            {
                var entregas = grupo
                .OrderBy(x => x.SecuenciaEntrega ?? 9999)
                .ThenBy(x => x.FechaRequerida)
                .ToList();

                var totalReqGrupo = entregas.Sum(x => x.CantidadRequerida);
                var totalPTGrupo = entregas.Sum(x => x.PiezasDesdePT ?? 0);
                var totalProdGrupo = entregas.Sum(x => x.PiezasAProducir ?? 0);
                var totalMPGrupo = entregas.Sum(x => x.MPRequeridaKg ?? 0);
                var totalHorasGrupo = entregas.Sum(x => x.HorasNecesarias ?? 0);

                <div class="renglon-card">
                    <div class="renglon-header">
                        <div>
                            <div class="renglon-title">Renglón @grupo.Key.Renglon · @Valor(grupo.Key.ReferenciaSAP ?? grupo.Key.NumeroParte)</div>
                            <div class="small-muted">@Valor(grupo.Key.DesignacionDescripcionSAP)</div>
                        </div>

                        <div class="d-flex gap-2 flex-wrap">
                            <span class="summary-chip"><i class="fa-solid fa-ruler"></i>UM: @Valor(grupo.Key.UnidadMedidaCliente)</span>
                            <span class="summary-chip"><i class="fa-solid fa-file-contract"></i>Contrato: @Valor(grupo.Key.ContratoCliente)</span>
                            <span class="summary-chip"><i class="fa-solid fa-truck"></i>@entregas.Count entrega(s)</span>
                            <span class="summary-chip"><i class="fa-solid fa-cubes"></i>Req: @totalReqGrupo.ToString("N0")</span>
                            <span class="summary-chip"><i class="fa-solid fa-industry"></i>A producir: @totalProdGrupo.ToString("N0")</span>
                        </div>
                    </div>

                    <div class="renglon-body">
                        <div class="row g-3 mb-3">
                            <div class="col-md-3"><div class="erp-label">No. parte</div><div class="erp-value">@Valor(grupo.Key.NumeroParte)</div></div>
                            <div class="col-md-3"><div class="erp-label">Referencia SAP / cliente</div><div class="erp-value">@Valor(grupo.Key.ReferenciaSAP)</div></div>
                            <div class="col-md-3"><div class="erp-label">Unidad cliente</div><div class="erp-value">@Valor(grupo.Key.UnidadMedidaCliente)</div></div>
                            <div class="col-md-3"><div class="erp-label">Contrato / orden cliente</div><div class="erp-value">@Valor(grupo.Key.ContratoCliente)</div></div>
                            <div class="col-md-12"><div class="erp-label">Designación / descripción</div><div class="erp-value">@Valor(grupo.Key.DesignacionDescripcionSAP)</div></div>
                        </div>

                        <div class="table-responsive">
                            <table class="table table-bordered table-hover align-middle">
                                <thead>
                                    <tr>
                                        <th>Entrega</th>
                                        <th>Fecha carga</th>
                                        <th>Fecha requerida</th>
                                        <th>Req.</th>
                                        <th>PT disp.</th>
                                        <th>Prod. pend.</th>
                                        <th>Desde PT</th>
                                        <th>A producir</th>
                                        <th>MP req.</th>
                                        <th>MP disp.</th>
                                        <th>Emb. req.</th>
                                        <th>Emb. disp.</th>
                                        <th>Horas</th>
                                        <th>Fin estimado</th>
                                        <th>Resultado</th>
                                    </tr>
                                </thead>

                                <tbody>
                                    @for (var i = 0; i < entregas.Count; i++)
                                    {
                                        var d = entregas[i];
                                        var secuencia = d.SecuenciaEntrega ?? (i + 1);

                                        <tr>
                                            <td><strong>@secuencia</strong></td>
                                            <td>@Fecha(d.FechaCarga)</td>
                                            <td>@d.FechaRequerida.ToString("dd/MM/yyyy")</td>
                                            <td>@d.CantidadRequerida.ToString("N0")</td>
                                            <td>@Entero(d.PTDisponibleAlCalcular)</td>
                                            <td>@Entero(d.ProduccionProgramadaPendiente)</td>
                                            <td><strong>@Entero(d.PiezasDesdePT)</strong></td>
                                            <td><strong>@Entero(d.PiezasAProducir)</strong></td>
                                            <td>@Decimal4(d.MPRequeridaKg)</td>
                                            <td>@Decimal4(d.MPDisponibleKg)</td>
                                            <td>@Decimal4(d.EmbalajeRequerido)</td>
                                            <td>@Decimal4(d.EmbalajeDisponible)</td>
                                            <td>@Decimal2(d.HorasNecesarias)</td>
                                            <td>@FechaHora(d.FechaFinEstimada)</td>
                                            <td>
                                                <span class="badge-calc @ClaseTiempo(d.DaTiempo)">@TextoTiempo(d.DaTiempo)</span>
                                                <div class="small-muted mt-1">@Valor(d.MensajeCapacidad)</div>
                                            </td>
                                        </tr>
                                    }
                                </tbody>

                                <tfoot>
                                    <tr class="fw-bold">
                                        <td colspan="3" class="text-end">Totales renglón</td>
                                        <td>@totalReqGrupo.ToString("N0")</td>
                                        <td></td>
                                        <td></td>
                                        <td>@totalPTGrupo.ToString("N0")</td>
                                        <td>@totalProdGrupo.ToString("N0")</td>
                                        <td>@totalMPGrupo.ToString("N4")</td>
                                        <td></td>
                                        <td></td>
                                        <td></td>
                                        <td>@totalHorasGrupo.ToString("N2")</td>
                                        <td colspan="2"></td>
                                    </tr>
                                </tfoot>
                            </table>
                        </div>
                    </div>
                </div>
            }
        }
        else
        {
            <div class="erp-card">
                <div class="erp-card-body text-center text-muted py-5">
                    <i class="fa-solid fa-inbox fa-2x mb-3"></i>
                    <div class="fw-bold">No hay renglones en este release.</div>
                </div>
            </div>
        }

        <div class="sticky-actions">
            <div class="d-flex justify-content-between gap-2 flex-wrap">
                <a asp-controller="PlaneacionRelease" asp-action="Index" class="btn btn-erp-light">
                    <i class="fa-solid fa-arrow-left me-1"></i>
                    Volver a Releases
                </a>

                <div class="d-flex gap-2 flex-wrap">
                    <form asp-controller="PlaneacionRelease" asp-action="Recalcular" method="post">
                        @Html.AntiForgeryToken()
                        <input type="hidden" name="id" value="@Model.ReleaseID" />
                        <button type="submit" class="btn btn-erp-light">
                            <i class="fa-solid fa-rotate me-1"></i>
                            Recalcular
                        </button>
                    </form>

                    <a asp-controller="PlaneacionRelease" asp-action="Calculadora" asp-route-clienteId="@Model.ClienteID" class="btn btn-erp-primary">
                        <i class="fa-solid fa-list-check me-1"></i>
                        Ir a Programa de Planeación
                    </a>
                </div>
            </div>
        </div>
    </div>
</body>
</html>