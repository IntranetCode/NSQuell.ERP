@model ERP.NSQuell.Models.PlaneacionReleaseDetalleVm
@using ERP.NSQuell.Models
@using System.Linq

@{
    Layout = null;

    var detalles = Model.Detalles ?? new List<PlaneacionReleaseDetalleRenglonVm>();

    var grupos = detalles
        .GroupBy(x => new
        {
            x.ReleaseRenglonID,
            x.Renglon,
            x.ParteID,
            x.NumeroParte,
            x.ReferenciaSAP,
            x.DesignacionDescripcionSAP,
            x.UnidadMedidaCliente,
            x.ContratoCliente
        })
        .OrderBy(g => g.Key.Renglon)
        .ToList();

    var totalEntregas = detalles.Count;
    var totalCantidad = detalles.Sum(x => x.CantidadRequerida);
    var totalPartes = grupos.Count;
}

@functions {
    public static string Valor(string valor)
    {
        return string.IsNullOrWhiteSpace(valor) ? "-" : valor;
    }

    public static string Fecha(DateTime? fecha)
    {
        return fecha.HasValue ? fecha.Value.ToString("dd/MM/yyyy") : "-";
    }

    public static string FechaNoNull(DateTime fecha)
    {
        return fecha.ToString("dd/MM/yyyy");
    }

    public static string Entero(int valor)
    {
        return valor.ToString("N0");
    }

    public static string TextoImportado(bool importado)
    {
        return importado ? "Desde archivo" : "Captura manual";
    }
}

