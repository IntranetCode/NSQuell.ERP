                                    <tr class="fw-bold">
                                        <td colspan="3" class="text-end">Total renglón</td>
                                        <td class="text-end">@totalReqGrupo.ToString("N0")</td>
                                        <td>@Valor(grupo.Key.UnidadMedidaCliente)</td>
                                    </tr>
                                </tfoot>
                            </table>
                        </div>
                    </div>
                </section>
            }
        }
        else
        {
            <div class="empty-state">
                <i class="fa-solid fa-inbox fa-3x mb-3"></i>
                <h3 class="fw-bold text-primary">No hay renglones en este release</h3>
                <p class="mb-0">
                    Regresa a la bandeja y valida que el release tenga entregas capturadas.
                </p>
            </div>
        }

        <section class="sticky-actions">
            <div class="d-flex justify-content-between gap-2 flex-wrap">
                <a asp-controller="PlaneacionRelease"
                   asp-action="Index"
                   class="btn btn-erp-light">
                    <i class="fa-solid fa-arrow-left me-1"></i>
                    Volver a Bandeja
                </a>

                <a asp-controller="PlaneacionRelease"
                   asp-action="Crear"
                   class="btn btn-erp-primary">
                    <i class="fa-solid fa-plus me-1"></i>
                    Nuevo release
                </a>
            </div>
        </section>
    </div>
</body>
</html>
