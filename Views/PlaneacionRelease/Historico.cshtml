@model List<ERP.NSQuell.Models.PlaneacionReleaseIndexVm>

@{
    Layout = null;

    var releases =
        Model ??
        new List<ERP.NSQuell.Models.PlaneacionReleaseIndexVm>();

    var grupos = releases
        .GroupBy(x => new
        {
            x.ClienteID,
            ClienteNombre =
                string.IsNullOrWhiteSpace(x.ClienteNombre)
                    ? "Sin cliente"
                    : x.ClienteNombre
        })
        .OrderBy(x => x.Key.ClienteNombre)
        .ToList();

    string Inicial(string? nombre)
    {
        return string.IsNullOrWhiteSpace(nombre)
            ? "?"
            : nombre.Trim()[0]
                .ToString()
                .ToUpperInvariant();
    }

    string Valor(string? value)
    {
        return string.IsNullOrWhiteSpace(value)
            ? "-"
            : value.Replace("GOLDEN", "GOLDE");
    }
}

<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport"
          content="width=device-width, initial-scale=1" />

    <title>Histórico de Releases</title>

    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css"
          rel="stylesheet" />

    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.2/css/all.min.css"
          rel="stylesheet" />

    <style>
        :root {
            --blue:#004aad;
            --blue-dark:#063875;
            --bg:#eef3f9;
            --border:#d8e2ee;
            --muted:#667085;
        }

        * {
            box-sizing:border-box;
        }

        body {
            margin:0;
            min-height:100vh;
            background:
                radial-gradient(circle at top left,rgba(0,74,173,.12),transparent 30%),
                linear-gradient(180deg,#f8fbff,var(--bg));
            color:#1f2937;
            font-family:"Segoe UI",Arial,sans-serif;
        }

        .page {
            max-width:1650px;
            margin:0 auto;
            padding:26px;
        }

        .hero {
            padding:28px 30px;
            border-radius:28px;
            color:white;
            background:
                linear-gradient(135deg,var(--blue),var(--blue-dark));
            box-shadow:
                0 22px 54px rgba(0,74,173,.23);
        }

        .hero h1 {
            margin:0;
            font-size:1.8rem;
            font-weight:950;
        }

        .hero p {
            margin:7px 0 0;
            color:rgba(255,255,255,.84);
        }

        .btn-glass {
            display:inline-flex;
            align-items:center;
            gap:7px;
            padding:10px 14px;
            border:1px solid rgba(255,255,255,.35);
            border-radius:14px;
            background:rgba(255,255,255,.14);
            color:white;
            text-decoration:none;
            font-weight:850;
        }

        .btn-glass:hover {
            background:white;
            color:var(--blue);
        }

        .client {
            margin-top:18px;
            border:1px solid var(--border);
            border-radius:24px;
            background:white;
            box-shadow:
                0 12px 30px rgba(16,24,40,.07);
            overflow:hidden;
        }

        .client-head {
            display:flex;
            justify-content:space-between;
            align-items:center;
            gap:14px;
            padding:18px 20px;
            background:
                linear-gradient(135deg,#fff,#f4f8ff);
        }

        .avatar {
            width:48px;
            height:48px;
            display:flex;
            align-items:center;
            justify-content:center;
            border-radius:17px;
            color:white;
            background:
                linear-gradient(135deg,var(--blue),var(--blue-dark));
            font-weight:950;
        }

        .client-title {
            margin:0;
            color:var(--blue-dark);
            font-size:1.05rem;
            font-weight:950;
        }

        .grid {
            display:grid;
            grid-template-columns:
                repeat(auto-fit,minmax(min(100%,330px),1fr));
            gap:13px;
            padding:18px;
            background:#fbfdff;
        }

        .release {
            min-width:0;
            display:flex;
            flex-direction:column;
            gap:12px;
            padding:16px;
            border:1px solid var(--border);
            border-radius:19px;
            background:white;
        }

        .release h3 {
            margin:0;
            color:var(--blue-dark);
            font-size:1rem;
            font-weight:950;
        }

        .meta {
            display:grid;
            grid-template-columns:
                repeat(2,minmax(0,1fr));
            gap:9px;
        }

        .meta-box {
            min-width:0;
            padding:10px;
            border:1px solid var(--border);
            border-radius:13px;
            background:#fbfdff;
        }

        .meta-label {
            color:var(--muted);
            font-size:.66rem;
            font-weight:900;
            text-transform:uppercase;
        }

        .meta-value {
            overflow-wrap:anywhere;
            font-size:.83rem;
            font-weight:850;
        }

        .btn-detail {
            margin-top:auto;
            display:flex;
            align-items:center;
            justify-content:center;
            gap:6px;
            padding:10px 13px;
            border-radius:13px;
            background:var(--blue);
            color:white;
            text-decoration:none;
            font-weight:850;
        }

        .empty {
            margin-top:18px;
            padding:50px 20px;
            border:1px dashed var(--border);
            border-radius:24px;
            background:white;
            color:var(--muted);
            text-align:center;
        }

        @@media(max-width:700px) {
            .page {
                padding:14px;
            }

            .hero {
                border-radius:22px;
            }

            .meta {
                grid-template-columns:1fr;
            }
        }
    </style>
</head>

<body>
    @* PLANEACION_NAVBAR_INJECT_V1_0 *@
    @await Html.PartialAsync("_PlaneacionNavbar")
<div class="page">
    @* RELEASE_HISTORICO_VIEW_V1_0_1 *@

    <section class="hero">
        <div class="d-flex justify-content-between align-items-start gap-3 flex-wrap">
            <div>
                <div class="small fw-bold text-uppercase opacity-75 mb-2">
                    Planeación / Releases
                </div>

                <h1>
                    <i class="fa-solid fa-clock-rotate-left me-2"></i>
                    Histórico de Releases
                </h1>

                <p>
                    Aquí aparecen automáticamente los Releases cuya última fecha requerida ya terminó.
                </p>
            </div>

            <a asp-controller="PlaneacionRelease"
               asp-action="Index"
               class="btn-glass">
                <i class="fa-solid fa-arrow-left"></i>
                Volver a la bandeja
            </a>
        </div>
    </section>

    @if (!grupos.Any())
    {
        <div class="empty">
            <i class="fa-regular fa-folder-open fa-2x mb-3"></i>

            <h2 class="h5 fw-bold text-primary">
                No hay Releases históricos
            </h2>

            <p class="mb-0">
                Los Releases se moverán aquí al día siguiente de su última fecha requerida.
            </p>
        </div>
    }
    else
    {
        foreach (var grupo in grupos)
        {
            var clienteReleases = grupo
                .OrderByDescending(
                    x => x.UltimaFechaRequerida)
                .ThenByDescending(
                    x => x.FechaCreacion)
                .ToList();

            <section class="client">
                <div class="client-head">
                    <div class="d-flex align-items-center gap-3">
                        <div class="avatar">
                            @Inicial(grupo.Key.ClienteNombre)
                        </div>

                        <div>
                            <h2 class="client-title">
                                @grupo.Key.ClienteNombre
                            </h2>

                            <div class="small text-muted fw-semibold">
                                @clienteReleases.Count histórico@(clienteReleases.Count == 1 ? "" : "s")
                            </div>
                        </div>
                    </div>

                    <span class="badge rounded-pill text-bg-light border">
                        @clienteReleases.Count
                    </span>
                </div>

                <div class="grid">
                    @foreach (var item in clienteReleases)
                    {
                        <article class="release">
                            <div>
                                <h3>
                                    @(item.FolioRelease ?? "-")
                                </h3>

                                <div class="small text-muted fw-semibold">
                                    Folio cliente:
                                    @(item.FolioCliente ?? "-")
                                    · ID @item.ReleaseID
                                </div>
                            </div>

                            <div class="meta">
                                <div class="meta-box">
                                    <div class="meta-label">
                                        Recepción
                                    </div>

                                    <div class="meta-value">
                                        @item.FechaRecepcion.ToString("dd/MM/yyyy")
                                    </div>
                                </div>

                                <div class="meta-box">
                                    <div class="meta-label">
                                        Última fecha requerida
                                    </div>

                                    <div class="meta-value">
                                        @(item.UltimaFechaRequerida?.ToString("dd/MM/yyyy") ?? "-")
                                    </div>
                                </div>

                                <div class="meta-box">
                                    <div class="meta-label">
                                        Plantilla
                                    </div>

                                    <div class="meta-value">
                                        @Valor(item.PlantillaImportacion)
                                    </div>
                                </div>

                                <div class="meta-box">
                                    <div class="meta-label">
                                        Entregas
                                    </div>

                                    <div class="meta-value">
                                        @item.TotalEntregas.ToString("N0")
                                    </div>
                                </div>
                            </div>

                            @if (!string.IsNullOrWhiteSpace(
                                item.ArchivoOrigenNombre))
                            {
                                <div class="small text-muted fw-semibold">
                                    <i class="fa-regular fa-file-lines me-1"></i>
                                    @item.ArchivoOrigenNombre
                                </div>
                            }

                            <a asp-controller="PlaneacionRelease"
                               asp-action="Detalle"
                               asp-route-id="@item.ReleaseID"
                               class="btn-detail">
                                <i class="fa-solid fa-eye"></i>
                                Ver detalle
                            </a>
                        </article>
                    }
                </div>
            </section>
        }
    }
</div>
</body>
</html>