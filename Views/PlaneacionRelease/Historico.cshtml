@model List<ERP.NSQuell.Models.PlaneacionReleaseIndexVm>

@{
    Layout = "~/Views/Shared/_Layout.cshtml";
    ViewData["Title"] = "Histórico de Releases";

    var releases =
        Model ??
        new List<ERP.NSQuell.Models.PlaneacionReleaseIndexVm>();

    var grupos = releases
        .GroupBy(x => new
        {
            x.ClienteID,
            ClienteNombre =
                string.IsNullOrWhiteSpace(x.ClienteNombre)
                    ? "Sin cliente"
                    : x.ClienteNombre
        })
        .OrderBy(x => x.Key.ClienteNombre)
        .ToList();

    string Inicial(string? nombre)
    {
        return string.IsNullOrWhiteSpace(nombre)
            ? "?"
            : nombre.Trim()[0]
                .ToString()
                .ToUpperInvariant();
    }

    string Valor(string? value)
    {
        return string.IsNullOrWhiteSpace(value)
            ? "-"
            : value.Replace("GOLDEN", "GOLDE");
    }
}

@section Styles {
    <link rel="stylesheet" href="~/css/PlaneacionRelease/historico.css" asp-append-version="true" />
}


@* PLANEACION_NAVBAR_INJECT_V1_0 *@
    @await Html.PartialAsync("_PlaneacionNavbar")
<div class="page">
    @* RELEASE_HISTORICO_VIEW_V1_0_1 *@

    <section class="hero">
        <div class="d-flex justify-content-between align-items-start gap-3 flex-wrap">
            <div>
                <div class="small fw-bold text-uppercase opacity-75 mb-2">
                    Planeación / Releases
                </div>

                <h1>
                    <i class="fa-solid fa-clock-rotate-left me-2"></i>
                    Histórico de Releases
                </h1>

                <p>
                    Aquí aparecen automáticamente los Releases cuya última fecha requerida ya terminó.
                </p>
            </div>

            <a asp-controller="PlaneacionRelease"
               asp-action="Index"
               class="btn-glass">
                <i class="fa-solid fa-arrow-left"></i>
                Volver a la bandeja
            </a>
        </div>
    </section>

    @if (!grupos.Any())
    {
        <div class="empty">
            <i class="fa-regular fa-folder-open fa-2x mb-3"></i>

            <h2 class="h5 fw-bold text-primary">
                No hay Releases históricos
            </h2>

            <p class="mb-0">
                Los Releases se moverán aquí al día siguiente de su última fecha requerida.
            </p>
        </div>
    }
    else
    {
        foreach (var grupo in grupos)
        {
            var clienteReleases = grupo
                .OrderByDescending(
                    x => x.UltimaFechaRequerida)
                .ThenByDescending(
                    x => x.FechaCreacion)
                .ToList();

            <section class="client">
                <div class="client-head">
                    <div class="d-flex align-items-center gap-3">
                        <div class="avatar">
                            @Inicial(grupo.Key.ClienteNombre)
                        </div>

                        <div>
                            <h2 class="client-title">
                                @grupo.Key.ClienteNombre
                            </h2>

                            <div class="small text-muted fw-semibold">
                                @clienteReleases.Count histórico@(clienteReleases.Count == 1 ? "" : "s")
                            </div>
                        </div>
                    </div>

                    <span class="badge rounded-pill text-bg-light border">
                        @clienteReleases.Count
                    </span>
                </div>

                <div class="grid">
                    @foreach (var item in clienteReleases)
                    {
                        <article class="release">
                            <div>
                                <h3>
                                    @(item.FolioRelease ?? "-")
                                </h3>

                                <div class="small text-muted fw-semibold">
                                    Folio cliente:
                                    @(item.FolioCliente ?? "-")
                                    · ID @item.ReleaseID
                                </div>
                            </div>

                            <div class="meta">
                                <div class="meta-box">
                                    <div class="meta-label">
                                        Recepción
                                    </div>

                                    <div class="meta-value">
                                        @item.FechaRecepcion.ToString("dd/MM/yyyy")
                                    </div>
                                </div>

                                <div class="meta-box">
                                    <div class="meta-label">
                                        Última fecha requerida
                                    </div>

                                    <div class="meta-value">
                                        @(item.UltimaFechaRequerida?.ToString("dd/MM/yyyy") ?? "-")
                                    </div>
                                </div>

                                <div class="meta-box">
                                    <div class="meta-label">
                                        Plantilla
                                    </div>

                                    <div class="meta-value">
                                        @Valor(item.PlantillaImportacion)
                                    </div>
                                </div>

                                <div class="meta-box">
                                    <div class="meta-label">
                                        Entregas
                                    </div>

                                    <div class="meta-value">
                                        @item.TotalEntregas.ToString("N0")
                                    </div>
                                </div>
                            </div>

                            @if (!string.IsNullOrWhiteSpace(
                                item.ArchivoOrigenNombre))
                            {
                                <div class="small text-muted fw-semibold">
                                    <i class="fa-regular fa-file-lines me-1"></i>
                                    @item.ArchivoOrigenNombre
                                </div>
                            }

                            <a asp-controller="PlaneacionRelease"
                               asp-action="Detalle"
                               asp-route-id="@item.ReleaseID"
                               class="btn-detail">
                                <i class="fa-solid fa-eye"></i>
                                Ver detalle
                            </a>
                        </article>
                    }
                </div>
            </section>
        }
    }
</div>
