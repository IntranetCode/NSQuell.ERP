@model ERP.NSQuell.Models.PlaneacionNecesidadFiltroVm

@{
    Layout = "~/Views/Shared/_Layout.cshtml";
    ViewData["Title"] = "Programa de Planeación | Planeación";

    string Valor(string? valor) => string.IsNullOrWhiteSpace(valor) ? "-" : valor;
    string Entero(int? valor) => valor.HasValue ? valor.Value.ToString("N0") : "-";
    string Decimal2(decimal? valor) => valor.HasValue ? valor.Value.ToString("N2") : "-";
    string Decimal4(decimal? valor) => valor.HasValue ? valor.Value.ToString("N4") : "-";
    string Fecha(DateTime? fecha) => fecha.HasValue ? fecha.Value.ToString("dd/MM/yyyy") : "-";
    string FechaHora(DateTime? fecha) => fecha.HasValue ? fecha.Value.ToString("dd/MM/yyyy HH:mm") : "-";

    string ClaseResultado(bool? daTiempo)
    {
        if (daTiempo == true) return "badge-ok";
        if (daTiempo == false) return "badge-no";
        return "badge-warn";
    }

    string TextoResultado(bool? daTiempo)
    {
        if (daTiempo == true) return "Sí da tiempo";
        if (daTiempo == false) return "No da tiempo";
        return "Sin validar";
    }


}

@section Scripts {
    <script>
        const urlPartesPorCliente = '@Url.Action("ObtenerPartesPorCliente", "PlaneacionRelease")';

        const clienteFiltro = document.getElementById('clienteIdFiltro');
        const parteFiltro = document.getElementById('parteIdFiltro');

        clienteFiltro?.addEventListener('change', async function () {
            const clienteId = this.value;

            if (!parteFiltro) return;

            parteFiltro.innerHTML = '<option value="">Todas</option>';

            if (!clienteId) {
                return;
            }

            try {
                const resp = await fetch(`${urlPartesPorCliente}?clienteId=${encodeURIComponent(clienteId)}`);
                const data = await resp.json();

                if (!data.ok) {
                    alert(data.mensaje || 'No se pudieron cargar las partes del cliente.');
                    return;
                }

                const partes = data.partes || [];

                partes.forEach(function (p) {
                    const opt = document.createElement('option');
                    opt.value = p.value;
                    opt.textContent = p.text;
                    parteFiltro.appendChild(opt);
                });

            } catch (err) {
                console.error(err);
                alert('No se pudieron cargar las partes del cliente.');
            }
        });
    </script>
}


@section Styles {
    <link rel="stylesheet" href="~/css/PlaneacionRelease/calculadora.css" asp-append-version="true" />
}


@* PLANEACION_NAVBAR_INJECT_V1_0 *@
    @await Html.PartialAsync("_PlaneacionNavbar")
    <div class="erp-shell">

        <div class="erp-header">
            <div class="d-flex justify-content-between align-items-start gap-3 flex-wrap">
                <div>
                    <h1>
                        <i class="fa-solid fa-clipboard-list me-2"></i>
                        Programa de Planeación
                    </h1>
                    <p>
                        Vista global de demanda del cliente contra PT disponible, producción programada, MP, embalaje y horas necesarias antes de enviarla a Cambio de Molde.
                    </p>
                </div>

                <div class="d-flex gap-2 flex-wrap">
                    <a asp-controller="PlaneacionRelease" asp-action="Index" class="btn btn-light fw-bold rounded-3">
                        <i class="fa-solid fa-arrow-left me-1"></i>
                        Releases
                    </a>

                    <a asp-controller="PlaneacionRelease" asp-action="Crear" class="btn btn-light fw-bold rounded-3">
                        <i class="fa-solid fa-plus me-1"></i>
                        Nuevo Release
                    </a>
                    @*
                    <a asp-controller="PlaneacionPanorama"
                       asp-action="Index"
                       class="btn btn-light fw-bold rounded-3">
                        <i class="fa-solid fa-chart-line me-1"></i>
                        Panorama
                    </a>*@
                </div>
            </div>
        </div>

        <div class="row g-3 mb-3">
            <div class="col-md-2">
                <div class="metric-card">
                    <div class="metric-label">Renglones</div>
                    <div class="metric-value">@Model.TotalRenglones</div>
                </div>
            </div>

            <div class="col-md-2">
                <div class="metric-card">
                    <div class="metric-label">Piezas requeridas</div>
                    <div class="metric-value">@Model.TotalRequerido.ToString("N0")</div>
                </div>
            </div>

            <div class="col-md-2">
                <div class="metric-card">
                    <div class="metric-label">Desde PT</div>
                    <div class="metric-value">@Model.TotalDesdePT.ToString("N0")</div>
                </div>
            </div>

            <div class="col-md-2">
                <div class="metric-card">
                    <div class="metric-label">A producir</div>
                    <div class="metric-value">@Model.TotalAProducir.ToString("N0")</div>
                </div>
            </div>

            <div class="col-md-2">
                <div class="metric-card">
                    <div class="metric-label">MP requerida kg</div>
                    <div class="metric-value">@Model.TotalMPRequerida.ToString("N4")</div>
                </div>
            </div>

            <div class="col-md-2">
                <div class="metric-card">
                    <div class="metric-label">Horas necesarias</div>
                    <div class="metric-value">@Model.TotalHoras.ToString("N2")</div>
                </div>
            </div>
        </div>

        <div class="row g-3 mb-3">
            @foreach (var p in Model.ResumenPeriodos)
            {
                <div class="col-md-3">
                    <div class="metric-card">
                        <div class="metric-label">@p.Periodo</div>
                        <div class="metric-value">@p.PiezasAProducir.ToString("N0")</div>

                        <div class="small-muted mt-2">
                            <div>
                                Req:
                                <strong>@p.CantidadRequerida.ToString("N0")</strong>
                            </div>

                            <div>
                                Desde PT:
                                <strong>@p.PiezasDesdePT.ToString("N0")</strong>
                            </div>

                            <div>
                                Programado:
                                <strong>@p.ProduccionProgramadaPendiente.ToString("N0")</strong>
                            </div>

                            <div>
                                Horas:
                                <strong>@p.HorasNecesarias.ToString("N2")</strong>
                            </div>
                        </div>
                    </div>
                </div>
            }
        </div>

        <div class="erp-card">
            <div class="erp-card-header">
                <div>
                    <h2 class="h5 fw-bold m-0 text-primary">
                        <i class="fa-solid fa-filter me-2"></i>
                        Filtros
                    </h2>
                    <div class="text-muted small">
                        Filtra por cliente, parte, rango de fechas o alertas.
                    </div>
                </div>
            </div>

            <div class="erp-card-body">
                <form asp-controller="PlaneacionRelease" asp-action="Calculadora" method="get">
                    <div class="row g-3 align-items-end">
                        <div class="col-md-3">
                            <label class="erp-label">Cliente</label>
                            <select name="clienteId" id="clienteIdFiltro" class="form-select erp-select">
                                <option value="">Todos</option>
                                @foreach (var c in Model.Clientes)
                                {
                                    <option value="@c.Value" selected="@(Model.ClienteID?.ToString() == c.Value)">
                                        @c.Text
                                    </option>
                                }
                            </select>
                        </div>

                        <div class="col-md-3">
                            <label class="erp-label">Parte</label>
                            <select name="parteId" id="parteIdFiltro" class="form-select erp-select">
                                <option value="">Todas</option>
                                @foreach (var p in Model.Partes)
                                {
                                    <option value="@p.Value" selected="@(Model.ParteID?.ToString() == p.Value)">
                                        @p.Text
                                    </option>
                                }
                            </select>
                        </div>

                        <div class="col-md-2">
                            <label class="erp-label">Desde</label>
                            <input name="fechaDesde"
                                   type="date"
                                   value="@(Model.FechaDesde?.ToString("yyyy-MM-dd"))"
                                   class="form-control erp-input" />
                        </div>

                        <div class="col-md-2">
                            <label class="erp-label">Hasta</label>
                            <input name="fechaHasta"
                                   type="date"
                                   value="@(Model.FechaHasta?.ToString("yyyy-MM-dd"))"
                                   class="form-control erp-input" />
                        </div>

                        <div class="col-md-2">
                            <button type="submit" class="btn btn-erp-primary w-100">
                                <i class="fa-solid fa-magnifying-glass me-1"></i>
                                Filtrar
                            </button>
                        </div>

                        <div class="col-md-12">
                            <div class="d-flex gap-3 flex-wrap">
                                <div class="form-check">
                                    <input type="hidden" name="soloPendientes" value="false" />

                                    <input class="form-check-input"
                                           type="checkbox"
                                           name="soloPendientes"
                                           value="true"
                                           id="soloPendientes"
                                           checked="@Model.SoloPendientes" />
                                    <label class="form-check-label fw-semibold" for="soloPendientes">
                                        Solo pendientes por producir
                                    </label>
                                </div>

                                <div class="form-check">
                                    <input type="hidden" name="soloSinCapacidad" value="false" />

                                    <input class="form-check-input"
                                           type="checkbox"
                                           name="soloSinCapacidad"
                                           value="true"
                                           id="soloSinCapacidad"
                                           checked="@Model.SoloSinCapacidad" />
                                    <label class="form-check-label fw-semibold" for="soloSinCapacidad">
                                        Solo sin capacidad
                                    </label>
                                </div>

                                <div class="form-check">
                                    <input type="hidden" name="soloSinMP" value="false" />

                                    <input class="form-check-input"
                                           type="checkbox"
                                           name="soloSinMP"
                                           value="true"
                                           id="soloSinMP"
                                           checked="@Model.SoloSinMP" />
                                    <label class="form-check-label fw-semibold" for="soloSinMP">
                                        Solo sin MP suficiente
                                    </label>
                                </div>

                                <a asp-controller="PlaneacionRelease" asp-action="Calculadora" class="btn btn-sm btn-erp-light">
                                    Limpiar filtros
                                </a>
                            </div>
                        </div>
                    </div>
                </form>
            </div>
        </div>

        <div class="erp-card">
            <div class="erp-card-header">
                <div>
                    <h2 class="h5 fw-bold m-0 text-primary">
                        <i class="fa-solid fa-table-list me-2"></i>
                        Programa de Planeación
                    </h2>
                    <div class="text-muted small">
                        Demanda lista para revisar y enviar a Cambio de Molde.
                    </div>
                </div>
            </div>

            <div class="erp-card-body">
                @if (Model.Necesidades != null && Model.Necesidades.Any())
                {
                    <div class="table-responsive">
                        <table class="table table-bordered table-hover align-middle">
                            <thead>
                                <tr>
                                    <th>Release</th>
                                    <th>Cliente</th>
                                    <th>Parte</th>
                                    <th>Fecha req.</th>
                                    <th>Req.</th>
                                    <th>PT</th>
                                    <th>Prog.</th>
                                    <th>Desde PT</th>
                                    <th>A producir</th>
                                    <th>MP req.</th>
                                    <th>MP disp.</th>
                                    <th>Emb. req.</th>
                                    <th>Emb. disp.</th>
                                    <th>Horas</th>
                                    <th>Validación inicial</th>
                                    <th>Acción</th>
                                </tr>
                            </thead>

                            <tbody>
                                @foreach (var n in Model.Necesidades)
                                {
                                    <tr>
                                        <td>
                                            <strong>@Valor(n.FolioRelease)</strong>
                                            <div class="small-muted">Ren. @n.Renglon</div>
                                        </td>

                                        <td>@Valor(n.ClienteNombre)</td>

                                        <td>
                                            <strong>@Valor(n.ReferenciaSAP ?? n.NumeroParte)</strong><br />
                                            <span class="small-muted">@Valor(n.DesignacionDescripcionSAP)</span>
                                        </td>

                                        <td>@n.FechaRequerida.ToString("dd/MM/yyyy")</td>
                                        <td>@n.CantidadRequerida.ToString("N0")</td>
                                        <td>@Entero(n.PTDisponibleAlCalcular)</td>
                                        <td>@Entero(n.ProduccionProgramadaPendiente)</td>

                                        <td>
                                            <strong>@Entero(n.PiezasDesdePT)</strong>
                                        </td>

                                        <td>
                                            <strong>@Entero(n.PiezasAProducir)</strong>
                                        </td>

                                        <td>@Decimal4(n.MPRequeridaKg)</td>

                                        <td>
                                            @Decimal4(n.MPDisponibleKg)

                                            @if (n.TieneMPInsuficiente)
                                            {
                                                <div class="mt-1">
                                                    <span class="badge-mp">
                                                        MP insuficiente
                                                    </span>
                                                </div>
                                            }
                                        </td>

                                        <td>@Decimal4(n.EmbalajeRequerido)</td>

                                        <td>
                                            @Decimal4(n.EmbalajeDisponible)

                                            @if (n.TieneEmbalajeInsuficiente)
                                            {
                                                <div class="mt-1">
                                                    <span class="badge-mp">
                                                        Emb. insuf.
                                                    </span>
                                                </div>
                                            }
                                        </td>

                                        <td>@Decimal2(n.HorasNecesarias)</td>

                                        <td>
                                            <span class="badge-calc @ClaseResultado(n.DaTiempo)">
                                                @TextoResultado(n.DaTiempo)
                                            </span>
                                            <div class="small-muted mt-1">
                                                @Valor(n.MensajeCapacidad)
                                            </div>
                                        </td>

                                        <td>
                                            <div class="d-flex flex-column gap-2">
                                                <a asp-controller="PlaneacionRelease"
                                                   asp-action="Detalle"
                                                   asp-route-id="@n.ReleaseID"
                                                   class="btn btn-sm btn-erp-light">
                                                    <i class="fa-solid fa-eye me-1"></i>
                                                    Ver Release
                                                </a>

                                                @if ((n.PiezasAProducir ?? 0) > 0 && !n.YaProgramado)
                                                {
                                                    <a asp-controller="PlaneacionPrograma"
                                                       asp-action="CrearDesdeNecesidad"
                                                       asp-route-releaseDetalleId="@n.ReleaseDetalleID"
                                                       class="btn btn-sm btn-erp-primary">
                                                        <i class="fa-solid fa-right-long me-1"></i>
                                                        Enviar a Cambio de Molde
                                                    </a>
                                                }
                                                else if (n.YaProgramado)
                                                {
                                                    <a asp-controller="PlaneacionPrograma"
                                                       asp-action="Maquinas"
                                                       class="btn btn-sm btn-success rounded-3 fw-bold">
                                                        <i class="fa-solid fa-circle-check me-1"></i>
                                                        Ya programado
                                                    </a>
                                                }
                                                else
                                                {
                                                    <span class="badge-calc badge-ok">
                                                        Cubierto con PT
                                                    </span>
                                                }
                                            </div>
                                        </td>
                                    </tr>
                                }
                            </tbody>

                            <tfoot>
                                <tr class="fw-bold">
                                    <td colspan="4" class="text-end">Totales</td>
                                    <td>@Model.TotalRequerido.ToString("N0")</td>
                                    <td></td>
                                    <td></td>
                                    <td>@Model.TotalDesdePT.ToString("N0")</td>
                                    <td>@Model.TotalAProducir.ToString("N0")</td>
                                    <td>@Model.TotalMPRequerida.ToString("N4")</td>
                                    <td></td>
                                    <td></td>
                                    <td></td>
                                    <td>@Model.TotalHoras.ToString("N2")</td>
                                    <td colspan="2"></td>
                                </tr>
                            </tfoot>
                        </table>
                    </div>
                }
                else
                {
                    <div class="empty-state">
                        <i class="fa-solid fa-clipboard-list"></i>
                        <div class="fw-bold">No hay necesidades de planeación con los filtros seleccionados.</div>
                        <div class="small">Captura un Release o limpia los filtros.</div>
                    </div>
                }
            </div>
        </div>

        <div class="sticky-actions">
            <div class="d-flex justify-content-between gap-2 flex-wrap">
                <a asp-controller="PlaneacionRelease" asp-action="Index" class="btn btn-erp-light">
                    <i class="fa-solid fa-arrow-left me-1"></i>
                    Volver a Releases
                </a>

                <div class="d-flex gap-2 flex-wrap">
                    <a asp-controller="PlaneacionPrograma"
                       asp-action="Maquinas"
                       class="btn btn-erp-primary">
                        <i class="fa-solid fa-industry me-1"></i>
                        Ver programa
                    </a>
                </div>
            </div>
        </div>

    </div>
