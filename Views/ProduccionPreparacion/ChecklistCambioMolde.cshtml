@model ERP.NSQuell.Models.ProduccionChecklistVm
@using ERP.NSQuell.Models
@using System.Globalization

@{
    Layout = "_Layout";

    var preparacionAnticipadaID = ViewBag.PreparacionAnticipadaID != null ? Convert.ToInt32(ViewBag.PreparacionAnticipadaID) : 0;
    var puedeGestionar = ViewBag.PuedeGestionarCambioMolde != null && Convert.ToBoolean(ViewBag.PuedeGestionarCambioMolde);
    var estadoCambioMolde = Convert.ToString(ViewBag.EstadoCambioMolde) ?? "";
    var fechaInicioCambioMolde = ViewBag.FechaInicioCambioMolde as DateTime?;
    var limiteCambioMoldeMinutos = ViewBag.LimiteCambioMoldeMinutos != null ? Convert.ToInt32(ViewBag.LimiteCambioMoldeMinutos) : 0;
    var esParejaLhRh = ViewBag.EsParejaLhRh != null && Convert.ToBoolean(ViewBag.EsParejaLhRh);
    var grupoLhRh = ViewBag.GrupoLhRh != null ? Convert.ToInt32(ViewBag.GrupoLhRh) : (int?)null;
    var puedeEditar = puedeGestionar && !Model.EstaCompleto;
    var cambioEnProceso = string.Equals(estadoCambioMolde, ProduccionPreparacionEstado.EnProceso, StringComparison.OrdinalIgnoreCase);
    var cambioConfirmado = string.Equals(estadoCambioMolde, ProduccionPreparacionEstado.Confirmada, StringComparison.OrdinalIgnoreCase);
    var totalPreguntas = Model.TotalPreguntas;
    var respondidas = Model.RespuestasContestadas;
    var porcentaje = Model.PorcentajeAvance;
    var secciones = Model.Secciones.OrderBy(x => x.OrdenSeccion).ToList();
}

@functions {
    public static string Txt(string? valor)
    {
        return string.IsNullOrWhiteSpace(valor) ? "—" : valor.Trim();
    }

    public static string ResultadoNormalizado(string? valor)
    {
        var r = (valor ?? "").Trim().ToUpperInvariant();
        if (r == "N/A") return "NA";
        if (r == "SI" || r == "SÍ") return "OK";
        if (r == "NO") return "NOK";
        return r;
    }

    public static string LadoTexto(string? lado)
    {
        if (string.Equals(lado, "LH", StringComparison.OrdinalIgnoreCase)) return "LH";
        if (string.Equals(lado, "RH", StringComparison.OrdinalIgnoreCase)) return "RH";
        return "OF";
    }
}

