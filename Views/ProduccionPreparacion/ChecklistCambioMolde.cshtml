<div class="cm-page">
    <section class="cm-hero">
        <div class="cm-hero-top">
            <div>
                <div class="cm-kicker">A1 · Actividad obligatoria de preparación</div>
                <h1 class="cm-title">Check List Desmontaje y Montaje de Molde</h1>
                <div class="cm-subtitle">@Txt(Model.CodigoFormato) · @Txt(Model.VersionFormato) · Preparación antes y durante el cambio físico de molde</div>
            </div>
            <a class="cm-back" asp-controller="ProduccionPreparacion" asp-action="Index">
                <i class="bi bi-arrow-left"></i>
                Volver a preparación
            </a>
        </div>
    </section>

    @if (TempData["Error"] != null)
    {
        <div class="cm-alert warning">
            <i class="bi bi-exclamation-triangle-fill"></i>
            <div>@TempData["Error"]</div>
        </div>
    }

    @if (Model.EstaCompleto)
    {
        <div class="cm-alert success">
            <i class="bi bi-check-circle-fill"></i>
            <div>El checklist está completo. Sus respuestas quedaron bloqueadas para edición y el cambio de molde ya puede finalizarse.</div>
        </div>
    }
    else if (!cambioEnProceso)
    {
        <div class="cm-alert info">
            <i class="bi bi-info-circle-fill"></i>
            <div>Puedes comenzar la sección de preparación previa. Las secciones de desmontaje y montaje corresponden al trabajo físico del cambio de molde.</div>
        </div>
    }

    <div class="cm-layout">
        <aside class="cm-sidebar">
            <section class="cm-card">
                <div class="cm-card-head">
                    <span><i class="bi bi-info-circle me-1"></i>Datos de la operación</span>
                    <span class="cm-status change">@Txt(estadoCambioMolde)</span>
                </div>
                <div class="cm-card-body">
                    <div class="cm-data">
                        <div class="cm-data-k">Máquina</div>
                        <div class="cm-data-v">@Txt(Model.MaquinaCodigo)<div class="text-muted small">@Txt(Model.MaquinaNombre)</div></div>
                    </div>
                    <div class="cm-data">
                        <div class="cm-data-k">Molde</div>
                        <div class="cm-data-v">@Txt(Model.MoldeCodigo)</div>
                    </div>
                    <div class="cm-data">
                        <div class="cm-data-k">Formato</div>
                        <div class="cm-data-v">@Txt(Model.CodigoFormato) · @Txt(Model.VersionFormato)</div>
                    </div>
                    <div class="cm-data">
                        <div class="cm-data-k">Checklist</div>
                        <div class="cm-data-v">#@Model.ChecklistArranqueID</div>
                    </div>
                    <div class="cm-data">
                        <div class="cm-data-k">Inicio cambio</div>
                        <div class="cm-data-v">@(fechaInicioCambioMolde.HasValue? fechaInicioCambioMolde.Value.ToString("dd/MM/yyyy HH:mm") : "Pendiente")</div>
                    </div>
                    <div class="cm-data">
                        <div class="cm-data-k">Límite</div>
                        <div class="cm-data-v">@(limiteCambioMoldeMinutos > 0 ? limiteCambioMoldeMinutos + " min" : "—")</div>
                    </div>
                </div>
            </section>

            @if (Model.Programas.Any())
            {
                <section class="cm-card">
                    <div class="cm-card-head">
                        <span><i class="bi bi-diagram-3 me-1"></i>@(esParejaLhRh ? "Operación LH/RH" : "Orden de fabricación")</span>
                    </div>
                    <div class="cm-card-body">
                        @if (esParejaLhRh)
                        {
                            <div class="cm-pair">
                                <div class="cm-pair-title">
                                    <i class="bi bi-link-45deg"></i>
                                    Checklist físico único
                                    @if (grupoLhRh.HasValue)
                                    {
                                        <span>· Grupo @grupoLhRh</span>
                                    }
                                </div>
                                <div class="small text-muted">Las dos OF comparten este checklist porque corresponden al mismo cambio físico de molde.</div>
                            </div>
                        }

                        @foreach (var programa in Model.Programas.OrderByDescending(x => x.EsPrincipal).ThenBy(x => x.ProgramaProduccionID))
                        {
                            <div class="cm-program">
                                <div class="cm-side">@LadoTexto(programa.LadoLhRh)</div>
                                <div>
                                    <div class="cm-of">@Txt(programa.NumeroOF)</div>
                                    <div class="cm-part">@Txt(programa.ReferenciaSAP) · @Txt(programa.NumeroParte)</div>
                                </div>
                            </div>
                        }
                    </div>
                </section>
            }

            <section class="cm-card">
                <div class="cm-card-head">
                    <span><i class="bi bi-graph-up-arrow me-1"></i>Avance general</span>
                </div>
                <div class="cm-card-body">
                    <div class="cm-progress-top">
                        <div class="cm-progress-value" id="porcentajeGeneral">@porcentaje%</div>
                        <div class="cm-progress-text">
                            <span id="respuestasGeneral">@respondidas</span> de
                            <span id="preguntasGeneral">@totalPreguntas</span><br />
                            respuestas
                        </div>
                    </div>
                    <div class="cm-progress">
                        <div class="cm-progress-bar" id="barraGeneral" style="width:@porcentaje%"></div>
                    </div>
                    <div class="mt-3">
                        <span id="estadoChecklist" class="cm-status @(Model.EstaCompleto ? "complete" : Model.EstaEnProceso ? "process" : "pending")">
                            <i class="bi @(Model.EstaCompleto ? "bi-check-circle" : Model.EstaEnProceso ? "bi-hourglass-split" : "bi-clock")"></i>
                            @Model.EstadoFlujo
                        </span>
                    </div>
                </div>
            </section>
        </aside>

        <main>
            <form id="tokenForm" class="d-none">
                @Html.AntiForgeryToken()
            </form>

            @if (!secciones.Any())
            {
                <div class="cm-alert warning">
                    <i class="bi bi-exclamation-triangle-fill"></i>
                    <div>No se encontraron preguntas activas para @Model.CodigoFormato @Model.VersionFormato.</div>
                </div>
            }

            @foreach (var seccion in secciones)
            {
                var preguntas = seccion.Preguntas.Where(x => x.Activo).OrderBy(x => x.OrdenPregunta).ThenBy(x => x.PreguntaID).ToList();
                var respuestasSeccion = preguntas.Count(x => x.EstaRespondida);
                var seccionCompleta = seccion.EstaCompleta;

                <section class="cm-section" data-section="@seccion.OrdenSeccion">
                    <div class="cm-section-head">
                        <div>
                            <div class="cm-section-title">
                                <span class="cm-section-index">@seccion.OrdenSeccion</span>
                                @seccion.Seccion
                            </div>
                            <div class="cm-section-sub">
                                @if (!string.IsNullOrWhiteSpace(seccion.ResponsableSugerido))
                                {
                                    <span>Responsable sugerido: @seccion.ResponsableSugerido · </span>
                                }
                                <span>@preguntas.Count punto(s) de verificación</span>
                            </div>
                        </div>
                        <div class="cm-section-state">
                            <span class="cm-section-count">
                                <i class="bi bi-list-check"></i>
                                <span class="section-counter">@respuestasSeccion / @preguntas.Count</span>
                            </span>
                            <span class="cm-status section-status @(seccionCompleta ? "complete" : respuestasSeccion > 0 ? "process" : "pending")">
                                @(seccionCompleta ? "COMPLETA" : respuestasSeccion > 0 ? "EN PROCESO" : "PENDIENTE")
                            </span>
                        </div>
                    </div>

                    <div class="cm-section-questions">
                        @foreach (var pregunta in preguntas)
                        {
                            var resultado = ResultadoNormalizado(pregunta.Resultado);
                            var esOk = resultado == "OK";
                            var esNok = resultado == "NOK";
                            var esNa = resultado == "NA";

                            <div class="cm-question" data-question="@pregunta.PreguntaID" data-required="@(pregunta.EsObligatoria.ToString().ToLowerInvariant())" data-permite-na="@(pregunta.PermiteNA.ToString().ToLowerInvariant())" data-requiere-nok="@(pregunta.RequiereObservacionSiNOK.ToString().ToLowerInvariant())" data-requiere-na="@(pregunta.RequiereObservacionSiNA.ToString().ToLowerInvariant())">
                                <div>
                                    <div class="cm-number">@pregunta.OrdenPregunta</div>
                                </div>
                                <div>
                                    <div class="cm-question-text">@pregunta.TextoPregunta</div>
                                    <div class="cm-question-meta">
                                        @if (pregunta.EsObligatoria)
                                        {
                                            <span class="cm-meta required"><i class="bi bi-asterisk"></i>Obligatoria</span>
                                        }
                                        @if (pregunta.PermiteNA)
                                        {
                                            <span class="cm-meta"><i class="bi bi-dash-circle"></i>Permite N/A</span>
                                        }
                                        @if (!string.IsNullOrWhiteSpace(pregunta.ResponsableSugerido))
                                        {
                                            <span class="cm-meta"><i class="bi bi-person"></i>@pregunta.ResponsableSugerido</span>
                                        }
                                    </div>
                                </div>
                                <div class="cm-answer">
                                    <input type="hidden" class="question-id" value="@pregunta.PreguntaID" />

                                    <div class="cm-options">
                                        <div class="cm-option ok">
                                            <input type="radio" id="ok_@pregunta.PreguntaID" name="resultado_@pregunta.PreguntaID" value="OK" @(esOk ? "checked" : "") @(!puedeEditar ? "disabled" : "") />
                                            <label for="ok_@pregunta.PreguntaID"><i class="bi bi-check-circle"></i>OK</label>
                                        </div>
                                        <div class="cm-option nok">
                                            <input type="radio" id="nok_@pregunta.PreguntaID" name="resultado_@pregunta.PreguntaID" value="NOK" @(esNok ? "checked" : "") @(!puedeEditar ? "disabled" : "") />
                                            <label for="nok_@pregunta.PreguntaID"><i class="bi bi-x-circle"></i>NOK</label>
                                        </div>
                                        <div class="cm-option na">
                                            <input type="radio" id="na_@pregunta.PreguntaID" name="resultado_@pregunta.PreguntaID" value="NA" @(esNa ? "checked" : "") @(!pregunta.PermiteNA || !puedeEditar ? "disabled" : "") />
                                            <label for="na_@pregunta.PreguntaID"><i class="bi bi-dash-circle"></i>N/A</label>
                                        </div>
                                    </div>

                                    <div class="cm-observation">
                                        <label class="observation-label">
                                            Observaciones
                                            <span class="observation-required d-none text-danger">· requerida</span>
                                        </label>
                                        <textarea class="question-observation" maxlength="1000" @(!puedeEditar ? "readonly" : "") placeholder="Captura observación cuando sea necesario">@pregunta.Observaciones</textarea>
                                    </div>

                                    @if (pregunta.FechaRespuesta.HasValue)
                                    {
                                        <div class="cm-saved">
                                            <i class="bi bi-clock-history"></i>
                                            Última respuesta: @pregunta.FechaRespuesta.Value.ToString("dd/MM/yyyy HH:mm")
                                            @if (!string.IsNullOrWhiteSpace(pregunta.UsuarioRespuestaNombre))
                                            {
                                                <span> · @pregunta.UsuarioRespuestaNombre</span>
                                            }
                                        </div>
                                    }
                                </div>
                            </div>
                        }
                    </div>

                    <div class="cm-section-actions">
                        @if (puedeEditar)
                        {
                            <button type="button" class="cm-btn cm-btn-primary btn-save-section" data-section="@seccion.OrdenSeccion">
                                <i class="bi bi-save"></i>
                                Guardar sección
                            </button>
                        }
                        else
                        {
                            <span class="cm-status @(Model.EstaCompleto ? "complete" : "pending")">
                                <i class="bi bi-lock"></i>
                                @(Model.EstaCompleto ? "Checklist finalizado" : "Solo lectura")
                            </span>
                        }
                    </div>
                </section>
            }

            <section class="cm-card">
                <div class="cm-card-head">
                    <span><i class="bi bi-chat-left-text me-1"></i>Observaciones generales</span>
                </div>
                <div class="cm-card-body">
                    <div class="cm-general">
                        <textarea id="observacionesGenerales" maxlength="2000" @(!puedeEditar ? "readonly" : "") placeholder="Comentarios generales del desmontaje y montaje de molde">@Model.ObservacionesGenerales</textarea>
                    </div>
                </div>
            </section>

            <div class="cm-final">
                <div class="cm-final-row">
                    <div>
                        <div class="fw-bold">Cierre del checklist GQ-F-PR01-03</div>
                        <div class="cm-final-note" id="mensajeFinalizacion">
                            @if (Model.EstaCompleto)
                            {
                                <span>El checklist ya fue finalizado.</span>
                            }
                            else
                            {
                                <span>Para finalizar deben estar contestadas todas las preguntas obligatorias.</span>
                            }
                        </div>
                    </div>
                    <div class="d-flex gap-2 flex-wrap">
                        <a class="cm-btn cm-btn-outline" asp-controller="ProduccionPreparacion" asp-action="Index">
                            <i class="bi bi-arrow-left"></i>
                            Volver
                        </a>
                        @if (puedeEditar)
                        {
                            <button type="button" id="btnFinalizarChecklist" class="cm-btn cm-btn-success">
                                <i class="bi bi-check2-circle"></i>
                                Finalizar checklist
                            </button>
                        }
                    </div>
                </div>
            </div>
        </main>
    </div>
</div>

<div id="cmToast" class="cm-toast"></div>

@section Scripts {
    <script>
        document.addEventListener('DOMContentLoaded',function(){
            const preparacionId=@preparacionAnticipadaID;
            const checklistId=@Model.ChecklistArranqueID;
            const puedeEditar=@puedeEditar.ToString().ToLowerInvariant();
            const token=document.querySelector('#tokenForm input[name="__RequestVerificationToken"]')?.value||'';
            const toast=document.getElementById('cmToast');
            const btnFinalizar=document.getElementById('btnFinalizarChecklist');

            function mostrarToast(mensaje,tipo){
                if(!toast)return;
                toast.textContent=mensaje||'';
                toast.className='cm-toast show '+(tipo||'info');
                window.clearTimeout(window.__cmToastTimer);
                window.__cmToastTimer=window.setTimeout(()=>toast.classList.remove('show'),4200);
            }

            function resultadoPregunta(row){
                return row.querySelector('input[type="radio"]:checked')?.value||'';
            }

            function requiereObservacion(row){
                const resultado=resultadoPregunta(row);
                return (resultado==='NOK'&&row.dataset.requiereNok==='true')||(resultado==='NA'&&row.dataset.requiereNa==='true');
            }

            function actualizarPregunta(row){
                const requiere=requiereObservacion(row);
                const badge=row.querySelector('.observation-required');
                const textarea=row.querySelector('.question-observation');
                badge?.classList.toggle('d-none',!requiere);
                if(textarea)textarea.required=requiere;
                if(!requiere)textarea?.classList.remove('is-invalid');
            }

            function respuestaValida(row){
                if(row.dataset.required!=='true')return true;
                const resultado=resultadoPregunta(row);
                if(!resultado)return false;
                if(resultado==='NA'&&row.dataset.permiteNa!=='true')return false;
                if(requiereObservacion(row)){
                    const obs=row.querySelector('.question-observation')?.value.trim()||'';
                    if(!obs)return false;
                }
                return true;
            }

            function actualizarResumen(){
                const rows=Array.from(document.querySelectorAll('.cm-question'));
                const total=rows.length;
                const respondidas=rows.filter(x=>!!resultadoPregunta(x)).length;
                const porcentaje=total>0?Math.round(respondidas*100/total):0;
                const totalEl=document.getElementById('preguntasGeneral');
                const respEl=document.getElementById('respuestasGeneral');
                const pctEl=document.getElementById('porcentajeGeneral');
                const barra=document.getElementById('barraGeneral');
                if(totalEl)totalEl.textContent=total;
                if(respEl)respEl.textContent=respondidas;
                if(pctEl)pctEl.textContent=porcentaje+'%';
                if(barra)barra.style.width=porcentaje+'%';

                document.querySelectorAll('.cm-section').forEach(section=>{
                    const sectionRows=Array.from(section.querySelectorAll('.cm-question'));
                    const sectionRespondidas=sectionRows.filter(x=>!!resultadoPregunta(x)).length;
                    const sectionCompleta=sectionRows.length>0&&sectionRows.every(respuestaValida);
                    const counter=section.querySelector('.section-counter');
                    const status=section.querySelector('.section-status');
                    if(counter)counter.textContent=sectionRespondidas+' / '+sectionRows.length;
                    if(status){
                        status.classList.remove('pending','process','complete');
                        if(sectionCompleta){
                            status.classList.add('complete');
                            status.textContent='COMPLETA';
                        }else if(sectionRespondidas>0){
                            status.classList.add('process');
                            status.textContent='EN PROCESO';
                        }else{
                            status.classList.add('pending');
                            status.textContent='PENDIENTE';
                        }
                    }
                });

                const todasValidas=rows.length>0&&rows.every(respuestaValida);
                const msg=document.getElementById('mensajeFinalizacion');
                if(msg&&!@Model.EstaCompleto.ToString().ToLowerInvariant()){
                    msg.textContent=todasValidas?'Todas las preguntas obligatorias están completas. Ya puedes finalizar el checklist.':'Para finalizar deben estar contestadas todas las preguntas obligatorias.';
                }
                if(btnFinalizar&&puedeEditar)btnFinalizar.disabled=!todasValidas;
            }

            function validarSeccion(section){
                let valido=true;
                const rows=Array.from(section.querySelectorAll('.cm-question'));
                rows.forEach(row=>{
                    row.classList.remove('invalid');
                    const textarea=row.querySelector('.question-observation');
                    textarea?.classList.remove('is-invalid');
                    if(!respuestaValida(row)){
                        valido=false;
                        row.classList.add('invalid');
                        if(requiereObservacion(row)&&textarea&&!textarea.value.trim())textarea.classList.add('is-invalid');
                    }
                });
                if(!valido){
                    const primera=section.querySelector('.cm-question.invalid');
                    primera?.scrollIntoView({behavior:'smooth',block:'center'});
                }
                return valido;
            }

            async function guardarSeccion(sectionNumber,button){
                if(!puedeEditar)return false;
                const section=document.querySelector('.cm-section[data-section="'+sectionNumber+'"]');
                if(!section)return false;
                const rows=Array.from(section.querySelectorAll('.cm-question'));
                const formData=new FormData();
                formData.append('__RequestVerificationToken',token);
                formData.append('PreparacionAnticipadaID',preparacionId);
                formData.append('ChecklistArranqueID',checklistId);
                formData.append('OrdenSeccion',sectionNumber);
                rows.forEach((row,index)=>{
                    const preguntaId=row.querySelector('.question-id')?.value||'';
                    const resultado=resultadoPregunta(row);
                    const observacion=row.querySelector('.question-observation')?.value.trim()||'';
                    formData.append('Respuestas['+index+'].PreguntaID',preguntaId);
                    formData.append('Respuestas['+index+'].Resultado',resultado);
                    formData.append('Respuestas['+index+'].Observaciones',observacion);
                    formData.append('Respuestas['+index+'].ValorCapturado','');
                });
                const htmlOriginal=button?.innerHTML;
                if(button){
                    button.disabled=true;
                    button.innerHTML='<span class="spinner-border spinner-border-sm"></span> Guardando...';
                }
                try{
                    const response=await fetch('@Url.Action("GuardarSeccionChecklistCambioMolde", "ProduccionPreparacion")',{
                        method:'POST',
                        body:formData,
                        headers:{'X-Requested-With':'XMLHttpRequest'}
                    });
                    const data=await response.json();
                    if(!response.ok||!data.ok)throw new Error(data.mensaje||'No fue posible guardar la sección.');
                    mostrarToast(data.mensaje||'Sección guardada correctamente.','success');
                    actualizarResumen();
                    return true;
                }catch(error){
                    mostrarToast(error.message||'No fue posible guardar la sección.','error');
                    return false;
                }finally{
                    if(button){
                        button.disabled=false;
                        button.innerHTML=htmlOriginal;
                    }
                }
            }

            async function guardarTodasLasSecciones(){
                const sections=Array.from(document.querySelectorAll('.cm-section'));
                for(const section of sections){
                    const numero=section.dataset.section;
                    const button=section.querySelector('.btn-save-section');
                    const ok=await guardarSeccion(numero,button);
                    if(!ok)return false;
                }
                return true;
            }

            async function finalizarChecklist(){
                if(!puedeEditar)return;
                const sections=Array.from(document.querySelectorAll('.cm-section'));
                const sectionInvalida=sections.find(x=>!validarSeccion(x));
                if(sectionInvalida){
                    mostrarToast('Faltan respuestas obligatorias o alguna observación requerida.','error');
                    actualizarResumen();
                    return;
                }

                btnFinalizar.disabled=true;
                const original=btnFinalizar.innerHTML;
                btnFinalizar.innerHTML='<span class="spinner-border spinner-border-sm"></span> Finalizando...';

                try{
                    const guardado=await guardarTodasLasSecciones();
                    if(!guardado)throw new Error('No fue posible guardar todas las secciones antes de finalizar.');

                    const formData=new FormData();
                    formData.append('__RequestVerificationToken',token);
                    formData.append('PreparacionAnticipadaID',preparacionId);
                    formData.append('ChecklistArranqueID',checklistId);
                    formData.append('ObservacionesGenerales',document.getElementById('observacionesGenerales')?.value.trim()||'');

                    const response=await fetch('@Url.Action("FinalizarChecklistCambioMolde", "ProduccionPreparacion")',{
                        method:'POST',
                        body:formData,
                        headers:{'X-Requested-With':'XMLHttpRequest'}
                    });
                    const data=await response.json();
                    if(!response.ok||!data.ok)throw new Error(data.mensaje||'No fue posible finalizar el checklist.');

                    mostrarToast(data.mensaje||'Checklist finalizado correctamente.','success');
                    window.setTimeout(()=>window.location.reload(),900);
                }catch(error){
                    mostrarToast(error.message||'No fue posible finalizar el checklist.','error');
                    btnFinalizar.disabled=false;
                    btnFinalizar.innerHTML=original;
                }
            }

            document.querySelectorAll('.cm-question').forEach(row=>{
                actualizarPregunta(row);
                row.querySelectorAll('input[type="radio"]').forEach(input=>{
                    input.addEventListener('change',function(){
                        row.classList.remove('invalid');
                        actualizarPregunta(row);
                        actualizarResumen();
                    });
                });
                row.querySelector('.question-observation')?.addEventListener('input',function(){
                    this.classList.remove('is-invalid');
                    row.classList.remove('invalid');
                    actualizarResumen();
                });
            });

            document.querySelectorAll('.btn-save-section').forEach(button=>{
                button.addEventListener('click',async function(){
                    const sectionNumber=this.dataset.section;
                    await guardarSeccion(sectionNumber,this);
                });
            });

            btnFinalizar?.addEventListener('click',finalizarChecklist);
            actualizarResumen();
        });
    </script>
}