<div class="emb-page">
    <section class="hero">
        <div class="hero-main">
            <div class="hero-icon"><i class="bi bi-box-seam"></i></div>
            <div>
                <h1>Preparación de embalajes</h1>
                <p>Prepara cajas y embalajes antes del arranque para que la producción no se detenga por material de empaque.</p>
            </div>
        </div>

        <div class="hero-actions">
            <a class="btnx btnx-light" asp-controller="ProduccionPreparacion" asp-action="Index">
                <i class="bi bi-grid-1x2"></i> Tablero
            </a>
            <a class="btnx btnx-light" asp-controller="ProduccionPreparacion" asp-action="CambioMolde">
                <i class="bi bi-tools"></i> Cambios de molde
            </a>
            <a class="btnx btnx-light" asp-controller="ProduccionPreparacion" asp-action="Secado">
                <i class="bi bi-thermometer-sun"></i> Secado
            </a>
            <a class="btnx btnx-light" asp-controller="ProduccionPreparacion" asp-action="Historial">
                <i class="bi bi-clock-history"></i> Historial
            </a>
            <a class="btnx btnx-light" asp-controller="Produccion" asp-action="Index">
                <i class="bi bi-arrow-left"></i> Producción
            </a>
        </div>
    </section>

    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success flash">
            <i class="bi bi-check-circle me-1"></i>@TempData["Success"]
        </div>
    }

    @if (TempData["Warning"] != null)
    {
        <div class="alert alert-warning flash">
            <i class="bi bi-exclamation-triangle me-1"></i>@TempData["Warning"]
        </div>
    }

    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger flash">
            <i class="bi bi-exclamation-octagon me-1"></i>@TempData["Error"]
        </div>
    }

    <section class="stats">
        <div class="stat">
            <div class="stat-icon red"><i class="bi bi-exclamation-circle"></i></div>
            <div>
                <span class="stat-value">@vencidos</span>
                <span class="stat-label">Vencidos</span>
            </div>
        </div>

        <div class="stat">
            <div class="stat-icon orange"><i class="bi bi-lightning-charge"></i></div>
            <div>
                <span class="stat-value">@hacerAhora</span>
                <span class="stat-label">Preparar ahora</span>
            </div>
        </div>

        <div class="stat">
            <div class="stat-icon blue"><i class="bi bi-calendar-event"></i></div>
            <div>
                <span class="stat-value">@proximos</span>
                <span class="stat-label">Próximos</span>
            </div>
        </div>

        <div class="stat">
            <div class="stat-icon green"><i class="bi bi-box2-check"></i></div>
            <div>
                <span class="stat-value">@Cantidad(totalRequerido)</span>
                <span class="stat-label">Embalajes requeridos pendientes</span>
            </div>
        </div>
    </section>

    <form method="get" asp-controller="ProduccionPreparacion" asp-action="Embalajes" class="filters">
        <div class="field">
            <label>Buscar</label>
            <input type="text" name="filtro" value="@filtroActual" placeholder="OF, parte, embalaje o máquina..." />
        </div>

        <div class="field">
            <label>Máquina</label>
            <select name="maquinaId">
                <option value="">Todas las máquinas</option>
                @foreach (var maquina in Model.Maquinas)
                {
                    if (Model.MaquinaID == maquina.MaquinaID)
                    {
                        <option value="@maquina.MaquinaID" selected>@maquina.Texto</option>
                    }
                    else
                    {
                        <option value="@maquina.MaquinaID">@maquina.Texto</option>
                    }
                }
            </select>
        </div>

        <button class="btnx btnx-primary" type="submit">
            <i class="bi bi-search"></i> Filtrar
        </button>

        <a class="btnx btnx-outline" asp-controller="ProduccionPreparacion" asp-action="Embalajes">
            <i class="bi bi-arrow-counterclockwise"></i> Limpiar
        </a>
    </form>

    <section class="section">
        <div class="section-head">
            <div>
                <h2>Embalajes pendientes</h2>
                <p>La tarea aparece antes del arranque y muestra exactamente qué embalaje y cuántos se requieren.</p>
            </div>
            <span class="section-count">@pendientes.Count</span>
        </div>

        @if (pendientes.Any())
        {
            foreach (var grupo in pendientes
            .GroupBy(x => new { x.MaquinaID, x.MaquinaCodigo, x.MaquinaNombre })
            .OrderBy(x => x.Key.MaquinaCodigo)
            .ThenBy(x => x.Key.MaquinaNombre))
            {
                var nombreMaquina = string.IsNullOrWhiteSpace(grupo.Key.MaquinaNombre)
                ? grupo.Key.MaquinaCodigo ?? "Sin máquina"
                : $"{grupo.Key.MaquinaCodigo} · {grupo.Key.MaquinaNombre}";

                var embalajesGrupo = grupo
                .Where(x => x.CantidadEmbalajes.HasValue)
                .Sum(x => x.CantidadEmbalajes!.Value);

                <details class="machine-group">
                    <summary>
                        <div class="group-title">
                            <div class="group-icon"><i class="bi bi-building-gear"></i></div>
                            <div>
                                <strong>@nombreMaquina</strong>
                                <small>@grupo.Count() tarea@(grupo.Count() == 1 ? "" : "s") · @Cantidad(embalajesGrupo) embalaje(s) pendientes</small>
                            </div>
                        </div>
                        <span class="group-count">@grupo.Count()</span>
                    </summary>

                    <div class="group-body">
                        @foreach (var tarea in grupo.OrderBy(x => x.FechaAviso))
                        {
                            <article class="task @ClasePendiente(tarea)">
                                <div class="task-main">
                                    <div class="task-head">
                                        <div class="task-title">
                                            <div class="task-icon"><i class="bi bi-box-seam"></i></div>
                                            <div>
                                                <div class="task-kicker">
                                                    <span class="task-type">Preparar embalaje</span>

                                                    @if (!string.IsNullOrWhiteSpace(tarea.NumeroOF))
                                                    {
                                                        <span class="chip">OF @tarea.NumeroOF</span>
                                                    }
                                                </div>

                                                <h3>@tarea.TextoEmbalaje</h3>
                                                <div class="task-sub">@tarea.TextoParte · @tarea.TextoMaquina</div>
                                            </div>
                                        </div>

                                        <span class="status-pill @BadgePendiente(tarea)">
                                            @TextoPendiente(tarea)
                                        </span>
                                    </div>

                                    <div class="quantity-banner">
                                        <div class="quantity-main">
                                            <span>Embalajes requeridos</span>
                                            <strong>@Cantidad(tarea.CantidadEmbalajes)</strong>
                                        </div>

                                        <div class="quantity-secondary">
                                            <span>Piezas por embalaje</span>
                                            <strong>@Cantidad(tarea.PiezasPorEmbalaje) PZA</strong>
                                        </div>
                                    </div>

                                    <div class="info-grid">
                                        <div class="info">
                                            <span>Preparar desde</span>
                                            <strong>@Fecha(tarea.FechaAviso)</strong>
                                        </div>

                                        <div class="info">
                                            <span>Arranque programado</span>
                                            <strong>@Fecha(tarea.FechaArranque)</strong>
                                        </div>

                                        <div class="info">
                                            <span>Producción programada</span>
                                            <strong>@tarea.CantidadProgramada.ToString("N0") PZA</strong>
                                        </div>

                                        <div class="info">
                                            <span>Programa</span>
                                            <strong>#@tarea.ProgramaProduccionID</strong>
                                        </div>
                                    </div>

                                    <div class="window">
                                        <i class="bi bi-clock me-1"></i>
                                        @if (tarea.EsVencida)
                                        {
                                            <text>La preparación ya debía estar disponible. @tarea.TextoTiempo.</text>
                                        }
                                        else if (tarea.EsHacerAhora)
                                        {
                                            <text>Ya está dentro de la ventana de preparación. @tarea.TextoTiempo.</text>
                                        }
                                        else
                                        {
                                            <text>Aún es próxima. @tarea.TextoTiempo.</text>
                                        }
                                    </div>

                                    <div class="actions">
                                        @if (Model.PuedeGestionarEmbalaje)
                                        {
                                            if (!tarea.EsProxima)
                                            {
                                                <button type="button"
                                                        class="btnx btnx-primary js-toggle-confirmar"
                                                        data-target="confirmar-@tarea.PreparacionAnticipadaID">
                                                    <i class="bi bi-check2-square"></i> Confirmar embalaje preparado
                                                </button>
                                            }
                                            else
                                            {
                                                <span class="disabled-note">
                                                    <i class="bi bi-clock-history"></i>
                                                    Disponible para confirmar desde @Hora(tarea.FechaAviso)
                                                </span>
                                            }
                                        }

                                        @if (tarea.EjecucionProduccionID.HasValue)
                                        {
                                            <a class="btnx btnx-outline"
                                               asp-controller="Produccion"
                                               asp-action="Detalle"
                                               asp-route-id="@tarea.EjecucionProduccionID.Value">
                                                <i class="bi bi-box-arrow-up-right"></i> Ver producción
                                            </a>
                                        }
                                    </div>

                                    @if (Model.PuedeGestionarEmbalaje && !tarea.EsProxima)
                                    {
                                        <div class="confirm-panel" id="confirmar-@tarea.PreparacionAnticipadaID">
                                            <form asp-controller="ProduccionPreparacion"
                                                  asp-action="ConfirmarPreparacion"
                                                  method="post"
                                                  class="confirm-form js-confirm-form">
                                                @Html.AntiForgeryToken()

                                                <input type="hidden"
                                                       name="PreparacionAnticipadaID"
                                                       value="@tarea.PreparacionAnticipadaID" />

                                                <div class="field">
                                                    <label>Observaciones</label>
                                                    <textarea name="Observaciones"
                                              maxlength="500"
                                              placeholder="Ubicación, acomodo, faltante detectado, material alterno, etc."></textarea>
                                                </div>

                                                <button class="btnx btnx-success" type="submit">
                                                    <i class="bi bi-box2-check"></i> Registrar como preparado
                                                </button>
                                            </form>
                                        </div>
                                    }
                                </div>
                            </article>
                        }
                    </div>
                </details>
            }
        }
        else
        {
            <div class="empty">
                <i class="bi bi-box2-check"></i>
                <strong>No hay embalajes pendientes</strong>
                <span>No se encontraron tareas de preparación de embalaje con los filtros actuales.</span>
            </div>
        }
    </section>

    <section class="section">
        <details class="machine-group">
            <summary>
                <div class="group-title">
                    <div class="group-icon" style="background:var(--emb-green-soft);color:var(--emb-green)">
                        <i class="bi bi-check2-circle"></i>
                    </div>
                    <div>
                        <strong>Embalajes preparados recientemente</strong>
                        <small>@completados.Count confirmación@(completados.Count == 1 ? "" : "es") visible(s)</small>
                    </div>
                </div>
            </summary>

            @if (completados.Any())
            {
                <div class="history-list">
                    @foreach (var tarea in completados)
                    {
                        <div class="history-row">
                            <div>
                                <strong>@tarea.TextoMaquina</strong>
                                <span>OF @(string.IsNullOrWhiteSpace(tarea.NumeroOF) ? "—" : tarea.NumeroOF)</span>
                            </div>

                            <div>
                                <strong>@tarea.TextoEmbalaje</strong>
                                <span>@Cantidad(tarea.CantidadEmbalajes) requerido(s) · @Cantidad(tarea.PiezasPorEmbalaje) pza/embalaje</span>
                            </div>

                            <div>
                                <strong>@Fecha(tarea.FechaConfirmacion)</strong>
                                <span>Confirmado</span>
                            </div>

                            <div>
                                <strong>@(string.IsNullOrWhiteSpace(tarea.UsuarioConfirmacionNombre) ? $"Usuario {tarea.UsuarioConfirmacionID}" : tarea.UsuarioConfirmacionNombre)</strong>
                                <span>@(string.IsNullOrWhiteSpace(tarea.Observaciones) ? "Sin observaciones" : tarea.Observaciones)</span>
                            </div>
                        </div>
                    }
                </div>
            }
            else
            {
                <div class="empty" style="border:0;border-radius:0">
                    <i class="bi bi-clock-history"></i>
                    <strong>Aún no hay embalajes confirmados recientemente</strong>
                </div>
            }
        </details>
    </section>
</div>

<script>
    (function () {
        document.querySelectorAll('.js-toggle-confirmar').forEach(function (button) {
            button.addEventListener('click', function () {
                const targetId = button.dataset.target || '';
                const panel = document.getElementById(targetId);

                if (!panel) return;

                document.querySelectorAll('.confirm-panel.show').forEach(function (other) {
                    if (other !== panel) other.classList.remove('show');
                });

                panel.classList.toggle('show');

                if (panel.classList.contains('show')) {
                    const textarea = panel.querySelector('textarea');
                    if (textarea) textarea.focus();
                }
            });
        });

        document.querySelectorAll('.js-confirm-form').forEach(function (form) {
            form.addEventListener('submit', function () {
                const button = form.querySelector('button[type="submit"]');

                if (!button) return;

                button.disabled = true;
                button.innerHTML =
                    '<span class="spinner-border spinner-border-sm" aria-hidden="true"></span> Guardando...';
            });
        });
    })();
</script>
