@using ERP.NSQuell.Models
@using System.Linq
@model ProduccionPreparacionIndexVm
@{
    Layout = "_Layout";
    ViewData["Title"] = "Preparación de embalajes";

    var tareas = Model.Tareas ?? new List<ProduccionPreparacionTareaVm>();
    var embalajes = tareas.Where(x => x.EsPreparacionEmbalaje).ToList();

    var pendientes = embalajes
        .Where(x => x.EstaPendiente)
        .OrderBy(x => x.FechaAviso)
        .ThenBy(x => x.FechaObjetivo)
        .ToList();

    var completados = embalajes
        .Where(x => x.EstaConfirmada)
        .OrderByDescending(x => x.FechaConfirmacion)
        .Take(40)
        .ToList();

    var vencidos = pendientes.Count(x => x.EsVencida);
    var hacerAhora = pendientes.Count(x => x.EsHacerAhora);
    var proximos = pendientes.Count(x => x.EsProxima);
    var totalRequerido = pendientes
        .Where(x => x.CantidadEmbalajes.HasValue)
        .Sum(x => x.CantidadEmbalajes!.Value);

    var filtroActual = string.IsNullOrWhiteSpace(Model.Filtro) ? "" : Model.Filtro;

    string Fecha(DateTime? value) => value?.ToString("dd/MM/yyyy HH:mm") ?? "—";
    string Hora(DateTime? value) => value?.ToString("HH:mm") ?? "—";

    string Cantidad(decimal? value)
    {
        if (!value.HasValue) return "—";
        return value.Value.ToString(value.Value % 1 == 0 ? "N0" : "N2");
    }

    string ClasePendiente(ProduccionPreparacionTareaVm tarea)
    {
        if (tarea.EsVencida) return "task-overdue";
        if (tarea.EsHacerAhora) return "task-now";
        return "task-next";
    }

    string TextoPendiente(ProduccionPreparacionTareaVm tarea)
    {
        if (tarea.EsVencida) return "Vencido";
        if (tarea.EsHacerAhora) return "Preparar ahora";
        return "Próximo";
    }

    string BadgePendiente(ProduccionPreparacionTareaVm tarea)
    {
        if (tarea.EsVencida) return "overdue";
        if (tarea.EsHacerAhora) return "now";
        return "next";
    }
}
