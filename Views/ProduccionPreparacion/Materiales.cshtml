            color: var(--mat-muted);
            font-weight: 700;
        }

    @@media(max-width:1100px) {
        .machine-summary,
        .of-summary {
            grid-template-columns: 1fr auto 30px;
        }

        .machine-next,
        .of-date {
            display: none;
        }

        .filters {
            grid-template-columns: 1fr 1fr;
        }

        .expected-grid,
        .deliveries {
            grid-template-columns: 1fr;
        }

        .decision-grid,
        .decision-grid.no-quantity {
            grid-template-columns: 1fr;
        }
    }

    @@media(max-width:700px) {
        .mat-page {
            padding: 10px;
        }

        .mat-header {
            align-items: flex-start;
            flex-direction: column;
        }

        .summary,
        .filters,
        .expected-amounts,
        .actions {
            grid-template-columns: 1fr;
        }

        .machine-summary,
        .of-summary {
            grid-template-columns: 1fr 30px;
        }

        .machine-badges,
        .of-status {
            display: none;
        }

        .warehouse-main {
            align-items: flex-start;
            flex-direction: column;
        }

            .warehouse-main span {
                text-align: left;
            }

        .history-row {
            grid-template-columns: 1fr 1fr;
        }
    }
</style>

<div class="mat-page">
    <header class="mat-header">
        <div class="mat-title">
            <div class="mat-title-icon"><i class="bi bi-boxes"></i></div>
            <div>
                <h1>Preparación de materiales</h1>
                <p>Revisa qué debe entregar Almacén y confirma únicamente lo que recibiste físicamente.</p>
            </div>
        </div>
        <a class="btnx" asp-controller="ProduccionPreparacion" asp-action="Index">
            <i class="bi bi-arrow-left"></i> Volver a Preparación
        </a>
    </header>

    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success flash"><i class="bi bi-check-circle me-1"></i>@TempData["Success"]</div>
    }
    @if (TempData["Warning"] != null)
    {
        <div class="alert alert-warning flash"><i class="bi bi-exclamation-triangle me-1"></i>@TempData["Warning"]</div>
    }
    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger flash"><i class="bi bi-exclamation-octagon me-1"></i>@TempData["Error"]</div>
    }

    <section class="summary">
        <div class="summary-card">
            <div class="summary-icon orange"><i class="bi bi-hourglass-split"></i></div>
            <div>
                <strong>@Model.PendientesAlmacen</strong>
                <span>Pendientes de Almacén</span>
            </div>
        </div>
        <div class="summary-card">
            <div class="summary-icon blue"><i class="bi bi-box-arrow-in-down"></i></div>
            <div>
                <strong>@Model.PendientesConfirmacion</strong>
                <span>Por confirmar</span>
            </div>
        </div>
        <div class="summary-card">
            <div class="summary-icon red"><i class="bi bi-exclamation-triangle"></i></div>
            <div>
                <strong>@Model.AclaracionesPendientes</strong>
                <span>Con diferencia</span>
            </div>
        </div>
    </section>

    <form method="get" asp-controller="ProduccionPreparacion" asp-action="Materiales" class="filters">
        <div class="field">
            <label>Buscar</label>
            <input type="text" name="filtro" value="@filtroActual" placeholder="OF, material, embalaje, parte..." />
        </div>
        <div class="field">
            <label>Máquina</label>
            <select name="maquinaId">
                <option value="">Todas las máquinas</option>
                @foreach (var maquina in Model.Maquinas)
                {
                    if (Model.MaquinaID == maquina.MaquinaID)
                    {
                        <option value="@maquina.MaquinaID" selected>@maquina.Texto</option>
                    }
                    else
                    {
                        <option value="@maquina.MaquinaID">@maquina.Texto</option>
                    }
                }
            </select>
        </div>
        <button class="btnx btnx-primary" type="submit"><i class="bi bi-search"></i> Filtrar</button>
        <a class="btnx" asp-controller="ProduccionPreparacion" asp-action="Materiales"><i class="bi bi-arrow-counterclockwise"></i> Limpiar</a>
    </form>

    <section class="section">
        <div class="section-head">
            <div>
                <h2>Almacén ya entregó · confirma recepción</h2>
                <p>Confirma primero lo que ya llegó físicamente. Las entregas están agrupadas por máquina para localizar rápidamente cada OF.</p>
            </div>
            <span class="section-count">@pendientesRecepcion.Count</span>
        </div>

        @if (pendientesRecepcion.Any())
        {
            <div class="machine-list" id="recepcionesMaquinas">
                @foreach (var maquinaGrupo in pendientesRecepcion
                            .GroupBy(x => new
                            {
                                x.MaquinaID,
                                x.MaquinaCodigo,
                                x.MaquinaNombre
                            })
                            .OrderBy(x => x.Min(y => y.FechaEntregaAlmacen))
                            .ThenBy(x => x.Key.MaquinaCodigo)
                            .ThenBy(x => x.Key.MaquinaNombre))
                {
                    var maquinaTextoRecepcion = string.IsNullOrWhiteSpace(maquinaGrupo.Key.MaquinaCodigo)
                    ? "Sin máquina"
                    : string.IsNullOrWhiteSpace(maquinaGrupo.Key.MaquinaNombre)
                    ? maquinaGrupo.Key.MaquinaCodigo
                    : $"{maquinaGrupo.Key.MaquinaCodigo} - {maquinaGrupo.Key.MaquinaNombre}";
                    var gruposOfRecepcion = maquinaGrupo
                    .GroupBy(x => x.NumeroOF)
                    .OrderBy(x => x.Min(y => y.FechaEntregaAlmacen))
                    .ThenBy(x => x.Key)
                    .ToList();
                    var primeraRecepcion = maquinaGrupo.OrderBy(x => x.FechaEntregaAlmacen).FirstOrDefault();
                    var totalMp = maquinaGrupo.Count(x => x.EsMateriaPrima);
                    var totalEmbalaje = maquinaGrupo.Count(x => x.EsEmbalaje);

                    <details class="machine-accordion js-machine-accordion">
                        <summary class="machine-summary reception-summary">
                            <div class="machine-main">
                                <div class="machine-icon"><i class="bi bi-box-arrow-in-down"></i></div>
                                <div>
                                    <strong>@maquinaTextoRecepcion</strong>
                                    <span>@gruposOfRecepcion.Count OF@(gruposOfRecepcion.Count == 1 ? "" : "s") · @maquinaGrupo.Count() entrega@(maquinaGrupo.Count() == 1 ? "" : "s") por confirmar</span>
                                </div>
                            </div>

                            <div class="machine-next">
                                @if (primeraRecepcion != null)
                                {
                                    <strong>OF @(string.IsNullOrWhiteSpace(primeraRecepcion.NumeroOF) ? "—" : primeraRecepcion.NumeroOF)</strong>
                                    <span>Entregado @Fecha(primeraRecepcion.FechaEntregaAlmacen)</span>
                                }
                            </div>

                            <div class="machine-badges">
                                @if (totalMp > 0)
                                {
                                    <span class="mini-badge blue"><i class="bi bi-droplet-half"></i>@totalMp MP</span>
                                }
                                @if (totalEmbalaje > 0)
                                {
                                    <span class="mini-badge green"><i class="bi bi-box-seam"></i>@totalEmbalaje embalaje@(totalEmbalaje == 1 ? "" : "s")</span>
                                }
                            </div>

                            <span class="machine-chevron"><i class="bi bi-chevron-down"></i></span>
                        </summary>

                        <div class="machine-body">
                            <div class="deliveries">
                                @foreach (var item in maquinaGrupo
                                                        .OrderBy(x => x.FechaEntregaAlmacen)
                                                        .ThenBy(x => x.NumeroOF)
                                                        .ThenBy(x => x.EsMateriaPrima ? 0 : 1)
                                                        .ThenBy(x => x.CodigoEntregado))
                                {
                                    var panelParcial = $"parcial-{item.RecepcionMaterialID}";
                                    var panelNoRecibido = $"no-recibido-{item.RecepcionMaterialID}";

                                    <article class="delivery">
                                        <div class="delivery-head">
                                            <div>
                                                <div class="delivery-kicker">
                                                    <span class="type-badge">
                                                        <i class="bi @(item.EsMateriaPrima ? "bi-droplet-half" : "bi-box-seam")"></i>
                                                        @item.TipoOrigenTexto
                                                    </span>
                                                    <span class="context-chip">OF @(string.IsNullOrWhiteSpace(item.NumeroOF) ? "—" : item.NumeroOF)</span>
                                                </div>
                                                <h3>@item.TextoEntregado</h3>
                                                <div class="delivery-sub">
                                                    @(string.IsNullOrWhiteSpace(item.MaquinaCodigo) ? "Sin máquina" : item.TextoMaquina)
                                                    @if (!string.IsNullOrWhiteSpace(item.NumeroParte))
                                                    {
                                                        <text> · Parte @item.NumeroParte</text>
                                                    }
                                                </div>
                                            </div>
                                            <span class="status-badge pending">Por confirmar</span>
                                        </div>

                                        <div class="delivery-body">
                                            <div class="warehouse-box">
                                                <div class="warehouse-label">Almacén reporta que entregó</div>
                                                <div class="warehouse-main">
                                                    <strong>@Cantidad(item.CantidadEntregadaAlmacen) @item.Unidad</strong>
                                                    <span>
                                                        @if (item.EsMateriaPrima)
                                                        {
                                                            <text>@item.TipoMPTexto</text>
                                                            @if (!string.IsNullOrWhiteSpace(item.Lote) && !string.Equals(item.Lote, "S/L", StringComparison.OrdinalIgnoreCase))
                                                            {
                                                                <text> · Lote @item.Lote</text>
                                                            }
                                                        }
                                                        else
                                                        {
                                                            <text>@item.CodigoEntregado</text>
                                                        }
                                                    </span>
                                                </div>
                                                <div class="warehouse-meta">
                                                    <span><i class="bi bi-person"></i>@(string.IsNullOrWhiteSpace(item.UsuarioEntregaAlmacenNombre) ? "Almacén" : item.UsuarioEntregaAlmacenNombre)</span>
                                                    <span><i class="bi bi-clock"></i>@Fecha(item.FechaEntregaAlmacen)</span>
                                                </div>
                                            </div>

                                            @if (item.EsSustitucion)
                                            {
                                                <div class="substitution">
                                                    <i class="bi bi-exclamation-triangle me-1"></i>
                                                    Solicitado: @item.TextoSolicitado<br />
                                                    Entregado: @item.TextoEntregado
                                                </div>
                                            }

                                            @if (Model.PuedeGestionarMateriales)
                                            {
                                                <div class="actions">
                                                    <form asp-controller="ProduccionPreparacion" asp-action="ConfirmarRecepcionMaterial" method="post" class="js-submit-form">
                                                        @Html.AntiForgeryToken()
                                                        <input type="hidden" name="RecepcionMaterialID" value="@item.RecepcionMaterialID" />
                                                        <input type="hidden" name="Decision" value="@ProduccionRecepcionMaterialDecision.Completo" />
                                                        <button class="btnx btnx-success" type="submit">
                                                            <i class="bi bi-check2-circle"></i> Sí, recibí completo
                                                        </button>
                                                    </form>
                                                    <button class="btnx btnx-warning js-toggle-panel" type="button" data-target="@panelParcial">
                                                        <i class="bi bi-dash-circle"></i> Recibí menos
                                                    </button>
                                                    <button class="btnx btnx-danger js-toggle-panel" type="button" data-target="@panelNoRecibido">
                                                        <i class="bi bi-x-circle"></i> No recibí
                                                    </button>
                                                </div>

                                                <div class="decision-panel" id="@panelParcial">
                                                    <form asp-controller="ProduccionPreparacion" asp-action="ConfirmarRecepcionMaterial" method="post" class="decision-grid js-submit-form">
                                                        @Html.AntiForgeryToken()
                                                        <input type="hidden" name="RecepcionMaterialID" value="@item.RecepcionMaterialID" />
                                                        <input type="hidden" name="Decision" value="@ProduccionRecepcionMaterialDecision.Parcial" />
                                                        <div class="field">
                                                            <label>Cantidad recibida</label>
                                                            <input type="number" name="CantidadRecibida" min="0.0001" max="@item.CantidadEntregadaAlmacen.ToString(System.Globalization.CultureInfo.InvariantCulture)" step="0.0001" required placeholder="0" />
                                                        </div>
                                                        <div class="field">
                                                            <label>Motivo de la diferencia</label>
                                                            <input type="text" name="MotivoDiferencia" maxlength="500" required placeholder="Ej. faltó un saco" />
                                                        </div>
                                                        <button class="btnx btnx-warning" type="submit"><i class="bi bi-check2"></i> Registrar parcial</button>
                                                    </form>
                                                </div>

                                                <div class="decision-panel" id="@panelNoRecibido">
                                                    <form asp-controller="ProduccionPreparacion" asp-action="ConfirmarRecepcionMaterial" method="post" class="decision-grid no-quantity js-submit-form">
                                                        @Html.AntiForgeryToken()
                                                        <input type="hidden" name="RecepcionMaterialID" value="@item.RecepcionMaterialID" />
                                                        <input type="hidden" name="Decision" value="@ProduccionRecepcionMaterialDecision.NoRecibido" />
                                                        <div class="field">
                                                            <label>Motivo</label>
                                                            <input type="text" name="MotivoDiferencia" maxlength="500" required placeholder="Describe brevemente por qué no lo recibiste" />
                                                        </div>
                                                        <button class="btnx btnx-danger" type="submit"><i class="bi bi-x-lg"></i> Confirmar no recibido</button>
                                                    </form>
                                                </div>
                                            }
                                            else
                                            {
                                                <div class="readonly-note"><i class="bi bi-eye me-1"></i> Solo lectura. No tienes permiso para confirmar recepciones.</div>
                                            }
                                        </div>
                                    </article>
                                }
                            </div>
                        </div>
                    </details>
                }
            </div>
        }
        else
        {
            <div class="empty">
                <i class="bi bi-inbox"></i>
                <strong>No hay entregas pendientes de confirmar</strong>
                <span>Cuando Almacén registre una entrega aparecerá aquí.</span>
            </div>
        }
    </section>

    <section class="section">
        <div class="section-head">
            <div>
                <h2>Próximo a recibir de Almacén</h2>
                <p>Despliega una máquina para revisar sus OF y el material que todavía falta por entregar.</p>
            </div>
            <span class="section-count">@esperados.Count</span>
        </div>

        @if (esperados.Any())
        {
            <div class="machine-list" id="materialesMaquinas">
                @foreach (var maquinaGrupo in esperados
                            .GroupBy(x => new
                            {
                                x.MaquinaID,
                                x.MaquinaCodigo,
                                x.MaquinaNombre
                            })
                            .OrderBy(x => x.Min(y => y.FechaArranque ?? DateTime.MaxValue))
                            .ThenBy(x => x.Key.MaquinaCodigo)
                            .ThenBy(x => x.Key.MaquinaNombre))
                {
                    var maquinaTexto = string.IsNullOrWhiteSpace(maquinaGrupo.Key.MaquinaCodigo)
                    ? "Sin máquina"
                    : string.IsNullOrWhiteSpace(maquinaGrupo.Key.MaquinaNombre)
                    ? maquinaGrupo.Key.MaquinaCodigo
                    : $"{maquinaGrupo.Key.MaquinaCodigo} - {maquinaGrupo.Key.MaquinaNombre}";

                    var gruposOf = maquinaGrupo
                    .GroupBy(x => new
                    {
                        x.ProgramaProduccionID,
                        x.NumeroOF,
                        x.FechaArranque
                    })
                    .OrderBy(x => x.Key.FechaArranque ?? DateTime.MaxValue)
                    .ThenBy(x => x.Key.NumeroOF)
                    .ToList();

                    var siguienteOf = gruposOf.FirstOrDefault();
                    var totalParciales = maquinaGrupo.Count(x => x.EsEntregaParcial);
                    var totalSinEntrega = maquinaGrupo.Count(x => x.SinEntrega);

                    <details class="machine-accordion js-machine-accordion">
                        <summary class="machine-summary">
                            <div class="machine-main">
                                <div class="machine-icon"><i class="bi bi-building-gear"></i></div>
                                <div>
                                    <strong>@maquinaTexto</strong>
                                    <span>@gruposOf.Count OF@(gruposOf.Count == 1 ? "" : "s") · @maquinaGrupo.Count() material@(maquinaGrupo.Count() == 1 ? "" : "es") pendiente@(maquinaGrupo.Count() == 1 ? "" : "s")</span>
                                </div>
                            </div>

                            <div class="machine-next">
                                @if (siguienteOf != null)
                                {
                                    <strong>OF @(string.IsNullOrWhiteSpace(siguienteOf.Key.NumeroOF) ? "—" : siguienteOf.Key.NumeroOF)</strong>
                                    <span>
                                        @if (siguienteOf.Key.FechaArranque.HasValue)
                                        {
                                            <text>@Fecha(siguienteOf.Key.FechaArranque)</text>
                                        }
                                        else
                                        {
                                            <text>Sin fecha de arranque</text>
                                        }
                                    </span>
                                }
                            </div>

                            <div class="machine-badges">
                                @if (totalParciales > 0)
                                {
                                    <span class="mini-badge orange"><i class="bi bi-circle-half"></i>@totalParciales parcial@(totalParciales == 1 ? "" : "es")</span>
                                }
                                @if (totalSinEntrega > 0)
                                {
                                    <span class="mini-badge red"><i class="bi bi-hourglass-split"></i>@totalSinEntrega pendiente@(totalSinEntrega == 1 ? "" : "s")</span>
                                }
                            </div>

                            <span class="machine-chevron"><i class="bi bi-chevron-down"></i></span>
                        </summary>

                        <div class="machine-body">
                            @foreach (var grupoOf in gruposOf)
                            {
                                var parcialesOf = grupoOf.Count(x => x.EsEntregaParcial);
                                var pendientesOf = grupoOf.Count(x => x.SinEntrega);

                                <details class="of-accordion js-of-accordion">
                                    <summary class="of-summary">
                                        <div class="of-main">
                                            <strong>OF @(string.IsNullOrWhiteSpace(grupoOf.Key.NumeroOF) ? "—" : grupoOf.Key.NumeroOF)</strong>
                                            <span>@grupoOf.Count() material@(grupoOf.Count() == 1 ? "" : "es") pendiente@(grupoOf.Count() == 1 ? "" : "s") de Almacén</span>
                                        </div>

                                        <div class="of-date">
                                            @if (grupoOf.Key.FechaArranque.HasValue)
                                            {
                                                <strong>@Fecha(grupoOf.Key.FechaArranque)</strong>
                                                <span>Se necesita</span>
                                            }
                                            else
                                            {
                                                <strong>Sin fecha</strong>
                                                <span>Arranque</span>
                                            }
                                        </div>

                                        <div class="of-status">
                                            @if (parcialesOf > 0)
                                            {
                                                <span class="mini-badge orange"><i class="bi bi-circle-half"></i>@parcialesOf parcial@(parcialesOf == 1 ? "" : "es")</span>
                                            }
                                            else if (pendientesOf > 0)
                                            {
                                                <span class="mini-badge red"><i class="bi bi-hourglass-split"></i>Pendiente</span>
                                            }
                                        </div>

                                        <span class="of-chevron"><i class="bi bi-chevron-down"></i></span>
                                    </summary>

                                    <div class="of-body">
                                        <div class="expected-grid">
                                            @foreach (var item in grupoOf.OrderBy(x => x.EsMateriaPrima ? 0 : 1).ThenBy(x => x.Codigo))
                                            {
                                                <div class="expected-card">
                                                    <div class="expected-top">
                                                        <div>
                                                            <span class="material-type">
                                                                <i class="bi @(item.EsMateriaPrima ? "bi-droplet-half" : "bi-box-seam")"></i>
                                                                @item.TipoOrigenTexto
                                                            </span>
                                                            <h3>@item.TextoMaterial</h3>
                                                        </div>

                                                        @if (item.EsEntregaParcial)
                                                        {
                                                            <span class="expected-status partial">Entrega parcial</span>
                                                        }
                                                        else
                                                        {
                                                            <span class="expected-status waiting">Pendiente de Almacén</span>
                                                        }
                                                    </div>

                                                    <div class="expected-amounts">
                                                        <div class="amount">
                                                            <span>Requerido</span>
                                                            <strong>@Cantidad(item.CantidadRequerida) @item.Unidad</strong>
                                                        </div>
                                                        <div class="amount">
                                                            <span>Almacén entregó</span>
                                                            <strong>@Cantidad(item.CantidadEntregadaAlmacen) @item.Unidad</strong>
                                                        </div>
                                                        <div class="amount missing">
                                                            <span>Falta entregar</span>
                                                            <strong>@Cantidad(item.CantidadPendienteAlmacen) @item.Unidad</strong>
                                                        </div>
                                                    </div>
                                                </div>
                                            }
                                        </div>
                                    </div>
                                </details>
                            }
                        </div>
                    </details>
                }
            </div>
        }
        else
        {
            <div class="empty">
                <i class="bi bi-check2-circle"></i>
                <strong>No hay materiales pendientes de Almacén</strong>
                <span>Con los filtros actuales, las próximas órdenes ya tienen sus materiales entregados.</span>
            </div>
        }
    </section>

    @if (recientes.Any())
    {
        <section class="section">
            <details class="history">
                <summary>
                    <i class="bi bi-clock-history"></i>
                    Últimas recepciones confirmadas
                    <span class="section-count ms-auto">@recientes.Count</span>
                </summary>

                <div class="history-list">
                    @foreach (var item in recientes)
                    {
                        <div class="history-row">
                            <div>
                                <strong>@item.TextoEntregado</strong>
                                <span>OF @(string.IsNullOrWhiteSpace(item.NumeroOF) ? "—" : item.NumeroOF)</span>
                            </div>
                            <div>
                                <strong>@Cantidad(item.CantidadEntregadaAlmacen) @item.Unidad</strong>
                                <span>Almacén</span>
                            </div>
                            <div>
                                <span class="status-badge @ClaseEstadoRecepcion(item)">@TextoEstadoRecepcion(item)</span>
                                @if (item.CantidadRecibidaProduccion.HasValue)
                                {
                                    <span>@CantidadNullable(item.CantidadRecibidaProduccion) @item.Unidad recibido</span>
                                }
                            </div>
                            <div>
                                <strong>@(string.IsNullOrWhiteSpace(item.UsuarioRecepcionNombre) ? "Producción" : item.UsuarioRecepcionNombre)</strong>
                                <span>@Fecha(item.FechaRecepcion)</span>
                                @if (item.TieneDiferencia && !string.IsNullOrWhiteSpace(item.MotivoDiferencia))
                                {
                                    <span>@item.MotivoDiferencia</span>
                                }
                            </div>
                        </div>
                    }
                </div>
            </details>
        </section>
    }
</div>

<script>
    (function () {
        document.querySelectorAll('.js-machine-accordion').forEach(function (machine) {
            machine.addEventListener('toggle', function () {
                if (!machine.open) return;

                document.querySelectorAll('.js-machine-accordion').forEach(function (other) {
                    if (other !== machine) other.open = false;
                });
            });
        });

        document.querySelectorAll('.js-of-accordion').forEach(function (ofItem) {
            ofItem.addEventListener('toggle', function () {
                if (!ofItem.open) return;

                const machine = ofItem.closest('.js-machine-accordion');
                if (!machine) return;

                machine.querySelectorAll('.js-of-accordion').forEach(function (other) {
                    if (other !== ofItem) other.open = false;
                });
            });
        });

        document.querySelectorAll('.js-toggle-panel').forEach(function (button) {
            button.addEventListener('click', function () {
                const targetId = button.dataset.target || '';
                const target = document.getElementById(targetId);
                if (!target) return;

                const card = button.closest('.delivery');
                if (card) {
                    card.querySelectorAll('.decision-panel.show').forEach(function (panel) {
                        if (panel !== target) panel.classList.remove('show');
                    });
                }

                target.classList.toggle('show');

                if (target.classList.contains('show')) {
                    const input = target.querySelector('input:not([type="hidden"])');
                    if (input) input.focus();
                }
            });
        });

        document.querySelectorAll('.js-submit-form').forEach(function (form) {
            form.addEventListener('submit', function () {
                const button = form.querySelector('button[type="submit"]');
                if (!button) return;

                button.disabled = true;
                button.innerHTML = '<span class="spinner-border spinner-border-sm" aria-hidden="true"></span> Guardando...';
            });
        });
    })();
</script>
