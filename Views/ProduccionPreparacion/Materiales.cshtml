@using ERP.NSQuell.Models
@using System
@using System.Collections.Generic
@using System.Linq
@model ProduccionPreparacionMaterialesVm

@{
    Layout = "_Layout";
    ViewData["Title"] = "Preparación de materiales";

    var esperados = (Model.MaterialesEsperados ?? new List<ProduccionMaterialEsperadoVm>())
        .Where(x => x.CantidadPendienteAlmacen > 0.0005m)
        .OrderBy(x => x.FechaArranque ?? DateTime.MaxValue)
        .ThenBy(x => x.MaquinaCodigo)
        .ThenBy(x => x.NumeroOF)
        .ThenBy(x => x.TipoOrigen)
        .ThenBy(x => x.Codigo)
        .ToList();

    var recepciones = Model.Recepciones ?? new List<ProduccionRecepcionMaterialVm>();

    var pendientesRecepcion = recepciones
        .Where(x => x.EstaPendiente)
        .OrderBy(x => x.FechaEntregaAlmacen)
        .ThenBy(x => x.NumeroOF)
        .ToList();

    var recientes = recepciones
        .Where(x => !x.EstaPendiente)
        .OrderByDescending(x => x.FechaRecepcion ?? x.FechaEntregaAlmacen)
        .Take(20)
        .ToList();

    var filtroActual = string.IsNullOrWhiteSpace(Model.Filtro) ? "" : Model.Filtro;

    string Cantidad(decimal value) => value.ToString(value % 1m == 0m ? "N0" : "0.####");
    string CantidadNullable(decimal? value) => value.HasValue ? Cantidad(value.Value) : "—";
    string Fecha(DateTime? value) => value?.ToString("dd/MM/yyyy HH:mm") ?? "—";

    string ClaseEstadoRecepcion(ProduccionRecepcionMaterialVm item)
    {
        if (item.EstaRecibidoCompleto) return "ok";
        if (item.EstaRecibidoParcial) return "partial";
        if (item.EstaNoRecibido) return "none";
        return "pending";
    }

    string TextoEstadoRecepcion(ProduccionRecepcionMaterialVm item)
    {
        if (item.EstaRecibidoCompleto) return "Recibido";
        if (item.EstaRecibidoParcial) return "Recibido parcial";
        if (item.EstaNoRecibido) return "No recibido";
        return "Pendiente";
    }
}

