            <div class="prep-clock">
                <strong id="liveClock">@Model.FechaConsulta.ToString("HH:mm:ss")</strong>
                <span id="liveDate">@Model.FechaConsulta.ToString("dddd dd/MM/yyyy")</span>
            </div>

            <a class="btnx btnx-light"
               asp-controller="Produccion"
               asp-action="Index">
                <i class="bi bi-arrow-left"></i>
                Producción
            </a>
        </div>
    </header>

    <nav class="module-nav">
        <a class="module-link molde"
           asp-controller="ProduccionPreparacion"
           asp-action="CambioMolde">
            <i class="bi bi-tools"></i>
            Cambios de molde
        </a>

        <a class="module-link embalaje"
           asp-controller="ProduccionPreparacion"
           asp-action="Materiales">
            <i class="bi bi-box-seam"></i>
            Materiales
        </a>

        <a class="module-link secado"
           asp-controller="ProduccionPreparacion"
           asp-action="Secado">
            <i class="bi bi-thermometer-sun"></i>
            Secado
        </a>

        <a class="module-link historial"
           asp-controller="ProduccionPreparacion"
           asp-action="Historial">
            <i class="bi bi-clock-history"></i>
            Historial
        </a>
    </nav>

    <div class="status-strip">
        <div class="status-item">
            <span class="status-dot red"></span>
            <div>
                <strong>@riesgos</strong>
                <span>Riesgos / vencidos</span>
            </div>
        </div>

        <div class="status-item">
            <span class="status-dot orange"></span>
            <div>
                <strong>@requierenAccion</strong>
                <span>Requieren acción</span>
            </div>
        </div>

        <div class="status-item">
            <span class="status-dot purple"></span>
            <div>
                <strong>@enCurso</strong>
                <span>Procesos en curso</span>
            </div>
        </div>

        <div class="status-item">
            <span class="status-dot blue"></span>
            <div>
                <strong>@programadas</strong>
                <span>Preparaciones próximas</span>
            </div>
        </div>
    </div>

    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success flash">
            <i class="bi bi-check-circle me-1"></i>@TempData["Success"]
        </div>
    }

    @if (TempData["Warning"] != null)
    {
        <div class="alert alert-warning flash">
            <i class="bi bi-exclamation-triangle me-1"></i>@TempData["Warning"]
        </div>
    }

    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger flash">
            <i class="bi bi-exclamation-octagon me-1"></i>@TempData["Error"]
        </div>
    }

    <form method="get"
          asp-controller="ProduccionPreparacion"
          asp-action="Index"
          class="filters">

        <div class="field">
            <label>Buscar</label>
            <input type="text"
                   name="filtro"
                   value="@filtroActual"
                   placeholder="OF, parte, material, embalaje, molde..." />
        </div>

        <div class="field">
            <label>Máquina</label>
            <select name="maquinaId">
                <option value="">Todas las máquinas</option>

                @foreach (var maquina in Model.Maquinas)
                {
                    if (Model.MaquinaID == maquina.MaquinaID)
                    {
                        <option value="@maquina.MaquinaID" selected>@maquina.Texto</option>
                    }
                    else
                    {
                        <option value="@maquina.MaquinaID">@maquina.Texto</option>
                    }
                }
            </select>
        </div>

        <button type="submit"
                class="btnx btnx-primary">
            <i class="bi bi-search"></i>
            Filtrar
        </button>

        <a class="btnx btnx-outline"
           asp-controller="ProduccionPreparacion"
           asp-action="Index">
            <i class="bi bi-arrow-counterclockwise"></i>
            Limpiar
        </a>

        <label class="attention-toggle">
            <input type="checkbox"
                   id="soloAtencion" />
            Solo máquinas con atención
        </label>
    </form>

    <details class="section-shell" open>
        <summary>
            <span class="section-icon">
                <i class="bi bi-building-gear"></i>
            </span>

            <span class="section-summary-title">
                <strong>Operación por máquina</strong>
                <span>Cada máquina agrupa sus OF y sus actividades de preparación.</span>
            </span>

            <span class="section-count">@gruposMaquina.Count</span>

            <span class="section-chevron">
                <i class="bi bi-chevron-down"></i>
            </span>
        </summary>

        <div class="section-content">
            @if (gruposMaquina.Any())
            {
                <div class="accordion machine-list"
                     id="accordionMaquinas">

                    @foreach (var grupo in gruposMaquina)
                    {
                        var estadoMaquina = EstadoGeneral(grupo);
                        var claseMaquina = EstadoGeneralClase(estadoMaquina);

                        var riesgosMaquina = grupo.Count(EsRiesgo);

                        var accionMaquina = grupo.Count(x =>
                        x.EstaPendiente &&
                        (
                        x.EsHacerAhora ||
                        x.EsVencida ||
                        SecadoLlegariaTarde(x)
                        ));

                        var enCursoMaquina = grupo.Count(EsEnCurso);

                        var programadasMaquina = grupo.Count(x =>
                        x.EstaPendiente &&
                        x.EsProxima &&
                        !SecadoLlegariaTarde(x));

                        var requiereAtencion =
                        riesgosMaquina > 0 ||
                        accionMaquina > 0 ||
                        enCursoMaquina > 0;

                        var programas = grupo
                        .GroupBy(x => x.ProgramaProduccionID)
                        .Where(ProgramaEsOperativo)
                        .OrderBy(x =>
                        ArranquePrograma(x) ??
                        x.Min(y => y.FechaObjetivo))
                        .ThenBy(x => x.Key)
                        .ToList();

                        var siguientePrograma = programas.FirstOrDefault();

                        var siguienteOf = siguientePrograma == null
                        ? "—"
                        : OfPrograma(siguientePrograma);

                        var siguienteParte = siguientePrograma == null
                        ? "Sin parte"
                        : PartePrograma(siguientePrograma);

                        var siguienteArranque = siguientePrograma == null
                        ? (DateTime?)null
                        : ArranquePrograma(siguientePrograma);

                        var collapseId = $"maquina-{grupo.Key.MaquinaID}";
                        var headingId = $"heading-{grupo.Key.MaquinaID}";

                        <div class="accordion-item machine-accordion js-machine"
                             data-attention="@(requiereAtencion ? "1" : "0")">

                            <h2 class="accordion-header"
                                id="@headingId">

                                <button class="accordion-button machine-button collapsed"
                                        type="button"
                                        data-bs-toggle="collapse"
                                        data-bs-target="#@collapseId"
                                        aria-expanded="false"
                                        aria-controls="@collapseId">

                                    <div class="machine-main">
                                        <span class="machine-mark">
                                            <i class="bi bi-building-gear"></i>
                                        </span>

                                        <div>
                                            <span class="level-kicker level-machine">NIVEL 1 · MÁQUINA</span>
                                            <strong>
                                                @(string.IsNullOrWhiteSpace(grupo.Key.MaquinaCodigo)
                                                                                        ? "Sin código"
                                                                                        : grupo.Key.MaquinaCodigo)
                                                                                                              </strong>

                                            <span>
                                                @(string.IsNullOrWhiteSpace(grupo.Key.MaquinaNombre)
                                                                                        ? "Máquina"
                                                                                        : grupo.Key.MaquinaNombre)
                                    </span>
                                </div>
                            </div>

                                    <div class="machine-next">
                                        <strong>OF @siguienteOf</strong>
                                        <span>@siguienteParte</span>
                                    </div>

                                    <div class="machine-time">
                                        <strong>@Fecha(siguienteArranque)</strong>
                                        <span>Próximo arranque</span>
                                    </div>

                                    <div class="machine-counters">
                                @if (riesgosMaquina > 0)
                                        {
                                            <span class="mini-count risk">
                                                <i class="bi bi-exclamation-octagon"></i>
                                                @riesgosMaquina riesgo(s)
                                            </span>
                                        }

                                        @if (accionMaquina > 0)
                                        {
                                            <span class="mini-count warning">
                                                <i class="bi bi-lightning-charge"></i>
                                                @accionMaquina atender
                                            </span>
                                        }

                                        @if (enCursoMaquina > 0)
                                        {
                                            <span class="mini-count process">
                                                <i class="bi bi-hourglass-split"></i>
                                                @enCursoMaquina en curso
                                            </span>
                                        }

                                        @if (programadasMaquina > 0)
                                        {
                                            <span class="mini-count scheduled">
                                                <i class="bi bi-calendar-event"></i>
                                                @programadasMaquina próxima(s)
                                            </span>
                                        }

                                        <span class="overall @claseMaquina">
                                            @estadoMaquina
                                        </span>
                                    </div>

                                    <span class="chevron">
                                        <i class="bi bi-chevron-down"></i>
                                    </span>
                                </button>
                            </h2>

                            <div id="@collapseId"
                                 class="accordion-collapse collapse"
                                 aria-labelledby="@headingId"
                                 data-bs-parent="#accordionMaquinas">

                                <div class="accordion-body machine-body">
                                    @foreach (var programa in programas)
                                    {
                                        var estadoPrograma = EstadoGeneral(programa);
                                        var clasePrograma = EstadoGeneralClase(estadoPrograma);
                                        var arranque = ArranquePrograma(programa);
                                        var of = OfPrograma(programa);
                                        var parte = PartePrograma(programa);

                                        var riesgosPrograma = programa.Count(EsRiesgo);
                                        var enCursoPrograma = programa.Count(EsEnCurso);
                                        var accionPrograma = programa.Count(x =>
                                        x.EstaPendiente &&
                                        (x.EsHacerAhora || x.EsVencida || SecadoLlegariaTarde(x)));
                                        var totalActividadesPrograma = programa.Count();

                                        <details class="program-block @clasePrograma">
                                            <summary class="program-head">
                                                <div class="program-of">
                                                    <span class="level-kicker level-of">NIVEL 2 · ORDEN DE FABRICACIÓN</span>
                                                    <strong>OF @of</strong>
                                                    <span>@parte</span>
                                                </div>

                                                <div class="program-info">
                                                    <strong>Programa #@programa.Key</strong>
                                                    <span>@programa.First().CantidadProgramada.ToString("N0") pza programadas</span>
                                                </div>

                                                <div class="program-info arranque-info">
                                                    <strong>@Fecha(arranque)</strong>
                                                    <span>Arranque programado</span>
                                                </div>

                                                <div class="program-counters">
                                                    @if (riesgosPrograma > 0)
                                                    {
                                                        <span class="mini-count risk">
                                                            <i class="bi bi-exclamation-octagon"></i>
                                                            @riesgosPrograma riesgo(s)
                                                        </span>
                                                    }
                                                    @if (accionPrograma > 0)
                                                    {
                                                        <span class="mini-count warning">
                                                            <i class="bi bi-lightning-charge"></i>
                                                            @accionPrograma atender
                                                        </span>
                                                    }
                                                    @if (enCursoPrograma > 0)
                                                    {
                                                        <span class="mini-count process">
                                                            <i class="bi bi-hourglass-split"></i>
                                                            @enCursoPrograma en curso
                                                        </span>
                                                    }
                                                    @if (riesgosPrograma == 0 && accionPrograma == 0 && enCursoPrograma == 0)
                                                    {
                                                        <span class="mini-count scheduled">
                                                            <i class="bi bi-list-check"></i>
                                                            @totalActividadesPrograma actividad(es)
                                                        </span>
                                                    }
                                                    <span class="overall @clasePrograma">@estadoPrograma</span>
                                                </div>

                                                <span class="program-chevron">
                                                    <i class="bi bi-chevron-down"></i>
                                                </span>
                                            </summary>

                                            <div class="program-tasks">
                                                <div class="task-level-title">
                                                    <span class="task-level-line"></span>
                                                    <span class="level-kicker level-task">NIVEL 3 · ACTIVIDADES</span>
                                                    <span>Preparaciones de esta OF</span>
                                                </div>

                                                <div class="task-table-wrap">
                                                    <table class="task-table">
                                                        <thead>
                                                            <tr>
                                                                <th>Actividad</th>
                                                                <th>Preparación requerida</th>
                                                                <th>Estado</th>
                                                                <th>Atender desde</th>
                                                                <th>Objetivo</th>
                                                                <th>Acción</th>
                                                            </tr>
                                                        </thead>

                                                        <tbody>
                                                            @foreach (var tarea in programa
                                                                                                            .OrderBy(x =>
                                                                                                            x.EsCambioMolde ? 1 :
                                                                                                            x.EsMateriaPrima ? 2 :
                                                                                                            x.EsSecadoMaterial ? 3 :
                                                                                                            x.EsPreparacionEmbalaje ? 4 : 5))
                                                            {
                                                                var claseFila = EsRiesgo(tarea)
                                                                ? "task-risk"
                                                                : tarea.EstaPendiente && tarea.EsHacerAhora
                                                                ? "task-warning"
                                                                : "";

                                                                <tr class="task-row task-@TipoClase(tarea) @claseFila">
                                                                    <td>
                                                                        <div class="activity-cell">
                                                                            <span class="activity-bullet">
                                                                                <i class="bi @TipoIcono(tarea)"></i>
                                                                            </span>
                                                                            <div>
                                                                                <span class="activity-kicker">ACTIVIDAD</span>
                                                                                <span class="type @TipoClase(tarea)">@TipoNombre(tarea)</span>
                                                                            </div>
                                                                        </div>
                                                                    </td>

                                                                    <td>
                                                                        <div class="task-detail">
                                                                            <strong>@TituloTarea(tarea)</strong>
                                                                            <span>@SubtituloTarea(tarea)</span>
                                                                        </div>
                                                                    </td>

                                                                    <td>
                                                                        <span class="state @EstadoClase(tarea)">
                                                                            @EstadoTarea(tarea)
                                                                        </span>
                                                                    </td>

                                                                    <td>
                                                                        <span class="time-main">@Fecha(tarea.FechaAviso)</span>
                                                                        @if (tarea.EstaPendiente)
                                                                        {
                                                                            <span class="time-sub">@tarea.TextoTiempo</span>
                                                                        }
                                                                    </td>

                                                                    <td>
                                                                        <span class="time-main">@Fecha(tarea.FechaObjetivo)</span>
                                                                        @if (tarea.FechaArranque.HasValue)
                                                                        {
                                                                            <span class="time-sub">
                                                                                Arranque @Hora(tarea.FechaArranque)
                                                                            </span>
                                                                        }
                                                                    </td>

                                                                    <td class="task-action">
                                                                        @if (!tarea.EstaConfirmada || SecadoEnProceso(tarea))
                                                                        {
                                                                            <a class="btnx btnx-primary"
                                                                               href="@UrlTarea(tarea)">
                                                                                Atender
                                                                                <i class="bi bi-arrow-right"></i>
                                                                            </a>
                                                                        }
                                                                        else if (tarea.EjecucionProduccionID.HasValue)
                                                                        {
                                                                            <a class="btnx btnx-outline"
                                                                               asp-controller="Produccion"
                                                                               asp-action="Detalle"
                                                                               asp-route-id="@tarea.EjecucionProduccionID.Value">
                                                                                Ver OF
                                                                            </a>
                                                                        }
                                                                        else
                                                                        {
                                                                            <span class="state ready">Listo</span>
                                                                        }
                                                                    </td>
                                                                </tr>
                                                            }
                                                        </tbody>
                                                    </table>
                                                </div>
                                            </div>
                                        </details>
                                    }
                                </div>
                            </div>
                        </div>
                    }
                </div>
            }
            else
            {
                <div class="empty">
                    <i class="bi bi-check2-circle"></i>
                    <strong>No hay preparaciones operativas con los filtros actuales</strong>
                    <span>Las tareas se generan automáticamente desde Planeación.</span>
                </div>
            }

            @if (tareasSinMaquina.Any())
            {
                <div class="warning-line">
                    <i class="bi bi-exclamation-triangle me-1"></i>
                    Hay @tareasSinMaquina.Count tarea(s) sin máquina asociada.
                    Conviene corregir su programa en Planeación.
                </div>
            }
        </div>
    </details>

    <details class="section-shell">
        <summary>
            <span class="section-icon"
                  style="background:var(--blueSoft);color:var(--blue)">
                <i class="bi bi-speedometer2"></i>
            </span>

            <span class="section-summary-title">
                <strong>Estado operativo por máquina</strong>
                <span>Resumen de la próxima OF de cada máquina: materia prima, secado, embalaje, cambio de molde y preparación general.</span>
            </span>

            <span class="section-count">@gruposMaquina.Count</span>

            <span class="section-chevron">
                <i class="bi bi-chevron-down"></i>
            </span>
        </summary>

        <div class="section-content">
            @if (gruposMaquina.Any())
            {
                <div class="table-wrap">
                    <table class="ops-table">
                        <thead>
                            <tr>
                                <th>Máquina</th>
                                <th>Próxima OF</th>
                                <th>Materia prima</th>
                                <th>Secado</th>
                                <th>Embalaje</th>
                                <th>Cambio de molde</th>
                                <th>Próximo arranque</th>
                                <th>Preparación</th>
                            </tr>
                        </thead>

                        <tbody>
                            @foreach (var grupo in gruposMaquina)
                            {
                                var programas = grupo
                                .GroupBy(x => x.ProgramaProduccionID)
                                .Where(ProgramaEsOperativo)
                                .OrderBy(x =>
                                ArranquePrograma(x) ??
                                x.Min(y => y.FechaObjetivo))
                                .ThenBy(x => x.Key)
                                .ToList();

                                var programaReferencia = programas.FirstOrDefault();

                                var materiaPrima = programaReferencia == null
                                ? null
                                : TareaDelPrograma(
                                programaReferencia,
                                ProduccionPreparacionTipo.MateriaPrima);

                                var secado = programaReferencia == null
                                ? null
                                : TareaDelPrograma(
                                programaReferencia,
                                ProduccionPreparacionTipo.SecadoMaterial);

                                var embalaje = programaReferencia == null
                                ? null
                                : TareaDelPrograma(
                                programaReferencia,
                                ProduccionPreparacionTipo.PrepararEmbalaje);

                                var molde = programaReferencia == null
                                ? null
                                : TareaDelPrograma(
                                programaReferencia,
                                ProduccionPreparacionTipo.CambioMolde);

                                var estadoGeneral = programaReferencia == null
                                ? EstadoGeneral(grupo)
                                : EstadoGeneral(programaReferencia);

                                var claseGeneral = EstadoGeneralClase(estadoGeneral);

                                var proximoArranque = programaReferencia == null
                                ? (DateTime?)null
                                : ArranquePrograma(programaReferencia);

                                var proximaOf = programaReferencia == null
                                ? "—"
                                : OfPrograma(programaReferencia);

                                <tr class="@(claseGeneral == "risk" ? "row-risk" : "")">
                                    <td>
                                        <div class="matrix-machine">
                                            <strong>
                                                @(string.IsNullOrWhiteSpace(grupo.Key.MaquinaCodigo)
                                                                                        ? "Sin código"
                                                                                        : grupo.Key.MaquinaCodigo)
                                                                                                              </strong>

                                            <span>
                                                @(string.IsNullOrWhiteSpace(grupo.Key.MaquinaNombre)
                                                                                        ? "Máquina"
                                                                                        : grupo.Key.MaquinaNombre)
                                    </span>
                                </div>
                            </td>

                                    <td>
                                        <strong>@proximaOf</strong>
                                    </td>

                                    <td class="matrix-state">
                                        <span class="state @EstadoClase(materiaPrima)">
                                            @EstadoTarea(materiaPrima)
                                        </span>

                                @if (materiaPrima != null)
                                        {
                                            var requeridaMp = materiaPrima.CantidadMpKg.GetValueOrDefault();
                                            var recibidaMp = materiaPrima.CantidadMpRecibidaProduccionKg;
                                            var pendienteMp = Math.Max(0m, requeridaMp - recibidaMp);

                                            <span class="time-sub">
                                                @pendienteMp.ToString("0.####") KG pendiente(s)
                                            </span>
                                        }
                                    </td>

                                    <td class="matrix-state">
                                        <span class="state @EstadoClase(secado)">
                                            @EstadoTarea(secado)
                                        </span>

                                        @if (secado != null)
                                        {
                                            <span class="time-sub">
                                                @(SecadoEnProceso(secado)
                                                                                    ? $"Listo {Fecha(secado.FechaDisponibleEstimada)}"
                                                                                    : Fecha(secado.FechaAviso))
                                </span>
                                                                }
                                    </td>

                                    <td class="matrix-state">
                                        <span class="state @EstadoClase(embalaje)">
                                            @EstadoTarea(embalaje)
                                        </span>

                                        @if (embalaje != null)
                                        {
                                            <span class="time-sub">@embalaje.TextoEmbalaje</span>
                                        }
                                    </td>

                                    <td class="matrix-state">
                                        <span class="state @EstadoClase(molde)">
                                            @EstadoTarea(molde)
                                        </span>

                                        @if (molde != null)
                                        {
                                            <span class="time-sub">@molde.TextoCambioMolde</span>
                                        }
                                    </td>

                                    <td>
                                        <span class="time-main">@Fecha(proximoArranque)</span>
                                    </td>

                                    <td>
                                        <span class="overall @claseGeneral">
                                            @estadoGeneral
                                        </span>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
            else
            {
                <div class="empty">
                    <i class="bi bi-speedometer2"></i>
                    <strong>No hay máquinas con preparación activa</strong>
                    <span>No se encontraron programas operativos con los filtros actuales.</span>
                </div>
            }
        </div>
    </details>

    <details class="section-shell">
        <summary>
            <span class="section-icon"
                  style="background:var(--orangeSoft);color:var(--orange)">
                <i class="bi bi-calendar-event"></i>
            </span>

            <span class="section-summary-title">
                <strong>Próximas preparaciones</strong>
                <span>Agenda corta de actividades futuras que todavía no requieren intervención.</span>
            </span>

            <span class="section-count">@proximas.Count</span>

            <span class="section-chevron">
                <i class="bi bi-chevron-down"></i>
            </span>
        </summary>

        <div class="section-content">
            @if (proximas.Any())
            {
                <div class="table-wrap">
                    <table class="ops-table">
                        <thead>
                            <tr>
                                <th>Atender desde</th>
                                <th>Máquina</th>
                                <th>OF / Parte</th>
                                <th>Actividad</th>
                                <th>Preparación requerida</th>
                                <th>Arranque</th>
                                <th></th>
                            </tr>
                        </thead>

                        <tbody>
                            @foreach (var tarea in proximas)
                            {
                                <tr>
                                    <td>
                                        <span class="time-main">@Fecha(tarea.FechaAviso)</span>
                                        <span class="time-sub">@tarea.TextoTiempo</span>
                                    </td>

                                    <td>
                                        <div class="matrix-machine">
                                            <strong>
                                                @(string.IsNullOrWhiteSpace(tarea.MaquinaCodigo)
                                                                                        ? "Sin código"
                                                                                        : tarea.MaquinaCodigo)
                                                                                                          </strong>

                                            <span>
                                                @(string.IsNullOrWhiteSpace(tarea.MaquinaNombre)
                                                                                        ? "Máquina"
                                                                                        : tarea.MaquinaNombre)
                                    </span>
                                </div>
                            </td>

                                    <td>
                                        <div class="task-detail">
                                            <strong>
                                                OF @(string.IsNullOrWhiteSpace(tarea.NumeroOF)
                                                                                        ? "—"
                                                                                        : tarea.NumeroOF)
                                    </strong>

                                            <span>@tarea.TextoParte</span>
                                        </div>
                                    </td>

                                    <td>
                                        <span class="type @TipoClase(tarea)">
                                            <i class="bi @TipoIcono(tarea)"></i>
                                            @TipoNombre(tarea)
                                        </span>
                                    </td>

                                    <td>
                                        <div class="task-detail">
                                            <strong>@TituloTarea(tarea)</strong>
                                            <span>@SubtituloTarea(tarea)</span>
                                        </div>
                                    </td>

                                    <td>
                                        <span class="time-main">@Fecha(tarea.FechaArranque)</span>
                                    </td>

                                    <td style="text-align:right">
                                        <a class="btnx btnx-outline"
                                           href="@UrlTarea(tarea)">
                                            Ver
                                            <i class="bi bi-arrow-right"></i>
                                        </a>
                                    </td>
                                </tr>
                                                }
                        </tbody>
                    </table>
                </div>
            }
            else
            {
                <div class="empty">
                    <i class="bi bi-calendar-check"></i>
                    <strong>No hay preparaciones próximas</strong>
                    <span>No hay tareas futuras pendientes con los filtros actuales.</span>
                </div>
            }
        </div>
    </details>

    <div class="footer-note">
        <span>
            Todo inicia contraído. El usuario decide qué sección y qué máquina necesita desplegar.
        </span>

        <span>
            Actualizado: @Model.FechaConsulta.ToString("dd/MM/yyyy HH:mm:ss")
        </span>
    </div>
</div>

<script>
    (function () {
        const page = document.getElementById('prepOperativa');
        const clock = document.getElementById('liveClock');
        const date = document.getElementById('liveDate');
        const soloAtencion = document.getElementById('soloAtencion');
        const maquinas = Array.from(
            document.querySelectorAll('.js-machine'));

        if (!page) return;

        // Jerarquía: Máquina > OF > Actividad.
        // Las máquinas y las OF siempre inician cerradas.
        document.querySelectorAll('#accordionMaquinas .accordion-collapse').forEach(function (panel) {
            panel.classList.remove('show');
        });
        document.querySelectorAll('#accordionMaquinas .accordion-button').forEach(function (button) {
            button.classList.add('collapsed');
            button.setAttribute('aria-expanded', 'false');
        });
        document.querySelectorAll('#accordionMaquinas .program-block').forEach(function (detalle) {
            detalle.removeAttribute('open');
            detalle.addEventListener('toggle', function () {
                if (!detalle.open) return;
                const contenedor = detalle.closest('.machine-body');
                contenedor?.querySelectorAll('.program-block[open]').forEach(function (otro) {
                    if (otro !== detalle) otro.removeAttribute('open');
                });
            });
        });
        document.querySelectorAll('#accordionMaquinas .accordion-collapse').forEach(function (panel) {
            panel.addEventListener('hidden.bs.collapse', function () {
                panel.querySelectorAll('.program-block[open]').forEach(function (detalle) {
                    detalle.removeAttribute('open');
                });
            });
        });

        const serverNow = Date.parse(
            page.dataset.serverNow || '');

        const offset = Number.isFinite(serverNow)
            ? serverNow - Date.now()
            : 0;

        function updateClock() {
            if (!clock || !date) return;

            const now = new Date(
                Date.now() + offset);

            clock.textContent =
                now.toLocaleTimeString('es-MX', {
                    hour: '2-digit',
                    minute: '2-digit',
                    second: '2-digit',
                    hour12: false
                });

            date.textContent =
                now.toLocaleDateString('es-MX', {
                    weekday: 'long',
                    day: '2-digit',
                    month: '2-digit',
                    year: 'numeric'
                });
        }

        function aplicarFiltroAtencion() {
            const solo = !!soloAtencion?.checked;

            maquinas.forEach(function (maquina) {
                const requiere =
                    maquina.dataset.attention === '1';

                maquina.classList.toggle(
                    'is-hidden',
                    solo && !requiere);
            });
        }

        soloAtencion?.addEventListener(
            'change',
            aplicarFiltroAtencion);

        updateClock();
        aplicarFiltroAtencion();

        window.setInterval(
            updateClock,
            1000);
    })();
</script>
