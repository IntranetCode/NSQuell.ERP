@using ERP.NSQuell.Models
@using System
@using System.Collections.Generic
@using System.Linq
@model ProduccionPreparacionIndexVm
@{
    Layout = "_Layout";
    ViewData["Title"] = "Preparación de Producción";

    var todas = (Model.Tareas ?? new List<ProduccionPreparacionTareaVm>())
        .Where(x => !x.EstaCancelada)
        .ToList();

    bool SecadoEnProceso(ProduccionPreparacionTareaVm t) =>
        t.EsSecadoMaterial &&
        t.EstaConfirmada &&
        t.FechaDisponibleEstimada.HasValue &&
        t.FechaDisponibleEstimada.Value > Model.FechaConsulta;

    bool SecadoListo(ProduccionPreparacionTareaVm t) =>
        t.EsSecadoMaterial &&
        t.EstaConfirmada &&
        t.FechaDisponibleEstimada.HasValue &&
        t.FechaDisponibleEstimada.Value <= Model.FechaConsulta;

    bool SecadoLlegariaTarde(ProduccionPreparacionTareaVm t)
    {
        if (!t.EsSecadoMaterial ||
            !t.EstaPendiente ||
            !t.HorasSecado.HasValue ||
            t.HorasSecado.Value <= 0 ||
            !t.FechaArranque.HasValue)
            return false;

        return Model.FechaConsulta
            .AddHours(Convert.ToDouble(t.HorasSecado.Value)) >
            t.FechaArranque.Value;
    }

    bool EsRiesgo(ProduccionPreparacionTareaVm t)
    {
        if (t.EsCambioMolde && t.EstaEnProceso)
        {
            var nivel = (t.NivelAlertaCambioMolde ?? "").Trim().ToUpperInvariant();

            if (nivel == "EXCEDIDO" || nivel == "CRITICO")
                return true;
        }

        if (t.EsSecadoMaterial &&
            (t.SecadoLlegaraTarde || SecadoLlegariaTarde(t)))
            return true;

        return t.EsVencida;
    }

    bool EsEnCurso(ProduccionPreparacionTareaVm t) =>
        t.EstaEnProceso || SecadoEnProceso(t);

    bool ProgramaEsOperativo(IEnumerable<ProduccionPreparacionTareaVm> origen)
    {
        var lista = origen.ToList();

        if (lista.Any(EsRiesgo) ||
            lista.Any(EsEnCurso) ||
            lista.Any(x => x.EstaPendiente))
            return true;

        var arranque = lista
            .Where(x => x.FechaArranque.HasValue)
            .OrderBy(x => x.FechaArranque)
            .Select(x => x.FechaArranque)
            .FirstOrDefault();

        return arranque.HasValue &&
               arranque.Value >= Model.FechaConsulta.AddHours(-2);
    }

    var programasOperativos = todas
        .GroupBy(x => x.ProgramaProduccionID)
        .Where(ProgramaEsOperativo)
        .ToList();

    var tareas = programasOperativos
        .SelectMany(x => x)
        .ToList();

    var gruposMaquina = tareas
        .Where(x => x.MaquinaID.HasValue)
        .GroupBy(x => new
        {
            x.MaquinaID,
            x.MaquinaCodigo,
            x.MaquinaNombre
        })
        .OrderByDescending(x => x.Any(EsRiesgo))
        .ThenByDescending(x => x.Any(EsEnCurso))
        .ThenByDescending(x => x.Any(y => y.EstaPendiente && (y.EsHacerAhora || y.EsVencida)))
        .ThenBy(x => x.Key.MaquinaCodigo)
        .ThenBy(x => x.Key.MaquinaNombre)
        .ToList();

    var proximas = tareas
        .Where(x =>
            x.EstaPendiente &&
            x.EsProxima &&
            !SecadoLlegariaTarde(x))
        .OrderBy(x => x.FechaAviso)
        .ThenBy(x => x.FechaObjetivo)
        .Take(20)
        .ToList();

    var tareasSinMaquina = tareas
        .Where(x => !x.MaquinaID.HasValue)
        .ToList();

    var riesgos = tareas.Count(EsRiesgo);

    var enCurso = tareas.Count(EsEnCurso);

    var requierenAccion = tareas.Count(x =>
        x.EstaPendiente &&
        (
            x.EsHacerAhora ||
            x.EsVencida ||
            SecadoLlegariaTarde(x)
        ));

    var programadas = proximas.Count;

    string Fecha(DateTime? value) =>
        value?.ToString("dd/MM HH:mm") ?? "—";

    string Hora(DateTime? value) =>
        value?.ToString("HH:mm") ?? "—";

    string TipoNombre(ProduccionPreparacionTareaVm t)
    {
        if (t.EsCambioMolde) return "Cambio de molde";
        if (t.EsPreparacionEmbalaje) return "Embalaje";
        if (t.EsSecadoMaterial) return "Secado";
        if (t.EsMateriaPrima) return "Materia prima";

        return "Preparación";
    }

    string TipoIcono(ProduccionPreparacionTareaVm t)
    {
        if (t.EsCambioMolde) return "bi-tools";
        if (t.EsMateriaPrima) return "bi-droplet-half";
        if (t.EsPreparacionEmbalaje) return "bi-box-seam";
        if (t.EsSecadoMaterial) return "bi-thermometer-sun";
        return "bi-gear";
    }

    string TipoClase(ProduccionPreparacionTareaVm t)
    {
        if (t.EsCambioMolde) return "molde";
        if (t.EsMateriaPrima) return "materia-prima";
        if (t.EsPreparacionEmbalaje) return "embalaje";
        if (t.EsSecadoMaterial) return "secado";
        return "";
    }

    string TituloTarea(ProduccionPreparacionTareaVm t)
    {
        if (t.EsCambioMolde) return t.TextoCambioMolde;
        if (t.EsMateriaPrima) return t.TextoMaterial;
        if (t.EsPreparacionEmbalaje) return t.TextoEmbalaje;
        if (t.EsSecadoMaterial) return t.TextoMaterial;
        return t.TipoTareaNombre;
    }

    string SubtituloTarea(ProduccionPreparacionTareaVm t)
    {
        if (t.EsCambioMolde)
        {
            if (t.EstaEnProceso)
                return $"{t.MinutosTranscurridosCambioMolde} min transcurridos · límite {t.LimiteCambioMoldeMinutos} min";

            return t.DuracionProgramadaCambioMoldeMinutos.HasValue
                ? $"Programado: {t.DuracionProgramadaCambioMoldeMinutos.Value} min"
                : $"Límite máquina: {t.LimiteCambioMoldeMinutos} min";
        }

        if (t.EsMateriaPrima)
        {
            var requerida = t.CantidadMpKg.GetValueOrDefault();
            var recibida = t.CantidadMpRecibidaProduccionKg;
            var pendiente = Math.Max(0m, requerida - recibida);
            return $"{recibida:0.####} / {requerida:0.####} KG recibidos · faltan {pendiente:0.####} KG";
        }

        if (t.EsPreparacionEmbalaje)
        {
            var cantidad = t.CantidadEmbalajes.HasValue
                ? t.CantidadEmbalajes.Value.ToString(
                    t.CantidadEmbalajes.Value % 1 == 0 ? "N0" : "N2")
                : "—";

            var piezas = t.PiezasPorEmbalaje.HasValue
                ? t.PiezasPorEmbalaje.Value.ToString(
                    t.PiezasPorEmbalaje.Value % 1 == 0 ? "N0" : "N2")
                : "—";

            return $"{cantidad} embalaje(s) · {piezas} pza/embalaje";
        }

        if (t.EsSecadoMaterial)
        {
            if (SecadoEnProceso(t))
                return $"Disponible {Fecha(t.FechaDisponibleEstimada)}";

            var horas = t.HorasSecado.HasValue
                ? $"{t.HorasSecado.Value:0.##} h"
                : "—";

            return $"{(string.IsNullOrWhiteSpace(t.TipoSecado) ? "Secado" : t.TipoSecado)} · {horas}";
        }

        return "";
    }

    string EstadoTarea(ProduccionPreparacionTareaVm? t)
    {
        if (t == null)
            return "No aplica";

        if (t.EsSecadoMaterial)
        {
            if (SecadoEnProceso(t))
                return t.SecadoLlegaraTarde
                    ? "Secando · riesgo"
                    : "Secando";

            if (SecadoListo(t))
                return "Listo";
        }

        if (t.EsCambioMolde && t.EstaEnProceso)
        {
            var nivel = (t.NivelAlertaCambioMolde ?? "").Trim().ToUpperInvariant();

            if (nivel == "EXCEDIDO") return "Límite excedido";
            if (nivel == "CRITICO") return "Crítico";
            if (nivel == "ADVERTENCIA") return "Advertencia";

            return "En proceso";
        }

        if (t.EstaConfirmada) return "Listo";
        if (SecadoLlegariaTarde(t)) return "Riesgo de atraso";
        if (t.EsVencida) return "Vencido";
        if (t.EsHacerAhora) return "Hacer ahora";
        if (t.EsProxima) return "Programado";

        return t.Estado;
    }

    string EstadoClase(ProduccionPreparacionTareaVm? t)
    {
        if (t == null)
            return "na";

        if (t.EsSecadoMaterial)
        {
            if (SecadoEnProceso(t))
                return t.SecadoLlegaraTarde
                    ? "risk"
                    : "process";

            if (SecadoListo(t))
                return "ready";
        }

        if (t.EsCambioMolde && t.EstaEnProceso)
        {
            var nivel = (t.NivelAlertaCambioMolde ?? "").Trim().ToUpperInvariant();

            if (nivel == "EXCEDIDO" || nivel == "CRITICO")
                return "risk";

            if (nivel == "ADVERTENCIA")
                return "warning";

            return "process";
        }

        if (t.EstaConfirmada) return "ready";
        if (SecadoLlegariaTarde(t) || t.EsVencida) return "risk";
        if (t.EsHacerAhora) return "warning";
        if (t.EsProxima) return "scheduled";

        return "na";
    }

    string UrlTarea(ProduccionPreparacionTareaVm t)
    {
        var filtro = string.IsNullOrWhiteSpace(t.NumeroOF)
            ? Model.Filtro
            : t.NumeroOF;

        if (t.EsCambioMolde)
            return Url.Action(
                "CambioMolde",
                "ProduccionPreparacion",
                new { maquinaId = t.MaquinaID, filtro }) ?? "#";

        if (t.EsMateriaPrima)
            return Url.Action(
                "Materiales",
                "ProduccionPreparacion",
                new { maquinaId = t.MaquinaID, filtro }) ?? "#";

        if (t.EsPreparacionEmbalaje)
            return Url.Action(
                "Embalajes",
                "ProduccionPreparacion",
                new { maquinaId = t.MaquinaID, filtro }) ?? "#";

        if (t.EsSecadoMaterial)
            return Url.Action(
                "Secado",
                "ProduccionPreparacion",
                new { maquinaId = t.MaquinaID, filtro }) ?? "#";

        return "#";
    }

    string EstadoGeneral(IEnumerable<ProduccionPreparacionTareaVm> origen)
    {
        var lista = origen.ToList();

        if (lista.Any(EsRiesgo)) return "RIESGO";
        if (lista.Any(EsEnCurso)) return "EN PROCESO";

        if (lista.Any(x =>
            x.EstaPendiente &&
            (x.EsHacerAhora || x.EsVencida)))
            return "ATENDER";

        if (lista.Any(x => x.EstaPendiente))
            return "PROGRAMADA";

        return "LISTA";
    }

    string EstadoGeneralClase(string estado)
    {
        return estado switch
        {
            "RIESGO" => "risk",
            "EN PROCESO" => "process",
            "ATENDER" => "warning",
            "PROGRAMADA" => "scheduled",
            _ => "ready"
        };
    }

    DateTime? ArranquePrograma(
        IEnumerable<ProduccionPreparacionTareaVm> origen) =>
        origen
            .Where(x => x.FechaArranque.HasValue)
            .OrderBy(x => x.FechaArranque)
            .Select(x => x.FechaArranque)
            .FirstOrDefault();

    string OfPrograma(
        IEnumerable<ProduccionPreparacionTareaVm> origen) =>
        origen
            .Where(x => !string.IsNullOrWhiteSpace(x.NumeroOF))
            .Select(x => x.NumeroOF!)
            .FirstOrDefault() ?? "—";

    string PartePrograma(
        IEnumerable<ProduccionPreparacionTareaVm> origen) =>
        origen
            .Select(x => x.TextoParte)
            .FirstOrDefault(x => !string.IsNullOrWhiteSpace(x))
        ?? "Sin parte";

    ProduccionPreparacionTareaVm? TareaDelPrograma(
        IEnumerable<ProduccionPreparacionTareaVm> programa,
        string tipoTarea)
    {
        var lista = programa
            .Where(x =>
                string.Equals(
                    x.TipoTarea,
                    tipoTarea,
                    StringComparison.OrdinalIgnoreCase))
            .ToList();

        if (tipoTarea == ProduccionPreparacionTipo.SecadoMaterial)
        {
            var secando = lista
                .Where(SecadoEnProceso)
                .OrderBy(x => x.FechaDisponibleEstimada)
                .FirstOrDefault();

            if (secando != null)
                return secando;
        }

        var enProceso = lista
            .Where(x => x.EstaEnProceso)
            .OrderBy(x => x.FechaInicioReal)
            .FirstOrDefault();

        if (enProceso != null)
            return enProceso;

        var pendiente = lista
            .Where(x => x.EstaPendiente)
            .OrderBy(x => x.FechaObjetivo)
            .FirstOrDefault();

        if (pendiente != null)
            return pendiente;

        return lista
            .Where(x => x.EstaConfirmada)
            .OrderByDescending(x => x.FechaConfirmacion)
            .FirstOrDefault();
    }

    var filtroActual = string.IsNullOrWhiteSpace(Model.Filtro)
        ? ""
        : Model.Filtro;
}

<link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.css"
      rel="stylesheet" />

<style>
    :root {
        --bg: #f4f7fb;
        --panel: #fff;
        --text: #14213f;
        --muted: #6f7b91;
        --line: #dbe4ef;
        --purple: #6845db;
        --purpleSoft: #f3efff;
        --blue: #365fda;
        --blueSoft: #eef3ff;
        --orange: #c77800;
        --orangeSoft: #fff6e3;
        --red: #c8332d;
        --redSoft: #fff1f0;
        --green: #1f7d4f;
        --greenSoft: #edf9f2;
        --graySoft: #f1f4f8;
        --shadow: 0 10px 28px rgba(16,35,76,.06);
    }

    html[data-nsq-theme="dark"],
    html[data-bs-theme="dark"] {
        --bg: #0b1220;
        --panel: #111b2d;
        --text: #e8eef8;
        --muted: #9aa9bd;
        --line: #2d3e55;
        --purpleSoft: #241b38;
        --blueSoft: #102b4c;
        --orangeSoft: #2b2313;
        --redSoft: #351719;
        --greenSoft: #102a20;
        --graySoft: #17263c;
        --shadow: 0 10px 28px rgba(0,0,0,.18);
    }

    .prep-page {
        min-height: 100vh;
        padding: 16px;
        background: var(--bg);
        color: var(--text);
    }

    .prep-head {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 16px;
        padding: 16px 18px;
        border-radius: 18px;
        background: linear-gradient(120deg,#17275d,#3e399b 68%,#6555de);
        color: #fff;
        box-shadow: 0 16px 38px rgba(35,43,124,.18);
    }

    .prep-brand {
        display: flex;
        align-items: center;
        gap: 13px;
        min-width: 0;
    }

    .prep-brand-icon {
        width: 48px;
        height: 48px;
        border-radius: 14px;
        display: grid;
        place-items: center;
        background: rgba(255,255,255,.13);
        font-size: 1.25rem;
        flex: none;
    }

    .prep-head h1 {
        margin: 0;
        font-size: 1.3rem;
        font-weight: 950;
    }

    .prep-head p {
        margin: 3px 0 0;
        font-size: .75rem;
        color: rgba(255,255,255,.78);
        font-weight: 650;
    }

    .prep-head-right {
        display: flex;
        align-items: center;
        gap: 12px;
        flex-wrap: wrap;
        justify-content: flex-end;
    }

    .prep-clock {
        text-align: right;
        line-height: 1.1;
    }

        .prep-clock strong {
            display: block;
            font-size: 1rem;
            font-weight: 950;
        }

        .prep-clock span {
            display: block;
            margin-top: 3px;
            font-size: .61rem;
            color: rgba(255,255,255,.72);
            font-weight: 750;
        }

    .btnx {
        min-height: 38px;
        border-radius: 10px;
        border: 1px solid #ccd7e5;
        background: #fff;
        color: #203150;
        padding: 7px 11px;
        text-decoration: none;
        font-size: .7rem;
        font-weight: 900;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: 6px;
        cursor: pointer;
        white-space: nowrap;
    }

    .btnx-light {
        background: rgba(255,255,255,.11);
        border-color: rgba(255,255,255,.25);
        color: #fff;
    }

        .btnx-light:hover {
            background: #fff;
            color: #2b3994;
        }

    .btnx-primary {
        background: var(--purple);
        border-color: var(--purple);
        color: #fff;
    }

    .btnx-outline {
        background: var(--panel);
        border-color: var(--line);
        color: var(--text);
    }

    .module-nav {
        margin-top: 11px;
        display: flex;
        gap: 7px;
        overflow: auto;
        padding-bottom: 3px;
    }

    .module-link {
        flex: 0 0 auto;
        min-height: 38px;
        border: 1px solid var(--line);
        border-radius: 10px;
        background: var(--panel);
        color: var(--text);
        padding: 7px 11px;
        text-decoration: none;
        font-size: .69rem;
        font-weight: 900;
        display: inline-flex;
        align-items: center;
        gap: 7px;
    }

        .module-link.molde i {
            color: var(--purple)
        }

        .module-link.embalaje i {
            color: var(--blue)
        }

        .module-link.secado i {
            color: var(--orange)
        }

        .module-link.historial i {
            color: var(--green)
        }

    .status-strip {
        margin-top: 11px;
        display: flex;
        background: var(--panel);
        border: 1px solid var(--line);
        border-radius: 13px;
        overflow: auto;
    }

    .status-item {
        flex: 1;
        min-width: 145px;
        padding: 9px 14px;
        border-left: 1px solid var(--line);
        display: flex;
        align-items: center;
        gap: 9px;
    }

        .status-item:first-child {
            border-left: 0;
        }

    .status-dot {
        width: 9px;
        height: 9px;
        border-radius: 50%;
        flex: none;
    }

        .status-dot.red {
            background: var(--red)
        }

        .status-dot.orange {
            background: var(--orange)
        }

        .status-dot.purple {
            background: var(--purple)
        }

        .status-dot.blue {
            background: var(--blue)
        }

    .status-item strong {
        display: block;
        font-size: .87rem;
        line-height: 1;
        font-weight: 950;
    }

    .status-item span {
        display: block;
        margin-top: 3px;
        font-size: .57rem;
        color: var(--muted);
        font-weight: 850;
        text-transform: uppercase;
    }

    .flash {
        margin-top: 10px;
        border-radius: 12px;
        padding: 10px 12px;
        font-size: .75rem;
        font-weight: 800;
    }

    .filters {
        margin-top: 11px;
        padding: 10px 12px;
        display: grid;
        grid-template-columns: minmax(240px,1fr) 260px auto auto auto;
        gap: 9px;
        align-items: end;
        background: var(--panel);
        border: 1px solid var(--line);
        border-radius: 13px;
    }

    .field label {
        display: block;
        margin-bottom: 4px;
        color: var(--muted);
        font-size: .58rem;
        font-weight: 950;
        text-transform: uppercase;
    }

    .field input,
    .field select {
        width: 100%;
        min-height: 38px;
        border: 1px solid var(--line);
        border-radius: 9px;
        background: var(--panel);
        color: var(--text);
        padding: 7px 9px;
        font-size: .72rem;
        font-weight: 750;
    }

    .attention-toggle {
        min-height: 38px;
        display: inline-flex;
        align-items: center;
        gap: 8px;
        padding: 7px 11px;
        border: 1px solid var(--line);
        border-radius: 9px;
        background: var(--panel);
        font-size: .67rem;
        font-weight: 900;
        white-space: nowrap;
        cursor: pointer;
    }

        .attention-toggle input {
            width: 15px;
            height: 15px;
            accent-color: var(--purple);
        }

    .section-shell {
        margin-top: 12px;
        border: 1px solid var(--line);
        border-radius: 13px;
        background: var(--panel);
        box-shadow: var(--shadow);
        overflow: hidden;
    }

        .section-shell > summary {
            list-style: none;
            cursor: pointer;
            min-height: 54px;
            display: grid;
            grid-template-columns: 36px minmax(0,1fr) auto 28px;
            gap: 10px;
            align-items: center;
            padding: 9px 12px;
            background: var(--panel);
        }

        .section-shell[open] > summary {
            background: var(--graySoft);
            border-bottom: 1px solid var(--line);
        }

    .section-icon {
        width: 34px;
        height: 34px;
        border-radius: 10px;
        display: grid;
        place-items: center;
        background: var(--purpleSoft);
        color: var(--purple);
    }

    .section-summary-title strong {
        display: block;
        font-size: .78rem;
        font-weight: 950;
    }

    .section-summary-title span {
        display: block;
        margin-top: 2px;
        color: var(--muted);
        font-size: .58rem;
        font-weight: 700;
    }

    .section-count {
        min-width: 30px;
        height: 26px;
        padding: 0 8px;
        border-radius: 999px;
        background: var(--graySoft);
        color: var(--text);
        display: grid;
        place-items: center;
        font-size: .62rem;
        font-weight: 950;
    }

    .section-chevron {
        color: var(--muted);
        text-align: center;
        transition: transform .18s ease;
    }

    .section-shell[open] .section-chevron {
        transform: rotate(180deg);
    }

    .section-content {
        padding: 10px;
        background: var(--bg);
    }

    .machine-list {
        display: grid;
        gap: 9px;
    }

    .machine-accordion {
        border: 1px solid var(--line) !important;
        border-radius: 12px !important;
        overflow: hidden;
        background: var(--panel);
    }

        .machine-accordion.is-hidden {
            display: none;
        }

    .machine-button {
        width: 100%;
        min-height: 60px;
        padding: 9px 11px;
        background: var(--panel) !important;
        color: var(--text) !important;
        display: grid !important;
