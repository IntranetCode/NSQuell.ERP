        }

        .stats {
            grid-template-columns: repeat(2,minmax(0,1fr))
        }

        .filters {
            grid-template-columns: 1fr
        }

        .mold-flow {
            grid-template-columns: 1fr
        }

        .mold-arrow {
            transform: rotate(90deg)
        }

        .info-grid {
            grid-template-columns: 1fr 1fr
        }

        .finalize-grid {
            grid-template-columns: 1fr
        }

        .history-card {
            grid-template-columns: 1fr 1fr
        }
    }
</style>

<div class="prep-page" id="cambioMoldePage" data-estado-url="@Url.Action("EstadoCambioMolde", "ProduccionPreparacion")">
    <section class="prep-hero">
        <div class="prep-hero-main">
            <div class="prep-hero-icon"><i class="bi bi-tools"></i></div>
            <div>
                <h1>Cambios de molde</h1>
                <p>Control operativo SMED: cambio programado, inicio real, cronómetro, límite por máquina y cierre con trazabilidad.</p>
            </div>
        </div>

        <div class="hero-actions">
            <a class="btnx btnx-light" asp-controller="ProduccionPreparacion" asp-action="Index">
                <i class="bi bi-grid-1x2"></i> Tablero
            </a>
            <a class="btnx btnx-light" asp-controller="ProduccionPreparacion" asp-action="Embalajes">
                <i class="bi bi-box-seam"></i> Embalajes
            </a>
            <a class="btnx btnx-light" asp-controller="ProduccionPreparacion" asp-action="Secado">
                <i class="bi bi-thermometer-sun"></i> Secado
            </a>
            <a class="btnx btnx-light" asp-controller="ProduccionPreparacion" asp-action="Historial">
                <i class="bi bi-clock-history"></i> Historial
            </a>
            <a class="btnx btnx-light" asp-controller="Produccion" asp-action="Index">
                <i class="bi bi-arrow-left"></i> Producción
            </a>
        </div>
    </section>

    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success flash">
            <i class="bi bi-check-circle me-1"></i>@TempData["Success"]
        </div>
    }

    @if (TempData["Warning"] != null)
    {
        <div class="alert alert-warning flash">
            <i class="bi bi-exclamation-triangle me-1"></i>@TempData["Warning"]
        </div>
    }

    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger flash">
            <i class="bi bi-exclamation-octagon me-1"></i>@TempData["Error"]
        </div>
    }

    <div class="critical-banner" id="criticalBanner">
        <i class="bi bi-exclamation-triangle-fill fs-5"></i>
        <div>
            <strong id="criticalBannerTitle">Cambios de molde requieren atención</strong>
            <div id="criticalBannerText"></div>
        </div>
    </div>

    <section class="stats">
        <div class="stat-card">
            <div class="stat-icon purple"><i class="bi bi-hourglass-split"></i></div>
            <div><span class="stat-value">@enProceso.Count</span><span class="stat-label">En proceso</span></div>
        </div>
        <div class="stat-card">
            <div class="stat-icon red"><i class="bi bi-exclamation-circle"></i></div>
            <div><span class="stat-value">@vencidas</span><span class="stat-label">Vencidos</span></div>
        </div>
        <div class="stat-card">
            <div class="stat-icon orange"><i class="bi bi-lightning-charge"></i></div>
            <div><span class="stat-value">@hacerAhora</span><span class="stat-label">Hacer ahora</span></div>
        </div>
        <div class="stat-card">
            <div class="stat-icon blue"><i class="bi bi-calendar-event"></i></div>
            <div><span class="stat-value">@proximas</span><span class="stat-label">Próximos</span></div>
        </div>
        <div class="stat-card">
            <div class="stat-icon green"><i class="bi bi-check2-circle"></i></div>
            <div><span class="stat-value">@fueraEstandar</span><span class="stat-label">Fuera de estándar</span></div>
        </div>
    </section>

    <form method="get" asp-controller="ProduccionPreparacion" asp-action="CambioMolde" class="filters">
        <div class="field">
            <label>Buscar</label>
            <input type="text" name="filtro" value="@filtroActual" placeholder="OF, parte, molde o máquina..." />
        </div>

        <div class="field">
            <label>Máquina</label>
            <select name="maquinaId">
                <option value="">Todas las máquinas</option>
                @foreach (var maquina in Model.Maquinas)
                {
                    if (Model.MaquinaID == maquina.MaquinaID)
                    {
                        <option value="@maquina.MaquinaID" selected>@maquina.Texto · @maquina.TextoLimiteCambioMolde</option>
                    }
                    else
                    {
                        <option value="@maquina.MaquinaID">@maquina.Texto · @maquina.TextoLimiteCambioMolde</option>
                    }
                }
            </select>
        </div>

        <button class="btnx btnx-primary" type="submit">
            <i class="bi bi-search"></i> Filtrar
        </button>

        <a class="btnx btnx-outline" asp-controller="ProduccionPreparacion" asp-action="CambioMolde">
            <i class="bi bi-arrow-counterclockwise"></i> Limpiar
        </a>
    </form>

    <section class="section">
        <div class="section-head">
            <div>
                <h2>Cambios en proceso</h2>
                <p>El tiempo se actualiza automáticamente y la alerta depende del límite configurado para cada máquina.</p>
            </div>
            <span class="section-count">@enProceso.Count</span>
        </div>

        @if (enProceso.Any())
        {
            <div class="running-grid">
                @foreach (var tarea in enProceso)
                {
                    var claseNivel = ClaseNivel(tarea.NivelAlertaCambioMolde);
                    var porcentaje = tarea.LimiteCambioMoldeMinutos > 0
                    ? Math.Min(100, Math.Round((decimal)tarea.MinutosTranscurridosCambioMolde * 100m / tarea.LimiteCambioMoldeMinutos, 0))
                    : 0;

                    <article class="change-card js-cambio-en-proceso @claseNivel"
                             data-cambio-id="@tarea.PreparacionAnticipadaID"
                             data-limite="@tarea.LimiteCambioMoldeMinutos"
                             data-level="@tarea.NivelAlertaCambioMolde">
                        <div class="change-top">
                            <div class="machine">
                                <div class="machine-icon"><i class="bi bi-gear-wide-connected"></i></div>
                                <div>
                                    <strong>@tarea.TextoMaquina</strong>
                                    <small>OF @(string.IsNullOrWhiteSpace(tarea.NumeroOF) ? "—" : tarea.NumeroOF) · @tarea.TextoParte</small>
                                </div>
                            </div>

                            <span class="status-pill js-level-badge @(tarea.NivelAlertaCambioMolde == "EXCEDIDO" ? "exceeded" : tarea.NivelAlertaCambioMolde == "CRITICO" ? "critical" : tarea.NivelAlertaCambioMolde == "ADVERTENCIA" ? "warning" : "normal")">
                                @TextoNivel(tarea.NivelAlertaCambioMolde)
                            </span>
                        </div>

                        <div class="change-body">
                            <div class="mold-flow">
                                <div class="mold-box">
                                    <span>Molde anterior</span>
                                    <strong>@(string.IsNullOrWhiteSpace(tarea.MoldeAnteriorCodigo) ? "Sin dato" : tarea.MoldeAnteriorCodigo)</strong>
                                </div>
                                <div class="mold-arrow"><i class="bi bi-arrow-right"></i></div>
                                <div class="mold-box">
                                    <span>Molde nuevo</span>
                                    <strong>@(string.IsNullOrWhiteSpace(tarea.MoldeCodigo) ? "Sin dato" : tarea.MoldeCodigo)</strong>
                                </div>
                            </div>

                            <div class="info-grid">
                                <div class="info"><span>Cambio programado</span><strong>@Fecha(tarea.FechaCambioMolde)</strong></div>
                                <div class="info"><span>Arranque programado</span><strong>@Fecha(tarea.FechaArranque)</strong></div>
                                <div class="info"><span>Inicio real</span><strong>@Fecha(tarea.FechaInicioReal)</strong></div>
                                <div class="info"><span>Límite máquina</span><strong>@TextoLimite(tarea.LimiteCambioMoldeMinutos)</strong></div>
                            </div>

                            <div class="timer-box">
                                <div>
                                    <div class="timer-label">Tiempo transcurrido</div>
                                    <div class="timer-value js-timer">@tarea.MinutosTranscurridosCambioMolde min</div>
                                    <div class="timer-sub js-restante">
                                        @if (tarea.MinutosExcesoCambioMolde > 0)
                                        {
                                            <text>Exceso: @tarea.MinutosExcesoCambioMolde min</text>
                                        }
                                        else
                                        {
                                            <text>Restan @tarea.MinutosRestantesLimiteCambioMolde min antes del límite</text>
                                        }
                                    </div>
                                </div>

                                <div class="timer-limit">
                                    <strong>@TextoLimite(tarea.LimiteCambioMoldeMinutos)</strong>
                                    <span>máximo configurado</span>
                                </div>
                            </div>

                            <div class="progressx"><div class="js-progress" style="width:@porcentaje%"></div></div>

                            @if (Model.PuedeGestionarCambioMolde)
                            {
                                <div class="card-actions">
                                    <button type="button"
                                            class="btnx btnx-success js-toggle-finalizar"
                                            data-target="finalizar-@tarea.PreparacionAnticipadaID">
                                        <i class="bi bi-check2-square"></i> Finalizar cambio
                                    </button>
                                </div>

                                <div class="finalize-panel" id="finalizar-@tarea.PreparacionAnticipadaID">
                                    <form method="post" asp-controller="ProduccionPreparacion" asp-action="FinalizarCambioMolde">
                                        @Html.AntiForgeryToken()
                                        <input type="hidden" name="PreparacionAnticipadaID" value="@tarea.PreparacionAnticipadaID" />

                                        <div class="finalize-grid">
                                            <div class="field">
                                                <label>Observaciones</label>
                                                <textarea name="Observaciones" maxlength="500" placeholder="Observaciones de instalación, ajuste o preparación..."></textarea>
                                            </div>

                                            <div class="field">
                                                <label>Motivo de excedente</label>
                                                <textarea name="MotivoExceso"
                                              maxlength="500"
                                              class="js-motivo-exceso"
                                              placeholder="Obligatorio únicamente si el tiempo real supera el límite de la máquina."></textarea>
                                                <div class="hint js-motivo-hint">
                                                    El sistema exigirá este campo si al finalizar ya se superó el máximo configurado.
                                                </div>
                                            </div>
                                        </div>

                                        <div class="card-actions">
                                            <button class="btnx btnx-success" type="submit">
                                                <i class="bi bi-check-circle"></i> Registrar finalización
                                            </button>
                                            <button class="btnx btnx-outline js-cancel-finalizar"
                                                    type="button"
                                                    data-target="finalizar-@tarea.PreparacionAnticipadaID">
                                                Cancelar
                                            </button>
                                        </div>
                                    </form>
                                </div>
                            }
                        </div>
                    </article>
                }
            </div>
        }
        else
        {
            <div class="empty">
                <i class="bi bi-stopwatch"></i>
                <strong>No hay cambios de molde en proceso</strong>
                <span>Cuando Técnico o SMED inicien una tarea, aparecerá aquí con su cronómetro.</span>
            </div>
        }
    </section>

    <section class="section">
        <div class="section-head">
            <div>
                <h2>Pendientes y próximos</h2>
                <p>Las tareas se agrupan por máquina. Los grupos inician cerrados para mantener la pantalla limpia.</p>
            </div>
            <span class="section-count">@pendientes.Count</span>
        </div>

        @if (pendientes.Any())
        {
            foreach (var grupo in pendientes
            .GroupBy(x => new { x.MaquinaID, x.MaquinaCodigo, x.MaquinaNombre, x.MinutosMaxCambioMolde })
            .OrderBy(x => x.Key.MaquinaCodigo)
            .ThenBy(x => x.Key.MaquinaNombre))
            {
                var tituloMaquina = string.IsNullOrWhiteSpace(grupo.Key.MaquinaNombre)
                ? grupo.Key.MaquinaCodigo ?? "Sin máquina"
                : $"{grupo.Key.MaquinaCodigo} · {grupo.Key.MaquinaNombre}";

                <details class="machine-group">
                    <summary>
                        <div class="group-title">
                            <div class="group-icon"><i class="bi bi-gear-wide-connected"></i></div>
                            <div>
                                <strong>@tituloMaquina</strong>
                                <small>@grupo.Count() cambio(s) · límite @TextoLimite(grupo.Key.MinutosMaxCambioMolde)</small>
                            </div>
                        </div>
                    </summary>

                    <div class="group-body">
                        @foreach (var tarea in grupo.OrderBy(x => x.FechaObjetivo))
                        {
                            <article class="pending-card @ClasePendiente(tarea)">
                                <div class="pending-head">
                                    <div>
                                        <div class="pending-title">OF @(string.IsNullOrWhiteSpace(tarea.NumeroOF) ? "—" : tarea.NumeroOF)</div>
                                        <div class="pending-sub">@tarea.TextoParte · Programa @tarea.ProgramaProduccionID</div>
                                    </div>

                                    <span class="status-pill @(tarea.EsVencida ? "overdue" : tarea.EsHacerAhora ? "now" : "next")">
                                        @TextoPendiente(tarea)
                                    </span>
                                </div>

                                <div class="pending-mold">
                                    <i class="bi bi-arrow-repeat me-1"></i>@tarea.TextoCambioMolde
                                </div>

                                <div class="pending-meta">
                                    <div><span>Cambio</span><strong>@Fecha(tarea.FechaCambioMolde)</strong></div>
                                    <div><span>Arranque</span><strong>@Fecha(tarea.FechaArranque)</strong></div>
                                    <div><span>Límite máquina</span><strong>@TextoLimite(tarea.LimiteCambioMoldeMinutos)</strong></div>
                                    <div><span>Aviso</span><strong>@Fecha(tarea.FechaAviso)</strong></div>
                                </div>

                                <div class="card-actions">
                                    @if (Model.PuedeGestionarCambioMolde)
                                    {
                                        <form method="post" asp-controller="ProduccionPreparacion" asp-action="IniciarCambioMolde">
                                            @Html.AntiForgeryToken()
                                            <input type="hidden" name="PreparacionAnticipadaID" value="@tarea.PreparacionAnticipadaID" />
                                            <button class="btnx btnx-primary" type="submit">
                                                <i class="bi bi-play-fill"></i> Iniciar cambio
                                            </button>
                                        </form>
                                    }

                                    @if (tarea.EjecucionProduccionID.HasValue)
                                    {
                                        <a class="btnx btnx-outline"
                                           asp-controller="Produccion"
                                           asp-action="Detalle"
                                           asp-route-id="@tarea.EjecucionProduccionID.Value">
                                            <i class="bi bi-box-arrow-up-right"></i> Ver producción
                                        </a>
                                    }
                                </div>
                            </article>
                        }
                    </div>
                </details>
            }
        }
        else
        {
            <div class="empty">
                <i class="bi bi-check2-circle"></i>
                <strong>No hay cambios de molde pendientes</strong>
                <span>La sincronización solo genera tareas cuando detecta un cambio real entre el molde anterior y el siguiente.</span>
            </div>
        }
    </section>

    <section class="section">
        <details class="machine-group">
            <summary>
                <div class="group-title">
                    <div class="group-icon" style="background:#eefaf3;color:#238353"><i class="bi bi-clock-history"></i></div>
                    <div>
                        <strong>Completados recientes</strong>
                        <small>@completadas.Count cambio(s) visibles · consulta el Historial para ver más</small>
                    </div>
                </div>
            </summary>

            <div>
                @if (completadas.Any())
                {
                    @foreach (var tarea in completadas)
                    {
                        <div class="history-card">
                            <div>
                                <strong>@tarea.TextoMaquina</strong><br />
                                <span>OF @(string.IsNullOrWhiteSpace(tarea.NumeroOF) ? "—" : tarea.NumeroOF)</span>
                            </div>

                            <div>
                                <strong>@tarea.TextoCambioMolde</strong><br />
                                <span>@tarea.TextoParte</span>
                            </div>

                            <div>
                                <strong>@(tarea.DuracionRealMinutos?.ToString() ?? tarea.MinutosTranscurridosCambioMolde.ToString()) min</strong><br />
                                <span>Límite @TextoLimite(tarea.LimiteCambioMoldeMinutos)</span>
                            </div>

                            <div>
                                <strong>@Fecha(tarea.FechaFinReal ?? tarea.FechaConfirmacion)</strong><br />
                                <span>@(string.IsNullOrWhiteSpace(tarea.UsuarioConfirmacionNombre) ? "Sin usuario" : tarea.UsuarioConfirmacionNombre)</span>
                            </div>

                            <div>
                                @if (tarea.ExcedioLimite)
                                {
                                    <span class="history-over"><i class="bi bi-exclamation-octagon me-1"></i>Fuera de estándar</span>
                                }
                                else
                                {
                                    <span style="color:#238353;font-weight:950"><i class="bi bi-check-circle me-1"></i>Dentro de límite</span>
                                }
                            </div>
                        </div>
                    }
                }
                else
                {
                    <div class="empty" style="border:0;border-radius:0">
                        <i class="bi bi-clock-history"></i>
                        <strong>Aún no hay cambios completados</strong>
                    </div>
                }
            </div>
        </details>
    </section>
</div>

<script>
    (function () {
        const page = document.getElementById('cambioMoldePage');
        if (!page) return;

        const estadoUrl = page.dataset.estadoUrl || '';
        const cards = Array.from(document.querySelectorAll('.js-cambio-en-proceso'));
        const banner = document.getElementById('criticalBanner');
        const bannerText = document.getElementById('criticalBannerText');

        function formatMinutes(totalMinutes) {
            const value = Math.max(0, Number(totalMinutes || 0));
            const hours = Math.floor(value / 60);
            const minutes = value % 60;

            if (hours > 0) {
                return String(hours).padStart(2, '0') + ':' + String(minutes).padStart(2, '0');
            }

            return '00:' + String(minutes).padStart(2, '0');
        }

        function badgeClass(level) {
            level = String(level || '').toUpperCase();

            if (level === 'EXCEDIDO') return 'exceeded';
            if (level === 'CRITICO') return 'critical';
            if (level === 'ADVERTENCIA') return 'warning';
            return 'normal';
        }

        function cardClass(level) {
            level = String(level || '').toUpperCase();

            if (level === 'EXCEDIDO') return 'level-exceeded';
            if (level === 'CRITICO') return 'level-critical';
            if (level === 'ADVERTENCIA') return 'level-warning';
            return 'level-normal';
        }

        function levelText(level) {
            level = String(level || '').toUpperCase();

            if (level === 'EXCEDIDO') return 'Límite excedido';
            if (level === 'CRITICO') return 'Crítico';
            if (level === 'ADVERTENCIA') return 'Advertencia';
            return 'Normal';
        }

        function updateCard(card, data) {
            const timer = card.querySelector('.js-timer');
            const remaining = card.querySelector('.js-restante');
            const badge = card.querySelector('.js-level-badge');
            const progress = card.querySelector('.js-progress');
            const motivo = card.querySelector('.js-motivo-exceso');
            const hint = card.querySelector('.js-motivo-hint');

            const elapsed = Number(data.minutosTranscurridos || 0);
            const limit = Math.max(1, Number(data.limiteMinutos || card.dataset.limite || 60));
            const excess = Number(data.minutosExceso || 0);
            const left = Number(data.minutosRestantes || 0);
            const level = String(data.nivel || 'NORMAL').toUpperCase();
            const percent = Math.min(100, Math.round((elapsed * 100) / limit));

            card.dataset.level = level;
            card.classList.remove('level-normal', 'level-warning', 'level-critical', 'level-exceeded');
            card.classList.add(cardClass(level));

            if (timer) {
                timer.textContent = formatMinutes(elapsed) + ' · ' + elapsed + ' min';
            }

            if (remaining) {
                remaining.textContent = excess > 0
                    ? 'Exceso: ' + excess + ' min sobre el límite'
                    : 'Restan ' + left + ' min antes del límite';
            }

            if (badge) {
                badge.classList.remove('normal', 'warning', 'critical', 'exceeded');
                badge.classList.add(badgeClass(level));
                badge.textContent = levelText(level);
            }

            if (progress) {
                progress.style.width = percent + '%';
            }

            if (motivo) {
                motivo.required = level === 'EXCEDIDO';
            }

            if (hint) {
                hint.textContent = level === 'EXCEDIDO'
                    ? 'El límite ya fue superado. El motivo de excedente es obligatorio para finalizar.'
                    : 'El sistema exigirá este campo si al finalizar ya se superó el máximo configurado.';
            }
        }

        async function refreshCard(card) {
            if (!estadoUrl) return;

            const id = card.dataset.cambioId;
            if (!id) return;

            try {
                const response = await fetch(estadoUrl + '?id=' + encodeURIComponent(id), {
                    method: 'GET',
                    headers: { 'X-Requested-With': 'XMLHttpRequest' },
                    cache: 'no-store'
                });

                if (!response.ok) return;

                const data = await response.json();
                updateCard(card, data);
            } catch (_) {
            }
        }

        function refreshBanner() {
            if (!banner || !bannerText) return;

            const important = cards.filter(function (card) {
                const level = String(card.dataset.level || '').toUpperCase();
                return level === 'ADVERTENCIA' || level === 'CRITICO' || level === 'EXCEDIDO';
            });

            if (important.length === 0) {
                banner.classList.remove('show');
                bannerText.textContent = '';
                return;
            }

            const exceeded = important.filter(x => String(x.dataset.level).toUpperCase() === 'EXCEDIDO').length;
            const critical = important.filter(x => String(x.dataset.level).toUpperCase() === 'CRITICO').length;
            const warning = important.filter(x => String(x.dataset.level).toUpperCase() === 'ADVERTENCIA').length;

            const parts = [];
            if (exceeded > 0) parts.push(exceeded + ' excedido(s)');
            if (critical > 0) parts.push(critical + ' crítico(s)');
            if (warning > 0) parts.push(warning + ' en advertencia');

            bannerText.textContent = parts.join(' · ') + '. Revisa los cambios en proceso.';
            banner.classList.add('show');
        }

        async function refreshAll() {
            await Promise.all(cards.map(refreshCard));
            refreshBanner();
        }

        document.querySelectorAll('.js-toggle-finalizar').forEach(function (button) {
            button.addEventListener('click', function () {
                const target = document.getElementById(button.dataset.target || '');
                if (!target) return;
                target.classList.toggle('show');
            });
        });

        document.querySelectorAll('.js-cancel-finalizar').forEach(function (button) {
            button.addEventListener('click', function () {
                const target = document.getElementById(button.dataset.target || '');
                if (!target) return;
                target.classList.remove('show');
            });
        });

        refreshAll();

        if (cards.length > 0) {
            window.setInterval(refreshAll, 30000);
        }
    })();
</script>
