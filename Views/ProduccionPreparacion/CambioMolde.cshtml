@using ERP.NSQuell.Models
@using System.Linq
@model ProduccionPreparacionIndexVm
@{
    Layout = "_Layout";
    ViewData["Title"] = "Cambios de molde";

    var tareas = Model.Tareas ?? new List<ProduccionPreparacionTareaVm>();
    var cambios = tareas.Where(x => x.EsCambioMolde).ToList();

    var enProceso = cambios
        .Where(x => x.EstaEnProceso)
        .OrderByDescending(x => x.NivelAlertaCambioMolde == "EXCEDIDO")
        .ThenByDescending(x => x.NivelAlertaCambioMolde == "CRITICO")
        .ThenByDescending(x => x.NivelAlertaCambioMolde == "ADVERTENCIA")
        .ThenBy(x => x.FechaInicioReal)
        .ToList();

    var pendientes = cambios
        .Where(x => x.EstaPendiente)
        .OrderBy(x => x.FechaAviso)
        .ThenBy(x => x.FechaObjetivo)
        .ToList();

    var completadas = cambios
        .Where(x => x.EstaConfirmada)
        .OrderByDescending(x => x.FechaFinReal ?? x.FechaConfirmacion)
        .Take(30)
        .ToList();

    var vencidas = pendientes.Count(x => x.EsVencida);
    var hacerAhora = pendientes.Count(x => x.EsHacerAhora);
    var proximas = pendientes.Count(x => x.EsProxima);
    var fueraEstandar = completadas.Count(x => x.ExcedioLimite);

    string Fecha(DateTime? value) => value?.ToString("dd/MM/yyyy HH:mm") ?? "—";
    string Hora(DateTime? value) => value?.ToString("HH:mm") ?? "—";

    string TextoLimite(int minutos)
    {
        if (minutos <= 0) minutos = 60;
        var horas = minutos / 60;
        var resto = minutos % 60;
        if (horas > 0 && resto > 0) return $"{horas} h {resto} min";
        if (horas > 0) return $"{horas} h";
        return $"{minutos} min";
    }

    string ClasePendiente(ProduccionPreparacionTareaVm tarea)
    {
        if (tarea.EsVencida) return "task-overdue";
        if (tarea.EsHacerAhora) return "task-now";
        return "task-next";
    }

    string TextoPendiente(ProduccionPreparacionTareaVm tarea)
    {
        if (tarea.EsVencida) return "Vencido";
        if (tarea.EsHacerAhora) return "Hacer ahora";
        return "Próximo";
    }

    string ClaseNivel(string? nivel)
    {
        nivel = (nivel ?? "").Trim().ToUpperInvariant();
        return nivel switch
        {
            "EXCEDIDO" => "level-exceeded",
            "CRITICO" => "level-critical",
            "ADVERTENCIA" => "level-warning",
            _ => "level-normal"
        };
    }

    string TextoNivel(string? nivel)
    {
        nivel = (nivel ?? "").Trim().ToUpperInvariant();
        return nivel switch
        {
            "EXCEDIDO" => "Límite excedido",
            "CRITICO" => "Crítico",
            "ADVERTENCIA" => "Advertencia",
            _ => "Normal"
        };
    }

    var filtroActual = string.IsNullOrWhiteSpace(Model.Filtro) ? "" : Model.Filtro;
}
