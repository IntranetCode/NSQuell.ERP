<script id="NSQ_SECADO_OF_MATERIAL_V1_3_JS">
(function () {
    const endpoint = '@Url.Action("EstadoSecado", "ProduccionPreparacion")';

    function horas(value) {
        const n = Number(value);
        return Number.isFinite(n) ? n.toFixed(2).replace(/\.00$/, '') + ' h' : '—';
    }

    async function cargarParametros(element) {
        const programa = element.getAttribute('data-programa-id');
        const ejecucion = element.getAttribute('data-ejecucion-id');
        const rango = element.querySelector('.js-secado-rango-v1');
        const alerta = element.querySelector('.js-secado-alerta-v1');

        if (!programa && !ejecucion) {
            if (rango) rango.textContent = 'Sin OF / ejecución';
            return;
        }

        const params = new URLSearchParams();
        if (programa) params.set('programaProduccionId', programa);
        if (ejecucion) params.set('ejecucionProduccionId', ejecucion);

        try {
            const response = await fetch(endpoint + '?' + params.toString(), {
                credentials: 'same-origin',
                headers: { 'X-Requested-With': 'XMLHttpRequest' }
            });

            if (!response.ok) throw new Error('HTTP ' + response.status);
            const data = await response.json();
            if (!data || !data.ok) throw new Error(data?.mensaje || 'Respuesta inválida');

            if (rango) {
                const tipo = data.tipoSecado ? String(data.tipoSecado).trim() : '';
                rango.textContent =
                    (tipo ? tipo + ' · ' : '') +
                    'Min ' + horas(data.horasSecadoMinimo) +
                    ' · Objetivo ' + horas(data.horasSecadoObjetivo) +
                    ' · Máx ' + horas(data.horasSecadoMaximo);
            }

            if (alerta) {
                const avisos = Array.isArray(data.alertas) ? data.alertas : [];
                const datoPieza = data.horasSecadoTexto
                    ? 'Dato pieza: ' + data.horasSecadoTexto + '.'
                    : 'Sin texto técnico de secado en la pieza.';
                alerta.textContent = [datoPieza].concat(avisos).join(' ');
            }

            if (data.fueraDeMaximo) {
                element.classList.add('is-max-warning');
            }
        }
        catch (error) {
            if (rango) rango.textContent = 'No disponible';
            if (alerta) alerta.textContent = 'No fue posible consultar min/objetivo/máx.';
            console.warn('EstadoSecado:', error);
        }
    }

    function iniciar() {
        document
            .querySelectorAll('.nsq-secado-parametros-v1')
            .forEach(cargarParametros);
    }

    if (document.readyState === 'loading') {
        document.addEventListener('DOMContentLoaded', iniciar, { once: true });
    } else {
        iniciar();
    }
})();
</script>

