    .load-alert {
        margin-top: 9px;
        border-radius: 10px;
        padding: 9px 10px;
        font-size: .64rem;
        font-weight: 850;
    }

        .load-alert.warning {
            background: var(--dry-orange-soft);
            color: var(--dry-orange-dark);
            border: 1px solid #edcf93;
        }

        .load-alert.success {
            background: var(--dry-green-soft);
            color: var(--dry-green);
            border: 1px solid #afdcc6;
        }

        .load-alert.danger {
            background: var(--dry-red-soft);
            color: var(--dry-red);
            border: 1px solid #efb1ad;
        }

    .actions {
        margin-top: 11px;
        display: flex;
        gap: 8px;
        flex-wrap: wrap;
        align-items: center;
    }

    .action-panel {
        display: none;
        margin-top: 10px;
        padding: 11px;
        border: 1px solid var(--dry-line);
        border-radius: 12px;
        background: var(--dry-gray-soft);
    }

        .action-panel.show {
            display: block;
        }

    .action-form {
        display: grid;
        gap: 9px;
    }

    .form-row-2 {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 9px;
    }

    .panel-title {
        display: flex;
        gap: 8px;
        align-items: center;
        margin-bottom: 9px;
        color: var(--dry-text);
        font-size: .72rem;
        font-weight: 950;
    }

    .segment-details,
    .history-details,
    .tolva-details {
        margin-top: 10px;
        border: 1px solid var(--dry-line);
        border-radius: 11px;
        overflow: hidden;
        background: var(--dry-card);
    }

        .segment-details summary,
        .history-details summary,
        .tolva-details summary {
            list-style: none;
            cursor: pointer;
            padding: 9px 10px;
            color: var(--dry-muted);
            font-size: .63rem;
            font-weight: 900;
            display: flex;
            align-items: center;
            gap: 7px;
        }

            .segment-details summary::-webkit-details-marker,
            .history-details summary::-webkit-details-marker,
            .tolva-details summary::-webkit-details-marker {
                display: none;
            }

    .segment-list {
        border-top: 1px solid var(--dry-line);
    }

    .segment-row {
        display: grid;
        grid-template-columns: 70px 1fr 1fr auto;
        gap: 8px;
        align-items: center;
        padding: 8px 10px;
        border-top: 1px solid var(--dry-line);
        font-size: .61rem;
    }

        .segment-row:first-child {
            border-top: 0;
        }

        .segment-row strong {
            color: var(--dry-text);
            font-weight: 900;
        }

        .segment-row span {
            color: var(--dry-muted);
            font-weight: 700;
        }

    .material-group {
        margin-bottom: 12px;
        background: var(--dry-card);
        border: 1px solid var(--dry-line);
        border-radius: 16px;
        overflow: hidden;
        box-shadow: var(--dry-shadow);
    }

        .material-group > summary {
            list-style: none;
            cursor: pointer;
            padding: 13px 15px;
            display: flex;
            align-items: center;
            justify-content: space-between;
            gap: 12px;
            border-bottom: 1px solid transparent;
        }

        .material-group[open] > summary {
            border-bottom-color: var(--dry-line);
        }

        .material-group > summary::-webkit-details-marker {
            display: none;
        }

    .group-title {
        display: flex;
        gap: 10px;
        align-items: center;
        min-width: 0;
    }

    .group-icon {
        width: 36px;
        height: 36px;
        border-radius: 10px;
        background: var(--dry-orange-soft);
        color: var(--dry-orange);
        display: grid;
        place-items: center;
        flex: none;
    }

    .group-title strong {
        display: block;
        color: var(--dry-text);
        font-size: .8rem;
        font-weight: 950;
    }

    .group-title small {
        display: block;
        margin-top: 2px;
        color: var(--dry-muted);
        font-size: .61rem;
        font-weight: 750;
    }

    .group-count {
        margin-left: auto;
        padding: 5px 9px;
        border-radius: 999px;
        background: var(--dry-orange-soft);
        color: var(--dry-orange);
        font-size: .61rem;
        font-weight: 950;
    }

    .material-grid {
        padding: 10px;
        background: var(--dry-bg);
        display: grid;
        grid-template-columns: repeat(2,minmax(0,1fr));
        gap: 10px;
    }

    .pending-card {
        background: var(--dry-card);
        border: 1px solid var(--dry-line);
        border-radius: 15px;
        padding: 13px;
    }

        .pending-card.is-alert {
            border: 2px solid var(--dry-red);
        }

        .pending-card.is-partial {
            border-left: 5px solid var(--dry-orange);
        }

    .pending-head {
        display: flex;
        justify-content: space-between;
        align-items: flex-start;
        gap: 10px;
    }

    .pending-title {
        display: flex;
        gap: 10px;
        min-width: 0;
    }

    .pending-icon {
        width: 41px;
        height: 41px;
        border-radius: 12px;
        background: var(--dry-purple-soft);
        color: var(--dry-purple);
        display: grid;
        place-items: center;
        flex: none;
    }

    .pending-title h3 {
        margin: 0;
        color: var(--dry-text);
        font-size: .86rem;
        font-weight: 950;
        overflow-wrap: anywhere;
    }

    .pending-title small {
        display: block;
        margin-top: 3px;
        color: var(--dry-muted);
        font-size: .62rem;
        font-weight: 700;
    }

    .chips {
        display: flex;
        flex-wrap: wrap;
        gap: 5px;
        margin-bottom: 4px;
    }

    .chip {
        display: inline-flex;
        align-items: center;
        gap: 4px;
        padding: 4px 7px;
        border-radius: 999px;
        background: var(--dry-blue-soft);
        color: var(--dry-blue);
        font-size: .56rem;
        font-weight: 900;
    }

    .process-row {
        margin-top: 10px;
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 7px;
    }

    .process-box {
        border: 1px solid var(--dry-line);
        border-radius: 11px;
        padding: 9px 10px;
    }

        .process-box.primary {
            background: var(--dry-orange-soft);
        }

        .process-box span {
            display: block;
            color: var(--dry-muted);
            font-size: .54rem;
            text-transform: uppercase;
            font-weight: 950;
        }

        .process-box strong {
            display: block;
            margin-top: 3px;
            color: var(--dry-text);
            font-size: .74rem;
            font-weight: 950;
        }

    .quantity-grid {
        margin-top: 8px;
        display: grid;
        grid-template-columns: repeat(4,minmax(0,1fr));
        gap: 6px;
    }

    .quantity-box {
        border: 1px solid var(--dry-line);
        border-radius: 10px;
        padding: 8px;
    }

        .quantity-box span {
            display: block;
            color: var(--dry-muted);
            font-size: .51rem;
            text-transform: uppercase;
            font-weight: 950;
        }

        .quantity-box strong {
            display: block;
            margin-top: 3px;
            color: var(--dry-text);
            font-size: .67rem;
            font-weight: 950;
        }

        .quantity-box.remaining {
            background: var(--dry-orange-soft);
        }

    .schedule-grid {
        margin-top: 8px;
        display: grid;
        grid-template-columns: repeat(2,minmax(0,1fr));
        gap: 6px;
    }

    .schedule-box {
        border: 1px solid var(--dry-line);
        border-radius: 9px;
        padding: 8px;
    }

        .schedule-box span {
            display: block;
            color: var(--dry-muted);
            font-size: .51rem;
            font-weight: 950;
            text-transform: uppercase;
        }

        .schedule-box strong {
            display: block;
            margin-top: 3px;
            color: var(--dry-text);
            font-size: .63rem;
            font-weight: 850;
        }

    .start-panel {
        margin-top: 10px;
        padding-top: 10px;
        border-top: 1px solid var(--dry-line);
    }

    .no-tolva {
        margin-top: 10px;
        padding: 9px 10px;
        border-radius: 10px;
        background: var(--dry-red-soft);
        color: var(--dry-red);
        font-size: .63rem;
        font-weight: 850;
    }

    .ready-list {
        background: var(--dry-card);
        border: 1px solid var(--dry-line);
        border-radius: 16px;
        overflow: hidden;
        box-shadow: var(--dry-shadow);
    }

    .ready-row {
        display: grid;
        grid-template-columns: 1.05fr 1.4fr .8fr 1fr auto;
        gap: 10px;
        align-items: center;
        padding: 11px 13px;
        border-top: 1px solid var(--dry-line);
        font-size: .66rem;
    }

        .ready-row:first-child {
            border-top: 0;
        }

        .ready-row strong {
            display: block;
            color: var(--dry-text);
            font-weight: 900;
        }

        .ready-row span {
            display: block;
            margin-top: 2px;
            color: var(--dry-muted);
            font-weight: 750;
        }

    .ok-text {
        color: var(--dry-green) !important;
        font-weight: 950 !important;
    }

    .empty {
        background: var(--dry-card);
        border: 1px dashed var(--dry-line);
        border-radius: 15px;
        padding: 28px 18px;
        text-align: center;
        color: var(--dry-muted);
    }

        .empty i {
            display: block;
            margin-bottom: 7px;
            font-size: 1.5rem;
        }

        .empty strong {
            display: block;
            color: var(--dry-text);
            font-size: .82rem;
            font-weight: 950;
        }

        .empty span {
            display: block;
            margin-top: 4px;
            font-size: .66rem;
            font-weight: 700;
        }

    @@media(max-width:1200px) {
        .tolva-grid {
            grid-template-columns: repeat(2,minmax(0,1fr));
        }

        .running-grid,
        .material-grid,
        .planned-grid {
            grid-template-columns: 1fr;
        }

        .stats {
            grid-template-columns: repeat(2,minmax(0,1fr));
        }
    }

    @@media(max-width:900px) {
        .filters {
            grid-template-columns: 1fr 1fr;
        }

        .info-grid,
        .quantity-grid {
            grid-template-columns: repeat(2,minmax(0,1fr));
        }
    }

    @@media(max-width:720px) {
        .dry-page {
            padding: 10px;
        }

        .hero {
            flex-direction: column;
            align-items: flex-start;
        }

        .hero-actions {
            justify-content: flex-start;
            width: 100%;
        }

        .stats,
        .filters,
        .tolva-grid,
        .process-row,
        .form-row-2 {
            grid-template-columns: 1fr;
        }

        .timer-box {
            grid-template-columns: 1fr;
        }

        .timer-target {
            text-align: left;
        }

        .ready-row {
            grid-template-columns: 1fr 1fr;
        }

        .segment-row {
            grid-template-columns: 1fr 1fr;
        }
    }
</style>

<div class="dry-page"
     id="secadoPage"
     data-server-now="@Model.FechaConsulta.ToString("O")"
     data-estado-url="@Url.Action("EstadoSecado", "ProduccionPreparacion")"
     data-tolerancia-fin="@Model.Configuracion.MinutosToleranciaFin">

    <section class="hero">
        <div class="hero-main">
            <div class="hero-icon">
                <i class="bi bi-thermometer-sun"></i>
            </div>

            <div>
                <h1>Secado de material</h1>
                <p>
                    Control operativo de materia prima recibida, cargas de secado,
                    tolvas, cambios de tolva y liberación del material al cumplir
                    el tiempo requerido.
                </p>
            </div>
        </div>

        <div class="hero-actions">
            <a class="btnx btnx-light"
               asp-controller="ProduccionPreparacion"
               asp-action="Index">
                <i class="bi bi-grid-1x2"></i>
                Tablero
            </a>

            <a class="btnx btnx-light"
               asp-controller="ProduccionPreparacion"
               asp-action="CambioMolde">
                <i class="bi bi-tools"></i>
                Cambios de molde
            </a>

            <a class="btnx btnx-light"
               asp-controller="ProduccionPreparacion"
               asp-action="Embalajes">
                <i class="bi bi-box-seam"></i>
                Embalajes
            </a>

            <a class="btnx btnx-light"
               asp-controller="ProduccionPreparacion"
               asp-action="Historial">
                <i class="bi bi-clock-history"></i>
                Historial
            </a>

            <a class="btnx btnx-light"
               asp-controller="Produccion"
               asp-action="Index">
                <i class="bi bi-arrow-left"></i>
                Producción
            </a>
        </div>
    </section>

    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success flash">
            <i class="bi bi-check-circle me-1"></i>
            @TempData["Success"]
        </div>
    }

    @if (TempData["Warning"] != null)
    {
        <div class="alert alert-warning flash">
            <i class="bi bi-exclamation-triangle me-1"></i>
            @TempData["Warning"]
        </div>
    }

    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger flash">
            <i class="bi bi-exclamation-octagon me-1"></i>
            @TempData["Error"]
        </div>
    }

    @if (!Model.PuedeGestionarSecado)
    {
        <div class="permission-note">
            <i class="bi bi-eye fs-5"></i>
            <div>
                <strong>Modo consulta</strong>
                Puedes consultar el estado del secado, pero tu usuario no tiene permiso
                para iniciar cargas, cambiar tolvas o finalizar procesos.
            </div>
        </div>
    }

    @if (totalAlertas > 0)
    {
        <div class="alert-banner">
            <i class="bi bi-exclamation-triangle-fill fs-5"></i>
            <div>
                <strong>Hay procesos que requieren atención.</strong>

                @if (Model.TotalAlertasEspera > 0)
                {
                    <span>
                        @Model.TotalAlertasEspera material(es) llevan más tiempo del permitido
                        esperando iniciar secado.
                    </span>
                }

                @if (Model.TotalCargasRetrasadas > 0)
                {
                    <span>
                        @Model.TotalCargasRetrasadas carga(s) ya superaron su tiempo esperado
                        más la tolerancia configurada.
                    </span>
                }
            </div>
        </div>
    }

    <section class="stats">
        <div class="stat">
            <div class="stat-icon blue">
                <i class="bi bi-calendar2-check"></i>
            </div>
            <div>
                <span class="stat-value">@pendientesPlaneacion.Count</span>
                <span class="stat-label">Programados sin MP</span>
            </div>
        </div>

        <div class="stat">
            <div class="stat-icon orange">
                <i class="bi bi-hourglass-split"></i>
            </div>
            <div>
                <span class="stat-value">@pendientes.Count</span>
                <span class="stat-label">Pendientes de carga</span>
            </div>
        </div>

        <div class="stat">
            <div class="stat-icon blue">
                <i class="bi bi-droplet-half"></i>
            </div>
            <div>
                <span class="stat-value">@cargasActivas.Count</span>
                <span class="stat-label">Cargas en proceso</span>
            </div>
        </div>

        <div class="stat">
            <div class="stat-icon green">
                <i class="bi bi-box-arrow-in-down"></i>
            </div>
            <div>
                <span class="stat-value">@Model.TotalTolvasDisponibles</span>
                <span class="stat-label">Tolvas disponibles</span>
            </div>
        </div>

        <div class="stat">
            <div class="stat-icon red">
                <i class="bi bi-exclamation-octagon"></i>
            </div>
            <div>
                <span class="stat-value">@totalAlertas</span>
                <span class="stat-label">Alertas operativas</span>
            </div>
        </div>
    </section>

    <form method="get"
          asp-controller="ProduccionPreparacion"
          asp-action="Secado"
          class="filters">

        <div class="field">
            <label>Buscar</label>
            <input type="text"
                   name="filtro"
                   value="@filtroActual"
                   placeholder="OF, material o máquina..." />
        </div>

        <div class="field">
            <label>Máquina</label>
            <select name="maquinaId">
                <option value="">Todas las máquinas</option>

                @foreach (var maquina in Model.Maquinas)
                {
                    if (Model.MaquinaID == maquina.MaquinaID)
                    {
                        <option value="@maquina.MaquinaID" selected>
                            @maquina.Texto
                        </option>
                    }
                    else
                    {
                        <option value="@maquina.MaquinaID">
                            @maquina.Texto
                        </option>
                    }
                }
            </select>
        </div>

        <button class="btnx btnx-primary" type="submit">
            <i class="bi bi-search"></i>
            Filtrar
        </button>

        <a class="btnx btnx-outline"
           asp-controller="ProduccionPreparacion"
           asp-action="Secado">
            <i class="bi bi-arrow-counterclockwise"></i>
            Limpiar
        </a>
    </form>

    <section class="section">
        <div class="section-head">
            <div>
                <h2>Programados · esperando recepción de MP</h2>
                <p>
                    Secados requeridos por Planeación que todavía no tienen materia prima
                    confirmada físicamente en Producción. Son informativos y no pueden
                    iniciar una carga hasta que se confirme la recepción.
                </p>
            </div>
            <span class="section-count">@pendientesPlaneacion.Count</span>
        </div>

        @if (pendientesPlaneacion.Any())
        {
            <div class="planned-grid">
                @foreach (var tarea in pendientesPlaneacion)
                {
                    var clasePlaneacion = EstadoPlaneacionClase(tarea);
                    <article class="planned-card @(clasePlaneacion == "danger" ? "is-danger" : clasePlaneacion == "warning" ? "is-warning" : "")">
                        <div class="planned-head">
                            <div class="planned-title">
                                <div class="planned-icon">
                                    <i class="bi bi-calendar2-check"></i>
                                </div>
                                <div>
                                    <div class="chips">
                                        <span class="chip">OF @(string.IsNullOrWhiteSpace(tarea.NumeroOF) ? "—" : tarea.NumeroOF)</span>
                                        <span class="chip">@tarea.TextoMaquina</span>
                                    </div>
                                    <h3>@tarea.TextoMaterial</h3>
                                    <small>
                                        @tarea.TextoParte
                                        @if (!string.IsNullOrWhiteSpace(tarea.DescripcionParte))
                                        {
                                            <text> · @tarea.DescripcionParte</text>
                                        }
                                    </small>
                                </div>
                            </div>
                            <span class="status-pill @clasePlaneacion">@EstadoPlaneacionTexto(tarea)</span>
                        </div>

                        <div class="process-row">
                            <div class="process-box primary">
                                <span>Proceso requerido</span>
                                <strong>@(string.IsNullOrWhiteSpace(tarea.TipoSecado) ? "Secado" : tarea.TipoSecado)</strong>
                            </div>
                            <div class="process-box">
                                <span>Tiempo requerido</span>
                                <strong>@Horas(tarea.HorasSecado)</strong>
                            </div>
                        </div>

                        <div class="schedule-grid">
                            <div class="schedule-box">
                                <span>Debe iniciar secado</span>
                                <strong>@Fecha(tarea.FechaAviso)</strong>
                            </div>
                            <div class="schedule-box">
                                <span>Objetivo / arranque</span>
                                <strong>@Fecha(tarea.FechaObjetivo)</strong>
                            </div>
                            <div class="schedule-box">
                                <span>Arranque producción</span>
                                <strong>@Fecha(tarea.FechaArranque)</strong>
                            </div>
                            <div class="schedule-box">
                                <span>Cantidad programada</span>
                                <strong>@tarea.CantidadProgramada.ToString("N0") PZA</strong>
                            </div>
                        </div>

                        <div class="planned-note">
                            <i class="bi bi-box-arrow-in-down me-1"></i>
                            Pendiente de confirmación física de materia prima. Al recibirse la MP,
                            este programa dejará esta sección y aparecerá en “Material pendiente de secado”,
                            donde ya se podrá seleccionar tolva e iniciar la carga.
                        </div>
                    </article>
                }
            </div>
        }
        else
        {
            <div class="empty">
                <i class="bi bi-calendar2-check"></i>
                <strong>No hay secados programados esperando materia prima</strong>
                <span>Todos los programas visibles ya tienen su recepción física registrada o no requieren secado.</span>
            </div>
        }
    </section>

    <section class="section">
        <details class="tolva-details" open>
            <summary>
                <i class="bi bi-boxes"></i>
                Estado de tolvas
                <span class="section-count">@tolvas.Count</span>
            </summary>

            <div style="padding:10px;background:var(--dry-bg)">
                @if (tolvas.Any())
                {
                    <div class="tolva-grid">
                        @foreach (var tolva in tolvas)
                        {
                            var claseTolva = tolva.DisponibleParaUsar
                            ? "is-free"
                            : tolva.EstaOcupada
                            ? "is-busy"
                            : "is-disabled";

                            <article class="tolva-card @claseTolva">
                                <div class="tolva-top">
                                    <div class="tolva-title">
                                        <div class="tolva-icon">
                                            <i class="bi bi-box2"></i>
                                        </div>

                                        <div>
                                            <strong>
                                                @(string.IsNullOrWhiteSpace(tolva.Codigo)
                                                                                        ? tolva.Nombre
                                                                                        : $"{tolva.Codigo} - {tolva.Nombre}")
                                    </strong>

                                            <small>
                                                @tolva.MaquinaCodigo
                                        @if (!string.IsNullOrWhiteSpace(tolva.MaquinaNombre))
                                                {
                                                    <text> · @tolva.MaquinaNombre</text>
                                                }
                                            </small>
                                        </div>
                                    </div>

                                    <span class="status-pill @(tolva.DisponibleParaUsar ? "success" : tolva.EstaOcupada ? "warning" : "danger")">
                                        @tolva.EstadoTexto
                                    </span>
                                </div>

                                <div class="tolva-info">
                                    <div>
                                        <span>Capacidad</span>
                                        <strong>@Cantidad(tolva.CapacidadKg)</strong>
                                    </div>

                                    <div>
                                        <span>Proceso</span>
                                        <strong>@tolva.TipoProcesoPermitido</strong>
                                    </div>
                                </div>

                                @if (tolva.EstaOcupada)
                                {
                                    <div class="busy-info">
                                        <i class="bi bi-hourglass-split me-1"></i>
                                        OF @(string.IsNullOrWhiteSpace(tolva.NumeroOFActiva) ? "—" : tolva.NumeroOFActiva)
                                        · @(string.IsNullOrWhiteSpace(tolva.MaterialCodigoActivo) ? "Material" : tolva.MaterialCodigoActivo)

                                        @if (tolva.FechaFinEsperadaActiva.HasValue)
                                        {
                                            <text>
                                                · Fin esperado @Fecha(tolva.FechaFinEsperadaActiva)
                                            </text>
                                        }
                                    </div>
                                }
                            </article>
                        }
                    </div>
                }
                else
                {
                    <div class="empty">
                        <i class="bi bi-boxes"></i>
                        <strong>No hay tolvas configuradas</strong>
                        <span>No se encontraron tolvas activas para el proceso de secado.</span>
                    </div>
                }
            </div>
        </details>
    </section>

    <section class="section">
        <div class="section-head">
            <div>
                <h2>Cargas en proceso</h2>
                <p>
                    Cada carga conserva su cronómetro aunque sea movida a otra tolva.
                    La finalización se habilita cuando se cumple el tiempo requerido.
                </p>
            </div>

            <span class="section-count">@cargasActivas.Count</span>
        </div>

        @if (cargasActivas.Any())
        {
            <div class="running-grid">
                @foreach (var item in cargasActivas)
                {
                    var material = item.Material;
                    var carga = item.Carga;

                    var totalMinutos = Math.Max(1, carga.DuracionRequeridaMinutos);
                    var transcurridos = Math.Max(0, carga.MinutosTranscurridos);

                    var porcentaje = Math.Min(
                    100,
                    Math.Max(
                    0,
                    (int)Math.Round(
                    (decimal)transcurridos * 100m / totalMinutos,
                    0)));

                    var tolvasCambio = tolvas
                    .Where(x =>
                    x.DisponibleParaUsar &&
                    x.TolvaID != carga.TolvaIDActual &&
                    x.CapacidadKg + ProduccionSecadoReglas.ToleranciaCantidad >= carga.CantidadKg &&
                    (
                    string.Equals(
                    x.TipoProcesoPermitido,
                    "AMBOS",
                    StringComparison.OrdinalIgnoreCase) ||
                    string.Equals(
                    x.TipoProcesoPermitido,
                    material.TipoProceso,
                    StringComparison.OrdinalIgnoreCase)
                    ))
                    .OrderBy(x => x.MaquinaCodigo)
                    .ThenBy(x => x.Codigo)
                    .ToList();

                    <article class="load-card js-load-card @(carga.EstaRetrasada ? "is-danger" : carga.TiempoRequeridoCumplido ? "is-ready" : "")"
                             data-load-id="@carga.SecadoCargaID"
                             data-start="@(carga.FechaInicioReal?.ToString("O") ?? "")"
                             data-end="@(carga.FechaFinEsperada?.ToString("O") ?? "")"
                             data-duration-minutes="@carga.DuracionRequeridaMinutos">

                        <div class="load-head">
                            <div class="load-machine">
                                <div class="load-machine-icon">
                                    <i class="bi bi-droplet-half"></i>
                                </div>

                                <div>
                                    <strong>
                                        @carga.TextoTolva
                                    </strong>

                                    <small>
                                        @material.TextoMaquina
                                        · Carga #@carga.NumeroCarga
                                        · OF @(string.IsNullOrWhiteSpace(material.NumeroOF) ? "—" : material.NumeroOF)
                                    </small>
                                </div>
                            </div>

                            <span class="status-pill @EstadoCargaClase(carga) js-load-status">
                                @carga.EstadoTexto
                            </span>
                        </div>

                        <div class="load-body">
                            <div class="material-box">
                                <div class="material-icon">
                                    <i class="bi bi-box2"></i>
                                </div>

                                <div>
                                    <span>Material</span>
                                    <strong>@material.TextoMaterial</strong>

                                    <small>
                                        @material.TipoProcesoTexto
                                        · @Cantidad(carga.CantidadKg)

                                        @if (!string.IsNullOrWhiteSpace(material.TipoMPTexto))
                                        {
                                            <text> · @material.TipoMPTexto</text>
                                        }

                                        @if (!string.IsNullOrWhiteSpace(material.Lote))
                                        {
                                            <text> · Lote @material.Lote</text>
                                        }
                                </small>
                            </div>
                        </div>

                        <div class="info-grid">
                            <div class="info">
                                <span>Inicio real</span>
                                <strong>@Fecha(carga.FechaInicioReal)</strong>
                            </div>

                            <div class="info">
                                <span>Fin esperado</span>
                                <strong class="js-end-label">
                                    @Fecha(carga.FechaFinEsperada)
                                </strong>
                            </div>

                            <div class="info">
                                <span>Tiempo requerido</span>
                                <strong>@Duracion(carga.DuracionRequeridaMinutos)</strong>
                            </div>

                            <div class="info">
                                <span>Espera previa</span>
                                <strong>
                                    @(carga.MinutosEsperaAntesInicio.HasValue
                                                                    ? $"{carga.MinutosEsperaAntesInicio.Value} min"
                                                                    : "0 min")
                            </strong>
                        </div>
                    </div>

                            <div class="timer-box">
                                <div>
                                    <div class="timer-label">
                                        Tiempo restante
                                    </div>

                                    <div class="timer-value js-countdown">
                                        Calculando...
                                    </div>

                                    <div class="timer-sub js-countdown-sub">
                                        Fin esperado @Fecha(carga.FechaFinEsperada)
                                    </div>
                                </div>

                                <div class="timer-target">
                                    <strong>@Cantidad(carga.CantidadKg)</strong>
                                    <span>cantidad en esta carga</span>
                                </div>
                            </div>

                            <div class="progressx">
                                <div class="js-progress"
                                     style="width:@porcentaje%"></div>
                            </div>

                            <div class="js-state-alert">
                        @if (carga.EstaRetrasada)
                                {
                                    <div class="load-alert danger">
                                        <i class="bi bi-exclamation-octagon-fill me-1"></i>
                                        La carga lleva
                                        <strong>@carga.MinutosRetrasoActual minuto(s)</strong>
                                        después del fin esperado y ya superó la tolerancia.
                                    </div>
                                }
                                else if (carga.TiempoRequeridoCumplido)
                                {
                                    <div class="load-alert success">
                                        <i class="bi bi-check-circle-fill me-1"></i>
                                        El tiempo requerido ya se cumplió.
                                        La carga puede finalizarse.
                                    </div>
                                }
                                else if (carga.EstaProximaAFinalizar)
                                {
                                    <div class="load-alert warning">
                                        <i class="bi bi-clock-fill me-1"></i>
                                        La carga está próxima a terminar.
                                        Faltan aproximadamente
                                        <strong>@carga.MinutosRestantes minuto(s)</strong>.
                                    </div>
                                }
                            </div>

                            @if (carga.Segmentos.Any())
                            {
                                <details class="segment-details">
                                    <summary>
                                        <i class="bi bi-diagram-3"></i>
                                        Recorrido de tolvas
                                        (@carga.Segmentos.Count segmento@(carga.Segmentos.Count == 1 ? "" : "s"))
                                    </summary>

                                    <div class="segment-list">
                                        @foreach (var segmento in carga.Segmentos.OrderBy(x => x.NumeroSegmento))
                                        {
                                            <div class="segment-row">
                                                <strong>
                                                    #@segmento.NumeroSegmento
                                                </strong>

                                                <div>
                                                    <strong>@segmento.TextoTolva</strong>

                                                    @if (segmento.EsCambioTolva)
                                                    {
                                                        <span>
                                                            Cambio de tolva
                                                        </span>
                                                    }
                                            </div>

                                            <div>
                                                <span>
                                                    @segmento.FechaInicio.ToString("dd/MM HH:mm")
                                                    -
                                                    @(segmento.FechaFin.HasValue
                                                                                            ? segmento.FechaFin.Value.ToString("dd/MM HH:mm")
                                                                                            : "Actual")
                                    </span>

                                    @if (segmento.MinutosSegmento.HasValue)
                                                    {
                                                        <span>
                                                            @segmento.MinutosSegmento.Value min
                                                        </span>
                                                    }
                                                </div>

                                                <div>
                                                    @if (segmento.EstaAbierto)
                                                    {
                                                        <span class="status-pill primary">
                                                            Actual
                                                        </span>
                                                    }
                                                    else
                                                    {
                                                        <span class="status-pill success">
                                                            Cerrado
                                                        </span>
                                                    }
                                                </div>

                                                @if (!string.IsNullOrWhiteSpace(segmento.MotivoCambio))
                                                {
                                                    <div style="grid-column:1/-1;color:var(--dry-muted)">
                                                        <i class="bi bi-chat-left-text me-1"></i>
                                                        @segmento.MotivoCambio
                                                    </div>
                                                }
                                            </div>
                                        }
                                    </div>
                                </details>
                            }

                            <div class="actions">
                                @if (Model.PuedeGestionarSecado)
                                {
                                    <button type="button"
                                            class="btnx btnx-outline js-toggle-panel"
                                            data-target="cambiarTolva-@carga.SecadoCargaID">
                                        <i class="bi bi-arrow-left-right"></i>
                                        Cambiar tolva
                                    </button>

                                    <button type="button"
                                            class="btnx btnx-success js-toggle-panel js-open-finish"
                                            data-target="finalizar-@carga.SecadoCargaID"
                                            @(carga.TiempoRequeridoCumplido ? null : "disabled")>
                                        <i class="bi bi-check-circle"></i>
                                        Finalizar carga
                                    </button>
                                }

                                @if (material.EjecucionProduccionID.HasValue)
                                {
                                    <a class="btnx btnx-outline"
                                       asp-controller="Produccion"
                                       asp-action="Detalle"
                                       asp-route-id="@material.EjecucionProduccionID.Value">
                                        <i class="bi bi-box-arrow-up-right"></i>
                                        Ver producción
                                    </a>
                                }
                            </div>

                            @if (Model.PuedeGestionarSecado)
                            {
                                <div class="action-panel"
                                     id="cambiarTolva-@carga.SecadoCargaID">

                                    <div class="panel-title">
                                        <i class="bi bi-arrow-left-right"></i>
                                        Cambiar tolva sin reiniciar cronómetro
                                    </div>

                                    @if (tolvasCambio.Any())
                                    {
                                        <form asp-controller="ProduccionPreparacion"
                                              asp-action="CambiarTolvaSecado"
                                              method="post"
                                              class="action-form js-post-form"
                                              data-confirm="¿Confirmas el cambio de tolva? El tiempo de secado continuará corriendo.">

                                            @Html.AntiForgeryToken()

                                            <input type="hidden"
                                                   name="SecadoCargaID"
                                                   value="@carga.SecadoCargaID" />

                                            <div class="field">
                                                <label>Nueva tolva</label>

                                                <select name="TolvaNuevaID"
                                                        required>
                                                    <option value="">
                                                        Selecciona una tolva...
                                                    </option>

                                                    @foreach (var tolvaCambio in tolvasCambio)
                                                    {
                                                        <option value="@tolvaCambio.TolvaID">
                                                            @tolvaCambio.Texto
                                                        </option>
                                                    }
                                                </select>

                                                <span class="field-help">
                                                    Solo se muestran tolvas disponibles,
                                                    compatibles con el proceso y con capacidad suficiente.
                                                </span>
                                            </div>

                                            <div class="field">
                                                <label>Motivo del cambio</label>

                                                <textarea name="MotivoCambio"
                                          maxlength="500"
                                          required
                                          placeholder="Ej. mantenimiento, falla de tolva, ajuste operativo..."></textarea>
                                            </div>

                                            <div class="actions">
                                                <button class="btnx btnx-primary"
                                                        type="submit">
                                                    <i class="bi bi-arrow-left-right"></i>
                                                    Confirmar cambio
                                                </button>
                                            </div>
                                        </form>
                                    }
                                    else
                                    {
                                        <div class="no-tolva">
                                            <i class="bi bi-exclamation-triangle me-1"></i>
                                            No existe otra tolva disponible con capacidad
                                            y proceso compatibles para esta carga.
                                        </div>
                                    }
                                </div>

                                <div class="action-panel"
                                     id="finalizar-@carga.SecadoCargaID">

                                    <div class="panel-title">
                                        <i class="bi bi-check-circle"></i>
                                        Finalizar carga de secado
                                    </div>

                                    <form asp-controller="ProduccionPreparacion"
                                          asp-action="FinalizarSecado"
                                          method="post"
                                          class="action-form js-post-form"
                                          data-confirm="¿Confirmas que la carga terminó físicamente su proceso de secado?">

                                        @Html.AntiForgeryToken()

                                        <input type="hidden"
                                               name="SecadoCargaID"
                                               value="@carga.SecadoCargaID" />

                                        <div class="field">
                                            <label>Observaciones</label>

                                            <textarea name="Observaciones"
                                          maxlength="1000"
                                          placeholder="Condición final del material, temperatura, observaciones del proceso, etc."></textarea>
                                        </div>

                                        <div class="actions">
                                            <button class="btnx btnx-success js-finish-submit"
                                                    type="submit"
                                                    @(carga.TiempoRequeridoCumplido ? null : "disabled")>
                                                <i class="bi bi-check2-circle"></i>
                                                Confirmar finalización
                                            </button>
                                        </div>
                                    </form>
                                </div>
                            }
                        </div>
                    </article>
                }
            </div>
        }
        else
        {
            <div class="empty">
                <i class="bi bi-droplet-half"></i>
                <strong>No hay cargas de secado activas</strong>
                <span>
                    Cuando se inicie una carga, aparecerá aquí con su tolva,
                    cantidad y contador en tiempo real.
                </span>
            </div>
        }
    </section>

    <section class="section">
        <div class="section-head">
            <div>
                <h2>Material pendiente de secado</h2>
                <p>
                    Materia prima recibida por Producción que todavía tiene
                    cantidad pendiente de asignar a una carga.
                </p>
            </div>

            <span class="section-count">@pendientes.Count</span>
        </div>

        @if (pendientes.Any())
        {
            foreach (var grupo in pendientes
            .GroupBy(x => new
            {
                x.MaquinaProgramadaID,
                x.MaquinaProgramadaCodigo,
                x.MaquinaProgramadaNombre
            })
            .OrderBy(x => x.Key.MaquinaProgramadaCodigo)
            .ThenBy(x => x.Key.MaquinaProgramadaNombre))
            {
                var maquinaTexto =
                string.IsNullOrWhiteSpace(grupo.Key.MaquinaProgramadaCodigo)
                ? "Sin máquina"
                : string.IsNullOrWhiteSpace(grupo.Key.MaquinaProgramadaNombre)
                ? grupo.Key.MaquinaProgramadaCodigo
                : $"{grupo.Key.MaquinaProgramadaCodigo} - {grupo.Key.MaquinaProgramadaNombre}";

                <details class="material-group" open>
                    <summary>
                        <div class="group-title">
                            <div class="group-icon">
                                <i class="bi bi-building-gear"></i>
                            </div>

                            <div>
                                <strong>@maquinaTexto</strong>
                                <small>
                                    @grupo.Count()
                                    material@(grupo.Count() == 1 ? "" : "es")
                                    pendiente(s)
                                </small>
                            </div>
                        </div>

                        <span class="group-count">
                            @grupo.Count()
                        </span>
                    </summary>

                    <div class="material-grid">
                        @foreach (var material in grupo)
                        {
                            var tolvasCompatibles = tolvas
                            .Where(x =>
                            x.DisponibleParaUsar &&
                            (
                            string.Equals(
                            x.TipoProcesoPermitido,
                            "AMBOS",
                            StringComparison.OrdinalIgnoreCase) ||
                            string.Equals(
                            x.TipoProcesoPermitido,
                            material.TipoProceso,
                            StringComparison.OrdinalIgnoreCase)
                            ))
                            .OrderByDescending(x =>
                            material.TolvaSugeridaID.HasValue &&
                            x.TolvaID == material.TolvaSugeridaID.Value)
                            .ThenBy(x => x.MaquinaCodigo)
                            .ThenBy(x => x.Codigo)
                            .ToList();

                            ProduccionSecadoTolvaVm? tolvaPredeterminada = null;

                            if (material.TolvaSugeridaID.HasValue)
                            {
                                tolvaPredeterminada = tolvasCompatibles
                                .FirstOrDefault(x =>
                                x.TolvaID == material.TolvaSugeridaID.Value);
                            }

                            if (tolvaPredeterminada == null)
                            {
                                tolvaPredeterminada = tolvasCompatibles.FirstOrDefault();
                            }

                            var cantidadInicial = tolvaPredeterminada != null
                            ? Math.Min(
                            material.CantidadPendienteAsignarKg,
                            tolvaPredeterminada.CapacidadKg)
                            : material.CantidadPendienteAsignarKg;

                            <article class="pending-card @(material.DebeAlertarEspera ? "is-alert" : material.EstaParcial ? "is-partial" : "")">
                                <div class="pending-head">
                                    <div class="pending-title">
                                        <div class="pending-icon">
                                            <i class="bi bi-box2"></i>
                                        </div>

                                        <div>
                                            <div class="chips">
                                                @if (!string.IsNullOrWhiteSpace(material.NumeroOF))
                                                {
                                                    <span class="chip">
                                                        OF @material.NumeroOF
                                                    </span>
                                                }

                                                @if (!string.IsNullOrWhiteSpace(material.TipoMPTexto))
                                                {
                                                    <span class="chip">
                                                        @material.TipoMPTexto
                                                    </span>
                                                }

                                                @if (!string.IsNullOrWhiteSpace(material.Lote))
                                                {
                                                    <span class="chip">
                                                        Lote @material.Lote
                                                    </span>
                                                }
                                            </div>

                                            <h3>@material.TextoMaterial</h3>

                                            <small>
                                                Recibido @material.FechaRecepcionProduccion.ToString("dd/MM/yyyy HH:mm")
                                            </small>
                                        </div>
                                    </div>

                                    <span class="status-pill @EstadoMaterialClase(material)">
                                        @material.EstadoTexto
                                    </span>
                                </div>

                                <div class="process-row">
                                    <div class="process-box primary">
                                        <span>Proceso requerido</span>
                                        <strong>@material.TipoProcesoTexto</strong>
                                    </div>

                                    <div class="process-box">
                                        <span>Tiempo requerido</span>
                                        <strong>@Duracion(material.MinutosSecadoRequeridos)</strong>
                                    </div>
                                </div>

                                <div class="quantity-grid">
                                    <div class="quantity-box">
                                        <span>Recibido</span>
                                        <strong>@Cantidad(material.CantidadRecibidaKg)</strong>
                                    </div>

                                    <div class="quantity-box">
                                        <span>Asignado</span>
                                        <strong>@Cantidad(material.CantidadAsignadaKg)</strong>
                                    </div>

                                    <div class="quantity-box">
                                        <span>Finalizado</span>
                                        <strong>@Cantidad(material.CantidadFinalizadaKg)</strong>
                                    </div>

                                    <div class="quantity-box remaining">
                                        <span>Por asignar</span>
                                        <strong>@Cantidad(material.CantidadPendienteAsignarKg)</strong>
                                    </div>
                                </div>

                                <div class="schedule-grid">
                                    <div class="schedule-box">
                                        <span>Inicio objetivo</span>
                                        <strong>@Fecha(material.FechaInicioSecadoObjetivo)</strong>
                                    </div>

                                    <div class="schedule-box">
                                        <span>Fin objetivo</span>
                                        <strong>@Fecha(material.FechaObjetivoFinSecado)</strong>
                                    </div>

                                    <div class="schedule-box">
                                        <span>Arranque producción</span>
                                        <strong>@Fecha(material.FechaArranqueProduccion)</strong>
                                    </div>

                                    <div class="schedule-box">
                                        <span>Tolva sugerida</span>
                                        <strong>@material.TextoTolvaSugerida</strong>
                                    </div>
                                </div>

                                @if (material.DebeAlertarEspera)
                                {
                                    <div class="load-alert danger">
                                        <i class="bi bi-exclamation-octagon-fill me-1"></i>
                                        El material lleva
                                        <strong>@material.MinutosEsperaActual minuto(s)</strong>
                                        esperando iniciar su primera carga.
                                    </div>
                                }

                                @if (material.RecepcionTardia)
                                {
                                    <div class="load-alert warning">
                                        <i class="bi bi-clock-history me-1"></i>
                                        Producción confirmó el material
                                        <strong>@material.MinutosRetrasoRecepcion minuto(s)</strong>
                                        después de la hora límite estimada.
                                    </div>
                                }

                                @if (material.Cargas.Any())
                                {
                                    <details class="history-details">
                                        <summary>
                                            <i class="bi bi-clock-history"></i>
                                            Cargas anteriores (@material.Cargas.Count)
                                        </summary>

                                        <div class="segment-list">
                                            @foreach (var cargaAnterior in material.Cargas
                                                                        .OrderByDescending(x => x.NumeroCarga))
                                            {
                                                <div class="segment-row">
                                                    <strong>
                                                        #@cargaAnterior.NumeroCarga
                                                    </strong>

                                                    <div>
                                                        <strong>@cargaAnterior.TextoTolva</strong>
                                                        <span>@Cantidad(cargaAnterior.CantidadKg)</span>
                                                    </div>

                                                    <div>
                                                        <span>
                                                            @Fecha(cargaAnterior.FechaInicioReal)
                                                        </span>
                                                        <span>
                                                            a @Fecha(cargaAnterior.FechaFinReal)
                                                        </span>
                                                    </div>

                                                    <span class="status-pill @(cargaAnterior.EstaFinalizada ? "success" : cargaAnterior.EstaCancelada ? "danger" : "primary")">
                                                        @cargaAnterior.EstadoTexto
                                                    </span>
                                                </div>
                                            }
                                        </div>
                                    </details>
                                }

                                @if (Model.PuedeGestionarSecado)
                                {
                                    if (tolvasCompatibles.Any())
                                    {
                                        <div class="start-panel">
                                            <form asp-controller="ProduccionPreparacion"
                                                  asp-action="IniciarSecado"
                                                  method="post"
                                                  class="action-form js-start-form js-post-form"
                                                  data-pending="@material.CantidadPendienteAsignarKg.ToString("0.####", CultureInfo.InvariantCulture)"
                                                  data-confirm="¿Confirmas el inicio de esta carga de secado?">

                                                @Html.AntiForgeryToken()

                                                <input type="hidden"
                                                       name="SecadoMaterialID"
                                                       value="@material.SecadoMaterialID" />

                                                <div class="form-row-2">
                                                    <div class="field">
                                                        <label>Tolva</label>

                                                        <select name="TolvaID"
                                                                class="js-tolva-select"
                                                                required>
                                                            <option value="">
                                                                Selecciona una tolva...
                                                            </option>

                                                            @foreach (var tolvaDisponible in tolvasCompatibles)
                                                            {
                                                                if (tolvaPredeterminada != null &&
                                                                tolvaDisponible.TolvaID == tolvaPredeterminada.TolvaID)
                                                                {
                                                                    <option value="@tolvaDisponible.TolvaID"
                                                                            data-capacity="@tolvaDisponible.CapacidadKg.ToString("0.####", CultureInfo.InvariantCulture)"
                                                                            selected>
                                                                        @tolvaDisponible.Texto
                                                                    </option>
                                                                }
                                                                else
                                                                {
                                                                    <option value="@tolvaDisponible.TolvaID"
                                                                            data-capacity="@tolvaDisponible.CapacidadKg.ToString("0.####", CultureInfo.InvariantCulture)">
                                                                        @tolvaDisponible.Texto
                                                                    </option>
                                                                }
                                                            }
                                                        </select>
                                                    </div>

                                                    <div class="field">
                                                        <label>Cantidad a cargar</label>

                                                        <input type="number"
                                                               name="CantidadKg"
                                                               class="js-cantidad-input"
                                                               min="0.0001"
                                                               step="0.0001"
                                                               value="@cantidadInicial.ToString("0.####", CultureInfo.InvariantCulture)"
                                                               required />

                                                        <span class="field-help js-capacity-hint"></span>
                                                    </div>
                                                </div>

                                                <div class="field">
                                                    <label>Observaciones</label>

                                                    <textarea name="Observaciones"
                                          maxlength="1000"
                                          placeholder="Condición del material, temperatura inicial, lote, observaciones del arranque, etc."></textarea>
                                                </div>

                                                <div class="actions">
                                                    <button type="submit"
                                                            class="btnx btnx-primary">
                                                        <i class="bi bi-play-circle"></i>
                                                        Iniciar carga
                                                    </button>

                                                    @if (material.EjecucionProduccionID.HasValue)
                                                    {
                                                        <a class="btnx btnx-outline"
                                                           asp-controller="Produccion"
                                                           asp-action="Detalle"
                                                           asp-route-id="@material.EjecucionProduccionID.Value">
                                                            <i class="bi bi-box-arrow-up-right"></i>
                                                            Ver producción
                                                        </a>
                                                    }
                                                </div>
                                            </form>
                                        </div>
                                    }
                                    else
                                    {
                                        <div class="no-tolva">
                                            <i class="bi bi-exclamation-triangle me-1"></i>
                                            No hay una tolva disponible compatible con
                                            <strong>@material.TipoProcesoTexto</strong>.
                                            Finaliza o libera otra carga antes de continuar.
                                        </div>
                                    }
                                }
                                else if (material.EjecucionProduccionID.HasValue)
                                {
                                    <div class="actions">
                                        <a class="btnx btnx-outline"
                                           asp-controller="Produccion"
                                           asp-action="Detalle"
                                           asp-route-id="@material.EjecucionProduccionID.Value">
                                            <i class="bi bi-box-arrow-up-right"></i>
                                            Ver producción
                                        </a>
                                    </div>
                                }
                            </article>
                        }
                    </div>
                </details>
            }
        }
        else
        {
            <div class="empty">
                <i class="bi bi-check2-circle"></i>
                <strong>No hay material pendiente por iniciar</strong>
                <span>
                    No se encontraron cantidades disponibles esperando una nueva carga de secado.
                </span>
            </div>
        }
    </section>

    <section class="section">
        <details class="material-group">
            <summary>
                <div class="group-title">
                    <div class="group-icon"
                         style="background:var(--dry-green-soft);color:var(--dry-green)">
                        <i class="bi bi-check2-circle"></i>
                    </div>

                    <div>
                        <strong>Material finalizado recientemente</strong>
                        <small>
                            @finalizados.Count material@(finalizados.Count == 1 ? "" : "es")
                            con secado completado
                        </small>
                    </div>
                </div>

                <span class="group-count">@finalizados.Count</span>
            </summary>

            @if (finalizados.Any())
            {
                <div style="padding:10px;background:var(--dry-bg)">
                    <div class="ready-list">
                        @foreach (var material in finalizados)
                        {
                            <div class="ready-row">
                                <div>
                                    <strong>@material.TextoMaquina</strong>
                                    <span>
                                        OF @(string.IsNullOrWhiteSpace(material.NumeroOF)
                                                                        ? "—"
                                                                        : material.NumeroOF)
                            </span>
                        </div>

                                <div>
                                    <strong>@material.TextoMaterial</strong>
                                    <span>
                                        @material.TipoProcesoTexto
                                        · @Cantidad(material.CantidadFinalizadaKg)
                                    </span>
                                </div>

                                <div>
                                    <strong>
                                        @Duracion(material.MinutosSecadoRequeridos)
                                    </strong>
                                    <span>Tiempo requerido</span>
                                </div>

                                <div>
                                    <strong>
                                        @Fecha(material.FechaUltimoFinSecado)
                                    </strong>
                                    <span>Última finalización</span>
                                </div>

                                <div>
                                    <span class="ok-text">
                                        <i class="bi bi-check-circle me-1"></i>
                                        Finalizado
                                    </span>
                                </div>
                            </div>
                                        }
                    </div>
                </div>
            }
            else
            {
                <div class="empty"
                     style="border:0;border-radius:0">
                    <i class="bi bi-clock-history"></i>
                    <strong>No hay material finalizado recientemente</strong>
                </div>
            }
        </details>
    </section>
</div>

<script>
    (function () {
        const page = document.getElementById('secadoPage');
        if (!page) return;

        let serverOffset = 0;

        const parsedServerNow = Date.parse(page.dataset.serverNow || '');

        if (Number.isFinite(parsedServerNow)) {
            serverOffset = parsedServerNow - Date.now();
        }

        const estadoUrl = page.dataset.estadoUrl || '';
        const toleranciaFinMinutos =
            Number.parseInt(page.dataset.toleranciaFin || '0', 10) || 0;

        function nowServer() {
            return Date.now() + serverOffset;
        }

        function formatDuration(milliseconds) {
            const totalSeconds = Math.max(
                0,
                Math.floor(milliseconds / 1000));

            const hours = Math.floor(totalSeconds / 3600);
            const minutes = Math.floor((totalSeconds % 3600) / 60);
            const seconds = totalSeconds % 60;

            return String(hours).padStart(2, '0') + ':' +
                   String(minutes).padStart(2, '0') + ':' +
                   String(seconds).padStart(2, '0');
        }

        function updateLoadCard(card) {
            const start = Date.parse(card.dataset.start || '');
            const end = Date.parse(card.dataset.end || '');

            if (!Number.isFinite(start) || !Number.isFinite(end))
                return;

            const now = nowServer();
            const remaining = end - now;
            const elapsed = Math.max(0, now - start);
            const total = Math.max(1, end - start);

            const percent = Math.min(
                100,
                Math.max(
                    0,
                    Math.round((elapsed * 100) / total)));

            const countdown = card.querySelector('.js-countdown');
            const subtitle = card.querySelector('.js-countdown-sub');
            const progress = card.querySelector('.js-progress');
            const status = card.querySelector('.js-load-status');
            const stateAlert = card.querySelector('.js-state-alert');
            const finishOpen = card.querySelector('.js-open-finish');
            const finishSubmit = card.querySelector('.js-finish-submit');

            if (progress) {
                progress.style.width = percent + '%';
            }

            if (remaining > 0) {
                if (countdown) {
                    countdown.textContent = formatDuration(remaining);
                }

                if (subtitle) {
                    subtitle.textContent =
                        'El proceso continúa hasta cumplir el tiempo requerido.';
                }

                if (finishOpen) {
                    finishOpen.disabled = true;
                }

                if (finishSubmit) {
                    finishSubmit.disabled = true;
                }

                const remainingMinutes =
                    Math.ceil(remaining / 60000);

                if (status) {
                    status.classList.remove(
                        'success',
                        'danger',
                        'warning');

                    if (remainingMinutes <= 15) {
                        status.classList.add('warning');
                        status.textContent = 'Próxima a terminar';
                    } else {
                        status.classList.add('primary');
                        status.textContent = 'En secado';
                    }
                }

                return;
            }

            const overdueMilliseconds =
                Math.max(0, now - end);

            const overdueMinutes =
                Math.floor(overdueMilliseconds / 60000);

            if (countdown) {
                if (overdueMilliseconds < 60000) {
                    countdown.textContent = 'TIEMPO CUMPLIDO';
                } else {
                    countdown.textContent =
                        '+' + formatDuration(overdueMilliseconds);
                }
            }

            if (subtitle) {
                subtitle.textContent =
                    overdueMinutes > 0
                        ? 'Tiempo adicional después del fin esperado.'
                        : 'La carga ya puede finalizarse.';
            }

            if (finishOpen) {
                finishOpen.disabled = false;
            }

            if (finishSubmit) {
                finishSubmit.disabled = false;
            }

            card.classList.add('is-ready');

            if (status) {
                status.classList.remove(
                    'primary',
                    'warning',
                    'success',
                    'danger');

                if (overdueMinutes > toleranciaFinMinutos) {
                    status.classList.add('danger');
                    status.textContent = 'Retrasada';
                    card.classList.add('is-danger');
                } else {
                    status.classList.add('success');
                    status.textContent = 'Tiempo cumplido';
                    card.classList.remove('is-danger');
                }
            }

            if (stateAlert) {
                if (overdueMinutes > toleranciaFinMinutos) {
                    stateAlert.innerHTML =
                        '<div class="load-alert danger">' +
                        '<i class="bi bi-exclamation-octagon-fill me-1"></i>' +
                        'La carga lleva <strong>' +
                        overdueMinutes +
                        ' minuto(s)</strong> después de su fin esperado.' +
                        '</div>';
                } else {
                    stateAlert.innerHTML =
                        '<div class="load-alert success">' +
                        '<i class="bi bi-check-circle-fill me-1"></i>' +
                        'El tiempo requerido ya se cumplió. ' +
                        'La carga puede finalizarse.' +
                        '</div>';
                }
            }
        }

        function updateAllLoads() {
            document
                .querySelectorAll('.js-load-card')
                .forEach(updateLoadCard);
        }

        document
            .querySelectorAll('.js-toggle-panel')
            .forEach(function (button) {
                button.addEventListener('click', function () {
                    if (button.disabled)
                        return;

                    const targetId =
                        button.dataset.target || '';

                    const panel =
                        document.getElementById(targetId);

                    if (!panel)
                        return;

                    const card =
                        button.closest('.js-load-card');

                    if (card) {
                        card
                            .querySelectorAll('.action-panel.show')
                            .forEach(function (other) {
                                if (other !== panel) {
                                    other.classList.remove('show');
                                }
                            });
                    }

                    panel.classList.toggle('show');

                    if (panel.classList.contains('show')) {
                        const firstField =
                            panel.querySelector(
                                'select, textarea, input:not([type="hidden"])');

                        if (firstField) {
                            window.setTimeout(function () {
                                firstField.focus();
                            }, 50);
                        }
                    }
                });
            });

        function configureStartForm(form) {
            const select =
                form.querySelector('.js-tolva-select');

            const quantity =
                form.querySelector('.js-cantidad-input');

            const hint =
                form.querySelector('.js-capacity-hint');

            const pending =
                Number.parseFloat(
                    form.dataset.pending || '0') || 0;

            if (!select || !quantity)
                return;

            function updateCapacity() {
                const option =
                    select.options[select.selectedIndex];

                if (!option || !option.value) {
                    quantity.removeAttribute('max');

                    if (hint) {
                        hint.textContent =
                            'Selecciona una tolva para consultar su capacidad.';
                    }

                    return;
                }

                const capacity =
                    Number.parseFloat(
                        option.dataset.capacity || '0') || 0;

                const allowed =
                    Math.max(
                        0,
                        Math.min(
                            pending,
                            capacity));

                quantity.max =
                    allowed.toFixed(4);

                let current =
                    Number.parseFloat(quantity.value || '0');

                if (!Number.isFinite(current) ||
                    current <= 0 ||
                    current > allowed) {

                    quantity.value =
                        allowed
                            .toFixed(4)
                            .replace(/\.?0+$/, '');
                }

                if (hint) {
                    hint.textContent =
                        'Disponible del material: ' +
                        pending.toFixed(4) +
                        ' KG · Capacidad de tolva: ' +
                        capacity.toFixed(4) +
                        ' KG · Máximo para esta carga: ' +
                        allowed.toFixed(4) +
                        ' KG';
                }

                validateQuantity();
            }

            function validateQuantity() {
                const option =
                    select.options[select.selectedIndex];

                const capacity =
                    option && option.value
                        ? Number.parseFloat(
                            option.dataset.capacity || '0') || 0
                        : 0;

                const allowed =
                    Math.max(
                        0,
                        Math.min(
                            pending,
                            capacity));

                const value =
                    Number.parseFloat(
                        quantity.value || '0');

                quantity.setCustomValidity('');

                if (!Number.isFinite(value) ||
                    value <= 0) {
                    quantity.setCustomValidity(
                        'La cantidad debe ser mayor a cero.');

                    return;
                }

                if (value > pending + 0.0005) {
                    quantity.setCustomValidity(
                        'La cantidad supera el material pendiente por asignar.');

                    return;
                }

                if (value > capacity + 0.0005) {
                    quantity.setCustomValidity(
                        'La cantidad supera la capacidad de la tolva seleccionada.');

                    return;
                }

                if (value > allowed + 0.0005) {
                    quantity.setCustomValidity(
                        'La cantidad indicada no es válida para esta carga.');
                }
            }

            select.addEventListener(
                'change',
                updateCapacity);

            quantity.addEventListener(
                'input',
                validateQuantity);

            updateCapacity();
        }

        document
            .querySelectorAll('.js-start-form')
            .forEach(configureStartForm);

        document
            .querySelectorAll('.js-post-form')
            .forEach(function (form) {
                form.addEventListener('submit', function (event) {
                    if (!form.checkValidity()) {
                        return;
                    }

                    const message =
                        form.dataset.confirm || '';

                    if (message &&
                        !window.confirm(message)) {
                        event.preventDefault();
                        return;
                    }

                    const submitButton =
                        form.querySelector(
                            'button[type="submit"]');

                    if (submitButton) {
                        submitButton.disabled = true;

                        submitButton.innerHTML =
                            '<span class="spinner-border spinner-border-sm" aria-hidden="true"></span>' +
                            ' Procesando...';
                    }
                });
            });

        async function syncLoadState(card) {
            if (!estadoUrl)
                return;

            const loadId =
                card.dataset.loadId || '';

            if (!loadId)
                return;

            try {
                const response = await fetch(
                    estadoUrl +
                    '?id=' +
                    encodeURIComponent(loadId),
                    {
                        method: 'GET',
                        credentials: 'same-origin',
                        headers: {
                            'X-Requested-With': 'XMLHttpRequest'
                        }
                    });

                if (!response.ok)
                    return;

                const data =
                    await response.json();

                if (!data)
                    return;

                const estado =
                    String(data.estado || '')
                        .toUpperCase();

                if (estado &&
                    estado !== 'EN_PROCESO') {

                    window.location.reload();
                    return;
                }

                if (data.ahoraServidor) {
                    const serverNow =
                        Date.parse(data.ahoraServidor);

                    if (Number.isFinite(serverNow)) {
                        serverOffset =
                            serverNow - Date.now();
                    }
                }

                if (data.fechaInicioReal) {
                    card.dataset.start =
                        data.fechaInicioReal;
                }

                if (data.fechaFinEsperada) {
                    card.dataset.end =
                        data.fechaFinEsperada;

                    const label =
                        card.querySelector(
                            '.js-end-label');

                    if (label) {
                        const date =
                            new Date(
                                data.fechaFinEsperada);

                        if (!Number.isNaN(
                            date.getTime())) {

                            label.textContent =
                                date.toLocaleDateString(
                                    'es-MX',
                                    {
                                        day: '2-digit',
                                        month: '2-digit',
                                        year: 'numeric'
                                    }) +
                                ' ' +
                                date.toLocaleTimeString(
                                    'es-MX',
                                    {
                                        hour: '2-digit',
                                        minute: '2-digit',
                                        hour12: false
                                    });
                        }
                    }
                }

                updateLoadCard(card);
            }
            catch {
                
            }
        }

        async function syncAllLoadStates() {
            const cards =
                Array.from(
                    document.querySelectorAll(
                        '.js-load-card'));

            for (const card of cards) {
                await syncLoadState(card);
            }
        }

        updateAllLoads();

        if (document.querySelector('.js-load-card')) {
            window.setInterval(
                updateAllLoads,
                1000);

            window.setInterval(
                syncAllLoadStates,
                60000);
        }
    })();
</script>