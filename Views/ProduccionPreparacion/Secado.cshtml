@using ERP.NSQuell.Models
@using System.Linq
@model ProduccionPreparacionIndexVm
@{
    Layout = "_Layout";
    ViewData["Title"] = "Secado de material";

    var tareas = Model.Tareas ?? new List<ProduccionPreparacionTareaVm>();
    var secados = tareas.Where(x => x.EsSecadoMaterial).ToList();

    var pendientes = secados
        .Where(x => x.EstaPendiente)
        .OrderBy(x => x.FechaAviso)
        .ThenBy(x => x.FechaObjetivo)
        .ToList();

    var secando = secados
        .Where(x => x.EstaConfirmada &&
                    x.FechaDisponibleEstimada.HasValue &&
                    x.FechaDisponibleEstimada.Value > Model.FechaConsulta)
        .OrderBy(x => x.FechaDisponibleEstimada)
        .ToList();

    var listos = secados
        .Where(x => x.EstaConfirmada &&
                    x.FechaDisponibleEstimada.HasValue &&
                    x.FechaDisponibleEstimada.Value <= Model.FechaConsulta)
        .OrderByDescending(x => x.FechaDisponibleEstimada)
        .Take(40)
        .ToList();

    var filtroActual = string.IsNullOrWhiteSpace(Model.Filtro) ? "" : Model.Filtro;

    bool LlegariaTardeSiIniciaAhora(ProduccionPreparacionTareaVm tarea)
    {
        if (!tarea.HorasSecado.HasValue ||
            tarea.HorasSecado.Value <= 0 ||
            !tarea.FechaArranque.HasValue)
            return false;

        return Model.FechaConsulta
            .AddHours(Convert.ToDouble(tarea.HorasSecado.Value)) >
            tarea.FechaArranque.Value;
    }

    int MinutosRetrasoSiIniciaAhora(ProduccionPreparacionTareaVm tarea)
    {
        if (!LlegariaTardeSiIniciaAhora(tarea) ||
            !tarea.HorasSecado.HasValue ||
            !tarea.FechaArranque.HasValue)
            return 0;

        var disponible = Model.FechaConsulta
            .AddHours(Convert.ToDouble(tarea.HorasSecado.Value));

        return Math.Max(
            0,
            (int)Math.Ceiling(
                (disponible - tarea.FechaArranque.Value).TotalMinutes));
    }

    var riesgosPendientes = pendientes.Count(LlegariaTardeSiIniciaAhora);
    var riesgosEnProceso = secando.Count(x => x.SecadoLlegaraTarde);
    var totalRiesgos = riesgosPendientes + riesgosEnProceso;

    string Fecha(DateTime? value) => value?.ToString("dd/MM/yyyy HH:mm") ?? "—";
    string Hora(DateTime? value) => value?.ToString("HH:mm") ?? "—";
    string Horas(decimal? value) => value.HasValue ? $"{value.Value:0.##} h" : "—";

    string ClasePendiente(ProduccionPreparacionTareaVm tarea)
    {
        if (LlegariaTardeSiIniciaAhora(tarea)) return "task-risk";
        if (tarea.EsVencida) return "task-overdue";
        if (tarea.EsHacerAhora) return "task-now";
        return "task-next";
    }

    string BadgePendiente(ProduccionPreparacionTareaVm tarea)
    {
        if (LlegariaTardeSiIniciaAhora(tarea)) return "risk";
        if (tarea.EsVencida) return "overdue";
        if (tarea.EsHacerAhora) return "now";
        return "next";
    }

    string TextoPendiente(ProduccionPreparacionTareaVm tarea)
    {
        if (LlegariaTardeSiIniciaAhora(tarea)) return "Riesgo de atraso";
        if (tarea.EsVencida) return "Vencido";
        if (tarea.EsHacerAhora) return "Iniciar ahora";
        return "Próximo";
    }
}
