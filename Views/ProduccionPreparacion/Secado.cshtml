            margin-top: 2px;
            color: var(--dry-muted);
            font-size: .57rem;
            font-weight: 800;
        }

    .progressx {
        margin-top: 9px;
        height: 8px;
        border-radius: 999px;
        background: #e9edf5;
        overflow: hidden;
    }

    html[data-nsq-theme="dark"] .progressx,
    html[data-bs-theme="dark"] .progressx {
        background: #233149;
    }

    .progressx > div {
        width: 0;
        height: 100%;
        border-radius: 999px;
        background: var(--dry-orange);
        transition: width .25s ease;
    }

    .load-card.is-ready .progressx > div {
        background: var(--dry-green);
    }

    .load-card.is-danger .progressx > div {
        background: var(--dry-red);
    }

    .load-alert {
        margin-top: 9px;
        border-radius: 10px;
        padding: 9px 10px;
        font-size: .64rem;
        font-weight: 850;
    }

        .load-alert.warning {
            background: var(--dry-orange-soft);
            color: var(--dry-orange-dark);
            border: 1px solid #edcf93;
        }

        .load-alert.success {
            background: var(--dry-green-soft);
            color: var(--dry-green);
            border: 1px solid #afdcc6;
        }

        .load-alert.danger {
            background: var(--dry-red-soft);
            color: var(--dry-red);
            border: 1px solid #efb1ad;
        }

    .actions {
        margin-top: 11px;
        display: flex;
        gap: 8px;
        flex-wrap: wrap;
        align-items: center;
    }

    .action-panel {
        display: none;
        margin-top: 10px;
        padding: 11px;
        border: 1px solid var(--dry-line);
        border-radius: 12px;
        background: var(--dry-gray-soft);
    }

        .action-panel.show {
            display: block;
        }

    .action-form {
        display: grid;
        gap: 9px;
    }

    .form-row-2 {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 9px;
    }

    .panel-title {
        display: flex;
        gap: 8px;
        align-items: center;
        margin-bottom: 9px;
        color: var(--dry-text);
        font-size: .72rem;
        font-weight: 950;
    }

    .segment-details,
    .history-details,
    .tolva-details {
        margin-top: 10px;
        border: 1px solid var(--dry-line);
        border-radius: 11px;
        overflow: hidden;
        background: var(--dry-card);
    }

        .segment-details summary,
        .history-details summary,
        .tolva-details summary {
            list-style: none;
            cursor: pointer;
            padding: 9px 10px;
            color: var(--dry-muted);
            font-size: .63rem;
            font-weight: 900;
            display: flex;
            align-items: center;
            gap: 7px;
        }

            .segment-details summary::-webkit-details-marker,
            .history-details summary::-webkit-details-marker,
            .tolva-details summary::-webkit-details-marker {
                display: none;
            }

    .segment-list {
        border-top: 1px solid var(--dry-line);
    }

    .segment-row {
        display: grid;
        grid-template-columns: 70px 1fr 1fr auto;
        gap: 8px;
        align-items: center;
        padding: 8px 10px;
        border-top: 1px solid var(--dry-line);
        font-size: .61rem;
    }

        .segment-row:first-child {
            border-top: 0;
        }

        .segment-row strong {
            color: var(--dry-text);
            font-weight: 900;
        }

        .segment-row span {
            color: var(--dry-muted);
            font-weight: 700;
        }

    .material-group {
        margin-bottom: 12px;
        background: var(--dry-card);
        border: 1px solid var(--dry-line);
        border-radius: 16px;
        overflow: hidden;
        box-shadow: var(--dry-shadow);
    }

        .material-group > summary {
            list-style: none;
            cursor: pointer;
            padding: 13px 15px;
            display: flex;
            align-items: center;
            justify-content: space-between;
            gap: 12px;
            border-bottom: 1px solid transparent;
        }

        .material-group[open] > summary {
            border-bottom-color: var(--dry-line);
        }

        .material-group > summary::-webkit-details-marker {
            display: none;
        }

    .group-title {
        display: flex;
        gap: 10px;
        align-items: center;
        min-width: 0;
    }

    .group-icon {
        width: 36px;
        height: 36px;
        border-radius: 10px;
        background: var(--dry-orange-soft);
        color: var(--dry-orange);
        display: grid;
        place-items: center;
        flex: none;
    }

    .group-title strong {
        display: block;
        color: var(--dry-text);
        font-size: .8rem;
        font-weight: 950;
    }

    .group-title small {
        display: block;
        margin-top: 2px;
        color: var(--dry-muted);
        font-size: .61rem;
        font-weight: 750;
    }

    .group-count {
        margin-left: auto;
        padding: 5px 9px;
        border-radius: 999px;
        background: var(--dry-orange-soft);
        color: var(--dry-orange);
        font-size: .61rem;
        font-weight: 950;
    }

    .material-grid {
        padding: 10px;
        background: var(--dry-bg);
        display: grid;
        grid-template-columns: repeat(2,minmax(0,1fr));
        gap: 10px;
    }

    .pending-card {
        background: var(--dry-card);
        border: 1px solid var(--dry-line);
        border-radius: 15px;
        padding: 13px;
    }

        .pending-card.is-alert {
            border: 2px solid var(--dry-red);
        }

        .pending-card.is-partial {
            border-left: 5px solid var(--dry-orange);
        }

    .pending-head {
        display: flex;
        justify-content: space-between;
        align-items: flex-start;
        gap: 10px;
    }

    .pending-title {
        display: flex;
        gap: 10px;
        min-width: 0;
    }

    .pending-icon {
        width: 41px;
        height: 41px;
        border-radius: 12px;
        background: var(--dry-purple-soft);
        color: var(--dry-purple);
        display: grid;
        place-items: center;
        flex: none;
    }

    .pending-title h3 {
        margin: 0;
        color: var(--dry-text);
        font-size: .86rem;
        font-weight: 950;
        overflow-wrap: anywhere;
    }

    .pending-title small {
        display: block;
        margin-top: 3px;
        color: var(--dry-muted);
        font-size: .62rem;
        font-weight: 700;
    }

    .chips {
        display: flex;
        flex-wrap: wrap;
        gap: 5px;
        margin-bottom: 4px;
    }

    .chip {
        display: inline-flex;
        align-items: center;
        gap: 4px;
        padding: 4px 7px;
        border-radius: 999px;
        background: var(--dry-blue-soft);
        color: var(--dry-blue);
        font-size: .56rem;
        font-weight: 900;
    }

    .process-row {
        margin-top: 10px;
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 7px;
    }

    .process-box {
        border: 1px solid var(--dry-line);
        border-radius: 11px;
        padding: 9px 10px;
    }

        .process-box.primary {
            background: var(--dry-orange-soft);
        }

        .process-box span {
            display: block;
            color: var(--dry-muted);
            font-size: .54rem;
            text-transform: uppercase;
            font-weight: 950;
        }

        .process-box strong {
            display: block;
            margin-top: 3px;
            color: var(--dry-text);
            font-size: .74rem;
            font-weight: 950;
        }

    .quantity-grid {
        margin-top: 8px;
        display: grid;
        grid-template-columns: repeat(4,minmax(0,1fr));
        gap: 6px;
    }

    .quantity-box {
        border: 1px solid var(--dry-line);
        border-radius: 10px;
        padding: 8px;
    }

        .quantity-box span {
            display: block;
            color: var(--dry-muted);
            font-size: .51rem;
            text-transform: uppercase;
            font-weight: 950;
        }

        .quantity-box strong {
            display: block;
            margin-top: 3px;
            color: var(--dry-text);
            font-size: .67rem;
            font-weight: 950;
        }

        .quantity-box.remaining {
            background: var(--dry-orange-soft);
        }

    .schedule-grid {
        margin-top: 8px;
        display: grid;
        grid-template-columns: repeat(2,minmax(0,1fr));
        gap: 6px;
    }

    .schedule-box {
        border: 1px solid var(--dry-line);
        border-radius: 9px;
        padding: 8px;
    }

        .schedule-box span {
            display: block;
            color: var(--dry-muted);
            font-size: .51rem;
            font-weight: 950;
            text-transform: uppercase;
        }

        .schedule-box strong {
            display: block;
            margin-top: 3px;
            color: var(--dry-text);
            font-size: .63rem;
            font-weight: 850;
        }

    .start-panel {
        margin-top: 10px;
        padding-top: 10px;
        border-top: 1px solid var(--dry-line);
    }

    .no-tolva {
        margin-top: 10px;
        padding: 9px 10px;
        border-radius: 10px;
        background: var(--dry-red-soft);
        color: var(--dry-red);
        font-size: .63rem;
        font-weight: 850;
    }

    .ready-list {
        background: var(--dry-card);
        border: 1px solid var(--dry-line);
        border-radius: 16px;
        overflow: hidden;
        box-shadow: var(--dry-shadow);
    }

    .ready-row {
        display: grid;
        grid-template-columns: 1.05fr 1.4fr .8fr 1fr auto;
        gap: 10px;
        align-items: center;
        padding: 11px 13px;
        border-top: 1px solid var(--dry-line);
        font-size: .66rem;
    }

        .ready-row:first-child {
            border-top: 0;
        }

        .ready-row strong {
            display: block;
            color: var(--dry-text);
            font-weight: 900;
        }

        .ready-row span {
            display: block;
            margin-top: 2px;
            color: var(--dry-muted);
            font-weight: 750;
        }

    .ok-text {
        color: var(--dry-green) !important;
        font-weight: 950 !important;
    }

    .empty {
        background: var(--dry-card);
        border: 1px dashed var(--dry-line);
        border-radius: 15px;
        padding: 28px 18px;
        text-align: center;
        color: var(--dry-muted);
    }

        .empty i {
            display: block;
            margin-bottom: 7px;
            font-size: 1.5rem;
        }

        .empty strong {
            display: block;
            color: var(--dry-text);
            font-size: .82rem;
            font-weight: 950;
        }

        .empty span {
            display: block;
            margin-top: 4px;
            font-size: .66rem;
            font-weight: 700;
        }

    .stat-priority {
        border-color: #e7bc68;
        background: linear-gradient(135deg,var(--dry-card),var(--dry-orange-soft));
    }

    .stat-sub {
        display: block;
        margin-top: 4px;
        color: var(--dry-muted);
        font-size: .58rem;
        font-weight: 750;
    }

    .section-priority {
        margin-top: 20px;
        padding: 14px;
        border: 1px solid #edcf93;
        border-radius: 20px;
        background: linear-gradient(180deg,var(--dry-orange-soft),transparent 190px);
    }

    html[data-nsq-theme="dark"] .section-priority,
    html[data-bs-theme="dark"] .section-priority {
        border-color: #5a4318;
    }

    .section-kpi {
        display: flex;
        gap: 8px;
        align-items: center;
        flex-wrap: wrap;
    }

        .section-kpi .kg-pill {
            padding: 7px 11px;
            border-radius: 999px;
            background: var(--dry-orange-soft);
            color: var(--dry-orange-dark);
            font-size: .68rem;
            font-weight: 950;
            white-space: nowrap;
        }

    .waiting-section {
        padding: 14px;
        border: 1px solid var(--dry-line);
        border-radius: 20px;
        background: linear-gradient(180deg,var(--dry-blue-soft),transparent 190px);
    }

    .waiting-machine {
        margin-bottom: 11px;
        background: var(--dry-card);
        border: 1px solid var(--dry-line);
        border-radius: 16px;
        overflow: hidden;
        box-shadow: var(--dry-shadow);
    }

        .waiting-machine > summary {
            list-style: none;
            cursor: pointer;
            padding: 12px 14px;
            display: flex;
            align-items: center;
            gap: 10px;
            justify-content: space-between;
        }

            .waiting-machine > summary::-webkit-details-marker {
                display: none;
            }

    .waiting-machine-title {
        display: flex;
        align-items: center;
        gap: 10px;
        min-width: 0;
    }

        .waiting-machine-title i {
            width: 36px;
            height: 36px;
            display: grid;
            place-items: center;
            border-radius: 10px;
            background: var(--dry-blue-soft);
            color: var(--dry-blue);
            flex: none;
        }

        .waiting-machine-title strong {
            display: block;
            font-size: .8rem;
            font-weight: 950;
            color: var(--dry-text);
        }

        .waiting-machine-title small {
            display: block;
            margin-top: 2px;
            color: var(--dry-muted);
            font-size: .61rem;
            font-weight: 750;
        }

    .waiting-machine-kpi {
        display: flex;
        align-items: center;
        gap: 7px;
        flex-wrap: wrap;
        justify-content: flex-end;
    }

    .waiting-kg {
        margin-top: 10px;
        padding: 11px 12px;
        border-radius: 12px;
        background: linear-gradient(135deg,var(--dry-blue-soft),var(--dry-card));
        border: 1px solid #b9c9f2;
        display: flex;
        justify-content: space-between;
        align-items: center;
        gap: 12px;
    }

    html[data-nsq-theme="dark"] .waiting-kg,
    html[data-bs-theme="dark"] .waiting-kg {
        border-color: #344b72;
    }

    .waiting-kg span {
        color: var(--dry-muted);
        font-size: .58rem;
        font-weight: 950;
        text-transform: uppercase;
        letter-spacing: .04em;
    }

    .waiting-kg strong {
        color: var(--dry-blue);
        font-size: 1.08rem;
        font-weight: 950;
        white-space: nowrap;
    }

    .waiting-foot {
        margin-top: 9px;
        display: flex;
        gap: 8px;
        justify-content: space-between;
        align-items: center;
        flex-wrap: wrap;
        padding-top: 9px;
        border-top: 1px dashed var(--dry-line);
        color: var(--dry-muted);
        font-size: .61rem;
        font-weight: 750;
    }


    /* NSQ_SECADO_LHRH_V1_START */
    .pair-card { border:2px solid #9d83ff; background:linear-gradient(180deg,var(--dry-purple-soft),var(--dry-card) 170px); }
    .pair-banner { display:flex; align-items:center; justify-content:space-between; gap:10px; margin:10px 0; padding:10px 12px; border-radius:12px; background:var(--dry-purple-soft); color:var(--dry-purple); font-size:.66rem; font-weight:850; }
    .pair-banner strong { font-weight:950; }
    .pair-badge { display:inline-flex; align-items:center; gap:5px; padding:5px 8px; border-radius:999px; background:var(--dry-purple-soft); color:var(--dry-purple); font-size:.58rem; font-weight:950; }
    .side-badge { display:inline-grid; place-items:center; min-width:34px; height:28px; padding:0 8px; border-radius:9px; font-size:.61rem; font-weight:950; }
    .side-badge.lh { background:#eaf3ff; color:#2456b5; }
    .side-badge.rh { background:#fff0e7; color:#b55319; }
    .side-badge.na { background:var(--dry-gray-soft); color:var(--dry-muted); }
    .pair-components { display:grid; gap:8px; margin-top:9px; }
    .pair-component { display:grid; grid-template-columns:auto minmax(0,1fr) auto; gap:9px; align-items:center; padding:9px 10px; border:1px solid var(--dry-line); border-radius:11px; background:var(--dry-card); }
    .pair-component-main strong { display:block; color:var(--dry-text); font-size:.71rem; font-weight:950; overflow-wrap:anywhere; }
    .pair-component-main span { display:block; margin-top:2px; color:var(--dry-muted); font-size:.59rem; font-weight:750; }
    .pair-component-kg { text-align:right; }
    .pair-component-kg strong { display:block; color:var(--dry-text); font-size:.72rem; font-weight:950; }
    .pair-component-kg span { display:block; margin-top:2px; color:var(--dry-muted); font-size:.54rem; font-weight:800; }
    .pair-qty-grid { display:grid; grid-template-columns:repeat(2,minmax(0,1fr)); gap:8px; }
    .pair-qty-item { padding:9px; border:1px solid var(--dry-line); border-radius:10px; background:var(--dry-card); }
    .pair-qty-head { display:flex; align-items:center; gap:7px; margin-bottom:6px; }
    .pair-qty-head strong { color:var(--dry-text); font-size:.65rem; font-weight:950; }
    .pair-summary { margin-top:8px; padding:9px 10px; border-radius:10px; background:var(--dry-orange-soft); color:var(--dry-orange-dark); font-size:.63rem; font-weight:850; }
    .load-components { display:grid; gap:7px; width:100%; }
    .load-component { display:grid; grid-template-columns:auto minmax(0,1fr) auto; gap:8px; align-items:center; padding:8px 9px; border:1px solid var(--dry-line); border-radius:10px; background:var(--dry-card); }
    .load-component strong { display:block; color:var(--dry-text); font-size:.68rem; font-weight:950; }
    .load-component small { display:block; margin-top:2px; color:var(--dry-muted); font-size:.57rem; font-weight:750; }
    .load-component .kg { color:var(--dry-text); font-size:.69rem; font-weight:950; white-space:nowrap; }
    .pair-links { display:flex; gap:6px; flex-wrap:wrap; }
    @@media(max-width:720px) { .pair-qty-grid { grid-template-columns:1fr; } .pair-component,.load-component { grid-template-columns:auto minmax(0,1fr); } .pair-component-kg,.load-component .kg { grid-column:2; text-align:left; } }
    /* NSQ_SECADO_LHRH_V1_END */

    @@media(max-width:1200px) {
        .tolva-grid {
            grid-template-columns: repeat(2,minmax(0,1fr));
        }

        .running-grid,
        .material-grid,
        .planned-grid {
            grid-template-columns: 1fr;
        }

        .stats {
            grid-template-columns: repeat(2,minmax(0,1fr));
        }
    }

    @@media(max-width:900px) {
        .filters {
            grid-template-columns: 1fr 1fr;
        }

        .info-grid,
        .quantity-grid {
            grid-template-columns: repeat(2,minmax(0,1fr));
        }
    }

    @@media(max-width:720px) {
        .dry-page {
            padding: 10px;
        }

        .hero {
            flex-direction: column;
            align-items: flex-start;
        }

        .hero-actions {
            justify-content: flex-start;
            width: 100%;
        }

        .stats,
        .filters,
        .tolva-grid,
        .process-row,
        .form-row-2 {
            grid-template-columns: 1fr;
        }

        .timer-box {
            grid-template-columns: 1fr;
        }

        .timer-target {
            text-align: left;
        }

        .ready-row {
            grid-template-columns: 1fr 1fr;
        }

        .segment-row {
            grid-template-columns: 1fr 1fr;
        }
    }
    /* NSQ_SECADO_OF_MATERIAL_V1_CSS_START */
    .nsq-early-finish-v1 {
        margin: 8px 0 10px;
        padding: 11px 12px;
        border: 1px solid #ef8e87;
        border-radius: 12px;
        background: var(--dry-red-soft);
        color: var(--dry-red);
        display: grid;
        gap: 4px;
        font-size: .7rem;
        font-weight: 800;
    }

    .nsq-early-finish-v1 strong {
        font-weight: 950;
    }

    .nsq-early-reason-v1 textarea {
        border-color: #ef8e87;
    }

    .nsq-secado-parametros-v1 small {
        display: block;
        margin-top: 3px;
        color: var(--dry-muted);
        font-size: .61rem;
        line-height: 1.25;
    }

    .nsq-secado-parametros-v1.is-max-warning strong,
    .nsq-secado-parametros-v1.is-max-warning small {
        color: var(--dry-red);
    }
    /* NSQ_SECADO_OF_MATERIAL_V1_CSS_END */
</style>

<div class="dry-page"
     id="secadoPage"
     data-server-now="@Model.FechaConsulta.ToString("O")"
     data-estado-url="@Url.Action("EstadoSecado", "ProduccionPreparacion")"
     data-tolerancia-fin="@Model.Configuracion.MinutosToleranciaFin">

    <section class="hero">
        <div class="hero-main">
            <div class="hero-icon">
                <i class="bi bi-thermometer-sun"></i>
            </div>

            <div>
                <h1>Secado de material</h1>
                <p>
                    Control operativo de materia prima recibida, cargas de secado,
                    tolvas, cambios de tolva y liberación del material al cumplir
                    el tiempo requerido.
                </p>
            </div>
        </div>

        <div class="hero-actions">
            <a class="btnx btnx-light"
               asp-controller="ProduccionPreparacion"
               asp-action="Index">
                <i class="bi bi-grid-1x2"></i>
                Tablero
            </a>

            <a class="btnx btnx-light"
               asp-controller="ProduccionPreparacion"
               asp-action="CambioMolde">
                <i class="bi bi-tools"></i>
                Cambios de molde
            </a>

            <a class="btnx btnx-light"
               asp-controller="ProduccionPreparacion"
               asp-action="Embalajes">
                <i class="bi bi-box-seam"></i>
                Embalajes
            </a>

            <a class="btnx btnx-light"
               asp-controller="ProduccionPreparacion"
               asp-action="Historial">
                <i class="bi bi-clock-history"></i>
                Historial
            </a>

            <a class="btnx btnx-light"
               asp-controller="Produccion"
               asp-action="Index">
                <i class="bi bi-arrow-left"></i>
                Producción
            </a>
        </div>
    </section>

    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success flash">
            <i class="bi bi-check-circle me-1"></i>
            @TempData["Success"]
        </div>
    }

    @if (TempData["Warning"] != null)
    {
        <div class="alert alert-warning flash">
            <i class="bi bi-exclamation-triangle me-1"></i>
            @TempData["Warning"]
        </div>
    }

    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger flash">
            <i class="bi bi-exclamation-octagon me-1"></i>
            @TempData["Error"]
        </div>
    }

    @if (!Model.PuedeGestionarSecado)
    {
        <div class="permission-note">
            <i class="bi bi-eye fs-5"></i>
            <div>
                <strong>Modo consulta</strong>
                Puedes consultar el estado del secado, pero tu usuario no tiene permiso
                para iniciar cargas, cambiar tolvas o finalizar procesos.
            </div>
        </div>
    }

    @if (totalAlertas > 0)
    {
        <div class="alert-banner">
            <i class="bi bi-exclamation-triangle-fill fs-5"></i>
            <div>
                <strong>Hay procesos que requieren atención.</strong>

                @if (Model.TotalAlertasEspera > 0)
                {
                    <span>
                        @Model.TotalAlertasEspera material(es) llevan más tiempo del permitido
                        esperando iniciar secado.
                    </span>
                }

                @if (totalCargasRetrasadas > 0)
                {
                    <span>
                        @totalCargasRetrasadas carga(s) ya superaron su tiempo esperado
                        más la tolerancia configurada.
                    </span>
                }
            </div>
        </div>
    }

    <section class="stats">
        <div class="stat stat-priority">
            <div class="stat-icon orange"><i class="bi bi-box2-heart"></i></div>
            <div>
                <span class="stat-value">@Cantidad(totalKgPendientesSecado)</span>
                <span class="stat-label">MP disponible para secar</span>
                <span class="stat-sub">@pendientes.Count lote@(pendientes.Count == 1 ? "" : "s") pendiente@(pendientes.Count == 1 ? "" : "s")</span>
            </div>
        </div>
        <div class="stat">
            <div class="stat-icon blue"><i class="bi bi-droplet-half"></i></div>
            <div>
                <span class="stat-value">@cargasActivas.Count</span>
                <span class="stat-label">Cargas en proceso</span>
                <span class="stat-sub">Secado activo en tolva</span>
            </div>
        </div>
        <div class="stat">
            <div class="stat-icon blue"><i class="bi bi-truck"></i></div>
            <div>
                <span class="stat-value">@Cantidad(totalKgEsperadosRecepcion)</span>
                <span class="stat-label">MP esperando recepción</span>
                <span class="stat-sub">@pendientesPlaneacion.Count OF@(pendientesPlaneacion.Count == 1 ? "" : "s") pendiente@(pendientesPlaneacion.Count == 1 ? "" : "s")</span>
            </div>
        </div>
        <div class="stat">
            <div class="stat-icon green"><i class="bi bi-box-arrow-in-down"></i></div>
            <div>
                <span class="stat-value">@Model.TotalTolvasDisponibles</span>
                <span class="stat-label">Tolvas disponibles</span>
                <span class="stat-sub">@Model.TotalTolvasOcupadas ocupada@(Model.TotalTolvasOcupadas == 1 ? "" : "s")</span>
            </div>
        </div>
        <div class="stat">
            <div class="stat-icon red"><i class="bi bi-exclamation-octagon"></i></div>
            <div>
                <span class="stat-value">@totalAlertas</span>
                <span class="stat-label">Alertas operativas</span>
                <span class="stat-sub">Espera o cargas retrasadas</span>
            </div>
        </div>
    </section>

    <form method="get"
          asp-controller="ProduccionPreparacion"
          asp-action="Secado"
          class="filters">

        <div class="field">
            <label>Buscar</label>
            <input type="text"
                   name="filtro"
                   value="@filtroActual"
                   placeholder="OF, material o máquina..." />
        </div>

        <div class="field">
            <label>Máquina</label>
            <select name="maquinaId">
                <option value="">Todas las máquinas</option>

                @foreach (var maquina in Model.Maquinas)
                {
                    if (Model.MaquinaID == maquina.MaquinaID)
                    {
                        <option value="@maquina.MaquinaID" selected>
                            @maquina.Texto
                        </option>
                    }
                    else
                    {
                        <option value="@maquina.MaquinaID">
                            @maquina.Texto
                        </option>
                    }
                }
            </select>
        </div>

        <button class="btnx btnx-primary" type="submit">
            <i class="bi bi-search"></i>
            Filtrar
        </button>

        <a class="btnx btnx-outline"
           asp-controller="ProduccionPreparacion"
           asp-action="Secado">
            <i class="bi bi-arrow-counterclockwise"></i>
            Limpiar
        </a>
    </form>

    <section class="section section-priority">
        <div class="section-head">
            <div>
                <h2><i class="bi bi-thermometer-sun me-1"></i> Material listo para entrar a secado</h2>
                <p>La MP permanece separada por OF. Cuando Planeación marca una pareja LH/RH, ambas OF se muestran juntas y se inicia una sola carga física con cantidades independientes.</p>
            </div>
            <div class="section-kpi">
                <span class="kg-pill">@Cantidad(totalKgPendientesSecado) disponibles</span>
                <span class="section-count">@totalGruposPendientes</span>
            </div>
        </div>
        @if (pendientes.Any())
        {
            foreach (var grupoMaquina in pendientes.GroupBy(x => new { x.MaquinaProgramadaID, x.MaquinaProgramadaCodigo, x.MaquinaProgramadaNombre }).OrderBy(x => x.Key.MaquinaProgramadaCodigo).ThenBy(x => x.Key.MaquinaProgramadaNombre))
            {
                var maquinaTexto = string.IsNullOrWhiteSpace(grupoMaquina.Key.MaquinaProgramadaCodigo) ? "Sin máquina" : string.IsNullOrWhiteSpace(grupoMaquina.Key.MaquinaProgramadaNombre) ? grupoMaquina.Key.MaquinaProgramadaCodigo : $"{grupoMaquina.Key.MaquinaProgramadaCodigo} - {grupoMaquina.Key.MaquinaProgramadaNombre}";
                var gruposOperativos = grupoMaquina.GroupBy(x => x.GrupoLhRh.HasValue ? $"LHRH:{x.GrupoLhRh.Value}" : $"MAT:{x.SecadoMaterialID}").Select(x => x.OrderBy(y => y.LadoLhRh).ThenBy(y => y.NumeroOF).ThenBy(y => y.SecadoMaterialID).ToList()).OrderBy(x => x.Min(y => y.FechaInicioSecadoObjetivo ?? DateTime.MaxValue)).ToList();
                <details class="material-group" open>
                    <summary>
                        <div class="group-title"><div class="group-icon"><i class="bi bi-building-gear"></i></div><div><strong>@maquinaTexto</strong><small>@gruposOperativos.Count carga@(gruposOperativos.Count == 1 ? "" : "s") operativa(s) pendiente(s)</small></div></div>
                        <span class="group-count">@gruposOperativos.Count</span>
                    </summary>
                    <div class="material-grid">
                        @foreach (var grupoMaterial in gruposOperativos)
                        {
                            var principal = grupoMaterial.First();
                            var esPareja = principal.GrupoLhRh.HasValue;
                            var grupoLhRh = principal.GrupoLhRh;
                            var programasGrupo = grupoMaterial.Where(x => x.ProgramaProduccionID.HasValue).Select(x => x.ProgramaProduccionID!.Value).Distinct().ToList();
                            var parejaCompleta = !esPareja || programasGrupo.Count >= 2;
                            var procesos = grupoMaterial.Select(x => x.TipoProceso?.Trim().ToUpperInvariant() ?? ProduccionSecadoTipoProceso.Secado).Distinct().ToList();
                            var procesoCompatible = procesos.Count == 1;
                            var tipoProcesoGrupo = principal.TipoProceso;
                            var duracionGrupo = grupoMaterial.Max(x => x.MinutosSecadoRequeridos);
                            var cantidadGrupo = grupoMaterial.Sum(x => x.CantidadPendienteAsignarKg);
                            var cargasAnterioresGrupo = grupoMaterial.SelectMany(x => x.Cargas).Where(x => !x.EstaEnProceso).GroupBy(x => x.SecadoCargaID).Select(x => x.First()).OrderByDescending(x => x.FechaFinReal ?? x.FechaInicioReal ?? DateTime.MinValue).ToList();
                            var tolvasCompatibles = procesoCompatible ? tolvas.Where(x => x.DisponibleParaUsar && (string.Equals(x.TipoProcesoPermitido,"AMBOS",StringComparison.OrdinalIgnoreCase) || string.Equals(x.TipoProcesoPermitido,tipoProcesoGrupo,StringComparison.OrdinalIgnoreCase))).OrderByDescending(x => x.CapacidadKg + ProduccionSecadoReglas.ToleranciaCantidad >= cantidadGrupo).ThenBy(x => x.CapacidadKg).ThenBy(x => x.MaquinaCodigo).ThenBy(x => x.Codigo).ToList() : new List<ProduccionSecadoTolvaVm>();
                            ProduccionSecadoTolvaVm? tolvaPredeterminada = null;
                            var sugeridas = grupoMaterial.Where(x => x.TolvaSugeridaID.HasValue).Select(x => x.TolvaSugeridaID!.Value).Distinct().ToList();
                            if (sugeridas.Any()) tolvaPredeterminada = tolvasCompatibles.FirstOrDefault(x => sugeridas.Contains(x.TolvaID) && x.CapacidadKg + ProduccionSecadoReglas.ToleranciaCantidad >= cantidadGrupo);
                            tolvaPredeterminada ??= tolvasCompatibles.FirstOrDefault(x => x.CapacidadKg + ProduccionSecadoReglas.ToleranciaCantidad >= cantidadGrupo) ?? tolvasCompatibles.FirstOrDefault();
                            <article class="pending-card @(esPareja ? "pair-card" : "") @(grupoMaterial.Any(x => x.DebeAlertarEspera) ? "is-alert" : grupoMaterial.Any(x => x.EstaParcial) ? "is-partial" : "")">
                                <div class="pending-head">
                                    <div class="pending-title"><div class="pending-icon"><i class="bi @(esPareja ? "bi-intersect" : "bi-box2")"></i></div><div><div class="chips">
                                        @if (esPareja) { <span class="pair-badge"><i class="bi bi-link-45deg"></i>Pareja LH/RH · Grupo @grupoLhRh</span> }
                                        else if (!string.IsNullOrWhiteSpace(principal.NumeroOF)) { <span class="chip">OF @principal.NumeroOF</span> }
                                        @if (!esPareja && !string.IsNullOrWhiteSpace(principal.TipoMPTexto)) { <span class="chip">@principal.TipoMPTexto</span> }
                                    </div><h3>@(esPareja ? $"Secado conjunto · {grupoMaterial.Count} material(es)" : principal.TextoMaterial)</h3><small>@(esPareja ? "Las cantidades se controlan por OF, pero el cronómetro y la tolva son únicos." : $"Recibido {principal.FechaRecepcionProduccion:dd/MM/yyyy HH:mm}")</small></div></div>
                                    <span class="status-pill @(grupoMaterial.Any(x => x.DebeAlertarEspera) ? "danger" : grupoMaterial.Any(x => x.EstaParcial) ? "warning" : "pending")">@(esPareja ? (parejaCompleta ? "Pareja lista" : "Esperando pareja") : principal.EstadoTexto)</span>
                                </div>
                                @if (esPareja)
                                {
                                    <div class="pair-banner"><span><i class="bi bi-info-circle me-1"></i><strong>Una sola carga física.</strong> MP y embalaje siguen separados; aquí solo se comparte tolva y tiempo de secado.</span><span>@Cantidad(cantidadGrupo)</span></div>
                                    <div class="pair-components">
                                        @foreach (var componente in grupoMaterial)
                                        {
                                            var lado = string.IsNullOrWhiteSpace(componente.LadoLhRh) ? "—" : componente.LadoLhRh!.ToUpperInvariant();
                                            var claseLado = lado == "LH" ? "lh" : lado == "RH" ? "rh" : "na";
                                            <div class="pair-component"><span class="side-badge @claseLado">@lado</span><div class="pair-component-main"><strong>OF @(string.IsNullOrWhiteSpace(componente.NumeroOF) ? "—" : componente.NumeroOF) · @componente.TextoMaterial</strong><span>@componente.TipoMPTexto @(string.IsNullOrWhiteSpace(componente.Lote) ? "" : $"· Lote {componente.Lote}")</span></div><div class="pair-component-kg"><strong>@Cantidad(componente.CantidadPendienteAsignarKg)</strong><span>por asignar</span></div></div>
                                        }
                                    </div>
                                }
                                <div class="process-row">
                                    <div class="process-box primary"><span>Proceso requerido</span><strong>@(procesoCompatible ? principal.TipoProcesoTexto : "Parámetros incompatibles")</strong></div>
                                    <div class="process-box"><span>@(esPareja ? "Tiempo conjunto" : "Tiempo requerido")</span><strong>@Duracion(duracionGrupo)</strong></div>
                                </div>
                                @if (!esPareja)
                                {
                                    <div class="quantity-grid"><div class="quantity-box"><span>Recibido</span><strong>@Cantidad(principal.CantidadRecibidaKg)</strong></div><div class="quantity-box"><span>Asignado</span><strong>@Cantidad(principal.CantidadAsignadaKg)</strong></div><div class="quantity-box"><span>Finalizado</span><strong>@Cantidad(principal.CantidadFinalizadaKg)</strong></div><div class="quantity-box remaining"><span>Por asignar</span><strong>@Cantidad(principal.CantidadPendienteAsignarKg)</strong></div></div>
                                }
                                <div class="schedule-grid"><div class="schedule-box"><span>Inicio objetivo</span><strong>@Fecha(grupoMaterial.Select(x => x.FechaInicioSecadoObjetivo).Where(x => x.HasValue).OrderBy(x => x).FirstOrDefault())</strong></div><div class="schedule-box"><span>Fin objetivo / arranque</span><strong>@Fecha(grupoMaterial.Select(x => x.FechaObjetivoFinSecado ?? x.FechaArranqueProduccion).Where(x => x.HasValue).OrderBy(x => x).FirstOrDefault())</strong></div></div>
                                @if (cargasAnterioresGrupo.Any())
                                {
                                    <details class="history-details"><summary><i class="bi bi-clock-history"></i>Cargas anteriores (@cargasAnterioresGrupo.Count)</summary><div class="segment-list">@foreach (var anterior in cargasAnterioresGrupo) { <div class="segment-row"><strong>#@anterior.NumeroCarga</strong><div><strong>@anterior.TextoTolva</strong><span>@Cantidad(anterior.CantidadKg)</span></div><div><span>@Fecha(anterior.FechaInicioReal)</span><span>a @Fecha(anterior.FechaFinReal)</span></div><span class="status-pill @(anterior.EstaFinalizada ? "success" : anterior.EstaCancelada ? "danger" : "primary")">@anterior.EstadoTexto</span></div> }</div></details>
                                }
                                @if (grupoMaterial.Any(x => x.DebeAlertarEspera)) { <div class="load-alert danger"><i class="bi bi-exclamation-octagon-fill me-1"></i>Hay material de esta carga que ya superó el tiempo de espera para iniciar secado.</div> }
                                @if (esPareja && !parejaCompleta) { <div class="no-tolva"><i class="bi bi-hourglass-split me-1"></i>La pareja todavía no está completa. El secado conjunto se habilitará cuando Producción tenga MP confirmada de las dos OF.</div> }
                                else if (!procesoCompatible) { <div class="no-tolva"><i class="bi bi-exclamation-triangle me-1"></i>Las OF de la pareja tienen tipos de secado diferentes. Corrige Planeación/datos técnicos antes de iniciar.</div> }
                                else if (Model.PuedeGestionarSecado && tolvasCompatibles.Any())
                                {
                                    <div class="start-panel">
                                        <form asp-controller="ProduccionPreparacion" asp-action="IniciarSecado" method="post" class="action-form js-start-form js-post-form" data-confirm="@(esPareja ? "¿Confirmas iniciar el secado conjunto LH/RH? Se creará una sola carga física para ambas OF." : "¿Confirmas el inicio de esta carga de secado?")">
                                            @Html.AntiForgeryToken()
                                            <input type="hidden" name="SecadoMaterialID" value="@principal.SecadoMaterialID" />
                                            <input type="hidden" name="CantidadKg" class="js-total-kg" value="@cantidadGrupo.ToString("0.####",CultureInfo.InvariantCulture)" />
                                            <div class="field"><label>Tolva</label><select name="TolvaID" class="js-tolva-select" required><option value="">Selecciona una tolva...</option>@foreach (var t in tolvasCompatibles) { if (tolvaPredeterminada != null && t.TolvaID == tolvaPredeterminada.TolvaID) { <option value="@t.TolvaID" data-capacity="@t.CapacidadKg.ToString("0.####",CultureInfo.InvariantCulture)" selected>@t.Texto</option> } else { <option value="@t.TolvaID" data-capacity="@t.CapacidadKg.ToString("0.####",CultureInfo.InvariantCulture)">@t.Texto</option> } }</select><span class="field-help js-capacity-hint"></span></div>
                                            <div class="pair-qty-grid">
                                                @for (var i = 0; i < grupoMaterial.Count; i++)
                                                {
                                                    var componente = grupoMaterial[i];
                                                    var lado = string.IsNullOrWhiteSpace(componente.LadoLhRh) ? (esPareja ? "OF" : "MP") : componente.LadoLhRh!.ToUpperInvariant();
                                                    var claseLado = lado == "LH" ? "lh" : lado == "RH" ? "rh" : "na";
                                                    <div class="pair-qty-item"><div class="pair-qty-head"><span class="side-badge @claseLado">@lado</span><strong>OF @(string.IsNullOrWhiteSpace(componente.NumeroOF) ? "—" : componente.NumeroOF)</strong></div><input type="hidden" name="Componentes[@i].SecadoMaterialID" value="@componente.SecadoMaterialID" /><div class="field"><label>Cantidad a cargar</label><input type="number" name="Componentes[@i].CantidadKg" class="js-component-quantity" data-pending="@componente.CantidadPendienteAsignarKg.ToString("0.####",CultureInfo.InvariantCulture)" min="0.0001" step="0.0001" value="@componente.CantidadPendienteAsignarKg.ToString("0.####",CultureInfo.InvariantCulture)" required /><span class="field-help">Disponible: @Cantidad(componente.CantidadPendienteAsignarKg)</span></div></div>
                                                }
                                            </div>
                                            <div class="pair-summary js-total-summary">Total de la carga: @Cantidad(cantidadGrupo)</div>
                                            <div class="field"><label>Observaciones</label><textarea name="Observaciones" maxlength="1000" placeholder="Condición del material, temperatura inicial, lote, observaciones del arranque, etc."></textarea></div>
                                            <div class="actions"><button type="submit" class="btnx btnx-primary"><i class="bi bi-play-circle"></i>@(esPareja ? "Iniciar secado conjunto" : "Iniciar carga")</button>@foreach (var ejecucion in grupoMaterial.Where(x => x.EjecucionProduccionID.HasValue).Select(x => x.EjecucionProduccionID!.Value).Distinct()) { <a class="btnx btnx-outline" asp-controller="Produccion" asp-action="Detalle" asp-route-id="@ejecucion"><i class="bi bi-box-arrow-up-right"></i>Ver producción</a> }</div>
                                        </form>
                                    </div>
                                }
                                else if (Model.PuedeGestionarSecado) { <div class="no-tolva"><i class="bi bi-exclamation-triangle me-1"></i>No hay una tolva disponible compatible con el proceso.</div> }
                                else { <div class="actions">@foreach (var ejecucion in grupoMaterial.Where(x => x.EjecucionProduccionID.HasValue).Select(x => x.EjecucionProduccionID!.Value).Distinct()) { <a class="btnx btnx-outline" asp-controller="Produccion" asp-action="Detalle" asp-route-id="@ejecucion"><i class="bi bi-box-arrow-up-right"></i>Ver producción</a> }</div> }
                            </article>
                        }
                    </div>
                </details>
            }
        }
        else
        {
            <div class="empty"><i class="bi bi-check2-circle"></i><strong>No hay material pendiente por iniciar</strong><span>No se encontraron cantidades disponibles esperando una nueva carga de secado.</span></div>
        }
    </section>

    <section class="section">
        <div class="section-head"><div><h2>Cargas en proceso</h2><p>Una carga LH/RH aparece una sola vez: comparte tolva y cronómetro, pero conserva el detalle de KG por OF.</p></div><span class="section-count">@cargasActivas.Count</span></div>
        @if (cargasActivas.Any())
        {
            <div class="running-grid">
                @foreach (var item in cargasActivas)
                {
                    var material = item.Material;
                    var carga = item.Carga;
                    var componentesCarga = carga.Materiales?.Where(x => x.Activo).OrderByDescending(x => x.EsPrincipal).ThenBy(x => x.LadoLhRh).ThenBy(x => x.NumeroOF).ToList() ?? new List<ProduccionSecadoCargaMaterialVm>();
                    var esCargaLhRh = carga.GrupoLhRh.HasValue || componentesCarga.Where(x => x.ProgramaProduccionID.HasValue).Select(x => x.ProgramaProduccionID!.Value).Distinct().Count() > 1;
                    var totalMinutos = Math.Max(1,carga.DuracionRequeridaMinutos);
                    var transcurridos = Math.Max(0,carga.MinutosTranscurridos);
                    var porcentaje = Math.Min(100,Math.Max(0,(int)Math.Round((decimal)transcurridos*100m/totalMinutos,0)));
                    var tolvasCambio = tolvas.Where(x => x.DisponibleParaUsar && x.TolvaID != carga.TolvaIDActual && x.CapacidadKg + ProduccionSecadoReglas.ToleranciaCantidad >= carga.CantidadKg && (string.Equals(x.TipoProcesoPermitido,"AMBOS",StringComparison.OrdinalIgnoreCase) || string.Equals(x.TipoProcesoPermitido,material.TipoProceso,StringComparison.OrdinalIgnoreCase))).OrderBy(x => x.MaquinaCodigo).ThenBy(x => x.Codigo).ToList();
                    <article class="load-card js-load-card @(esCargaLhRh ? "pair-card" : "") @(carga.EstaRetrasada ? "is-danger" : carga.TiempoRequeridoCumplido ? "is-ready" : "")" data-load-id="@carga.SecadoCargaID" data-start="@(carga.FechaInicioReal?.ToString("O") ?? "")" data-end="@(carga.FechaFinEsperada?.ToString("O") ?? "")" data-duration-minutes="@carga.DuracionRequeridaMinutos">
                        <div class="load-head"><div class="load-machine"><div class="load-machine-icon"><i class="bi bi-droplet-half"></i></div><div><strong>@carga.TextoTolva</strong><small>@material.TextoMaquina · Carga #@carga.NumeroCarga @if (esCargaLhRh) { <text>· Pareja LH/RH grupo @carga.GrupoLhRh</text> } else { <text>· OF @(string.IsNullOrWhiteSpace(material.NumeroOF) ? "—" : material.NumeroOF)</text> }</small></div></div><span class="status-pill @EstadoCargaClase(carga) js-load-status">@carga.EstadoTexto</span></div>
                        <div class="load-body">
                            @if (esCargaLhRh && componentesCarga.Any())
                            {
                                <div class="pair-banner"><span><i class="bi bi-link-45deg me-1"></i><strong>Secado conjunto LH/RH.</strong> Una tolva, un cronómetro y trazabilidad independiente por OF.</span><span>@Cantidad(carga.CantidadKg)</span></div>
                                <div class="load-components">
                                    @foreach (var componente in componentesCarga)
                                    {
                                        var lado = string.IsNullOrWhiteSpace(componente.LadoLhRh) ? "—" : componente.LadoLhRh!.ToUpperInvariant();
                                        var claseLado = lado == "LH" ? "lh" : lado == "RH" ? "rh" : "na";
                                        <div class="load-component"><span class="side-badge @claseLado">@lado</span><div><strong>OF @(string.IsNullOrWhiteSpace(componente.NumeroOF) ? "—" : componente.NumeroOF) · @(string.IsNullOrWhiteSpace(componente.MaterialCodigo) ? "Material" : componente.MaterialCodigo)</strong><small>@componente.MaterialDescripcion</small></div><span class="kg">@Cantidad(componente.CantidadKg)</span></div>
                                    }
                                </div>
                            }
                            else
                            {
                                <div class="material-box"><div class="material-icon"><i class="bi bi-box2"></i></div><div><span>Material</span><strong>@material.TextoMaterial</strong><small>@material.TipoProcesoTexto · @Cantidad(carga.CantidadKg) @if (!string.IsNullOrWhiteSpace(material.TipoMPTexto)) { <text>· @material.TipoMPTexto</text> } @if (!string.IsNullOrWhiteSpace(material.Lote)) { <text>· Lote @material.Lote</text> }</small></div></div>
                            }
                            <div class="info-grid">
                                <div class="info"><span>Inicio real</span><strong>@Fecha(carga.FechaInicioReal)</strong></div>
                                <div class="info"><span>Fin esperado</span><strong class="js-end-label">@Fecha(carga.FechaFinEsperada)</strong></div>
                                <div class="info nsq-secado-parametros-v1" data-programa-id="@(material.ProgramaProduccionID?.ToString() ?? "")" data-ejecucion-id="@(material.EjecucionProduccionID?.ToString() ?? "")"><span>Parámetros min / objetivo / máx</span><strong class="js-secado-rango-v1">Consultando...</strong><small class="js-secado-alerta-v1"></small></div>
                                <div class="info"><span>@(esCargaLhRh ? "Tiempo conjunto" : "Tiempo requerido")</span><strong>@Duracion(carga.DuracionRequeridaMinutos)</strong></div>
                                <div class="info"><span>Espera previa</span><strong>@(carga.MinutosEsperaAntesInicio.HasValue ? $"{carga.MinutosEsperaAntesInicio.Value} min" : "0 min")</strong></div>
                            </div>
                            <div class="timer-box"><div><div class="timer-label">Tiempo restante</div><div class="timer-value js-countdown">Calculando...</div><div class="timer-sub js-countdown-sub">Fin esperado @Fecha(carga.FechaFinEsperada)</div></div><div class="timer-target"><strong>@Cantidad(carga.CantidadKg)</strong><span>@(esCargaLhRh ? "total conjunto en tolva" : "cantidad en esta carga")</span></div></div>
                            <div class="progressx"><div class="js-progress" style="width:@porcentaje%"></div></div>
                            <div class="js-state-alert">@if (carga.EstaRetrasada) { <div class="load-alert danger"><i class="bi bi-exclamation-octagon-fill me-1"></i>La carga lleva <strong>@carga.MinutosRetrasoActual minuto(s)</strong> después del fin esperado y ya superó la tolerancia.</div> } else if (carga.TiempoRequeridoCumplido) { <div class="load-alert success"><i class="bi bi-check-circle-fill me-1"></i>El tiempo requerido ya se cumplió. La carga puede finalizarse.</div> } else if (carga.EstaProximaAFinalizar) { <div class="load-alert warning"><i class="bi bi-clock-fill me-1"></i>La carga está próxima a terminar. Faltan aproximadamente <strong>@carga.MinutosRestantes minuto(s)</strong>.</div> }</div>
                            @if (carga.Segmentos.Any())
                            {
                                <details class="segment-details"><summary><i class="bi bi-diagram-3"></i>Recorrido de tolvas (@carga.Segmentos.Count segmento@(carga.Segmentos.Count == 1 ? "" : "s"))</summary><div class="segment-list">@foreach (var segmento in carga.Segmentos.OrderBy(x => x.NumeroSegmento)) { <div class="segment-row"><strong>#@segmento.NumeroSegmento</strong><div><strong>@segmento.TextoTolva</strong>@if (segmento.EsCambioTolva) { <span>Cambio de tolva</span> }</div><div><span>@segmento.FechaInicio.ToString("dd/MM HH:mm") - @(segmento.FechaFin.HasValue ? segmento.FechaFin.Value.ToString("dd/MM HH:mm") : "Actual")</span>@if (segmento.MinutosSegmento.HasValue) { <span>@segmento.MinutosSegmento.Value min</span> }</div><div><span class="status-pill @(segmento.EstaAbierto ? "primary" : "success")">@(segmento.EstaAbierto ? "Actual" : "Cerrado")</span></div>@if (!string.IsNullOrWhiteSpace(segmento.MotivoCambio)) { <div style="grid-column:1/-1;color:var(--dry-muted)"><i class="bi bi-chat-left-text me-1"></i>@segmento.MotivoCambio</div> }</div> }</div></details>
                            }
                            <div class="actions">
                                @if (Model.PuedeGestionarSecado) { <button type="button" class="btnx btnx-outline js-toggle-panel" data-target="cambiarTolva-@carga.SecadoCargaID"><i class="bi bi-arrow-left-right"></i>Cambiar tolva</button><button type="button" class="btnx @(carga.TiempoRequeridoCumplido ? "btnx-success" : "btnx-danger") js-toggle-panel js-open-finish" data-target="finalizar-@carga.SecadoCargaID">@if (carga.TiempoRequeridoCumplido) { <i class="bi bi-check-circle"></i><span>Finalizar carga</span> } else { <i class="bi bi-stop-circle"></i><span>Interrumpir secado</span> }</button> }
                                <div class="pair-links">@if (componentesCarga.Any()) { foreach (var ejecucion in componentesCarga.Where(x => x.EjecucionProduccionID.HasValue).Select(x => x.EjecucionProduccionID!.Value).Distinct()) { <a class="btnx btnx-outline" asp-controller="Produccion" asp-action="Detalle" asp-route-id="@ejecucion"><i class="bi bi-box-arrow-up-right"></i>Ver OF</a> } } else if (material.EjecucionProduccionID.HasValue) { <a class="btnx btnx-outline" asp-controller="Produccion" asp-action="Detalle" asp-route-id="@material.EjecucionProduccionID.Value"><i class="bi bi-box-arrow-up-right"></i>Ver producción</a> }</div>
                            </div>
                            @if (Model.PuedeGestionarSecado)
                            {
                                <div class="action-panel" id="cambiarTolva-@carga.SecadoCargaID"><div class="panel-title"><i class="bi bi-arrow-left-right"></i>Cambiar tolva sin reiniciar cronómetro</div>@if (tolvasCambio.Any()) { <form asp-controller="ProduccionPreparacion" asp-action="CambiarTolvaSecado" method="post" class="action-form js-post-form" data-confirm="¿Confirmas el cambio de tolva? El tiempo de secado continuará corriendo.">@Html.AntiForgeryToken()<input type="hidden" name="SecadoCargaID" value="@carga.SecadoCargaID" /><div class="field"><label>Nueva tolva</label><select name="TolvaNuevaID" required><option value="">Selecciona una tolva...</option>@foreach (var t in tolvasCambio) { <option value="@t.TolvaID">@t.Texto</option> }</select><span class="field-help">Solo se muestran tolvas disponibles, compatibles y con capacidad para toda la carga.</span></div><div class="field"><label>Motivo del cambio</label><textarea name="MotivoCambio" maxlength="500" required placeholder="Ej. mantenimiento, falla de tolva, ajuste operativo..."></textarea></div><div class="actions"><button class="btnx btnx-primary" type="submit"><i class="bi bi-arrow-left-right"></i>Confirmar cambio</button></div></form> } else { <div class="no-tolva"><i class="bi bi-exclamation-triangle me-1"></i>No existe otra tolva disponible con capacidad y proceso compatibles para esta carga.</div> }</div>
                                <div class="action-panel" id="finalizar-@carga.SecadoCargaID"><div class="panel-title js-finish-panel-title">@if (carga.TiempoRequeridoCumplido) { <i class="bi bi-check-circle"></i><span>Finalizar carga de secado</span> } else { <i class="bi bi-exclamation-triangle"></i><span>Interrumpir secado antes de tiempo</span> }</div><form asp-controller="ProduccionPreparacion" asp-action="FinalizarSecado" method="post" class="action-form js-post-form js-finish-form" data-confirm="@(carga.TiempoRequeridoCumplido ? "¿Confirmas que la carga terminó físicamente su proceso de secado?" : "¿Confirmas interrumpir el secado antes del tiempo objetivo? Esta acción cerrará la carga para todas las OF relacionadas.")">@Html.AntiForgeryToken()<input type="hidden" name="SecadoCargaID" value="@carga.SecadoCargaID" /><input type="hidden" name="ConfirmarFinalizacionAnticipada" class="js-early-confirm" value="@(carga.TiempoRequeridoCumplido ? "false" : "true")" /><div class="js-early-fields @(carga.TiempoRequeridoCumplido ? "d-none" : "")"><div class="load-alert warning mb-3"><i class="bi bi-exclamation-triangle-fill me-1"></i><strong>Interrupción anticipada.</strong> Todavía faltan aproximadamente <strong>@carga.MinutosRestantes minuto(s)</strong>. La decisión se registrará para todos los materiales de la carga.</div><div class="field"><label>Motivo de la interrupción *</label><textarea name="MotivoFinalizacionAnticipada" class="js-early-reason" maxlength="500" @(carga.TiempoRequeridoCumplido ? null : "required") placeholder="Motivo operativo de la interrupción..."></textarea></div></div><div class="field"><label>Observaciones</label><textarea name="Observaciones" maxlength="1000" placeholder="Condición del material, temperatura, observaciones del proceso, etc."></textarea></div><div class="actions"><button class="btnx @(carga.TiempoRequeridoCumplido ? "btnx-success" : "btnx-danger") js-finish-submit" type="submit">@if (carga.TiempoRequeridoCumplido) { <i class="bi bi-check2-circle"></i><span>Confirmar finalización</span> } else { <i class="bi bi-stop-circle"></i><span>Confirmar interrupción anticipada</span> }</button></div></form></div>
                            }
                        </div>
                    </article>
                }
            </div>
        }
        else
        {
            <div class="empty"><i class="bi bi-droplet-half"></i><strong>No hay cargas de secado activas</strong><span>Cuando se inicie una carga, aparecerá aquí con su tolva, cantidad y contador en tiempo real.</span></div>
        }
    </section>

    <section class="section">
        <details class="tolva-details" open>
