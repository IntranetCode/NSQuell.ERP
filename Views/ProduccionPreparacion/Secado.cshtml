                else
                {
                    <div class="empty">
                        <i class="bi bi-boxes"></i>
                        <strong>No hay tolvas configuradas</strong>
                        <span>No se encontraron tolvas activas para el proceso de secado.</span>
                    </div>
                }
            </div>
        </details>
    </section>

    <section class="section waiting-section">
        <div class="section-head">
            <div>
                <h2><i class="bi bi-truck me-1"></i> Próximos materiales · esperando recepción</h2>
                <p>
                    Materia prima requerida para secado que Planeación ya tiene programada, pero Producción todavía no ha confirmado físicamente.
                </p>
            </div>
            <div class="section-kpi">
                <span class="kg-pill" style="background:var(--dry-blue-soft);color:var(--dry-blue)">@Cantidad(totalKgEsperadosRecepcion) por recibir</span>
                <span class="section-count" style="background:var(--dry-blue-soft);color:var(--dry-blue)">@pendientesPlaneacion.Count</span>
            </div>
        </div>

        @if (pendientesPlaneacion.Any())
        {
            foreach (var grupo in pendientesPlaneacion
            .GroupBy(x => new { x.MaquinaID, x.MaquinaCodigo, x.MaquinaNombre })
            .OrderBy(x => x.Key.MaquinaCodigo)
            .ThenBy(x => x.Key.MaquinaNombre))
            {
                var maquinaTexto = string.IsNullOrWhiteSpace(grupo.Key.MaquinaCodigo)
                ? "Sin máquina"
                : string.IsNullOrWhiteSpace(grupo.Key.MaquinaNombre)
                ? grupo.Key.MaquinaCodigo
                : $"{grupo.Key.MaquinaCodigo} - {grupo.Key.MaquinaNombre}";
                var kgEsperadosMaquina = grupo.Sum(x => x.CantidadMpPendienteRecepcionKg);
                <details class="waiting-machine" open>
                    <summary>
                        <div class="waiting-machine-title">
                            <i class="bi bi-building-gear"></i>
                            <div>
                                <strong>@maquinaTexto</strong>
                                <small>@grupo.Count() OF@(grupo.Count() == 1 ? "" : "s") esperando materia prima</small>
                            </div>
                        </div>
                        <div class="waiting-machine-kpi">
                            <span class="status-pill primary">@Cantidad(kgEsperadosMaquina) esperados</span>
                            <span class="section-count" style="background:var(--dry-blue-soft);color:var(--dry-blue)">@grupo.Count()</span>
                        </div>
                    </summary>
                    <div class="planned-grid" style="padding:10px;background:var(--dry-bg)">
                        @foreach (var tarea in grupo.OrderBy(x => x.FechaAviso).ThenBy(x => x.FechaObjetivo))
                        {
                            var clasePlaneacion = EstadoPlaneacionClase(tarea);
                            var cantidadMpEsperada = tarea.CantidadMpKg ?? 0m;
                            var cantidadMpRecibida = tarea.CantidadMpRecibidaProduccionKg;
                            var cantidadMpFaltante = tarea.CantidadMpPendienteRecepcionKg;
                            <article class="planned-card @(clasePlaneacion == "danger" ? "is-danger" : clasePlaneacion == "warning" ? "is-warning" : "")">
                                <div class="planned-head">
                                    <div class="planned-title">
                                        <div class="planned-icon"><i class="bi bi-truck"></i></div>
                                        <div>
                                            <div class="chips">
                                                <span class="chip">OF @(string.IsNullOrWhiteSpace(tarea.NumeroOF) ? "—" : tarea.NumeroOF)</span>
                                                <span class="chip">@tarea.TextoParte</span>
                                                @if (tarea.GrupoLhRh.HasValue)
                                                {
                                                    <span class="pair-badge"><i class="bi bi-link-45deg"></i>Pareja @tarea.GrupoLhRh @(string.IsNullOrWhiteSpace(tarea.LadoLhRh) ? "" : $"· {tarea.LadoLhRh}")</span>
                                                }
                                            </div>
                                            <h3>@tarea.TextoMaterial</h3>
                                            @if (!string.IsNullOrWhiteSpace(tarea.DescripcionParte))
                                            {
                                                <small>@tarea.DescripcionParte</small>
                                            }
                                        </div>
                                    </div>
                                    <span class="status-pill @clasePlaneacion">@EstadoPlaneacionTexto(tarea)</span>
                                </div>

                                <div class="waiting-kg">
                                    <div>
                                        <span>Materia prima que falta recibir</span>
                                        <div class="field-help">Lo que todavía esperamos físicamente de Almacén para esta OF</div>
                                    </div>
                                    <strong>@(cantidadMpEsperada > 0 ? Cantidad(cantidadMpFaltante) : "Por definir")</strong>
                                </div>

                                @if (cantidadMpEsperada > 0)
                                {
                                    <div class="quantity-grid" style="grid-template-columns:repeat(3,minmax(0,1fr))">
                                        <div class="quantity-box">
                                            <span>Requerido por OF</span>
                                            <strong>@Cantidad(cantidadMpEsperada)</strong>
                                        </div>
                                        <div class="quantity-box">
                                            <span>Ya confirmado</span>
                                            <strong>@Cantidad(cantidadMpRecibida)</strong>
                                        </div>
                                        <div class="quantity-box remaining">
                                            <span>Falta recibir</span>
                                            <strong>@Cantidad(cantidadMpFaltante)</strong>
                                        </div>
                                    </div>
                                }

                                <div class="process-row">
                                    <div class="process-box primary">
                                        <span>Proceso requerido</span>
                                        <strong>@(string.IsNullOrWhiteSpace(tarea.TipoSecado) ? "Secado" : tarea.TipoSecado)</strong>
                                    </div>
                                    <div class="process-box">
                                        <span>Tiempo de secado</span>
                                        <strong>@Horas(tarea.HorasSecado)</strong>
                                    </div>
                                </div>

                                <div class="schedule-grid">
                                    <div class="schedule-box">
                                        <span>Debe iniciar secado</span>
                                        <strong>@Fecha(tarea.FechaAviso)</strong>
                                    </div>
                                    <div class="schedule-box">
                                        <span>Arranque producción</span>
                                        <strong>@Fecha(tarea.FechaArranque ?? tarea.FechaObjetivo)</strong>
                                    </div>
                                </div>

                                <div class="waiting-foot">
                                    <span><i class="bi bi-box-arrow-in-down me-1"></i>Pendiente de confirmación física en Producción</span>
                                    <span>@tarea.CantidadProgramada.ToString("N0") PZA programadas</span>
                                </div>
                            </article>
                        }
                    </div>
                </details>
            }
        }
        else
        {
            <div class="empty">
                <i class="bi bi-truck"></i>
                <strong>No hay materia prima pendiente de recepción para secado</strong>
                <span>Los programas visibles ya tienen material físico confirmado o no requieren secado.</span>
            </div>
        }
    </section>

    <section class="section">
        <details class="material-group">
            <summary>
                <div class="group-title">
                    <div class="group-icon"
                         style="background:var(--dry-green-soft);color:var(--dry-green)">
                        <i class="bi bi-check2-circle"></i>
                    </div>

                    <div>
                        <strong>Material finalizado recientemente</strong>
                        <small>
                            @finalizados.Count material@(finalizados.Count == 1 ? "" : "es")
