                        </small>
                    </div>
                </div>

                <span class="group-count">@finalizados.Count</span>
            </summary>

            @if (finalizados.Any())
            {
                <div style="padding:10px;background:var(--dry-bg)">
                    <div class="ready-list">
                        @foreach (var material in finalizados)
                        {
                            <div class="ready-row">
                                <div>
                                    <strong>@material.TextoMaquina</strong>
                                    <span>OF @(string.IsNullOrWhiteSpace(material.NumeroOF) ? "—" : material.NumeroOF) @if (material.GrupoLhRh.HasValue) { <text>· Pareja @material.GrupoLhRh @(string.IsNullOrWhiteSpace(material.LadoLhRh) ? "" : $"· {material.LadoLhRh}")</text> }</span>
                        </div>

                                <div>
                                    <strong>@material.TextoMaterial</strong>
                                    <span>
                                        @material.TipoProcesoTexto
                                        · @Cantidad(material.CantidadFinalizadaKg)
                                    </span>
                                </div>

                                <div>
                                    <strong>
                                        @Duracion(material.MinutosSecadoRequeridos)
                                    </strong>
                                    <span>Tiempo requerido</span>
                                </div>

                                <div>
                                    <strong>
                                        @Fecha(material.FechaUltimoFinSecado)
                                    </strong>
                                    <span>Última finalización</span>
                                </div>

                                <div>
                                    <span class="ok-text">
                                        <i class="bi bi-check-circle me-1"></i>
                                        Finalizado
                                    </span>
                                </div>
                            </div>
                                        }
                    </div>
                </div>
            }
            else
            {
                <div class="empty"
                     style="border:0;border-radius:0">
                    <i class="bi bi-clock-history"></i>
                    <strong>No hay material finalizado recientemente</strong>
                </div>
            }
        </details>
    </section>
</div>

<script>
    (function () {
        const page = document.getElementById('secadoPage');
        if (!page) return;

        let serverOffset = 0;

        const parsedServerNow = Date.parse(page.dataset.serverNow || '');

        if (Number.isFinite(parsedServerNow)) {
            serverOffset = parsedServerNow - Date.now();
        }

        const estadoUrl = page.dataset.estadoUrl || '';
        const toleranciaFinMinutos =
            Number.parseInt(page.dataset.toleranciaFin || '0', 10) || 0;

        function nowServer() {
            return Date.now() + serverOffset;
        }

        function formatDuration(milliseconds) {
            const totalSeconds = Math.max(
                0,
                Math.floor(milliseconds / 1000));

            const hours = Math.floor(totalSeconds / 3600);
            const minutes = Math.floor((totalSeconds % 3600) / 60);
            const seconds = totalSeconds % 60;

            return String(hours).padStart(2, '0') + ':' +
                   String(minutes).padStart(2, '0') + ':' +
                   String(seconds).padStart(2, '0');
        }

            function updateLoadCard(card) {
        const start=Date.parse(card.dataset.start||'');
        const end=Date.parse(card.dataset.end||'');

        if(!Number.isFinite(start)||!Number.isFinite(end))
            return;

        const now=nowServer();
        const remaining=end-now;
        const elapsed=Math.max(0,now-start);
        const total=Math.max(1,end-start);

        const percent=Math.min(
            100,
            Math.max(
                0,
                Math.round((elapsed*100)/total)));

        const countdown=card.querySelector('.js-countdown');
        const subtitle=card.querySelector('.js-countdown-sub');
        const progress=card.querySelector('.js-progress');
        const status=card.querySelector('.js-load-status');
        const stateAlert=card.querySelector('.js-state-alert');
        const finishOpen=card.querySelector('.js-open-finish');
        const finishSubmit=card.querySelector('.js-finish-submit');
        const finishForm=card.querySelector('.js-finish-form');
        const finishPanelTitle=card.querySelector('.js-finish-panel-title');
        const earlyConfirm=card.querySelector('.js-early-confirm');
        const earlyFields=card.querySelector('.js-early-fields');
        const earlyReason=card.querySelector('.js-early-reason');

        if(progress)
            progress.style.width=percent+'%';

        if(remaining>0)
        {
            const remainingMinutes=Math.ceil(remaining/60000);

            if(countdown)
                countdown.textContent=formatDuration(remaining);

            if(subtitle)
                subtitle.textContent='El proceso continúa. Producción puede interrumpirlo anticipadamente si es necesario.';

            if(finishOpen)
            {
                finishOpen.disabled=false;
                finishOpen.classList.remove('btnx-success');
                finishOpen.classList.add('btnx-danger');
                finishOpen.innerHTML=
                    '<i class="bi bi-stop-circle"></i>'+
                    '<span>Interrumpir secado</span>';
            }

            if(finishSubmit)
            {
                finishSubmit.disabled=false;
                finishSubmit.classList.remove('btnx-success');
                finishSubmit.classList.add('btnx-danger');
                finishSubmit.innerHTML=
                    '<i class="bi bi-stop-circle"></i>'+
                    '<span>Confirmar interrupción anticipada</span>';
            }

            if(finishPanelTitle)
            {
                finishPanelTitle.innerHTML=
                    '<i class="bi bi-exclamation-triangle"></i>'+
                    '<span>Interrumpir secado antes de tiempo</span>';
            }

            if(finishForm)
            {
                finishForm.dataset.confirm=
                    '¿Confirmas interrumpir el secado antes del tiempo objetivo? Esta acción cerrará la carga.';
            }

            if(earlyConfirm)
                earlyConfirm.value='true';

            if(earlyFields)
                earlyFields.classList.remove('d-none');

            if(earlyReason)
                earlyReason.required=true;

            if(status)
            {
                status.classList.remove(
                    'success',
                    'danger',
                    'warning',
                    'primary');

                if(remainingMinutes<=15)
                {
                    status.classList.add('warning');
                    status.textContent='Próxima a terminar';
                }
                else
                {
                    status.classList.add('primary');
                    status.textContent='En secado';
                }
            }

            return;
        }

        const overdueMilliseconds=Math.max(0,now-end);
        const overdueMinutes=Math.floor(overdueMilliseconds/60000);

        if(countdown)
        {
            countdown.textContent=
                overdueMilliseconds<60000
                    ?'TIEMPO CUMPLIDO'
                    :'+'+formatDuration(overdueMilliseconds);
        }

        if(subtitle)
        {
            subtitle.textContent=
                overdueMinutes>0
                    ?'Tiempo adicional después del fin esperado.'
                    :'La carga ya puede finalizarse.';
        }

        if(finishOpen)
        {
            finishOpen.disabled=false;
            finishOpen.classList.remove('btnx-danger');
            finishOpen.classList.add('btnx-success');
            finishOpen.innerHTML=
                '<i class="bi bi-check-circle"></i>'+
                '<span>Finalizar carga</span>';
        }

        if(finishSubmit)
        {
            finishSubmit.disabled=false;
            finishSubmit.classList.remove('btnx-danger');
            finishSubmit.classList.add('btnx-success');
            finishSubmit.innerHTML=
                '<i class="bi bi-check2-circle"></i>'+
                '<span>Confirmar finalización</span>';
        }

        if(finishPanelTitle)
        {
            finishPanelTitle.innerHTML=
                '<i class="bi bi-check-circle"></i>'+
                '<span>Finalizar carga de secado</span>';
        }

        if(finishForm)
        {
            finishForm.dataset.confirm=
                '¿Confirmas que la carga terminó físicamente su proceso de secado?';
        }

        if(earlyConfirm)
            earlyConfirm.value='false';

        if(earlyFields)
            earlyFields.classList.add('d-none');

        if(earlyReason)
        {
            earlyReason.required=false;
            earlyReason.value='';
        }

        card.classList.add('is-ready');

        if(status)
        {
            status.classList.remove(
                'primary',
                'warning',
                'success',
                'danger');

            if(overdueMinutes>toleranciaFinMinutos)
            {
                status.classList.add('danger');
                status.textContent='Retrasada';
                card.classList.add('is-danger');
            }
            else
            {
                status.classList.add('success');
                status.textContent='Tiempo cumplido';
                card.classList.remove('is-danger');
            }
        }

        if(stateAlert)
        {
            if(overdueMinutes>toleranciaFinMinutos)
            {
                stateAlert.innerHTML=
                    '<div class="load-alert danger">'+
                    '<i class="bi bi-exclamation-octagon-fill me-1"></i>'+
                    'La carga lleva <strong>'+
                    overdueMinutes+
                    ' minuto(s)</strong> después de su fin esperado.'+
                    '</div>';
            }
            else
            {
                stateAlert.innerHTML=
                    '<div class="load-alert success">'+
                    '<i class="bi bi-check-circle-fill me-1"></i>'+
                    'El tiempo requerido ya se cumplió. La carga puede finalizarse.'+
                    '</div>';
            }
        }
    }

        function updateAllLoads() {
            document
                .querySelectorAll('.js-load-card')
                .forEach(updateLoadCard);
        }

        document
            .querySelectorAll('.js-toggle-panel')
            .forEach(function (button) {
                button.addEventListener('click', function () {
                    if (button.disabled)
                        return;

                    const targetId =
                        button.dataset.target || '';

                    const panel =
                        document.getElementById(targetId);

                    if (!panel)
                        return;

                    const card =
                        button.closest('.js-load-card');

                    if (card) {
                        card
                            .querySelectorAll('.action-panel.show')
                            .forEach(function (other) {
                                if (other !== panel) {
                                    other.classList.remove('show');
                                }
                            });
                    }

                    panel.classList.toggle('show');

                    if (panel.classList.contains('show')) {
                        const firstField =
                            panel.querySelector(
                                'select, textarea, input:not([type="hidden"])');

                        if (firstField) {
                            window.setTimeout(function () {
                                firstField.focus();
                            }, 50);
                        }
                    }
                });
            });

        function configureStartForm(form) {
            const select = form.querySelector('.js-tolva-select');
            const inputs = Array.from(form.querySelectorAll('.js-component-quantity'));
            const hint = form.querySelector('.js-capacity-hint');
            const totalHidden = form.querySelector('.js-total-kg');
            const totalSummary = form.querySelector('.js-total-summary');
            if (!select || !inputs.length) return;
            function number(value) { const n = Number.parseFloat(value || '0'); return Number.isFinite(n) ? n : 0; }
            function validate() {
                const option = select.options[select.selectedIndex];
                const capacity = option && option.value ? number(option.dataset.capacity) : 0;
                let total = 0;
                inputs.forEach(function (input) {
                    input.setCustomValidity('');
                    const pending = number(input.dataset.pending);
                    const value = number(input.value);
                    if (value <= 0) input.setCustomValidity('La cantidad debe ser mayor a cero.');
                    else if (value > pending + 0.0005) input.setCustomValidity('La cantidad supera lo pendiente para esta OF.');
                    total += Math.max(0,value);
                });
                if (option && option.value && total > capacity + 0.0005 && inputs.length) inputs[inputs.length - 1].setCustomValidity('La suma de las OF supera la capacidad de la tolva seleccionada.');
                if (totalHidden) totalHidden.value = total.toFixed(4).replace(/\.?0+$/,'');
                if (hint) hint.textContent = option && option.value ? 'Total de la carga: ' + total.toFixed(4) + ' KG · Capacidad de tolva: ' + capacity.toFixed(4) + ' KG' : 'Selecciona una tolva para validar la capacidad total.';
                if (totalSummary) totalSummary.textContent = 'Total de la carga: ' + total.toFixed(4) + ' KG' + (option && option.value ? ' · Disponible en tolva: ' + capacity.toFixed(4) + ' KG' : '');
            }
            select.addEventListener('change',validate);
            inputs.forEach(function (input) { input.addEventListener('input',validate); });
            validate();
        }

        document
            .querySelectorAll('.js-start-form')
            .forEach(configureStartForm);

        document
            .querySelectorAll('.js-post-form')
            .forEach(function (form) {
                form.addEventListener('submit', function (event) {
                    if (!form.checkValidity()) {
                        return;
                    }

                    const message =
                        form.dataset.confirm || '';

                    if (message &&
                        !window.confirm(message)) {
                        event.preventDefault();
                        return;
                    }

                    const submitButton =
                        form.querySelector(
                            'button[type="submit"]');

                    if (submitButton) {
                        submitButton.disabled = true;

                        submitButton.innerHTML =
                            '<span class="spinner-border spinner-border-sm" aria-hidden="true"></span>' +
                            ' Procesando...';
                    }
                });
            });

        async function syncLoadState(card) {
            if (!estadoUrl)
                return;

            const loadId =
                card.dataset.loadId || '';

            if (!loadId)
                return;

            try {
                const response = await fetch(
                    estadoUrl +
                    '?id=' +
                    encodeURIComponent(loadId),
                    {
                        method: 'GET',
                        credentials: 'same-origin',
                        headers: {
                            'X-Requested-With': 'XMLHttpRequest'
                        }
                    });

                if (!response.ok)
                    return;

                const data =
                    await response.json();

                if (!data)
                    return;

                const estado =
                    String(data.estado || '')
                        .toUpperCase();

                if (estado &&
                    estado !== 'EN_PROCESO') {

                    window.location.reload();
                    return;
                }

                if (data.ahoraServidor) {
                    const serverNow =
                        Date.parse(data.ahoraServidor);

                    if (Number.isFinite(serverNow)) {
                        serverOffset =
                            serverNow - Date.now();
                    }
                }

                if (data.fechaInicioReal) {
                    card.dataset.start =
                        data.fechaInicioReal;
                }

                if (data.fechaFinEsperada) {
                    card.dataset.end =
                        data.fechaFinEsperada;

                    const label =
                        card.querySelector(
                            '.js-end-label');

                    if (label) {
                        const date =
                            new Date(
                                data.fechaFinEsperada);

                        if (!Number.isNaN(
                            date.getTime())) {

                            label.textContent =
                                date.toLocaleDateString(
                                    'es-MX',
                                    {
                                        day: '2-digit',
                                        month: '2-digit',
                                        year: 'numeric'
                                    }) +
                                ' ' +
                                date.toLocaleTimeString(
                                    'es-MX',
                                    {
                                        hour: '2-digit',
                                        minute: '2-digit',
                                        hour12: false
                                    });
                        }
                    }
                }

                updateLoadCard(card);
            }
            catch {

            }
        }

        async function syncAllLoadStates() {
            const cards =
                Array.from(
                    document.querySelectorAll(
                        '.js-load-card'));

            for (const card of cards) {
                await syncLoadState(card);
            }
        }

        updateAllLoads();

        if (document.querySelector('.js-load-card')) {
            window.setInterval(
                updateAllLoads,
                1000);

            window.setInterval(
                syncAllLoadStates,
                60000);
        }
    })();
</script>

