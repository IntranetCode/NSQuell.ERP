@using ERP.NSQuell.Models
@using System.Globalization
@using System.Linq
@model ProduccionSecadoIndexVm

@{
    Layout = "_Layout";
    ViewData["Title"] = "Secado de material";

    var materiales = Model.Materiales ?? new List<ProduccionSecadoMaterialVm>();
    var tolvas = Model.Tolvas ?? new List<ProduccionSecadoTolvaVm>();
    var pendientesPlaneacion = (Model.PendientesPlaneacion ?? new List<ProduccionPreparacionTareaVm>())
        .OrderBy(x => x.FechaAviso)
        .ThenBy(x => x.FechaObjetivo)
        .ThenBy(x => x.ProgramaProduccionID)
        .ToList();

    var cargasActivas = materiales
        .SelectMany(x => x.Cargas.Select(c => new { Material = x, Carga = c }))
        .Where(x => x.Carga.EstaEnProceso)
        .GroupBy(x => x.Carga.SecadoCargaID)
        .Select(g => g.FirstOrDefault(x => x.Carga.Materiales != null && x.Carga.Materiales.Any(m => m.EsPrincipal && m.SecadoMaterialID == x.Material.SecadoMaterialID)) ?? g.First())
        .OrderBy(x => x.Carga.FechaFinEsperada ?? DateTime.MaxValue)
        .ToList();

    var pendientes = materiales
        .Where(x =>
            !x.EstaFinalizado &&
            !x.EstaCancelado &&
            !x.TieneCargaEnProceso &&
            x.RequiereNuevaCarga)
        .OrderByDescending(x => x.DebeAlertarEspera)
        .ThenBy(x => x.FechaInicioSecadoObjetivo ?? DateTime.MaxValue)
        .ThenBy(x => x.FechaArranqueProduccion ?? DateTime.MaxValue)
        .ToList();

    var finalizados = materiales
        .Where(x => x.EstaFinalizado)
        .OrderByDescending(x => x.FechaUltimoFinSecado ?? DateTime.MinValue)
        .Take(40)
        .ToList();

    var filtroActual = string.IsNullOrWhiteSpace(Model.Filtro)
        ? string.Empty
        : Model.Filtro;

    var totalCargasRetrasadas = materiales.SelectMany(x => x.Cargas).GroupBy(x => x.SecadoCargaID).Count(x => x.First().EstaRetrasada);
    var totalAlertas = Model.TotalAlertasEspera + totalCargasRetrasadas;
    var totalKgPendientesSecado = pendientes.Sum(x => x.CantidadPendienteAsignarKg);
    var totalKgEsperadosRecepcion = pendientesPlaneacion.Sum(x => x.CantidadMpPendienteRecepcionKg);
    var totalGruposPendientes = pendientes.GroupBy(x => x.GrupoLhRh.HasValue ? $"LHRH:{x.GrupoLhRh.Value}" : $"MAT:{x.SecadoMaterialID}").Count();

    string Fecha(DateTime? value) =>
        value?.ToString("dd/MM/yyyy HH:mm") ?? "—";

    string Cantidad(decimal value) =>
        $"{value:0.####} KG";

    string Horas(decimal? value) =>
        value.HasValue && value.Value > 0 ? $"{value.Value:0.##} h" : "—";

    string EstadoPlaneacionClase(ProduccionPreparacionTareaVm tarea)
    {
        if (Model.FechaConsulta > tarea.FechaObjetivo) return "danger";
        if (Model.FechaConsulta >= tarea.FechaAviso) return "warning";
        return "primary";
    }

    string EstadoPlaneacionTexto(ProduccionPreparacionTareaVm tarea)
    {
        if (Model.FechaConsulta > tarea.FechaObjetivo) return "Recepción urgente";
        if (Model.FechaConsulta >= tarea.FechaAviso) return "Debe iniciar secado";
        return "Esperando recepción de MP";
    }

    string Duracion(int minutos)
    {
        if (minutos <= 0)
            return "—";

        var horas = minutos / 60;
        var resto = minutos % 60;

        if (horas <= 0)
            return $"{resto} min";

        if (resto <= 0)
            return $"{horas} h";

        return $"{horas} h {resto} min";
    }

    string EstadoMaterialClase(ProduccionSecadoMaterialVm material)
    {
        if (material.EstaFinalizado)
            return "success";

        if (material.DebeAlertarEspera)
            return "danger";

        if (material.EstaParcial)
            return "warning";

        if (material.TieneCargaEnProceso)
            return "primary";

        return "pending";
    }

    string EstadoCargaClase(ProduccionSecadoCargaVm carga)
    {
        if (carga.EstaRetrasada)
            return "danger";

        if (carga.TiempoRequeridoCumplido)
            return "success";

        if (carga.EstaProximaAFinalizar)
            return "warning";

        return "primary";
    }
}

