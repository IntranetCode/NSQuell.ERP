            --navy2: #172b4d;
            --blue: #173a7a;
            --blue2: #2454a4;
            --blueSoft: #edf4ff;
            --line: #d4deea;
            --line2: #c4d0de;
            --bg: #edf2f7;
            --text: #172033;
            --muted: #66758a;
            --danger: #b42318;
            --danger2: #d92d20;
            --dangerBg: #fff1f0;
            --warn: #936100;
            --warn2: #b77900;
            --warnBg: #fff7df;
