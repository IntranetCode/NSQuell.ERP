@model ERP.NSQuell.Models.ViewModels.Logistica.LogisticaListaCargaIndexVm
@using System.Globalization
@using System.Text.Json
@{
    Layout = null;
    ViewData["Title"] = "Lista de carga semanal";

    var semanaAnteriorFecha = Model.FechaInicio.AddDays(-7);
    var semanaSiguienteFecha = Model.FechaInicio.AddDays(7);

    var anioAnterior = ISOWeek.GetYear(semanaAnteriorFecha);
    var numeroSemanaAnterior = ISOWeek.GetWeekOfYear(semanaAnteriorFecha);

    var anioSiguiente = ISOWeek.GetYear(semanaSiguienteFecha);
    var numeroSemanaSiguiente = ISOWeek.GetWeekOfYear(semanaSiguienteFecha);

    var gruposClientes = Model.Filas
        .GroupBy(x => new { x.ClienteID, x.Cliente })
        .OrderByDescending(x => x.Sum(y => y.Atraso))
        .ThenBy(x => x.Key.Cliente)
        .ToList();

    var programacionImpresion = Model.Filas
        .SelectMany(fila => fila.Programaciones
            .Where(p => p.Activo
                && !string.Equals(p.Estatus, "Cancelada", StringComparison.OrdinalIgnoreCase)
                && p.CantidadProgramada > 0
                && p.FechaProgramadaCarga.Date >= Model.FechaInicio.Date
                && p.FechaProgramadaCarga.Date <= Model.FechaFin.Date)
            .Select(p => new
            {
                Fecha = p.FechaProgramadaCarga.Date,
                fila.Cliente,
                fila.Referencia,
                fila.Designacion,
                Cantidad = p.CantidadProgramada,
                Generado = p.CantidadGeneradaEmbarque,
                Enviado = p.CantidadEnviada,
                Observaciones = p.Observaciones ?? string.Empty
            }))
        .GroupBy(x => new { x.Fecha, x.Cliente, x.Referencia, x.Designacion })
        .Select(g => new
        {
            g.Key.Fecha,
            g.Key.Cliente,
            g.Key.Referencia,
            g.Key.Designacion,
            Cantidad = g.Sum(x => x.Cantidad),
            Generado = g.Sum(x => Math.Min(x.Generado, x.Cantidad)),
            Enviado = g.Sum(x => Math.Min(x.Enviado, x.Cantidad)),
            Observaciones = string.Join(" | ", g.Select(x => x.Observaciones?.Trim())
                .Where(x => !string.IsNullOrWhiteSpace(x))
                .Distinct())
        })
        .OrderBy(x => x.Fecha)
        .ThenBy(x => x.Cliente)
        .ThenBy(x => x.Referencia)
        .ToList();
}
<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width,initial-scale=1" />
    <title>@ViewData["Title"]</title>

