    <section id="programacionPrint" class="print-sheet" aria-hidden="true">
        <div class="print-head">
            <div>
                <h1>Programación semanal de entregas</h1>
                <p>Lista de carga · Programación registrada para la semana seleccionada</p>
            </div>
            <div class="print-week">
                <strong>@Model.SemanaTexto</strong>
                <span>@Model.RangoTexto</span>
            </div>
        </div>
        @if (programacionImpresion.Count == 0)
        {
            <div class="print-empty">No hay programación registrada para esta semana.</div>
        }
        else
        {
            <table class="print-table">
                <thead>
                    <tr>
                        <th class="print-date">Fecha</th>
                        <th class="print-client">Cliente</th>
                        <th class="print-ref">Referencia</th>
                        <th>Designación</th>
                        <th class="print-qty">Cantidad</th>
                        <th class="print-status">Estado</th>
                        <th class="print-obs">Observaciones</th>
                    </tr>
                </thead>
                <tbody>
                    @{
                        DateTime? fechaImpresionAnterior = null;
                    }
                    @foreach (var item in programacionImpresion)
                    {
                        if (!fechaImpresionAnterior.HasValue || fechaImpresionAnterior.Value.Date != item.Fecha.Date)
                        {
                            <tr class="print-day-row">
                                <td colspan="7">@CultureInfo.GetCultureInfo("es-MX").TextInfo.ToTitleCase(item.Fecha.ToString("dddd dd 'de' MMMM 'de' yyyy", CultureInfo.GetCultureInfo("es-MX")))</td>
                            </tr>
                            fechaImpresionAnterior = item.Fecha.Date;
                        }
                        var estadoImpresion = item.Enviado >= item.Cantidad
                        ? "Enviado"
                        : item.Generado >= item.Cantidad
                        ? "Embarque generado"
                        : item.Generado > 0
                        ? "Parcial en embarque"
                        : "Programado";
                        <tr>
                            <td class="print-date">@item.Fecha.ToString("dd/MM/yyyy")</td>
                            <td class="print-client">@item.Cliente</td>
                            <td class="print-ref">@item.Referencia</td>
                            <td>@item.Designacion</td>
                            <td class="print-qty">@item.Cantidad.ToString("N0")</td>
                            <td class="print-status">@estadoImpresion</td>
                            <td class="print-obs">@(string.IsNullOrWhiteSpace(item.Observaciones) ? "-" : item.Observaciones)</td>
                        </tr>
                    }
                </tbody>
            </table>
        }
    </section>

    <script>
        (function(){
            document.getElementById('btnImprimirProgramacion')?.addEventListener('click',()=>window.print());
            const n=v=>Number(v||0);
            const entero=v=>Math.max(0,Math.floor(n(v)));
            const nf=v=>entero(v).toLocaleString('es-MX');
            const nombresDias={1:'Lunes',2:'Martes',3:'Miércoles',4:'Jueves',5:'Viernes',6:'Sábado',7:'Domingo'};
            const acordeones=[...document.querySelectorAll('.client-accordion')];
            const buscar=document.getElementById('buscarClienteParte');
            const filtro=document.getElementById('filtroEstado');
            const sinResultados=document.getElementById('sinResultados');
            document.querySelectorAll('.js-client-toggle').forEach(btn=>btn.addEventListener('click',()=>btn.closest('.client-accordion')?.classList.toggle('open')));
            function filtrar(){
                const q=(buscar?.value||'').trim().toLowerCase();
                const tipo=filtro?.value||'todos';
                let visibles=0;
                acordeones.forEach(item=>{
                    let visible=!q||(item.dataset.search||'').includes(q);
                    if(tipo==='expeditado') visible=visible&&item.dataset.expeditado==='1';
                    else if(tipo==='pendiente') visible=visible&&item.dataset.pendiente==='1';
                    else if(tipo==='programado') visible=visible&&item.dataset.programado==='1';
                    item.style.display=visible?'':'none';
                    if(visible){ visibles++; if(q) item.classList.add('open'); }
                });
                if(sinResultados) sinResultados.style.display=visibles===0?'block':'none';
            }
            buscar?.addEventListener('input',filtrar);
            filtro?.addEventListener('change',filtrar);
            document.getElementById('btnExpandir')?.addEventListener('click',()=>acordeones.filter(x=>x.style.display!=='none').forEach(x=>x.classList.add('open')));
            document.getElementById('btnContraer')?.addEventListener('click',()=>acordeones.forEach(x=>x.classList.remove('open')));

            const backdrop=document.getElementById('programarBackdrop');
            const filas=document.getElementById('programacionFilas');
            const form=document.getElementById('formProgramacion');
            const prClienteID=document.getElementById('prClienteID');
            const prParteID=document.getElementById('prParteID');
            const prTitulo=document.getElementById('prTitulo');
            const prSubtitulo=document.getElementById('prSubtitulo');
            const prTotal=document.getElementById('prTotal');
            const prOriginal=document.getElementById('prOriginal');
            const prCapturado=document.getElementById('prCapturado');
            const prRestante=document.getElementById('prRestante');
            const prHabitual=document.getElementById('prHabitual');
            const prProtegido=document.getElementById('prProtegido');
            const prAvanceTexto=document.getElementById('prAvanceTexto');
            const prDetalleResultado=document.getElementById('prDetalleResultado');
            const prFooterResumen=document.getElementById('prFooterResumen');
            const prTrack=document.getElementById('prTrack');
            const prTrackBar=document.getElementById('prTrackBar');
            const cardRestante=document.getElementById('cardRestante');
            const mensaje=document.getElementById('mensajePlan');
            const btnGuardar=document.getElementById('btnGuardar');
            const btnOtraFecha=document.getElementById('btnOtraFecha');
            const liveUbicacion=document.getElementById('liveUbicacion');
            const liveAlmacen=document.getElementById('liveAlmacen');
            const liveProduccion=document.getElementById('liveProduccion');
            const liveGP12=document.getElementById('liveGP12');
            const liveTotal=document.getElementById('liveTotal');
            const liveActualizado=document.getElementById('liveActualizado');
            let totalObjetivo=0;
            let totalGenerado=0;
            let totalProgramadoOriginal=0;
            let diasHabituales=[];
            let programacionesOriginales=[];
            let inicioSemana='';
            let finSemana='';
            let parteActual=0;
            let timerUbicacion=null;
            let firmaInicial='';

            function convertirDiaSemana(fechaTexto){
                if(!fechaTexto) return 0;
                const p=fechaTexto.split('-').map(Number);
                if(p.length!==3||p.some(Number.isNaN)) return 0;
                const diaJs=new Date(p[0],p[1]-1,p[2]).getDay();
                return diaJs===0?7:diaJs;
            }
            function formatearFecha(fecha){ return [fecha.getFullYear(),String(fecha.getMonth()+1).padStart(2,'0'),String(fecha.getDate()).padStart(2,'0')].join('-'); }
            function fechasUsadas(){ return new Set([...filas?.querySelectorAll('.js-fecha')||[]].map(x=>x.value).filter(Boolean)); }
            function fechaSugeridaLibre(){
                if(!inicioSemana) return '';
                const p=inicioSemana.split('-').map(Number);
                if(p.length!==3||p.some(Number.isNaN)) return '';
                const base=new Date(p[0],p[1]-1,p[2]);
                const usadas=fechasUsadas();
                const candidatos=[];
                diasHabituales.filter(x=>x>=1&&x<=6).forEach(d=>{
                    const f=new Date(base); f.setDate(base.getDate()+d-1); candidatos.push(formatearFecha(f));
                });
                for(let i=0;i<6;i++){ const f=new Date(base); f.setDate(base.getDate()+i); candidatos.push(formatearFecha(f)); }
                return candidatos.find(x=>!usadas.has(x))||'';
            }
            function normalizarProgramacionesOriginales(lista){
                const mapa=new Map();
                (Array.isArray(lista)?lista:[]).forEach(item=>{
                    const fecha=String(item?.fecha||'').trim();
                    const cantidad=entero(item?.cantidad);
                    if(!fecha||cantidad<=0) return;
                    const obs=String(item?.observaciones||'').trim();
                    if(!mapa.has(fecha)) mapa.set(fecha,{fecha,cantidad:0,observaciones:obs});
                    const actual=mapa.get(fecha);
                    actual.cantidad+=cantidad;
                    if(!actual.observaciones&&obs) actual.observaciones=obs;
                });
                return [...mapa.values()].sort((a,b)=>a.fecha.localeCompare(b.fecha));
            }
            function actualizarAdvertenciaDia(row){
                const fecha=row?.querySelector('.js-fecha');
                const warning=row?.querySelector('.js-dia-warning');
                if(!fecha||!warning) return;
                if(!fecha.value||diasHabituales.length===0){ warning.textContent=''; warning.className='planner-row-note js-dia-warning'; return; }
                const dia=convertirDiaSemana(fecha.value);
                if(diasHabituales.includes(dia)){ warning.textContent='Día habitual del cliente.'; warning.className='planner-row-note js-dia-warning'; return; }
                warning.textContent='Día distinto al habitual: '+diasHabituales.map(x=>nombresDias[x]||'').filter(Boolean).join(' / ')+'.';
                warning.className='planner-row-note warn js-dia-warning';
            }
            function reindexar(){
                if(!filas) return;
                [...filas.querySelectorAll('.planner-row')].forEach((row,index)=>{
                    const fecha=row.querySelector('.js-fecha');
                    const cantidad=row.querySelector('.js-cantidad');
                    const observaciones=row.querySelector('.js-obs');
                    if(fecha) fecha.name=`Programaciones[${index}].FechaProgramadaCarga`;
                    if(cantidad) cantidad.name=`Programaciones[${index}].Cantidad`;
                    if(observaciones) observaciones.name=`Programaciones[${index}].Observaciones`;
                });
            }
            function totalCapturado(){
                if(!filas) return 0;
                return [...filas.querySelectorAll('.js-cantidad')].reduce((total,input)=>total+entero(input.value),0);
            }
            function obtenerEstadoFilas(){
                if(!filas) return [];
                return [...filas.querySelectorAll('.planner-row')].map(row=>({
                    fecha:row.querySelector('.js-fecha')?.value||'',
                    cantidad:entero(row.querySelector('.js-cantidad')?.value),
                    observaciones:(row.querySelector('.js-obs')?.value||'').trim()
                })).filter(x=>x.fecha||x.cantidad>0||x.observaciones);
            }
            function firmaActual(){
                return JSON.stringify(obtenerEstadoFilas().filter(x=>x.cantidad>0).sort((a,b)=>a.fecha.localeCompare(b.fecha)||a.cantidad-b.cantidad));
            }
            function hayCambios(){ return !!firmaInicial&&firmaActual()!==firmaInicial; }
            function validarDuplicados(){
                const grupos=new Map();
                [...filas?.querySelectorAll('.planner-row')||[]].forEach(row=>{
                    row.classList.remove('duplicate');
                    const fecha=row.querySelector('.js-fecha')?.value||'';
                    if(!fecha) return;
                    if(!grupos.has(fecha)) grupos.set(fecha,[]);
                    grupos.get(fecha).push(row);
                });
                let hay=false;
                grupos.forEach(rows=>{
                    if(rows.length<=1) return;
                    hay=true;
                    rows.forEach(row=>row.classList.add('duplicate'));
                });
                return hay;
            }
            function actualizarMarcaCambio(row){
                if(!row) return;
                const origen=row.dataset.origen||'nuevo';
                if(origen==='nuevo'){ row.classList.toggle('changed',entero(row.querySelector('.js-cantidad')?.value)>0||!!row.querySelector('.js-fecha')?.value); return; }
                const originalFecha=row.dataset.fechaOriginal||'';
                const originalCantidad=entero(row.dataset.cantidadOriginal);
                const originalObs=row.dataset.obsOriginal||'';
                const fecha=row.querySelector('.js-fecha')?.value||'';
                const cantidad=entero(row.querySelector('.js-cantidad')?.value);
                const obs=(row.querySelector('.js-obs')?.value||'').trim();
                row.classList.toggle('changed',fecha!==originalFecha||cantidad!==originalCantidad||obs!==originalObs);
                const nota=row.querySelector('.js-original-note');
                if(nota) nota.textContent=`Antes: ${nf(originalCantidad)} PZA${originalFecha?` · ${originalFecha.split('-').reverse().join('/')}`:''}`;
            }
            function actualizarResumen(){
                const capturado=totalCapturado();
                const restante=Math.max(0,totalObjetivo-capturado);
                const excedente=Math.max(0,capturado-totalObjetivo);
                const duplicadas=validarDuplicados();
                [...filas?.querySelectorAll('.planner-row')||[]].forEach(actualizarMarcaCambio);
                if(prCapturado) prCapturado.textContent=nf(capturado);
                if(prRestante) prRestante.textContent=excedente>0?'+'+nf(excedente):nf(restante);
                if(prAvanceTexto) prAvanceTexto.textContent=`${nf(capturado)} programadas / ${nf(totalObjetivo)} editables`;
                if(prDetalleResultado) prDetalleResultado.textContent=`Antes había ${nf(totalProgramadoOriginal)} PZA programadas. Al guardar quedarán ${nf(capturado)} PZA programadas y ${nf(restante)} PZA sin fecha.`;
                if(prFooterResumen) prFooterResumen.innerHTML=`<strong>${nf(capturado)} PZA</strong> programadas · ${nf(restante)} PZA sin fecha`;
                const porcentaje=totalObjetivo>0?Math.min(100,capturado*100/totalObjetivo):0;
                if(prTrackBar) prTrackBar.style.width=porcentaje+'%';
                cardRestante?.classList.remove('complete');
                prTrack?.classList.remove('complete','error');
                if(duplicadas){
                    if(mensaje){ mensaje.className='planner-message error'; mensaje.innerHTML='Hay <strong>dos filas con la misma fecha</strong>. Usa una sola fila por día para evitar duplicar la programación.'; }
                    prTrack?.classList.add('error');
                    if(btnGuardar) btnGuardar.disabled=true;
                    return;
                }
                if(excedente>0){
                    if(mensaje){ mensaje.className='planner-message error'; mensaje.innerHTML=`El resultado supera el saldo editable por <strong>${nf(excedente)} PZA</strong>. Reduce alguna cantidad antes de guardar.`; }
                    prTrack?.classList.add('error');
                    if(btnGuardar) btnGuardar.disabled=true;
                    return;
                }
                if(capturado<=0){
                    if(mensaje){ mensaje.className='planner-message warning'; mensaje.innerHTML='Captura al menos una fecha con una cantidad mayor a cero.'; }
                    if(btnGuardar) btnGuardar.disabled=true;
                    return;
                }
                const delta=capturado-totalProgramadoOriginal;
                if(restante===0){ cardRestante?.classList.add('complete'); prTrack?.classList.add('complete'); }
                if(mensaje){
                    if(delta>0){
                        mensaje.className='planner-message info';
                        mensaje.innerHTML=`Estás agregando <strong>${nf(delta)} PZA</strong> a la programación. Se toman del saldo que estaba sin fecha; <strong>ninguna fecha existente se descuenta automáticamente</strong>. Quedarán <strong>${nf(restante)} PZA</strong> sin programar.`;
                    }else if(delta<0){
                        mensaje.className='planner-message warning';
                        mensaje.innerHTML=`Estás liberando <strong>${nf(Math.abs(delta))} PZA</strong> de la programación actual. Esas piezas volverán a quedar sin fecha. Resultado: <strong>${nf(restante)} PZA</strong> sin programar.`;
                    }else if(hayCambios()){
                        mensaje.className='planner-message info';
                        mensaje.innerHTML=`Estás redistribuyendo las mismas <strong>${nf(capturado)} PZA</strong> entre fechas. El total programado no cambia y quedan <strong>${nf(restante)} PZA</strong> sin fecha.`;
                    }else{
                        mensaje.className=restante>0?'planner-message warning':'planner-message info';
                        mensaje.innerHTML=restante>0
                            ? `La programación actual se conserva sin cambios: <strong>${nf(totalProgramadoOriginal)} PZA</strong> programadas y <strong>${nf(restante)} PZA</strong> todavía sin fecha.`
                            : `La programación actual ya cubre las <strong>${nf(totalObjetivo)} PZA</strong> editables.`;
                    }
                }
                if(btnGuardar) btnGuardar.disabled=false;
            }
            function configurarEventosFila(row){
                const fecha=row.querySelector('.js-fecha');
                const cantidad=row.querySelector('.js-cantidad');
                const obs=row.querySelector('.js-obs');
                [fecha,cantidad,obs].forEach(control=>{
                    control?.addEventListener('input',()=>{ actualizarAdvertenciaDia(row); actualizarResumen(); });
                    control?.addEventListener('change',()=>{ actualizarAdvertenciaDia(row); actualizarResumen(); });
                });
                actualizarAdvertenciaDia(row);
            }
            function crearFila({fecha='',cantidad='',observaciones='',origen='nuevo'}={}){
                if(!filas) return null;
                const row=document.createElement('div');
                const existente=origen==='existente';
                row.className=`planner-row ${existente?'existing':'new-row'}`;
                row.dataset.origen=origen;
                row.dataset.fechaOriginal=existente?fecha:'';
                row.dataset.cantidadOriginal=existente?String(entero(cantidad)):'0';
                row.dataset.obsOriginal=existente?(observaciones||''):'';
                row.innerHTML=`
                    <div class="planner-field">
                        <label>Fecha de carga</label>
                        <input type="date" class="js-fecha" required />
                        <span class="planner-row-tag">${existente?'Programación actual':'Nueva fecha'}</span>
                        <span class="planner-row-note js-dia-warning"></span>
                    </div>
                    <div class="planner-field">
                        <label>Cantidad</label>
                        <input type="number" class="js-cantidad" min="0" step="1" inputmode="numeric" placeholder="0" required />
                        <span class="planner-row-note ${existente?'js-original-note':''}">${existente?`Antes: ${nf(cantidad)} PZA`:'Usa el saldo sin fecha disponible.'}</span>
                    </div>
                    <div class="planner-field obs">
                        <label>Observaciones</label>
                        <input type="text" class="js-obs" maxlength="1000" placeholder="Opcional" />
                        <span class="planner-row-note">${existente?'Puedes cambiar fecha o cantidad; el cambio será explícito.':'Esta fila no modifica por sí sola ninguna programación existente.'}</span>
                    </div>
                    <div class="planner-delete">${existente?'<button type="button" class="btn btn-sm btn-danger js-eliminar" title="Quitar esta fecha">×</button>':'<button type="button" class="btn btn-sm btn-danger js-eliminar">Quitar</button>'}</div>`;
                filas.appendChild(row);
                const inputFecha=row.querySelector('.js-fecha');
                const inputCantidad=row.querySelector('.js-cantidad');
                const inputObservaciones=row.querySelector('.js-obs');
                if(inputFecha){ inputFecha.value=fecha||''; if(inicioSemana) inputFecha.min=inicioSemana; if(finSemana) inputFecha.max=finSemana; }
                if(inputCantidad) inputCantidad.value=cantidad!==''&&cantidad!==null&&cantidad!==undefined?entero(cantidad):'';
                if(inputObservaciones) inputObservaciones.value=observaciones||'';
                row.querySelector('.js-eliminar')?.addEventListener('click',()=>{
                    const eraExistente=row.dataset.origen==='existente';
                    const cantidadOriginal=entero(row.dataset.cantidadOriginal);
                    const texto=eraExistente&&cantidadOriginal>0?`Esta fecha tenía ${nf(cantidadOriginal)} PZA programadas. Al quitarla, esas piezas quedarán sin fecha. ¿Continuar?`:'¿Quitar esta fila?';
                    if(!confirm(texto)) return;
                    row.remove();
                    reindexar();
                    actualizarResumen();
                });
                configurarEventosFila(row);
                reindexar();
                return row;
            }
            function restaurarProgramacionActual(){
                if(!filas) return;
                filas.innerHTML='';
                const existentes=normalizarProgramacionesOriginales(programacionesOriginales);
                totalProgramadoOriginal=existentes.reduce((t,x)=>t+entero(x.cantidad),0);
                if(existentes.length>0){
                    existentes.forEach(x=>crearFila({fecha:x.fecha,cantidad:x.cantidad,observaciones:x.observaciones,origen:'existente'}));
                }else{
                    const sugerida=fechaSugeridaLibre();
                    crearFila({fecha:sugerida,cantidad:totalObjetivo,observaciones:'',origen:'nuevo'});
                }
                reindexar();
                firmaInicial=firmaActual();
                actualizarResumen();
            }
            function agregarOtraFecha(){
                const capturado=totalCapturado();
                const saldo=Math.max(0,totalObjetivo-capturado);
                if(saldo<=0){
                    alert('Todo el saldo editable ya está programado. Si quieres mover piezas a otra fecha, primero reduce la cantidad de la fecha original para liberar saldo.');
                    return;
                }
                const sugerida=fechaSugeridaLibre();
                const row=crearFila({fecha:sugerida,cantidad:'',observaciones:'',origen:'nuevo'});
                actualizarResumen();
                setTimeout(()=>row?.querySelector('.js-cantidad')?.focus(),30);
            }
            async function cargarUbicacion(){
                if(!parteActual) return;
                if(liveUbicacion) liveUbicacion.textContent='Consultando...';
                try{
                    const url=`@Url.Action("ObtenerUbicacionParte", "LogisticaListaCarga")`+`?parteId=${encodeURIComponent(parteActual)}`;
                    const response=await fetch(url,{method:'GET',cache:'no-store',headers:{'X-Requested-With':'XMLHttpRequest'}});
                    if(!response.ok) throw new Error('No fue posible consultar la ubicación.');
                    const data=await response.json();
                    if(liveUbicacion) liveUbicacion.textContent=data.ubicacion||'SIN MATERIAL';
                    if(liveAlmacen) liveAlmacen.textContent=nf(data.piezasAlmacen);
                    if(liveProduccion) liveProduccion.textContent=nf(data.piezasProduccion);
                    if(liveGP12) liveGP12.textContent=nf(data.piezasGP12);
                    if(liveTotal) liveTotal.textContent=nf(data.piezasLocalizadas);
                    if(liveActualizado) liveActualizado.textContent='Actualizado '+new Date().toLocaleTimeString('es-MX',{hour:'2-digit',minute:'2-digit'});
                }catch(error){
                    console.error(error);
                    if(liveUbicacion) liveUbicacion.textContent='No disponible';
                    if(liveAlmacen) liveAlmacen.textContent='-';
                    if(liveProduccion) liveProduccion.textContent='-';
                    if(liveGP12) liveGP12.textContent='-';
                    if(liveTotal) liveTotal.textContent='-';
                }
            }
            function abrirProgramacion(btn){
                if(!backdrop||!filas) return;
                const clienteId=btn.dataset.clienteId||'';
                const parteId=btn.dataset.parteId||'';
                const cliente=btn.dataset.cliente||'';
                const referencia=btn.dataset.referencia||'';
                const designacion=btn.dataset.designacion||'';
                totalObjetivo=entero(btn.dataset.editable);
                totalGenerado=entero(btn.dataset.generado);
                parteActual=entero(parteId);
                inicioSemana=btn.dataset.semanaInicio||'';
                finSemana=btn.dataset.semanaFin||'';
                try{ diasHabituales=JSON.parse(btn.dataset.dias||'[]').map(Number).filter(x=>x>=1&&x<=6); }catch{ diasHabituales=[]; }
                try{ programacionesOriginales=JSON.parse(btn.dataset.programaciones||'[]')||[]; }catch{ programacionesOriginales=[]; }
                const normalizadas=normalizarProgramacionesOriginales(programacionesOriginales);
                totalProgramadoOriginal=normalizadas.reduce((t,x)=>t+entero(x.cantidad),0);
                if(totalProgramadoOriginal>totalObjetivo) totalProgramadoOriginal=totalObjetivo;
                const sinFechaInicial=Math.max(0,totalObjetivo-totalProgramadoOriginal);
                if(prClienteID) prClienteID.value=clienteId;
                if(prParteID) prParteID.value=parteId;
                if(prTitulo) prTitulo.textContent=(normalizadas.length>0?'Ajustar programación · ':'Programar día de carga · ')+cliente;
                if(prSubtitulo) prSubtitulo.textContent=referencia+(designacion?' · '+designacion:'');
                if(prTotal) prTotal.textContent=nf(totalObjetivo);
                if(prOriginal) prOriginal.textContent=nf(totalProgramadoOriginal);
                if(prRestante) prRestante.textContent=nf(sinFechaInicial);
                if(prProtegido) prProtegido.textContent=nf(totalGenerado)+' PZA';
                if(prHabitual) prHabitual.textContent=diasHabituales.length>0?diasHabituales.map(x=>nombresDias[x]||'').filter(Boolean).join(' / '):'Sin definir';
                restaurarProgramacionActual();
                cargarUbicacion();
                if(timerUbicacion) clearInterval(timerUbicacion);
                timerUbicacion=setInterval(()=>{ if(backdrop.classList.contains('open')) cargarUbicacion(); },30000);
                backdrop.classList.add('open');
                backdrop.setAttribute('aria-hidden','false');
                document.body.style.overflow='hidden';
            }
            function cerrarProgramacion(forzar=false){
                if(!forzar&&hayCambios()&&!confirm('Hay cambios de programación sin guardar. ¿Deseas cerrar y descartarlos?')) return;
                backdrop?.classList.remove('open');
                backdrop?.setAttribute('aria-hidden','true');
                document.body.style.overflow='';
                if(timerUbicacion){ clearInterval(timerUbicacion); timerUbicacion=null; }
            }
            document.querySelectorAll('.js-programar').forEach(btn=>btn.addEventListener('click',()=>abrirProgramacion(btn)));
            document.querySelectorAll('.js-cerrar').forEach(btn=>btn.addEventListener('click',()=>cerrarProgramacion(false)));
            backdrop?.addEventListener('click',e=>{ if(e.target===backdrop) cerrarProgramacion(false); });
            document.getElementById('btnActualizarUbicacion')?.addEventListener('click',cargarUbicacion);
            btnOtraFecha?.addEventListener('click',agregarOtraFecha);
            document.getElementById('btnRestablecer')?.addEventListener('click',()=>{
                if(hayCambios()&&!confirm('¿Restablecer la programación tal como estaba al abrir esta ventana?')) return;
                restaurarProgramacionActual();
            });
            form?.addEventListener('submit',e=>{
                reindexar();
                actualizarResumen();
                const capturado=totalCapturado();
                if(validarDuplicados()){ e.preventDefault(); alert('No puedes guardar dos filas con la misma fecha. Ajusta la cantidad en una sola fila.'); return; }
                if(capturado<=0){ e.preventDefault(); alert('Captura al menos una fecha con una cantidad mayor a cero.'); return; }
                if(capturado>totalObjetivo){ e.preventDefault(); alert(`La programación supera el saldo editable de ${nf(totalObjetivo)} PZA.`); return; }
                const registros=[...filas.querySelectorAll('.planner-row')];
                const activos=registros.filter(row=>entero(row.querySelector('.js-cantidad')?.value)>0);
                if(activos.length===0){ e.preventDefault(); alert('Captura al menos una fecha de carga.'); return; }
                const invalido=activos.some(row=>{
                    const fecha=row.querySelector('.js-fecha')?.value||'';
                    const cantidad=entero(row.querySelector('.js-cantidad')?.value);
                    return !fecha||cantidad<=0||(inicioSemana&&fecha<inicioSemana)||(finSemana&&fecha>finSemana);
                });
                if(invalido){ e.preventDefault(); alert('Revisa las fechas y cantidades. Todas las filas con piezas deben estar dentro de la semana y tener una cantidad mayor a cero.'); return; }
                registros.filter(row=>entero(row.querySelector('.js-cantidad')?.value)<=0).forEach(row=>row.remove());
                reindexar();
                const restante=Math.max(0,totalObjetivo-capturado);
                const delta=capturado-totalProgramadoOriginal;
                let confirmacion=`Se guardarán ${nf(capturado)} PZA programadas y quedarán ${nf(restante)} PZA sin fecha.`;
                if(delta>0) confirmacion+=` Se agregan ${nf(delta)} PZA respecto a la programación anterior.`;
                else if(delta<0) confirmacion+=` Se liberan ${nf(Math.abs(delta))} PZA respecto a la programación anterior.`;
                else if(hayCambios()) confirmacion+=' El total no cambia; solo se redistribuyen fechas/cantidades.';
                if(!confirm(confirmacion+' ¿Deseas continuar?')){ e.preventDefault(); return; }
                if(btnGuardar){ btnGuardar.disabled=true; btnGuardar.textContent='Guardando...'; }
                firmaInicial='';
            });
            document.addEventListener('keydown',e=>{ if(e.key==='Escape'&&backdrop?.classList.contains('open')) cerrarProgramacion(false); });
        })();
    </script>
</body>
</html>
