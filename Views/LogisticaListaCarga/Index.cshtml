        .client-name {
            font-weight: 900;
            color: var(--navy);
            font-size: 13px
        }

        .client-sub {
            display: flex;
            gap: 5px;
            flex-wrap: wrap;
            margin-top: 4px;
            font-size: 9px;
            color: var(--muted)
        }

        .client-kpi {
            text-align: center;
            border-left: 1px solid #e4eaf1
        }

            .client-kpi span {
                display: block;
                font-size: 7px;
                text-transform: uppercase;
                color: #8491a2;
                font-weight: 800
            }

            .client-kpi strong {
                font-size: 12px;
                color: var(--navy)
            }

            .client-kpi.danger strong {
                color: var(--danger)
            }

            .client-kpi.warning strong {
                color: var(--warn2)
            }

            .client-kpi.success strong {
                color: var(--ok)
            }

        .chevron {
            font-size: 17px;
            color: #728096;
            transition: .15s
        }

        .client-accordion.open .chevron {
            transform: rotate(180deg)
        }

        .client-body {
            display: none;
            border-top: 1px solid var(--line)
        }

        .client-accordion.open .client-body {
            display: block
        }

        .client-toolbar {
            display: flex;
            align-items: center;
            justify-content: space-between;
            gap: 8px;
            padding: 6px 9px;
            background: #fbfcfe;
            border-bottom: 1px solid var(--line);
            font-size: 9px;
            color: var(--muted)
        }

        .table-wrap {
            overflow-x: auto
        }

        .parts {
            width: 100%;
            border-collapse: collapse;
            table-layout: fixed;
            min-width: 1400px
        }

            .parts th {
                background: #e9eff6;
                color: #33445c;
                border-right: 1px solid #d5dee9;
                border-bottom: 1px solid #ccd7e4;
                padding: 6px 4px;
                font-size: 8px;
                text-transform: uppercase;
                text-align: center
            }

            .parts td {
                border-right: 1px solid #e6ebf2;
                border-bottom: 1px solid #e5ebf1;
                padding: 5px 4px;
                font-size: 10px;
                text-align: center;
                vertical-align: middle
            }

            .parts tbody tr:hover {
                background: #f7faff
            }

            .parts tr.part-exp {
                background: #fff9f8
            }

            .parts .left {
                text-align: left
            }

        .reference {
            font-family: Consolas,monospace;
            font-weight: 700;
            color: #223b61
        }

        .designation {
            display: block;
            white-space: nowrap;
            overflow: hidden;
            text-overflow: ellipsis
        }

        .demand-number {
            font-size: 11px;
            font-weight: 900;
            color: var(--navy)
        }

        .late {
            color: var(--danger) !important
        }

        .day-cell {
            min-height: 37px;
            display: flex;
            align-items: center;
            justify-content: center;
            flex-direction: column
        }

        .day-value {
            font-size: 11px;
            font-weight: 900;
            color: var(--blue)
        }

            .day-value.empty {
                color: #9cabbc
            }

        .day-required {
            font-size: 7px;
            color: #8491a1
        }

        td.habitual {
            background: #eef4ff
        }

            td.habitual .day-cell:after {
                content: "Habitual";
                font-size: 6px;
                text-transform: uppercase;
                font-weight: 800;
                color: #6681a9
            }

        .progress {
            height: 4px;
            border-radius: 999px;
            background: #e3eaf2;
            overflow: hidden;
            margin-top: 4px
        }

            .progress span {
                display: block;
                height: 100%;
                background: var(--blue2)
            }

            .progress.success span {
                background: var(--ok2)
            }

        .track-main {
            font-size: 11px;
            font-weight: 900
        }

        .track-sub {
            display: block;
            font-size: 7px;
            color: var(--muted);
            margin-top: 2px
        }

            .track-sub.warn {
                color: var(--warn)
            }

            .track-sub.ok {
                color: var(--ok)
            }

        .location {
            text-align: left
        }

            .location strong {
                display: block;
                font-size: 9px
            }

            .location small {
                font-size: 7px;
                color: var(--muted)
            }

        .no-results {
            display: none;
            padding: 25px;
            text-align: center;
            color: var(--muted)
        }

        .shipment-zone {
            padding: 9px;
            border-bottom: 1px solid var(--line);
            background: #f8fafc
        }

        .shipment-zone-title {
            display: flex;
            align-items: center;
            justify-content: space-between;
            gap: 10px;
            margin-bottom: 7px
        }

            .shipment-zone-title strong {
                font-size: 10px;
                color: var(--navy)
            }

            .shipment-zone-title span {
                font-size: 8px;
                color: var(--muted)
            }

        .shipment-groups {
            display: grid;
            grid-template-columns: repeat(auto-fit,minmax(320px,1fr));
            gap: 7px
        }

        .shipment-group {
            border: 1px solid #cad7e7;
            border-radius: 8px;
            background: #fff;
            overflow: hidden;
            box-shadow: 0 2px 7px rgba(16,27,49,.04)
        }

            .shipment-group.exp {
                border-color: #efc0bb
            }

        .shipment-group-head {
            display: flex;
            align-items: center;
            justify-content: space-between;
            gap: 8px;
            padding: 7px 8px;
            background: #eef4fb;
            border-bottom: 1px solid #dbe4ee
        }

        .shipment-group.exp .shipment-group-head {
            background: #fff3f1
        }

        .shipment-group-title {
            min-width: 0
        }

            .shipment-group-title strong {
                display: block;
                font-size: 10px;
                color: var(--navy)
            }

            .shipment-group-title span {
                display: block;
                margin-top: 1px;
                font-size: 8px;
                color: var(--muted)
            }

        .shipment-group-total {
            text-align: right;
            white-space: nowrap
        }

            .shipment-group-total strong {
                display: block;
                font-size: 13px;
                color: var(--blue)
            }

        .shipment-group.exp .shipment-group-total strong {
            color: var(--danger)
        }

        .shipment-group-total span {
            display: block;
            font-size: 7px;
            color: var(--muted);
            text-transform: uppercase;
            font-weight: 800
        }

        .shipment-lines {
            padding: 5px 8px
        }

        .shipment-line {
            display: grid;
            grid-template-columns: 105px minmax(0,1fr) 80px;
            gap: 7px;
            align-items: center;
            padding: 4px 0;
            border-bottom: 1px dashed #e1e7ef
        }

            .shipment-line:last-child {
                border-bottom: 0
            }

            .shipment-line .ref {
                font: 700 9px Consolas,monospace;
                color: #29446a;
                overflow: hidden;
                text-overflow: ellipsis;
                white-space: nowrap
            }

            .shipment-line .desc {
                font-size: 8px;
                color: #607086;
                overflow: hidden;
                text-overflow: ellipsis;
                white-space: nowrap
            }

            .shipment-line .qty {
                text-align: right;
                font-size: 9px;
                font-weight: 900;
                color: var(--navy)
            }

        .shipment-group-foot {
            display: flex;
            align-items: center;
            justify-content: space-between;
            gap: 8px;
            padding: 6px 8px;
            border-top: 1px solid #e1e7ef;
            background: #fbfcfe
        }

            .shipment-group-foot small {
                font-size: 7px;
                color: var(--muted);
                line-height: 1.25
            }

        .dialog-backdrop {
            display: none;
            position: fixed;
            inset: 0;
            background: rgba(10,20,35,.62);
            z-index: 1000;
            padding: 20px;
            align-items: center;
            justify-content: center;
            backdrop-filter: blur(2px)
        }

            .dialog-backdrop.open {
                display: flex
            }

        .dialog {
            width: min(850px,100%);
            max-height: calc(100vh - 35px);
            background: #fff;
            border-radius: 12px;
            box-shadow: 0 22px 65px rgba(0,0,0,.30);
            overflow: hidden;
            display: flex;
            flex-direction: column
        }

        .dialog-head {
            padding: 13px 15px;
            border-bottom: 1px solid var(--line);
            display: flex;
            justify-content: space-between;
            background: #fbfcfe
        }

            .dialog-head h3 {
                margin: 0;
                color: var(--navy);
                font-size: 17px
            }

            .dialog-head small {
                display: block;
                color: var(--muted);
                margin-top: 2px
            }

        .dialog-body {
            padding: 14px;
            overflow: auto
        }

        .dialog-foot {
            padding: 11px 14px;
            border-top: 1px solid var(--line);
            display: flex;
            justify-content: flex-end;
            gap: 7px;
            background: #fbfcfe
        }

        .x {
            border: 0;
            background: none;
            font-size: 21px;
            cursor: pointer;
            color: #69778a
        }

        .planner-top {
            display: grid;
            grid-template-columns: repeat(4,1fr);
            gap: 8px;
            margin-bottom: 11px
        }

        .planner-kpi {
            border: 1px solid var(--line);
            border-radius: 8px;
            padding: 8px 9px;
            background: #f8fafc
        }

            .planner-kpi span {
                display: block;
                font-size: 8px;
                text-transform: uppercase;
                color: var(--muted);
                font-weight: 800
            }

            .planner-kpi strong {
                display: block;
                margin-top: 2px;
                font-size: 17px;
                color: var(--navy)
            }

            .planner-kpi.remaining {
                background: var(--warnBg);
                border-color: #e6cc87
            }

                .planner-kpi.remaining strong {
                    color: var(--warn2)
                }

            .planner-kpi.complete {
                background: var(--okBg);
                border-color: #a9dec3
            }

                .planner-kpi.complete strong {
                    color: var(--ok)
                }

        .live-location {
            border: 1px solid #cdd9e8;
            border-radius: 9px;
            background: #f5f9ff;
            margin-bottom: 11px;
            overflow: hidden
        }

        .live-location-head {
            display: flex;
            align-items: center;
            justify-content: space-between;
            padding: 7px 9px;
            background: #edf4ff;
            border-bottom: 1px solid #dbe5f0
        }

            .live-location-head strong {
                font-size: 10px;
                color: var(--navy)
            }

        .live-location-grid {
            display: grid;
            grid-template-columns: 1.4fr repeat(3,1fr)
        }

            .live-location-grid > div {
                padding: 8px 10px;
                border-right: 1px solid #dbe5f0
            }

                .live-location-grid > div:last-child {
                    border-right: 0
                }

            .live-location-grid span {
                display: block;
                font-size: 7px;
                text-transform: uppercase;
                color: #7b899a;
                font-weight: 800
            }

            .live-location-grid strong {
                display: block;
                margin-top: 2px;
                font-size: 12px;
                color: var(--navy)
            }

        .live-location-foot {
            padding: 6px 9px;
            border-top: 1px solid #dbe5f0;
            font-size: 9px;
            color: var(--muted)
        }

        #liveActualizado {
            float: right
        }

        .planner-message {
            border-radius: 8px;
            padding: 9px 10px;
            font-size: 11px;
            margin-bottom: 10px;
            border: 1px solid
        }

            .planner-message.info {
                background: var(--blueSoft);
                border-color: #c3d5f1;
                color: #254c85
            }

            .planner-message.warning {
                background: var(--warnBg);
                border-color: #e7ca7e;
                color: #715000
            }

            .planner-message.error {
                background: var(--dangerBg);
                border-color: #efb4ae;
                color: #8b1e17
            }

        .planner-actions {
            display: flex;
            gap: 6px;
            flex-wrap: wrap;
            margin-bottom: 10px
        }

        .planner-help {
            padding: 8px 10px;
            border: 1px solid #cbd9eb;
            background: #f5f8fc;
            border-radius: 8px;
            margin-bottom: 10px;
            font-size: 10px;
            color: #52657e
        }

            .planner-help strong {
                color: var(--navy)
            }

        .planner-table {
            width: 100%;
            border-collapse: collapse;
            border: 1px solid var(--line)
        }

            .planner-table th {
                background: #eaf0f6;
                color: #52647b;
                font-size: 8px;
                text-transform: uppercase;
                text-align: left;
                padding: 6px
            }

            .planner-table td {
                padding: 6px;
                border-bottom: 1px solid var(--line);
                vertical-align: top
            }

            .planner-table input {
                width: 100%;
                border: 1px solid var(--line2);
                border-radius: 6px;
                padding: 7px;
                outline: none
            }

                .planner-table input:focus {
                    border-color: #668ac0;
                    box-shadow: 0 0 0 2px rgba(35,63,128,.07)
                }

                .planner-table input[readonly] {
                    background: #edf3fa;
                    color: var(--navy);
                    font-weight: 900;
                    cursor: not-allowed;
                    border-color: #c9d7e8
                }

            .planner-table .col-date {
                width: 160px
            }

            .planner-table .col-qty {
                width: 135px
            }

            .planner-table .col-delete {
                width: 42px
            }

        .saldo-tag {
            display: block;
            margin-top: 3px;
            font-size: 7px;
            color: var(--blue);
            font-weight: 800
        }

        .row-warning {
            display: none;
            color: var(--warn);
            font-size: 8px;
            margin-top: 3px
        }

            .row-warning.show {
                display: block
            }

        .rest-bar {
            margin-top: 11px;
            border: 1px solid var(--line);
            border-radius: 8px;
            padding: 9px;
            background: #f8fafc
        }

        .rest-head {
            display: flex;
            justify-content: space-between;
            font-size: 10px;
            color: var(--muted);
            margin-bottom: 5px
        }

            .rest-head strong {
                color: var(--navy)
            }

        .rest-track {
            height: 9px;
            background: #e2e9f1;
            border-radius: 999px;
            overflow: hidden
        }

            .rest-track span {
                display: block;
                height: 100%;
                background: var(--blue2);
                transition: width .15s
            }

            .rest-track.complete span {
                background: var(--ok2)
            }

            .rest-track.error span {
                background: var(--danger2)
            }

        @@media(max-width:1200px) {
            .summary {
                grid-template-columns: repeat(4,1fr)
            }

            .client-head-inner {
                grid-template-columns: minmax(200px,1.5fr) repeat(3,minmax(85px,.6fr)) 32px
            }

            .client-kpi.hide-medium {
                display: none
            }
        }

        @@media(max-width:750px) {
            .page {
                padding: 9px
            }

            .header {
                align-items: flex-start;
                flex-direction: column
            }

            .summary {
                grid-template-columns: repeat(2,1fr)
            }

            .search-box {
                width: 100%;
                min-width: 100%
            }

            .client-head-inner {
                grid-template-columns: 1fr 90px 30px
            }

            .client-kpi {
                display: none
            }

                .client-kpi.mobile-show {
                    display: block
                }

            .planner-top {
                grid-template-columns: repeat(2,1fr)
            }

            .live-location-grid {
                grid-template-columns: repeat(2,1fr)
            }
        }
    </style>
</head>
<body>

    <div class="page">
        <div class="header">
            <div class="header-left">
                <a class="back-main" asp-controller="LogisticaOperacion" asp-action="Index">
                    <span class="back-icon">←</span>
                    <span>
                        <small>REGRESAR A</small>
                        <strong>Centro Operativo</strong>
                    </span>
                </a>

                <div class="header-title">
                    <h1>Lista de carga semanal</h1>
                    <p>Consulta la demanda y programa el día de carga por cliente y parte. Los embarques continúan desde el Centro Operativo.</p>
                </div>
            </div>

            <div class="header-actions">
                <a class="btn btn-soft"
                   asp-controller="LogisticaListaCarga"
                   asp-action="DiasCargaClientes"
                   title="Configurar días habituales de carga por cliente">
                    Días habituales
                </a>

                <a class="btn"
                   asp-controller="LogisticaListaCarga"
                   asp-action="Index"
                   asp-route-anio="@anioAnterior"
                   asp-route-semana="@numeroSemanaAnterior">
                    ‹ Anterior
                </a>

                <div class="week-box">
                    <strong>@Model.SemanaTexto</strong>
                    <span>@Model.RangoTexto</span>
                </div>

                <a class="btn"
                   asp-controller="LogisticaListaCarga"
                   asp-action="Index"
                   asp-route-anio="@anioSiguiente"
                   asp-route-semana="@numeroSemanaSiguiente">
                    Siguiente ›
                </a>
            </div>
        </div>

        @if (TempData["LogisticaOk"] is string ok && !string.IsNullOrWhiteSpace(ok))
        {
            <div class="notice notice-ok">@ok</div>
        }

        @if (TempData["LogisticaError"] is string error && !string.IsNullOrWhiteSpace(error))
        {
            <div class="notice notice-error">@error</div>
        }

        <div class="summary">
            <div class="summary-item">
                <span>Clientes</span>
                <strong>@Model.TotalClientes</strong>
            </div>
            <div class="summary-item">
                <span>Partes</span>
                <strong>@Model.TotalPartidas</strong>
            </div>
            <div class="summary-item">
                <span>Demanda semana</span>
                <strong>@Model.TotalSemana.ToString("N0")</strong>
            </div>
            <div class="summary-item danger">
                <span>Expeditado</span>
                <strong>@Model.TotalAtraso.ToString("N0")</strong>
            </div>
            <div class="summary-item">
                <span>Por atender</span>
                <strong>@Model.TotalPorAtender.ToString("N0")</strong>
            </div>
            <div class="summary-item warning">
                <span>Sin programar</span>
                <strong>@Model.TotalSinProgramar.ToString("N0")</strong>
            </div>
            <div class="summary-item">
                <span>Programado</span>
                <strong>@Model.TotalProgramado.ToString("N0")</strong>
            </div>
            <div class="summary-item success">
                <span>Enviado</span>
                <strong>@Model.TotalEnviado.ToString("N0")</strong>
            </div>
        </div>

        <div class="toolbar">
            <div class="search-box">
                <span class="search-icon">⌕</span>
                <input id="buscarClienteParte" placeholder="Buscar cliente, referencia o designación..." autocomplete="off" />
            </div>

            <span class="toolbar-label">Mostrar</span>

            <select id="filtroEstado">
                <option value="todos">Todos los clientes</option>
                <option value="expeditado">Con expeditados</option>
                <option value="pendiente">Con piezas sin programar</option>
                <option value="programado">Con programación</option>
            </select>

            <button type="button" class="btn btn-sm" id="btnExpandir">Expandir todos</button>
            <button type="button" class="btn btn-sm" id="btnContraer">Contraer todos</button>
        </div>

        <div class="section">
            <div class="section-head">
                <div>
                    <h2>Programación por cliente · @Model.SemanaTexto</h2>
                    <small>Define el día de carga por cliente y parte. La creación del embarque continúa desde el Centro Operativo.</small>
                </div>

            </div>

            <div class="clients">
                @foreach (var grupo in gruposClientes)
                {
                    var totalSemana = grupo.Sum(x => x.TotalSemana);
                    var totalAtraso = grupo.Sum(x => x.Atraso);
                    var totalAtender = grupo.Sum(x => x.TotalPorAtender);
                    var totalProgramado = grupo.Sum(x => x.TotalProgramado);
                    var totalPendiente = grupo.Sum(x => x.TotalSinProgramar);
                    var totalEnviado = grupo.Sum(x => x.TotalEnviado);

                    var dias = grupo
                    .SelectMany(x => x.DiasHabituales)
                    .GroupBy(x => x.DiaSemana)
                    .Select(x => x.First())
                    .OrderBy(x => x.DiaSemana)
                    .ToList();

                    var diasTexto = dias.Count == 0
                    ? "Sin día habitual"
                    : string.Join(" · ", dias.Select(x => x.DiaTexto));

                    var search = (grupo.Key.Cliente + " " + string.Join(" ", grupo.Select(x => x.Referencia + " " + x.Designacion))).ToLowerInvariant();


                    <div class="client-accordion @(totalAtraso > 0 ? "has-exp" : "")"
                         data-search="@search"
                         data-expeditado="@(totalAtraso > 0 ? "1" : "0")"
                         data-pendiente="@(totalPendiente > 0 ? "1" : "0")"
                         data-programado="@(totalProgramado > 0 ? "1" : "0")">
                        <button type="button" class="client-head js-client-toggle">
                            <div class="client-head-inner">
                                <div>
                                    <div class="client-name">@grupo.Key.Cliente</div>

                                    <div class="client-sub">
                                        <span>@grupo.Count() parte(s)</span>
                                        <span>·</span>
                                        <span>Día habitual: <strong>@diasTexto</strong></span>

                                        @if (totalAtraso > 0)
                                        {
                                            <span class="status status-exp">Expeditado</span>
                                        }
                                    </div>
                                </div>

                                <div class="client-kpi">
                                    <span>Semana</span>
                                    <strong>@totalSemana.ToString("N0")</strong>
                                </div>

                                <div class="client-kpi danger">
                                    <span>Atraso</span>
                                    <strong>@totalAtraso.ToString("N0")</strong>
                                </div>

                                <div class="client-kpi mobile-show">
                                    <span>Por atender</span>
                                    <strong>@totalAtender.ToString("N0")</strong>
                                </div>

                                <div class="client-kpi warning hide-medium">
                                    <span>Sin programar</span>
                                    <strong>@totalPendiente.ToString("N0")</strong>
                                </div>

                                <div class="client-kpi success hide-medium">
                                    <span>Enviado</span>
                                    <strong>@totalEnviado.ToString("N0")</strong>
                                </div>

                                <div class="chevron">⌄</div>
                            </div>
                        </button>

                        <div class="client-body">
                            <div class="client-toolbar">
                                <span><strong>@grupo.Key.Cliente</strong> · @grupo.Count() parte(s)</span>
                                <span>Programado: <strong>@totalProgramado.ToString("N0")</strong> · Sin programar: <strong>@totalPendiente.ToString("N0")</strong></span>
                            </div>


                            <div class="table-wrap">
                                <table class="parts">
                                    <thead>
                                        <tr>
                                            <th style="width:115px">Referencia</th>
                                            <th style="width:205px">Designación</th>
                                            <th style="width:72px">Semana</th>
                                            <th style="width:72px">Atraso</th>
                                            <th style="width:80px">Por atender</th>
                                            <th style="width:67px">Lun<br /><small>@Model.FechaInicio.ToString("dd/MM")</small></th>
                                            <th style="width:67px">Mar<br /><small>@Model.FechaInicio.AddDays(1).ToString("dd/MM")</small></th>
                                            <th style="width:67px">Mié<br /><small>@Model.FechaInicio.AddDays(2).ToString("dd/MM")</small></th>
                                            <th style="width:67px">Jue<br /><small>@Model.FechaInicio.AddDays(3).ToString("dd/MM")</small></th>
                                            <th style="width:67px">Vie<br /><small>@Model.FechaInicio.AddDays(4).ToString("dd/MM")</small></th>
                                            <th style="width:67px">Sáb<br /><small>@Model.FechaInicio.AddDays(5).ToString("dd/MM")</small></th>
                                            <th style="width:95px">Programado</th>
                                            <th style="width:85px">Enviado</th>
                                            <th style="width:145px">Ubicación</th>
                                            <th style="width:90px">Acción</th>
                                        </tr>
                                    </thead>

                                    <tbody>
                                        @foreach (var fila in grupo.OrderByDescending(x => x.EsExpeditado).ThenBy(x => x.Referencia))
                                        {
                                            var porcentajeProgramado = fila.PorcentajeProgramado.ToString("0.##", CultureInfo.InvariantCulture) + "%";
                                            var porcentajeEnviado = fila.PorcentajeEnviado.ToString("0.##", CultureInfo.InvariantCulture) + "%";

                                            var diasJson = JsonSerializer.Serialize(
                                            fila.DiasHabituales
                                            .Select(x => x.DiaSemana)
                                            .Distinct()
                                            .OrderBy(x => x)
                                            .ToList());

                                            var fechas = new[]
                                            {
                                                                        Model.FechaInicio.Date,
                                                                        Model.FechaInicio.AddDays(1).Date,
                                                                        Model.FechaInicio.AddDays(2).Date,
                                                                        Model.FechaInicio.AddDays(3).Date,
                                                                        Model.FechaInicio.AddDays(4).Date,
                                                                        Model.FechaInicio.AddDays(5).Date
                                                                        };

                                            var valores = new[]
                                            {
                                                                        fila.Lunes,
                                                                        fila.Martes,
                                                                        fila.Miercoles,
                                                                        fila.Jueves,
                                                                        fila.Viernes,
                                                                        fila.Sabado
                                                                        };

                                            var requeridos = new[]
                                            {
                                                                        fila.RequeridoLunes,
                                                                        fila.RequeridoMartes,
                                                                        fila.RequeridoMiercoles,
                                                                        fila.RequeridoJueves,
                                                                        fila.RequeridoViernes,
                                                                        fila.RequeridoSabado
                                                                        };

                                            <tr class="@(fila.EsExpeditado ? "part-exp" : "")">
                                                <td class="left">
                                                    <span class="reference">@fila.Referencia</span>
                                                </td>

                                                <td class="left">
                                                    <span class="designation" title="@fila.Designacion">@fila.Designacion</span>
                                                </td>

                                                <td>
                                                    <span class="demand-number">@fila.TotalSemana.ToString("N0")</span>
                                                </td>

                                                <td>
                                                    <span class="demand-number @(fila.Atraso > 0 ? "late" : "")">
                                                        @(fila.Atraso > 0 ? fila.Atraso.ToString("N0") : "-")
                                                    </span>
                                                </td>

                                                <td>
                                                    <span class="demand-number">@fila.TotalPorAtender.ToString("N0")</span>

                                                    @if (fila.TotalSinProgramar > 0)
                                                    {
                                                        <span class="track-sub warn">
                                                            Sin fecha @fila.TotalSinProgramar.ToString("N0")
                                                        </span>
                                                    }
                                                </td>

                                                @for (var i = 0; i < 6; i++)
                                                {
                                                    <td class="@(fila.EsDiaHabitual(fechas[i]) ? "habitual" : "")">
                                                        <div class="day-cell">
                                                            <span class="day-value @(valores[i] <= 0 ? "empty" : "")">
                                                                @(valores[i] > 0 ? valores[i].ToString("N0") : "-")
                                                            </span>

                                                            @if (requeridos[i] > 0)
                                                            {
                                                                <span class="day-required">
                                                                    Req. @requeridos[i].ToString("N0")
                                                                </span>
                                                            }
                                                        </div>
                                                    </td>
                                                }

                                                <td>
                                                    <span class="track-main">@fila.TotalProgramado.ToString("N0")</span>

                                                    <div class="progress">
                                                        <span style="width:@porcentajeProgramado"></span>
                                                    </div>

                                                    @if (fila.TotalProgramado > 0)
                                                    {
                                                        <span class="track-sub ok">Programado</span>
                                                    }
                                                </td>

                                                <td>
                                                    <span class="track-main" style="color:var(--ok)">
                                                        @fila.TotalEnviado.ToString("N0")
                                                    </span>

                                                    <div class="progress success">
                                                        <span style="width:@porcentajeEnviado"></span>
                                                    </div>
                                                </td>

                                                <td>
                                                    <div class="location">
                                                        <strong>@fila.UbicacionTexto</strong>

                                                        @if (fila.TieneMaterialLocalizado)
                                                        {
                                                            <small>
                                                                @if (fila.PiezasAlmacen > 0)
                                                                {
                                                                    <span>ALM @fila.PiezasAlmacen.ToString("N0")</span>
                                                                }

                                                                @if (fila.PiezasProduccion > 0)
                                                                {
                                                                    <span> · PROD @fila.PiezasProduccion.ToString("N0")</span>
                                                                }

                                                                @if (fila.PiezasGP12 > 0)
                                                                {
                                                                    <span> · GP12 @fila.PiezasGP12.ToString("N0")</span>
                                                                }
                                                            </small>
                                                        }
                                                    </div>
                                                </td>

                                                <td>
                                                    @if (Model.SemanaAbierta && fila.TotalSinProgramar > 0)
                                                    {
                                                        <button type="button"
                                                                class="btn btn-sm btn-primary js-programar"
                                                                data-cliente-id="@fila.ClienteID"
                                                                data-parte-id="@fila.ParteID"
                                                                data-cliente="@fila.Cliente"
                                                                data-referencia="@fila.Referencia"
                                                                data-designacion="@fila.Designacion"
                                                                data-sin-programar="@fila.TotalSinProgramar"
                                                                data-semana-inicio="@Model.FechaInicio.ToString("yyyy-MM-dd")"
                                                                data-dias='@diasJson'>
                                                            Programar día
                                                        </button>
                                                    }
                                                    else if (fila.TotalProgramado > 0)
                                                    {
                                                        <span class="status status-programmed">Programado</span>
                                                    }
                                                    else
                                                    {
                                                        <span class="track-sub ok">Completo</span>
                                                    }
                                                </td>
                                            </tr>
                                        }
                                    </tbody>
                                </table>
                            </div>
                        </div>
                    </div>
                }

                <div id="sinResultados" class="no-results">
                    No hay clientes que coincidan con los filtros.
                </div>
            </div>
        </div>
    </div>

    @if (Model.ListaCargaSemanaID.HasValue)
    {
        <div id="programarBackdrop" class="dialog-backdrop" aria-hidden="true">
            <div class="dialog">
                <form method="post"
                      asp-controller="LogisticaListaCarga"
                      asp-action="GuardarProgramacion"
                      id="formProgramacion">

                    @Html.AntiForgeryToken()

                    <input type="hidden"
                           name="ListaCargaSemanaID"
                           value="@Model.ListaCargaSemanaID" />

                    <input type="hidden"
                           name="ClienteID"
                           id="prClienteID" />

                    <input type="hidden"
                           name="ParteID"
                           id="prParteID" />

                    <input type="hidden"
                           name="Anio"
                           value="@Model.Anio" />

                    <input type="hidden"
                           name="NumeroSemana"
                           value="@Model.NumeroSemana" />

                    <div class="dialog-head">
                        <div>
                            <h3 id="prTitulo">Programar día de carga</h3>
                            <small id="prSubtitulo"></small>
                        </div>

                        <button type="button"
                                class="x js-cerrar">
                            ×
                        </button>
                    </div>

                    <div class="dialog-body">
                        <div class="planner-top">
                            <div class="planner-kpi">
                                <span>Pendiente inicial</span>
                                <strong id="prTotal">0</strong>
                            </div>

                            <div class="planner-kpi">
                                <span>Distribuido</span>
                                <strong id="prCapturado">0</strong>
                            </div>

                            <div class="planner-kpi remaining"
                                 id="cardRestante">
                                <span>Sin distribuir</span>
                                <strong id="prRestante">0</strong>
                            </div>

                            <div class="planner-kpi">
                                <span>Día habitual</span>
                                <strong id="prHabitual">-</strong>
                            </div>
                        </div>

                        <div class="live-location">
                            <div class="live-location-head">
                                <strong>● Ubicación actual del material</strong>

                                <button type="button"
                                        class="btn btn-sm"
                                        id="btnActualizarUbicacion">
                                    ↻ Actualizar
                                </button>
                            </div>

                            <div class="live-location-grid">
                                <div>
                                    <span>Ubicación</span>
                                    <strong id="liveUbicacion">Consultando...</strong>
                                </div>

                                <div>
                                    <span>Almacén PT</span>
                                    <strong id="liveAlmacen">-</strong>
                                </div>

                                <div>
                                    <span>Producción</span>
                                    <strong id="liveProduccion">-</strong>
                                </div>

                                <div>
                                    <span>GP12</span>
                                    <strong id="liveGP12">-</strong>
                                </div>
                            </div>

                            <div class="live-location-foot">
                                Total localizado:
                                <strong id="liveTotal">-</strong> PZA

                                <span id="liveActualizado"></span>
                            </div>
                        </div>

                        <div class="planner-help">
                            <strong>¿Cómo funciona?</strong>
                            La primera fila contiene automáticamente el saldo pendiente.
                            Cuando agregues cantidades en otras fechas, esa primera cantidad
                            se reducirá sola para que nunca se duplique el requerimiento.
                        </div>

                        <div id="mensajePlan"
                             class="planner-message info">
                        </div>

                        <div class="planner-actions">
                            <button type="button"
                                    class="btn btn-sm"
                                    id="btnOtraFecha">
                                + Dividir en otra fecha
                            </button>

                            <button type="button"
                                    class="btn btn-sm btn-soft"
                                    id="btnRestablecer">
                                Restablecer
                            </button>
                        </div>

                        <table class="planner-table">
                            <thead>
                                <tr>
                                    <th class="col-date">Fecha de carga</th>
                                    <th class="col-qty">Cantidad</th>
                                    <th>Observaciones</th>
                                    <th class="col-delete"></th>
                                </tr>
                            </thead>

                            <tbody id="programacionFilas"></tbody>
                        </table>

                        <div class="rest-bar">
                            <div class="rest-head">
                                <span>Total distribuido</span>
                                <strong id="prAvanceTexto">0 / 0 PZA</strong>
                            </div>

                            <div class="rest-track"
                                 id="prTrack">
                                <span id="prTrackBar"></span>
                            </div>
                        </div>
                    </div>

                    <div class="dialog-foot">
                        <button type="button"
                                class="btn js-cerrar">
                            Cancelar
                        </button>

                        <button type="submit"
                                class="btn btn-primary"
                                id="btnGuardar">
                            Guardar programación
                        </button>
                    </div>
                </form>
            </div>
        </div>
    }

    <script>
        (function(){
            const n=v=>Number(v||0);
            const nf=v=>n(v).toLocaleString('es-MX');

            const nombresDias={
                1:'Lunes',
                2:'Martes',
                3:'Miércoles',
                4:'Jueves',
                5:'Viernes',
                6:'Sábado',
                7:'Domingo'
            };

            /* =========================================================
               ACORDEONES Y FILTROS
               ========================================================= */

            const acordeones=[...document.querySelectorAll('.client-accordion')];
            const buscar=document.getElementById('buscarClienteParte');
            const filtro=document.getElementById('filtroEstado');
            const sinResultados=document.getElementById('sinResultados');

            document.querySelectorAll('.js-client-toggle').forEach(btn=>{
                btn.addEventListener('click',()=>{
                    const item=btn.closest('.client-accordion');

                    if(item){
                        item.classList.toggle('open');
                    }
                });
            });

            function filtrar(){
                const q=(buscar?.value||'').trim().toLowerCase();
                const tipo=filtro?.value||'todos';
                let visibles=0;

                acordeones.forEach(item=>{
                    let visible=
                        !q||
                        (item.dataset.search||'').includes(q);

                    if(tipo==='expeditado'){
                        visible=
                            visible&&
                            item.dataset.expeditado==='1';
                    }
                    else if(tipo==='pendiente'){
                        visible=
                            visible&&
                            item.dataset.pendiente==='1';
                    }
                    else if(tipo==='programado'){
                        visible=
                            visible&&
                            item.dataset.programado==='1';
                    }

                    item.style.display=
                        visible
                            ?''
                            :'none';

                    if(visible){
                        visibles++;

                        if(q){
                            item.classList.add('open');
                        }
                    }
                });

                if(sinResultados){
                    sinResultados.style.display=
                        visibles===0
                            ?'block'
                            :'none';
                }
            }

            buscar?.addEventListener(
                'input',
                filtrar);

            filtro?.addEventListener(
                'change',
                filtrar);

            document.getElementById('btnExpandir')
                ?.addEventListener('click',()=>{
                    acordeones
                        .filter(x=>x.style.display!=='none')
                        .forEach(x=>x.classList.add('open'));
                });

            document.getElementById('btnContraer')
                ?.addEventListener('click',()=>{
                    acordeones
                        .forEach(x=>x.classList.remove('open'));
                });

            /* =========================================================
               MODAL DE PROGRAMACIÓN
               ========================================================= */

            const backdrop=
                document.getElementById('programarBackdrop');

            const filas=
                document.getElementById('programacionFilas');

            const form=
                document.getElementById('formProgramacion');

            const prClienteID=
                document.getElementById('prClienteID');

            const prParteID=
                document.getElementById('prParteID');

            const prTitulo=
                document.getElementById('prTitulo');

            const prSubtitulo=
                document.getElementById('prSubtitulo');

            const prTotal=
                document.getElementById('prTotal');

            const prCapturado=
                document.getElementById('prCapturado');

            const prRestante=
                document.getElementById('prRestante');

            const prHabitual=
                document.getElementById('prHabitual');

            const prAvanceTexto=
                document.getElementById('prAvanceTexto');

            const prTrack=
                document.getElementById('prTrack');

            const prTrackBar=
                document.getElementById('prTrackBar');

            const cardRestante=
                document.getElementById('cardRestante');

            const mensaje=
                document.getElementById('mensajePlan');

            const btnGuardar=
                document.getElementById('btnGuardar');

            const liveUbicacion=
                document.getElementById('liveUbicacion');

            const liveAlmacen=
                document.getElementById('liveAlmacen');

            const liveProduccion=
                document.getElementById('liveProduccion');

            const liveGP12=
                document.getElementById('liveGP12');

            const liveTotal=
                document.getElementById('liveTotal');

            const liveActualizado=
                document.getElementById('liveActualizado');

            let totalObjetivo=0;
            let diasHabituales=[];
            let inicioSemana='';
            let parteActual=0;
            let timerUbicacion=null;

            /* =========================================================
               FECHAS
               ========================================================= */

            function convertirDiaSemana(fechaTexto){
                if(!fechaTexto){
                    return 0;
                }

                const p=
                    fechaTexto
                        .split('-')
                        .map(Number);

                if(p.length!==3){
                    return 0;
                }

                const diaJs=
                    new Date(
                        p[0],
                        p[1]-1,
                        p[2])
                        .getDay();

                return diaJs===0
                    ?7
                    :diaJs;
            }

            function formatearFecha(fecha){
                return [
                    fecha.getFullYear(),
                    String(fecha.getMonth()+1).padStart(2,'0'),
                    String(fecha.getDate()).padStart(2,'0')
                ].join('-');
            }

            function fechaSugerida(){
                if(!inicioSemana){
                    return '';
                }

                const p=
                    inicioSemana
                        .split('-')
                        .map(Number);

                if(p.length!==3){
                    return inicioSemana;
                }

                const fecha=
                    new Date(
                        p[0],
                        p[1]-1,
                        p[2]);

                if(diasHabituales.length>0){
                    const preferido=
                        Math.min(...diasHabituales);

                    fecha.setDate(
                        fecha.getDate()+
                        Math.max(
                            0,
                            preferido-1));
                }

                return formatearFecha(fecha);
            }

            function actualizarAdvertenciaDia(tr){
                const fecha=
                    tr?.querySelector('.js-fecha');

                const warning=
                    tr?.querySelector('.row-warning');

                if(!fecha||!warning){
                    return;
                }

                if(
                    !fecha.value||
                    diasHabituales.length===0){

                    warning.textContent='';
                    warning.classList.remove('show');

                    return;
                }

                const dia=
                    convertirDiaSemana(
                        fecha.value);

                if(
                    diasHabituales
                        .includes(dia)){

                    warning.textContent='';
                    warning.classList.remove('show');

                    return;
                }

                warning.textContent=
                    'Día distinto al habitual: '+
                    diasHabituales
                        .map(x=>nombresDias[x]||'')
                        .filter(Boolean)
                        .join(' / ')+
                    '.';

                warning.classList.add('show');
            }

            /* =========================================================
               CÁLCULO AUTOMÁTICO DE SALDO
               ========================================================= */

            function obtenerFilaSaldo(){
                return filas
                    ?.querySelector(
                        'tr[data-es-saldo="1"]');
            }

            function obtenerCantidadOtrasFilas(){
                if(!filas){
                    return 0;
                }

                return [...filas.querySelectorAll(
                    'tr:not([data-es-saldo="1"]) .js-cantidad')]
                    .reduce(
                        (total,input)=>
                            total+
                            Math.max(
                                0,
                                n(input.value)),
                        0);
            }

            function actualizarSaldoAutomatico(){
                const filaSaldo=
                    obtenerFilaSaldo();

                const inputSaldo=
                    filaSaldo
                        ?.querySelector(
                            '.js-cantidad');

                if(!inputSaldo){
                    return;
                }

                const otras=
                    obtenerCantidadOtrasFilas();

                const saldo=
                    Math.max(
                        0,
                        totalObjetivo-otras);

                inputSaldo.value=
                    saldo;

                actualizarResumen();
            }

            function totalDistribuido(){
                if(!filas){
                    return 0;
                }

                return [...filas.querySelectorAll(
                    '.js-cantidad')]
                    .reduce(
                        (total,input)=>
                            total+
                            Math.max(
                                0,
                                n(input.value)),
                        0);
            }

            function actualizarResumen(){
                const otras=
                    obtenerCantidadOtrasFilas();

                const excedente=
                    Math.max(
                        0,
                        otras-totalObjetivo);

                const saldo=
                    Math.max(
                        0,
                        totalObjetivo-otras);

                const distribuido=
                    totalDistribuido();

                if(prCapturado){
                    prCapturado.textContent=
                        nf(distribuido);
                }

                if(prRestante){
                    prRestante.textContent=
                        nf(saldo);
                }

                if(prAvanceTexto){
                    prAvanceTexto.textContent=
                        `${nf(distribuido)} / ${nf(totalObjetivo)} PZA`;
                }

                const porcentaje=
                    totalObjetivo>0
                        ?Math.min(
                            100,
                            distribuido*100/
                            totalObjetivo)
                        :0;

                if(prTrackBar){
                    prTrackBar.style.width=
                        porcentaje+'%';
                }

                cardRestante
                    ?.classList
                    .remove('complete');

                prTrack
                    ?.classList
                    .remove(
                        'complete',
                        'error');

                if(excedente>0){
                    if(prRestante){
                        prRestante.textContent=
                            '+'+nf(excedente);
                    }

                    if(mensaje){
                        mensaje.className=
                            'planner-message error';

                        mensaje.innerHTML=
                            `Las fechas adicionales suman <strong>${nf(otras)} PZA</strong>, `+
                            `superando el pendiente por <strong>${nf(excedente)} PZA</strong>.`;
                    }

                    prTrack
                        ?.classList
                        .add('error');

                    if(btnGuardar){
                        btnGuardar.disabled=true;
                    }

                    return;
                }

                if(saldo===0){
                    cardRestante
                        ?.classList
                        .add('complete');

                    prTrack
                        ?.classList
                        .add('complete');

                    if(mensaje){
                        mensaje.className=
                            'planner-message info';

                        mensaje.innerHTML=
                            `✓ Las <strong>${nf(totalObjetivo)} PZA</strong> `+
                            `quedaron completamente distribuidas entre las fechas seleccionadas.`;
                    }

                    if(btnGuardar){
                        btnGuardar.disabled=false;
                    }

                    return;
                }

                if(mensaje){
                    mensaje.className=
                        'planner-message info';

                    if(otras>0){
                        mensaje.innerHTML=
                            `Se asignaron <strong>${nf(otras)} PZA</strong> a otras fechas. `+
                            `La fila de saldo se ajustó automáticamente a <strong>${nf(saldo)} PZA</strong>.`;
                    }
                    else{
                        mensaje.innerHTML=
                            `Las <strong>${nf(totalObjetivo)} PZA</strong> están asignadas inicialmente a la fecha principal. `+
                            `Agrega otra fecha para dividir la entrega.`;
                    }
                }

                if(btnGuardar){
                    btnGuardar.disabled=false;
                }
            }

            /* =========================================================
               FILAS
               ========================================================= */

            function reindexar(){
                if(!filas){
                    return;
                }

                [...filas.querySelectorAll('tr')]
                    .forEach((tr,index)=>{

                        const fecha=
                            tr.querySelector(
                                '.js-fecha');

                        const cantidad=
                            tr.querySelector(
                                '.js-cantidad');

                        const observaciones=
                            tr.querySelector(
                                '.js-obs');

                        if(fecha){
                            fecha.name=
                                `Programaciones[${index}].FechaProgramadaCarga`;
                        }

                        if(cantidad){
                            cantidad.name=
                                `Programaciones[${index}].Cantidad`;
                        }

                        if(observaciones){
                            observaciones.name=
                                `Programaciones[${index}].Observaciones`;
                        }
                    });
            }

            function crearFilaSaldo(){
                if(!filas){
                    return;
                }

                const tr=
                    document.createElement('tr');

                tr.dataset.esSaldo='1';

                tr.innerHTML=`
                    <td>
                        <input type="date"
                               class="js-fecha"
                               required />
                        <div class="row-warning"></div>
                    </td>
                    <td>
                        <input type="number"
                               class="js-cantidad"
                               min="0"
                               step="1"
                               readonly />
                        <span class="saldo-tag">
                            Saldo automático
                        </span>
                    </td>
                    <td>
                        <input type="text"
                               class="js-obs"
                               maxlength="1000"
                               placeholder="Opcional" />
                    </td>
                    <td></td>`;

                filas.appendChild(tr);

                const fecha=
                    tr.querySelector(
                        '.js-fecha');

                const cantidad=
                    tr.querySelector(
                        '.js-cantidad');

                if(fecha){
                    fecha.value=
                        fechaSugerida();

                    fecha.addEventListener(
                        'change',
                        ()=>actualizarAdvertenciaDia(tr));
                }

                if(cantidad){
                    cantidad.value=
                        totalObjetivo;
                }

                actualizarAdvertenciaDia(tr);

                reindexar();
            }

            function crearFilaAdicional(
                fecha='',
                cantidad='',
                observaciones=''){

                if(!filas){
                    return;
                }

                const tr=
                    document.createElement('tr');

                tr.dataset.esSaldo='0';

                tr.innerHTML=`
                    <td>
                        <input type="date"
                               class="js-fecha"
                               required />
                        <div class="row-warning"></div>
                    </td>
                    <td>
                        <input type="number"
                               class="js-cantidad"
                               min="1"
                               step="1"
                               placeholder="0"
                               required />
                    </td>
                    <td>
                        <input type="text"
                               class="js-obs"
                               maxlength="1000"
                               placeholder="Opcional" />
                    </td>
                    <td>
                        <button type="button"
                                class="btn btn-sm btn-danger js-eliminar"
                                title="Eliminar">
                            ×
                        </button>
                    </td>`;

                filas.appendChild(tr);

                const inputFecha=
                    tr.querySelector(
                        '.js-fecha');

                const inputCantidad=
                    tr.querySelector(
                        '.js-cantidad');

                const inputObservaciones=
                    tr.querySelector(
                        '.js-obs');

                const btnEliminar=
                    tr.querySelector(
                        '.js-eliminar');

                if(inputFecha){
                    inputFecha.value=
                        fecha||
                        fechaSugerida();

                    inputFecha.addEventListener(
                        'change',
                        ()=>actualizarAdvertenciaDia(tr));
                }

                if(inputCantidad){
                    inputCantidad.value=
                        cantidad!==null&&
                        cantidad!==undefined
                            ?cantidad
                            :'';

                    inputCantidad.addEventListener(
                        'input',
                        actualizarSaldoAutomatico);

                    inputCantidad.addEventListener(
                        'change',
                        actualizarSaldoAutomatico);
                }

                if(inputObservaciones){
                    inputObservaciones.value=
                        observaciones||
                        '';
                }

                if(btnEliminar){
                    btnEliminar.addEventListener(
                        'click',
                        ()=>{
                            tr.remove();

                            reindexar();

                            actualizarSaldoAutomatico();
                        });
                }

                actualizarAdvertenciaDia(tr);

                reindexar();

                actualizarSaldoAutomatico();
            }

            function restablecerProgramacion(){
                if(!filas){
                    return;
                }

                filas.innerHTML='';

                crearFilaSaldo();

                actualizarSaldoAutomatico();
            }

            /* =========================================================
               UBICACIÓN EN TIEMPO REAL
               ========================================================= */

            async function cargarUbicacion(){
                if(!parteActual){
                    return;
                }

                if(liveUbicacion){
                    liveUbicacion.textContent=
                        'Consultando...';
                }

                try{
                    const url=
                        `@Url.Action("ObtenerUbicacionParte", "LogisticaListaCarga")`+
                        `?parteId=${encodeURIComponent(parteActual)}`;

                    const response=
                        await fetch(
                            url,
                            {
                                method:'GET',
                                cache:'no-store',
                                headers:{
                                    'X-Requested-With':
                                        'XMLHttpRequest'
                                }
                            });

                    if(!response.ok){
                        throw new Error(
                            'No fue posible consultar la ubicación.');
                    }

                    const data=
                        await response.json();

                    if(liveUbicacion){
                        liveUbicacion.textContent=
                            data.ubicacion||
                            'SIN MATERIAL';
                    }

                    if(liveAlmacen){
                        liveAlmacen.textContent=
                            nf(data.piezasAlmacen);
                    }

                    if(liveProduccion){
                        liveProduccion.textContent=
                            nf(data.piezasProduccion);
                    }

                    if(liveGP12){
                        liveGP12.textContent=
                            nf(data.piezasGP12);
                    }

                    if(liveTotal){
                        liveTotal.textContent=
                            nf(data.piezasLocalizadas);
                    }

                    if(liveActualizado){
                        liveActualizado.textContent=
                            'Actualizado '+
                            new Date()
                                .toLocaleTimeString(
                                    'es-MX',
                                    {
                                        hour:'2-digit',
                                        minute:'2-digit'
                                    });
                    }
                }
                catch(error){
                    console.error(error);

                    if(liveUbicacion){
                        liveUbicacion.textContent=
                            'No disponible';
                    }

                    if(liveAlmacen){
                        liveAlmacen.textContent='-';
                    }

                    if(liveProduccion){
                        liveProduccion.textContent='-';
                    }

                    if(liveGP12){
                        liveGP12.textContent='-';
                    }

                    if(liveTotal){
                        liveTotal.textContent='-';
                    }
                }
            }

            /* =========================================================
               ABRIR / CERRAR
               ========================================================= */

            function abrirProgramacion(btn){
                if(!backdrop||!filas){
                    return;
                }

                const clienteId=
                    btn.dataset.clienteId||
                    '';

                const parteId=
                    btn.dataset.parteId||
                    '';

                const cliente=
                    btn.dataset.cliente||
                    '';

                const referencia=
                    btn.dataset.referencia||
                    '';

                const designacion=
                    btn.dataset.designacion||
                    '';

                totalObjetivo=
                    Math.max(
                        0,
                        n(btn.dataset.sinProgramar));

                parteActual=
                    n(parteId);

                inicioSemana=
                    btn.dataset.semanaInicio||
                    '';

                try{
                    diasHabituales=
                        JSON.parse(
                            btn.dataset.dias||
                            '[]')
                        .map(Number);
                }
                catch{
                    diasHabituales=[];
                }

                if(prClienteID){
                    prClienteID.value=
                        clienteId;
                }

                if(prParteID){
                    prParteID.value=
                        parteId;
                }

                if(prTitulo){
                    prTitulo.textContent=
                        'Programar día de carga · '+
                        cliente;
                }

                if(prSubtitulo){
                    prSubtitulo.textContent=
                        referencia+
                        (
                            designacion
                                ?' · '+designacion
                                :''
                        );
                }

                if(prTotal){
                    prTotal.textContent=
                        nf(totalObjetivo);
                }

                if(prHabitual){
                    prHabitual.textContent=
                        diasHabituales.length>0
                            ?diasHabituales
                                .map(x=>nombresDias[x]||'')
                                .filter(Boolean)
                                .join(' / ')
                            :'Sin definir';
                }

                /*
                 * SIEMPRE iniciamos con UNA fila saldo.
                 *
                 * Ejemplo:
                 * pendiente = 18,000
                 *
                 * fila principal = 18,000
                 */
                restablecerProgramacion();

                cargarUbicacion();

                if(timerUbicacion){
                    clearInterval(
                        timerUbicacion);
                }

                timerUbicacion=
                    setInterval(
                        ()=>{
                            if(
                                backdrop
                                    .classList
                                    .contains('open')){

                                cargarUbicacion();
                            }
                        },
                        30000);

                backdrop.classList.add('open');

                backdrop.setAttribute(
                    'aria-hidden',
                    'false');
            }

            function cerrarProgramacion(){
                backdrop
                    ?.classList
                    .remove('open');

                backdrop
                    ?.setAttribute(
                        'aria-hidden',
                        'true');

                if(timerUbicacion){
                    clearInterval(
                        timerUbicacion);

                    timerUbicacion=null;
                }
            }

            document
                .querySelectorAll(
                    '.js-programar')
                .forEach(btn=>{
                    btn.addEventListener(
                        'click',
                        ()=>abrirProgramacion(btn));
                });

            document
                .querySelectorAll(
                    '.js-cerrar')
                .forEach(btn=>{
                    btn.addEventListener(
                        'click',
                        cerrarProgramacion);
                });

            backdrop
                ?.addEventListener(
                    'click',
                    e=>{
                        if(e.target===backdrop){
                            cerrarProgramacion();
                        }
                    });

            /* =========================================================
               BOTONES DEL MODAL
               ========================================================= */

            document
                .getElementById(
                    'btnActualizarUbicacion')
                ?.addEventListener(
                    'click',
                    cargarUbicacion);

            document
                .getElementById(
                    'btnOtraFecha')
                ?.addEventListener(
                    'click',
                    ()=>{
                        crearFilaAdicional(
                            fechaSugerida(),
                            '',
                            '');

                        setTimeout(
                            ()=>{
                                const inputs=
                                    filas
                                        ?.querySelectorAll(
                                            'tr:not([data-es-saldo="1"]) .js-cantidad');

                                if(
                                    inputs&&
                                    inputs.length>0){

                                    inputs[
                                        inputs.length-1
                                    ].focus();
                                }
                            },
                            30);
                    });

            document
                .getElementById(
                    'btnRestablecer')
                ?.addEventListener(
                    'click',
                    restablecerProgramacion);

            /* =========================================================
               GUARDAR
               ========================================================= */

            form
                ?.addEventListener(
                    'submit',
                    e=>{

                        reindexar();

                        const otras=
                            obtenerCantidadOtrasFilas();

                        if(
                            otras>
                            totalObjetivo){

                            e.preventDefault();

                            alert(
                                'Las cantidades distribuidas superan el pendiente disponible.');

                            return;
                        }

                        const registros=
                            [...filas.querySelectorAll('tr')];

                        const invalido=
                            registros.some(
                                tr=>{

                                    const fecha=
                                        tr.querySelector(
                                            '.js-fecha');

                                    const cantidad=
                                        tr.querySelector(
                                            '.js-cantidad');

                                    return (
                                        !fecha?.value||
                                        n(cantidad?.value)<=0
                                    );
                                });

                        if(invalido){
                            e.preventDefault();

                            alert(
                                'Todas las fechas deben tener una cantidad mayor a cero.');

                            return;
                        }

                        /*
                         * Al llegar aquí SIEMPRE:
                         *
                         * suma de todas las filas
                         * =
                         * totalObjetivo
                         *
                         * porque la primera es saldo automático.
                         */
                        if(
                            totalDistribuido()!==
                            totalObjetivo){

                            e.preventDefault();

                            alert(
                                'La distribución no coincide con el pendiente inicial.');

                            return;
                        }

                        if(btnGuardar){
                            btnGuardar.disabled=
                                true;

                            btnGuardar.textContent=
                                'Guardando...';
                        }
                    });


            document
                .addEventListener(
                    'keydown',
                    e=>{
                        if(e.key==='Escape'){
                            cerrarProgramacion();
                        }
                    });
        })();
    </script>
</body>
</html>
