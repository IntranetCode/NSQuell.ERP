@model ERP.NSQuell.Models.ViewModels.Logistica.LogisticaListaCargaIndexVm
@using System.Globalization
@using System.Text.Json
@{
    Layout = null;
    ViewData["Title"] = "Lista de carga semanal";

    var semanaAnteriorFecha = Model.FechaInicio.AddDays(-7);
    var semanaSiguienteFecha = Model.FechaInicio.AddDays(7);

    var anioAnterior = ISOWeek.GetYear(semanaAnteriorFecha);
    var numeroSemanaAnterior = ISOWeek.GetWeekOfYear(semanaAnteriorFecha);

    var anioSiguiente = ISOWeek.GetYear(semanaSiguienteFecha);
    var numeroSemanaSiguiente = ISOWeek.GetWeekOfYear(semanaSiguienteFecha);

    var gruposClientes = Model.Filas
        .GroupBy(x => new { x.ClienteID, x.Cliente })
        .OrderByDescending(x => x.Sum(y => y.Atraso))
        .ThenBy(x => x.Key.Cliente)
        .ToList();
}
<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width,initial-scale=1" />
    <title>@ViewData["Title"]</title>

    <style>
        :root {
            --navy: #101b31;
            --navy2: #172b4d;
            --blue: #173a7a;
            --blue2: #2454a4;
            --blueSoft: #edf4ff;
            --line: #d4deea;
            --line2: #c4d0de;
            --bg: #edf2f7;
            --text: #172033;
            --muted: #66758a;
            --danger: #b42318;
            --danger2: #d92d20;
            --dangerBg: #fff1f0;
            --warn: #936100;
            --warn2: #b77900;
            --warnBg: #fff7df;
            --ok: #087443;
            --ok2: #15955c;
            --okBg: #eaf9f1;
            --purple: #6941c6;
            --purpleBg: #f2edff;
            --shadow: 0 5px 18px rgba(16,27,49,.08)
        }

        * {
            box-sizing: border-box
        }

        html, body {
            margin: 0;
            background: var(--bg);
            color: var(--text);
            font-family: Segoe UI,Arial,sans-serif;
            font-size: 14px
        }

        button, input, select, textarea {
            font: inherit
        }

        body {
            min-height: 100vh
        }

        .page {
            max-width: 1880px;
            margin: 0 auto;
            padding: 16px
        }

        .header {
            display: flex;
            align-items: center;
            justify-content: space-between;
            gap: 18px;
            margin-bottom: 12px
        }

        .header-left {
            display: flex;
            align-items: center;
            gap: 13px;
            min-width: 0
        }

        .header-title {
            min-width: 0
        }

            .header-title h1 {
                margin: 0;
                color: var(--navy);
                font-size: 25px;
                font-weight: 900;
                letter-spacing: -.02em
            }

            .header-title p {
                margin: 4px 0 0;
                color: var(--muted);
                font-size: 12px
            }

        .back-main {
            display: flex;
            align-items: center;
            gap: 11px;
            background: linear-gradient(135deg,#101b31,#173a7a);
            color: #fff;
            text-decoration: none;
            border-radius: 11px;
            padding: 10px 16px;
            box-shadow: 0 6px 17px rgba(16,27,49,.25);
            min-width: 150px;
            transition: .15s
        }

            .back-main:hover {
                filter: brightness(1.1);
                transform: translateY(-1px)
            }

        .back-icon {
            font-size: 26px;
            line-height: 1
        }

        .back-main small {
            display: block;
            font-size: 7px;
            letter-spacing: .11em;
            color: #c8d5e8;
            font-weight: 900
        }

        .back-main strong {
            display: block;
            margin-top: 1px;
            font-size: 13px
        }

        .header-actions {
            display: flex;
            align-items: center;
            gap: 7px;
            flex-wrap: wrap
        }

        .btn {
            border: 1px solid var(--line2);
            background: #fff;
            color: var(--navy);
            padding: 7px 11px;
            border-radius: 7px;
            text-decoration: none;
            cursor: pointer;
            font-weight: 700;
            display: inline-flex;
            align-items: center;
            justify-content: center;
            gap: 6px;
            min-height: 34px;
            transition: .12s;
            white-space: nowrap
        }

            .btn:hover {
                border-color: #8ca4c0;
                background: #f8fbff
            }

        .btn-primary {
            background: var(--blue);
            border-color: var(--blue);
            color: #fff
        }

            .btn-primary:hover {
                background: var(--blue2);
                border-color: var(--blue2);
                color: #fff
            }

        .btn-success {
            background: var(--ok);
            border-color: var(--ok);
            color: #fff
        }

            .btn-success:hover {
                background: var(--ok2);
                border-color: var(--ok2)
            }

        .btn-danger {
            background: #fff;
            border-color: #efb5af;
            color: var(--danger)
        }

            .btn-danger:hover {
                background: var(--dangerBg)
            }

        .btn-soft {
            background: var(--blueSoft);
            border-color: #c9daf5;
            color: var(--blue)
        }

        .btn-sm {
            min-height: 29px;
            padding: 5px 8px;
            font-size: 11px
        }

        .btn:disabled, .btn.disabled {
            opacity: .42;
            pointer-events: none
        }

        .week-box {
            background: #fff;
            border: 1px solid var(--line);
            border-radius: 8px;
            padding: 7px 13px;
            text-align: center;
            min-width: 145px;
            box-shadow: var(--shadow)
        }

            .week-box strong {
                display: block;
                color: var(--blue);
                font-size: 15px
            }

            .week-box span {
                font-size: 9px;
                color: var(--muted)
            }

        .notice {
            padding: 10px 12px;
            border-radius: 8px;
            margin-bottom: 10px;
            border: 1px solid;
            font-size: 12px
        }

        .notice-ok {
            background: var(--okBg);
            border-color: #afe3c8;
            color: #085f39
        }

        .notice-error {
            background: var(--dangerBg);
            border-color: #efb8b2;
            color: #8e1d14
        }

        .summary {
            display: grid;
            grid-template-columns: repeat(8,minmax(105px,1fr));
            background: #fff;
            border: 1px solid var(--line);
            border-radius: 10px;
            overflow: hidden;
            margin-bottom: 10px;
            box-shadow: var(--shadow)
        }

        .summary-item {
            padding: 9px 11px;
            border-right: 1px solid var(--line);
            border-top: 3px solid var(--blue)
        }

            .summary-item:last-child {
                border-right: 0
            }

            .summary-item span {
                display: block;
                font-size: 8px;
                text-transform: uppercase;
                font-weight: 800;
                color: var(--muted)
            }

            .summary-item strong {
                display: block;
                margin-top: 3px;
                color: var(--navy);
                font-size: 18px;
                font-weight: 900
            }

            .summary-item.danger {
                border-top-color: var(--danger2)
            }

                .summary-item.danger strong {
                    color: var(--danger)
                }

            .summary-item.warning {
                border-top-color: #d99a14
            }

                .summary-item.warning strong {
                    color: var(--warn2)
                }

            .summary-item.success {
                border-top-color: var(--ok2)
            }

                .summary-item.success strong {
                    color: var(--ok)
                }

        .toolbar {
            display: flex;
            align-items: center;
            gap: 7px;
            flex-wrap: wrap;
            background: #fff;
            border: 1px solid var(--line);
            border-radius: 10px;
            padding: 9px 10px;
            margin-bottom: 10px;
            box-shadow: var(--shadow)
        }

        .search-box {
            position: relative;
            flex: 1;
            min-width: 280px
        }

            .search-box input {
                width: 100%;
                height: 35px;
                border: 1px solid var(--line2);
                border-radius: 7px;
                padding: 7px 10px 7px 32px;
                outline: none
            }

                .search-box input:focus {
                    border-color: #6389be;
                    box-shadow: 0 0 0 3px rgba(35,63,128,.08)
                }

        .search-icon {
            position: absolute;
            left: 10px;
            top: 9px;
            color: #7b899a
        }

        .toolbar select {
            height: 35px;
            border: 1px solid var(--line2);
            border-radius: 7px;
            padding: 5px 9px;
            background: #fff;
            min-width: 185px
        }

        .toolbar-label {
            font-size: 9px;
            font-weight: 800;
            text-transform: uppercase;
            color: var(--muted)
        }

        .status {
            display: inline-flex;
            align-items: center;
            padding: 4px 8px;
            border-radius: 999px;
            font-weight: 800;
            font-size: 9px
        }

        .status-exp {
            background: var(--dangerBg);
            color: var(--danger)
        }

        .status-programmed {
            background: var(--purpleBg);
            color: var(--purple)
        }

        .section {
            background: #fff;
            border: 1px solid var(--line);
            border-radius: 10px;
            overflow: hidden;
            box-shadow: var(--shadow)
        }

        .section-head {
            display: flex;
            align-items: center;
            justify-content: space-between;
            gap: 12px;
            padding: 10px 12px;
            border-bottom: 1px solid var(--line);
            background: #f8fafc
        }

            .section-head h2 {
                font-size: 14px;
                color: var(--navy);
                margin: 0;
                font-weight: 900
            }

            .section-head small {
                display: block;
                color: var(--muted);
                font-size: 10px;
                margin-top: 2px
            }

        .clients {
            padding: 9px
        }

        .client-accordion {
            border: 1px solid var(--line);
            border-radius: 9px;
            margin-bottom: 7px;
            overflow: hidden;
            background: #fff
        }

            .client-accordion.has-exp {
                border-color: #edc1bc
            }

        .client-head {
            width: 100%;
            border: 0;
            background: #f8fafc;
            padding: 0;
            cursor: pointer;
            text-align: left;
            color: inherit
        }

        .client-accordion.has-exp .client-head {
            background: linear-gradient(90deg,#fff4f2,#fafbfd 40%)
        }

        .client-head-inner {
            display: grid;
            grid-template-columns: minmax(220px,1.8fr) repeat(5,minmax(90px,.65fr)) 32px;
            align-items: center;
            gap: 4px;
            min-height: 58px;
            padding: 7px 9px
