@model ERP.NSQuell.Models.ViewModels.Logistica.LogisticaListaCargaIndexVm
@using System.Globalization
@using System.Text.Json
@{
    Layout = null;
    ViewData["Title"] = "Lista de carga semanal";
    var semanaAnteriorFecha = Model.FechaInicio.AddDays(-7);
    var semanaSiguienteFecha = Model.FechaInicio.AddDays(7);
    var anioAnterior = ISOWeek.GetYear(semanaAnteriorFecha);
    var numeroSemanaAnterior = ISOWeek.GetWeekOfYear(semanaAnteriorFecha);
    var anioSiguiente = ISOWeek.GetYear(semanaSiguienteFecha);
    var numeroSemanaSiguiente = ISOWeek.GetWeekOfYear(semanaSiguienteFecha);
}
<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width,initial-scale=1" />
    <title>@ViewData["Title"]</title>
    <style>
        :root {
            --navy: #172033;
            --blue: #173a7a;
            --blue2: #233f80;
            --line: #dce5ef;
            --bg: #f3f6f9;
            --soft: #fbfcfd;
            --text: #1f2b3d;
            --muted: #6c7889;
            --danger: #b42318;
            --danger-bg: #fff1f0;
            --warn: #9a6700;
            --warn-bg: #fff8e6;
            --ok: #137a4b;
            --ok-bg: #ecfdf3;
            --shadow: 0 8px 24px rgba(23,32,51,.08)
        }

        * {
            box-sizing: border-box
        }

        html, body {
            margin: 0;
            background: var(--bg);
            color: var(--text);
            font-family: Segoe UI,Arial,sans-serif;
            font-size: 14px
        }

        button, input, select, textarea {
            font: inherit
        }

        .page {
            max-width: 1820px;
            margin: 0 auto;
            padding: 16px
        }

        .topbar {
            display: flex;
            align-items: flex-start;
            justify-content: space-between;
            gap: 16px;
            margin-bottom: 12px
        }

        .title-wrap h1 {
            margin: 0;
            color: var(--navy);
            font-size: 24px;
            line-height: 1.15
        }

        .title-wrap p {
            margin: 5px 0 0;
            color: var(--muted);
            font-size: 13px
        }

        .week-nav {
            display: flex;
            align-items: center;
            gap: 8px;
            flex-wrap: wrap;
            justify-content: flex-end
        }

        .btn {
            border: 1px solid var(--line);
            background: #fff;
            color: var(--navy);
            padding: 7px 11px;
            border-radius: 7px;
            text-decoration: none;
            cursor: pointer;
            font-weight: 600;
            display: inline-flex;
            align-items: center;
            justify-content: center;
            gap: 6px;
            min-height: 34px
        }

            .btn:hover {
                border-color: #aabbd0;
                background: #f8fafc
            }

        .btn-primary {
            background: var(--blue);
            border-color: var(--blue);
            color: #fff
        }

            .btn-primary:hover {
                background: var(--blue2);
                color: #fff
            }

        .btn-success {
            background: var(--ok);
            border-color: var(--ok);
            color: #fff
        }

        .btn-danger {
            background: #fff;
            border-color: #e9b3ad;
            color: var(--danger)
        }

        .btn-warning {
            background: var(--warn-bg);
            border-color: #ead59e;
            color: #725000
        }

        .btn-sm {
            padding: 5px 8px;
            min-height: 29px;
            font-size: 12px
        }

        .btn:disabled, .btn.disabled {
            opacity: .45;
            cursor: not-allowed;
            pointer-events: none
        }

        .week-box {
            background: #fff;
            border: 1px solid var(--line);
            padding: 7px 12px;
            border-radius: 7px;
            text-align: center;
            min-width: 132px
        }

            .week-box strong {
                display: block;
                color: var(--blue);
                font-size: 15px
            }

            .week-box span {
                font-size: 11px;
                color: var(--muted)
            }

        .status {
            display: inline-flex;
            align-items: center;
            padding: 4px 8px;
            border-radius: 999px;
            font-weight: 700;
            font-size: 10px;
            white-space: nowrap
        }

        .status-open {
            background: var(--ok-bg);
            color: var(--ok)
        }

        .status-closed {
            background: #eef1f4;
            color: #576271
        }

        .status-exp {
            background: var(--danger-bg);
            color: var(--danger)
        }

        .status-prog {
            background: #edf3ff;
            color: var(--blue)
        }

        .status-warn {
            background: var(--warn-bg);
            color: var(--warn)
        }

        .status-ok {
            background: var(--ok-bg);
            color: var(--ok)
        }

        .notice {
            padding: 10px 12px;
            border-radius: 7px;
            margin: 0 0 10px;
            border: 1px solid
        }

        .notice-ok {
            background: var(--ok-bg);
            border-color: #b7ebd0;
            color: #12633f
        }

        .notice-error {
            background: var(--danger-bg);
            border-color: #f3c3be;
            color: #8f1d14
        }

        .notice-info {
            background: #edf3ff;
            border-color: #cddcf4;
            color: #274c84
        }

        .summary {
            display: grid;
            grid-template-columns: repeat(8,minmax(110px,1fr));
            border: 1px solid var(--line);
            background: #fff;
            border-radius: 9px;
            overflow: hidden;
            margin-bottom: 10px
        }

        .summary-item {
            padding: 9px 11px;
            border-right: 1px solid var(--line);
            min-width: 0
        }

            .summary-item:last-child {
                border-right: 0
            }

            .summary-item span {
                display: block;
                color: var(--muted);
                font-size: 9px;
                text-transform: uppercase;
                letter-spacing: .05em
            }

            .summary-item strong {
                display: block;
                margin-top: 2px;
                color: var(--navy);
                font-size: 17px;
                white-space: nowrap
            }

            .summary-item.danger strong {
                color: var(--danger)
            }

            .summary-item.warning strong {
                color: var(--warn)
            }

            .summary-item.success strong {
                color: var(--ok)
            }

        .toolbar {
            display: flex;
            align-items: end;
            gap: 8px;
            flex-wrap: wrap;
            background: #fff;
            border: 1px solid var(--line);
            border-radius: 9px;
            padding: 9px 10px;
            margin-bottom: 10px
        }

        .field {
            display: flex;
            flex-direction: column;
            gap: 3px
        }

            .field label {
                font-size: 10px;
                text-transform: uppercase;
                color: var(--muted);
                font-weight: 700
            }

            .field input, .field select, .field textarea {
                border: 1px solid #cfd9e5;
                border-radius: 6px;
                background: #fff;
                padding: 7px 8px;
                outline: none;
                color: var(--text)
            }

                .field input:focus, .field select:focus, .field textarea:focus {
                    border-color: #7694c4;
                    box-shadow: 0 0 0 2px rgba(35,63,128,.08)
                }

        .field-search {
            flex: 1;
            min-width: 220px
        }

        .field-client {
            min-width: 220px
        }

        .field-critical {
            min-width: 145px
        }

        .week-actions {
            margin-left: auto;
            display: flex;
            gap: 6px;
            align-items: center;
            flex-wrap: wrap
        }

        .section {
            background: #fff;
            border: 1px solid var(--line);
            border-radius: 9px;
            overflow: hidden;
            margin-bottom: 12px
        }

        .section-head {
            display: flex;
            align-items: center;
            justify-content: space-between;
            gap: 12px;
            padding: 9px 11px;
            border-bottom: 1px solid var(--line);
            background: var(--soft)
        }

            .section-head h2 {
                font-size: 14px;
                color: var(--navy);
                margin: 0
            }

            .section-head small {
                color: var(--muted)
            }

        .section-actions {
            display: flex;
            align-items: center;
            gap: 7px;
            flex-wrap: wrap
        }

        .table-wrap {
            width: 100%;
            overflow-x: auto
        }

        .matrix {
            width: 100%;
            border-collapse: collapse;
            table-layout: fixed;
            min-width: 1590px
        }

            .matrix th {
                background: #eef3f8;
                color: #314158;
                border-right: 1px solid var(--line);
                border-bottom: 1px solid var(--line);
                font-size: 9px;
                text-transform: uppercase;
                letter-spacing: .02em;
                padding: 6px 4px;
                text-align: center;
                vertical-align: middle
            }

            .matrix td {
                border-right: 1px solid #edf1f5;
                border-bottom: 1px solid #e8edf3;
                padding: 5px 4px;
                vertical-align: middle;
                text-align: center;
                font-size: 11px
            }

                .matrix th:last-child, .matrix td:last-child {
                    border-right: 0
                }

            .matrix tbody tr:hover {
                background: #f8fbff
            }

            .matrix tbody tr.row-exp {
                background: #fff8f7
            }

                .matrix tbody tr.row-exp:hover {
                    background: #fff1ef
                }

            .matrix tbody tr.row-pending td:first-child {
                box-shadow: inset 3px 0 0 #d99a16
            }

            .matrix .left {
                text-align: left
            }

            .matrix .num {
                font-variant-numeric: tabular-nums
            }

            .matrix .strong {
                font-weight: 700;
                color: var(--navy)
            }

            .matrix .late {
                color: var(--danger);
                font-weight: 800;
                background: #fff0ee
            }

            .matrix .sent {
                color: var(--ok);
                font-weight: 800
            }

            .matrix .pending {
                color: var(--warn);
                font-weight: 800
            }

            .matrix .muted {
                color: #a2acb9
            }

        .c-cliente {
            width: 145px
        }

        .c-ref {
            width: 110px
        }

        .c-desc {
            width: 190px
        }

        .c-total {
            width: 72px
        }

        .c-atraso {
            width: 66px
        }

        .c-dia {
            width: 72px
        }

        .c-ubi {
            width: 160px
        }

        .c-programado {
            width: 105px
        }

        .c-enviado {
            width: 95px
        }

        .c-action {
            width: 92px
        }

        .client {
            font-weight: 700;
            color: #24334a
        }

        .reference {
            font-family: Consolas,monospace;
            font-size: 11px
        }

        .designation {
            white-space: nowrap;
            overflow: hidden;
            text-overflow: ellipsis;
            display: block
        }

        .habitual {
            display: block;
            margin-top: 3px;
            font-size: 9px;
            color: #627188;
            line-height: 1.15
        }

        .day-cell {
            min-height: 38px;
            display: flex;
            flex-direction: column;
            align-items: center;
            justify-content: center;
            gap: 1px
        }

        .day-value {
            font-weight: 800;
            color: var(--blue);
            font-size: 12px
        }

        .day-required {
            font-size: 8px;
            color: #8995a5;
            white-space: nowrap
        }

        .day-habitual {
            background: #f3f7ff
        }

            .day-habitual .day-value {
                color: #173a7a
            }

        .location {
            display: flex;
            flex-direction: column;
            gap: 2px;
            align-items: flex-start
        }

            .location strong {
                font-size: 10px;
                color: #33445d;
                white-space: normal;
                text-align: left
            }

            .location small {
                font-size: 9px;
                color: var(--muted);
                line-height: 1.2;
                text-align: left
            }

        .metric-detail {
            display: block;
            font-size: 8px;
            font-weight: 500;
            color: var(--muted);
            margin-top: 2px;
            line-height: 1.2
        }

        .progress {
            height: 3px;
            background: #e9eef4;
            border-radius: 999px;
            overflow: hidden;
            margin-top: 3px
        }

            .progress > span {
                display: block;
                height: 100%;
                background: #3d6db4
            }

        .progress-ok > span {
            background: #25845c
        }

        .empty {
            padding: 28px;
            text-align: center;
            color: var(--muted)
        }

        .agenda {
            width: 100%;
            border-collapse: collapse;
            min-width: 900px
        }

            .agenda th {
                background: #eef3f8;
                color: #314158;
                font-size: 10px;
                text-transform: uppercase;
                padding: 7px 8px;
                border-bottom: 1px solid var(--line);
                text-align: left
            }

            .agenda td {
                padding: 7px 8px;
                border-bottom: 1px solid #edf1f5;
                font-size: 12px
            }

            .agenda tbody tr:hover {
                background: #f8fbff
            }

            .agenda a {
                color: var(--blue);
                text-decoration: none;
                font-weight: 700
            }

                .agenda a:hover {
                    text-decoration: underline
                }

        .obs-bar {
            display: flex;
            gap: 8px;
            align-items: end
        }

            .obs-bar .field {
                flex: 1
            }

            .obs-bar textarea {
                resize: vertical;
                min-height: 34px;
                max-height: 100px
            }

        .dialog-backdrop {
            display: none;
            position: fixed;
            inset: 0;
            background: rgba(12,19,31,.52);
            z-index: 1000;
            padding: 20px;
            align-items: center;
            justify-content: center
        }

            .dialog-backdrop.open {
                display: flex
            }

        .dialog {
            width: min(720px,100%);
            max-height: calc(100vh - 40px);
            background: #fff;
            border-radius: 10px;
            box-shadow: 0 18px 50px rgba(0,0,0,.22);
            overflow: hidden;
            display: flex;
            flex-direction: column
        }

        .dialog-sm {
            width: min(560px,100%)
        }

        .dialog-head {
            padding: 12px 14px;
            border-bottom: 1px solid var(--line);
            display: flex;
            align-items: center;
            justify-content: space-between;
            gap: 10px
        }

            .dialog-head h3 {
                margin: 0;
                color: var(--navy);
                font-size: 16px
            }

            .dialog-head small {
                display: block;
                margin-top: 2px;
                color: var(--muted)
            }

        .dialog-body {
            padding: 14px;
            overflow: auto
        }

        .dialog-foot {
            padding: 10px 14px;
            border-top: 1px solid var(--line);
            display: flex;
            justify-content: flex-end;
            gap: 7px
        }

        .dialog-grid {
            display: grid;
            grid-template-columns: 1fr 1fr;
            gap: 10px
        }

            .dialog-grid .full {
                grid-column: 1/-1
            }

        .x {
            border: 0;
            background: none;
            font-size: 20px;
            cursor: pointer;
            color: #6c7889
        }

        .legend {
            display: flex;
            gap: 10px;
            align-items: center;
            flex-wrap: wrap;
            font-size: 10px;
            color: var(--muted)
        }

        .dot {
            width: 8px;
            height: 8px;
            border-radius: 50%;
            display: inline-block;
            margin-right: 3px
        }

        .dot-exp {
            background: #d92d20
        }

        .dot-prog {
            background: #2f65b0
        }

        .dot-hab {
            background: #8ea8d4
        }

        .state-actions {
            display: flex;
            gap: 6px;
            align-items: center;
            flex-wrap: wrap
        }

        .program-summary {
            display: grid;
            grid-template-columns: repeat(4,1fr);
            gap: 7px;
            margin-bottom: 12px
        }

            .program-summary > div {
                border: 1px solid var(--line);
                border-radius: 7px;
                padding: 7px 8px;
                background: var(--soft)
            }

            .program-summary span {
                display: block;
                font-size: 9px;
                text-transform: uppercase;
                color: var(--muted)
            }

            .program-summary strong {
                display: block;
                margin-top: 2px;
                color: var(--navy);
                font-size: 14px
            }

        .program-table {
            width: 100%;
            border-collapse: collapse
        }

            .program-table th {
                font-size: 9px;
                text-transform: uppercase;
                color: var(--muted);
                text-align: left;
                padding: 5px;
                border-bottom: 1px solid var(--line)
            }

            .program-table td {
                padding: 5px;
                border-bottom: 1px solid #edf1f5;
                vertical-align: top
            }

            .program-table input {
                width: 100%;
                border: 1px solid #cfd9e5;
                border-radius: 6px;
                padding: 7px
            }

            .program-table .col-date {
                width: 160px
            }

            .program-table .col-qty {
                width: 120px
            }

            .program-table .col-delete {
                width: 42px
            }

        .program-warning {
            display: none;
            color: var(--warn);
            font-size: 9px;
            margin-top: 3px;
            line-height: 1.2
        }

            .program-warning.show {
                display: block
            }

        .program-footer {
            display: flex;
            align-items: center;
            justify-content: space-between;
            gap: 10px;
            margin-top: 10px;
            padding-top: 10px;
            border-top: 1px solid var(--line)
        }

        .program-total {
            font-size: 12px;
            color: var(--muted)
        }

            .program-total strong {
                color: var(--navy);
                font-size: 16px
            }

        .hint {
            font-size: 10px;
            color: var(--muted);
            margin: 4px 0 0;
            line-height: 1.35
        }

        .warning-box {
            background: var(--warn-bg);
            border: 1px solid #ead59e;
            color: #715200;
            border-radius: 7px;
            padding: 8px 10px;
            font-size: 11px;
            margin-bottom: 10px
        }

        @@media(max-width:1250px) {
            .summary {
                grid-template-columns: repeat(4,1fr)
            }

            .summary-item:nth-child(4n) {
                border-right: 0
            }

            .week-actions {
                margin-left: 0
            }

            .topbar {
                flex-direction: column
            }

            .week-nav {
                justify-content: flex-start
            }
        }

        @@media(max-width:700px) {
            .page {
                padding: 10px
            }

            .summary {
                grid-template-columns: repeat(2,1fr)
            }

            .summary-item:nth-child(even) {
                border-right: 0
            }

            .toolbar {
                align-items: stretch
            }

            .field, .field-client, .field-critical, .field-search {
                width: 100%;
                min-width: 0
            }

            .week-actions {
                width: 100%
            }

            .obs-bar {
                flex-direction: column;
                align-items: stretch
            }

            .dialog-grid {
                grid-template-columns: 1fr
            }

                .dialog-grid .full {
                    grid-column: auto
                }

            .program-summary {
                grid-template-columns: repeat(2,1fr)
            }

            .program-footer {
                align-items: stretch;
                flex-direction: column
            }

            .title-wrap h1 {
                font-size: 21px
            }
        }
    </style>
</head>
<body>
    <div class="page">
        <div class="topbar">
            <div class="title-wrap">
                <h1>Lista de carga semanal</h1>
                <p>Programa cuánto material debe cargar o salir de planta cada día. La modalidad de salida se define posteriormente en Embarques.</p>
            </div>
            <div class="week-nav">
                <a class="btn" asp-controller="LogisticaListaCarga" asp-action="Index" asp-route-anio="@anioAnterior" asp-route-semana="@numeroSemanaAnterior">‹ Semana anterior</a>
                <div class="week-box"><strong>@Model.SemanaTexto</strong><span>@Model.RangoTexto</span></div>
                <a class="btn" asp-controller="LogisticaListaCarga" asp-action="Index" asp-route-anio="@anioSiguiente" asp-route-semana="@numeroSemanaSiguiente">Semana siguiente ›</a>
            </div>
        </div>

        @if (TempData["LogisticaOk"] is string ok && !string.IsNullOrWhiteSpace(ok))
        {
            <div class="notice notice-ok">@ok</div>
        }
        @if (TempData["LogisticaError"] is string error && !string.IsNullOrWhiteSpace(error))
        {
            <div class="notice notice-error">@error</div>
        }
        @if (ViewBag.ErrorConfiguracion is string errorConfiguracion && !string.IsNullOrWhiteSpace(errorConfiguracion))
        {
            <div class="notice notice-error">@errorConfiguracion</div>
        }

        <div class="summary">
            <div class="summary-item"><span>Clientes</span><strong>@Model.TotalClientes</strong></div>
            <div class="summary-item"><span>Partidas</span><strong>@Model.TotalPartidas</strong></div>
            <div class="summary-item"><span>Semana actual</span><strong>@Model.TotalSemana.ToString("N0")</strong></div>
            <div class="summary-item danger"><span>Expeditado / atraso</span><strong>@Model.TotalAtraso.ToString("N0")</strong></div>
            <div class="summary-item"><span>Por atender</span><strong>@Model.TotalPorAtender.ToString("N0")</strong></div>
            <div class="summary-item warning"><span>Sin programar</span><strong>@Model.TotalSinProgramar.ToString("N0")</strong></div>
            <div class="summary-item"><span>Programado</span><strong>@Model.TotalProgramado.ToString("N0")</strong></div>
            <div class="summary-item success"><span>Enviado</span><strong>@Model.TotalEnviado.ToString("N0")</strong></div>
        </div>

        <form method="get" asp-controller="LogisticaListaCarga" asp-action="Index" class="toolbar">
            <input type="hidden" name="anio" value="@Model.Anio" />
            <input type="hidden" name="semana" value="@Model.NumeroSemana" />
            <div class="field field-search">
                <label>Buscar</label>
                <input type="text" name="q" value="@Model.Busqueda" placeholder="Cliente, referencia, designación u OF" />
            </div>
            <div class="field field-client">
                <label>Cliente</label>
                <select name="clienteId">
                    <option value="">Todos los clientes</option>
                    @foreach (var cliente in Model.Clientes)
                    {
                        if (Model.ClienteID == cliente.ClienteID)
                        {
                            <option value="@cliente.ClienteID" selected>@cliente.Cliente</option>
                        }
                        else
                        {
                            <option value="@cliente.ClienteID">@cliente.Cliente</option>
                        }
                    }
                </select>
            </div>
            <div class="field field-critical">
                <label>Criticidad</label>
                <select name="criticidad">
                    <option value="">Todos</option>
                    @if (Model.Criticidad == "Programado")
                    {
                        <option value="Programado" selected>Programado</option>
                    }
                    else
                    {
                        <option value="Programado">Programado</option>
                    }
                    @if (Model.Criticidad == "Expeditado")
                    {
                        <option value="Expeditado" selected>Expeditado</option>
                    }
                    else
                    {
                        <option value="Expeditado">Expeditado</option>
                    }
                </select>
            </div>
            <button class="btn btn-primary" type="submit">Aplicar</button>
            <a class="btn" asp-controller="LogisticaListaCarga" asp-action="Index" asp-route-anio="@Model.Anio" asp-route-semana="@Model.NumeroSemana">Limpiar</a>
            <div class="week-actions">
                <span class="status @(Model.SemanaAbierta ? "status-open" : "status-closed")">@Model.EstatusSemana</span>
            </div>
        </form>

        @if (Model.ListaCargaSemanaID.HasValue)
        {
            <div class="section">
                <div class="section-head">
                    <div>
                        <h2>Control de semana</h2>
                        <small>Observaciones generales y apertura/cierre operativo.</small>
                    </div>
                    <div class="state-actions">
                        <span class="status @(Model.SemanaAbierta ? "status-open" : "status-closed")">@Model.EstatusSemana</span>
                        <form method="post" asp-controller="LogisticaListaCarga" asp-action="CambiarEstadoSemana" style="margin:0">
                            @Html.AntiForgeryToken()
                            <input type="hidden" name="listaCargaSemanaId" value="@Model.ListaCargaSemanaID" />
                            <input type="hidden" name="estatus" value="@(Model.SemanaAbierta ? "Cerrada" : "Abierta")" />
                            <button type="submit" class="btn btn-sm @(Model.SemanaAbierta ? "btn-danger" : "btn-primary")">@(Model.SemanaAbierta ? "Cerrar semana" : "Reabrir semana")</button>
                        </form>
                    </div>
                </div>
                <div style="padding:9px 10px">
                    <form method="post" asp-controller="LogisticaListaCarga" asp-action="GuardarObservacionesSemana" class="obs-bar">
                        @Html.AntiForgeryToken()
                        <input type="hidden" name="listaCargaSemanaId" value="@Model.ListaCargaSemanaID" />
                        <div class="field">
                            <label>Observaciones de la semana</label>
                            <textarea name="observaciones" maxlength="1000" placeholder="Comentarios operativos generales...">@Model.ObservacionesSemana</textarea>
                        </div>
                        <button type="submit" class="btn">Guardar observación</button>
                    </form>
                </div>
            </div>
        }

        <div class="section">
            <div class="section-head">
                <div>
                    <h2>Programación de carga · @Model.SemanaTexto</h2>
                    <small>Incluye demanda de la semana y cantidades pendientes de semanas anteriores.</small>
                </div>
                <div class="section-actions">
                    <div class="legend">
                        <span><i class="dot dot-exp"></i>Expeditado</span>
                        <span><i class="dot dot-prog"></i>Programado</span>
                        <span><i class="dot dot-hab"></i>Día habitual</span>
                    </div>
                    @if (Model.ListaCargaSemanaID.HasValue && Model.SemanaAbierta)
                    {
                        <form method="post" asp-controller="LogisticaListaCarga" asp-action="GenerarEmbarques" style="margin:0" class="js-generar-form">
                            @Html.AntiForgeryToken()
                            <input type="hidden" name="ListaCargaSemanaID" value="@Model.ListaCargaSemanaID" />
                            <input type="hidden" name="Anio" value="@Model.Anio" />
                            <input type="hidden" name="NumeroSemana" value="@Model.NumeroSemana" />
                            <button type="submit" class="btn btn-success" @(Model.TieneProgramacionSinGenerar ? null : "disabled")>Generar embarques · @Model.TotalPendienteGenerar.ToString("N0") PZA</button>
                        </form>
                    }
                </div>
            </div>

            @if (Model.TotalSinProgramar > 0)
            {
                <div class="notice notice-info" style="margin:10px">
                    Hay <strong>@Model.TotalSinProgramar.ToString("N0") PZA</strong> pendientes de asignar a una fecha de carga. Las piezas no desaparecen aunque no se programen esta semana.
                </div>
            }

            @if (Model.Filas.Count == 0)
            {
                <div class="empty">No hay entregas pendientes para los criterios seleccionados.</div>
            }
            else
            {
                <div class="table-wrap">
                    <table class="matrix">
                        <thead>
                            <tr>
                                <th class="c-cliente">Cliente</th>
                                <th class="c-ref">Referencia</th>
                                <th class="c-desc">Designación</th>
                                <th class="c-total">Semana</th>
                                <th class="c-atraso">Atraso</th>
                                <th class="c-dia">Lun<br /><small>@Model.FechaInicio.ToString("dd/MM")</small></th>
                                <th class="c-dia">Mar<br /><small>@Model.FechaInicio.AddDays(1).ToString("dd/MM")</small></th>
                                <th class="c-dia">Mié<br /><small>@Model.FechaInicio.AddDays(2).ToString("dd/MM")</small></th>
                                <th class="c-dia">Jue<br /><small>@Model.FechaInicio.AddDays(3).ToString("dd/MM")</small></th>
                                <th class="c-dia">Vie<br /><small>@Model.FechaInicio.AddDays(4).ToString("dd/MM")</small></th>
                                <th class="c-dia">Sáb<br /><small>@Model.FechaInicio.AddDays(5).ToString("dd/MM")</small></th>
                                <th class="c-ubi">Ubicación</th>
                                <th class="c-total">Por atender</th>
                                <th class="c-programado">Programado</th>
                                <th class="c-enviado">Enviado</th>
                                <th class="c-action">Acción</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var fila in Model.Filas)
                            {
                                var porcentajeProgramadoCss = fila.PorcentajeProgramado.ToString("0.##", CultureInfo.InvariantCulture) + "%";
                                var porcentajeEnviadoCss = fila.PorcentajeEnviado.ToString("0.##", CultureInfo.InvariantCulture) + "%";
                                var fechaLunes = Model.FechaInicio.Date;
                                var fechaMartes = Model.FechaInicio.AddDays(1).Date;
                                var fechaMiercoles = Model.FechaInicio.AddDays(2).Date;
                                var fechaJueves = Model.FechaInicio.AddDays(3).Date;
                                var fechaViernes = Model.FechaInicio.AddDays(4).Date;
                                var fechaSabado = Model.FechaInicio.AddDays(5).Date;
                                var tieneGenerado = fila.TotalGeneradoEmbarques > 0;
                                var programacionesJson = JsonSerializer.Serialize(fila.Programaciones.Where(x => x.Activo && !string.Equals(x.Estatus, "Cancelada", StringComparison.OrdinalIgnoreCase)).Select(x => new
                                {
                                    fecha = x.FechaProgramadaCarga.ToString("yyyy-MM-dd"),
                                    cantidad = x.CantidadProgramada,
                                    observaciones = x.Observaciones ?? string.Empty,
                                    generado = x.CantidadGeneradaEmbarque,
                                    enviado = x.CantidadEnviada
                                }));
                                var diasJson = JsonSerializer.Serialize(fila.DiasHabituales.Select(x => x.DiaSemana).Distinct().OrderBy(x => x).ToList());
                                <tr class="@($"{(fila.EsExpeditado ? "row-exp" : "")} {(fila.TotalSinProgramar > 0 ? "row-pending" : "")}")">
                                    <td class="left">
                                        <div class="client">@fila.Cliente</div>
                                        <span class="status @(fila.EsExpeditado ? "status-exp" : "status-prog")">@fila.Criticidad</span>
                                        <span class="habitual">Habitual: @fila.DiasHabitualesTexto</span>
                                    </td>
                                    <td class="left"><span class="reference">@fila.Referencia</span></td>
                                    <td class="left"><span class="designation" title="@fila.Designacion">@fila.Designacion</span></td>
                                    <td class="num strong">@fila.TotalSemana.ToString("N0")</td>
                                    <td class="num @(fila.Atraso > 0 ? "late" : "muted")">@(fila.Atraso > 0 ? fila.Atraso.ToString("N0") : "-")</td>

                                    <td class="@(fila.EsDiaHabitual(fechaLunes) ? "day-habitual" : "")">
                                        <div class="day-cell">
                                            <span class="day-value">@(fila.Lunes > 0 ? fila.Lunes.ToString("N0") : "-")</span>
                                            @if (fila.RequeridoLunes > 0)
                                            {
                                                <span class="day-required">Req. @fila.RequeridoLunes.ToString("N0")</span>
                                            }
                                        </div>
                                    </td>
                                    <td class="@(fila.EsDiaHabitual(fechaMartes) ? "day-habitual" : "")">
                                        <div class="day-cell">
                                            <span class="day-value">@(fila.Martes > 0 ? fila.Martes.ToString("N0") : "-")</span>
                                            @if (fila.RequeridoMartes > 0)
                                            {
                                                <span class="day-required">Req. @fila.RequeridoMartes.ToString("N0")</span>
                                            }
                                        </div>
                                    </td>
                                    <td class="@(fila.EsDiaHabitual(fechaMiercoles) ? "day-habitual" : "")">
                                        <div class="day-cell">
                                            <span class="day-value">@(fila.Miercoles > 0 ? fila.Miercoles.ToString("N0") : "-")</span>
                                            @if (fila.RequeridoMiercoles > 0)
                                            {
                                                <span class="day-required">Req. @fila.RequeridoMiercoles.ToString("N0")</span>
                                            }
                                        </div>
                                    </td>
                                    <td class="@(fila.EsDiaHabitual(fechaJueves) ? "day-habitual" : "")">
                                        <div class="day-cell">
                                            <span class="day-value">@(fila.Jueves > 0 ? fila.Jueves.ToString("N0") : "-")</span>
                                            @if (fila.RequeridoJueves > 0)
                                            {
                                                <span class="day-required">Req. @fila.RequeridoJueves.ToString("N0")</span>
                                            }
                                        </div>
                                    </td>
                                    <td class="@(fila.EsDiaHabitual(fechaViernes) ? "day-habitual" : "")">
                                        <div class="day-cell">
                                            <span class="day-value">@(fila.Viernes > 0 ? fila.Viernes.ToString("N0") : "-")</span>
                                            @if (fila.RequeridoViernes > 0)
                                            {
                                                <span class="day-required">Req. @fila.RequeridoViernes.ToString("N0")</span>
                                            }
                                        </div>
                                    </td>
                                    <td class="@(fila.EsDiaHabitual(fechaSabado) ? "day-habitual" : "")">
                                        <div class="day-cell">
                                            <span class="day-value">@(fila.Sabado > 0 ? fila.Sabado.ToString("N0") : "-")</span>
                                            @if (fila.RequeridoSabado > 0)
                                            {
                                                <span class="day-required">Req. @fila.RequeridoSabado.ToString("N0")</span>
                                            }
                                        </div>
                                    </td>

                                    <td class="left">
                                        <div class="location">
                                            <strong>@fila.UbicacionTexto</strong>
                                            @if (fila.TieneMaterialLocalizado)
                                            {
                                                <small>
                                                    @if (fila.PiezasAlmacen > 0)
                                                    {
                                                        <span>ALM @fila.PiezasAlmacen.ToString("N0")</span>
                                                    }
                                                    @if (fila.PiezasProduccion > 0)
                                                    {
                                                        <span> · PROD @fila.PiezasProduccion.ToString("N0")</span>
                                                    }
                                                    @if (fila.PiezasGP12 > 0)
                                                    {
                                                        <span> · GP12 @fila.PiezasGP12.ToString("N0")</span>
                                                    }
                                                </small>
                                            }
                                        </div>
                                    </td>

                                    <td class="num strong">
                                        @fila.TotalPorAtender.ToString("N0")
                                        @if (fila.TotalSinProgramar > 0)
                                        {
                                            <span class="metric-detail" style="color:var(--warn)">Sin programar: @fila.TotalSinProgramar.ToString("N0")</span>
                                        }
                                    </td>
                                    <td class="num">
                                        <strong>@fila.TotalProgramado.ToString("N0")</strong>
                                        <div class="progress" title="@fila.PorcentajeProgramado.ToString("N2")% programado"><span style="width:@porcentajeProgramadoCss"></span></div>
                                        @if (fila.TotalPendienteGenerar > 0)
                                        {
                                            <span class="metric-detail">Por generar: @fila.TotalPendienteGenerar.ToString("N0")</span>
                                        }
                                        else if (fila.TotalProgramado > 0)
                                        {
                                            <span class="metric-detail" style="color:var(--ok)">Embarque generado</span>
                                        }
                                    </td>
                                    <td class="num sent">
                                        @fila.TotalEnviado.ToString("N0")
                                        <div class="progress progress-ok" title="@fila.PorcentajeEnviado.ToString("N2")% enviado"><span style="width:@porcentajeEnviadoCss"></span></div>
                                        @if (fila.TotalPendienteEnviar > 0)
                                        {
                                            <span class="metric-detail">Pendiente: @fila.TotalPendienteEnviar.ToString("N0")</span>
                                        }
                                    </td>
                                    <td>
                                        @if (Model.SemanaAbierta && Model.ListaCargaSemanaID.HasValue && fila.ClienteID.HasValue && fila.ParteID.HasValue)
                                        {
                                            if (tieneGenerado)
                                            {
                                                <button type="button" class="btn btn-sm disabled" disabled title="Ya existe un embarque generado para esta programación.">Generado</button>
                                            }
                                            else
                                            {
                                                <button type="button" class="btn btn-sm btn-primary js-programar"
                                                        data-cliente-id="@fila.ClienteID"
                                                        data-parte-id="@fila.ParteID"
                                                        data-cliente="@fila.Cliente"
                                                        data-referencia="@fila.Referencia"
                                                        data-designacion="@fila.Designacion"
                                                        data-total="@fila.TotalPorAtender"
                                                        data-programado="@fila.TotalProgramado"
                                                        data-sin-programar="@fila.TotalSinProgramar"
                                                        data-semana-inicio="@Model.FechaInicio.ToString("yyyy-MM-dd")"
                                                        data-semana-fin="@Model.FechaFin.ToString("yyyy-MM-dd")"
                                                        data-programaciones='@programacionesJson'
                                                        data-dias='@diasJson'>
                                                    Programar
                                                </button>
                                            }
                                            <button type="button" class="btn btn-sm js-ajuste"
                                                    data-cliente-id="@fila.ClienteID"
                                                    data-parte-id="@fila.ParteID"
                                                    data-cliente="@fila.Cliente"
                                                    data-referencia="@fila.Referencia"
                                                    data-ubicacion="@fila.Ubicacion"
                                                    data-observaciones="@fila.Observaciones">
                                                Ubicación
                                            </button>
                                        }
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
        </div>

        <div class="section">
            <div class="section-head">
                <div>
                    <h2>Salidas de la semana</h2>
                    <small>Viajes programados y realizados durante la semana.</small>
                </div>
                <span class="status status-prog">@Model.TotalSalidas salida(s)</span>
            </div>
            @if (Model.Salidas.Count == 0)
            {
                <div class="empty">No hay viajes registrados para esta semana con los criterios seleccionados.</div>
            }
            else
            {
                <div class="table-wrap">
                    <table class="agenda">
                        <thead>
                            <tr>
                                <th>Fecha</th>
                                <th>Lugar de envío</th>
                                <th>Chofer</th>
                                <th>Hora salida</th>
                                <th>Hora regreso</th>
                                <th>Tipo de salida</th>
                                <th>Criticidad</th>
                                <th>Unidad</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var salida in Model.Salidas)
                            {
                                <tr>
                                    <td>@salida.Fecha.ToString("dd/MM/yyyy")</td>
                                    <td><a asp-controller="LogisticaViajes" asp-action="Detalle" asp-route-id="@salida.ViajeID">@salida.LugarEnvio</a></td>
                                    <td>@(string.IsNullOrWhiteSpace(salida.Chofer) ? "-" : salida.Chofer)</td>
                                    <td>@salida.HoraSalidaTexto</td>
                                    <td>@salida.HoraRegresoTexto</td>
                                    <td>@(string.IsNullOrWhiteSpace(salida.TipoSalida) ? "-" : salida.TipoSalida)</td>
                                    <td><span class="status @(salida.EsExpeditada ? "status-exp" : "status-prog")">@salida.Criticidad</span></td>
                                    <td>@(string.IsNullOrWhiteSpace(salida.Unidad) ? "-" : salida.Unidad)</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
        </div>
    </div>

    @if (Model.ListaCargaSemanaID.HasValue)
    {
        <div id="programarBackdrop" class="dialog-backdrop" aria-hidden="true">
            <div class="dialog" role="dialog" aria-modal="true">
                <form method="post" asp-controller="LogisticaListaCarga" asp-action="GuardarProgramacion" id="formProgramacion">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="ListaCargaSemanaID" value="@Model.ListaCargaSemanaID" />
                    <input type="hidden" name="ClienteID" id="prClienteID" />
                    <input type="hidden" name="ParteID" id="prParteID" />
                    <input type="hidden" name="Anio" value="@Model.Anio" />
                    <input type="hidden" name="NumeroSemana" value="@Model.NumeroSemana" />
                    <div class="dialog-head">
                        <div>
                            <h3 id="prTitulo">Programar carga</h3>
                            <small id="prSubtitulo"></small>
                        </div>
                        <button type="button" class="x js-cerrar-programacion" aria-label="Cerrar">×</button>
                    </div>
                    <div class="dialog-body">
                        <div class="program-summary">
                            <div><span>Por atender</span><strong id="prTotal">0</strong></div>
                            <div><span>Programado</span><strong id="prProgramado">0</strong></div>
                            <div><span>Sin programar</span><strong id="prPendiente">0</strong></div>
                            <div><span>Día habitual</span><strong id="prHabitual" style="font-size:12px">-</strong></div>
                        </div>
                        <div class="warning-box">
                            La fecha representa el día en que el material se cargará o saldrá de planta. Puede programarse aunque todavía no exista suficiente material disponible en PT.
                        </div>
                        <table class="program-table">
                            <thead>
                                <tr>
                                    <th class="col-date">Fecha de carga</th>
                                    <th class="col-qty">Cantidad</th>
                                    <th>Observaciones</th>
                                    <th class="col-delete"></th>
                                </tr>
                            </thead>
                            <tbody id="programacionFilas"></tbody>
                        </table>
                        <div class="program-footer">
                            <button type="button" class="btn btn-sm" id="btnAgregarProgramacion">+ Dividir entrega</button>
                            <div class="program-total">Total capturado: <strong id="prCapturado">0</strong> PZA</div>
                        </div>
                        <p class="hint">El día habitual del cliente es únicamente una referencia. Si seleccionas otra fecha aparecerá una advertencia, pero el sistema permitirá guardarla.</p>
                    </div>
                    <div class="dialog-foot">
                        <button type="button" class="btn js-cerrar-programacion">Cancelar</button>
                        <button type="submit" class="btn btn-primary">Guardar programación</button>
                    </div>
                </form>
            </div>
        </div>

        <div id="ajusteBackdrop" class="dialog-backdrop" aria-hidden="true">
            <div class="dialog dialog-sm" role="dialog" aria-modal="true">
                <form method="post" asp-controller="LogisticaListaCarga" asp-action="GuardarAjuste">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="ListaCargaSemanaID" value="@Model.ListaCargaSemanaID" />
                    <input type="hidden" name="ClienteID" id="ajClienteID" />
                    <input type="hidden" name="ParteID" id="ajParteID" />
                    <input type="hidden" name="anio" value="@Model.Anio" />
                    <input type="hidden" name="semana" value="@Model.NumeroSemana" />
                    <div class="dialog-head">
                        <div>
                            <h3>Ubicación y observaciones</h3>
                            <small id="ajusteSubtitulo"></small>
                        </div>
                        <button type="button" class="x js-cerrar-ajuste" aria-label="Cerrar">×</button>
                    </div>
                    <div class="dialog-body">
                        <div class="dialog-grid">
                            <div class="field full">
                                <label>Ubicación manual</label>
                                <input type="text" name="UbicacionManual" id="ajUbicacion" maxlength="100" placeholder="Ej. PRODUCCION Y GP12" />
                            </div>
                            <div class="field full">
                                <label>Observaciones</label>
                                <textarea name="Observaciones" id="ajObservaciones" maxlength="1000" rows="4" placeholder="Comentario operativo..."></textarea>
                            </div>
                        </div>
                        <p class="hint">La ubicación indica dónde se encuentran actualmente las piezas inyectadas. La captura manual tendrá prioridad visual sobre la ubicación detectada automáticamente.</p>
                    </div>
                    <div class="dialog-foot">
                        <button type="button" class="btn js-cerrar-ajuste">Cancelar</button>
                        <button type="submit" class="btn btn-primary">Guardar</button>
                    </div>
                </form>
            </div>
        </div>
    }

    <script>
        (function(){
            const nombresDias={1:'Lunes',2:'Martes',3:'Miércoles',4:'Jueves',5:'Viernes',6:'Sábado',7:'Domingo'};
            const formatoNumero=n=>Number(n||0).toLocaleString('es-MX');
            const programarBackdrop=document.getElementById('programarBackdrop');
            const filas=document.getElementById('programacionFilas');
            const btnAgregar=document.getElementById('btnAgregarProgramacion');
            const prClienteID=document.getElementById('prClienteID');
            const prParteID=document.getElementById('prParteID');
            const prTitulo=document.getElementById('prTitulo');
            const prSubtitulo=document.getElementById('prSubtitulo');
            const prTotal=document.getElementById('prTotal');
            const prProgramado=document.getElementById('prProgramado');
            const prPendiente=document.getElementById('prPendiente');
            const prHabitual=document.getElementById('prHabitual');
            const prCapturado=document.getElementById('prCapturado');
            let diasHabituales=[];
            let inicioSemana='';
            function diaSemana(fechaTexto){
                if(!fechaTexto)return 0;
                const partes=fechaTexto.split('-').map(Number);
                if(partes.length!==3)return 0;
                const fecha=new Date(partes[0],partes[1]-1,partes[2]);
                const js=fecha.getDay();
                return js===0?7:js;
            }
            function fechaSugerida(){
                if(!inicioSemana)return '';
                const p=inicioSemana.split('-').map(Number);
                const inicio=new Date(p[0],p[1]-1,p[2]);
                if(!diasHabituales.length)return inicioSemana;
                const dia=Math.min(...diasHabituales);
                const f=new Date(inicio);
                f.setDate(inicio.getDate()+Math.max(0,dia-1));
                const y=f.getFullYear();
                const m=String(f.getMonth()+1).padStart(2,'0');
                const d=String(f.getDate()).padStart(2,'0');
                return `${y}-${m}-${d}`;
            }
            function advertenciaFila(tr){
                const fecha=tr.querySelector('.js-fecha-programacion');
                const warning=tr.querySelector('.program-warning');
                if(!fecha||!warning)return;
                if(!fecha.value||!diasHabituales.length){warning.classList.remove('show');warning.textContent='';return;}
                const dia=diaSemana(fecha.value);
                if(diasHabituales.includes(dia)){warning.classList.remove('show');warning.textContent='';return;}
                const habitual=diasHabituales.map(x=>nombresDias[x]||'').filter(Boolean).join(' / ');
                warning.textContent='⚠ Día distinto al habitual: '+habitual+'. Se permite guardar.';
                warning.classList.add('show');
            }
            function actualizarIndices(){
                [...filas.querySelectorAll('tr')].forEach((tr,i)=>{
                    tr.querySelector('.js-fecha-programacion').name=`Programaciones[${i}].FechaProgramadaCarga`;
                    tr.querySelector('.js-cantidad-programacion').name=`Programaciones[${i}].Cantidad`;
                    tr.querySelector('.js-observaciones-programacion').name=`Programaciones[${i}].Observaciones`;
                });
                actualizarTotal();
            }
            function actualizarTotal(){
                let total=0;
                filas.querySelectorAll('.js-cantidad-programacion').forEach(x=>total+=Number(x.value||0));
                if(prCapturado)prCapturado.textContent=formatoNumero(total);
            }
            function agregarFila(fecha='',cantidad='',observaciones=''){
                const tr=document.createElement('tr');
                tr.innerHTML=`
                    <td>
                        <input type="date" class="js-fecha-programacion" required />
                        <div class="program-warning"></div>
                    </td>
                    <td><input type="number" class="js-cantidad-programacion" min="1" step="1" required /></td>
                    <td><input type="text" class="js-observaciones-programacion" maxlength="1000" placeholder="Opcional" /></td>
                    <td><button type="button" class="btn btn-sm btn-danger js-eliminar-programacion" title="Eliminar">×</button></td>`;
                filas.appendChild(tr);
                tr.querySelector('.js-fecha-programacion').value=fecha||fechaSugerida();
                tr.querySelector('.js-cantidad-programacion').value=cantidad||'';
                tr.querySelector('.js-observaciones-programacion').value=observaciones||'';
                tr.querySelector('.js-fecha-programacion').addEventListener('change',()=>advertenciaFila(tr));
                tr.querySelector('.js-cantidad-programacion').addEventListener('input',actualizarTotal);
                tr.querySelector('.js-eliminar-programacion').addEventListener('click',()=>{
                    tr.remove();
                    if(!filas.querySelector('tr'))agregarFila(fechaSugerida(),'','');
                    actualizarIndices();
                });
                advertenciaFila(tr);
                actualizarIndices();
            }
            function abrirProgramacion(btn){
                prClienteID.value=btn.dataset.clienteId||'';
                prParteID.value=btn.dataset.parteId||'';
                prTitulo.textContent='Programar carga · '+(btn.dataset.cliente||'');
                prSubtitulo.textContent=(btn.dataset.referencia||'')+(btn.dataset.designacion?' · '+btn.dataset.designacion:'');
                prTotal.textContent=formatoNumero(btn.dataset.total);
                prProgramado.textContent=formatoNumero(btn.dataset.programado);
                prPendiente.textContent=formatoNumero(btn.dataset.sinProgramar);
                inicioSemana=btn.dataset.semanaInicio||'';
                try{diasHabituales=JSON.parse(btn.dataset.dias||'[]').map(Number);}catch{diasHabituales=[];}
                prHabitual.textContent=diasHabituales.length?diasHabituales.map(x=>nombresDias[x]||'').filter(Boolean).join(' / '):'Sin definir';
                filas.innerHTML='';
                let existentes=[];
                try{existentes=JSON.parse(btn.dataset.programaciones||'[]');}catch{existentes=[];}
                existentes=existentes.filter(x=>Number(x.generado||0)<=0);
                if(existentes.length){
                    existentes.forEach(x=>agregarFila(x.fecha||'',x.cantidad||'',x.observaciones||''));
                }else{
                    const cantidad=Number(btn.dataset.sinProgramar||btn.dataset.total||0);
                    agregarFila(fechaSugerida(),cantidad>0?cantidad:'','');
                }
                programarBackdrop.classList.add('open');
                programarBackdrop.setAttribute('aria-hidden','false');
            }
            function cerrarProgramacion(){
                if(!programarBackdrop)return;
                programarBackdrop.classList.remove('open');
                programarBackdrop.setAttribute('aria-hidden','true');
            }
            document.querySelectorAll('.js-programar').forEach(btn=>btn.addEventListener('click',()=>abrirProgramacion(btn)));
            document.querySelectorAll('.js-cerrar-programacion').forEach(btn=>btn.addEventListener('click',cerrarProgramacion));
            if(btnAgregar)btnAgregar.addEventListener('click',()=>agregarFila(fechaSugerida(),'',''));
            if(programarBackdrop)programarBackdrop.addEventListener('click',e=>{if(e.target===programarBackdrop)cerrarProgramacion();});

            const ajusteBackdrop=document.getElementById('ajusteBackdrop');
            const ajClienteID=document.getElementById('ajClienteID');
            const ajParteID=document.getElementById('ajParteID');
            const ajUbicacion=document.getElementById('ajUbicacion');
            const ajObservaciones=document.getElementById('ajObservaciones');
            const ajusteSubtitulo=document.getElementById('ajusteSubtitulo');
            function abrirAjuste(btn){
                ajClienteID.value=btn.dataset.clienteId||'';
                ajParteID.value=btn.dataset.parteId||'';
                ajUbicacion.value=btn.dataset.ubicacion||'';
                ajObservaciones.value=btn.dataset.observaciones||'';
                ajusteSubtitulo.textContent=(btn.dataset.cliente||'')+' · '+(btn.dataset.referencia||'');
                ajusteBackdrop.classList.add('open');
                ajusteBackdrop.setAttribute('aria-hidden','false');
                setTimeout(()=>ajUbicacion.focus(),50);
            }
            function cerrarAjuste(){
                if(!ajusteBackdrop)return;
                ajusteBackdrop.classList.remove('open');
                ajusteBackdrop.setAttribute('aria-hidden','true');
            }
            document.querySelectorAll('.js-ajuste').forEach(btn=>btn.addEventListener('click',()=>abrirAjuste(btn)));
            document.querySelectorAll('.js-cerrar-ajuste').forEach(btn=>btn.addEventListener('click',cerrarAjuste));
            if(ajusteBackdrop)ajusteBackdrop.addEventListener('click',e=>{if(e.target===ajusteBackdrop)cerrarAjuste();});

            document.querySelectorAll('.js-generar-form').forEach(form=>{
                form.addEventListener('submit',e=>{
                    if(!confirm('¿Generar los embarques pendientes de esta programación? La modalidad de salida se definirá posteriormente en cada embarque.'))e.preventDefault();
                    else{
                        const btn=form.querySelector('button[type="submit"]');
                        if(btn){btn.disabled=true;btn.textContent='Generando...';}
                    }
                });
            });

            const formProgramacion=document.getElementById('formProgramacion');
            if(formProgramacion){
                formProgramacion.addEventListener('submit',e=>{
                    actualizarIndices();
                    const registros=[...filas.querySelectorAll('tr')];
                    if(!registros.length){e.preventDefault();alert('Captura al menos una fecha de programación.');return;}
                    let total=0;
                    let invalido=false;
                    registros.forEach(tr=>{
                        const fecha=tr.querySelector('.js-fecha-programacion').value;
                        const cantidad=Number(tr.querySelector('.js-cantidad-programacion').value||0);
                        if(!fecha||cantidad<=0)invalido=true;
                        total+=cantidad;
                    });
                    if(invalido){e.preventDefault();alert('Todas las filas deben tener fecha y una cantidad mayor a cero.');return;}
                    if(total<=0){e.preventDefault();alert('La cantidad programada debe ser mayor a cero.');return;}
                    const btn=formProgramacion.querySelector('button[type="submit"]');
                    if(btn){btn.disabled=true;btn.textContent='Guardando...';}
                });
            }

            document.addEventListener('keydown',e=>{
                if(e.key!=='Escape')return;
                cerrarProgramacion();
                cerrarAjuste();
            });
        })();
    </script>
</body>
</html>