            display: flex;
            align-items: center;
            justify-content: space-between;
            gap: 8px;
            padding: 6px 8px;
            border-top: 1px solid #e1e7ef;
            background: #fbfcfe
        }

            .shipment-group-foot small {
                font-size: 7px;
                color: var(--muted);
