@model ERP.NSQuell.Models.PlaneacionCalendarioMaquinasVm
@using System.Globalization

@functions {
    public static string Pct(double value)
    {
        return value.ToString("0.####", CultureInfo.InvariantCulture);
    }

    public static string ClaseVista(string vistaActual, string vista)
    {
        return string.Equals(vistaActual, vista, StringComparison.OrdinalIgnoreCase)
            ? "btn btn-primary fw-bold"
            : "btn btn-outline-primary fw-bold";
    }

    public static string BadgeProduccion(int? estatusProduccionId)
    {
        if (estatusProduccionId.HasValue)
        {
            switch (estatusProduccionId.Value)
            {
                case 1: return "badge bg-secondary";
                case 2: return "badge bg-info text-dark";
                case 3: return "badge bg-warning text-dark";
                case 4: return "badge bg-danger";
                case 5: return "badge bg-primary";
                case 6: return "badge bg-success";
                case 9: return "badge bg-dark";
                case 99: return "badge bg-secondary";
            }
        }

        return "badge bg-light text-dark border";
    }

    public static string TextoProduccion(int? estatusProduccionId, string estatusProduccionNombre)
    {
        if (!string.IsNullOrWhiteSpace(estatusProduccionNombre))
            return estatusProduccionNombre;

        if (estatusProduccionId.HasValue)
        {
            switch (estatusProduccionId.Value)
            {
                case 1: return "Pendiente";
                case 2: return "En preparación";
                case 3: return "En producción";
                case 4: return "Pausado";
                case 5: return "Terminado parcial";
                case 6: return "Terminado";
                case 9: return "Cerrado";
                case 99: return "Cancelado";
            }
        }

        return "Sin ejecución";
    }

    public static string TextoPeriodoAnterior(ERP.NSQuell.Models.PlaneacionCalendarioMaquinasVm model)
    {
        if (model.EsVistaDia) return "Día anterior";
        if (model.EsVistaMes) return "Mes anterior";
        if (model.EsVistaRango) return "Rango anterior";
        return "Semana anterior";
    }

    public static string TextoPeriodoSiguiente(ERP.NSQuell.Models.PlaneacionCalendarioMaquinasVm model)
    {
        if (model.EsVistaDia) return "Día siguiente";
        if (model.EsVistaMes) return "Mes siguiente";
        if (model.EsVistaRango) return "Rango siguiente";
        return "Semana siguiente";
    }
}

@{
    Layout = "~/Views/Shared/_Layout.cshtml";
    ViewData["Title"] = "Calendario de mÃ¡quinas | PlaneaciÃ³n";
    var cultura = new CultureInfo("es-MX");

    // NSQ_PRODUCCION_CALENDARIO_VIEW_V1
    var modoProduccion = ViewBag.ModoProduccion is bool modo && modo;

    if (modoProduccion)
    {
        ViewData["Title"] = "Calendario de Producci\u00F3n";
    }

    var inicioPeriodo = Model.InicioPeriodo;
    var finPeriodo = Model.FinPeriodo;

    if (finPeriodo <= inicioPeriodo)
    {
        finPeriodo = inicioPeriodo.AddDays(7);
    }

    var totalMinutos = Math.Max(1, (finPeriodo - inicioPeriodo).TotalMinutes);
    var totalDias = Math.Max(1, Model.TotalDiasPeriodo);

    var ahoraVisible =
        Model.Ahora >= inicioPeriodo &&
        Model.Ahora < finPeriodo;

    var ahoraLeft = ahoraVisible
        ? (Model.Ahora - inicioPeriodo).TotalMinutes / totalMinutos * 100
        : 0;

    var periodoAnterior = Model.PeriodoAnterior;
    var periodoSiguiente = Model.PeriodoSiguiente;

    var rangoFinVisible = Model.RangoFin.HasValue
        ? Model.RangoFin.Value.ToString("yyyy-MM-dd")
        : Model.FinPeriodo.AddDays(-1).ToString("yyyy-MM-dd");

    var rangoInicioVisible = Model.RangoInicio.HasValue
        ? Model.RangoInicio.Value.ToString("yyyy-MM-dd")
        : Model.InicioPeriodo.ToString("yyyy-MM-dd");

    Func<DateTime, string> UrlPeriodo = fecha =>
    {
        if (Model.EsVistaRango)
        {
            var finRango = fecha.AddDays(totalDias - 1).ToString("yyyy-MM-dd");

            if (modoProduccion)
            {
                return Url.RouteUrl("ProduccionCalendario", new
                {
                    vista = "rango",
                    rangoInicio = fecha.ToString("yyyy-MM-dd"),
                    rangoFin = finRango
                }) ?? "#";
            }

            return Url.Action("Index", "PlaneacionCalendarioMaquinas", new
            {
                vista = "rango",
                rangoInicio = fecha.ToString("yyyy-MM-dd"),
                rangoFin = finRango
            }) ?? "#";
        }

        if (modoProduccion)
        {
            return Url.RouteUrl("ProduccionCalendario", new
            {
                vista = Model.VistaNormalizada,
                fecha = fecha.ToString("yyyy-MM-dd")
            }) ?? "#";
        }

        return Url.Action("Index", "PlaneacionCalendarioMaquinas", new
        {
            vista = Model.VistaNormalizada,
            fecha = fecha.ToString("yyyy-MM-dd")
        }) ?? "#";
    };

    var solicitudesReprogramacion =
        ViewBag.SolicitudesReprogramacion as List<ERP.NSQuell.Controllers.SolicitudReprogramacionCalendarioVm>
        ?? new List<ERP.NSQuell.Controllers.SolicitudReprogramacionCalendarioVm>();

    var totalSolicitudesReprogramacion = solicitudesReprogramacion.Count;
    var hayInterrupcionesActivas = ViewBag.HayInterrupcionesActivas is bool hay && hay;
    var totalInterrupcionesActivas = ViewBag.TotalInterrupcionesActivas is int totalInterrupciones ? totalInterrupciones : 0;
    var fechaCalculoProyeccion = ViewBag.FechaCalculoProyeccion is DateTime fechaCalculo ? fechaCalculo : Model.Ahora;


}

@section Scripts {
    <script>
        const search = document.getElementById('calendarSearch');
        const statusBox = document.getElementById('calendarStatus');
        const token = document.querySelector('input[name="__RequestVerificationToken"]')?.value || '';
        const modoProduccion = @(modoProduccion ? "true" : "false");
        const trabajarDomingoCalendario = document.getElementById('trabajarDomingoCalendario');
        const calendarKiosk = document.getElementById('calendarKiosk');
        const btnPantallaCompletaCalendario = document.getElementById('btnPantallaCompletaCalendario');
        const btnCompactarCalendario = document.getElementById('btnCompactarCalendario');
        const timelineScroll = calendarKiosk?.querySelector('.timeline-scroll');
        const timelineElement = calendarKiosk?.querySelector('.timeline');
        const fitScaleLabel = document.getElementById('fitScaleLabel');

        const inicioPeriodo = new Date('@inicioPeriodo.ToString("yyyy-MM-ddTHH:mm:ss")');
        const finPeriodo = new Date('@finPeriodo.ToString("yyyy-MM-ddTHH:mm:ss")');
        const totalMinutosPeriodo = (finPeriodo - inicioPeriodo) / 60000;

        let draggedBlock = null;
        let dragStarted = false;
        let suppressClickUntil = 0;
        let payloadPendienteConfirmacion = null;

        let maquinasCompatiblesActuales = new Set();
        let cargandoCompatibles = false;


        function calendarioEnPantallaCompleta() {
            return document.fullscreenElement === calendarKiosk ||
                   calendarKiosk?.classList.contains('fullscreen-fallback');
        }


                function ajustarCalendarioAlViewport() {
            if (!calendarKiosk ||
                !timelineScroll ||
                !timelineElement) {
                return;
            }


            timelineElement.style.transform = '';
            timelineElement.style.width = '100%';
            timelineElement.style.height = 'auto';

            calendarKiosk.classList.remove('fit-screen');

            if (!calendarioEnPantallaCompleta()) {
                timelineScroll.style.overflowX = 'auto';
                timelineScroll.style.overflowY = 'auto';

                if (fitScaleLabel) {
                    fitScaleLabel.textContent = '';
                }

                return;
            }

           
            timelineScroll.style.overflowX = 'auto';
            timelineScroll.style.overflowY = 'auto';

          
            calendarKiosk.classList.add('kiosk-compact');

            if (btnCompactarCalendario) {
                btnCompactarCalendario.classList.add('is-active');

                const icono =
                    btnCompactarCalendario.querySelector('i');

                const texto =
                    btnCompactarCalendario.querySelector('span');

                if (icono) {
                    icono.className =
                        'fa-solid fa-up-right-and-down-left-from-center';
                }

                if (texto) {
                    texto.textContent = 'Vista normal';
                }
            }

            if (fitScaleLabel) {
                fitScaleLabel.textContent =
                    'Vista nítida 100%';
            }
        }


        function actualizarBotonPantallaCompleta() {
            if (!btnPantallaCompletaCalendario || !calendarKiosk) return;

            const activo = calendarioEnPantallaCompleta();
            const icono = btnPantallaCompletaCalendario.querySelector('i');
            const etiqueta = btnPantallaCompletaCalendario.querySelector('.fullscreen-label');

            btnPantallaCompletaCalendario.classList.toggle('is-active', activo);

            if (icono) {
                icono.className = activo
                    ? 'fa-solid fa-compress'
                    : 'fa-solid fa-expand';
            }

            if (etiqueta) {
                etiqueta.textContent = activo
                    ? 'Salir de pantalla completa'
                    : 'Pantalla completa';
            }
        }

        async function alternarPantallaCompletaCalendario() {
            if (!calendarKiosk) return;

            try {
                if (document.fullscreenEnabled) {
                    if (document.fullscreenElement) {
                        await document.exitFullscreen();
                    } else {
                        await calendarKiosk.requestFullscreen({ navigationUI: 'hide' });
                    }
                } else {
                    const activo = calendarKiosk.classList.toggle('fullscreen-fallback');
                    document.body.classList.toggle('fullscreen-fallback-active', activo);
                    actualizarBotonPantallaCompleta();
                }
            } catch (error) {
                const activo = calendarKiosk.classList.toggle('fullscreen-fallback');
                document.body.classList.toggle('fullscreen-fallback-active', activo);
                actualizarBotonPantallaCompleta();
            }
        }

        function alternarModoCompacto() {
            if (!calendarKiosk || !btnCompactarCalendario) return;

            const activo = calendarKiosk.classList.toggle('kiosk-compact');
            btnCompactarCalendario.classList.toggle('is-active', activo);

            const icono = btnCompactarCalendario.querySelector('i');
            const texto = btnCompactarCalendario.querySelector('span');

            if (icono) {
                icono.className = activo
                    ? 'fa-solid fa-up-right-and-down-left-from-center'
                    : 'fa-solid fa-compress';
            }

            if (texto) {
                texto.textContent = activo ? 'Vista normal' : 'Compactar';
            }

            try {
                localStorage.setItem('planeacionCalendarioCompacto', activo ? '1' : '0');
            } catch { }

            setTimeout(ajustarCalendarioAlViewport, 30);
        }

        function restaurarPreferenciasCalendario() {
            if (!calendarKiosk || !btnCompactarCalendario) return;

            try {
                const compacto = localStorage.getItem('planeacionCalendarioCompacto') === '1';

                if (compacto) {
                    calendarKiosk.classList.add('kiosk-compact');
                    btnCompactarCalendario.classList.add('is-active');

                    const icono = btnCompactarCalendario.querySelector('i');
                    const texto = btnCompactarCalendario.querySelector('span');

                    if (icono) icono.className = 'fa-solid fa-up-right-and-down-left-from-center';
                    if (texto) texto.textContent = 'Vista normal';
                }
            } catch { }
        }

        function setStatus(message, type) {
            if (!statusBox) return;

            statusBox.className = `calendar-status ${type || ''}`.trim();
            statusBox.textContent = message;
        }

        function mostrarModalCalendario(titulo, mensaje) {
            document.getElementById('modalCalendarioMensajeTitulo').textContent =
                titulo || 'Movimiento no permitido';

            document.getElementById('modalCalendarioMensajeTexto').textContent =
                mensaje || 'No fue posible realizar el movimiento.';

            const modalElement = document.getElementById('modalCalendarioMensaje');
            const modal = bootstrap.Modal.getOrCreateInstance(modalElement);

            modal.show();
        }

        function localIso(value) {
            const pad = number => String(number).padStart(2, '0');

            return `${value.getFullYear()}-${pad(value.getMonth() + 1)}-${pad(value.getDate())}T${pad(value.getHours())}:${pad(value.getMinutes())}:00`;
        }

        function snapToMinutes(date, minutes) {
            const ms = minutes * 60 * 1000;
            return new Date(Math.round(date.getTime() / ms) * ms);
        }

        function getDropDate(track, event) {
            const rect = track.getBoundingClientRect();
            const x = Math.max(0, Math.min(event.clientX - rect.left, rect.width));
            const porcentaje = x / rect.width;
            const minutos = porcentaje * totalMinutosPeriodo;

            const fecha = new Date(inicioPeriodo.getTime() + minutos * 60000);
            // Se ajusta a 60 minutos: los movimientos de Planeación se realizan por hora.
            return snapToMinutes(fecha, 60); // NSQ_DROP_HORA_EXACTA_V40
        }

        function puedeArrastrar(block) {
            return !modoProduccion && block.dataset.puedeMover === 'true'; // NSQ_MES_DRAG_V1
        }


        function limpiarMaquinasCompatibles() {
            maquinasCompatiblesActuales = new Set();
            document.body.classList.remove('drag-compatible-mode');

            document.querySelectorAll('.track.compatible-target, .track.incompatible-target, .track.drag-over').forEach(track => {
                track.classList.remove('compatible-target', 'incompatible-target', 'drag-over');
            });

            document.querySelectorAll('.calendar-machine-row.compatible-row, .calendar-machine-row.incompatible-row').forEach(row => {
                row.classList.remove('compatible-row', 'incompatible-row');
            });
        }

        function aplicarMaquinasCompatibles(maquinas) {
            limpiarMaquinasCompatibles();

            maquinasCompatiblesActuales = new Set(
                (maquinas || [])
                    .map(x => Number(x.maquinaID || x.maquinaId || x.MaquinaID || 0))
                    .filter(x => Number.isFinite(x) && x > 0)
            );

            if (!maquinasCompatiblesActuales.size) {
                setStatus('No se encontraron máquinas compatibles para este programa.', 'error');
                return;
            }

            document.body.classList.add('drag-compatible-mode');

            document.querySelectorAll('.track').forEach(track => {
                const maquinaId = Number(track.dataset.maquinaId || 0);
                const row = track.closest('.calendar-machine-row');

                if (maquinasCompatiblesActuales.has(maquinaId)) {
                    track.classList.add('compatible-target');
                    row?.classList.add('compatible-row');
                } else {
                    track.classList.add('incompatible-target');
                    row?.classList.add('incompatible-row');
                }
            });
        }

        async function cargarMaquinasCompatibles(programaId) {
            if (!programaId || cargandoCompatibles) return;

            try {
                cargandoCompatibles = true;

                       const urlMaquinasCompatibles =
            '@Url.Action("MaquinasCompatibles", "PlaneacionCalendarioMaquinas")' +
            '?programaProduccionId=' +
            encodeURIComponent(programaId);

        const response = await fetch(urlMaquinasCompatibles, {
                    method: 'GET',
                    headers: { 'Accept': 'application/json' }
                });

                if (!response.ok) {
                    throw new Error(`HTTP ${response.status}`);
                }

                const result = await response.json();

                if (!result.ok) {
                    limpiarMaquinasCompatibles();
                    setStatus(result.mensaje || 'No se pudieron consultar máquinas compatibles.', 'error');
                    return;
                }

                aplicarMaquinasCompatibles(result.maquinas || []);

                if ((result.maquinas || []).length > 0) {
                    setStatus('Máquinas compatibles resaltadas en verde. Suelta el bloque solo sobre una máquina habilitada.', 'working');
                }
            }
            catch (error) {
                limpiarMaquinasCompatibles();
                setStatus('Error al consultar máquinas compatibles: ' + error.message, 'error');
            }
            finally {
                cargandoCompatibles = false;
            }
        }

               function destinoCompatible(track) {
            const maquinaId = Number(track.dataset.maquinaId || 0);

            if (!draggedBlock) {
                return false;
            }

            if (!maquinasCompatiblesActuales.size) {
                return false;
            }

            return maquinasCompatiblesActuales.has(maquinaId);
        }

        function abrirModalConfirmacionMovimiento(result, payload) {
            payloadPendienteConfirmacion = {
                ...payload,
                confirmarMovimiento: true
            };

            document.getElementById('confirmarMaquinaDestino').textContent =
                `${result.maquinaCodigo || '-'} ${result.maquinaNombre || ''}`.trim();

            document.getElementById('confirmarHoras').textContent =
                `${result.horasProgramadas || 0} h`;

            document.getElementById('confirmarCambio').textContent =
                result.cambioTexto || '-';

            document.getElementById('confirmarArranque').textContent =
                result.arranqueTexto || '-';

            document.getElementById('confirmarFin').textContent =
                result.finTexto || '-';

            document.getElementById('confirmarMotivo').textContent =
                result.resumen || result.motivo || 'El movimiento será aplicado.';

            const modalElement = document.getElementById('modalConfirmarMovimientoCalendario');
            const modal = bootstrap.Modal.getOrCreateInstance(modalElement);

            modal.show();
        }

        async function aplicarMovimientoConfirmado() {
            if (!payloadPendienteConfirmacion) {
                mostrarModalCalendario(
                    'Movimiento no disponible',
                    'No hay un movimiento pendiente por confirmar.'
                );
                return;
            }

            const btn = document.getElementById('btnConfirmarMovimientoCalendario');

            try {
                btn.disabled = true;
                btn.textContent = 'Aplicando...';

                setStatus('Aplicando movimiento confirmado...', 'working');

        const response = await fetch('@Url.Action("ReprogramarCalendario", "PlaneacionCalendarioMaquinas")', {
                    method: 'POST',
                    headers: {
                        'Content-Type': 'application/json',
                        'RequestVerificationToken': token
                    },
                    body: JSON.stringify(payloadPendienteConfirmacion)
                });

                if (!response.ok) {
                    throw new Error(`HTTP ${response.status}`);
                }

                const result = await response.json();

                if (!result.ok) {
                    const mensaje = result.mensaje || 'No fue posible aplicar el movimiento.';
                    setStatus(mensaje, 'error');
                    mostrarModalCalendario('No se pudo mover el programa', mensaje);
                    return;
                }

                const modalElement = document.getElementById('modalConfirmarMovimientoCalendario');
                const modal = bootstrap.Modal.getOrCreateInstance(modalElement);
                modal.hide();

                payloadPendienteConfirmacion = null;

                setStatus(result.mensaje || 'Programa actualizado correctamente.', 'success');

                setTimeout(() => {
                    window.location.reload();
                }, 650);
            }
            catch (error) {
                const mensaje = 'Error al aplicar el movimiento: ' + error.message;

                setStatus(mensaje, 'error');
                mostrarModalCalendario('Error al guardar', mensaje);
            }
            finally {
                btn.disabled = false;
                btn.textContent = 'Sí, aplicar movimiento';
            }
        }

        function limpiarResaltadoSolicitudReprogramacion() {
            document.querySelectorAll('.block.reprogram-request-focus').forEach(x => {
                x.classList.remove('reprogram-request-focus');
            });
        }

        function atenderSolicitudEnCalendario(programaId, urlPrograma) {
            const programa = Number(programaId || 0);

            if (!Number.isFinite(programa) || programa <= 0) {
                mostrarModalCalendario(
                    'Solicitud no disponible',
                    'No se pudo identificar el programa solicitado.'
                );
                return;
            }

            const modalElement = document.getElementById('modalSolicitudesReprogramacion');
            const modal = modalElement ? bootstrap.Modal.getInstance(modalElement) : null;
            modal?.hide();
            limpiarResaltadoSolicitudReprogramacion();

            const bloque = document.querySelector(`.block[data-programa-id="${programa}"]`);

            if (!bloque) {
                if (urlPrograma) {
                    window.location.href = urlPrograma;
                    return;
                }

                mostrarModalCalendario(
                    'Programa fuera del periodo',
                    'El programa solicitado no está visible en el periodo actual del calendario.'
                );
                return;
            }

            bloque.classList.add('reprogram-request-focus');
            bloque.scrollIntoView({ behavior: 'smooth', block: 'center', inline: 'center' });
            setStatus(
                `Solicitud de reprogramación localizada. Programa ${programa} resaltado; arrástralo a la nueva posición o máquina compatible.`,
                'working'
            );

            setTimeout(() => {
                bloque.classList.remove('reprogram-request-focus');
            }, 7000);
        }

        document.querySelectorAll('.btn-atender-reprogramacion').forEach(btn => {
            btn.addEventListener('click', () => {
                atenderSolicitudEnCalendario(
                    btn.dataset.programaId,
                    btn.dataset.urlPrograma || ''
                );
            });
        });

        btnPantallaCompletaCalendario
            ?.addEventListener('click', alternarPantallaCompletaCalendario);

        btnCompactarCalendario
            ?.addEventListener('click', alternarModoCompacto);

        document.addEventListener('fullscreenchange', () => {
            if (!document.fullscreenElement && calendarKiosk?.classList.contains('fullscreen-fallback')) {
                calendarKiosk.classList.remove('fullscreen-fallback');
                document.body.classList.remove('fullscreen-fallback-active');
            }

            actualizarBotonPantallaCompleta();
            setTimeout(ajustarCalendarioAlViewport, 60);
        });

        document.addEventListener('keydown', event => {
            if (event.key === 'Escape' && calendarKiosk?.classList.contains('fullscreen-fallback')) {
                calendarKiosk.classList.remove('fullscreen-fallback');
                document.body.classList.remove('fullscreen-fallback-active');
                actualizarBotonPantallaCompleta();
                ajustarCalendarioAlViewport();
            }
        });

        restaurarPreferenciasCalendario();
        actualizarBotonPantallaCompleta();
        window.addEventListener('resize', () => {
            clearTimeout(window.__calendarFitTimer);
            window.__calendarFitTimer = setTimeout(ajustarCalendarioAlViewport, 100);
        });

        document.getElementById('btnConfirmarMovimientoCalendario')
            ?.addEventListener('click', aplicarMovimientoConfirmado);

        document.getElementById('btnMostrarRango')
            ?.addEventListener('click', () => {
                document.getElementById('formRangoCalendario')?.classList.toggle('active');
            });

        document.getElementById('formRangoCalendario')
            ?.addEventListener('submit', event => {
                const inicio = document.getElementById('rangoInicio')?.value;
                const fin = document.getElementById('rangoFin')?.value;

                if (!inicio || !fin) {
                    event.preventDefault();
                    mostrarModalCalendario('Rango incompleto', 'Selecciona fecha inicio y fecha fin.');
                    return;
                }

                const inicioDate = new Date(`${inicio}T00:00:00`);
                const finDate = new Date(`${fin}T00:00:00`);
                const dias = (finDate - inicioDate) / 86400000 + 1;

                if (finDate < inicioDate) {
                    event.preventDefault();
                    mostrarModalCalendario('Rango inválido', 'La fecha fin no puede ser menor que la fecha inicio.');
                    return;
                }

                if (dias > 31) {
                    event.preventDefault();
                    mostrarModalCalendario('Rango inválido', 'El rango no puede ser mayor a 31 días.');
                    return;
                }
            });

        search?.addEventListener('input', () => {
            const value = search.value.trim().toLowerCase();

            for (const row of document.querySelectorAll('.calendar-machine-row')) {
                row.style.display =
                    !value || (row.dataset.search || '').includes(value)
                        ? ''
                        : 'none';
            }
        });

        document.querySelectorAll('.block').forEach(block => {
            block.addEventListener('dragstart', event => {
                if (!puedeArrastrar(block)) {
                    event.preventDefault();

                    const motivo = block.dataset.motivoBloqueo ||
                        'Este bloque no puede moverse desde el calendario.';

                    setStatus(motivo, 'error');
                    mostrarModalCalendario('Movimiento bloqueado', motivo);

                    return;
                }

                draggedBlock = block;
                dragStarted = true;

                event.dataTransfer.effectAllowed = 'move';
                event.dataTransfer.setData('text/plain', block.dataset.programaId);

                setStatus('Consultando máquinas compatibles...', 'working');
                cargarMaquinasCompatibles(Number(block.dataset.programaId || 0));

                setTimeout(() => {
                    dragStarted = false;
                }, 400);
            });

            block.addEventListener('dragend', () => {
                suppressClickUntil = Date.now() + 650;

                limpiarMaquinasCompatibles();
            });

            block.addEventListener('click', event => {
                if (dragStarted || Date.now() < suppressClickUntil) {
                    event.preventDefault();
                    event.stopPropagation();
                    event.stopImmediatePropagation();
                    return false;
                }
            });
        });

        document.querySelectorAll('.track').forEach(track => {
            track.addEventListener('dragover', event => {
                if (!draggedBlock) return;

                if (!destinoCompatible(track)) {
                    event.dataTransfer.dropEffect = 'none';
                    return;
                }

                event.preventDefault();
                event.dataTransfer.dropEffect = 'move';
                track.classList.add('drag-over');
            });

            track.addEventListener('dragleave', () => {
                track.classList.remove('drag-over');
            });

            track.addEventListener('drop', async event => {
                event.preventDefault();
                track.classList.remove('drag-over');

                if (!draggedBlock) return;

                const programaId = Number(draggedBlock.dataset.programaId);
                const maquinaId = Number(track.dataset.maquinaId);
                const inicioNuevo = getDropDate(track, event);

                if (!Number.isFinite(programaId) || programaId <= 0) {
                    setStatus('No se pudo identificar el programa a mover.', 'error');
                    draggedBlock = null;
                    return;
                }

                if (!Number.isFinite(maquinaId) || maquinaId <= 0) {
                    setStatus('No se pudo identificar la máquina destino.', 'error');
                    draggedBlock = null;
                    return;
                }

                if (!destinoCompatible(track)) {
                    const mensaje = 'Esta máquina no está configurada como principal ni sustituta para esta parte.';
                    setStatus(mensaje, 'error');
                    mostrarModalCalendario('Movimiento no permitido', mensaje);
                    draggedBlock = null;
                    return;
                }

                const payload = {
                    programaProduccionID: programaId,
                    maquinaID: maquinaId,
                    inicio: localIso(inicioNuevo),
                    duracionBloqueHoras: 0,
                    redimensionado: false,
                    forzarMaquina: false,
                    confirmarMovimiento: false,
                    trabajarDomingo: !!trabajarDomingoCalendario?.checked
                };

                try {
                    setStatus('Validando máquina, line time, cola, molde, operador/turno y cambio...', 'working');

        const response = await fetch('@Url.Action("ReprogramarCalendario", "PlaneacionCalendarioMaquinas")', {
                        method: 'POST',
                        headers: {
                            'Content-Type': 'application/json',
                            'RequestVerificationToken': token
                        },
                        body: JSON.stringify(payload)
                    });

                    if (!response.ok) {
                        throw new Error(`HTTP ${response.status}`);
                    }

                    const result = await response.json();

                    if (!result.ok) {
                        const mensaje = result.mensaje ||
                            'No puedes mover este programa a esa máquina porque no es principal ni sustituta.';

                        setStatus(mensaje, 'error');
                        mostrarModalCalendario('Movimiento no permitido', mensaje);

                        draggedBlock = null;
                        return;
                    }

                    if (result.requiereConfirmacion) {
                        setStatus(result.mensaje || 'Confirma el movimiento propuesto.', 'working');
                        abrirModalConfirmacionMovimiento(result, payload);

                        draggedBlock = null;
                        return;
                    }

                    setStatus(result.mensaje || 'Programa actualizado correctamente.', 'success');

                    setTimeout(() => {
                        window.location.reload();
                    }, 650);
                }
                catch (error) {
                    const mensaje = 'Error al guardar el movimiento: ' + error.message;

                    setStatus(mensaje, 'error');
                    mostrarModalCalendario('Error al guardar', mensaje);
                }
                finally {
                    limpiarMaquinasCompatibles();
                    draggedBlock = null;
                }
            });
        });
    </script>

    <script>
        document.addEventListener('DOMContentLoaded', function () {
            const endpointProyeccion =
                '@Url.Action("ProyeccionInterrupcionesActivas", "PlaneacionCalendarioMaquinas")';

            const inicioPeriodoProyeccion =
                new Date('@inicioPeriodo.ToString("yyyy-MM-ddTHH:mm:ss")');

            const finPeriodoProyeccion =
                new Date('@finPeriodo.ToString("yyyy-MM-ddTHH:mm:ss")');

            const totalMinutosProyeccion =
                Math.max(
                    1,
                    (finPeriodoProyeccion - inicioPeriodoProyeccion) / 60000);

            const panel =
                document.getElementById(
                    'proyeccionInterrupcionesPanel');

            const totalElement =
                document.getElementById(
                    'proyeccionInterrupcionesTotal');

            const fechaElement =
                document.getElementById(
                    'proyeccionInterrupcionesFecha');

            const domingo =
                document.getElementById(
                    'trabajarDomingoCalendario');

            let consultando = false;

            function parseFecha(value) {
                if (!value)
                    return null;

                const fecha =
                    new Date(value);

                if (Number.isNaN(fecha.getTime()))
                    return null;

                return fecha;
            }

            function textoFecha(value) {
                const fecha =
                    value instanceof Date
                        ? value
                        : parseFecha(value);

                if (!fecha)
                    return '-';

                const pad =
                    value =>
                        String(value).padStart(2, '0');

                return
                    `${pad(fecha.getDate())}/` +
                    `${pad(fecha.getMonth() + 1)}/` +
                    `${fecha.getFullYear()} ` +
                    `${pad(fecha.getHours())}:` +
                    `${pad(fecha.getMinutes())}`;
            }

            function posicionarBloque(
                bloque,
                inicio,
                fin) {

                if (!bloque ||
                    !inicio ||
                    !fin) {
                    return;
                }

                if (fin <= inicioPeriodoProyeccion ||
                    inicio >= finPeriodoProyeccion) {

                    bloque.style.display =
                        'none';

                    return;
                }

                bloque.style.display =
                    '';

                const inicioVisible =
                    inicio < inicioPeriodoProyeccion
                        ? inicioPeriodoProyeccion
                        : inicio;

                const finVisible =
                    fin > finPeriodoProyeccion
                        ? finPeriodoProyeccion
                        : fin;

                const left =
                    (inicioVisible -
                     inicioPeriodoProyeccion) /
                    60000 /
                    totalMinutosProyeccion *
                    100;

                const width =
                    Math.max(
                        .35,
                        (finVisible -
                         inicioVisible) /
                        60000 /
                        totalMinutosProyeccion *
                        100);

                bloque.style.left =
                    `${left}%`;

                bloque.style.width =
                    `${width}%`;
            }

            function limpiarProyeccion() {
                document
                    .querySelectorAll(
                        '.block[data-programa-id]')
                    .forEach(bloque => {

                        const inicioOficial =
                            parseFecha(
                                bloque.dataset
                                    .inicioOficial);

                        const finOficial =
                            parseFecha(
                                bloque.dataset
                                    .finOficial);

                        posicionarBloque(
                            bloque,
                            inicioOficial,
                            finOficial);

                        bloque.classList.remove(
                            'has-live-projection',
                            'projection-root',
                            'projection-shifted');

                        bloque.dataset
                            .inicioProyectado = '';

                        bloque.dataset
                            .finProyectado = '';

                        const indicador =
                            bloque.querySelector(
                                '[data-projection-indicator]');

                        if (indicador) {
                            indicador
                                .classList
                                .add('d-none');
                        }

                        const linea =
                            bloque.querySelector(
                                '[data-projection-line]');

                        if (linea) {
                            linea
                                .classList
                                .add('d-none');

                            linea.textContent =
                                '';
                        }

                        const programaId =
                            bloque.dataset
                                .programaId;

                        const modal =
                            document.querySelector(
                                `[data-projection-modal="${programaId}"]`);

                        if (modal) {
                            modal
                                .classList
                                .add('d-none');
                        }
                    });
            }

            function actualizarPanel(data) {
                if (!panel)
                    return;

                const total =
                    Number(
                        data?.totalInterrupcionesActivas ||
                        0);

                panel.classList.toggle(
                    'd-none',
                    total <= 0);

                if (totalElement) {
                    totalElement.textContent =
                        String(total);
                }

                if (fechaElement) {
                    fechaElement.textContent =
                        data?.fechaCalculo
                            ? textoFecha(
                                data.fechaCalculo)
                            : '-';
                }
            }

            function aplicarPrograma(
                programa) {

                const programaId =
                    Number(
                        programa
                            ?.programaProduccionID ||
                        0);

                if (!programaId)
                    return;

                const bloque =
                    document.querySelector(
                        `.block[data-programa-id="${programaId}"]`);

                if (!bloque)
                    return;

                const inicio =
                    parseFecha(
                        programa
                            .inicioProyectado);

                const fin =
                    parseFecha(
                        programa
                            .finProyectado);

                if (!inicio ||
                    !fin) {
                    return;
                }

                posicionarBloque(
                    bloque,
                    inicio,
                    fin);

                bloque.dataset
                    .inicioProyectado =
                    programa.inicioProyectado ||
                    '';

                bloque.dataset
                    .finProyectado =
                    programa.finProyectado ||
                    '';

                bloque.classList.add(
                    'has-live-projection');

                const esRaiz =
                    programa
                        .esProgramaRaizInterrupcion ===
                    true;

                bloque.classList.toggle(
                    'projection-root',
                    esRaiz);

                bloque.classList.toggle(
                    'projection-shifted',
                    !esRaiz);

                const minutos =
                    Number(
                        esRaiz
                            ? programa
                                .minutosImpactoInterrupcion
                            : programa
                                .minutosDesplazamiento ||
                              0);

                const indicador =
                    bloque.querySelector(
                        '[data-projection-indicator]');

                if (indicador) {
                    indicador
                        .classList
                        .remove('d-none');

                    indicador.innerHTML =
                        esRaiz
                            ? `<i class="fa-solid fa-pause"></i><span>PARO +${minutos} min</span>`
                            : `<i class="fa-solid fa-clock-rotate-left"></i><span>PROY +${minutos} min</span>`;
                }

                const linea =
                    bloque.querySelector(
                        '[data-projection-line]');

                if (linea) {
                    linea
                        .classList
                        .remove('d-none');

                    linea.textContent =
                        esRaiz
                            ? `Fin proyectado: ${textoFecha(fin)}`
                            : `Proyección: ${textoFecha(inicio)} - ${textoFecha(fin)}`;
                }

                const modal =
                    document.querySelector(
                        `[data-projection-modal="${programaId}"]`);

                if (!modal)
                    return;

                modal
                    .classList
                    .remove('d-none');

                const tipo =
                    modal.querySelector(
                        '[data-projection-modal-tipo]');

                const motivo =
                    modal.querySelector(
                        '[data-projection-modal-motivo]');

                const inicioModal =
                    modal.querySelector(
                        '[data-projection-modal-inicio]');

                const finModal =
                    modal.querySelector(
                        '[data-projection-modal-fin]');

                const impacto =
                    modal.querySelector(
                        '[data-projection-modal-impacto]');

                if (tipo) {
                    tipo.textContent =
                        esRaiz
                            ? 'Interrupción activa en esta OF'
                            : 'Impacto de una interrupción anterior';
                }

                if (motivo) {
                    motivo.textContent =
                        programa.motivoParo ||
                        (
                            esRaiz
                                ? 'Paro de Producción'
                                : 'Recorrido por secuencia de máquina / molde'
                        );
                }

                if (inicioModal) {
                    inicioModal.textContent =
                        textoFecha(inicio);
                }

                if (finModal) {
                    finModal.textContent =
                        textoFecha(fin);
                }

                if (impacto) {
                    impacto.textContent =
                        `+${minutos} min`;
                }
            }

            async function actualizar() {
                if (consultando)
                    return;

                consultando = true;

                try {
                    const parametros =
                        new URLSearchParams(
                            {
                                rangoInicio:
                                    '@inicioPeriodo.ToString("yyyy-MM-ddTHH:mm:ss")',

                                rangoFin:
                                    '@finPeriodo.ToString("yyyy-MM-ddTHH:mm:ss")',

                                trabajarDomingo:
                                    (
                                        !!domingo?.checked
                                    ).toString()
                            });

                    const response =
                        await fetch(
                            `${endpointProyeccion}?${parametros.toString()}`,
                            {
                                method: 'GET',
                                headers: {
                                    'Accept':
                                        'application/json'
                                },
                                cache: 'no-store'
                            });

                    if (!response.ok) {
                        throw new Error(
                            `HTTP ${response.status}`);
                    }

                    const data =
                        await response.json();

                    if (!data?.ok) {
                        if (data?.sesionExpirada)
                            return;

                        throw new Error(
                            data?.mensaje ||
                            'No fue posible calcular la proyección.');
                    }

                    limpiarProyeccion();
                    actualizarPanel(data);

                    (
                        data.programas ||
                        []
                    ).forEach(
                        aplicarPrograma);
                }
                catch (error) {
                    console.warn(
                        'No fue posible actualizar la proyección de interrupciones:',
                        error);
                }
                finally {
                    consultando = false;
                }
            }

            actualizar();

            const timer =
                window.setInterval(
                    actualizar,
                    30000);

            domingo?.addEventListener(
                'change',
                actualizar);

            document.addEventListener(
                'visibilitychange',
                function () {
                    if (!document.hidden) {
                        actualizar();
                    }
                });

            window.addEventListener(
                'beforeunload',
                function () {
                    window.clearInterval(
                        timer);
                });
        });
    </script>

    <script>
    // NSQ_CAMBIO_OPERADOR_CALENDARIO_V1
    document.addEventListener('DOMContentLoaded', function () {
        if (!modoProduccion) return;

        const modalEl = document.getElementById('modalCambioOperadorCalendario');
        if (!modalEl) return;

        const modalCambio = bootstrap.Modal.getOrCreateInstance(modalEl);
        const programaInput = document.getElementById('coProgramaID');
        const operadorActual = document.getElementById('coOperadorActual');
        const turnoTexto = document.getElementById('coTurno');
        const operadorSelect = document.getElementById('coOperadorNuevo');
        const alcance = document.getElementById('coAlcance');
        const motivo = document.getElementById('coMotivo');
        const justificacion = document.getElementById('coJustificacion');
        const feedback = document.getElementById('coFeedback');
        const btnGuardar = document.getElementById('coGuardar');

        function feedbackSet(texto, tipo) {
            feedback.className = `alert py-2 px-3 small ${tipo || 'alert-light'}`;
            feedback.textContent = texto || '';
            feedback.classList.toggle('d-none', !texto);
        }

        async function abrirCambio(programaId) {
            feedbackSet('', '');
            operadorSelect.innerHTML = '<option value="">Cargando...</option>';
            programaInput.value = programaId;
            justificacion.value = '';
            motivo.value = '';
            alcance.value = 'SOLO_OF';
            modalCambio.show();

            try {
                const url =
                    '@Url.Action("PersonalPrograma","PlaneacionCalendarioMaquinas")' +
                    '?programaProduccionId=' + encodeURIComponent(programaId);

                const response = await fetch(url, {
                    headers: { 'Accept': 'application/json' }
                });
                const data = await response.json();

                if (!response.ok || !data?.ok) {
                    throw new Error(data?.mensaje || `HTTP ${response.status}`);
                }

                operadorActual.textContent =
                    data.operadorRealNombre ||
                    data.operadorPlaneadoNombre ||
                    'Sin operador';

                turnoTexto.textContent = data.turno || 'Sin turno';

                operadorSelect.innerHTML =
                    '<option value="">-- Seleccionar sustituto --</option>';

                (data.candidatos || []).forEach(x => {
                    const option = document.createElement('option');
                    option.value = String(x.personaID);
                    option.textContent =
                        x.nombre + (x.nivel ? ` · N${x.nivel}` : '');
                    operadorSelect.appendChild(option);
                });
            }
            catch (error) {
                operadorSelect.innerHTML =
                    '<option value="">No disponible</option>';
                feedbackSet(
                    error.message || 'No fue posible cargar candidatos.',
                    'alert-danger'
                );
            }
        }

        document.querySelectorAll('[data-cambiar-operador]').forEach(btn => {
            btn.addEventListener('click', function (event) {
                event.preventDefault();
                event.stopPropagation();
                abrirCambio(btn.dataset.programaId);
            });
        });

        btnGuardar?.addEventListener('click', async function () {
            const payload = {
                programaProduccionID: Number(programaInput.value || 0),
                operadorSustitutoID: Number(operadorSelect.value || 0),
                alcance: alcance.value,
                motivo: motivo.value,
                justificacion: justificacion.value.trim()
            };

            if (!payload.operadorSustitutoID) {
                feedbackSet('Selecciona el operador sustituto.', 'alert-warning');
                return;
            }

            if (!payload.motivo) {
                feedbackSet('Selecciona el motivo del cambio.', 'alert-warning');
                return;
            }

            if (payload.justificacion.length < 5) {
                feedbackSet(
                    'Escribe una justificación clara del cambio.',
                    'alert-warning'
                );
                return;
            }

            try {
                btnGuardar.disabled = true;
                btnGuardar.innerHTML =
                    '<span class="spinner-border spinner-border-sm me-1"></span> Guardando...';

                const response = await fetch(
                    '@Url.Action("CambiarOperador","PlaneacionCalendarioMaquinas")',
                    {
                        method: 'POST',
                        headers: {
                            'Content-Type': 'application/json',
                            'RequestVerificationToken': token
                        },
                        body: JSON.stringify(payload)
                    });

                const data = await response.json();

                if (!response.ok || !data?.ok) {
                    throw new Error(data?.mensaje || `HTTP ${response.status}`);
                }

                feedbackSet(data.mensaje || 'Cambio aplicado.', 'alert-success');
                setTimeout(() => window.location.reload(), 700);
            }
            catch (error) {
                feedbackSet(
                    error.message || 'No fue posible guardar el cambio.',
                    'alert-danger'
                );
            }
            finally {
                btnGuardar.disabled = false;
                btnGuardar.innerHTML =
                    '<i class="fa-solid fa-user-check me-1"></i> Aplicar cambio';
            }
        });
    });
    </script>

