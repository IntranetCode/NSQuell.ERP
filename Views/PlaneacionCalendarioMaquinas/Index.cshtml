                                {
                                    <span class="small text-muted">
                                        Inspección @bloque.InspeccionCalidadID
                                    </span>
                                }
                                @if (bloque.ConfiguracionCalidadInvalidada)
                                {
                                    <span class="d-block small text-danger fw-bold">
                                        Configuración invalidada
                                    </span>
                                }
