                        </div>
                    </div>

                    <div class="col-md-6">
                        <div class="border rounded-3 p-3">
                            <small class="text-muted">Horas programadas</small>
                            <strong id="confirmarHoras" class="d-block">-</strong>
                        </div>
                    </div>

                    <div class="col-md-4">
                        <div class="border rounded-3 p-3">
                            <small class="text-muted">Cambio</small>
                            <strong id="confirmarCambio" class="d-block">-</strong>
                        </div>
                    </div>

                    <div class="col-md-4">
                        <div class="border rounded-3 p-3">
                            <small class="text-muted">Arranque</small>
                            <strong id="confirmarArranque" class="d-block">-</strong>
                        </div>
                    </div>

                    <div class="col-md-4">
                        <div class="border rounded-3 p-3">
                            <small class="text-muted">Fin estimado</small>
                            <strong id="confirmarFin" class="d-block">-</strong>
                        </div>
                    </div>

                    <div class="col-12">
                        <div class="border rounded-3 p-3 bg-light">
                            <small class="text-muted">Qué va a pasar</small>
