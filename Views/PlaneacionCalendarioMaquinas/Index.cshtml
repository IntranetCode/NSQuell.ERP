        <div class="timeline-scroll">
            <div class="timeline">
                <div class="timeline-header">
                    <div class="machine-head">MÁQUINA / BLOQUES</div>

                    <div class="days">
                        @for (var day = 0; day < totalDias; day++)
                        {
                            var fecha = inicioPeriodo.AddDays(day);

                            <div class="day">
                                <strong>@fecha.ToString("ddd", cultura).ToUpperInvariant()</strong>
                                <span>@fecha.ToString("dd/MM")</span>
                            </div>
                        }
                    </div>
                </div>

                @foreach (var maquina in Model.Maquinas)
                {
                    var rowHeight = Math.Max(56, 8 + maquina.Carriles * 48);

                    var search = string.Join(" ",
                    maquina.Codigo,
                    maquina.Nombre,
                    string.Join(" ", maquina.Bloques.Select(x =>
                    $"{x.OFTexto} {x.ClienteNombre} {x.ParteTexto} {x.Descripcion} {x.MoldeCodigo} {x.MaquinaSugeridaTexto} {x.EstadoSemaforoTexto} {x.OperadorProgramadoNombre} {x.OperadorRealNombre} {x.TurnoProgramadoNombre} {x.EstatusProduccionNombre} {x.EstadoCalidad}")))
                    .ToLowerInvariant();

                    <div class="machine-row calendar-machine-row"
                         data-search="@search">
                        <div class="machine-info" data-nsq-style="height:@(rowHeight)px">
                            <div class="machine-inline" title="@maquina.Codigo - @maquina.Nombre">
                                <span class="machine-code">@maquina.Codigo</span>
                                <span class="machine-name">@maquina.Nombre</span>
                                <span class="machine-count">@maquina.Bloques.Count</span>
                            </div>
                        </div>

                        <div class="track"
                             data-maquina-id="@maquina.MaquinaID"
                             data-nsq-style="height:@(rowHeight)px">
                            @if (ahoraVisible)
                            {
                                <div class="now-line"
                                     data-nsq-style="left:@Pct(ahoraLeft)%"
                                     title="Hora actual"></div>
                            }

                            @if (!maquina.Bloques.Any())
                            {
                                <div class="empty-row">Sin OF programada durante este periodo.</div>
                            }

                            @foreach (var bloque in maquina.Bloques)
                            {
                                var visibleInicio = bloque.Inicio < inicioPeriodo
                                ? inicioPeriodo
                                : bloque.Inicio;

                                var visibleFin = bloque.Fin > finPeriodo
                                ? finPeriodo
                                : bloque.Fin;

                                var left = (visibleInicio - inicioPeriodo).TotalMinutes / totalMinutos * 100;

                                var width = Math.Max(
                                .35,
                                (visibleFin - visibleInicio).TotalMinutes / totalMinutos * 100);

                                var top = 8 + bloque.Carril * 48;

                                var puedeMover = !modoProduccion && bloque.PuedeMoverCalendario;

                                var tituloBloqueo = modoProduccion
                                ? "Vista de solo lectura para Produccion."
                                : puedeMover
                                    ? "Arrastra para mandar a cola de otra máquina compatible."
                                    : bloque.MotivoBloqueoMovimiento;

                                var textoOperador = bloque.TextoOperadorVisible;
                                var origenOperador = bloque.TieneOperadorReal
                                ? "Real"
                                : "Planeado";

                                var textoTurno = bloque.TextoTurnoProgramado;
                                var textoCalidad = bloque.EstadoCalidadTexto;

                                var minutosAtrasoInicio = bloque.Inicio < Model.Ahora
                                ? Math.Max(0, (int)Math.Floor((Model.Ahora - bloque.Inicio).TotalMinutes))
                                : 0;

                                var mostrarAlertaNoInicio =
                                bloque.EstatusID == 1 &&
                                minutosAtrasoInicio >= 10 &&
                                bloque.EstatusProduccionID != 3;

                                var textoAlertaNoInicio = mostrarAlertaNoInicio
                                ? $"Producción no inició a la hora programada. Atraso: {minutosAtrasoInicio} min."
                                : string.Empty;

                                var solicitudReprogramacionPendiente =
                                solicitudesReprogramacion.FirstOrDefault(x =>
                                x.ProgramaProduccionID == bloque.ProgramaProduccionID);

                                var tieneSolicitudReprogramacion = solicitudReprogramacionPendiente != null;

                                /*
                                * PRIORIDAD VISUAL DEL CALENDARIO
                                * 1. Paro real de Producción.
                                * 2. Reliberación / configuración invalidada por Calidad.
                                * 3. Proceso activo de Calidad.
                                * 4. Producción activa.
                                * 5. Semáforo normal que ya calcula el modelo.
                                *
                                * No modifica lógica ni estados; únicamente decide el color.
                                */
                                var claseColorBloque = bloque.ClaseSemaforoCalendario;

                                var estaEnParo =
                                bloque.EstatusProduccionID == 4;

                                var estaEnReliberacion =
                                bloque.RequiereReliberacion ||
                                bloque.ConfiguracionCalidadInvalidada;

                                var estadoCalidadNormalizado =
                                (bloque.EstadoCalidad ?? string.Empty)
                                .Trim()
                                .ToUpperInvariant();

                                var estaEnCalidad =
                                bloque.InspeccionCalidadID.HasValue &&
                                !string.IsNullOrWhiteSpace(estadoCalidadNormalizado) &&
                                estadoCalidadNormalizado != "CERRADA";

                                if (estaEnParo)
                                {
                                    claseColorBloque = "bloque-paro";
                                }
                                else if (estaEnReliberacion)
                                {
                                    claseColorBloque = "bloque-reliberacion";
                                }
                                else if (estaEnCalidad)
                                {
                                    claseColorBloque = "bloque-calidad";
                                }
                                else if (bloque.EstatusProduccionID == 3)
                                {
                                    claseColorBloque = "bloque-produciendo";
                                }

                                <button type="button"
                                        class="block @claseColorBloque @(puedeMover ? "" : "no-drag") @(mostrarAlertaNoInicio ? "has-start-delay" : "") @(tieneSolicitudReprogramacion ? "has-reprogram-request" : "")"
                                        draggable="@(puedeMover ? "true" : "false")"
                                        data-nsq-style="left:@Pct(left)%;width:@Pct(width)%;top:@(top)px"
                                        data-programa-id="@bloque.ProgramaProduccionID"
                                        data-maquina-id="@bloque.MaquinaID"
                                        data-inicio="@bloque.Inicio.ToString("yyyy-MM-ddTHH:mm:ss")"
                                        data-fin="@bloque.Fin.ToString("yyyy-MM-ddTHH:mm:ss")"
                                        data-puede-mover="@(puedeMover ? "true" : "false")"
                                        data-motivo-bloqueo="@bloque.MotivoBloqueoMovimiento"
                                        data-bs-toggle="modal"
                                        data-bs-target="#ofModal_@bloque.ProgramaProduccionID"
                                        title="@bloque.OFTexto · @bloque.ParteTexto · @bloque.EstadoSemaforoTexto · @bloque.Inicio.ToString("dd/MM HH:mm") - @bloque.Fin.ToString("dd/MM HH:mm") · Operador @origenOperador: @textoOperador · Turno: @textoTurno · Calidad: @textoCalidad · Máquina sugerida: @bloque.MaquinaSugeridaTexto · @(mostrarAlertaNoInicio? textoAlertaNoInicio + " · " : "")@tituloBloqueo">
                                    @if (mostrarAlertaNoInicio)
                                    {
                                        <span class="start-delay-alert" title="@textoAlertaNoInicio">
                                            <i class="fa-solid fa-bell"></i>
                                        </span>
                                    }
                                    @if (tieneSolicitudReprogramacion)
                                    {
                                        <span class="reprogram-request-indicator" title="Producción solicitó reprogramación">
                                            <i class="fa-solid fa-calendar-arrow-down"></i>
                                        </span>
                                    }
                                    <strong>@bloque.OFTexto · @bloque.ParteTexto</strong>
                                    <span>@(bloque.ClienteNombre ?? "Sin cliente") · @bloque.EstadoSemaforoTexto</span>
                                    <span class="operator-line">
                                        <i class="fa-solid fa-user-gear"></i>
                                        @origenOperador: @textoOperador · @textoTurno
                                    </span>
                                </button>
                            }
                        </div>
                    </div>
                }
            </div>
        </div>
    </section>
</div>

@foreach (var bloque in Model.Maquinas.SelectMany(x => x.Bloques))
{
    var textoOperadorModal = bloque.TextoOperadorProgramado;
    var textoOperadorRealModal = bloque.TextoOperadorReal;
    var textoAuxiliarModal = bloque.TextoOperadorAuxiliarProgramado;
    var textoTurnoModal = bloque.TextoTurnoProgramado;
    var textoCalidadModal = bloque.EstadoCalidadTexto;

    var textoEstatusProduccion = TextoProduccion(
    bloque.EstatusProduccionID,
    bloque.EstatusProduccionNombre);

    <div class="modal fade"
         id="ofModal_@bloque.ProgramaProduccionID"
         tabindex="-1"
         aria-hidden="true">
        <div class="modal-dialog modal-lg modal-dialog-centered">
            <div class="modal-content border-0 rounded-4 shadow">
                <div class="modal-header border-0">
                    <div>
                        <div class="small text-muted fw-bold text-uppercase">
