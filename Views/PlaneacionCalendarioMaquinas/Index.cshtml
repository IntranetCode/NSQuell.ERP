                            <div class="detail-card">
                                <small>Producidas</small>
                                <strong class="d-block">@bloque.CantidadProducida.ToString("N0")</strong>
                            </div>
                        </div>

                        <div class="col-md-4">
                            <div class="detail-card">
                                <small>Pendientes</small>
                                <strong class="d-block">@bloque.CantidadPendiente.ToString("N0")</strong>
                            </div>
                        </div>
                    </div>
                </div>

                <div class="modal-footer border-0">
                    @if (modoProduccion && bloque.EjecucionProduccionID.HasValue)
                    {
