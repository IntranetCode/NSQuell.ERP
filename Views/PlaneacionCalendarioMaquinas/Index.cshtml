<style>
    .timeline-header .days .nsq-hour-ruler-v31 {
        grid-column: 1 / -1;
        display: grid;
        background: #eef4fb;
        border-top: 1px solid #d7e1ee;
        overflow: hidden;
    }
    .timeline-header .days .nsq-hour-cell-v31 {
        min-width: 0;
        padding: 2px 0;
        border-left: 1px solid #d7e1ee;
        text-align: center;
        color: #344054;
        font-size: .48rem;
        font-weight: 900;
        line-height: 1;
        overflow: hidden;
    }
    .timeline-header .days .nsq-hour-cell-v31.day-start {
        border-left: 2px solid #7d8da6;
        color: #004aad;
        background: #e4efff;
    }
</style>
<script>
document.addEventListener('DOMContentLoaded', function () {
    const vista31 = '@Model.VistaNormalizada'.toLowerCase();
    const dias31 = @totalDias;
    const days31 = document.querySelector('.timeline-header .days');
    const timeline31 = document.querySelector('.timeline');
    const machine31 = document.querySelector('.timeline-header .machine-head');

    document.querySelectorAll('.nsq-hour-ruler-v30,.nsq-hour-ruler-v31').forEach(x => x.remove());

    const mostrar31 = vista31 === 'dia' || vista31 === 'semana' || (vista31 === 'rango' && dias31 <= 7);
    if (!days31 || !mostrar31) return;

    const totalHoras31 = Math.max(24, dias31 * 24);
    const ruler31 = document.createElement('div');
    ruler31.className = 'nsq-hour-ruler-v31';
    ruler31.style.gridTemplateColumns = `repeat(${totalHoras31}, minmax(0, 1fr))`;

    for (let i=0; i<totalHoras31; i++) {
        const h=i%24;
        const cell=document.createElement('span');
        cell.className='nsq-hour-cell-v31'+(h===0?' day-start':'');
        cell.textContent=String(h).padStart(2,'0');
        cell.title=String(h).padStart(2,'0')+':00';
        ruler31.appendChild(cell);
    }
    days31.appendChild(ruler31);

    if (timeline31) {
        if (vista31 === 'dia' && machine31) {
            const mw=Math.max(150,Math.ceil(machine31.getBoundingClientRect().width));
            timeline31.style.minWidth=`${mw + (24 * 48)}px`;
        } else {
            // Semana vuelve al ancho natural anterior; 168 horas se comprimen.
            timeline31.style.minWidth='';
        }
    }
});
</script>