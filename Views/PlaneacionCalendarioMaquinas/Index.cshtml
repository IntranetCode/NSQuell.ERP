                    <span>Compactar</span>
                </button>

                <button type="button"
                        id="btnPantallaCompletaCalendario"
                        class="btn-calendar-action"
                        title="Abrir calendario en modo kiosco a pantalla completa">
                    <i class="fa-solid fa-expand"></i>
                    <span class="fullscreen-label">Pantalla completa</span>
                </button>

                <span class="fullscreen-help">Esc para salir</span>
                <span id="fitScaleLabel" class="fit-scale-label"></span>
            </div>

            <div class="legend">
                <span><i data-nsq-style-id="nsq-si-93d879e3cf"></i>@(modoProduccion ? "Programado" : "Programado / movible")</span>
                <span><i data-nsq-style-id="nsq-si-1c4b44484e"></i>Produciendo / en línea</span>
                <span><i data-nsq-style-id="nsq-si-31a65355ef"></i>Paro</span>
                <span><i data-nsq-style-id="nsq-si-b64b5184b1"></i>Calidad</span>
                <span><i data-nsq-style-id="nsq-si-147df738d9"></i>Reliberación</span>
                <span><i data-nsq-style-id="nsq-si-31d8aa2278"></i>Ya producido</span>
                <span><i data-nsq-style-id="nsq-si-e71927bd00"></i>Cerrado / cancelado</span>

                    <span>
                        <i class="fa-solid fa-border-all text-warning"></i>
                        Contorno punteado = proyección por interrupción
                    </span>

            </div>
        </div>

        <div class="timeline-scroll">
            <div class="timeline">
                <div class="timeline-header">
                    <div class="machine-head">MÁQUINA / BLOQUES</div>

                    <div class="days">
                        @for (var day = 0; day < totalDias; day++)
                        {
                            var fecha = inicioPeriodo.AddDays(day);

                            <div class="day">
                                <strong>@fecha.ToString("ddd", cultura).ToUpperInvariant()</strong>
                                <span>@fecha.ToString("dd/MM")</span>
                            </div>
                        }
                    </div>
                </div>

                @foreach (var maquina in Model.Maquinas)
                {
                    var rowHeight = Math.Max(56, 8 + maquina.Carriles * 48);

                    var search = string.Join(" ",
                    maquina.Codigo,
                    maquina.Nombre,
                    string.Join(" ", maquina.Bloques.Select(x =>
                    $"{x.OFTexto} {x.ClienteNombre} {x.ParteTexto} {x.Descripcion} {x.MoldeCodigo} {x.MaquinaSugeridaTexto} {x.EstadoSemaforoTexto} {x.OperadorProgramadoNombre} {x.OperadorRealNombre} {x.TurnoProgramadoNombre} {x.EstatusProduccionNombre} {x.EstadoCalidad}")))
                    .ToLowerInvariant();

                    <div class="machine-row calendar-machine-row"
                         data-search="@search">
                        <div class="machine-info"
                             data-open-machine-board
                             data-maquina-id="@maquina.MaquinaID"
                             data-fecha-desde="@inicioPeriodo.ToString("yyyy-MM-dd")"
                             data-fecha-hasta="@finPeriodo.AddDays(-1).ToString("yyyy-MM-dd")"
                             data-board-url="@Url.Action("Maquinas", "PlaneacionPrograma")"
                             role="button"
                             tabindex="0"
                             title="Abrir tablero de @maquina.Codigo"
                             data-nsq-marker="NSQ_GENERAL_MACHINE_CLICK_V1" data-nsq-style="height:@(rowHeight)px">
                            <div class="machine-inline" title="@maquina.Codigo - @maquina.Nombre">
                                <span class="machine-code">@maquina.Codigo</span>
                                <span class="machine-name">@maquina.Nombre</span>
                                <span class="machine-count">@maquina.Bloques.Count</span>
                            </div>
                        </div>

                        <div class="track"
                             data-maquina-id="@maquina.MaquinaID"
                             data-nsq-style="height:@(rowHeight)px">
                            @if (ahoraVisible)
                            {
                                <div class="now-line"
                                     data-nsq-style="left:@Pct(ahoraLeft)%"
                                     title="Hora actual"></div>
                            }

                            @if (!maquina.Bloques.Any())
                            {
                                <div class="empty-row">Sin OF programada durante este periodo.</div>
                            }

                           
                                @foreach (var bloque in maquina.Bloques)
                                {
                                    var inicioVisualBloque = bloque.InicioVisual;
                                    var finVisualBloque = bloque.FinVisual;

                                    var visibleInicio = inicioVisualBloque < inicioPeriodo
                                    ? inicioPeriodo
                                    : inicioVisualBloque;

                                    var visibleFin = finVisualBloque > finPeriodo
                                    ? finPeriodo
                                    : finVisualBloque;

                                    var left = (visibleInicio - inicioPeriodo).TotalMinutes / totalMinutos * 100;

                                    var width = Math.Max(
                                    .35,
                                    (visibleFin - visibleInicio).TotalMinutes / totalMinutos * 100);

                                    var top = 8 + bloque.Carril * 48;
                                    var puedeMover = !modoProduccion && bloque.PuedeMoverCalendario;

                                    var tituloBloqueo = modoProduccion
                                    ? "Vista de solo lectura para Produccion."
                                    : puedeMover
                                    ? "Arrastra para mandar a cola de otra máquina compatible."
                                    : bloque.MotivoBloqueoMovimiento;

                                    var textoOperador = bloque.TextoOperadorVisible;
                                    var origenOperador = bloque.TieneOperadorReal
                                    ? "Real"
                                    : "Planeado";

                                    var textoTurno = bloque.TextoTurnoProgramado;
                                    var textoCalidad = bloque.EstadoCalidadTexto;

                                    var minutosAtrasoInicio = bloque.Inicio < Model.Ahora
                                    ? Math.Max(0, (int)Math.Floor((Model.Ahora - bloque.Inicio).TotalMinutes))
                                    : 0;

                                    var mostrarAlertaNoInicio =
                                    bloque.EstatusID == 1 &&
                                    minutosAtrasoInicio >= 10 &&
                                    bloque.EstatusProduccionID != 3;

                                    var textoAlertaNoInicio = mostrarAlertaNoInicio
                                    ? $"Producción no inició a la hora programada. Atraso: {minutosAtrasoInicio} min."
                                    : string.Empty;

                                    var solicitudReprogramacionPendiente =
                                    solicitudesReprogramacion.FirstOrDefault(x =>
                                    x.ProgramaProduccionID == bloque.ProgramaProduccionID);

                                    var tieneSolicitudReprogramacion =
                                    solicitudReprogramacionPendiente != null;

                                    var claseColorBloque =
                                    bloque.ClaseSemaforoCalendario;

                                    var estaEnParo =
                                    bloque.EstatusProduccionID == 4;

                                    var estaEnReliberacion =
                                    bloque.RequiereReliberacion ||
                                    bloque.ConfiguracionCalidadInvalidada;

                                    var estadoCalidadNormalizado =
                                    (bloque.EstadoCalidad ?? string.Empty)
                                    .Trim()
                                    .ToUpperInvariant();

                                    var estaEnCalidad =
                                    bloque.InspeccionCalidadID.HasValue &&
                                    !string.IsNullOrWhiteSpace(estadoCalidadNormalizado) &&
                                    estadoCalidadNormalizado != "CERRADA";

                                    if (estaEnParo)
                                    {
                                        claseColorBloque = "bloque-paro";
                                    }
                                    else if (estaEnReliberacion)
                                    {
                                        claseColorBloque = "bloque-reliberacion";
                                    }
                                    else if (estaEnCalidad)
                                    {
                                        claseColorBloque = "bloque-calidad";
                                    }
                                    else if (bloque.EstatusProduccionID == 3)
                                    {
                                        claseColorBloque = "bloque-produciendo";
                                    }

                                    <button type="button"
                                            class="block @claseColorBloque @(puedeMover ? "" : "no-drag") @(mostrarAlertaNoInicio ? "has-start-delay" : "") @(tieneSolicitudReprogramacion ? "has-reprogram-request" : "") @(bloque.TieneProyeccionInterrupcion ? "has-live-projection" : "") @(bloque.EsProgramaRaizInterrupcion ? "projection-root" : bloque.TieneProyeccionInterrupcion ? "projection-shifted" : "")"
                                            draggable="@(puedeMover ? "true" : "false")"
                                            data-nsq-style="left:@Pct(left)%;width:@Pct(width)%;top:@(top)px"
                                            data-programa-id="@bloque.ProgramaProduccionID"
                                            data-maquina-id="@bloque.MaquinaID"
                                            data-inicio="@bloque.Inicio.ToString("yyyy-MM-ddTHH:mm:ss")"
                                            data-fin="@bloque.Fin.ToString("yyyy-MM-ddTHH:mm:ss")"
                                            data-inicio-oficial="@bloque.Inicio.ToString("yyyy-MM-ddTHH:mm:ss")"
                                            data-fin-oficial="@bloque.Fin.ToString("yyyy-MM-ddTHH:mm:ss")"
                                            data-inicio-proyectado="@(bloque.InicioProyectado?.ToString("yyyy-MM-ddTHH:mm:ss") ?? "")"
                                            data-fin-proyectado="@(bloque.FinProyectado?.ToString("yyyy-MM-ddTHH:mm:ss") ?? "")"
                                            data-puede-mover="@(puedeMover ? "true" : "false")"
                                            data-motivo-bloqueo="@bloque.MotivoBloqueoMovimiento"
                                            data-bs-toggle="modal"
                                            data-bs-target="#ofModal_@bloque.ProgramaProduccionID"
                                            title="@bloque.OFTexto · @bloque.ParteTexto · @bloque.EstadoSemaforoTexto · @bloque.Inicio.ToString("dd/MM HH:mm") - @bloque.Fin.ToString("dd/MM HH:mm") · Operador @origenOperador: @textoOperador · Turno: @textoTurno · Calidad: @textoCalidad · Máquina sugerida: @bloque.MaquinaSugeridaTexto · @(mostrarAlertaNoInicio? textoAlertaNoInicio + " · " : "")@tituloBloqueo">

                                        @if (mostrarAlertaNoInicio)
                                        {
                                            <span class="start-delay-alert"
                                                  title="@textoAlertaNoInicio">
                                                <i class="fa-solid fa-bell"></i>
                                            </span>
                                        }

                                        @if (tieneSolicitudReprogramacion)
                                        {
                                            <span class="reprogram-request-indicator"
                                                  title="Producción solicitó reprogramación">
                                                <i class="fa-solid fa-calendar-arrow-down"></i>
                                            </span>
                                        }

                                    <span class="projection-live-indicator @(bloque.TieneProyeccionInterrupcion ? "" : "d-none")"
                                          data-projection-indicator>
                                        <i class="fa-solid @(bloque.EsProgramaRaizInterrupcion ? "fa-pause" : "fa-clock-rotate-left")"></i>
                                        <span>
                                            @(bloque.EsProgramaRaizInterrupcion
                                                                                ? $"PARO +{bloque.MinutosImpactoInterrupcion} min"
                                                                                : $"PROY +{bloque.MinutosDesplazamientoProyectado} min")
                                                                                                                                    </span>
                                                                                                                                </span>

                                    <strong>
                                        @bloque.OFTexto · @bloque.ParteTexto
                                    </strong>

                                    <span>
                                        @(bloque.ClienteNombre ?? "Sin cliente") ·
                                        @bloque.EstadoSemaforoTexto
                                    </span>

                                    <span class="operator-line">
                                        <i class="fa-solid fa-user-gear"></i>
                                        @origenOperador: @textoOperador · @textoTurno
                                    </span>

                                    <span class="projection-line @(bloque.TieneProyeccionInterrupcion ? "" : "d-none")"
                                          data-projection-line>
                                        @(bloque.TieneProyeccionInterrupcion
                                                                        ? bloque.EsProgramaRaizInterrupcion
                                                                        ? $"Fin proyectado: {bloque.FinVisual:dd/MM HH:mm}"
                                                                        : $"Proyección: {bloque.InicioVisual:dd/MM HH:mm} - {bloque.FinVisual:dd/MM HH:mm}"
                                                                        : "")
                            </span>
                        </button>
                                                }
                            }
                        </div>
                    </div>
                }
            </div>
        </div>
    </section>
</div>

@foreach (var bloque in Model.Maquinas.SelectMany(x => x.Bloques))
{
    var textoOperadorModal = bloque.TextoOperadorProgramado;
    var textoOperadorRealModal = bloque.TextoOperadorReal;
    var textoAuxiliarModal = bloque.TextoOperadorAuxiliarProgramado;
    var textoTurnoModal = bloque.TextoTurnoProgramado;
    var textoCalidadModal = bloque.EstadoCalidadTexto;

    var textoEstatusProduccion = TextoProduccion(
    bloque.EstatusProduccionID,
    bloque.EstatusProduccionNombre);

    <div class="modal fade"
         id="ofModal_@bloque.ProgramaProduccionID"
         tabindex="-1"
         aria-hidden="true">
        <div class="modal-dialog modal-lg modal-dialog-centered">
            <div class="modal-content border-0 rounded-4 shadow">
                <div class="modal-header border-0">
                    <div>
                        <div class="small text-muted fw-bold text-uppercase">
                            Detalle de producción / planeación
                        </div>

                        <h2 class="modal-title h5 fw-bold text-primary">
                            @bloque.OFTexto
                        </h2>
                    </div>

                    <button type="button"
                            class="btn-close"
                            data-bs-dismiss="modal"></button>
                </div>
                <div class="modal-body">
                    <div class="alert projection-detail @(bloque.TieneProyeccionInterrupcion ? "" : "d-none") mb-3"
                         data-projection-modal="@bloque.ProgramaProduccionID">
                        <div class="d-flex gap-3 align-items-start">
                            <i class="fa-solid fa-wave-square text-warning fs-4 mt-1"></i>
                            <div class="flex-grow-1">
                                <div class="fw-bold"
                                     data-projection-modal-tipo>
                                    @(bloque.EsProgramaRaizInterrupcion
                                                                    ? "Interrupción activa en esta OF"
                                                                    : "Impacto de una interrupción anterior")
                                                                                                         </div>

                                <div class="small text-muted mt-1"
                                     data-projection-modal-motivo>
                                    @(string.IsNullOrWhiteSpace(bloque.MotivoInterrupcionProyectada)
                                                                    ? "Recorrido por secuencia de máquina / molde"
                                                                    : bloque.MotivoInterrupcionProyectada)
                            </div>

                                <div class="row g-2 mt-1">
                                    <div class="col-md-4">
                                        <small class="text-muted d-block">
                                            Inicio proyectado
                                        </small>
                                        <strong data-projection-modal-inicio>
                                            @bloque.InicioVisual.ToString("dd/MM/yyyy HH:mm")
                                        </strong>
                                    </div>

                                    <div class="col-md-4">
                                        <small class="text-muted d-block">
                                            Fin proyectado
                                        </small>
                                        <strong data-projection-modal-fin>
                                            @bloque.FinVisual.ToString("dd/MM/yyyy HH:mm")
                                        </strong>
                                    </div>

                                    <div class="col-md-4">
                                        <small class="text-muted d-block">
                                            Impacto estimado
                                        </small>
                                        <strong class="text-warning-emphasis"
                                                data-projection-modal-impacto>
                                            +@(bloque.EsProgramaRaizInterrupcion
                                                                                    ? bloque.MinutosImpactoInterrupcion
                                                                                    : bloque.MinutosDesplazamientoProyectado) min
                                    </strong>
                                </div>
                            </div>

                                <div class="small fw-bold mt-2">
                                    Las fechas oficiales permanecen sin cambios hasta cerrar la interrupción y aplicar el reacomodo definitivo.
                                </div>
                            </div>
                        </div>
                    </div>

                    <div class="row g-3">
                        <div class="col-md-4">
                            <div class="operator-card">
                                <small>Operador planeado</small>
                                <strong class="d-block">@textoOperadorModal</strong>
                                <span class="small text-muted">Auxiliar: @textoAuxiliarModal</span>

                                @if (modoProduccion)
                                {
                                    <button type="button"
                                            class="btn btn-sm btn-outline-warning fw-bold mt-2"
                                            data-cambiar-operador
                                            data-programa-id="@bloque.ProgramaProduccionID">
                                        <i class="fa-solid fa-user-pen me-1"></i>
                                        Cambiar operador
                                    </button>
                                }

                            </div>
                        </div>

                        <div class="col-md-4">
                            <div class="operator-card">
                                <small>Operador real de la ejecución</small>
                                <strong class="d-block">@textoOperadorRealModal</strong>
                                @if (bloque.EjecucionProduccionID.HasValue)
                                {
                                    <span class="small text-muted">
                                        Ejecución @bloque.EjecucionProduccionID
                                    </span>
                                }
                            </div>
                        </div>

                        <div class="col-md-4">
                            <div class="operator-card">
                                <small>Proceso de Calidad</small>
                                <strong class="d-block">@textoCalidadModal</strong>
                                @if (bloque.InspeccionCalidadID.HasValue)
                                {
                                    <span class="small text-muted">
                                        Inspección @bloque.InspeccionCalidadID
                                    </span>
                                }
                                @if (bloque.ConfiguracionCalidadInvalidada)
                                {
                                    <span class="d-block small text-danger fw-bold">
                                        Configuración invalidada
                                    </span>
                                }
                                @if (bloque.RequiereReliberacion)
                                {
                                    <span class="d-block small text-warning fw-bold">
                                        Reliberación pendiente
                                    </span>
                                }
                            </div>
                        </div>

                        <div class="col-md-3">
                            <div class="operator-card">
                                <small>Turno</small>
                                <strong class="d-block">@textoTurnoModal</strong>
                            </div>
                        </div>

                        <div class="col-md-3">
                            <div class="operator-card">
                                <small>Asignación escala</small>
                                <strong class="d-block">
                                    @(bloque.EscalaAsignacionID.HasValue? bloque.EscalaAsignacionID.Value.ToString() : "-")
                                </strong>
                            </div>
                        </div>

                        <div class="col-md-4">
                            <div class="detail-card">
                                <small>Máquina actual</small>
                                <strong class="d-block">@bloque.MaquinaCodigo</strong>
                            </div>
                        </div>

                        <div class="col-md-4">
                            <div class="detail-card">
                                <small>Máquina principal</small>
                                <strong class="d-block">@(bloque.MaquinaPrincipalCodigo ?? "Sin máquina principal")</strong>
                                <span class="small">@bloque.MaquinaPrincipalNombre</span>
                            </div>
                        </div>

                        <div class="col-md-4">
                            <div class="detail-card">
                                <small>Máquina sustituta</small>
                                <strong class="d-block">@(bloque.MaquinaSustitutaCodigo ?? "Sin máquina sustituta")</strong>
                                <span class="small">@bloque.MaquinaSustitutaNombre</span>
                            </div>
                        </div>

                        <div class="col-md-4">
                            <div class="detail-card">
                                <small>Estatus planeación</small>
                                <strong class="d-block">@bloque.EstatusTexto</strong>
                            </div>
                        </div>

                        <div class="col-md-4">
                            <div class="detail-card">
                                <small>Estatus producción</small>
                                <span class="@BadgeProduccion(bloque.EstatusProduccionID)">
                                    @textoEstatusProduccion
                                </span>

                                @if (bloque.EjecucionProduccionID.HasValue)
                                {
                                    <strong class="d-block mt-2">
                                        Ejecución @bloque.EjecucionProduccionID
                                    </strong>
                                }
                            </div>
                        </div>

                        <div class="col-md-4">
                            <div class="detail-card">
                                <small>Semáforo</small>
                                <strong class="d-block">@bloque.EstadoSemaforoTexto</strong>

                                @if (!bloque.PuedeMoverCalendario)
                                {
                                    <span class="small text-danger fw-bold">
                                        @bloque.MotivoBloqueoMovimiento
                                    </span>
                                }
                            </div>
                        </div>

                        <div class="col-md-4">
                            <div class="detail-card">
                                <small>Molde</small>
                                <strong class="d-block">@(bloque.MoldeCodigo ?? "-")</strong>
                            </div>
                        </div>

                        <div class="col-md-4">
                            <div class="detail-card">
                                <small>Horas a producir</small>
                                <strong class="d-block">@bloque.HorasProgramadas.ToString("N2")</strong>
                            </div>
                        </div>

                        <div class="col-md-4">
                            <div class="detail-card">
                                <small>Máquina sugerida</small>
                                <strong class="d-block">@bloque.MaquinaSugeridaTexto</strong>
                            </div>
                        </div>

                        <div class="col-md-6">
                            <div class="detail-card">
                                <small>Cliente</small>
                                <strong class="d-block">@(bloque.ClienteNombre ?? "-")</strong>
                            </div>
                        </div>

                        <div class="col-md-6">
                            <div class="detail-card">
                                <small>Parte</small>
                                <strong class="d-block">@bloque.ParteTexto</strong>
                                <span class="small">@bloque.Descripcion</span>
                            </div>
                        </div>

                        <div class="col-md-4">
                            <div class="detail-card">
                                <small>Cambio de molde</small>
                                <strong class="d-block">@(bloque.Cambio.HasValue? bloque.Cambio.Value.ToString(@"hh\:mm") : "-")</strong>
                            </div>
                        </div>

                        <div class="col-md-4">
                            <div class="detail-card">
                                <small>Arranque</small>
                                <strong class="d-block">@(bloque.Arranque.HasValue? bloque.Arranque.Value.ToString(@"hh\:mm") : "-")</strong>
                            </div>
                        </div>

                        <div class="col-md-4">
                            <div class="detail-card">
                                <small>Duración visible</small>
                                <strong class="d-block">
                                    @((bloque.Fin - bloque.Inicio).TotalHours.ToString("N2")) h
                                </strong>
                            </div>
                        </div>

                        <div class="col-md-6">
                            <div class="detail-card">
                                <small>Inicio</small>
                                <strong class="d-block">@bloque.Inicio.ToString("dd/MM/yyyy HH:mm")</strong>
                            </div>
                        </div>

                        <div class="col-md-6">
                            <div class="detail-card">
                                <small>Fin</small>
                                <strong class="d-block">@bloque.Fin.ToString("dd/MM/yyyy HH:mm")</strong>
                            </div>
                        </div>

                        <div class="col-md-4">
                            <div class="detail-card">
                                <small>Programadas</small>
                                <strong class="d-block">@bloque.CantidadProgramada.ToString("N0")</strong>
                            </div>
                        </div>

                        <div class="col-md-4">
                            <div class="detail-card">
                                <small>Producidas</small>
                                <strong class="d-block">@bloque.CantidadProducida.ToString("N0")</strong>
                            </div>
                        </div>

                        <div class="col-md-4">
                            <div class="detail-card">
                                <small>Pendientes</small>
                                <strong class="d-block">@bloque.CantidadPendiente.ToString("N0")</strong>
                            </div>
                        </div>
                    </div>
                </div>

                <div class="modal-footer border-0">
                    @if (modoProduccion && bloque.EjecucionProduccionID.HasValue)
                    {
                        <a class="btn btn-primary fw-bold"
                           href="@Url.Action("Detalle", "Produccion", new { id = bloque.EjecucionProduccionID.Value })">
                            <i class="fa-solid fa-arrow-up-right-from-square me-1"></i>
                            Ver ejecuci&oacute;n
                        </a>
                    }
                    else if (modoProduccion && (!bloque.EstatusProduccionID.HasValue || bloque.EstatusProduccionID == 1))
                    {
                        <a class="btn btn-primary fw-bold"
                           href="@Url.Action("Index", "Produccion", new { prepararProgramaId = bloque.ProgramaProduccionID })">
                            <i class="fa-solid fa-play me-1"></i>
                            Ir a iniciar preparaci&oacute;n
                        </a>
                    }

                    <button type="button"
                            class="btn btn-outline-secondary fw-bold"
                            data-bs-dismiss="modal">
                        Cerrar
                    </button>
                </div>
            </div>
        </div>
    </div>
}


@if (modoProduccion)
{
<div class="modal fade"
     id="modalCambioOperadorCalendario"
     tabindex="-1"
     aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content border-0 rounded-4 shadow">
            <div class="modal-header border-0 bg-primary text-white">
                <div>
                    <div class="small text-uppercase fw-bold opacity-75">
                        Producción / Excepción operativa
                    </div>
                    <h5 class="modal-title fw-bold mb-0">
                        <i class="fa-solid fa-user-pen me-1"></i>
                        Cambiar operador
                    </h5>
                </div>
                <button type="button"
                        class="btn-close btn-close-white"
                        data-bs-dismiss="modal"></button>
            </div>

            <div class="modal-body">
                <input type="hidden" id="coProgramaID" />

                <div class="row g-2 mb-3">
                    <div class="col-7">
                        <div class="border rounded-3 p-3 h-100">
                            <small class="text-muted fw-bold">OPERADOR ACTUAL</small>
                            <strong id="coOperadorActual" class="d-block mt-1">-</strong>
                        </div>
                    </div>
                    <div class="col-5">
                        <div class="border rounded-3 p-3 h-100">
                            <small class="text-muted fw-bold">TURNO</small>
                            <strong id="coTurno" class="d-block mt-1">-</strong>
                        </div>
                    </div>
                </div>

                <div class="mb-3">
                    <label class="form-label fw-bold">Nuevo operador</label>
                    <select id="coOperadorNuevo" class="form-select">
                        <option value="">-- Seleccionar sustituto --</option>
                    </select>
                    <div class="form-text">
                        Si existe matriz, sólo aparecen operadores con polivalencia N1-N4 para la parte.
                    </div>
                </div>

                <div class="mb-3">
                    <label class="form-label fw-bold">Aplicar cambio a</label>
                    <select id="coAlcance" class="form-select">
                        <option value="SOLO_OF">Sólo esta OF</option>
                        <option value="RESTO_TURNO">Resto del turno en esta máquina</option>
                    </select>
                </div>

                <div class="mb-3">
                    <label class="form-label fw-bold">Motivo</label>
                    <select id="coMotivo" class="form-select">
                        <option value="">-- Seleccionar --</option>
                        <option value="AUSENCIA">Ausencia</option>
                        <option value="INCAPACIDAD">Incapacidad</option>
                        <option value="PERMISO">Permiso / salida</option>
                        <option value="COBERTURA">Cobertura operativa</option>
                        <option value="CAMBIO_DE_PRIORIDAD">Cambio de prioridad</option>
                        <option value="OTRO">Otro</option>
                    </select>
                </div>

                <div class="mb-2">
                    <label class="form-label fw-bold">
                        Justificación <span class="text-danger">*</span>
                    </label>
                    <textarea id="coJustificacion"
                              class="form-control"
                              rows="3"
                              maxlength="500"
                              placeholder="Ej. El operador planeado reportó ausencia al inicio del turno."></textarea>
                </div>

                <div id="coFeedback"
                     class="alert d-none mt-3 mb-0"></div>
            </div>

            <div class="modal-footer border-0">
                <button type="button"
                        class="btn btn-outline-secondary fw-bold"
                        data-bs-dismiss="modal">
                    Cancelar
                </button>

                <button type="button"
                        id="coGuardar"
                        class="btn btn-primary fw-bold">
                    <i class="fa-solid fa-user-check me-1"></i>
                    Aplicar cambio
                </button>
            </div>
        </div>
    </div>
</div>
}

<div class="modal fade" id="modalSolicitudesReprogramacion" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-xl modal-dialog-centered modal-dialog-scrollable">
        <div class="modal-content border-0 rounded-4 shadow">
            <div class="modal-header border-0 bg-warning-subtle">
                <div>
                    <div class="small text-uppercase fw-bold text-warning-emphasis">Producción / Planeación</div>
                    <h5 class="modal-title fw-bold mb-0"><i class="fa-solid fa-calendar-arrow-down me-2"></i>Solicitudes de reprogramación</h5>
                </div>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body">
                @if (!solicitudesReprogramacion.Any())
                {
                    <div class="alert alert-success mb-0"><i class="fa-solid fa-circle-check me-1"></i>No existen solicitudes de reprogramación pendientes.</div>
                }
                else
                {
                    <div class="alert alert-warning border-0 rounded-3"><strong>Importante:</strong> atender una solicitud no cambia automáticamente la programación. Ubica el programa en el calendario y muévelo con el flujo normal de Planeación.</div>
                    @foreach (var solicitud in solicitudesReprogramacion)
                    {
                        var fechaPrograma = solicitud.FechaInicioPrograma ?? solicitud.FechaInicioProgramadaActual ?? solicitud.FechaSolicitud;
                        var urlPrograma = Url.Action("Index", "PlaneacionCalendarioMaquinas", new { vista = Model.VistaNormalizada, fecha = fechaPrograma.ToString("yyyy-MM-dd") }) ?? "#";
                        <div class="reprogram-request-card">
                            <div class="d-flex justify-content-between align-items-start gap-3 flex-wrap">
                                <div>
                                    <div class="d-flex align-items-center gap-2 flex-wrap mb-1">
                                        <strong class="text-primary fs-6">@solicitud.TextoOF</strong>
                                        <span class="reprogram-request-badge"><i class="fa-solid fa-clock"></i>Pendiente</span>
                                        @if (solicitud.MinutosAtrasoActual > 0)
                                        {
                                            <span class="badge text-bg-danger">Atraso @solicitud.TextoAtrasoActual</span>
                                        }
                                    </div>
                                    <div class="text-muted small">Programa @solicitud.ProgramaProduccionID · @solicitud.TextoParte · @solicitud.TextoMaquina</div>
                                </div>
                                <button type="button" class="btn btn-primary fw-bold btn-atender-reprogramacion" data-programa-id="@solicitud.ProgramaProduccionID" data-url-programa="@urlPrograma">
                                    <i class="fa-solid fa-location-crosshairs me-1"></i>Atender en calendario
                                </button>
                            </div>
                            <div class="row g-3 mt-1">
                                <div class="col-md-4"><div class="border rounded-3 p-3 h-100"><small class="text-muted">Horario al solicitar</small><strong class="d-block">@solicitud.TextoHorarioActual</strong></div></div>
                                <div class="col-md-4"><div class="border rounded-3 p-3 h-100"><small class="text-muted">Solicitud registrada</small><strong class="d-block">@solicitud.FechaSolicitud.ToString("dd/MM/yyyy HH:mm")</strong><span class="small text-muted">@(string.IsNullOrWhiteSpace(solicitud.UsuarioSolicitanteNombre) ? $"Usuario {solicitud.UsuarioSolicitanteID}" : solicitud.UsuarioSolicitanteNombre)</span></div></div>
                                <div class="col-md-4"><div class="border rounded-3 p-3 h-100"><small class="text-muted">Cantidad programada</small><strong class="d-block">@solicitud.CantidadProgramada.ToString("N0")</strong><span class="small text-muted">Molde: @(string.IsNullOrWhiteSpace(solicitud.MoldeCodigo) ? "-" : solicitud.MoldeCodigo)</span></div></div>
                                <div class="col-12">
                                    <div class="reprogram-request-motive">
                                        <div class="small text-muted fw-bold text-uppercase">Motivo informado por Producción</div>
                                        <div class="fw-bold mt-1">@(string.IsNullOrWhiteSpace(solicitud.Motivo) ? "Sin motivo especificado" : solicitud.Motivo)</div>
                                        @if (!string.IsNullOrWhiteSpace(solicitud.Observaciones))
                                        {
                                            <div class="small mt-2">@solicitud.Observaciones</div>
                                        }
                                    </div>
                                </div>
                            </div>
                        </div>
                    }
                }
            </div>
            <div class="modal-footer border-0">
                <span class="small text-muted me-auto">Rechazar una solicitud se conectará en el siguiente paso.</span>
                <button type="button" class="btn btn-outline-secondary fw-bold" data-bs-dismiss="modal">Cerrar</button>
            </div>
        </div>
    </div>
</div>

<div class="modal fade" id="modalConfirmarMovimientoCalendario" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered modal-lg">
        <div class="modal-content border-0 rounded-4 shadow">
            <div class="modal-header border-0 bg-primary text-white rounded-top-4">
