    <div id="antiForgeryToken" class="d-none">
        @Html.AntiForgeryToken()
    </div>

    <section class="calendar-card" id="calendarKiosk">
        <div class="calendar-card-header p-2 border-bottom d-flex justify-content-between align-items-center gap-3 flex-wrap">
            <div>
                <strong class="text-primary">
                    @Model.TituloPeriodo
                </strong>

                <div class="small text-muted">
                    Vista: @Model.TextoVista. Azul = programado y movible. Amarillo suave = Calidad. Rosa = paro. Morado suave = reliberación. Ámbar = Producción activa. Verde = producido. Gris = cerrado/cancelado. Operador planeado y operador real se muestran por separado.
                </div>
            </div>

            <div class="calendar-actions">
                <button type="button"
                        id="btnCompactarCalendario"
                        class="btn-calendar-action"
                        title="Reduce textos y espacios para mostrar más máquinas">
