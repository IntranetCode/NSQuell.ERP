@model ERP.NSQuell.Models.ViewModels.MaquinariaFormViewModel

@{
    Layout = "_LayoutMaquinaria";
    ViewData["Title"] = "Agregar máquina";
}

<div class="maq-form-page">
    <section class="maq-form-hero">
        <div class="maq-form-icon"><i class="fas fa-industry"></i></div>
        <div>
            <span class="maq-kicker">ALTAS - MAQUINARIA</span>
            <h1>Agregar máquina</h1>
            <p>Registra una nueva máquina en el catálogo operativo.</p>
        </div>
    </section>

    <form asp-action="CrearMaquinaria" asp-controller="Maquinaria" method="post" class="maq-form-card">
        @Html.AntiForgeryToken()

        <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

        <div class="maq-form-grid">
            <div class="maq-field">
                <label asp-for="Codigo">Código</label>
                <input asp-for="Codigo" class="form-control" placeholder="Ej. 90-T" />
                <span asp-validation-for="Codigo" class="text-danger"></span>
            </div>

            <div class="maq-field">
                <label asp-for="Nombre">Nombre</label>
                <input asp-for="Nombre" class="form-control" placeholder="Nombre de la máquina" />
                <span asp-validation-for="Nombre" class="text-danger"></span>
            </div>

            <div class="maq-field">
                <label asp-for="Area">Área</label>
                <input asp-for="Area" class="form-control" placeholder="Ej. Inyección" />
                <span asp-validation-for="Area" class="text-danger"></span>
            </div>

            <div class="maq-field">
                <label asp-for="EstadoOperativo">Estado operativo</label>
                <select asp-for="EstadoOperativo" class="form-select">
                    <option value="Operativa">Operativa</option>
                    <option value="Mantenimiento">Mantenimiento</option>
                    <option value="Fuera de servicio">Fuera de servicio</option>
                </select>
                <span asp-validation-for="EstadoOperativo" class="text-danger"></span>
            </div>

            <div class="maq-field maq-field-full">
                <label asp-for="Descripcion">Descripción</label>
                <textarea asp-for="Descripcion" class="form-control" rows="4" placeholder="Descripción breve de la máquina"></textarea>
                <span asp-validation-for="Descripcion" class="text-danger"></span>
            </div>

            <div class="maq-switch-row maq-field-full">
                <input asp-for="Activo" class="form-check-input" />
                <div>
                    <label asp-for="Activo">Máquina activa</label>
                    <p>Activa para mantenerla disponible en el catálogo.</p>
                </div>
            </div>

            <div class="maq-field maq-field-full">
                <label>Máquinas sustitutas</label>
                <p class="maq-help-text">Selecciona una o más máquinas que puedan sustituir a esta máquina cuando sea necesario.</p>

                @if (Model.MaquinasSustitutasDisponibles != null && Model.MaquinasSustitutasDisponibles.Any())
                {
                    <div class="maq-sub-grid">
                        @foreach (var maq in Model.MaquinasSustitutasDisponibles)
                        {
                            <label class="maq-sub-option">
                                <input type="checkbox"
                                       name="MaquinasSustitutasSeleccionadas"
                                       value="@maq.MaquinaID"
                                       @(maq.Seleccionada ? "checked" : null) />
                                <span>
                                    <strong>@maq.Codigo</strong>
                                    <small>@maq.Nombre</small>
                                    @if (!string.IsNullOrWhiteSpace(maq.Area) || !string.IsNullOrWhiteSpace(maq.EstadoOperativo))
                                    {
                                        <em>@maq.Area · @maq.EstadoOperativo</em>
                                    }
                                </span>
                            </label>
                        }
                    </div>
                }
                else
                {
                    <div class="maq-empty-sub">
                        No hay otras máquinas activas disponibles para asignar como sustitutas.
                    </div>
                }
            </div>
        </div>

        <div class="maq-form-actions">
            <a href="@Url.Action("Maquinaria", "Maquinaria")" class="maq-btn-secondary">
                <i class="fas fa-times"></i> Cancelar
            </a>
            <button type="submit" class="maq-btn-primary">
                <i class="fas fa-save"></i> Guardar máquina
            </button>
        </div>
    </form>
</div>

<style>
    .maq-form-page { width: min(100%, 1180px); margin: 0 auto; padding: clamp(1rem, 1.7vw, 1.6rem); }
    .maq-form-hero { display:flex; align-items:center; gap:1rem; padding:1.35rem; margin-bottom:1rem; border-radius:28px; background:linear-gradient(135deg,#0f1a2b,#17243a); color:#fff; box-shadow:0 22px 55px rgba(15,23,42,.18); }
    .maq-form-icon { width:58px; height:58px; border-radius:18px; display:grid; place-items:center; background:linear-gradient(135deg,#f47b20,#c2410c); box-shadow:0 16px 34px rgba(244,123,32,.32); font-size:1.3rem; }
    .maq-kicker { display:block; color:#ffb04a; font-weight:950; font-size:.75rem; letter-spacing:.12em; margin-bottom:.3rem; }
    .maq-form-hero h1 { margin:0; font-weight:950; letter-spacing:-.04em; }
    .maq-form-hero p { margin:.3rem 0 0; color:#dbeafe; font-weight:700; }
    .maq-form-card { background:rgba(255,255,255,.96); color:#0d1929; border:1px solid rgba(41,67,95,.14); border-radius:28px; padding:1.35rem; box-shadow:0 22px 55px rgba(41,67,95,.14); }
    .maq-form-grid { display:grid; grid-template-columns:repeat(2,minmax(0,1fr)); gap:1rem; }
    .maq-field label, .maq-switch-row label { display:block; font-weight:950; color:#0d1929; margin-bottom:.35rem; }
    .maq-field .form-control, .maq-field .form-select { min-height:48px; border-radius:14px; font-weight:800; border:1px solid rgba(41,67,95,.16); }
    .maq-field-full { grid-column:1 / -1; }
    .maq-switch-row { display:flex; gap:.8rem; align-items:center; padding:1rem; border:1px solid rgba(41,67,95,.12); border-radius:18px; background:#f8fafc; }
    .maq-switch-row p { margin:0; color:#64748b; font-weight:700; }
    .maq-help-text { margin:.15rem 0 .75rem; color:#64748b; font-weight:700; font-size:.9rem; }
    .maq-sub-grid { display:grid; grid-template-columns:repeat(3,minmax(0,1fr)); gap:.75rem; margin-top:.65rem; }
    .maq-sub-option { display:flex; gap:.7rem; align-items:flex-start; padding:.85rem; border:1px solid rgba(41,67,95,.14); border-radius:16px; background:#f8fafc; cursor:pointer; transition:all .18s ease; }
    .maq-sub-option:hover { border-color:#f47b20; background:#fff7ed; }
    .maq-sub-option input { width:18px; height:18px; margin-top:.2rem; accent-color:#f47b20; }
    .maq-sub-option strong { display:block; color:#0d1929; font-weight:950; line-height:1.15; }
    .maq-sub-option small { display:block; color:#29435f; font-weight:800; margin-top:.18rem; }
    .maq-sub-option em { display:block; color:#64748b; font-style:normal; font-size:.78rem; font-weight:700; margin-top:.2rem; }
    .maq-empty-sub { padding:.9rem; border:1px dashed rgba(41,67,95,.18); border-radius:16px; background:#f8fafc; color:#64748b; font-weight:800; }
    .maq-form-actions { display:flex; justify-content:flex-end; gap:.75rem; margin-top:1.2rem; padding-top:1rem; border-top:1px solid rgba(41,67,95,.12); }
    .maq-btn-primary, .maq-btn-secondary { border:0; min-height:44px; padding:.75rem 1.1rem; border-radius:14px; font-weight:950; text-decoration:none; display:inline-flex; align-items:center; gap:.45rem; }
    .maq-btn-primary { background:linear-gradient(135deg,#f47b20,#c2410c); color:#fff; box-shadow:0 14px 26px rgba(244,123,32,.25); }
    .maq-btn-secondary { background:#e8f0fb; color:#0d1929; }
    @@media (max-width: 768px) { .maq-form-grid, .maq-sub-grid { grid-template-columns:1fr; } .maq-form-actions { flex-direction:column-reverse; } .maq-btn-primary,.maq-btn-secondary { width:100%; justify-content:center; } }
</style>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
