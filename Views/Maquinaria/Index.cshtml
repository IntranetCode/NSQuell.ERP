    }

    html[data-nsq-theme="dark"] .maq-stat-label,
    html[data-nsq-theme="dark"] .maq-mobile-detail,
    html[data-nsq-theme="dark"] .empty-text {
        color: #cbd5e1;
    }

    html[data-nsq-theme="dark"] .maq-table tbody td {
        background: rgba(15,23,42,.78);
        border-top-color: rgba(255,255,255,.07);
        color: #cbd5e1;
    }

    html[data-nsq-theme="dark"] .maq-table tbody tr:hover td {
        color: #fff !important;
        background-color: rgba(244,123,32,.075) !important;
    }

    html[data-nsq-theme="dark"] .empty-state {
        background: transparent;
    }

    @@media (max-width: 1199.98px) {
        .maq-stats-grid { grid-template-columns: repeat(2, minmax(0, 1fr)); }
    }

    @@media (max-width: 991.98px) {
        .maq-hero-grid { grid-template-columns: 1fr; min-height: auto; }
        .maq-hero-side { min-height: 245px; border-right: 0; border-bottom: 1px solid rgba(255,255,255,.10); }
        .maq-search-form { width: 100%; max-width: none; margin-left: 0; }
    }

    @@media (max-width: 767.98px) {
        .maquinaria-page { padding: .85rem; }
        .maq-hero, .maq-list-card { border-radius: 22px; }
        .maq-hero-side, .maq-hero-main { padding: 1.1rem; }
        .maq-stats-grid { grid-template-columns: repeat(2, minmax(0, 1fr)); gap: .65rem; }
        .maq-search-group { display: grid; grid-template-columns: 1fr auto auto; border-radius: 18px; }
        .maq-search-group .form-select { grid-column: 1 / -1; max-width: none; width: 100%; border-right: 0 !important; border-bottom: 1px solid rgba(41,67,95,.10) !important; }
        .maq-table-wrap { display: none; }
        .maq-mobile-list { display: grid; }
        .maq-list-header { padding: 1rem; align-items: flex-start; flex-direction: column; gap: .3rem; }
    }

    @@media (max-width: 420px) {
        .maq-stats-grid { grid-template-columns: 1fr; }
        .maq-search-group { grid-template-columns: 1fr auto; }
        .maq-search-group .form-control { grid-column: 1 / 2; min-width: 0; }
        .maq-search-group .btn-clear { grid-column: 1 / -1; border-left: 0 !important; border-top: 1px solid rgba(41,67,95,.10) !important; }
    }
</style>

<div class="maquinaria-page">
    <section class="maq-hero">
        <div class="maq-hero-grid">
            <aside class="maq-hero-side">
                <div>
                    <div class="maq-icon-box">
                        <i class="fas fa-industry"></i>
                    </div>

                    <h1 class="maq-title">Administración de Maquinaria</h1>
                    <p class="maq-subtitle">
                        Gestiona el catálogo de máquinas, su área, estado operativo y disponibilidad.
                    </p>

                    <a href="@Url.Action("CrearMaquinaria", "Maquinaria")" class="maq-main-action">
                        <i class="fas fa-plus"></i>
                        Agregar máquina
                    </a>
                </div>

                <div class="maq-filter-note">
                    <i class="fas fa-filter me-1"></i>@EstadoFiltroLabel()
                </div>
            </aside>

            <main class="maq-hero-main">
                <form method="get" class="maq-search-form">
                    <div class="input-group maq-search-group">
                        <select name="filtroCampo" class="form-select flex-grow-0" aria-label="Campo de búsqueda">
                            <option value="Todos" selected="@Selected("Todos", filtroCampoActual)">Todos los campos</option>
                            <option value="Codigo" selected="@Selected("Codigo", filtroCampoActual)">Código</option>
                            <option value="Nombre" selected="@Selected("Nombre", filtroCampoActual)">Nombre</option>
                            <option value="Area" selected="@Selected("Area", filtroCampoActual)">Área</option>
                            <option value="EstadoOperativo" selected="@Selected("EstadoOperativo", filtroCampoActual)">Estado operativo</option>
                        </select>

                        <select name="estadoVista" class="form-select flex-grow-0" aria-label="Filtro de estado">
                            <option value="Todos" selected="@Selected("Todos", estadoVistaActual)">Todas</option>
                            <option value="Activas" selected="@Selected("Activas", estadoVistaActual)">Activas</option>
                            <option value="Inactivas" selected="@Selected("Inactivas", estadoVistaActual)">Inactivas</option>
                            <option value="Operativas" selected="@Selected("Operativas", estadoVistaActual)">Operativas</option>
                        </select>

                        <input type="text"
                               name="busqueda"
                               class="form-control"
                               placeholder="Buscar máquina..."
                               value="@busquedaActual"
                               aria-label="Buscar maquinaria" />

                        <button class="btn btn-search" type="submit" title="Buscar">
                            <i class="fas fa-search"></i>
                        </button>

                        @if (!string.IsNullOrWhiteSpace(busquedaActual) || filtroCampoActual != "Todos" || estadoVistaActual != "Todos")
                        {
                            <a href="@Url.Action("Maquinaria", "Maquinaria")"
                               class="btn btn-clear"
                               title="Limpiar filtros">
                                <i class="fas fa-times"></i>
                            </a>
                        }
                    </div>
                </form>

                <div class="maq-stats-grid">
                    <div class="maq-stat-card">
                        <div class="maq-stat-icon"><i class="fas fa-cogs"></i></div>
                        <div>
                            <p class="maq-stat-value">@totalMaquinas</p>
                            <p class="maq-stat-label">Mostradas</p>
                        </div>
                    </div>

                    <div class="maq-stat-card">
                        <div class="maq-stat-icon success"><i class="fas fa-check-circle"></i></div>
                        <div>
                            <p class="maq-stat-value">@totalOperativas</p>
                            <p class="maq-stat-label">Operativas</p>
                        </div>
                    </div>

                    <div class="maq-stat-card">
                        <div class="maq-stat-icon warning"><i class="fas fa-power-off"></i></div>
                        <div>
                            <p class="maq-stat-value">@totalActivas</p>
                            <p class="maq-stat-label">Activas</p>
                        </div>
                    </div>

                    <div class="maq-stat-card">
                        <div class="maq-stat-icon danger"><i class="fas fa-ban"></i></div>
                        <div>
                            <p class="maq-stat-value">@totalInactivas</p>
                            <p class="maq-stat-label">Inactivas</p>
                        </div>
                    </div>
                </div>
            </main>
        </div>
    </section>

    @if (!string.IsNullOrWhiteSpace(mensajeError))
    {
        <div class="alert alert-danger fw-bold">
            <i class="fas fa-exclamation-circle me-1"></i>@mensajeError
        </div>
    }

    <section class="maq-list-card">
        <div class="maq-list-header">
            <h2 class="maq-list-title">
                <i class="fas fa-clipboard-list"></i>
                Catálogo de maquinaria
            </h2>
            <div class="maq-list-count">
                @totalMaquinas @(totalMaquinas == 1 ? "registro encontrado" : "registros encontrados")
            </div>
        </div>

        @if (maquinas.Any())
        {
            <div class="table-responsive maq-table-wrap">
                <table class="table maq-table align-middle">
                    <thead>
                        <tr>
                            <th>Código</th>
                            <th>Nombre</th>
                            <th>Área</th>
                            <th>Sustitutas</th>
                            <th>Estado operativo</th>
                            <th>Estado</th>
                            <th class="text-end">Acciones</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in maquinas)
                        {
                            var codigo = CodigoCorto(item.Codigo);
                            var nombre = Safe(item.Nombre);
                            var area = Safe(item.Area);
                            var estado = EstadoTexto(item.EstadoOperativo);
                            var esOperativa = string.Equals(estado, "Operativa", StringComparison.OrdinalIgnoreCase);

                            <tr>
                                <td>
                                    <div class="maq-code-cell">
                                        <span class="maq-avatar">@InicialCodigo(codigo)</span>
                                        <div>
                                            <div class="maq-code-main">@codigo</div>
                                            <div class="maq-code-sub">ID @item.MaquinaID</div>
                                        </div>
                                    </div>
                                </td>

                                <td>
                                    <div class="maq-name-main">@(string.IsNullOrWhiteSpace(nombre) ? codigo : nombre)</div>
                                    @if (!string.IsNullOrWhiteSpace(item.Descripcion))
                                    {
                                        <div class="maq-code-sub">@item.Descripcion</div>
                                    }
                                </td>

                                <td>
                                    <span class="maq-pill area">
                                        <i class="fas fa-industry"></i>
                                        @(string.IsNullOrWhiteSpace(area) ? "Sin área" : area)
                                    </span>
                                </td>

                                <td>
                                    @if (item.TotalMaquinasSustitutas > 0)
                                    {
                                        <div class="maq-sub-list">
                                            <span class="maq-sub-count">
                                                <i class="fas fa-random"></i>
                                                @item.TotalMaquinasSustitutas sustituta@(item.TotalMaquinasSustitutas == 1 ? "" : "s")
                                            </span>
                                            <span class="maq-sub-text">@item.MaquinasSustitutasTexto</span>
                                        </div>
                                    }
                                    else
                                    {
                                        <span class="maq-code-sub">Sin sustitutas</span>
                                    }
                                </td>

                                <td>
                                    <span class="maq-pill @(esOperativa ? "estado-ok" : "estado-alerta")">
                                        <i class="@(esOperativa ? "fas fa-circle-check" : "fas fa-triangle-exclamation")"></i>
                                        @estado
                                    </span>
                                </td>

                                <td>
                                    <span class="maq-pill @(item.Activo ? "activo" : "inactivo")">
                                        <i class="@(item.Activo ? "fas fa-check-circle" : "fas fa-circle-xmark")"></i>
                                        @(item.Activo ? "Activo" : "Inactivo")
                                    </span>
                                </td>

                                <td class="text-end">
                                    <a class="maq-action-btn"
                                       href="@Url.Action("EditarMaquinaria", "Maquinaria", new { id = item.MaquinaID })">
                                        <i class="fas fa-pencil-alt"></i>
                                        Editar
                                    </a>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>

            <div class="maq-mobile-list">
                @foreach (var item in maquinas)
                {
                    var codigo = CodigoCorto(item.Codigo);
                    var nombre = Safe(item.Nombre);
                    var area = Safe(item.Area);
                    var estado = EstadoTexto(item.EstadoOperativo);
                    var esOperativa = string.Equals(estado, "Operativa", StringComparison.OrdinalIgnoreCase);

                    <article class="maq-mobile-card">
                        <div class="maq-mobile-head">
                            <div class="maq-mobile-title">
                                <span class="maq-avatar">@InicialCodigo(codigo)</span>
                                <div>
                                    <div class="maq-code-main">@codigo</div>
                                    <div class="maq-code-sub">ID @item.MaquinaID</div>
                                </div>
                            </div>

                            <span class="maq-pill @(item.Activo ? "activo" : "inactivo")">
                                <i class="@(item.Activo ? "fas fa-check-circle" : "fas fa-circle-xmark")"></i>
                                @(item.Activo ? "Activo" : "Inactivo")
                            </span>
                        </div>

                        <div class="maq-mobile-detail">
                            <div>
                                <i class="fas fa-cog"></i>
                                <span><strong>Nombre:</strong> @(string.IsNullOrWhiteSpace(nombre) ? codigo : nombre)</span>
                            </div>
                            <div>
                                <i class="fas fa-industry"></i>
                                <span><strong>Área:</strong> @(string.IsNullOrWhiteSpace(area) ? "Sin área" : area)</span>
                            </div>
                            <div>
                                <i class="fas fa-gauge-high"></i>
                                <span><strong>Estado operativo:</strong> @estado</span>
                            </div>
                            <div>
                                <i class="fas fa-random"></i>
                                <span><strong>Sustitutas:</strong> @(item.TotalMaquinasSustitutas > 0 ? item.MaquinasSustitutasTexto : "Sin sustitutas")</span>
                            </div>
                            <div class="mt-2">
                                <a class="maq-action-btn"
                                   href="@Url.Action("EditarMaquinaria", "Maquinaria", new { id = item.MaquinaID })">
                                    <i class="fas fa-pencil-alt"></i>
                                    Editar
                                </a>
                            </div>
                        </div>
                    </article>
                }
            </div>
        }
        else
        {
            <div class="empty-state">
                <div class="empty-icon">
                    <i class="fas fa-cogs"></i>
                </div>
                <h3 class="empty-title">No hay maquinaria para mostrar</h3>
                <p class="empty-text">
                    Ajusta el filtro de búsqueda o verifica que existan registros en dbo.ERP_Maquinas.
                </p>
            </div>
        }
    </section>
</div>

@functions {
    public class MaquinaVistaVm
    {
        public int MaquinaID { get; set; }
        public string Codigo { get; set; } = "";
        public string Nombre { get; set; } = "";
        public string Area { get; set; } = "";
        public string EstadoOperativo { get; set; } = "";
        public string Descripcion { get; set; } = "";
        public bool Activo { get; set; }
        public DateTime? FechaCreacion { get; set; }
        public DateTime? FechaModificacion { get; set; }
        public int TotalMaquinasSustitutas { get; set; }
        public string MaquinasSustitutasTexto { get; set; } = "";
    }
}
