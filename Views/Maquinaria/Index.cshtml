@using Microsoft.Data.SqlClient
@using Microsoft.EntityFrameworkCore
@using Microsoft.AspNetCore.Http
@using System
@using System.Linq
@using System.Collections.Generic
@inject ERP.NSQuell.Models.ApplicationDbContext DbContext

@{
    Layout = "_LayoutMaquinaria";
    ViewData["Title"] = "Altas de Maquinaria";

    var busquedaActual = Context.Request.Query["busqueda"].ToString().Trim();
    var filtroCampoActual = Context.Request.Query["filtroCampo"].ToString().Trim();
    filtroCampoActual = string.IsNullOrWhiteSpace(filtroCampoActual) ? "Todos" : filtroCampoActual;

    var estadoVistaActual = Context.Request.Query["estadoVista"].ToString().Trim();
    estadoVistaActual = string.IsNullOrWhiteSpace(estadoVistaActual) ? "Todos" : estadoVistaActual;

    var maquinas = new List<MaquinaVistaVm>();
    var mensajeError = "";

    string Safe(string? texto) => string.IsNullOrWhiteSpace(texto) ? "" : texto.Trim();
    string EstadoTexto(string? estado) => string.IsNullOrWhiteSpace(estado) ? "Sin estado" : estado.Trim();
    string? Selected(string value, string current) => string.Equals(value, current, StringComparison.OrdinalIgnoreCase) ? "selected" : null;

    string EstadoFiltroLabel()
    {
        if (string.Equals(estadoVistaActual, "Activas", StringComparison.OrdinalIgnoreCase)) return "Máquinas activas";
        if (string.Equals(estadoVistaActual, "Inactivas", StringComparison.OrdinalIgnoreCase)) return "Máquinas inactivas";
        if (string.Equals(estadoVistaActual, "Operativas", StringComparison.OrdinalIgnoreCase)) return "Máquinas operativas";
        return "Todas las máquinas";
    }

    string CodigoCorto(string? codigo)
    {
        codigo = Safe(codigo);
        return string.IsNullOrWhiteSpace(codigo) ? "S/C" : codigo;
    }

    string InicialCodigo(string? codigo)
    {
        codigo = CodigoCorto(codigo);
        return codigo.Length > 5 ? codigo.Substring(0, 5) : codigo;
    }

    try
    {
        var cnn = DbContext.Database.GetConnectionString();

        if (string.IsNullOrWhiteSpace(cnn))
        {
            mensajeError = "No se encontró la cadena de conexión para consultar la maquinaria.";
        }
        else
        {
            await using var conn = new SqlConnection(cnn);
            await conn.OpenAsync();

            const string sql = @"
                SELECT
                    M.MaquinaID,
                    M.Codigo,
                    M.Nombre,
                    M.Area,
                    M.EstadoOperativo,
                    M.Descripcion,
                    M.Activo,
                    M.FechaCreacion,
                    M.FechaModificacion,
                    ISNULL(Sust.TotalMaquinasSustitutas, 0) AS TotalMaquinasSustitutas,
                    ISNULL(Sust.MaquinasSustitutasTexto, '') AS MaquinasSustitutasTexto
                FROM dbo.ERP_Maquinas AS M
                OUTER APPLY
                (
                    SELECT
                        COUNT(1) AS TotalMaquinasSustitutas,
                        STUFF((
                            SELECT ', ' + ISNULL(S.Codigo, '') +
                                   CASE 
                                       WHEN NULLIF(LTRIM(RTRIM(ISNULL(S.Nombre, ''))), '') IS NOT NULL 
                                       THEN ' - ' + S.Nombre 
                                       ELSE '' 
                                   END
                            FROM dbo.ERP_MaquinasSustitutas AS MS2
                            INNER JOIN dbo.ERP_Maquinas AS S
                                ON S.MaquinaID = MS2.MaquinaSustitutaID
                            WHERE MS2.MaquinaPrincipalID = M.MaquinaID
                              AND MS2.Activo = 1
                              AND S.Activo = 1
                            ORDER BY ISNULL(MS2.Prioridad, 999), S.Codigo, S.Nombre
                            FOR XML PATH(''), TYPE
                        ).value('.', 'nvarchar(max)'), 1, 2, '') AS MaquinasSustitutasTexto
                    FROM dbo.ERP_MaquinasSustitutas AS MS
                    INNER JOIN dbo.ERP_Maquinas AS S2
                        ON S2.MaquinaID = MS.MaquinaSustitutaID
                    WHERE MS.MaquinaPrincipalID = M.MaquinaID
                      AND MS.Activo = 1
                      AND S2.Activo = 1
                ) AS Sust
                WHERE
                    (
                        @Busqueda = ''
                        OR (@FiltroCampo = 'Todos' AND (
                            M.Codigo LIKE @Like
                            OR M.Nombre LIKE @Like
                            OR M.Area LIKE @Like
                            OR M.EstadoOperativo LIKE @Like
                            OR ISNULL(M.Descripcion, '') LIKE @Like
                            OR ISNULL(Sust.MaquinasSustitutasTexto, '') LIKE @Like
                        ))
                        OR (@FiltroCampo = 'Codigo' AND M.Codigo LIKE @Like)
                        OR (@FiltroCampo = 'Nombre' AND M.Nombre LIKE @Like)
                        OR (@FiltroCampo = 'Area' AND M.Area LIKE @Like)
                        OR (@FiltroCampo = 'EstadoOperativo' AND M.EstadoOperativo LIKE @Like)
                    )
                    AND (
                        @EstadoVista = 'Todos'
                        OR (@EstadoVista = 'Activas' AND M.Activo = 1)
                        OR (@EstadoVista = 'Inactivas' AND M.Activo = 0)
                        OR (@EstadoVista = 'Operativas' AND M.EstadoOperativo = 'Operativa')
                    )
                ORDER BY
                    M.Area,
                    CASE
                        WHEN PATINDEX('%[^0-9]%', M.Codigo + 'X') > 1
                        THEN TRY_CONVERT(INT, LEFT(M.Codigo, PATINDEX('%[^0-9]%', M.Codigo + 'X') - 1))
                        ELSE NULL
                    END,
                    M.Codigo,
                    M.Nombre;";

            await using var cmd = new SqlCommand(sql, conn);
            cmd.Parameters.AddWithValue("@Busqueda", busquedaActual);
            cmd.Parameters.AddWithValue("@Like", $"%{busquedaActual}%");
            cmd.Parameters.AddWithValue("@FiltroCampo", filtroCampoActual);
            cmd.Parameters.AddWithValue("@EstadoVista", estadoVistaActual);

            await using var rd = await cmd.ExecuteReaderAsync();

            while (await rd.ReadAsync())
            {
                maquinas.Add(new MaquinaVistaVm
                {
                    MaquinaID = rd["MaquinaID"] == DBNull.Value ? 0 : Convert.ToInt32(rd["MaquinaID"]),
                    Codigo = rd["Codigo"]?.ToString() ?? "",
                    Nombre = rd["Nombre"]?.ToString() ?? "",
                    Area = rd["Area"]?.ToString() ?? "",
                    EstadoOperativo = rd["EstadoOperativo"]?.ToString() ?? "",
                    Descripcion = rd["Descripcion"]?.ToString() ?? "",
                    Activo = rd["Activo"] != DBNull.Value && Convert.ToBoolean(rd["Activo"]),
                    FechaCreacion = rd["FechaCreacion"] == DBNull.Value ? null : Convert.ToDateTime(rd["FechaCreacion"]),
                    FechaModificacion = rd["FechaModificacion"] == DBNull.Value ? null : Convert.ToDateTime(rd["FechaModificacion"]),
                    TotalMaquinasSustitutas = rd["TotalMaquinasSustitutas"] == DBNull.Value ? 0 : Convert.ToInt32(rd["TotalMaquinasSustitutas"]),
                    MaquinasSustitutasTexto = rd["MaquinasSustitutasTexto"]?.ToString() ?? ""
                });
            }
        }
    }
    catch (Exception ex)
    {
        mensajeError = "No se pudo cargar la información de maquinaria: " + ex.Message;
    }

    var totalMaquinas = maquinas.Count;
    var totalOperativas = maquinas.Count(x => string.Equals(Safe(x.EstadoOperativo), "Operativa", StringComparison.OrdinalIgnoreCase));
    var totalActivas = maquinas.Count(x => x.Activo);
    var totalInactivas = maquinas.Count(x => !x.Activo);
}

