@model ERP.NSQuell.Models.ViewModels.Logistica.LogisticaViajesIndexVm
@{
    ViewData["Title"] = "Viajes";
    Layout = "_Layout";
    var paginaActual = ViewBag.PaginaActual is int p ? p : 1;
    var totalPaginas = ViewBag.TotalPaginas is int tp ? tp : 1;
    var totalRegistros = ViewBag.TotalRegistros is long tr ? tr : 0L;
    string BadgeEstatus(string estatus) => estatus switch
    {
        "Programado" => "bg-primary",
        "En curso" => "bg-warning text-dark",
        "Completado" => "bg-success",
        "Cancelado" => "bg-secondary",
        _ => "bg-light text-dark"
    };
    string TipoVisible(string? tipo) => string.IsNullOrWhiteSpace(tipo) ? "-" : tipo.Trim().Replace("Entrega PT", "Entrega", StringComparison.OrdinalIgnoreCase).Replace("Entrega NS", "Entrega", StringComparison.OrdinalIgnoreCase);
    string OperacionVisible(string? operacion) => string.IsNullOrWhiteSpace(operacion) ? "Parada operativa" : operacion.Trim().Replace("Entrega PT", "Entrega", StringComparison.OrdinalIgnoreCase).Replace("Entrega NS", "Entrega", StringComparison.OrdinalIgnoreCase);
}
<style>
    :root {
        --lv-blue: #173a7a;
        --lv-text: #172033;
        --lv-muted: #6d7888;
        --lv-border: #dce4ee;
        --lv-soft: #f6f8fb;
        --lv-shadow: 0 8px 24px rgba(22,42,75,.06)
    }

    .viajes-page {
        max-width: 1720px;
        margin: 0 auto;
        padding: 18px 20px 30px;
        color: var(--lv-text)
    }

    .viajes-header {
        display: flex;
        justify-content: space-between;
        align-items: center;
        gap: 12px;
        flex-wrap: wrap;
        padding: 15px 17px;
        margin-bottom: 14px;
        border: 1px solid var(--lv-border);
        border-left: 4px solid var(--lv-blue);
        border-radius: 12px;
        background: #fff;
        box-shadow: var(--lv-shadow)
    }

    .viajes-title {
        margin: 0;
        color: var(--lv-text);
        font-size: 1.48rem;
        font-weight: 800;
        letter-spacing: -.02em
    }

        .viajes-title i {
            color: var(--lv-blue)
        }

    .viajes-subtitle {
        margin: 3px 0 0;
        color: var(--lv-muted);
        font-size: .88rem;
        font-weight: 500
    }

    .header-actions {
        display: flex;
        gap: 7px;
        flex-wrap: wrap
    }

        .header-actions .btn {
            min-height: 35px;
            border-radius: 8px;
            font-weight: 700;
            display: inline-flex;
            align-items: center
        }

    .resumen-strip {
        display: grid;
        grid-template-columns: repeat(6,minmax(130px,1fr));
        gap: 8px;
        margin-bottom: 14px
    }

    .resumen-item {
        min-height: 72px;
        padding: 10px 12px;
        border: 1px solid var(--lv-border);
        border-radius: 10px;
        background: #fff;
        box-shadow: 0 4px 13px rgba(22,42,75,.035)
    }

        .resumen-item strong {
            display: block;
            margin-bottom: 3px;
            color: var(--lv-blue);
            font-size: 1.22rem;
            font-weight: 800
        }

        .resumen-item span {
            display: block;
            color: var(--lv-muted);
            font-size: .7rem;
            font-weight: 700
        }

    .filtros {
        display: grid;
        grid-template-columns: minmax(230px,2fr) repeat(4,minmax(135px,1fr)) auto auto;
        gap: 8px;
        align-items: end;
        margin-bottom: 14px;
        padding: 14px 12px 12px;
        border: 1px solid var(--lv-border);
        border-radius: 12px;
        background: #fff;
        box-shadow: 0 5px 16px rgba(25,47,80,.035)
    }

        .filtros label {
            display: block;
            margin-bottom: 3px;
            color: #465164;
            font-size: .76rem;
            font-weight: 700
        }

        .filtros .form-control, .filtros .form-select {
            min-height: 38px;
            border-radius: 8px;
            border-color: #d4dde7;
            font-size: .84rem
        }

        .filtros .btn {
            min-height: 38px;
            border-radius: 8px;
            font-weight: 700
        }

    .table-wrap {
        width: 100%;
        overflow-x: auto;
        border: 1px solid var(--lv-border);
        border-radius: 12px;
        background: #fff;
        box-shadow: var(--lv-shadow)
    }

    .viajes-table {
        margin-bottom: 0;
        background: #fff;
        font-size: .81rem;
        vertical-align: middle
    }

        .viajes-table thead th {
            padding: .58rem .56rem;
            color: #4c5868;
            background: #f3f6f9;
            border-bottom: 1px solid #d8e1ea;
            font-size: .7rem;
            font-weight: 800;
            text-transform: uppercase;
            white-space: nowrap
        }

        .viajes-table tbody td {
            padding: .56rem;
            border-color: #edf0f4;
            vertical-align: middle
        }

        .viajes-table tbody tr:nth-child(even) td {
            background: #fbfcfd
        }

        .viajes-table tbody tr:hover td {
            background: #f4f8fc
        }

    .folio {
        color: var(--lv-blue);
        font-weight: 800;
        white-space: nowrap
    }

    .ruta {
        min-width: 150px;
        max-width: 230px
    }

    .texto-corto {
        display: block;
        overflow: hidden;
        max-width: 230px;
        text-overflow: ellipsis;
        white-space: nowrap
    }

    .badge-mini {
        font-size: .7rem;
        padding: .35em .55em;
        font-weight: 600
    }


    .route-cell {
        min-width: 220px;
        max-width: 300px
    }

    .route-main {
        display: flex;
        align-items: center;
        gap: 6px;
        min-width: 0
    }

        .route-main i {
            color: #7e8ca0;
            font-size: .65rem;
            flex: 0 0 auto
        }

    .route-point {
        display: block;
        min-width: 0;
        overflow: hidden;
        text-overflow: ellipsis;
        white-space: nowrap;
        font-weight: 700
    }

    .multi-badge {
        display: inline-flex;
        align-items: center;
        gap: 4px;
        margin-top: 4px;
        padding: .22rem .42rem;
        border: 1px solid #bad1f1;
        border-radius: 999px;
        background: #f2f7ff;
        color: #315b96;
        font-size: .64rem;
        font-weight: 800;
        white-space: nowrap
    }

    .stops-cell {
        min-width: 145px
    }

    .stops-number {
        display: flex;
        align-items: baseline;
        justify-content: space-between;
        gap: 8px;
        font-weight: 800
    }

        .stops-number small {
            color: var(--lv-muted);
            font-size: .65rem;
            font-weight: 700
        }

    .stops-progress {
        height: 5px;
        margin-top: 5px;
        overflow: hidden;
        border-radius: 999px;
        background: #e8edf3
    }

        .stops-progress > span {
            display: block;
            height: 100%;
            border-radius: inherit;
            background: var(--lv-blue)
        }

    .next-stop {
        min-width: 220px;
        max-width: 310px
    }

    .next-stop-main {
        display: flex;
        align-items: flex-start;
        gap: 7px
    }

    .next-stop-seq {
        display: inline-flex;
        width: 24px;
        height: 24px;
        align-items: center;
        justify-content: center;
        flex: 0 0 24px;
        border-radius: 50%;
        background: #edf4ff;
        color: var(--lv-blue);
        font-size: .68rem;
        font-weight: 900
    }

    .next-stop-name {
        display: block;
        max-width: 235px;
        overflow: hidden;
        color: #23334d;
        font-weight: 800;
        text-overflow: ellipsis;
        white-space: nowrap
    }

    .next-stop-meta {
        display: block;
        margin-top: 1px;
        color: var(--lv-muted);
        font-size: .66rem
    }

    .route-complete {
        color: #198754;
        font-size: .72rem;
        font-weight: 800
    }

    .route-pending {
        color: #7a8492;
        font-size: .7rem;
        font-weight: 700
    }

    .acciones {
        white-space: nowrap;
        text-align: right
    }

        .acciones .btn {
            min-width: 31px;
            min-height: 29px;
            padding: .25rem .45rem;
            border-radius: 7px;
            display: inline-flex;
            align-items: center;
            justify-content: center
        }

    .state-note {
        margin-top: 2px;
        font-size: .66rem;
        font-weight: 600
    }

        .state-note.warning {
            color: #a06600
        }

        .state-note.info {
            color: #345cc4
        }

    .empty-state {
        min-height: 160px;
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
        color: #7a8492;
        background: #fbfcfd
    }

    .tabla-footer {
        display: flex;
        justify-content: space-between;
        align-items: center;
        gap: 12px;
        flex-wrap: wrap;
        margin-top: 10px;
        padding: 10px 4px 0;
        border-top: 1px solid #e5eaf0;
        color: #6c757d;
        font-size: .82rem
    }

    .pagination .page-link {
        margin: 0 2px;
        border-radius: 6px;
        color: #314d86;
        border-color: #dbe3ec;
        font-weight: 600
    }

    .pagination .page-item.active .page-link {
        background: #233f80;
        border-color: #233f80
    }

    html[data-nsq-theme="dark"] .viajes-page {
        color: #e7edf6
    }

    html[data-nsq-theme="dark"] .viajes-header, html[data-nsq-theme="dark"] .resumen-item, html[data-nsq-theme="dark"] .filtros, html[data-nsq-theme="dark"] .table-wrap {
        background: #111b2d;
        border-color: #2a3a50;
        box-shadow: none
    }

    html[data-nsq-theme="dark"] .viajes-title {
        color: #eef4fb
    }

    html[data-nsq-theme="dark"] .viajes-subtitle, html[data-nsq-theme="dark"] .resumen-item span {
        color: #9eacbf
    }

    html[data-nsq-theme="dark"] .filtros label {
        color: #c7d3e2
    }

    html[data-nsq-theme="dark"] .filtros .form-control, html[data-nsq-theme="dark"] .filtros .form-select {
        background: #0d1727;
        color: #eef4fb;
        border-color: #314158
    }

    html[data-nsq-theme="dark"] .viajes-table {
        background: #111b2d
    }

        html[data-nsq-theme="dark"] .viajes-table thead th {
            background: #162237;
            border-color: #2a3a50;
            color: #cbd7e6
        }

        html[data-nsq-theme="dark"] .viajes-table tbody td {
            border-color: #243349
        }

        html[data-nsq-theme="dark"] .viajes-table tbody tr:nth-child(even) td {
            background: #101a2a
        }

        html[data-nsq-theme="dark"] .viajes-table tbody tr:hover td {
            background: #17253a
        }


    html[data-nsq-theme="dark"] .multi-badge {
        background: #152742;
        border-color: #34557e;
        color: #b8d2f4
    }

    html[data-nsq-theme="dark"] .stops-progress {
        background: #26364b
    }

    html[data-nsq-theme="dark"] .next-stop-seq {
        background: #1d3354;
        color: #c5dbfb
    }

    html[data-nsq-theme="dark"] .next-stop-name {
        color: #e7edf6
    }

    @@media(max-width:1200px) {
        .resumen-strip {
            grid-template-columns: repeat(3,minmax(0,1fr))
        }

        .filtros {
            grid-template-columns: repeat(4,minmax(150px,1fr))
        }

            .filtros .filtro-busqueda {
                grid-column: span 2
            }
    }

    @@media(max-width:768px) {
        .viajes-page {
            padding: 14px 10px 24px
        }

        .header-actions {
            width: 100%
        }

            .header-actions .btn {
                flex: 1
            }

        .resumen-strip {
            grid-template-columns: repeat(2,minmax(0,1fr))
        }

        .filtros {
            grid-template-columns: 1fr 1fr
        }

            .filtros .filtro-busqueda {
                grid-column: 1/-1
            }

            .filtros .btn {
                width: 100%
            }
    }

    @@media(max-width:480px) {
        .resumen-strip, .filtros {
            grid-template-columns: 1fr
        }

            .filtros .filtro-busqueda {
                grid-column: auto
            }
    }
</style>

<div class="viajes-page">
    <div class="viajes-header">
        <div>
            <h1 class="viajes-title"><i class="fa-solid fa-route me-1"></i>Viajes</h1>
            <p class="viajes-subtitle">Programación y seguimiento de rutas de personal, recolecciones, traslados y entregas operativas.</p>
        </div>
        <div class="header-actions">
            <a asp-controller="LogisticaViajes" asp-action="Choferes" class="btn btn-outline-primary btn-sm"><i class="fa-solid fa-id-card me-1"></i>Choferes</a>
            <a asp-controller="LogisticaViajes" asp-action="Calendario" class="btn btn-outline-secondary btn-sm"><i class="fa-solid fa-calendar-days me-1"></i>Calendario</a>
            <a asp-controller="LogisticaViajes" asp-action="Crear" class="btn btn-primary btn-sm"><i class="fa-solid fa-plus me-1"></i>Nuevo viaje</a>
        </div>
    </div>

    @if (TempData["LogisticaOk"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show py-2 px-3 mb-3" role="alert"><i class="fa-solid fa-circle-check me-1"></i>@TempData["LogisticaOk"]<button type="button" class="btn-close" data-bs-dismiss="alert"></button></div>
    }
    @if (TempData["LogisticaError"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show py-2 px-3 mb-3" role="alert"><i class="fa-solid fa-triangle-exclamation me-1"></i>@TempData["LogisticaError"]<button type="button" class="btn-close" data-bs-dismiss="alert"></button></div>
    }

    <div class="resumen-strip">
        <div class="resumen-item"><strong>@Model.TotalViajes</strong><span>Total viajes</span></div>
        <div class="resumen-item"><strong>@Model.Programados</strong><span>Programados</span></div>
        <div class="resumen-item"><strong>@Model.EnCurso</strong><span>En curso</span></div>
        <div class="resumen-item"><strong>@Model.Completados</strong><span>Completados</span></div>
        <div class="resumen-item"><strong>@Model.ViajesHoy</strong><span>Programados hoy</span></div>
        <div class="resumen-item"><strong>@Model.RetornosPendientes</strong><span>Retornos pendientes</span></div>
    </div>

    <form asp-controller="LogisticaViajes" asp-action="Index" method="get" class="filtros">
        <div class="filtro-busqueda">
            <label>Buscar</label>
            <input type="text" name="q" value="@Model.Busqueda" class="form-control" placeholder="Folio, origen, destino, motivo o chofer" />
        </div>
        <div>
            <label>Estatus</label>
            <select name="estatus" class="form-select">
                <option value="">Todos</option>
                <option value="Programado" selected="@(Model.Estatus == "Programado")">Programado</option>
                <option value="En curso" selected="@(Model.Estatus == "En curso")">En curso</option>
                <option value="Completado" selected="@(Model.Estatus == "Completado")">Completado</option>
                <option value="Cancelado" selected="@(Model.Estatus == "Cancelado")">Cancelado</option>
            </select>
        </div>
        <div>
            <label>Tipo de salida</label>
            <select name="tipoViaje" class="form-select">
                <option value="">Todos</option>
                <option value="Entrega PT" selected="@(Model.TipoViaje == "Entrega PT")">Entrega</option>
                <option value="Ruta multipropósito" selected="@(Model.TipoViaje == "Ruta multipropósito")">Ruta multiparada</option>
                <option value="Ruta de personal" selected="@(Model.TipoViaje == "Ruta de personal")">Ruta de personal</option>
                <option value="Recolección de MP" selected="@(Model.TipoViaje == "Recolección de MP")">Recolección de MP</option>
                <option value="Traslado entre plantas" selected="@(Model.TipoViaje == "Traslado entre plantas")">Traslado entre plantas</option>
                <option value="Recolección de material" selected="@(Model.TipoViaje == "Recolección de material")">Recolección de material</option>
                <option value="Entrega / recolección especial" selected="@(Model.TipoViaje == "Entrega / recolección especial")">Entrega / recolección especial</option>
                <option value="Otro" selected="@(Model.TipoViaje == "Otro")">Otro</option>
            </select>
        </div>
        <div>
            <label>Desde</label>
            <input type="date" name="fechaDesde" value="@(Model.FechaDesde?.ToString("yyyy-MM-dd"))" class="form-control" />
        </div>
        <div>
            <label>Hasta</label>
            <input type="date" name="fechaHasta" value="@(Model.FechaHasta?.ToString("yyyy-MM-dd"))" class="form-control" />
        </div>
        <div><button type="submit" class="btn btn-dark btn-sm w-100"><i class="fa-solid fa-magnifying-glass me-1"></i>Filtrar</button></div>
        <div><a asp-controller="LogisticaViajes" asp-action="Index" class="btn btn-outline-secondary btn-sm w-100">Limpiar</a></div>
    </form>

    <div class="table-wrap">
        <table class="table table-hover table-sm viajes-table">
            <thead>
                <tr>
                    <th>Folio</th>
                    <th>Fecha / hora</th>
                    <th>Tipo</th>
                    <th>Recorrido</th>
                    <th>Paradas</th>
                    <th>Próxima parada</th>
                    <th>Unidad</th>
                    <th>Chofer</th>
                    <th>Estatus</th>
                    <th>Inc.</th>
                    <th class="text-end">Acción</th>
                </tr>
            </thead>
            <tbody>
                @if (Model.Viajes == null || Model.Viajes.Count == 0)
                {
                    <tr><td colspan="11"><div class="empty-state"><i class="fa-solid fa-route fa-2x mb-2"></i><div>No hay viajes que coincidan con los filtros.</div></div></td></tr>
                }
                else
                {
                    foreach (var viaje in Model.Viajes)
                    {
                        var esEntrega = string.Equals(viaje.TipoViaje, "Entrega PT", StringComparison.OrdinalIgnoreCase);
                        var tieneParadas = viaje.TotalParadas > 0;
                        var porcentajeParadas = Math.Max(0m, Math.Min(100m, viaje.PorcentajeParadas));
                        <tr>
                            <td>
                                <span class="folio">@viaje.Folio</span>
                                @if (viaje.EsMultiParada)
                                {
                                    <div><span class="multi-badge"><i class="fa-solid fa-code-branch"></i>Multi-parada</span></div>
                                }
                            </td>
                            <td class="text-nowrap">
                                <div>@viaje.FechaProgramada.ToString("dd/MM/yyyy")</div>
                                @if (viaje.HoraSalidaProgramada.HasValue)
                                {
                                    <small class="text-muted">@viaje.HoraSalidaProgramada.Value.ToString(@"hh\:mm")</small>
                                }
                                else
                                {
                                    <small class="state-note warning">Hora pendiente</small>
                                }
                            </td>
                            <td><span class="texto-corto" title="@TipoVisible(viaje.TipoViaje)">@TipoVisible(viaje.TipoViaje)</span></td>
                            <td class="route-cell">
                                <div class="route-main" title="@viaje.Origen → @viaje.Destino">
                                    <span class="route-point">@(!string.IsNullOrWhiteSpace(viaje.Origen) ? viaje.Origen : "Origen pendiente")</span>
                                    <i class="fa-solid fa-arrow-right"></i>
                                    <span class="route-point">@(!string.IsNullOrWhiteSpace(viaje.Destino) ? viaje.Destino : "Destino pendiente")</span>
                                </div>
                                @if (viaje.EsMultiParada && tieneParadas)
                                {
                                    <div class="state-note info">@viaje.TotalParadas parada(s) en la ruta</div>
                                }
                            </td>
                            <td class="stops-cell">
                                @if (tieneParadas)
                                {
                                    <div class="stops-number"><span>@viaje.ParadasCompletadas / @viaje.TotalParadas</span><small>@porcentajeParadas.ToString("N0")%</small></div>
                                    <div class="stops-progress" title="@porcentajeParadas.ToString("N1")% atendido"><span style="width:@porcentajeParadas.ToString("0.##", System.Globalization.CultureInfo.InvariantCulture)%"></span></div>
                                    @if (viaje.ParadasPendientes > 0)
                                    {
                                        <div class="state-note warning">@viaje.ParadasPendientes pendiente(s)</div>
                                    }
                                    else
                                    {
                                        <div class="state-note info">Ruta atendida</div>
                                    }
                                }
                                else
                                {
                                    <span class="route-pending">Sin paradas cargadas</span>
                                }
                            </td>
                            <td class="next-stop">
                                @if (viaje.ProximaParadaID.HasValue)
                                {
                                    <div class="next-stop-main">
                                        <span class="next-stop-seq">@(viaje.ProximaSecuencia?.ToString() ?? "•")</span>
                                        <div>
                                            <span class="next-stop-name" title="@viaje.ProximaParada">@(!string.IsNullOrWhiteSpace(viaje.ProximaParada) ? viaje.ProximaParada : "Parada pendiente")</span>
                                            <span class="next-stop-meta">@OperacionVisible(viaje.ProximaOperacion)</span>
                                            @if (viaje.ProximaLlegadaProgramada.HasValue)
                                            {
                                                <span class="next-stop-meta"><i class="fa-regular fa-clock me-1"></i>@viaje.ProximaLlegadaProgramada.Value.ToString("dd/MM HH:mm")</span>
                                            }
                                        </div>
                                    </div>
                                }
                                else if (tieneParadas && viaje.ParadasPendientes == 0)
                                {
                                    <span class="route-complete"><i class="fa-solid fa-circle-check me-1"></i>Sin paradas pendientes</span>
                                }
                                else
                                {
                                    <span class="route-pending">Pendiente de ruta</span>
                                }
                            </td>
                            <td><span class="texto-corto" title="@viaje.Unidad">@(string.IsNullOrWhiteSpace(viaje.Unidad) ? "Pendiente" : viaje.Unidad)</span></td>
                            <td><span class="texto-corto" title="@viaje.Operador">@(string.IsNullOrWhiteSpace(viaje.Operador) ? "Pendiente" : viaje.Operador)</span></td>
                            <td>
                                <span class="badge badge-mini @BadgeEstatus(viaje.Estatus)">@viaje.Estatus</span>
                                @if (viaje.Estatus == "Programado")
                                {
                                    <div class="state-note info">Pendiente de iniciar</div>
                                }
                                @if (viaje.RetornoPendiente)
                                {
                                    <div class="state-note warning">Viaje en curso</div>
                                }
                            </td>
                            <td class="text-center">
                                @if (viaje.TieneIncidencia)
                                {
                                    <span class="text-danger" title="Tiene incidencias"><i class="fa-solid fa-triangle-exclamation"></i></span>
                                }
                                else
                                {
                                    <span class="text-muted">-</span>
                                }
                            </td>
                            <td class="acciones">
                                <a asp-controller="LogisticaViajes" asp-action="Detalle" asp-route-id="@viaje.ViajeID" class="btn btn-outline-primary btn-sm" title="Ver ruta y paradas"><i class="fa-solid fa-eye"></i></a>
                                @if (viaje.Estatus == "Programado" && !esEntrega)
                                {
                                    <a asp-controller="LogisticaViajes" asp-action="Editar" asp-route-id="@viaje.ViajeID" class="btn btn-outline-warning btn-sm" title="Editar preparación del viaje"><i class="fa-solid fa-screwdriver-wrench"></i></a>
                                }
                                else if (viaje.Estatus == "Programado" && esEntrega)
                                {
                                    <a asp-controller="LogisticaOperacion" asp-action="Index" class="btn btn-outline-secondary btn-sm" title="Modificar desde Centro Operativo"><i class="fa-solid fa-table-columns"></i></a>
                                }
                            </td>
                        </tr>
                    }
                }
            </tbody>
        </table>
    </div>

    <div class="tabla-footer">
        <div>@totalRegistros.ToString("N0") registro(s)</div>
        @if (totalPaginas > 1)
        {
            <nav>
                <ul class="pagination pagination-sm mb-0">
                    <li class="page-item @(paginaActual <= 1 ? "disabled" : "")">
                        <a class="page-link" asp-controller="LogisticaViajes" asp-action="Index" asp-route-pagina="@(paginaActual - 1)" asp-route-q="@Model.Busqueda" asp-route-estatus="@Model.Estatus" asp-route-tipoViaje="@Model.TipoViaje" asp-route-fechaDesde="@(Model.FechaDesde?.ToString("yyyy-MM-dd"))" asp-route-fechaHasta="@(Model.FechaHasta?.ToString("yyyy-MM-dd"))">Anterior</a>
                    </li>
                    @{
                        var inicio = Math.Max(1, paginaActual - 2);
                        var fin = Math.Min(totalPaginas, paginaActual + 2);
                    }
                    @for (var i = inicio; i <= fin; i++)
                    {
                        <li class="page-item @(i == paginaActual ? "active" : "")">
                            <a class="page-link" asp-controller="LogisticaViajes" asp-action="Index" asp-route-pagina="@i" asp-route-q="@Model.Busqueda" asp-route-estatus="@Model.Estatus" asp-route-tipoViaje="@Model.TipoViaje" asp-route-fechaDesde="@(Model.FechaDesde?.ToString("yyyy-MM-dd"))" asp-route-fechaHasta="@(Model.FechaHasta?.ToString("yyyy-MM-dd"))">@i</a>
                        </li>
                    }
                    <li class="page-item @(paginaActual >= totalPaginas ? "disabled" : "")">
                        <a class="page-link" asp-controller="LogisticaViajes" asp-action="Index" asp-route-pagina="@(paginaActual + 1)" asp-route-q="@Model.Busqueda" asp-route-estatus="@Model.Estatus" asp-route-tipoViaje="@Model.TipoViaje" asp-route-fechaDesde="@(Model.FechaDesde?.ToString("yyyy-MM-dd"))" asp-route-fechaHasta="@(Model.FechaHasta?.ToString("yyyy-MM-dd"))">Siguiente</a>
                    </li>
                </ul>
            </nav>
        }
    </div>
</div>
