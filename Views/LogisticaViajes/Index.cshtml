@model ERP.NSQuell.Models.ViewModels.Logistica.LogisticaViajesIndexVm

@{
    ViewData["Title"] = "Viajes";
    Layout = "_Layout";

    var paginaActual = ViewBag.PaginaActual is int p ? p : 1;
    var totalPaginas = ViewBag.TotalPaginas is int tp ? tp : 1;
    var totalRegistros = ViewBag.TotalRegistros is long tr ? tr : 0L;

    string BadgeEstatus(string estatus) => estatus switch
    {
        "Programado" => "bg-primary",
        "En curso" => "bg-warning text-dark",
        "Completado" => "bg-success",
        "Cancelado" => "bg-secondary",
        _ => "bg-light text-dark"
    };

    string BadgeTransporte(string tipo) => tipo switch
    {
        "Interno" => "bg-info text-dark",
        "Externo" => "bg-dark",
        _ => "bg-light text-dark"
    };
}

<style>
    .viajes-page {
        padding: 18px 20px 30px;
    }

    .viajes-header {
        display: flex;
        justify-content: space-between;
        align-items: center;
        gap: 12px;
        margin-bottom: 14px;
        flex-wrap: wrap;
    }

    .viajes-title {
        margin: 0;
        font-size: 1.35rem;
        font-weight: 700;
    }

    .viajes-subtitle {
        margin: 3px 0 0;
        color: #6c757d;
        font-size: .9rem;
    }

    .resumen-strip {
        display: flex;
        gap: 18px;
        flex-wrap: wrap;
        align-items: center;
        padding: 10px 0 12px;
        border-top: 1px solid #e9ecef;
        border-bottom: 1px solid #e9ecef;
        margin-bottom: 14px;
    }

    .resumen-item {
        display: flex;
        align-items: baseline;
        gap: 6px;
        white-space: nowrap;
    }

        .resumen-item strong {
            font-size: 1rem;
        }

        .resumen-item span {
            font-size: .82rem;
            color: #6c757d;
        }

    .filtros {
        display: grid;
        grid-template-columns: minmax(210px, 2fr) repeat(5, minmax(130px, 1fr)) auto auto;
        gap: 8px;
        margin-bottom: 14px;
        align-items: end;
    }

        .filtros label {
            display: block;
            font-size: .76rem;
            font-weight: 600;
            margin-bottom: 3px;
            color: #495057;
        }

        .filtros .form-control,
        .filtros .form-select {
            min-height: 36px;
            font-size: .84rem;
        }

    .table-wrap {
        width: 100%;
        overflow-x: auto;
    }

    .viajes-table {
        margin-bottom: 0;
        font-size: .82rem;
        vertical-align: middle;
    }

        .viajes-table thead th {
            white-space: nowrap;
            font-size: .74rem;
            text-transform: uppercase;
            letter-spacing: .02em;
            color: #495057;
            background: #f8f9fa;
            border-bottom-width: 1px;
        }

        .viajes-table td {
            vertical-align: middle;
        }

        .viajes-table .folio {
            font-weight: 700;
            white-space: nowrap;
        }

        .viajes-table .ruta {
            min-width: 160px;
            max-width: 230px;
        }

        .viajes-table .texto-corto {
            display: block;
            overflow: hidden;
            text-overflow: ellipsis;
            white-space: nowrap;
            max-width: 230px;
        }

    .badge-mini {
        font-size: .72rem;
        font-weight: 600;
        padding: .35em .55em;
    }

    .acciones {
        white-space: nowrap;
        text-align: right;
    }

        .acciones .btn {
            padding: .25rem .45rem;
            font-size: .76rem;
        }

    .tabla-footer {
        display: flex;
        justify-content: space-between;
        align-items: center;
        gap: 12px;
        padding-top: 12px;
        flex-wrap: wrap;
        font-size: .82rem;
        color: #6c757d;
    }

    .empty-state {
        padding: 34px 15px;
        text-align: center;
        color: #6c757d;
    }

    @@media (max-width: 1200px) {
        .filtros {
            grid-template-columns: repeat(4, minmax(150px, 1fr));
        }
    }

    @@media (max-width: 768px) {
        .viajes-page {
            padding: 14px 10px 24px;
        }

        .viajes-header {
            align-items: flex-start;
        }

            .viajes-header .btn {
                width: 100%;
            }

        .resumen-strip {
            gap: 10px 16px;
        }

        .filtros {
            grid-template-columns: 1fr 1fr;
        }

            .filtros .filtro-busqueda {
                grid-column: 1 / -1;
            }

            .filtros .btn {
                width: 100%;
            }
    }

    @@media (max-width: 480px) {
        .filtros {
            grid-template-columns: 1fr;
        }

            .filtros .filtro-busqueda {
                grid-column: auto;
            }
    }
</style>

<div class="viajes-page">

    <div class="viajes-header">
        <div>
            <h1 class="viajes-title">
                <i class="fa-solid fa-route me-1"></i>
                Viajes
            </h1>
            <p class="viajes-subtitle">
                Programación y seguimiento de rutas de personal, recolecciones y traslados.
            </p>
        </div>

        <a asp-controller="LogisticaViajes"
           asp-action="Crear"
           class="btn btn-primary btn-sm">
            <i class="fa-solid fa-plus me-1"></i>
            Nuevo viaje
        </a>
    </div>

    @if (TempData["LogisticaOk"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show py-2 px-3 mb-3" role="alert">
            <i class="fa-solid fa-circle-check me-1"></i>
            @TempData["LogisticaOk"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    @if (TempData["LogisticaError"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show py-2 px-3 mb-3" role="alert">
            <i class="fa-solid fa-triangle-exclamation me-1"></i>
            @TempData["LogisticaError"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    <div class="resumen-strip">
        <div class="resumen-item">
            <strong>@Model.TotalViajes</strong>
            <span>Total</span>
        </div>

        <div class="resumen-item">
            <strong>@Model.Programados</strong>
            <span>Programados</span>
        </div>

        <div class="resumen-item">
            <strong>@Model.EnCurso</strong>
            <span>En curso</span>
        </div>

        <div class="resumen-item">
            <strong>@Model.Completados</strong>
            <span>Completados</span>
        </div>

        <div class="resumen-item">
            <strong>@Model.ViajesHoy</strong>
            <span>Hoy</span>
        </div>

        <div class="resumen-item">
            <strong>@Model.RetornosPendientes</strong>
            <span>Retornos pendientes</span>
        </div>
    </div>

    <form asp-controller="LogisticaViajes"
          asp-action="Index"
          method="get"
          class="filtros">

        <div class="filtro-busqueda">
            <label>Buscar</label>
            <input type="text"
                   name="q"
                   value="@Model.Busqueda"
                   class="form-control"
                   placeholder="Folio, origen, destino, motivo u operador" />
        </div>

        <div>
            <label>Estatus</label>
            <select name="estatus" class="form-select">
                <option value="">Todos</option>
                <option value="Programado" selected="@(Model.Estatus == "Programado")">
                    Programado
                </option>
                <option value="En curso" selected="@(Model.Estatus == "En curso")">
                    En curso
                </option>
                <option value="Completado" selected="@(Model.Estatus == "Completado")">
                    Completado
                </option>
                <option value="Cancelado" selected="@(Model.Estatus == "Cancelado")">
                    Cancelado
                </option>
            </select>
        </div>

        <div>
            <label>Tipo de viaje</label>
            <select name="tipoViaje" class="form-select">
                <option value="">Todos</option>
                <option value="Ruta de personal"
                        selected="@(Model.TipoViaje == "Ruta de personal")">
                    Ruta de personal
                </option>
                <option value="Recolección de MP"
                        selected="@(Model.TipoViaje == "Recolección de MP")">
                    Recolección de MP
                </option>
                <option value="Traslado entre plantas"
                        selected="@(Model.TipoViaje == "Traslado entre plantas")">
                    Traslado entre plantas
                </option>
                <option value="Recolección de material"
                        selected="@(Model.TipoViaje == "Recolección de material")">
                    Recolección de material
                </option>
                <option value="Entrega / recolección especial"
                        selected="@(Model.TipoViaje == "Entrega / recolección especial")">
                    Entrega / recolección especial
                </option>
                <option value="Otro"
                        selected="@(Model.TipoViaje == "Otro")">
                    Otro
                </option>
            </select>
        </div>

        <div>
            <label>Transporte</label>
            <select name="tipoTransporte" class="form-select">
                <option value="">Todos</option>
                <option value="Interno" selected="@(Model.TipoTransporte == "Interno")">
                    Interno
                </option>
                <option value="Externo" selected="@(Model.TipoTransporte == "Externo")">
                    Externo
                </option>
            </select>
        </div>

        <div>
            <label>Desde</label>
            <input type="date"
                   name="fechaDesde"
                   value="@(Model.FechaDesde?.ToString("yyyy-MM-dd"))"
                   class="form-control" />
        </div>

        <div>
            <label>Hasta</label>
            <input type="date"
                   name="fechaHasta"
                   value="@(Model.FechaHasta?.ToString("yyyy-MM-dd"))"
                   class="form-control" />
        </div>

        <div>
            <button type="submit"
                    class="btn btn-dark btn-sm w-100">
                <i class="fa-solid fa-magnifying-glass me-1"></i>
                Filtrar
            </button>
        </div>

        <div>
            <a asp-controller="LogisticaViajes"
               asp-action="Index"
               class="btn btn-outline-secondary btn-sm w-100">
                Limpiar
            </a>
        </div>
    </form>

    <div class="table-wrap">
        <table class="table table-hover table-sm viajes-table">
            <thead>
                <tr>
                    <th>Folio</th>
                    <th>Fecha</th>
                    <th>Tipo</th>
                    <th>Transporte</th>
                    <th>Origen</th>
                    <th>Destino</th>
                    <th>Unidad</th>
                    <th>Operador</th>
                    <th>Estatus</th>
                    <th>Inc.</th>
                    <th class="text-end">Acción</th>
                </tr>
            </thead>

            <tbody>
                @if (Model.Viajes == null || Model.Viajes.Count == 0)
                {
                    <tr>
                        <td colspan="11">
                            <div class="empty-state">
                                <i class="fa-solid fa-route fa-2x mb-2"></i>
                                <div>No hay viajes que coincidan con los filtros.</div>
                            </div>
                        </td>
                    </tr>
                }
                else
                {
                    foreach (var viaje in Model.Viajes)
                    {
                        <tr>
                            <td>
                                <span class="folio">@viaje.Folio</span>
                            </td>

                            <td class="text-nowrap">
                                <div>@viaje.FechaProgramada.ToString("dd/MM/yyyy")</div>

                                @if (viaje.HoraSalidaProgramada.HasValue)
                                {
                                    <small class="text-muted">
                                        @viaje.HoraSalidaProgramada.Value.ToString(@"hh\:mm")
                                    </small>
                                }
                    </td>

                    <td>
                        <span class="texto-corto"
                              title="@viaje.TipoViaje">
                            @viaje.TipoViaje
                        </span>
                    </td>

                    <td>
                        <span class="badge badge-mini @BadgeTransporte(viaje.TipoTransporte)">
                            @viaje.TipoTransporte
                        </span>
                    </td>

                    <td class="ruta">
                        <span class="texto-corto"
                              title="@viaje.Origen">
                            @viaje.Origen
                        </span>
                    </td>

                    <td class="ruta">
                        <span class="texto-corto"
                              title="@viaje.Destino">
                            @viaje.Destino
                        </span>
                    </td>

                    <td>
                        <span class="texto-corto"
                              title="@viaje.Unidad">
                            @(string.IsNullOrWhiteSpace(viaje.Unidad)
                                                        ? "-"
                                                        : viaje.Unidad)
                                                                   </span>
                                                               </td>

                    <td>
                        <span class="texto-corto"
                              title="@viaje.Operador">
                            @(string.IsNullOrWhiteSpace(viaje.Operador)
                                                        ? "-"
                                                        : viaje.Operador)
                        </span>
                    </td>

                            <td>
                                <span class="badge badge-mini @BadgeEstatus(viaje.Estatus)">
                                    @viaje.Estatus
                                </span>

                        @if (viaje.RetornoPendiente)
                                {
                                    <div>
                                        <small class="text-warning">
                                            Regreso pendiente
                                        </small>
                                    </div>
                                }
                            </td>

                            <td class="text-center">
                                @if (viaje.TieneIncidencia)
                                {
                                    <span class="text-danger"
                                          title="Tiene incidencias">
                                        <i class="fa-solid fa-triangle-exclamation"></i>
                                    </span>
                                }
                                else
                                {
                                    <span class="text-muted">-</span>
                                }
                            </td>

                            <td class="acciones">
                                <a asp-controller="LogisticaViajes"
                                   asp-action="Detalle"
                                   asp-route-id="@viaje.ViajeID"
                                   class="btn btn-outline-primary btn-sm"
                                   title="Ver detalle">
                                    <i class="fa-solid fa-eye"></i>
                                </a>

                                @if (viaje.Estatus == "Programado")
                                {
                                    <a asp-controller="LogisticaViajes"
                                       asp-action="Editar"
                                       asp-route-id="@viaje.ViajeID"
                                       class="btn btn-outline-secondary btn-sm"
                                       title="Editar">
                                        <i class="fa-solid fa-pen"></i>
                                    </a>
                                }
                            </td>
                        </tr>
                    }
                }
            </tbody>
        </table>
    </div>

    <div class="tabla-footer">
        <div>
            @totalRegistros.ToString("N0") registro(s)
        </div>

        @if (totalPaginas > 1)
        {
            <nav>
                <ul class="pagination pagination-sm mb-0">

                    <li class="page-item @(paginaActual <= 1 ? "disabled" : "")">
                        <a class="page-link"
                           asp-controller="LogisticaViajes"
                           asp-action="Index"
                           asp-route-pagina="@(paginaActual - 1)"
                           asp-route-q="@Model.Busqueda"
                           asp-route-estatus="@Model.Estatus"
                           asp-route-tipoViaje="@Model.TipoViaje"
                           asp-route-tipoTransporte="@Model.TipoTransporte"
                           asp-route-fechaDesde="@(Model.FechaDesde?.ToString("yyyy-MM-dd"))"
                           asp-route-fechaHasta="@(Model.FechaHasta?.ToString("yyyy-MM-dd"))">
                            Anterior
                        </a>
                    </li>

                    @{
                        var inicio = Math.Max(1, paginaActual - 2);
                        var fin = Math.Min(totalPaginas, paginaActual + 2);
                    }

                    @for (var i = inicio; i <= fin; i++)
                    {
                        <li class="page-item @(i == paginaActual ? "active" : "")">
                            <a class="page-link"
                               asp-controller="LogisticaViajes"
                               asp-action="Index"
                               asp-route-pagina="@i"
                               asp-route-q="@Model.Busqueda"
                               asp-route-estatus="@Model.Estatus"
                               asp-route-tipoViaje="@Model.TipoViaje"
                               asp-route-tipoTransporte="@Model.TipoTransporte"
                               asp-route-fechaDesde="@(Model.FechaDesde?.ToString("yyyy-MM-dd"))"
                               asp-route-fechaHasta="@(Model.FechaHasta?.ToString("yyyy-MM-dd"))">
                                @i
                            </a>
                        </li>
                    }

                    <li class="page-item @(paginaActual >= totalPaginas ? "disabled" : "")">
                        <a class="page-link"
                           asp-controller="LogisticaViajes"
                           asp-action="Index"
                           asp-route-pagina="@(paginaActual + 1)"
                           asp-route-q="@Model.Busqueda"
                           asp-route-estatus="@Model.Estatus"
                           asp-route-tipoViaje="@Model.TipoViaje"
                           asp-route-tipoTransporte="@Model.TipoTransporte"
                           asp-route-fechaDesde="@(Model.FechaDesde?.ToString("yyyy-MM-dd"))"
                           asp-route-fechaHasta="@(Model.FechaHasta?.ToString("yyyy-MM-dd"))">
                            Siguiente
                        </a>
                    </li>

                </ul>
            </nav>
        }
    </div>

</div>