@model ERP.NSQuell.Models.ViewModels.Logistica.LogisticaViajesIndexVm

@{
    ViewData["Title"] = "Viajes";
    Layout = "_Layout";

    var paginaActual = ViewBag.PaginaActual is int p ? p : 1;
    var totalPaginas = ViewBag.TotalPaginas is int tp ? tp : 1;
    var totalRegistros = ViewBag.TotalRegistros is long tr ? tr : 0L;

    string BadgeEstatus(string estatus) => estatus switch
    {
        "Programado" => "bg-primary",
        "En curso" => "bg-warning text-dark",
        "Completado" => "bg-success",
        "Cancelado" => "bg-secondary",
        _ => "bg-light text-dark"
    };

    string BadgeTransporte(string tipo) => tipo switch
    {
        "Interno" => "bg-info text-dark",
        "Externo" => "bg-dark",
        _ => "bg-light text-dark"
    };
}

<style>
    .viajes-page {
        padding: 18px 20px 30px;
    }

    .viajes-header {
        display: flex;
        justify-content: space-between;
        align-items: center;
        gap: 12px;
        margin-bottom: 14px;
        flex-wrap: wrap;
    }

    .viajes-title {
        margin: 0;
        font-size: 1.35rem;
        font-weight: 700;
    }

    .viajes-subtitle {
        margin: 3px 0 0;
        color: #6c757d;
        font-size: .9rem;
    }

    .resumen-strip {
        display: flex;
        gap: 18px;
        flex-wrap: wrap;
        align-items: center;
        padding: 10px 0 12px;
        border-top: 1px solid #e9ecef;
        border-bottom: 1px solid #e9ecef;
        margin-bottom: 14px;
    }

    .resumen-item {
        display: flex;
        align-items: baseline;
        gap: 6px;
        white-space: nowrap;
    }

        .resumen-item strong {
            font-size: 1rem;
        }

        .resumen-item span {
            font-size: .82rem;
            color: #6c757d;
        }

    .filtros {
        display: grid;
        grid-template-columns: minmax(210px, 2fr) repeat(5, minmax(130px, 1fr)) auto auto;
        gap: 8px;
        margin-bottom: 14px;
        align-items: end;
    }

        .filtros label {
            display: block;
            font-size: .76rem;
            font-weight: 600;
            margin-bottom: 3px;
            color: #495057;
        }

        .filtros .form-control,
        .filtros .form-select {
            min-height: 36px;
            font-size: .84rem;
        }

    .table-wrap {
        width: 100%;
        overflow-x: auto;
    }

    .viajes-table {
        margin-bottom: 0;
        font-size: .82rem;
        vertical-align: middle;
    }

        .viajes-table thead th {
            white-space: nowrap;
            font-size: .74rem;
            text-transform: uppercase;
            letter-spacing: .02em;
            color: #495057;
            background: #f8f9fa;
            border-bottom-width: 1px;
        }

        .viajes-table td {
            vertical-align: middle;
        }

        .viajes-table .folio {
            font-weight: 700;
            white-space: nowrap;
        }

        .viajes-table .ruta {
            min-width: 160px;
            max-width: 230px;
        }

        .viajes-table .texto-corto {
            display: block;
            overflow: hidden;
            text-overflow: ellipsis;
            white-space: nowrap;
            max-width: 230px;
        }

    .badge-mini {
        font-size: .72rem;
        font-weight: 600;
        padding: .35em .55em;
    }

    .acciones {
        white-space: nowrap;
        text-align: right;
    }

        .acciones .btn {
            padding: .25rem .45rem;
            font-size: .76rem;
        }

    .tabla-footer {
        display: flex;
        justify-content: space-between;
        align-items: center;
        gap: 12px;
        padding-top: 12px;
        flex-wrap: wrap;
        font-size: .82rem;
        color: #6c757d;
    }

    .empty-state {
        padding: 34px 15px;
        text-align: center;
        color: #6c757d;
    }

    @@media (max-width: 1200px) {
        .filtros {
            grid-template-columns: repeat(4, minmax(150px, 1fr));
        }
    }

    @@media (max-width: 768px) {
        .viajes-page {
            padding: 14px 10px 24px;
        }

        .viajes-header {
            align-items: flex-start;
        }

            .viajes-header .btn {
                width: 100%;
            }

        .resumen-strip {
            gap: 10px 16px;
        }

        .filtros {
            grid-template-columns: 1fr 1fr;
        }

            .filtros .filtro-busqueda {
                grid-column: 1 / -1;
            }

            .filtros .btn {
                width: 100%;
            }
    }

    @@media (max-width: 480px) {
        .filtros {
            grid-template-columns: 1fr;
        }

            .filtros .filtro-busqueda {
                grid-column: auto;
            }
    }

    /* =========================================================
               VIAJES - MEJORA VISUAL SIN CARDS
               Conserva filtros, tabla, paginación y funcionalidad.
               ========================================================= */

    .viajes-page {
        position: relative;
    }

    .viajes-header {
        padding: 6px 0 12px;
        border-bottom: 1px solid #dbe4ee;
    }

    .viajes-title {
