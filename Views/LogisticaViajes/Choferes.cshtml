@model ERP.NSQuell.Models.ViewModels.Logistica.LogisticaChoferesVm
@{
    ViewData["Title"] = "Choferes";
    Layout = "_Layout";
    string ClaseEstado(string estado) => estado switch
    {
        "Disponible" => "disp",
        "En viaje" => "curso",
        "Programado" => "prog",
        _ => "otro"
    };
}
<style>
    :root {
        --ch-blue: #173a7a;
        --ch-text: #172033;
        --ch-muted: #6d7888;
        --ch-border: #dce4ee;
        --ch-soft: #f6f8fb;
        --ch-shadow: 0 8px 24px rgba(22,42,75,.06)
    }

    .ch-page {
        max-width: 1500px;
        margin: 0 auto;
        padding: 18px 20px 30px;
        color: var(--ch-text)
    }

    .ch-head {
        display: flex;
        justify-content: space-between;
        align-items: center;
        gap: 12px;
        flex-wrap: wrap;
        padding: 15px 17px;
        margin-bottom: 12px;
        border: 1px solid var(--ch-border);
        border-left: 4px solid var(--ch-blue);
        border-radius: 12px;
        background: #fff;
        box-shadow: var(--ch-shadow)
    }

    .ch-title {
        margin: 0;
        color: var(--ch-text);
        font-size: 1.46rem;
        font-weight: 800;
        letter-spacing: -.02em
    }

        .ch-title i {
            color: var(--ch-blue)
        }

    .ch-sub {
        margin: 3px 0 0;
        color: var(--ch-muted);
        font-size: .86rem;
        font-weight: 500
    }

    .ch-actions {
        display: flex;
        gap: 7px;
        flex-wrap: wrap
    }

        .ch-actions .btn {
            min-height: 35px;
            border-radius: 8px;
            font-weight: 700;
            display: inline-flex;
            align-items: center
        }

    .ch-summary {
        display: grid;
        grid-template-columns: repeat(3,minmax(150px,1fr));
        gap: 8px;
        margin-bottom: 12px
    }

    .ch-kpi {
        min-height: 72px;
        padding: 10px 12px;
        border: 1px solid var(--ch-border);
        border-radius: 10px;
        background: #fff;
        box-shadow: 0 4px 13px rgba(22,42,75,.035)
    }

        .ch-kpi span {
            display: block;
            margin-bottom: 3px;
            color: var(--ch-muted);
            font-size: .68rem;
            font-weight: 800;
            text-transform: uppercase;
            letter-spacing: .02em
        }

        .ch-kpi strong {
            display: block;
            color: var(--ch-blue);
            font-size: 1.25rem;
            font-weight: 800
        }

        .ch-kpi:nth-child(2) strong {
            color: #b42318
        }

        .ch-kpi:nth-child(3) strong {
            color: #345cc4
        }

    .ch-note {
        margin-bottom: 12px;
        padding: 9px 11px;
        border: 1px dashed #cbd8e6;
        border-radius: 9px;
        background: #f8fbff;
        color: #56667b;
        font-size: .74rem
    }

        .ch-note strong {
            color: var(--ch-blue)
        }

    .ch-table {
        overflow-x: auto;
        border: 1px solid var(--ch-border);
        border-radius: 12px;
        background: #fff;
        box-shadow: var(--ch-shadow)
    }

        .ch-table table {
            width: 100%;
            min-width: 1050px;
            margin: 0;
            border-collapse: collapse
        }

        .ch-table th {
            padding: .58rem .62rem;
            background: #f3f6f9;
            color: #536072;
            border-bottom: 1px solid #d8e1ea;
            text-align: left;
            font-size: .69rem;
            font-weight: 800;
            text-transform: uppercase;
            white-space: nowrap
        }

        .ch-table td {
            padding: .62rem;
            border-top: 1px solid #edf1f5;
            font-size: .81rem;
            vertical-align: middle
        }

        .ch-table tbody tr:nth-child(even) td {
            background: #fbfcfd
        }

        .ch-table tbody tr:hover td {
            background: #f4f8fc
        }

    .state {
        display: inline-flex;
        align-items: center;
        padding: 4px 8px;
        border-radius: 999px;
        font-size: .68rem;
        font-weight: 800;
        white-space: nowrap
    }

    .disp {
        background: #ecfdf3;
        color: #137a4b
    }

    .curso {
        background: #fff1f0;
        color: #b42318
    }

    .prog {
        background: #edf3ff;
        color: #173a7a
    }

    .otro {
        background: #f2f4f7;
        color: #667085
    }

    .chofer-name {
        font-weight: 800;
        color: #253247
    }

    .folio {
        font-weight: 800;
        color: var(--ch-blue);
        white-space: nowrap
    }

    .muted {
        color: #7a8797;
        font-size: .71rem
    }

    .assign-cell {
        min-width: 190px
    }

    .dest-cell {
        min-width: 180px;
        max-width: 260px
    }

    .date-cell {
        white-space: nowrap
    }

    .empty {
        padding: 30px;
        text-align: center;
        color: #6d7888
    }

    html[data-nsq-theme="dark"] .ch-page {
        color: #e7edf6
    }

    html[data-nsq-theme="dark"] .ch-head, html[data-nsq-theme="dark"] .ch-kpi, html[data-nsq-theme="dark"] .ch-table {
        background: #111b2d;
        border-color: #2a3a50;
        box-shadow: none
    }

    html[data-nsq-theme="dark"] .ch-title, html[data-nsq-theme="dark"] .chofer-name {
        color: #eef4fb
    }

    html[data-nsq-theme="dark"] .ch-sub, html[data-nsq-theme="dark"] .muted {
        color: #9eacbf
    }

    html[data-nsq-theme="dark"] .ch-note {
        background: #162237;
        border-color: #314158;
        color: #aebbd0
    }

    html[data-nsq-theme="dark"] .ch-table th {
        background: #162237;
        color: #cbd7e6;
        border-color: #2a3a50
    }

    html[data-nsq-theme="dark"] .ch-table td {
        border-color: #243349
    }

    html[data-nsq-theme="dark"] .ch-table tbody tr:nth-child(even) td {
        background: #101a2a
    }

    html[data-nsq-theme="dark"] .ch-table tbody tr:hover td {
        background: #17253a
    }

    @@media(max-width:800px) {
        .ch-summary {
            grid-template-columns: 1fr
        }

        .ch-page {
            padding: 14px 10px 24px
        }

        .ch-head {
            align-items: flex-start
        }

        .ch-actions {
            width: 100%
        }

            .ch-actions .btn {
                flex: 1
            }
    }
</style>

<div class="ch-page">
    <div class="ch-head">
        <div>
            <h1 class="ch-title"><i class="fa-solid fa-id-card me-1"></i>Choferes</h1>
            <p class="ch-sub">Disponibilidad calculada automáticamente con viajes y embarques activos.</p>
        </div>
        <div class="ch-actions">
            <a asp-controller="LogisticaViajes" asp-action="Calendario" class="btn btn-outline-secondary btn-sm"><i class="fa-solid fa-calendar-days me-1"></i>Calendario</a>
            <a asp-controller="LogisticaViajes" asp-action="Index" class="btn btn-outline-primary btn-sm"><i class="fa-solid fa-arrow-left me-1"></i>Volver a viajes</a>
        </div>
    </div>

    <div class="ch-summary">
        <div class="ch-kpi"><span>Disponibles</span><strong>@Model.Disponibles</strong></div>
        <div class="ch-kpi"><span>En viaje</span><strong>@Model.EnViaje</strong></div>
        <div class="ch-kpi"><span>Programados</span><strong>@Model.Programados</strong></div>
    </div>

    <div class="ch-note">
        <strong>Disponibilidad automática:</strong> un chofer aparece como <strong>En viaje</strong> cuando tiene una asignación activa en curso; como <strong>Programado</strong> cuando tiene una próxima asignación; y como <strong>Disponible</strong> cuando no tiene ninguna de las anteriores.
    </div>

    <div class="ch-table">
        <table>
            <thead>
                <tr>
                    <th>Chofer</th>
                    <th>Estado</th>
                    <th>Asignación actual</th>
                    <th>Destino actual</th>
                    <th>Salida actual</th>
                    <th>Próxima asignación</th>
                    <th>Próxima salida</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var c in Model.Choferes)
                {
                    <tr>
                        <td><span class="chofer-name">@c.Chofer</span></td>
                        <td><span class="state @ClaseEstado(c.Estado)">@c.Estado</span></td>
                        <td class="assign-cell">
                            @if (!string.IsNullOrWhiteSpace(c.FolioActual))
                            {
                                <span class="folio">@c.FolioActual</span>
                                @if (!string.IsNullOrWhiteSpace(c.FuenteActual))
                                {
                                    <div class="muted">@c.FuenteActual</div>
                                }
                            }
                            else
                            {
                                <span class="muted">Sin asignación activa</span>
                            }
                        </td>
                        <td class="dest-cell">@(string.IsNullOrWhiteSpace(c.DestinoActual) ? "-" : c.DestinoActual)</td>
                        <td class="date-cell">@(c.SalidaActual.HasValue? c.SalidaActual.Value.ToString("dd/MM/yyyy HH:mm"):"-")</td>
                        <td class="assign-cell">
                            @if (!string.IsNullOrWhiteSpace(c.FolioProximo))
                            {
                                <span class="folio">@c.FolioProximo</span>
                                @if (!string.IsNullOrWhiteSpace(c.FuenteProxima))
                                {
                                    <div class="muted">@c.FuenteProxima</div>
                                }
                                @if (!string.IsNullOrWhiteSpace(c.DestinoProximo))
                                {
                                    <div class="muted">@c.DestinoProximo</div>
                                }
                            }
                            else
                            {
                                <span class="muted">Sin próxima asignación</span>
                            }
                        </td>
                        <td class="date-cell">@(c.ProximaSalida.HasValue? c.ProximaSalida.Value.ToString("dd/MM/yyyy HH:mm"):"-")</td>
                    </tr>
                }
                @if (!Model.Choferes.Any())
                {
                    <tr><td colspan="7"><div class="empty"><i class="fa-solid fa-user-slash me-1"></i>No se encontraron usuarios activos de Logística con puesto de Chofer.</div></td></tr>
                }
            </tbody>
        </table>
    </div>
</div>
