@model ERP.NSQuell.Models.ViewModels.Logistica.LogisticaChoferesVm
@{ViewData["Title"]="Choferes";Layout="_Layout";}
<style>
.ch-page{max-width:1500px;margin:0 auto;padding:18px}.ch-head{display:flex;justify-content:space-between;align-items:center;gap:12px;padding:16px;border:1px solid #dce4ee;border-left:4px solid #173a7a;border-radius:12px;background:#fff;box-shadow:0 8px 24px rgba(22,42,75,.06);margin-bottom:12px}.ch-head h1{margin:0;font-size:1.45rem;font-weight:850;color:#172033}.ch-head p{margin:3px 0 0;color:#6d7888}.ch-summary{display:grid;grid-template-columns:repeat(3,1fr);gap:8px;margin-bottom:12px}.ch-kpi{padding:12px;border:1px solid #dce4ee;border-radius:10px;background:#fff}.ch-kpi span{display:block;font-size:.7rem;color:#6d7888;text-transform:uppercase;font-weight:800}.ch-kpi strong{display:block;font-size:1.35rem;color:#173a7a}.ch-table{background:#fff;border:1px solid #dce4ee;border-radius:12px;overflow:auto;box-shadow:0 8px 24px rgba(22,42,75,.05)}table{width:100%;border-collapse:collapse;min-width:950px}th{padding:9px;background:#f3f6f9;color:#536072;text-align:left;font-size:.72rem;text-transform:uppercase}td{padding:10px;border-top:1px solid #edf1f5;font-size:.82rem}.state{display:inline-flex;padding:4px 8px;border-radius:999px;font-size:.7rem;font-weight:850}.disp{background:#ecfdf3;color:#137a4b}.curso{background:#fff1f0;color:#b42318}.prog{background:#edf3ff;color:#173a7a}.folio{font-weight:800;color:#173a7a}.muted{color:#7a8797;font-size:.72rem}@@media /* NSQ_FIX_BUILD_CHOFERES_MEDIA_V5_0_2 */(max-width:700px){.ch-summary{grid-template-columns:1fr}.ch-page{padding:10px}.ch-head{align-items:flex-start;flex-direction:column}}
</style>
<div class="ch-page">
 <div class="ch-head"><div><h1><i class="fa-solid fa-id-card me-1"></i>Choferes</h1><p>Disponibilidad calculada automáticamente con viajes y embarques activos.</p></div><a asp-controller="LogisticaViajes" asp-action="Index" class="btn btn-outline-primary">Volver a viajes</a></div>
 <div class="ch-summary"><div class="ch-kpi"><span>Disponibles</span><strong>@Model.Disponibles</strong></div><div class="ch-kpi"><span>En viaje</span><strong>@Model.EnViaje</strong></div><div class="ch-kpi"><span>Programados</span><strong>@Model.Programados</strong></div></div>
 <div class="ch-table"><table><thead><tr><th>Chofer</th><th>Estado</th><th>Viaje actual</th><th>Destino actual</th><th>Próxima asignación</th><th>Próxima salida</th></tr></thead><tbody>
 @foreach(var c in Model.Choferes){<tr><td><strong>@c.Chofer</strong></td><td><span class="state @(c.Estado=="Disponible"?"disp":c.Estado=="En viaje"?"curso":"prog")">@c.Estado</span></td><td>@if(!string.IsNullOrWhiteSpace(c.FolioActual)){<span class="folio">@c.FolioActual</span><div class="muted">@c.FuenteActual</div>}else{<span class="muted">Sin viaje activo</span>}</td><td>@(string.IsNullOrWhiteSpace(c.DestinoActual)?"-":c.DestinoActual)</td><td>@if(!string.IsNullOrWhiteSpace(c.FolioProximo)){<span class="folio">@c.FolioProximo</span><div class="muted">@c.FuenteProxima · @c.DestinoProximo</div>}else{<span class="muted">Sin asignación</span>}</td><td>@(c.ProximaSalida.HasValue?c.ProximaSalida.Value.ToString("dd/MM/yyyy HH:mm"):"-")</td></tr>}
 @if(!Model.Choferes.Any()){<tr><td colspan="6" style="text-align:center;padding:30px;color:#6d7888">No se encontraron usuarios activos de Logística con puesto de Chofer.</td></tr>}
 </tbody></table></div>
</div>