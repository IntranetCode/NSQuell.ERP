@model ERP.NSQuell.Models.ViewModels.Logistica.LogisticaViajeCrearVm
@{
    ViewData["Title"] = "Programar viaje independiente";
    Layout = "_Layout";
}
<style>
    :root {
        --lv-blue: #173a7a;
        --lv-text: #172033;
        --lv-muted: #6d7888;
        --lv-border: #dce4ee;
        --lv-soft: #f6f8fb;
        --lv-shadow: 0 8px 24px rgba(22,42,75,.06)
    }

    .viaje-form-page {
        max-width: 1500px;
        margin: 0 auto;
        padding: 18px 20px 30px;
        color: var(--lv-text)
    }

    .viaje-form-header {
        display: flex;
        justify-content: space-between;
        align-items: center;
        gap: 12px;
        flex-wrap: wrap;
        padding: 15px 17px;
        margin-bottom: 14px;
        border: 1px solid var(--lv-border);
        border-left: 4px solid var(--lv-blue);
        border-radius: 12px;
        background: #fff;
        box-shadow: var(--lv-shadow)
    }

    .viaje-form-title {
        margin: 0;
        color: var(--lv-text);
        font-size: 1.48rem;
        font-weight: 800;
        letter-spacing: -.02em
    }

        .viaje-form-title i {
            color: var(--lv-blue)
        }

    .viaje-form-subtitle {
        margin: 3px 0 0;
        color: var(--lv-muted);
        font-size: .86rem;
        font-weight: 500
    }

    .viaje-form-header > .btn {
        min-height: 35px;
        border-radius: 8px;
        font-weight: 700;
        display: inline-flex;
        align-items: center
    }

    .form-section {
        margin-bottom: 12px;
        padding: 14px;
        border: 1px solid var(--lv-border);
        border-radius: 12px;
        background: #fff;
        box-shadow: var(--lv-shadow)
    }

    .form-section-title {
        display: flex;
        align-items: center;
        gap: 8px;
        margin-bottom: 12px;
        padding-bottom: 8px;
        border-bottom: 1px solid #e8edf3;
        color: var(--lv-text);
        font-size: .96rem;
        font-weight: 800
    }

        .form-section-title:before {
            content: "";
            width: 4px;
            height: 18px;
            border-radius: 8px;
            background: var(--lv-blue);
            flex: 0 0 auto
        }

    .form-grid {
        display: grid;
        grid-template-columns: repeat(12,1fr);
        gap: 10px 12px
    }

    .col-12g {
        grid-column: span 12
    }

    .col-8g {
        grid-column: span 8
    }

    .col-6g {
        grid-column: span 6
    }

    .col-4g {
        grid-column: span 4
    }

    .col-3g {
        grid-column: span 3
    }

    .form-label {
        margin-bottom: 4px;
        color: #465164;
        font-size: .78rem;
        font-weight: 700
    }

    .required:after {
        content: " *";
        color: #b42318;
        font-weight: 900
    }

    .form-control, .form-select {
        min-height: 39px;
        border-radius: 8px;
        border-color: #d4dde7;
        background: #fff;
        box-shadow: none;
        font-size: .86rem
    }

        .form-control:focus, .form-select:focus {
            border-color: #8ba5d4;
            box-shadow: 0 0 0 .18rem rgba(23,58,122,.08)
        }

    textarea.form-control {
        min-height: 104px;
        resize: vertical
    }

    .form-text {
        color: #7a8492;
        font-size: .74rem
    }

    .field-validation-error {
        display: block;
        margin-top: 4px;
        color: #dc3545;
        font-size: .76rem;
        font-weight: 600
    }

    .validation-summary-errors {
        padding: 10px 12px;
        border: 1px solid #efc5ca;
        border-radius: 9px;
        background: #fff7f8;
        color: #b42318;
        font-size: .82rem
    }

    .optional-note {
        margin-bottom: 10px;
        padding: 9px 11px;
        border: 1px dashed #c8d7e8;
        border-radius: 9px;
        background: #f7faff;
        color: #58697d;
        font-size: .76rem
    }

        .optional-note strong {
            color: var(--lv-blue)
        }

    .linked-note {
        display: flex;
        align-items: flex-start;
        justify-content: space-between;
        gap: 14px;
        margin-bottom: 14px;
        padding: 12px 14px;
        border: 1px solid #b8d2f1;
        border-left: 4px solid var(--lv-blue);
        border-radius: 11px;
        background: #f4f8ff;
        color: #31506f
    }

        .linked-note > div:first-child {
            display: flex;
            align-items: flex-start;
            gap: 9px;
            min-width: 0
        }

        .linked-note i {
            margin-top: 2px;
            color: var(--lv-blue);
            font-size: 1rem
        }

        .linked-note strong {
            display: block;
            margin-bottom: 3px;
            color: var(--lv-blue);
            font-size: .81rem;
            font-weight: 800
        }

        .linked-note span {
            display: block;
            font-size: .75rem;
            line-height: 1.45;
            font-weight: 600
        }

        .linked-note .btn {
            flex: 0 0 auto;
            border-radius: 8px;
            font-weight: 700;
            white-space: nowrap
        }

    .resource-strip {
        display: grid;
        grid-template-columns: repeat(4,minmax(120px,1fr));
        gap: 8px;
        margin-top: 10px
    }

        .resource-strip > div {
            padding: 8px 10px;
            border: 1px solid #dce4ed;
            border-radius: 8px;
            background: #fbfcfd
        }

        .resource-strip span {
            display: block;
            color: #748195;
            font-size: .66rem
        }

        .resource-strip strong {
            display: block;
            margin-top: 2px;
            font-size: .78rem
        }

    .form-actions {
        position: sticky;
        bottom: 0;
        z-index: 5;
        display: flex;
        justify-content: flex-end;
        gap: 8px;
        margin-top: 14px;
        padding: 12px 14px;
        border: 1px solid var(--lv-border);
        border-radius: 12px;
        background: rgba(255,255,255,.97);
        box-shadow: 0 -4px 16px rgba(25,47,80,.05);
        backdrop-filter: blur(4px)
    }

        .form-actions .btn {
            min-height: 38px;
            border-radius: 8px;
            font-weight: 700
        }

        .form-actions .btn-primary {
            min-width: 180px;
            background: #233f80;
            border-color: #233f80
        }

    html[data-nsq-theme="dark"] .viaje-form-page {
        color: #e7edf6
    }

    html[data-nsq-theme="dark"] .viaje-form-header, html[data-nsq-theme="dark"] .form-section, html[data-nsq-theme="dark"] .form-actions {
        background: #111b2d;
        border-color: #2a3a50;
        box-shadow: none
    }

    html[data-nsq-theme="dark"] .viaje-form-title, html[data-nsq-theme="dark"] .form-section-title {
        color: #eef4fb
    }

    html[data-nsq-theme="dark"] .viaje-form-subtitle, html[data-nsq-theme="dark"] .form-text, html[data-nsq-theme="dark"] .optional-note {
        color: #9eacbf
    }

    html[data-nsq-theme="dark"] .form-label {
        color: #c7d3e2
    }

    html[data-nsq-theme="dark"] .form-control, html[data-nsq-theme="dark"] .form-select {
        background: #0d1727;
        color: #eef4fb;
        border-color: #314158
    }

    html[data-nsq-theme="dark"] .optional-note, html[data-nsq-theme="dark"] .resource-strip > div {
        background: #162237;
        border-color: #2a3a50
    }

    html[data-nsq-theme="dark"] .linked-note {
        background: #0d1828;
        border-color: #31527a;
        color: #b9c8da
    }

        html[data-nsq-theme="dark"] .linked-note strong {
            color: #dceafe
        }

    @@media(max-width:900px) {
        .col-8g, .col-6g, .col-4g, .col-3g {
            grid-column: span 6
        }

        .resource-strip {
            grid-template-columns: repeat(2,minmax(0,1fr))
        }
    }

    @@media(max-width:600px) {
        .viaje-form-page {
            padding: 14px 10px 24px
        }

        .col-8g, .col-6g, .col-4g, .col-3g, .col-12g {
            grid-column: span 12
        }

        .viaje-form-header > .btn {
            width: 100%;
            justify-content: center
        }

        .form-actions {
            position: static;
            flex-direction: column-reverse;
            padding: 10px
        }

            .form-actions .btn {
                width: 100%
            }

        .resource-strip {
            grid-template-columns: 1fr
        }

        .linked-note {
            flex-direction: column
        }

            .linked-note .btn {
                width: 100%;
                justify-content: center
            }
    }
</style>

<div class="viaje-form-page">
    <div class="viaje-form-header">
        <div>
            <h1 class="viaje-form-title"><i class="fa-solid fa-route me-1"></i>Programar viaje independiente</h1>
            <p class="viaje-form-subtitle">Registra rutas de personal, recolecciones, traslados u otras salidas que no provienen de un embarque de producto terminado.</p>
        </div>
        <a asp-controller="LogisticaViajes" asp-action="Index" class="btn btn-outline-secondary btn-sm"><i class="fa-solid fa-arrow-left me-1"></i>Regresar</a>
    </div>

    <div class="linked-note">
        <div>
            <i class="fa-solid fa-circle-info"></i>
            <div>
                <strong>Las Entregas de producto terminado no se crean aquí.</strong>
                <span>Cuando un embarque usa la forma de salida Entrega, el viaje se crea y sincroniza desde Centro Operativo. Ahí se conservan fecha, hora, ruta, unidad y chofer ligados al embarque. La carga física puede realizarla Centro Operativo o el chofer, sin importar la hora; la salida física la confirma el chofer desde su portal.</span>
            </div>
        </div>
        <a asp-controller="LogisticaOperacion" asp-action="Index" class="btn btn-outline-primary btn-sm"><i class="fa-solid fa-table-columns me-1"></i>Centro Operativo</a>
    </div>

    @if (TempData["LogisticaError"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show py-2 px-3 mb-3" role="alert">
            <i class="fa-solid fa-triangle-exclamation me-1"></i>@TempData["LogisticaError"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    <form asp-controller="LogisticaViajes" asp-action="Crear" method="post" autocomplete="off">
        @Html.AntiForgeryToken()
        <div asp-validation-summary="ModelOnly" class="validation-summary-errors mb-3"></div>

        <div class="form-section">
            <div class="form-section-title">Datos generales</div>
            <div class="form-grid">
                <div class="col-4g">
                    <label asp-for="TipoViaje" class="form-label required">Tipo de viaje</label>
                    <select asp-for="TipoViaje" class="form-select" required>
                        <option value="">Selecciona...</option>
                        <option value="Ruta de personal">Ruta de personal</option>
                        <option value="Recolección de MP">Recolección de MP</option>
                        <option value="Traslado entre plantas">Traslado entre plantas</option>
                        <option value="Recolección de material">Recolección de material</option>
                        <option value="Entrega / recolección especial">Entrega / recolección especial</option>
                        <option value="Otro">Otro</option>
                    </select>
                    <div class="form-text">Para una Entrega de producto terminado utiliza Centro Operativo; no se debe crear manualmente desde Viajes.</div>
                    <span asp-validation-for="TipoViaje"></span>
                </div>
                <div class="col-4g">
                    <label asp-for="FechaProgramada" class="form-label required">Fecha programada</label>
                    <input asp-for="FechaProgramada" type="date" class="form-control" required />
                    <span asp-validation-for="FechaProgramada"></span>
                </div>
                <div class="col-4g">
                    <label asp-for="HoraSalidaProgramada" class="form-label">Hora de salida</label>
                    <input asp-for="HoraSalidaProgramada" type="time" class="form-control" />
                    <div class="form-text">Opcional al programar. Obligatoria antes de iniciar el viaje.</div>
                    <span asp-validation-for="HoraSalidaProgramada"></span>
                </div>
            </div>
        </div>

        <div class="form-section">
            <div class="form-section-title">Ruta y objetivo</div>
            <div class="form-grid">
                <div class="col-6g">
                    <label asp-for="Origen" class="form-label required">Origen</label>
                    <input asp-for="Origen" class="form-control" maxlength="300" placeholder="Ej. Planta NS Quell" required />
                    <span asp-validation-for="Origen"></span>
                </div>
                <div class="col-6g">
                    <label asp-for="Destino" class="form-label required">Destino</label>
                    <input asp-for="Destino" class="form-control" maxlength="300" placeholder="Destino del viaje" required />
                    <span asp-validation-for="Destino"></span>
                </div>
                <div class="col-8g">
                    <label asp-for="Motivo" class="form-label required">Motivo / objetivo del viaje</label>
                    <input asp-for="Motivo" class="form-control" maxlength="500" placeholder="Describe brevemente el propósito del viaje" required />
                    <span asp-validation-for="Motivo"></span>
                </div>
                <div class="col-4g">
                    <label asp-for="RutaID" class="form-label">Ruta registrada</label>
                    <select asp-for="RutaID" class="form-select">
                        <option value="">Pendiente por asignar...</option>
                        @foreach (var ruta in Model.Rutas)
                        {
                            <option value="@ruta.Id">@ruta.Texto</option>
                        }
                    </select>
                    <div class="form-text">Puede quedar pendiente al programar.</div>
                    <span asp-validation-for="RutaID"></span>
                </div>
            </div>
        </div>

        <div class="form-section">
            <div class="form-section-title">Unidad y chofer</div>
            <div class="optional-note"><strong>Asignación opcional al programar.</strong> En un viaje independiente puedes guardar mientras falten recursos. Antes de iniciar el viaje se exigirán hora de salida, ruta, unidad y chofer activos.</div>
            <div class="form-grid">
                <div class="col-6g">
                    <label asp-for="UnidadID" class="form-label">Unidad</label>
                    <select asp-for="UnidadID" class="form-select">
                        <option value="">Pendiente por asignar...</option>
                        @foreach (var unidad in Model.Unidades)
                        {
                            <option value="@unidad.Id">@unidad.Texto</option>
                        }
                    </select>
                    <span asp-validation-for="UnidadID"></span>
                </div>
                <div class="col-6g">
                    <label asp-for="OperadorUsuarioID" class="form-label">Chofer</label>
                    <select asp-for="OperadorUsuarioID" class="form-select">
                        <option value="">Pendiente por asignar...</option>
                        @foreach (var operador in Model.Operadores)
                        {
                            <option value="@operador.Id">@operador.Texto</option>
                        }
                    </select>
                    <span asp-validation-for="OperadorUsuarioID"></span>
                    <div class="form-text">Selecciona uno de los choferes activos disponibles en el catálogo.</div>
                </div>
            </div>
            <div class="resource-strip">
                <div><span>Hora</span><strong>Opcional al programar</strong></div>
                <div><span>Ruta</span><strong>Opcional al programar</strong></div>
                <div><span>Unidad</span><strong>Opcional al programar</strong></div>
                <div><span>Chofer</span><strong>Opcional al programar</strong></div>
            </div>
        </div>

        <div class="form-section">
            <div class="form-section-title">Observaciones</div>
            <div class="form-grid">
                <div class="col-12g">
                    <label asp-for="Observaciones" class="form-label">Observaciones</label>
                    <textarea asp-for="Observaciones" class="form-control" maxlength="1200" placeholder="Información adicional del viaje"></textarea>
                    <div class="form-text">Máximo 1,200 caracteres.</div>
                    <span asp-validation-for="Observaciones"></span>
                </div>
            </div>
        </div>

        <div class="form-actions">
            <a asp-controller="LogisticaViajes" asp-action="Index" class="btn btn-outline-secondary">Cancelar</a>
            <button type="submit" class="btn btn-primary"><i class="fa-solid fa-floppy-disk me-1"></i>Programar viaje independiente</button>
        </div>
    </form>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
