        }

        .history-row {
            display: block
        }

        .history-date, .history-event, .history-user {
            display: block;
            margin-bottom: 3px
        }

        .nav-tabs {
            overflow-x: auto;
            flex-wrap: nowrap
        }

            .nav-tabs .nav-link {
                white-space: nowrap
            }
    }
</style>

<div class="viaje-page">
    <div class="viaje-head">
        <div>
            <h1 class="viaje-title"><i class="fa-solid fa-route me-1"></i>@Model.Folio</h1>
            <div class="viaje-sub">@tipoViajeVisible · @Model.Origen → @Model.Destino</div>
        </div>
        <div class="head-actions">
            <a asp-controller="LogisticaViajes" asp-action="Index" class="btn btn-outline-secondary btn-sm"><i class="fa-solid fa-arrow-left me-1"></i>Viajes</a>
            @if (esFlujoEmbarque)
            {
                <a asp-controller="LogisticaOperacion" asp-action="Index" class="btn btn-outline-primary btn-sm"><i class="fa-solid fa-table-columns me-1"></i>Centro Operativo</a>
            }
            else if (Model.PuedeEditar)
            {
                <a asp-controller="LogisticaViajes" asp-action="Editar" asp-route-id="@Model.ViajeID" class="btn btn-outline-primary btn-sm"><i class="fa-solid fa-screwdriver-wrench me-1"></i>Completar preparación</a>
            }
        </div>
    </div>

    @if (TempData["LogisticaOk"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show py-2 px-3 mb-2"><i class="fa-solid fa-circle-check me-1"></i>@TempData["LogisticaOk"]<button type="button" class="btn-close" data-bs-dismiss="alert"></button></div>
    }
    @if (TempData["LogisticaError"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show py-2 px-3 mb-2"><i class="fa-solid fa-triangle-exclamation me-1"></i>@TempData["LogisticaError"]<button type="button" class="btn-close" data-bs-dismiss="alert"></button></div>
    }

    <div class="summary">
        <div class="summary-item"><span>Estatus</span><strong><span class="badge badge-mini @BadgeEstatus(Model.Estatus)">@Model.Estatus</span></strong></div>
        <div class="summary-item"><span>Programado</span><strong>@Model.FechaProgramada.ToString("dd/MM/yyyy") @(Model.HoraSalidaProgramada.HasValue? Model.HoraSalidaProgramada.Value.ToString(@"hh\:mm"):"")</strong></div>
        <div class="summary-item"><span>Ruta</span><strong title="@Model.Ruta">@(Model.TieneRuta? Model.Ruta: "Pendiente")</strong></div>
        <div class="summary-item"><span>Unidad</span><strong>@Model.UnidadMostrar</strong></div>
        <div class="summary-item"><span>Chofer</span><strong>@Model.ChoferMostrar</strong></div>
        <div class="summary-item"><span>Paradas</span><strong>@totalParadas total · @paradasPendientes pendientes</strong></div>
        <div class="summary-item"><span>Próxima parada</span><strong title="@(proximaParada?.Direccion ?? string.Empty)">@(proximaParada == null ? "Sin pendiente" : $"{proximaParada.Secuencia}. {proximaParada.Lugar}")</strong></div>
        <div class="summary-item"><span>KM usados</span><strong>@(Model.KilometrosUtilizados.HasValue? Model.KilometrosUtilizados.Value.ToString("N0") + " km":"-")</strong></div>
    </div>

    @if (esFlujoEmbarque)
    {
        <div class="workflow entrega">
            <div class="workflow-step done"><span>Paso 1</span><strong>Programación</strong></div>
            <div class="workflow-step @(Model.Estatus == "Programado" ? "current" : Model.Estatus is "En curso" or "Completado" ? "done" : "")"><span>Paso 2</span><strong>Carga física</strong></div>
            <div class="workflow-step @(Model.Estatus is "En curso" or "Completado" ? "done" : "")"><span>Paso 3</span><strong>Salida del chofer</strong></div>
            <div class="workflow-step @(Model.Estatus == "En curso" ? "current" : Model.Estatus == "Completado" ? "done" : "")"><span>Paso 4</span><strong>En ruta</strong></div>
            <div class="workflow-step @(Model.Estatus == "Completado" ? "done" : "")"><span>Paso 5</span><strong>Regreso / cierre</strong></div>
        </div>
        <div class="sync-box"><i class="fa-solid fa-arrows-rotate me-1"></i><strong>Viaje vinculado al flujo de Embarques.</strong> La programación se mantiene sincronizada desde Centro Operativo. La carga física puede registrarse desde Centro Operativo o por el chofer; la salida, las paradas, la entrega y el regreso los confirma el chofer desde su portal.</div>
    }
    else
    {
        <div class="workflow">
            <div class="workflow-step @(Model.Estatus is "En curso" or "Completado" ? "done" : "current")"><span>Paso 1</span><strong>Programado</strong></div>
            <div class="workflow-step @(Model.Estatus is "En curso" or "Completado" ? "done" : Model.Estatus == "Programado" && preparacionCompleta ? "current" : "")"><span>Paso 2</span><strong>Preparación</strong></div>
            <div class="workflow-step @(Model.Estatus == "Completado" ? "done" : Model.Estatus == "En curso" ? "current" : "")"><span>Paso 3</span><strong>En curso</strong></div>
            <div class="workflow-step @(Model.Estatus == "Completado" ? "done" : "")"><span>Paso 4</span><strong>Regreso / cierre</strong></div>
        </div>
    }

    <div class="stage">
        @if (Model.Estatus == "Programado")
        {
            @if (esFlujoEmbarque)
            {
                <div class="stage-head">
                    <div>
                        <h2 class="stage-title">Etapa actual: carga física y espera de salida</h2>
                        <div class="stage-sub">La programación del viaje está ligada a uno o más embarques. Los recursos y la forma de salida se administran desde Centro Operativo y la salida física la confirma el chofer.</div>
                    </div>
                    <span class="badge bg-primary stage-badge">Programado</span>
                </div>
                @if (!preparacionCompleta)
                {
                    <div class="missing mb-2"><i class="fa-solid fa-triangle-exclamation me-1"></i><strong>La programación vinculada está incompleta:</strong> @string.Join(", ", faltantesPreparacion). Corrige esos datos desde Centro Operativo para mantener sincronizados Embarque y Viaje.</div>
                }
                else
                {
                    <div class="success-box mb-2"><i class="fa-solid fa-circle-check me-1"></i>Programación completa. La carga puede continuar desde Centro Operativo o desde el portal del chofer. La salida física no se registra desde esta pantalla.</div>
                }
                <div class="stage-grid">
                    <div class="s3"><div class="info-box"><div class="info-label">Fecha / hora</div><div class="info-value">@Model.FechaProgramada.ToString("dd/MM/yyyy") @(Model.HoraSalidaProgramada?.ToString(@"hh\:mm") ?? "Pendiente")</div></div></div>
                    <div class="s3"><div class="info-box"><div class="info-label">Ruta</div><div class="info-value">@(Model.TieneRuta? Model.Ruta: "Pendiente")</div></div></div>
                    <div class="s3"><div class="info-box"><div class="info-label">Unidad</div><div class="info-value">@Model.UnidadMostrar</div></div></div>
                    <div class="s3"><div class="info-box"><div class="info-label">Chofer</div><div class="info-value">@Model.ChoferMostrar</div></div></div>
                    <div class="s12 text-end"><a asp-controller="LogisticaOperacion" asp-action="Index" class="btn btn-primary btn-sm"><i class="fa-solid fa-table-columns me-1"></i>Abrir Centro Operativo</a></div>
                </div>
            }
            else if (usaPortalChofer)
            {
                <div class="stage-head">
                    <div>
                        <h2 class="stage-title">Etapa actual: preparar recorrido</h2>
                        <div class="stage-sub">Este viaje tiene una ruta por paradas. Una vez completa la preparación, el chofer debe iniciar el recorrido desde su portal para activar correctamente la primera parada.</div>
                    </div>
                    <span class="badge bg-primary stage-badge">Programado</span>
                </div>
                @if (!preparacionCompleta)
                {
                    <div class="missing mb-2"><i class="fa-solid fa-triangle-exclamation me-1"></i><strong>Falta completar:</strong> @string.Join(", ", faltantesPreparacion).</div>
                    @if (Model.PuedeEditar)
                    {
                        <a asp-controller="LogisticaViajes" asp-action="Editar" asp-route-id="@Model.ViajeID" class="btn btn-warning btn-sm"><i class="fa-solid fa-screwdriver-wrench me-1"></i>Completar preparación</a>
                    }
                }
                else
                {
                    <div class="success-box mb-0"><i class="fa-solid fa-user-shield me-1"></i><strong>Preparación completa.</strong> La salida debe confirmarla el chofer asignado desde su portal para iniciar la secuencia de paradas; no se duplica el inicio desde esta vista administrativa.</div>
                }
            }
            else
            {
                <div class="stage-head">
                    <div>
                        <h2 class="stage-title">Etapa actual: preparar e iniciar viaje</h2>
                        <div class="stage-sub">Primero completa la preparación. Después registra la salida y el kilometraje inicial.</div>
                    </div>
                    <span class="badge bg-primary stage-badge">Programado</span>
                </div>
                @if (!preparacionCompleta)
                {
                    <div class="missing mb-2"><i class="fa-solid fa-triangle-exclamation me-1"></i><strong>Falta completar:</strong> @string.Join(", ", faltantesPreparacion).</div>
                    @if (Model.PuedeEditar)
                    {
                        <a asp-controller="LogisticaViajes" asp-action="Editar" asp-route-id="@Model.ViajeID" class="btn btn-warning btn-sm"><i class="fa-solid fa-screwdriver-wrench me-1"></i>Completar preparación</a>
                    }
                }
                else
                {
                    <div class="success-box mb-2"><i class="fa-solid fa-circle-check me-1"></i>Preparación completa. Ya puedes iniciar este viaje simple.</div>
                    <form asp-controller="LogisticaViajes" asp-action="RegistrarSalida" method="post" class="stage-grid">
                        @Html.AntiForgeryToken()
                        <input type="hidden" name="ViajeID" value="@Model.ViajeID" />
                        <div class="s4"><label class="required">Fecha y hora de salida</label><input type="datetime-local" name="FechaSalida" value="@ahora" class="form-control" required /></div>
                        <div class="s3"><label class="required">Kilometraje inicial</label><input type="number" name="KilometrajeSalida" min="0" step="1" class="form-control" required placeholder="Ej. 125430" /></div>
                        <div class="s4"><label>Observaciones</label><input type="text" name="Observaciones" maxlength="1000" class="form-control" placeholder="Opcional" /></div>
                        <div class="s1"><button type="submit" class="btn btn-success btn-sm w-100" onclick="return confirm('¿Confirmar la salida de este viaje?');"><i class="fa-solid fa-play me-1"></i>Iniciar</button></div>
                    </form>
                }
            }
        }
        else if (Model.Estatus == "En curso")
        {
            <div class="stage-head">
                <div>
                    <h2 class="stage-title">@(usaPortalChofer ? "Viaje en ruta" : "Etapa actual: registrar regreso")</h2>
                    <div class="stage-sub">@(usaPortalChofer ? "El recorrido está siendo operado por el chofer. Las paradas y el regreso deben cerrarse desde su portal para conservar una sola trazabilidad." : "La salida ya fue registrada. Captura el kilometraje final para cerrar el viaje.")</div>
                </div>
                <span class="badge bg-warning text-dark stage-badge">En curso</span>
            </div>
            <div class="stage-grid mb-2">
                <div class="s4"><div class="info-box"><div class="info-label">Salida real</div><div class="info-value">@(Model.FechaSalidaReal.HasValue? Model.FechaSalidaReal.Value.ToString("dd/MM/yyyy HH:mm") : "-")</div></div></div>
                <div class="s4"><div class="info-box"><div class="info-label">Kilometraje inicial</div><div class="info-value">@(Model.KilometrajeSalida.HasValue? Model.KilometrajeSalida.Value.ToString("N0") + " km" : "-")</div></div></div>
                <div class="s4"><div class="info-box"><div class="info-label">Destino</div><div class="info-value">@Model.Destino</div></div></div>
            </div>
            @if (usaPortalChofer)
            {
                <div class="sync-box mb-0"><i class="fa-solid fa-user-shield me-1"></i><strong>Acción reservada al chofer.</strong> El viaje tiene embarques vinculados o una secuencia de paradas activa. El regreso debe registrarse desde LogisticaChofer después de resolver toda la ruta.</div>
            }
            else if (Model.PuedeRegistrarRegreso)
            {
                <form asp-controller="LogisticaViajes" asp-action="RegistrarRetorno" method="post" class="stage-grid">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="ViajeID" value="@Model.ViajeID" />
                    <div class="s3"><label class="required">Fecha y hora de regreso</label><input type="datetime-local" name="FechaRegreso" value="@ahora" class="form-control" required /></div>
                    <div class="s3"><label class="required">Kilometraje final</label><input type="number" name="KilometrajeRegreso" min="@(Model.KilometrajeSalida ?? 0)" step="1" class="form-control" required placeholder="Ej. 125612" /></div>
                    <div class="s2"><label>Pago de gasolina</label><input type="number" name="PagoGasolina" min="0" step="0.01" class="form-control" placeholder="Opcional" /></div>
                    <div class="s3"><label>Observaciones</label><input type="text" name="Observaciones" maxlength="1000" class="form-control" placeholder="Opcional" /></div>
                    <div class="s1"><button type="submit" class="btn btn-success btn-sm w-100" onclick="return confirm('¿Confirmar el regreso y cerrar el viaje?');"><i class="fa-solid fa-flag-checkered me-1"></i>Cerrar</button></div>
                </form>
            }
        }
        else if (Model.Estatus == "Completado")
        {
            <div class="stage-head">
                <div>
                    <h2 class="stage-title">Viaje completado</h2>
                    <div class="stage-sub">El recorrido quedó cerrado. Los datos capturados permanecen disponibles abajo.</div>
                </div>
                <span class="badge bg-success stage-badge">Completado</span>
            </div>
            <div class="stage-grid">
                <div class="s3"><div class="info-box"><div class="info-label">Salida</div><div class="info-value">@(Model.FechaSalidaReal.HasValue? Model.FechaSalidaReal.Value.ToString("dd/MM/yyyy HH:mm") : "-")</div></div></div>
                <div class="s3"><div class="info-box"><div class="info-label">Regreso</div><div class="info-value">@(Model.FechaRegresoReal.HasValue? Model.FechaRegresoReal.Value.ToString("dd/MM/yyyy HH:mm") : "-")</div></div></div>
                <div class="s2"><div class="info-box"><div class="info-label">KM inicial</div><div class="info-value">@(Model.KilometrajeSalida.HasValue? Model.KilometrajeSalida.Value.ToString("N0") : "-")</div></div></div>
                <div class="s2"><div class="info-box"><div class="info-label">KM final</div><div class="info-value">@(Model.KilometrajeRegreso.HasValue? Model.KilometrajeRegreso.Value.ToString("N0") : "-")</div></div></div>
                <div class="s2"><div class="info-box"><div class="info-label">KM usados</div><div class="info-value">@(Model.KilometrosUtilizados.HasValue? Model.KilometrosUtilizados.Value.ToString("N0") : "-")</div></div></div>
            </div>
        }
        else
        {
            <div class="stage-head">
                <div><h2 class="stage-title">Viaje cancelado</h2><div class="stage-sub">El viaje ya no tiene acciones operativas pendientes.</div></div>
                <span class="badge bg-secondary stage-badge">Cancelado</span>
            </div>
        }
    </div>

    <div class="tabs-shell">
        <ul class="nav nav-tabs" role="tablist">
            <li class="nav-item"><button class="nav-link active" data-bs-toggle="tab" data-bs-target="#tabDatos" type="button"><i class="fa-solid fa-circle-info me-1"></i>Datos</button></li>
            <li class="nav-item"><button class="nav-link" data-bs-toggle="tab" data-bs-target="#tabRuta" type="button"><i class="fa-solid fa-route me-1"></i>Ruta / paradas <span class="badge bg-secondary ms-1">@totalParadas</span></button></li>
            <li class="nav-item">
                <button class="nav-link" data-bs-toggle="tab" data-bs-target="#tabIncidencias" type="button">
                    <i class="fa-solid fa-triangle-exclamation me-1"></i>Incidencias @if(incidenciasAbiertas>0){
                    <span class="badge bg-danger ms-1">@incidenciasAbiertas</span>
                                        }
                </button>
            </li>
            <li class="nav-item"><button class="nav-link" data-bs-toggle="tab" data-bs-target="#tabEvidencias" type="button"><i class="fa-solid fa-paperclip me-1"></i>Evidencias <span class="badge bg-secondary ms-1">@totalEvidencias</span></button></li>
            <li class="nav-item"><button class="nav-link" data-bs-toggle="tab" data-bs-target="#tabHistorial" type="button"><i class="fa-solid fa-clock-rotate-left me-1"></i>Historial</button></li>
        </ul>

        <div class="tab-content">
            <div class="tab-pane fade show active" id="tabDatos">
                <div class="section-head"><h3>Información del viaje</h3></div>
                <div class="info-grid">
                    <div class="i3 info-box"><div class="info-label">Tipo de salida</div><div class="info-value">@tipoViajeVisible</div></div>
                    <div class="i3 info-box"><div class="info-label">Fecha programada</div><div class="info-value">@Model.FechaProgramada.ToString("dd/MM/yyyy")</div></div>
                    <div class="i3 info-box"><div class="info-label">Hora programada</div><div class="info-value">@(Model.HoraSalidaProgramada.HasValue? Model.HoraSalidaProgramada.Value.ToString(@"hh\:mm"):"Pendiente")</div></div>
                    <div class="i3 info-box"><div class="info-label">Ruta</div><div class="info-value">@(Model.TieneRuta? Model.Ruta: "Pendiente")</div></div>
                    <div class="i6 info-box"><div class="info-label">Origen</div><div class="info-value">@Model.Origen</div></div>
                    <div class="i6 info-box"><div class="info-label">Destino</div><div class="info-value">@Model.Destino</div></div>
                    <div class="i6 info-box"><div class="info-label">Unidad</div><div class="info-value">@Model.UnidadMostrar</div></div>
                    <div class="i6 info-box"><div class="info-label">Chofer</div><div class="info-value">@Model.ChoferMostrar</div></div>
                    <div class="i12 info-box"><div class="info-label">Motivo / objetivo</div><div class="info-value">@TxtVisible(Model.Motivo)</div></div>
                </div>

                <div class="section-head mt-3"><h3>Seguimiento capturado</h3></div>
                <div class="info-grid">
                    <div class="i3 info-box"><div class="info-label">Salida real</div><div class="info-value">@(Model.FechaSalidaReal.HasValue? Model.FechaSalidaReal.Value.ToString("dd/MM/yyyy HH:mm"):"Pendiente")</div></div>
                    <div class="i3 info-box"><div class="info-label">KM inicial</div><div class="info-value">@(Model.KilometrajeSalida.HasValue? Model.KilometrajeSalida.Value.ToString("N0") + " km":"Pendiente")</div></div>
                    <div class="i3 info-box"><div class="info-label">Regreso real</div><div class="info-value">@(Model.FechaRegresoReal.HasValue? Model.FechaRegresoReal.Value.ToString("dd/MM/yyyy HH:mm"):"Pendiente")</div></div>
                    <div class="i3 info-box"><div class="info-label">KM final</div><div class="info-value">@(Model.KilometrajeRegreso.HasValue? Model.KilometrajeRegreso.Value.ToString("N0") + " km":"Pendiente")</div></div>
                    <div class="i3 info-box"><div class="info-label">KM utilizados</div><div class="info-value">@(Model.KilometrosUtilizados.HasValue? Model.KilometrosUtilizados.Value.ToString("N0") + " km":"-")</div></div>
                    <div class="i3 info-box"><div class="info-label">Pago gasolina</div><div class="info-value">@(Model.PagoGasolina.HasValue ? $"${Model.PagoGasolina.Value:N2}" : "-")</div></div>
                    <div class="i6 info-box"><div class="info-label">Observaciones</div><div class="info-value" style="white-space:pre-line">@TxtVisible(Model.Observaciones)</div></div>
                </div>

                <div class="section-head mt-3"><h3>Registro</h3></div>
                <div class="info-grid">
                    <div class="i4 info-box"><div class="info-label">Responsable</div><div class="info-value">@(string.IsNullOrWhiteSpace(Model.UsuarioResponsable) ? "-" : Model.UsuarioResponsable)</div></div>
                    <div class="i4 info-box"><div class="info-label">Creado por</div><div class="info-value">@(string.IsNullOrWhiteSpace(Model.CreadoPor) ? "-" : Model.CreadoPor)</div></div>
                    <div class="i4 info-box"><div class="info-label">Fecha creación</div><div class="info-value">@Model.FechaCreacion.ToString("dd/MM/yyyy HH:mm")</div></div>
                </div>

                @if (Model.PuedeCancelar && !esFlujoEmbarque)
                {
                    <div class="danger-box">
                        <button class="btn btn-outline-danger btn-sm" type="button" data-bs-toggle="collapse" data-bs-target="#cancelarViaje"><i class="fa-solid fa-ban me-1"></i>Cancelar viaje</button>
                        <div class="collapse mt-2" id="cancelarViaje">
                            <form asp-controller="LogisticaViajes" asp-action="Cancelar" method="post" class="compact-form">
                                @Html.AntiForgeryToken()
                                <input type="hidden" name="ViajeID" value="@Model.ViajeID" />
                                <div class="f10"><label class="required">Motivo de cancelación</label><input type="text" name="Motivo" maxlength="1000" class="form-control" required placeholder="Indica por qué se cancela el viaje" /></div>
                                <div class="f2"><button type="submit" class="btn btn-danger btn-sm w-100" onclick="return confirm('¿Seguro que deseas cancelar este viaje?');">Confirmar</button></div>
                            </form>
                        </div>
                    </div>
                }
                @if (esFlujoEmbarque && Model.Estatus == "Programado")
                {
                    <div class="sync-box mt-3 mb-0"><i class="fa-solid fa-link me-1"></i><strong>Entrega sincronizada con Embarque.</strong> Para cancelar o reprogramar esta operación utiliza Centro Operativo; hacerlo directamente sobre el viaje podría separar el estado del Embarque y del Viaje.</div>
                }
            </div>


            <div class="tab-pane fade" id="tabRuta">
                <div class="section-head">
                    <div>
                        <h3>Ruta y múltiples paradas</h3>
                        <div class="text-muted small">El viaje conserva una sola unidad y un solo chofer. Las paradas vinculadas a embarques se consultan aquí, pero sus datos de entrega se administran desde Centro Operativo.</div>
                    </div>
                    @if (puedeAdministrarParadas)
                    {
                        <button class="btn btn-primary btn-sm" type="button" data-bs-toggle="collapse" data-bs-target="#agregarParada"><i class="fa-solid fa-plus me-1"></i>Agregar parada</button>
                    }
                </div>
                <div class="route-summary">
                    <div class="route-summary-item"><span>Tipo de recorrido</span><strong>@(Model.EsMultiParada ? "Múltiples paradas" : "Ruta simple")</strong></div>
                    <div class="route-summary-item"><span>Paradas</span><strong>@totalParadas total</strong></div>
                    <div class="route-summary-item"><span>Resueltas</span><strong>@paradasCompletadas de @totalParadas</strong><div class="route-progress"><span style="width:@(totalParadas <= 0 ? 0 : Math.Round((decimal)paradasCompletadas * 100m / totalParadas, 1).ToString(System.Globalization.CultureInfo.InvariantCulture))%"></span></div></div>
                    <div class="route-summary-item"><span>Próxima parada</span><strong>@(proximaParada == null ? "Sin pendiente" : $"{proximaParada.Secuencia}. {proximaParada.Lugar}")</strong></div>
                </div>
                @if (puedeAdministrarParadas)
                {
                    <div class="collapse mb-3" id="agregarParada">
                        <div class="route-edit">
                            <div class="fw-bold mb-2"><i class="fa-solid fa-location-dot me-1"></i>Nueva parada</div>
                            <form asp-controller="LogisticaViajes" asp-action="AgregarParada" method="post" class="compact-form">
                                @Html.AntiForgeryToken()
                                <input type="hidden" name="ViajeID" value="@Model.ViajeID" />
                                <input type="hidden" name="Secuencia" value="0" />
                                <div class="f3"><label class="required">Tipo de parada</label><select name="TipoParada" class="form-select" required><option value="Entrega">Entrega</option><option value="Recoleccion">Recolección</option><option value="Traslado">Traslado</option><option value="Servicio">Servicio</option><option value="Otro">Otro</option></select></div>
                                <div class="f3"><label>Operación</label><input type="text" name="TipoOperacion" maxlength="80" class="form-control" placeholder="Ej. Recolección MP" /></div>
                                <div class="f3"><label class="required">Lugar</label><input type="text" name="Lugar" maxlength="300" class="form-control" required placeholder="Cliente, proveedor, planta..." /></div>
                                <div class="f3"><label>Dirección</label><input type="text" name="Direccion" maxlength="600" class="form-control" placeholder="Dirección de la parada" /></div>
                                <div class="f3"><label>Llegada programada</label><input type="datetime-local" name="FechaHoraLlegadaProgramada" class="form-control" /></div>
                                <div class="f3"><label>Salida programada</label><input type="datetime-local" name="FechaHoraSalidaProgramada" class="form-control" /></div>
                                <div class="f3"><label>Contacto</label><input type="text" name="ContactoNombre" maxlength="200" class="form-control" placeholder="Nombre" /></div>
                                <div class="f3"><label>Teléfono</label><input type="text" name="ContactoTelefono" maxlength="50" class="form-control" placeholder="Teléfono" /></div>
                                <div class="f8"><label>Observaciones</label><input type="text" name="Observaciones" maxlength="1200" class="form-control" placeholder="Indicaciones de acceso, material a recoger, documentos, etc." /></div>
                                <div class="f2"><div class="form-check mt-4"><input class="form-check-input" type="checkbox" name="RequiereEvidencia" value="true" id="RequiereEvidenciaNueva" /><label class="form-check-label" for="RequiereEvidenciaNueva">Requiere evidencia</label></div></div>
                                <div class="f2"><button type="submit" class="btn btn-primary btn-sm w-100"><i class="fa-solid fa-plus me-1"></i>Agregar</button></div>
                            </form>
                            <div class="text-muted small mt-2"><i class="fa-solid fa-circle-info me-1"></i>Origen y Retorno final los controla el sistema. Las entregas provenientes de un Embarque se crean y vinculan automáticamente; este formulario se usa para paradas adicionales.</div>
                        </div>
                    </div>
                }
                @if (Model.Paradas == null || Model.Paradas.Count == 0)
                {
                    <div class="empty"><i class="fa-solid fa-route me-1"></i>Este viaje todavía no tiene paradas registradas.</div>
                }
                else
                {
                    var paradasOrdenadas = Model.Paradas.OrderBy(x => x.Secuencia).ThenBy(x => x.ViajeParadaID).ToList();
                    <div class="route-timeline">
                        @for (var indice = 0; indice < paradasOrdenadas.Count; indice++)
                        {
                            var parada = paradasOrdenadas[indice];
                            var anterior = indice > 0 ? paradasOrdenadas[indice - 1] : null;
                            var siguiente = indice < paradasOrdenadas.Count - 1 ? paradasOrdenadas[indice + 1] : null;
                            var esProxima = proximaParada?.ViajeParadaID == parada.ViajeParadaID;
                            var resuelta = parada.Estatus is "Completada" or "Omitida" or "Cancelada";
                            var ligadaEmbarque = parada.Embarques != null && parada.Embarques.Count > 0;
                            var embarquesResueltos = ligadaEmbarque && parada.Embarques.All(x => x.Estatus is "Entregado" or "Cancelado");
                            var puedeModificar = puedeAdministrarParadas && !resuelta && !ligadaEmbarque && (Model.Estatus == "Programado" || parada.Estatus == "Pendiente");
                            var baseMover = puedeAdministrarParadas && !resuelta && parada.TipoParada != "Origen" && !parada.CierraViaje && (Model.Estatus == "Programado" || parada.Estatus == "Pendiente");
                            var anteriorResuelta = anterior != null && anterior.Estatus is "Completada" or "Omitida" or "Cancelada";
                            var siguienteResuelta = siguiente != null && siguiente.Estatus is "Completada" or "Omitida" or "Cancelada";
                            var puedeSubir = baseMover && anterior != null && anterior.TipoParada != "Origen" && !anterior.CierraViaje && !anteriorResuelta && (Model.Estatus == "Programado" || anterior.Estatus == "Pendiente");
                            var puedeBajar = baseMover && siguiente != null && siguiente.TipoParada != "Origen" && !siguiente.CierraViaje && !siguienteResuelta && (Model.Estatus == "Programado" || siguiente.Estatus == "Pendiente");
                            var puedeEliminar = Model.Estatus == "Programado" && !resuelta && parada.TipoParada != "Origen" && !parada.CierraViaje && !ligadaEmbarque;
                            var puedeOmitir = Model.Estatus == "En curso" && esProxima && !resuelta && parada.TipoParada != "Origen" && !parada.CierraViaje && (!ligadaEmbarque || embarquesResueltos);
                            <div class="route-stop @(resuelta ? "complete" : esProxima ? "current" : "")">
                                <div class="route-stop-marker"><i class="fa-solid @IconoParada(parada.TipoParada)"></i></div>
                                <div class="route-stop-card">
                                    <div class="route-stop-top">
                                        <div>
                                            <div class="d-flex align-items-center gap-2 flex-wrap">
                                                <h4 class="route-stop-title">@parada.Secuencia. @parada.Lugar</h4>
                                                <span class="badge badge-mini @BadgeParada(parada.Estatus)">@parada.Estatus</span>
                                                <span class="badge bg-light text-dark border badge-mini">@parada.TipoParadaTexto</span>
                                                @if (parada.CierraViaje)
                                                {
                                                    <span class="badge bg-dark badge-mini">Cierra viaje</span>
                                                }
                                                @if (ligadaEmbarque)
                                                {
                                                    <span class="badge bg-primary badge-mini">Embarque</span>
                                                }
                                            </div>
                                            <div class="route-stop-sub">@(!string.IsNullOrWhiteSpace(parada.TipoOperacion) ? parada.TipoOperacion : parada.TipoParadaTexto)@(!string.IsNullOrWhiteSpace(parada.Direccion) ? $" · {parada.Direccion}" : "")</div>
                                        </div>
                                        @if (puedeSubir || puedeBajar || puedeModificar || puedeEliminar)
                                        {
                                            <div class="route-stop-actions">
                                                @if (puedeSubir)
                                                {
                                                    <form asp-controller="LogisticaViajes" asp-action="MoverParada" method="post">
                                                        @Html.AntiForgeryToken()
                                                        <input type="hidden" name="viajeId" value="@Model.ViajeID" />
                                                        <input type="hidden" name="viajeParadaId" value="@parada.ViajeParadaID" />
                                                        <input type="hidden" name="direccion" value="subir" />
                                                        <button type="submit" class="btn btn-outline-secondary btn-sm" title="Subir parada"><i class="fa-solid fa-arrow-up"></i></button>
                                                    </form>
                                                }
                                                @if (puedeBajar)
                                                {
                                                    <form asp-controller="LogisticaViajes" asp-action="MoverParada" method="post">
                                                        @Html.AntiForgeryToken()
                                                        <input type="hidden" name="viajeId" value="@Model.ViajeID" />
                                                        <input type="hidden" name="viajeParadaId" value="@parada.ViajeParadaID" />
                                                        <input type="hidden" name="direccion" value="bajar" />
                                                        <button type="submit" class="btn btn-outline-secondary btn-sm" title="Bajar parada"><i class="fa-solid fa-arrow-down"></i></button>
                                                    </form>
                                                }
                                                @if (puedeModificar)
                                                {
                                                    <button type="button" class="btn btn-outline-primary btn-sm" data-bs-toggle="collapse" data-bs-target="#editarParada-@parada.ViajeParadaID" title="Editar parada"><i class="fa-solid fa-pen"></i></button>
                                                }
                                                @if (puedeEliminar)
                                                {
                                                    <form asp-controller="LogisticaViajes" asp-action="EliminarParada" method="post" onsubmit="return confirm('¿Retirar esta parada de la ruta?');">
                                                        @Html.AntiForgeryToken()
                                                        <input type="hidden" name="viajeId" value="@Model.ViajeID" />
                                                        <input type="hidden" name="viajeParadaId" value="@parada.ViajeParadaID" />
                                                        <button type="submit" class="btn btn-outline-danger btn-sm" title="Eliminar parada"><i class="fa-solid fa-trash"></i></button>
                                                    </form>
                                                }
                                            </div>
                                        }
                                    </div>
                                    <div class="route-stop-meta">
                                        <div class="route-meta"><span>Llegada programada</span><strong>@(parada.FechaHoraLlegadaProgramada.HasValue? parada.FechaHoraLlegadaProgramada.Value.ToString("dd/MM/yyyy HH:mm") : "-")</strong></div>
                                        <div class="route-meta"><span>Salida programada</span><strong>@(parada.FechaHoraSalidaProgramada.HasValue? parada.FechaHoraSalidaProgramada.Value.ToString("dd/MM/yyyy HH:mm") : "-")</strong></div>
                                        <div class="route-meta"><span>Tiempo real</span><strong>@(parada.FechaLlegadaReal.HasValue ? $"Llegó {parada.FechaLlegadaReal.Value:dd/MM HH:mm}" : "Sin llegada")@(parada.FechaSalidaReal.HasValue ? $" · Salió {parada.FechaSalidaReal.Value:dd/MM HH:mm}" : "")</strong></div>
                                        <div class="route-meta"><span>Evidencias</span><strong>@parada.TotalEvidencias @(parada.RequiereEvidencia ? "· requerida" : "")</strong></div>
                                    </div>
                                    @if (!string.IsNullOrWhiteSpace(parada.ContactoNombre) || !string.IsNullOrWhiteSpace(parada.ContactoTelefono) || !string.IsNullOrWhiteSpace(parada.Observaciones))
                                    {
                                        <div class="route-empty-note mt-2">
                                            @if (!string.IsNullOrWhiteSpace(parada.ContactoNombre) || !string.IsNullOrWhiteSpace(parada.ContactoTelefono))
                                            {
                                                <div>
                                                    <strong>Contacto:</strong> @TxtVisible(parada.ContactoNombre)
                                                    @if (!string.IsNullOrWhiteSpace(parada.ContactoTelefono))
                                                    {
                                                        <span>· @parada.ContactoTelefono</span>
                                                    }
                                                </div>
                                            }
                                            @if (!string.IsNullOrWhiteSpace(parada.Observaciones))
                                            {
                                                <div class="mt-1"><strong>Indicaciones:</strong> @TxtVisible(parada.Observaciones)</div>
                                            }
                                        </div>
                                    }
                                    @if (ligadaEmbarque)
                                    {
                                        <div class="route-shipments">
                                            <div class="fw-bold small"><i class="fa-solid fa-boxes-stacked me-1"></i>Embarques en esta parada</div>
                                            @foreach (var embarque in parada.Embarques.OrderBy(x => x.OrdenEntrega ?? int.MaxValue).ThenBy(x => x.EmbarqueID))
                                            {
                                                <div class="route-shipment">
                                                    <div><strong>@embarque.Folio</strong> · @embarque.Cliente · @embarque.TotalPiezas.ToString("N0") PZA <span class="badge bg-light text-dark border ms-1">@embarque.Estatus</span></div>
                                                    <a asp-controller="LogisticaEmbarques" asp-action="Detalle" asp-route-id="@embarque.EmbarqueID" class="btn btn-outline-primary btn-sm"><i class="fa-solid fa-up-right-from-square me-1"></i>Ver</a>
                                                </div>
                                            }
                                            @if (!resuelta)
                                            {
                                                <div class="route-empty-note mt-2"><i class="fa-solid fa-lock me-1"></i>Los datos de esta parada vinculada no se editan desde Viajes. Cambia la programación desde Centro Operativo para mantener sincronizado el embarque.</div>
                                            }
                                        </div>
                                    }
                                    @if (puedeOmitir)
                                    {
                                        <div class="collapse mt-2" id="omitirParada-@parada.ViajeParadaID">
                                            <form asp-controller="LogisticaViajes" asp-action="OmitirParada" method="post" class="d-flex gap-2">
                                                @Html.AntiForgeryToken()
                                                <input type="hidden" name="viajeId" value="@Model.ViajeID" />
                                                <input type="hidden" name="viajeParadaId" value="@parada.ViajeParadaID" />
                                                <input type="text" name="motivo" maxlength="1000" class="form-control form-control-sm" required placeholder="Motivo de omisión" />
                                                <button type="submit" class="btn btn-warning btn-sm" onclick="return confirm('¿Omitir esta parada y continuar con la siguiente?');">Omitir</button>
                                            </form>
                                        </div>
                                        <button type="button" class="btn btn-outline-warning btn-sm mt-2" data-bs-toggle="collapse" data-bs-target="#omitirParada-@parada.ViajeParadaID"><i class="fa-solid fa-forward me-1"></i>Omitir parada</button>
                                    }
                                    @if (puedeModificar)
                                    {
                                        <div class="collapse route-edit" id="editarParada-@parada.ViajeParadaID">
                                            <form asp-controller="LogisticaViajes" asp-action="EditarParada" method="post" class="compact-form">
                                                @Html.AntiForgeryToken()
                                                <input type="hidden" name="ViajeID" value="@Model.ViajeID" />
                                                <input type="hidden" name="ViajeParadaID" value="@parada.ViajeParadaID" />
                                                <input type="hidden" name="Secuencia" value="@parada.Secuencia" />
                                                <input type="hidden" name="RowVersion" value="@parada.RowVersion" />
                                                <div class="f3">
                                                    <label>Tipo</label>
                                                    <select name="TipoParada" class="form-select" disabled="@(parada.TipoParada == "Origen" || parada.CierraViaje ? "disabled" : null)">
                                                        <option value="Entrega" selected="@(parada.TipoParada == "Entrega")">Entrega</option>
                                                        <option value="Recoleccion" selected="@(parada.TipoParada == "Recoleccion")">Recolección</option>
                                                        <option value="Traslado" selected="@(parada.TipoParada == "Traslado")">Traslado</option>
                                                        <option value="Servicio" selected="@(parada.TipoParada == "Servicio")">Servicio</option>
                                                        <option value="Otro" selected="@(parada.TipoParada == "Otro")">Otro</option>
                                                        <option value="Retorno" selected="@(parada.TipoParada == "Retorno")">Retorno</option>
                                                        <option value="Origen" selected="@(parada.TipoParada == "Origen")">Origen</option>
                                                    </select>
                                                    @if (parada.TipoParada == "Origen" || parada.CierraViaje)
                                                    {
                                                        <input type="hidden" name="TipoParada" value="@parada.TipoParada" />
                                                    }
                                                </div>
                                                <div class="f3"><label>Operación</label><input type="text" name="TipoOperacion" maxlength="80" value="@parada.TipoOperacion" class="form-control" /></div>
                                                <div class="f3"><label class="required">Lugar</label><input type="text" name="Lugar" maxlength="300" value="@parada.Lugar" class="form-control" required /></div>
                                                <div class="f3"><label>Dirección</label><input type="text" name="Direccion" maxlength="600" value="@parada.Direccion" class="form-control" /></div>
                                                <div class="f3"><label>Llegada programada</label><input type="datetime-local" name="FechaHoraLlegadaProgramada" value="@(parada.FechaHoraLlegadaProgramada?.ToString("yyyy-MM-ddTHH:mm"))" class="form-control" /></div>
                                                <div class="f3"><label>Salida programada</label><input type="datetime-local" name="FechaHoraSalidaProgramada" value="@(parada.FechaHoraSalidaProgramada?.ToString("yyyy-MM-ddTHH:mm"))" class="form-control" /></div>
                                                <div class="f3"><label>Contacto</label><input type="text" name="ContactoNombre" maxlength="200" value="@parada.ContactoNombre" class="form-control" /></div>
                                                <div class="f3"><label>Teléfono</label><input type="text" name="ContactoTelefono" maxlength="50" value="@parada.ContactoTelefono" class="form-control" /></div>
                                                <div class="f8"><label>Observaciones</label><input type="text" name="Observaciones" maxlength="1200" value="@parada.Observaciones" class="form-control" /></div>
                                                <div class="f2"><div class="form-check mt-4"><input class="form-check-input" type="checkbox" name="RequiereEvidencia" value="true" id="Evidencia-@parada.ViajeParadaID" checked="@parada.RequiereEvidencia" /><label class="form-check-label" for="Evidencia-@parada.ViajeParadaID">Requiere evidencia</label></div></div>
                                                <div class="f2"><button type="submit" class="btn btn-primary btn-sm w-100"><i class="fa-solid fa-floppy-disk me-1"></i>Guardar</button></div>
                                            </form>
                                        </div>
                                    }
                                    @if (parada.Historial != null && parada.Historial.Count > 0)
                                    {
                                        <button type="button" class="btn btn-link btn-sm px-0 mt-1" data-bs-toggle="collapse" data-bs-target="#historialParada-@parada.ViajeParadaID"><i class="fa-solid fa-clock-rotate-left me-1"></i>Ver historial de parada</button>
                                        <div class="collapse route-history" id="historialParada-@parada.ViajeParadaID">
                                            @foreach (var h in parada.Historial.Take(8))
                                            {
                                                <div class="route-history-row"><span>@h.FechaEvento.ToString("dd/MM HH:mm")</span><strong>@TxtVisible(h.Evento.Replace("_", " "))</strong><span>@TxtVisible(h.Observaciones)</span></div>
                                            }
                                        </div>
                                    }
                                </div>
                            </div>
                        }
                    </div>
                }
            </div>

            <div class="tab-pane fade" id="tabIncidencias">
                <div class="section-head">
                    <h3>Incidencias del viaje</h3>
                    @if (Model.Estatus is not "Cancelado" and not "Completado")
                    {
                        <button class="btn btn-outline-danger btn-sm" type="button" data-bs-toggle="collapse" data-bs-target="#nuevaIncidencia"><i class="fa-solid fa-plus me-1"></i>Nueva incidencia</button>
                    }
                </div>

                @if (Model.Estatus is not "Cancelado" and not "Completado")
                {
                    <div class="collapse mb-3" id="nuevaIncidencia">
                        <form asp-controller="LogisticaViajes" asp-action="RegistrarIncidencia" method="post" class="compact-form">
                            @Html.AntiForgeryToken()
                            <input type="hidden" name="ViajeID" value="@Model.ViajeID" />
                            <div class="f3"><label class="required">Tipo</label><select name="Tipo" class="form-select" required><option value="">Selecciona...</option><option value="Unidad">Unidad</option><option value="Operador">Operador</option><option value="Tráfico">Tráfico</option><option value="Retraso">Retraso</option><option value="Ruta">Ruta</option><option value="Material">Material</option><option value="Recolección">Recolección</option><option value="Cliente / destino">Cliente / destino</option><option value="Seguridad">Seguridad</option><option value="Otro">Otro</option></select></div>
                            <div class="f2"><label class="required">Severidad</label><select name="Severidad" class="form-select" required><option value="Baja">Baja</option><option value="Media" selected>Media</option><option value="Alta">Alta</option><option value="Crítica">Crítica</option></select></div>
                            <div class="f3"><label>Responsable</label><input type="text" name="Responsable" maxlength="200" class="form-control" placeholder="Opcional" /></div>
                            <div class="f4"><label class="required">Descripción</label><input type="text" name="Descripcion" maxlength="1200" class="form-control" required placeholder="Describe la incidencia" /></div>
                            <div class="f12 text-end"><button type="submit" class="btn btn-danger btn-sm"><i class="fa-solid fa-plus me-1"></i>Registrar</button></div>
                        </form>
                    </div>
                }

                <div class="table-wrap">
                    <table class="table table-sm compact-table">
                        <thead><tr><th>ID</th><th>Fecha</th><th>Tipo</th><th>Severidad</th><th>Descripción</th><th>Responsable</th><th>Estatus</th><th></th></tr></thead>
                        <tbody>
                            @if (Model.Incidencias == null || Model.Incidencias.Count == 0)
                            {
                                <tr><td colspan="8"><div class="empty">Sin incidencias registradas.</div></td></tr>
                            }
                            else
                            {
                                foreach (var incidencia in Model.Incidencias)
                                {
                                    <tr>
                                        <td>VINC-@incidencia.ViajeIncidenciaID.ToString("000000")</td>
                                        <td class="text-nowrap">@incidencia.FechaRegistro.ToString("dd/MM/yyyy HH:mm")</td>
                                        <td>@incidencia.Tipo</td>
                                        <td><span class="badge badge-mini @BadgeSeveridad(incidencia.Severidad)">@incidencia.Severidad</span></td>
                                        <td style="min-width:220px">@incidencia.Descripcion</td>
                                        <td>@(string.IsNullOrWhiteSpace(incidencia.Responsable) ? "-" : incidencia.Responsable)</td>
                                        <td><span class="badge badge-mini @BadgeIncidencia(incidencia.Estatus)">@incidencia.Estatus</span></td>
                                        <td style="min-width:220px">
                                            @if (incidencia.EstaAbierta)
                                            {
                                                <form asp-controller="LogisticaViajes" asp-action="CerrarIncidencia" method="post" class="d-flex gap-1">
                                                    @Html.AntiForgeryToken()
                                                    <input type="hidden" name="ViajeID" value="@Model.ViajeID" />
                                                    <input type="hidden" name="ViajeIncidenciaID" value="@incidencia.ViajeIncidenciaID" />
                                                    <input type="text" name="Solucion" maxlength="1200" class="form-control form-control-sm" placeholder="Solución aplicada" required />
                                                    <button type="submit" class="btn btn-outline-success btn-sm"><i class="fa-solid fa-check"></i></button>
                                                </form>
                                            }
                                            else
                                            {
                                                <span class="text-success"><i class="fa-solid fa-circle-check me-1"></i>Cerrada</span>
                                            }
                                        </td>
                                    </tr>
                                }
                            }
                        </tbody>
                    </table>
                </div>
            </div>

            <div class="tab-pane fade" id="tabEvidencias">
                <div class="section-head">
                    <h3>Evidencias del viaje</h3>
                    @if (Model.Estatus is not "Cancelado" and not "Completado")
                    {
                        <button class="btn btn-outline-primary btn-sm" type="button" data-bs-toggle="collapse" data-bs-target="#nuevaEvidencia"><i class="fa-solid fa-plus me-1"></i>Agregar evidencia</button>
                    }
                </div>

                @if (Model.Estatus is not "Cancelado" and not "Completado")
                {
                    <div class="collapse mb-3" id="nuevaEvidencia">
                        <form asp-controller="LogisticaViajes" asp-action="SubirEvidencia" method="post" enctype="multipart/form-data" class="compact-form">
                            @Html.AntiForgeryToken()
                            <input type="hidden" name="viajeId" value="@Model.ViajeID" />
                            <div class="f3"><label>Tipo</label><select name="tipoEvidencia" class="form-select"><option value="General">General</option><option value="Salida">Salida</option><option value="Unidad">Unidad</option><option value="Ruta">Ruta</option><option value="Gasolina">Gasolina</option><option value="Regreso">Regreso</option><option value="Incidencia">Incidencia</option></select></div>
                            <div class="f4"><label class="required">Fotografía / archivo</label><input type="file" name="archivo" class="form-control" accept=".jpg,.jpeg,.png,.pdf,image/jpeg,image/png,application/pdf" required /></div>
                            <div class="f4"><label>Observaciones</label><input type="text" name="observaciones" maxlength="1000" class="form-control" placeholder="Opcional" /></div>
                            <div class="f1"><button type="submit" class="btn btn-primary btn-sm w-100"><i class="fa-solid fa-camera me-1"></i>Agregar</button></div>
                        </form>
                    </div>
                }

                @if (Model.Evidencias == null || Model.Evidencias.Count == 0)
                {
                    <div class="empty">Sin evidencias registradas.</div>
                }
                else
                {
                    <div class="evidence-grid">
                        @foreach (var evidencia in Model.Evidencias)
                        {
                            <div class="evidence-item">
                                <div class="d-flex justify-content-between gap-2">
                                    <div>
                                        <div class="evidence-name">@evidencia.NombreOriginal</div>
                                        <div class="evidence-meta">@evidencia.TipoEvidencia · @evidencia.FechaCarga.ToString("dd/MM/yyyy HH:mm")</div>
                                        @if (!string.IsNullOrWhiteSpace(evidencia.Observaciones))
                                        {
                                            <div class="evidence-meta">@TxtVisible(evidencia.Observaciones)</div>
                                        }
                                    </div>
                                    <div class="d-flex gap-1">
                                        <a asp-controller="LogisticaViajes" asp-action="VerEvidencia" asp-route-id="@evidencia.ViajeEvidenciaID" class="btn btn-outline-primary btn-sm"><i class="fa-solid fa-eye"></i></a>
                                        @{
                                            var evidenciaInmutable = Model.Estatus is "Cancelado" or "Completado"
                                            || (string.Equals(evidencia.TipoEvidencia, "Salida", StringComparison.OrdinalIgnoreCase) && Model.FechaSalidaReal.HasValue)
                                            || (string.Equals(evidencia.TipoEvidencia, "Regreso", StringComparison.OrdinalIgnoreCase) && Model.FechaRegresoReal.HasValue);
                                        }
                                        @if (!evidenciaInmutable)
                                        {
                                            <form asp-controller="LogisticaViajes" asp-action="EliminarEvidencia" method="post" onsubmit="return confirm('¿Retirar esta evidencia?');">
                                                @Html.AntiForgeryToken()
                                                <input type="hidden" name="viajeId" value="@Model.ViajeID" />
                                                <input type="hidden" name="evidenciaId" value="@evidencia.ViajeEvidenciaID" />
                                                <button type="submit" class="btn btn-outline-danger btn-sm"><i class="fa-solid fa-trash"></i></button>
                                            </form>
                                        }
                                    </div>
                                </div>
                            </div>
                        }
                    </div>
                }
            </div>

            <div class="tab-pane fade" id="tabHistorial">
                <div class="section-head"><h3>Historial del viaje</h3></div>
                @if (Model.Historial == null || Model.Historial.Count == 0)
                {
                    <div class="empty">Sin movimientos registrados.</div>
                }
                else
                {
                    foreach (var movimiento in Model.Historial)
                    {
                        <div class="history-row">
                            <div class="history-date">@movimiento.FechaEvento.ToString("dd/MM/yyyy HH:mm")</div>
                            <div class="history-event">@TxtVisible(movimiento.Evento.Replace("_", " "))</div>
                            <div>
                                @if (!string.IsNullOrWhiteSpace(movimiento.EstadoAnterior) || !string.IsNullOrWhiteSpace(movimiento.EstadoNuevo))
                                {
                                    <div class="mb-1">
                                        @if (!string.IsNullOrWhiteSpace(movimiento.EstadoAnterior))
                                        {
                                            <span>@movimiento.EstadoAnterior</span>
                                        }
                                        @if (!string.IsNullOrWhiteSpace(movimiento.EstadoNuevo))
                                        {
                                            <span> → @movimiento.EstadoNuevo</span>
                                        }
                                    </div>
                                }
                                @if (!string.IsNullOrWhiteSpace(movimiento.Observaciones))
                                {
                                    <div class="text-muted">@TxtVisible(movimiento.Observaciones)</div>
                                }
                            </div>
                            <div class="history-user">@movimiento.Usuario</div>
                        </div>
                    }
                }
            </div>
        </div>
    </div>
</div>
