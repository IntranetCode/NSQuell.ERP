@{
    Layout = "~/Views/Shared/_Layout.cshtml";
    ViewData["Title"] = "Calendario de viajes";
}
@section Styles {
    <link rel="stylesheet" href="~/css/logistica.css" asp-append-version="true" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/fullcalendar@6.1.15/index.global.min.css" />
}
<style>
    :root {
        --lv-blue: #173a7a;
        --lv-text: #172033;
        --lv-muted: #6d7888;
        --lv-border: #dce4ee;
        --lv-shadow: 0 8px 24px rgba(22,42,75,.06)
    }

    .cal-page {
        max-width: 1720px;
        margin: 0 auto;
        padding: 18px 20px 30px;
        color: var(--lv-text)
    }

    .cal-head {
        display: flex;
        justify-content: space-between;
        align-items: center;
        gap: 12px;
        flex-wrap: wrap;
        padding: 15px 17px;
        margin-bottom: 14px;
        border: 1px solid var(--lv-border);
        border-left: 4px solid var(--lv-blue);
        border-radius: 12px;
        background: #fff;
        box-shadow: var(--lv-shadow)
    }

    .cal-title {
        margin: 0;
        color: var(--lv-text);
        font-size: 1.48rem;
        font-weight: 800;
        letter-spacing: -.02em
    }

        .cal-title i {
            color: var(--lv-blue)
        }

    .cal-subtitle {
        margin: 3px 0 0;
        color: var(--lv-muted);
        font-size: .86rem;
        font-weight: 500
    }

    .cal-actions {
        display: flex;
        gap: 6px;
        flex-wrap: wrap
    }

        .cal-actions .btn {
            min-height: 34px;
            border-radius: 8px;
            font-weight: 700;
            display: inline-flex;
            align-items: center
        }

    .cal-toolbar {
        display: grid;
        grid-template-columns: minmax(250px,1.5fr) minmax(150px,.8fr) auto;
        gap: 8px;
        align-items: end;
        padding: 14px 12px 12px;
        margin-bottom: 12px;
        border: 1px solid var(--lv-border);
        border-radius: 12px;
        background: #fff;
        box-shadow: 0 5px 16px rgba(25,47,80,.035)
    }

    .cal-field label {
        display: block;
        margin-bottom: 3px;
        color: #465164;
        font-size: .69rem;
        font-weight: 700
    }

    .cal-field .form-control, .cal-field .form-select {
        min-height: 38px;
        border-radius: 8px;
        border-color: #d4dde7;
        font-size: .8rem
    }

    .cal-toolbar .btn {
        min-height: 38px;
        border-radius: 8px;
        font-weight: 700
    }

    .cal-summary {
        display: grid;
        grid-template-columns: repeat(4,minmax(130px,1fr));
        gap: 8px;
        margin-bottom: 12px
    }

        .cal-summary > div {
            min-height: 70px;
            padding: 10px 12px;
            border: 1px solid var(--lv-border);
            border-radius: 10px;
            background: #fff;
            box-shadow: 0 4px 13px rgba(22,42,75,.035)
        }

        .cal-summary strong {
            display: block;
            margin-bottom: 3px;
            color: var(--lv-blue);
            font-size: 1.2rem;
            font-weight: 800
        }

        .cal-summary span {
            display: block;
            color: var(--lv-muted);
            font-size: .7rem;
            font-weight: 700
        }

    .cal-shell {
        padding: 12px;
        border: 1px solid var(--lv-border);
        border-radius: 12px;
        background: #fff;
        box-shadow: var(--lv-shadow);
        overflow-x: auto
    }

    #calendar {
        min-width: 720px
    }

    .fc {
        font-size: .8rem
    }

        .fc .fc-toolbar {
            gap: 8px;
            flex-wrap: wrap
        }

        .fc .fc-toolbar-title {
            color: var(--lv-text);
            font-size: 1.05rem;
            font-weight: 800
        }

        .fc .fc-button {
            font-size: .74rem;
            padding: .35rem .55rem
        }

        .fc .fc-button-primary {
            background: #233f80;
            border-color: #233f80;
            border-radius: 7px;
            font-weight: 700;
            box-shadow: none
        }

            .fc .fc-button-primary:not(:disabled):hover, .fc .fc-button-primary:not(:disabled).fc-button-active {
                background: #173a7a;
                border-color: #173a7a
            }

        .fc .fc-scrollgrid, .fc-theme-standard td, .fc-theme-standard th {
            border-color: #e7ecf2
        }

        .fc .fc-col-header-cell {
            background: #f5f7fa
        }

        .fc .fc-col-header-cell-cushion, .fc .fc-daygrid-day-number {
            color: #536072;
            font-weight: 700;
            text-decoration: none
        }

        .fc .fc-day-today {
            background: #f2f6fb !important
        }

        .fc .fc-daygrid-event {
            border: 0;
            border-radius: 5px;
            padding: 2px 4px;
            cursor: pointer;
            box-shadow: 0 2px 4px rgba(0,0,0,.08)
        }

    .legend {
        display: flex;
        gap: 12px;
        flex-wrap: wrap;
        margin-top: 10px;
        padding: 9px 11px;
        border: 1px solid var(--lv-border);
        border-radius: 9px;
        background: #fff;
        font-size: .72rem
    }

    .legend-item {
        display: flex;
        align-items: center;
        gap: 5px;
        color: var(--lv-muted);
        font-weight: 600
    }

    .legend-dot {
        width: 9px;
        height: 9px;
        border-radius: 50%;
        display: inline-block
    }

    #viajeModal .modal-content {
        border: 1px solid var(--lv-border);
        border-radius: 12px;
        box-shadow: 0 18px 40px rgba(18,33,57,.16)
    }

    #viajeModal .modal-header {
        background: #f6f8fb;
        border-bottom-color: #e4eaf1
    }

    .modal-data {
        display: grid;
        grid-template-columns: repeat(2,minmax(0,1fr));
        gap: 9px 14px
    }

        .modal-data > div {
            padding: 7px 8px;
            border-bottom: 1px solid #edf1f5
        }

        .modal-data label {
            display: block;
            margin-bottom: 1px;
            color: #7a8492;
            font-size: .66rem;
            font-weight: 700;
            text-transform: uppercase
        }

        .modal-data > div > div {
            font-size: .82rem;
            font-weight: 500
        }

    html[data-nsq-theme="dark"] .cal-page {
        color: #e7edf6
    }

    html[data-nsq-theme="dark"] .cal-head, html[data-nsq-theme="dark"] .cal-toolbar, html[data-nsq-theme="dark"] .cal-summary > div, html[data-nsq-theme="dark"] .cal-shell, html[data-nsq-theme="dark"] .legend, html[data-nsq-theme="dark"] #viajeModal .modal-content {
        background: #111b2d;
        border-color: #2a3a50;
        box-shadow: none
    }

    html[data-nsq-theme="dark"] .cal-title, html[data-nsq-theme="dark"] .fc .fc-toolbar-title {
        color: #eef4fb
    }

    html[data-nsq-theme="dark"] .cal-subtitle, html[data-nsq-theme="dark"] .cal-summary span, html[data-nsq-theme="dark"] .legend-item {
        color: #9eacbf
    }

    html[data-nsq-theme="dark"] .cal-field label {
        color: #c7d3e2
    }

    html[data-nsq-theme="dark"] .cal-field .form-control, html[data-nsq-theme="dark"] .cal-field .form-select {
        background: #0d1727;
        color: #eef4fb;
        border-color: #314158
    }

    @@media(max-width:800px) {
        .cal-page {
            padding: 14px 10px 24px
        }

        .cal-head {
            padding: 12px
        }

        .cal-actions {
            width: 100%
        }

            .cal-actions .btn {
                flex: 1
            }

        .cal-toolbar {
            grid-template-columns: 1fr
        }

        .cal-summary {
            grid-template-columns: repeat(2,minmax(0,1fr))
        }

        .modal-data {
            grid-template-columns: 1fr
        }
    }
</style>

<div class="cal-page">
    <div class="cal-head">
        <div>
            <h1 class="cal-title"><i class="fa-solid fa-calendar-days me-1"></i>Calendario de viajes</h1>
            <p class="cal-subtitle">Programación de rutas de personal, recolecciones, traslados y entregas operativas.</p>
        </div>
        <div class="cal-actions">
            <a asp-controller="LogisticaViajes" asp-action="Index" class="btn btn-outline-secondary btn-sm"><i class="fa-solid fa-arrow-left me-1"></i>Viajes</a>
            <a asp-controller="LogisticaViajes" asp-action="Crear" class="btn btn-primary btn-sm"><i class="fa-solid fa-plus me-1"></i>Nuevo viaje</a>
        </div>
    </div>

    <div class="cal-toolbar">
        <div class="cal-field">
            <label>Buscar</label>
            <input id="q" class="form-control" autocomplete="off" placeholder="Folio, origen, destino, chofer o motivo" />
        </div>
        <div class="cal-field">
            <label>Estatus</label>
            <select id="estatus" class="form-select">
                <option value="">Todos</option>
                <option>Programado</option>
                <option>En curso</option>
                <option>Completado</option>
                <option>Cancelado</option>
            </select>
        </div>
        <div class="d-flex gap-1">
            <button id="btnAplicar" type="button" class="btn btn-primary btn-sm"><i class="fa-solid fa-filter me-1"></i>Aplicar</button>
            <button id="btnLimpiar" type="button" class="btn btn-outline-secondary btn-sm">Limpiar</button>
        </div>
    </div>

    <div class="cal-summary">
        <div><strong id="totalEventos">0</strong><span>viajes visibles</span></div>
        <div><strong id="totalProgramados">0</strong><span>programados</span></div>
        <div><strong id="totalCurso">0</strong><span>en curso</span></div>
        <div><strong id="totalIncidencias">0</strong><span>con incidencia</span></div>
    </div>

    <div class="cal-shell"><div id="calendar"></div></div>

    <div class="legend">
        <span class="legend-item"><span class="legend-dot" style="background:#0d6efd"></span>Programado</span>
        <span class="legend-item"><span class="legend-dot" style="background:#fd7e14"></span>En curso</span>
        <span class="legend-item"><span class="legend-dot" style="background:#198754"></span>Completado</span>
        <span class="legend-item"><span class="legend-dot" style="background:#6c757d"></span>Cancelado</span>
        <span class="legend-item"><i class="fa-solid fa-triangle-exclamation text-danger"></i>Incidencia</span>
    </div>
</div>

<div class="modal fade" id="viajeModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header py-2">
                <h5 class="modal-title fs-6" id="mTitulo">Viaje</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body">
                <div class="modal-data">
                    <div><label>Tipo de salida</label><div id="mTipo">-</div></div>
                    <div><label>Estatus</label><div id="mEstatus">-</div></div>
                    <div><label>Fecha programada</label><div id="mFecha">-</div></div>
                    <div><label>Hora de salida</label><div id="mHora">-</div></div>
                    <div><label>Origen</label><div id="mOrigen">-</div></div>
                    <div><label>Destino</label><div id="mDestino">-</div></div>
                    <div><label>Unidad</label><div id="mUnidad">-</div></div>
                    <div><label>Chofer</label><div id="mOperador">-</div></div>
                    <div style="grid-column:1/-1"><label>Motivo</label><div id="mMotivo">-</div></div>
                </div>
                <div id="mAlerta" class="alert alert-warning py-2 px-3 mt-3 mb-0 d-none"><i class="fa-solid fa-triangle-exclamation me-1"></i>Este viaje tiene incidencia registrada.</div>
            </div>
            <div class="modal-footer py-2">
                <button type="button" class="btn btn-outline-secondary btn-sm" data-bs-dismiss="modal">Cerrar</button>
                <a id="mAbrir" class="btn btn-primary btn-sm"><i class="fa-solid fa-arrow-up-right-from-square me-1"></i>Abrir viaje</a>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/fullcalendar@6.1.15/index.global.min.js"></script>
    <script>
        (()=>{
            const q=document.getElementById('q');
            const estatus=document.getElementById('estatus');
            const color=e=>e==='En curso'?'#fd7e14':e==='Completado'?'#198754':e==='Cancelado'?'#6c757d':'#0d6efd';
            const fechaLocal=f=>`${f.getFullYear()}-${String(f.getMonth()+1).padStart(2,'0')}-${String(f.getDate()).padStart(2,'0')}`;

            const calendar=new FullCalendar.Calendar(document.getElementById('calendar'),{
                locale:'es',
                initialView:'dayGridMonth',
                firstDay:1,
                height:'auto',
                displayEventTime:false,
                dayMaxEvents:4,
                headerToolbar:{left:'prev,next today',center:'title',right:'dayGridMonth,timeGridWeek,listWeek'},
                buttonText:{today:'Hoy',month:'Mes',week:'Semana',list:'Lista'},
                datesSet:()=>cargar(),
                eventClick:info=>mostrar(info.event.extendedProps)
            });

            async function cargar(){
                const inicio=calendar.view.activeStart;
                const fin=new Date(calendar.view.activeEnd);
                fin.setDate(fin.getDate()-1);
                const qs=new URLSearchParams({desde:fechaLocal(inicio),hasta:fechaLocal(fin)});
                if(q.value.trim())qs.set('q',q.value.trim());
                if(estatus.value)qs.set('estatus',estatus.value);
                try{
                    const r=await fetch('@Url.Action("EventosCalendario", "LogisticaViajes")?'+qs.toString(),{headers:{'X-Requested-With':'XMLHttpRequest'}});
                    const data=await r.json();
                    if(!r.ok||!data.ok)throw new Error(data.mensaje||'No fue posible cargar los viajes.');
                    const eventos=Array.isArray(data.eventos)?data.eventos:[];
                    calendar.removeAllEvents();
                    calendar.addEventSource(eventos.map(x=>({
                        id:`VIAJE-${x.viajeId}`,
                        title:`${x.hora?x.hora+' ':''}${x.titulo}`,
                        start:x.fecha,
                        allDay:true,
                        backgroundColor:color(x.estatus),
                        borderColor:color(x.estatus),
                        textColor:'#fff',
                        extendedProps:x
                    })));
                    document.getElementById('totalEventos').textContent=eventos.length;
                    document.getElementById('totalProgramados').textContent=eventos.filter(x=>x.estatus==='Programado').length;
                    document.getElementById('totalCurso').textContent=eventos.filter(x=>x.estatus==='En curso').length;
                    document.getElementById('totalIncidencias').textContent=eventos.filter(x=>x.incidencia).length;
                }catch(e){
                    calendar.removeAllEvents();
                    document.getElementById('totalEventos').textContent='0';
                    document.getElementById('totalProgramados').textContent='0';
                    document.getElementById('totalCurso').textContent='0';
                    document.getElementById('totalIncidencias').textContent='0';
                    alert(e.message||'No fue posible cargar los viajes.');
                }
            }

            function mostrar(p){
                document.getElementById('mTitulo').textContent=p.titulo||'Viaje';
                document.getElementById('mTipo').textContent=p.tipoViaje||'-';
                document.getElementById('mEstatus').textContent=p.estatus||'-';
                document.getElementById('mFecha').textContent=p.fecha||'-';
                document.getElementById('mHora').textContent=p.hora||'Pendiente';
                document.getElementById('mOrigen').textContent=p.origen||'-';
                document.getElementById('mDestino').textContent=p.destino||'-';
                document.getElementById('mUnidad').textContent=p.unidad||'Pendiente';
                document.getElementById('mOperador').textContent=p.operador||'Pendiente';
                document.getElementById('mMotivo').textContent=p.motivo||'-';
                document.getElementById('mAlerta').classList.toggle('d-none',!p.incidencia);
                document.getElementById('mAbrir').href=p.url||'#';
                bootstrap.Modal.getOrCreateInstance(document.getElementById('viajeModal')).show();
            }

            document.getElementById('btnAplicar').addEventListener('click',cargar);
            document.getElementById('btnLimpiar').addEventListener('click',()=>{q.value='';estatus.value='';cargar();});
            q.addEventListener('keydown',e=>{if(e.key==='Enter'){e.preventDefault();cargar();}});
            calendar.render();
        })();
    </script>
}
