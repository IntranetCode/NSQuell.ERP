@model ERP.NSQuell.Models.Compras.SeguimientoDireccionViewModel

@{
    ViewData["Title"] = "Seguimiento Dirección - Compras";
    var culturaMx = new System.Globalization.CultureInfo("es-MX");
}

@section Styles {
    <style>
        :root {
            --compras-text: #1f2937;
            --compras-muted: #6b7280;
            --compras-border: #e5e7eb;
            --ns-blue: #0b4f8f;
            --ns-blue-dark: #073763;
            --ns-blue-soft: #eaf3fb;
            --ns-orange: #ff7a00;
            --ns-orange-dark: #e85d04;
            --ns-orange-soft: #fff4e8;
            --success-soft: #ecfdf5;
            --success-text: #15803d;
            --danger-soft: #fef2f2;
            --danger-text: #b91c1c;
            --warning-soft: #fff7ed;
            --warning-text: #c2410c;
            --info-soft: #eff6ff;
            --info-text: #1d4ed8;
            --shadow-soft: 0 12px 28px rgba(15, 23, 42, 0.07);
        }

        .seguimiento-page {
            color: var(--compras-text);
        }

        .alert-compras {
            border-radius: 16px;
            padding: 14px 16px;
            border: 1px solid var(--compras-border);
            margin-bottom: 16px;
            font-weight: 700;
        }

        .alert-success-compras {
            background: var(--success-soft);
            color: #166534;
            border-color: #bbf7d0;
        }

        .alert-error-compras {
            background: var(--danger-soft);
            color: #991b1b;
            border-color: #fecaca;
        }

        .page-hero {
            background: radial-gradient(circle at 90% 20%, rgba(255, 122, 0, 0.13), transparent 30%), linear-gradient(135deg, #ffffff 0%, #f8fbff 100%);
            border: 1px solid var(--compras-border);
            border-radius: 24px;
            padding: 28px;
            margin-bottom: 18px;
            box-shadow: var(--shadow-soft);
            overflow: hidden;
            position: relative;
        }

            .page-hero::after {
                content: "SEG";
                position: absolute;
                right: 28px;
                top: 4px;
                font-size: 86px;
                font-weight: 1000;
                color: rgba(11, 79, 143, 0.05);
                letter-spacing: -0.08em;
            }

        .page-chip {
            display: inline-flex;
            border-radius: 999px;
            border: 1px solid #ffd2a3;
            background: var(--ns-orange-soft);
            color: var(--ns-orange-dark);
            padding: 7px 12px;
            font-size: 11px;
            font-weight: 900;
            letter-spacing: 0.12em;
            text-transform: uppercase;
            margin-bottom: 12px;
        }

        .page-title {
            font-size: clamp(28px, 4vw, 40px);
            font-weight: 1000;
            margin: 0 0 8px 0;
            color: var(--compras-text);
            letter-spacing: -0.04em;
        }

        .page-subtitle {
            color: var(--compras-muted);
            font-size: 14px;
            line-height: 1.7;
            font-weight: 600;
            max-width: 800px;
            margin: 0;
        }

        .btn-compras-main,
        .btn-compras-secondary,
        .btn-compras-blue {
            border-radius: 14px;
            padding: 10px 15px;
            text-decoration: none;
            font-weight: 900;
            display: inline-flex;
            align-items: center;
            justify-content: center;
            gap: 8px;
            border: 1px solid transparent;
            transition: all 0.2s ease;
            white-space: nowrap;
        }

        .btn-compras-main {
            background: linear-gradient(135deg, var(--ns-orange), var(--ns-orange-dark));
            color: white;
            box-shadow: 0 12px 26px rgba(255, 122, 0, 0.22);
        }

            .btn-compras-main:hover {
                color: white;
                transform: translateY(-2px);
            }

        .btn-compras-blue {
            background: linear-gradient(135deg, var(--ns-blue), var(--ns-blue-dark));
            color: white;
            box-shadow: 0 12px 26px rgba(11, 79, 143, 0.18);
        }

            .btn-compras-blue:hover {
                color: white;
                transform: translateY(-2px);
            }

        .btn-compras-secondary {
            background: white;
            color: var(--ns-blue);
            border-color: #cfe2f3;
        }

            .btn-compras-secondary:hover {
                background: var(--ns-blue-soft);
                color: var(--ns-blue-dark);
                transform: translateY(-2px);
            }

        .summary-grid {
            display: grid;
            grid-template-columns: repeat(5, minmax(0, 1fr));
            gap: 14px;
            margin-bottom: 18px;
        }

        .summary-card {
            background: white;
            border: 1px solid var(--compras-border);
            border-radius: 20px;
            padding: 18px;
            box-shadow: 0 10px 24px rgba(15, 23, 42, 0.05);
            min-height: 112px;
            position: relative;
            overflow: hidden;
        }

            .summary-card::after {
                content: "";
                position: absolute;
                right: -38px;
                bottom: -38px;
                width: 105px;
                height: 105px;
                border-radius: 999px;
                background: rgba(255, 122, 0, 0.06);
            }

        .summary-label {
            color: var(--compras-muted);
            font-size: 11px;
            text-transform: uppercase;
            letter-spacing: 0.10em;
            font-weight: 900;
            margin-bottom: 8px;
            position: relative;
            z-index: 2;
        }

        .summary-number {
            color: var(--compras-text);
            font-size: 31px;
            font-weight: 1000;
            line-height: 1;
            position: relative;
            z-index: 2;
        }

        .filters-card,
        .table-card,
        .load-card {
            background: white;
            border: 1px solid var(--compras-border);
            border-radius: 22px;
            padding: 18px;
            margin-bottom: 18px;
            box-shadow: 0 10px 24px rgba(15, 23, 42, 0.05);
        }

        .filter-label {
            font-size: 12px;
            font-weight: 900;
            color: var(--compras-muted);
            text-transform: uppercase;
            letter-spacing: 0.08em;
            margin-bottom: 6px;
        }

        .form-control,
        .form-select {
            border-radius: 14px;
            border-color: var(--compras-border);
            padding: 11px 14px;
            font-weight: 600;
            color: var(--compras-text);
        }

            .form-control:focus,
            .form-select:focus {
                border-color: var(--ns-blue);
                box-shadow: 0 0 0 0.18rem rgba(11, 79, 143, 0.12);
            }

        .section-title {
            font-size: 20px;
            font-weight: 1000;
            margin: 0;
            color: var(--compras-text);
        }

        .section-subtitle {
            font-size: 13px;
            color: var(--compras-muted);
            font-weight: 600;
            margin: 5px 0 0 0;
        }

        .seguimiento-table {
            width: 100%;
            border-collapse: separate;
            border-spacing: 0 10px;
            min-width: 1250px;
        }

            .seguimiento-table th {
                color: var(--compras-muted);
                font-size: 11px;
                text-transform: uppercase;
                letter-spacing: 0.10em;
                padding: 0 12px 6px;
                border: none;
                white-space: nowrap;
            }

            .seguimiento-table td {
                background: #f9fafb;
                border-top: 1px solid var(--compras-border);
                border-bottom: 1px solid var(--compras-border);
                color: #374151;
                padding: 14px 12px;
                font-size: 13px;
                font-weight: 650;
                vertical-align: middle;
            }

                .seguimiento-table td:first-child {
                    border-left: 1px solid var(--compras-border);
                    border-radius: 16px 0 0 16px;
                }

                .seguimiento-table td:last-child {
                    border-right: 1px solid var(--compras-border);
                    border-radius: 0 16px 16px 0;
                }

        .folio-text {
            color: var(--ns-blue-dark);
            font-weight: 1000;
        }

        .small-muted {
            color: var(--compras-muted);
            font-size: 12px;
            font-weight: 700;
        }

        .badge-compras,
        .badge-semaforo {
            display: inline-flex;
            align-items: center;
            border-radius: 999px;
            padding: 6px 10px;
            font-size: 11px;
            font-weight: 900;
            border: 1px solid transparent;
            white-space: nowrap;
        }

        .badge-pendiente {
            background: var(--warning-soft);
            color: var(--warning-text);
            border-color: #fed7aa;
        }

        .badge-revision {
            background: var(--info-soft);
            color: var(--info-text);
            border-color: #bfdbfe;
        }

        .badge-aprobada,
        .badge-verde {
            background: var(--success-soft);
            color: var(--success-text);
            border-color: #bbf7d0;
        }

        .badge-rechazada,
        .badge-rojo {
            background: var(--danger-soft);
            color: var(--danger-text);
            border-color: #fecaca;
        }

        .badge-cancelada,
        .badge-gris {
            background: #f3f4f6;
            color: #4b5563;
            border-color: #e5e7eb;
        }

        .badge-amarillo {
            background: var(--warning-soft);
            color: var(--warning-text);
            border-color: #fed7aa;
        }

        .progress-wrap {
            min-width: 170px;
        }

        .progress-top {
            display: flex;
            justify-content: space-between;
            gap: 10px;
            font-size: 11px;
            font-weight: 900;
            color: var(--compras-muted);
            margin-bottom: 7px;
        }

        .progress-track {
            height: 9px;
            border-radius: 999px;
            background: #e5e7eb;
            overflow: hidden;
            border: 1px solid #dbe3ea;
        }

        .progress-fill {
            height: 100%;
            border-radius: 999px;
            background: linear-gradient(90deg, var(--ns-blue), #2563eb);
        }

        .btn-table {
            border-radius: 999px;
            padding: 8px 13px;
            background: white;
            border: 1px solid #cfe2f3;
            color: var(--ns-blue);
            font-size: 12px;
            text-decoration: none;
            font-weight: 900;
            transition: all 0.2s ease;
            white-space: nowrap;
        }

            .btn-table:hover {
                background: var(--ns-blue);
                color: white;
            }

        .empty-state {
            background: #f9fafb;
            border: 1px dashed #d1d5db;
            border-radius: 20px;
            padding: 36px 20px;
            text-align: center;
            color: var(--compras-muted);
            font-weight: 700;
        }

        .load-grid {
            display: grid;
            gap: 12px;
        }

        .load-row {
            display: grid;
            grid-template-columns: 240px 1fr 80px;
            gap: 12px;
            align-items: center;
        }

        .load-name {
            font-weight: 1000;
            color: var(--compras-text);
        }

        .load-meta {
            color: var(--compras-muted);
            font-size: 12px;
            font-weight: 700;
        }

        .load-track {
            height: 28px;
            border-radius: 999px;
            background: #e5e7eb;
            overflow: hidden;
        }

        .load-fill {
            height: 100%;
            min-width: 36px;
            background: linear-gradient(135deg, var(--ns-blue), #2563eb);
            color: white;
            display: flex;
            align-items: center;
            justify-content: flex-end;
            padding-right: 10px;
            font-size: 12px;
            font-weight: 1000;
            border-radius: 999px;
        }

        @@media (max-width: 1100px) {
            .summary-grid {
                grid-template-columns: repeat(2, minmax(0, 1fr));
            }

            .load-row {
                grid-template-columns: 1fr;
            }
        }

        @@media (max-width: 700px) {
            .summary-grid {
                grid-template-columns: 1fr;
            }

            .btn-compras-main,
            .btn-compras-secondary,
            .btn-compras-blue {
                width: 100%;
            }
        }
    </style>
}

<div class="seguimiento-page">

    @if (TempData["Success"] != null)
    {
        <div class="alert-compras alert-success-compras">
            @TempData["Success"]
        </div>
    }

    @if (TempData["Error"] != null)
    {
        <div class="alert-compras alert-error-compras">
            @TempData["Error"]
        </div>
    }

    <div class="erp-page-breadcrumb">
        <a asp-controller="Compras" asp-action="BandejaDireccion" class="erp-btn-back">← Bandeja Dirección</a>
        <span>Inicio</span>
        <span>›</span>
        <span>Compras</span>
        <span>›</span>
        <strong>Seguimiento Dirección</strong>
    </div>

    <section class="page-hero">
        <div class="row align-items-center g-4">
            <div class="col-12 col-lg-8">
                <div class="page-chip">Seguimiento gerencial</div>

                <h1 class="page-title">Seguimiento de compras</h1>

                <p class="page-subtitle">
                    Vista de Dirección para monitorear el avance de solicitudes, estatus, tiempos por etapa,
                    retrasos y carga de trabajo por comprador.
                </p>
            </div>

            <div class="col-12 col-lg-4">
                <div class="d-flex justify-content-lg-end gap-2 flex-wrap">
                    <a asp-controller="Compras" asp-action="Index" class="btn-compras-secondary">
                        Panel compras
                    </a>

                    <a asp-controller="Compras" asp-action="Solicitudes" class="btn-compras-secondary">
                        Solicitudes
                    </a>

                    <a asp-controller="Compras" asp-action="BandejaDireccion" class="btn-compras-main">
                        Bandeja Dirección
                    </a>
                </div>
            </div>
        </div>
    </section>

    <section class="summary-grid">
        <div class="summary-card">
            <div class="summary-label">Total</div>
            <div class="summary-number">@Model.TotalSolicitudes</div>
        </div>

        <div class="summary-card">
            <div class="summary-label">Activas</div>
            <div class="summary-number">@Model.TotalActivas</div>
        </div>

        <div class="summary-card">
            <div class="summary-label">Cerradas</div>
            <div class="summary-number">@Model.TotalCerradas</div>
        </div>

        <div class="summary-card">
            <div class="summary-label">Retrasadas</div>
            <div class="summary-number">@Model.TotalRetrasadas</div>
        </div>

        <div class="summary-card">
            <div class="summary-label">Monto cotizado</div>
            <div class="summary-number" style="font-size:24px;">
                @String.Format(culturaMx, "{0:C}", Model.MontoTotalCotizado)
            </div>
        </div>
    </section>

    <section class="filters-card">
        <form method="get" asp-controller="Compras" asp-action="SeguimientoDireccion">
            <div class="row g-3 align-items-end">
                <div class="col-12 col-md-6 col-xl-3">
                    <label class="filter-label">Estatus</label>
                    <select name="estatusId" class="form-select">
                        @foreach (var estatus in Model.EstatusCatalogo)
                        {
                            <option value="@estatus.Value" selected="@(Model.FiltroEstatusID?.ToString() == estatus.Value ? "selected" : null)">
                                @estatus.Text
                            </option>
                        }
                    </select>
                </div>

                <div class="col-12 col-md-6 col-xl-3">
                    <label class="filter-label">Departamento</label>
                    <select name="departamento" class="form-select">
                        @foreach (var departamento in Model.DepartamentosCatalogo)
                        {
                            <option value="@departamento.Value" selected="@(string.Equals(Model.FiltroDepartamento, departamento.Value, StringComparison.OrdinalIgnoreCase) ? "selected" : null)">
                                @departamento.Text
                            </option>
                        }
                    </select>
                </div>

                <div class="col-12 col-md-6 col-xl-3">
                    <label class="filter-label">Comprador</label>
                    <select name="comprador" class="form-select">
                        @foreach (var comprador in Model.CompradoresCatalogo)
                        {
                            <option value="@comprador.Value" selected="@(string.Equals(Model.FiltroComprador, comprador.Value, StringComparison.OrdinalIgnoreCase) ? "selected" : null)">
                                @comprador.Text
                            </option>
                        }
                    </select>
                </div>

                <div class="col-12 col-md-6 col-xl-3">
                    <div class="d-flex gap-2 flex-wrap">
                        <label class="btn-compras-secondary" style="cursor:pointer;">
                            <input type="checkbox"
                                   name="soloRetrasadas"
                                   value="true"
                                   class="form-check-input me-1"
                            @(Model.SoloRetrasadas ? "checked" : "") />
                            Solo retrasadas
                        </label>

                        <button type="submit" class="btn-compras-main">
                            Filtrar
                        </button>

                        <a asp-controller="Compras" asp-action="SeguimientoDireccion" class="btn-compras-secondary">
                            Limpiar
                        </a>
                    </div>
                </div>
            </div>
        </form>
    </section>

    <section class="load-card">
        <div class="d-flex justify-content-between align-items-start flex-wrap gap-2 mb-3">
            <div>
                <h2 class="section-title">Carga por comprador</h2>
                <p class="section-subtitle">
                    Distribución de solicitudes asignadas o atendidas por comprador.
                </p>
            </div>
        </div>

        @if (Model.CargaCompradores.Any())
        {
            var maxCarga = Model.CargaCompradores.Max(x => x.TotalAsignadas);

            <div class="load-grid">
                @foreach (var carga in Model.CargaCompradores)
                {
                    var porcentaje = maxCarga <= 0 ? 0 : Math.Max(8, (carga.TotalAsignadas * 100) / maxCarga);

                    <div class="load-row">
                        <div>
                            <div class="load-name">@carga.Comprador</div>
                            <div class="load-meta">
                                Pendientes: @carga.Pendientes · Cotizando: @carga.Cotizando · O.C.: @carga.Ordenes · Retrasadas: @carga.Retrasadas
                            </div>
                        </div>

                        <div class="load-track">
                            <div class="load-fill" style="width:@porcentaje%">
                                @carga.TotalAsignadas
                            </div>
                        </div>

                        <div class="text-end fw-bold">
                            @String.Format(culturaMx, "{0:C}", carga.MontoTotal)
                        </div>
                    </div>
                }
            </div>
        }
        else
        {
            <div class="empty-state">
                No hay información de carga para los filtros seleccionados.
            </div>
        }
    </section>

    <section class="table-card">
        <div class="d-flex justify-content-between align-items-start flex-wrap gap-2 mb-3">
            <div>
                <h2 class="section-title">Seguimiento de solicitudes</h2>
                <p class="section-subtitle">
                    Solicitudes filtradas con semáforo de avance, tiempo en estatus y detalle por etapa.
                </p>
            </div>
        </div>

        @if (Model.Solicitudes.Any())
        {
            <div class="table-responsive">
                <table class="seguimiento-table">
                    <thead>
                        <tr>
                            <th>Folio</th>
                            <th>Fecha</th>
                            <th>Departamento</th>
                            <th>Solicitante</th>
                            <th>Comprador</th>
                            <th>Avance</th>
                            <th>Estatus</th>
                            <th>Días</th>
                            <th>Permitidos</th>
                            <th>Semáforo</th>
                            <th>Monto</th>
                            <th></th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in Model.Solicitudes)
                        {
                            <tr>
                                <td>
                                    <span class="folio-text">@(item.Folio ?? "Sin folio")</span>
                                    <div class="small-muted">@(item.TipoCompra ?? "-")</div>
                                </td>

                                <td>@item.FechaSolicitud.ToString("dd/MM/yyyy HH:mm")</td>

                                <td>@(item.Departamento ?? "-")</td>

                                <td>@(item.Solicitante ?? "-")</td>

                                <td>@(item.CompradorAsignado ?? "Sin asignar")</td>

                                <td>
                                    <div class="progress-wrap">
                                        <div class="progress-top">
                                            <span>@item.ResponsableActual</span>
                                            <strong>@item.PorcentajeAvance%</strong>
                                        </div>
                                        <div class="progress-track">
                                            <div class="progress-fill" style="width:@item.PorcentajeAvance%"></div>
                                        </div>
                                    </div>
                                </td>

                                <td>
                                    <span class="badge-compras @GetBadgeClass(item.EstatusID)">
                                        @(item.EstatusNombre ?? "Sin estatus")
                                    </span>
                                </td>

                                <td>@item.DiasEnEstatus</td>
                                <td>@item.DiasPermitidos</td>

                                <td>
                                    <span class="@item.SemaforoCss">
                                        @item.SemaforoTexto
                                    </span>
                                </td>

                                <td>@String.Format(culturaMx, "{0:C}", item.MontoCotizado ?? 0)</td>

                                <td>
                                    <div class="d-flex gap-2 justify-content-end flex-wrap">
                                        <button type="button"
                                                class="btn-table btn-detalle"
                                                data-bs-toggle="modal"
                                                data-bs-target="#modalDetalleSeguimiento"
                                                data-folio="@item.Folio"
                                                data-solicitante="@item.Solicitante"
                                                data-comprador="@(string.IsNullOrWhiteSpace(item.CompradorAsignado) ? "Sin asignar" : item.CompradorAsignado)"
                                                data-direccion="@item.DiasDireccion"
                                                data-compras="@item.DiasCompras"
                                                data-oc="@item.DiasOC"
                                                data-proveedor="@item.DiasProveedor"
                                                data-almacen="@item.DiasAlmacen">
                                            Tiempos
                                        </button>

                                        <a asp-controller="Compras"
                                           asp-action="DetalleSolicitud"
                                           asp-route-id="@item.SolicitudCompraID"
                                           asp-route-returnTo="SeguimientoDireccion"
                                           class="btn-table">
                                            Ver
                                        </a>
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
        else
        {
            <div class="empty-state">
                No se encontraron solicitudes para los filtros seleccionados.
            </div>
        }
    </section>
</div>

<div class="modal fade"
     id="modalDetalleSeguimiento"
     tabindex="-1"
     aria-hidden="true">

    <div class="modal-dialog modal-lg modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header" style="background:linear-gradient(135deg,#0b4f8f,#073763);color:white;">
                <h5 class="modal-title fw-bold">
                    Tiempos del proceso -
                    <span id="mdFolio"></span>
                </h5>

                <button type="button"
                        class="btn-close btn-close-white"
                        data-bs-dismiss="modal">
                </button>
            </div>

            <div class="modal-body">
                <div class="row g-3 mb-3">
                    <div class="col-12 col-md-6">
                        <strong>Solicitante:</strong><br />
                        <span id="mdSolicitante"></span>
                    </div>

                    <div class="col-12 col-md-6">
                        <strong>Comprador:</strong><br />
                        <span id="mdComprador"></span>
                    </div>
                </div>

                <table class="table table-bordered">
                    <thead class="table-light">
                        <tr>
                            <th>Etapa</th>
                            <th>Días acumulados</th>
                        </tr>
                    </thead>
                    <tbody>
                        <tr>
                            <td>Dirección</td>
                            <td id="mdDireccion"></td>
                        </tr>
                        <tr>
                            <td>Compras / Cotización</td>
                            <td id="mdCompras"></td>
                        </tr>
                        <tr>
                            <td>Orden de compra</td>
                            <td id="mdOC"></td>
                        </tr>
                        <tr>
                            <td>Proveedor</td>
                            <td id="mdProveedor"></td>
                        </tr>
                        <tr>
                            <td>Almacén</td>
                            <td id="mdAlmacen"></td>
                        </tr>
                    </tbody>
                </table>

                <div class="alert alert-info">
                    <strong>Total registrado:</strong>
                    <span id="mdTotal"></span> día(s)
                </div>
            </div>

            <div class="modal-footer">
                <button type="button"
                        class="btn-compras-secondary"
                        data-bs-dismiss="modal">
                    Cerrar
                </button>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        document.addEventListener('DOMContentLoaded', function () {
            document.querySelectorAll('.btn-detalle').forEach(function (btn) {
                btn.addEventListener('click', function () {
                    const direccion = parseInt(btn.dataset.direccion || '0');
                    const compras = parseInt(btn.dataset.compras || '0');
                    const oc = parseInt(btn.dataset.oc || '0');
                    const proveedor = parseInt(btn.dataset.proveedor || '0');
                    const almacen = parseInt(btn.dataset.almacen || '0');

                    document.getElementById('mdFolio').innerText = btn.dataset.folio || '';
                    document.getElementById('mdSolicitante').innerText = btn.dataset.solicitante || '';
                    document.getElementById('mdComprador').innerText = btn.dataset.comprador || 'Sin asignar';

                    document.getElementById('mdDireccion').innerText = direccion;
                    document.getElementById('mdCompras').innerText = compras;
                    document.getElementById('mdOC').innerText = oc;
                    document.getElementById('mdProveedor').innerText = proveedor;
                    document.getElementById('mdAlmacen').innerText = almacen;
                    document.getElementById('mdTotal').innerText =
                        direccion + compras + oc + proveedor + almacen;
                });
            });
        });
    </script>
}

@functions {
    private string GetBadgeClass(int estatusId)
    {
        return estatusId switch
        {
            1 => "badge-pendiente",
            2 => "badge-revision",
            3 => "badge-revision",
            4 => "badge-revision",
            5 => "badge-aprobada",
            6 => "badge-revision",
            7 => "badge-revision",
            8 => "badge-pendiente",
            9 => "badge-revision",
            10 => "badge-aprobada",
            11 => "badge-rechazada",
            12 => "badge-cancelada",
            _ => "badge-pendiente"
        };
    }
}
