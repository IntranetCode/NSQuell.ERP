@model ERP.NSQuell.Models.Compras.RegistrarCotizacionesViewModel

@{
    ViewData["Title"] = "Registrar cotizaciones";

    var returnTo = ViewBag.ReturnTo as string ?? Context.Request.Query["returnTo"].ToString();

    if (string.IsNullOrWhiteSpace(returnTo) && Context.Request.HasFormContentType)
    {
        returnTo = Context.Request.Form["returnTo"].ToString();
    }
}

@section Styles {
    <style>
        :root {
            --compras-text: #1f2937;
            --compras-muted: #6b7280;
            --compras-border: #e5e7eb;
            --ns-blue: #0b4f8f;
            --ns-blue-dark: #073763;
            --ns-blue-soft: #eaf3fb;
            --ns-orange: #ff7a00;
            --ns-orange-dark: #e85d04;
            --ns-orange-soft: #fff4e8;
            --success-soft: #ecfdf5;
            --success-text: #15803d;
            --danger-soft: #fef2f2;
            --danger-text: #b91c1c;
            --warning-soft: #fff7ed;
            --warning-text: #c2410c;
            --shadow-soft: 0 12px 28px rgba(15, 23, 42, 0.07);
        }

        .cotizaciones-page {
            color: var(--compras-text);
        }

        .page-hero {
            background: radial-gradient(circle at 90% 20%, rgba(255, 122, 0, 0.13), transparent 30%), linear-gradient(135deg, #ffffff 0%, #f8fbff 100%);
            border: 1px solid var(--compras-border);
            border-radius: 24px;
            padding: 28px;
            margin-bottom: 18px;
            box-shadow: var(--shadow-soft);
            position: relative;
            overflow: hidden;
        }

            .page-hero::after {
                content: "COT";
                position: absolute;
                right: 28px;
                top: 4px;
                font-size: 86px;
                font-weight: 1000;
                color: rgba(11, 79, 143, 0.05);
                letter-spacing: -0.08em;
            }

        .page-chip {
            display: inline-flex;
            border-radius: 999px;
            border: 1px solid #ffd2a3;
            background: var(--ns-orange-soft);
            color: var(--ns-orange-dark);
            padding: 7px 12px;
            font-size: 11px;
            font-weight: 900;
            letter-spacing: 0.12em;
            text-transform: uppercase;
            margin-bottom: 12px;
        }

        .page-title {
            font-size: clamp(28px, 4vw, 40px);
            font-weight: 1000;
            margin: 0 0 8px 0;
            color: var(--compras-text);
            letter-spacing: -0.04em;
        }

        .page-subtitle {
            color: var(--compras-muted);
            font-size: 14px;
            line-height: 1.7;
            font-weight: 600;
            max-width: 760px;
            margin: 0;
        }

        .info-card {
            background: white;
            border: 1px solid var(--compras-border);
            border-radius: 24px;
            padding: 22px;
            margin-bottom: 18px;
            box-shadow: var(--shadow-soft);
        }

        .section-title {
            font-size: 20px;
            font-weight: 1000;
            margin: 0;
            color: var(--compras-text);
            letter-spacing: -0.03em;
        }

        .section-subtitle {
            font-size: 13px;
            color: var(--compras-muted);
            font-weight: 600;
            margin: 5px 0 0 0;
        }

        .cotizacion-card {
            background: #f9fafb;
            border: 1px solid var(--compras-border);
            border-radius: 20px;
            padding: 18px;
            margin-bottom: 16px;
        }

        .cotizacion-header {
            display: flex;
            justify-content: space-between;
            align-items: flex-start;
            gap: 12px;
            flex-wrap: wrap;
            margin-bottom: 16px;
        }

        .cotizacion-badge {
            display: inline-flex;
            align-items: center;
            border-radius: 999px;
            background: var(--ns-blue-soft);
            color: var(--ns-blue);
            padding: 6px 10px;
            font-size: 11px;
            font-weight: 900;
            border: 1px solid #cfe2f3;
        }

        .cotizacion-title {
            font-size: 17px;
            font-weight: 1000;
            color: var(--ns-blue-dark);
            margin: 8px 0 0 0;
        }

        .form-label {
            font-size: 12px;
            font-weight: 900;
            color: var(--compras-muted);
            text-transform: uppercase;
            letter-spacing: 0.08em;
            margin-bottom: 6px;
        }

        .form-control,
        .form-select {
            border-radius: 14px;
            border-color: var(--compras-border);
            padding: 10px 13px;
            font-weight: 600;
        }

        .btn-compras-main,
        .btn-compras-secondary,
        .btn-compras-danger,
        .btn-compras-blue {
            border-radius: 14px;
            padding: 10px 15px;
            text-decoration: none;
            font-weight: 900;
            display: inline-flex;
            align-items: center;
            justify-content: center;
            gap: 8px;
            border: 1px solid transparent;
            transition: all 0.2s ease;
            white-space: nowrap;
        }

        .btn-compras-main {
            background: linear-gradient(135deg, var(--ns-orange), var(--ns-orange-dark));
            color: white;
            box-shadow: 0 12px 26px rgba(255, 122, 0, 0.22);
        }

            .btn-compras-main:hover {
                color: white;
                transform: translateY(-2px);
            }

        .btn-compras-blue {
            background: linear-gradient(135deg, var(--ns-blue), var(--ns-blue-dark));
            color: white;
            box-shadow: 0 12px 26px rgba(11, 79, 143, 0.18);
        }

            .btn-compras-blue:hover {
                color: white;
                transform: translateY(-2px);
            }

        .btn-compras-secondary {
            background: white;
            color: var(--ns-blue);
            border-color: #cfe2f3;
        }

            .btn-compras-secondary:hover {
                background: var(--ns-blue-soft);
                color: var(--ns-blue-dark);
                transform: translateY(-2px);
            }

        .btn-compras-danger {
            background: white;
            color: var(--danger-text);
            border-color: #fecaca;
        }

            .btn-compras-danger:hover {
                background: var(--danger-soft);
                color: var(--danger-text);
            }

        .table-card {
            background: white;
            border: 1px solid var(--compras-border);
            border-radius: 20px;
            padding: 18px;
            margin-bottom: 18px;
        }

        .compras-table {
            width: 100%;
            border-collapse: separate;
            border-spacing: 0 10px;
        }

            .compras-table th {
                color: var(--compras-muted);
                font-size: 11px;
                text-transform: uppercase;
                letter-spacing: 0.10em;
                padding: 0 12px 6px;
                border: none;
                white-space: nowrap;
            }

            .compras-table td {
                background: #f9fafb;
                border-top: 1px solid var(--compras-border);
                border-bottom: 1px solid var(--compras-border);
                color: #374151;
                padding: 14px 12px;
                font-size: 13px;
                font-weight: 650;
                vertical-align: middle;
            }

                .compras-table td:first-child {
                    border-left: 1px solid var(--compras-border);
                    border-radius: 16px 0 0 16px;
                }

                .compras-table td:last-child {
                    border-right: 1px solid var(--compras-border);
                    border-radius: 0 16px 16px 0;
                }

        .empty-state {
            background: #f9fafb;
            border: 1px dashed #d1d5db;
            border-radius: 20px;
            padding: 28px;
            color: var(--compras-muted);
            font-weight: 700;
            text-align: center;
        }

        @@media (max-width: 767.98px) {
            .page-hero,
            .info-card {
                padding: 18px;
                border-radius: 20px;
            }

            .btn-compras-main,
            .btn-compras-secondary,
            .btn-compras-danger,
            .btn-compras-blue {
                width: 100%;
            }
        }
    </style>
}

<div class="cotizaciones-page">

    <div class="erp-page-breadcrumb">
        <a asp-controller="Compras"
           asp-action="DetalleSolicitud"
           asp-route-id="@Model.SolicitudCompraID"
           asp-route-returnTo="@returnTo"
           class="erp-btn-back">
            ← Regresar
        </a>
        <span>Inicio</span>
        <span>›</span>
        <span>Compras</span>
        <span>›</span>
        <strong>Registrar cotizaciones</strong>
    </div>

    <section class="page-hero">
        <div class="row align-items-center g-4">
            <div class="col-12 col-lg-8">
                <div class="page-chip">Cotizaciones de proveedores</div>

                <h1 class="page-title">
                    Registrar cotizaciones
                </h1>

                <p class="page-subtitle">
                    Solicitud @(Model.Folio ?? $"#{Model.SolicitudCompraID}") · @Model.EstatusNombre.
                    Selecciona proveedores desde ERP_Proveedores y adjunta una cotización por cada proveedor.
                </p>
            </div>

            <div class="col-12 col-lg-4">
                <div class="d-flex justify-content-lg-end gap-2 flex-wrap">
                    <a asp-controller="Compras"
                       asp-action="DetalleSolicitud"
                       asp-route-id="@Model.SolicitudCompraID"
                       asp-route-returnTo="@returnTo"
                       class="btn-compras-secondary">
                        Ver detalle
                    </a>
                </div>
            </div>
        </div>
    </section>

    <section class="info-card">
        <div class="mb-4">
            <h2 class="section-title">Nueva captura</h2>
            <p class="section-subtitle">
                Puedes registrar una o varias cotizaciones en un mismo envío.
            </p>
        </div>

        @if (Model.Proveedores != null && Model.Proveedores.Any(x => !string.IsNullOrWhiteSpace(x.Value)))
        {
            <form asp-controller="Compras"
                  asp-action="RegistrarCotizaciones"
                  method="post"
                  enctype="multipart/form-data">
                @Html.AntiForgeryToken()
                <input type="hidden" name="returnTo" value="@returnTo" />

                <input type="hidden" name="SolicitudCompraID" value="@Model.SolicitudCompraID" />

                <div id="cotizacionesContainer">
                    <div class="cotizacion-card cotizacion-row" data-index="0">
                        <div class="cotizacion-header">
                            <div>
                                <span class="cotizacion-badge">Cotización #1</span>
                                <h3 class="cotizacion-title">Proveedor</h3>
                            </div>
                        </div>

                        <div class="row g-3">
                            <div class="col-12 col-md-6">
                                <label class="form-label">Proveedor</label>
                                <select name="Cotizaciones[0].ProveedorID" class="form-select" required>
                                    @foreach (var proveedor in Model.Proveedores)
                                    {
                                        <option value="@proveedor.Value">@proveedor.Text</option>
                                    }
                                </select>
                            </div>

                            <div class="col-12 col-md-3">
                                <label class="form-label">Subtotal</label>
                                <input type="number" name="Cotizaciones[0].Subtotal" class="form-control" step="0.01" min="0" />
                            </div>

                            <div class="col-12 col-md-3">
                                <label class="form-label">IVA</label>
                                <input type="number" name="Cotizaciones[0].IVA" class="form-control" step="0.01" min="0" />
                            </div>

                            <div class="col-12 col-md-3">
                                <label class="form-label">Total</label>
                                <input type="number" name="Cotizaciones[0].Total" class="form-control" step="0.01" min="0.01" required />
                            </div>

                            <div class="col-12 col-md-3">
                                <label class="form-label">Tiempo entrega</label>
                                <input type="text" name="Cotizaciones[0].TiempoEntrega" class="form-control" placeholder="Ej. 5 días hábiles" />
                            </div>

                            <div class="col-12 col-md-6">
                                <label class="form-label">Condiciones de pago</label>
                                <input type="text" name="Cotizaciones[0].CondicionesPago" class="form-control" placeholder="Ej. Contado / Crédito 15 días" />
                            </div>

                            <div class="col-12 col-md-6">
                                <label class="form-label">Archivo cotización</label>
                                <input type="file" name="Cotizaciones[0].ArchivoCotizacion" class="form-control" accept=".pdf,.jpg,.jpeg,.png,.webp" required />
                            </div>

                            <div class="col-12 col-md-6">
                                <label class="form-label">Recomendada por Compras</label>
                                <select name="Cotizaciones[0].EsRecomendada" class="form-select">
                                    <option value="false">No</option>
                                    <option value="true">Sí</option>
                                </select>
                            </div>

                            <div class="col-12">
                                <label class="form-label">Observaciones</label>
                                <textarea name="Cotizaciones[0].Observaciones" class="form-control" rows="3" placeholder="Comentarios de la cotización..."></textarea>
                            </div>
                        </div>
                    </div>
                </div>

                <div class="d-flex gap-2 flex-wrap mt-3">
                    <button type="button" id="agregarCotizacion" class="btn-compras-secondary">
                        + Agregar otra cotización
                    </button>

                    <button type="submit" class="btn-compras-main">
                        Registrar cotizaciones
                    </button>
                </div>
            </form>

            <template id="cotizacionTemplate">
                <div class="cotizacion-card cotizacion-row" data-index="__index__">
                    <div class="cotizacion-header">
                        <div>
                            <span class="cotizacion-badge">Cotización #__numero__</span>
                            <h3 class="cotizacion-title">Proveedor</h3>
                        </div>

                        <button type="button" class="btn-compras-danger btn-quitar-cotizacion">
                            Quitar
                        </button>
                    </div>

                    <div class="row g-3">
                        <div class="col-12 col-md-6">
                            <label class="form-label">Proveedor</label>
                            <select name="Cotizaciones[__index__].ProveedorID" class="form-select" required>
                                @foreach (var proveedor in Model.Proveedores)
                                {
                                    <option value="@proveedor.Value">@proveedor.Text</option>
                                }
                            </select>
                        </div>

                        <div class="col-12 col-md-3">
                            <label class="form-label">Subtotal</label>
                            <input type="number" name="Cotizaciones[__index__].Subtotal" class="form-control" step="0.01" min="0" />
                        </div>

                        <div class="col-12 col-md-3">
                            <label class="form-label">IVA</label>
                            <input type="number" name="Cotizaciones[__index__].IVA" class="form-control" step="0.01" min="0" />
                        </div>

                        <div class="col-12 col-md-3">
                            <label class="form-label">Total</label>
                            <input type="number" name="Cotizaciones[__index__].Total" class="form-control" step="0.01" min="0.01" required />
                        </div>

                        <div class="col-12 col-md-3">
                            <label class="form-label">Tiempo entrega</label>
                            <input type="text" name="Cotizaciones[__index__].TiempoEntrega" class="form-control" placeholder="Ej. 5 días hábiles" />
                        </div>

                        <div class="col-12 col-md-6">
                            <label class="form-label">Condiciones de pago</label>
                            <input type="text" name="Cotizaciones[__index__].CondicionesPago" class="form-control" placeholder="Ej. Contado / Crédito 15 días" />
                        </div>

                        <div class="col-12 col-md-6">
                            <label class="form-label">Archivo cotización</label>
                            <input type="file" name="Cotizaciones[__index__].ArchivoCotizacion" class="form-control" accept=".pdf,.jpg,.jpeg,.png,.webp" required />
                        </div>

                        <div class="col-12 col-md-6">
                            <label class="form-label">Recomendada por Compras</label>
                            <select name="Cotizaciones[__index__].EsRecomendada" class="form-select">
                                <option value="false">No</option>
                                <option value="true">Sí</option>
                            </select>
                        </div>

                        <div class="col-12">
                            <label class="form-label">Observaciones</label>
                            <textarea name="Cotizaciones[__index__].Observaciones" class="form-control" rows="3" placeholder="Comentarios de la cotización..."></textarea>
                        </div>
                    </div>
                </div>
            </template>
        }
        else
        {
            <div class="empty-state">
                No hay proveedores activos en ERP_Proveedores. Primero registra proveedores en el catálogo.
            </div>
        }
    </section>

    <section class="table-card">
        <div class="mb-3">
            <h2 class="section-title">Cotizaciones existentes</h2>
            <p class="section-subtitle">
                Cotizaciones ya registradas para esta solicitud.
            </p>
        </div>

        @if (Model.CotizacionesExistentes != null && Model.CotizacionesExistentes.Any())
        {
            <div class="table-responsive">
                <table class="compras-table">
                    <thead>
                        <tr>
                            <th>Proveedor</th>
                            <th>Fecha</th>
                            <th>Total</th>
                            <th>Entrega</th>
                            <th>Estatus</th>
                            <th>Recomendada</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in Model.CotizacionesExistentes)
                        {
                            <tr>
                                <td>@(item.ProveedorNombre ?? "-")</td>
                                <td>@item.FechaCotizacion.ToString("dd/MM/yyyy HH:mm")</td>
                                <td>@FormatCurrency(item.Total)</td>
                                <td>@(item.TiempoEntrega ?? "-")</td>
                                <td>@(item.Estatus ?? "-")</td>
                                <td>@(item.EsRecomendada ? "Sí" : "No")</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
        else
        {
            <div class="empty-state">
                Aún no hay cotizaciones registradas para esta solicitud.
            </div>
        }
    </section>
</div>

@section Scripts {
    <script>
        document.addEventListener('DOMContentLoaded', function () {
            const btnAgregar = document.getElementById('agregarCotizacion');
            const container = document.getElementById('cotizacionesContainer');
            const template = document.getElementById('cotizacionTemplate');

            if (!btnAgregar || !container || !template) {
                return;
            }

            let index = 1;

            btnAgregar.addEventListener('click', function () {
                const numero = index + 1;

                const html = template.innerHTML
                    .replaceAll('__index__', index)
                    .replaceAll('__numero__', numero);

                const wrapper = document.createElement('div');
                wrapper.innerHTML = html.trim();

                container.appendChild(wrapper.firstElementChild);

                index++;
            });

            container.addEventListener('click', function (event) {
                const button = event.target.closest('.btn-quitar-cotizacion');

                if (!button) {
                    return;
                }

                const row = button.closest('.cotizacion-row');

                if (row) {
                    row.remove();
                }
            });
        });
    </script>
}

@functions {
    private string FormatCurrency(decimal? value)
    {
        return value.HasValue ? value.Value.ToString("C2") : "-";
    }
}