@model ERP.NSQuell.Models.CtqFiscalVm
@using System.Globalization
@{
    ViewData["Title"]="Fiscal CONTPAQ";var mx=CultureInfo.GetCultureInfo("es-MX");string M(decimal v)=>v.ToString("C2",mx);
    string PageUrl(int p)=>Url.Action("ContpaqiFiscal","Compras",new { desde=Model.Filtro.Desde.ToString("yyyy-MM-dd"),hasta=Model.Filtro.Hasta.ToString("yyyy-MM-dd"),rangoPersonalizado=true,buscar=Model.Filtro.Buscar,proveedor=Model.Filtro.Proveedor,rfc=Model.Filtro.RFC,estatus=Model.Filtro.Estatus,moneda=Model.Filtro.Moneda,centroCosto=Model.Filtro.CentroCosto,almacen=Model.Filtro.Almacen,estadoDocumento=Model.EstadoDocumento,pagina=p,tamanoPagina=Model.Filtro.TamanoPagina })??"#";
}
<div id="ctq-workspace-root" class="ctq15-page">
<partial name="_ContpaqiSubnav" />
<partial name="_ContpaqiFilterPanel" model="Model.Filtro" />
@if(!string.IsNullOrWhiteSpace(Model.ErrorMessage)){<div class="ctq15-alert">@Model.ErrorMessage</div>}
<section class="ctq15-kpis"><div class="ctq15-kpi"><div class="ctq15-kpi-label">Documentos</div><div class="ctq15-kpi-value">@Model.TotalDocumentos</div></div><div class="ctq15-kpi"><div class="ctq15-kpi-label">Completos</div><div class="ctq15-kpi-value">@Model.Completos</div></div><div class="ctq15-kpi"><div class="ctq15-kpi-label">Sin XML</div><div class="ctq15-kpi-value">@Model.SinXml</div></div><div class="ctq15-kpi"><div class="ctq15-kpi-label">Sin PDF</div><div class="ctq15-kpi-value">@Model.SinPdf</div></div></section>
<section class="ctq15-card"><form method="get" action="@Url.Action("ContpaqiFiscal","Compras")" data-ctq-ajax-form class="d-flex gap-2 align-items-end flex-wrap">
@foreach(var pair in new[]{("desde",Model.Filtro.Desde.ToString("yyyy-MM-dd")),("hasta",Model.Filtro.Hasta.ToString("yyyy-MM-dd")),("buscar",Model.Filtro.Buscar??""),("proveedor",Model.Filtro.Proveedor??""),("rfc",Model.Filtro.RFC??""),("estatus",Model.Filtro.Estatus??""),("moneda",Model.Filtro.Moneda??""),("centroCosto",Model.Filtro.CentroCosto??""),("almacen",Model.Filtro.Almacen??""),("tamanoPagina",Model.Filtro.TamanoPagina.ToString())}){<input type="hidden" name="@pair.Item1" value="@pair.Item2"/>}
<div class="ctq15-field"><label>Estado documental</label><select name="estadoDocumento">@foreach(var e in new[]{"Todos","Completos","Sin XML","Sin PDF","Sin ambos"}){<option value="@e" selected="@(Model.EstadoDocumento==e?"selected":null)">@e</option>}</select></div><button class="ctq15-btn ctq15-btn-primary">Aplicar</button><span class="ctq15-result-note">@Model.TotalFiltrados resultado(s) · Sin ambos: @Model.SinAmbos</span></form></section>
<section class="ctq15-card"><div class="table-responsive"><table class="ctq15-table"><thead><tr><th>Fecha</th><th>Folio</th><th>Proveedor</th><th>UUID</th><th>XML</th><th>PDF</th><th>Estatus</th><th>Total MXN</th><th></th></tr></thead><tbody>@foreach(var x in Model.Filas){<tr><td>@x.FechaCompra.ToString("dd/MM/yyyy")</td><td><strong>@(x.Folio??x.CompraID.ToString())</strong></td><td>@x.Proveedor<br/><small>@x.RFC</small></td><td style="max-width:260px;word-break:break-all">@x.UUID</td><td><span class="badge @(x.TieneXml?"bg-success":"bg-danger")">@(x.TieneXml?"Sí":"No")</span></td><td><span class="badge @(x.TienePdf?"bg-success":"bg-danger")">@(x.TienePdf?"Sí":"No")</span></td><td>@x.Estatus</td><td class="ctq15-money">@M(x.TotalMxn)</td><td><a asp-action="ContpaqiDetalle" asp-route-empresaOrigenId="@x.EmpresaOrigenID" asp-route-compraId="@x.CompraID" class="ctq15-btn">Ver detalle</a></td></tr>}</tbody></table></div><div class="ctq15-pager">@if(Model.Filtro.Pagina>1){<a href="@PageUrl(Model.Filtro.Pagina-1)" class="ctq15-btn" data-ctq-ajax>← Anterior</a>}@if(Model.Filtro.Pagina<Model.TotalPaginas){<a href="@PageUrl(Model.Filtro.Pagina+1)" class="ctq15-btn" data-ctq-ajax>Siguiente →</a>}</div></section>
</div>
