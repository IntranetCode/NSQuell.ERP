                                <span><i class="bi bi-speedometer2 me-1"></i>Avance</span>
                                <span>@Model.Metricas.PorcentajeAvance.ToString("0.##")%</span>
                            </div>
                            <div class="nsq-op-progress-line">
                                <span style="width:@Pct(Model.Metricas.PorcentajeAvance)%"></span>
                            </div>
                            <div class="nsq-op-progress-label">
                                <span>@Model.Metricas.CantidadProducida.ToString("N0") producidas</span>
                                <span>@Model.Metricas.CantidadProgramada.ToString("N0") programadas</span>
