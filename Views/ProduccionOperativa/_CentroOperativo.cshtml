                                <span class="nsq-op-parallel-task-icon"><i class="bi bi-tools"></i></span>
                                <div>
                                    <strong>Cambio físico de molde</strong>
                                    <small>@(pasoCambioMolde.Detalle ?? pasoCambioMolde.MotivoBloqueo ?? "Desmontaje y montaje del molde correspondiente.")</small>
                                    @if (!string.IsNullOrWhiteSpace(urlCambioMolde))
                                    {
                                        <a href="@urlCambioMolde" class="nsq-op-parallel-link" data-nsq-operativa-accion data-accion-clave="@accionCambioMolde!.Clave" data-solo-lectura="@((!accionCambioMolde.DisponibleParaUsuario || Model.Permisos.SoloLectura) ? "true" : "false")">
                                            <i class="bi bi-arrow-right-circle"></i>@(accionCambioMolde.DisponibleParaUsuario? accionCambioMolde.TextoBoton: "Ver actividad")
                                        </a>
                                    }
                                </div>
                                <span class="nsq-op-parallel-state">@pasoCambioMolde.EstadoTexto</span>
                            </div>
                        }
                        @if (pasoChecklistMolde != null)
                        {
                            var urlChecklistMolde = accionChecklistMolde == null ? null : Url.Action("Contenido", "ProduccionOperativa", new
                            {
                                programaProduccionId = Model.ProgramaProduccionID,
                                accionClave = accionChecklistMolde.Clave,
                                origen = Model.Origen,
                                soloLectura = !accionChecklistMolde.DisponibleParaUsuario || Model.Permisos.SoloLectura
                            });
                            <div class="nsq-op-parallel-task">
                                <span class="nsq-op-parallel-task-icon"><i class="bi bi-ui-checks-grid"></i></span>
                                <div>
                                    <strong>Checklist GQ-F-PR01-03</strong>
                                    <small>@(pasoChecklistMolde.Detalle ?? "Checklist de desmontaje y montaje de molde.")</small>
                                    @if (!string.IsNullOrWhiteSpace(urlChecklistMolde))
                                    {
                                        <a href="@urlChecklistMolde" class="nsq-op-parallel-link" data-nsq-operativa-accion data-accion-clave="@accionChecklistMolde!.Clave" data-solo-lectura="@((!accionChecklistMolde.DisponibleParaUsuario || Model.Permisos.SoloLectura) ? "true" : "false")">
                                            <i class="bi bi-arrow-right-circle"></i>@(accionChecklistMolde.DisponibleParaUsuario? accionChecklistMolde.TextoBoton: "Ver checklist")
                                        </a>
                                    }
                                </div>
                                <span class="nsq-op-parallel-state">@pasoChecklistMolde.EstadoTexto</span>
                            </div>
                        }
                    </div>
                </section>
            }

            <div class="nsq-op-grid">
                <div>
                    <section class="nsq-op-card">
                        <div class="nsq-op-card-body">
                            <div class="nsq-op-section-title">
                                <span><i class="bi bi-lightning-charge-fill me-1"></i>Acción actual</span>
                                @if (accionActual != null)
                                {
                                    <span>@accionActual.AreaResponsableTexto</span>
                                }
                            </div>

                            @if (accionActual == null)
                            {
                                <div class="nsq-op-action @(Model.EstaFinalizada ? "" : "is-waiting")">
                                    <div class="nsq-op-action-main">
                                        <div class="nsq-op-action-icon">
                                            <i class="bi @(Model.EstaFinalizada ? "bi-check-circle-fill" : "bi-hourglass-split")"></i>
                                        </div>
                                        <div>
                                            <div class="nsq-op-action-kicker">Estado operativo</div>
                                            <div class="nsq-op-action-title">@(Model.EstaFinalizada ? "Proceso finalizado" : "Sin acción operativa disponible")</div>
                                            <div class="nsq-op-action-desc">
                                                @(Model.EstaFinalizada
                                                                                            ? "La OF no tiene actividades pendientes en el Centro Operativo."
                                                                                            : "La Agenda Operativa no determinó una actividad ejecutable para este momento.")
                                        </div>
                                    </div>
                                </div>
                            </div>
                                                        }
                            else
                            {
                                var esAccionExterna = EsAccionExterna(accionActual);
                                var claseAccion = accionActual.Bloqueada ? "is-blocked" : !accionActual.DisponibleParaUsuario ? "is-waiting" : "";
                                var urlAccion = Url.Action("Contenido", "ProduccionOperativa", new
                                {
                                    programaProduccionId = Model.ProgramaProduccionID,
                                    accionClave = accionActual.Clave,
                                    origen = Model.Origen,
                                    soloLectura = !accionActual.DisponibleParaUsuario || Model.Permisos.SoloLectura
                                }) ?? $"/Produccion/Operativa/Contenido/{Model.ProgramaProduccionID}/{Uri.EscapeDataString(accionActual.Clave)}";

                                <div class="nsq-op-action @claseAccion">
                                    <div class="nsq-op-action-main">
                                        <div class="nsq-op-action-icon">
                                            <i class="bi @accionActual.Icono"></i>
                                        </div>
                                        <div>
                                            <div class="nsq-op-action-kicker">
                                                @(accionActual.DisponibleParaUsuario ? "Te corresponde ahora" : "Actividad actual de la OF")
                                            </div>
                                            <div class="nsq-op-action-title">@accionActual.Titulo</div>
                                            @if (!string.IsNullOrWhiteSpace(accionActual.Descripcion))
                                            {
                                                <div class="nsq-op-action-desc">@accionActual.Descripcion</div>
                                            }
                                            <div class="nsq-op-meta">
                                                <span><i class="bi bi-people-fill"></i>@accionActual.AreaResponsableTexto</span>
                                                @if (!string.IsNullOrWhiteSpace(accionActual.ResponsableNombre))
                                                {
                                                    <span><i class="bi bi-person-fill"></i>@accionActual.ResponsableNombre</span>
                                                }
                                                @if (accionActual.FechaObjetivo.HasValue)
                                                {
                                                    <span><i class="bi bi-clock"></i>@TextoFecha(accionActual.FechaObjetivo)</span>
                                                }
                                                @if (accionActual.EstaVencida)
                                                {
                                                    <span class="text-danger"><i class="bi bi-exclamation-circle-fill"></i>@accionActual.MinutosDesfase min de desfase</span>
                                                }
                                            </div>
                                        </div>

                                        @if (esAccionExterna)
                                        {
                                            <span class="nsq-op-action-btn is-external" title="Esta actividad se atiende únicamente desde su módulo responsable.">
                                                <i class="bi bi-hourglass-split"></i>@TextoEsperaArea(accionActual)
                                            </span>
                                        }
                                        else if (accionActual.Bloqueada && !accionActual.DisponibleParaUsuario)
                                        {
                                            <a href="@urlAccion"
                                               class="nsq-op-action-btn is-view"
                                               data-nsq-operativa-accion
                                               data-accion-clave="@accionActual.Clave"
                                               data-solo-lectura="true">
                                                <i class="bi bi-eye"></i>Ver estado
                                            </a>
                                        }
                                        else
                                        {
                                            <a href="@urlAccion"
                                               class="nsq-op-action-btn @(accionActual.DisponibleParaUsuario ? "" : "is-view")"
                                               data-nsq-operativa-accion
                                               data-accion-clave="@accionActual.Clave"
                                               data-solo-lectura="@((!accionActual.DisponibleParaUsuario || Model.Permisos.SoloLectura) ? "true" : "false")">
                                                <i class="bi @(accionActual.DisponibleParaUsuario ? "bi-arrow-right-circle-fill" : "bi-eye")"></i>
                                                @(accionActual.DisponibleParaUsuario? accionActual.TextoBoton: "Ver actividad")
                                            </a>
                                        }
                                    </div>
                                </div>
                            }

                            @if (siguiente != null)
                            {
                                <div class="nsq-op-next">
                                    <div class="nsq-op-next-icon"><i class="bi bi-skip-forward-fill"></i></div>
                                    <div>
                                        <strong>Después sigue: @siguiente.Titulo</strong>
                                        <small>@siguiente.AreaResponsableTexto@(string.IsNullOrWhiteSpace(siguiente.ResponsableNombre) ? "" : $" · {siguiente.ResponsableNombre}")</small>
                                    </div>
                                </div>
                            }
                        </div>
                    </section>

                    @if (mostrarAccionesDuranteSerie)
                    {
                        <section class="nsq-op-series-tools">
                            <div class="nsq-op-series-tools-head">
                                <strong><i class="bi bi-activity me-1"></i>Durante la serie</strong>
                                <span>Acciones concurrentes; no cambian el orden del arranque</span>
                            </div>
                            <div class="nsq-op-series-tools-list">
                                @foreach (var accionSerie in accionesDuranteSerie)
                                {
                                    var urlSerie = Url.Action("Contenido", "ProduccionOperativa", new
                                    {
                                        programaProduccionId = Model.ProgramaProduccionID,
                                        accionClave = accionSerie.Clave,
                                        origen = Model.Origen,
                                        soloLectura = !accionSerie.DisponibleParaUsuario || Model.Permisos.SoloLectura
                                    }) ?? $"/Produccion/Operativa/Contenido/{Model.ProgramaProduccionID}/{Uri.EscapeDataString(accionSerie.Clave)}";
                                    <a class="nsq-op-tool"
                                       href="@urlSerie"
                                       data-nsq-operativa-accion
                                       data-accion-clave="@accionSerie.Clave"
                                       data-solo-lectura="@((!accionSerie.DisponibleParaUsuario || Model.Permisos.SoloLectura) ? "true" : "false")">
                                        <i class="bi @accionSerie.Icono"></i>
                                        @(accionSerie.DisponibleParaUsuario? accionSerie.Titulo: $"Ver {accionSerie.Titulo}")
                                    </a>
                                }
                            </div>
                        </section>
                    }

                    @if (Model.EsParejaLhRh)
                    {
                        <section class="nsq-op-lhrh">
                            <div class="nsq-op-lhrh-title">
                                <i class="bi bi-link-45deg"></i>
                                Operación conjunta LH/RH
                                @if (Model.LhRh.GrupoLhRh.HasValue)
                                {
                                    <span>· Grupo @Model.LhRh.GrupoLhRh.Value</span>
                                }
                            </div>
                            <div class="nsq-op-lhrh-grid">
                                <div class="nsq-op-lhrh-item">
                                    <strong>OF actual · @(string.IsNullOrWhiteSpace(Model.LhRh.LadoActual) ? "Lado" : Model.LhRh.LadoActual)</strong>
                                    @Model.OFTexto · @Model.ParteTexto
                                </div>
                                <div class="nsq-op-lhrh-item">
                                    <strong>OF pareja · @(string.IsNullOrWhiteSpace(Model.LhRh.LadoPareja) ? "Lado" : Model.LhRh.LadoPareja)</strong>
                                    @Model.LhRh.OFParejaTexto · @Model.LhRh.ParteParejaTexto
                                </div>
                            </div>
                            @if (!Model.LhRh.ParejaConsistente && !string.IsNullOrWhiteSpace(Model.LhRh.MotivoInconsistencia))
                            {
                                <div class="mt-2 small text-danger fw-bold">
                                    <i class="bi bi-exclamation-triangle-fill me-1"></i>@Model.LhRh.MotivoInconsistencia
                                </div>
                            }
                        </section>
                    }

                    <details class="nsq-op-details">
                        <summary>
                            <span><i class="bi bi-diagram-3 me-1"></i>Ver flujo completo de la OF</span>
                            <span class="text-muted">@pasos.Count paso(s)</span>
                        </summary>
                        <div class="nsq-op-details-body">
                            @foreach (var fase in fasesVisuales)
                            {
                                var pasosFase = pasos.Where(x => ContieneClave(fase.Claves, x.Clave)).OrderBy(x => x.Orden).ToList();
                                if (!pasosFase.Any()) continue;
                                var faseParalela = string.Equals(fase.Clave, "MOLDE", StringComparison.OrdinalIgnoreCase);
                                <div class="nsq-op-flow-phase @(faseParalela ? "is-parallel" : "")">
                                    <div class="nsq-op-flow-phase-head">
                                        <i class="bi @fase.Icono"></i>
                                        <span>@fase.Nombre</span>
                                        @if (faseParalela && pasosFase.Count > 1)
                                        {
                                            <span class="badge text-bg-primary">simultáneo</span>
                                        }
                                    </div>
                                    <div class="nsq-op-flow">
                                        @foreach (var paso in pasosFase)
                                        {
                                            var accionPaso = Model.AccionesDisponibles.FirstOrDefault(x => string.Equals(x.Clave, paso.AccionClave ?? paso.Clave, StringComparison.OrdinalIgnoreCase))
                                            ?? accionesVisibles.FirstOrDefault(x => string.Equals(x.Clave, paso.Clave, StringComparison.OrdinalIgnoreCase));
                                            var esExternaPaso = EsAccionExterna(accionPaso);
                                            var puedeModificarPaso = PuedeModificarDesdeFlujo(paso, accionPaso, Model.Permisos.SoloLectura);
                                            var soloLecturaPaso = !puedeModificarPaso;
                                            var textoAccionPaso = TextoAccionFlujo(paso, accionPaso, puedeModificarPaso);
                                            var iconoAccionPaso = IconoAccionFlujo(paso, accionPaso, puedeModificarPaso);
                                            var claseBotonPaso = esExternaPaso
                                            ? "is-external"
                                            : puedeModificarPaso
                                            ? (paso.Completado ? "is-edit" : "is-attend")
                                            : "";
                                            var urlPaso = accionPaso == null
                                            ? null
                                            : Url.Action("Contenido", "ProduccionOperativa", new
                                            {
                                                programaProduccionId = Model.ProgramaProduccionID,
                                                accionClave = accionPaso.Clave,
                                                origen = Model.Origen,
                                                soloLectura = soloLecturaPaso
                                            }) ?? $"/Produccion/Operativa/Contenido/{Model.ProgramaProduccionID}/{Uri.EscapeDataString(accionPaso.Clave)}";

                                            <div class="nsq-op-flow-item @ClasePaso(paso)">
                                                <div class="nsq-op-flow-icon"><i class="bi @IconoPaso(paso)"></i></div>
                                                <div>
                                                    <div class="nsq-op-flow-title">@paso.Nombre</div>
                                                    @if (!string.IsNullOrWhiteSpace(paso.Detalle))
                                                    {
                                                        <div class="nsq-op-flow-detail">@paso.Detalle</div>
                                                    }
                                                    else if (!string.IsNullOrWhiteSpace(paso.MotivoBloqueo))
                                                    {
                                                        <div class="nsq-op-flow-detail">@paso.MotivoBloqueo</div>
                                                    }
                                                </div>
                                                <div class="nsq-op-flow-state">@paso.EstadoTexto</div>

                                                @if (accionPaso != null && !string.IsNullOrWhiteSpace(urlPaso))
                                                {
                                                    <a href="@urlPaso"
                                                       class="nsq-op-flow-action @claseBotonPaso"
                                                       data-nsq-operativa-accion
                                                       data-accion-clave="@accionPaso.Clave"
                                                       data-solo-lectura="@(soloLecturaPaso ? "true" : "false")"
                                                       title="@(esExternaPaso
                                                                                                                                                                         ? "Consulta el estado desde Producción. La acción se ejecuta únicamente en el módulo responsable."
                                                                                                                                                                         : puedeModificarPaso
                                                                                                                                                                             ? "Abrir esta actividad para continuar o modificar lo permitido por su controlador."
                                                                                                                                                                             : "Abrir esta actividad en modo consulta.")">
                                            <i class="bi @iconoAccionPaso"></i>@textoAccionPaso
                                        </a>
                                                                                }
                                                else
                                                {
                                                    <span class="nsq-op-flow-noaction">Sin acción</span>
                                                }
                                            </div>
                                        }
                                    </div>
                                </div>
                            }
                        </div>
                    </details>

                    @if (accionesSecundarias.Any())
                    {
                        <details class="nsq-op-details">
                            <summary>
                                <span><i class="bi bi-grid me-1"></i>Herramientas y consultas</span>
                                <span class="text-muted">@accionesSecundarias.Count</span>
                            </summary>
                            <div class="nsq-op-details-body">
                                <div class="nsq-op-tools">
                                    @foreach (var accion in accionesSecundarias)
                                    {
                                        if (string.Equals(accion.Clave, ProduccionOperativaAccionClave.DetalleCompleto, StringComparison.OrdinalIgnoreCase))
                                        {
                                            if (!string.IsNullOrWhiteSpace(urlDetalle))
                                            {
                                                <a class="nsq-op-tool" href="@urlDetalle" target="_blank" rel="noopener">
                                                    <i class="bi @accion.Icono"></i>@accion.Titulo
                                                </a>
                                            }
                                        }
                                        else if (EsAccionExterna(accion))
                                        {
                                            <span class="nsq-op-tool is-disabled" title="Esta actividad se atiende desde su módulo responsable.">
                                                <i class="bi bi-hourglass-split"></i>@accion.Titulo · @TextoEsperaArea(accion)
                                            </span>
                                        }
                                        else
                                        {
                                            var urlSecundaria = Url.Action("Contenido", "ProduccionOperativa", new
                                            {
                                                programaProduccionId = Model.ProgramaProduccionID,
                                                accionClave = accion.Clave,
                                                origen = Model.Origen,
                                                soloLectura = !accion.DisponibleParaUsuario || Model.Permisos.SoloLectura
                                            }) ?? $"/Produccion/Operativa/Contenido/{Model.ProgramaProduccionID}/{Uri.EscapeDataString(accion.Clave)}";

                                            <a class="nsq-op-tool"
                                               href="@urlSecundaria"
                                               data-nsq-operativa-accion
                                               data-accion-clave="@accion.Clave"
                                               data-solo-lectura="@((!accion.DisponibleParaUsuario || Model.Permisos.SoloLectura) ? "true" : "false")">
                                                <i class="bi @accion.Icono"></i>@accion.Titulo
                                            </a>
                                        }
                                    }
                                </div>
                            </div>
                        </details>
                    }
                </div>

                <aside>
                    <section class="nsq-op-card">
                        <div class="nsq-op-card-body">
