                                        <div class="nsq-op-kpi-value">@Model.Metricas.ObjetivoHoraActual.Value.ToString("N0")</div>
                                        <div class="nsq-op-kpi-note">pzas/h</div>
                                    </div>
                                }
                                @if (Model.Metricas.ContadorActual.HasValue)
                                {
                                    <div class="nsq-op-kpi">
                                        <div class="nsq-op-kpi-label">Contador</div>
                                        <div class="nsq-op-kpi-value">@Model.Metricas.ContadorActual.Value.ToString("N0")</div>
                                        <div class="nsq-op-kpi-note">actual</div>
                                    </div>
                                }
                                @if (Model.Metricas.CajasFormadas > 0 || Model.Metricas.CajasPendientesCalidad > 0 || Model.Metricas.CajasEnZonaVerde > 0)
                                {
                                    <div class="nsq-op-kpi">
                                        <div class="nsq-op-kpi-label">Cajas</div>
                                        <div class="nsq-op-kpi-value">@Model.Metricas.CajasFormadas</div>
                                        <div class="nsq-op-kpi-note">@Model.Metricas.CajasPendientesCalidad pendiente(s) Calidad</div>
                                    </div>
                                }
                                @if (Model.Metricas.MinutosParoActual > 0)
                                {
                                    <div class="nsq-op-kpi">
                                        <div class="nsq-op-kpi-label">Paro actual</div>
                                        <div class="nsq-op-kpi-value">@Model.Metricas.MinutosParoActual min</div>
                                        <div class="nsq-op-kpi-note">acumulados</div>
                                    </div>
                                }
                            </div>
                        </div>
                    </section>

                    <section class="nsq-op-card mt-3">
                        <div class="nsq-op-card-body">
                            <div class="nsq-op-section-title"><span><i class="bi bi-calendar3 me-1"></i>Programa</span></div>
                            <div class="small text-muted">
                                <div class="d-flex justify-content-between gap-3 py-1">
                                    <span>Inicio programado</span>
                                    <strong class="text-body">@TextoFecha(Model.FechaInicioProgramada)</strong>
                                </div>
                                <div class="d-flex justify-content-between gap-3 py-1">
                                    <span>Fin programado</span>
                                    <strong class="text-body">@TextoFecha(Model.FechaFinProgramada)</strong>
                                </div>
                                @if (Model.FechaInicioReal.HasValue)
                                {
                                    <div class="d-flex justify-content-between gap-3 py-1">
                                        <span>Inicio real</span>
                                        <strong class="text-body">@TextoFecha(Model.FechaInicioReal)</strong>
                                    </div>
                                }
                                @if (Model.FechaFinReal.HasValue)
                                {
                                    <div class="d-flex justify-content-between gap-3 py-1">
                                        <span>Fin real</span>
                                        <strong class="text-body">@TextoFecha(Model.FechaFinReal)</strong>
                                    </div>
                                }
                            </div>
                        </div>
                    </section>
                </aside>
            </div>
        </div>

        <section class="nsq-op-action-view"
                 data-nsq-operativa-vista-accion>
            <div class="nsq-op-action-view-head">
                <button type="button"
                        class="nsq-op-back"
                        data-nsq-operativa-volver>
                    <i class="bi bi-arrow-left"></i>
                    Volver al Centro Operativo
                </button>
                <div class="small text-muted fw-bold" data-nsq-operativa-accion-titulo></div>
            </div>
            <div data-nsq-operativa-contenido-body>
                <div class="nsq-op-readonly-banner" data-nsq-operativa-readonly-banner>
                    <i class="bi bi-eye-fill mt-1"></i>
                    <span>Modo consulta: puedes revisar la información de esta actividad, pero sus capturas y cierres no se pueden modificar desde aquí.</span>
                </div>
                <div class="nsq-op-loading">
                    <div class="nsq-op-spinner"></div>
                    <span>Cargando actividad...</span>
                </div>
            </div>
        </section>
    </div>

    <div class="nsq-op-footer">
        <div class="nsq-op-footer-user">
            <i class="bi bi-person-circle"></i>
            <span>
                Sesión: <strong>@Model.Usuario.NombreVisible</strong>
                @if (!string.IsNullOrWhiteSpace(Model.Usuario.Puesto))
                {
                    <span> · @Model.Usuario.Puesto</span>
                }
            </span>
        </div>
        <div>
            Actualizado @Model.FechaConsulta.ToString("dd/MM/yyyy HH:mm:ss")
        </div>
    </div>
</div>

<script>
    (() => {
        'use strict';

        const root=document.getElementById('nsqOpCentro_@Model.ProgramaProduccionID');
        if(!root||root.dataset.readonlyWired==='1') return;
        root.dataset.readonlyWired='1';

        const actionView=root.querySelector('[data-nsq-operativa-vista-accion]');
        const actionBody=root.querySelector('[data-nsq-operativa-contenido-body]');
        const scrollBody=root.querySelector('.nsq-op-body');
        if(!actionView||!actionBody) return;

        let soloLecturaActiva=false;

        function llevarContenidoArriba(){
            if(!scrollBody) return;
            window.requestAnimationFrame(()=>{
                scrollBody.scrollTop=0;
            });
        }

        function aplicarSoloLectura(){
            let banner=actionBody.querySelector('[data-nsq-operativa-readonly-banner]');

            if(soloLecturaActiva&&!banner){
                banner=document.createElement('div');
                banner.className='nsq-op-readonly-banner';
                banner.setAttribute('data-nsq-operativa-readonly-banner','');
                banner.innerHTML='<i class="bi bi-eye-fill mt-1"></i><span>Modo consulta: puedes revisar la información de esta actividad, pero sus capturas y cierres no se pueden modificar desde aquí.</span>';
                actionBody.prepend(banner);
            }

            if(banner){
                banner.classList.toggle('is-visible',soloLecturaActiva);
            }

            if(!soloLecturaActiva) return;

            actionBody.querySelectorAll('form').forEach(form=>{
                form.dataset.nsqSoloLectura='1';
            });

            actionBody.querySelectorAll('form input:not([type="hidden"]), form select, form textarea, form button[type="submit"], form input[type="submit"]').forEach(control=>{
                control.disabled=true;
                control.setAttribute('aria-disabled','true');
            });
        }

        root.addEventListener('click',event=>{
            const link=event.target.closest('[data-nsq-operativa-accion]');
            if(link&&root.contains(link)){
                soloLecturaActiva=String(link.getAttribute('data-solo-lectura')||'false').toLowerCase()==='true';
                root.dataset.nsqSoloLecturaActiva=soloLecturaActiva?'true':'false';
                llevarContenidoArriba();
                window.setTimeout(aplicarSoloLectura,0);
                return;
            }

            const volver=event.target.closest('[data-nsq-operativa-volver]');
            if(volver&&root.contains(volver)){
                soloLecturaActiva=false;
                root.dataset.nsqSoloLecturaActiva='false';
                llevarContenidoArriba();
            }
        },true);

        root.addEventListener('submit',event=>{
            if(!soloLecturaActiva) return;
            const form=event.target;
            if(!(form instanceof HTMLFormElement)||!actionBody.contains(form)) return;

            event.preventDefault();
            event.stopPropagation();
            if(typeof event.stopImmediatePropagation==='function') event.stopImmediatePropagation();
            aplicarSoloLectura();
        },true);

        const observer=new MutationObserver(()=>{
            if(!document.body.contains(root)){
                observer.disconnect();
                return;
            }
            aplicarSoloLectura();
        });

        observer.observe(actionBody,{childList:true,subtree:true});

        root.addEventListener('nsq:operativa-accion-cargada',aplicarSoloLectura);
    })();
</script>
