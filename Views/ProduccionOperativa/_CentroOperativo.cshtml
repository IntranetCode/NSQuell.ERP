@model ERP.NSQuell.Models.ProduccionCentroOperativoVm
@using ERP.NSQuell.Models
@using System.Globalization
@using System.Linq

@functions {
    public static string ClaseEstadoGeneral(string? estado)
    {
        var e = (estado ?? string.Empty).Trim().ToUpperInvariant();
        return e switch
        {
            "PRODUCIENDO" => "is-running",
            "EN_PREPARACION" => "is-preparation",
            "PREPARACION" => "is-preparation",
            "ESPERANDO_CALIDAD" => "is-quality",
            "PAUSADA" => "is-warning",
            "PAUSADO" => "is-warning",
            "BLOQUEADA" => "is-danger",
            "INTERRUMPIDA_URGENTE" => "is-danger",
            "TERMINADA" => "is-done",
            "CERRADA" => "is-done",
            _ => "is-neutral"
        };
    }

    public static string ClasePrioridad(string? prioridad)
    {
        var p = (prioridad ?? string.Empty).Trim().ToUpperInvariant();
        return p switch
        {
            "CRITICA" => "is-danger",
            "CRÍTICA" => "is-danger",
            "ALTA" => "is-warning",
            "BAJA" => "is-muted",
            _ => "is-neutral"
        };
    }

    public static string ClaseSeveridad(string? severidad)
    {
        var s = (severidad ?? string.Empty).Trim().ToUpperInvariant();
        return s switch
        {
            "PELIGRO" => "is-danger",
            "ADVERTENCIA" => "is-warning",
            "EXITO" => "is-success",
            "ÉXITO" => "is-success",
            _ => "is-info"
        };
    }

    public static string ClasePaso(ProduccionOperativaPasoVm paso)
    {
        if (paso.Completado) return "is-complete";
        if (paso.Bloqueado) return "is-blocked";
        if (paso.EnProceso) return "is-progress";
        return "is-pending";
    }

    public static string IconoPaso(ProduccionOperativaPasoVm paso)
    {
        if (paso.Completado) return "bi-check-lg";
        if (paso.Bloqueado) return "bi-lock-fill";
        if (paso.EnProceso) return "bi-play-fill";
        return "bi-circle";
    }

    public static decimal ProgresoEtapa(IEnumerable<ProduccionOperativaPasoVm>? pasos, string etapa)
    {
        if (pasos == null) return 0m;
        var lista = pasos.Where(x => x.Aplica && string.Equals(x.Etapa, etapa, StringComparison.OrdinalIgnoreCase)).ToList();
        if (lista.Count == 0) return 0m;
        return Math.Round(lista.Count(x => x.Completado) * 100m / lista.Count, 0, MidpointRounding.AwayFromZero);
    }

    public static decimal ProgresoClaves(IEnumerable<ProduccionOperativaPasoVm>? pasos, IEnumerable<string> claves)
    {
        if (pasos == null || claves == null) return 0m;
        var set = claves.ToHashSet(StringComparer.OrdinalIgnoreCase);
        var lista = pasos.Where(x => x.Aplica && set.Contains(x.Clave)).ToList();
        if (lista.Count == 0) return 0m;
        return Math.Round(lista.Count(x => x.Completado) * 100m / lista.Count, 0, MidpointRounding.AwayFromZero);
    }

    public static bool ContieneClave(IEnumerable<string> claves, string? clave)
    {
        if (string.IsNullOrWhiteSpace(clave)) return false;
        return claves.Any(x => string.Equals(x, clave, StringComparison.OrdinalIgnoreCase));
    }

    public static string Pct(decimal value)
    {
        var v = Math.Max(0m, Math.Min(100m, value));
        return v.ToString("0.##", CultureInfo.InvariantCulture);
    }

    public static string TextoFecha(DateTime? fecha)
    {
        return fecha.HasValue ? fecha.Value.ToString("dd/MM/yyyy HH:mm") : "-";
    }

    public static bool EsAccionExterna(ProduccionOperativaAccionVm? accion)
    {
        if (accion == null) return false;
        var area = (accion.AreaResponsable ?? string.Empty).Trim().ToUpperInvariant();
        var clave = (accion.Clave ?? string.Empty).Trim().ToUpperInvariant();
        if (area == AgendaOperativaArea.Calidad) return true;
        return clave == AgendaOperativaPasoClave.PrimerasPiezas
            || clave == AgendaOperativaPasoClave.Calidad
            || clave == AgendaOperativaPasoClave.CalidadFinal
            || clave == "RELIBERACION_CALIDAD"
            || clave == "GP12";
    }

    public static string TextoEsperaArea(ProduccionOperativaAccionVm accion)
    {
        var area = (accion.AreaResponsable ?? string.Empty).Trim().ToUpperInvariant();
        return area == AgendaOperativaArea.Calidad ? "Esperando a Calidad" : "Esperando área responsable";
    }

    public static bool PuedeModificarDesdeFlujo(ProduccionOperativaPasoVm paso, ProduccionOperativaAccionVm? accion, bool soloLecturaGlobal)
    {
        if (accion == null || soloLecturaGlobal || EsAccionExterna(accion)) return false;
        if (accion.SoloLectura || accion.Bloqueada || !accion.EsEjecutable || !accion.PuedeEjecutarUsuario) return false;
        if (paso.Completado) return true;
        return accion.DisponibleParaUsuario;
    }

    public static string TextoAccionFlujo(ProduccionOperativaPasoVm paso, ProduccionOperativaAccionVm? accion, bool puedeModificar)
    {
        if (accion == null) return string.Empty;
        if (EsAccionExterna(accion)) return paso.Completado ? "Ver resultado" : "Ver estado";
        if (paso.Completado) return puedeModificar ? "Editar" : "Ver";
        if (paso.EnProceso) return puedeModificar ? "Continuar" : "Ver";
        if (puedeModificar) return string.IsNullOrWhiteSpace(accion.TextoBoton) ? "Atender" : accion.TextoBoton;
        return "Ver";
    }

    public static string IconoAccionFlujo(ProduccionOperativaPasoVm paso, ProduccionOperativaAccionVm? accion, bool puedeModificar)
    {
        if (accion == null) return "bi-eye";
        if (EsAccionExterna(accion)) return "bi-eye";
        if (paso.Completado) return puedeModificar ? "bi-pencil-square" : "bi-eye";
        if (paso.EnProceso) return puedeModificar ? "bi-play-circle" : "bi-eye";
        return puedeModificar ? "bi-arrow-right-circle" : "bi-eye";
    }
}

@{
    var accionActual = Model.AccionActual;
    var siguiente = Model.SiguienteAccion;
    var pasos = Model.PasosVisibles.ToList();
    var accionesVisibles = Model.AccionesVisibles.ToList();

    var clavesPrevio = new[]
    {
        AgendaOperativaPasoClave.Planeacion,
        AgendaOperativaPasoClave.Personal
    };
    var clavesMateriales = new[]
    {
        AgendaOperativaPasoClave.Material,
        AgendaOperativaPasoClave.Secado,
        AgendaOperativaPasoClave.Embalaje
    };
    var clavesMolde = new[]
    {
        AgendaOperativaPasoClave.CambioMolde,
        ProduccionOperativaAccionClave.ChecklistCambioMolde
    };
    var clavesArranque = new[]
    {
        "INICIAR_PREPARACION",
        AgendaOperativaPasoClave.ChecklistArranque,
        AgendaOperativaPasoClave.ConfiguracionCorrida
    };
    var clavesCalidadArranque = new[]
    {
        AgendaOperativaPasoClave.PrimerasPiezas,
        AgendaOperativaPasoClave.Calidad
    };
    var clavesSerie = new[]
    {
        AgendaOperativaPasoClave.InicioSerie,
        AgendaOperativaPasoClave.Produccion,
        AgendaOperativaPasoClave.Capturas,
        AgendaOperativaPasoClave.Cajas
    };
    var clavesCierre = new[]
    {
        AgendaOperativaPasoClave.CalidadFinal,
        AgendaOperativaPasoClave.LiberacionMaquina,
        AgendaOperativaPasoClave.Cierre
    };

    var fasesVisuales = new[]
    {
        new { Clave="PREVIO", Nombre="Prerequisitos", Icono="bi-clipboard-check", Claves=clavesPrevio },
        new { Clave="MATERIALES", Nombre="Materiales", Icono="bi-box-seam", Claves=clavesMateriales },
        new { Clave="MOLDE", Nombre="Molde + checklist", Icono="bi-tools", Claves=clavesMolde },
        new { Clave="ARRANQUE", Nombre="Preparación de arranque", Icono="bi-ui-checks", Claves=clavesArranque },
        new { Clave="CALIDAD", Nombre="Calidad de arranque", Icono="bi-patch-check", Claves=clavesCalidadArranque },
        new { Clave="SERIE", Nombre="Serie", Icono="bi-gear-wide-connected", Claves=clavesSerie },
        new { Clave="CIERRE", Nombre="Cierre", Icono="bi-flag", Claves=clavesCierre }
    }
    .Where(f => pasos.Any(p => p.Aplica && ContieneClave(f.Claves, p.Clave)))
    .ToList();

    var accionesHerramientaClaves = new[]
    {
        ProduccionOperativaAccionClave.CambioTurno,
        ProduccionOperativaAccionClave.RelevoOperador,
        ProduccionOperativaAccionClave.MonitoreoTurno,
        ProduccionOperativaAccionClave.TiempoExtra,
        ProduccionOperativaAccionClave.Historial,
        ProduccionOperativaAccionClave.DetalleCompleto
    };

    var accionesSecundarias = accionesVisibles
        .Where(x => accionesHerramientaClaves.Any(k => string.Equals(k, x.Clave, StringComparison.OrdinalIgnoreCase)))
        .Where(x => !x.Completada || string.Equals(x.Clave, ProduccionOperativaAccionClave.Historial, StringComparison.OrdinalIgnoreCase) || string.Equals(x.Clave, ProduccionOperativaAccionClave.DetalleCompleto, StringComparison.OrdinalIgnoreCase))
        .OrderBy(x => x.Orden)
        .ThenBy(x => x.Titulo)
        .ToList();

    var clavesDuranteSerie = new[]
    {
        AgendaOperativaPasoClave.Capturas,
        AgendaOperativaPasoClave.Cajas,
        AgendaOperativaPasoClave.Paro,
        ProduccionOperativaAccionClave.CambioTurno,
        ProduccionOperativaAccionClave.TiempoExtra
    };

    var accionesDuranteSerie = accionesVisibles
        .Where(x => clavesDuranteSerie.Any(k => string.Equals(k, x.Clave, StringComparison.OrdinalIgnoreCase)))
        .Where(x => !x.Completada)
        .Where(x => accionActual == null || !string.Equals(x.Clave, accionActual.Clave, StringComparison.OrdinalIgnoreCase))
        .OrderBy(x => x.Orden)
        .ThenBy(x => x.Titulo)
        .ToList();

    var mostrarAccionesDuranteSerie = Model.EstatusEjecucionID is ProduccionEstatus.EnProduccion or ProduccionEstatus.Pausado
        && accionesDuranteSerie.Any();

    var detalleCompleto = accionesVisibles.FirstOrDefault(x => string.Equals(x.Clave, ProduccionOperativaAccionClave.DetalleCompleto, StringComparison.OrdinalIgnoreCase));
    var historial = accionesVisibles.FirstOrDefault(x => string.Equals(x.Clave, ProduccionOperativaAccionClave.Historial, StringComparison.OrdinalIgnoreCase));

    var pasoCambioMolde = pasos.FirstOrDefault(x => string.Equals(x.Clave, AgendaOperativaPasoClave.CambioMolde, StringComparison.OrdinalIgnoreCase));
    var pasoChecklistMolde = pasos.FirstOrDefault(x => string.Equals(x.Clave, ProduccionOperativaAccionClave.ChecklistCambioMolde, StringComparison.OrdinalIgnoreCase));
    var accionCambioMolde = accionesVisibles.FirstOrDefault(x => string.Equals(x.Clave, AgendaOperativaPasoClave.CambioMolde, StringComparison.OrdinalIgnoreCase));
    var accionChecklistMolde = accionesVisibles.FirstOrDefault(x => string.Equals(x.Clave, ProduccionOperativaAccionClave.ChecklistCambioMolde, StringComparison.OrdinalIgnoreCase));
    var mostrarTrabajoParaleloMolde = pasoCambioMolde?.Aplica == true && !(pasoCambioMolde.Completado && pasoChecklistMolde?.Completado == true);

    var urlCentro = Url.Action("Centro", "ProduccionOperativa", new { programaProduccionId = Model.ProgramaProduccionID, origen = Model.Origen, soloLectura = Model.Permisos.SoloLectura }) ?? $"/Produccion/Operativa/Centro/{Model.ProgramaProduccionID}";
    var urlDetalle = Model.EjecucionProduccionID.HasValue
        ? Url.Action("Detalle", "Produccion", new { id = Model.EjecucionProduccionID.Value })
        : Url.Action("Index", "Produccion", new { busqueda = Model.OFTexto });

    var estadoClase = ClaseEstadoGeneral(Model.EstadoGeneral);
    var prioridadClase = ClasePrioridad(Model.Prioridad);
    var porcentajeGeneral = Math.Max(Model.Resumen.PorcentajeGeneral, Model.Metricas.PorcentajeAvance);
}
