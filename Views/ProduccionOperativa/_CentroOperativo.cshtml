                                    <div class="nsq-op-kpi-value">@Model.Metricas.CantidadPendiente.ToString("N0")</div>
                                    <div class="nsq-op-kpi-note">piezas</div>
                                </div>
                                <div class="nsq-op-kpi">
                                    <div class="nsq-op-kpi-label">Capturas</div>
                                    <div class="nsq-op-kpi-value">@Model.Metricas.CapturasCompletadas / @Model.Metricas.CapturasRequeridas</div>
                                    <div class="nsq-op-kpi-note">@Model.Metricas.CapturasPendientes pendiente(s)</div>
