        display: flex;
        align-items: center;
        justify-content: center;
        background: #eaf2ff;
        color: var(--op-primary);
        font-size: 1.25rem;
        flex: none;
    }

    .nsq-op-action.is-blocked .nsq-op-action-icon {
        background: #fff0f0;
        color: var(--op-danger)
    }

    .nsq-op-action.is-waiting .nsq-op-action-icon {
        background: #fff7e6;
        color: var(--op-warning)
    }

    .nsq-op-action-kicker {
        font-size: .68rem;
        text-transform: uppercase;
        letter-spacing: .075em;
        color: var(--op-muted);
        font-weight: 900
    }

    .nsq-op-action-title {
        margin-top: 2px;
        color: var(--op-navy);
        font-size: 1.03rem;
        font-weight: 950;
        line-height: 1.15
    }

    .nsq-op-action-desc {
        margin-top: 5px;
        color: var(--op-muted);
        font-size: .79rem;
        line-height: 1.4
    }

    .nsq-op-meta {
        display: flex;
        align-items: center;
        gap: 8px 13px;
        flex-wrap: wrap;
        margin-top: 9px;
        font-size: .71rem;
        color: #475467;
        font-weight: 750
    }

        .nsq-op-meta span {
            display: inline-flex;
            align-items: center;
            gap: 5px
        }

    .nsq-op-action-btn {
        min-width: 128px;
        border: 0;
        border-radius: 12px;
        padding: 10px 13px;
        background: var(--op-primary);
        color: #fff;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: 7px;
        text-decoration: none;
        font-size: .78rem;
        font-weight: 900;
        box-shadow: 0 5px 14px rgba(0,74,173,.18);
        transition: .16s ease;
        white-space: nowrap;
    }

        .nsq-op-action-btn:hover {
            color: #fff;
            background: #003f93;
            transform: translateY(-1px)
        }

        .nsq-op-action-btn.is-view {
            background: #eef4fc;
            color: var(--op-primary);
            box-shadow: none;
            border: 1px solid #cfdff5
        }

            .nsq-op-action-btn.is-view:hover {
                background: #e3eefc;
                color: #003f93
            }

        .nsq-op-action-btn.is-external {
            background: #f3f4f6;
            color: #667085;
            border: 1px solid #d9dee7;
            box-shadow: none;
            cursor: default;
            pointer-events: none
        }

    .nsq-op-tool.is-disabled {
        background: #f7f8fa;
        color: #98a2b3;
        border-color: #e4e7ec;
        cursor: default;
        pointer-events: none
    }

    .nsq-op-next {
        display: flex;
        align-items: center;
        gap: 10px;
        margin-top: 10px;
        padding: 11px 13px;
        border-radius: 13px;
        background: #f8fafc;
        border: 1px dashed #d5dce6;
        color: #475467;
    }

    .nsq-op-next-icon {
        width: 31px;
        height: 31px;
        border-radius: 9px;
        background: #fff;
        border: 1px solid var(--op-border);
        display: flex;
        align-items: center;
        justify-content: center;
        color: var(--op-primary)
    }

    .nsq-op-next strong {
        display: block;
        color: var(--op-navy);
        font-size: .78rem
    }

    .nsq-op-next small {
        display: block;
        margin-top: 2px;
        font-size: .69rem;
        color: var(--op-muted)
    }

    .nsq-op-alerts {
        display: flex;
        flex-wrap: wrap;
        gap: 6px;
        margin-bottom: 8px
    }

    .nsq-op-alert {
        display: inline-flex;
        align-items: center;
        gap: 7px;
        min-width: 0;
        max-width: 100%;
        padding: 5px 9px;
        border-radius: 999px;
        border: 1px solid #dbe6f2;
        background: #f5faff;
        color: #24557f;
        font-size: .69rem;
    }

        .nsq-op-alert.is-warning {
            background: #fff8ea;
            border-color: #f3d8a5;
            color: #895600
        }

        .nsq-op-alert.is-danger {
            background: #fff1f1;
            border-color: #efb9b9;
            color: #a72828
        }

        .nsq-op-alert.is-success {
            background: #edf9f3;
            border-color: #bfe2cf;
            color: #176b48
        }

        .nsq-op-alert i {
            flex: 0 0 auto
        }

        .nsq-op-alert > div {
            display: flex;
            align-items: center;
            gap: 5px;
            min-width: 0
        }

        .nsq-op-alert strong {
            flex: 0 0 auto;
            font-size: .69rem
        }

        .nsq-op-alert span {
            min-width: 0;
            max-width: 620px;
            overflow: hidden;
            text-overflow: ellipsis;
            white-space: nowrap;
            line-height: 1.2
        }

    .nsq-op-kpi-grid {
        display: grid;
        grid-template-columns: repeat(2,minmax(0,1fr));
        gap: 8px
    }

    .nsq-op-kpi {
        min-width: 0;
        padding: 11px;
        border: 1px solid var(--op-border);
        border-radius: 12px;
        background: #fff;
    }

    .nsq-op-kpi-label {
        font-size: .64rem;
        color: var(--op-muted);
        font-weight: 850;
        text-transform: uppercase;
        letter-spacing: .045em
    }

    .nsq-op-kpi-value {
        margin-top: 3px;
        color: var(--op-navy);
        font-size: 1.03rem;
        font-weight: 950;
        white-space: nowrap;
        overflow: hidden;
        text-overflow: ellipsis
    }

    .nsq-op-kpi-note {
        margin-top: 2px;
        color: var(--op-muted);
        font-size: .64rem
    }

    .nsq-op-progress-line {
        height: 8px;
        border-radius: 999px;
        background: #edf1f5;
        overflow: hidden;
        margin-top: 9px
    }

        .nsq-op-progress-line span {
            display: block;
            height: 100%;
            border-radius: inherit;
            background: linear-gradient(90deg,var(--op-primary),#2b82eb)
        }

    .nsq-op-progress-label {
        display: flex;
        justify-content: space-between;
        gap: 10px;
        margin-top: 6px;
        font-size: .68rem;
        color: var(--op-muted);
        font-weight: 750
    }

    .nsq-op-series-tools {
        margin-top: 10px;
        padding: 10px 11px;
        border: 1px solid var(--op-border);
        border-radius: 13px;
        background: #fbfcfe;
    }

    .nsq-op-series-tools-head {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 8px;
        margin-bottom: 7px;
    }

        .nsq-op-series-tools-head strong {
            color: var(--op-navy);
            font-size: .72rem;
        }

        .nsq-op-series-tools-head span {
            color: var(--op-muted);
            font-size: .62rem;
        }

    .nsq-op-series-tools-list {
        display: flex;
        gap: 6px;
        flex-wrap: wrap;
    }

    .nsq-op-lhrh {
        margin-top: 10px;
        padding: 11px 12px;
        border: 1px solid #d7c8f0;
        border-radius: 13px;
        background: #faf7ff;
    }

    .nsq-op-lhrh-title {
        display: flex;
        align-items: center;
        gap: 7px;
        color: #6941a5;
        font-size: .73rem;
        font-weight: 950
    }

    .nsq-op-lhrh-grid {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 7px;
        margin-top: 8px
    }

    .nsq-op-lhrh-item {
        padding: 8px 9px;
        border-radius: 10px;
        background: #fff;
        border: 1px solid #e6ddf5;
        font-size: .69rem;
        color: #5b4b72
    }

        .nsq-op-lhrh-item strong {
            display: block;
            color: #39265c;
            font-size: .76rem
        }

    .nsq-op-details {
        margin-top: 12px;
        border: 1px solid var(--op-border);
        border-radius: 14px;
        background: #fff;
        overflow: hidden
    }

        .nsq-op-details > summary {
            list-style: none;
            display: flex;
            align-items: center;
            justify-content: space-between;
            gap: 10px;
            cursor: pointer;
            padding: 12px 14px;
            color: var(--op-navy);
            font-size: .76rem;
            font-weight: 900;
        }

            .nsq-op-details > summary::-webkit-details-marker {
                display: none
            }

            .nsq-op-details > summary::after {
                content: "\F282";
                font-family: "bootstrap-icons";
                font-size: .75rem;
                color: var(--op-muted);
                transition: .16s ease
            }

        .nsq-op-details[open] > summary::after {
            transform: rotate(180deg)
        }

    .nsq-op-details-body {
        padding: 0 14px 13px
    }

    .nsq-op-flow {
        display: grid;
        gap: 6px
    }

    .nsq-op-flow-item {
        display: grid;
        grid-template-columns: 27px minmax(0,1fr) auto auto;
        align-items: center;
        gap: 9px;
        padding: 8px 9px;
        border-radius: 10px;
        background: #fafbfc;
        border: 1px solid #edf0f4;
    }

    .nsq-op-flow-icon {
        width: 27px;
        height: 27px;
        border-radius: 8px;
        display: flex;
        align-items: center;
        justify-content: center;
        background: #fff;
        border: 1px solid var(--op-border);
        color: #98a2b3
    }

    .nsq-op-flow-item.is-complete .nsq-op-flow-icon {
        background: #eaf8f1;
        border-color: #b8e0ca;
        color: var(--op-success)
    }

    .nsq-op-flow-item.is-progress .nsq-op-flow-icon {
        background: #eaf2ff;
        border-color: #c9dcf8;
        color: var(--op-primary)
    }

    .nsq-op-flow-item.is-blocked .nsq-op-flow-icon {
        background: #fff0f0;
        border-color: #f1c0c0;
        color: var(--op-danger)
    }

    .nsq-op-flow-title {
        font-size: .73rem;
        color: var(--op-navy);
        font-weight: 850
    }

    .nsq-op-flow-detail {
        margin-top: 2px;
        font-size: .65rem;
        color: var(--op-muted);
        line-height: 1.3
    }

    .nsq-op-flow-state {
        font-size: .64rem;
        color: var(--op-muted);
        font-weight: 850;
        white-space: nowrap
    }

    .nsq-op-flow-action {
        min-width: 82px;
        min-height: 32px;
        padding: 6px 9px;
        border: 1px solid #cfdff5;
        border-radius: 9px;
        background: #eef4fc;
        color: var(--op-primary);
        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: 5px;
        text-decoration: none;
        font-size: .64rem;
        font-weight: 900;
        white-space: nowrap;
        transition: .16s ease;
    }

        .nsq-op-flow-action:hover {
            color: #003f93;
            background: #e3eefc;
            border-color: #b7d0f1;
            transform: translateY(-1px)
        }

        .nsq-op-flow-action.is-edit,
        .nsq-op-flow-action.is-attend {
            background: var(--op-primary);
            border-color: var(--op-primary);
            color: #fff;
        }

            .nsq-op-flow-action.is-edit:hover,
            .nsq-op-flow-action.is-attend:hover {
                background: #003f93;
                border-color: #003f93;
                color: #fff
            }

        .nsq-op-flow-action.is-external {
            background: #f7f8fa;
            border-color: #e1e5eb;
            color: #667085;
        }

    .nsq-op-flow-noaction {
        min-width: 82px;
        text-align: center;
        color: #98a2b3;
        font-size: .62rem;
        font-weight: 800;
    }

    .nsq-op-tools {
        display: flex;
        gap: 7px;
        flex-wrap: wrap
    }

    .nsq-op-tool {
        border: 1px solid var(--op-border);
        border-radius: 10px;
        padding: 7px 9px;
        background: #fff;
        color: #344054;
        text-decoration: none;
        font-size: .69rem;
        font-weight: 850;
        display: inline-flex;
        align-items: center;
        gap: 6px;
    }

        .nsq-op-tool:hover {
            color: var(--op-primary);
            border-color: #b9d0ef;
            background: #f7faff
        }

    .nsq-op-footer {
        flex: 0 0 auto;
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 12px;
        flex-wrap: wrap;
        padding: 11px 20px;
        border-top: 1px solid var(--op-border);
        background: #fff;
        color: var(--op-muted);
        font-size: .68rem;
    }

    .nsq-op-footer-user {
        display: flex;
        align-items: center;
        gap: 7px;
        min-width: 0
    }

        .nsq-op-footer-user strong {
            color: #344054
        }

    .nsq-op-action-view {
        display: none;
        width: 100%;
        min-height: 0;
    }

        .nsq-op-action-view.is-active {
            display: block;
            min-height: 0;
        }

    [data-nsq-operativa-contenido-body] {
        width: 100%;
        min-height: 0;
        overflow: visible;
    }

    .nsq-op-action-view-head {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 12px;
        margin-bottom: 12px;
    }

    .nsq-op-back {
        border: 1px solid var(--op-border);
        border-radius: 10px;
        background: #fff;
        color: #344054;
        padding: 8px 10px;
        display: inline-flex;
        align-items: center;
        gap: 6px;
        font-size: .72rem;
        font-weight: 850;
    }

    .nsq-op-readonly-banner {
        display: none;
        align-items: flex-start;
        gap: 8px;
        margin-bottom: 10px;
        padding: 9px 11px;
        border: 1px solid #d7e3f3;
        border-radius: 11px;
        background: #f5f9ff;
        color: #345b83;
        font-size: .69rem;
        font-weight: 800;
        line-height: 1.35;
    }

        .nsq-op-readonly-banner.is-visible {
            display: flex
        }

    .nsq-op-loading {
        min-height: 220px;
        display: flex;
        align-items: center;
        justify-content: center;
        flex-direction: column;
        gap: 10px;
        color: var(--op-muted);
        font-size: .78rem;
        font-weight: 800;
    }

    .nsq-op-spinner {
        width: 28px;
        height: 28px;
        border: 3px solid #d9e4f2;
        border-top-color: var(--op-primary);
        border-radius: 50%;
        animation: nsqOpSpin .75s linear infinite;
    }

    @@keyframes nsqOpSpin {
        to {
            transform: rotate(360deg)
        }
    }

    html[data-nsq-theme="dark"] .nsq-op-center {
        --op-text: #edf2f7;
        --op-muted: #9bacbf;
        --op-border: rgba(255,255,255,.10);
        --op-soft: #0b1422;
        --op-navy: #f6f8fb;
        background: #101b2c;
    }

    html[data-nsq-theme="dark"] .nsq-op-body,
    html[data-nsq-theme="dark"] .nsq-op-footer {
        background: #0b1422
    }

    html[data-nsq-theme="dark"] .nsq-op-card,
    html[data-nsq-theme="dark"] .nsq-op-stage,
    html[data-nsq-theme="dark"] .nsq-op-kpi,
    html[data-nsq-theme="dark"] .nsq-op-details,
    html[data-nsq-theme="dark"] .nsq-op-flow-icon,
    html[data-nsq-theme="dark"] .nsq-op-tool,
    html[data-nsq-theme="dark"] .nsq-op-lhrh-item,
    html[data-nsq-theme="dark"] .nsq-op-action {
        background: #111d2f
    }

    html[data-nsq-theme="dark"] .nsq-op-action {
        background: linear-gradient(180deg,#111d2f,#0e1929)
    }

    html[data-nsq-theme="dark"] .nsq-op-flow-item,
    html[data-nsq-theme="dark"] .nsq-op-next {
        background: #0e1929
    }

    html[data-nsq-theme="dark"] .nsq-op-route-note,
    html[data-nsq-theme="dark"] .nsq-op-parallel {
        background: #0e1929;
        border-color: #27466d;
        color: #b7cdf0;
    }

    html[data-nsq-theme="dark"] .nsq-op-parallel-task {
        background: #111d2f;
    }

    html[data-nsq-theme="dark"] .nsq-op-series-tools {
        background: #0e1929;
    }

    @@media(max-width:991.98px) {
        .nsq-op-grid {
            grid-template-columns: 1fr
        }

        .nsq-op-stagebar {
            grid-template-columns: repeat(7,minmax(118px,1fr));
            overflow-x: auto;
            padding-bottom: 3px
        }
    }

    @@media(max-width:767.98px) {
        .nsq-op-header {
            padding: 16px
        }

        .nsq-op-header-top {
            flex-direction: column
        }

        .nsq-op-header-actions {
            position: absolute;
            right: 12px;
            top: 12px
        }

        .nsq-op-body {
            padding: 12px
        }

        .nsq-op-parallel-grid,
        .nsq-op-flow-phase.is-parallel .nsq-op-flow {
            grid-template-columns: 1fr
        }

        .nsq-op-action-main {
            grid-template-columns: auto 1fr
        }

            .nsq-op-action-main > .nsq-op-action-btn {
                grid-column: 1/-1;
                width: 100%
            }

        .nsq-op-kpi-grid {
            grid-template-columns: 1fr 1fr
        }

        .nsq-op-flow-item {
            grid-template-columns: 27px minmax(0,1fr) auto;
            align-items: start
        }

        .nsq-op-flow-state {
            align-self: center
        }

        .nsq-op-flow-action,
        .nsq-op-flow-noaction {
            grid-column: 2/-1;
            justify-self: stretch;
            width: 100%
        }

        .nsq-op-footer {
            padding: 10px 12px
        }
    }
</style>

<div id="nsqOpCentro_@Model.ProgramaProduccionID"
     class="nsq-op-center"
     data-nsq-operativa-centro
     data-programa-id="@Model.ProgramaProduccionID"
     data-ejecucion-id="@(Model.EjecucionProduccionID?.ToString() ?? "")"
     data-of="@Model.OFTexto"
     data-origen="@Model.Origen"
     data-solo-lectura="@(Model.Permisos.SoloLectura ? "true" : "false")">

    <div class="nsq-op-header">
        <div class="nsq-op-header-top">
            <div>
                <div class="nsq-op-title-row">
                    <div class="nsq-op-of">OF @Model.OFTexto</div>
                    <span class="nsq-op-program">@Model.ProgramaTexto</span>
                    @if (Model.EsParejaLhRh)
                    {
                        <span class="nsq-op-program"><i class="bi bi-link-45deg"></i> LH/RH</span>
                    }
                </div>
                <div class="nsq-op-subtitle">
                    <span><i class="bi bi-gear-wide-connected"></i>@Model.MaquinaTexto</span>
                    <span><i class="bi bi-box"></i>@Model.ParteTexto</span>
                    @if (!string.IsNullOrWhiteSpace(Model.ClienteNombre))
                    {
                        <span><i class="bi bi-building"></i>@Model.ClienteNombre</span>
                    }
                    @if (!string.IsNullOrWhiteSpace(Model.MoldeCodigo))
                    {
                        <span><i class="bi bi-grid-3x3-gap"></i>@Model.MoldeTexto</span>
                    }
                </div>
            </div>

            <div class="nsq-op-header-actions">
                <a href="@urlCentro"
                   class="nsq-op-icon-btn"
                   title="Actualizar"
                   data-nsq-operativa-refrescar>
                    <i class="bi bi-arrow-clockwise"></i>
                </a>
                @if (!string.IsNullOrWhiteSpace(urlDetalle) && detalleCompleto != null)
                {
                    <a href="@urlDetalle"
                       class="nsq-op-icon-btn"
                       title="Abrir detalle completo"
                       target="_blank"
                       rel="noopener">
                        <i class="bi bi-box-arrow-up-right"></i>
                    </a>
                }
                <button type="button"
                        class="nsq-op-icon-btn"
                        data-bs-dismiss="modal"
                        aria-label="Cerrar"
                        title="Cerrar">
                    <i class="bi bi-x-lg"></i>
                </button>
            </div>
        </div>

        <div class="nsq-op-badges">
            <span class="nsq-op-badge @estadoClase">
                <i class="bi bi-activity"></i>@Model.EstadoGeneralTexto
            </span>
            <span class="nsq-op-badge @prioridadClase">
                <i class="bi bi-flag-fill"></i>@Model.PrioridadTexto
            </span>
            <span class="nsq-op-badge">
                <i class="bi @ProduccionOperativaEtapa.Icono(Model.EtapaActual)"></i>@Model.EtapaActualTexto
            </span>
            @if (Model.Permisos.SoloLectura)
            {
                <span class="nsq-op-badge is-muted"><i class="bi bi-eye"></i>Solo lectura</span>
            }
            @if (Model.TieneParoAbierto)
            {
                <span class="nsq-op-badge is-warning"><i class="bi bi-pause-circle-fill"></i>Paro abierto</span>
            }
            @if (Model.TieneInterrupcionUrgente)
            {
                <span class="nsq-op-badge is-danger"><i class="bi bi-exclamation-octagon-fill"></i>Interrupción urgente</span>
            }
        </div>
    </div>

    <div class="nsq-op-body">
        <div data-nsq-operativa-resumen>
            <div class="nsq-op-stagebar">
                @foreach (var fase in fasesVisuales)
                {
                    var pasosFase = pasos.Where(x => ContieneClave(fase.Claves, x.Clave)).ToList();
                    var porcentajeFase = ProgresoClaves(pasos, fase.Claves);
                    var actualFase = accionActual != null && ContieneClave(fase.Claves, accionActual.Clave);
                    var pasadaFase = porcentajeFase >= 100m;
                    <div class="nsq-op-stage @(actualFase ? "is-current" : pasadaFase ? "is-past" : "")">
                        <div class="nsq-op-stage-head">
                            <i class="bi @fase.Icono"></i>
                            <span>@fase.Nombre</span>
                            <span class="ms-auto">@porcentajeFase.ToString("0")%</span>
