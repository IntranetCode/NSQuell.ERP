@model ERP.NSQuell.Models.ProduccionConfiguracionTecnicoVm
@using ERP.NSQuell.Models
@using System.Globalization
@using System.Linq
@using System.Collections.Generic

@functions {
    public static HashSet<int> CavidadesSeleccionadas(string? csv)
    {
        var set = new HashSet<int>();
        if (string.IsNullOrWhiteSpace(csv)) return set;
        foreach (var parte in csv.Split(',', StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries))
            if (int.TryParse(parte, out var n) && n > 0) set.Add(n);
        return set;
    }

    public static decimal? ObjetivoReferencia(int? cavidades, decimal? ciclo)
    {
        if (!cavidades.HasValue || cavidades.Value <= 0 || !ciclo.HasValue || ciclo.Value <= 0) return null;
        return (3600m / ciclo.Value) * cavidades.Value;
    }

    public static string ComparacionObjetivo(int actual, decimal? referencia)
    {
        if (actual <= 0 || !referencia.HasValue || referencia.Value <= 0) return "Sin referencia";
        var refRedondeada = (int)Math.Round(referencia.Value, 0, MidpointRounding.AwayFromZero);
        var diferencia = actual - refRedondeada;
        if (diferencia == 0) return "Igual a referencia";
        return diferencia > 0
            ? $"{Math.Abs(diferencia):N0} pzas/h por encima"
            : $"{Math.Abs(diferencia):N0} pzas/h por debajo";
    }
}

@{
    var puedeModificar = ViewData["PuedeModificarConfiguracionOperativa"] is bool pm && pm;
    var cfg = Model.ConfiguracionActual;
    var pareja = Model.ParejaLhRh;
    var tieneRelacionPareja = pareja != null;
    var tieneEjecucionPareja = pareja?.TieneEjecucionPareja == true;
    var compatiblePareja = pareja?.EsCompatibleFisicamente != false;
    var cfgPareja = Model.ConfiguracionActualPareja;
    var actualVigente = cfg?.EstaVigente == true;
    var parejaVigente = cfgPareja?.EstaVigente == true;
    var configuracionInconsistente = tieneEjecucionPareja && (actualVigente != parejaVigente);
    var bloquearPareja = tieneRelacionPareja && (!tieneEjecucionPareja || !compatiblePareja || configuracionInconsistente);
    var esCambio = actualVigente && (!tieneEjecucionPareja || parejaVigente);

    var accion = esCambio
        ? (Url.Action("CambiarConfiguracionCorridaOperativa", "Produccion") ?? "/Produccion/CambiarConfiguracionCorridaOperativa")
        : (Url.Action("GuardarConfiguracionCorridaOperativa", "Produccion") ?? "/Produccion/GuardarConfiguracionCorridaOperativa");

    var cavidadesDefault = cfg?.CavidadesUsadas ?? Model.CavidadesBD;
    var cavidadesCsv = cfg?.CavidadesConfiguradas;
    var seleccionActual = CavidadesSeleccionadas(cavidadesCsv);
    var cavidadesDisponibles = (Model.CavidadesDisponibles ?? new List<int>()).Where(x => x > 0).Distinct().OrderBy(x => x).ToList();

    var cavidadesDefaultPareja = cfgPareja?.CavidadesUsadas ?? Model.CavidadesBDPareja;
    var cavidadesCsvPareja = cfgPareja?.CavidadesConfiguradas;
    var seleccionPareja = CavidadesSeleccionadas(cavidadesCsvPareja);
    var cavidadesDisponiblesPareja = (Model.CavidadesDisponiblesPareja ?? new List<int>()).Where(x => x > 0).Distinct().OrderBy(x => x).ToList();

    var cicloDefault = cfg?.TiempoCicloSegundos ?? Model.TiempoCicloBD ?? cfgPareja?.TiempoCicloSegundos ?? Model.TiempoCicloBDPareja;
    var contadorDefault = Model.UltimoContadorMaquina ?? Model.UltimoContadorMaquinaPareja;
    var objetivoRef = ObjetivoReferencia(Model.CavidadesBD, Model.TiempoCicloBD);
    var objetivoRefPareja = ObjetivoReferencia(Model.CavidadesBDPareja, Model.TiempoCicloBDPareja);
}

<style>
