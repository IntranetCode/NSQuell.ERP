        --t-navy: #102a56;
        --t-text: #1d2939;
        --t-muted: #667085;
        --t-line: #e4e7ec;
        --t-soft: #f8fafc;
        --t-green: #128254;
        --t-orange: #b66900;
        --t-red: #c93636;
        color: var(--t-text)
    }

