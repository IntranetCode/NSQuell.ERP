@model ERP.NSQuell.Models.ProduccionSeguimientoTecnicoOperativoVm
@using ERP.NSQuell.Models
@using System.Globalization
@using System.Linq

@functions {
    public static string Fecha(DateTime? value)
    {
        return value.HasValue ? value.Value.ToString("dd/MM/yyyy HH:mm") : "-";
    }

    public static string Numero(int value)
    {
        return value.ToString("N0");
    }

    public static string DecimalTexto(decimal? value, string formato = "0.##")
    {
        return value.HasValue ? value.Value.ToString(formato) : "-";
    }

    public static string EstadoCaptura(ProduccionSeguimientoTecnicoCapturaVm captura)
    {
        if (!captura.CumplioObjetivo.HasValue) return "is-neutral";
        return captura.CumplioObjetivo.Value ? "is-ok" : "is-bad";
    }

    public static string EstadoCalidad(ProduccionSeguimientoTecnicoCalidadVm? calidad)
    {
        if (calidad == null) return "is-neutral";
        if (calidad.ConfiguracionInvalidada || calidad.RequiereReliberacion || calidad.MonitoreosVencidos > 0 || calidad.DisposicionesPendientes > 0) return "is-bad";
        if (calidad.MonitoreosConHallazgo > 0) return "is-warn";
        if (calidad.Liberado) return "is-ok";
        return "is-warn";
    }

    public static string EstadoEjecucion(int estatusId)
    {
        return estatusId switch
        {
            ProduccionEstatus.EnProduccion => "is-running",
            ProduccionEstatus.Pausado => "is-warn",
            ProduccionEstatus.EnPreparacion => "is-prep",
            ProduccionEstatus.Terminado or ProduccionEstatus.TerminadoParcial or ProduccionEstatus.Cerrado => "is-ok",
            _ => "is-neutral"
        };
    }

    public static string Pct(decimal value)
    {
        return Math.Max(0m, Math.Min(100m, value)).ToString("0.##", CultureInfo.InvariantCulture);
    }
}

@{
    var ultima = Model.UltimaCaptura;
    var lectura = Model.UltimaLecturaContador;
    var configuracionFisica = Model.ConfiguracionFisicaReferencia;
    var tieneAlertas = Model.TieneParoAbierto || Model.RequiereReliberacion || Model.TieneHallazgosCalidad || (Model.EsParejaLhRh && !Model.ConfiguracionFisicaSincronizada);
    var urlHistorial = Url.Action("Contenido", "ProduccionOperativa", new
    {
        programaProduccionId = Model.ProgramaProduccionID,
        accionClave = ProduccionOperativaAccionClave.Historial,
        origen = ProduccionOperativaOrigen.Calendario,
        soloLectura = true
    }) ?? $"/Produccion/Operativa/Contenido/{Model.ProgramaProduccionID}/{ProduccionOperativaAccionClave.Historial}?origen=CALENDARIO&soloLectura=true";
}

