</style>

<div class="pst">
    <section class="pst-head">
        <div class="pst-head-main">
            <div class="pst-head-icon"><i class="bi bi-activity"></i></div>
            <div>
                <div class="pst-kicker">Producción en serie · seguimiento</div>
                <div class="pst-title">Seguimiento técnico de @Model.NumeroOF</div>
                <div class="pst-sub">
                    <span><i class="bi bi-hash"></i>Programa @Model.ProgramaProduccionID</span>
                    <span><i class="bi bi-gear-wide-connected"></i>@Model.Maquina</span>
                    <span><i class="bi bi-box"></i>@(!string.IsNullOrWhiteSpace(Model.ReferenciaSAP) ? Model.ReferenciaSAP : Model.NumeroParte)</span>
                    @if (!string.IsNullOrWhiteSpace(Model.Molde))
                    {
                        <span><i class="bi bi-grid-3x3-gap"></i>@Model.Molde</span>
                    }
                </div>
            </div>
        </div>
        <div class="pst-head-actions">
            <span class="pst-badge is-read"><i class="bi bi-eye-fill"></i>Solo consulta</span>
            <button type="button" class="pst-btn" data-pst-refrescar><i class="bi bi-arrow-clockwise"></i>Actualizar</button>
        </div>
    </section>

    <div class="pst-note">
        <i class="bi bi-info-circle-fill"></i>
        <div><strong>Las capturas por hora las realiza el operador.</strong> Este bloque permite al técnico y a supervisión consultar lo capturado, el contador, la configuración vigente, los paros y el estado de Calidad sin modificar la producción horaria.</div>
    </div>

    @if (tieneAlertas)
    {
        <div class="pst-alerts">
            @if (Model.TieneParoAbierto)
            {
                <div class="pst-alert is-bad"><i class="bi bi-pause-circle-fill"></i><span>Existe un paro abierto en la operación. Revisa el motivo y el tiempo acumulado antes de asumir que la corrida continúa normalmente.</span></div>
            }
            @if (Model.RequiereReliberacion)
            {
                <div class="pst-alert is-bad"><i class="bi bi-shield-exclamation"></i><span>Calidad requiere reliberación o existe una configuración invalidada. El estado se muestra aquí únicamente para seguimiento.</span></div>
            }
            @if (Model.TieneHallazgosCalidad)
            {
                <div class="pst-alert is-warn"><i class="bi bi-exclamation-triangle-fill"></i><span>Existen hallazgos o disposiciones pendientes en Calidad. Consulta el detalle del lado correspondiente.</span></div>
            }
            @if (Model.EsParejaLhRh && !Model.ConfiguracionFisicaSincronizada)
            {
                <div class="pst-alert is-bad"><i class="bi bi-link-45deg"></i><span>La pareja LH/RH no tiene sincronizados el ciclo y el contador base de la configuración física vigente. Debe revisarse antes de interpretar el seguimiento conjunto.</span></div>
            }
        </div>
    }

    <section class="pst-kpis">
        <div class="pst-kpi"><div class="pst-kpi-label">Planeado</div><div class="pst-kpi-value">@Numero(Model.CantidadPlaneadaTotal)</div><div class="pst-kpi-note">pieza(s) de la operación</div></div>
        <div class="pst-kpi"><div class="pst-kpi-label">OK acumulado</div><div class="pst-kpi-value">@Numero(Model.CantidadOKTotal)</div><div class="pst-kpi-note">@Model.PorcentajeAvance.ToString("0.#")% del plan</div></div>
        <div class="pst-kpi"><div class="pst-kpi-label">Capturas operador</div><div class="pst-kpi-value">@Numero(Model.CapturasRegistradasTotal)</div><div class="pst-kpi-note">bloques horarios registrados</div></div>

        @* NSQ_SERIE_OBJETIVO_TEORICO_BD_V1 *@
        @foreach (var ladoObjetivo in Model.Lados
            .Where(x => x.ObjetivoHoraTeorico.HasValue && x.ObjetivoHoraTeorico.Value > 0)
            .OrderBy(x => x.ProgramaProduccionID))
        {
            <div class="pst-kpi">
                <div class="pst-kpi-label">
                    @(Model.EsParejaLhRh
                        ? $"Objetivo teórico / h · {(string.IsNullOrWhiteSpace(ladoObjetivo.LadoLhRh) ? ladoObjetivo.NumeroOF : ladoObjetivo.LadoLhRh)}"
                        : "Objetivo teórico / h")
                </div>
                <div class="pst-kpi-value">@ladoObjetivo.ObjetivoHoraTeorico.Value.ToString("N0")</div>
                <div class="pst-kpi-note">
                    pzas/h · @(string.IsNullOrWhiteSpace(ladoObjetivo.ObjetivoHoraTeoricoFuente)
                        ? "referencia BD"
                        : ladoObjetivo.ObjetivoHoraTeoricoFuente)
                </div>
            </div>
        }

        <div class="pst-kpi"><div class="pst-kpi-label">Cumplimiento horario</div><div class="pst-kpi-value">@(Model.ObjetivoAcumuladoTotal > 0 ? $"{Model.PorcentajeCumplimientoHoras:0.#}%" : "-")</div><div class="pst-kpi-note">OK vs objetivo acumulado</div></div>
        <div class="pst-kpi"><div class="pst-kpi-label">Sospechoso</div><div class="pst-kpi-value">@Numero(Model.CantidadSospechosaTotal)</div><div class="pst-kpi-note">clasificación reportada</div></div>
        <div class="pst-kpi"><div class="pst-kpi-label">Scrap / rojo</div><div class="pst-kpi-value">@Numero(Model.CantidadScrapTotal)</div><div class="pst-kpi-note">clasificación reportada</div></div>
        <div class="pst-kpi"><div class="pst-kpi-label">Objetivo acumulado</div><div class="pst-kpi-value">@(Model.ObjetivoAcumuladoTotal > 0 ? Numero(Model.ObjetivoAcumuladoTotal) : "-")</div><div class="pst-kpi-note">según bloques capturados</div></div>
        <div class="pst-kpi"><div class="pst-kpi-label">Último contador</div><div class="pst-kpi-value">@(lectura != null ? lectura.ValorContador.ToString("N0") : "-")</div><div class="pst-kpi-note">@(lectura != null ? lectura.FechaLectura.ToString("dd/MM HH:mm") : "sin lectura")</div></div>
    </section>

    <div class="pst-grid">
        <section class="pst-card">
            <div class="pst-card-head">
                <div>
                    <div class="pst-card-title"><i class="bi bi-speedometer2"></i>Estado físico de la corrida</div>
                    <div class="pst-card-sub">Datos vigentes de máquina; no modifica configuración ni capturas.</div>
                </div>
                @if (Model.EsParejaLhRh)
                {
                    <span class="pst-state @(Model.ConfiguracionFisicaSincronizada ? "is-ok" : "is-bad")"><i class="bi bi-link-45deg"></i>@(Model.ConfiguracionFisicaSincronizada ? "LH/RH sincronizado" : "Revisar LH/RH")</span>
                }
            </div>
            <div class="pst-card-body">
                <div class="pst-physical-grid">
                    <div class="pst-physical"><small>Contador actual consultado</small><strong>@(lectura != null ? lectura.ValorContador.ToString("N0") : "Sin lectura")</strong></div>
                    <div class="pst-physical"><small>Ciclo vigente</small><strong>@(configuracionFisica != null ? $"{configuracionFisica.TiempoCicloSegundos:0.####} s" : "Sin configuración")</strong></div>
                    <div class="pst-physical"><small>Objetivo vigente</small><strong>@(configuracionFisica != null ? $"{configuracionFisica.ObjetivoHoraOperativo:N0} pza/h" : "-")</strong></div>
                    <div class="pst-physical"><small>Última captura operador</small><strong>@(ultima != null ? $"{ultima.NumeroOF} · {ultima.RangoHora}" : "Sin capturas")</strong></div>
                </div>
                @if (ultima != null)
                {
                    <div class="pst-mini-grid">
                        <div class="pst-mini"><label>Operador última captura</label><div>@(string.IsNullOrWhiteSpace(ultima.OperadorNombre) ? "Sin nombre" : ultima.OperadorNombre)</div></div>
                        <div class="pst-mini"><label>Resultado última captura</label><div>@ultima.CantidadOK.ToString("N0") OK · @ultima.CantidadScrap.ToString("N0") scrap · @(ultima.PorcentajeCumplimiento.HasValue ? $"{ultima.PorcentajeCumplimiento:0.#}%" : "sin objetivo")</div></div>
                    </div>
                }
            </div>
        </section>

        <section class="pst-card">
            <div class="pst-card-head"><div><div class="pst-card-title"><i class="bi bi-calendar3"></i>Programa vs ejecución</div><div class="pst-card-sub">Conserva diferencia entre lo planeado y lo realmente ejecutado.</div></div></div>
            <div class="pst-card-body">
                <div class="pst-mini-grid">
                    <div class="pst-mini"><label>Inicio planeado</label><div>@Fecha(Model.FechaInicioProgramada)</div></div>
                    <div class="pst-mini"><label>Inicio real</label><div>@Fecha(Model.FechaInicioReal)</div></div>
                    <div class="pst-mini"><label>Fin planeado</label><div>@Fecha(Model.FechaFinProgramada)</div></div>
                    <div class="pst-mini"><label>Fin real</label><div>@Fecha(Model.FechaFinReal)</div></div>
                </div>
            </div>
        </section>
    </div>

    <div class="pst-lados">
        @foreach (var lado in Model.Lados.OrderBy(x => x.ProgramaProduccionID))
        {
            var avance = Pct(lado.PorcentajeAvance);
            var calidadClase = EstadoCalidad(lado.Calidad);
            <article class="pst-lado">
                <div class="pst-lado-head">
                    <div>
                        <div class="pst-lado-of">
                            @lado.NumeroOF
                            @if (!string.IsNullOrWhiteSpace(lado.LadoLhRh))
                            {
                                <span class="pst-badge ms-1">@lado.LadoLhRh</span>
                            }
                        </div>
                        <div class="pst-lado-meta">Programa @lado.ProgramaProduccionID · @lado.ParteTexto</div>
                    </div>
                    <span class="pst-state @EstadoEjecucion(lado.EstatusID)">@lado.EstatusNombre</span>
                </div>
                <div class="pst-lado-body">
                    <div class="pst-progress-row"><span>Avance OK</span><strong>@lado.CantidadOK.ToString("N0") / @lado.CantidadPlaneada.ToString("N0") · @lado.PorcentajeAvance.ToString("0.#")%</strong></div>
                    <div class="pst-progress"><span style="width:@avance%"></span></div>

                    <div class="pst-mini-grid">
                        <div class="pst-mini"><label>Operador principal</label><div>@(string.IsNullOrWhiteSpace(lado.OperadorNombre) ? "Sin asignar" : lado.OperadorNombre)</div></div>
                        <div class="pst-mini"><label>Auxiliar</label><div>@(string.IsNullOrWhiteSpace(lado.OperadorAuxiliarNombre) ? "Sin asignar" : lado.OperadorAuxiliarNombre)</div></div>
                        <div class="pst-mini"><label>Inicio planeado / real</label><div>@Fecha(lado.FechaInicioProgramada)<br />@Fecha(lado.FechaInicioReal)</div></div>
                        <div class="pst-mini"><label>Capturas / objetivo</label><div>@lado.CapturasRegistradas.ToString("N0") captura(s) · @(lado.ObjetivoAcumulado > 0 ? $"{lado.ObjetivoAcumulado:N0} pza" : "-")</div></div>
                    </div>

                    <div class="pst-section-label">Configuración vigente</div>
                    @if (lado.Configuracion != null)
                    {
                        <div class="pst-config">
                            <div class="pst-config-grid">
                                <div class="pst-config-item"><small>Cavidades usadas</small><strong>@lado.Configuracion.CavidadesUsadas.ToString("N0")</strong></div>
                                <div class="pst-config-item"><small>Cavidades activas</small><strong>@lado.Configuracion.CavidadesTexto</strong></div>
                                <div class="pst-config-item"><small>Ciclo</small><strong>@lado.Configuracion.TiempoCicloSegundos.ToString("0.####") s</strong></div>
                                <div class="pst-config-item"><small>Objetivo teórico BD</small><strong>@(lado.ObjetivoHoraTeorico.HasValue ? $"{lado.ObjetivoHoraTeorico.Value:N0} pza/h" : "-")</strong></div>
                                <div class="pst-config-item"><small>Objetivo vigente real</small><strong>@lado.Configuracion.ObjetivoHoraOperativo.ToString("N0") pza/h</strong></div>
                                <div class="pst-config-item"><small>Contador base</small><strong>@(lado.Configuracion.ContadorInicioVigencia.HasValue? lado.Configuracion.ContadorInicioVigencia.Value.ToString("N0"):"-")</strong></div>
                                <div class="pst-config-item"><small>Vigente desde</small><strong>@lado.Configuracion.FechaInicioVigencia.ToString("dd/MM/yyyy HH:mm")</strong></div>
                            </div>
                            @if (!string.IsNullOrWhiteSpace(lado.Configuracion.TecnicoProduccionNombre) || !string.IsNullOrWhiteSpace(lado.Configuracion.MotivoCambio))
                            {
                                <div class="pst-mini-grid mt-2">
                                    <div class="pst-mini"><label>Técnico</label><div>@(string.IsNullOrWhiteSpace(lado.Configuracion.TecnicoProduccionNombre) ? "-" : lado.Configuracion.TecnicoProduccionNombre)</div></div>
                                    <div class="pst-mini"><label>Motivo / referencia</label><div>@(string.IsNullOrWhiteSpace(lado.Configuracion.MotivoCambio) ? (lado.Configuracion.EsConfiguracionInicial ? "Configuración inicial" : "-") : lado.Configuracion.MotivoCambio)</div></div>
                                </div>
                            }
                        </div>
                    }
                    else
                    {
                        <div class="pst-empty">No hay una configuración de corrida vigente para esta ejecución.</div>
                    }

                    <div class="pst-section-label">Calidad</div>
                    @if (lado.Calidad != null)
                    {
                        <div class="pst-quality @calidadClase">
                            <div class="pst-quality-head">
                                <div class="pst-quality-title"><i class="bi bi-shield-check me-1"></i>@lado.Calidad.EstadoTexto</div>
                                @if (!string.IsNullOrWhiteSpace(lado.Calidad.Etiqueta))
                                {
                                    <span class="pst-chip">Etiqueta @lado.Calidad.Etiqueta</span>
                                }
                            </div>
                            <div class="pst-quality-stats">
                                <span class="pst-chip">@lado.Calidad.MonitoreosConformes conforme(s)</span>
                                <span class="pst-chip">@lado.Calidad.MonitoreosPendientes pendiente(s)</span>
                                @if (lado.Calidad.MonitoreosVencidos > 0)
                                {
                                    <span class="pst-chip">@lado.Calidad.MonitoreosVencidos vencido(s)</span>
                                }
                                @if (lado.Calidad.MonitoreosConHallazgo > 0)
                                {
                                    <span class="pst-chip">@lado.Calidad.MonitoreosConHallazgo hallazgo(s)</span>
                                }
                                @if (lado.Calidad.DisposicionesPendientes > 0)
                                {
                                    <span class="pst-chip">@lado.Calidad.DisposicionesPendientes disposición(es)</span>
                                }
                            </div>
                            @if (lado.Calidad.ProximoMonitoreo.HasValue)
                            {
                                <div class="pst-card-sub mt-2">Próximo monitoreo: <strong>@lado.Calidad.ProximoMonitoreo.Value.ToString("dd/MM/yyyy HH:mm")</strong></div>
                            }
                            @if (!string.IsNullOrWhiteSpace(lado.Calidad.MotivoDevolucion))
                            {
                                <div class="pst-card-sub mt-2">@lado.Calidad.MotivoDevolucion</div>
                            }
                        </div>
                    }
                    else
                    {
                        <div class="pst-empty">No se encontró inspección de Calidad relacionada.</div>
                    }

                    @if (lado.ParoAbierto != null)
                    {
                        <div class="pst-paro-open">
                            <strong><i class="bi bi-pause-circle-fill me-1"></i>Paro abierto · @lado.ParoAbierto.DuracionTexto</strong>
                            <div>@(string.IsNullOrWhiteSpace(lado.ParoAbierto.MotivoParoTexto) ? "Sin motivo capturado" : lado.ParoAbierto.MotivoParoTexto)</div>
                            @if (!string.IsNullOrWhiteSpace(lado.ParoAbierto.Descripcion))
                            {
                                <div>@lado.ParoAbierto.Descripcion</div>
                            }
                        </div>
                    }
                </div>
            </article>
        }
    </div>

    <section class="pst-card mt-3">
        <div class="pst-card-head">
            <div><div class="pst-card-title"><i class="bi bi-clock-history"></i>Capturas hora por hora</div><div class="pst-card-sub">Información registrada por los operadores. Solo lectura para el seguimiento técnico.</div></div>
            <span class="pst-badge">@Model.CapturasRecientes.Count reciente(s)</span>
        </div>
        @if (Model.CapturasRecientes.Any())
        {
            <div class="pst-table-wrap">
                <table class="pst-table">
                    <thead><tr><th>OF / lado</th><th>Fecha</th><th>Hora</th><th>Operador</th><th class="pst-num">Físicas</th><th class="pst-num">OK</th><th class="pst-num">Sospechoso</th><th class="pst-num">Scrap</th><th class="pst-num">Objetivo</th><th class="pst-num">Cumplimiento</th><th>Eventos</th></tr></thead>
                    <tbody>
                        @foreach (var captura in Model.CapturasRecientes.OrderByDescending(x => x.FechaHoraFin).ThenByDescending(x => x.RegistroHoraID))
                        {
                            var objetivo = captura.ObjetivoBloque.GetValueOrDefault() > 0 ? captura.ObjetivoBloque : captura.ObjetivoHora;
                            <tr>
                                <td><strong>@captura.NumeroOF</strong>@if(!string.IsNullOrWhiteSpace(captura.LadoLhRh)){
                                <span class="pst-tag ms-1">@captura.LadoLhRh</span>
                            }
    </td>
                            <td>@captura.FechaProduccion.ToString("dd/MM/yyyy")</td>
                            <td>@captura.RangoHora</td>
                            <td>@(string.IsNullOrWhiteSpace(captura.OperadorNombre) ? "-" : captura.OperadorNombre)</td>
                            <td class="pst-num">@(captura.PiezasCalculadasContador.HasValue? captura.PiezasCalculadasContador.Value.ToString("N0"):captura.TotalClasificado.ToString("N0"))</td>
                            <td class="pst-num">@captura.CantidadOK.ToString("N0")</td>
                            <td class="pst-num">@captura.CantidadSospechosa.ToString("N0")</td>
                            <td class="pst-num">@captura.CantidadScrap.ToString("N0")</td>
                            <td class="pst-num">@(objetivo.HasValue && objetivo.Value > 0 ? objetivo.Value.ToString("N0") : "-")</td>
                            <td class="pst-num"><span class="pst-capture-result @EstadoCaptura(captura)">@(captura.PorcentajeCumplimiento.HasValue ? $"{captura.PorcentajeCumplimiento.Value:0.#}%" : "-")</span></td>
                            <td>
                                <div class="pst-tags">
                                    @if (captura.TieneCambioConfiguracion)
                                    {
                                        <span class="pst-tag is-blue">Cambio config.</span>
                                    }
                                    @if (captura.TieneReinicioContador)
                                    {
                                        <span class="pst-tag is-amber">Reinicio contador</span>
                                    }
                                    @if (captura.AjustadoPorCalidad)
                                    {
                                        <span class="pst-tag is-green">Ajustado Calidad</span>
                                    }
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
                }
                else
        {
            <div class="pst-empty"><i class="bi bi-hourglass me-1"></i>Todavía no existen capturas horarias del operador para mostrar.</div>
        }
    </section>

    <section class="pst-card mt-3">
        <div class="pst-card-head"><div><div class="pst-card-title"><i class="bi bi-pause-circle"></i>Paros recientes</div><div class="pst-card-sub">Incluye paros abiertos y cerrados relacionados con la ejecución.</div></div><span class="pst-badge">@Model.ParosRecientes.Count</span></div>
        <div class="pst-card-body">
            @if (Model.ParosRecientes.Any())
            {
                <div class="pst-paros">
                    @foreach (var paro in Model.ParosRecientes.OrderByDescending(x => x.FechaInicioParo).ThenByDescending(x => x.ParoID))
                    {
                        <div class="pst-paro">
                            <div class="pst-paro-icon"><i class="bi @(paro.EsInterrupcionUrgente ? "bi-lightning-charge-fill" : "bi-pause-fill")"></i></div>
                            <div>
                                <div class="pst-paro-title">@paro.NumeroOF@if(!string.IsNullOrWhiteSpace(paro.LadoLhRh)){
                                <span> · @paro.LadoLhRh</span>
                            }
     · @(string.IsNullOrWhiteSpace(paro.MotivoParoTexto) ? "Paro" : paro.MotivoParoTexto)</div>
                            <div class="pst-paro-desc">@(!string.IsNullOrWhiteSpace(paro.Descripcion) ? paro.Descripcion : (paro.EsInterrupcionUrgente ? "Interrupción urgente de Planeación" : "Sin descripción"))</div>
                        </div>
                        <div class="pst-paro-time"><strong>@paro.DuracionTexto</strong><br />@paro.FechaInicioParo.ToString("dd/MM HH:mm")<br /><span class="pst-state @(paro.EstaAbierto ? "is-bad" : "is-neutral")">@(paro.EstaAbierto ? "Abierto" : "Cerrado")</span></div>
                    </div>
                }
            </div>
                        }
                        else
            {
                <div class="pst-empty">No hay paros registrados para las ejecuciones mostradas.</div>
            }
        </div>
    </section>

    <div class="pst-footer-tools">
        <a href="@urlHistorial"
           class="pst-btn"
           data-nsq-operativa-accion
           data-accion-clave="@ProduccionOperativaAccionClave.Historial"
           data-solo-lectura="true">
            <i class="bi bi-journal-text"></i>Ver historial, checklists y pasos anteriores
        </a>
        <div class="pst-updated"><i class="bi bi-arrow-repeat me-1"></i>Actualizado @Model.FechaConsulta.ToString("dd/MM/yyyy HH:mm:ss") · refresco automático cada 20 s</div>
    </div>
</div>
