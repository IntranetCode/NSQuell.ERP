    html[data-nsq-theme="dark"] .ps-op {
        --ps-text: #eef2f7;
        --ps-muted: #9aacbf;
        --ps-line: rgba(255,255,255,.10);
        --ps-soft: #0e1929;
        --ps-navy: #f5f7fb
    }

        html[data-nsq-theme="dark"] .ps-op .ps-stat,
        html[data-nsq-theme="dark"] .ps-op .ps-card {
            background: #111d2f
        }

        html[data-nsq-theme="dark"] .ps-op .ps-card-head {
            background: #0e1929
        }

        html[data-nsq-theme="dark"] .ps-op .ps-line strong,
