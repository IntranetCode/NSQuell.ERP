        .ps-op .ps-components {
            display: grid;
            grid-template-columns: repeat(2,minmax(0,1fr));
            gap: 7px;
            margin-top: 8px
        }

        .ps-op .ps-component {
            padding: 8px;
            border-radius: 9px;
            background: #f8fafc;
            border: 1px solid var(--ps-line)
        }

        .ps-op .ps-component-head {
            display: flex;
            align-items: center;
            justify-content: space-between;
            gap: 6px;
            margin-bottom: 5px;
            font-size: .65rem;
