@model ERP.NSQuell.Models.ProduccionSecadoIndexVm
@using ERP.NSQuell.Models
@using System.Globalization
@using System.Linq

@functions {
    string Fecha(DateTime? value)
    {
        return value?.ToString("dd/MM/yyyy HH:mm") ?? "—";
    }

    string Cantidad(decimal value)
    {
        return $"{value:0.####} KG";
    }

    string Duracion(int minutos)
    {
        if (minutos <= 0) return "—";
        var h = minutos / 60;
        var m = minutos % 60;
        if (h <= 0) return $"{m} min";
        if (m <= 0) return $"{h} h";
        return $"{h} h {m} min";
    }
}

@{
    var programaId = ViewData["ProgramaProduccionID"] != null
        ? Convert.ToInt32(ViewData["ProgramaProduccionID"])
        : 0;

    var materiales = Model.Materiales ?? new List<ProduccionSecadoMaterialVm>();
    var tolvas = Model.Tolvas ?? new List<ProduccionSecadoTolvaVm>();

    var cargasActivas = materiales
        .SelectMany(m => m.Cargas.Select(c => new { Material = m, Carga = c }))
        .Where(x => x.Carga.EstaEnProceso)
        .GroupBy(x => x.Carga.SecadoCargaID)
        .Select(g => g.First())
        .OrderBy(x => x.Carga.FechaFinEsperada ?? DateTime.MaxValue)
        .ToList();

    var pendientes = materiales
        .Where(x => !x.EstaFinalizado && !x.EstaCancelado && !x.TieneCargaEnProceso && x.RequiereNuevaCarga)
        .GroupBy(x => x.GrupoLhRh.HasValue ? $"G:{x.GrupoLhRh.Value}" : $"M:{x.SecadoMaterialID}")
        .Select(g => g.OrderBy(x => x.LadoLhRh).ThenBy(x => x.SecadoMaterialID).ToList())
        .OrderByDescending(g => g.Any(x => x.DebeAlertarEspera))
        .ThenBy(g => g.Select(x => x.FechaInicioSecadoObjetivo ?? DateTime.MaxValue).Min())
        .ToList();

    var finalizados = materiales
        .Where(x => x.EstaFinalizado)
        .OrderByDescending(x => x.FechaUltimoFinSecado ?? DateTime.MinValue)
        .ToList();
}

<style>
