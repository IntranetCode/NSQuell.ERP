        }

            .ps-op .ps-badge.green {
                background: #edf9f3;
                color: #176b48
            }

            .ps-op .ps-badge.orange {
                background: #fff8ea;
                color: #8a5700
            }

            .ps-op .ps-badge.red {
                background: #fff1f1;
                color: #a52b2b
            }

        .ps-op .ps-body {
            padding: 11px 12px
        }

        .ps-op .ps-kpis {
            display: grid;
            grid-template-columns: repeat(3,minmax(0,1fr));
            gap: 6px;
            margin-bottom: 9px
        }

        .ps-op .ps-kpi {
            padding: 7px 8px;
            border-radius: 9px;
            background: var(--ps-soft);
            border: 1px solid #eef1f5
        }

            .ps-op .ps-kpi span {
                display: block;
                color: var(--ps-muted);
                font-size: .57rem;
                text-transform: uppercase;
                font-weight: 850
            }

            .ps-op .ps-kpi strong {
                display: block;
                margin-top: 2px;
                color: var(--ps-navy);
                font-size: .72rem;
                font-weight: 950
            }

        .ps-op .ps-line {
            display: flex;
            align-items: flex-start;
            justify-content: space-between;
            gap: 10px;
            padding: 5px 0;
            border-top: 1px solid #f0f2f5;
            font-size: .66rem;
            color: var(--ps-muted)
        }

            .ps-op .ps-line:first-child {
