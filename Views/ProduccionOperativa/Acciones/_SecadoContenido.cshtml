    @@media(max-width:900px) {
        .ps-op .ps-grid {
            grid-template-columns: 1fr
        }
    }

    @@media(max-width:650px) {
        .ps-op .ps-summary {
            grid-template-columns: 1fr 1fr
        }

        .ps-op .ps-form-grid, .ps-op .ps-components {
            grid-template-columns: 1fr
