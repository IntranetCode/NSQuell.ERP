@model ERP.NSQuell.Models.ProduccionSecadoIndexVm
@using ERP.NSQuell.Models
@using System.Globalization
@using System.Linq

@functions {
    string Fecha(DateTime? value)
    {
        return value?.ToString("dd/MM/yyyy HH:mm") ?? "—";
    }

    string Cantidad(decimal value)
    {
        return $"{value:0.####} KG";
    }

    private sealed class SecadoTolvaOpcion
    {
        public string Valor { get; set; } = string.Empty;
        public string Texto { get; set; } = string.Empty;
        public string MaquinaCodigo { get; set; } = string.Empty;
        public decimal CapacidadKg { get; set; }
        public bool NoSeleccionable { get; set; }
        public bool Seleccionada { get; set; }
    }

    private static List<SecadoTolvaOpcion> OpcionesTodasTolvas(
        IEnumerable<ProduccionSecadoTolvaVm> tolvas,
        IEnumerable<ProduccionPreparacionMaquinaVm> maquinas,
        string tipoProceso, decimal? cantidadCambio = null,
        int? tolvaActual = null, int? predeterminada = null)
    {
        var opciones = new List<SecadoTolvaOpcion>();
        var catalogo = tolvas.ToList();
        foreach (var tolva in catalogo)
        {
            var motivos = new List<string>();
            if (!tolva.Activo) motivos.Add("Inactiva");
            if (!tolva.DisponibleOperativamente) motivos.Add("No disponible operativamente");
            if (tolva.TolvaID == tolvaActual) motivos.Add("Tolva actual de esta carga");
            else if (tolva.EstaOcupada)
                motivos.Add(string.IsNullOrWhiteSpace(tolva.NumeroOFActiva) ? "Ocupada" : "Ocupada por " + tolva.NumeroOFActiva);
            if (!string.Equals(tolva.TipoProcesoPermitido, "AMBOS", StringComparison.OrdinalIgnoreCase) &&
                !string.Equals(tolva.TipoProcesoPermitido, tipoProceso, StringComparison.OrdinalIgnoreCase))
                motivos.Add("No compatible con " + tipoProceso);
            if (tolva.CapacidadKg <= 0) motivos.Add("Capacidad no registrada");
            opciones.Add(new SecadoTolvaOpcion
            {
                Valor = tolva.TolvaID.ToString(CultureInfo.InvariantCulture),
                Texto = tolva.Texto + " · " + (motivos.Count == 0 ? "Disponible" : string.Join("; ", motivos))
                    + (motivos.Count == 0 && cantidadCambio.HasValue && cantidadCambio.Value > tolva.CapacidadKg ? " · Traslado por parcialidades" : ""),
                MaquinaCodigo = tolva.MaquinaCodigo,
                CapacidadKg = tolva.CapacidadKg,
                NoSeleccionable = motivos.Count > 0,
                Seleccionada = motivos.Count == 0 && tolva.TolvaID == predeterminada
            });
        }
        var maquinasConTolva = catalogo.Select(t => t.MaquinaID).ToHashSet();
        foreach (var maquina in maquinas.Where(m => !maquinasConTolva.Contains(m.MaquinaID)))
        {
            opciones.Add(new SecadoTolvaOpcion
            {
                Texto = maquina.Codigo + (string.IsNullOrWhiteSpace(maquina.Nombre) ? "" : " - " + maquina.Nombre) + " · Configurar capacidad y proceso para usar",
                MaquinaCodigo = maquina.Codigo,
                NoSeleccionable = true
            });
        }
        return opciones.OrderBy(x => x.NoSeleccionable)
            .ThenBy(x => x.MaquinaCodigo, StringComparer.OrdinalIgnoreCase)
            .ThenBy(x => x.Texto, StringComparer.OrdinalIgnoreCase).ToList();
    }

    string Duracion(int minutos)
    {
        if (minutos <= 0) return "—";
        var h = minutos / 60;
        var m = minutos % 60;
        if (h <= 0) return $"{m} min";
        if (m <= 0) return $"{h} h";
        return $"{h} h {m} min";
    }
}

@{
    var programaId = ViewData["ProgramaProduccionID"] != null
        ? Convert.ToInt32(ViewData["ProgramaProduccionID"])
        : 0;

    var materiales = Model.Materiales ?? new List<ProduccionSecadoMaterialVm>();
    var tolvas = Model.Tolvas ?? new List<ProduccionSecadoTolvaVm>();
    var maquinas = ViewData["EquiposSecadoSinConfig"] as List<ProduccionPreparacionMaquinaVm>
        ?? new List<ProduccionPreparacionMaquinaVm>();

    var cargasActivas = materiales
        .SelectMany(m => m.Cargas.Select(c => new { Material = m, Carga = c }))
        .Where(x => x.Carga.EstaEnProceso)
        .GroupBy(x => x.Carga.SecadoCargaID)
        .Select(g => g.First())
        .OrderBy(x => x.Carga.FechaFinEsperada ?? DateTime.MaxValue)
        .ToList();

    var pendientes = materiales
        .Where(x => !x.EstaFinalizado && !x.EstaCancelado && x.RequiereNuevaCarga)
        .GroupBy(x => x.GrupoLhRh.HasValue ? $"G:{x.GrupoLhRh.Value}" : $"M:{x.SecadoMaterialID}")
        .Select(g => g.OrderBy(x => x.LadoLhRh).ThenBy(x => x.SecadoMaterialID).ToList())
        .OrderByDescending(g => g.Any(x => x.DebeAlertarEspera))
        .ThenBy(g => g.Select(x => x.FechaInicioSecadoObjetivo ?? DateTime.MaxValue).Min())
        .ToList();

    var finalizados = materiales
        .Where(x => x.EstaFinalizado)
        .OrderByDescending(x => x.FechaUltimoFinSecado ?? DateTime.MinValue)
        .ToList();
}

