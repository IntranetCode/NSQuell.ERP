        .ps-op .ps-actions {
            display: flex;
            justify-content: flex-end;
            gap: 7px;
            flex-wrap: wrap;
            margin-top: 9px
        }

        .ps-op .ps-btn {
            border: 0;
            border-radius: 8px;
            padding: 8px 10px;
            background: var(--ps-blue);
            color: #fff;
            font-size: .67rem;
            font-weight: 900
        }

            .ps-op .ps-btn.warn {
                background: #b66900
            }

            .ps-op .ps-btn.danger {
                background: #b42318
            }

            .ps-op .ps-btn:disabled {
                opacity: .55
            }

        .ps-op details {
            margin-top: 8px
        }

            .ps-op details summary {
                cursor: pointer;
                color: #475467;
                font-size: .63rem;
                font-weight: 900
            }

        .ps-op .ps-message {
            padding: 10px 11px;
            border: 1px dashed #cfd7e3;
            border-radius: 10px;
            background: #fbfcfe;
            color: #667085;
            font-size: .68rem;
            line-height: 1.4
        }

            .ps-op .ps-message strong {
                color: #344054
            }

            .ps-op .ps-message.warn {
                background: #fff8ea;
                border-color: #efd29d;
                color: #865600
            }

            .ps-op .ps-message.danger {
                background: #fff1f1;
                border-color: #efb8b8;
                color: #a52b2b
            }

        .ps-op .ps-timer {
            margin-top: 7px;
            padding: 7px 8px;
            border-radius: 8px;
            background: #eef4fc;
            color: #245484;
            font-size: .67rem;
            font-weight: 900
        }

        .ps-op .ps-history {
            display: grid;
            gap: 5px;
            margin-top: 7px
        }

        .ps-op .ps-history-item {
            display: flex;
            justify-content: space-between;
            gap: 8px;
            padding: 6px 7px;
            border: 1px solid var(--ps-line);
