<div id="@rootId"
     data-cajas-contenido
     data-cajas-auto-refrescar="@(Model.RequiereAutoRefresco ? "true" : "false")">
    <div class="pcj-head">
        <div>
            <h3><i class="bi bi-boxes me-1"></i>Cajas de Produccion</h3>
            <p>Formacion, trazabilidad, producto incompleto, envio a Calidad, zona verde y salida hacia Almacen PT desde el mismo Centro Operativo.</p>
        </div>
        <div class="pcj-head-actions">
            @if (Model.EsLhRh)
            {
                <span class="pcj-chip"><i class="bi bi-link-45deg"></i>LH/RH · grupo @Model.GrupoLhRh</span>
            }
            @if (Model.PendientesCalidad > 0)
            {
                <span class="pcj-chip warn"><i class="bi bi-hourglass-split"></i>@Model.PendientesCalidad esperando Calidad</span>
            }
            @if (Model.PendientesAlmacen > 0)
            {
                <span class="pcj-chip"><i class="bi bi-truck"></i>@Model.PendientesAlmacen esperando Almacen</span>
            }
            <button type="button" class="pcj-btn outline" data-cajas-refrescar><i class="bi bi-arrow-clockwise"></i>Actualizar</button>
        </div>
    </div>

    <div class="pcj-summary">
        <div class="pcj-stat"><span>Cajas</span><strong>@Model.TotalCajas</strong></div>
        <div class="pcj-stat"><span>Esperando Calidad</span><strong>@Model.PendientesCalidad</strong></div>
        <div class="pcj-stat"><span>Retenidas</span><strong>@Model.RetenidasCalidadGp12</strong></div>
        <div class="pcj-stat"><span>Zona verde</span><strong>@Model.EnZonaVerde</strong></div>
        <div class="pcj-stat"><span>Salida / Almacen</span><strong>@Model.PendientesAlmacen</strong></div>
        <div class="pcj-stat"><span>Producto incompleto</span><strong>@Model.ProductoIncompleto</strong></div>
    </div>

    @if (Model.SoloLectura || !Model.UsuarioEsOperador)
    {
        <div class="pcj-alert read"><i class="bi bi-eye me-1"></i>Modo consulta. Puedes revisar cajas, estados de Calidad, producto incompleto y trazabilidad, pero las acciones operativas corresponden al operador/auxiliar autorizado.</div>
    }
    <div class="pcj-message" data-pcj-message></div>

    @foreach (var lado in lados)
    {
        var vm = lado.Vm;
        var puedeCapturar = Model.PuedeGestionar && vm.EstatusID == ProduccionEstatus.EnProduccion && !vm.TieneParoAbierto && !vm.MaquinaLiberada;
        var cajas = vm.Cajas.OrderByDescending(x => x.CajaProduccionID).ToList();
        var propiasIncompletas = cajas.Where(x => x.EsCajaIncompleta).ToList();
        var asignadas = vm.CajasIncompletasDisponibles ?? new List<ProduccionCajaIncompletaDisponibleVm>();
        <section class="pcj-side" data-pcj-side="@vm.EjecucionProduccionID">
            <div class="pcj-side-head">
                <div class="pcj-side-title">
                    <div class="pcj-side-icon"><i class="bi bi-box-seam"></i></div>
                    <div>
                        <strong>@vm.TextoOF @(!string.IsNullOrWhiteSpace(lado.Lado) ? $"· {lado.Lado}" : string.Empty)</strong>
                        <small>@vm.TextoParte · @vm.TextoMaquina · Programa @vm.ProgramaProduccionID</small>
                    </div>
                </div>
                <div class="pcj-side-badges">
                    <span class="pcj-chip">@vm.EstatusNombre</span>
                    @if (vm.TieneParoAbierto)
                    {
                        <span class="pcj-chip red"><i class="bi bi-pause-circle"></i>Paro abierto</span>
                    }
                    @if (vm.MaquinaLiberada)
                    {
                        <span class="pcj-chip green"><i class="bi bi-unlock"></i>Maquina liberada</span>
                    }
                </div>
            </div>
            <div class="pcj-body">
                <div class="pcj-kpis">
                    <div class="pcj-kpi"><b>@vm.CantidadOKDisponible.ToString("N0")</b><span>OK disponible</span></div>
                    <div class="pcj-kpi"><b>@vm.CantidadSospechosaDisponible.ToString("N0")</b><span>Sospechoso disponible</span></div>
                    <div class="pcj-kpi"><b>@vm.CantidadScrapDisponible.ToString("N0")</b><span>Scrap disponible</span></div>
                    <div class="pcj-kpi"><b>@vm.PiezasPorCajaSugeridas.ToString("N0")</b><span>Capacidad por caja</span></div>
                    <div class="pcj-kpi"><b>@vm.Cajas.Count.ToString("N0")</b><span>Cajas reales</span></div>
                </div>

                @if (Model.PuedeGestionar && !puedeCapturar)
                {
                    var motivo = vm.MaquinaLiberada ? "La maquina ya fue liberada." : vm.TieneParoAbierto ? "Existe un paro abierto." : "La ejecucion no se encuentra en Produccion activa.";
                    <div class="pcj-alert"><i class="bi bi-exclamation-triangle me-1"></i>@motivo No se habilita formacion/escaneo de nuevas cajas.</div>
                }

                @if (puedeCapturar)
                {
                    <div class="pcj-actions">
                        <div class="pcj-panel">
                            <h4><i class="bi bi-upc-scan"></i>Escanear etiqueta fisica</h4>
                            <form action="@urlEscanear" method="post" data-pcj-form data-reset="true">
                                @Html.AntiForgeryToken()
                                <input type="hidden" name="EjecucionProduccionID" value="@vm.EjecucionProduccionID" />
                                <div class="pcj-form-row">
                                    <div>
                                        <label>Codigo de barras</label>
                                        <input class="form-control" name="CodigoBarras" autocomplete="off" placeholder="Escanea la etiqueta de la caja" required />
                                    </div>
                                    <button class="pcj-btn primary" type="submit"><i class="bi bi-upc-scan"></i>Registrar</button>
                                </div>
                            </form>
                        </div>
                        <div class="pcj-panel">
                            <h4><i class="bi bi-box-seam"></i>Formar caja manual</h4>
                            <form action="@urlFormar" method="post" data-pcj-form data-confirm="¿Registrar esta caja con las cantidades capturadas?" data-reset="true">
                                @Html.AntiForgeryToken()
                                <input type="hidden" name="ejecucionProduccionId" value="@vm.EjecucionProduccionID" />
                                <div class="pcj-form-grid">
                                    <div>
                                        <label>Tipo</label>
                                        <select class="form-select" name="tipoCaja" required>
                                            <option value="OK">OK</option>
                                            <option value="SOSPECHOSO">Sospechoso</option>
                                            <option value="SCRAP">Scrap</option>
                                            <option value="RETENCION">Retencion</option>
                                            <option value="INCOMPLETA">Producto incompleto</option>
                                        </select>
                                    </div>
                                    <div>
                                        <label>Piezas</label>
                                        <input class="form-control" type="number" min="1" name="cantidadPiezas" value="@(vm.CantidadSugeridaSiguienteCaja > 0 ? vm.CantidadSugeridaSiguienteCaja : 1)" required />
                                    </div>
                                </div>
                                <div class="mt-2">
                                    <label>Observaciones</label>
                                    <input class="form-control" name="observaciones" maxlength="500" placeholder="Opcional" />
                                </div>
                                <div class="mt-2 d-flex justify-content-end"><button class="pcj-btn green" type="submit"><i class="bi bi-plus-circle"></i>Formar caja</button></div>
                            </form>
                        </div>
                    </div>
                }

                <div class="pcj-section-title">
                    <h4><i class="bi bi-list-check me-1"></i>Cajas registradas</h4>
                    <span class="pcj-chip">@cajas.Count registro(s)</span>
                </div>

                @if (cajas.Count == 0)
                {
                    <div class="pcj-empty">Todavia no existen cajas registradas para esta OF.</div>
                }
                else
                {
                    <div class="pcj-boxes">
                        @foreach (var caja in cajas)
                        {
                            var estatusCalidad = Model.ObtenerEstatusCalidad(caja.CajaProduccionID);
                            var devuelta = Model.CajaDevuelta(caja);
                            var corregida = Model.CajaCorregida(caja);
                            var etiqueta = !string.IsNullOrWhiteSpace(caja.EtiquetaFolio) ? caja.EtiquetaFolio : !string.IsNullOrWhiteSpace(caja.EtiquetaBlanca) ? caja.EtiquetaBlanca : caja.FolioCaja;
                            var estadoClase = caja.EstaPendienteCalidad || caja.EstaRetenida ? "quality" : caja.RecibidaAlmacen || caja.EstaLiberadaCalidad || caja.EstaEnZonaVerde || caja.TieneSalidaProduccion ? "good" : devuelta ? "bad" : "blue";
                            <article class="pcj-box">
                                <div class="pcj-box-main">
                                    <strong>@(caja.EsCajaIncompleta ? "Etiqueta blanca" : $"Caja {caja.NumeroCaja:N0}") · @caja.CantidadPiezas.ToString("N0") pza</strong>
                                    <span>@(etiqueta ?? "Sin etiqueta") · @caja.TipoCaja</span>
                                </div>
                                <div>
                                    @if (caja.EstaPendienteCalidad)
                                    {
                                        <span class="pcj-state quality"><i class="bi bi-hourglass-split"></i>Esperando a Calidad</span>
                                    }
                                    else if (caja.EstaRetenida)
                                    {
                                        <span class="pcj-state quality"><i class="bi bi-shield-exclamation"></i>Esperando Calidad / GP12</span>
                                    }
                                    else if (devuelta)
                                    {
                                        <span class="pcj-state bad"><i class="bi bi-arrow-counterclockwise"></i>Devuelta por Calidad</span>
                                    }
                                    else if (corregida)
                                    {
                                        <span class="pcj-state blue"><i class="bi bi-tools"></i>Corregida · lista para reenvio</span>
                                    }
                                    else
                                    {
                                        <span class="pcj-state @estadoClase">@caja.EstadoCajaNombre</span>
                                    }
                                    @if (!string.IsNullOrWhiteSpace(caja.ResultadoCalidad))
                                    {
                                        <div class="pcj-box-info"><span>Resultado: @caja.ResultadoCalidad</span></div>
                                    }
                                </div>
                                <div class="pcj-box-info">
                                    <span>Formada: @caja.FechaFormacion.ToString("dd/MM HH:mm")</span>
                                    @if (caja.FechaLiberacionCalidad.HasValue)
                                    {
                                        <span>Calidad: @caja.FechaLiberacionCalidad.Value.ToString("dd/MM HH:mm")</span>
                                    }
                                    @if (caja.FechaSalidaProduccion.HasValue)
                                    {
                                        <span>Salida Produccion: @caja.FechaSalidaProduccion.Value.ToString("dd/MM HH:mm")</span>
                                    }
                                    @if (caja.FechaRecepcionAlmacen.HasValue)
                                    {
                                        <span>Almacen PT: @caja.FechaRecepcionAlmacen.Value.ToString("dd/MM HH:mm")</span>
                                    }
                                    @if (!string.IsNullOrWhiteSpace(caja.MotivoCalidad))
                                    {
                                        <span>Calidad: @caja.MotivoCalidad</span>
                                    }
                                </div>
                                <div class="pcj-box-actions">
                                    @if (Model.PuedeGestionar)
                                    {
                                        @if (devuelta && caja.EstaFormada)
                                        {
                                            <form action="@urlCorregir" method="post" data-pcj-form data-confirm="¿Registrar la correccion realizada en Produccion?" class="pcj-inline-form">
                                                @Html.AntiForgeryToken()
                                                <input type="hidden" name="cajaProduccionId" value="@caja.CajaProduccionID" />
                                                <input class="form-control" name="correccionRealizada" maxlength="500" placeholder="Correccion realizada" required />
                                                <button class="pcj-btn orange" type="submit"><i class="bi bi-tools"></i>Registrar correccion</button>
                                            </form>
                                        }
                                        else if (caja.PuedeSolicitarCalidad && !caja.EsCajaIncompleta && !caja.EstaPendienteCalidad && !caja.EstaRetenida && (string.IsNullOrWhiteSpace(estatusCalidad) || string.Equals(estatusCalidad, "FORMADA", StringComparison.OrdinalIgnoreCase) || corregida))
                                        {
                                            <form action="@urlSolicitar" method="post" data-pcj-form data-confirm="¿Enviar esta caja a Calidad para revision?">
                                                @Html.AntiForgeryToken()
                                                <input type="hidden" name="cajaProduccionId" value="@caja.CajaProduccionID" />
                                                <button class="pcj-btn orange" type="submit"><i class="bi bi-send"></i>@(corregida ? "Reenviar a Calidad" : "Enviar a Calidad")</button>
                                            </form>
                                        }
                                        @if (caja.PuedeMoverZonaVerde)
                                        {
                                            <form action="@urlZona" method="post" data-pcj-form data-confirm="¿Mover esta caja liberada a zona verde?">
                                                @Html.AntiForgeryToken()
                                                <input type="hidden" name="cajaProduccionId" value="@caja.CajaProduccionID" />
                                                <button class="pcj-btn green" type="submit"><i class="bi bi-arrow-right-circle"></i>Zona verde</button>
                                            </form>
                                        }
                                        @if (caja.PuedeEscanearSalidaProduccion)
                                        {
                                            <form action="@urlSalida" method="post" data-pcj-form class="pcj-inline-form">
                                                @Html.AntiForgeryToken()
                                                <input type="hidden" name="cajaProduccionId" value="@caja.CajaProduccionID" />
                                                <input class="form-control" name="etiquetaEscaneada" autocomplete="off" placeholder="Escanea etiqueta" value="@(caja.TieneEtiquetaFisica ? string.Empty : caja.EtiquetaFolio)" />
                                                <button class="pcj-btn primary" type="submit"><i class="bi bi-box-arrow-right"></i>Salida Produccion</button>
                                            </form>
                                        }
                                    }
                                    @if (caja.EstaPendienteCalidad)
                                    {
                                        <span class="pcj-state quality"><i class="bi bi-shield-check"></i>Sin acciones de Calidad aqui</span>
                                    }
                                    else if (caja.TieneSalidaProduccion)
                                    {
                                        <span class="pcj-state blue"><i class="bi bi-hourglass"></i>Esperando Almacen PT</span>
                                    }
                                    else if (caja.RecibidaAlmacen)
                                    {
                                        <span class="pcj-state good"><i class="bi bi-check-circle"></i>Recibida por Almacen PT</span>
                                    }
                                </div>
                            </article>
                        }
                    </div>
                }

                <div class="pcj-incomplete">
                    <div class="pcj-section-title">
                        <h4><i class="bi bi-box2-heart me-1"></i>Producto incompleto</h4>
                        <span class="pcj-chip">Planeacion define que etiqueta puede usar esta OF</span>
                    </div>
                    <div class="pcj-alert info"><i class="bi bi-info-circle me-1"></i>Produccion no puede tomar producto incompleto libre. Aqui solo aparecen etiquetas que Planeacion ya asigno a esta OF, ademas de las etiquetas blancas originadas por sobreproduccion de esta misma ejecucion.</div>

                    @if (propiasIncompletas.Count == 0 && asignadas.Count == 0)
                    {
                        <div class="pcj-empty">No existe producto incompleto relacionado o asignado a esta OF.</div>
                    }
                    @foreach (var incompleta in propiasIncompletas)
                    {
                        var porcentaje = Math.Clamp(incompleta.PorcentajeLlenadoIncompleto, 0m, 100m);
                        <div class="pcj-incomplete-card">
                            <div>
                                <strong>@(incompleta.EtiquetaBlanca ?? incompleta.EtiquetaFolio ?? incompleta.FolioCaja ?? $"Caja {incompleta.CajaProduccionID}")</strong>
                                <div class="text-muted small">@incompleta.CantidadPiezas.ToString("N0") / @(incompleta.CapacidadObjetivoCaja?.ToString("N0") ?? "-") pza · @incompleta.EstadoProductoIncompletoTexto</div>
                                <div class="pcj-progress"><span style="width:@porcentaje.ToString("0.##", System.Globalization.CultureInfo.InvariantCulture)%"></span></div>
                            </div>
                            <div><span class="pcj-state">Faltan @incompleta.PiezasFaltantesIncompleto.ToString("N0") pza</span></div>
                            <div></div>
                        </div>
                    }
                    @foreach (var asignada in asignadas)
                    {
                        var porcentaje = Math.Clamp(asignada.PorcentajeLlenado, 0m, 100m);
                        <div class="pcj-incomplete-card">
                            <div>
                                <strong>@(asignada.EtiquetaBlanca ?? asignada.FolioCaja ?? $"Caja {asignada.CajaProduccionID}")</strong>
                                <div class="text-muted small">Origen: @asignada.TextoOFOrigen · @asignada.TextoCantidad · @asignada.TextoEstado</div>
                                <div class="pcj-progress"><span style="width:@porcentaje.ToString("0.##", System.Globalization.CultureInfo.InvariantCulture)%"></span></div>
                            </div>
                            <div>
                                <span class="pcj-state blue">Faltan @asignada.CantidadPendienteCompletar.ToString("N0") pza</span>
                                <div class="text-muted small mt-1">@asignada.TextoUbicacion</div>
                            </div>
                            <div class="pcj-box-actions">
                                @if (Model.PuedeGestionar)
                                {
                                    <form action="@urlReservar" method="post" data-pcj-form data-confirm="¿Confirmar esta etiqueta asignada por Planeacion para la OF actual?">
                                        @Html.AntiForgeryToken()
                                        <input type="hidden" name="CajaProduccionID" value="@asignada.CajaProduccionID" />
                                        <input type="hidden" name="EjecucionProduccionID" value="@vm.EjecucionProduccionID" />
                                        <button class="pcj-btn outline" type="submit"><i class="bi bi-link-45deg"></i>Confirmar asignacion</button>
                                    </form>
                                    @if (puedeCapturar)
                                    {
                                        <form action="@urlCompletar" method="post" data-pcj-form data-confirm="¿Aplicar estas piezas para completar la etiqueta blanca?" class="pcj-inline-form">
                                            @Html.AntiForgeryToken()
                                            <input type="hidden" name="CajaProduccionID" value="@asignada.CajaProduccionID" />
                                            <input type="hidden" name="EjecucionProduccionID" value="@vm.EjecucionProduccionID" />
                                            <input class="form-control" type="number" min="1" max="@asignada.CantidadPendienteCompletar" name="CantidadPiezas" value="@Math.Max(1, asignada.CantidadPendienteCompletar)" required />
                                            <input class="form-control" name="Observaciones" maxlength="500" placeholder="Observaciones" />
                                            <button class="pcj-btn purple" type="submit"><i class="bi bi-box2-heart"></i>Completar</button>
                                        </form>
                                    }
                                }
                            </div>
                        </div>
                    }
                </div>
            </div>
        </section>
    }
</div>

<script>
    (() => {
        'use strict';
        const root=document.getElementById('@rootId');
        if(!root||root.dataset.inicializado==='1') return;
        root.dataset.inicializado='1';

        const mensaje=root.querySelector('[data-pcj-message]');
        let enviando=false;

        function mostrar(texto,tipo){
            if(!mensaje) return;
            mensaje.textContent=texto||'';
            mensaje.className=`pcj-message show ${tipo==='error'?'error':'ok'}`;
            mensaje.scrollIntoView({block:'nearest',behavior:'smooth'});
        }

        async function leerRespuesta(response){
            const tipo=(response.headers.get('content-type')||'').toLowerCase();
            if(tipo.includes('application/json')) return await response.json();
            const texto=await response.text();
            if(response.ok) return {ok:true,mensaje:texto||'Operacion completada.'};
            const doc=new DOMParser().parseFromString(texto,'text/html');
            return {ok:false,mensaje:doc.body?.innerText?.trim()?.slice(0,700)||texto.slice(0,700)||`HTTP ${response.status}`};
        }

        root.addEventListener('submit',async event=>{
            const form=event.target.closest?.('[data-pcj-form]');
            if(!form) return;
            event.preventDefault();
            if(enviando) return;
            const confirmar=form.dataset.confirm;
            if(confirmar&&!window.confirm(confirmar)) return;

            enviando=true;
            const boton=form.querySelector('button[type="submit"]');
            const htmlOriginal=boton?.innerHTML;
            if(boton){
                boton.disabled=true;
                boton.innerHTML='<span class="spinner-border spinner-border-sm" aria-hidden="true"></span> Procesando';
            }
            try{
                const response=await fetch(form.action,{
                    method:(form.method||'POST').toUpperCase(),
                    body:new FormData(form),
                    cache:'no-store',
                    credentials:'same-origin',
                    headers:{'X-Requested-With':'XMLHttpRequest'}
                });
                const data=await leerRespuesta(response);
                if(!response.ok||data?.ok===false) throw new Error(data?.mensaje||`HTTP ${response.status}`);
                mostrar(data?.mensaje||'Operacion completada.','ok');
                if(form.dataset.reset==='true') form.reset();
                window.setTimeout(()=>root.dispatchEvent(new CustomEvent('nsq:cajas-actualizadas',{bubbles:true})),350);
            }catch(error){
                mostrar(error?.message||'No fue posible completar la operacion.','error');
            }finally{
                enviando=false;
                if(boton){
                    boton.disabled=false;
                    boton.innerHTML=htmlOriginal||'Guardar';
                }
            }
        });

        root.querySelectorAll('input[name="CodigoBarras"],input[name="etiquetaEscaneada"]').forEach(input=>{
            input.addEventListener('keydown',event=>{
                if(event.key!=='Enter') return;
                event.preventDefault();
                input.form?.requestSubmit();
            });
        });
    })();
</script>
