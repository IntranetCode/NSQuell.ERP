@using System
@using System.Collections.Generic
@using System.Linq
@using ERP.NSQuell.Models
@model ERP.NSQuell.Models.ProduccionCajasOperativasVm

@{
    var rootId = $"pcjContenido_{Model.Actual.ProgramaProduccionID}_{Model.Actual.EjecucionProduccionID}";
    var urlFormar = Url.Action("FormarCajaOperativa", "ProduccionOperador") ?? "/ProduccionOperador/FormarCajaOperativa";
    var urlEscanear = Url.Action("EscanearCajaOperativa", "ProduccionOperador") ?? "/ProduccionOperador/EscanearCajaOperativa";
    var urlCorregir = Url.Action("CorregirCajaDevueltaOperativa", "ProduccionOperador") ?? "/ProduccionOperador/CorregirCajaDevueltaOperativa";
    var urlSolicitar = Url.Action("SolicitarLiberacionCajaOperativa", "ProduccionOperador") ?? "/ProduccionOperador/SolicitarLiberacionCajaOperativa";
    var urlZona = Url.Action("MoverCajaZonaVerdeOperativa", "ProduccionOperador") ?? "/ProduccionOperador/MoverCajaZonaVerdeOperativa";
    var urlSalida = Url.Action("EscanearSalidaCajaOperativa", "ProduccionOperador") ?? "/ProduccionOperador/EscanearSalidaCajaOperativa";
    var urlReservar = Url.Action("ReservarCajaIncompletaOperativa", "ProduccionOperador") ?? "/ProduccionOperador/ReservarCajaIncompletaOperativa";
    var urlCompletar = Url.Action("CompletarCajaIncompletaOperativa", "ProduccionOperador") ?? "/ProduccionOperador/CompletarCajaIncompletaOperativa";

    var lados = new List<(ProduccionOperadorCajasVm Vm, string Lado)> { (Model.Actual, Model.LadoActual ?? string.Empty) };
    if (Model.Pareja != null) lados.Add((Model.Pareja, Model.LadoPareja ?? string.Empty));
}

