@model ERP.NSQuell.Models.ProduccionCentroOperativoVm
@using ERP.NSQuell.Models

@{
    var tipo = (Convert.ToString(ViewData["TipoInsumoOperativo"]) ?? "MP").Trim().ToUpperInvariant();
    var esMp = tipo == ProduccionRecepcionMaterialTipo.MP;
    var soloLectura = ViewData["SoloLectura"] is bool sr ? sr : Model.Permisos.SoloLectura;
    var rootId = $"poInsumo_{tipo}_{Model.ProgramaProduccionID}";
    var titulo = esMp ? "Recepción de materia prima" : "Recepción de embalaje";
    var icono = esMp ? "bi-box-arrow-in-down" : "bi-box2-heart";
}

<style>
    .po-insumo {
        --pi: #004aad;
        --pi-text: #182230;
        --pi-muted: #667085;
        --pi-border: #e4e7ec;
        --pi-soft: #f8fafc;
        --pi-ok: #128254;
        --pi-warn: #b66900;
        --pi-bad: #c93636;
        color: var(--pi-text)
    }

        .po-insumo * {
            box-sizing: border-box
        }

        .po-insumo .pi-card {
            border: 1px solid var(--pi-border);
            border-radius: 14px;
            background: #fff;
            overflow: hidden
        }

        .po-insumo .pi-head {
            display: flex;
            justify-content: space-between;
            align-items: flex-start;
            gap: 12px;
            padding: 13px 14px;
            border-bottom: 1px solid var(--pi-border);
            background: #fbfcfe
        }

            .po-insumo .pi-head strong {
                display: block;
                color: #102a56;
                font-size: .9rem
            }

            .po-insumo .pi-head small {
                display: block;
                margin-top: 2px;
                color: var(--pi-muted);
                font-size: .68rem
            }

        .po-insumo .pi-body {
            padding: 14px
        }

        .po-insumo .pi-summary {
            display: grid;
            grid-template-columns: repeat(5,minmax(0,1fr));
            gap: 8px
        }

        .po-insumo .pi-kpi {
            padding: 9px 10px;
            border: 1px solid var(--pi-border);
            border-radius: 10px;
            background: var(--pi-soft)
        }

            .po-insumo .pi-kpi span {
                display: block;
                color: var(--pi-muted);
                font-size: .58rem;
                font-weight: 850;
                text-transform: uppercase
            }

            .po-insumo .pi-kpi strong {
                display: block;
                margin-top: 2px;
                color: #102a56;
                font-size: .94rem;
                font-weight: 950
            }

        .po-insumo .pi-status {
            display: none;
            margin: 10px 0;
            padding: 9px 10px;
            border-radius: 9px;
            font-size: .7rem;
            font-weight: 750
        }

            .po-insumo .pi-status.show {
                display: block
            }

            .po-insumo .pi-status.ok {
                background: #edf9f3;
                border: 1px solid #bee2cf;
                color: #176b48
            }

            .po-insumo .pi-status.warn {
                background: #fff8ea;
                border: 1px solid #f0d39d;
                color: #8a5700
            }

            .po-insumo .pi-status.bad {
                background: #fff1f1;
                border: 1px solid #efb8b8;
                color: #a52b2b
            }

            .po-insumo .pi-status.info {
                background: #edf5ff;
                border: 1px solid #bdd6fa;
                color: #174f91
            }

        .po-insumo .pi-list {
            display: grid;
            gap: 9px;
            margin-top: 11px
        }

        .po-insumo .pi-item {
            border: 1px solid var(--pi-border);
            border-radius: 12px;
            padding: 11px;
            background: #fff
        }

            .po-insumo .pi-item.is-pending {
                border-left: 4px solid var(--pi)
            }

            .po-insumo .pi-item.is-ok {
                border-left: 4px solid var(--pi-ok)
            }

            .po-insumo .pi-item.is-diff {
                border-left: 4px solid var(--pi-warn)
            }

        .po-insumo .pi-item-top {
            display: flex;
            justify-content: space-between;
            align-items: flex-start;
            gap: 10px
        }

        .po-insumo .pi-name {
            color: #102a56;
            font-size: .78rem;
            font-weight: 900
        }

        .po-insumo .pi-meta {
            display: flex;
            gap: 6px 11px;
            flex-wrap: wrap;
            margin-top: 4px;
            color: var(--pi-muted);
            font-size: .64rem
        }

        .po-insumo .pi-pill {
            display: inline-flex;
            align-items: center;
            padding: 4px 7px;
            border-radius: 999px;
            background: #f2f4f7;
            color: #475467;
            font-size: .61rem;
            font-weight: 850;
            white-space: nowrap
        }

            .po-insumo .pi-pill.ok {
                background: #edf9f3;
                color: #176b48
            }

            .po-insumo .pi-pill.warn {
                background: #fff8ea;
                color: #8a5700
            }

            .po-insumo .pi-pill.bad {
                background: #fff1f1;
                color: #a52b2b
            }

        .po-insumo .pi-form {
            display: grid;
            grid-template-columns: 1fr 1fr;
            gap: 8px;
            margin-top: 10px;
            padding-top: 10px;
            border-top: 1px solid var(--pi-border)
        }

            .po-insumo .pi-form .full {
                grid-column: 1/-1
            }

        .po-insumo label {
            display: block;
            margin-bottom: 4px;
            color: #344054;
            font-size: .64rem;
            font-weight: 850
        }

        .po-insumo .form-control, .po-insumo .form-select {
            min-height: 36px;
            border-radius: 8px;
            font-size: .72rem
        }

        .po-insumo .pi-actions {
            grid-column: 1/-1;
            display: flex;
            justify-content: flex-end;
            gap: 7px;
            flex-wrap: wrap
        }

        .po-insumo .pi-btn {
            border: 0;
            border-radius: 9px;
            padding: 8px 11px;
            background: var(--pi);
            color: #fff;
            font-size: .7rem;
            font-weight: 900;
            display: inline-flex;
            align-items: center;
            justify-content: center;
            gap: 4px
        }

            .po-insumo .pi-btn:hover {
                filter: brightness(.96)
            }

            .po-insumo .pi-btn:disabled {
                opacity: .55;
                cursor: not-allowed
            }

        .po-insumo .pi-btn-return {
            background: #fff;
            color: #ad2d2d;
            border: 1px solid #e6b2b2
        }

            .po-insumo .pi-btn-return:hover {
                background: #fff4f4
            }

        .po-insumo .pi-btn-cancel {
            background: #fff;
            color: #475467;
            border: 1px solid var(--pi-border)
        }

        .po-insumo .pi-return-actions {
            display: flex;
            justify-content: flex-end;
            gap: 7px;
            margin-top: 9px
        }

        .po-insumo .pi-return-panel {
            display: none;
            margin-top: 10px;
            padding: 11px;
            border: 1px solid #efc1c1;
            border-radius: 11px;
            background: #fff8f8
        }

            .po-insumo .pi-return-panel.show {
                display: block
            }

        .po-insumo .pi-return-title {
            display: flex;
            align-items: center;
            gap: 7px;
            margin-bottom: 4px;
            color: #9c2f2f;
            font-size: .73rem;
            font-weight: 950
        }

        .po-insumo .pi-return-help {
            margin-bottom: 9px;
            color: #805555;
            font-size: .64rem;
            line-height: 1.45
        }

        .po-insumo .pi-return-grid {
            display: grid;
            grid-template-columns: 1fr 1fr;
            gap: 8px
        }

            .po-insumo .pi-return-grid .full {
                grid-column: 1/-1
            }

        .po-insumo .pi-file-help {
            margin-top: 3px;
            color: var(--pi-muted);
            font-size: .58rem
        }

        .po-insumo .pi-empty {
            padding: 18px;
            border: 1px dashed #cfd7e3;
            border-radius: 11px;
            text-align: center;
            color: var(--pi-muted);
            font-size: .72rem;
            background: #fbfcfe
        }

        .po-insumo .pi-wait {
            margin-top: 10px;
            padding: 9px 10px;
            border-radius: 9px;
            background: #f5f7fa;
            border: 1px solid var(--pi-border);
            color: #475467;
            font-size: .68rem
        }

            .po-insumo .pi-wait.ok {
                background: #edf9f3;
                border-color: #bee2cf;
                color: #176b48
            }

            .po-insumo .pi-wait.warn {
                background: #fff8ea;
                border-color: #f0d39d;
                color: #8a5700
            }

        .po-insumo details {
            margin-top: 10px
        }

            .po-insumo details summary {
                cursor: pointer;
                color: #475467;
                font-size: .67rem;
                font-weight: 850
            }

        .po-insumo .pi-history {
            display: grid;
            gap: 6px;
            margin-top: 7px
        }

        .po-insumo .pi-history-row {
            display: flex;
            justify-content: space-between;
            gap: 12px;
            padding: 7px 8px;
            border-radius: 8px;
            background: var(--pi-soft);
            font-size: .65rem;
            color: #667085
        }

            .po-insumo .pi-history-row strong {
                color: #344054
            }

        .po-insumo .pi-lhrh {
            margin-top: 9px;
            padding: 8px 9px;
            border: 1px solid #ddd0f1;
            border-radius: 9px;
            background: #faf7ff;
            color: #5f4a7b;
            font-size: .65rem
        }

        .po-insumo .pi-loading {
            padding: 22px;
            text-align: center;
            color: var(--pi-muted);
            font-size: .72rem
        }

        .po-insumo .pi-spinner {
            display: inline-block;
            width: 20px;
            height: 20px;
            border: 2px solid #d7e2f1;
            border-top-color: var(--pi);
            border-radius: 50%;
            animation: piSpin .7s linear infinite
        }

    @@keyframes piSpin {
        to {
            transform: rotate(360deg)
        }
    }

    html[data-nsq-theme="dark"] .po-insumo {
        --pi-text: #eef2f7;
        --pi-muted: #9aacbf;
        --pi-border: rgba(255,255,255,.10);
        --pi-soft: #0e1929
    }

        html[data-nsq-theme="dark"] .po-insumo .pi-card,
        html[data-nsq-theme="dark"] .po-insumo .pi-head,
        html[data-nsq-theme="dark"] .po-insumo .pi-item {
            background: #111d2f
        }

            html[data-nsq-theme="dark"] .po-insumo .pi-head strong,
            html[data-nsq-theme="dark"] .po-insumo .pi-name,
            html[data-nsq-theme="dark"] .po-insumo .pi-kpi strong,
            html[data-nsq-theme="dark"] .po-insumo label {
                color: #f5f7fb
            }

        html[data-nsq-theme="dark"] .po-insumo .pi-return-panel {
            background: #25191c;
            border-color: #6b3439
        }

        html[data-nsq-theme="dark"] .po-insumo .pi-return-title {
            color: #ffb4b4
        }

        html[data-nsq-theme="dark"] .po-insumo .pi-return-help {
            color: #d3a4a4
        }

    @@media (max-width:900px) {
        .po-insumo .pi-summary {
            grid-template-columns: repeat(3,minmax(0,1fr))
        }
    }

    @@media (max-width:760px) {
        .po-insumo .pi-summary {
            grid-template-columns: 1fr 1fr
        }

        .po-insumo .pi-form, .po-insumo .pi-return-grid {
            grid-template-columns: 1fr
        }

            .po-insumo .pi-form .full, .po-insumo .pi-actions, .po-insumo .pi-return-grid .full {
                grid-column: 1
            }

        .po-insumo .pi-actions, .po-insumo .pi-return-actions {
            justify-content: stretch
        }

            .po-insumo .pi-actions .pi-btn, .po-insumo .pi-return-actions .pi-btn {
                flex: 1
            }

        .po-insumo .pi-item-top {
            flex-direction: column
        }
    }
</style>

<div id="@rootId"
     class="po-insumo"
     data-po-insumo
     data-programa-id="@Model.ProgramaProduccionID"
     data-tipo="@tipo"
     data-solo-lectura="@(soloLectura ? "true" : "false")">
    <form class="d-none" data-po-token>@Html.AntiForgeryToken()</form>

    <div class="pi-card">
        <div class="pi-head">
            <div>
                <strong><i class="bi @icono me-1"></i>@titulo</strong>
                <small>@Model.OFTexto · @Model.MaquinaTexto · @Model.ParteTexto</small>
            </div>
            <span class="badge bg-light text-dark border">Programa #@Model.ProgramaProduccionID</span>
        </div>

        <div class="pi-body">
            <div class="pi-summary">
                <div class="pi-kpi"><span>Requerido</span><strong data-pi-requerido>-</strong></div>
                <div class="pi-kpi"><span>Entregado</span><strong data-pi-entregado>-</strong></div>
                <div class="pi-kpi"><span>Confirmado</span><strong data-pi-confirmado>-</strong></div>
                <div class="pi-kpi"><span>Pend. Almacén</span><strong data-pi-pendiente-almacen>-</strong></div>
                <div class="pi-kpi"><span>Pend. confirmar</span><strong data-pi-pendiente-confirmar>-</strong></div>
            </div>

            <div class="pi-status" data-pi-status></div>

            <div data-pi-contenido>
                <div class="pi-loading">
                    <span class="pi-spinner"></span>
                    <div class="mt-2">Consultando entregas...</div>
                </div>
            </div>
        </div>
    </div>
</div>

<script>
    (() => {
        'use strict';

        const root=document.getElementById('@rootId');
        if(!root||root.dataset.inicializado==='1') return;
        root.dataset.inicializado='1';

        const programaId=Number(root.dataset.programaId||0);
        const tipo=(root.dataset.tipo||'MP').toUpperCase();
        const soloLectura=root.dataset.soloLectura==='true';
        const token=root.querySelector('input[name="__RequestVerificationToken"]')?.value||'';
        const contenido=root.querySelector('[data-pi-contenido]');
        const status=root.querySelector('[data-pi-status]');
        const requerido=root.querySelector('[data-pi-requerido]');
        const entregado=root.querySelector('[data-pi-entregado]');
        const confirmado=root.querySelector('[data-pi-confirmado]');
        const pendienteAlmacen=root.querySelector('[data-pi-pendiente-almacen]');
        const pendienteConfirmar=root.querySelector('[data-pi-pendiente-confirmar]');

        const urlDatos='@Url.Action("OperativaInsumosDatos", "ProduccionPreparacion")';
        const urlGuardar='@Url.Action("ConfirmarRecepcionMaterialOperativa", "ProduccionPreparacion")';
        const urlDevolver='@Url.Action("DevolverMaterialOperativa", "ProduccionPreparacion")';

        const motivosMp=[
            'Material sucio',
            'Material contaminado',
            'Material húmedo / mojado',
            'Material incorrecto',
            'Lote incorrecto',
            'Saco / empaque dañado',
            'Etiquetado / identificación incorrecta',
            'Cantidad incorrecta',
            'Material mezclado',
            'Otro'
        ];

        const motivosEmbalaje=[
            'Embalaje sucio',
            'Embalaje dañado / roto',
            'Embalaje mojado / húmedo',
            'Código de embalaje incorrecto',
            'Medida / especificación incorrecta',
            'Etiquetado / impresión incorrecta',
            'Cantidad incorrecta',
            'Deformado / aplastado',
            'Material de embalaje incorrecto',
            'Otro'
        ];

        const esc=value=>String(value??'').replace(/[&<>'"]/g,c=>({
            '&':'&amp;',
            '<':'&lt;',
            '>':'&gt;',
            "'":'&#39;',
            '"':'&quot;'
        }[c]));

        const numero=value=>{
            const valor=Number(value||0);
            return Number.isFinite(valor)
                ?valor.toLocaleString('es-MX',{maximumFractionDigits:4})
                :'0';
        };

        const fecha=value=>{
            if(!value) return '-';
            const d=new Date(value);
            return Number.isNaN(d.getTime())
                ?'-'
                :d.toLocaleString('es-MX',{
                    day:'2-digit',
                    month:'2-digit',
                    year:'numeric',
                    hour:'2-digit',
                    minute:'2-digit'
                });
        };

        function mensaje(texto,tipoClase){
            if(!status) return;
            status.textContent=texto||'';
            status.className='pi-status'+(texto?' show ':' ')+(tipoClase||'');
        }

        function refrescarCentro(){
            window.setTimeout(()=>{
                const centro=root.closest('[data-nsq-operativa-centro]');
                centro?.querySelector('[data-nsq-operativa-refrescar]')?.click();
            },300);
        }

        function claseRecepcion(x){
            if(x.estaPendiente) return 'is-pending';
            if(x.estaRecibidoCompleto) return 'is-ok';
            return 'is-diff';
        }

        function badgeEstado(x){
            if(x.estaPendiente) return '<span class="pi-pill">Pendiente de Producción</span>';
            if(x.estaRecibidoCompleto) return '<span class="pi-pill ok">Recibido</span>';
            if(x.estaRecibidoParcial) return '<span class="pi-pill warn">Recepción parcial</span>';
            return '<span class="pi-pill bad">No recibido</span>';
        }

        function opcionesMotivos(){
            const motivos=tipo==='MP'?motivosMp:motivosEmbalaje;
            return '<option value="">Selecciona un motivo</option>'+
                motivos.map(x=>`<option value="${esc(x)}">${esc(x)}</option>`).join('');
        }

        function formRecepcion(x,puedeGestionar){
            if(!x.estaPendiente||soloLectura||!puedeGestionar) return '';

            return `
            <form class="pi-form" data-pi-form data-id="${Number(x.recepcionMaterialID||0)}">
                <div>
                    <label>Confirmación</label>
                    <select class="form-select" name="Decision" data-pi-decision required>
                        <option value="COMPLETO">Recibí completo</option>
                        <option value="PARCIAL">Recibí parcialmente</option>
                        <option value="NO_RECIBIDO">No recibí</option>
                    </select>
                </div>

                <div data-pi-cantidad-wrap style="display:none">
                    <label>Cantidad realmente recibida</label>
                    <input class="form-control"
                           type="number"
                           min="0.0001"
                           step="0.0001"
                           max="${Number(x.cantidadEntregadaAlmacen||0)}"
                           name="CantidadRecibida"
                           data-pi-cantidad />
                </div>

                <div class="full" data-pi-motivo-wrap style="display:none">
                    <label>Motivo de diferencia</label>
                    <textarea class="form-control"
                              rows="2"
                              maxlength="500"
                              name="MotivoDiferencia"
                              data-pi-motivo
                              placeholder="Indica qué ocurrió"></textarea>
                </div>

                <div class="full">
                    <label>Observaciones opcionales</label>
                    <textarea class="form-control"
                              rows="2"
                              maxlength="800"
                              name="Observaciones"
                              placeholder="Opcional"></textarea>
                </div>

                <div class="pi-actions">
                    <button type="submit" class="pi-btn">
                        <i class="bi bi-check2-circle"></i>
                        Confirmar recepción
                    </button>
                </div>
            </form>`;
        }

        function bloqueDevolucion(x,puedeDevolver){
            if(soloLectura||!puedeDevolver||!x.estaPendiente) return '';

            const id=Number(x.recepcionMaterialID||0);
            const cantidad=Math.max(0,Number(x.cantidadEntregadaAlmacen||0));
            if(id<=0||cantidad<=0) return '';

            return `
            <div class="pi-return-actions">
                <button type="button"
                        class="pi-btn pi-btn-return"
                        data-pi-return-open="${id}">
                    <i class="bi bi-arrow-return-left"></i>
                    Devolver a Almacén
                </button>
            </div>

            <div class="pi-return-panel" data-pi-return-panel="${id}">
                <div class="pi-return-title">
                    <i class="bi bi-arrow-return-left"></i>
                    Devolver material a Almacén
                </div>

                <div class="pi-return-help">
                    Utiliza esta opción cuando la entrega física no debe conservarse en Producción.
                    La devolución regresará la cantidad indicada a inventario y la OF quedará pendiente de reposición.
                </div>

                <form data-pi-return-form data-id="${id}" enctype="multipart/form-data">
                    <div class="pi-return-grid">
                        <div>
                            <label>Cantidad a devolver</label>
                            <input class="form-control"
                                   type="number"
                                   name="CantidadDevuelta"
                                   min="0.001"
                                   step="0.001"
                                   max="${cantidad}"
                                   value="${cantidad}"
                                   required />
                        </div>

                        <div>
                            <label>Motivo</label>
                            <select class="form-select"
                                    name="MotivoDevolucion"
                                    required>
                                ${opcionesMotivos()}
                            </select>
                        </div>

                        <div class="full">
                            <label>Comentario / detalle</label>
                            <textarea class="form-control"
                                      name="ComentarioDevolucion"
                                      rows="2"
                                      maxlength="500"
                                      placeholder="Describe qué se detectó en el material"
                                      required></textarea>
                        </div>

                        <div class="full">
                            <label>Fotografía de evidencia</label>
                            <input class="form-control"
                                   type="file"
                                   name="EvidenciaDevolucion"
                                   accept=".jpg,.jpeg,.png,.webp,image/jpeg,image/png,image/webp"
                                   required />
                            <div class="pi-file-help">JPG, JPEG, PNG o WEBP. Máximo 8 MB.</div>
                        </div>
                    </div>

                    <div class="pi-return-actions">
                        <button type="button"
                                class="pi-btn pi-btn-cancel"
                                data-pi-return-close="${id}">
                            Cancelar
                        </button>

                        <button type="submit" class="pi-btn pi-btn-return">
                            <i class="bi bi-arrow-return-left"></i>
                            Confirmar devolución
                        </button>
                    </div>
                </form>
            </div>`;
        }

        function estadoResumen(data){
            const r=data.resumen||{};
            const requeridoNum=Number(r.cantidadRequerida||0);
            const confirmadoNum=Number(r.cantidadConfirmada||0);
            const pendienteAlmacenNum=Number(r.pendienteAlmacen||0);
            const pendientesConfirmacion=Number(r.pendientesConfirmacion||0);

            if(r.completo){
                mensaje(`${data.tipoTexto} completo para esta OF.`,'ok');
                return;
            }

            if(tipo==='MP'&&r.parcial&&r.puedeContinuarPreparacion){
                const saldo=pendienteAlmacenNum>0
                    ?` Almacén aún debe entregar ${numero(pendienteAlmacenNum)}.`
                    :'';
                mensaje(
                    `Recepción parcial disponible: Producción tiene ${numero(confirmadoNum)} de ${numero(requeridoNum)} confirmados y puede continuar con la preparación.${saldo}`,
                    'ok'
                );
                return;
            }

            if(pendientesConfirmacion>0){
                mensaje(
                    `Hay ${pendientesConfirmacion} entrega(s) de ${data.tipoTexto.toLowerCase()} pendientes de confirmar por Producción.`,
                    'warn'
                );
                return;
            }

            if(pendienteAlmacenNum>0){
                mensaje(
                    `Esperando ${numero(pendienteAlmacenNum)} por entregar desde Almacén.`,
                    'warn'
                );
                return;
            }

            if(r.hayCantidadConfirmada){
                mensaje(
                    `Producción ya tiene ${numero(confirmadoNum)} confirmados.`,
                    'info'
                );
                return;
            }

            mensaje('Sin entregas pendientes de confirmar.','');
        }

        function render(data){
            const r=data.resumen||{};

            requerido.textContent=numero(r.cantidadRequerida);
            entregado.textContent=numero(r.cantidadEntregada);
            confirmado.textContent=numero(r.cantidadConfirmada);
            pendienteAlmacen.textContent=numero(r.pendienteAlmacen);
            pendienteConfirmar.textContent=numero(r.pendienteConfirmar);

            estadoResumen(data);

            const recepciones=Array.isArray(data.recepciones)?data.recepciones:[];
            const esperados=Array.isArray(data.esperados)?data.esperados:[];
            const pendientes=recepciones.filter(x=>x.estaPendiente);
            const historico=recepciones.filter(x=>!x.estaPendiente);

            let html='';

            if(pendientes.length){
                html+='<div class="pi-list">';

                pendientes.forEach(x=>{
                    const puedeDevolver=!!x.puedeDevolver||(
                        !!data.puedeDevolver&&
                        !!x.estaPendiente&&
                        Number(x.cantidadEntregadaAlmacen||0)>0
                    );

                    html+=`
                    <article class="pi-item ${claseRecepcion(x)}">
                        <div class="pi-item-top">
                            <div>
                                <div class="pi-name">
                                    ${esc(x.textoEntregado||x.textoSolicitado||'Insumo')}
                                </div>

                                <div class="pi-meta">
                                    <span>
                                        <i class="bi bi-box-arrow-in-down me-1"></i>
                                        ${numero(x.cantidadEntregadaAlmacen)} ${esc(x.unidad||'')}
                                    </span>

                                    ${x.lote?`
                                    <span>
                                        <i class="bi bi-upc-scan me-1"></i>
                                        Lote ${esc(x.lote)}
                                    </span>`:''}

                                    <span>
                                        <i class="bi bi-clock me-1"></i>
                                        ${fecha(x.fechaEntregaAlmacen)}
                                    </span>

                                    ${x.usuarioEntregaAlmacenNombre?`
                                    <span>
                                        <i class="bi bi-person me-1"></i>
                                        ${esc(x.usuarioEntregaAlmacenNombre)}
                                    </span>`:''}
                                </div>
                            </div>

                            ${badgeEstado(x)}
                        </div>

                        ${x.esSustitucion?`
                        <div class="pi-wait">
                            <i class="bi bi-arrow-left-right me-1"></i>
                            Solicitado: ${esc(x.textoSolicitado)} ·
                            Entregado: ${esc(x.textoEntregado)}
                        </div>`:''}

                        ${x.observacionesAlmacen?`
                        <div class="pi-wait">
                            ${esc(x.observacionesAlmacen)}
                        </div>`:''}

                        ${x.grupoLhRh?`
                        <div class="pi-lhrh">
                            <i class="bi bi-link-45deg me-1"></i>
                            LH/RH grupo ${esc(x.grupoLhRh)}
                            ${x.ladoLhRh?` · ${esc(x.ladoLhRh)}`:''}
                            ${x.numeroOFPareja?` · Pareja ${esc(x.numeroOFPareja)}`:''}
                        </div>`:''}

                        ${formRecepcion(x,!!data.puedeGestionar)}
                        ${bloqueDevolucion(x,puedeDevolver)}
                    </article>`;
                });

                html+='</div>';
            }
            else if(esperados.length){
                html+='<div class="pi-list">';

                esperados.forEach(x=>{
                    const entregadoEsperado=Number(x.cantidadEntregadaAlmacen||0);
                    const confirmadoEsperado=Number(x.cantidadConfirmadaProduccion||0);
                    const requeridoEsperado=Number(x.cantidadRequerida||0);
                    const parcialEsperado=confirmadoEsperado>0&&confirmadoEsperado+0.0005<requeridoEsperado;

                    html+=`
                    <article class="pi-item ${parcialEsperado?'is-diff':''}">
                        <div class="pi-item-top">
                            <div>
                                <div class="pi-name">
                                    ${esc(x.codigo)}
                                    ${x.descripcion?` - ${esc(x.descripcion)}`:''}
                                </div>

                                <div class="pi-meta">
                                    <span>Requerido ${numero(requeridoEsperado)} ${esc(x.unidad||'')}</span>
                                    <span>Entregado ${numero(entregadoEsperado)} ${esc(x.unidad||'')}</span>
                                    <span>Confirmado ${numero(confirmadoEsperado)} ${esc(x.unidad||'')}</span>
                                </div>
                            </div>

                            <span class="pi-pill ${parcialEsperado?'warn':''}">
                                ${parcialEsperado?'Entrega parcial':esc(x.estadoAlmacenTexto||'Pendiente de Almacén')}
                            </span>
                        </div>
                    </article>`;
                });

                html+='</div>';

                if(tipo==='MP'&&r.parcial&&r.puedeContinuarPreparacion){
                    html+=`
                    <div class="pi-wait ok">
                        <i class="bi bi-check-circle me-1"></i>
                        Producción ya tiene <strong>${numero(r.cantidadConfirmada)}</strong> confirmados y puede continuar con la preparación.
                        ${Number(r.pendienteAlmacen||0)>0
                            ?` Almacén aún debe completar <strong>${numero(r.pendienteAlmacen)}</strong>.`
                            :''}
                    </div>`;
                }
                else if(Number(r.pendienteAlmacen||0)>0){
                    html+=`
                    <div class="pi-wait warn">
                        <i class="bi bi-hourglass-split me-1"></i>
                        Almacén todavía debe registrar una entrega por
                        <strong>${numero(r.pendienteAlmacen)}</strong>.
                    </div>`;
                }
                else{
                    html+=`
                    <div class="pi-wait">
                        <i class="bi bi-info-circle me-1"></i>
                        Actualmente no existe una nueva entrega de Almacén pendiente de confirmar.
                    </div>`;
                }
            }
            else if(r.completo){
                html=`
                <div class="pi-empty">
                    <i class="bi bi-check-circle-fill text-success me-1"></i>
                    El insumo requerido ya está confirmado.
                </div>`;
            }
            else if(tipo==='MP'&&r.hayCantidadConfirmada){
                html=`
                <div class="pi-empty">
                    <i class="bi bi-check-circle text-success me-1"></i>
                    Producción ya tiene ${numero(r.cantidadConfirmada)} disponibles.
                    ${Number(r.pendienteAlmacen||0)>0
                        ?` Almacén tiene pendientes ${numero(r.pendienteAlmacen)} por entregar.`
                        :''}
                </div>`;
            }
            else{
                html=`
                <div class="pi-empty">
                    No hay movimientos de este insumo para la OF.
                </div>`;
            }

            if(historico.length){
                html+=`
                <details>
                    <summary>
                        Recepciones anteriores (${historico.length})
                    </summary>
                    <div class="pi-history">`;

                historico.slice(0,12).forEach(x=>{
                    html+=`
                    <div class="pi-history-row">
                        <span>
                            ${esc(x.textoEntregado||x.textoSolicitado||'Insumo')} ·
                            ${numero(x.cantidadRecibidaProduccion)} ${esc(x.unidad||'')}
                        </span>
                        <strong>
                            ${esc(x.estadoRecepcionTexto||x.estadoRecepcion||'')}
                        </strong>
                    </div>`;
                });

                html+='</div></details>';
            }

            contenido.innerHTML=html;
            enlazarEventos();
        }

        function actualizarCamposRecepcion(form){
            const decision=form.querySelector('[data-pi-decision]')?.value||'COMPLETO';
            const wrapCantidad=form.querySelector('[data-pi-cantidad-wrap]');
            const wrapMotivo=form.querySelector('[data-pi-motivo-wrap]');
            const cantidad=form.querySelector('[data-pi-cantidad]');
            const motivo=form.querySelector('[data-pi-motivo]');
            const parcial=decision==='PARCIAL';
            const diferencia=decision==='PARCIAL'||decision==='NO_RECIBIDO';

            if(wrapCantidad) wrapCantidad.style.display=parcial?'block':'none';
            if(wrapMotivo) wrapMotivo.style.display=diferencia?'block':'none';

            if(cantidad){
                cantidad.required=parcial;
                if(!parcial) cantidad.value='';
            }

            if(motivo){
                motivo.required=diferencia;
                if(!diferencia) motivo.value='';
            }
        }

        function abrirDevolucion(id){
            root.querySelectorAll('[data-pi-return-panel]').forEach(panel=>{
                panel.classList.toggle(
                    'show',
                    String(panel.dataset.piReturnPanel)===String(id)
                );
            });

            const panel=root.querySelector(`[data-pi-return-panel="${id}"]`);
            panel?.querySelector('select[name="MotivoDevolucion"]')?.focus();
        }

        function cerrarDevolucion(id){
            const panel=root.querySelector(`[data-pi-return-panel="${id}"]`);
            panel?.classList.remove('show');

            const form=panel?.querySelector('[data-pi-return-form]');
            if(form instanceof HTMLFormElement) form.reset();
        }

        function enlazarEventos(){
            root.querySelectorAll('[data-pi-form]').forEach(form=>{
                const decision=form.querySelector('[data-pi-decision]');
                decision?.addEventListener('change',()=>actualizarCamposRecepcion(form));
                actualizarCamposRecepcion(form);
                form.addEventListener('submit',guardarRecepcion);
            });

            root.querySelectorAll('[data-pi-return-open]').forEach(btn=>{
                btn.addEventListener('click',()=>{
                    abrirDevolucion(btn.dataset.piReturnOpen);
                });
            });

            root.querySelectorAll('[data-pi-return-close]').forEach(btn=>{
                btn.addEventListener('click',()=>{
                    cerrarDevolucion(btn.dataset.piReturnClose);
                });
            });

            root.querySelectorAll('[data-pi-return-form]').forEach(form=>{
                form.addEventListener('submit',guardarDevolucion);
            });
        }

        async function guardarRecepcion(event){
            event.preventDefault();

            const form=event.currentTarget;
            const boton=form.querySelector('button[type="submit"]');
            const data=new FormData(form);

            data.append('RecepcionMaterialID',form.dataset.id||'0');
            data.append('__RequestVerificationToken',token);

            if(boton) boton.disabled=true;
            mensaje('Guardando recepción...','info');

            try{
                const response=await fetch(urlGuardar,{
                    method:'POST',
                    body:data,
                    credentials:'same-origin',
                    headers:{
                        'X-Requested-With':'XMLHttpRequest',
                        'X-NSQ-Operativa':'1',
                        'Accept':'application/json'
                    }
                });

                let result=null;
                try{result=await response.json();}catch{}

                if(!response.ok||result?.ok!==true)
                    throw new Error(result?.mensaje||`HTTP ${response.status}`);

                mensaje(
                    result.mensaje||'Recepción actualizada.',
                    result.advertencia?'warn':'ok'
                );

                await cargar();
                refrescarCentro();
            }
            catch(error){
                mensaje(
                    error?.message||'No fue posible confirmar la recepción.',
                    'bad'
                );

                if(boton) boton.disabled=false;
            }
        }

        async function guardarDevolucion(event){
            event.preventDefault();

            const form=event.currentTarget;
            const boton=form.querySelector('button[type="submit"]');
            const cantidad=form.querySelector('input[name="CantidadDevuelta"]');
            const motivo=form.querySelector('select[name="MotivoDevolucion"]');
            const comentario=form.querySelector('textarea[name="ComentarioDevolucion"]');
            const evidencia=form.querySelector('input[name="EvidenciaDevolucion"]');

            const cantidadNumero=Number(cantidad?.value||0);
            const maximo=Number(cantidad?.max||0);
            const archivo=evidencia?.files?.[0]||null;

            if(!Number.isFinite(cantidadNumero)||cantidadNumero<=0){
                mensaje('La cantidad a devolver debe ser mayor a cero.','bad');
                cantidad?.focus();
                return;
            }

            if(maximo>0&&cantidadNumero>maximo+0.0005){
                mensaje(`No puedes devolver más de ${numero(maximo)}.`,'bad');
                cantidad?.focus();
                return;
            }

            if(!motivo?.value){
                mensaje('Selecciona el motivo de la devolución.','bad');
                motivo?.focus();
                return;
            }

            if(!comentario?.value?.trim()){
                mensaje('Escribe el comentario o detalle del problema.','bad');
                comentario?.focus();
                return;
            }

            if(!archivo){
                mensaje('La fotografía de evidencia es obligatoria.','bad');
                evidencia?.focus();
                return;
            }

            if(archivo.size>8*1024*1024){
                mensaje('La evidencia no puede superar 8 MB.','bad');
                evidencia.value='';
                evidencia?.focus();
                return;
            }

            const tiposPermitidos=['image/jpeg','image/png','image/webp'];
            if(archivo.type&&!tiposPermitidos.includes(archivo.type)){
                mensaje('La evidencia debe ser una imagen JPG, PNG o WEBP.','bad');
                evidencia.value='';
                evidencia?.focus();
                return;
            }

            const confirmado=window.confirm(
                `¿Confirmas devolver ${numero(cantidadNumero)} a Almacén? La OF quedará pendiente de reposición.`
            );

            if(!confirmado) return;

            const data=new FormData(form);
            data.append('RecepcionMaterialID',form.dataset.id||'0');
            data.append('__RequestVerificationToken',token);

            if(boton){
                boton.disabled=true;
                boton.innerHTML='<span class="spinner-border spinner-border-sm"></span> Devolviendo...';
            }

            mensaje('Registrando devolución a Almacén...','info');

            try{
                const response=await fetch(urlDevolver,{
                    method:'POST',
                    body:data,
                    credentials:'same-origin',
                    headers:{
                        'X-Requested-With':'XMLHttpRequest',
                        'X-NSQ-Operativa':'1',
                        'Accept':'application/json'
                    }
                });

                let result=null;
                try{result=await response.json();}catch{}

                if(!response.ok||result?.ok!==true)
                    throw new Error(result?.mensaje||`HTTP ${response.status}`);

                mensaje(
                    result.mensaje||'Devolución registrada correctamente.',
                    result.advertencia?'warn':'ok'
                );

                await cargar();
                refrescarCentro();
            }
            catch(error){
                mensaje(
                    error?.message||'No fue posible registrar la devolución.',
                    'bad'
                );

                if(boton){
                    boton.disabled=false;
                    boton.innerHTML='<i class="bi bi-arrow-return-left"></i> Confirmar devolución';
                }
            }
        }

        async function cargar(){
            contenido.innerHTML=`
            <div class="pi-loading">
                <span class="pi-spinner"></span>
                <div class="mt-2">Consultando entregas...</div>
            </div>`;

            try{
                const qs=new URLSearchParams({
                    programaProduccionId:String(programaId),
                    tipo
                });

                const response=await fetch(`${urlDatos}?${qs.toString()}`,{
                    cache:'no-store',
                    credentials:'same-origin',
                    headers:{
                        'X-Requested-With':'XMLHttpRequest',
                        'Accept':'application/json'
                    }
                });

                let data=null;
                try{data=await response.json();}catch{}

                if(!response.ok||data?.ok!==true)
                    throw new Error(data?.mensaje||`HTTP ${response.status}`);

                render(data);
            }
            catch(error){
                contenido.innerHTML=`
                <div class="pi-empty text-danger">
                    <i class="bi bi-exclamation-triangle me-1"></i>
                    ${esc(error?.message||'No fue posible consultar las entregas.')}
                </div>`;

                mensaje(
                    error?.message||'No fue posible consultar las entregas.',
                    'bad'
                );
            }
        }

        cargar();
    })();
</script>