@model ERP.NSQuell.Models.ProduccionCentroOperativoVm

@{
    var rootId = $"poParos_{Model.ProgramaProduccionID}";
    var soloLectura = ViewData["SoloLectura"] is bool b && b;
    var url = Url.Action("OperativaParos", "Produccion", new { programaProduccionId = Model.ProgramaProduccionID, soloLectura })
        ?? $"/Produccion/OperativaParos?programaProduccionId={Model.ProgramaProduccionID}&soloLectura={(soloLectura ? "true" : "false")}";
}

<style>
    .por-loader {
        min-height: 240px
    }

    .por-loading {
        min-height: 240px;
        display: flex;
        align-items: center;
        justify-content: center;
        flex-direction: column;
        gap: 10px;
        color: #667085;
        font-size: .8rem;
        font-weight: 800
    }

    .por-spinner {
        width: 31px;
        height: 31px;
        border: 3px solid #dbe5f1;
        border-top-color: #004aad;
        border-radius: 50%;
        animation: porSpin .72s linear infinite
    }

    .por-error {
        border: 1px solid #fecaca;
        background: #fff5f5;
        color: #991b1b;
        border-radius: 14px;
        padding: 16px;
        font-size: .82rem;
        font-weight: 750
    }

    @@keyframes porSpin {
        to {
            transform: rotate(360deg)
        }
    }
</style>

<div id="@rootId" class="por-loader" data-por-loader>
    <div data-por-body>
        <div class="por-loading">
            <div class="por-spinner"></div>
            <span>Cargando paros e interrupciones...</span>
        </div>
    </div>
</div>

<script>
    (() => {
        'use strict';
        const root=document.getElementById('@rootId');
        if(!root||root.dataset.inicializado==='1') return;
        root.dataset.inicializado='1';
        const body=root.querySelector('[data-por-body]');
        const url='@url';

        function escapar(texto){
            return String(texto??'')
                .replace(/&/g,'&amp;')
                .replace(/</g,'&lt;')
                .replace(/>/g,'&gt;')
                .replace(/"/g,'&quot;')
                .replace(/'/g,'&#039;');
        }

        async function errorRespuesta(response){
            try{
                const tipo=(response.headers.get('content-type')||'').toLowerCase();
                if(tipo.includes('application/json')){
                    const data=await response.json();
                    return data?.mensaje||data?.message||`HTTP ${response.status}`;
                }
                const texto=await response.text();
                if(!texto) return `HTTP ${response.status}`;
                const doc=new DOMParser().parseFromString(texto,'text/html');
                return doc.body?.innerText?.trim()?.slice(0,500)||texto.slice(0,500);
            }catch{
                return `HTTP ${response.status}`;
            }
        }

        function ejecutarScripts(contenedor){
            [...contenedor.querySelectorAll('script')].forEach(anterior=>{
                const nuevo=document.createElement('script');
                [...anterior.attributes].forEach(a=>nuevo.setAttribute(a.name,a.value));
                nuevo.text=anterior.textContent||'';
                anterior.replaceWith(nuevo);
            });
        }

        let cargando=false;

        async function cargar(){
            if(cargando||!root.isConnected) return;
            cargando=true;
            try{
                const response=await fetch(url,{
                    method:'GET',
                    cache:'no-store',
                    credentials:'same-origin',
                    headers:{'X-Requested-With':'XMLHttpRequest','Cache-Control':'no-cache'}
                });
                if(!response.ok) throw new Error(await errorRespuesta(response));
                body.innerHTML=await response.text();
                ejecutarScripts(body);
            }catch(error){
                body.innerHTML=`<div class="por-error"><i class="bi bi-exclamation-triangle-fill me-1"></i>${escapar(error?.message||'No fue posible cargar los paros.')}</div>`;
            }finally{
                cargando=false;
            }
        }

        function requiereActualizacionAutomatica(){
            const contenido=body.querySelector('[data-paros-operativos-root]');
            return contenido?.dataset.interrupcionUrgente==='1';
        }

        const timer=window.setInterval(()=>{
            if(!root.isConnected){window.clearInterval(timer);return;}
            if(document.hidden||!requiereActualizacionAutomatica()) return;
            cargar();
        },20000);

        document.addEventListener('visibilitychange',()=>{
            if(!document.hidden&&root.isConnected&&requiereActualizacionAutomatica()) cargar();
        });

        cargar();
    })();
</script>
