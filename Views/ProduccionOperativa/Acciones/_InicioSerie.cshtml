@model ERP.NSQuell.Models.ProduccionCentroOperativoVm
@{
    var ejecucionId = Model.EjecucionProduccionID.GetValueOrDefault();
    var soloLectura = ViewData["SoloLectura"] is bool sl && sl;
}
<div class="pis-shell"
     data-pis-root
     data-ejecucion-id="@ejecucionId"
     data-solo-lectura="@(soloLectura ? "true" : "false")"
     data-url-contenido="@Url.Action("InicioSerieOperativa", "Produccion")">
    <div class="pis-message d-none" data-pis-message></div>
    <div data-pis-body>
        @if (ejecucionId <= 0)
        {
            <div class="alert alert-warning mb-0">
                <i class="bi bi-hourglass-split me-1"></i>
                El inicio de serie se habilita cuando ya existe una ejecución de Producción.
            </div>
        }
        else
        {
            <div class="pis-loading">
                <span class="spinner-border spinner-border-sm" role="status" aria-hidden="true"></span>
                <span>Cargando estado de inicio de serie...</span>
            </div>
        }
    </div>
</div>

<style>
    .pis-shell {
        --pis-border: #dbe4ee;
        --pis-muted: #64748b;
        --pis-text: #0f172a;
        --pis-soft: #f8fafc;
        --pis-green: #166534;
        --pis-blue: #1d4ed8;
        --pis-amber: #92400e;
        color: var(--pis-text)
    }

    .pis-loading {
        min-height: 120px;
        display: flex;
        align-items: center;
        justify-content: center;
        gap: .65rem;
        color: var(--pis-muted)
    }

    .pis-message {
        margin-bottom: 1rem;
        padding: .75rem .9rem;
        border-radius: .75rem;
        font-weight: 700;
        font-size: .9rem
    }

        .pis-message.is-ok {
            background: #ecfdf5;
            color: #166534;
            border: 1px solid #bbf7d0
        }

        .pis-message.is-bad {
            background: #fef2f2;
            color: #991b1b;
            border: 1px solid #fecaca
        }

        .pis-message.is-warn {
            background: #fffbeb;
            color: #92400e;
            border: 1px solid #fde68a
        }

    html[data-nsq-theme="dark"] .pis-shell {
        --pis-border: rgba(255,255,255,.12);
        --pis-muted: #94a3b8;
        --pis-text: #f8fafc;
        --pis-soft: #0f1a2a
    }
</style>

<script>
    (()=>{
        const root=document.currentScript?.previousElementSibling?.previousElementSibling;
        if(!root||!root.matches('[data-pis-root]')||root.dataset.wired==='1') return;
        root.dataset.wired='1';

        const body=root.querySelector('[data-pis-body]');
        const message=root.querySelector('[data-pis-message]');
        const ejecucionId=Number(root.dataset.ejecucionId||0);
        const soloLectura=root.dataset.soloLectura==='true';
        const urlContenido=root.dataset.urlContenido||'';
        let cargando=false;

        function mostrar(texto,tipo='ok'){
            if(!message) return;
            if(!texto){message.className='pis-message d-none';message.textContent='';return;}
            message.className=`pis-message is-${tipo}`;
            message.textContent=texto;
        }

        function escapeHtml(valor){
            return String(valor??'').replace(/[&<>'"]/g,c=>({'&':'&amp;','<':'&lt;','>':'&gt;',"'":'&#39;','"':'&quot;'}[c]));
        }

        async function leer(response){
            const tipo=response.headers.get('content-type')||'';
            if(tipo.includes('application/json')) return await response.json();
            const texto=await response.text();
            return {ok:response.ok,mensaje:texto};
        }

        function conectar(scope){
            const form=scope.querySelector('form[data-pis-form]');
            if(!form||form.dataset.wired==='1') return;
            form.dataset.wired='1';
            const boton=form.querySelector('button[type="submit"]');
            const contador=form.querySelector('[name="contadorMaquinaActual"]');
            const requiereContador=form.dataset.requiereContador==='true';

            if(soloLectura){
                form.querySelectorAll('input,button,select,textarea').forEach(x=>x.disabled=true);
                return;
            }

            form.addEventListener('submit',async e=>{
                e.preventDefault();
                mostrar('');
                if(requiereContador&&(contador?.value===''||Number(contador?.value)<0)){
                    mostrar('Captura el contador físico actual de la máquina antes de reiniciar la serie.','bad');
                    contador?.focus();
                    return;
                }
                if(!form.reportValidity()) return;

                const textoConfirmacion=requiereContador
                    ?'¿Confirmas reiniciar la producción en serie usando el contador físico capturado como nueva base?'
                    :'¿Confirmas iniciar la producción en serie?';
                if(!window.confirm(textoConfirmacion)) return;

                if(boton) boton.disabled=true;
                try{
                    const response=await fetch(form.action,{
                        method:'POST',
                        body:new FormData(form),
                        credentials:'same-origin',
                        headers:{'X-Requested-With':'XMLHttpRequest','X-NSQ-Operativa':'1','Accept':'application/json'}
                    });
                    const data=await leer(response);
                    if(!response.ok||!data?.ok) throw new Error(data?.mensaje||`HTTP ${response.status}`);
                    mostrar(data.mensaje||'Inicio de serie confirmado.',data.advertencia?'warn':'ok');
                    await cargar(false);
                    window.setTimeout(()=>root.closest('[data-nsq-operativa-centro]')?.querySelector('[data-nsq-operativa-refrescar]')?.click(),450);
                }catch(error){
                    mostrar(error?.message||'No fue posible iniciar o reiniciar la serie.','bad');
                }finally{
                    if(boton) boton.disabled=false;
                }
            });
        }

        async function cargar(mostrarCarga=true){
            if(cargando||ejecucionId<=0||!urlContenido) return;
            cargando=true;
            if(mostrarCarga) body.innerHTML='<div class="pis-loading"><span class="spinner-border spinner-border-sm" role="status" aria-hidden="true"></span><span>Cargando estado de inicio de serie...</span></div>';
            try{
                const response=await fetch(`${urlContenido}?ejecucionProduccionId=${encodeURIComponent(ejecucionId)}`,{
                    cache:'no-store',credentials:'same-origin',headers:{'X-Requested-With':'XMLHttpRequest','Accept':'text/html,application/json'}
                });
                if(!response.ok){
                    const data=await leer(response);
                    throw new Error(data?.mensaje||`HTTP ${response.status}`);
                }
                body.innerHTML=await response.text();
                conectar(body);
            }catch(error){
                body.innerHTML=`<div class="alert alert-danger mb-0"><i class="bi bi-exclamation-triangle-fill me-1"></i>${escapeHtml(error?.message||'No fue posible cargar el inicio de serie.')}</div>`;
            }finally{
                cargando=false;
            }
        }

        cargar();
    })();
</script>
