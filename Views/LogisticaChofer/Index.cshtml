@model List<ERP.NSQuell.Models.ViewModels.Logistica.LogisticaViajeDetalleVm>
@{
    Layout = "~/Views/Shared/_Layout.cshtml";
    ViewData["Title"] = "Mis viajes | Logística";

    var nombreChofer = ViewBag.NombreChofer as string ?? "Chofer";
    var totalViajes = ViewBag.TotalViajes is int total ? total : Model.Count;
    var programados = ViewBag.Programados is int prog ? prog : Model.Count(x => x.Estatus == "Programado");
    var enCurso = ViewBag.EnCurso is int curso ? curso : Model.Count(x => x.Estatus == "En curso");
    var completadosHoy = ViewBag.CompletadosHoy is int completos ? completos : Model.Count(x => x.Estatus == "Completado" && x.FechaRegresoReal.HasValue && x.FechaRegresoReal.Value.Date == DateTime.Today);

    var viajesEnCurso = Model.Where(x => x.Estatus == "En curso").OrderBy(x => x.FechaSalidaReal ?? x.FechaProgramada).ToList();
    var viajesProgramados = Model.Where(x => x.Estatus == "Programado").OrderBy(x => x.FechaProgramada).ThenBy(x => x.HoraSalidaProgramada).ToList();
    var viajesCompletados = Model.Where(x => x.Estatus == "Completado").OrderByDescending(x => x.FechaRegresoReal ?? x.FechaProgramada).ToList();
    var hayEntregas = Model.Any(x => string.Equals(x.TipoViaje, "Entrega PT", StringComparison.OrdinalIgnoreCase) || x.Paradas.Any(p => string.Equals(p.TipoParada, "Entrega", StringComparison.OrdinalIgnoreCase)));
}
@functions {
    public static string Txt(string? value) => string.IsNullOrWhiteSpace(value) ? "-" : value.Trim();
    public static string TxtVisible(string? value) => Txt(value).Replace("Entrega NS", "Entrega", StringComparison.OrdinalIgnoreCase).Replace("Entrega PT", "Entrega", StringComparison.OrdinalIgnoreCase);
    public static bool EsEntrega(ERP.NSQuell.Models.ViewModels.Logistica.LogisticaViajeDetalleVm viaje) => string.Equals(viaje.TipoViaje, "Entrega PT", StringComparison.OrdinalIgnoreCase);
    public static string TipoViajeVisible(ERP.NSQuell.Models.ViewModels.Logistica.LogisticaViajeDetalleVm viaje)
    {
        if (string.Equals(viaje.TipoViaje, "Entrega PT", StringComparison.OrdinalIgnoreCase)) return "Entrega";
        if (string.Equals(viaje.TipoViaje, "Ruta multipropósito", StringComparison.OrdinalIgnoreCase)) return "Ruta multiparada";
        return TxtVisible(viaje.TipoViaje);
    }
    public static string TipoParadaVisible(string? tipo)
    {
        var valor = Txt(tipo);
        return valor switch
        {
            "Recoleccion" => "Recolección",
            "Origen" => "Origen",
            "Entrega" => "Entrega",
            "Traslado" => "Traslado",
            "Servicio" => "Servicio",
            "Retorno" => "Retorno",
            _ => valor
        };
    }
    public static string OperacionVisible(string? operacion)
    {
        if (string.IsNullOrWhiteSpace(operacion)) return "Parada operativa";
        return operacion.Trim().Replace("Entrega PT", "Entrega", StringComparison.OrdinalIgnoreCase).Replace("Entrega NS", "Entrega", StringComparison.OrdinalIgnoreCase);
    }
    public static string EstadoClase(string? estatus)
    {
        return estatus switch
        {
            "En curso" => "estado-curso",
            "Programado" => "estado-programado",
            "Completado" => "estado-completado",
            "Cancelado" => "estado-cancelado",
            _ => "estado-neutral"
        };
    }
    public static string FechaHoraProgramada(ERP.NSQuell.Models.ViewModels.Logistica.LogisticaViajeDetalleVm viaje)
    {
        return viaje.HoraSalidaProgramada.HasValue ? $"{viaje.FechaProgramada:dd/MM/yyyy} {viaje.HoraSalidaProgramada.Value:hh\\:mm}" : viaje.FechaProgramada.ToString("dd/MM/yyyy");
    }
}

@section Styles {
    <style>
        :root {
            --azul: #004aad;
            --azul-oscuro: #00347a;
            --verde: #107c41;
            --amarillo: #b54708;
            --rojo: #b42318;
            --gris: #667085;
            --borde: #dbe4f0;
            --fondo: #f3f6fa;
            --texto: #172033
        }

        * {
            box-sizing: border-box
        }

        body {
            margin: 0;
            background: var(--fondo);
            color: var(--texto);
            font-family: "Segoe UI",Arial,sans-serif
        }

        .page {
            max-width: 1700px;
            margin: auto;
            padding: 20px
        }

        .hero {
            background: linear-gradient(135deg,var(--azul-oscuro),var(--azul));
            color: #fff;
            border-radius: 22px;
            padding: 20px 22px;
            margin-bottom: 14px;
            box-shadow: 0 18px 42px rgba(0,74,173,.2)
        }

            .hero h1 {
                margin: 0;
                font-size: 1.65rem;
                font-weight: 950
            }

            .hero p {
                margin: 5px 0 0;
                color: rgba(255,255,255,.86);
                font-weight: 650
            }

        .hero-actions {
            display: flex;
            gap: 8px;
            flex-wrap: wrap
        }

        .btn-hero {
            display: inline-flex;
            align-items: center;
            gap: 7px;
            border: 1px solid rgba(255,255,255,.35);
            border-radius: 12px;
            padding: 9px 13px;
            color: #fff;
            text-decoration: none;
            font-weight: 900;
            background: rgba(255,255,255,.12)
        }

            .btn-hero:hover {
                background: #fff;
                color: var(--azul)
            }

        .resumen-linea {
            display: flex;
            align-items: center;
            flex-wrap: wrap;
            gap: 8px 18px;
            padding: 10px 14px;
            margin-bottom: 14px;
            background: #fff;
            border: 1px solid var(--borde);
            border-radius: 14px;
            color: var(--gris);
            font-size: .78rem;
            font-weight: 800
        }

            .resumen-linea strong {
                color: var(--azul-oscuro);
                font-size: .95rem;
                font-weight: 950
            }

            .resumen-linea .en-curso strong {
                color: var(--verde)
            }

        .panel {
            background: #fff;
            border: 1px solid var(--borde);
            border-radius: 20px;
            box-shadow: 0 10px 28px rgba(15,23,42,.06);
            overflow: hidden;
            margin-bottom: 16px
        }

        .panel-head {
            min-height: 52px;
            padding: 13px 17px;
            background: #f8fbff;
            border-bottom: 1px solid var(--borde);
            color: var(--azul-oscuro);
            font-weight: 950;
            display: flex;
            align-items: center;
            justify-content: space-between;
            gap: 10px
        }

            .panel-head small {
                color: var(--gris);
                font-weight: 800
            }

        .panel-body {
            padding: 10px 14px 14px
        }

        .table-wrap {
            overflow-x: auto
        }

        .viajes-table {
            width: 100%;
            border-collapse: separate;
            border-spacing: 0 8px;
            min-width: 1240px
        }

            .viajes-table th {
                padding: 7px 10px;
                color: var(--gris);
                font-size: .7rem;
                text-transform: uppercase;
                letter-spacing: .04em;
                text-align: left;
                white-space: nowrap
            }

            .viajes-table td {
                padding: 11px 10px;
                border-top: 1px solid var(--borde);
                border-bottom: 1px solid var(--borde);
                background: #fff;
                vertical-align: middle
            }

                .viajes-table td:first-child {
                    border-left: 1px solid var(--borde);
                    border-radius: 13px 0 0 13px
                }

                .viajes-table td:last-child {
                    border-right: 1px solid var(--borde);
                    border-radius: 0 13px 13px 0
                }

            .viajes-table tbody tr:hover td {
                background: #f8fbff
            }

            .viajes-table tr.viaje-curso td:first-child {
                border-left: 4px solid var(--verde)
            }

            .viajes-table tr.viaje-programado td:first-child {
                border-left: 4px solid var(--azul)
            }

            .viajes-table tr.viaje-completado td:first-child {
                border-left: 4px solid #98a2b3
            }

        .main {
            color: var(--azul-oscuro);
            font-weight: 950
        }

        .sub {
            margin-top: 2px;
            color: var(--gris);
            font-size: .78rem;
            font-weight: 650
        }

        .multi-tag {
            display: inline-flex;
            align-items: center;
            gap: 5px;
            margin-top: 5px;
            padding: 4px 7px;
            border: 1px solid #b9d3f6;
            border-radius: 999px;
            background: #f0f6ff;
            color: var(--azul);
            font-size: .67rem;
            font-weight: 950;
            white-space: nowrap
        }

        .route-progress {
            min-width: 190px
        }

        .route-progress-top {
            display: flex;
            align-items: center;
            justify-content: space-between;
            gap: 8px;
            color: var(--texto);
            font-size: .76rem;
            font-weight: 900
        }

        .route-progress-track {
            height: 6px;
            margin-top: 5px;
            overflow: hidden;
            border-radius: 999px;
            background: #e8eef6
        }

            .route-progress-track span {
                display: block;
                height: 100%;
                border-radius: inherit;
                background: var(--azul)
            }

        .next-stop-box {
            min-width: 225px;
            max-width: 300px;
            margin-top: 7px;
            padding: 8px 9px;
            border: 1px solid #d9e7f8;
            border-radius: 11px;
            background: #f8fbff
        }

        .next-stop-head {
            display: flex;
            align-items: flex-start;
            gap: 8px
        }

        .next-stop-number {
            display: inline-flex;
            width: 25px;
            height: 25px;
            flex: 0 0 25px;
            align-items: center;
            justify-content: center;
            border-radius: 50%;
            background: var(--azul);
            color: #fff;
            font-size: .69rem;
            font-weight: 950
        }

        .next-stop-name {
            display: block;
            max-width: 225px;
            overflow: hidden;
            color: var(--azul-oscuro);
            font-size: .76rem;
            font-weight: 950;
            text-overflow: ellipsis;
            white-space: nowrap
        }

        .next-stop-meta {
            display: block;
            margin-top: 1px;
            color: var(--gris);
            font-size: .68rem;
            font-weight: 750
        }

        .next-stop-state {
            display: inline-flex;
            align-items: center;
            gap: 4px;
            margin-top: 5px;
            color: var(--verde);
            font-size: .68rem;
            font-weight: 900
        }

        .route-complete {
            display: inline-flex;
            align-items: center;
            gap: 5px;
            margin-top: 6px;
            color: var(--verde);
            font-size: .72rem;
            font-weight: 950
        }

        .mobile-route-status {
            margin-top: 9px;
            padding: 9px 10px;
            border: 1px solid #d9e7f8;
            border-radius: 12px;
            background: #f8fbff
        }

        .estado {
            display: inline-flex;
            align-items: center;
            gap: 5px;
            border-radius: 999px;
            padding: 6px 9px;
            font-size: .72rem;
            font-weight: 950;
            white-space: nowrap
        }

        .estado-curso {
            background: #ecfdf3;
            color: var(--verde)
        }

        .estado-programado {
            background: #eff6ff;
            color: var(--azul)
        }

        .estado-completado {
            background: #f2f4f7;
            color: #475467
        }

        .estado-cancelado {
            background: #fef3f2;
            color: var(--rojo)
        }

        .estado-neutral {
            background: #f2f4f7;
            color: var(--gris)
        }

        .btn-abrir {
            display: inline-flex;
            align-items: center;
            justify-content: center;
            gap: 7px;
            min-width: 126px;
            min-height: 42px;
            border-radius: 11px;
            padding: 9px 12px;
            background: var(--azul);
            color: #fff;
            text-decoration: none;
            font-weight: 950;
            white-space: nowrap
        }

            .btn-abrir:hover {
                background: var(--azul-oscuro);
                color: #fff
            }

            .btn-abrir.en-curso {
                background: var(--verde)
            }

                .btn-abrir.en-curso:hover {
                    background: #0c6534
                }

        .empty {
            padding: 34px 18px;
            text-align: center;
            color: var(--gris);
            font-weight: 800
        }

            .empty i {
                display: block;
                margin-bottom: 8px;
                font-size: 1.8rem;
                color: #98a2b3
            }

        .alert {
            border-radius: 14px;
            font-weight: 800
        }

        .mobile-list {
            display: none
        }

        .mobile-row {
            border-bottom: 1px solid var(--borde);
            padding: 13px 2px
        }

            .mobile-row:last-child {
                border-bottom: 0
            }

        .mobile-top {
            display: flex;
            justify-content: space-between;
            gap: 10px;
            align-items: flex-start
        }

        .mobile-route {
            margin-top: 8px;
            color: var(--texto);
            font-size: .87rem;
            font-weight: 800
        }

        .mobile-meta {
            display: grid;
            grid-template-columns: 1fr 1fr;
            gap: 5px 10px;
            margin-top: 8px;
            color: var(--gris);
            font-size: .76rem;
            font-weight: 700
        }

        .mobile-action {
            margin-top: 10px
        }

            .mobile-action .btn-abrir {
                width: 100%
            }

        html[data-nsq-theme="dark"] {
            --fondo: #08111e;
            --texto: #edf3fb;
            --gris: #9aabc1;
            --borde: #2c3e55;
            color-scheme: dark
        }

            html[data-nsq-theme="dark"] .panel,
            html[data-nsq-theme="dark"] .resumen-linea,
            html[data-nsq-theme="dark"] .viajes-table td {
                background: #111c2d
            }

            html[data-nsq-theme="dark"] .panel-head {
                background: #0d1828
            }

            html[data-nsq-theme="dark"] .viajes-table tbody tr:hover td {
                background: #132338
            }

            html[data-nsq-theme="dark"] .multi-tag {
                background: #142744;
                border-color: #315b8b;
                color: #bfd9ff
            }

            html[data-nsq-theme="dark"] .route-progress-track {
                background: #26374d
            }

            html[data-nsq-theme="dark"] .next-stop-box,
            html[data-nsq-theme="dark"] .mobile-route-status {
                background: #0d1828;
                border-color: #29435f
            }

            html[data-nsq-theme="dark"] .next-stop-name {
                color: #edf3fb
            }

        @@media(max-width:800px) {
            .page {
                padding: 10px
            }

            .hero {
                border-radius: 18px;
                padding: 17px
            }

                .hero h1 {
                    font-size: 1.4rem
                }

            .hero-actions {
                width: 100%
            }

            .btn-hero {
                flex: 1;
                justify-content: center
            }

            .resumen-linea {
                gap: 7px 13px;
                padding: 9px 11px
            }

            .table-wrap {
                display: none
            }

            .mobile-list {
                display: block
            }

            .panel-body {
                padding: 4px 13px 8px
            }
        }
    </style>
}

<div class="page">
    <section class="hero">
        <div class="d-flex justify-content-between align-items-start flex-wrap gap-3">
            <div>
                <h1><i class="fa-solid fa-truck-fast me-2"></i>Mis viajes</h1>
                <p>@nombreChofer · consulta tus viajes asignados, el avance de la ruta y la próxima parada. En los viajes de Entrega también puedes revisar o continuar la carga física desde el detalle.</p>
            </div>
            <div class="hero-actions">
                <a href="@Url.Action("Index", "LogisticaChofer")" class="btn-hero">
                    <i class="fa-solid fa-rotate-right"></i>
                    Actualizar
                </a>
            </div>
        </div>
    </section>

    @if (TempData["LogisticaOk"] != null)
    {
        <div class="alert alert-success">@TempData["LogisticaOk"]</div>
    }

    @if (TempData["LogisticaError"] != null)
    {
        <div class="alert alert-danger">@TempData["LogisticaError"]</div>
    }

    <div class="resumen-linea">
        <span>Total <strong>@totalViajes</strong></span>
        <span>Programados <strong>@programados</strong></span>
        <span class="en-curso">En curso <strong>@enCurso</strong></span>
        <span>Completados hoy <strong>@completadosHoy</strong></span>
        <span><i class="fa-regular fa-calendar me-1"></i>@DateTime.Today.ToString("dd/MM/yyyy")</span>
    </div>

    @if (hayEntregas)
    {
        <div class="alert alert-primary d-flex align-items-start gap-2">
            <i class="fa-solid fa-boxes-stacked mt-1"></i>
            <div><strong>Carga física compartida.</strong> Cuando la ruta incluye una Entrega, Centro Operativo y el chofer trabajan sobre el mismo embarque. Una entrega completada no termina automáticamente un viaje multiparada: el recorrido continúa hasta atender las paradas restantes y regresar a planta.</div>
        </div>
    }

    @if (viajesEnCurso.Any())
    {
        <section class="panel">
            <div class="panel-head">
                <span><i class="fa-solid fa-location-arrow me-2"></i>Viaje en curso</span>
                <small>@viajesEnCurso.Count activo@(viajesEnCurso.Count == 1 ? "" : "s")</small>
            </div>
            <div class="panel-body">
                <div class="table-wrap">
                    <table class="viajes-table">
                        <thead>
                            <tr>
                                <th>Viaje</th>
                                <th>Salida</th>
                                <th>Recorrido</th>
                                <th>Progreso / próxima parada</th>
                                <th>Unidad</th>
                                <th>Estado</th>
                                <th></th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var viaje in viajesEnCurso)
                            {
                                var proxima = viaje.ProximaParada;
                                var porcentaje = viaje.TotalParadas <= 0 ? 0m : Math.Round(Math.Min(100m, (decimal)viaje.ParadasCompletadas * 100m / viaje.TotalParadas), 1);
                                var progresoStyle = $"width:{porcentaje.ToString("0.##", System.Globalization.CultureInfo.InvariantCulture)}%;";
                                <tr class="viaje-curso">
                                    <td>
                                        <div class="main">@viaje.Folio</div>
                                        <div class="sub">@TipoViajeVisible(viaje)</div>
                                        <div class="sub">@TxtVisible(viaje.Motivo)</div>
                                        @if (viaje.EsMultiParada)
                                        {
                                            <span class="multi-tag"><i class="fa-solid fa-code-branch"></i>Ruta multiparada</span>
                                        }
                                    </td>
                                    <td>
                                        <div class="main">@(viaje.FechaSalidaReal?.ToString("HH:mm") ?? "-")</div>
                                        <div class="sub">@(viaje.FechaSalidaReal?.ToString("dd/MM/yyyy") ?? viaje.FechaProgramada.ToString("dd/MM/yyyy"))</div>
                                    </td>
                                    <td>
                                        <div class="main">@Txt(viaje.Origen) <i class="fa-solid fa-arrow-right-long mx-1"></i> @Txt(viaje.Destino)</div>
                                        @if (viaje.TotalParadas > 0)
                                        {
                                            <div class="sub">@viaje.TotalParadas parada@(viaje.TotalParadas == 1 ? "" : "s") en la ruta</div>
                                        }
                                    </td>
                                    <td>
                                        @if (viaje.TotalParadas > 0)
                                        {
                                            <div class="route-progress">
                                                <div class="route-progress-top">
                                                    <span>@viaje.ParadasCompletadas / @viaje.TotalParadas atendidas</span>
                                                    <span>@porcentaje.ToString("N0")%</span>
                                                </div>
                                                <div class="route-progress-track"><span style="@progresoStyle"></span></div>
                                                @if (viaje.ParadasPendientes > 0)
                                                {
                                                    <div class="sub">@viaje.ParadasPendientes pendiente@(viaje.ParadasPendientes == 1 ? "" : "s")</div>
                                                }
                                            </div>
                                        }
                                        @if (proxima != null)
                                        {
                                            <div class="next-stop-box">
                                                <div class="next-stop-head">
                                                    <span class="next-stop-number">@proxima.Secuencia</span>
                                                    <div>
                                                        <span class="next-stop-name" title="@proxima.Lugar">@Txt(proxima.Lugar)</span>
                                                        <span class="next-stop-meta">@TipoParadaVisible(proxima.TipoParada) · @OperacionVisible(proxima.TipoOperacion)</span>
                                                        @if (proxima.FechaHoraLlegadaProgramada.HasValue)
                                                        {
                                                            <span class="next-stop-meta"><i class="fa-regular fa-clock me-1"></i>@proxima.FechaHoraLlegadaProgramada.Value.ToString("dd/MM HH:mm")</span>
                                                        }
                                                        <span class="next-stop-state"><i class="fa-solid fa-location-dot"></i>@Txt(proxima.Estatus)</span>
                                                    </div>
                                                </div>
                                            </div>
                                        }
                                        else if (viaje.TotalParadas > 0 && viaje.ParadasPendientes == 0)
                                        {
                                            <span class="route-complete"><i class="fa-solid fa-circle-check"></i>Ruta atendida</span>
                                        }
                                        else if (viaje.TotalParadas <= 0)
                                        {
                                            <div class="sub">Sin paradas configuradas</div>
                                        }
                                    </td>
                                    <td>
                                        <div class="main">@viaje.UnidadMostrar</div>
                                        <div class="sub">@Txt(viaje.Ruta)</div>
                                    </td>
                                    <td>
                                        <span class="estado @EstadoClase(viaje.Estatus)"><i class="fa-solid fa-circle"></i>@viaje.Estatus</span>
                                        @if (viaje.TieneIncidencia)
                                        {
                                            <div class="sub text-danger fw-bold"><i class="fa-solid fa-triangle-exclamation me-1"></i>Con incidencia</div>
                                        }
                                    </td>
                                    <td class="text-end">
                                        <a class="btn-abrir en-curso" href="@Url.Action("Detalle", "LogisticaChofer", new { id = viaje.ViajeID })">
                                            <i class="fa-solid fa-arrow-right"></i>
                                            Continuar
                                        </a>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
                <div class="mobile-list">
                    @foreach (var viaje in viajesEnCurso)
                    {
                        var proxima = viaje.ProximaParada;
                        var porcentaje = viaje.TotalParadas <= 0 ? 0m : Math.Round(Math.Min(100m, (decimal)viaje.ParadasCompletadas * 100m / viaje.TotalParadas), 1);
                        var progresoStyle = $"width:{porcentaje.ToString("0.##", System.Globalization.CultureInfo.InvariantCulture)}%;";
                        <div class="mobile-row">
                            <div class="mobile-top">
                                <div>
                                    <div class="main">@viaje.Folio</div>
                                    <div class="sub">@TipoViajeVisible(viaje) · salida @(viaje.FechaSalidaReal?.ToString("dd/MM/yyyy HH:mm") ?? "-")</div>
                                    @if (viaje.EsMultiParada)
                                    {
                                        <span class="multi-tag"><i class="fa-solid fa-code-branch"></i>Ruta multiparada</span>
                                    }
                                </div>
                                <span class="estado @EstadoClase(viaje.Estatus)">@viaje.Estatus</span>
                            </div>
                            <div class="mobile-route">@Txt(viaje.Origen) <i class="fa-solid fa-arrow-right-long mx-1"></i> @Txt(viaje.Destino)</div>
                            @if (viaje.TotalParadas > 0)
                            {
                                <div class="mobile-route-status">
                                    <div class="route-progress-top"><span>@viaje.ParadasCompletadas / @viaje.TotalParadas atendidas</span><span>@porcentaje.ToString("N0")%</span></div>
                                    <div class="route-progress-track"><span style="@progresoStyle"></span></div>
                                    @if (proxima != null)
                                    {
                                        <div class="next-stop-box">
                                            <div class="next-stop-head">
                                                <span class="next-stop-number">@proxima.Secuencia</span>
                                                <div>
                                                    <span class="next-stop-name">@Txt(proxima.Lugar)</span>
                                                    <span class="next-stop-meta">@TipoParadaVisible(proxima.TipoParada) · @OperacionVisible(proxima.TipoOperacion)</span>
                                                    <span class="next-stop-state"><i class="fa-solid fa-location-dot"></i>@Txt(proxima.Estatus)</span>
                                                </div>
                                            </div>
                                        </div>
                                    }
                                </div>
                            }
                            <div class="mobile-meta">
                                <span><i class="fa-solid fa-truck me-1"></i>@viaje.UnidadMostrar</span>
                                <span><i class="fa-solid fa-route me-1"></i>@Txt(viaje.Ruta)</span>
                                @if (viaje.TieneIncidencia)
                                {
                                    <span class="text-danger fw-bold"><i class="fa-solid fa-triangle-exclamation me-1"></i>Incidencia</span>
                                }
                            </div>
                            <div class="mobile-action">
                                <a class="btn-abrir en-curso" href="@Url.Action("Detalle", "LogisticaChofer", new { id = viaje.ViajeID })">
                                    <i class="fa-solid fa-arrow-right"></i>
                                    Continuar viaje
                                </a>
                            </div>
                        </div>
                    }
                </div>
            </div>
        </section>
    }

    <section class="panel">
        <div class="panel-head">
            <span><i class="fa-regular fa-clock me-2"></i>Próximos viajes</span>
            <small>@viajesProgramados.Count pendiente@(viajesProgramados.Count == 1 ? "" : "s")</small>
        </div>
        <div class="panel-body">
            @if (viajesProgramados.Any())
            {
                <div class="table-wrap">
                    <table class="viajes-table">
                        <thead>
                            <tr>
                                <th>Viaje</th>
                                <th>Programado</th>
                                <th>Recorrido</th>
                                <th>Ruta / primera parada</th>
                                <th>Unidad</th>
                                <th>Estado</th>
                                <th></th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var viaje in viajesProgramados)
                            {
                                var proxima = viaje.ProximaParada;
                                <tr class="viaje-programado">
                                    <td>
                                        <div class="main">@viaje.Folio</div>
                                        <div class="sub">@TipoViajeVisible(viaje)</div>
                                        <div class="sub">@TxtVisible(viaje.Motivo)</div>
                                        @if (viaje.EsMultiParada)
                                        {
                                            <span class="multi-tag"><i class="fa-solid fa-code-branch"></i>Ruta multiparada</span>
                                        }
                                    </td>
                                    <td>
                                        <div class="main">@FechaHoraProgramada(viaje)</div>
                                        <div class="sub">Salida programada</div>
                                    </td>
                                    <td>
                                        <div class="main">@Txt(viaje.Origen) <i class="fa-solid fa-arrow-right-long mx-1"></i> @Txt(viaje.Destino)</div>
                                        @if (viaje.TotalParadas > 0)
                                        {
                                            <div class="sub">@viaje.TotalParadas parada@(viaje.TotalParadas == 1 ? "" : "s") programada@(viaje.TotalParadas == 1 ? "" : "s")</div>
                                        }
                                    </td>
                                    <td>
                                        @if (viaje.TotalParadas > 0)
                                        {
                                            <div class="route-progress">
                                                <div class="route-progress-top"><span>@viaje.ParadasCompletadas / @viaje.TotalParadas atendidas</span><span>@viaje.ParadasPendientes pendientes</span></div>
                                                <div class="route-progress-track"><span style="width:0%;"></span></div>
                                            </div>
                                        }
                                        @if (proxima != null)
                                        {
                                            <div class="next-stop-box">
                                                <div class="next-stop-head">
                                                    <span class="next-stop-number">@proxima.Secuencia</span>
                                                    <div>
                                                        <span class="next-stop-name" title="@proxima.Lugar">@Txt(proxima.Lugar)</span>
                                                        <span class="next-stop-meta">@TipoParadaVisible(proxima.TipoParada) · @OperacionVisible(proxima.TipoOperacion)</span>
                                                        @if (proxima.FechaHoraLlegadaProgramada.HasValue)
                                                        {
                                                            <span class="next-stop-meta"><i class="fa-regular fa-clock me-1"></i>@proxima.FechaHoraLlegadaProgramada.Value.ToString("dd/MM HH:mm")</span>
                                                        }
                                                    </div>
                                                </div>
                                            </div>
                                        }
                                        else if (viaje.TotalParadas <= 0)
                                        {
                                            <div class="sub">Sin paradas configuradas</div>
                                        }
                                    </td>
                                    <td>
                                        <div class="main">@viaje.UnidadMostrar</div>
                                        <div class="sub">@Txt(viaje.Ruta)</div>
                                    </td>
                                    <td>
                                        <span class="estado @EstadoClase(viaje.Estatus)"><i class="fa-solid fa-clock"></i>@viaje.Estatus</span>
                                        @if (EsEntrega(viaje))
                                        {
                                            <div class="sub"><i class="fa-solid fa-boxes-stacked me-1"></i>Carga física desde el detalle</div>
                                        }
                                        @if (viaje.TieneIncidencia)
                                        {
                                            <div class="sub text-danger fw-bold"><i class="fa-solid fa-triangle-exclamation me-1"></i>Con incidencia</div>
                                        }
                                    </td>
                                    <td class="text-end">
                                        <a class="btn-abrir" href="@Url.Action("Detalle", "LogisticaChofer", new { id = viaje.ViajeID })">
                                            <i class="fa-solid fa-arrow-right"></i>
                                            @(EsEntrega(viaje) ? "Abrir operación" : "Abrir viaje")
                                        </a>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
                <div class="mobile-list">
                    @foreach (var viaje in viajesProgramados)
                    {
                        var proxima = viaje.ProximaParada;
                        <div class="mobile-row">
                            <div class="mobile-top">
                                <div>
                                    <div class="main">@viaje.Folio</div>
                                    <div class="sub">@TipoViajeVisible(viaje) · @FechaHoraProgramada(viaje)</div>
                                    @if (viaje.EsMultiParada)
                                    {
                                        <span class="multi-tag"><i class="fa-solid fa-code-branch"></i>Ruta multiparada</span>
                                    }
                                </div>
                                <span class="estado @EstadoClase(viaje.Estatus)">@viaje.Estatus</span>
                            </div>
                            <div class="mobile-route">@Txt(viaje.Origen) <i class="fa-solid fa-arrow-right-long mx-1"></i> @Txt(viaje.Destino)</div>
                            @if (viaje.TotalParadas > 0)
                            {
                                <div class="mobile-route-status">
                                    <div class="route-progress-top"><span>@viaje.TotalParadas parada@(viaje.TotalParadas == 1 ? "" : "s")</span><span>@viaje.ParadasPendientes pendientes</span></div>
                                    @if (proxima != null)
                                    {
                                        <div class="next-stop-box">
                                            <div class="next-stop-head">
                                                <span class="next-stop-number">@proxima.Secuencia</span>
                                                <div>
                                                    <span class="next-stop-name">@Txt(proxima.Lugar)</span>
                                                    <span class="next-stop-meta">@TipoParadaVisible(proxima.TipoParada) · @OperacionVisible(proxima.TipoOperacion)</span>
                                                </div>
                                            </div>
                                        </div>
                                    }
                                </div>
                            }
                            @if (EsEntrega(viaje))
                            {
                                <div class="sub mt-2"><i class="fa-solid fa-boxes-stacked me-1"></i>Carga física compartida desde el detalle</div>
                            }
                            <div class="mobile-meta">
                                <span><i class="fa-solid fa-truck me-1"></i>@viaje.UnidadMostrar</span>
                                <span><i class="fa-solid fa-route me-1"></i>@Txt(viaje.Ruta)</span>
                                @if (viaje.TieneIncidencia)
                                {
                                    <span class="text-danger fw-bold"><i class="fa-solid fa-triangle-exclamation me-1"></i>Incidencia</span>
                                }
                            </div>
                            <div class="mobile-action">
                                <a class="btn-abrir" href="@Url.Action("Detalle", "LogisticaChofer", new { id = viaje.ViajeID })">
                                    <i class="fa-solid fa-arrow-right"></i>
                                    @(EsEntrega(viaje) ? "Abrir operación" : "Abrir viaje")
                                </a>
                            </div>
                        </div>
                    }
                </div>
            }
            else
            {
                <div class="empty">
                    <i class="fa-regular fa-calendar-check"></i>
                    No tienes viajes programados pendientes.
                </div>
            }
        </div>
    </section>

    @if (viajesCompletados.Any())
    {
        <section class="panel">
            <div class="panel-head">
                <span><i class="fa-solid fa-check-double me-2"></i>Completados recientes</span>
                <small>Últimos 7 días</small>
            </div>
            <div class="panel-body">
                <div class="table-wrap">
                    <table class="viajes-table">
                        <thead>
                            <tr>
                                <th>Viaje</th>
                                <th>Regreso</th>
                                <th>Recorrido</th>
                                <th>Paradas</th>
                                <th>Unidad</th>
                                <th>Recorrido total</th>
                                <th></th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var viaje in viajesCompletados)
                            {
                                var porcentaje = viaje.TotalParadas <= 0 ? 0m : Math.Round(Math.Min(100m, (decimal)viaje.ParadasCompletadas * 100m / viaje.TotalParadas), 1);
                                var progresoStyle = $"width:{porcentaje.ToString("0.##", System.Globalization.CultureInfo.InvariantCulture)}%;";
                                <tr class="viaje-completado">
                                    <td>
                                        <div class="main">@viaje.Folio</div>
                                        <div class="sub">@TipoViajeVisible(viaje)</div>
                                        <div class="sub">@TxtVisible(viaje.Motivo)</div>
                                        @if (viaje.EsMultiParada)
                                        {
                                            <span class="multi-tag"><i class="fa-solid fa-code-branch"></i>Ruta multiparada</span>
                                        }
                                    </td>
                                    <td>
                                        <div class="main">@(viaje.FechaRegresoReal?.ToString("dd/MM/yyyy HH:mm") ?? "-")</div>
                                    </td>
                                    <td>
                                        <div class="main">@Txt(viaje.Origen) <i class="fa-solid fa-arrow-right-long mx-1"></i> @Txt(viaje.Destino)</div>
                                    </td>
                                    <td>
                                        @if (viaje.TotalParadas > 0)
                                        {
                                            <div class="route-progress">
                                                <div class="route-progress-top"><span>@viaje.ParadasCompletadas / @viaje.TotalParadas atendidas</span><span>@porcentaje.ToString("N0")%</span></div>
                                                <div class="route-progress-track"><span style="@progresoStyle"></span></div>
                                                @if (viaje.ParadasPendientes == 0)
                                                {
                                                    <span class="route-complete"><i class="fa-solid fa-circle-check"></i>Ruta cerrada</span>
                                                }
                                            </div>
                                        }
                                        else
                                        {
                                            <div class="sub">Viaje cerrado</div>
                                        }
                                    </td>
                                    <td>
                                        <div class="main">@viaje.UnidadMostrar</div>
                                        <div class="sub">@Txt(viaje.Ruta)</div>
                                    </td>
                                    <td>
                                        <div class="main">@(viaje.KilometrosUtilizados.HasValue ? $"{viaje.KilometrosUtilizados.Value:N0} km" : "-")</div>
                                    </td>
                                    <td class="text-end">
                                        <a class="btn-abrir" href="@Url.Action("Detalle", "LogisticaChofer", new { id = viaje.ViajeID })">
                                            <i class="fa-regular fa-eye"></i>
                                            Ver
                                        </a>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
                <div class="mobile-list">
                    @foreach (var viaje in viajesCompletados)
                    {
                        var porcentaje = viaje.TotalParadas <= 0 ? 0m : Math.Round(Math.Min(100m, (decimal)viaje.ParadasCompletadas * 100m / viaje.TotalParadas), 1);
                        var progresoStyle = $"width:{porcentaje.ToString("0.##", System.Globalization.CultureInfo.InvariantCulture)}%;";
                        <div class="mobile-row">
                            <div class="mobile-top">
                                <div>
                                    <div class="main">@viaje.Folio</div>
                                    <div class="sub">@TipoViajeVisible(viaje) · regreso @(viaje.FechaRegresoReal?.ToString("dd/MM/yyyy HH:mm") ?? "-")</div>
                                    @if (viaje.EsMultiParada)
                                    {
                                        <span class="multi-tag"><i class="fa-solid fa-code-branch"></i>Ruta multiparada</span>
                                    }
                                </div>
                                <span class="estado @EstadoClase(viaje.Estatus)">@viaje.Estatus</span>
                            </div>
                            <div class="mobile-route">@Txt(viaje.Origen) <i class="fa-solid fa-arrow-right-long mx-1"></i> @Txt(viaje.Destino)</div>
                            @if (viaje.TotalParadas > 0)
                            {
                                <div class="mobile-route-status">
                                    <div class="route-progress-top"><span>@viaje.ParadasCompletadas / @viaje.TotalParadas atendidas</span><span>@porcentaje.ToString("N0")%</span></div>
                                    <div class="route-progress-track"><span style="@progresoStyle"></span></div>
                                </div>
                            }
                            <div class="mobile-meta">
                                <span><i class="fa-solid fa-truck me-1"></i>@viaje.UnidadMostrar</span>
                                <span><i class="fa-solid fa-road me-1"></i>@(viaje.KilometrosUtilizados.HasValue ? $"{viaje.KilometrosUtilizados.Value:N0} km" : "-")</span>
                            </div>
                            <div class="mobile-action">
                                <a class="btn-abrir" href="@Url.Action("Detalle", "LogisticaChofer", new { id = viaje.ViajeID })">
                                    <i class="fa-regular fa-eye"></i>
                                    Ver viaje
                                </a>
                            </div>
                        </div>
                    }
                </div>
            </div>
        </section>
    }
</div>
