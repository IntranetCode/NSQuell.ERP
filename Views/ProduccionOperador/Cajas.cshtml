    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
    <script>
        (() => {
            const formCaja = document.getElementById('formFormarCaja');
            const selectTipo = document.getElementById('tipoCaja');
            const inputCantidad = document.getElementById('cantidadPiezas');
            const textoDisponible = document.getElementById('cantidadDisponible');
            const botonFormar = document.getElementById('btnFormarCaja');

            const actualizarDisponible = () => {
                if (!selectTipo || !inputCantidad || !textoDisponible || !botonFormar) return;

                const option = selectTipo.options[selectTipo.selectedIndex];
                const disponible = Number(option?.dataset?.disponible || 0);

                textoDisponible.textContent = disponible.toLocaleString('es-MX');
                inputCantidad.max = String(disponible);

                if (Number(inputCantidad.value || 0) > disponible) {
                    inputCantidad.value = disponible > 0 ? String(disponible) : '';
                }

                const puedeFormar = disponible > 0 && !selectTipo.disabled;
                inputCantidad.disabled = !puedeFormar;
                botonFormar.disabled = !puedeFormar;
            };

            selectTipo?.addEventListener('change', actualizarDisponible);
            actualizarDisponible();

            formCaja?.addEventListener('submit', event => {
                const disponible = Number(
                    selectTipo?.options[selectTipo.selectedIndex]?.dataset?.disponible || 0
                );
                const cantidad = Number(inputCantidad?.value || 0);

                if (cantidad <= 0 || cantidad > disponible) {
                    event.preventDefault();
                    alert('La cantidad debe ser mayor a cero y no puede exceder lo disponible para el tipo seleccionado.');
                    return;
                }

                const boton = formCaja.querySelector('button[type="submit"]');
                if (boton) {
                    boton.disabled = true;
                    boton.innerHTML = '<i class="fa-solid fa-spinner fa-spin"></i> Formando caja...';
                }
            });

            document.querySelectorAll('form[data-confirm]').forEach(form => {
                form.addEventListener('submit', event => {
                    const mensaje = form.dataset.confirm || 'Confirmar operacion?';

                    if (!window.confirm(mensaje)) {
                        event.preventDefault();
                        return;
                    }

                    const boton = form.querySelector('button[type="submit"]');
                    if (boton) {
                        boton.disabled = true;
                        boton.innerHTML = '<i class="fa-solid fa-spinner fa-spin"></i> Procesando...';
                    }
                });
            });
        })();
    </script>
</body>
</html>
