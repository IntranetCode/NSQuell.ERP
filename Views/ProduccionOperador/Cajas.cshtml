@model ERP.NSQuell.Models.ProduccionOperadorCajasVm
@using System.Linq

@{
    Layout = null;

    var cajas = Model.Cajas ?? new List<ERP.NSQuell.Models.ProduccionOperadorCajaVm>();

    var totalCapturado = Model.CantidadOKTotal + Model.CantidadSospechosaTotal + Model.CantidadScrapTotal;
    var totalEnCajas = cajas.Sum(x => x.CantidadPiezas);

    var pendientesCalidad = cajas.Count(x => x.EstadoCajaID == 2);
    var liberadasCalidad = cajas.Count(x => x.EstadoCajaID >= 3 && x.EtiquetaVerde);
    var enZonaVerde = cajas.Count(x => x.EstadoCajaID == 5);
    var salidasProduccion = cajas.Count(x => x.EstadoCajaID >= 6);

    var pendienteEmpaque = totalCapturado - totalEnCajas;
    if (pendienteEmpaque < 0)
    {
        pendienteEmpaque = 0;
    }

    var avanceCajas = totalCapturado > 0
        ? Math.Round(((decimal)totalEnCajas * 100m) / totalCapturado, 2)
        : 0m;

    if (avanceCajas < 0)
    {
        avanceCajas = 0;
    }

    if (avanceCajas > 100)
    {
        avanceCajas = 100;
    }

    var avanceTexto = avanceCajas.ToString("0.##", System.Globalization.CultureInfo.InvariantCulture);
}

@functions {
    public static string Txt(string value)
    {
        return string.IsNullOrWhiteSpace(value) ? "-" : value.Trim();
    }

    public static string TxtNullable(string value)
    {
        return string.IsNullOrWhiteSpace(value) ? "-" : value.Trim();
    }

    public static string Numero(int value)
    {
        return value.ToString("N0");
    }

    public static string FechaTxt(DateTime? value)
    {
        return value.HasValue
            ? value.Value.ToString("dd/MM/yyyy HH:mm")
            : "-";
    }

    public static string FechaTxtNoNullable(DateTime value)
    {
        return value == DateTime.MinValue
            ? "-"
            : value.ToString("dd/MM/yyyy HH:mm");
    }

    public static string OFTexto(ERP.NSQuell.Models.ProduccionOperadorCajasVm item)
    {
        if (!string.IsNullOrWhiteSpace(item.NumeroOFRecibida))
            return item.NumeroOFRecibida;

        if (!string.IsNullOrWhiteSpace(item.FolioSolicitud))
            return item.FolioSolicitud;

        return "Programa " + item.ProgramaProduccionID.ToString();
    }

    public static string ParteTexto(ERP.NSQuell.Models.ProduccionOperadorCajasVm item)
    {
        if (!string.IsNullOrWhiteSpace(item.ReferenciaSAP))
            return item.ReferenciaSAP;

        if (!string.IsNullOrWhiteSpace(item.NumeroParte))
            return item.NumeroParte;

        return "-";
    }

    public static string EstadoClaseCaja(ERP.NSQuell.Models.ProduccionOperadorCajaVm caja)
    {
        if (caja.EstadoCajaID == 1)
            return "badge-neutral";

        if (caja.EstadoCajaID == 2)
            return "badge-warning";

        if (caja.EstadoCajaID == 3)
            return "badge-success";

        if (caja.EstadoCajaID == 4)
            return "badge-danger";

        if (caja.EstadoCajaID == 5)
            return "badge-green";

        if (caja.EstadoCajaID == 6)
            return "badge-blue";

        if (caja.EstadoCajaID == 7)
            return "badge-darkx";

        return "badge-neutral";
    }

    public static string TipoClase(string tipo)
    {
        var t = string.IsNullOrWhiteSpace(tipo)
            ? ""
            : tipo.Trim().ToUpperInvariant();

        if (t == "OK")
            return "type-ok";

        if (t == "SOSPECHOSO")
            return "type-sos";

        if (t == "SCRAP")
            return "type-scrap";

        if (t == "RETENCION")
            return "type-ret";

        return "type-default";
    }
}

<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <title>Cajas de Producción | Operador</title>
    <meta name="viewport" content="width=device-width, initial-scale=1" />

    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.2/css/all.min.css" rel="stylesheet">

    <style>
        :root {
            --blue: #004AAD;
            --blue-dark: #00347a;
            --green: #107c41;
            --green-bg: #ecfdf3;
            --orange: #b54708;
            --orange-bg: #fff7ed;
            --red: #b42318;
            --red-bg: #fef3f2;
            --gray: #667085;
            --border: #d9e3f1;
            --bg: #f4f7fb;
            --text: #172033;
            --shadow: 0 14px 34px rgba(15, 23, 42, .08);
        }

        body {
            margin: 0;
            min-height: 100vh;
            background: linear-gradient(180deg, #f8fbff 0%, #eef3f9 100%);
            color: var(--text);
            font-family: "Segoe UI", Arial, sans-serif;
        }

        .page {
            max-width: 1700px;
            margin: 0 auto;
            padding: 22px;
        }

        .hero {
            border-radius: 26px;
            padding: 24px 26px;
            margin-bottom: 16px;
            color: #fff;
            background: linear-gradient(135deg, #00347a, #004AAD);
            box-shadow: 0 24px 58px rgba(0, 74, 173, .22);
        }

        .hero-top {
            display: flex;
            justify-content: space-between;
            align-items: flex-start;
            gap: 18px;
            flex-wrap: wrap;
        }

        .hero h1 {
            margin: 0;
            font-size: 1.9rem;
            font-weight: 950;
        }

        .hero p {
            margin: 8px 0 0;
            color: rgba(255,255,255,.86);
            font-weight: 650;
        }

        .hero-actions {
            display: flex;
            gap: 10px;
            flex-wrap: wrap;
        }

        .btn-hero {
            display: inline-flex;
            align-items: center;
            gap: 8px;
            border: 1px solid rgba(255,255,255,.36);
            border-radius: 14px;
            padding: 10px 14px;
            color: #fff;
            text-decoration: none;
            font-weight: 900;
            background: rgba(255,255,255,.14);
        }

            .btn-hero:hover {
                color: var(--blue);
                background: #fff;
            }

        .info-grid {
            display: grid;
            grid-template-columns: repeat(6, minmax(0, 1fr));
            gap: 12px;
            margin-bottom: 16px;
        }

        .info {
            border: 1px solid var(--border);
            border-radius: 18px;
            background: #fff;
            padding: 14px;
            box-shadow: var(--shadow);
        }

        .k {
            color: var(--gray);
            font-size: .72rem;
            font-weight: 950;
            letter-spacing: .04em;
            text-transform: uppercase;
        }

        .v {
            margin-top: 4px;
            color: var(--blue-dark);
            font-size: 1.05rem;
            font-weight: 950;
            line-height: 1.15;
            word-break: break-word;
        }

        .sub {
            margin-top: 3px;
            color: var(--gray);
            font-size: .84rem;
            font-weight: 650;
        }

        .metrics {
            display: grid;
            grid-template-columns: repeat(6, minmax(0, 1fr));
            gap: 12px;
            margin-bottom: 16px;
        }

        .metric {
            border: 1px solid var(--border);
            border-radius: 18px;
            background: #fff;
            padding: 15px;
            box-shadow: var(--shadow);
        }

            .metric .num {
                margin-top: 4px;
                font-size: 1.65rem;
                font-weight: 950;
                line-height: 1;
            }

        .progress-wrap {
            border: 1px solid var(--border);
            border-radius: 18px;
            background: #fff;
            padding: 15px;
            margin-bottom: 16px;
            box-shadow: var(--shadow);
        }

        .progress {
            height: 14px;
            border-radius: 999px;
            background: #e9eef7;
        }

        .progress-bar {
            border-radius: 999px;
            background: var(--blue);
        }

        .flow-metrics {
            display: grid;
            grid-template-columns: repeat(4, minmax(0, 1fr));
            gap: 12px;
            margin-bottom: 16px;
        }

        .availability-box {
            border: 1px solid #bfdbfe;
            border-radius: 16px;
            background: #eff6ff;
            color: #1d4ed8;
            padding: 12px 14px;
            font-weight: 850;
        }

        .availability-number {
            font-size: 1.18rem;
            font-weight: 950;
        }

        .layout {
            display: grid;
            grid-template-columns: minmax(390px, .42fr) minmax(0, .58fr);
            gap: 16px;
            align-items: start;
        }

        .panel {
            border: 1px solid var(--border);
            border-radius: 22px;
            background: #fff;
            box-shadow: var(--shadow);
            overflow: hidden;
            margin-bottom: 16px;
        }

        .panel-head {
            padding: 16px 18px;
            border-bottom: 1px solid var(--border);
            background: linear-gradient(180deg, #ffffff, #f8fbff);
            color: var(--blue-dark);
            font-size: 1.05rem;
            font-weight: 950;
        }

        .panel-body {
            padding: 18px;
        }

        .note {
            border: 1px solid #bfdbfe;
            border-radius: 16px;
            background: #eff6ff;
            color: #1d4ed8;
            padding: 12px 14px;
            font-weight: 750;
        }

        .warn-note {
            border: 1px solid #fed7aa;
            border-radius: 16px;
            background: #fff7ed;
            color: #9a3412;
            padding: 12px 14px;
            font-weight: 750;
        }

        .danger-note {
            border: 1px solid #fecdca;
            border-radius: 16px;
            background: #fef3f2;
            color: var(--red);
            padding: 12px 14px;
            font-weight: 750;
        }

        .success-note {
            border: 1px solid #abefc6;
            border-radius: 16px;
            background: #ecfdf3;
            color: #067647;
            padding: 12px 14px;
            font-weight: 750;
        }

        .form-label {
            color: #344054;
            font-size: .76rem;
            font-weight: 950;
            letter-spacing: .04em;
            text-transform: uppercase;
        }

        .form-control,
        .form-select {
            border: 1px solid var(--border);
            border-radius: 14px;
            padding: 11px 12px;
            box-shadow: none;
        }

            .form-control:focus,
            .form-select:focus {
                border-color: var(--blue);
                box-shadow: 0 0 0 .22rem rgba(0, 74, 173, .12);
            }

        .btn-main,
        .btn-green,
        .btn-warningx,
        .btn-blue,
        .btn-mutedx {
            display: inline-flex;
            align-items: center;
            justify-content: center;
            gap: 9px;
            width: 100%;
            border-radius: 16px;
            padding: 12px 14px;
            font-weight: 950;
            border: 1px solid transparent;
            text-decoration: none;
        }

        .btn-main {
            background: var(--blue);
            border-color: var(--blue);
            color: #fff;
        }

            .btn-main:hover {
                background: var(--blue-dark);
                border-color: var(--blue-dark);
                color: #fff;
            }

        .btn-green {
            background: var(--green);
            border-color: var(--green);
            color: #fff;
        }

        .btn-warningx {
            background: #f79009;
            border-color: #f79009;
            color: #fff;
        }

        .btn-blue {
            background: #2563eb;
            border-color: #2563eb;
            color: #fff;
        }

        .btn-mutedx {
            background: #f2f4f7;
            border-color: #d0d5dd;
            color: #344054;
        }

        .disabled-area {
            opacity: .58;
            pointer-events: none;
        }

        .table-wrap {
            width: 100%;
            overflow-x: auto;
        }

        .table {
            margin-bottom: 0;
            vertical-align: middle;
        }

            .table thead th {
                background: #f8fbff;
                color: #344054;
                font-size: .74rem;
                text-transform: uppercase;
                letter-spacing: .04em;
                font-weight: 950;
                border-bottom: 1px solid var(--border);
                white-space: nowrap;
            }

            .table tbody td {
                border-color: #eef2f7;
                font-weight: 650;
                white-space: nowrap;
            }

        .badge-flow {
            display: inline-flex;
            align-items: center;
            gap: 6px;
            border-radius: 999px;
            padding: 7px 10px;
            font-size: .78rem;
            font-weight: 950;
        }

        .badge-neutral {
            color: #344054;
            background: #f2f4f7;
            border: 1px solid #d0d5dd;
        }

        .badge-warning {
            color: #9a3412;
            background: #fff7ed;
            border: 1px solid #fed7aa;
        }

        .badge-success {
            color: #067647;
            background: #ecfdf3;
            border: 1px solid #abefc6;
        }

        .badge-danger {
            color: #b42318;
            background: #fef3f2;
            border: 1px solid #fecdca;
        }

        .badge-green {
            color: #05603a;
            background: #d1fadf;
            border: 1px solid #75e0a7;
        }

        .badge-blue {
            color: #1d4ed8;
            background: #eff6ff;
            border: 1px solid #bfdbfe;
        }

        .badge-darkx {
            color: #fff;
            background: #344054;
            border: 1px solid #344054;
        }

        .type-pill {
            display: inline-flex;
            align-items: center;
            justify-content: center;
            border-radius: 999px;
            padding: 6px 10px;
            font-size: .76rem;
            font-weight: 950;
            border: 1px solid transparent;
        }

        .type-ok {
            color: #067647;
            background: #ecfdf3;
            border-color: #abefc6;
        }

        .type-sos {
            color: #9a3412;
            background: #fff7ed;
            border-color: #fed7aa;
        }

        .type-scrap {
            color: #b42318;
            background: #fef3f2;
            border-color: #fecdca;
        }

        .type-ret {
            color: #78350f;
            background: #fef3c7;
            border-color: #fde68a;
        }

        .type-default {
            color: #344054;
            background: #f2f4f7;
            border-color: #d0d5dd;
        }

        .actions-grid {
            display: grid;
            grid-template-columns: repeat(3, minmax(140px, 1fr));
            gap: 8px;
            min-width: 440px;
        }

        .small-form {
            margin: 0;
        }

        .scan-row {
            display: flex;
            gap: 8px;
            align-items: center;
        }

            .scan-row input {
                min-width: 170px;
            }

        .empty {
            border: 1px dashed #cbd5e1;
            border-radius: 18px;
            padding: 28px;
            text-align: center;
            color: #64748b;
            font-weight: 800;
            background: #f8fafc;
        }

        @@media (max-width: 1280px) {
            .layout {
                grid-template-columns: 1fr;
            }

            .metrics {
                grid-template-columns: repeat(3, minmax(0, 1fr));
            }

            .flow-metrics {
                grid-template-columns: repeat(2, minmax(0, 1fr));
            }

            .info-grid {
                grid-template-columns: repeat(2, minmax(0, 1fr));
            }
        }

        @@media (max-width: 760px) {
            .page {
                padding: 14px;
            }

            .hero {
                border-radius: 22px;
                padding: 20px;
            }

                .hero h1 {
                    font-size: 1.45rem;
                }

            .metrics,
            .info-grid,
            .flow-metrics {
                grid-template-columns: 1fr;
            }

            .actions-grid {
                grid-template-columns: 1fr;
                min-width: 260px;
            }

            .scan-row {
                flex-direction: column;
                align-items: stretch;
            }
        }
    </style>
</head>

<body>
    <div class="page">

        <section class="hero">
            <div class="hero-top">
                <div>
                    <h1>
                        <i class="fa-solid fa-boxes-stacked me-2"></i>
                        Cajas de Producción
                    </h1>
                    <p>
                        Punto 12 al 16: formar caja, solicitar Calidad, mover a zona verde, escanear salida y esperar recepción de Almacén.
                    </p>
                </div>

                <div class="hero-actions">
                    <a href="@Url.Action("Index", "ProduccionOperador")" class="btn-hero">
                        <i class="fa-solid fa-arrow-left"></i>
                        Kiosko
                    </a>

                    <a href="@Url.Action("Captura", "ProduccionOperador", new { id = Model.EjecucionProduccionID })" class="btn-hero">
                        <i class="fa-solid fa-keyboard"></i>
                        Captura
                    </a>

                    <a href="@Url.Action("Cajas", "ProduccionOperador", new { id = Model.EjecucionProduccionID })" class="btn-hero">
                        <i class="fa-solid fa-rotate-right"></i>
                        Actualizar
                    </a>
                </div>
            </div>
        </section>

        @if (TempData["Success"] != null)
        {
            <div class="alert alert-success rounded-4 fw-bold">
                <i class="fa-solid fa-circle-check me-1"></i>
                @TempData["Success"]
            </div>
        }

        @if (TempData["Error"] != null)
        {
            <div class="alert alert-danger rounded-4 fw-bold">
                <i class="fa-solid fa-triangle-exclamation me-1"></i>
                @TempData["Error"]
            </div>
        }

        <section class="info-grid">
            <div class="info">
                <div class="k">OF / Solicitud</div>
                <div class="v">@OFTexto(Model)</div>
                <div class="sub">
                    @if (Model.SolicitudProduccionID.HasValue)
                    {
                        <span>Solicitud @Model.SolicitudProduccionID.Value</span>
                    }
                    else
                    {
                        <span>Sin solicitud vinculada</span>
                    }
                </div>
            </div>

            <div class="info">
                <div class="k">Cliente</div>
                <div class="v">@TxtNullable(Model.ClienteNombre)</div>
                <div class="sub">Programa @Model.ProgramaProduccionID</div>
            </div>

            <div class="info">
                <div class="k">Máquina</div>
                <div class="v">@TxtNullable(Model.MaquinaCodigo)</div>
                <div class="sub">@TxtNullable(Model.MaquinaNombre)</div>
            </div>

            <div class="info">
                <div class="k">Parte</div>
                <div class="v">@ParteTexto(Model)</div>
                <div class="sub">@TxtNullable(Model.DescripcionParte)</div>
            </div>

            <div class="info">
                <div class="k">Molde</div>
                <div class="v">@TxtNullable(Model.MoldeCodigo)</div>
                <div class="sub">
                    @TxtNullable(Model.MaterialCodigo)
                    @if (!string.IsNullOrWhiteSpace(Model.MaterialDescripcion))
                    {
                        <span> · @Model.MaterialDescripcion</span>
                    }
                </div>
            </div>

            <div class="info">
                <div class="k">Estatus producción</div>
                <div class="v">@Model.EstatusNombre</div>
                <div class="sub @(Model.TieneParoAbierto ? "text-danger" : "")">
                    @(Model.TieneParoAbierto ? "Paro abierto" : "Ejecución disponible")
                </div>
            </div>
        </section>

        <section class="metrics">
            <div class="metric">
                <div class="k">OK capturado</div>
                <div class="num text-success">@Numero(Model.CantidadOKTotal)</div>
                <div class="sub">Disponible: @Numero(Model.CantidadOKDisponible)</div>
            </div>

            <div class="metric">
                <div class="k">Sospechoso</div>
                <div class="num text-warning">@Numero(Model.CantidadSospechosaTotal)</div>
                <div class="sub">Disponible: @Numero(Model.CantidadSospechosaDisponible)</div>
            </div>

            <div class="metric">
                <div class="k">Scrap</div>
                <div class="num text-danger">@Numero(Model.CantidadScrapTotal)</div>
                <div class="sub">Disponible: @Numero(Model.CantidadScrapDisponible)</div>
            </div>

            <div class="metric">
                <div class="k">Total capturado</div>
                <div class="num text-primary">@Numero(totalCapturado)</div>
                <div class="sub">OK + sospechoso + scrap</div>
            </div>

            <div class="metric">
                <div class="k">Total en cajas</div>
                <div class="num">@Numero(totalEnCajas)</div>
                <div class="sub">Pendiente: @Numero(pendienteEmpaque)</div>
            </div>

            <div class="metric">
                <div class="k">Siguiente caja</div>
                <div class="num text-primary">@Model.SiguienteNumeroCaja.ToString("000")</div>
                <div class="sub">Número sugerido</div>
            </div>
        </section>

        <section class="progress-wrap">
            <div class="d-flex justify-content-between align-items-center mb-2 flex-wrap gap-2">
                <div class="fw-bold text-primary">
                    Avance de empaque en cajas
                </div>

                <div class="fw-bold">
                    @avanceCajas.ToString("0.##")%
                </div>
            </div>

            <div class="progress">
                <div class="progress-bar"
                     role="progressbar"
                     style="width:@avanceTexto%">
                </div>
            </div>
        </section>

        <section class="flow-metrics">
            <div class="metric">
                <div class="k">Pendientes de Calidad</div>
                <div class="num text-warning">@Numero(pendientesCalidad)</div>
                <div class="sub">Cajas enviadas para revisión</div>
            </div>

            <div class="metric">
                <div class="k">Liberadas por Calidad</div>
                <div class="num text-success">@Numero(liberadasCalidad)</div>
                <div class="sub">Con etiqueta verde</div>
            </div>

            <div class="metric">
                <div class="k">En zona verde</div>
                <div class="num text-success">@Numero(enZonaVerde)</div>
                <div class="sub">Pendientes de escanear salida</div>
            </div>

            <div class="metric">
                <div class="k">Salidas de Producción</div>
                <div class="num text-primary">@Numero(salidasProduccion)</div>
                <div class="sub">Esperando o recibidas por Almacén</div>
            </div>
        </section>

        <div class="layout">

            <aside>
                <section class="panel @(Model.PuedeFormarCaja ? "" : "disabled-area")">
                    <div class="panel-head">
                        <i class="fa-solid fa-box me-2"></i>
                        Formar caja
                    </div>

                    <div class="panel-body">
                        @if (Model.TieneParoAbierto)
                        {
                            <div class="danger-note mb-3">
                                <i class="fa-solid fa-circle-pause me-1"></i>
                                Hay un paro abierto. Cierra el paro antes de formar cajas.
                            </div>
                        }
                        else if (Model.EstatusID != 3)
                        {
                            <div class="warn-note mb-3">
                                <i class="fa-solid fa-triangle-exclamation me-1"></i>
                                Solo puedes formar cajas cuando la producción está en serie.
                            </div>
                        }
                        else
                        {
                            <div class="note mb-3">
                                <i class="fa-solid fa-circle-info me-1"></i>
                                Forma la caja con piezas ya capturadas por hora. Después envíala a Calidad.
                            </div>
                        }

                        <form method="post"
                              action="@Url.Action("FormarCaja", "ProduccionOperador")"
                              id="formFormarCaja">
                            @Html.AntiForgeryToken()

                            <input type="hidden"
                                   name="ejecucionProduccionId"
                                   value="@Model.EjecucionProduccionID" />

                            <div class="mb-3">
                                <label class="form-label">Tipo de caja</label>
                                <select name="tipoCaja" class="form-select" id="tipoCaja" required>
                                    <option value="OK" data-disponible="@Model.CantidadOKDisponible">Producto conforme</option>
                                    <option value="SOSPECHOSO" data-disponible="@Model.CantidadSospechosaDisponible">Sospechoso</option>
                                    <option value="SCRAP" data-disponible="@Model.CantidadScrapDisponible">Scrap</option>
                                    <option value="RETENCION" data-disponible="@Model.CantidadSospechosaDisponible">Retención</option>
                                </select>
                                <div class="sub mt-1">
                                    OK disponible: @Numero(Model.CantidadOKDisponible) · Sospechoso: @Numero(Model.CantidadSospechosaDisponible) · Scrap: @Numero(Model.CantidadScrapDisponible)
                                </div>
                            </div>

                            <div class="availability-box mb-3">
                                Disponible para el tipo seleccionado:
                                <span class="availability-number" id="cantidadDisponible">@Numero(Model.CantidadOKDisponible)</span>
                                pieza(s)
                            </div>

                            <div class="mb-3">
                                <label class="form-label">Cantidad de piezas</label>
                                <input type="number"
                                       name="cantidadPiezas"
                                       id="cantidadPiezas"
                                       min="1"
                                       max="@Model.CantidadOKDisponible"
                                       step="1"
                                       inputmode="numeric"
                                       class="form-control"
                                       required />
                            </div>

                            <div class="mb-3">
                                <label class="form-label">Lote material</label>
                                <input type="text"
                                       name="loteMaterial"
                                       maxlength="100"
                                       class="form-control"
                                       placeholder="Lote utilizado en la caja" />
                            </div>

                            <div class="mb-3">
                                <label class="form-label">Etiqueta / folio caja</label>
                                <input type="text"
                                       name="etiquetaFolio"
                                       maxlength="100"
                                       class="form-control"
                                       placeholder="Opcional. Si se deja vacío se genera folio automático." />
                            </div>

                            <div class="mb-3">
                                <label class="form-label">Observaciones</label>
                                <textarea name="observaciones"
                                          rows="3"
                                          maxlength="500"
                                          class="form-control"
                                          placeholder="Comentarios de empaque, etiqueta, lote o condición..."></textarea>
                            </div>

                            <button type="submit" class="btn-main" id="btnFormarCaja">
                                <i class="fa-solid fa-box"></i>
                                Formar caja
                            </button>
                        </form>
                    </div>
                </section>

               
            </aside>

            <main>
                <section class="panel">
                    <div class="panel-head">
                        <i class="fa-solid fa-list-check me-2"></i>
                        Cajas registradas
                    </div>

                    <div class="panel-body">
                        @if (!cajas.Any())
                        {
                            <div class="empty">
                                <i class="fa-solid fa-box-open fa-2x mb-3 d-block"></i>
                                Todavía no hay cajas formadas para esta ejecución.
                            </div>
                        }
                        else
                        {
                            <div class="table-wrap">
                                <table class="table">
                                    <thead>
                                        <tr>
                                            <th>Caja</th>
                                            <th>Folio / etiqueta</th>
                                            <th>Tipo</th>
                                            <th>Cantidad</th>
                                            <th>Estado</th>
                                            <th>Etiqueta verde</th>
                                            <th>Formación</th>
                                            <th>Calidad</th>
                                            <th>Zona verde</th>
                                            <th>Salida producción</th>
                                            <th>Almacén</th>
                                            <th>Acciones</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        @foreach (var caja in cajas)
                                        {
                                            <tr>
                                                <td>
                                                    <strong>@caja.NumeroCaja.ToString("000")</strong>
                                                </td>

                                                <td>
                                                    <div class="fw-bold">@TxtNullable(caja.FolioCaja)</div>
                                                    <div class="sub">@TxtNullable(caja.EtiquetaFolio)</div>
                                                </td>

                                                <td>
                                                    <span class="type-pill @TipoClase(caja.TipoCaja)">
                                                        @caja.TipoCaja
                                                    </span>
                                                </td>

                                                <td>
                                                    <strong>@Numero(caja.CantidadPiezas)</strong>
                                                </td>

                                                <td>
                                                    <span class="badge-flow @EstadoClaseCaja(caja)">
                                                        @if (caja.EstadoCajaID == 1)
                                                        {
                                                            <i class="fa-solid fa-box"></i>
                                                        }
                                                        else if (caja.EstadoCajaID == 2)
                                                        {
                                                            <i class="fa-solid fa-hourglass-half"></i>
                                                        }
                                                        else if (caja.EstadoCajaID == 3)
                                                        {
                                                            <i class="fa-solid fa-circle-check"></i>
                                                        }
                                                        else if (caja.EstadoCajaID == 4)
                                                        {
                                                            <i class="fa-solid fa-triangle-exclamation"></i>
                                                        }
                                                        else if (caja.EstadoCajaID == 5)
                                                        {
                                                            <i class="fa-solid fa-location-dot"></i>
                                                        }
                                                        else if (caja.EstadoCajaID == 6)
                                                        {
                                                            <i class="fa-solid fa-barcode"></i>
                                                        }
                                                        else if (caja.EstadoCajaID == 7)
                                                        {
                                                            <i class="fa-solid fa-warehouse"></i>
                                                        }

                                                        @caja.EstadoCajaNombre
                                                    </span>

                                                    @if (!string.IsNullOrWhiteSpace(caja.MotivoCalidad))
                                                    {
                                                        <div class="sub text-danger mt-1">
                                                            @caja.MotivoCalidad
                                                        </div>
                                                    }
                                                </td>

                                                <td>
                                                    @if (caja.EtiquetaVerde)
                                                    {
                                                        <span class="badge-flow badge-success">
                                                            <i class="fa-solid fa-tag"></i>
                                                            Sí
                                                        </span>
                                                    }
                                                    else
                                                    {
                                                        <span class="badge-flow badge-neutral">
                                                            No
                                                        </span>
                                                    }
                                                </td>

                                                <td>
                                                    @FechaTxtNoNullable(caja.FechaFormacion)
                                                </td>

                                                <td>
                                                    @FechaTxt(caja.FechaLiberacionCalidad)
                                                    @if (!string.IsNullOrWhiteSpace(caja.ResultadoCalidad))
                                                    {
                                                        <div class="sub">@caja.ResultadoCalidad</div>
                                                    }
                                                </td>

                                                <td>
                                                    @FechaTxt(caja.FechaZonaVerde)
                                                </td>

                                                <td>
                                                    @FechaTxt(caja.FechaSalidaProduccion)
                                                </td>

                                                <td>
                                                    @FechaTxt(caja.FechaRecepcionAlmacen)
                                                </td>

                                                <td>
                                                    <div class="actions-grid">

                                                        @if (caja.PuedeSolicitarCalidad)
                                                        {
                                                            <form method="post"
                                                                  action="@Url.Action("SolicitarLiberacionCaja", "ProduccionOperador")"
                                                                  class="small-form accion-form"
                                                                  data-confirm="¿Enviar esta caja a Calidad para su liberación?">
                                                                @Html.AntiForgeryToken()

                                                                <input type="hidden"
                                                                       name="cajaProduccionId"
                                                                       value="@caja.CajaProduccionID" />

                                                                <button type="submit" class="btn-warningx">
                                                                    <i class="fa-solid fa-microscope"></i>
                                                                    Solicitar Calidad
                                                                </button>
                                                            </form>
                                                        }
                                                        else
                                                        {
                                                            <button type="button" class="btn-mutedx" disabled>
                                                                <i class="fa-solid fa-microscope"></i>
                                                                Calidad
                                                            </button>
                                                        }

                                                        @if (caja.PuedeMoverZonaVerde)
                                                        {
                                                            <form method="post"
                                                                  action="@Url.Action("MoverCajaZonaVerde", "ProduccionOperador")"
                                                                  class="small-form accion-form"
                                                                  data-confirm="¿Confirmar el movimiento de esta caja a zona verde?">
                                                                @Html.AntiForgeryToken()

                                                                <input type="hidden"
                                                                       name="cajaProduccionId"
                                                                       value="@caja.CajaProduccionID" />

                                                                <button type="submit" class="btn-green">
                                                                    <i class="fa-solid fa-location-dot"></i>
                                                                    Zona verde
                                                                </button>
                                                            </form>
                                                        }
                                                        else
                                                        {
                                                            <button type="button" class="btn-mutedx" disabled>
                                                                <i class="fa-solid fa-lock"></i>
                                                                Zona verde
                                                            </button>
                                                        }

                                                        @if (caja.PuedeEscanearSalidaProduccion)
                                                        {
                                                            <form method="post"
                                                                  action="@Url.Action("EscanearSalidaCaja", "ProduccionOperador")"
                                                                  class="small-form accion-form"
                                                                  data-confirm="¿Registrar la salida de Producción para esta caja?">
                                                                @Html.AntiForgeryToken()

                                                                <input type="hidden"
                                                                       name="cajaProduccionId"
                                                                       value="@caja.CajaProduccionID" />

                                                                <div class="scan-row">
                                                                    <input type="text"
                                                                           name="etiquetaEscaneada"
                                                                           maxlength="100"
                                                                           class="form-control"
                                                                           placeholder="Escanear etiqueta" />

                                                                    <button type="submit" class="btn-blue">
                                                                        <i class="fa-solid fa-barcode"></i>
                                                                        Salida
                                                                    </button>
                                                                </div>
                                                            </form>
                                                        }
                                                        else
                                                        {
                                                            <button type="button" class="btn-mutedx" disabled>
                                                                <i class="fa-solid fa-lock"></i>
                                                                Salida
                                                            </button>
                                                        }

                                                    </div>
                                                </td>
                                            </tr>
                                        }
                                    </tbody>
                                </table>
                            </div>
                        }
                    </div>
                </section>
            </main>
        </div>
    </div>

    <script>
        (() => {
            const formFormarCaja = document.getElementById('formFormarCaja');
            const tipoCaja = document.getElementById('tipoCaja');
            const cantidadPiezas = document.getElementById('cantidadPiezas');
            const cantidadDisponible = document.getElementById('cantidadDisponible');
            const btnFormarCaja = document.getElementById('btnFormarCaja');
            const accionForms = document.querySelectorAll('.accion-form');

            const disponibles = {
                OK: @Model.CantidadOKDisponible,
                SOSPECHOSO: @Model.CantidadSospechosaDisponible,
                SCRAP: @Model.CantidadScrapDisponible,
                RETENCION: @Model.CantidadSospechosaDisponible
            };

            function obtenerDisponible() {
                const tipo = tipoCaja?.value || '';
                return Number(disponibles[tipo] ?? 0);
            }

            function actualizarDisponible() {
                if (!tipoCaja || !cantidadPiezas || !cantidadDisponible || !btnFormarCaja) return;

                const disponible = obtenerDisponible();
                cantidadDisponible.textContent = disponible.toLocaleString('es-MX');
                cantidadPiezas.max = String(disponible);

                if (Number(cantidadPiezas.value || 0) > disponible) {
                    cantidadPiezas.value = disponible > 0 ? String(disponible) : '';
                }

                const puedeFormar = disponible > 0 && !tipoCaja.disabled;
                cantidadPiezas.disabled = !puedeFormar;
                btnFormarCaja.disabled = !puedeFormar;
            }

            tipoCaja?.addEventListener('change', actualizarDisponible);
            actualizarDisponible();

            formFormarCaja?.addEventListener('submit', function (event) {
                const cantidad = Number(cantidadPiezas?.value || 0);
                const disponible = obtenerDisponible();
                const tipo = tipoCaja?.value || '';

                if (cantidad <= 0) {
                    event.preventDefault();
                    alert('La cantidad de piezas debe ser mayor a cero.');
                    return;
                }

                if (cantidad > disponible) {
                    event.preventDefault();
                    alert('La cantidad excede lo disponible para ' + tipo + '. Disponible: ' + disponible + ' pieza(s).');
                    return;
                }

                if (btnFormarCaja) {
                    btnFormarCaja.disabled = true;
                    btnFormarCaja.innerHTML = '<i class="fa-solid fa-spinner fa-spin"></i> Formando caja...';
                }
            });

            accionForms.forEach(function (form) {
                form.addEventListener('submit', function (event) {
                    const mensaje = form.dataset.confirm;

                    if (mensaje && !window.confirm(mensaje)) {
                        event.preventDefault();
                        return;
                    }

                    const btn = form.querySelector('button[type="submit"]');
                    if (btn) {
                        btn.disabled = true;
                        btn.innerHTML = '<i class="fa-solid fa-spinner fa-spin"></i> Procesando...';
                    }
                });
            });
        })();
    </script>
</body>
</html>