@model List<ERP.NSQuell.Models.ProduccionOperadorTabletVm>
@using System.Linq
@using System.Collections.Generic
@using ERP.NSQuell.Models
@{
    Layout = "~/Views/Shared/_Layout.cshtml";
    var producciones = Model ?? new List<ProduccionOperadorTabletVm>();
    var alertas = ViewBag.AlertasProximosProgramas as List<ProduccionAlertaProximoProgramaVm> ?? new List<ProduccionAlertaProximoProgramaVm>();
    var alertasLhRh = ViewBag.AlertasLhRh as List<string> ?? new List<string>();
    var maquinas = producciones.Select(x => string.IsNullOrWhiteSpace(x.MaquinaCodigo) ? "SIN MÁQUINA" : x.MaquinaCodigo.Trim()).Distinct(StringComparer.OrdinalIgnoreCase).OrderBy(x => x).ToList();
    var gruposLhRh = producciones.Where(x => x.ParejaLhRh != null && x.ProduccionPareja != null && x.ParejaLhRh.GrupoLhRh > 0).Select(x => x.ParejaLhRh!.GrupoLhRh).Distinct().ToList();
    var produccionesIndividuales = producciones.Count(x => x.ParejaLhRh == null || x.ProduccionPareja == null || x.ParejaLhRh.GrupoLhRh <= 0);
    var totalOperacionesVisibles = produccionesIndividuales + gruposLhRh.Count;
}
@functions {
    public static string Txt(string? value) => string.IsNullOrWhiteSpace(value) ? "-" : value.Trim();
    public static string ParteTexto(ProduccionOperadorTabletVm item) => !string.IsNullOrWhiteSpace(item.ReferenciaSAP) ? item.ReferenciaSAP : !string.IsNullOrWhiteSpace(item.NumeroParte) ? item.NumeroParte : "-";
    public static string OFTexto(ProduccionOperadorTabletVm item) => !string.IsNullOrWhiteSpace(item.NumeroOFRecibida) ? item.NumeroOFRecibida : !string.IsNullOrWhiteSpace(item.FolioSolicitud) ? item.FolioSolicitud : "Programa " + item.ProgramaProduccionID;
    public static string EstadoTexto(ProduccionOperadorTabletVm item) => item.TieneParoAbierto ? "Paro abierto" : item.EstatusID == ProduccionEstatus.Pausado ? "Pausado" : item.EstatusID == ProduccionEstatus.EnProduccion ? "En producción" : "Programada";
    public static string EstadoClase(ProduccionOperadorTabletVm item) => item.TieneParoAbierto ? "estado-paro" : item.EstatusID == ProduccionEstatus.Pausado ? "estado-pausa" : item.EstatusID == ProduccionEstatus.EnProduccion ? "estado-produccion" : "estado-programada";
    public static decimal Avance(ProduccionOperadorTabletVm item) { var planeada = item.CantidadPlaneada ?? 0; if (planeada <= 0) return 0; return Math.Min(100m, Math.Round(item.CantidadOKTotal * 100m / planeada, 2)); }
    public static string AlertaTiempo(ProduccionAlertaProximoProgramaVm alerta) => alerta.MinutosRestantes < 0 ? "Hace " + Math.Abs(alerta.MinutosRestantes) + " min" : alerta.MinutosRestantes == 0 ? "Ahora" : "En " + alerta.MinutosRestantes + " min";
    public static string AlertaTipo(ProduccionAlertaProximoProgramaVm alerta) => alerta.TipoAlerta == "CAMBIO_MOLDE" ? "Cambio de molde" : alerta.TipoAlerta == "ARRANQUE" ? "Arranque" : "Alerta";
    public static bool EsParejaVisible(ProduccionOperadorTabletVm item) => item.ParejaLhRh != null && item.ProduccionPareja != null && item.ParejaLhRh.GrupoLhRh > 0;
    public static string LadoTexto(ProduccionOperadorTabletVm item, string alterno) => string.IsNullOrWhiteSpace(item.LadoLhRh) ? alterno : item.LadoLhRh!.Trim().ToUpperInvariant();
    public static string EstadoFisicoTexto(ProduccionOperadorTabletVm actual, ProduccionOperadorTabletVm pareja)
    {
        if (actual.TieneParoAbierto || pareja.TieneParoAbierto) return "Paro LH/RH";
        if (actual.EstatusID == ProduccionEstatus.Pausado || pareja.EstatusID == ProduccionEstatus.Pausado) return "Pausado LH/RH";
        if (actual.EstatusID == ProduccionEstatus.EnProduccion && pareja.EstatusID == ProduccionEstatus.EnProduccion) return "En producción conjunta";
        return "Estado desincronizado";
    }
    public static string EstadoFisicoClase(ProduccionOperadorTabletVm actual, ProduccionOperadorTabletVm pareja)
    {
        if (actual.TieneParoAbierto || pareja.TieneParoAbierto) return "estado-paro";
        if (actual.EstatusID == ProduccionEstatus.Pausado || pareja.EstatusID == ProduccionEstatus.Pausado) return "estado-pausa";
        if (actual.EstatusID == ProduccionEstatus.EnProduccion && pareja.EstatusID == ProduccionEstatus.EnProduccion) return "estado-produccion";
        return "estado-programada";
    }
}
@{
    ViewData["Title"] = "Kiosco de Operador";
}

@section Styles {
    <style>
        :root {
            --azul: #004aad;
            --azul-oscuro: #00347a;
            --verde: #107c41;
            --amarillo: #b54708;
            --rojo: #b42318;
            --gris: #667085;
            --borde: #dbe4f0;
            --fondo: #f3f6fa;
            --texto: #172033
        }

        * {
            box-sizing: border-box
        }

        body {
            margin: 0;
            background: var(--fondo);
            color: var(--texto);
            font-family: "Segoe UI",Arial,sans-serif
        }

        .page {
            max-width: 1700px;
            margin: auto;
            padding: 20px
        }

        .hero {
            background: linear-gradient(135deg,var(--azul-oscuro),var(--azul));
            color: #fff;
            border-radius: 22px;
            padding: 20px 22px;
            margin-bottom: 16px;
            box-shadow: 0 18px 42px rgba(0,74,173,.2)
        }

            .hero h1 {
                margin: 0;
                font-size: 1.65rem;
                font-weight: 950
            }

            .hero p {
                margin: 5px 0 0;
                color: rgba(255,255,255,.85);
                font-weight: 650
            }

        .btn-hero {
            display: inline-flex;
            align-items: center;
            gap: 7px;
            border: 1px solid rgba(255,255,255,.35);
            border-radius: 12px;
            padding: 9px 13px;
            color: #fff;
            text-decoration: none;
            font-weight: 900;
            background: rgba(255,255,255,.12)
        }

            .btn-hero:hover {
                background: #fff;
                color: var(--azul)
            }

        .panel {
            background: #fff;
            border: 1px solid var(--borde);
            border-radius: 20px;
            box-shadow: 0 10px 28px rgba(15,23,42,.06);
            overflow: hidden;
            margin-bottom: 16px
        }

        .panel-head {
            padding: 15px 17px;
            background: #f8fbff;
            border-bottom: 1px solid var(--borde);
            font-weight: 950;
            color: var(--azul-oscuro)
        }

        .panel-body {
            padding: 16px
        }

        .filter-grid {
            display: grid;
            grid-template-columns: minmax(240px,360px) 1fr;
            gap: 14px;
            align-items: end
        }

        .filter-label {
            display: block;
            color: var(--gris);
            font-size: .72rem;
            font-weight: 950;
            text-transform: uppercase;
            margin-bottom: 6px
        }

        .form-select {
            border-radius: 12px;
            border-color: var(--borde);
            font-weight: 800
        }

        .alert-toggle {
            width: 100%;
            border: 1px solid #bfdbfe;
            background: #eff6ff;
            color: var(--azul-oscuro);
            border-radius: 14px;
            padding: 12px 14px;
            font-weight: 950;
            display: flex;
            justify-content: space-between;
            align-items: center
        }

            .alert-toggle .fa-chevron-down {
                transition: transform .2s
            }

            .alert-toggle[aria-expanded="true"] .fa-chevron-down {
                transform: rotate(180deg)
            }

        .alert-list {
            display: grid;
            gap: 10px;
            margin-top: 12px
        }

        .alert-row {
            display: grid;
            grid-template-columns: 150px 1fr 1fr 150px 170px;
            gap: 12px;
            align-items: center;
            border: 1px solid var(--borde);
            border-radius: 14px;
            padding: 12px;
            background: #fff
        }

        .alert-time {
            font-weight: 950;
            color: var(--rojo)
        }

        .alert-type {
            font-weight: 900;
            color: var(--azul-oscuro)
        }

        .table-wrap {
            overflow-x: auto
        }

        .prod-table {
            width: 100%;
            border-collapse: separate;
            border-spacing: 0 9px;
            min-width: 1180px
        }

            .prod-table th {
                padding: 8px 10px;
                color: var(--gris);
                font-size: .72rem;
                text-transform: uppercase;
                text-align: left;
                white-space: nowrap
            }

            .prod-table td {
                padding: 12px 10px;
                border-top: 1px solid var(--borde);
                border-bottom: 1px solid var(--borde);
                background: #fff;
                vertical-align: middle
            }

                .prod-table td:first-child {
                    border-left: 1px solid var(--borde);
                    border-radius: 14px 0 0 14px
                }

                .prod-table td:last-child {
                    border-right: 1px solid var(--borde);
                    border-radius: 0 14px 14px 0
                }

        .main {
            font-weight: 950;
            color: var(--azul-oscuro)
        }

        .sub {
            font-size: .8rem;
            color: var(--gris);
            font-weight: 650;
            margin-top: 2px
        }

        .estado {
            display: inline-flex;
            align-items: center;
            border-radius: 999px;
            padding: 6px 9px;
            font-size: .73rem;
            font-weight: 950;
            white-space: nowrap
        }

        .estado-produccion {
            background: #ecfdf3;
            color: var(--verde)
        }

        .estado-pausa {
            background: #fff7ed;
            color: var(--amarillo)
        }

        .estado-paro {
            background: #fef3f2;
            color: var(--rojo)
        }

        .estado-programada {
            background: #eff6ff;
            color: var(--azul)
        }

        .qty {
            display: flex;
            gap: 6px;
            flex-wrap: wrap
        }

        .pill {
            border-radius: 999px;
            padding: 5px 8px;
            font-size: .72rem;
            font-weight: 900;
            background: #f2f4f7
        }

            .pill.ok {
                background: #ecfdf3;
                color: var(--verde)
            }

            .pill.sos {
                background: #fff7ed;
                color: var(--amarillo)
            }

            .pill.scrap {
                background: #fef3f2;
                color: var(--rojo)
            }

        .progress {
            height: 9px;
            border-radius: 999px;
            background: #e9eef7;
            min-width: 130px
        }

        .progress-bar {
            background: var(--azul)
        }

        .btn-captura {
            display: inline-flex;
            align-items: center;
            justify-content: center;
            gap: 7px;
            border-radius: 12px;
            padding: 10px 13px;
            background: var(--azul);
            color: #fff;
            text-decoration: none;
            font-weight: 950;
            white-space: nowrap
        }

            .btn-captura:hover {
                background: var(--azul-oscuro);
                color: #fff
            }

        .empty {
            padding: 40px 20px;
            text-align: center;
            color: var(--gris);
            font-weight: 800
        }

        .machine-summary {
            color: var(--gris);
            font-weight: 800
        }

        .hidden-row {
            display: none !important
        }

        .turn-reception {
            border: 1px solid #93c5fd;
            background: linear-gradient(135deg,#eff6ff,#fff);
            border-radius: 20px;
            padding: 16px;
            margin-bottom: 16px;
            box-shadow: 0 10px 28px rgba(15,23,42,.06)
        }

        .turn-reception-title {
            color: var(--azul-oscuro);
            font-size: 1.05rem;
            font-weight: 950
        }

        .turn-reception-sub {
            color: var(--gris);
            font-size: .82rem;
            font-weight: 700
        }

        .turn-reception-list {
            display: grid;
            gap: 10px;
            margin-top: 12px
        }

        .turn-reception-card {
            border: 1px solid var(--borde);
            border-radius: 16px;
            background: #fff;
            padding: 14px;
            display: grid;
            grid-template-columns: 1.2fr 1fr 1fr auto;
            gap: 12px;
            align-items: center
        }

            .turn-reception-card .label {
                color: var(--gris);
                font-size: .68rem;
                font-weight: 900;
                text-transform: uppercase
            }

            .turn-reception-card .value {
                color: var(--azul-oscuro);
                font-weight: 950;
                margin-top: 2px
            }

        .btn-receive-turn {
            border: 0;
            border-radius: 12px;
            padding: 10px 14px;
            background: var(--verde);
            color: #fff;
            font-weight: 950;
            white-space: nowrap
        }

            .btn-receive-turn:hover {
                background: #0b5d31
            }

        .turn-detail-grid {
            display: grid;
            grid-template-columns: repeat(3,minmax(0,1fr));
            gap: 10px;
            margin-bottom: 14px
        }

        .turn-detail-card {
            border: 1px solid var(--borde);
            border-radius: 14px;
            padding: 12px;
            background: #f8fbff
        }

            .turn-detail-card .k {
                color: var(--gris);
                font-size: .68rem;
                font-weight: 900;
                text-transform: uppercase
            }

            .turn-detail-card .v {
                color: var(--azul-oscuro);
                font-size: 1.05rem;
                font-weight: 950;
                margin-top: 3px
            }

        .turn-accept-header {
            background: linear-gradient(135deg,#065f46,#107c41);
            color: #fff
        }

        .turn-observations {
            border: 1px solid #d0d5dd;
            border-radius: 14px;
            padding: 12px;
            background: #f8fafc;
            white-space: pre-wrap;
            color: #344054;
            font-weight: 700
        }

        .lh-rh-alert {
            border: 1px solid #f4c790;
            background: #fff8eb;
            color: #8a4b08;
            border-radius: 16px;
            padding: 13px 15px;
            margin-bottom: 16px;
            font-weight: 800
        }

        .pair-row td {
            background: linear-gradient(180deg,#ffffff,#f8fbff)
        }

            .pair-row td:first-child {
                border-left: 4px solid var(--azul)
            }

        .pair-badge {
            display: inline-flex;
            align-items: center;
            gap: 6px;
            border-radius: 999px;
            padding: 5px 9px;
            background: #eaf2ff;
            color: var(--azul-oscuro);
            font-size: .72rem;
            font-weight: 950;
            margin-top: 6px
        }

        .pair-cell {
            display: grid;
            gap: 8px
        }

        .pair-side {
            border: 1px solid #dbe7f7;
            border-radius: 12px;
            padding: 9px 10px;
            background: #fff
        }

        .pair-side-head {
            display: flex;
            align-items: center;
            gap: 7px;
            flex-wrap: wrap;
            margin-bottom: 3px
        }

        .side-badge {
            display: inline-flex;
            min-width: 34px;
            justify-content: center;
            border-radius: 999px;
            padding: 3px 7px;
            background: var(--azul);
            color: #fff;
            font-size: .68rem;
            font-weight: 950
        }

            .side-badge.rh {
                background: #5b3dbb
            }

        .pair-progress {
            display: grid;
            gap: 9px;
            min-width: 180px
        }

        .pair-progress-line {
            display: grid;
            gap: 4px
        }

        .pair-progress-meta {
            display: flex;
            justify-content: space-between;
            gap: 8px;
            font-size: .72rem;
            font-weight: 900
        }

        .pair-action-note {
            color: var(--gris);
            font-size: .72rem;
            font-weight: 750;
            margin-top: 5px;
            max-width: 190px
        }

        .pair-missing {
            display: inline-flex;
            align-items: center;
            gap: 5px;
            border-radius: 999px;
            padding: 4px 8px;
            margin-top: 5px;
            background: #fff7ed;
            color: var(--amarillo);
            font-size: .68rem;
            font-weight: 950
        }

        @@media(max-width:800px) {
            .page {
                padding: 10px
            }

            .filter-grid {
                grid-template-columns: 1fr
            }

            .alert-row {
                grid-template-columns: 1fr
            }

            .hero {
                border-radius: 18px
            }
        }
    </style>
}

<div class="page">
    <section class="hero">
        <div class="d-flex justify-content-between align-items-start flex-wrap gap-3">
            <div>
                <h1><i class="fa-solid fa-tablet-screen-button me-2"></i>Kiosco de Operador</h1>
                <p>Consulta las OF programadas por máquina y entra directamente a la captura horaria.</p>
            </div>

            <div class="d-flex gap-2 flex-wrap">
                <a href="@Url.Action("Historial", "ProduccionOperador")" class="btn-hero">
                    <i class="fa-solid fa-clock-rotate-left"></i>
                    Mi historial
                </a>

                <a href="@Url.Action("Index", "ProduccionOperador")" class="btn-hero">
                    <i class="fa-solid fa-rotate-right"></i>
                    Actualizar
                </a>
            </div>
        </div>
    </section>
    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success rounded-4 fw-bold">@TempData["Success"]</div>
    }
    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger rounded-4 fw-bold">@TempData["Error"]</div>
    }
    @if (alertasLhRh.Any())
    {
        <div class="lh-rh-alert">
            <div class="fw-bold mb-1"><i class="fa-solid fa-triangle-exclamation me-2"></i>Revisión LH/RH</div>
            @foreach (var mensaje in alertasLhRh.Distinct())
            {
                <div class="small">@mensaje</div>
            }
        </div>
    }
    <section class="turn-reception d-none" id="turnosPendientesSection">
        <div class="d-flex justify-content-between align-items-start flex-wrap gap-2"><div><div class="turn-reception-title"><i class="fa-solid fa-arrow-right-arrow-left me-2"></i>Tienes un turno pendiente por recibir</div><div class="turn-reception-sub">Revisa exactamente lo que recibes antes de aceptar. La responsabilidad cambia únicamente cuando confirmas la recepción.</div></div><span class="badge bg-primary" id="turnosPendientesCount">0</span></div>
        <div class="turn-reception-list" id="turnosPendientesLista"></div>
    </section>



    <section class="panel">
        <div class="panel-body">
            <button class="alert-toggle" type="button" data-bs-toggle="collapse" data-bs-target="#proximasProducciones" aria-expanded="false" aria-controls="proximasProducciones"><span><i class="fa-solid fa-bell me-2"></i>Próximas producciones en 15 minutos (@alertas.Count)</span><i class="fa-solid fa-chevron-down"></i></button><div class="collapse" id="proximasProducciones">
                <div class="alert-list">
                    @if (alertas.Any())
                    {
                        foreach (var alerta in alertas.OrderBy(x => x.FechaObjetivo))
                        {
                            <div class="alert-row">
                                <div><div class="alert-type">@AlertaTipo(alerta)</div><div class="alert-time">@AlertaTiempo(alerta)</div></div><div><div class="main">@alerta.TextoMaquina</div><div class="sub">Objetivo @alerta.FechaObjetivo.ToString("dd/MM/yyyy HH:mm")</div></div><div><div class="main">@alerta.TextoParte</div><div class="sub">Molde @Txt(alerta.MoldeCodigo)</div></div><div><div class="main">@alerta.CantidadProgramada.ToString("N0")</div><div class="sub">piezas</div></div><div>
                                    @if (alerta.EjecucionProduccionID.HasValue)
                                    {
                                        <a class="btn-captura" href="@Url.Action("Detalle", "Produccion", new { id = alerta.EjecucionProduccionID.Value })"><i class="fa-solid fa-eye"></i>Ver preparación</a>
                                    }
                                    else
                                    {

                                        <a class="btn-captura" href="@Url.Action("Index", "Produccion")"><i class="fa-solid fa-industry"></i>Ir a Producción</a>
                                    }
                                </div>
                            </div>
                        }
                    }
                    else
                    {

                        <div class="empty">No hay próximas producciones dentro de la ventana de 15 minutos.</div>
                    }
                </div>
            </div>
        </div>
    </section>
    <section class="panel">
        <div class="panel-body">
            <div class="filter-grid">
                <div>
                    <label class="filter-label" for="filtroMaquina"><i class="fa-solid fa-filter me-1"></i>Filtrar por máquina</label>
                    <select class="form-select" id="filtroMaquina">
                        <option value="">Todas las máquinas</option>
                        @foreach (var maquinaFiltro in maquinas)
                        {
                            <option value="@maquinaFiltro">@maquinaFiltro</option>
                        }
                    </select>
                </div>
                <div>
                    <div class="filter-label">Resumen visible</div>
                    <div class="machine-summary" id="resumenFiltro">Mostrando @totalOperacionesVisibles producción(es) física(s). @gruposLhRh.Count pareja(s) LH/RH.</div>
                </div>
            </div>
        </div>
    </section>
    <section class="panel">
        <div class="panel-head d-flex justify-content-between align-items-center flex-wrap gap-2"><span><i class="fa-solid fa-list-check me-2"></i>OF programadas por máquina</span><div class="d-flex gap-2 align-items-center"><span class="badge bg-info text-dark">LH/RH @gruposLhRh.Count</span><span id="contadorVisible" class="badge bg-primary">@totalOperacionesVisibles</span></div></div><div class="panel-body">
            @if (!producciones.Any())
            {
                <div class="empty"><i class="fa-solid fa-folder-open fa-2x mb-2"></i><div>No hay producciones disponibles.</div></div>
            }
            else
            {

                <div class="table-wrap">
                    <table class="prod-table">
                        <thead><tr><th>Máquina</th><th>OF / Programa</th><th>Parte</th><th>Operador</th><th>Estado</th><th>Cantidades</th><th>Avance</th><th>Acción</th></tr></thead>
                        <tbody>
                            @{
                                var gruposRenderizados = new HashSet<int>();
                            }
                            @foreach (var item in producciones.OrderBy(x => x.MaquinaCodigo).ThenBy(x => x.ProgramaProduccionID))
                            {
                                var maquina = string.IsNullOrWhiteSpace(item.MaquinaCodigo) ? "SIN MÁQUINA" : item.MaquinaCodigo.Trim();
                                var esParejaVisible = EsParejaVisible(item);
                                if (esParejaVisible)
                                {
                                    var grupo = item.ParejaLhRh!.GrupoLhRh;
                                    if (!gruposRenderizados.Add(grupo)) { continue; }
                                    var pareja = item.ProduccionPareja!;
                                    var itemEsLh = string.Equals(item.LadoLhRh, "LH", StringComparison.OrdinalIgnoreCase);
                                    var parejaEsLh = string.Equals(pareja.LadoLhRh, "LH", StringComparison.OrdinalIgnoreCase);
                                    var ladoLh = itemEsLh ? item : parejaEsLh ? pareja : item;
                                    var ladoRh = ReferenceEquals(ladoLh, item) ? pareja : item;
                                    var etiquetaLh = string.Equals(ladoLh.LadoLhRh, "RH", StringComparison.OrdinalIgnoreCase) ? "RH" : "LH";
                                    var etiquetaRh = etiquetaLh == "LH" ? "RH" : "LH";
                                    var avanceLh = Avance(ladoLh);
                                    var avanceRh = Avance(ladoRh);
                                    var avanceLhCss = avanceLh.ToString("0.##", System.Globalization.CultureInfo.InvariantCulture);
                                    var avanceRhCss = avanceRh.ToString("0.##", System.Globalization.CultureInfo.InvariantCulture);
                                    var mismoOperador = ladoLh.OperadorID == ladoRh.OperadorID && string.Equals(Txt(ladoLh.OperadorNombre), Txt(ladoRh.OperadorNombre), StringComparison.OrdinalIgnoreCase);
                                    <tr data-maquina="@maquina" class="pair-row" data-grupo-lhrh="@grupo">
                                        <td>
                                            <div class="main">@maquina</div>
                                            <div class="sub">@Txt(item.MaquinaNombre)</div>
                                            <span class="pair-badge"><i class="fa-solid fa-link"></i>Producción LH/RH · Grupo @grupo</span>
                                        </td>
                                        <td>
                                            <div class="pair-cell">
                                                <div class="pair-side"><div class="pair-side-head"><span class="side-badge">@etiquetaLh</span><span class="main">@OFTexto(ladoLh)</span></div><div class="sub">Programa @ladoLh.ProgramaProduccionID · Ejecución @ladoLh.EjecucionProduccionID</div></div>
                                                <div class="pair-side"><div class="pair-side-head"><span class="side-badge rh">@etiquetaRh</span><span class="main">@OFTexto(ladoRh)</span></div><div class="sub">Programa @ladoRh.ProgramaProduccionID · Ejecución @ladoRh.EjecucionProduccionID</div></div>
                                            </div>
                                        </td>
                                        <td>
                                            <div class="pair-cell">
                                                <div class="pair-side"><div class="pair-side-head"><span class="side-badge">@etiquetaLh</span><span class="main">@ParteTexto(ladoLh)</span></div><div class="sub">@Txt(ladoLh.DescripcionParte)</div></div>
                                                <div class="pair-side"><div class="pair-side-head"><span class="side-badge rh">@etiquetaRh</span><span class="main">@ParteTexto(ladoRh)</span></div><div class="sub">@Txt(ladoRh.DescripcionParte)</div></div>
                                            </div>
                                        </td>
                                        <td>
                                            @if (mismoOperador)
                                            {
                                                <div class="main">@Txt(ladoLh.OperadorNombre)</div>
                                                <div class="sub">Operador compartido · @(ladoLh.OperadorID.HasValue ? "ID " + ladoLh.OperadorID.Value : "Sin ID")</div>
                                            }
                                            else
                                            {
                                                <div class="pair-cell">
                                                    <div class="pair-side"><div class="pair-side-head"><span class="side-badge">@etiquetaLh</span><span class="main">@Txt(ladoLh.OperadorNombre)</span></div></div>
                                                    <div class="pair-side"><div class="pair-side-head"><span class="side-badge rh">@etiquetaRh</span><span class="main">@Txt(ladoRh.OperadorNombre)</span></div></div>
                                                </div>
                                            }
                                        </td>
                                        <td><span class="estado @EstadoFisicoClase(ladoLh, ladoRh)">@EstadoFisicoTexto(ladoLh, ladoRh)</span></td>
                                        <td>
                                            <div class="pair-cell">
                                                <div class="pair-side"><div class="pair-side-head"><span class="side-badge">@etiquetaLh</span></div><div class="qty"><span class="pill ok">OK @ladoLh.CantidadOKTotal.ToString("N0")</span><span class="pill sos">Amarillos @ladoLh.CantidadSospechosaTotal.ToString("N0")</span><span class="pill scrap">Scrap @ladoLh.CantidadScrapTotal.ToString("N0")</span></div></div>
                                                <div class="pair-side"><div class="pair-side-head"><span class="side-badge rh">@etiquetaRh</span></div><div class="qty"><span class="pill ok">OK @ladoRh.CantidadOKTotal.ToString("N0")</span><span class="pill sos">Amarillos @ladoRh.CantidadSospechosaTotal.ToString("N0")</span><span class="pill scrap">Scrap @ladoRh.CantidadScrapTotal.ToString("N0")</span></div></div>
                                            </div>
                                        </td>
                                        <td>
                                            <div class="pair-progress">
                                                <div class="pair-progress-line"><div class="pair-progress-meta"><span>@etiquetaLh · @avanceLh.ToString("0.##")%</span><span>@ladoLh.CantidadOKTotal.ToString("N0") / @((ladoLh.CantidadPlaneada ?? 0).ToString("N0"))</span></div><div class="progress"><div class="progress-bar" style="width:@avanceLhCss%"></div></div></div>
                                                <div class="pair-progress-line"><div class="pair-progress-meta"><span>@etiquetaRh · @avanceRh.ToString("0.##")%</span><span>@ladoRh.CantidadOKTotal.ToString("N0") / @((ladoRh.CantidadPlaneada ?? 0).ToString("N0"))</span></div><div class="progress"><div class="progress-bar" style="width:@avanceRhCss%"></div></div></div>
                                            </div>
                                        </td>
                                        <td>
                                            <div class="d-flex gap-2 flex-wrap"><a href="@Url.Action("Captura", "ProduccionOperador", new { id = item.EjecucionProduccionID })" class="btn-captura"><i class="fa-solid fa-keyboard"></i>Abrir producción LH/RH</a></div>
                                            <div class="pair-action-note">Puedes entrar desde cualquiera de las dos OF; la captura carga automáticamente ambos lados.</div>
                                        </td>
                                    </tr>
                                }
                                else
                                {
                                    var avance = Avance(item);
                                    var avanceCss = avance.ToString("0.##", System.Globalization.CultureInfo.InvariantCulture);
                                    <tr data-maquina="@maquina">
                                        <td><div class="main">@maquina</div><div class="sub">@Txt(item.MaquinaNombre)</div></td>
                                        <td>
                                            <div class="main">@OFTexto(item)</div><div class="sub">Programa @item.ProgramaProduccionID</div>
                                            @if (item.ParejaLhRh != null && item.ProduccionPareja == null)
                                            {
                                                <span class="pair-missing"><i class="fa-solid fa-triangle-exclamation"></i>Pareja LH/RH no visible</span>
                                            }
                                        </td>
                                        <td><div class="main">@ParteTexto(item)</div><div class="sub">@Txt(item.DescripcionParte)</div></td>
                                        <td><div class="main">@Txt(item.OperadorNombre)</div><div class="sub">@(item.OperadorID.HasValue ? "ID " + item.OperadorID.Value : "Sin operador")</div></td>
                                        <td><span class="estado @EstadoClase(item)">@EstadoTexto(item)</span></td>
                                        <td><div class="qty"><span class="pill ok">OK @item.CantidadOKTotal.ToString("N0")</span><span class="pill sos">Amarillos @item.CantidadSospechosaTotal.ToString("N0")</span><span class="pill scrap">Scrap @item.CantidadScrapTotal.ToString("N0")</span></div></td>
                                        <td><div class="d-flex justify-content-between small fw-bold mb-1"><span>@avance.ToString("0.##")%</span><span>@item.CantidadOKTotal.ToString("N0") / @((item.CantidadPlaneada ?? 0).ToString("N0"))</span></div><div class="progress"><div class="progress-bar" style="width:@avanceCss%"></div></div></td>
                                        <td><div class="d-flex gap-2 flex-wrap"><a href="@Url.Action("Captura", "ProduccionOperador", new { id = item.EjecucionProduccionID })" class="btn-captura"><i class="fa-solid fa-keyboard"></i>Capturar</a></div></td>
                                    </tr>
                                }
                            }
                        </tbody>
                    </table>
                </div>
            }
        </div>
    </section>
</div>
<div class="modal fade" id="modalRecibirTurno" tabindex="-1" aria-hidden="true" data-bs-backdrop="static" data-bs-keyboard="false">
    <div class="modal-dialog modal-dialog-centered modal-lg">
        <div class="modal-content border-0 rounded-4">
            <div class="modal-header turn-accept-header rounded-top-4"><h5 class="modal-title fw-bold"><i class="fa-solid fa-handshake me-2"></i>Recepción de turno</h5><button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button></div>
            <form method="post" action="@Url.Action("RecibirTurno","ProduccionOperador")" id="formRecibirTurno">
                @Html.AntiForgeryToken()<input type="hidden" name="CambioTurnoID" id="recibirCambioTurnoID" />
                <div class="modal-body p-4">
                    <div class="alert alert-info rounded-4 fw-bold"><i class="fa-solid fa-circle-info me-1"></i>Al aceptar, esta máquina quedará bajo tu responsabilidad como único operador asignado.</div>
                    <div class="turn-detail-grid">
                        <div class="turn-detail-card"><div class="k">Recibes de</div><div class="v" id="recibirSaliente">-</div></div>
                        <div class="turn-detail-card"><div class="k">Máquina</div><div class="v" id="recibirMaquina">-</div></div>
                        <div class="turn-detail-card"><div class="k">Parte</div><div class="v" id="recibirParte">-</div></div>
                        <div class="turn-detail-card"><div class="k">Fecha entrega</div><div class="v" id="recibirFecha">-</div></div>
                        <div class="turn-detail-card"><div class="k">OK acumulado</div><div class="v text-success" id="recibirOK">0</div></div>
                        <div class="turn-detail-card"><div class="k">Sospechoso</div><div class="v text-warning" id="recibirSos">0</div></div>
                        <div class="turn-detail-card"><div class="k">Scrap</div><div class="v text-danger" id="recibirScrap">0</div></div>
                        <div class="turn-detail-card"><div class="k">Cajas producidas</div><div class="v" id="recibirCajas">0</div></div>
                        <div class="turn-detail-card"><div class="k">Cajas entregadas</div><div class="v text-success" id="recibirCajasEntregadas">0</div></div>
                    </div>
                    <div class="mb-3"><label class="form-label fw-bold">Observaciones del operador saliente</label><div class="turn-observations" id="recibirObservacionesEntrega">Sin observaciones.</div></div>
                    <div class="mb-3"><label class="form-label fw-bold">Observaciones de recepción</label><textarea class="form-control" rows="3" maxlength="1000" name="ObservacionesRecepcion" id="observacionesRecepcion" placeholder="Opcional. Registra cualquier condición detectada al recibir."></textarea></div>
                    <div class="form-check p-3 border rounded-4 bg-light"><input class="form-check-input" type="checkbox" id="confirmoRecepcion"><label class="form-check-label fw-bold" for="confirmoRecepcion">Confirmo que revisé la máquina, producción, cajas y observaciones mostradas.</label></div>
                    <div class="alert alert-danger rounded-4 fw-bold d-none mt-3 mb-0" id="mensajeRecepcionTurno"></div>
                </div>
                <div class="modal-footer border-0 px-4 pb-4"><button type="button" class="btn btn-light fw-bold" data-bs-dismiss="modal">Cancelar</button><button type="submit" class="btn btn-success fw-bold" id="btnAceptarRecepcion" disabled><i class="fa-solid fa-circle-check me-1"></i>Aceptar y recibir turno</button></div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        document.addEventListener('DOMContentLoaded',function(){
            const filtro=document.getElementById('filtroMaquina'),filas=Array.from(document.querySelectorAll('tr[data-maquina]')),contador=document.getElementById('contadorVisible'),resumen=document.getElementById('resumenFiltro');
            const section=document.getElementById('turnosPendientesSection'),lista=document.getElementById('turnosPendientesLista'),count=document.getElementById('turnosPendientesCount'),modalEl=document.getElementById('modalRecibirTurno'),modal=modalEl?bootstrap.Modal.getOrCreateInstance(modalEl):null,form=document.getElementById('formRecibirTurno'),check=document.getElementById('confirmoRecepcion'),btn=document.getElementById('btnAceptarRecepcion');
            let turnos=[];
            function prop(o,...n){if(!o)return null;for(const k of n)if(Object.prototype.hasOwnProperty.call(o,k))return o[k];return null;}
            function txt(v,a='-'){return v===null||v===undefined||String(v).trim()===''?a:String(v).trim();}
            function num(v){const n=Number(v||0);return Number.isFinite(n)?n.toLocaleString('es-MX'):'0';}
            function fecha(v){if(!v)return '-';const d=new Date(v);return Number.isNaN(d.getTime())?txt(v):d.toLocaleString('es-MX',{day:'2-digit',month:'2-digit',year:'numeric',hour:'2-digit',minute:'2-digit'});}
            function aplicar(){const valor=(filtro?.value||'').trim().toLowerCase();let visibles=0;filas.forEach(f=>{const maquina=(f.dataset.maquina||'').trim().toLowerCase(),mostrar=!valor||maquina===valor;f.classList.toggle('hidden-row',!mostrar);if(mostrar)visibles++;});if(contador)contador.textContent=visibles;if(resumen)resumen.textContent='Mostrando '+visibles+' producción(es).';}
            filtro?.addEventListener('change',aplicar);
            function abrir(id){const t=turnos.find(x=>Number(prop(x,'cambioTurnoID','CambioTurnoID'))===id);if(!t)return;document.getElementById('recibirCambioTurnoID').value=String(id);document.getElementById('recibirSaliente').textContent=txt(prop(t,'operadorSalienteNombre','OperadorSalienteNombre'));document.getElementById('recibirMaquina').textContent=txt(prop(t,'maquinaCodigo','MaquinaCodigo'));document.getElementById('recibirParte').textContent=txt(prop(t,'referenciaSAP','ReferenciaSAP')||prop(t,'numeroParte','NumeroParte'));document.getElementById('recibirFecha').textContent=fecha(prop(t,'fechaEntrega','FechaEntrega'));document.getElementById('recibirOK').textContent=num(prop(t,'cantidadOK','CantidadOK'));document.getElementById('recibirSos').textContent=num(prop(t,'cantidadSospechosa','CantidadSospechosa'));document.getElementById('recibirScrap').textContent=num(prop(t,'cantidadScrap','CantidadScrap'));document.getElementById('recibirCajas').textContent=num(prop(t,'totalCajas','TotalCajas'));document.getElementById('recibirCajasEntregadas').textContent=num(prop(t,'totalCajasEntregadas','TotalCajasEntregadas'));document.getElementById('recibirObservacionesEntrega').textContent=txt(prop(t,'observaciones','Observaciones'),'Sin observaciones.');document.getElementById('observacionesRecepcion').value='';check.checked=false;btn.disabled=true;modal?.show();}
            function render(){count.textContent=String(turnos.length);if(!turnos.length){section.classList.add('d-none');lista.innerHTML='';return;}section.classList.remove('d-none');lista.innerHTML='';turnos.forEach(t=>{const id=Number(prop(t,'cambioTurnoID','CambioTurnoID')||0),card=document.createElement('div');card.className='turn-reception-card';card.innerHTML='<div><div class="label">Entrega de</div><div class="value">'+txt(prop(t,'operadorSalienteNombre','OperadorSalienteNombre'))+'</div><div class="sub">'+fecha(prop(t,'fechaEntrega','FechaEntrega'))+'</div></div><div><div class="label">Máquina</div><div class="value">'+txt(prop(t,'maquinaCodigo','MaquinaCodigo'))+'</div><div class="sub">'+txt(prop(t,'referenciaSAP','ReferenciaSAP')||prop(t,'numeroParte','NumeroParte'))+'</div></div><div><div class="label">Lo que recibes</div><div class="qty"><span class="pill ok">OK '+num(prop(t,'cantidadOK','CantidadOK'))+'</span><span class="pill sos">Sos '+num(prop(t,'cantidadSospechosa','CantidadSospechosa'))+'</span><span class="pill scrap">Scrap '+num(prop(t,'cantidadScrap','CantidadScrap'))+'</span></div><div class="sub mt-1">Cajas '+num(prop(t,'totalCajasEntregadas','TotalCajasEntregadas'))+' / '+num(prop(t,'totalCajas','TotalCajas'))+'</div></div><div><button type="button" class="btn-receive-turn" data-id="'+id+'"><i class="fa-solid fa-handshake me-1"></i>Revisar y recibir</button></div>';lista.appendChild(card);});lista.querySelectorAll('[data-id]').forEach(b=>b.addEventListener('click',()=>abrir(Number(b.dataset.id||0))));}
            async function cargar(){try{const r=await fetch('@Url.Action("ObtenerTurnosPendientesRecepcion", "ProduccionOperador")',{headers:{'X-Requested-With':'XMLHttpRequest'}}),d=await r.json();if(!r.ok||!d||d.ok===false)throw new Error(d?.mensaje||'No fue posible consultar turnos pendientes.');turnos=d.turnos??d.Turnos??[];if(!Array.isArray(turnos))turnos=[];render();}catch(e){console.error(e);}}
            check?.addEventListener('change',()=>btn.disabled=!check.checked);
            form?.addEventListener('submit',function(e){if(!check.checked){e.preventDefault();const m=document.getElementById('mensajeRecepcionTurno');m.innerHTML='<i class="fa-solid fa-triangle-exclamation me-1"></i>Confirma que revisaste lo que estás recibiendo.';m.classList.remove('d-none');return;}btn.disabled=true;btn.innerHTML='<i class="fa-solid fa-spinner fa-spin me-1"></i>Recibiendo turno...';});
            cargar();
            setInterval(function(){if(!document.hidden&&!document.querySelector('.modal.show'))window.location.reload();},60000);
        });
    </script>
}
