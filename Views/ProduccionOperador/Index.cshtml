@model List<ERP.NSQuell.Models.ProduccionOperadorTabletVm>
@using System.Linq
@using System.Collections.Generic
@using ERP.NSQuell.Models
@{
    Layout = null;
    var producciones = Model ?? new List<ProduccionOperadorTabletVm>();
    var alertas = ViewBag.AlertasProximosProgramas as List<ProduccionAlertaProximoProgramaVm> ?? new List<ProduccionAlertaProximoProgramaVm>();
    var maquinas = producciones.Select(x => string.IsNullOrWhiteSpace(x.MaquinaCodigo) ? "SIN MÁQUINA" : x.MaquinaCodigo.Trim()).Distinct(StringComparer.OrdinalIgnoreCase).OrderBy(x => x).ToList();
}
@functions {
    public static string Txt(string? value) => string.IsNullOrWhiteSpace(value) ? "-" : value.Trim();
    public static string ParteTexto(ProduccionOperadorTabletVm item) => !string.IsNullOrWhiteSpace(item.ReferenciaSAP) ? item.ReferenciaSAP : !string.IsNullOrWhiteSpace(item.NumeroParte) ? item.NumeroParte : "-";
    public static string OFTexto(ProduccionOperadorTabletVm item) => !string.IsNullOrWhiteSpace(item.NumeroOFRecibida) ? item.NumeroOFRecibida : !string.IsNullOrWhiteSpace(item.FolioSolicitud) ? item.FolioSolicitud : "Programa " + item.ProgramaProduccionID;
    public static string EstadoTexto(ProduccionOperadorTabletVm item) => item.TieneParoAbierto ? "Paro abierto" : item.EstatusID == ProduccionEstatus.Pausado ? "Pausado" : item.EstatusID == ProduccionEstatus.EnProduccion ? "En producción" : "Programada";
    public static string EstadoClase(ProduccionOperadorTabletVm item) => item.TieneParoAbierto ? "estado-paro" : item.EstatusID == ProduccionEstatus.Pausado ? "estado-pausa" : item.EstatusID == ProduccionEstatus.EnProduccion ? "estado-produccion" : "estado-programada";
    public static decimal Avance(ProduccionOperadorTabletVm item) { var planeada = item.CantidadPlaneada ?? 0; if (planeada <= 0) return 0; return Math.Min(100m, Math.Round(item.CantidadOKTotal * 100m / planeada, 2)); }
    public static string AlertaTiempo(ProduccionAlertaProximoProgramaVm alerta) => alerta.MinutosRestantes < 0 ? "Hace " + Math.Abs(alerta.MinutosRestantes) + " min" : alerta.MinutosRestantes == 0 ? "Ahora" : "En " + alerta.MinutosRestantes + " min";
    public static string AlertaTipo(ProduccionAlertaProximoProgramaVm alerta) => alerta.TipoAlerta == "CAMBIO_MOLDE" ? "Cambio de molde" : alerta.TipoAlerta == "ARRANQUE" ? "Arranque" : "Alerta";
}
<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Kiosco de Operador</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet" />
    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.2/css/all.min.css" rel="stylesheet" />
    <style>
        :root {
            --azul: #004aad;
            --azul-oscuro: #00347a;
            --verde: #107c41;
            --amarillo: #b54708;
            --rojo: #b42318;
            --gris: #667085;
            --borde: #dbe4f0;
            --fondo: #f3f6fa;
            --texto: #172033
        }

        * {
            box-sizing: border-box
        }

        body {
            margin: 0;
            background: var(--fondo);
            color: var(--texto);
            font-family: "Segoe UI",Arial,sans-serif
        }

        .page {
            max-width: 1700px;
            margin: auto;
            padding: 20px
        }

        .hero {
            background: linear-gradient(135deg,var(--azul-oscuro),var(--azul));
            color: #fff;
            border-radius: 22px;
            padding: 20px 22px;
            margin-bottom: 16px;
            box-shadow: 0 18px 42px rgba(0,74,173,.2)
        }

            .hero h1 {
                margin: 0;
                font-size: 1.65rem;
                font-weight: 950
            }

            .hero p {
                margin: 5px 0 0;
                color: rgba(255,255,255,.85);
                font-weight: 650
            }

        .btn-hero {
            display: inline-flex;
            align-items: center;
            gap: 7px;
            border: 1px solid rgba(255,255,255,.35);
            border-radius: 12px;
            padding: 9px 13px;
            color: #fff;
            text-decoration: none;
            font-weight: 900;
            background: rgba(255,255,255,.12)
        }

            .btn-hero:hover {
                background: #fff;
                color: var(--azul)
            }

        .panel {
            background: #fff;
            border: 1px solid var(--borde);
            border-radius: 20px;
            box-shadow: 0 10px 28px rgba(15,23,42,.06);
            overflow: hidden;
            margin-bottom: 16px
        }

        .panel-head {
            padding: 15px 17px;
            background: #f8fbff;
            border-bottom: 1px solid var(--borde);
            font-weight: 950;
            color: var(--azul-oscuro)
        }

        .panel-body {
            padding: 16px
        }

        .filter-grid {
            display: grid;
            grid-template-columns: minmax(240px,360px) 1fr;
            gap: 14px;
            align-items: end
        }

        .filter-label {
            display: block;
            color: var(--gris);
            font-size: .72rem;
            font-weight: 950;
            text-transform: uppercase;
            margin-bottom: 6px
        }

        .form-select {
            border-radius: 12px;
            border-color: var(--borde);
            font-weight: 800
        }

        .alert-toggle {
            width: 100%;
            border: 1px solid #bfdbfe;
            background: #eff6ff;
            color: var(--azul-oscuro);
            border-radius: 14px;
            padding: 12px 14px;
            font-weight: 950;
            display: flex;
            justify-content: space-between;
            align-items: center
        }

            .alert-toggle .fa-chevron-down {
                transition: transform .2s
            }

            .alert-toggle[aria-expanded="true"] .fa-chevron-down {
                transform: rotate(180deg)
            }

        .alert-list {
            display: grid;
            gap: 10px;
            margin-top: 12px
        }

        .alert-row {
            display: grid;
            grid-template-columns: 150px 1fr 1fr 150px 170px;
            gap: 12px;
            align-items: center;
            border: 1px solid var(--borde);
            border-radius: 14px;
            padding: 12px;
            background: #fff
        }

        .alert-time {
            font-weight: 950;
            color: var(--rojo)
        }

        .alert-type {
            font-weight: 900;
            color: var(--azul-oscuro)
        }

        .table-wrap {
            overflow-x: auto
        }

        .prod-table {
            width: 100%;
            border-collapse: separate;
            border-spacing: 0 9px;
            min-width: 1180px
        }

            .prod-table th {
                padding: 8px 10px;
                color: var(--gris);
                font-size: .72rem;
                text-transform: uppercase;
                text-align: left;
                white-space: nowrap
            }

            .prod-table td {
                padding: 12px 10px;
                border-top: 1px solid var(--borde);
                border-bottom: 1px solid var(--borde);
                background: #fff;
                vertical-align: middle
            }

                .prod-table td:first-child {
                    border-left: 1px solid var(--borde);
                    border-radius: 14px 0 0 14px
                }

                .prod-table td:last-child {
                    border-right: 1px solid var(--borde);
                    border-radius: 0 14px 14px 0
                }

        .main {
            font-weight: 950;
            color: var(--azul-oscuro)
        }

        .sub {
            font-size: .8rem;
            color: var(--gris);
            font-weight: 650;
            margin-top: 2px
        }

        .estado {
            display: inline-flex;
            align-items: center;
            border-radius: 999px;
            padding: 6px 9px;
            font-size: .73rem;
            font-weight: 950;
            white-space: nowrap
        }

        .estado-produccion {
            background: #ecfdf3;
            color: var(--verde)
        }

        .estado-pausa {
            background: #fff7ed;
            color: var(--amarillo)
        }

        .estado-paro {
            background: #fef3f2;
            color: var(--rojo)
        }

        .estado-programada {
            background: #eff6ff;
            color: var(--azul)
        }

        .qty {
            display: flex;
            gap: 6px;
            flex-wrap: wrap
        }

        .pill {
            border-radius: 999px;
            padding: 5px 8px;
            font-size: .72rem;
            font-weight: 900;
            background: #f2f4f7
        }

            .pill.ok {
                background: #ecfdf3;
                color: var(--verde)
            }

            .pill.sos {
                background: #fff7ed;
                color: var(--amarillo)
            }

            .pill.scrap {
                background: #fef3f2;
                color: var(--rojo)
            }

        .progress {
            height: 9px;
            border-radius: 999px;
            background: #e9eef7;
            min-width: 130px
        }

        .progress-bar {
            background: var(--azul)
        }

        .btn-captura {
            display: inline-flex;
            align-items: center;
            justify-content: center;
            gap: 7px;
            border-radius: 12px;
            padding: 10px 13px;
            background: var(--azul);
            color: #fff;
            text-decoration: none;
            font-weight: 950;
            white-space: nowrap
        }

            .btn-captura:hover {
                background: var(--azul-oscuro);
                color: #fff
            }

        .empty {
            padding: 40px 20px;
            text-align: center;
            color: var(--gris);
            font-weight: 800
        }

        .machine-summary {
            color: var(--gris);
            font-weight: 800
        }

        .hidden-row {
            display: none !important
        }
        @@media(max - width:800px)

        {
            .page

        {
            padding: 10px
        }

        .filter-grid {
            grid-template-columns: 1fr
        }

        .alert-row {
            grid-template-columns: 1fr
        }

        .hero {
            border-radius: 18px
        }

        }
    </style>
</head>
<body>
    <div class="page">
        <section class="hero"><div class="d-flex justify-content-between align-items-start flex-wrap gap-3"><div><h1><i class="fa-solid fa-tablet-screen-button me-2"></i>Kiosco de Operador</h1><p>Consulta las OF programadas por máquina y entra directamente a la captura horaria.</p></div><div class="d-flex gap-2 flex-wrap"><a href="@Url.Action("Index", "Produccion")" class="btn-hero"></i> <i class="fa-solid fa-rotate-right"></i>Actualizar</a></div></div></section>
        @if (TempData["Success"] != null)
        {
            <div class="alert alert-success rounded-4 fw-bold">@TempData["Success"]</div>
        }
        @if (TempData["Error"] != null)
        {
            <div class="alert alert-danger rounded-4 fw-bold">@TempData["Error"]</div>
        }
        <section class="panel"><div class="panel-head"><i class="fa-solid fa-filter me-2"></i>Filtros</div><div class="panel-body"><div class="filter-grid"><div><label class="filter-label" for="filtroMaquina">Máquina</label><select id="filtroMaquina" class="form-select"><option value="">Todas las máquinas</option>@foreach(var maquina in maquinas){
        <option value="@maquina">@maquina</option>
                }
</select></div><div class="machine-summary" id="resumenFiltro">Mostrando @producciones.Count producción(es).</div></div></div></section>
        <section class="panel"><div class="panel-body"><button class="alert-toggle" type="button" data-bs-toggle="collapse" data-bs-target="#proximasProducciones" aria-expanded="false" aria-controls="proximasProducciones"><span><i class="fa-solid fa-bell me-2"></i>Próximas producciones en 15 minutos (@alertas.Count)</span><i class="fa-solid fa-chevron-down"></i></button><div class="collapse" id="proximasProducciones"><div class="alert-list">@if(alertas.Any()){foreach(var alerta in alertas.OrderBy(x=>x.FechaObjetivo)){
        <div class="alert-row"><div><div class="alert-type">@AlertaTipo(alerta)</div><div class="alert-time">@AlertaTiempo(alerta)</div></div><div><div class="main">@alerta.TextoMaquina</div><div class="sub">Objetivo @alerta.FechaObjetivo.ToString("dd/MM/yyyy HH:mm")</div></div><div><div class="main">@alerta.TextoParte</div><div class="sub">Molde @Txt(alerta.MoldeCodigo)</div></div><div><div class="main">@alerta.CantidadProgramada.ToString("N0")</div><div class="sub">piezas</div></div><div>@if(alerta.EjecucionProduccionID.HasValue){
        <a class="btn-captura" href="@Url.Action("Detalle", "Produccion", new { id = alerta.EjecucionProduccionID.Value })"><i class="fa-solid fa-eye"></i>Ver preparación</a>
                }else
        {

            <a class="btn-captura" href="@Url.Action("Index", "Produccion")"><i class="fa-solid fa-industry"></i>Ir a Producción</a>
        }
</div></div>
                }}else
        {

            <div class="empty">No hay próximas producciones dentro de la ventana de 15 minutos.</div>
        }
</div></div></div></section>
        <section class="panel"><div class="panel-head d-flex justify-content-between align-items-center"><span><i class="fa-solid fa-list-check me-2"></i>OF programadas por máquina</span><span id="contadorVisible" class="badge bg-primary">@producciones.Count</span></div><div class="panel-body">@if(!producciones.Any()){
        <div class="empty"><i class="fa-solid fa-folder-open fa-2x mb-2"></i><div>No hay producciones disponibles.</div></div>
                }else
        {

            <div class="table-wrap"><table class="prod-table"><thead><tr><th>Máquina</th><th>OF / Programa</th><th>Parte</th><th>Operador</th><th>Estado</th><th>Cantidades</th><th>Avance</th><th>Acción</th></tr></thead><tbody>@foreach(var item in producciones.OrderBy(x=>x.MaquinaCodigo).ThenBy(x=>x.ProgramaProduccionID)){var maquina=string.IsNullOrWhiteSpace(item.MaquinaCodigo)?"SIN MÁQUINA":item.MaquinaCodigo.Trim();var avance=Avance(item);var avanceCss=avance.ToString("0.##",System.Globalization.CultureInfo.InvariantCulture);
            <tr data-maquina="@maquina"><td><div class="main">@maquina</div><div class="sub">@Txt(item.MaquinaNombre)</div></td><td><div class="main">@OFTexto(item)</div><div class="sub">Programa @item.ProgramaProduccionID</div></td><td><div class="main">@ParteTexto(item)</div><div class="sub">@Txt(item.DescripcionParte)</div></td><td><div class="main">@Txt(item.OperadorNombre)</div><div class="sub">@(item.OperadorID.HasValue ? "ID " + item.OperadorID.Value : "Sin operador")</div></td><td><span class="estado @EstadoClase(item)">@EstadoTexto(item)</span></td><td><div class="qty"><span class="pill ok">OK @item.CantidadOKTotal.ToString("N0")</span><span class="pill sos">Amarillos @item.CantidadSospechosaTotal.ToString("N0")</span><span class="pill scrap">Scrap @item.CantidadScrapTotal.ToString("N0")</span></div></td><td><div class="d-flex justify-content-between small fw-bold mb-1"><span>@avance.ToString("0.##")%</span><span>@item.CantidadOKTotal.ToString("N0") / @((item.CantidadPlaneada ?? 0).ToString("N0"))</span></div><div class="progress"><div class="progress-bar" style="width:@avanceCss%"></div></div></td>
                                        <td>
                                            <div class="d-flex gap-2 flex-wrap">

                                                <a href="@Url.Action(
                                                               "Captura",
                                                               "ProduccionOperador",
                                                               new { id = item.EjecucionProduccionID })"
                                           class="btn-captura">
                                            <i class="fa-solid fa-keyboard"></i>
                                            Capturar
                                        </a>

                                                <a href="@Url.Action(
                                                       "Cajas",
                                                       "ProduccionOperador",
                                                       new { id = item.EjecucionProduccionID })"
                                           class="btn-captura"
                                           style="background:#107c41;">
                                            <i class="fa-solid fa-box"></i>
                                            Cajas
                                        </a>

                                            </div>
                                        </td>
            </tr>
        }
</tbody></table></div>
                }
</div></section>
    </div>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
    <script>
        document.addEventListener('DOMContentLoaded',function(){const filtro=document.getElementById('filtroMaquina'),filas=Array.from(document.querySelectorAll('tr[data-maquina]')),contador=document.getElementById('contadorVisible'),resumen=document.getElementById('resumenFiltro');function aplicar(){const valor=(filtro?.value||'').trim().toLowerCase();let visibles=0;filas.forEach(f=>{const maquina=(f.dataset.maquina||'').trim().toLowerCase(),mostrar=!valor||maquina===valor;f.classList.toggle('hidden-row',!mostrar);if(mostrar)visibles++;});if(contador)contador.textContent=visibles;if(resumen)resumen.textContent='Mostrando '+visibles+' producción(es).';}filtro?.addEventListener('change',aplicar);setInterval(function(){if(!document.hidden)window.location.reload();},60000);});
    </script>
</body>
</html>
