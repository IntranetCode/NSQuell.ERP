            }

            .btn-extra-start {
                width: 100%;
            }

            .extra-actions {
                align-items: stretch;
                flex-direction: column;
            }

            .btn-extra-cut,
            .btn-extra-finish {
                width: 100%;
            }

            .extra-timer-value {
                font-size: 2.1rem;
            }

            .extra-meta-grid,
            .extra-start-summary {
                grid-template-columns: 1fr;
            }
        }

        @@media(max-width:900px) {
            .shift-summary {
                grid-template-columns: repeat(2,1fr);
            }

            .turn-change-meta {
                grid-template-columns: repeat(2,1fr);
            }

            .turn-change-obs {
                grid-template-columns: 1fr;
            }
        }

        @@media(max-width:700px) {
            .turn-toolbar {
                align-items: stretch;
                flex-direction: column;
            }

            .btn-turn {
                width: 100%;
                justify-content: center;
            }

            .turn-summary-grid {
                grid-template-columns: 1fr 1fr;
            }
        }

        @@media(max-width:1000px) {
            .summary-grid {
                grid-template-columns: repeat(2,1fr)
            }

            .hour-table {
                min-width: 1120px
            }

            .table-wrap {
                overflow-x: auto
            }
        }

        @@media(max-width:650px) {
            .page {
                padding: 10px
            }

            .hero {
                border-radius: 18px
            }

            .modal-grid {
                grid-template-columns: 1fr
            }

            .physical-summary {
                grid-template-columns: 1fr 1fr
            }

            .counter-capture-grid {
                grid-template-columns: 1fr
            }

            .modal-qty {
                height: 62px
            }

            .summary-grid {
                grid-template-columns: 1fr 1fr
            }
        }

        /* =========================================================
           WORKSPACE LH/RH
           ========================================================= */
        .pair-workspace {
            border: 1px solid #b9ccff;
            background: linear-gradient(180deg,#f8fbff,#eef4ff);
            border-radius: 22px;
            padding: 16px;
            margin-bottom: 14px;
            box-shadow: 0 12px 30px rgba(0,74,173,.08)
        }
        .pair-banner {
            display: flex;
            align-items: center;
            justify-content: space-between;
            gap: 12px;
            flex-wrap: wrap;
            padding: 12px 14px;
            border-radius: 15px;
            background: linear-gradient(135deg,#002c6d,#004aad);
            color: #fff;
            margin-bottom: 12px
        }
        .pair-banner-title { font-size: 1.05rem; font-weight: 950 }
        .pair-banner-sub { margin-top: 2px; color: rgba(255,255,255,.82); font-size: .8rem; font-weight: 700 }
        .pair-badge {
            display: inline-flex;
            align-items: center;
            gap: 6px;
            padding: 7px 10px;
            border-radius: 999px;
            background: rgba(255,255,255,.14);
            border: 1px solid rgba(255,255,255,.25);
            font-size: .76rem;
            font-weight: 950
        }
        .pair-grid { display: grid; grid-template-columns: repeat(2,minmax(0,1fr)); gap: 12px }
        .pair-side {
            position: relative;
            overflow: hidden;
            border-radius: 18px;
            border: 1px solid var(--border);
            background: #fff;
            padding: 15px
        }
        .pair-side.lh { border-top: 4px solid #004aad }
        .pair-side.rh { border-top: 4px solid #7c3aed }
        .pair-side-label {
            display: inline-flex;
            align-items: center;
            gap: 6px;
            border-radius: 999px;
            padding: 5px 9px;
            font-size: .72rem;
            font-weight: 950;
            background: #eef4ff;
            color: #1d4ed8
        }
        .pair-side.rh .pair-side-label { background: #f5f3ff; color: #6d28d9 }
        .pair-of { margin-top: 8px; font-size: 1.25rem; font-weight: 950; color: var(--blue-dark) }
        .pair-part { color: #475467; font-size: .86rem; font-weight: 750; margin-top: 2px }
        .pair-side-stats { display: grid; grid-template-columns: repeat(3,minmax(0,1fr)); gap: 7px; margin-top: 12px }
        .pair-stat { background: #f8fafc; border: 1px solid #e4e7ec; border-radius: 11px; padding: 8px }
        .pair-stat .k { color: var(--muted); font-size: .62rem; font-weight: 900; text-transform: uppercase }
        .pair-stat .v { color: var(--blue-dark); font-weight: 950; margin-top: 2px }
        .pair-shared {
            display: grid;
            grid-template-columns: repeat(4,minmax(0,1fr));
            gap: 8px;
            margin-top: 12px
        }
        .pair-shared-card { border: 1px solid #bfdbfe; background: #fff; border-radius: 13px; padding: 10px 11px; text-align: center }
        .pair-shared-card .k { color: var(--muted); font-size: .64rem; text-transform: uppercase; font-weight: 900 }
        .pair-shared-card .v { margin-top: 3px; color: var(--blue-dark); font-size: 1.02rem; font-weight: 950 }
        .pair-note { border: 1px solid #c4b5fd; background: #f5f3ff; color: #5b21b6; border-radius: 14px; padding: 11px 13px; font-weight: 800; margin-bottom: 14px }
        .pair-hour-table { min-width: 1120px }
        .pair-hour-side-cell { min-width: 275px }
        .pair-hour-side {
            border: 1px solid var(--border);
            border-radius: 13px;
            padding: 9px;
            background: #fff
        }
        .pair-hour-side.current { border-left: 4px solid #004aad }
        .pair-hour-side.partner { border-left: 4px solid #7c3aed }
        .pair-hour-side-head { display: flex; align-items: center; justify-content: space-between; gap: 8px; margin-bottom: 8px; font-weight: 950 }
        .pair-hour-side-grid { display: grid; grid-template-columns: repeat(3,minmax(0,1fr)); gap: 6px }
        .pair-hour-mini .k { font-size: .6rem; color: var(--muted); font-weight: 900; text-transform: uppercase; text-align: center }
        .pair-hour-mini .hour-input { height: 45px; min-width: 0; font-size: 1.05rem; margin-top: 3px }
        .pair-hour-obs { margin-top: 7px; min-width: 0; width: 100% }
        .pair-modal-dialog { max-width: 1180px }
        .pair-capture-grid { display: grid; grid-template-columns: repeat(2,minmax(0,1fr)); gap: 14px; margin-top: 14px }
        .pair-capture-side { border: 1px solid var(--border); border-radius: 18px; padding: 14px; background: #fff }
        .pair-capture-side.current { border-top: 4px solid #004aad }
        .pair-capture-side.partner { border-top: 4px solid #7c3aed }
        .pair-capture-head { display: flex; justify-content: space-between; gap: 10px; align-items: flex-start; flex-wrap: wrap; margin-bottom: 12px }
        .pair-capture-title { font-size: 1rem; color: var(--blue-dark); font-weight: 950 }
        .pair-capture-of { color: var(--muted); font-size: .78rem; font-weight: 750; margin-top: 2px }
        .pair-physical-summary { display: grid; grid-template-columns: repeat(3,minmax(0,1fr)); gap: 7px; margin-bottom: 12px }
        .pair-physical-summary .physical-card { padding: 8px }
        .pair-physical-summary .physical-card .v { font-size: 1rem }
        .pair-history-table { min-width: 1050px }
        .pair-disabled-action { opacity: .72 }
        .pair-state-warning { border: 1px solid #fedf89; background: #fffcf5; color: #93370d; border-radius: 14px; padding: 11px 13px; font-weight: 800; margin-bottom: 14px }

        @@media(max-width:900px) {
            .pair-grid,.pair-capture-grid { grid-template-columns: 1fr }
            .pair-shared { grid-template-columns: repeat(2,1fr) }
        }
        @@media(max-width:600px) {
            .pair-side-stats,.pair-hour-side-grid,.pair-physical-summary { grid-template-columns: 1fr 1fr }
            .pair-shared { grid-template-columns: 1fr 1fr }
        }
    </style>
}

<div class="page">
    <section class="hero">
        <div class="d-flex justify-content-between align-items-start flex-wrap gap-3">
            <div>
                <h1><i class="fa-solid @(esLhRh ? "fa-link" : "fa-table-list") me-2"></i>@(esLhRh ? "Producción conjunta LH / RH" : "Captura de producción por hora")</h1>
                <p>@(esLhRh ? $"Grupo LH/RH {relacionPareja!.GrupoLhRh} · una operación física, dos OF trazables." : "Captura cada fila como en AppSheet. La Hora 1 comienza cuando inicia producción en serie.")</p>
            </div>
            <div class="d-flex gap-2 flex-wrap"><a href="@Url.Action("Index", "ProduccionOperador")" class="btn-hero"><i class="fa-solid fa-arrow-left"></i>Kiosco</a><a href="@Url.Action("Captura", "ProduccionOperador", new { id = Model.EjecucionProduccionID })" class="btn-hero"><i class="fa-solid fa-rotate-right"></i>Actualizar</a></div>
        </div>
    </section>

    @if (!string.IsNullOrWhiteSpace(mensajeSuccess))
    {
        var claseResultadoGuardado = mensajeObjetivoNoCumplido ? "danger" : mensajeSinObjetivo ? "neutral" : "success";
        var iconoResultadoGuardado = mensajeObjetivoNoCumplido ? "fa-arrow-trend-down" : mensajeSinObjetivo ? "fa-circle-info" : "fa-circle-check";
        <div class="saved-goal-result @claseResultadoGuardado">
            <i class="fa-solid @iconoResultadoGuardado me-2"></i>@mensajeSuccess
        </div>
    }
    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger rounded-4 fw-bold"><i class="fa-solid fa-triangle-exclamation me-1"></i>@TempData["Error"]</div>
    }
    @if (TempData["Info"] != null)
    {
        <div class="alert alert-info rounded-4 fw-bold"><i class="fa-solid fa-circle-info me-1"></i>@TempData["Info"]</div>
    }

    @if (esLhRh)
    {
        <section class="pair-workspace">
            <div class="pair-banner">
                <div>
                    <div class="pair-banner-title"><i class="fa-solid fa-link me-2"></i>Pareja LH/RH · Grupo @relacionPareja!.GrupoLhRh</div>
                    <div class="pair-banner-sub">Las dos OF comparten máquina, molde, ciclo y contador. Cavidades, OK, scrap, defectos, calidad y cajas permanecen separados por lado.</div>
                </div>
                <span class="pair-badge"><i class="fa-solid fa-gears"></i>@Txt(Model.MaquinaCodigo) · @Txt(Model.MaquinaNombre)</span>
            </div>
            <div class="pair-grid">
                <div class="pair-side lh">
                    <span class="pair-side-label"><i class="fa-solid fa-arrow-left"></i>@ladoActual</span>
                    <div class="pair-of">OF @Txt(Model.NumeroOFRecibida ?? Model.FolioSolicitud)</div>
                    <div class="pair-part">@Txt(Model.ReferenciaSAP ?? Model.NumeroParte) · @Txt(Model.DescripcionParte)</div>
                    <div class="pair-side-stats">
                        <div class="pair-stat"><div class="k">Planeado</div><div class="v">@(planeada > 0 ? Numero(planeada) : "-")</div></div>
                        <div class="pair-stat"><div class="k">OK</div><div class="v text-success">@Numero(Model.CantidadOKTotal)</div></div>
                        <div class="pair-stat"><div class="k">Scrap</div><div class="v text-danger">@Numero(Model.CantidadScrapTotal)</div></div>
                        <div class="pair-stat"><div class="k">Pendiente</div><div class="v">@Numero(pendiente)</div></div>
                        <div class="pair-stat"><div class="k">Cavidades</div><div class="v">@(cavidadesEnUso.HasValue ? cavidadesEnUso.Value.ToString("N0") : "-")</div></div>
                        <div class="pair-stat"><div class="k">Objetivo/h</div><div class="v">@(objetivoHora.HasValue ? objetivoHora.Value.ToString("N0") : "-")</div></div>
                    </div>
                    <div class="small text-muted fw-bold mt-2">Avance @avance.ToString("0.##")% · Bonus provisional @bonusActual.ToString("N0")</div>
                </div>
                <div class="pair-side rh">
                    <span class="pair-side-label"><i class="fa-solid fa-arrow-right"></i>@ladoPareja</span>
                    <div class="pair-of">OF @Txt(produccionPareja!.NumeroOFRecibida ?? produccionPareja.FolioSolicitud)</div>
                    <div class="pair-part">@Txt(produccionPareja.ReferenciaSAP ?? produccionPareja.NumeroParte) · @Txt(produccionPareja.DescripcionParte)</div>
                    <div class="pair-side-stats">
                        <div class="pair-stat"><div class="k">Planeado</div><div class="v">@(planeadaPareja > 0 ? Numero(planeadaPareja) : "-")</div></div>
                        <div class="pair-stat"><div class="k">OK</div><div class="v text-success">@Numero(produccionPareja.CantidadOKTotal)</div></div>
                        <div class="pair-stat"><div class="k">Scrap</div><div class="v text-danger">@Numero(produccionPareja.CantidadScrapTotal)</div></div>
                        <div class="pair-stat"><div class="k">Pendiente</div><div class="v">@Numero(pendientePareja)</div></div>
                        <div class="pair-stat"><div class="k">Cavidades</div><div class="v">@(cavidadesEnUsoPareja.HasValue ? cavidadesEnUsoPareja.Value.ToString("N0") : "-")</div></div>
                        <div class="pair-stat"><div class="k">Objetivo/h</div><div class="v">@(objetivoHoraPareja.HasValue ? objetivoHoraPareja.Value.ToString("N0") : "-")</div></div>
                    </div>
                    <div class="small text-muted fw-bold mt-2">Avance @avancePareja.ToString("0.##")% · Bonus provisional @bonusPareja.ToString("N0")</div>
                </div>
            </div>
            <div class="pair-shared">
                <div class="pair-shared-card"><div class="k">Máquina física</div><div class="v">@Txt(Model.MaquinaCodigo)</div></div>
                <div class="pair-shared-card"><div class="k">Ciclo compartido</div><div class="v">@(cicloEnUso.HasValue ? $"{cicloEnUso.Value:0.##} s" : "-")</div></div>
                <div class="pair-shared-card"><div class="k">Último contador</div><div class="v">@(ultimoContadorCompartido.HasValue ? ultimoContadorCompartido.Value.ToString("N0") : "Revisar")</div></div>
                <div class="pair-shared-card"><div class="k">Estado conjunto</div><div class="v">@(capturaLhRhBloqueada ? "Bloqueado" : tieneParoFisico ? "En paro" : ambasEnProduccion ? "Produciendo" : "Revisar")</div></div>
            </div>
        </section>
    }
    else
    {
    <section class="summary-grid">

        <div class="summary">
            <div class="k">Máquina</div>
            <div class="v">
                @Txt(Model.MaquinaCodigo)
            </div>
            <div class="text-muted small">
                @Txt(Model.MaquinaNombre)
            </div>
        </div>

        <div class="summary">
            <div class="k">Parte</div>
            <div class="v">
                @Txt(
                Model.ReferenciaSAP
                ?? Model.NumeroParte)
            </div>
            <div class="text-muted small">
                @Txt(Model.DescripcionParte)
            </div>
        </div>

        <div class="summary objective-summary">
            <div class="k">
                Meta de la OF
            </div>

            <div class="v">
                @(planeada > 0
                                ? Numero(planeada)
                                : "-")
            </div>

            <div class="text-muted small">
                @(planeada > 0
                                ? "Piezas requeridas"
                                : "Sin cantidad planeada")
            </div>
        </div>

        <div class="summary">
            <div class="k">
                Verdes / OK acumulado
            </div>

            <div class="v text-success">
                @Numero(Model.CantidadOKTotal)
            </div>

            <div class="text-muted small">
                @avance.ToString("0.##")% de la OF
            </div>
        </div>

        <div class="summary">
            <div class="k">
                Pendiente OF
            </div>

            <div class="v @(pendiente > 0
                                                                                        ? "text-primary"
                                                                                        : "text-success")">
                @Numero(pendiente)
            </div>

            <div class="text-muted small">
                @(pendiente > 0
                                ? "Piezas verdes / OK por producir"
                                : "Meta alcanzada")
            </div>
        </div>

        <div class="summary">
            <div class="k">
                Rojas / Scrap
            </div>

            <div class="v text-danger">
                @Numero(
                                Model.CantidadScrapTotal)
            </div>
        </div>

        <div class="summary objective-summary">
            <div class="k">
                Objetivo por hora
            </div>

            <div class="v">
                @(objetivoHora.HasValue &&
                                objetivoHora.Value > 0
                                ? Numero(objetivoHora.Value)
                                : "-")
            </div>

            <div class="text-muted small">
                @(objetivoHora.HasValue &&
                                objetivoHora.Value > 0
                                ? "PZA / H"
                                : "Sin objetivo configurado")

                @if (cicloEnUso.HasValue)
                {
                    <span>
                        · Ciclo
                        @cicloEnUso.Value.ToString("0.##") s
                    </span>
                }

                @if (cavidadesEnUso.HasValue)
                {
                    <span>
                        · @cavidadesEnUso.Value cav.
                    </span>
                }
            </div>
        </div>

        <div class="summary objective-summary">
            <div class="k">Configuración en uso</div>
            <div class="v">
                @(cavidadesEnUso.HasValue ? $"{cavidadesEnUso.Value:N0} cav." : "-")
            </div>
            <div class="text-muted small">
                @(cicloEnUso.HasValue ? $"Ciclo {cicloEnUso.Value:0.##} s" : "Sin ciclo confirmado")
                @(Model.TieneConfiguracionReal ? " · Técnico" : " · Valor de referencia")
            </div>
        </div>

        <div class="summary objective-summary">
            <div class="k">Último contador</div>
            <div class="v">
                @(ultimoContador.HasValue? ultimoContador.Value.ToString("N0") : "-")
            </div>
            <div class="text-muted small">
                @(ultimoContador.HasValue ? "Última lectura registrada" : "Pendiente de lectura base")
            </div>
        </div>

        <div class="summary objective-summary">
            <div class="k">Bonus provisional</div>
            <div class="v text-success">@bonusActual.ToString("N0")</div>
            <div class="text-muted small">Piezas verdes abonadas provisionalmente; cualquier ajuste posterior queda trazado.</div>
        </div>

    </section>

    }

    @if (esLhRh)
    {
        <section class="turn-toolbar pair-disabled-action">
            <div>
                <div class="turn-title"><i class="fa-solid fa-people-arrows-left-right me-2"></i>Entrega de turno · Pareja LH/RH</div>
                <div class="turn-subtitle">La entrega debe cambiar al operador de las dos OF en una sola operación. Mientras el endpoint conjunto no esté habilitado, esta acción queda protegida para evitar desincronizar los lados.</div>
            </div>
            <button type="button" class="btn-turn" disabled><i class="fa-solid fa-lock"></i>Entrega conjunta</button>
        </section>
        <section class="paro-toolbar pair-disabled-action">
            <div>
                <div class="paro-title"><i class="fa-solid fa-link me-2"></i>Paro físico LH/RH</div>
                <div class="paro-subtitle">Un paro de esta máquina debe afectar simultáneamente a ambas ejecuciones. La captura horaria conjunta sí está habilitada; el paro desde Operador permanecerá protegido hasta usar el método atómico LH/RH.</div>
            </div>
            <button type="button" class="btn-paro-start" disabled><i class="fa-solid fa-lock"></i>Paro conjunto</button>
        </section>
    }
    else
    {
    <section class="turn-toolbar">
        <div>
            <div class="turn-title">
                <i class="fa-solid fa-arrow-right-arrow-left me-2"></i>Entrega de turno
            </div>
            <div class="turn-subtitle">
                Entrega la producción al siguiente operador. El cambio será efectivo únicamente cuando el operador entrante confirme la recepción.
            </div>
        </div>
        @if (Model.EstatusID == ERP.NSQuell.Models.ProduccionEstatus.EnProduccion)
        {
            <button type="button"
                    class="btn-turn"
                    id="btnAbrirCambioTurno"
                    @(Model.TieneParoAbierto ? "disabled" : "")>
                <i class="fa-solid fa-right-from-bracket"></i>
                Entregar turno
            </button>
        }
        else
        {
            <button type="button" class="btn-turn" disabled>
                <i class="fa-solid fa-right-from-bracket"></i>
                Entregar turno
            </button>
        }
    </section>

    <section class="paro-toolbar @(Model.TieneParoAbierto ? "open" : "")">
        <div>
            <div class="paro-title">
                <i class="fa-solid @(Model.TieneParoAbierto ? "fa-circle-pause text-danger" : "fa-triangle-exclamation text-warning") me-2"></i>
                @(Model.TieneParoAbierto ? "Paro de máquina activo" : "Control de paro de máquina")
            </div>
            <div class="paro-subtitle">
                @(Model.TieneParoAbierto
                                ? "La producción está pausada. Finaliza el paro cuando la máquina esté lista para continuar."
                                : "El operador puede reportar un paro cuando la máquina o el proceso deban detenerse.")
            </div>
        </div>

        @if (Model.TieneParoAbierto && Model.ParoAbiertoID.HasValue)
        {
            <button type="button"
                    class="btn-paro-close"
                    data-bs-toggle="modal"
                    data-bs-target="#modalCerrarParo">
                <i class="fa-solid fa-play"></i>
                Finalizar paro
            </button>
        }
        else if (Model.EstatusID == ERP.NSQuell.Models.ProduccionEstatus.EnProduccion)
        {
            <button type="button"
                    class="btn-paro-start"
                    data-bs-toggle="modal"
                    data-bs-target="#modalIniciarParo">
                <i class="fa-solid fa-stop"></i>
                Reportar paro
            </button>
        }
    </section>

    }

    @if (esLhRh)
    {
        <section class="panel">
            <div class="panel-head d-flex justify-content-between align-items-center flex-wrap gap-2">
                <span><i class="fa-solid fa-link me-2"></i>Registro por hora · Producción conjunta LH/RH</span>
                <span class="badge bg-primary">Grupo @relacionPareja!.GrupoLhRh · @ladoActual + @ladoPareja</span>
            </div>
            <div class="panel-body">
                @if (!string.IsNullOrWhiteSpace(errorLhRh))
                {
                    <div class="alert alert-danger rounded-4 fw-bold"><i class="fa-solid fa-triangle-exclamation me-1"></i>@errorLhRh</div>
                }
                @if (capturaLhRhBloqueada)
                {
                    <div class="pair-state-warning"><i class="fa-solid fa-lock me-1"></i>La captura conjunta está bloqueada porque las dos ejecuciones no están sincronizadas. Corrige la condición indicada arriba y actualiza la pantalla.</div>
                }
                else if (tieneParoFisico)
                {
                    <div class="alert alert-danger fw-bold"><i class="fa-solid fa-circle-pause me-1"></i>Existe un paro abierto en al menos uno de los lados. No se guardará una hora parcial LH/RH.</div>
                }
                else if (Model.EstatusID != ERP.NSQuell.Models.ProduccionEstatus.EnProduccion || produccionPareja!.EstatusID != ERP.NSQuell.Models.ProduccionEstatus.EnProduccion)
                {
                    <div class="alert alert-warning fw-bold"><i class="fa-solid fa-triangle-exclamation me-1"></i>Ambas OF deben estar en Producción para habilitar la captura conjunta.</div>
                }
                else
                {
