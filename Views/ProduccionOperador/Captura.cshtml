                                                        <div class="pair-hour-mini"><div class="k">Scrap</div><input class="hour-input scrap empty-number" type="number" min="0" value="0" data-field="scrap-pareja" @(editable ? "" : "disabled") /></div>
                                                    </div>
                                                    <input class="obs-input form-control pair-hour-obs" maxlength="500" placeholder="Observaciones @ladoPareja" data-field="obs-pareja" @(editable ? "" : "disabled") />
                                                }
                                            </div>
                                        </td>
                                        <td><span class="status-pill @(editable ? EstadoClase(fila) : "status-future")">@(filaPareja == null ? "Desfasada" : editable ? EstadoTexto(fila) : "Pendiente")</span></td>
                                        <td><button type="button" class="btn-save-row btn-open-hour" @(editable ? "" : "disabled")><i class="fa-solid fa-floppy-disk me-1"></i>Capturar ambas</button></td>
                                    </tr>
                                }
