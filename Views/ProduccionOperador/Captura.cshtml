            const maquinaNombre=propiedad(resumen,'maquinaNombre','MaquinaNombre');
            const maquina=[maquinaCodigo,maquinaNombre].filter(x=>x&&String(x).trim()!=='').join(' - ');
            document.getElementById('turnMaquina').textContent=textoSeguro(maquina);
            document.getElementById('turnParte').textContent=textoSeguro(propiedad(resumen,'referenciaSAP','ReferenciaSAP')||propiedad(resumen,'numeroParte','NumeroParte'));
            document.getElementById('turnUltimaHora').textContent=textoSeguro(propiedad(resumen,'ultimaHoraTexto','UltimaHoraTexto'),'Sin captura registrada');
            document.getElementById('turnOperadorSaliente').textContent=textoSeguro(propiedad(resumen,'operadorSalienteNombre','OperadorSalienteNombre'));
            document.getElementById('turnCantidadOK').textContent=numeroCambioTurno(propiedad(resumen,'cantidadOK','CantidadOK'));
            document.getElementById('turnCantidadScrap').textContent=numeroCambioTurno(propiedad(resumen,'cantidadScrap','CantidadScrap'));
            document.getElementById('turnTotalCajas').textContent=numeroCambioTurno(propiedad(resumen,'totalCajas','TotalCajas'));
            document.getElementById('turnCajasEntregadas').textContent=numeroCambioTurno(propiedad(resumen,'totalCajasEntregadas','TotalCajasEntregadas'));
            const cajasPendientes=Number(propiedad(resumen,'totalCajasPendientes','TotalCajasPendientes')||0);
            document.getElementById('turnCajasPendientes').textContent=numeroCambioTurno(cajasPendientes);
            const badgePendientes=document.getElementById('badgeCajasPendientes');
            if(badgePendientes){
                badgePendientes.className=cajasPendientes>0?'danger':'ok';
                badgePendientes.innerHTML=cajasPendientes>0
                    ?'<i class="fa-solid fa-triangle-exclamation me-1"></i>Pendientes: <strong>'+numeroCambioTurno(cajasPendientes)+'</strong>'
                    :'<i class="fa-solid fa-circle-check me-1"></i>Pendientes: <strong>0</strong>';
            }
            const puedeEntregar=Boolean(propiedad(resumen,'puedeEntregar','PuedeEntregar'));
            const motivoBloqueo=propiedad(resumen,'motivoBloqueo','MotivoBloqueo');
            const validacion=document.getElementById('turnValidacionEntrega');
            if(validacion){
                if(puedeEntregar){
                    validacion.className='turn-validation ok';
                    validacion.innerHTML='<i class="fa-solid fa-circle-check me-1"></i>La producción está lista para entregar el turno.';
                }else{
                    validacion.className='turn-validation error';
                    validacion.innerHTML='<i class="fa-solid fa-triangle-exclamation me-1"></i>'+textoSeguro(motivoBloqueo,'El turno no puede entregarse en este momento.');
                }
            }
            const operadorSugeridoId=propiedad(resumen,'operadorSugeridoID','OperadorSugeridoID');
            const operadorSugeridoNombre=propiedad(resumen,'operadorSugeridoNombre','OperadorSugeridoNombre');
            const turnoSugeridoNombre=propiedad(resumen,'turnoSugeridoNombre','TurnoSugeridoNombre');
            const escalaEncontrada=Boolean(propiedad(resumen,'escalaEncontrada','EscalaEncontrada'));
            const escalaFolio=propiedad(resumen,'escalaFolio','EscalaFolio');
            const sugeridoPorTecnico=Boolean(propiedad(resumen,'sugeridoPorTecnico','SugeridoPorTecnico'));
            const tecnicoNombre=propiedad(resumen,'tecnicoSugerenciaNombre','TecnicoSugerenciaNombre');
            const fechaSugerenciaTecnico=propiedad(resumen,'fechaSugerenciaTecnico','FechaSugerenciaTecnico');
            const observacionesSugerenciaTecnico=propiedad(resumen,'observacionesSugerenciaTecnico','ObservacionesSugerenciaTecnico');
            const sugeridoBox=document.getElementById('turnSugeridoBox');
            const sugeridoLabel=document.getElementById('turnSugeridoLabel');
            const sugeridoIcono=document.getElementById('turnSugeridoIcono');
            const tecnicoMeta=document.getElementById('turnTecnicoMeta');
            const tecnicoObservacion=document.getElementById('turnTecnicoObservacion');
            if(operadorSugeridoId&&sugeridoBox){
                document.getElementById('turnOperadorSugerido').textContent=textoSeguro(operadorSugeridoNombre);
                sugeridoBox.classList.toggle('technician',sugeridoPorTecnico);
                if(sugeridoLabel)sugeridoLabel.textContent=sugeridoPorTecnico?'Operador sugerido por el técnico':'Operador sugerido según escala';
                if(sugeridoIcono)sugeridoIcono.className=sugeridoPorTecnico?'fa-solid fa-user-gear':'fa-solid fa-calendar-check';
                let detalle=sugeridoPorTecnico?'Sugerencia del técnico':'Según escala';
                if(turnoSugeridoNombre)detalle+=' · Turno '+turnoSugeridoNombre;
                if(!sugeridoPorTecnico&&escalaFolio)detalle+=' · '+escalaFolio;
                document.getElementById('turnSugeridoDetalle').textContent=detalle;
                if(tecnicoMeta){
                    if(sugeridoPorTecnico){
                        let meta='Sugerido por '+textoSeguro(tecnicoNombre,'Técnico de Producción');
                        if(fechaSugerenciaTecnico){
                            const fecha=new Date(fechaSugerenciaTecnico);
                            if(!Number.isNaN(fecha.getTime()))meta+=' · '+fecha.toLocaleString('es-MX',{dateStyle:'short',timeStyle:'short'});
                        }
                        tecnicoMeta.textContent=meta;
                        tecnicoMeta.classList.remove('d-none');
                    }else{
                        tecnicoMeta.textContent='';
                        tecnicoMeta.classList.add('d-none');
                    }
                }
                if(tecnicoObservacion){
                    if(sugeridoPorTecnico&&observacionesSugerenciaTecnico&&String(observacionesSugerenciaTecnico).trim()!==''){
                        tecnicoObservacion.textContent='Observación del técnico: '+String(observacionesSugerenciaTecnico).trim();
                        tecnicoObservacion.classList.remove('d-none');
                    }else{
                        tecnicoObservacion.textContent='';
                        tecnicoObservacion.classList.add('d-none');
                    }
                }
                sugeridoBox.classList.remove('d-none');
            }else if(sugeridoBox){
                sugeridoBox.classList.add('d-none');
                sugeridoBox.classList.remove('technician');
                if(tecnicoMeta){tecnicoMeta.textContent='';tecnicoMeta.classList.add('d-none');}
                if(tecnicoObservacion){tecnicoObservacion.textContent='';tecnicoObservacion.classList.add('d-none');}
            }
            const tieneMatriz=Boolean(propiedad(resumen,'tieneMatrizPolivalencia','TieneMatrizPolivalencia'));
            const ayuda=document.getElementById('turnAyudaOperador');
            if(ayuda){
                if(operadorSugeridoId&&sugeridoPorTecnico){
                    ayuda.textContent='El técnico recomienda a este operador para el cambio de turno. La selección sigue abierta: puedes elegir otro operador autorizado si al momento del relevo cambió la disponibilidad.';
                }else if(operadorSugeridoId){
                    ayuda.textContent='No existe una sugerencia vigente del técnico; el sistema propone al operador de escala más próximo. Puedes seleccionar otro operador autorizado si es necesario.';
                }else if(escalaEncontrada&&tieneMatriz){
                    ayuda.textContent='Existe escala vigente, pero no se encontró un operador válido para sugerir. Selecciona manualmente un operador N1-N4 autorizado para esta parte.';
                }else if(tieneMatriz){
                    ayuda.textContent='No existe una sugerencia vigente. Selecciona manualmente un operador N1-N4 autorizado para esta parte.';
                }else{
                    ayuda.textContent='La parte no tiene matriz de polivalencia configurada. Selecciona un operador activo del catálogo.';
                }
            }
            const operadores=obtenerOperadoresResumen(resumen);
            if(selectOperadorEntrante){
                selectOperadorEntrante.innerHTML='<option value="">Selecciona operador</option>';
                operadores.forEach(function(op){
                    const personaId=propiedad(op,'personaID','PersonaID');
                    const nombre=textoSeguro(propiedad(op,'nombre','Nombre'));
                    const nivel=propiedad(op,'nivel','Nivel');
                    const turno=propiedad(op,'turnoNombre','TurnoNombre');
                    const enEscala=Boolean(propiedad(op,'enEscala','EnEscala'));
                    const option=document.createElement('option');
                    option.value=personaId;
                    let texto=nombre;
                    if(nivel!==null&&nivel!==undefined)texto+=' · N'+nivel;
                    if(turno)texto+=' · '+turno;
                    if(enEscala)texto+=' · ESCALA';
                    option.textContent=texto;
                    option.dataset.escala=enEscala?'true':'false';
                    option.dataset.nivel=nivel??'';
                    selectOperadorEntrante.appendChild(option);
                });
                selectOperadorEntrante.disabled=!puedeEntregar||operadores.length===0;
                if(operadorSugeridoId&&operadores.some(x=>Number(propiedad(x,'personaID','PersonaID'))===Number(operadorSugeridoId))){
                    selectOperadorEntrante.value=String(operadorSugeridoId);
                }
            }
            if(operadores.length===0&&puedeEntregar){
                mostrarErrorCambioTurno('No existen operadores disponibles para recibir el turno. Revisa la escala o la matriz de polivalencia.');
            }
            pintarOperadorSeleccionado();
            evaluarBotonCambioTurno();
        }
        async function cargarCambioTurno(){
            limpiarCambioTurno();
            try{
                const url='@Url.Action("ObtenerResumenCambioTurno", "ProduccionOperador")'+'?ejecucionProduccionId=@Model.EjecucionProduccionID';
                const response=await fetch(url,{
                    method:'GET',
                    headers:{'X-Requested-With':'XMLHttpRequest'}
                });
                let data=null;
                try{
                    data=await response.json();
                }catch{
                    data=null;
                }
                if(!response.ok||!data||data.ok===false){
                    throw new Error(data?.mensaje||'No fue posible consultar la información para entregar el turno.');
                }
                const resumen=data.resumen??data.Resumen;
                if(!resumen)throw new Error('El servidor no devolvió el resumen del cambio de turno.');
                llenarResumenCambioTurno(resumen);
                document.getElementById('cambioTurnoLoading')?.classList.add('d-none');
                document.getElementById('cambioTurnoContenido')?.classList.remove('d-none');
            }catch(error){
                document.getElementById('cambioTurnoLoading')?.classList.add('d-none');
                document.getElementById('cambioTurnoContenido')?.classList.remove('d-none');
                mostrarErrorCambioTurno(error?.message||'No fue posible cargar la entrega de turno.');
            }
        }
        btnAbrirCambioTurno?.addEventListener('click',async function(){
            modalCambioTurno?.show();
            await cargarCambioTurno();
        });
        selectOperadorEntrante?.addEventListener('change',function(){
            pintarOperadorSeleccionado();
            evaluarBotonCambioTurno();
        });
        formCambioTurno?.addEventListener('submit',function(e){
            ocultarErrorCambioTurno();
            if(!resumenCambioTurno){
                e.preventDefault();
                mostrarErrorCambioTurno('No se ha cargado la información de la entrega.');
                return;
            }
            const puedeEntregar=Boolean(propiedad(resumenCambioTurno,'puedeEntregar','PuedeEntregar'));
            if(!puedeEntregar){
                e.preventDefault();
                mostrarErrorCambioTurno(textoSeguro(propiedad(resumenCambioTurno,'motivoBloqueo','MotivoBloqueo'),'El turno no puede entregarse.'));
                return;
            }
            const operadorId=Number(selectOperadorEntrante?.value||0);
            if(operadorId<=0){
                e.preventDefault();
                mostrarErrorCambioTurno('Selecciona al operador que recibirá el turno.');
                return;
            }
            const operador=obtenerOperadorPorId(operadorId);
            if(!operador){
                e.preventDefault();
                mostrarErrorCambioTurno('El operador seleccionado ya no se encuentra dentro de los candidatos autorizados.');
                return;
            }
            if(btnConfirmarCambioTurno){
                btnConfirmarCambioTurno.disabled=true;
                btnConfirmarCambioTurno.innerHTML='<i class="fa-solid fa-spinner fa-spin me-1"></i>Enviando turno...';
            }
        });
        modalCambioTurnoElemento?.addEventListener('hidden.bs.modal',function(){
            limpiarCambioTurno();
            if(btnConfirmarCambioTurno){
                btnConfirmarCambioTurno.innerHTML='<i class="fa-solid fa-paper-plane me-1"></i>Enviar turno para recepción';
            }
        });

            function formatoCronometro(segundos){
                const total=Math.max(0,Math.floor(Number(segundos)||0));
                const horas=Math.floor(total/3600);
                const minutos=Math.floor((total%3600)/60);
                const seg=total%60;
                return String(horas).padStart(2,'0')+':'+String(minutos).padStart(2,'0')+':'+String(seg).padStart(2,'0');
            }

            const panelTiempoExtra=document.getElementById('panelTiempoExtra');
            const btnCapturarCorteTiempoExtra=document.getElementById('btnCapturarCorteTiempoExtra');
            const btnFinalizarTiempoExtra=document.getElementById('btnFinalizarTiempoExtra');
            const alertaCorteTiempoExtra=document.getElementById('alertaCorteTiempoExtra');
            const modalCorteTiempoExtraElemento=document.getElementById('modalCorteTiempoExtra');
            const modalCorteTiempoExtra=modalCorteTiempoExtraElemento?bootstrap.Modal.getOrCreateInstance(modalCorteTiempoExtraElemento):null;
            const formCorteTiempoExtra=document.getElementById('formCorteTiempoExtra');
            const urlPrevisualizarCorteTiempoExtra='@Url.Action("PrevisualizarCorteTiempoExtra", "ProduccionOperador")';
            const urlCapturarCorteTiempoExtra='@Url.Action("CapturarCorteTiempoExtra", "ProduccionOperador")';
            const urlFinalizarTiempoExtra='@Url.Action("FinalizarTiempoExtra", "ProduccionOperador")';
            let modoRegistroTiempoExtra='CORTE';
            let segundosCorteActual=panelTiempoExtra?Number(panelTiempoExtra.dataset.segundosCorte||0):0;
            let extraPreviewTimer=null;
            let extraPreviewSecuencia=0;
            let ultimaPrevisualizacionExtra=null;
            let extraPreviewValida=false;

            function actualizarBotonConfirmarExtra(){
                const boton=document.getElementById('btnConfirmarCorteTiempoExtra');
                if(!boton)return;
                const cortePermitido=modoRegistroTiempoExtra!=='CORTE'||segundosCorteActual>=3600;
                const defectosValidos=evaluarDefectos('extra').valido;
                boton.disabled=!ejecucionEnProduccion||tieneParoAbierto||!extraPreviewValida||!cortePermitido||!defectosValidos;
            }

            function mostrarMensajeCorteExtra(mensaje){
                const box=document.getElementById('mensajeCorteTiempoExtra');
                if(!box)return;
                box.innerHTML='<i class="fa-solid fa-triangle-exclamation me-2"></i>'+mensaje;
                box.classList.remove('d-none');
            }

            function limpiarMensajeCorteExtra(){
                const box=document.getElementById('mensajeCorteTiempoExtra');
                if(!box)return;
                box.classList.add('d-none');
                box.innerHTML='';
            }

            function limpiarPrevisualizacionExtra(){
                ultimaPrevisualizacionExtra=null;
                extraPreviewValida=false;
                const ids=['extraPiezasFisicas','extraOKSugerido','extraObjetivoBloque','extraCumplimiento','extraBonusInicial'];
                ids.forEach(id=>{const el=document.getElementById(id);if(el)el.textContent='-';});
                const ok=document.getElementById('extraOK');
                if(ok)ok.value='';
                actualizarBotonConfirmarExtra();
            }

            function establecerOKAutomaticoExtra(valor){
                const input=document.getElementById('extraOK');
                if(!input)return;
                input.value=Number(valor||0).toString();
            }

            function actualizarComparacionExtra(){
                const ok=numeroSeguro(document.getElementById('extraOK'));
                const bonus=document.getElementById('extraBonusInicial');
                if(bonus)bonus.textContent='+'+Math.max(0,ok).toLocaleString('es-MX');
                const cumplimiento=document.getElementById('extraCumplimiento');
                if(!cumplimiento)return;
                if(!ultimaPrevisualizacionExtra){
                    cumplimiento.textContent='-';
                    cumplimiento.className='v';
                    return;
                }
                const objetivo=Number(ultimaPrevisualizacionExtra.objetivoBloque??ultimaPrevisualizacionExtra.ObjetivoBloque??0);
                if(objetivo<=0){
                    cumplimiento.textContent='-';
                    cumplimiento.className='v';
                    return;
                }
                const porcentaje=Math.round((ok*1000)/objetivo)/10;
                cumplimiento.textContent=porcentaje.toLocaleString('es-MX')+'%';
                cumplimiento.className='v '+(ok>=objetivo?'text-success':'text-danger');
            }

            function actualizarClasificacionExtra(){
                const feedback=document.getElementById('extraClasificacionFeedback');
                if(!feedback)return;
                const ok=numeroSeguro(document.getElementById('extraOK'));
                const scrap=numeroSeguro(document.getElementById('extraScrap'));
                actualizarComparacionExtra();
                if(!ultimaPrevisualizacionExtra){
                    feedback.className='classification-feedback';
                    feedback.innerHTML='<i class="fa-solid fa-circle-info me-1"></i>Captura el contador y las piezas rojas para calcular automáticamente las verdes de este periodo.';
                    return;
                }
                const fisicas=Number(ultimaPrevisualizacionExtra.piezasFisicas??ultimaPrevisualizacionExtra.PiezasFisicas??0);
                const total=ok+scrap;
                if(total===fisicas){
                    feedback.className='classification-feedback ok';
                    feedback.innerHTML='<i class="fa-solid fa-circle-check me-1"></i>Producción física: <strong>'+fisicas.toLocaleString('es-MX')+'</strong> · Verdes/OK: <strong>'+ok.toLocaleString('es-MX')+'</strong> · Rojas/Scrap: <strong>'+scrap.toLocaleString('es-MX')+'</strong>.';
                    return;
                }
                feedback.className='classification-feedback warning';
                feedback.innerHTML='<i class="fa-solid fa-triangle-exclamation me-1"></i>El cálculo cambió. Espera a que el ERP actualice las verdes antes de guardar.';
            }

            function pintarPrevisualizacionExtra(data,forzarAutomatico=false){
                ultimaPrevisualizacionExtra=data;
                extraPreviewValida=true;
                const fisicas=Number(data.piezasFisicas??data.PiezasFisicas??0);
                const sugerido=Number(data.cantidadOK??data.CantidadOK??0);
                const objetivo=Number(data.objetivoBloque??data.ObjetivoBloque??0);
                const minutos=Number(data.minutosProductivos??data.MinutosProductivos??0);
                const segmentos=Number(data.numeroSegmentos??data.NumeroSegmentos??0);
                const numeroCorte=Number(data.numeroCorte??data.NumeroCorte??0);
                const pFisicas=document.getElementById('extraPiezasFisicas');
                const pSugerido=document.getElementById('extraOKSugerido');
                const pObjetivo=document.getElementById('extraObjetivoBloque');
                if(pFisicas)pFisicas.textContent=fisicas.toLocaleString('es-MX');
                if(pSugerido)pSugerido.textContent=sugerido.toLocaleString('es-MX');
                if(pObjetivo)pObjetivo.textContent=objetivo>0?objetivo.toLocaleString('es-MX'):'-';
                establecerOKAutomaticoExtra(sugerido);
                const contadorInicial=data.contadorInicial??data.ContadorInicial;
                const contadorFinal=data.contadorFinal??data.ContadorFinal;
                const feedback=document.getElementById('extraContadorFeedback');
                if(feedback){
                    let texto='<i class="fa-solid fa-calculator me-1"></i><strong>'+fisicas.toLocaleString('es-MX')+' pieza(s) físicas</strong> calculadas por el servidor';
                    if(numeroCorte>0)texto+=' para el corte #'+numeroCorte;
                    texto+='. '+minutos.toLocaleString('es-MX',{maximumFractionDigits:2})+' min productivos · '+segmentos.toLocaleString('es-MX')+' segmento(s).';
                    if(contadorInicial!==null&&contadorInicial!==undefined&&contadorFinal!==null&&contadorFinal!==undefined)texto+=' Contador '+Number(contadorInicial).toLocaleString('es-MX')+' → '+Number(contadorFinal).toLocaleString('es-MX')+'.';
                    if(Boolean(data.tieneCambioConfiguracion??data.TieneCambioConfiguracion))texto+=' <span class="text-primary">Se consideraron cambios de configuración.</span>';
                    if(Boolean(data.tieneReinicioContador??data.TieneReinicioContador))texto+=' <span class="text-warning">Se detectó reinicio del contador.</span>';
                    feedback.className='counter-feedback';
                    feedback.innerHTML=texto;
                }
                const servidorDiceDisponible=Boolean(data.corte60Disponible??data.Corte60Disponible);
                if(modoRegistroTiempoExtra==='CORTE'&&!servidorDiceDisponible){
                    extraPreviewValida=false;
                    const segundosFaltantes=Number(data.segundosParaCorte??data.SegundosParaCorte??0);
                    mostrarMensajeCorteExtra('El bloque todavía no cumple 60 minutos. Faltan aproximadamente '+formatoCronometro(segundosFaltantes)+'.');
                }else{
                    limpiarMensajeCorteExtra();
                }
                actualizarClasificacionExtra();
                actualizarBotonConfirmarExtra();
            }

            async function ejecutarPrevisualizacionExtra(forzarAutomatico=false){
                const contadorInput=document.getElementById('extraContador');
                const raw=(contadorInput?.value||'').trim();
                if(raw===''||!Number.isFinite(Number(raw))||Number(raw)<0){
                    limpiarPrevisualizacionExtra();
                    const feedback=document.getElementById('extraContadorFeedback');
                    if(feedback){
                        feedback.className='counter-feedback';
                        feedback.innerHTML='<i class="fa-solid fa-circle-info me-1"></i>Captura un contador válido para calcular la producción de este periodo de tiempo extra.';
                    }
                    actualizarClasificacionExtra();
                    return;
                }
                if(!formCorteTiempoExtra)return;
                const secuencia=++extraPreviewSecuencia;
                extraPreviewValida=false;
                actualizarBotonConfirmarExtra();
                document.getElementById('extraResumenPreview')?.classList.add('preview-loading');
                const token=formCorteTiempoExtra.querySelector('input[name="__RequestVerificationToken"]')?.value||'';
                const tiempoExtraId=formCorteTiempoExtra.querySelector('input[name="TiempoExtraID"]')?.value||'0';
                const datos=new FormData();
                datos.append('__RequestVerificationToken',token);
                datos.append('tiempoExtraId',tiempoExtraId);
                datos.append('contadorMaquinaActual',raw);
                datos.append('cantidadScrap',String(numeroSeguro(document.getElementById('extraScrap'))));
                try{
                    const response=await fetch(urlPrevisualizarCorteTiempoExtra,{method:'POST',body:datos,headers:{'X-Requested-With':'XMLHttpRequest'}});
                    let data=null;
                    try{data=await response.json();}catch{data=null;}
                    if(secuencia!==extraPreviewSecuencia)return;
                    if(!response.ok||!data||data.ok===false){
                        extraPreviewValida=false;
                        ultimaPrevisualizacionExtra=null;
                        const mensaje=data?.mensaje||data?.Mensaje||'No fue posible calcular el corte de tiempo extra.';
                        const feedback=document.getElementById('extraContadorFeedback');
                        if(feedback){feedback.className='counter-feedback text-danger';feedback.innerHTML='<i class="fa-solid fa-triangle-exclamation me-1"></i>'+mensaje;}
                        const ids=['extraPiezasFisicas','extraOKSugerido','extraObjetivoBloque','extraCumplimiento','extraBonusInicial'];
                        ids.forEach(id=>{const el=document.getElementById(id);if(el)el.textContent='-';});
                        mostrarMensajeCorteExtra(mensaje);
                        actualizarClasificacionExtra();
                        actualizarBotonConfirmarExtra();
                        return;
                    }
                    pintarPrevisualizacionExtra(data,forzarAutomatico);
                }catch(error){
                    if(secuencia!==extraPreviewSecuencia)return;
                    extraPreviewValida=false;
                    ultimaPrevisualizacionExtra=null;
                    const mensaje=error?.message||'No fue posible consultar el cálculo del tiempo extra.';
                    const feedback=document.getElementById('extraContadorFeedback');
                    if(feedback){feedback.className='counter-feedback text-danger';feedback.innerHTML='<i class="fa-solid fa-triangle-exclamation me-1"></i>'+mensaje;}
                    mostrarMensajeCorteExtra(mensaje);
                    actualizarClasificacionExtra();
                    actualizarBotonConfirmarExtra();
                }finally{
                    if(secuencia===extraPreviewSecuencia)document.getElementById('extraResumenPreview')?.classList.remove('preview-loading');
                }
            }

            function programarPrevisualizacionExtra(forzarAutomatico=false){
                if(extraPreviewTimer)window.clearTimeout(extraPreviewTimer);
                extraPreviewTimer=window.setTimeout(function(){ejecutarPrevisualizacionExtra(forzarAutomatico);},300);
            }

            function prepararModalTiempoExtra(modo){
                if(!ejecucionEnProduccion||tieneParoAbierto){
                    return;
                }
                if(modo==='CORTE'&&segundosCorteActual<3600){
                    return;
                }
                modoRegistroTiempoExtra=modo;
                limpiarMensajeCorteExtra();
                limpiarPrevisualizacionExtra();
                const contador=document.getElementById('extraContador');
                const ok=document.getElementById('extraOK');
                const scrap=document.getElementById('extraScrap');
                const observaciones=document.getElementById('extraObservaciones');
                if(contador)contador.value='';
                if(ok)ok.value='';
                if(scrap)scrap.value='0';
                if(observaciones)observaciones.value='';
                reiniciarDefectos('extra');
                sincronizarDefectosConScrap('extra');
                const finalizar=document.getElementById('extraFinalizarTiempoExtra');
                if(finalizar)finalizar.value=modo==='FINALIZAR'?'true':'false';
                const titulo=document.getElementById('tituloModalCorteTiempoExtra');
                const subtitulo=document.getElementById('subtituloModalCorteTiempoExtra');
                const ayuda=document.getElementById('extraModoAyuda');
                const boton=document.getElementById('btnConfirmarCorteTiempoExtra');
                if(formCorteTiempoExtra)formCorteTiempoExtra.action=modo==='FINALIZAR'?urlFinalizarTiempoExtra:urlCapturarCorteTiempoExtra;
                if(modo==='FINALIZAR'){
                    if(titulo)titulo.innerHTML='<i class="fa-solid fa-flag-checkered me-2"></i>Finalizar tiempo extra';
                    if(subtitulo)subtitulo.textContent='Se guardará un último corte con el tiempo realmente transcurrido y después se cerrará la sesión.';
                    if(ayuda){
                        ayuda.className='extra-mode-help finish mb-3';
                        ayuda.innerHTML='<i class="fa-solid fa-triangle-exclamation me-1"></i>No necesitas esperar a los 60 minutos para finalizar. El ERP calculará el último bloque parcial hasta la lectura actual del contador.';
                    }
                    if(boton)boton.innerHTML='<i class="fa-solid fa-flag-checkered me-1"></i>Guardar último corte y finalizar';
                }else{
                    if(titulo)titulo.innerHTML='<i class="fa-solid fa-stopwatch me-2"></i>Capturar corte de tiempo extra';
                    if(subtitulo)subtitulo.textContent='Registra la lectura actual para cerrar este bloque y comenzar automáticamente el siguiente.';
                    if(ayuda){
                        ayuda.className='extra-mode-help mb-3';
                        ayuda.innerHTML='<i class="fa-solid fa-circle-info me-1"></i>Este corte se guarda y el siguiente bloque de tiempo extra comienza automáticamente desde la lectura que captures.';
                    }
                    if(boton)boton.innerHTML='<i class="fa-solid fa-floppy-disk me-1"></i>Guardar corte';
                }
                actualizarClasificacionExtra();
                actualizarBotonConfirmarExtra();
                modalCorteTiempoExtra?.show();
                window.setTimeout(()=>document.getElementById('extraContador')?.focus(),250);
            }

            btnCapturarCorteTiempoExtra?.addEventListener('click',function(){
                prepararModalTiempoExtra('CORTE');
            });

            btnFinalizarTiempoExtra?.addEventListener('click',function(){
                prepararModalTiempoExtra('FINALIZAR');
            });

            document.getElementById('extraContador')?.addEventListener('input',function(){
                extraPreviewValida=false;
                actualizarBotonConfirmarExtra();
                programarPrevisualizacionExtra(false);
            });

            document.getElementById('extraScrap')?.addEventListener('input',function(){
                extraPreviewValida=false;
                sincronizarDefectosConScrap('extra');
                actualizarBotonConfirmarExtra();
                actualizarClasificacionExtra();
                programarPrevisualizacionExtra(false);
            });

            formCorteTiempoExtra?.addEventListener('submit',function(e){
                limpiarMensajeCorteExtra();
                const contadorRaw=(document.getElementById('extraContador')?.value||'').trim();
                const contador=Number(contadorRaw);
                const okRaw=(document.getElementById('extraOK')?.value||'').trim();
                const ok=Number(okRaw||0);
                const scrap=numeroSeguro(document.getElementById('extraScrap'));
                const observaciones=(document.getElementById('extraObservaciones')?.value||'').trim();

                if(modoRegistroTiempoExtra==='CORTE'&&segundosCorteActual<3600){
                    e.preventDefault();
                    mostrarMensajeCorteExtra('El corte todavía no cumple 60 minutos.');
                    return;
                }

                if(contadorRaw===''||!Number.isFinite(contador)||contador<0){
                    e.preventDefault();
                    mostrarMensajeCorteExtra('Captura el contador actual de la máquina.');
                    document.getElementById('extraContador')?.focus();
                    return;
                }

                if(okRaw===''||!Number.isFinite(ok)||ok<0||scrap<0){
                    e.preventDefault();
                    mostrarMensajeCorteExtra('Revisa las cantidades. Las piezas rojas deben ser un número mayor o igual a cero y las verdes deben haber sido calculadas por el ERP.');
                    return;
                }

                const estadoDefectos=evaluarDefectos('extra');
                pintarEstadoDefectos('extra');
                if(!estadoDefectos.valido){
                    e.preventDefault();
                    mostrarMensajeCorteExtra(estadoDefectos.mensaje);
                    document.getElementById('panelDefectosExtra')?.scrollIntoView({behavior:'smooth',block:'center'});
                    return;
                }
                reindexarDefectos('extra');

                if(!extraPreviewValida||!ultimaPrevisualizacionExtra){
                    e.preventDefault();
                    mostrarMensajeCorteExtra('Espera a que el ERP termine de calcular la producción física antes de guardar.');
                    programarPrevisualizacionExtra(false);
                    return;
                }

                const fisicas=Number(ultimaPrevisualizacionExtra.piezasFisicas??ultimaPrevisualizacionExtra.PiezasFisicas??0);
                const total=ok+scrap;

                if(fisicas===0&&total===0&&!observaciones){
                    e.preventDefault();
                    mostrarMensajeCorteExtra('El contador no registró producción en este periodo. Indica en observaciones qué ocurrió.');
                    document.getElementById('extraObservaciones')?.focus();
                    return;
                }

                if(total!==fisicas){
                    e.preventDefault();
                    mostrarMensajeCorteExtra('El cálculo automático cambió. Espera a que el ERP recalcule las verdes antes de guardar.');
                    programarPrevisualizacionExtra(true);
                    return;
                }

                const boton=document.getElementById('btnConfirmarCorteTiempoExtra');
                if(boton){
                    boton.disabled=true;
                    boton.innerHTML=modoRegistroTiempoExtra==='FINALIZAR'
                        ?'<i class="fa-solid fa-spinner fa-spin me-1"></i>Finalizando...'
                        :'<i class="fa-solid fa-spinner fa-spin me-1"></i>Guardando corte...';
                }
            });

            modalCorteTiempoExtraElemento?.addEventListener('hidden.bs.modal',function(){
                if(extraPreviewTimer)window.clearTimeout(extraPreviewTimer);
                extraPreviewSecuencia++;
                limpiarMensajeCorteExtra();
                limpiarPrevisualizacionExtra();
                reiniciarDefectos('extra');
                const boton=document.getElementById('btnConfirmarCorteTiempoExtra');
                if(boton)boton.innerHTML='<i class="fa-solid fa-floppy-disk me-1"></i>Guardar corte';
            });

            if(panelTiempoExtra&&tieneTiempoExtraActivo){
                const segundosSesionBase=Number(panelTiempoExtra.dataset.segundosSesion||0);
                const segundosCorteBase=Number(panelTiempoExtra.dataset.segundosCorte||0);
                const inicioReloj=performance.now();
                const timerSesion=document.getElementById('cronometroTiempoExtra');
                const timerCorte=document.getElementById('cronometroCorteTiempoExtra');
                const estadoCorte=document.getElementById('estadoCorteTiempoExtra');

                function actualizarCronometroTiempoExtra(){
                    const transcurrido=(performance.now()-inicioReloj)/1000;
                    const segundosSesion=segundosSesionBase+transcurrido;
                    const segundosCorte=segundosCorteBase+transcurrido;
                    segundosCorteActual=segundosCorte;

                    if(timerSesion)timerSesion.textContent=formatoCronometro(segundosSesion);
                    if(timerCorte)timerCorte.textContent=formatoCronometro(segundosCorte);

                    const corteDisponible=segundosCorte>=3600;

                    if(btnCapturarCorteTiempoExtra){
                        btnCapturarCorteTiempoExtra.disabled=!corteDisponible||!ejecucionEnProduccion||tieneParoAbierto;
                        btnCapturarCorteTiempoExtra.classList.toggle('ready',corteDisponible&&ejecucionEnProduccion&&!tieneParoAbierto);
                        btnCapturarCorteTiempoExtra.title=corteDisponible
                            ?'Captura la lectura actual del contador para cerrar este bloque.'
                            :'El corte se habilita al cumplir 60 minutos desde el último corte.';
                    }

                    if(btnFinalizarTiempoExtra){
                        btnFinalizarTiempoExtra.disabled=!ejecucionEnProduccion||tieneParoAbierto;
                    }

                    if(alertaCorteTiempoExtra){
                        alertaCorteTiempoExtra.classList.toggle('d-none',!corteDisponible);
                    }

                    if(estadoCorte){
                        if(corteDisponible){
                            timerCorte?.classList.add('overdue');
                            estadoCorte.classList.add('overdue');
                            const excedente=Math.max(0,Math.floor(segundosCorte-3600));
                            estadoCorte.innerHTML='<i class="fa-solid fa-bell me-1"></i>Corte de 60 min disponible · '+formatoCronometro(excedente)+' después del corte.';
                        }else{
                            timerCorte?.classList.remove('overdue');
                            estadoCorte.classList.remove('overdue');
                            estadoCorte.innerHTML='<i class="fa-solid fa-hourglass-half me-1"></i>Próximo corte en '+formatoCronometro(3600-segundosCorte)+'.';
                        }
                    }

                    actualizarBotonConfirmarExtra();
                }

                actualizarCronometroTiempoExtra();
                window.setInterval(actualizarCronometroTiempoExtra,1000);
            }

            function mostrarMensajeTiempoExtra(mensaje){
                const box=document.getElementById('mensajeTiempoExtra');
                if(!box)return;
                box.innerHTML='<i class="fa-solid fa-triangle-exclamation me-2"></i>'+mensaje;
                box.classList.remove('d-none');
            }

            function limpiarMensajeTiempoExtra(){
                const box=document.getElementById('mensajeTiempoExtra');
                if(!box)return;
                box.classList.add('d-none');
                box.innerHTML='';
            }

            formIniciarTiempoExtra?.addEventListener('submit',function(e){
                limpiarMensajeTiempoExtra();
                const motivo=(document.getElementById('motivoTiempoExtra')?.value||'').trim();
                const observaciones=(document.getElementById('observacionesTiempoExtra')?.value||'').trim();
                const motivoOtro='@ERP.NSQuell.Models.ProduccionTiempoExtraMotivo.Otro';
                if(!motivo){
                    e.preventDefault();
                    mostrarMensajeTiempoExtra('Selecciona el motivo del tiempo extra.');
                    return;
                }
                if(motivo===motivoOtro&&!observaciones){
                    e.preventDefault();
                    mostrarMensajeTiempoExtra('Cuando seleccionas Otro debes explicar el motivo en observaciones.');
                    document.getElementById('observacionesTiempoExtra')?.focus();
                    return;
                }
                const boton=document.getElementById('btnConfirmarTiempoExtra');
                if(boton){
                    boton.disabled=true;
                    boton.innerHTML='<i class="fa-solid fa-spinner fa-spin me-1"></i>Iniciando...';
                }
            });

            function programarActualizacion(){
                window.setTimeout(function(){
                    const hayModalAbierto=document.querySelector('.modal.show');
                    const hayCampoActivo=document.activeElement&&['INPUT','TEXTAREA','SELECT'].includes(document.activeElement.tagName);
                    if(hayModalAbierto||hayCampoActivo){
                        programarActualizacion();
                        return;
                    }
                    window.location.reload();
                },60000);
            }
            programarActualizacion();
        });
    </script>
}
