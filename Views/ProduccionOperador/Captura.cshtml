                                    <div class="accordion-item">
                                        <h2 class="accordion-header" id="heading_@idTurno">
                                            <button class="accordion-button @(turno.NumeroTurno == historialTurnos.Last().NumeroTurno ? "" : "collapsed")" type="button" data-bs-toggle="collapse" data-bs-target="#@idTurno" aria-expanded="@(turno.NumeroTurno == historialTurnos.Last().NumeroTurno ? "true" : "false")" aria-controls="@idTurno">
                                                <div class="shift-head-main">
                                                    <span class="shift-name"><i class="fa-solid fa-user-clock me-1"></i>@Txt(turno.TurnoNombre)</span>
                                                    <span class="shift-operator">@Txt(turno.OperadorNombre)</span>
                                                    <span class="shift-range">@turno.FechaInicio.ToString("dd/MM/yyyy HH:mm") → @textoFinTurno</span>
                                                    <span class="shift-badges">
                                                        <span class="shift-badge ok">VERDES @Numero(turno.CantidadOK)</span>
                                                        <span class="shift-badge scrap">ROJAS @Numero(turno.CantidadScrap)</span>
                                                        <span class="shift-badge goal">@turno.PorcentajeCumplimiento.ToString("0.#")%</span>
                                                    </span>
                                                </div>
                                            </button>
                                        </h2>
                                        <div id="@idTurno" class="accordion-collapse collapse @(turno.NumeroTurno == historialTurnos.Last().NumeroTurno ? "show" : "")" aria-labelledby="heading_@idTurno" data-bs-parent="#accordionTurnosProduccion">
                                            <div class="accordion-body">
                                                <div class="shift-summary">
                                                    <div class="shift-summary-card"><div class="k">Operador</div><div class="v">@Txt(turno.OperadorNombre)</div></div>
                                                    <div class="shift-summary-card"><div class="k">Horas capturadas</div><div class="v">@horasTurno.Count</div></div>
                                                    <div class="shift-summary-card"><div class="k">Objetivo acumulado</div><div class="v">@Numero(turno.ObjetivoTotal)</div></div>
                                                    <div class="shift-summary-card"><div class="k">OK acumulado</div><div class="v text-success">@Numero(turno.CantidadOK)</div></div>
                                                    <div class="shift-summary-card"><div class="k">Cumplimiento</div><div class="v @(turno.CumplioObjetivo ? "text-success" : "text-danger")">@turno.PorcentajeCumplimiento.ToString("0.#")%</div></div>
                                                </div>
                                                <div class="table-wrap">
                                                    <table class="hour-table">
                                                        <thead>
                                                            <tr><th>Hora</th><th>Rango</th><th>Objetivo</th><th>Verdes / OK</th><th>Rojas / Scrap</th><th>Cumplimiento</th><th>Observaciones</th><th>Estado</th></tr>
                                                        </thead>
                                                        <tbody>
                                                            @for (var i = 0; i < horasTurno.Count; i++)
                                                            {
                                                                var fila = horasTurno[i];
                                                                var claseHistorial = fila.ObjetivoBloque.HasValue && fila.ObjetivoBloque.Value > 0 && !fila.CumplioObjetivo ? "row-goal-fail" : "row-complete";
                                                                <tr class="@claseHistorial">
                                                                    <td>
                                                                        <div class="hour-label">Hora @(i + 1)</div>
                                                                        <div class="small text-muted">Global #@fila.NumeroHora</div>
                                                                    </td>
                                                                    <td><div class="hour-range">@Hora(fila.HoraInicio) - @Hora(fila.HoraFin)</div><div class="small text-muted">@fila.FechaProduccion.ToString("dd/MM/yyyy")</div></td>
                                                                    <td class="objective-cell"><div class="objective-main">@((fila.ObjetivoBloque ?? fila.ObjetivoHora)?.ToString("N0") ?? "-")</div><span class="objective-sub">PZA</span></td>
                                                                    <td><span class="status-pill status-complete">@Numero(fila.CantidadOK)</span></td>
                                                                    <td><span class="status-pill status-overdue">@Numero(fila.CantidadScrap)</span></td>
                                                                    <td>
                                                                        @if (!fila.ObjetivoBloque.HasValue || fila.ObjetivoBloque.Value <= 0)
                                                                        {
                                                                            <span class="goal-result goal-neutral"><span class="history-goal-title"><i class="fa-solid fa-circle-info me-1"></i>Sin objetivo</span><span class="history-goal-detail">No se pudo evaluar esta hora</span></span>
                                                                        }
                                                                        else if (fila.CumplioObjetivo)
                                                                        {
                                                                            <span class="goal-result goal-success"><span class="history-goal-title"><i class="fa-solid fa-circle-check me-1"></i>Cumplió</span><span class="history-goal-detail">@fila.PorcentajeCumplimiento.ToString("0.#")% del objetivo</span><span class="history-goal-detail">@(fila.PiezasSobreObjetivo > 0 ? $"Superó por {fila.PiezasSobreObjetivo:N0} pieza(s)" : "Objetivo exacto")</span></span>
                                                                        }
                                                                        else
                                                                        {
                                                                            <span class="goal-result goal-danger"><span class="history-goal-title"><i class="fa-solid fa-circle-xmark me-1"></i>No cumplió</span><span class="history-goal-detail">@fila.PorcentajeCumplimiento.ToString("0.#")% del objetivo</span><span class="history-goal-detail">Faltaron @fila.PiezasFaltantes.ToString("N0") pieza(s)</span></span>
                                                                        }
                                                                    </td>
                                                                    <td>@Txt(fila.Observaciones)</td>
                                                                    <td><span class="status-pill status-complete"><i class="fa-solid fa-check"></i> Capturada</span></td>
                                                                </tr>
                                                            }
                                                        </tbody>
                                                    </table>
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                }
                            </div>
                        </div>
                    </div>
                }
                else if (horasCapturadas.Count > 0)
                {
                    <div class="alert alert-warning rounded-4 fw-bold mt-3 mb-0"><i class="fa-solid fa-triangle-exclamation me-1"></i>Existen horas capturadas, pero todavía no se pudo construir el historial por turnos. Revisa que cada hora tenga OperadorID/OperadorNombre y que Captura cargue Model.HistorialTurnos.</div>
                }

                @if (historialCambiosTurno.Count > 0)
                {
                    <div class="shift-history">
                        <button class="history-toggle" type="button" data-bs-toggle="collapse" data-bs-target="#historialCambiosTurno" aria-expanded="false" aria-controls="historialCambiosTurno">
                            <span><i class="fa-solid fa-right-left me-2"></i>Historial de cambios de turno (@historialCambiosTurno.Count)</span>
                            <i class="fa-solid fa-chevron-down"></i>
                        </button>
                        <div class="collapse history-box" id="historialCambiosTurno">
                            @foreach (var cambio in historialCambiosTurno.OrderByDescending(x => x.FechaEntrega))
                            {
                                var estadoClase = string.Equals(cambio.Estado, "RECIBIDO", StringComparison.OrdinalIgnoreCase) ? "status-complete" : string.Equals(cambio.Estado, "CANCELADO", StringComparison.OrdinalIgnoreCase) ? "status-overdue" : "status-ready";
                                <div class="turn-change-card">
                                    <div class="d-flex justify-content-between align-items-center flex-wrap gap-2 mb-2">
                                        <div class="fw-bold text-primary"><i class="fa-solid fa-arrow-right-arrow-left me-1"></i>Cambio #@cambio.CambioTurnoID</div>
                                        <div class="d-flex gap-2 flex-wrap">
                                            <span class="status-pill @estadoClase">@Txt(cambio.Estado)</span>
                                            <span class="status-pill status-future">
                                                @(string.Equals(cambio.OrigenOperadorEntrante, "TECNICO", StringComparison.OrdinalIgnoreCase)
                                                                                    ? "Técnico"
                                                                                    : string.Equals(cambio.OrigenOperadorEntrante, "ESCALA", StringComparison.OrdinalIgnoreCase)
                                                                                    ? "Escala"
                                                                                    : "Manual")
                                </span>
                            </div>
                        </div>
                        <div class="turn-change-flow">
                            <div class="turn-change-person">
                                <div class="k">Entrega</div>
                                <div class="v">@Txt(cambio.OperadorSalienteNombre)</div>
                                <div class="small text-muted">@Txt(cambio.TurnoSalienteNombre)</div>
                            </div>
                            <div class="turn-change-arrow"><i class="fa-solid fa-arrow-right"></i></div>
                            <div class="turn-change-person">
                                <div class="k">Recibe</div>
                                <div class="v">@Txt(cambio.OperadorEntranteNombre)</div>
                                <div class="small text-muted">@Txt(cambio.TurnoEntranteNombre)</div>
                            </div>
                        </div>
                        <div class="turn-change-meta">
                            <div class="turn-card"><div class="label">Fecha entrega</div><div class="value">@cambio.FechaEntrega.ToString("dd/MM/yyyy HH:mm")</div></div>
                            <div class="turn-card"><div class="label">Fecha recepción</div><div class="value">@(cambio.FechaRecepcion.HasValue? cambio.FechaRecepcion.Value.ToString("dd/MM/yyyy HH:mm") : "Pendiente")</div></div>
                            <div class="turn-card"><div class="label">Producción entregada</div><div class="value text-success">Verdes @Numero(cambio.CantidadOK)</div><div class="small text-danger">Rojas @Numero(cambio.CantidadScrap)</div></div>
                            <div class="turn-card"><div class="label">Cajas</div><div class="value">@Numero(cambio.TotalCajasEntregadas) / @Numero(cambio.TotalCajas)</div><div class="small text-muted">Pendientes @Numero(cambio.TotalCajasPendientes)</div></div>
                        </div>
                        <div class="turn-change-obs">
                            <div><div class="k">Observaciones de entrega</div><div class="v">@Txt(cambio.ObservacionesEntrega)</div></div>
                            <div><div class="k">Observaciones de recepción</div><div class="v">@Txt(cambio.ObservacionesRecepcion)</div></div>
                        </div>
                    </div>
                                        }
                        </div>
                    </div>
                }
            }
        </div>
    </section>

    }

    @if (tieneTiempoExtraActivo && tiempoExtraActivo != null)
    {
        <section class="extra-panel active" id="panelTiempoExtra" data-segundos-sesion="@Math.Floor(segundosSesionTiempoExtra)" data-segundos-corte="@Math.Floor(segundosCorteTiempoExtra)">
            <div class="extra-head">
                <div>
                    <div class="extra-title"><i class="fa-solid fa-stopwatch me-2"></i>Tiempo extra en curso</div>
                    <div class="extra-subtitle">La sesión queda guardada en el ERP. Cada corte toma como base la última lectura registrada y reinicia automáticamente el bloque siguiente.</div>
                </div>
                <span class="extra-running-badge"><span class="extra-running-dot"></span>@tiempoExtraActivo.EstadoNombre</span>
            </div>
            <div class="extra-body">
                <div class="extra-timer-wrap">
                    <div class="extra-timer-card">
                        <div class="extra-timer-label">Tiempo total de la sesión</div>
                        <div class="extra-timer-value" id="cronometroTiempoExtra">00:00:00</div>
                        <div class="extra-cut-status">Inició @tiempoExtraActivo.FechaHoraInicio.ToString("dd/MM/yyyy HH:mm")</div>
                    </div>
                    <div class="extra-timer-card cut">
                        <div class="extra-timer-label">Desde el último corte</div>
                        <div class="extra-timer-value @(corteTiempoExtraDisponible ? "overdue" : "")" id="cronometroCorteTiempoExtra">00:00:00</div>
                        <div class="extra-cut-status @(corteTiempoExtraDisponible ? "overdue" : "")" id="estadoCorteTiempoExtra">
                            @(corteTiempoExtraDisponible ? "Corte de 60 minutos disponible." : "Próximo corte al cumplir 60 minutos.")
                        </div>
                    </div>
                </div>
                <div class="extra-meta-grid">
                    <div class="extra-meta-card"><div class="k">Sesión</div><div class="v">#@tiempoExtraActivo.TiempoExtraID</div></div>
                    <div class="extra-meta-card"><div class="k">Operador</div><div class="v">@Txt(tiempoExtraActivo.OperadorInicioNombre)</div></div>
                    <div class="extra-meta-card"><div class="k">Contador base</div><div class="v">@tiempoExtraActivo.ContadorInicio.ToString("N0")</div></div>
                    <div class="extra-meta-card"><div class="k">Último contador corte</div><div class="v">@tiempoExtraActivo.ContadorUltimoCorte.ToString("N0")</div></div>
                    <div class="extra-meta-card"><div class="k">Motivo</div><div class="v">@tiempoExtraActivo.MotivoNombre</div></div>
                </div>
                <div id="alertaCorteTiempoExtra" class="extra-due-alert @(corteTiempoExtraDisponible ? "" : "d-none")">
                    <i class="fa-solid fa-bell me-2"></i>Ya se cumplieron 60 minutos desde el último corte. Captura la lectura actual del contador para cerrar este bloque.
                </div>
                @if (Model.TieneParoAbierto)
                {
                    <div class="alert alert-danger rounded-4 fw-bold mt-3 mb-0"><i class="fa-solid fa-circle-pause me-1"></i>Existe un paro abierto. Cierra el paro antes de registrar o finalizar el tiempo extra.</div>
                }
                else if (Model.EstatusID != ERP.NSQuell.Models.ProduccionEstatus.EnProduccion)
                {
                    <div class="alert alert-warning rounded-4 fw-bold mt-3 mb-0"><i class="fa-solid fa-triangle-exclamation me-1"></i>La ejecución no se encuentra en Producción. El tiempo extra queda visible, pero no puede capturarse hasta recuperar el estado operativo correspondiente.</div>
                }
                <div class="extra-actions">
                    <button type="button"
                            class="btn-extra-cut @(corteTiempoExtraDisponible && Model.EstatusID == ERP.NSQuell.Models.ProduccionEstatus.EnProduccion && !Model.TieneParoAbierto ? "ready" : "")"
                            id="btnCapturarCorteTiempoExtra"
                            @((corteTiempoExtraDisponible && Model.EstatusID == ERP.NSQuell.Models.ProduccionEstatus.EnProduccion && !Model.TieneParoAbierto) ? "" : "disabled")>
                        <i class="fa-solid fa-gauge-high"></i>
                        Capturar corte
                    </button>
                    <button type="button"
                            class="btn-extra-finish"
                            id="btnFinalizarTiempoExtra"
                            @((Model.EstatusID != ERP.NSQuell.Models.ProduccionEstatus.EnProduccion || Model.TieneParoAbierto) ? "disabled" : "")>
                        <i class="fa-solid fa-flag-checkered"></i>
                        Finalizar tiempo extra
                    </button>
                </div>
                @if (!string.IsNullOrWhiteSpace(tiempoExtraActivo.Observaciones))
                {
                    <div class="alert alert-light border rounded-4 mt-3 mb-0"><strong>Observaciones de la sesión:</strong> @tiempoExtraActivo.Observaciones</div>
                }
            </div>
        </section>
    }
    else if (puedeIniciarTiempoExtra)
    {
        <section class="extra-panel ready">
            <div class="extra-head">
                <div>
                    <div class="extra-title"><i class="fa-solid fa-forward-fast me-2"></i>¿Vas a seguir produciendo?</div>
                    <div class="extra-subtitle">El tiempo normal planeado ya quedó capturado. Si la máquina continuará trabajando, inicia una sesión de tiempo extra.</div>
                </div>
                <button type="button" class="btn-extra-start" data-bs-toggle="modal" data-bs-target="#modalIniciarTiempoExtra"><i class="fa-solid fa-play"></i>Iniciar tiempo extra</button>
            </div>
            <div class="extra-body">
                <div class="extra-start-summary mb-0">
                    <div class="extra-start-card"><div class="k">Último contador</div><div class="v">@(ultimoContador.HasValue? ultimoContador.Value.ToString("N0") : "-")</div></div>
                    <div class="extra-start-card"><div class="k">Cavidades en uso</div><div class="v">@(cavidadesEnUso.HasValue? cavidadesEnUso.Value.ToString("N0") : "-")</div></div>
                    <div class="extra-start-card"><div class="k">Ciclo vigente</div><div class="v">@(cicloEnUso.HasValue ? $"{cicloEnUso.Value:0.##} s" : "-")</div></div>
                </div>
            </div>
        </section>
    }
    else if (!esLhRh && Model.EstatusID == ERP.NSQuell.Models.ProduccionEstatus.EnProduccion)
    {
        <section class="extra-panel waiting">
            <div class="extra-body">
                <div class="extra-waiting-message"><i class="fa-solid fa-hourglass-half text-primary fa-lg"></i><span>El botón de <strong>tiempo extra</strong> se habilitará automáticamente cuando se complete la captura del tiempo normal planeado.</span></div>
            </div>
        </section>
    }

    @if (historialTiempoExtra.Count > 0)
    {
        <div class="extra-history">
            <button class="history-toggle" type="button" data-bs-toggle="collapse" data-bs-target="#historialTiempoExtra" aria-expanded="false" aria-controls="historialTiempoExtra"><span><i class="fa-solid fa-clock-rotate-left me-2"></i>Historial de tiempo extra (@historialTiempoExtra.Count)</span><i class="fa-solid fa-chevron-down"></i></button>
            <div class="collapse history-box" id="historialTiempoExtra">
                <div class="table-wrap">
                    <table class="extra-history-table">
                        <thead><tr><th>Sesión</th><th>Rango</th><th>Operador</th><th>Motivo</th><th>Contador inicial</th><th>Contador final</th><th>Cortes</th><th>Estado</th></tr></thead>
                        <tbody>
                            @foreach (var sesion in historialTiempoExtra)
                            {
                                var claseEstadoExtra = sesion.EstaFinalizado ? "status-complete" : sesion.EstaCancelado ? "status-overdue" : "status-ready";
                                <tr>
                                    <td><strong>#@sesion.TiempoExtraID</strong></td>
                                    <td>@sesion.RangoTexto</td>
                                    <td>@Txt(sesion.OperadorInicioNombre)</td>
                                    <td>@sesion.MotivoNombre</td>
                                    <td>@sesion.ContadorInicio.ToString("N0")</td>
                                    <td>@(sesion.ContadorFin.HasValue? sesion.ContadorFin.Value.ToString("N0") : "-")</td>
                                    <td>@(sesion.Cortes?.Count ?? 0)</td>
                                    <td><span class="status-pill @claseEstadoExtra">@sesion.EstadoNombre</span></td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    }
</div>

<div class="modal fade modal-extra" id="modalIniciarTiempoExtra" tabindex="-1" aria-hidden="true" data-bs-backdrop="static" data-bs-keyboard="false">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title"><i class="fa-solid fa-stopwatch me-2"></i>Iniciar tiempo extra</h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Cerrar"></button>
            </div>
            <form method="post" action="@Url.Action("IniciarTiempoExtra","ProduccionOperador")" id="formIniciarTiempoExtra">
                @Html.AntiForgeryToken()
                <input type="hidden" name="EjecucionProduccionID" value="@Model.EjecucionProduccionID" />
                <div class="modal-body p-4">
                    <div class="alert alert-primary rounded-4 fw-semibold"><i class="fa-solid fa-circle-info me-1"></i>El ERP tomará automáticamente la última lectura del contador como base. No necesitas reiniciar físicamente el contador de la máquina.</div>
                    <div class="extra-start-summary">
                        <div class="extra-start-card"><div class="k">Contador base</div><div class="v">@(ultimoContador.HasValue? ultimoContador.Value.ToString("N0") : "-")</div></div>
                        <div class="extra-start-card"><div class="k">Cavidades</div><div class="v">@(cavidadesEnUso.HasValue? cavidadesEnUso.Value.ToString("N0") : "-")</div></div>
                        <div class="extra-start-card"><div class="k">Ciclo</div><div class="v">@(cicloEnUso.HasValue ? $"{cicloEnUso.Value:0.##} s" : "-")</div></div>
                    </div>
                    <div id="mensajeTiempoExtra" class="alert alert-danger rounded-4 fw-bold d-none" role="alert"></div>
                    <div class="mb-3">
                        <label for="motivoTiempoExtra" class="form-label fw-bold">Motivo del tiempo extra</label>
                        <select class="form-select form-select-lg" name="Motivo" id="motivoTiempoExtra" required>
                            <option value="@ERP.NSQuell.Models.ProduccionTiempoExtraMotivo.CompletarOF">Completar OF</option>
                            <option value="@ERP.NSQuell.Models.ProduccionTiempoExtraMotivo.RecuperarAtraso">Recuperar atraso</option>
                            <option value="@ERP.NSQuell.Models.ProduccionTiempoExtraMotivo.ProduccionAdicionalAutorizada">Producción adicional autorizada</option>
                            <option value="@ERP.NSQuell.Models.ProduccionTiempoExtraMotivo.AjusteProceso">Ajuste de proceso</option>
                            <option value="@ERP.NSQuell.Models.ProduccionTiempoExtraMotivo.Otro">Otro</option>
                        </select>
                    </div>
                    <div class="mb-0">
                        <label for="observacionesTiempoExtra" class="form-label fw-bold">Observaciones</label>
                        <textarea class="form-control" rows="4" maxlength="500" name="Observaciones" id="observacionesTiempoExtra" placeholder="Opcional. Si eliges Otro, explica el motivo."></textarea>
                    </div>
                </div>
                <div class="modal-footer border-0 px-4 pb-4">
                    <button type="button" class="btn btn-light fw-bold" data-bs-dismiss="modal">Cancelar</button>
                    <button type="submit" class="btn btn-primary fw-bold" id="btnConfirmarTiempoExtra"><i class="fa-solid fa-play me-1"></i>Iniciar cronómetro</button>
                </div>
            </form>
        </div>
    </div>
</div>

@if (tieneTiempoExtraActivo && tiempoExtraActivo != null)
{
    <div class="modal fade modal-extra" id="modalCorteTiempoExtra" tabindex="-1" aria-hidden="true" data-bs-backdrop="static" data-bs-keyboard="false">
        <div class="modal-dialog modal-dialog-centered modal-lg">
            <div class="modal-content">
                <div class="modal-header">
                    <div>
                        <h5 class="modal-title mb-1" id="tituloModalCorteTiempoExtra"><i class="fa-solid fa-stopwatch me-2"></i>Capturar corte de tiempo extra</h5>
                        <div class="small opacity-75 fw-semibold" id="subtituloModalCorteTiempoExtra">Registra la lectura actual para cerrar el bloque.</div>
                    </div>
                    <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Cerrar"></button>
                </div>
                <form method="post" action="@Url.Action("CapturarCorteTiempoExtra","ProduccionOperador")" id="formCorteTiempoExtra">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="TiempoExtraID" value="@tiempoExtraActivo.TiempoExtraID" />
                    <input type="hidden" name="EjecucionProduccionID" value="@Model.EjecucionProduccionID" />
                    <input type="hidden" name="FinalizarTiempoExtra" id="extraFinalizarTiempoExtra" value="false" />
                    <div class="modal-body p-4">
                        <div class="extra-mode-help mb-3" id="extraModoAyuda"><i class="fa-solid fa-circle-info me-1"></i>Este corte se guarda y el siguiente bloque de tiempo extra comienza automáticamente desde la lectura que captures.</div>
                        <div id="mensajeCorteTiempoExtra" class="alert alert-danger rounded-4 fw-bold d-none mb-3" role="alert"></div>
                        <div class="counter-capture-card">
                            <div class="d-flex justify-content-between align-items-start flex-wrap gap-2 mb-3">
                                <div>
                                    <div class="fw-bold text-primary"><i class="fa-solid fa-gauge-high me-1"></i>Contador de máquina</div>
                                    <div class="small text-muted fw-semibold">Captura la lectura física actual. El servidor calculará las piezas desde el último corte.</div>
                                </div>
                                <span class="badge bg-primary">Sesión #@tiempoExtraActivo.TiempoExtraID</span>
                            </div>
                            <div class="counter-capture-grid">
                                <div>
                                    <label for="extraContador" class="form-label fw-bold">Contador actual</label>
                                    <input type="number" min="0" step="1" value="" placeholder="Ej. 12850" name="ContadorMaquinaActual" id="extraContador" class="counter-value-input empty-number" inputmode="numeric" autocomplete="off" />
                                </div>
                                <div class="counter-reference">
                                    <div class="k">Último contador del corte</div>
                                    <div class="v">@tiempoExtraActivo.ContadorUltimoCorte.ToString("N0")</div>
                                    <div class="small text-muted mt-1">Último corte: @tiempoExtraActivo.FechaHoraUltimoCorte.ToString("dd/MM/yyyy HH:mm")</div>
                                </div>
                            </div>
                            <div class="counter-feedback" id="extraContadorFeedback">Captura el contador actual y las piezas rojas. El ERP calculará automáticamente las piezas verdes / OK.</div>
                        </div>
                        <div class="extra-meta-grid mb-3" id="extraResumenPreview">
                            <div class="extra-meta-card"><div class="k">Producción física</div><div class="v" id="extraPiezasFisicas">-</div></div>
                            <div class="extra-meta-card"><div class="k">Verdes / OK</div><div class="v text-success" id="extraOKSugerido">-</div></div>
                            <div class="extra-meta-card"><div class="k">Objetivo bloque</div><div class="v" id="extraObjetivoBloque">-</div></div>
                            <div class="extra-meta-card"><div class="k">Cumplimiento</div><div class="v" id="extraCumplimiento">-</div></div>
                            <div class="extra-meta-card"><div class="k">Bonus provisional</div><div class="v text-success" id="extraBonusInicial">-</div></div>
                        </div>
                        <div class="modal-grid mb-3">
                            <div>
                                <div class="modal-label text-success">Verdes / OK</div>
                                <input type="number" min="0" value="" placeholder="Auto" name="CantidadOK" id="extraOK" class="modal-qty ok empty-number" inputmode="numeric" autocomplete="off" readonly tabindex="-1" />
                                <div class="ok-mode-row"><span class="ok-mode-badge"><i class="fa-solid fa-wand-magic-sparkles"></i>Calculado automáticamente</span></div>
                            </div>
                            <div>
                                <div class="modal-label text-danger">Rojas / Scrap</div>
                                <input type="number" min="0" value="0" placeholder="0" name="CantidadScrap" id="extraScrap" class="modal-qty scrap empty-number" inputmode="numeric" autocomplete="off" />
                            </div>
                        </div>
                        <div class="defect-panel d-none" id="panelDefectosExtra">
                            <div class="defect-head">
                                <div>
                                    <div class="defect-title"><i class="fa-solid fa-bug me-2"></i>Defecto de las piezas rojas / Scrap <span class="text-danger">*</span></div>
                                    <div class="defect-help">Si retiras piezas como scrap, indica por qué. Debes clasificar exactamente todas las piezas reportadas.</div>
                                </div>
                                <div class="defect-counter" id="contadorDefectosExtra">0 / 0 clasificadas</div>
                            </div>
                            @if (catalogoDefectos.Count == 0)
                            {
                                <div class="alert alert-danger rounded-4 fw-bold mb-0"><i class="fa-solid fa-triangle-exclamation me-1"></i>No existen defectos activos en Calidad_CatalogoDefectos. No podrás guardar scrap hasta que exista al menos un defecto activo.</div>
                            }
                            else
                            {
                                <div class="defect-list" id="listaDefectosExtra"></div>
                                <div class="defect-footer">
                                    <button type="button" class="btn-add-defect" id="btnAgregarDefectoExtra"><i class="fa-solid fa-plus me-1"></i>Agregar otro defecto</button>
                                    <div class="defect-feedback" id="resumenDefectosExtra">Selecciona el defecto de las piezas scrap.</div>
                                </div>
                            }
                        </div>
                        <div class="classification-feedback" id="extraClasificacionFeedback"><i class="fa-solid fa-circle-info me-1"></i>El ERP calcula automáticamente: <strong>verdes / OK = producción física - rojas / Scrap</strong>. Las verdes no son editables por el operador.</div>
                        <label class="form-label fw-bold mt-3" for="extraObservaciones">Observaciones</label>
                        <textarea name="Observaciones" id="extraObservaciones" class="form-control" rows="3" maxlength="500" placeholder="Opcional. Si el contador no registró producción, explica qué ocurrió."></textarea>
                    </div>
                    <div class="modal-footer border-0 px-4 pb-4">
                        <button type="button" class="btn btn-light fw-bold" data-bs-dismiss="modal">Cancelar</button>
                        <button type="submit" class="btn btn-primary fw-bold" id="btnConfirmarCorteTiempoExtra" disabled><i class="fa-solid fa-floppy-disk me-1"></i>Guardar corte</button>
                    </div>
                </form>
            </div>
        </div>
    </div>
}

<div class="modal fade modal-turn" id="modalCambioTurno" tabindex="-1" aria-hidden="true" data-bs-backdrop="static" data-bs-keyboard="false">
    <div class="modal-dialog modal-dialog-centered modal-lg">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">
                    <i class="fa-solid fa-arrow-right-arrow-left me-2"></i>Entrega de turno
                </h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Cerrar"></button>
            </div>
            <form method="post" action="@Url.Action("EntregarTurno","ProduccionOperador")" id="formCambioTurno">
                @Html.AntiForgeryToken()
                <input type="hidden" name="EjecucionProduccionID" value="@Model.EjecucionProduccionID" />
                <div class="modal-body p-4">
                    <div id="cambioTurnoLoading" class="turn-loading">
                        <i class="fa-solid fa-spinner fa-spin fa-2x mb-3"></i>
                        <div>Consultando información del turno...</div>
                    </div>
                    <div id="cambioTurnoContenido" class="d-none">
                        <div id="mensajeCambioTurno" class="turn-validation error d-none"></div>
                        <div class="turn-summary-grid">
                            <div class="turn-card">
                                <div class="label">Máquina</div>
                                <div class="value" id="turnMaquina">-</div>
                            </div>
                            <div class="turn-card">
                                <div class="label">Parte</div>
                                <div class="value" id="turnParte">-</div>
                            </div>
                            <div class="turn-card">
                                <div class="label">Última hora registrada</div>
                                <div class="value" id="turnUltimaHora">-</div>
                            </div>
                        </div>
                        <div class="turn-person">
                            <div class="turn-person-label">Operador saliente</div>
                            <div class="turn-person-name" id="turnOperadorSaliente">-</div>
                        </div>
                        <div class="row g-3 mb-3">
                            <div class="col-md-6">
                                <div class="turn-card h-100">
                                    <div class="label">Verdes / OK</div>
                                    <div class="value text-success" id="turnCantidadOK">0</div>
                                </div>
                            </div>
                            <div class="col-md-6">
                                <div class="turn-card h-100">
                                    <div class="label">Rojas / Scrap</div>
                                    <div class="value text-danger" id="turnCantidadScrap">0</div>
                                </div>
                            </div>
                        </div>
                        <div class="turn-card mb-3">
                            <div class="d-flex justify-content-between align-items-center flex-wrap gap-2 mb-2">
                                <div>
                                    <div class="label">Estado de cajas</div>
                                    <div class="value"><span id="turnTotalCajas">0</span> caja(s)</div>
                                </div>
                            </div>
                            <div class="turn-box-state mb-0">
                                <span class="ok">
                                    <i class="fa-solid fa-circle-check me-1"></i>
                                    Entregadas: <strong id="turnCajasEntregadas">0</strong>
                                </span>
                                <span class="danger" id="badgeCajasPendientes">
                                    <i class="fa-solid fa-triangle-exclamation me-1"></i>
                                    Pendientes: <strong id="turnCajasPendientes">0</strong>
                                </span>
                            </div>
                        </div>
                        <div id="turnValidacionEntrega" class="turn-validation ok">
                            <i class="fa-solid fa-circle-check me-1"></i>
                            La producción está lista para entregar el turno.
                        </div>
                        <div class="turn-person suggested d-none" id="turnSugeridoBox">
                            <div class="turn-person-label" id="turnSugeridoLabel">Operador sugerido</div>
                            <div class="turn-person-name" id="turnOperadorSugerido">-</div>
                            <div class="turn-source">
                                <i class="fa-solid fa-calendar-check" id="turnSugeridoIcono"></i>
                                <span id="turnSugeridoDetalle">Escala</span>
                            </div>
                            <div class="turn-technician-meta d-none" id="turnTecnicoMeta"></div>
                            <div class="turn-technician-observation d-none" id="turnTecnicoObservacion"></div>
                        </div>
                        <div class="mb-3">
                            <label for="operadorEntranteID" class="form-label fw-bold">
                                Operador entrante
                            </label>
                            <select class="form-select turn-select"
                                    id="operadorEntranteID"
                                    name="OperadorEntranteID"
                                    required>
                                <option value="">Selecciona operador</option>
                            </select>
                            <div class="turn-option-help" id="turnAyudaOperador">
                                Si el técnico dejó una sugerencia, aparecerá preseleccionada. Puedes cambiarla por otro operador autorizado si las condiciones del turno cambiaron.
                            </div>
                        </div>
                        <div id="turnInfoSeleccionado" class="turn-person d-none">
                            <div class="turn-person-label">Operador seleccionado</div>
                            <div class="turn-person-name" id="turnSeleccionadoNombre">-</div>
                            <div class="small text-muted fw-bold mt-1" id="turnSeleccionadoDetalle"></div>
                        </div>
                        <div class="mb-0">
                            <label for="observacionesCambioTurno" class="form-label fw-bold">Observaciones de entrega</label>
                            <textarea name="Observaciones"
                                      id="observacionesCambioTurno"
                                      rows="3"
                                      maxlength="1000"
                                      class="form-control"
                                      placeholder="Ejemplo: máquina estable, pendiente seguimiento de una incidencia, material en proceso, etc."></textarea>
                        </div>
                    </div>
                </div>
                <div class="modal-footer border-0 px-4 pb-4">
                    <button type="button" class="btn btn-light fw-bold" data-bs-dismiss="modal">
                        Cancelar
                    </button>
                    <button type="submit"
                            class="btn btn-primary fw-bold"
                            id="btnConfirmarCambioTurno"
                            disabled>
                        <i class="fa-solid fa-paper-plane me-1"></i>
                        Enviar turno para recepción
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

<div class="modal fade modal-paro" id="modalIniciarParo" tabindex="-1" aria-hidden="true" data-bs-backdrop="static" data-bs-keyboard="false">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title"><i class="fa-solid fa-triangle-exclamation me-2"></i>Reportar paro de máquina</h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Cerrar"></button>
            </div>
            <form method="post" action="@Url.Action("IniciarParo", "ProduccionOperador")" id="formIniciarParo">
                @Html.AntiForgeryToken()
                <div class="modal-body p-4">
                    <input type="hidden" name="EjecucionProduccionID" value="@Model.EjecucionProduccionID" />

                    <div class="paro-warning mb-3">
                        <i class="fa-solid fa-circle-info me-1"></i>
                        Al confirmar, la ejecución quedará pausada y se bloqueará la captura por hora hasta cerrar el paro.
                    </div>
                    <div id="mensajeParo" class="alert alert-danger rounded-4 fw-bold d-none mb-3" role="alert"></div>

                    <div class="mb-3">
                        <label class="form-label fw-bold">Motivo del paro</label>
                        <select name="MotivoParoID" id="motivoParoId" class="form-select form-select-lg">
                            @foreach (var motivo in Model.MotivosParo ?? new List<Microsoft.AspNetCore.Mvc.Rendering.SelectListItem>())
                            {
                                <option value="@motivo.Value">@motivo.Text</option>
                            }
                        </select>
                    </div>

                    <div class="mb-3">
                        <label class="form-label fw-bold">Otro motivo</label>
                        <input type="text"
                               name="MotivoParoTexto"
                               id="motivoParoTexto"
                               maxlength="200"
                               class="form-control"
                               placeholder="Úsalo cuando el motivo no esté en el catálogo" />
                    </div>

                    <div>
                        <label class="form-label fw-bold">Descripción</label>
                        <textarea name="Descripcion"
                                  id="descripcionParo"
                                  rows="4"
                                  maxlength="500"
                                  class="form-control"
                                  placeholder="Describe brevemente qué ocurrió"></textarea>
                    </div>
                </div>
                <div class="modal-footer border-0 px-4 pb-4">
                    <button type="button" class="btn btn-light fw-bold" data-bs-dismiss="modal">Cancelar</button>
                    <button type="submit" class="btn btn-danger fw-bold" id="btnConfirmarParo">
                        <i class="fa-solid fa-stop me-1"></i>Iniciar paro
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

<div class="modal fade modal-reanudar" id="modalCerrarParo" tabindex="-1" aria-hidden="true" data-bs-backdrop="static" data-bs-keyboard="false">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title"><i class="fa-solid fa-play me-2"></i>Finalizar paro de máquina</h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Cerrar"></button>
            </div>
            <form method="post" action="@Url.Action("CerrarParo", "ProduccionOperador")" id="formCerrarParo">
                @Html.AntiForgeryToken()
                <div class="modal-body p-4">
                    <input type="hidden" name="ParoID" value="@Model.ParoAbiertoID" />

                    <div class="alert alert-success fw-bold rounded-4">
                        <i class="fa-solid fa-circle-check me-1"></i>
                        Confirma que la máquina está lista para continuar.
                    </div>

                    <div class="paro-warning mb-3">
                        <i class="fa-solid fa-clock me-1"></i>
                        Si el paro duró más de 15 minutos, el sistema regresará la producción a preparación y solicitará reliberación de Calidad.
                    </div>

                    <div>
                        <label class="form-label fw-bold">Observaciones de cierre</label>
                        <textarea name="ObservacionesCierre"
                                  rows="4"
                                  maxlength="500"
                                  class="form-control"
                                  placeholder="Describe la corrección o condición para reanudar"></textarea>
                    </div>
                </div>
                <div class="modal-footer border-0 px-4 pb-4">
                    <button type="button" class="btn btn-light fw-bold" data-bs-dismiss="modal">Cancelar</button>
                    <button type="submit" class="btn btn-success fw-bold" id="btnConfirmarCierreParo">
                        <i class="fa-solid fa-play me-1"></i>Finalizar y continuar
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

@if (esLhRh)
{
    <div class="modal fade" id="modalCapturaHora" tabindex="-1" aria-hidden="true" data-bs-backdrop="static" data-bs-keyboard="false">
        <div class="modal-dialog modal-dialog-centered pair-modal-dialog modal-xl">
            <div class="modal-content">
                <div class="modal-header">
                    <div><h5 class="modal-title"><i class="fa-solid fa-link me-2"></i>Captura horaria conjunta LH/RH</h5><div class="small opacity-75 fw-semibold">Un contador físico · dos cálculos por cavidades · dos clasificaciones independientes</div></div>
                    <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Cerrar"></button>
                </div>
                <form method="post" action="@Url.Action("RegistrarHora","ProduccionOperador")" id="formModalHora">
                    @Html.AntiForgeryToken()
