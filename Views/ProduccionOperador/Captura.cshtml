        .turn-summary-grid {
            display: grid;
            grid-template-columns: repeat(3,minmax(0,1fr));
            gap: 10px;
            margin-bottom: 15px;
        }

        .turn-card {
            border: 1px solid var(--border);
            border-radius: 14px;
            padding: 11px 12px;
            background: #f8fafc;
        }

            .turn-card .label {
                font-size: .68rem;
                font-weight: 900;
                text-transform: uppercase;
                color: var(--muted);
            }

            .turn-card .value {
                margin-top: 3px;
                font-size: 1.1rem;
                font-weight: 950;
                color: var(--blue-dark);
            }

        .turn-person {
            border: 1px solid var(--border);
            border-radius: 16px;
            padding: 14px;
            background: #fff;
            margin-bottom: 12px;
        }

            .turn-person.suggested {
                border-color: #93c5fd;
                background: #eff6ff;
            }

        .turn-person-label {
            color: var(--muted);
            font-size: .7rem;
            font-weight: 900;
            text-transform: uppercase;
        }

        .turn-person-name {
            color: var(--blue-dark);
            font-size: 1.15rem;
            font-weight: 950;
            margin-top: 2px;
        }

        .turn-source {
            display: inline-flex;
            align-items: center;
            gap: 5px;
            padding: 5px 8px;
            border-radius: 999px;
            font-size: .7rem;
            font-weight: 900;
            margin-top: 7px;
            background: #dbeafe;
            color: #1d4ed8;
        }

        .turn-person.suggested.technician {
            border-color: #c4b5fd;
            background: #f5f3ff;
        }

            .turn-person.suggested.technician .turn-person-label,
            .turn-person.suggested.technician .turn-person-name {
                color: #5b21b6;
            }

            .turn-person.suggested.technician .turn-source {
                background: #ede9fe;
                color: #6d28d9;
            }

        .turn-technician-meta {
            margin-top: 9px;
            padding-top: 9px;
            border-top: 1px dashed #c4b5fd;
            color: #5b21b6;
            font-size: .78rem;
            font-weight: 750;
        }

        .turn-technician-observation {
            margin-top: 8px;
            padding: 9px 10px;
            border-radius: 10px;
            background: rgba(109,40,217,.06);
            color: #4c1d95;
            font-size: .8rem;
            font-weight: 700;
            white-space: pre-wrap;
        }

        .turn-box-state {
            display: flex;
            gap: 8px;
            flex-wrap: wrap;
            margin-bottom: 14px;
        }

            .turn-box-state span {
                border-radius: 999px;
                padding: 6px 10px;
                font-size: .76rem;
                font-weight: 900;
            }

            .turn-box-state .ok {
                background: #ecfdf3;
                color: #067647;
            }

            .turn-box-state .danger {
                background: #fef3f2;
                color: #b42318;
            }

        .turn-validation {
            border-radius: 14px;
            padding: 12px 14px;
            font-weight: 850;
            margin-bottom: 14px;
        }

            .turn-validation.ok {
                border: 1px solid #abefc6;
                background: #ecfdf3;
                color: #067647;
            }

            .turn-validation.error {
                border: 1px solid #fda29b;
                background: #fef3f2;
                color: #b42318;
            }

        .turn-select {
            min-height: 52px;
            font-weight: 750;
        }

        .turn-option-help {
            font-size: .78rem;
            color: var(--muted);
            font-weight: 650;
            margin-top: 5px;
        }

        .shift-history {
            margin-top: 14px;
        }

        .shift-accordion .accordion-item {
            border: 1px solid var(--border);
            border-radius: 16px !important;
            overflow: hidden;
            margin-bottom: 10px;
            background: #fff;
        }

        .shift-accordion .accordion-button {
            background: #f8fbff;
            color: var(--blue-dark);
            font-weight: 950;
            box-shadow: none;
            padding: 14px 16px;
        }

            .shift-accordion .accordion-button:not(.collapsed) {
                background: #eef4ff;
                color: var(--blue-dark);
                box-shadow: inset 0 -1px 0 var(--border);
            }

            .shift-accordion .accordion-button:focus {
                box-shadow: none;
            }

        .shift-head-main {
            display: flex;
            flex-wrap: wrap;
            align-items: center;
            gap: 8px 12px;
            width: 100%;
            padding-right: 12px;
        }

        .shift-name {
            font-weight: 950;
        }

        .shift-operator {
            color: #475467;
            font-size: .82rem;
            font-weight: 800;
        }

        .shift-range {
            color: var(--muted);
            font-size: .78rem;
            font-weight: 750;
        }

        .shift-badges {
            display: flex;
            flex-wrap: wrap;
            gap: 6px;
            margin-left: auto;
        }

        .shift-badge {
            display: inline-flex;
            align-items: center;
            gap: 4px;
            border-radius: 999px;
            padding: 5px 8px;
            font-size: .69rem;
            font-weight: 900;
            white-space: nowrap;
        }

            .shift-badge.ok {
                background: #ecfdf3;
                color: #067647;
            }

            .shift-badge.sos {
                background: #fff7ed;
                color: #b54708;
            }

            .shift-badge.scrap {
                background: #fef3f2;
                color: #b42318;
            }

            .shift-badge.goal {
                background: #eef4ff;
                color: #1d4ed8;
            }

        .shift-summary {
            display: grid;
            grid-template-columns: repeat(5,minmax(0,1fr));
            gap: 8px;
            margin-bottom: 12px;
        }

        .shift-summary-card {
            border: 1px solid var(--border);
            border-radius: 13px;
            padding: 10px 11px;
            background: #f8fafc;
        }

            .shift-summary-card .k {
                color: var(--muted);
                font-size: .66rem;
                font-weight: 900;
                text-transform: uppercase;
            }

            .shift-summary-card .v {
                color: var(--blue-dark);
                margin-top: 2px;
                font-weight: 950;
                font-size: 1rem;
            }

        .turn-change-card {
            border: 1px solid var(--border);
            border-radius: 14px;
            padding: 13px;
            background: #fff;
            margin-bottom: 10px;
        }

        .turn-change-flow {
            display: grid;
            grid-template-columns: 1fr auto 1fr;
            align-items: center;
            gap: 10px;
            margin-bottom: 10px;
        }

        .turn-change-person {
            border: 1px solid var(--border);
            border-radius: 12px;
            padding: 10px;
            background: #f8fafc;
        }

            .turn-change-person .k {
                color: var(--muted);
                font-size: .66rem;
                font-weight: 900;
                text-transform: uppercase;
            }

            .turn-change-person .v {
                color: var(--blue-dark);
                font-weight: 950;
                margin-top: 2px;
            }

        .turn-change-arrow {
            color: var(--blue);
            font-size: 1.25rem;
        }

        .turn-change-meta {
            display: grid;
            grid-template-columns: repeat(4,minmax(0,1fr));
            gap: 8px;
            margin-bottom: 10px;
        }

        .turn-change-obs {
            display: grid;
            grid-template-columns: 1fr 1fr;
            gap: 8px;
        }

            .turn-change-obs > div {
                border: 1px dashed var(--border);
                border-radius: 12px;
                padding: 10px;
                background: #fbfcfe;
            }

            .turn-change-obs .k {
                color: var(--muted);
                font-size: .66rem;
                font-weight: 900;
                text-transform: uppercase;
                margin-bottom: 3px;
            }

            .turn-change-obs .v {
                color: #344054;
                font-size: .82rem;
                font-weight: 700;
                white-space: pre-wrap;
            }

        .extra-panel {
            margin-top: 16px;
            border: 1px solid #b9ccff;
            border-radius: 20px;
            overflow: hidden;
            background: #fff;
            box-shadow: 0 12px 30px rgba(15,23,42,.07);
        }

        .extra-panel.ready {
            border-color: #93c5fd;
            background: linear-gradient(180deg,#f8fbff,#eef6ff);
        }

        .extra-panel.active {
            border-color: #a7f3d0;
            background: linear-gradient(180deg,#f7fef9,#ecfdf3);
        }

        .extra-panel.waiting {
            border-color: #e4e7ec;
            background: #f8fafc;
        }

        .extra-head {
            padding: 17px 18px;
            display: flex;
            justify-content: space-between;
            align-items: center;
            gap: 14px;
            flex-wrap: wrap;
            border-bottom: 1px solid rgba(148,163,184,.25);
        }

        .extra-title {
            color: var(--blue-dark);
            font-size: 1.08rem;
            font-weight: 950;
        }

        .extra-subtitle {
            color: var(--muted);
            font-size: .84rem;
            font-weight: 700;
            margin-top: 3px;
        }

        .btn-extra-start {
            border: 0;
            border-radius: 14px;
            padding: 12px 17px;
            background: linear-gradient(135deg,#00347a,#004aad);
            color: #fff;
            font-weight: 950;
            display: inline-flex;
            align-items: center;
            justify-content: center;
            gap: 8px;
            white-space: nowrap;
            box-shadow: 0 8px 18px rgba(0,74,173,.18);
        }

        .btn-extra-start:hover {
            background: #00347a;
            color: #fff;
        }

        .extra-body {
            padding: 17px 18px;
        }

        .extra-timer-wrap {
            display: grid;
            grid-template-columns: minmax(0,1.5fr) minmax(0,1fr);
            gap: 12px;
            margin-bottom: 14px;
        }

        .extra-timer-card {
            border: 1px solid #abefc6;
            border-radius: 18px;
            background: #fff;
            padding: 18px;
            text-align: center;
        }

        .extra-timer-card.cut {
            border-color: #bfdbfe;
        }

        .extra-timer-label {
            color: var(--muted);
            font-size: .7rem;
            font-weight: 900;
            text-transform: uppercase;
            letter-spacing: .04em;
        }

        .extra-timer-value {
            margin-top: 3px;
            font-size: 2.65rem;
            line-height: 1;
            font-weight: 950;
            color: #067647;
            font-variant-numeric: tabular-nums;
        }

        .extra-timer-card.cut .extra-timer-value {
            color: var(--blue-dark);
        }

        .extra-timer-value.overdue {
            color: #b42318 !important;
        }

        .extra-cut-status {
            margin-top: 8px;
            font-size: .8rem;
            font-weight: 850;
            color: #475467;
        }

        .extra-cut-status.overdue {
            color: #b42318;
        }

        .extra-meta-grid {
            display: grid;
            grid-template-columns: repeat(5,minmax(0,1fr));
            gap: 9px;
        }

        .extra-meta-card {
            border: 1px solid var(--border);
            border-radius: 13px;
            background: #fff;
            padding: 10px 11px;
        }

        .extra-meta-card .k {
            color: var(--muted);
            font-size: .66rem;
            text-transform: uppercase;
            font-weight: 900;
        }

        .extra-meta-card .v {
            color: var(--blue-dark);
            margin-top: 3px;
            font-size: .96rem;
            font-weight: 950;
        }

        .extra-running-badge {
            display: inline-flex;
            align-items: center;
            gap: 6px;
            border-radius: 999px;
            padding: 7px 10px;
            background: #ecfdf3;
            color: #067647;
            font-size: .76rem;
            font-weight: 950;
        }

        .extra-running-dot {
            width: 8px;
            height: 8px;
            border-radius: 50%;
            background: currentColor;
            animation: extraPulse 1.2s infinite;
        }

        .extra-actions {
            display: flex;
            align-items: center;
            justify-content: flex-end;
            gap: 10px;
            flex-wrap: wrap;
            margin-top: 14px;
        }

        .btn-extra-cut,
        .btn-extra-finish {
            border: 0;
            border-radius: 14px;
            padding: 12px 16px;
            font-weight: 950;
            display: inline-flex;
            align-items: center;
            justify-content: center;
            gap: 8px;
            min-height: 46px;
            transition: transform .15s ease,box-shadow .15s ease,opacity .15s ease;
        }

        .btn-extra-cut {
            background: linear-gradient(135deg,#00347a,#004aad);
            color: #fff;
            box-shadow: 0 8px 18px rgba(0,74,173,.18);
        }

        .btn-extra-cut.ready {
            animation: extraCutPulse 1.4s infinite;
        }

        .btn-extra-cut:hover:not(:disabled) {
            color: #fff;
            transform: translateY(-1px);
            box-shadow: 0 10px 22px rgba(0,74,173,.24);
        }

        .btn-extra-finish {
            background: #fff;
            color: #b42318;
            border: 1px solid #fda29b;
        }

        .btn-extra-finish:hover:not(:disabled) {
            background: #fef3f2;
            color: #912018;
            transform: translateY(-1px);
        }

        .btn-extra-cut:disabled,
        .btn-extra-finish:disabled {
            opacity: .5;
            cursor: not-allowed;
            box-shadow: none;
        }

        .extra-due-alert {
            margin-top: 14px;
            border: 1px solid #fda29b;
            background: #fef3f2;
            color: #b42318;
            border-radius: 14px;
            padding: 11px 13px;
            font-weight: 900;
        }

        .extra-mode-help {
            border-radius: 14px;
            padding: 11px 13px;
            font-weight: 750;
            border: 1px solid #bfdbfe;
            background: #eff6ff;
            color: #1d4ed8;
        }

        .extra-mode-help.finish {
            border-color: #fedf89;
            background: #fffcf5;
            color: #93370d;
        }

        @@keyframes extraCutPulse {
            0%,100% { box-shadow: 0 8px 18px rgba(0,74,173,.18); }
            50% { box-shadow: 0 0 0 6px rgba(0,74,173,.10),0 10px 24px rgba(0,74,173,.25); }
        }

        @@keyframes extraPulse {
            0%,100% { opacity: .35; transform: scale(.85); }
            50% { opacity: 1; transform: scale(1.15); }
        }

        .extra-waiting-message {
            display: flex;
            align-items: center;
            gap: 10px;
            color: #475467;
            font-weight: 800;
        }

        .extra-history {
            margin-top: 12px;
        }

        .extra-history-table {
            width: 100%;
            border-collapse: collapse;
        }

        .extra-history-table th,
        .extra-history-table td {
            padding: 10px;
            border-bottom: 1px solid var(--border);
            vertical-align: middle;
            font-size: .82rem;
        }

        .extra-history-table th {
            color: var(--muted);
            text-transform: uppercase;
            font-size: .68rem;
            font-weight: 900;
            white-space: nowrap;
        }

        .extra-history-table td {
            font-weight: 700;
            color: #344054;
        }

        .modal-extra .modal-header {
            background: linear-gradient(135deg,#00347a,#004aad);
        }

        .extra-start-summary {
            display: grid;
            grid-template-columns: repeat(3,minmax(0,1fr));
            gap: 9px;
            margin-bottom: 14px;
        }

        .extra-start-card {
            border: 1px solid var(--border);
            border-radius: 13px;
            padding: 11px;
            background: #f8fbff;
        }

        .extra-start-card .k {
            color: var(--muted);
            font-size: .68rem;
            text-transform: uppercase;
            font-weight: 900;
        }

        .extra-start-card .v {
            margin-top: 3px;
            color: var(--blue-dark);
            font-weight: 950;
            font-size: 1rem;
        }

        @@media(max-width:1100px) {
            .extra-meta-grid {
                grid-template-columns: repeat(3,1fr);
            }
        }

        @@media(max-width:800px) {
            .extra-timer-wrap {
                grid-template-columns: 1fr;
            }

            .extra-meta-grid,
            .extra-start-summary {
                grid-template-columns: 1fr 1fr;
            }
        }

        @@media(max-width:520px) {
            .extra-head {
                align-items: stretch;
            }

            .btn-extra-start {
                width: 100%;
            }

            .extra-actions {
                align-items: stretch;
                flex-direction: column;
            }

            .btn-extra-cut,
            .btn-extra-finish {
                width: 100%;
            }

            .extra-timer-value {
                font-size: 2.1rem;
            }

            .extra-meta-grid,
            .extra-start-summary {
                grid-template-columns: 1fr;
            }
        }

        @@media(max-width:900px) {
            .shift-summary {
                grid-template-columns: repeat(2,1fr);
            }

            .turn-change-meta {
                grid-template-columns: repeat(2,1fr);
            }

            .turn-change-obs {
                grid-template-columns: 1fr;
            }
        }

        @@media(max-width:700px) {
            .turn-toolbar {
                align-items: stretch;
                flex-direction: column;
            }

            .btn-turn {
                width: 100%;
                justify-content: center;
            }

            .turn-summary-grid {
                grid-template-columns: 1fr 1fr;
            }
        }

        @@media(max-width:1000px) {
            .summary-grid {
                grid-template-columns: repeat(2,1fr)
            }

            .hour-table {
                min-width: 1120px
            }

            .table-wrap {
                overflow-x: auto
            }
        }

        @@media(max-width:650px) {
            .page {
                padding: 10px
            }

            .hero {
                border-radius: 18px
            }

            .modal-grid {
                grid-template-columns: 1fr
            }

            .physical-summary {
                grid-template-columns: 1fr 1fr
            }

            .counter-capture-grid {
                grid-template-columns: 1fr
            }

            .modal-qty {
                height: 62px
            }

            .summary-grid {
                grid-template-columns: 1fr 1fr
            }
        }
    </style>
}

<div class="page">
    <section class="hero">
        <div class="d-flex justify-content-between align-items-start flex-wrap gap-3">
            <div><h1><i class="fa-solid fa-table-list me-2"></i>Captura de producción por hora</h1><p>Captura cada fila como en AppSheet. La Hora 1 comienza cuando inicia producción en serie.</p></div>
            <div class="d-flex gap-2 flex-wrap"><a href="@Url.Action("Index", "ProduccionOperador")" class="btn-hero"><i class="fa-solid fa-arrow-left"></i>Kiosco</a><a href="@Url.Action("Captura", "ProduccionOperador", new { id = Model.EjecucionProduccionID })" class="btn-hero"><i class="fa-solid fa-rotate-right"></i>Actualizar</a></div>
        </div>
    </section>

    @if (!string.IsNullOrWhiteSpace(mensajeSuccess))
    {
        var claseResultadoGuardado = mensajeObjetivoNoCumplido ? "danger" : mensajeSinObjetivo ? "neutral" : "success";
        var iconoResultadoGuardado = mensajeObjetivoNoCumplido ? "fa-arrow-trend-down" : mensajeSinObjetivo ? "fa-circle-info" : "fa-circle-check";
        <div class="saved-goal-result @claseResultadoGuardado">
            <i class="fa-solid @iconoResultadoGuardado me-2"></i>@mensajeSuccess
        </div>
    }
    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger rounded-4 fw-bold"><i class="fa-solid fa-triangle-exclamation me-1"></i>@TempData["Error"]</div>
    }
    @if (TempData["Info"] != null)
    {
        <div class="alert alert-info rounded-4 fw-bold"><i class="fa-solid fa-circle-info me-1"></i>@TempData["Info"]</div>
    }

    <section class="summary-grid">

        <div class="summary">
            <div class="k">Máquina</div>
            <div class="v">
                @Txt(Model.MaquinaCodigo)
            </div>
            <div class="text-muted small">
                @Txt(Model.MaquinaNombre)
            </div>
        </div>

        <div class="summary">
            <div class="k">Parte</div>
            <div class="v">
                @Txt(
                Model.ReferenciaSAP
                ?? Model.NumeroParte)
            </div>
            <div class="text-muted small">
                @Txt(Model.DescripcionParte)
            </div>
        </div>

        <div class="summary objective-summary">
            <div class="k">
                Meta de la OF
            </div>

            <div class="v">
                @(planeada > 0
                                ? Numero(planeada)
                                : "-")
            </div>

            <div class="text-muted small">
                @(planeada > 0
                                ? "Piezas requeridas"
                                : "Sin cantidad planeada")
            </div>
        </div>

        <div class="summary">
            <div class="k">
                OK acumulado
            </div>

            <div class="v text-success">
                @Numero(Model.CantidadOKTotal)
            </div>

            <div class="text-muted small">
                @avance.ToString("0.##")% de la OF
            </div>
        </div>

        <div class="summary">
            <div class="k">
                Pendiente OF
            </div>

            <div class="v @(pendiente > 0
                                                                       ? "text-primary"
                                                                       : "text-success")">
                @Numero(pendiente)
            </div>

            <div class="text-muted small">
                @(pendiente > 0
                                ? "Piezas OK por producir"
                                : "Meta alcanzada")
            </div>
        </div>

        <div class="summary">
            <div class="k">
                Sospechosos
            </div>

            <div class="v text-warning">
                @Numero(
                                Model.CantidadSospechosaTotal)
            </div>
        </div>

        <div class="summary">
            <div class="k">
                Scrap
            </div>

            <div class="v text-danger">
                @Numero(
                                Model.CantidadScrapTotal)
            </div>
        </div>

        <div class="summary objective-summary">
            <div class="k">
                Objetivo por hora
            </div>

            <div class="v">
                @(objetivoHora.HasValue &&
                                objetivoHora.Value > 0
                                ? Numero(objetivoHora.Value)
                                : "-")
            </div>

            <div class="text-muted small">
                @(objetivoHora.HasValue &&
                                objetivoHora.Value > 0
                                ? "PZA / H"
                                : "Sin objetivo configurado")

                @if (cicloEnUso.HasValue)
                {
                    <span>
                        · Ciclo
                        @cicloEnUso.Value.ToString("0.##") s
                    </span>
                }

                @if (cavidadesEnUso.HasValue)
                {
                    <span>
                        · @cavidadesEnUso.Value cav.
                    </span>
                }
            </div>
        </div>

        <div class="summary objective-summary">
            <div class="k">Configuración en uso</div>
            <div class="v">
                @(cavidadesEnUso.HasValue ? $"{cavidadesEnUso.Value:N0} cav." : "-")
            </div>
            <div class="text-muted small">
                @(cicloEnUso.HasValue ? $"Ciclo {cicloEnUso.Value:0.##} s" : "Sin ciclo confirmado")
                @(Model.TieneConfiguracionReal ? " · Técnico" : " · Valor de referencia")
            </div>
        </div>

        <div class="summary objective-summary">
            <div class="k">Último contador</div>
            <div class="v">
                @(ultimoContador.HasValue? ultimoContador.Value.ToString("N0") : "-")
            </div>
            <div class="text-muted small">
                @(ultimoContador.HasValue ? "Última lectura registrada" : "Pendiente de lectura base")
            </div>
        </div>

        <div class="summary objective-summary">
            <div class="k">Bonus provisional</div>
            <div class="v text-success">@bonusActual.ToString("N0")</div>
            <div class="text-muted small">Piezas OK abonadas, sujetas a ajustes de Calidad</div>
        </div>

    </section>

    <section class="turn-toolbar">
        <div>
            <div class="turn-title">
                <i class="fa-solid fa-arrow-right-arrow-left me-2"></i>Entrega de turno
            </div>
            <div class="turn-subtitle">
                Entrega la producción al siguiente operador. El cambio será efectivo únicamente cuando el operador entrante confirme la recepción.
            </div>
        </div>
        @if (Model.EstatusID == ERP.NSQuell.Models.ProduccionEstatus.EnProduccion)
        {
            <button type="button"
                    class="btn-turn"
                    id="btnAbrirCambioTurno"
                    @(Model.TieneParoAbierto ? "disabled" : "")>
                <i class="fa-solid fa-right-from-bracket"></i>
                Entregar turno
            </button>
        }
        else
        {
            <button type="button" class="btn-turn" disabled>
                <i class="fa-solid fa-right-from-bracket"></i>
                Entregar turno
            </button>
        }
    </section>

    <section class="paro-toolbar @(Model.TieneParoAbierto ? "open" : "")">
        <div>
            <div class="paro-title">
                <i class="fa-solid @(Model.TieneParoAbierto ? "fa-circle-pause text-danger" : "fa-triangle-exclamation text-warning") me-2"></i>
                @(Model.TieneParoAbierto ? "Paro de máquina activo" : "Control de paro de máquina")
            </div>
            <div class="paro-subtitle">
                @(Model.TieneParoAbierto
                                ? "La producción está pausada. Finaliza el paro cuando la máquina esté lista para continuar."
                                : "El operador puede reportar un paro cuando la máquina o el proceso deban detenerse.")
            </div>
        </div>

        @if (Model.TieneParoAbierto && Model.ParoAbiertoID.HasValue)
        {
            <button type="button"
                    class="btn-paro-close"
                    data-bs-toggle="modal"
                    data-bs-target="#modalCerrarParo">
                <i class="fa-solid fa-play"></i>
                Finalizar paro
            </button>
        }
        else if (Model.EstatusID == ERP.NSQuell.Models.ProduccionEstatus.EnProduccion)
        {
            <button type="button"
                    class="btn-paro-start"
                    data-bs-toggle="modal"
                    data-bs-target="#modalIniciarParo">
                <i class="fa-solid fa-stop"></i>
                Reportar paro
            </button>
        }
    </section>

    <section class="panel">
        <div class="panel-head d-flex justify-content-between align-items-center flex-wrap gap-2">
            <span><i class="fa-solid fa-clock me-2"></i>Registro por horas</span><span class="badge bg-primary">
                OF @Numero(Model.CantidadOKTotal)
                / @Numero(planeada)
                · @avance.ToString("0.##")%
                · Faltan @Numero(pendiente)
            </span>
        </div>
        <div class="panel-body">
            @if (Model.TieneParoAbierto)
            {
                <div class="alert alert-danger fw-bold"><i class="fa-solid fa-circle-pause me-1"></i>Existe un paro abierto. Cierra el paro antes de capturar horas.</div>
            }
            else if (Model.EstatusID != ERP.NSQuell.Models.ProduccionEstatus.EnProduccion)
            {

                <div class="alert alert-warning fw-bold"><i class="fa-solid fa-triangle-exclamation me-1"></i>La captura se habilita cuando inicia producción en serie.</div>
            }
            else
            {

                <div class="notice"><i class="fa-solid fa-circle-info me-1"></i>Captura el <strong>contador actual</strong>, <strong>Sospechosos</strong> y <strong>Scrap</strong>. El ERP calculará y propondrá automáticamente las piezas <strong>OK</strong>. El operador puede corregir el OK manualmente cuando sea necesario; la diferencia contra la producción física quedará visible antes de guardar.</div>
            }

            @if (horas.Count == 0)
            {
                <div class="alert alert-secondary mb-0">No se generaron las filas horarias. El controlador debe cargar <strong>Model.HorasCaptura</strong> desde la hora real de inicio de producción.</div>
            }
            else
            {
                <div class="table-wrap @(capturaHabilitada ? "" : "blocked")">
                    <table class="hour-table">
                        <thead><tr><th>Hora</th><th>Rango</th><th>Objetivo</th><th>Contador</th><th>OK</th><th>Sospechosos</th><th>Scrap</th><th>Observaciones</th><th>Estado</th><th>Acción</th></tr></thead>
                        <tbody>
                            @foreach (var fila in horasPendientesVisibles)
                            {
                                var editable = capturaHabilitada && !fila.Capturada && fila.Disponible;
                                var claseFila = fila.Vencida ? "row-overdue" : fila.Disponible ? "row-ready" : "";
                                var esObligatoria = horaObligatoria != null && horaObligatoria.NumeroHora == fila.NumeroHora;
                                <tr class="@claseFila" data-hour-row data-numero="@fila.NumeroHora" data-fecha="@fila.FechaProduccion.ToString("yyyy-MM-dd")" data-inicio="@Hora(fila.HoraInicio)" data-fin="@Hora(fila.HoraFin)" data-objetivo="@(fila.ObjetivoBloque ?? fila.ObjetivoHora ?? objetivoHora ?? 0)" data-obligatoria="@(esObligatoria ? "true" : "false")">
                                    <td><div class="hour-label">Hora @fila.NumeroHora</div></td>
                                    <td><div class="hour-range">@Hora(fila.HoraInicio) - @Hora(fila.HoraFin)</div><div class="small text-muted">@fila.FechaProduccion.ToString("dd/MM/yyyy")</div></td>
                                    <td class="objective-cell"><div class="objective-main">@((fila.ObjetivoBloque ?? fila.ObjetivoHora ?? objetivoHora)?.ToString("N0") ?? "-")</div><span class="objective-sub">@(fila.ObjetivoBloque.HasValue && fila.ObjetivoHora.HasValue && fila.ObjetivoBloque.Value != fila.ObjetivoHora.Value ? "Ajustado al bloque" : "PZA objetivo")</span></td>
                                    <td><input class="hour-input counter empty-number" type="number" min="0" value="" placeholder="Actual" inputmode="numeric" data-field="counter" @(editable ? "" : "disabled") /></td>
                                    <td><input class="hour-input ok empty-number" type="number" min="0" value="" placeholder="Auto" inputmode="numeric" data-field="ok" @(editable ? "" : "disabled") /></td>
                                    <td><input class="hour-input yellow empty-number" type="number" min="0" value="" placeholder="0" inputmode="numeric" data-field="yellow" @(editable ? "" : "disabled") /></td>
                                    <td><input class="hour-input scrap empty-number" type="number" min="0" value="" placeholder="0" inputmode="numeric" data-field="scrap" @(editable ? "" : "disabled") /></td>
                                    <td><input class="obs-input form-control" maxlength="500" placeholder="Opcional" data-field="obs" @(editable ? "" : "disabled") /></td>
                                    <td><span class="status-pill @EstadoClase(fila)">@EstadoTexto(fila)</span></td>
                                    <td><button type="button" class="btn-save-row btn-open-hour" @(editable ? "" : "disabled")><i class="fa-solid fa-floppy-disk me-1"></i>Guardar</button></td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
                @if (horasPendientesAdicionales.Count > 0)
                {
                    <button class="history-toggle" type="button" data-bs-toggle="collapse" data-bs-target="#pendientesAdicionales" aria-expanded="false" aria-controls="pendientesAdicionales"><span><i class="fa-solid fa-list me-2"></i>Ver más horas pendientes (@horasPendientesAdicionales.Count)</span><i class="fa-solid fa-chevron-down"></i></button>
                    <div class="collapse history-box" id="pendientesAdicionales">
                        <div class="table-wrap @(capturaHabilitada ? "" : "blocked")">
                            <table class="hour-table">
                                <thead><tr><th>Hora</th><th>Rango</th><th>Objetivo</th><th>Contador</th><th>OK</th><th>Sospechosos</th><th>Scrap</th><th>Observaciones</th><th>Estado</th><th>Acción</th></tr></thead>
                                <tbody>
                                    @foreach (var fila in horasPendientesAdicionales)
                                    {
                                        var editable = capturaHabilitada && !fila.Capturada && fila.Disponible;
                                        var claseFila = fila.Vencida ? "row-overdue" : fila.Disponible ? "row-ready" : "";
                                        var esObligatoria = horaObligatoria != null && horaObligatoria.NumeroHora == fila.NumeroHora;
                                        <tr class="@claseFila" data-hour-row data-numero="@fila.NumeroHora" data-fecha="@fila.FechaProduccion.ToString("yyyy-MM-dd")" data-inicio="@Hora(fila.HoraInicio)" data-fin="@Hora(fila.HoraFin)" data-objetivo="@(fila.ObjetivoBloque ?? fila.ObjetivoHora ?? objetivoHora ?? 0)" data-obligatoria="@(esObligatoria ? "true" : "false")">
                                            <td><div class="hour-label">Hora @fila.NumeroHora</div></td>
                                            <td><div class="hour-range">@Hora(fila.HoraInicio) - @Hora(fila.HoraFin)</div><div class="small text-muted">@fila.FechaProduccion.ToString("dd/MM/yyyy")</div></td>
                                            <td class="objective-cell"><div class="objective-main">@((fila.ObjetivoBloque ?? fila.ObjetivoHora ?? objetivoHora)?.ToString("N0") ?? "-")</div><span class="objective-sub">@(fila.ObjetivoBloque.HasValue && fila.ObjetivoHora.HasValue && fila.ObjetivoBloque.Value != fila.ObjetivoHora.Value ? "Ajustado al bloque" : "PZA objetivo")</span></td>
                                            <td><input class="hour-input counter empty-number" type="number" min="0" value="" placeholder="Actual" inputmode="numeric" data-field="counter" @(editable ? "" : "disabled") /></td>
                                            <td><input class="hour-input ok empty-number" type="number" min="0" value="" placeholder="Auto" inputmode="numeric" data-field="ok" @(editable ? "" : "disabled") /></td>
                                            <td><input class="hour-input yellow empty-number" type="number" min="0" value="" placeholder="0" inputmode="numeric" data-field="yellow" @(editable ? "" : "disabled") /></td>
                                            <td><input class="hour-input scrap empty-number" type="number" min="0" value="" placeholder="0" inputmode="numeric" data-field="scrap" @(editable ? "" : "disabled") /></td>
                                            <td><input class="obs-input form-control" maxlength="500" placeholder="Opcional" data-field="obs" @(editable ? "" : "disabled") /></td>
                                            <td><span class="status-pill @EstadoClase(fila)">@EstadoTexto(fila)</span></td>
                                            <td><button type="button" class="btn-save-row btn-open-hour" @(editable ? "" : "disabled")><i class="fa-solid fa-floppy-disk me-1"></i>Guardar</button></td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    </div>
                }
                @if (historialTurnos.Count > 0)
                {
                    <div class="shift-history">
                        <button class="history-toggle" type="button" data-bs-toggle="collapse" data-bs-target="#historialPorTurnos" aria-expanded="false" aria-controls="historialPorTurnos">
                            <span><i class="fa-solid fa-people-arrows-left-right me-2"></i>Historial de producción por turnos (@historialTurnos.Count)</span>
                            <i class="fa-solid fa-chevron-down"></i>
                        </button>
                        <div class="collapse history-box" id="historialPorTurnos">
                            <div class="accordion shift-accordion" id="accordionTurnosProduccion">
                                @foreach (var turno in historialTurnos)
                                {
                                    var idTurno = $"turnoProduccion_{turno.NumeroTurno}";
                                    var horasTurno = turno.Horas?.OrderBy(x => x.FechaProduccion).ThenBy(x => x.HoraInicio).ToList() ?? new List<ERP.NSQuell.Models.ProduccionCapturaHoraFilaVm>();
                                    var textoFinTurno = turno.FechaFin.HasValue ? turno.FechaFin.Value.ToString("dd/MM/yyyy HH:mm") : "En curso";
                                    <div class="accordion-item">
                                        <h2 class="accordion-header" id="heading_@idTurno">
                                            <button class="accordion-button @(turno.NumeroTurno == historialTurnos.Last().NumeroTurno ? "" : "collapsed")" type="button" data-bs-toggle="collapse" data-bs-target="#@idTurno" aria-expanded="@(turno.NumeroTurno == historialTurnos.Last().NumeroTurno ? "true" : "false")" aria-controls="@idTurno">
                                                <div class="shift-head-main">
                                                    <span class="shift-name"><i class="fa-solid fa-user-clock me-1"></i>@Txt(turno.TurnoNombre)</span>
                                                    <span class="shift-operator">@Txt(turno.OperadorNombre)</span>
                                                    <span class="shift-range">@turno.FechaInicio.ToString("dd/MM/yyyy HH:mm") → @textoFinTurno</span>
                                                    <span class="shift-badges">
                                                        <span class="shift-badge ok">OK @Numero(turno.CantidadOK)</span>
                                                        <span class="shift-badge sos">SOS @Numero(turno.CantidadSospechosa)</span>
                                                        <span class="shift-badge scrap">SCRAP @Numero(turno.CantidadScrap)</span>
                                                        <span class="shift-badge goal">@turno.PorcentajeCumplimiento.ToString("0.#")%</span>
                                                    </span>
                                                </div>
                                            </button>
                                        </h2>
                                        <div id="@idTurno" class="accordion-collapse collapse @(turno.NumeroTurno == historialTurnos.Last().NumeroTurno ? "show" : "")" aria-labelledby="heading_@idTurno" data-bs-parent="#accordionTurnosProduccion">
                                            <div class="accordion-body">
                                                <div class="shift-summary">
                                                    <div class="shift-summary-card"><div class="k">Operador</div><div class="v">@Txt(turno.OperadorNombre)</div></div>
                                                    <div class="shift-summary-card"><div class="k">Horas capturadas</div><div class="v">@horasTurno.Count</div></div>
                                                    <div class="shift-summary-card"><div class="k">Objetivo acumulado</div><div class="v">@Numero(turno.ObjetivoTotal)</div></div>
                                                    <div class="shift-summary-card"><div class="k">OK acumulado</div><div class="v text-success">@Numero(turno.CantidadOK)</div></div>
                                                    <div class="shift-summary-card"><div class="k">Cumplimiento</div><div class="v @(turno.CumplioObjetivo ? "text-success" : "text-danger")">@turno.PorcentajeCumplimiento.ToString("0.#")%</div></div>
                                                </div>
                                                <div class="table-wrap">
                                                    <table class="hour-table">
                                                        <thead>
                                                            <tr><th>Hora</th><th>Rango</th><th>Objetivo</th><th>OK</th><th>Sospechosos</th><th>Scrap</th><th>Cumplimiento</th><th>Observaciones</th><th>Estado</th></tr>
                                                        </thead>
                                                        <tbody>
                                                            @for (var i = 0; i < horasTurno.Count; i++)
                                                            {
                                                                var fila = horasTurno[i];
                                                                var claseHistorial = fila.ObjetivoBloque.HasValue && fila.ObjetivoBloque.Value > 0 && !fila.CumplioObjetivo ? "row-goal-fail" : "row-complete";
                                                                <tr class="@claseHistorial">
                                                                    <td>
                                                                        <div class="hour-label">Hora @(i + 1)</div>
                                                                        <div class="small text-muted">Global #@fila.NumeroHora</div>
                                                                    </td>
                                                                    <td><div class="hour-range">@Hora(fila.HoraInicio) - @Hora(fila.HoraFin)</div><div class="small text-muted">@fila.FechaProduccion.ToString("dd/MM/yyyy")</div></td>
                                                                    <td class="objective-cell"><div class="objective-main">@((fila.ObjetivoBloque ?? fila.ObjetivoHora)?.ToString("N0") ?? "-")</div><span class="objective-sub">PZA</span></td>
                                                                    <td><span class="status-pill status-complete">@Numero(fila.CantidadOK)</span></td>
                                                                    <td><span class="status-pill status-ready">@Numero(fila.CantidadSospechosa)</span></td>
                                                                    <td><span class="status-pill status-overdue">@Numero(fila.CantidadScrap)</span></td>
                                                                    <td>
                                                                        @if (!fila.ObjetivoBloque.HasValue || fila.ObjetivoBloque.Value <= 0)
                                                                        {
                                                                            <span class="goal-result goal-neutral"><span class="history-goal-title"><i class="fa-solid fa-circle-info me-1"></i>Sin objetivo</span><span class="history-goal-detail">No se pudo evaluar esta hora</span></span>
                                                                        }
                                                                        else if (fila.CumplioObjetivo)
                                                                        {
                                                                            <span class="goal-result goal-success"><span class="history-goal-title"><i class="fa-solid fa-circle-check me-1"></i>Cumplió</span><span class="history-goal-detail">@fila.PorcentajeCumplimiento.ToString("0.#")% del objetivo</span><span class="history-goal-detail">@(fila.PiezasSobreObjetivo > 0 ? $"Superó por {fila.PiezasSobreObjetivo:N0} pieza(s)" : "Objetivo exacto")</span></span>
                                                                        }
                                                                        else
                                                                        {
                                                                            <span class="goal-result goal-danger"><span class="history-goal-title"><i class="fa-solid fa-circle-xmark me-1"></i>No cumplió</span><span class="history-goal-detail">@fila.PorcentajeCumplimiento.ToString("0.#")% del objetivo</span><span class="history-goal-detail">Faltaron @fila.PiezasFaltantes.ToString("N0") pieza(s)</span></span>
                                                                        }
                                                                    </td>
                                                                    <td>@Txt(fila.Observaciones)</td>
                                                                    <td><span class="status-pill status-complete"><i class="fa-solid fa-check"></i> Capturada</span></td>
                                                                </tr>
                                                            }
                                                        </tbody>
                                                    </table>
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                }
                            </div>
                        </div>
                    </div>
                }
                else if (horasCapturadas.Count > 0)
                {
                    <div class="alert alert-warning rounded-4 fw-bold mt-3 mb-0"><i class="fa-solid fa-triangle-exclamation me-1"></i>Existen horas capturadas, pero todavía no se pudo construir el historial por turnos. Revisa que cada hora tenga OperadorID/OperadorNombre y que Captura cargue Model.HistorialTurnos.</div>
                }

                @if (historialCambiosTurno.Count > 0)
                {
                    <div class="shift-history">
                        <button class="history-toggle" type="button" data-bs-toggle="collapse" data-bs-target="#historialCambiosTurno" aria-expanded="false" aria-controls="historialCambiosTurno">
                            <span><i class="fa-solid fa-right-left me-2"></i>Historial de cambios de turno (@historialCambiosTurno.Count)</span>
                            <i class="fa-solid fa-chevron-down"></i>
                        </button>
                        <div class="collapse history-box" id="historialCambiosTurno">
                            @foreach (var cambio in historialCambiosTurno.OrderByDescending(x => x.FechaEntrega))
                            {
                                var estadoClase = string.Equals(cambio.Estado, "RECIBIDO", StringComparison.OrdinalIgnoreCase) ? "status-complete" : string.Equals(cambio.Estado, "CANCELADO", StringComparison.OrdinalIgnoreCase) ? "status-overdue" : "status-ready";
                                <div class="turn-change-card">
                                    <div class="d-flex justify-content-between align-items-center flex-wrap gap-2 mb-2">
                                        <div class="fw-bold text-primary"><i class="fa-solid fa-arrow-right-arrow-left me-1"></i>Cambio #@cambio.CambioTurnoID</div>
                                        <div class="d-flex gap-2 flex-wrap">
                                            <span class="status-pill @estadoClase">@Txt(cambio.Estado)</span>
                                            <span class="status-pill status-future">
                                                @(string.Equals(cambio.OrigenOperadorEntrante, "TECNICO", StringComparison.OrdinalIgnoreCase)
                                                                                    ? "Técnico"
                                                                                    : string.Equals(cambio.OrigenOperadorEntrante, "ESCALA", StringComparison.OrdinalIgnoreCase)
                                                                                    ? "Escala"
                                                                                    : "Manual")
                                </span>
                            </div>
                        </div>
                        <div class="turn-change-flow">
                            <div class="turn-change-person">
                                <div class="k">Entrega</div>
                                <div class="v">@Txt(cambio.OperadorSalienteNombre)</div>
                                <div class="small text-muted">@Txt(cambio.TurnoSalienteNombre)</div>
                            </div>
                            <div class="turn-change-arrow"><i class="fa-solid fa-arrow-right"></i></div>
                            <div class="turn-change-person">
                                <div class="k">Recibe</div>
                                <div class="v">@Txt(cambio.OperadorEntranteNombre)</div>
                                <div class="small text-muted">@Txt(cambio.TurnoEntranteNombre)</div>
                            </div>
                        </div>
                        <div class="turn-change-meta">
                            <div class="turn-card"><div class="label">Fecha entrega</div><div class="value">@cambio.FechaEntrega.ToString("dd/MM/yyyy HH:mm")</div></div>
                            <div class="turn-card"><div class="label">Fecha recepción</div><div class="value">@(cambio.FechaRecepcion.HasValue? cambio.FechaRecepcion.Value.ToString("dd/MM/yyyy HH:mm") : "Pendiente")</div></div>
                            <div class="turn-card"><div class="label">Producción entregada</div><div class="value">OK @Numero(cambio.CantidadOK)</div><div class="small text-muted">SOS @Numero(cambio.CantidadSospechosa) · Scrap @Numero(cambio.CantidadScrap)</div></div>
                            <div class="turn-card"><div class="label">Cajas</div><div class="value">@Numero(cambio.TotalCajasEntregadas) / @Numero(cambio.TotalCajas)</div><div class="small text-muted">Pendientes @Numero(cambio.TotalCajasPendientes)</div></div>
                        </div>
                        <div class="turn-change-obs">
                            <div><div class="k">Observaciones de entrega</div><div class="v">@Txt(cambio.ObservacionesEntrega)</div></div>
                            <div><div class="k">Observaciones de recepción</div><div class="v">@Txt(cambio.ObservacionesRecepcion)</div></div>
                        </div>
                    </div>
                                        }
                        </div>
                    </div>
                }
            }
        </div>
    </section>

    @if (tieneTiempoExtraActivo && tiempoExtraActivo != null)
    {
        <section class="extra-panel active" id="panelTiempoExtra" data-segundos-sesion="@Math.Floor(segundosSesionTiempoExtra)" data-segundos-corte="@Math.Floor(segundosCorteTiempoExtra)">
            <div class="extra-head">
                <div>
                    <div class="extra-title"><i class="fa-solid fa-stopwatch me-2"></i>Tiempo extra en curso</div>
                    <div class="extra-subtitle">La sesión queda guardada en el ERP. Cada corte toma como base la última lectura registrada y reinicia automáticamente el bloque siguiente.</div>
                </div>
                <span class="extra-running-badge"><span class="extra-running-dot"></span>@tiempoExtraActivo.EstadoNombre</span>
            </div>
            <div class="extra-body">
                <div class="extra-timer-wrap">
                    <div class="extra-timer-card">
                        <div class="extra-timer-label">Tiempo total de la sesión</div>
                        <div class="extra-timer-value" id="cronometroTiempoExtra">00:00:00</div>
                        <div class="extra-cut-status">Inició @tiempoExtraActivo.FechaHoraInicio.ToString("dd/MM/yyyy HH:mm")</div>
                    </div>
                    <div class="extra-timer-card cut">
                        <div class="extra-timer-label">Desde el último corte</div>
                        <div class="extra-timer-value @(corteTiempoExtraDisponible ? "overdue" : "")" id="cronometroCorteTiempoExtra">00:00:00</div>
                        <div class="extra-cut-status @(corteTiempoExtraDisponible ? "overdue" : "")" id="estadoCorteTiempoExtra">
                            @(corteTiempoExtraDisponible ? "Corte de 60 minutos disponible." : "Próximo corte al cumplir 60 minutos.")
                        </div>
                    </div>
                </div>
                <div class="extra-meta-grid">
                    <div class="extra-meta-card"><div class="k">Sesión</div><div class="v">#@tiempoExtraActivo.TiempoExtraID</div></div>
                    <div class="extra-meta-card"><div class="k">Operador</div><div class="v">@Txt(tiempoExtraActivo.OperadorInicioNombre)</div></div>
                    <div class="extra-meta-card"><div class="k">Contador base</div><div class="v">@tiempoExtraActivo.ContadorInicio.ToString("N0")</div></div>
                    <div class="extra-meta-card"><div class="k">Último contador corte</div><div class="v">@tiempoExtraActivo.ContadorUltimoCorte.ToString("N0")</div></div>
                    <div class="extra-meta-card"><div class="k">Motivo</div><div class="v">@tiempoExtraActivo.MotivoNombre</div></div>
                </div>
                <div id="alertaCorteTiempoExtra" class="extra-due-alert @(corteTiempoExtraDisponible ? "" : "d-none")">
                    <i class="fa-solid fa-bell me-2"></i>Ya se cumplieron 60 minutos desde el último corte. Captura la lectura actual del contador para cerrar este bloque.
                </div>
                @if (Model.TieneParoAbierto)
                {
                    <div class="alert alert-danger rounded-4 fw-bold mt-3 mb-0"><i class="fa-solid fa-circle-pause me-1"></i>Existe un paro abierto. Cierra el paro antes de registrar o finalizar el tiempo extra.</div>
                }
                else if (Model.EstatusID != ERP.NSQuell.Models.ProduccionEstatus.EnProduccion)
                {
                    <div class="alert alert-warning rounded-4 fw-bold mt-3 mb-0"><i class="fa-solid fa-triangle-exclamation me-1"></i>La ejecución no se encuentra en Producción. El tiempo extra queda visible, pero no puede capturarse hasta recuperar el estado operativo correspondiente.</div>
                }
                <div class="extra-actions">
                    <button type="button"
                            class="btn-extra-cut @(corteTiempoExtraDisponible && Model.EstatusID == ERP.NSQuell.Models.ProduccionEstatus.EnProduccion && !Model.TieneParoAbierto ? "ready" : "")"
                            id="btnCapturarCorteTiempoExtra"
                            @((corteTiempoExtraDisponible && Model.EstatusID == ERP.NSQuell.Models.ProduccionEstatus.EnProduccion && !Model.TieneParoAbierto) ? "" : "disabled")>
                        <i class="fa-solid fa-gauge-high"></i>
                        Capturar corte
                    </button>
                    <button type="button"
                            class="btn-extra-finish"
                            id="btnFinalizarTiempoExtra"
                            @((Model.EstatusID != ERP.NSQuell.Models.ProduccionEstatus.EnProduccion || Model.TieneParoAbierto) ? "disabled" : "")>
                        <i class="fa-solid fa-flag-checkered"></i>
                        Finalizar tiempo extra
                    </button>
                </div>
                @if (!string.IsNullOrWhiteSpace(tiempoExtraActivo.Observaciones))
                {
                    <div class="alert alert-light border rounded-4 mt-3 mb-0"><strong>Observaciones de la sesión:</strong> @tiempoExtraActivo.Observaciones</div>
                }
            </div>
        </section>
    }
    else if (puedeIniciarTiempoExtra)
    {
        <section class="extra-panel ready">
            <div class="extra-head">
                <div>
                    <div class="extra-title"><i class="fa-solid fa-forward-fast me-2"></i>¿Vas a seguir produciendo?</div>
                    <div class="extra-subtitle">El tiempo normal planeado ya quedó capturado. Si la máquina continuará trabajando, inicia una sesión de tiempo extra.</div>
                </div>
                <button type="button" class="btn-extra-start" data-bs-toggle="modal" data-bs-target="#modalIniciarTiempoExtra"><i class="fa-solid fa-play"></i>Iniciar tiempo extra</button>
            </div>
            <div class="extra-body">
                <div class="extra-start-summary mb-0">
                    <div class="extra-start-card"><div class="k">Último contador</div><div class="v">@(ultimoContador.HasValue ? ultimoContador.Value.ToString("N0") : "-")</div></div>
                    <div class="extra-start-card"><div class="k">Cavidades en uso</div><div class="v">@(cavidadesEnUso.HasValue ? cavidadesEnUso.Value.ToString("N0") : "-")</div></div>
                    <div class="extra-start-card"><div class="k">Ciclo vigente</div><div class="v">@(cicloEnUso.HasValue ? $"{cicloEnUso.Value:0.##} s" : "-")</div></div>
                </div>
            </div>
        </section>
    }
    else if (Model.EstatusID == ERP.NSQuell.Models.ProduccionEstatus.EnProduccion)
    {
        <section class="extra-panel waiting">
            <div class="extra-body">
                <div class="extra-waiting-message"><i class="fa-solid fa-hourglass-half text-primary fa-lg"></i><span>El botón de <strong>tiempo extra</strong> se habilitará automáticamente cuando se complete la captura del tiempo normal planeado.</span></div>
            </div>
        </section>
    }

    @if (historialTiempoExtra.Count > 0)
    {
        <div class="extra-history">
            <button class="history-toggle" type="button" data-bs-toggle="collapse" data-bs-target="#historialTiempoExtra" aria-expanded="false" aria-controls="historialTiempoExtra"><span><i class="fa-solid fa-clock-rotate-left me-2"></i>Historial de tiempo extra (@historialTiempoExtra.Count)</span><i class="fa-solid fa-chevron-down"></i></button>
            <div class="collapse history-box" id="historialTiempoExtra">
                <div class="table-wrap">
                    <table class="extra-history-table">
                        <thead><tr><th>Sesión</th><th>Rango</th><th>Operador</th><th>Motivo</th><th>Contador inicial</th><th>Contador final</th><th>Cortes</th><th>Estado</th></tr></thead>
                        <tbody>
                            @foreach (var sesion in historialTiempoExtra)
                            {
                                var claseEstadoExtra = sesion.EstaFinalizado ? "status-complete" : sesion.EstaCancelado ? "status-overdue" : "status-ready";
                                <tr>
                                    <td><strong>#@sesion.TiempoExtraID</strong></td>
                                    <td>@sesion.RangoTexto</td>
                                    <td>@Txt(sesion.OperadorInicioNombre)</td>
                                    <td>@sesion.MotivoNombre</td>
                                    <td>@sesion.ContadorInicio.ToString("N0")</td>
                                    <td>@(sesion.ContadorFin.HasValue ? sesion.ContadorFin.Value.ToString("N0") : "-")</td>
                                    <td>@(sesion.Cortes?.Count ?? 0)</td>
                                    <td><span class="status-pill @claseEstadoExtra">@sesion.EstadoNombre</span></td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    }
</div>

<div class="modal fade modal-extra" id="modalIniciarTiempoExtra" tabindex="-1" aria-hidden="true" data-bs-backdrop="static" data-bs-keyboard="false">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title"><i class="fa-solid fa-stopwatch me-2"></i>Iniciar tiempo extra</h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Cerrar"></button>
            </div>
            <form method="post" action="@Url.Action("IniciarTiempoExtra","ProduccionOperador")" id="formIniciarTiempoExtra">
