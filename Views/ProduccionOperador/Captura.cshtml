                                <div class="counter-reference"><div class="k">Último contador compartido</div><div class="v">@(ultimoContadorCompartido.HasValue ? ultimoContadorCompartido.Value.ToString("N0") : "Sin lectura sincronizada")</div><div class="small text-muted mt-1">Ciclo físico: @(cicloEnUso.HasValue ? $"{cicloEnUso.Value:0.##} s" : "-")</div></div>
                            </div>
