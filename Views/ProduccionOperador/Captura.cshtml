                                <div class="modal-goal"><div class="goal-label">Resultado contra objetivo · @ladoPareja</div><div class="modal-goal-feedback" id="modalObjetivoFeedbackPareja">Captura el contador y scrap para calcular.</div></div>
                                <div class="modal-grid mb-3"><div><div class="modal-label text-success">Verdes / OK</div><input type="number" min="0" value="" placeholder="Auto" id="modalOKPareja" class="modal-qty ok empty-number" readonly tabindex="-1" /><div class="ok-mode-row"><span class="ok-mode-badge"><i class="fa-solid fa-wand-magic-sparkles"></i>Automático</span></div></div><div><div class="modal-label text-danger">Rojas / Scrap</div><input type="number" min="0" value="0" name="CantidadScrapPareja" id="modalScrapPareja" class="modal-qty scrap empty-number" inputmode="numeric" autocomplete="off" /></div></div>
                                <div class="defect-panel d-none" id="panelDefectosPareja"><div class="defect-head"><div><div class="defect-title"><i class="fa-solid fa-bug me-2"></i>Defectos @ladoPareja <span class="text-danger">*</span></div><div class="defect-help">Clasifica exactamente todas las piezas scrap de este lado.</div></div><div class="defect-counter" id="contadorDefectosPareja">0 / 0 clasificadas</div></div>@if (catalogoDefectos.Count == 0){<div class="alert alert-danger rounded-4 fw-bold mb-0">No existen defectos activos.</div>}else{<div class="defect-list" id="listaDefectosPareja"></div><div class="defect-footer"><button type="button" class="btn-add-defect" id="btnAgregarDefectoPareja"><i class="fa-solid fa-plus me-1"></i>Agregar defecto</button><div class="defect-feedback" id="resumenDefectosPareja">Selecciona el defecto.</div></div>}</div>
                                <div class="classification-feedback" id="modalClasificacionFeedbackPareja"><i class="fa-solid fa-circle-info me-1"></i>OK = producción física de @ladoPareja - scrap de @ladoPareja.</div>
                                <label class="form-label fw-bold mt-3">Observaciones @ladoPareja</label><textarea name="ObservacionesPareja" id="modalObsPareja" class="form-control" rows="3" maxlength="500" placeholder="Opcional"></textarea>
                            </section>
                        </div>
                        <input type="hidden" id="modalSegmentos" value="" />
                        <input type="hidden" id="modalSegmentosPareja" value="" />
                        <div class="alert alert-success mt-3 mb-0"><i class="fa-solid fa-calculator me-1"></i><strong>Regla física:</strong> el delta del contador representa ciclos completos para los dos lados. No se divide entre LH y RH; cada OF multiplica esos ciclos por sus cavidades activas.</div>
                    </div>
                    <div class="modal-footer border-0 px-4 pb-4"><button type="submit" class="btn btn-primary w-100" id="btnGuardarHora"><i class="fa-solid fa-floppy-disk me-1"></i>Guardar hora LH/RH</button></div>
                </form>
            </div>
        </div>
    </div>
}
else
{
<div class="modal fade" id="modalCapturaHora" tabindex="-1" aria-hidden="true" data-bs-backdrop="static" data-bs-keyboard="false">
    <div class="modal-dialog modal-dialog-centered modal-lg">
        <div class="modal-content">
            <div class="modal-header"><h5 class="modal-title"><i class="fa-solid fa-bell me-2"></i>Captura horaria pendiente</h5><button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Cerrar"></button></div>
            <form method="post" action="@Url.Action("RegistrarHora","ProduccionOperador")" id="formModalHora">
                @Html.AntiForgeryToken()
                <div class="modal-body p-4">
                    <input type="hidden" name="EjecucionProduccionID" value="@Model.EjecucionProduccionID" />
                    <input type="hidden" name="FechaProduccion" id="modalFecha" />
                    <input type="hidden" name="HoraInicio" id="modalInicio" />
                    <input type="hidden" name="HoraFin" id="modalFin" />
                    <div class="text-center mb-3"><div class="text-muted fw-bold">Debes completar</div><div class="modal-hour" id="modalTituloHora">Hora pendiente</div><div class="text-muted" id="modalRangoHora"></div></div>
                    <div class="modal-goal">
                        <div class="goal-label">Objetivo de este bloque</div>
                        <div class="goal-value"><span id="modalObjetivo">-</span> <small>PZA</small></div>
                        <div class="modal-goal-feedback" id="modalObjetivoFeedback">Captura el contador y las piezas rojas para calcular automáticamente las verdes / OK.</div>
                    </div>

                    <div class="counter-capture-card">
                        <div class="d-flex justify-content-between align-items-start flex-wrap gap-2 mb-3">
                            <div>
                                <div class="fw-bold text-primary"><i class="fa-solid fa-gauge-high me-1"></i>Contador de máquina</div>
                                <div class="small text-muted fw-semibold">Escribe la lectura física de la máquina al cierre de este bloque.</div>
                            </div>
                            <span class="badge bg-primary">@(cavidadesEnUso.HasValue ? $"{cavidadesEnUso.Value:N0} cavidad(es) en uso" : "Cavidades pendientes")</span>
                        </div>
                        <div class="counter-capture-grid">
                            <div>
                                <label for="modalContador" class="form-label fw-bold">Contador actual</label>
                                <input type="number" min="0" step="1" value="" placeholder="Ej. 12850" name="ContadorMaquinaActual" id="modalContador" class="counter-value-input empty-number" inputmode="numeric" autocomplete="off" />
                            </div>
                            <div class="counter-reference">
                                <div class="k">Último contador registrado</div>
                                <div class="v">@(ultimoContador.HasValue? ultimoContador.Value.ToString("N0") : "Sin lectura previa")</div>
                                <div class="small text-muted mt-1">@(cicloEnUso.HasValue ? $"Ciclo vigente: {cicloEnUso.Value:0.##} s" : "El servidor tomará la configuración técnica vigente")</div>
                            </div>
                        </div>
                        <div class="counter-feedback" id="modalContadorFeedback">Captura el contador. El servidor hará el cálculo real considerando contador base, cavidades, paros y cambios de configuración.</div>
                    </div>

                    <div id="mensajeCapturaHora" class="alert alert-danger rounded-4 fw-bold d-none mb-3" role="alert"></div>

                    <div class="physical-summary" id="resumenFisicoHora">
                        <div class="physical-card"><div class="k">Producción física</div><div class="v" id="modalPiezasFisicas">-</div></div>
                        <div class="physical-card"><div class="k">Verdes / OK</div><div class="v text-success" id="modalOKSugerido">-</div></div>
                        <div class="physical-card"><div class="k">Min. productivos</div><div class="v" id="modalMinutosProductivos">-</div></div>
                        <div class="physical-card"><div class="k">Segmentos</div><div class="v" id="modalSegmentos">-</div></div>
                    </div>

                    <div class="modal-grid mb-3">
                        <div>
                            <div class="modal-label text-success">Verdes / OK</div>
                            <input type="number" min="0" value="" placeholder="Auto" name="CantidadOK" id="modalOK" class="modal-qty ok empty-number" inputmode="numeric" autocomplete="off" readonly tabindex="-1" />
                            <div class="ok-mode-row"><span class="ok-mode-badge"><i class="fa-solid fa-wand-magic-sparkles"></i>Calculado automáticamente</span></div>
                        </div>
                        <div>
                            <div class="modal-label text-danger">Rojas / Scrap</div>
                            <input type="number" min="0" value="0" placeholder="0" name="CantidadScrap" id="modalScrap" class="modal-qty scrap empty-number" inputmode="numeric" autocomplete="off" />
                        </div>
                    </div>

                    <div class="defect-panel d-none" id="panelDefectosNormal">
                        <div class="defect-head">
                            <div>
                                <div class="defect-title"><i class="fa-solid fa-bug me-2"></i>¿Por qué estás retirando estas piezas? <span class="text-danger">*</span></div>
                                <div class="defect-help">El defecto es obligatorio cuando Scrap es mayor que cero. Puedes repartir el scrap entre varios defectos.</div>
                            </div>
                            <div class="defect-counter" id="contadorDefectosNormal">0 / 0 clasificadas</div>
                        </div>
                        @if (catalogoDefectos.Count == 0)
                        {
                            <div class="alert alert-danger rounded-4 fw-bold mb-0"><i class="fa-solid fa-triangle-exclamation me-1"></i>No existen defectos activos en Calidad_CatalogoDefectos. No podrás guardar scrap hasta que exista al menos un defecto activo.</div>
                        }
                        else
                        {
                            <div class="defect-list" id="listaDefectosNormal"></div>
                            <div class="defect-footer">
                                <button type="button" class="btn-add-defect" id="btnAgregarDefectoNormal"><i class="fa-solid fa-plus me-1"></i>Agregar otro defecto</button>
                                <div class="defect-feedback" id="resumenDefectosNormal">Selecciona el defecto de las piezas scrap.</div>
                            </div>
                        }
                    </div>

                    <div class="classification-feedback" id="modalClasificacionFeedback"><i class="fa-solid fa-circle-info me-1"></i>El ERP calcula automáticamente: <strong>verdes / OK = producción física - rojas / Scrap</strong>. El operador únicamente registra el contador y las piezas rojas.</div>

                    <label class="form-label fw-bold mt-3">Observaciones</label><textarea name="Observaciones" id="modalObs" class="form-control" rows="3" maxlength="500" placeholder="Opcional. Si el contador no registró producción, explica qué ocurrió."></textarea>
                    <div class="alert alert-success mt-3 mb-0"><i class="fa-solid fa-calculator me-1"></i><strong>Cálculo automático:</strong> las piezas verdes no se capturan manualmente. El ERP las obtiene restando las piezas rojas a la producción física calculada desde el contador.</div>
                </div>
                <div class="modal-footer border-0 px-4 pb-4"><button type="submit" class="btn btn-primary w-100" id="btnGuardarHora"><i class="fa-solid fa-floppy-disk me-1"></i>Guardar Hora</button></div>
            </form>
        </div>
    </div>
</div>

}

<template id="templateDefectoScrap">
    <div class="defect-row" data-defect-row>
        <div>
            <label class="form-label">Tipo de defecto</label>
            <select class="form-select" data-defect-select>
                <option value="">Selecciona defecto...</option>
                @foreach (var defecto in catalogoDefectos)
                {
                    <option value="@defecto.CatalogoDefectoID">@defecto.Texto</option>
                }
            </select>
        </div>
        <div>
            <label class="form-label">Cantidad</label>
            <input type="number" min="1" step="1" class="form-control text-center" data-defect-qty inputmode="numeric" autocomplete="off" />
        </div>
        <button type="button" class="btn-remove-defect" data-remove-defect title="Quitar defecto" aria-label="Quitar defecto"><i class="fa-solid fa-trash-can"></i></button>
        <div class="defect-observation">
            <label class="form-label">Observación del defecto <span class="text-muted text-lowercase">(opcional)</span></label>
            <input type="text" maxlength="500" class="form-control" data-defect-obs placeholder="Ej. zona de la pieza, condición observada, detalle útil para Calidad" />
        </div>
    </div>
</template>

@section Scripts {
    <script>
        document.addEventListener('DOMContentLoaded',function(){
            const modalElement=document.getElementById('modalCapturaHora');
            const modal=modalElement?bootstrap.Modal.getOrCreateInstance(modalElement):null;
            const form=document.getElementById('formModalHora');
            const urlPrevisualizar='@Url.Action("PrevisualizarProduccionHora", "ProduccionOperador")';
            const esLhRh=@esLhRh.ToString().ToLowerInvariant();
            const capturaHabilitada=@capturaHabilitada.ToString().ToLowerInvariant();
            const tieneParoAbierto=@tieneParoFisico.ToString().ToLowerInvariant();
            const tieneTiempoExtraActivo=@tieneTiempoExtraActivo.ToString().ToLowerInvariant();
            const ejecucionEnProduccion=@(Model.EstatusID == ERP.NSQuell.Models.ProduccionEstatus.EnProduccion ? "true" : "false");
            const formIniciarTiempoExtra=document.getElementById('formIniciarTiempoExtra');
            let filaActiva=null;
            let previewTimer=null;
            let previewSecuencia=0;
            let ultimaPrevisualizacion=null;
            let claveFilaDefectosNormal=null;
            let claveFilaDefectosPareja=null;

            function numeroSeguro(input){
                const raw=(input?.value||'').trim();
                if(raw==='')return 0;
                const numero=Number(raw);
                return Number.isFinite(numero)?numero:0;
            }

            const hayCatalogoDefectos=@(catalogoDefectos.Count > 0 ? "true" : "false");

            function configDefectos(tipo){
                if(tipo==='extra')return{scrapId:'extraScrap',panelId:'panelDefectosExtra',listaId:'listaDefectosExtra',contadorId:'contadorDefectosExtra',resumenId:'resumenDefectosExtra',agregarId:'btnAgregarDefectoExtra',prefix:'DefectosScrap'};
                if(tipo==='pareja')return{scrapId:'modalScrapPareja',panelId:'panelDefectosPareja',listaId:'listaDefectosPareja',contadorId:'contadorDefectosPareja',resumenId:'resumenDefectosPareja',agregarId:'btnAgregarDefectoPareja',prefix:'DefectosScrapPareja'};
                return{scrapId:'modalScrap',panelId:'panelDefectosNormal',listaId:'listaDefectosNormal',contadorId:'contadorDefectosNormal',resumenId:'resumenDefectosNormal',agregarId:'btnAgregarDefectoNormal',prefix:'DefectosScrap'};
            }

            function filasDefecto(tipo){
                const cfg=configDefectos(tipo);
                const lista=document.getElementById(cfg.listaId);
                return lista?Array.from(lista.querySelectorAll('[data-defect-row]')):[];
            }

            function reindexarDefectos(tipo){
                const cfg=configDefectos(tipo);
                filasDefecto(tipo).forEach(function(fila,index){
                    const select=fila.querySelector('[data-defect-select]');
                    const qty=fila.querySelector('[data-defect-qty]');
                    const obs=fila.querySelector('[data-defect-obs]');
                    if(select)select.name=cfg.prefix+'['+index+'].CatalogoDefectoID';
                    if(qty)qty.name=cfg.prefix+'['+index+'].CantidadScrap';
                    if(obs)obs.name=cfg.prefix+'['+index+'].Observaciones';
                });
            }

            function agregarFilaDefecto(tipo,cantidadSugerida){
                const cfg=configDefectos(tipo);
                const lista=document.getElementById(cfg.listaId);
                const template=document.getElementById('templateDefectoScrap');
                if(!lista||!template||!hayCatalogoDefectos)return null;
                const fragment=template.content.cloneNode(true);
                const fila=fragment.querySelector('[data-defect-row]');
                const qty=fila?.querySelector('[data-defect-qty]');
                if(qty&&Number(cantidadSugerida)>0){qty.value=String(Math.trunc(Number(cantidadSugerida)));fila.dataset.cantidadAutomatica='true';}
                lista.appendChild(fragment);
                reindexarDefectos(tipo);
                return lista.lastElementChild;
            }

            function reiniciarDefectos(tipo){
                const cfg=configDefectos(tipo);
                const lista=document.getElementById(cfg.listaId);
                if(lista)lista.innerHTML='';
                document.getElementById(cfg.panelId)?.classList.add('d-none');
                pintarEstadoDefectos(tipo);
            }

            function evaluarDefectos(tipo){
                const cfg=configDefectos(tipo);
                const scrap=Math.max(0,Math.trunc(numeroSeguro(document.getElementById(cfg.scrapId))));
                if(scrap<=0)return{valido:true,scrap:0,total:0,faltan:0,mensaje:'Sin scrap por clasificar.',estado:'ok'};
                if(!hayCatalogoDefectos)return{valido:false,scrap,total:0,faltan:scrap,mensaje:'No existen defectos activos en el catálogo. Solicita a Calidad que habilite al menos un defecto.',estado:'error'};
                const filas=filasDefecto(tipo);
                if(filas.length===0)return{valido:false,scrap,total:0,faltan:scrap,mensaje:'Selecciona el defecto de las piezas scrap.',estado:'error'};
                let total=0;
                const ids=[];
                for(const fila of filas){
                    const select=fila.querySelector('[data-defect-select]');
                    const qtyInput=fila.querySelector('[data-defect-qty]');
                    const id=Number((select?.value||'').trim());
                    const raw=(qtyInput?.value||'').trim();
                    const qty=Number(raw);
                    if(!Number.isInteger(id)||id<=0)return{valido:false,scrap,total,faltan:Math.max(0,scrap-total),mensaje:'Selecciona un tipo de defecto en todas las filas.',estado:'error'};
                    if(raw===''||!Number.isInteger(qty)||qty<=0)return{valido:false,scrap,total,faltan:Math.max(0,scrap-total),mensaje:'La cantidad de cada defecto debe ser un número entero mayor a cero.',estado:'error'};
                    ids.push(id);total+=qty;
                }
                if(new Set(ids).size!==ids.length)return{valido:false,scrap,total,faltan:Math.max(0,scrap-total),mensaje:'No repitas el mismo defecto. Usa una sola fila y coloca ahí la cantidad total.',estado:'error'};
                if(total<scrap)return{valido:false,scrap,total,faltan:scrap-total,mensaje:'Has clasificado '+total.toLocaleString('es-MX')+' de '+scrap.toLocaleString('es-MX')+' pieza(s). Faltan '+(scrap-total).toLocaleString('es-MX')+'.',estado:'warning'};
                if(total>scrap)return{valido:false,scrap,total,faltan:0,mensaje:'Asignaste '+total.toLocaleString('es-MX')+' pieza(s) a defectos, pero el scrap es '+scrap.toLocaleString('es-MX')+'.',estado:'error'};
                return{valido:true,scrap,total,faltan:0,mensaje:'Scrap completamente clasificado: '+total.toLocaleString('es-MX')+' de '+scrap.toLocaleString('es-MX')+' pieza(s).',estado:'ok'};
            }

            function actualizarBotonGuardarHora(){
                const guardar=document.getElementById('btnGuardarHora');
                if(!guardar||guardar.dataset.enviando)return;
                const normal=evaluarDefectos('normal').valido;
                const pareja=!esLhRh||evaluarDefectos('pareja').valido;
                guardar.disabled=!(normal&&pareja);
            }

            function pintarEstadoDefectos(tipo){
                const cfg=configDefectos(tipo);
                const estado=evaluarDefectos(tipo);
                const contador=document.getElementById(cfg.contadorId);
                const resumen=document.getElementById(cfg.resumenId);
                const agregar=document.getElementById(cfg.agregarId);
                if(contador){contador.textContent=estado.total.toLocaleString('es-MX')+' / '+estado.scrap.toLocaleString('es-MX')+' clasificadas';contador.classList.toggle('ok',estado.valido&&estado.scrap>0);}
                if(resumen){resumen.textContent=estado.mensaje;resumen.className='defect-feedback'+(estado.estado==='ok'?' ok':estado.estado==='warning'?' warning':'');}
                if(agregar){const numeroFilas=filasDefecto(tipo).length;agregar.disabled=!hayCatalogoDefectos||estado.scrap<=0||(estado.scrap>0&&numeroFilas>=estado.scrap);}
                if(tipo==='normal'||tipo==='pareja')actualizarBotonGuardarHora();
                return estado;
            }

            function sincronizarDefectosConScrap(tipo){
                const cfg=configDefectos(tipo);
                const scrap=Math.max(0,Math.trunc(numeroSeguro(document.getElementById(cfg.scrapId))));
                const panel=document.getElementById(cfg.panelId);
                const lista=document.getElementById(cfg.listaId);
                if(scrap<=0){if(lista)lista.innerHTML='';panel?.classList.add('d-none');pintarEstadoDefectos(tipo);return;}
                panel?.classList.remove('d-none');
                if(hayCatalogoDefectos&&filasDefecto(tipo).length===0)agregarFilaDefecto(tipo,scrap);
                const filas=filasDefecto(tipo);
                if(filas.length===1&&filas[0].dataset.cantidadAutomatica==='true'){const qty=filas[0].querySelector('[data-defect-qty]');if(qty)qty.value=String(scrap);}
                reindexarDefectos(tipo);pintarEstadoDefectos(tipo);
            }

            function prepararEventosDefectos(tipo){
                const cfg=configDefectos(tipo);
                const lista=document.getElementById(cfg.listaId);
                const agregar=document.getElementById(cfg.agregarId);
                agregar?.addEventListener('click',function(){
                    const estadoAntes=evaluarDefectos(tipo);const scrap=estadoAntes.scrap;const filas=filasDefecto(tipo);if(scrap<=0||filas.length>=scrap)return;
                    filas.forEach(f=>f.dataset.cantidadAutomatica='false');
                    let cantidadNueva=estadoAntes.total<scrap?scrap-estadoAntes.total:1;if(cantidadNueva<=0)cantidadNueva=1;
                    const nueva=agregarFilaDefecto(tipo,cantidadNueva);nueva?.querySelector('[data-defect-select]')?.focus();pintarEstadoDefectos(tipo);if(tipo==='extra')actualizarBotonConfirmarExtra();
                });
                lista?.addEventListener('input',function(e){const fila=e.target.closest?.('[data-defect-row]');if(fila&&e.target.matches('[data-defect-qty]'))fila.dataset.cantidadAutomatica='false';reindexarDefectos(tipo);pintarEstadoDefectos(tipo);if(tipo==='extra')actualizarBotonConfirmarExtra();});
                lista?.addEventListener('change',function(){reindexarDefectos(tipo);pintarEstadoDefectos(tipo);if(tipo==='extra')actualizarBotonConfirmarExtra();});
                lista?.addEventListener('click',function(e){const boton=e.target.closest?.('[data-remove-defect]');if(!boton)return;boton.closest('[data-defect-row]')?.remove();reindexarDefectos(tipo);if(filasDefecto(tipo).length===0){const scrap=Math.max(0,Math.trunc(numeroSeguro(document.getElementById(cfg.scrapId))));if(scrap>0&&hayCatalogoDefectos)agregarFilaDefecto(tipo,scrap);}pintarEstadoDefectos(tipo);if(tipo==='extra')actualizarBotonConfirmarExtra();});
            }

            prepararEventosDefectos('normal');
            prepararEventosDefectos('pareja');
            prepararEventosDefectos('extra');

            function limpiarPrevisualizacion(){
                ultimaPrevisualizacion=null;
                ['modalPiezasFisicas','modalOKSugerido','modalMinutosProductivos','modalSegmentos','modalPiezasFisicasPareja','modalOKSugeridoPareja','modalMinutosProductivosPareja','modalSegmentosPareja'].forEach(id=>{const e=document.getElementById(id);if(e)e.textContent='-';});
                const ok=document.getElementById('modalOK');if(ok)ok.value='';
                const okPareja=document.getElementById('modalOKPareja');if(okPareja)okPareja.value='';
                if(filaActiva){const campo=filaActiva.querySelector('[data-field="ok"]');if(campo)campo.value='';const campoPareja=filaActiva.querySelector('[data-field="ok-pareja"]');if(campoPareja)campoPareja.value='';}
                actualizarComparacionObjetivos();actualizarClasificaciones();
            }

            function establecerOKAutomatico(valor,esPareja=false){
                const input=document.getElementById(esPareja?'modalOKPareja':'modalOK');if(!input)return;
                input.value=Number(valor||0).toString();
                if(filaActiva){const campo=filaActiva.querySelector(esPareja?'[data-field="ok-pareja"]':'[data-field="ok"]');if(campo)campo.value=input.value;}
            }

            function actualizarComparacionObjetivoLado(inputId,feedbackId){
                const input=document.getElementById(inputId);const feedback=document.getElementById(feedbackId);if(!input||!feedback)return;
                const objetivo=Number(input.dataset.objetivo||0);const valorRaw=(input.value||'').trim();
                if(objetivo<=0){feedback.className='modal-goal-feedback text-muted';feedback.innerHTML='<i class="fa-solid fa-circle-info me-1"></i>Esta OF no tiene objetivo configurado para este bloque.';return;}
                if(valorRaw===''){feedback.className='modal-goal-feedback text-muted';feedback.textContent='Las verdes / OK se calcularán al leer el contador y descontar scrap.';return;}
                const ok=Number(valorRaw||0);const diferencia=ok-objetivo;const porcentaje=Math.round((ok/objetivo)*1000)/10;
                if(diferencia>0){feedback.className='modal-goal-feedback text-success';feedback.innerHTML='<i class="fa-solid fa-circle-check me-1"></i>'+porcentaje.toLocaleString('es-MX')+'% · supera por '+diferencia.toLocaleString('es-MX')+' pieza(s).';return;}
