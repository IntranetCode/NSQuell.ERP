                            <div class="turn-person-label">Operador seleccionado</div>
                            <div class="turn-person-name" id="turnSeleccionadoNombre">-</div>
                            <div class="small text-muted fw-bold mt-1" id="turnSeleccionadoDetalle"></div>
                        </div>
                        <div class="mb-0">
                            <label for="observacionesCambioTurno" class="form-label fw-bold">Observaciones de entrega</label>
                            <textarea name="Observaciones"
                                      id="observacionesCambioTurno"
                                      rows="3"
                                      maxlength="1000"
                                      class="form-control"
                                      placeholder="Ejemplo: máquina estable, pendiente seguimiento de una incidencia, material en proceso, etc."></textarea>
                        </div>
                    </div>
                </div>
                <div class="modal-footer border-0 px-4 pb-4">
                    <button type="button" class="btn btn-light fw-bold" data-bs-dismiss="modal">
                        Cancelar
                    </button>
                    <button type="submit"
                            class="btn btn-primary fw-bold"
                            id="btnConfirmarCambioTurno"
                            disabled>
                        <i class="fa-solid fa-paper-plane me-1"></i>
                        Enviar turno para recepción
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

<div class="modal fade modal-paro" id="modalIniciarParo" tabindex="-1" aria-hidden="true" data-bs-backdrop="static" data-bs-keyboard="false">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title"><i class="fa-solid fa-triangle-exclamation me-2"></i>Reportar paro de máquina</h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Cerrar"></button>
            </div>
            <form method="post" action="@Url.Action("IniciarParo", "ProduccionOperador")" id="formIniciarParo">
                @Html.AntiForgeryToken()
                <div class="modal-body p-4">
                    <input type="hidden" name="EjecucionProduccionID" value="@Model.EjecucionProduccionID" />

                    <div class="paro-warning mb-3">
                        <i class="fa-solid fa-circle-info me-1"></i>
                        Al confirmar, la ejecución quedará pausada y se bloqueará la captura por hora hasta cerrar el paro.
                    </div>
                    <div id="mensajeParo" class="alert alert-danger rounded-4 fw-bold d-none mb-3" role="alert"></div>

                    <div class="mb-3">
                        <label class="form-label fw-bold">Motivo del paro</label>
                        <select name="MotivoParoID" id="motivoParoId" class="form-select form-select-lg">
                            @foreach (var motivo in Model.MotivosParo ?? new List<Microsoft.AspNetCore.Mvc.Rendering.SelectListItem>())
                            {
                                <option value="@motivo.Value">@motivo.Text</option>
                            }
                        </select>
                    </div>

                    <div class="mb-3">
                        <label class="form-label fw-bold">Otro motivo</label>
                        <input type="text"
                               name="MotivoParoTexto"
                               id="motivoParoTexto"
                               maxlength="200"
                               class="form-control"
                               placeholder="Úsalo cuando el motivo no esté en el catálogo" />
                    </div>

                    <div>
                        <label class="form-label fw-bold">Descripción</label>
                        <textarea name="Descripcion"
                                  id="descripcionParo"
                                  rows="4"
                                  maxlength="500"
                                  class="form-control"
                                  placeholder="Describe brevemente qué ocurrió"></textarea>
                    </div>
                </div>
                <div class="modal-footer border-0 px-4 pb-4">
                    <button type="button" class="btn btn-light fw-bold" data-bs-dismiss="modal">Cancelar</button>
                    <button type="submit" class="btn btn-danger fw-bold" id="btnConfirmarParo">
                        <i class="fa-solid fa-stop me-1"></i>Iniciar paro
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

<div class="modal fade modal-reanudar" id="modalCerrarParo" tabindex="-1" aria-hidden="true" data-bs-backdrop="static" data-bs-keyboard="false">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title"><i class="fa-solid fa-play me-2"></i>Finalizar paro de máquina</h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Cerrar"></button>
            </div>
            <form method="post" action="@Url.Action("CerrarParo", "ProduccionOperador")" id="formCerrarParo">
                @Html.AntiForgeryToken()
                <div class="modal-body p-4">
                    <input type="hidden" name="ParoID" value="@Model.ParoAbiertoID" />

                    <div class="alert alert-success fw-bold rounded-4">
                        <i class="fa-solid fa-circle-check me-1"></i>
                        Confirma que la máquina está lista para continuar.
                    </div>

                    <div class="paro-warning mb-3">
                        <i class="fa-solid fa-clock me-1"></i>
                        Si el paro duró más de 15 minutos, el sistema regresará la producción a preparación y solicitará reliberación de Calidad.
                    </div>

                    <div>
                        <label class="form-label fw-bold">Observaciones de cierre</label>
                        <textarea name="ObservacionesCierre"
                                  rows="4"
                                  maxlength="500"
                                  class="form-control"
                                  placeholder="Describe la corrección o condición para reanudar"></textarea>
                    </div>
                </div>
                <div class="modal-footer border-0 px-4 pb-4">
                    <button type="button" class="btn btn-light fw-bold" data-bs-dismiss="modal">Cancelar</button>
                    <button type="submit" class="btn btn-success fw-bold" id="btnConfirmarCierreParo">
                        <i class="fa-solid fa-play me-1"></i>Finalizar y continuar
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

<div class="modal fade" id="modalCapturaHora" tabindex="-1" aria-hidden="true" data-bs-backdrop="static" data-bs-keyboard="false">
    <div class="modal-dialog modal-dialog-centered modal-lg">
        <div class="modal-content">
            <div class="modal-header"><h5 class="modal-title"><i class="fa-solid fa-bell me-2"></i>Captura horaria pendiente</h5><button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Cerrar"></button></div>
            <form method="post" action="@Url.Action("RegistrarHora","ProduccionOperador")" id="formModalHora">
                @Html.AntiForgeryToken()
                <div class="modal-body p-4">
                    <input type="hidden" name="EjecucionProduccionID" value="@Model.EjecucionProduccionID" />
                    <input type="hidden" name="FechaProduccion" id="modalFecha" />
                    <input type="hidden" name="HoraInicio" id="modalInicio" />
                    <input type="hidden" name="HoraFin" id="modalFin" />
                    <div class="text-center mb-3"><div class="text-muted fw-bold">Debes completar</div><div class="modal-hour" id="modalTituloHora">Hora pendiente</div><div class="text-muted" id="modalRangoHora"></div></div>
                    <div class="modal-goal">
                        <div class="goal-label">Objetivo de este bloque</div>
                        <div class="goal-value"><span id="modalObjetivo">-</span> <small>PZA</small></div>
                        <div class="modal-goal-feedback" id="modalObjetivoFeedback">Captura el contador para calcular la producción y sugerir las piezas OK.</div>
                    </div>

                    <div class="counter-capture-card">
                        <div class="d-flex justify-content-between align-items-start flex-wrap gap-2 mb-3">
                            <div>
                                <div class="fw-bold text-primary"><i class="fa-solid fa-gauge-high me-1"></i>Contador de máquina</div>
                                <div class="small text-muted fw-semibold">Escribe la lectura física de la máquina al cierre de este bloque.</div>
                            </div>
                            <span class="badge bg-primary">@(cavidadesEnUso.HasValue ? $"{cavidadesEnUso.Value:N0} cavidad(es) en uso" : "Cavidades pendientes")</span>
                        </div>
                        <div class="counter-capture-grid">
                            <div>
                                <label for="modalContador" class="form-label fw-bold">Contador actual</label>
                                <input type="number" min="0" step="1" value="" placeholder="Ej. 12850" name="ContadorMaquinaActual" id="modalContador" class="counter-value-input empty-number" inputmode="numeric" autocomplete="off" />
                            </div>
                            <div class="counter-reference">
                                <div class="k">Último contador registrado</div>
                                <div class="v">@(ultimoContador.HasValue? ultimoContador.Value.ToString("N0") : "Sin lectura previa")</div>
                                <div class="small text-muted mt-1">@(cicloEnUso.HasValue ? $"Ciclo vigente: {cicloEnUso.Value:0.##} s" : "El servidor tomará la configuración técnica vigente")</div>
                            </div>
                        </div>
                        <div class="counter-feedback" id="modalContadorFeedback">Captura el contador. El servidor hará el cálculo real considerando contador base, cavidades, paros y cambios de configuración.</div>
                    </div>

                    <div id="mensajeCapturaHora" class="alert alert-danger rounded-4 fw-bold d-none mb-3" role="alert"></div>

                    <div class="physical-summary" id="resumenFisicoHora">
                        <div class="physical-card"><div class="k">Producción física</div><div class="v" id="modalPiezasFisicas">-</div></div>
                        <div class="physical-card"><div class="k">OK sugerido</div><div class="v text-success" id="modalOKSugerido">-</div></div>
                        <div class="physical-card"><div class="k">Min. productivos</div><div class="v" id="modalMinutosProductivos">-</div></div>
                        <div class="physical-card"><div class="k">Segmentos</div><div class="v" id="modalSegmentos">-</div></div>
                    </div>

                    <div class="modal-grid mb-3">
                        <div class="ok-capture-wrap">
                            <div class="modal-label text-success">OK</div>
                            <input type="number" min="0" value="" placeholder="Auto" name="CantidadOK" id="modalOK" class="modal-qty ok empty-number" inputmode="numeric" autocomplete="off" />
                            <div class="ok-mode-row">
                                <span class="ok-mode-badge" id="modalOKModo"><i class="fa-solid fa-wand-magic-sparkles"></i>Automático</span>
                                <button type="button" class="btn-ok-auto d-none" id="btnRestaurarOKAutomatico"><i class="fa-solid fa-rotate-left me-1"></i>Usar cálculo automático</button>
                            </div>
                        </div>
                        <div><div class="modal-label text-warning">Sospechosos</div><input type="number" min="0" value="0" placeholder="0" name="CantidadSospechosa" id="modalYellow" class="modal-qty yellow empty-number" inputmode="numeric" autocomplete="off" /></div>
                        <div><div class="modal-label text-danger">Scrap</div><input type="number" min="0" value="0" placeholder="0" name="CantidadScrap" id="modalScrap" class="modal-qty scrap empty-number" inputmode="numeric" autocomplete="off" /></div>
                    </div>

                    <div class="classification-feedback" id="modalClasificacionFeedback"><i class="fa-solid fa-circle-info me-1"></i>El OK se propondrá automáticamente como producción física menos Sospechosos y Scrap. Si el operador necesita corregirlo, puede borrar el valor y capturar otro.</div>

                    <label class="form-label fw-bold mt-3">Observaciones</label><textarea name="Observaciones" id="modalObs" class="form-control" rows="3" maxlength="500" placeholder="Opcional. Recomendado cuando se modifica manualmente el OK o existe una diferencia contra el contador."></textarea>
                    <div class="alert alert-warning mt-3 mb-0"><i class="fa-solid fa-circle-info me-1"></i><strong>Ayuda automática:</strong> el ERP propone el OK para reducir captura. <strong>El campo OK sigue editable</strong>; si el operador lo modifica, la pantalla marcará la diferencia contra la producción física antes de guardar.</div>
                </div>
                <div class="modal-footer border-0 px-4 pb-4"><button type="submit" class="btn btn-primary w-100"><i class="fa-solid fa-floppy-disk me-1"></i>Guardar Hora</button></div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        document.addEventListener('DOMContentLoaded',function(){
            const modalElement=document.getElementById('modalCapturaHora');
            const modal=modalElement?bootstrap.Modal.getOrCreateInstance(modalElement):null;
            const form=document.getElementById('formModalHora');
            const urlPrevisualizar='@Url.Action("PrevisualizarProduccionHora","ProduccionOperador")';
            const capturaHabilitada=@capturaHabilitada.ToString().ToLowerInvariant();
            const tieneParoAbierto=@Model.TieneParoAbierto.ToString().ToLowerInvariant();
            const tieneTiempoExtraActivo=@tieneTiempoExtraActivo.ToString().ToLowerInvariant();
            const ejecucionEnProduccion=@(Model.EstatusID == ERP.NSQuell.Models.ProduccionEstatus.EnProduccion ? "true" : "false");
            const formIniciarTiempoExtra=document.getElementById('formIniciarTiempoExtra');
            let filaActiva=null;
            let okManual=false;
            let actualizandoOKAutomatico=false;
            let previewTimer=null;
            let previewSecuencia=0;
            let ultimaPrevisualizacion=null;

            function numeroSeguro(input){
                const raw=(input?.value||'').trim();
                if(raw==='')return 0;
                const numero=Number(raw);
                return Number.isFinite(numero)?numero:0;
            }

            function limpiarPrevisualizacion(){
                ultimaPrevisualizacion=null;
                document.getElementById('modalPiezasFisicas').textContent='-';
                document.getElementById('modalOKSugerido').textContent='-';
                document.getElementById('modalMinutosProductivos').textContent='-';
                document.getElementById('modalSegmentos').textContent='-';
            }

            function cambiarModoOK(manual){
                okManual=manual;
                const badge=document.getElementById('modalOKModo');
                const boton=document.getElementById('btnRestaurarOKAutomatico');
                if(badge){
                    badge.classList.toggle('manual',manual);
                    badge.innerHTML=manual
                        ?'<i class="fa-solid fa-pen"></i>Manual'
                        :'<i class="fa-solid fa-wand-magic-sparkles"></i>Automático';
                }
                boton?.classList.toggle('d-none',!manual);
            }

            function establecerOKAutomatico(valor){
                const input=document.getElementById('modalOK');
                if(!input)return;
                actualizandoOKAutomatico=true;
                input.value=Number(valor||0).toString();
                actualizandoOKAutomatico=false;
                if(filaActiva){
                    const campo=filaActiva.querySelector('[data-field="ok"]');
                    if(campo)campo.value=input.value;
                }
            }

            function actualizarComparacionObjetivo(){
                const input=document.getElementById('modalOK');
                const feedback=document.getElementById('modalObjetivoFeedback');
                if(!input||!feedback)return;
                const objetivo=Number(input.dataset.objetivo||0);
                const valorRaw=(input.value||'').trim();
                if(objetivo<=0){
                    feedback.className='modal-goal-feedback text-muted';
                    feedback.innerHTML='<i class="fa-solid fa-circle-info me-1"></i>Esta parte no tiene objetivo configurado para este bloque.';
                    return;
                }
                if(valorRaw===''){
                    feedback.className='modal-goal-feedback text-muted';
                    feedback.textContent='El OK se propondrá automáticamente después de calcular la producción física.';
                    return;
                }
                const ok=Number(valorRaw||0);
                const diferencia=ok-objetivo;
                const porcentaje=Math.round((ok/objetivo)*1000)/10;
                if(diferencia>0){
                    feedback.className='modal-goal-feedback text-success';
                    feedback.innerHTML='<i class="fa-solid fa-circle-check me-1"></i>Alcanzaste el objetivo: <strong>'+porcentaje.toLocaleString('es-MX')+'%</strong>. Lo superaste por '+diferencia.toLocaleString('es-MX')+' pieza(s).';
                    return;
                }
                if(diferencia===0){
                    feedback.className='modal-goal-feedback text-success';
                    feedback.innerHTML='<i class="fa-solid fa-circle-check me-1"></i>Alcanzaste exactamente el objetivo: <strong>100%</strong>.';
                    return;
                }
                feedback.className='modal-goal-feedback text-danger';
                feedback.innerHTML='<i class="fa-solid fa-circle-xmark me-1"></i>No alcanzaste el objetivo: <strong>'+porcentaje.toLocaleString('es-MX')+'%</strong>. Faltaron '+Math.abs(diferencia).toLocaleString('es-MX')+' pieza(s).';
            }

            function actualizarClasificacion(){
                const feedback=document.getElementById('modalClasificacionFeedback');
                if(!feedback)return;
                const ok=numeroSeguro(document.getElementById('modalOK'));
                const yellow=numeroSeguro(document.getElementById('modalYellow'));
                const scrap=numeroSeguro(document.getElementById('modalScrap'));
                const total=ok+yellow+scrap;
                if(!ultimaPrevisualizacion){
                    feedback.className='classification-feedback';
                    feedback.innerHTML='<i class="fa-solid fa-circle-info me-1"></i>Clasificación actual: <strong>'+total.toLocaleString('es-MX')+'</strong> pieza(s). Captura el contador para obtener la producción física real.';
                    return;
                }
                const fisicas=Number(ultimaPrevisualizacion.piezasFisicas??ultimaPrevisualizacion.PiezasFisicas??0);
                const diferencia=total-fisicas;
                if(diferencia===0){
                    feedback.className='classification-feedback ok';
                    feedback.innerHTML='<i class="fa-solid fa-circle-check me-1"></i>La clasificación cuadra con las <strong>'+fisicas.toLocaleString('es-MX')+'</strong> piezas físicas. OK '+ok.toLocaleString('es-MX')+' + Sospechosos '+yellow.toLocaleString('es-MX')+' + Scrap '+scrap.toLocaleString('es-MX')+'.';
                    return;
                }
                feedback.className='classification-feedback warning';
                const textoDiferencia=diferencia>0
                    ?'La clasificación excede la producción física por <strong>'+Math.abs(diferencia).toLocaleString('es-MX')+'</strong> pieza(s).'
                    :'Faltan por clasificar <strong>'+Math.abs(diferencia).toLocaleString('es-MX')+'</strong> pieza(s) contra el contador.';
                feedback.innerHTML='<i class="fa-solid fa-triangle-exclamation me-1"></i>'+textoDiferencia+(okManual?' <strong>El OK está en modo manual.</strong>':'');
            }

            function pintarPrevisualizacion(data,forzarAuto){
                ultimaPrevisualizacion=data;
                const fisicas=Number(data.piezasFisicas??data.PiezasFisicas??0);
                const sugerido=Number(data.cantidadOK??data.CantidadOK??0);
                const minutos=Number(data.minutosProductivos??data.MinutosProductivos??0);
                const segmentos=Number(data.numeroSegmentos??data.NumeroSegmentos??0);
                document.getElementById('modalPiezasFisicas').textContent=fisicas.toLocaleString('es-MX');
                document.getElementById('modalOKSugerido').textContent=sugerido.toLocaleString('es-MX');
                document.getElementById('modalMinutosProductivos').textContent=minutos.toLocaleString('es-MX',{maximumFractionDigits:2});
                document.getElementById('modalSegmentos').textContent=segmentos.toLocaleString('es-MX');
                if(!okManual||forzarAuto){
                    cambiarModoOK(false);
                    establecerOKAutomatico(sugerido);
                }
                const contadorInicial=data.contadorInicial??data.ContadorInicial;
                const contadorFinal=data.contadorFinal??data.ContadorFinal;
                const feedback=document.getElementById('modalContadorFeedback');
                if(feedback){
                    let texto='<i class="fa-solid fa-calculator me-1"></i>Producción física calculada por el servidor: <strong>'+fisicas.toLocaleString('es-MX')+' pieza(s)</strong>.';
                    if(contadorInicial!==null&&contadorInicial!==undefined&&contadorFinal!==null&&contadorFinal!==undefined)texto+=' Contador '+Number(contadorInicial).toLocaleString('es-MX')+' → '+Number(contadorFinal).toLocaleString('es-MX')+'.';
                    if(Boolean(data.tieneCambioConfiguracion??data.TieneCambioConfiguracion))texto+=' <span class="text-primary">Se consideraron cambios de configuración.</span>';
                    if(Boolean(data.tieneReinicioContador??data.TieneReinicioContador))texto+=' <span class="text-warning">Se detectó reinicio del contador.</span>';
                    feedback.className='counter-feedback';
                    feedback.innerHTML=texto;
                }
                actualizarComparacionObjetivo();
                actualizarClasificacion();
            }

            async function ejecutarPrevisualizacion(forzarAuto=false){
                const contadorInput=document.getElementById('modalContador');
                const raw=(contadorInput?.value||'').trim();
                if(raw===''||!Number.isFinite(Number(raw))||Number(raw)<0){
                    limpiarPrevisualizacion();
                    const feedback=document.getElementById('modalContadorFeedback');
                    if(feedback){
                        feedback.className='counter-feedback';
                        feedback.innerHTML='<i class="fa-solid fa-circle-info me-1"></i>Captura un contador válido para calcular automáticamente la producción física y el OK sugerido.';
                    }
                    actualizarClasificacion();
                    return;
                }
                if(!form)return;
                const secuencia=++previewSecuencia;
                const card=document.getElementById('resumenFisicoHora');
                card?.classList.add('preview-loading');
                const token=form.querySelector('input[name="__RequestVerificationToken"]')?.value||'';
                const datos=new FormData();
                datos.append('__RequestVerificationToken',token);
                datos.append('ejecucionProduccionId','@Model.EjecucionProduccionID');
                datos.append('fechaProduccion',document.getElementById('modalFecha')?.value||'');
                datos.append('horaInicio',document.getElementById('modalInicio')?.value||'');
                datos.append('horaFin',document.getElementById('modalFin')?.value||'');
                datos.append('contadorMaquinaActual',raw);
                datos.append('cantidadSospechosa',String(numeroSeguro(document.getElementById('modalYellow'))));
                datos.append('cantidadScrap',String(numeroSeguro(document.getElementById('modalScrap'))));
                try{
                    const response=await fetch(urlPrevisualizar,{method:'POST',body:datos,headers:{'X-Requested-With':'XMLHttpRequest'}});
                    let data=null;
                    try{data=await response.json();}catch{data=null;}
                    if(secuencia!==previewSecuencia)return;
                    if(!response.ok||!data||data.ok===false){
                        ultimaPrevisualizacion=null;
                        const mensaje=data?.mensaje||data?.Mensaje||'No fue posible calcular la producción del bloque.';
                        const feedback=document.getElementById('modalContadorFeedback');
                        if(feedback){feedback.className='counter-feedback text-danger';feedback.innerHTML='<i class="fa-solid fa-triangle-exclamation me-1"></i>'+mensaje;}
                        limpiarPrevisualizacion();
                        actualizarClasificacion();
                        return;
                    }
                    pintarPrevisualizacion(data,forzarAuto);
                }catch(error){
                    if(secuencia!==previewSecuencia)return;
                    ultimaPrevisualizacion=null;
                    limpiarPrevisualizacion();
                    const feedback=document.getElementById('modalContadorFeedback');
                    if(feedback){feedback.className='counter-feedback text-danger';feedback.innerHTML='<i class="fa-solid fa-triangle-exclamation me-1"></i>'+(error?.message||'No fue posible consultar el cálculo automático.');}
                    actualizarClasificacion();
                }finally{
                    if(secuencia===previewSecuencia)card?.classList.remove('preview-loading');
                }
            }

            function programarPrevisualizacion(forzarAuto=false){
                if(previewTimer)window.clearTimeout(previewTimer);
                previewTimer=window.setTimeout(function(){ejecutarPrevisualizacion(forzarAuto);},300);
            }

            function cargarFila(row){
                if(!row||!form)return;
                filaActiva=row;
                cambiarModoOK(false);
                limpiarPrevisualizacion();
                limpiarMensajeCaptura();
                document.getElementById('modalFecha').value=row.dataset.fecha||'';
                document.getElementById('modalInicio').value=row.dataset.inicio||'';
                document.getElementById('modalFin').value=row.dataset.fin||'';
                document.getElementById('modalTituloHora').textContent='Hora '+(row.dataset.numero||'');
                document.getElementById('modalRangoHora').textContent=(row.dataset.inicio||'')+' - '+(row.dataset.fin||'');
                document.getElementById('modalObjetivo').textContent=Number(row.dataset.objetivo||0)>0?Number(row.dataset.objetivo).toLocaleString('es-MX'):'-';
                document.getElementById('modalOK').dataset.objetivo=row.dataset.objetivo||'0';
                document.getElementById('modalContador').value=row.querySelector('[data-field="counter"]')?.value||'';
                document.getElementById('modalOK').value=row.querySelector('[data-field="ok"]')?.value||'';
                document.getElementById('modalYellow').value=row.querySelector('[data-field="yellow"]')?.value||'0';
                document.getElementById('modalScrap').value=row.querySelector('[data-field="scrap"]')?.value||'0';
                document.getElementById('modalObs').value=row.querySelector('[data-field="obs"]')?.value||'';
                actualizarComparacionObjetivo();
                actualizarClasificacion();
                if((document.getElementById('modalContador').value||'').trim()!=='')programarPrevisualizacion(true);
            }

            document.getElementById('modalContador')?.addEventListener('input',function(){
                if(filaActiva){const campo=filaActiva.querySelector('[data-field="counter"]');if(campo)campo.value=this.value;}
                programarPrevisualizacion(false);
            });

            ['modalYellow','modalScrap'].forEach(function(id){
                document.getElementById(id)?.addEventListener('input',function(){
                    if(filaActiva){
                        const selector=id==='modalYellow'?'[data-field="yellow"]':'[data-field="scrap"]';
                        const campo=filaActiva.querySelector(selector);
                        if(campo)campo.value=this.value;
                    }
                    actualizarClasificacion();
                    programarPrevisualizacion(false);
                });
            });

            document.getElementById('modalOK')?.addEventListener('input',function(){
                if(!actualizandoOKAutomatico)cambiarModoOK(true);
                if(filaActiva){const campo=filaActiva.querySelector('[data-field="ok"]');if(campo)campo.value=this.value;}
                actualizarComparacionObjetivo();
                actualizarClasificacion();
            });

            document.getElementById('modalObs')?.addEventListener('input',function(){
                if(filaActiva){const campo=filaActiva.querySelector('[data-field="obs"]');if(campo)campo.value=this.value;}
            });

            document.getElementById('btnRestaurarOKAutomatico')?.addEventListener('click',function(){
                cambiarModoOK(false);
                if(ultimaPrevisualizacion){
                    const sugerido=Number(ultimaPrevisualizacion.cantidadOK??ultimaPrevisualizacion.CantidadOK??0);
                    establecerOKAutomatico(sugerido);
                    actualizarComparacionObjetivo();
                    actualizarClasificacion();
                }else{
                    programarPrevisualizacion(true);
                }
            });

            document.querySelectorAll('.btn-open-hour').forEach(btn=>btn.addEventListener('click',function(){
                if(!capturaHabilitada||tieneParoAbierto)return;
                const row=this.closest('[data-hour-row]');
                cargarFila(row);
                modal?.show();
            }));

            function mostrarMensajeCaptura(mensaje){
