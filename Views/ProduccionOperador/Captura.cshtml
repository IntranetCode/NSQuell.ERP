                <div class="modal-body p-4">
                    <div class="alert alert-primary rounded-4 fw-semibold"><i class="fa-solid fa-circle-info me-1"></i>El ERP tomará automáticamente la última lectura del contador como base. No necesitas reiniciar físicamente el contador de la máquina.</div>
                    <div class="extra-start-summary">
                        <div class="extra-start-card"><div class="k">Contador base</div><div class="v">@(ultimoContador.HasValue ? ultimoContador.Value.ToString("N0") : "-")</div></div>
                        <div class="extra-start-card"><div class="k">Cavidades</div><div class="v">@(cavidadesEnUso.HasValue ? cavidadesEnUso.Value.ToString("N0") : "-")</div></div>
                        <div class="extra-start-card"><div class="k">Ciclo</div><div class="v">@(cicloEnUso.HasValue ? $"{cicloEnUso.Value:0.##} s" : "-")</div></div>
                    </div>
                    <div id="mensajeTiempoExtra" class="alert alert-danger rounded-4 fw-bold d-none" role="alert"></div>
                    <div class="mb-3">
                        <label for="motivoTiempoExtra" class="form-label fw-bold">Motivo del tiempo extra</label>
                        <select class="form-select form-select-lg" name="Motivo" id="motivoTiempoExtra" required>
                            <option value="@ERP.NSQuell.Models.ProduccionTiempoExtraMotivo.CompletarOF">Completar OF</option>
                            <option value="@ERP.NSQuell.Models.ProduccionTiempoExtraMotivo.RecuperarAtraso">Recuperar atraso</option>
                            <option value="@ERP.NSQuell.Models.ProduccionTiempoExtraMotivo.ProduccionAdicionalAutorizada">Producción adicional autorizada</option>
                            <option value="@ERP.NSQuell.Models.ProduccionTiempoExtraMotivo.AjusteProceso">Ajuste de proceso</option>
                            <option value="@ERP.NSQuell.Models.ProduccionTiempoExtraMotivo.Otro">Otro</option>
                        </select>
                    </div>
                    <div class="mb-0">
                        <label for="observacionesTiempoExtra" class="form-label fw-bold">Observaciones</label>
                        <textarea class="form-control" rows="4" maxlength="500" name="Observaciones" id="observacionesTiempoExtra" placeholder="Opcional. Si eliges Otro, explica el motivo."></textarea>
                    </div>
                </div>
                <div class="modal-footer border-0 px-4 pb-4">
                    <button type="button" class="btn btn-light fw-bold" data-bs-dismiss="modal">Cancelar</button>
                    <button type="submit" class="btn btn-primary fw-bold" id="btnConfirmarTiempoExtra"><i class="fa-solid fa-play me-1"></i>Iniciar cronómetro</button>
                </div>
            </form>
        </div>
    </div>
</div>

@if (tieneTiempoExtraActivo && tiempoExtraActivo != null)
{
    <div class="modal fade modal-extra" id="modalCorteTiempoExtra" tabindex="-1" aria-hidden="true" data-bs-backdrop="static" data-bs-keyboard="false">
        <div class="modal-dialog modal-dialog-centered modal-lg">
            <div class="modal-content">
                <div class="modal-header">
                    <div>
                        <h5 class="modal-title mb-1" id="tituloModalCorteTiempoExtra"><i class="fa-solid fa-stopwatch me-2"></i>Capturar corte de tiempo extra</h5>
                        <div class="small opacity-75 fw-semibold" id="subtituloModalCorteTiempoExtra">Registra la lectura actual para cerrar el bloque.</div>
                    </div>
                    <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Cerrar"></button>
                </div>
                <form method="post" action="@Url.Action("CapturarCorteTiempoExtra","ProduccionOperador")" id="formCorteTiempoExtra">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="TiempoExtraID" value="@tiempoExtraActivo.TiempoExtraID" />
                    <input type="hidden" name="EjecucionProduccionID" value="@Model.EjecucionProduccionID" />
                    <input type="hidden" name="OkModificadoManual" id="extraOkModificadoManual" value="false" />
                    <input type="hidden" name="FinalizarTiempoExtra" id="extraFinalizarTiempoExtra" value="false" />
                    <div class="modal-body p-4">
                        <div class="extra-mode-help mb-3" id="extraModoAyuda"><i class="fa-solid fa-circle-info me-1"></i>Este corte se guarda y el siguiente bloque de tiempo extra comienza automáticamente desde la lectura que captures.</div>
                        <div id="mensajeCorteTiempoExtra" class="alert alert-danger rounded-4 fw-bold d-none mb-3" role="alert"></div>
                        <div class="counter-capture-card">
                            <div class="d-flex justify-content-between align-items-start flex-wrap gap-2 mb-3">
                                <div>
                                    <div class="fw-bold text-primary"><i class="fa-solid fa-gauge-high me-1"></i>Contador de máquina</div>
                                    <div class="small text-muted fw-semibold">Captura la lectura física actual. El servidor calculará las piezas desde el último corte.</div>
                                </div>
                                <span class="badge bg-primary">Sesión #@tiempoExtraActivo.TiempoExtraID</span>
                            </div>
                            <div class="counter-capture-grid">
                                <div>
                                    <label for="extraContador" class="form-label fw-bold">Contador actual</label>
                                    <input type="number" min="0" step="1" value="" placeholder="Ej. 12850" name="ContadorMaquinaActual" id="extraContador" class="counter-value-input empty-number" inputmode="numeric" autocomplete="off" />
                                </div>
                                <div class="counter-reference">
                                    <div class="k">Último contador del corte</div>
                                    <div class="v">@tiempoExtraActivo.ContadorUltimoCorte.ToString("N0")</div>
                                    <div class="small text-muted mt-1">Último corte: @tiempoExtraActivo.FechaHoraUltimoCorte.ToString("dd/MM/yyyy HH:mm")</div>
                                </div>
                            </div>
                            <div class="counter-feedback" id="extraContadorFeedback">Captura el contador actual para obtener producción física, objetivo proporcional y OK sugerido.</div>
                        </div>
                        <div class="extra-meta-grid mb-3" id="extraResumenPreview">
                            <div class="extra-meta-card"><div class="k">Producción física</div><div class="v" id="extraPiezasFisicas">-</div></div>
                            <div class="extra-meta-card"><div class="k">OK sugerido</div><div class="v text-success" id="extraOKSugerido">-</div></div>
                            <div class="extra-meta-card"><div class="k">Objetivo bloque</div><div class="v" id="extraObjetivoBloque">-</div></div>
                            <div class="extra-meta-card"><div class="k">Cumplimiento</div><div class="v" id="extraCumplimiento">-</div></div>
                            <div class="extra-meta-card"><div class="k">Bonus provisional</div><div class="v text-success" id="extraBonusInicial">-</div></div>
                        </div>
                        <div class="modal-grid mb-3">
                            <div class="ok-capture-wrap">
                                <div class="modal-label text-success">OK</div>
                                <input type="number" min="0" value="" placeholder="Auto" name="CantidadOK" id="extraOK" class="modal-qty ok empty-number" inputmode="numeric" autocomplete="off" />
                                <div class="ok-mode-row">
                                    <span class="ok-mode-badge" id="extraOKModo"><i class="fa-solid fa-wand-magic-sparkles"></i>Automático</span>
                                    <button type="button" class="btn-ok-auto d-none" id="btnRestaurarOKAutomaticoExtra"><i class="fa-solid fa-rotate-left me-1"></i>Usar cálculo automático</button>
                                </div>
                            </div>
                            <div><div class="modal-label text-warning">Sospechosos</div><input type="number" min="0" value="0" placeholder="0" name="CantidadSospechosa" id="extraYellow" class="modal-qty yellow empty-number" inputmode="numeric" autocomplete="off" /></div>
                            <div><div class="modal-label text-danger">Scrap</div><input type="number" min="0" value="0" placeholder="0" name="CantidadScrap" id="extraScrap" class="modal-qty scrap empty-number" inputmode="numeric" autocomplete="off" /></div>
                        </div>
                        <div class="classification-feedback" id="extraClasificacionFeedback"><i class="fa-solid fa-circle-info me-1"></i>El ERP propondrá el OK como producción física menos Sospechosos y Scrap. Puedes ajustar el OK manualmente si existe una diferencia real y dejar la explicación en observaciones.</div>
                        <label class="form-label fw-bold mt-3" for="extraObservaciones">Observaciones</label>
                        <textarea name="Observaciones" id="extraObservaciones" class="form-control" rows="3" maxlength="500" placeholder="Opcional. Obligatorio si modificas el OK y la clasificación ya no coincide con la producción física, o si el contador no registra producción."></textarea>
                    </div>
                    <div class="modal-footer border-0 px-4 pb-4">
                        <button type="button" class="btn btn-light fw-bold" data-bs-dismiss="modal">Cancelar</button>
                        <button type="submit" class="btn btn-primary fw-bold" id="btnConfirmarCorteTiempoExtra" disabled><i class="fa-solid fa-floppy-disk me-1"></i>Guardar corte</button>
                    </div>
                </form>
            </div>
        </div>
    </div>
}

<div class="modal fade modal-turn" id="modalCambioTurno" tabindex="-1" aria-hidden="true" data-bs-backdrop="static" data-bs-keyboard="false">
