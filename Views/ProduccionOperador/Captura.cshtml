        function obtenerOperadoresResumen(resumen){
            const lista=propiedad(resumen,'operadores','Operadores');
            return Array.isArray(lista)?lista:[];
        }
        function obtenerOperadorPorId(personaId){
            if(!resumenCambioTurno)return null;
            return obtenerOperadoresResumen(resumenCambioTurno).find(function(x){
                return Number(propiedad(x,'personaID','PersonaID'))===Number(personaId);
            })||null;
        }
        function pintarOperadorSeleccionado(){
            const box=document.getElementById('turnInfoSeleccionado');
            const nombre=document.getElementById('turnSeleccionadoNombre');
            const detalle=document.getElementById('turnSeleccionadoDetalle');
            if(!selectOperadorEntrante||!box||!nombre||!detalle)return;
            const personaId=Number(selectOperadorEntrante.value||0);
            const operador=obtenerOperadorPorId(personaId);
            if(!operador){
                box.classList.add('d-none');
                nombre.textContent='-';
                detalle.textContent='';
                return;
            }
            const nivel=propiedad(operador,'nivel','Nivel');
            const turno=propiedad(operador,'turnoNombre','TurnoNombre');
            const enEscala=Boolean(propiedad(operador,'enEscala','EnEscala'));
            const sugeridoPorTecnico=Boolean(propiedad(resumenCambioTurno,'sugeridoPorTecnico','SugeridoPorTecnico'));
            const operadorSugeridoId=Number(propiedad(resumenCambioTurno,'operadorSugeridoID','OperadorSugeridoID')||0);
            nombre.textContent=textoSeguro(propiedad(operador,'nombre','Nombre'));
            const partes=[];
            if(nivel!==null&&nivel!==undefined)partes.push('Nivel N'+nivel);
            if(turno)partes.push('Turno '+turno);
            if(sugeridoPorTecnico&&operadorSugeridoId===personaId){
                partes.push('Sugerido por técnico');
            }else{
                partes.push(enEscala?'Programado en escala':'Selección manual autorizada');
            }
            detalle.textContent=partes.join(' · ');
            box.classList.remove('d-none');
        }
        function evaluarBotonCambioTurno(){
            if(!btnConfirmarCambioTurno||!selectOperadorEntrante||!resumenCambioTurno)return;
            const puedeEntregar=Boolean(propiedad(resumenCambioTurno,'puedeEntregar','PuedeEntregar'));
            const operadorSeleccionado=Number(selectOperadorEntrante.value||0)>0;
            btnConfirmarCambioTurno.disabled=!puedeEntregar||!operadorSeleccionado;
        }
        function llenarResumenCambioTurno(resumen){
            resumenCambioTurno=resumen;
            const maquinaCodigo=propiedad(resumen,'maquinaCodigo','MaquinaCodigo');
            const maquinaNombre=propiedad(resumen,'maquinaNombre','MaquinaNombre');
            const maquina=[maquinaCodigo,maquinaNombre].filter(x=>x&&String(x).trim()!=='').join(' - ');
            document.getElementById('turnMaquina').textContent=textoSeguro(maquina);
            document.getElementById('turnParte').textContent=textoSeguro(propiedad(resumen,'referenciaSAP','ReferenciaSAP')||propiedad(resumen,'numeroParte','NumeroParte'));
            document.getElementById('turnUltimaHora').textContent=textoSeguro(propiedad(resumen,'ultimaHoraTexto','UltimaHoraTexto'),'Sin captura registrada');
            document.getElementById('turnOperadorSaliente').textContent=textoSeguro(propiedad(resumen,'operadorSalienteNombre','OperadorSalienteNombre'));
            document.getElementById('turnCantidadOK').textContent=numeroCambioTurno(propiedad(resumen,'cantidadOK','CantidadOK'));
            document.getElementById('turnCantidadSospechosa').textContent=numeroCambioTurno(propiedad(resumen,'cantidadSospechosa','CantidadSospechosa'));
            document.getElementById('turnCantidadScrap').textContent=numeroCambioTurno(propiedad(resumen,'cantidadScrap','CantidadScrap'));
            document.getElementById('turnTotalCajas').textContent=numeroCambioTurno(propiedad(resumen,'totalCajas','TotalCajas'));
            document.getElementById('turnCajasEntregadas').textContent=numeroCambioTurno(propiedad(resumen,'totalCajasEntregadas','TotalCajasEntregadas'));
            const cajasPendientes=Number(propiedad(resumen,'totalCajasPendientes','TotalCajasPendientes')||0);
            document.getElementById('turnCajasPendientes').textContent=numeroCambioTurno(cajasPendientes);
            const badgePendientes=document.getElementById('badgeCajasPendientes');
            if(badgePendientes){
                badgePendientes.className=cajasPendientes>0?'danger':'ok';
                badgePendientes.innerHTML=cajasPendientes>0
                    ?'<i class="fa-solid fa-triangle-exclamation me-1"></i>Pendientes: <strong>'+numeroCambioTurno(cajasPendientes)+'</strong>'
                    :'<i class="fa-solid fa-circle-check me-1"></i>Pendientes: <strong>0</strong>';
            }
            const puedeEntregar=Boolean(propiedad(resumen,'puedeEntregar','PuedeEntregar'));
            const motivoBloqueo=propiedad(resumen,'motivoBloqueo','MotivoBloqueo');
            const validacion=document.getElementById('turnValidacionEntrega');
            if(validacion){
                if(puedeEntregar){
                    validacion.className='turn-validation ok';
                    validacion.innerHTML='<i class="fa-solid fa-circle-check me-1"></i>La producción está lista para entregar el turno.';
                }else{
                    validacion.className='turn-validation error';
                    validacion.innerHTML='<i class="fa-solid fa-triangle-exclamation me-1"></i>'+textoSeguro(motivoBloqueo,'El turno no puede entregarse en este momento.');
                }
            }
            const operadorSugeridoId=propiedad(resumen,'operadorSugeridoID','OperadorSugeridoID');
            const operadorSugeridoNombre=propiedad(resumen,'operadorSugeridoNombre','OperadorSugeridoNombre');
            const turnoSugeridoNombre=propiedad(resumen,'turnoSugeridoNombre','TurnoSugeridoNombre');
            const escalaEncontrada=Boolean(propiedad(resumen,'escalaEncontrada','EscalaEncontrada'));
            const escalaFolio=propiedad(resumen,'escalaFolio','EscalaFolio');
            const sugeridoPorTecnico=Boolean(propiedad(resumen,'sugeridoPorTecnico','SugeridoPorTecnico'));
            const tecnicoNombre=propiedad(resumen,'tecnicoSugerenciaNombre','TecnicoSugerenciaNombre');
            const fechaSugerenciaTecnico=propiedad(resumen,'fechaSugerenciaTecnico','FechaSugerenciaTecnico');
            const observacionesSugerenciaTecnico=propiedad(resumen,'observacionesSugerenciaTecnico','ObservacionesSugerenciaTecnico');
            const sugeridoBox=document.getElementById('turnSugeridoBox');
            const sugeridoLabel=document.getElementById('turnSugeridoLabel');
            const sugeridoIcono=document.getElementById('turnSugeridoIcono');
            const tecnicoMeta=document.getElementById('turnTecnicoMeta');
            const tecnicoObservacion=document.getElementById('turnTecnicoObservacion');
            if(operadorSugeridoId&&sugeridoBox){
                document.getElementById('turnOperadorSugerido').textContent=textoSeguro(operadorSugeridoNombre);
                sugeridoBox.classList.toggle('technician',sugeridoPorTecnico);
                if(sugeridoLabel)sugeridoLabel.textContent=sugeridoPorTecnico?'Operador sugerido por el técnico':'Operador sugerido según escala';
                if(sugeridoIcono)sugeridoIcono.className=sugeridoPorTecnico?'fa-solid fa-user-gear':'fa-solid fa-calendar-check';
                let detalle=sugeridoPorTecnico?'Sugerencia del técnico':'Según escala';
                if(turnoSugeridoNombre)detalle+=' · Turno '+turnoSugeridoNombre;
                if(!sugeridoPorTecnico&&escalaFolio)detalle+=' · '+escalaFolio;
                document.getElementById('turnSugeridoDetalle').textContent=detalle;
                if(tecnicoMeta){
                    if(sugeridoPorTecnico){
                        let meta='Sugerido por '+textoSeguro(tecnicoNombre,'Técnico de Producción');
                        if(fechaSugerenciaTecnico){
                            const fecha=new Date(fechaSugerenciaTecnico);
                            if(!Number.isNaN(fecha.getTime()))meta+=' · '+fecha.toLocaleString('es-MX',{dateStyle:'short',timeStyle:'short'});
                        }
                        tecnicoMeta.textContent=meta;
                        tecnicoMeta.classList.remove('d-none');
                    }else{
                        tecnicoMeta.textContent='';
                        tecnicoMeta.classList.add('d-none');
                    }
                }
                if(tecnicoObservacion){
                    if(sugeridoPorTecnico&&observacionesSugerenciaTecnico&&String(observacionesSugerenciaTecnico).trim()!==''){
                        tecnicoObservacion.textContent='Observación del técnico: '+String(observacionesSugerenciaTecnico).trim();
                        tecnicoObservacion.classList.remove('d-none');
                    }else{
                        tecnicoObservacion.textContent='';
                        tecnicoObservacion.classList.add('d-none');
                    }
                }
                sugeridoBox.classList.remove('d-none');
            }else if(sugeridoBox){
                sugeridoBox.classList.add('d-none');
                sugeridoBox.classList.remove('technician');
                if(tecnicoMeta){tecnicoMeta.textContent='';tecnicoMeta.classList.add('d-none');}
                if(tecnicoObservacion){tecnicoObservacion.textContent='';tecnicoObservacion.classList.add('d-none');}
            }
            const tieneMatriz=Boolean(propiedad(resumen,'tieneMatrizPolivalencia','TieneMatrizPolivalencia'));
            const ayuda=document.getElementById('turnAyudaOperador');
            if(ayuda){
                if(operadorSugeridoId&&sugeridoPorTecnico){
                    ayuda.textContent='El técnico recomienda a este operador para el cambio de turno. La selección sigue abierta: puedes elegir otro operador autorizado si al momento del relevo cambió la disponibilidad.';
                }else if(operadorSugeridoId){
                    ayuda.textContent='No existe una sugerencia vigente del técnico; el sistema propone al operador de escala más próximo. Puedes seleccionar otro operador autorizado si es necesario.';
                }else if(escalaEncontrada&&tieneMatriz){
                    ayuda.textContent='Existe escala vigente, pero no se encontró un operador válido para sugerir. Selecciona manualmente un operador N1-N4 autorizado para esta parte.';
                }else if(tieneMatriz){
                    ayuda.textContent='No existe una sugerencia vigente. Selecciona manualmente un operador N1-N4 autorizado para esta parte.';
                }else{
                    ayuda.textContent='La parte no tiene matriz de polivalencia configurada. Selecciona un operador activo del catálogo.';
                }
            }
            const operadores=obtenerOperadoresResumen(resumen);
            if(selectOperadorEntrante){
                selectOperadorEntrante.innerHTML='<option value="">Selecciona operador</option>';
                operadores.forEach(function(op){
                    const personaId=propiedad(op,'personaID','PersonaID');
                    const nombre=textoSeguro(propiedad(op,'nombre','Nombre'));
                    const nivel=propiedad(op,'nivel','Nivel');
                    const turno=propiedad(op,'turnoNombre','TurnoNombre');
                    const enEscala=Boolean(propiedad(op,'enEscala','EnEscala'));
                    const option=document.createElement('option');
                    option.value=personaId;
                    let texto=nombre;
                    if(nivel!==null&&nivel!==undefined)texto+=' · N'+nivel;
                    if(turno)texto+=' · '+turno;
                    if(enEscala)texto+=' · ESCALA';
                    option.textContent=texto;
                    option.dataset.escala=enEscala?'true':'false';
                    option.dataset.nivel=nivel??'';
                    selectOperadorEntrante.appendChild(option);
                });
                selectOperadorEntrante.disabled=!puedeEntregar||operadores.length===0;
                if(operadorSugeridoId&&operadores.some(x=>Number(propiedad(x,'personaID','PersonaID'))===Number(operadorSugeridoId))){
                    selectOperadorEntrante.value=String(operadorSugeridoId);
                }
            }
            if(operadores.length===0&&puedeEntregar){
                mostrarErrorCambioTurno('No existen operadores disponibles para recibir el turno. Revisa la escala o la matriz de polivalencia.');
            }
            pintarOperadorSeleccionado();
            evaluarBotonCambioTurno();
        }
        async function cargarCambioTurno(){
            limpiarCambioTurno();
            try{
                const url='@Url.Action("ObtenerResumenCambioTurno", "ProduccionOperador")'+'?ejecucionProduccionId=@Model.EjecucionProduccionID';
                const response=await fetch(url,{
                    method:'GET',
                    headers:{'X-Requested-With':'XMLHttpRequest'}
                });
                let data=null;
                try{
                    data=await response.json();
                }catch{
                    data=null;
                }
                if(!response.ok||!data||data.ok===false){
                    throw new Error(data?.mensaje||'No fue posible consultar la información para entregar el turno.');
                }
                const resumen=data.resumen??data.Resumen;
                if(!resumen)throw new Error('El servidor no devolvió el resumen del cambio de turno.');
                llenarResumenCambioTurno(resumen);
                document.getElementById('cambioTurnoLoading')?.classList.add('d-none');
                document.getElementById('cambioTurnoContenido')?.classList.remove('d-none');
            }catch(error){
                document.getElementById('cambioTurnoLoading')?.classList.add('d-none');
                document.getElementById('cambioTurnoContenido')?.classList.remove('d-none');
                mostrarErrorCambioTurno(error?.message||'No fue posible cargar la entrega de turno.');
            }
        }
        btnAbrirCambioTurno?.addEventListener('click',async function(){
            modalCambioTurno?.show();
            await cargarCambioTurno();
        });
        selectOperadorEntrante?.addEventListener('change',function(){
            pintarOperadorSeleccionado();
            evaluarBotonCambioTurno();
        });
