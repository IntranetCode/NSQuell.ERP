                    const btnAbrirCambioTurno=document.getElementById('btnAbrirCambioTurno');
        const modalCambioTurnoElemento=document.getElementById('modalCambioTurno');
        const modalCambioTurno=modalCambioTurnoElemento?bootstrap.Modal.getOrCreateInstance(modalCambioTurnoElemento):null;
        const formCambioTurno=document.getElementById('formCambioTurno');
        const selectOperadorEntrante=document.getElementById('operadorEntranteID');
        const btnConfirmarCambioTurno=document.getElementById('btnConfirmarCambioTurno');
        let resumenCambioTurno=null;
        function textoSeguro(valor,alternativo='-'){
            if(valor===null||valor===undefined||String(valor).trim()==='')return alternativo;
            return String(valor).trim();
        }
        function numeroCambioTurno(valor){
            const numero=Number(valor||0);
            return Number.isFinite(numero)?numero.toLocaleString('es-MX'):'0';
        }
        function propiedad(obj,...nombres){
            if(!obj)return null;
            for(const nombre of nombres){
                if(Object.prototype.hasOwnProperty.call(obj,nombre))return obj[nombre];
            }
            return null;
        }
        function mostrarErrorCambioTurno(mensaje){
            const box=document.getElementById('mensajeCambioTurno');
