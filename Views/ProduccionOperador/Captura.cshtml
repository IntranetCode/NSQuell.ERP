            }

            function limpiarMensajeCorteExtra(){
                const box=document.getElementById('mensajeCorteTiempoExtra');
                if(!box)return;
                box.classList.add('d-none');
                box.innerHTML='';
            }

            function limpiarPrevisualizacionExtra(){
                ultimaPrevisualizacionExtra=null;
                extraPreviewValida=false;
                const ids=['extraPiezasFisicas','extraOKSugerido','extraObjetivoBloque','extraCumplimiento','extraBonusInicial'];
                ids.forEach(id=>{const el=document.getElementById(id);if(el)el.textContent='-';});
                actualizarBotonConfirmarExtra();
            }

            function cambiarModoOKExtra(manual){
                extraOkManual=manual;
                const hidden=document.getElementById('extraOkModificadoManual');
                if(hidden)hidden.value=manual?'true':'false';
                const badge=document.getElementById('extraOKModo');
                const restaurar=document.getElementById('btnRestaurarOKAutomaticoExtra');
                if(badge){
                    badge.classList.toggle('manual',manual);
                    badge.innerHTML=manual
                        ?'<i class="fa-solid fa-pen"></i>Manual'
                        :'<i class="fa-solid fa-wand-magic-sparkles"></i>Automático';
                }
                restaurar?.classList.toggle('d-none',!manual);
            }

            function establecerOKAutomaticoExtra(valor){
                const input=document.getElementById('extraOK');
                if(!input)return;
                extraActualizandoOK=true;
                input.value=Number(valor||0).toString();
                extraActualizandoOK=false;
            }

            function actualizarComparacionExtra(){
                const ok=numeroSeguro(document.getElementById('extraOK'));
                const bonus=document.getElementById('extraBonusInicial');
                if(bonus)bonus.textContent='+'+Math.max(0,ok).toLocaleString('es-MX');
                const cumplimiento=document.getElementById('extraCumplimiento');
                if(!cumplimiento)return;
                if(!ultimaPrevisualizacionExtra){
                    cumplimiento.textContent='-';
                    cumplimiento.className='v';
                    return;
                }
                const objetivo=Number(ultimaPrevisualizacionExtra.objetivoBloque??ultimaPrevisualizacionExtra.ObjetivoBloque??0);
                if(objetivo<=0){
                    cumplimiento.textContent='-';
                    cumplimiento.className='v';
                    return;
                }
                const porcentaje=Math.round((ok*1000)/objetivo)/10;
                cumplimiento.textContent=porcentaje.toLocaleString('es-MX')+'%';
                cumplimiento.className='v '+(ok>=objetivo?'text-success':'text-danger');
            }

            function actualizarClasificacionExtra(){
                const feedback=document.getElementById('extraClasificacionFeedback');
                if(!feedback)return;
                const ok=numeroSeguro(document.getElementById('extraOK'));
                const sospechoso=numeroSeguro(document.getElementById('extraYellow'));
                const scrap=numeroSeguro(document.getElementById('extraScrap'));
                const total=ok+sospechoso+scrap;
                actualizarComparacionExtra();
                if(!ultimaPrevisualizacionExtra){
                    feedback.className='classification-feedback';
                    feedback.innerHTML='<i class="fa-solid fa-circle-info me-1"></i>Captura el contador para calcular la producción física del periodo.';
                    return;
                }
                const fisicas=Number(ultimaPrevisualizacionExtra.piezasFisicas??ultimaPrevisualizacionExtra.PiezasFisicas??0);
                const diferencia=total-fisicas;
                if(diferencia===0){
                    feedback.className='classification-feedback ok';
                    feedback.innerHTML='<i class="fa-solid fa-circle-check me-1"></i>La clasificación cuadra con las <strong>'+fisicas.toLocaleString('es-MX')+'</strong> piezas físicas. OK '+ok.toLocaleString('es-MX')+' + Sospechosos '+sospechoso.toLocaleString('es-MX')+' + Scrap '+scrap.toLocaleString('es-MX')+'.';
                    return;
                }
                feedback.className='classification-feedback warning';
                const texto=diferencia>0
                    ?'La clasificación excede la producción física por <strong>'+Math.abs(diferencia).toLocaleString('es-MX')+'</strong> pieza(s).'
                    :'Faltan por clasificar <strong>'+Math.abs(diferencia).toLocaleString('es-MX')+'</strong> pieza(s) respecto al contador.';
                feedback.innerHTML='<i class="fa-solid fa-triangle-exclamation me-1"></i>'+texto+(extraOkManual?' <strong>El OK está en modo manual.</strong>':'');
            }

            function pintarPrevisualizacionExtra(data,forzarAutomatico=false){
                ultimaPrevisualizacionExtra=data;
                extraPreviewValida=true;
                const fisicas=Number(data.piezasFisicas??data.PiezasFisicas??0);
                const sugerido=Number(data.cantidadOK??data.CantidadOK??0);
                const objetivo=Number(data.objetivoBloque??data.ObjetivoBloque??0);
                const minutos=Number(data.minutosProductivos??data.MinutosProductivos??0);
                const segmentos=Number(data.numeroSegmentos??data.NumeroSegmentos??0);
                const numeroCorte=Number(data.numeroCorte??data.NumeroCorte??0);
                const pFisicas=document.getElementById('extraPiezasFisicas');
                const pSugerido=document.getElementById('extraOKSugerido');
                const pObjetivo=document.getElementById('extraObjetivoBloque');
                if(pFisicas)pFisicas.textContent=fisicas.toLocaleString('es-MX');
                if(pSugerido)pSugerido.textContent=sugerido.toLocaleString('es-MX');
                if(pObjetivo)pObjetivo.textContent=objetivo>0?objetivo.toLocaleString('es-MX'):'-';
                if(!extraOkManual||forzarAutomatico){
                    cambiarModoOKExtra(false);
                    establecerOKAutomaticoExtra(sugerido);
                }
                const contadorInicial=data.contadorInicial??data.ContadorInicial;
                const contadorFinal=data.contadorFinal??data.ContadorFinal;
                const feedback=document.getElementById('extraContadorFeedback');
                if(feedback){
                    let texto='<i class="fa-solid fa-calculator me-1"></i><strong>'+fisicas.toLocaleString('es-MX')+' pieza(s) físicas</strong> calculadas por el servidor';
                    if(numeroCorte>0)texto+=' para el corte #'+numeroCorte;
                    texto+='. '+minutos.toLocaleString('es-MX',{maximumFractionDigits:2})+' min productivos · '+segmentos.toLocaleString('es-MX')+' segmento(s).';
                    if(contadorInicial!==null&&contadorInicial!==undefined&&contadorFinal!==null&&contadorFinal!==undefined)texto+=' Contador '+Number(contadorInicial).toLocaleString('es-MX')+' → '+Number(contadorFinal).toLocaleString('es-MX')+'.';
                    if(Boolean(data.tieneCambioConfiguracion??data.TieneCambioConfiguracion))texto+=' <span class="text-primary">Se consideraron cambios de configuración.</span>';
                    if(Boolean(data.tieneReinicioContador??data.TieneReinicioContador))texto+=' <span class="text-warning">Se detectó reinicio del contador.</span>';
                    feedback.className='counter-feedback';
                    feedback.innerHTML=texto;
                }
                const servidorDiceDisponible=Boolean(data.corte60Disponible??data.Corte60Disponible);
                if(modoRegistroTiempoExtra==='CORTE'&&!servidorDiceDisponible){
                    extraPreviewValida=false;
                    const segundosFaltantes=Number(data.segundosParaCorte??data.SegundosParaCorte??0);
                    mostrarMensajeCorteExtra('El bloque todavía no cumple 60 minutos. Faltan aproximadamente '+formatoCronometro(segundosFaltantes)+'.');
                }else{
                    limpiarMensajeCorteExtra();
                }
                actualizarClasificacionExtra();
                actualizarBotonConfirmarExtra();
            }

            async function ejecutarPrevisualizacionExtra(forzarAutomatico=false){
                const contadorInput=document.getElementById('extraContador');
                const raw=(contadorInput?.value||'').trim();
                if(raw===''||!Number.isFinite(Number(raw))||Number(raw)<0){
                    limpiarPrevisualizacionExtra();
                    const feedback=document.getElementById('extraContadorFeedback');
                    if(feedback){
                        feedback.className='counter-feedback';
                        feedback.innerHTML='<i class="fa-solid fa-circle-info me-1"></i>Captura un contador válido para calcular la producción de este periodo de tiempo extra.';
                    }
                    actualizarClasificacionExtra();
                    return;
                }
                if(!formCorteTiempoExtra)return;
                const secuencia=++extraPreviewSecuencia;
                extraPreviewValida=false;
                actualizarBotonConfirmarExtra();
                document.getElementById('extraResumenPreview')?.classList.add('preview-loading');
                const token=formCorteTiempoExtra.querySelector('input[name="__RequestVerificationToken"]')?.value||'';
                const tiempoExtraId=formCorteTiempoExtra.querySelector('input[name="TiempoExtraID"]')?.value||'0';
                const datos=new FormData();
                datos.append('__RequestVerificationToken',token);
                datos.append('tiempoExtraId',tiempoExtraId);
                datos.append('contadorMaquinaActual',raw);
                datos.append('cantidadSospechosa',String(numeroSeguro(document.getElementById('extraYellow'))));
                datos.append('cantidadScrap',String(numeroSeguro(document.getElementById('extraScrap'))));
                try{
                    const response=await fetch(urlPrevisualizarCorteTiempoExtra,{method:'POST',body:datos,headers:{'X-Requested-With':'XMLHttpRequest'}});
                    let data=null;
                    try{data=await response.json();}catch{data=null;}
                    if(secuencia!==extraPreviewSecuencia)return;
                    if(!response.ok||!data||data.ok===false){
                        extraPreviewValida=false;
                        ultimaPrevisualizacionExtra=null;
                        const mensaje=data?.mensaje||data?.Mensaje||'No fue posible calcular el corte de tiempo extra.';
                        const feedback=document.getElementById('extraContadorFeedback');
                        if(feedback){feedback.className='counter-feedback text-danger';feedback.innerHTML='<i class="fa-solid fa-triangle-exclamation me-1"></i>'+mensaje;}
                        const ids=['extraPiezasFisicas','extraOKSugerido','extraObjetivoBloque','extraCumplimiento','extraBonusInicial'];
                        ids.forEach(id=>{const el=document.getElementById(id);if(el)el.textContent='-';});
                        mostrarMensajeCorteExtra(mensaje);
                        actualizarClasificacionExtra();
                        actualizarBotonConfirmarExtra();
                        return;
                    }
                    pintarPrevisualizacionExtra(data,forzarAutomatico);
                }catch(error){
                    if(secuencia!==extraPreviewSecuencia)return;
                    extraPreviewValida=false;
                    ultimaPrevisualizacionExtra=null;
                    const mensaje=error?.message||'No fue posible consultar el cálculo del tiempo extra.';
                    const feedback=document.getElementById('extraContadorFeedback');
                    if(feedback){feedback.className='counter-feedback text-danger';feedback.innerHTML='<i class="fa-solid fa-triangle-exclamation me-1"></i>'+mensaje;}
                    mostrarMensajeCorteExtra(mensaje);
                    actualizarClasificacionExtra();
                    actualizarBotonConfirmarExtra();
                }finally{
                    if(secuencia===extraPreviewSecuencia)document.getElementById('extraResumenPreview')?.classList.remove('preview-loading');
                }
            }

            function programarPrevisualizacionExtra(forzarAutomatico=false){
                if(extraPreviewTimer)window.clearTimeout(extraPreviewTimer);
                extraPreviewTimer=window.setTimeout(function(){ejecutarPrevisualizacionExtra(forzarAutomatico);},300);
            }

            function prepararModalTiempoExtra(modo){
                if(!ejecucionEnProduccion||tieneParoAbierto){
                    return;
                }
                if(modo==='CORTE'&&segundosCorteActual<3600){
                    return;
                }
                modoRegistroTiempoExtra=modo;
                limpiarMensajeCorteExtra();
                limpiarPrevisualizacionExtra();
                cambiarModoOKExtra(false);
                const contador=document.getElementById('extraContador');
                const ok=document.getElementById('extraOK');
                const sospechoso=document.getElementById('extraYellow');
                const scrap=document.getElementById('extraScrap');
                const observaciones=document.getElementById('extraObservaciones');
                if(contador)contador.value='';
                if(ok)ok.value='';
                if(sospechoso)sospechoso.value='0';
                if(scrap)scrap.value='0';
                if(observaciones)observaciones.value='';
                const finalizar=document.getElementById('extraFinalizarTiempoExtra');
                if(finalizar)finalizar.value=modo==='FINALIZAR'?'true':'false';
                const titulo=document.getElementById('tituloModalCorteTiempoExtra');
                const subtitulo=document.getElementById('subtituloModalCorteTiempoExtra');
                const ayuda=document.getElementById('extraModoAyuda');
                const boton=document.getElementById('btnConfirmarCorteTiempoExtra');
                if(formCorteTiempoExtra)formCorteTiempoExtra.action=modo==='FINALIZAR'?urlFinalizarTiempoExtra:urlCapturarCorteTiempoExtra;
                if(modo==='FINALIZAR'){
                    if(titulo)titulo.innerHTML='<i class="fa-solid fa-flag-checkered me-2"></i>Finalizar tiempo extra';
                    if(subtitulo)subtitulo.textContent='Se guardará un último corte con el tiempo realmente transcurrido y después se cerrará la sesión.';
                    if(ayuda){
                        ayuda.className='extra-mode-help finish mb-3';
                        ayuda.innerHTML='<i class="fa-solid fa-triangle-exclamation me-1"></i>No necesitas esperar a los 60 minutos para finalizar. El ERP calculará el último bloque parcial hasta la lectura actual del contador.';
                    }
                    if(boton)boton.innerHTML='<i class="fa-solid fa-flag-checkered me-1"></i>Guardar último corte y finalizar';
                }else{
                    if(titulo)titulo.innerHTML='<i class="fa-solid fa-stopwatch me-2"></i>Capturar corte de tiempo extra';
                    if(subtitulo)subtitulo.textContent='Registra la lectura actual para cerrar este bloque y comenzar automáticamente el siguiente.';
                    if(ayuda){
                        ayuda.className='extra-mode-help mb-3';
                        ayuda.innerHTML='<i class="fa-solid fa-circle-info me-1"></i>Este corte se guarda y el siguiente bloque de tiempo extra comienza automáticamente desde la lectura que captures.';
                    }
                    if(boton)boton.innerHTML='<i class="fa-solid fa-floppy-disk me-1"></i>Guardar corte';
                }
                actualizarClasificacionExtra();
                actualizarBotonConfirmarExtra();
                modalCorteTiempoExtra?.show();
                window.setTimeout(()=>document.getElementById('extraContador')?.focus(),250);
            }

            btnCapturarCorteTiempoExtra?.addEventListener('click',function(){
                prepararModalTiempoExtra('CORTE');
            });

            btnFinalizarTiempoExtra?.addEventListener('click',function(){
                prepararModalTiempoExtra('FINALIZAR');
            });

            document.getElementById('extraContador')?.addEventListener('input',function(){
                extraPreviewValida=false;
                actualizarBotonConfirmarExtra();
                programarPrevisualizacionExtra(false);
            });

            ['extraYellow','extraScrap'].forEach(function(id){
                document.getElementById(id)?.addEventListener('input',function(){
                    extraPreviewValida=false;
                    actualizarBotonConfirmarExtra();
                    actualizarClasificacionExtra();
                    programarPrevisualizacionExtra(false);
                });
            });

            document.getElementById('extraOK')?.addEventListener('input',function(){
                if(!extraActualizandoOK)cambiarModoOKExtra(true);
                actualizarClasificacionExtra();
            });

            document.getElementById('btnRestaurarOKAutomaticoExtra')?.addEventListener('click',function(){
                cambiarModoOKExtra(false);
                if(ultimaPrevisualizacionExtra){
                    const sugerido=Number(ultimaPrevisualizacionExtra.cantidadOK??ultimaPrevisualizacionExtra.CantidadOK??0);
                    establecerOKAutomaticoExtra(sugerido);
                    actualizarClasificacionExtra();
                }else{
                    programarPrevisualizacionExtra(true);
                }
            });

            formCorteTiempoExtra?.addEventListener('submit',function(e){
                limpiarMensajeCorteExtra();
                const contadorRaw=(document.getElementById('extraContador')?.value||'').trim();
                const contador=Number(contadorRaw);
                const okRaw=(document.getElementById('extraOK')?.value||'').trim();
                const ok=Number(okRaw||0);
                const sospechoso=numeroSeguro(document.getElementById('extraYellow'));
                const scrap=numeroSeguro(document.getElementById('extraScrap'));
                const observaciones=(document.getElementById('extraObservaciones')?.value||'').trim();

                if(modoRegistroTiempoExtra==='CORTE'&&segundosCorteActual<3600){
                    e.preventDefault();
                    mostrarMensajeCorteExtra('El corte todavía no cumple 60 minutos.');
                    return;
                }

                if(contadorRaw===''||!Number.isFinite(contador)||contador<0){
                    e.preventDefault();
                    mostrarMensajeCorteExtra('Captura el contador actual de la máquina.');
                    document.getElementById('extraContador')?.focus();
                    return;
                }

                if(okRaw===''||!Number.isFinite(ok)||ok<0||sospechoso<0||scrap<0){
                    e.preventDefault();
                    mostrarMensajeCorteExtra('Revisa las cantidades. OK, Sospechosos y Scrap deben ser números mayores o iguales a cero.');
                    return;
                }

                if(!extraPreviewValida||!ultimaPrevisualizacionExtra){
                    e.preventDefault();
                    mostrarMensajeCorteExtra('Espera a que el ERP termine de calcular la producción física antes de guardar.');
                    programarPrevisualizacionExtra(false);
                    return;
                }

                const fisicas=Number(ultimaPrevisualizacionExtra.piezasFisicas??ultimaPrevisualizacionExtra.PiezasFisicas??0);
                const total=ok+sospechoso+scrap;

                if(fisicas===0&&total===0&&!observaciones){
                    e.preventDefault();
                    mostrarMensajeCorteExtra('El contador no registró producción en este periodo. Indica en observaciones qué ocurrió.');
                    document.getElementById('extraObservaciones')?.focus();
                    return;
                }

                if(total!==fisicas&&!observaciones){
                    e.preventDefault();
                    mostrarMensajeCorteExtra('La clasificación suma '+total.toLocaleString('es-MX')+' pieza(s), pero el contador indica '+fisicas.toLocaleString('es-MX')+'. Agrega una observación explicando la diferencia.');
                    document.getElementById('extraObservaciones')?.focus();
                    return;
                }

                const boton=document.getElementById('btnConfirmarCorteTiempoExtra');
                if(boton){
                    boton.disabled=true;
                    boton.innerHTML=modoRegistroTiempoExtra==='FINALIZAR'
                        ?'<i class="fa-solid fa-spinner fa-spin me-1"></i>Finalizando...'
                        :'<i class="fa-solid fa-spinner fa-spin me-1"></i>Guardando corte...';
                }
            });

            modalCorteTiempoExtraElemento?.addEventListener('hidden.bs.modal',function(){
                if(extraPreviewTimer)window.clearTimeout(extraPreviewTimer);
                extraPreviewSecuencia++;
                limpiarMensajeCorteExtra();
                limpiarPrevisualizacionExtra();
                cambiarModoOKExtra(false);
                const boton=document.getElementById('btnConfirmarCorteTiempoExtra');
                if(boton)boton.innerHTML='<i class="fa-solid fa-floppy-disk me-1"></i>Guardar corte';
            });

            if(panelTiempoExtra&&tieneTiempoExtraActivo){
                const segundosSesionBase=Number(panelTiempoExtra.dataset.segundosSesion||0);
                const segundosCorteBase=Number(panelTiempoExtra.dataset.segundosCorte||0);
                const inicioReloj=performance.now();
                const timerSesion=document.getElementById('cronometroTiempoExtra');
                const timerCorte=document.getElementById('cronometroCorteTiempoExtra');
                const estadoCorte=document.getElementById('estadoCorteTiempoExtra');

                function actualizarCronometroTiempoExtra(){
                    const transcurrido=(performance.now()-inicioReloj)/1000;
                    const segundosSesion=segundosSesionBase+transcurrido;
                    const segundosCorte=segundosCorteBase+transcurrido;
                    segundosCorteActual=segundosCorte;

                    if(timerSesion)timerSesion.textContent=formatoCronometro(segundosSesion);
                    if(timerCorte)timerCorte.textContent=formatoCronometro(segundosCorte);

                    const corteDisponible=segundosCorte>=3600;

                    if(btnCapturarCorteTiempoExtra){
                        btnCapturarCorteTiempoExtra.disabled=!corteDisponible||!ejecucionEnProduccion||tieneParoAbierto;
                        btnCapturarCorteTiempoExtra.classList.toggle('ready',corteDisponible&&ejecucionEnProduccion&&!tieneParoAbierto);
                        btnCapturarCorteTiempoExtra.title=corteDisponible
                            ?'Captura la lectura actual del contador para cerrar este bloque.'
                            :'El corte se habilita al cumplir 60 minutos desde el último corte.';
                    }

                    if(btnFinalizarTiempoExtra){
                        btnFinalizarTiempoExtra.disabled=!ejecucionEnProduccion||tieneParoAbierto;
                    }

                    if(alertaCorteTiempoExtra){
                        alertaCorteTiempoExtra.classList.toggle('d-none',!corteDisponible);
                    }

                    if(estadoCorte){
                        if(corteDisponible){
                            timerCorte?.classList.add('overdue');
                            estadoCorte.classList.add('overdue');
                            const excedente=Math.max(0,Math.floor(segundosCorte-3600));
                            estadoCorte.innerHTML='<i class="fa-solid fa-bell me-1"></i>Corte de 60 min disponible · '+formatoCronometro(excedente)+' después del corte.';
                        }else{
                            timerCorte?.classList.remove('overdue');
                            estadoCorte.classList.remove('overdue');
                            estadoCorte.innerHTML='<i class="fa-solid fa-hourglass-half me-1"></i>Próximo corte en '+formatoCronometro(3600-segundosCorte)+'.';
                        }
                    }

                    actualizarBotonConfirmarExtra();
                }

                actualizarCronometroTiempoExtra();
                window.setInterval(actualizarCronometroTiempoExtra,1000);
            }

            function mostrarMensajeTiempoExtra(mensaje){
                const box=document.getElementById('mensajeTiempoExtra');
                if(!box)return;
                box.innerHTML='<i class="fa-solid fa-triangle-exclamation me-2"></i>'+mensaje;
                box.classList.remove('d-none');
            }

            function limpiarMensajeTiempoExtra(){
                const box=document.getElementById('mensajeTiempoExtra');
                if(!box)return;
                box.classList.add('d-none');
                box.innerHTML='';
            }

            formIniciarTiempoExtra?.addEventListener('submit',function(e){
                limpiarMensajeTiempoExtra();
                const motivo=(document.getElementById('motivoTiempoExtra')?.value||'').trim();
                const observaciones=(document.getElementById('observacionesTiempoExtra')?.value||'').trim();
                const motivoOtro='@ERP.NSQuell.Models.ProduccionTiempoExtraMotivo.Otro';
                if(!motivo){
                    e.preventDefault();
                    mostrarMensajeTiempoExtra('Selecciona el motivo del tiempo extra.');
                    return;
                }
                if(motivo===motivoOtro&&!observaciones){
                    e.preventDefault();
                    mostrarMensajeTiempoExtra('Cuando seleccionas Otro debes explicar el motivo en observaciones.');
                    document.getElementById('observacionesTiempoExtra')?.focus();
                    return;
                }
                const boton=document.getElementById('btnConfirmarTiempoExtra');
                if(boton){
                    boton.disabled=true;
                    boton.innerHTML='<i class="fa-solid fa-spinner fa-spin me-1"></i>Iniciando...';
                }
            });

            function programarActualizacion(){
                window.setTimeout(function(){
                    const hayModalAbierto=document.querySelector('.modal.show');
                    const hayCampoActivo=document.activeElement&&['INPUT','TEXTAREA','SELECT'].includes(document.activeElement.tagName);
                    if(hayModalAbierto||hayCampoActivo){
                        programarActualizacion();
                        return;
                    }
                    window.location.reload();
                },60000);
            }
            programarActualizacion();
        });
    </script>
}
