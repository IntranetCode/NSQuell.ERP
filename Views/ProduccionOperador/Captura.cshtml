            async function ejecutarPrevisualizacion(){
                const contadorInput=document.getElementById('modalContador');const raw=(contadorInput?.value||'').trim();
                if(raw===''||!Number.isFinite(Number(raw))||Number(raw)<0){limpiarPrevisualizacion();const feedback=document.getElementById('modalContadorFeedback');if(feedback){feedback.className='counter-feedback';feedback.innerHTML='<i class="fa-solid fa-circle-info me-1"></i>Captura un contador válido para calcular la producción.';}actualizarClasificaciones();return;}
                if(!form)return;
                const secuencia=++previewSecuencia;const card=document.getElementById('resumenFisicoHora');card?.classList.add('preview-loading');
                const token=form.querySelector('input[name="__RequestVerificationToken"]')?.value||'';const datos=new FormData();
                datos.append('__RequestVerificationToken',token);datos.append('ejecucionProduccionId','@Model.EjecucionProduccionID');datos.append('fechaProduccion',document.getElementById('modalFecha')?.value||'');datos.append('horaInicio',document.getElementById('modalInicio')?.value||'');datos.append('horaFin',document.getElementById('modalFin')?.value||'');datos.append('contadorMaquinaActual',raw);datos.append('cantidadScrap',String(numeroSeguro(document.getElementById('modalScrap'))));
                if(esLhRh)datos.append('cantidadScrapPareja',String(numeroSeguro(document.getElementById('modalScrapPareja'))));
                try{
                    const response=await fetch(urlPrevisualizar,{method:'POST',body:datos,headers:{'X-Requested-With':'XMLHttpRequest'}});let data=null;try{data=await response.json();}catch{data=null;}
                    if(secuencia!==previewSecuencia)return;
                    if(!response.ok||!data||data.ok===false){ultimaPrevisualizacion=null;const mensaje=data?.mensaje||data?.Mensaje||'No fue posible calcular la producción del bloque.';const feedback=document.getElementById('modalContadorFeedback');if(feedback){feedback.className='counter-feedback text-danger';feedback.innerHTML='<i class="fa-solid fa-triangle-exclamation me-1"></i>'+mensaje;}limpiarPrevisualizacion();actualizarClasificaciones();return;}
                    pintarPrevisualizacion(data);
                }catch(error){if(secuencia!==previewSecuencia)return;ultimaPrevisualizacion=null;limpiarPrevisualizacion();const feedback=document.getElementById('modalContadorFeedback');if(feedback){feedback.className='counter-feedback text-danger';feedback.innerHTML='<i class="fa-solid fa-triangle-exclamation me-1"></i>'+(error?.message||'No fue posible consultar el cálculo automático.');}actualizarClasificaciones();}
                finally{if(secuencia===previewSecuencia)card?.classList.remove('preview-loading');}
