    <div class="modal fade" id="modalCapturaHora" tabindex="-1" aria-hidden="true" data-bs-backdrop="static" data-bs-keyboard="false">
        <div class="modal-dialog modal-dialog-centered modal-lg">
            <div class="modal-content">
                <div class="modal-header"><h5 class="modal-title"><i class="fa-solid fa-bell me-2"></i>Captura horaria pendiente</h5><button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Cerrar"></button></div>
                <form method="post" action="@Url.Action("RegistrarHora","ProduccionOperador")" id="formModalHora">
                    @Html.AntiForgeryToken()
                    <div class="modal-body p-4">
                        <input type="hidden" name="EjecucionProduccionID" value="@Model.EjecucionProduccionID" />
                        <input type="hidden" name="FechaProduccion" id="modalFecha" />
                        <input type="hidden" name="HoraInicio" id="modalInicio" />
                        <input type="hidden" name="HoraFin" id="modalFin" />
                        <div class="text-center mb-3"><div class="text-muted fw-bold">Debes completar</div><div class="modal-hour" id="modalTituloHora">Hora pendiente</div><div class="text-muted" id="modalRangoHora"></div></div>
                        <div class="modal-goal">
                            <div class="goal-label">Objetivo de este bloque</div>
                            <div class="goal-value"><span id="modalObjetivo">-</span> <small>PZA</small></div>
                            <div class="modal-goal-feedback" id="modalObjetivoFeedback">Captura las piezas OK para comparar contra el objetivo.</div>
                        </div>
                        <div id="mensajeCapturaHora" class="alert alert-danger rounded-4 fw-bold d-none mb-3" role="alert"></div>
                        <div class="modal-grid mb-3">
                            <div><div class="modal-label text-success">OK</div><input type="number" min="0" value="" placeholder="0" name="CantidadOK" id="modalOK" class="modal-qty ok empty-number" inputmode="numeric" /></div>
                            <div><div class="modal-label text-warning">Sospechosos</div><input type="number" min="0" value="" placeholder="0" name="CantidadSospechosa" id="modalYellow" class="modal-qty yellow empty-number" inputmode="numeric" /></div>
                            <div><div class="modal-label text-danger">Scrap</div><input type="number" min="0" value="" placeholder="0" name="CantidadScrap" id="modalScrap" class="modal-qty scrap empty-number" inputmode="numeric" /></div>
                        </div>
                        <label class="form-label fw-bold">Observaciones</label><textarea name="Observaciones" id="modalObs" class="form-control" rows="3" maxlength="500" placeholder="Necesaria cuando no hubo producción o para explicar incidencias"></textarea>
                        <div class="alert alert-warning mt-3 mb-0"><i class="fa-solid fa-circle-info me-1"></i>Puedes cerrar este aviso durante las pruebas, pero la siguiente hora seguirá bloqueada hasta capturar la anterior.</div>
                    </div>
                    <div class="modal-footer border-0 px-4 pb-4"><button type="submit" class="btn btn-primary w-100"><i class="fa-solid fa-floppy-disk me-1"></i>Guardar Hora</button></div>
                </form>
            </div>
        </div>
    </div>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
    <script>
        document.addEventListener('DOMContentLoaded',function(){
            const modalElement=document.getElementById('modalCapturaHora');
            const modal=modalElement?bootstrap.Modal.getOrCreateInstance(modalElement):null;
            const form=document.getElementById('formModalHora');
            function cargarFila(row){
                if(!row||!form)return;
                document.getElementById('modalFecha').value=row.dataset.fecha||'';
                document.getElementById('modalInicio').value=row.dataset.inicio||'';
                document.getElementById('modalFin').value=row.dataset.fin||'';
                document.getElementById('modalTituloHora').textContent='Hora '+(row.dataset.numero||'');
                document.getElementById('modalRangoHora').textContent=(row.dataset.inicio||'')+' - '+(row.dataset.fin||'');
                document.getElementById('modalObjetivo').textContent=Number(row.dataset.objetivo||0)>0?Number(row.dataset.objetivo).toLocaleString('es-MX'):'-';
                document.getElementById('modalOK').dataset.objetivo=row.dataset.objetivo||'0';
                document.getElementById('modalOK').value=row.querySelector('[data-field="ok"]')?.value||'';
                document.getElementById('modalYellow').value=row.querySelector('[data-field="yellow"]')?.value||'';
                document.getElementById('modalScrap').value=row.querySelector('[data-field="scrap"]')?.value||'';
                document.getElementById('modalObs').value=row.querySelector('[data-field="obs"]')?.value||'';
                actualizarComparacionObjetivo();
            }
            function actualizarComparacionObjetivo(){
                const input=document.getElementById('modalOK');
                const feedback=document.getElementById('modalObjetivoFeedback');
                if(!input||!feedback)return;
                const objetivo=Number(input.dataset.objetivo||0);
                const valorRaw=(input.value||'').trim();
                if(objetivo<=0){
                    feedback.className='modal-goal-feedback text-muted';
                    feedback.innerHTML='<i class="fa-solid fa-circle-info me-1"></i>Esta parte no tiene objetivo por hora configurado.';
                    return;
                }
                if(valorRaw===''){
                    feedback.className='modal-goal-feedback text-muted';
                    feedback.textContent='Captura las piezas OK para comparar contra el objetivo de esta hora.';
                    return;
                }
                const ok=Number(valorRaw||0);
                const diferencia=ok-objetivo;
                const porcentaje=Math.round((ok/objetivo)*1000)/10;
                if(diferencia>0){
                    feedback.className='modal-goal-feedback text-success';
                    feedback.innerHTML='<i class="fa-solid fa-circle-check me-1"></i>Alcanzaste el objetivo: <strong>'+porcentaje.toLocaleString('es-MX')+'%</strong>. Lo superaste por '+diferencia.toLocaleString('es-MX')+' pieza(s).';
                    return;
                }
                if(diferencia===0){
                    feedback.className='modal-goal-feedback text-success';
                    feedback.innerHTML='<i class="fa-solid fa-circle-check me-1"></i>Alcanzaste exactamente el objetivo: <strong>100%</strong>.';
                    return;
                }
                feedback.className='modal-goal-feedback text-danger';
                feedback.innerHTML='<i class="fa-solid fa-circle-xmark me-1"></i>No alcanzaste el objetivo: <strong>'+porcentaje.toLocaleString('es-MX')+'%</strong>. Faltaron '+Math.abs(diferencia).toLocaleString('es-MX')+' pieza(s).';
            }
            document.getElementById('modalOK')?.addEventListener('input',actualizarComparacionObjetivo);
            const capturaHabilitada = @capturaHabilitada.ToString().ToLowerInvariant();
            const tieneParoAbierto = @Model.TieneParoAbierto.ToString().ToLowerInvariant();

            document.querySelectorAll('.btn-open-hour').forEach(btn=>btn.addEventListener('click',function(){
                if (!capturaHabilitada || tieneParoAbierto) return;
                const row=this.closest('[data-hour-row]');
                cargarFila(row);
                modal?.show();
            }));
            function mostrarMensajeCaptura(mensaje){
                const box=document.getElementById('mensajeCapturaHora');
                if(!box)return;
                box.innerHTML='<i class="fa-solid fa-triangle-exclamation me-2"></i>'+mensaje;
                box.classList.remove('d-none');
            }
            function limpiarMensajeCaptura(){
                const box=document.getElementById('mensajeCapturaHora');
                if(!box)return;
                box.classList.add('d-none');
                box.innerHTML='';
            }
            form?.addEventListener('submit',function(e){
                limpiarMensajeCaptura();
                const ok=Number(document.getElementById('modalOK').value||0);
                const yellow=Number(document.getElementById('modalYellow').value||0);
                const scrap=Number(document.getElementById('modalScrap').value||0);
                const obs=(document.getElementById('modalObs').value||'').trim();
                if(ok<0||yellow<0||scrap<0){
                    e.preventDefault();
                    mostrarMensajeCaptura('Las cantidades no pueden ser negativas. Revisa OK, Sospechosos y Scrap.');
                    return;
                }
                if(ok===0&&yellow===0&&scrap===0&&!obs){
                    e.preventDefault();
                    mostrarMensajeCaptura('Captura al menos una cantidad o explica en observaciones por qué no hubo producción durante esta hora.');
                    return;
                }
                const button=form.querySelector('button[type="submit"]');
                if(button){
                    button.disabled=true;
                    button.innerHTML='<i class="fa-solid fa-spinner fa-spin me-1"></i>Guardando...';
                }
            });
            const obligatoria=document.querySelector('[data-hour-row][data-obligatoria="true"]');
            if(capturaHabilitada && !tieneParoAbierto && obligatoria){
                cargarFila(obligatoria);
                modal?.show();
            } else {
                modal?.hide();
            }

            function mostrarMensajeParo(mensaje){
                const box=document.getElementById('mensajeParo');
                if(!box)return;
                box.innerHTML='<i class="fa-solid fa-triangle-exclamation me-2"></i>'+mensaje;
                box.classList.remove('d-none');
            }
            function limpiarMensajeParo(){
                const box=document.getElementById('mensajeParo');
                if(!box)return;
                box.classList.add('d-none');
                box.innerHTML='';
            }
            const formIniciarParo=document.getElementById('formIniciarParo');
            formIniciarParo?.addEventListener('submit',function(e){
                limpiarMensajeParo();
                const motivoId=(document.getElementById('motivoParoId')?.value||'').trim();
                const motivoTexto=(document.getElementById('motivoParoTexto')?.value||'').trim();
                if(!motivoId&&!motivoTexto){
                    e.preventDefault();
                    mostrarMensajeParo('Selecciona un motivo del catálogo o captura otro motivo antes de iniciar el paro.');
                    return;
                }
                const button=document.getElementById('btnConfirmarParo');
                if(button){
                    button.disabled=true;
                    button.innerHTML='<i class="fa-solid fa-spinner fa-spin me-1"></i>Iniciando paro...';
                }
            });

            const formCerrarParo=document.getElementById('formCerrarParo');
            formCerrarParo?.addEventListener('submit',function(){
                const button=document.getElementById('btnConfirmarCierreParo');
                if(button){button.disabled=true;button.innerHTML='<i class="fa-solid fa-spinner fa-spin me-1"></i>Finalizando...';}
            });

                    const btnAbrirCambioTurno=document.getElementById('btnAbrirCambioTurno');
        const modalCambioTurnoElemento=document.getElementById('modalCambioTurno');
        const modalCambioTurno=modalCambioTurnoElemento?bootstrap.Modal.getOrCreateInstance(modalCambioTurnoElemento):null;
        const formCambioTurno=document.getElementById('formCambioTurno');
        const selectOperadorEntrante=document.getElementById('operadorEntranteID');
        const btnConfirmarCambioTurno=document.getElementById('btnConfirmarCambioTurno');
        let resumenCambioTurno=null;
        function textoSeguro(valor,alternativo='-'){
            if(valor===null||valor===undefined||String(valor).trim()==='')return alternativo;
            return String(valor).trim();
        }
        function numeroCambioTurno(valor){
            const numero=Number(valor||0);
            return Number.isFinite(numero)?numero.toLocaleString('es-MX'):'0';
        }
        function propiedad(obj,...nombres){
            if(!obj)return null;
            for(const nombre of nombres){
                if(Object.prototype.hasOwnProperty.call(obj,nombre))return obj[nombre];
            }
            return null;
        }
        function mostrarErrorCambioTurno(mensaje){
            const box=document.getElementById('mensajeCambioTurno');
            if(!box)return;
            box.className='turn-validation error';
            box.innerHTML='<i class="fa-solid fa-triangle-exclamation me-1"></i>'+mensaje;
        }
        function ocultarErrorCambioTurno(){
            const box=document.getElementById('mensajeCambioTurno');
            if(!box)return;
            box.classList.add('d-none');
            box.innerHTML='';
        }
        function limpiarCambioTurno(){
            resumenCambioTurno=null;
            document.getElementById('cambioTurnoLoading')?.classList.remove('d-none');
            document.getElementById('cambioTurnoContenido')?.classList.add('d-none');
            ocultarErrorCambioTurno();
            if(selectOperadorEntrante){
                selectOperadorEntrante.innerHTML='<option value="">Selecciona operador</option>';
                selectOperadorEntrante.disabled=true;
            }
            if(btnConfirmarCambioTurno)btnConfirmarCambioTurno.disabled=true;
            document.getElementById('turnInfoSeleccionado')?.classList.add('d-none');
            document.getElementById('turnSugeridoBox')?.classList.add('d-none');
        }
        function obtenerOperadoresResumen(resumen){
            const lista=propiedad(resumen,'operadores','Operadores');
            return Array.isArray(lista)?lista:[];
        }
        function obtenerOperadorPorId(personaId){
            if(!resumenCambioTurno)return null;
            return obtenerOperadoresResumen(resumenCambioTurno).find(function(x){
                return Number(propiedad(x,'personaID','PersonaID'))===Number(personaId);
            })||null;
        }
        function pintarOperadorSeleccionado(){
            const box=document.getElementById('turnInfoSeleccionado');
            const nombre=document.getElementById('turnSeleccionadoNombre');
            const detalle=document.getElementById('turnSeleccionadoDetalle');
            if(!selectOperadorEntrante||!box||!nombre||!detalle)return;
            const personaId=Number(selectOperadorEntrante.value||0);
            const operador=obtenerOperadorPorId(personaId);
            if(!operador){
                box.classList.add('d-none');
                nombre.textContent='-';
                detalle.textContent='';
                return;
            }
            const nivel=propiedad(operador,'nivel','Nivel');
            const turno=propiedad(operador,'turnoNombre','TurnoNombre');
            const enEscala=Boolean(propiedad(operador,'enEscala','EnEscala'));
            nombre.textContent=textoSeguro(propiedad(operador,'nombre','Nombre'));
            const partes=[];
            if(nivel!==null&&nivel!==undefined)partes.push('Nivel N'+nivel);
            if(turno)partes.push('Turno '+turno);
            partes.push(enEscala?'Programado en escala':'Selección manual autorizada');
            detalle.textContent=partes.join(' · ');
            box.classList.remove('d-none');
        }
        function evaluarBotonCambioTurno(){
            if(!btnConfirmarCambioTurno||!selectOperadorEntrante||!resumenCambioTurno)return;
            const puedeEntregar=Boolean(propiedad(resumenCambioTurno,'puedeEntregar','PuedeEntregar'));
            const operadorSeleccionado=Number(selectOperadorEntrante.value||0)>0;
            btnConfirmarCambioTurno.disabled=!puedeEntregar||!operadorSeleccionado;
        }
        function llenarResumenCambioTurno(resumen){
            resumenCambioTurno=resumen;
            const maquinaCodigo=propiedad(resumen,'maquinaCodigo','MaquinaCodigo');
            const maquinaNombre=propiedad(resumen,'maquinaNombre','MaquinaNombre');
            const maquina=[maquinaCodigo,maquinaNombre].filter(x=>x&&String(x).trim()!=='').join(' - ');
            document.getElementById('turnMaquina').textContent=textoSeguro(maquina);
            document.getElementById('turnParte').textContent=textoSeguro(propiedad(resumen,'referenciaSAP','ReferenciaSAP')||propiedad(resumen,'numeroParte','NumeroParte'));
            document.getElementById('turnUltimaHora').textContent=textoSeguro(propiedad(resumen,'ultimaHoraTexto','UltimaHoraTexto'),'Sin captura registrada');
            document.getElementById('turnOperadorSaliente').textContent=textoSeguro(propiedad(resumen,'operadorSalienteNombre','OperadorSalienteNombre'));
            document.getElementById('turnCantidadOK').textContent=numeroCambioTurno(propiedad(resumen,'cantidadOK','CantidadOK'));
            document.getElementById('turnCantidadSospechosa').textContent=numeroCambioTurno(propiedad(resumen,'cantidadSospechosa','CantidadSospechosa'));
            document.getElementById('turnCantidadScrap').textContent=numeroCambioTurno(propiedad(resumen,'cantidadScrap','CantidadScrap'));
            document.getElementById('turnTotalCajas').textContent=numeroCambioTurno(propiedad(resumen,'totalCajas','TotalCajas'));
            document.getElementById('turnCajasEntregadas').textContent=numeroCambioTurno(propiedad(resumen,'totalCajasEntregadas','TotalCajasEntregadas'));
            const cajasPendientes=Number(propiedad(resumen,'totalCajasPendientes','TotalCajasPendientes')||0);
            document.getElementById('turnCajasPendientes').textContent=numeroCambioTurno(cajasPendientes);
            const badgePendientes=document.getElementById('badgeCajasPendientes');
            if(badgePendientes){
                badgePendientes.className=cajasPendientes>0?'danger':'ok';
                badgePendientes.innerHTML=cajasPendientes>0
                    ?'<i class="fa-solid fa-triangle-exclamation me-1"></i>Pendientes: <strong>'+numeroCambioTurno(cajasPendientes)+'</strong>'
                    :'<i class="fa-solid fa-circle-check me-1"></i>Pendientes: <strong>0</strong>';
            }
            const puedeEntregar=Boolean(propiedad(resumen,'puedeEntregar','PuedeEntregar'));
            const motivoBloqueo=propiedad(resumen,'motivoBloqueo','MotivoBloqueo');
            const validacion=document.getElementById('turnValidacionEntrega');
            if(validacion){
                if(puedeEntregar){
                    validacion.className='turn-validation ok';
                    validacion.innerHTML='<i class="fa-solid fa-circle-check me-1"></i>La producción está lista para entregar el turno.';
                }else{
                    validacion.className='turn-validation error';
                    validacion.innerHTML='<i class="fa-solid fa-triangle-exclamation me-1"></i>'+textoSeguro(motivoBloqueo,'El turno no puede entregarse en este momento.');
                }
            }
            const operadorSugeridoId=propiedad(resumen,'operadorSugeridoID','OperadorSugeridoID');
            const operadorSugeridoNombre=propiedad(resumen,'operadorSugeridoNombre','OperadorSugeridoNombre');
            const turnoSugeridoNombre=propiedad(resumen,'turnoSugeridoNombre','TurnoSugeridoNombre');
            const escalaEncontrada=Boolean(propiedad(resumen,'escalaEncontrada','EscalaEncontrada'));
            const escalaFolio=propiedad(resumen,'escalaFolio','EscalaFolio');
            const sugeridoBox=document.getElementById('turnSugeridoBox');
            if(operadorSugeridoId&&sugeridoBox){
                document.getElementById('turnOperadorSugerido').textContent=textoSeguro(operadorSugeridoNombre);
                let detalle='Según escala';
                if(turnoSugeridoNombre)detalle+=' · Turno '+turnoSugeridoNombre;
                if(escalaFolio)detalle+=' · '+escalaFolio;
                document.getElementById('turnSugeridoDetalle').textContent=detalle;
                sugeridoBox.classList.remove('d-none');
            }else if(sugeridoBox){
                sugeridoBox.classList.add('d-none');
            }
            const tieneMatriz=Boolean(propiedad(resumen,'tieneMatrizPolivalencia','TieneMatrizPolivalencia'));
            const ayuda=document.getElementById('turnAyudaOperador');
            if(ayuda){
                if(operadorSugeridoId){
                    ayuda.textContent='El operador sugerido fue encontrado en la escala y cumple con la regla de polivalencia. Puedes seleccionar otro operador autorizado si es necesario.';
                }else if(escalaEncontrada&&tieneMatriz){
                    ayuda.textContent='Existe escala vigente, pero no se encontró un operador válido para sugerir. Selecciona manualmente un operador N1-N4 autorizado para esta parte.';
                }else if(tieneMatriz){
                    ayuda.textContent='No existe un operador sugerido por escala. Selecciona manualmente un operador N1-N4 autorizado para esta parte.';
                }else{
                    ayuda.textContent='La parte no tiene matriz de polivalencia configurada. Selecciona un operador activo del catálogo.';
                }
            }
            const operadores=obtenerOperadoresResumen(resumen);
            if(selectOperadorEntrante){
                selectOperadorEntrante.innerHTML='<option value="">Selecciona operador</option>';
                operadores.forEach(function(op){
                    const personaId=propiedad(op,'personaID','PersonaID');
                    const nombre=textoSeguro(propiedad(op,'nombre','Nombre'));
                    const nivel=propiedad(op,'nivel','Nivel');
                    const turno=propiedad(op,'turnoNombre','TurnoNombre');
                    const enEscala=Boolean(propiedad(op,'enEscala','EnEscala'));
                    const option=document.createElement('option');
                    option.value=personaId;
                    let texto=nombre;
                    if(nivel!==null&&nivel!==undefined)texto+=' · N'+nivel;
                    if(turno)texto+=' · '+turno;
                    if(enEscala)texto+=' · ESCALA';
                    option.textContent=texto;
                    option.dataset.escala=enEscala?'true':'false';
                    option.dataset.nivel=nivel??'';
                    selectOperadorEntrante.appendChild(option);
                });
                selectOperadorEntrante.disabled=!puedeEntregar||operadores.length===0;
                if(operadorSugeridoId&&operadores.some(x=>Number(propiedad(x,'personaID','PersonaID'))===Number(operadorSugeridoId))){
                    selectOperadorEntrante.value=String(operadorSugeridoId);
                }
            }
            if(operadores.length===0&&puedeEntregar){
                mostrarErrorCambioTurno('No existen operadores disponibles para recibir el turno. Revisa la escala o la matriz de polivalencia.');
            }
            pintarOperadorSeleccionado();
            evaluarBotonCambioTurno();
        }
        async function cargarCambioTurno(){
            limpiarCambioTurno();
            try{
                const url='@Url.Action("ObtenerResumenCambioTurno", "ProduccionOperador")'+'?ejecucionProduccionId=@Model.EjecucionProduccionID';
                const response=await fetch(url,{
                    method:'GET',
                    headers:{'X-Requested-With':'XMLHttpRequest'}
                });
                let data=null;
                try{
                    data=await response.json();
                }catch{
                    data=null;
                }
                if(!response.ok||!data||data.ok===false){
                    throw new Error(data?.mensaje||'No fue posible consultar la información para entregar el turno.');
                }
                const resumen=data.resumen??data.Resumen;
                if(!resumen)throw new Error('El servidor no devolvió el resumen del cambio de turno.');
                llenarResumenCambioTurno(resumen);
                document.getElementById('cambioTurnoLoading')?.classList.add('d-none');
                document.getElementById('cambioTurnoContenido')?.classList.remove('d-none');
            }catch(error){
                document.getElementById('cambioTurnoLoading')?.classList.add('d-none');
                document.getElementById('cambioTurnoContenido')?.classList.remove('d-none');
                mostrarErrorCambioTurno(error?.message||'No fue posible cargar la entrega de turno.');
            }
        }
        btnAbrirCambioTurno?.addEventListener('click',async function(){
            modalCambioTurno?.show();
            await cargarCambioTurno();
        });
        selectOperadorEntrante?.addEventListener('change',function(){
            pintarOperadorSeleccionado();
            evaluarBotonCambioTurno();
        });
        formCambioTurno?.addEventListener('submit',function(e){
            ocultarErrorCambioTurno();
            if(!resumenCambioTurno){
                e.preventDefault();
                mostrarErrorCambioTurno('No se ha cargado la información de la entrega.');
                return;
            }
            const puedeEntregar=Boolean(propiedad(resumenCambioTurno,'puedeEntregar','PuedeEntregar'));
            if(!puedeEntregar){
                e.preventDefault();
                mostrarErrorCambioTurno(textoSeguro(propiedad(resumenCambioTurno,'motivoBloqueo','MotivoBloqueo'),'El turno no puede entregarse.'));
                return;
            }
            const operadorId=Number(selectOperadorEntrante?.value||0);
            if(operadorId<=0){
                e.preventDefault();
                mostrarErrorCambioTurno('Selecciona al operador que recibirá el turno.');
                return;
            }
            const operador=obtenerOperadorPorId(operadorId);
            if(!operador){
                e.preventDefault();
                mostrarErrorCambioTurno('El operador seleccionado ya no se encuentra dentro de los candidatos autorizados.');
                return;
            }
            if(btnConfirmarCambioTurno){
                btnConfirmarCambioTurno.disabled=true;
                btnConfirmarCambioTurno.innerHTML='<i class="fa-solid fa-spinner fa-spin me-1"></i>Enviando turno...';
            }
        });
        modalCambioTurnoElemento?.addEventListener('hidden.bs.modal',function(){
            limpiarCambioTurno();
            if(btnConfirmarCambioTurno){
                btnConfirmarCambioTurno.innerHTML='<i class="fa-solid fa-paper-plane me-1"></i>Enviar turno para recepción';
            }
        });

            function programarActualizacion(){
                window.setTimeout(function(){
                    const hayModalAbierto=document.querySelector('.modal.show');
                    const hayCampoActivo=document.activeElement&&['INPUT','TEXTAREA','SELECT'].includes(document.activeElement.tagName);
                    if(hayModalAbierto||hayCampoActivo){
                        programarActualizacion();
                        return;
                    }
                    window.location.reload();
                },60000);
            }
            programarActualizacion();
        });
    </script>
</body>
</html>
