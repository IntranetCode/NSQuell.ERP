@model ERP.NSQuell.Models.ProduccionOperadorTabletVm
@{
    Layout = "~/Views/Shared/_Layout.cshtml";

    var produccionPareja = Model.ProduccionPareja;
    var relacionPareja = Model.ParejaLhRh;
    var esLhRh = Model.EsProduccionLhRh && produccionPareja != null && relacionPareja != null;
    var ladoActual = !string.IsNullOrWhiteSpace(Model.LadoLhRh) ? Model.LadoLhRh! : "OF A";
    var ladoPareja = !string.IsNullOrWhiteSpace(Model.LadoParejaLhRh) ? Model.LadoParejaLhRh! : "OF B";
    var capturaLhRhBloqueada = esLhRh && ViewBag.CapturaLhRhBloqueada == true;
    var errorLhRh = ViewBag.ErrorLhRh as string;

    var planeada = Model.CantidadPlaneada ?? 0;
    var totalCapturado = Model.CantidadOKTotal + Model.CantidadScrapTotal;
    var pendiente = Math.Max(0, planeada - Model.CantidadOKTotal);
    var avance = planeada > 0 ? Math.Min(100m, Math.Round(Model.CantidadOKTotal * 100m / planeada, 2)) : 0m;

    var planeadaPareja = esLhRh ? produccionPareja!.CantidadPlaneada ?? 0 : 0;
    var pendientePareja = esLhRh ? Math.Max(0, planeadaPareja - produccionPareja!.CantidadOKTotal) : 0;
    var avancePareja = esLhRh && planeadaPareja > 0 ? Math.Min(100m, Math.Round(produccionPareja!.CantidadOKTotal * 100m / planeadaPareja, 2)) : 0m;

    var horas = Model.HorasCaptura?.OrderBy(x => x.FechaProduccion).ThenBy(x => x.NumeroHora).ToList() ?? new List<ERP.NSQuell.Models.ProduccionCapturaHoraFilaVm>();
    var horasPareja = esLhRh ? produccionPareja!.HorasCaptura?.OrderBy(x => x.FechaProduccion).ThenBy(x => x.NumeroHora).ToList() ?? new List<ERP.NSQuell.Models.ProduccionCapturaHoraFilaVm>() : new List<ERP.NSQuell.Models.ProduccionCapturaHoraFilaVm>();
    var historialTurnos = Model.HistorialTurnos?.OrderBy(x => x.NumeroTurno).ToList() ?? new List<ERP.NSQuell.Models.ProduccionHistorialTurnoVm>();
    var historialCambiosTurno = Model.HistorialCambiosTurno?.OrderBy(x => x.FechaEntrega).ToList() ?? new List<ERP.NSQuell.Models.ProduccionCambioTurnoHistorialVm>();

    var tiempoExtraActivo = Model.TiempoExtraActivo;
    var historialTiempoExtra = Model.HistorialTiempoExtra?.OrderByDescending(x => x.TiempoExtraID).ToList() ?? new List<ERP.NSQuell.Models.ProduccionTiempoExtraVm>();
    var tieneTiempoExtraActivo = tiempoExtraActivo != null;
    var capturaNormalFinalizada = esLhRh
        ? horas.Count > 0 && horasPareja.Count > 0 && horas.All(x => x.Capturada) && horasPareja.All(x => x.Capturada)
        : Model.PuedeIniciarTiempoExtra || tieneTiempoExtraActivo;

    var horasPendientes = capturaNormalFinalizada ? new List<ERP.NSQuell.Models.ProduccionCapturaHoraFilaVm>() : horas.Where(x => !x.Capturada).OrderBy(x => x.FechaProduccion).ThenBy(x => x.NumeroHora).ToList();
    var horasPendientesVisibles = horasPendientes.Take(5).ToList();
    var horasPendientesAdicionales = horasPendientes.Skip(5).ToList();
    var horasCapturadas = horas.Where(x => x.Capturada).OrderByDescending(x => x.FechaProduccion).ThenByDescending(x => x.NumeroHora).ToList();
    var horaObligatoria = horasPendientes.Where(x => x.Disponible).OrderBy(x => x.FechaProduccion).ThenBy(x => x.NumeroHora).FirstOrDefault();

    var tieneParoFisico = Model.TieneParoAbierto || (esLhRh && produccionPareja!.TieneParoAbierto);
    var ambasEnProduccion = !esLhRh || produccionPareja!.EstatusID == ERP.NSQuell.Models.ProduccionEstatus.EnProduccion;
    var capturaHabilitada = Model.EstatusID == ERP.NSQuell.Models.ProduccionEstatus.EnProduccion && ambasEnProduccion && !tieneParoFisico && !capturaNormalFinalizada && !capturaLhRhBloqueada;
    var puedeIniciarTiempoExtra = !esLhRh && Model.PuedeIniciarTiempoExtra && !tieneTiempoExtraActivo && Model.EstatusID == ERP.NSQuell.Models.ProduccionEstatus.EnProduccion && !Model.TieneParoAbierto;

    var segundosSesionTiempoExtra = tiempoExtraActivo != null ? Math.Max(0d, (Model.FechaHoraServidor - tiempoExtraActivo.FechaHoraInicio).TotalSeconds) : 0d;
    var segundosCorteTiempoExtra = tiempoExtraActivo != null ? Math.Max(0d, (Model.FechaHoraServidor - tiempoExtraActivo.FechaHoraUltimoCorte).TotalSeconds) : 0d;
    var corteTiempoExtraDisponible = tiempoExtraActivo != null && segundosCorteTiempoExtra >= 3600d;

    var objetivoHora = Model.ObjetivoHoraEnUso ?? Model.ObjetivoHora;
    var cavidadesEnUso = Model.CavidadesEnUso;
    var cicloEnUso = Model.CicloEnUso;
    var ultimoContador = Model.UltimoContadorMaquina;
    var bonusActual = Model.BonusOperadorActual;

    var objetivoHoraPareja = esLhRh ? produccionPareja!.ObjetivoHoraEnUso ?? produccionPareja.ObjetivoHora : null;
    var cavidadesEnUsoPareja = esLhRh ? produccionPareja!.CavidadesEnUso : null;
    var cicloEnUsoPareja = esLhRh ? produccionPareja!.CicloEnUso : null;
    var ultimoContadorPareja = esLhRh ? produccionPareja!.UltimoContadorMaquina : null;
    var bonusPareja = esLhRh ? produccionPareja!.BonusOperadorActual : 0;
    var ultimoContadorCompartido = !esLhRh
        ? ultimoContador
        : ultimoContador.HasValue && ultimoContadorPareja.HasValue && ultimoContador.Value == ultimoContadorPareja.Value
            ? ultimoContador
            : null;

    var catalogoDefectos = Model.CatalogoDefectos?.Where(x => x.Activo).OrderBy(x => x.Codigo).ThenBy(x => x.Nombre).ToList() ?? new List<ERP.NSQuell.Models.ProduccionCatalogoDefectoVm>();
    var mensajeSuccess = TempData["Success"]?.ToString();
    var mensajeObjetivoNoCumplido = !string.IsNullOrWhiteSpace(mensajeSuccess) && mensajeSuccess.Contains("No alcanzaste el objetivo por hora", StringComparison.OrdinalIgnoreCase);
    var mensajeSinObjetivo = !string.IsNullOrWhiteSpace(mensajeSuccess) && mensajeSuccess.Contains("no tiene objetivo por hora configurado", StringComparison.OrdinalIgnoreCase);
}
@functions {
    public static string Txt(string? value) => string.IsNullOrWhiteSpace(value) ? "-" : value.Trim();
    public static string Numero(int value) => value.ToString("N0");
    public static string Hora(TimeSpan value) => value.ToString(@"hh\:mm");
    public static string EstadoTexto(ERP.NSQuell.Models.ProduccionCapturaHoraFilaVm fila)
    {
        if (fila.Capturada) return "Capturada";
        if (fila.Vencida) return "Obligatoria";
        if (fila.Disponible) return "Disponible";
        return "Próxima";
    }
    public static string EstadoClase(ERP.NSQuell.Models.ProduccionCapturaHoraFilaVm fila)
    {
        if (fila.Capturada) return "status-complete";
        if (fila.Vencida) return "status-overdue";
        if (fila.Disponible) return "status-ready";
        return "status-future";
    }
}
@{
    ViewData["Title"] = "Captura por hora | Producción";
}

