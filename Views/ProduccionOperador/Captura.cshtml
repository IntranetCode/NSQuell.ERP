                mostrarErrorCambioTurno('No se ha cargado la información de la entrega.');
                return;
            }
            const puedeEntregar=Boolean(propiedad(resumenCambioTurno,'puedeEntregar','PuedeEntregar'));
            if(!puedeEntregar){
                e.preventDefault();
                mostrarErrorCambioTurno(textoSeguro(propiedad(resumenCambioTurno,'motivoBloqueo','MotivoBloqueo'),'El turno no puede entregarse.'));
                return;
            }
            const operadorId=Number(selectOperadorEntrante?.value||0);
            if(operadorId<=0){
                e.preventDefault();
                mostrarErrorCambioTurno('Selecciona al operador que recibirá el turno.');
                return;
            }
            const operador=obtenerOperadorPorId(operadorId);
            if(!operador){
                e.preventDefault();
                mostrarErrorCambioTurno('El operador seleccionado ya no se encuentra dentro de los candidatos autorizados.');
                return;
            }
            if(btnConfirmarCambioTurno){
                btnConfirmarCambioTurno.disabled=true;
                btnConfirmarCambioTurno.innerHTML='<i class="fa-solid fa-spinner fa-spin me-1"></i>Enviando turno...';
            }
