                            <table class="hour-table pair-history-table">
                                <thead><tr><th>Hora</th><th>Rango</th><th>Contador</th><th>@ladoActual · OK</th><th>@ladoActual · Scrap</th><th>@ladoPareja · OK</th><th>@ladoPareja · Scrap</th><th>Estado</th></tr></thead>
                                <tbody>
                                    @foreach (var fila in horasCapturadas)
                                    {
                                        var filaPareja = horasPareja.FirstOrDefault(x => x.FechaProduccion.Date == fila.FechaProduccion.Date && x.HoraInicio.Hours == fila.HoraInicio.Hours && x.HoraInicio.Minutes == fila.HoraInicio.Minutes && x.HoraFin.Hours == fila.HoraFin.Hours && x.HoraFin.Minutes == fila.HoraFin.Minutes);
                                        var contadoresIguales = !fila.ContadorFinal.HasValue || filaPareja == null || !filaPareja.ContadorFinal.HasValue || fila.ContadorFinal.Value == filaPareja.ContadorFinal.Value;
                                        <tr class="@(filaPareja?.Capturada == true && contadoresIguales ? "row-complete" : "row-overdue")">
