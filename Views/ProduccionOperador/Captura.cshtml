                btnConfirmarCambioTurno.innerHTML='<i class="fa-solid fa-paper-plane me-1"></i>Enviar turno para recepción';
            }
        });

            function formatoCronometro(segundos){
                const total=Math.max(0,Math.floor(Number(segundos)||0));
                const horas=Math.floor(total/3600);
                const minutos=Math.floor((total%3600)/60);
                const seg=total%60;
                return String(horas).padStart(2,'0')+':'+String(minutos).padStart(2,'0')+':'+String(seg).padStart(2,'0');
            }

