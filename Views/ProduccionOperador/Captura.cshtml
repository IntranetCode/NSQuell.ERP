            if(!selectOperadorEntrante||!box||!nombre||!detalle)return;
            const personaId=Number(selectOperadorEntrante.value||0);
            const operador=obtenerOperadorPorId(personaId);
            if(!operador){
                box.classList.add('d-none');
                nombre.textContent='-';
                detalle.textContent='';
                return;
            }
            const nivel=propiedad(operador,'nivel','Nivel');
            const turno=propiedad(operador,'turnoNombre','TurnoNombre');
            const enEscala=Boolean(propiedad(operador,'enEscala','EnEscala'));
            const sugeridoPorTecnico=Boolean(propiedad(resumenCambioTurno,'sugeridoPorTecnico','SugeridoPorTecnico'));
            const operadorSugeridoId=Number(propiedad(resumenCambioTurno,'operadorSugeridoID','OperadorSugeridoID')||0);
            nombre.textContent=textoSeguro(propiedad(operador,'nombre','Nombre'));
            const partes=[];
            if(nivel!==null&&nivel!==undefined)partes.push('Nivel N'+nivel);
            if(turno)partes.push('Turno '+turno);
            if(sugeridoPorTecnico&&operadorSugeridoId===personaId){
                partes.push('Sugerido por técnico');
            }else{
                partes.push(enEscala?'Programado en escala':'Selección manual autorizada');
            }
            detalle.textContent=partes.join(' · ');
            box.classList.remove('d-none');
        }
