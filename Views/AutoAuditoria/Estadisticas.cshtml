@inject Microsoft.Extensions.Configuration.IConfiguration AaConfig
@model ERP.NSQuell.Servicios.AutoAuditoria.AaEstadisticas
@{
    ViewData["Title"]="Compras · Estadísticas de autoauditoría";
    Layout="~/Views/Shared/_Layout.cshtml";
    var all=Model.Solicitudes;
    var responded=all.Where(x=>x.Respondida.HasValue).ToList();
    var eligible=all.Count(x=>!x.Revocada.HasValue);
    var verde=responded.Sum(x=>(long)x.Verde);var amarillo=responded.Sum(x=>(long)x.Amarillo);var rojo=responded.Sum(x=>(long)x.Rojo);var nb=responded.Sum(x=>(long)x.Nb);var total=verde+amarillo+rojo+nb;
    string Pct(long n,long d)=> (d==0?0:100.0*n/d).ToString("0.##",System.Globalization.CultureInfo.InvariantCulture);
    var meses=responded.GroupBy(x=>x.Respondida!.Value.ToString("yyyy-MM")).OrderByDescending(x=>x.Key).Take(12).OrderBy(x=>x.Key).ToList();
    var empresas=all.GroupBy(x=>x.Empresa.Trim(),StringComparer.OrdinalIgnoreCase).OrderBy(x=>x.Key).ToList();
}
@section Styles {
<style>
.aa-stats{max-width:1450px;margin:auto;padding:18px 4px 48px;--line:rgba(130,155,190,.26)}.aa-stats h1{font-weight:760;letter-spacing:-.035em;font-size:clamp(25px,3vw,36px);margin:0 0 6px}.aa-stats h2{font-size:18px;font-weight:700;margin:0 0 12px}.aa-stats small,.aa-muted{opacity:.75}.aa-kpis{display:grid;grid-template-columns:repeat(auto-fit,minmax(170px,1fr));gap:12px;margin:22px 0}.aa-scard{border:1px solid var(--line);border-radius:16px;padding:19px;background:var(--surface,rgba(130,155,190,.05));margin:0 0 18px}.aa-kpis .aa-scard{margin:0}.aa-kpis strong{display:block;font-size:30px;font-weight:750}.aa-flex{display:flex;align-items:center;justify-content:space-between;flex-wrap:wrap;gap:12px}.aa-charts{display:grid;grid-template-columns:1fr 1fr;gap:18px}.aa-stack{display:flex;height:13px;background:rgba(130,155,190,.2);border-radius:7px;overflow:hidden;min-width:110px}.aa-stack span{height:100%;display:block}.aa-v{background:#24a46d}.aa-a{background:#d5a52a}.aa-r{background:#e25757}.aa-n{background:#8797a9}.aa-scard td,.aa-scard th{font-size:13px;padding:11px 8px;vertical-align:middle}.aa-legend{display:flex;gap:12px;flex-wrap:wrap;font-size:12px;margin:12px 0}.aa-legend i{width:10px;height:10px;border-radius:2px;display:inline-block;margin-right:4px}.aa-month{display:grid;grid-template-columns:75px 1fr 40px;align-items:center;gap:9px;margin:8px 0}.aa-month .bar{height:12px;background:rgba(130,155,190,.2);border-radius:6px;overflow:hidden}.aa-month .bar div{height:100%;background:#2c79be}.aa-num{white-space:nowrap;font-variant-numeric:tabular-nums}.aa-green{color:#23a66c}.aa-red{color:#e25757}
@@media(max-width:850px){.aa-charts{grid-template-columns:1fr}.aa-scard{padding:14px}}
</style>
}
<div class="aa-stats">
<div class="aa-flex"><div><div class="small fw-bold text-uppercase" style="color:#e19b28;letter-spacing:.1em">Compras · SGC · @(string.Equals(AaConfig["AutoAuditoria:Modo"],"PROD",StringComparison.OrdinalIgnoreCase)?"PRODUCCIÓN":"TEST")</div><h1>Estadísticas de autoauditoría</h1><div class="aa-muted">GQ-F-CP02-05 · Ver. 01 · Histórico completo de solicitudes registradas.</div></div><a class="btn btn-outline-secondary" href="@Url.Action("Index","AutoAuditoria")">Volver a autoauditorías</a></div>
<div class="aa-kpis">
<div class="aa-scard"><small>Solicitudes totales</small><strong>@all.Count</strong></div><div class="aa-scard"><small>Respondidas</small><strong class="aa-green">@responded.Count</strong></div><div class="aa-scard"><small>Pendientes vigentes</small><strong>@all.Count(x=>x.Estado=="Pendiente")</strong></div><div class="aa-scard"><small>Vencidas sin respuesta</small><strong>@all.Count(x=>x.Estado=="Vencida")</strong></div><div class="aa-scard"><small>Revocadas</small><strong>@all.Count(x=>x.Estado=="Revocada")</strong></div><div class="aa-scard"><small>Tasa de respuesta</small><strong>@Pct(responded.Count,eligible)%</strong><small>Excluye revocadas · @(responded.Count)/@eligible</small></div><div class="aa-scard"><small>Evaluaciones con rojo</small><strong class="aa-red">@responded.Count(x=>x.Rojo>0)</strong></div>
</div>
<div class="aa-charts">
<section class="aa-scard"><h2>Distribución de valoraciones</h2><small>@total respuestas individuales de @responded.Count evaluaciones.</small><div class="aa-stack mt-3" role="img" aria-label="Distribución por valoración"><span class="aa-v" style="width:@Pct(verde,total)%"></span><span class="aa-a" style="width:@Pct(amarillo,total)%"></span><span class="aa-r" style="width:@Pct(rojo,total)%"></span><span class="aa-n" style="width:@Pct(nb,total)%"></span></div><div class="aa-legend"><span><i class="aa-v"></i>Verde @verde (@Pct(verde,total)%)</span><span><i class="aa-a"></i>Amarillo @amarillo (@Pct(amarillo,total)%)</span><span><i class="aa-r"></i>Rojo @rojo (@Pct(rojo,total)%)</span><span><i class="aa-n"></i>n.b. @nb (@Pct(nb,total)%)</span></div><small>Clasificación final pendiente de validación por SGC. Los conteos no equivalen a una aprobación del proveedor.</small></section>
<section class="aa-scard"><h2>Respuestas por mes (UTC)</h2><small>Últimos 12 meses con actividad registrada.</small>@if(meses.Count==0){<p class="mt-3 aa-muted">Aún no hay respuestas.</p>}else{var max=meses.Max(x=>x.Count());foreach(var m in meses){<div class="aa-month"><span>@m.Key</span><div class="bar"><div style="width:@Pct(m.Count(),max)%"></div></div><b class="text-end">@m.Count()</b></div>}}</section>
</div>
<section class="aa-scard"><div class="aa-flex"><div><h2>Resultados por punto</h2><small>18 requerimientos · solo evaluaciones respondidas.</small></div><div class="aa-legend"><span><i class="aa-v"></i>V</span><span><i class="aa-a"></i>A</span><span><i class="aa-r"></i>R</span><span><i class="aa-n"></i>n.b.</span></div></div><div class="table-responsive"><table class="table"><thead><tr><th>Punto</th><th>Requerimiento</th><th>Distribución</th><th>V</th><th>A</th><th>R</th><th>n.b.</th></tr></thead><tbody>@foreach(var p in Model.Puntos){<tr><td class="aa-num fw-semibold">@p.Punto @(p.Asterisco?"*":"")</td><td>@p.Texto</td><td><div class="aa-stack" aria-label="@p.Verde verde, @p.Amarillo amarillo, @p.Rojo rojo, @p.Nb no evaluable"><span class="aa-v" style="width:@Pct(p.Verde,p.Total)%"></span><span class="aa-a" style="width:@Pct(p.Amarillo,p.Total)%"></span><span class="aa-r" style="width:@Pct(p.Rojo,p.Total)%"></span><span class="aa-n" style="width:@Pct(p.Nb,p.Total)%"></span></div></td><td>@p.Verde</td><td>@p.Amarillo</td><td class="aa-red">@p.Rojo</td><td>@p.Nb</td></tr>}</tbody></table></div></section>
<section class="aa-scard"><h2>Histórico por empresa</h2><small>Consolidado por razón social registrada; las invitaciones manuales con nombres diferentes se muestran por separado.</small><div class="table-responsive"><table class="table"><thead><tr><th>Empresa</th><th>Solicitudes</th><th>Respondidas</th><th>Pendientes</th><th>Vencidas</th><th>Con rojo</th><th>Última respuesta UTC</th></tr></thead><tbody>@foreach(var e in empresas){<tr><td class="fw-semibold">@e.Key</td><td>@e.Count()</td><td>@e.Count(x=>x.Respondida.HasValue)</td><td>@e.Count(x=>x.Estado=="Pendiente")</td><td>@e.Count(x=>x.Estado=="Vencida")</td><td>@e.Count(x=>x.Rojo>0)</td><td>@(e.Max(x=>x.Respondida)?.ToString("dd/MM/yyyy HH:mm")??"—")</td></tr>}@if(empresas.Count==0){<tr><td colspan="7" class="text-center aa-muted">Sin solicitudes registradas.</td></tr>}</tbody></table></div></section>
@if(Model.EsAdministrador){<section class="aa-scard"><h2>Usuarios con acceso efectivo</h2><p class="small">Solo visible al administrador. Lista actual de usuarios activos que cumplen el control de departamento/rol y cuentan con permiso efectivo del submenú. Cerrar e iniciar sesión si cambió el permiso.</p><div class="table-responsive"><table class="table"><thead><tr><th>ID</th><th>Usuario</th><th>Nombre</th><th>Departamento</th><th>Rol</th></tr></thead><tbody>@foreach(var a in Model.Accesos){<tr><td>@a.Id</td><td>@a.Usuario</td><td>@a.Nombre</td><td>@a.Departamento</td><td>@a.Rol</td></tr>}</tbody></table></div></section>}
</div>
