@model ERP.NSQuell.Models.PlaneacionProgramaNecesidadFiltroVm
@using ERP.NSQuell.Models
@using System.Linq
@using System.Collections.Generic

@functions {
    public static string Txt(string? value) => string.IsNullOrWhiteSpace(value) ? "-" : value;
    public static string F(DateTime value) => value == DateTime.MinValue ? "-" : value.ToString("dd/MM/yyyy");
    public static string F(DateTime? value) => value.HasValue ? value.Value.ToString("dd/MM/yyyy") : "-";
    public static string N0(int? value) => value.HasValue ? value.Value.ToString("N0") : "0";
    public static string N0(decimal? value) => value.HasValue ? value.Value.ToString("N0") : "0";
    public static string D2(decimal? value) => value.HasValue ? value.Value.ToString("N2") : "0.00";
    public static string D4(decimal? value) => value.HasValue ? value.Value.ToString("N4") : "0.0000";

    public static bool NecesitaProduccion(PlaneacionProgramaNecesidadVm x) => (x.PiezasAProducir ?? 0) > 0;
    public static bool StockOk(PlaneacionProgramaNecesidadVm x) => (x.PiezasDesdePT ?? 0) > 0 || !NecesitaProduccion(x);

    public static bool MpOk(PlaneacionProgramaNecesidadVm x)
    {
        if (!NecesitaProduccion(x)) return true;
        return (x.MPDisponibleKg ?? 0) >= (x.MPRequeridaKg ?? 0) && (x.MPRequeridaKg ?? 0) > 0;
    }

    public static bool EmbalajeOk(PlaneacionProgramaNecesidadVm x)
    {
        if (!NecesitaProduccion(x)) return true;
        return (x.EmbalajeDisponible ?? 0) >= (x.EmbalajeRequerido ?? 0) && (x.EmbalajeRequerido ?? 0) > 0;
    }

    public static bool MoldeOk(PlaneacionProgramaNecesidadVm x) => !NecesitaProduccion(x) || x.MoldeID.HasValue;
    public static bool MaquinaOk(PlaneacionProgramaNecesidadVm x) => !NecesitaProduccion(x) || x.MaquinaSugeridaID.HasValue;
    public static bool MaterialOk(PlaneacionProgramaNecesidadVm x) => !NecesitaProduccion(x) || x.MaterialID.HasValue || !string.IsNullOrWhiteSpace(x.MaterialCodigo);
    public static bool CavidadesOk(PlaneacionProgramaNecesidadVm x) => !NecesitaProduccion(x) || ((x.Cavidades ?? 0) > 0);
    public static bool CicloOk(PlaneacionProgramaNecesidadVm x) => !NecesitaProduccion(x) || !string.IsNullOrWhiteSpace(x.Ciclo);
    public static bool ObjetivoOk(PlaneacionProgramaNecesidadVm x) => !NecesitaProduccion(x) || ((x.ObjetivoHora ?? 0) > 0);
    public static bool PesoOk(PlaneacionProgramaNecesidadVm x) => !NecesitaProduccion(x) || ((x.PesoBrutoPieza ?? 0) > 0);

    public static bool DatosTecnicosOk(PlaneacionProgramaNecesidadVm x)
    {
        return MaterialOk(x) && MoldeOk(x) && MaquinaOk(x) && CavidadesOk(x) && CicloOk(x) && ObjetivoOk(x) && PesoOk(x);
    }

    public static bool ListoCambioMolde(PlaneacionProgramaNecesidadVm x)
    {
        return !x.ProgramaProduccionID.HasValue && NecesitaProduccion(x) && DatosTecnicosOk(x) && MpOk(x) && EmbalajeOk(x);
    }

    public static bool PendienteAbasto(PlaneacionProgramaNecesidadVm x)
    {
        return !x.ProgramaProduccionID.HasValue && NecesitaProduccion(x) && DatosTecnicosOk(x) && (!MpOk(x) || !EmbalajeOk(x));
    }

    public static bool PendienteDatosTecnicos(PlaneacionProgramaNecesidadVm x)
    {
        return !x.ProgramaProduccionID.HasValue && NecesitaProduccion(x) && !DatosTecnicosOk(x);
    }

    public static bool CubiertoOProgramado(PlaneacionProgramaNecesidadVm x) => x.ProgramaProduccionID.HasValue || !NecesitaProduccion(x);
    public static string ClienteNombre(PlaneacionProgramaNecesidadVm x) => string.IsNullOrWhiteSpace(x.ClienteNombre) ? "Sin cliente" : x.ClienteNombre!;

    public static string ParteClave(PlaneacionProgramaNecesidadVm x)
    {
        if (!string.IsNullOrWhiteSpace(x.NumeroParte)) return x.NumeroParte!;
        if (!string.IsNullOrWhiteSpace(x.ReferenciaSAP)) return x.ReferenciaSAP!;
        return "-";
    }

    public static string EstadoTexto(PlaneacionProgramaNecesidadVm x)
    {
        if (x.ProgramaProduccionID.HasValue) return "Ya programado";
        if (!NecesitaProduccion(x)) return "Cubierto";
        if (ListoCambioMolde(x)) return "Listo para Cambio de Molde";
        if (PendienteAbasto(x)) return "Pendiente de abasto";
        return "Pendiente de datos técnicos";
    }

    public static string EstadoClase(PlaneacionProgramaNecesidadVm x)
    {
        if (ListoCambioMolde(x)) return "estado-ok";
        if (PendienteAbasto(x)) return "estado-warn";
        if (PendienteDatosTecnicos(x)) return "estado-danger";
        return "estado-muted";
    }

    public static string CardClase(PlaneacionProgramaNecesidadVm x)
    {
        if (ListoCambioMolde(x)) return "card-ok";
        if (PendienteAbasto(x)) return "card-warn";
        if (PendienteDatosTecnicos(x)) return "card-danger";
        return "card-muted";
    }

    public static string CheckClase(bool ok) => ok ? "check ok" : "check no";
    public static string CheckIcono(bool ok) => ok ? "fa-circle-check" : "fa-circle-xmark";
    public static string CollapseId(string prefix, int a) => prefix + "_" + a.ToString();
    public static string ModalId(PlaneacionProgramaNecesidadVm item) => "modalCambio_" + item.ReleaseDetalleID.ToString();

    public static string DataSearch(PlaneacionProgramaNecesidadVm item)
    {
        return string.Join(" ",
            item.FolioRelease ?? string.Empty,
            item.ClienteNombre ?? string.Empty,
            item.NumeroParte ?? string.Empty,
            item.ReferenciaSAP ?? string.Empty,
            item.DesignacionDescripcionSAP ?? string.Empty,
            item.MaterialCodigo ?? string.Empty,
            item.MaterialDescripcion ?? string.Empty,
            item.MoldeCodigo ?? string.Empty,
            item.MaquinaSugeridaCodigo ?? string.Empty,
            item.MaquinaSugeridaNombre ?? string.Empty,
            item.MensajeCapacidad ?? string.Empty
        ).ToLowerInvariant();
    }

    public static DateTime PrioridadFecha(PlaneacionProgramaNecesidadVm item)
    {
        return item.FechaRequerida == DateTime.MinValue ? DateTime.MaxValue : item.FechaRequerida;
    }

    public static int PrioridadEntrada(PlaneacionProgramaNecesidadVm item)
    {
        return item.ReleaseDetalleID;
    }

    public static string PrioridadTexto(PlaneacionProgramaNecesidadVm item)
    {
        var fecha = item.FechaRequerida == DateTime.MinValue
            ? "Sin fecha"
            : item.FechaRequerida.ToString("dd/MM/yyyy");

        return fecha + " · Entrada " + item.ReleaseDetalleID.ToString();
    }

    public static string ReleaseKey(PlaneacionProgramaNecesidadVm item)
    {
        return string.IsNullOrWhiteSpace(item.FolioRelease)
            ? "SIN_RELEASE"
            : item.FolioRelease.Replace(" ", "_").Replace("/", "_").Replace(".", "_").Replace("-", "_");
    }

    public static string ReleaseTexto(PlaneacionProgramaNecesidadVm item)
    {
        return string.IsNullOrWhiteSpace(item.FolioRelease)
            ? "Sin release"
            : item.FolioRelease!;
    }

    public sealed class SeccionUi
    {
        public string Titulo { get; set; } = "";
        public string Sub { get; set; } = "";
        public string Icono { get; set; } = "";
        public string Clase { get; set; } = "";
        public bool Open { get; set; }
        public List<PlaneacionProgramaNecesidadVm> Items { get; set; } = new();
    }
}

@{
    Layout = null;
    var necesidades = Model.Necesidades ?? new List<PlaneacionProgramaNecesidadVm>();

    // Prioridad FIFO de planeación:
    // 1) Primero lo que tiene FechaRequerida más cercana.
    // 2) Si empatan, gana el ReleaseDetalleID más antiguo.
    var listos = necesidades.Where(ListoCambioMolde).OrderBy(PrioridadFecha).ThenBy(PrioridadEntrada).ToList();
    var abasto = necesidades.Where(PendienteAbasto).OrderBy(PrioridadFecha).ThenBy(PrioridadEntrada).ToList();
    var datosTecnicos = necesidades.Where(PendienteDatosTecnicos).OrderBy(PrioridadFecha).ThenBy(PrioridadEntrada).ToList();
    var resueltos = necesidades.Where(CubiertoOProgramado).OrderBy(PrioridadFecha).ThenBy(PrioridadEntrada).ToList();

    var secciones = new List<SeccionUi>
    {
        new SeccionUi { Titulo = "Listos para Programa Cambio de Molde", Sub = "Renglones liberados para definir cambio, arranque, máquina y molde final.", Items = listos, Open = true, Icono = "fa-circle-check", Clase = "sec-ok" },
        new SeccionUi { Titulo = "Pendientes de abastecimiento", Sub = "Tienen datos técnicos completos, pero falta MP o embalaje.", Items = abasto, Open = false, Icono = "fa-truck-ramp-box", Clase = "sec-warn" },
        new SeccionUi { Titulo = "Pendientes de datos técnicos", Sub = "Falta molde, material, cavidades, ciclo, máquina, objetivo/hra o peso bruto.", Items = datosTecnicos, Open = false, Icono = "fa-screwdriver-wrench", Clase = "sec-danger" },
        new SeccionUi { Titulo = "Cubiertas o ya programadas", Sub = "Renglones ya cubiertos con stock o ya enviados a máquinas.", Items = resueltos, Open = false, Icono = "fa-box-check", Clase = "sec-muted" }
    };
}

<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <title>Programa de Planeación</title>
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet" />
    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.2/css/all.min.css" rel="stylesheet" />

    <style>
        :root {
            --azul: #0b4ea2;
            --azul2: #063a78;
            --azul-soft: #eef6ff;
            --linea: #d9e3f1;
            --texto: #1f2937;
            --muted: #667085;
            --ok: #0f7a4f;
            --ok-bg: #ebfff4;
            --warn: #b86b00;
            --warn-bg: #fff7e6;
            --danger: #b42318;
            --danger-bg: #fff1f0;
            --gray-bg: #f4f5f7;
            --shadow: 0 16px 36px rgba(15,23,42,.08);
            --shadow-soft: 0 8px 22px rgba(15,23,42,.05)
        }

        * {
            box-sizing: border-box
        }

        body {
            margin: 0;
            background: radial-gradient(circle at 0% 0%,rgba(11,78,162,.10),transparent 32%),linear-gradient(180deg,#f8fbff 0%,#edf2f8 100%);
            font-family: "Segoe UI",Arial,sans-serif;
            color: var(--texto)
        }

        .page {
            max-width: 1760px;
            margin: 0 auto;
            padding: 24px
        }

        .hero {
            border-radius: 28px;
            padding: 30px;
            margin-bottom: 18px;
            color: #fff;
            background: linear-gradient(135deg,rgba(11,78,162,.98),rgba(6,58,120,.98));
            box-shadow: var(--shadow)
        }

            .hero h1 {
                margin: 0 0 8px 0;
                font-size: 2rem;
                font-weight: 950
            }

            .hero p {
                margin: 0;
                opacity: .92;
                max-width: 1120px
            }

        .hero-actions {
            display: flex;
            gap: 10px;
            flex-wrap: wrap;
            margin-top: 16px
        }

        .btn-glass {
            color: #fff;
            text-decoration: none;
            border: 1px solid rgba(255,255,255,.35);
            background: rgba(255,255,255,.13);
            border-radius: 14px;
            padding: 9px 14px;
            font-weight: 850;
            display: inline-flex;
            gap: 8px;
            align-items: center
        }

            .btn-glass:hover {
                color: var(--azul);
                background: #fff
            }

        .filter-card {
            background: rgba(255,255,255,.94);
            border: 1px solid var(--linea);
            border-radius: 24px;
            padding: 18px;
            margin-bottom: 18px;
            box-shadow: var(--shadow-soft);
            backdrop-filter: blur(14px)
        }

        .form-label {
            color: var(--muted);
            font-size: .78rem;
            font-weight: 950;
            text-transform: uppercase;
            letter-spacing: .04em
        }

        .form-control, .form-select {
            border-radius: 14px;
            border: 1px solid var(--linea);
            padding: 10px 12px;
            min-height: 45px
        }

        .btn-main {
            border: none;
            border-radius: 14px;
            padding: 10px 14px;
            min-height: 45px;
            color: #fff;
            background: linear-gradient(135deg,var(--azul),var(--azul2));
            font-weight: 900;
            text-decoration: none;
            display: inline-flex;
            gap: 8px;
            align-items: center;
            justify-content: center
        }

            .btn-main:hover {
                color: #fff;
                opacity: .96
            }

        .quick-btn {
            border-radius: 999px;
            padding: 9px 13px;
            border: 1px solid var(--linea);
            background: #fff;
            font-size: .83rem;
            font-weight: 950;
            text-decoration: none;
            color: var(--azul2);
            display: inline-flex;
            align-items: center;
            gap: 7px
        }

            .quick-btn:hover {
                border-color: rgba(11,78,162,.35);
                background: var(--azul-soft);
                color: var(--azul)
            }

        .quick-ok {
            color: var(--ok);
            border-color: #bcebd3;
            background: var(--ok-bg)
        }

        .quick-warn {
            color: var(--warn);
            border-color: #f2d59a;
            background: var(--warn-bg)
        }

        .quick-danger {
            color: var(--danger);
            border-color: #f3b8b3;
            background: var(--danger-bg)
        }

        .section {
            background: #fff;
            border: 1px solid var(--linea);
            border-radius: 26px;
            overflow: hidden;
            box-shadow: var(--shadow-soft);
            margin-bottom: 18px
        }

            .section.sec-ok {
                border-color: #bcebd3
            }

            .section.sec-warn {
                border-color: #f2d59a
            }

            .section.sec-danger {
                border-color: #f3b8b3
            }

        .section-head {
            padding: 18px 20px;
            border-bottom: 1px solid #edf1f7;
            display: flex;
            justify-content: space-between;
            gap: 14px;
            align-items: center;
            flex-wrap: wrap;
            cursor: pointer;
            background: linear-gradient(180deg,#fff,#f8fbff)
        }

        .section-title {
            margin: 0;
            font-size: 1.12rem;
            font-weight: 950;
            color: var(--azul2);
            display: flex;
            align-items: center;
            gap: 9px
        }

        .section-icon {
            width: 36px;
            height: 36px;
            border-radius: 14px;
            background: var(--azul-soft);
            color: var(--azul);
            display: inline-flex;
            align-items: center;
            justify-content: center
        }

        .section-sub {
            margin-top: 4px;
            color: var(--muted);
            font-size: .9rem
        }

        .section-body {
            padding: 16px
        }

        .count-pill, .summary-pill {
            border-radius: 999px;
            padding: 7px 11px;
            font-size: .78rem;
            font-weight: 950;
            background: #eef4ff;
            color: var(--azul);
            border: 1px solid #cfe0ff;
            white-space: nowrap;
            display: inline-flex;
            align-items: center;
            gap: 6px
        }

        .summary-pill {
            background: #fff;
            color: #344054;
            border-color: var(--linea)
        }

        .client-grid {
            display: grid;
            grid-template-columns: repeat(auto-fill,minmax(330px,1fr));
            gap: 12px;
        }

        .client-panel {
            border: 1px solid var(--linea);
            background: linear-gradient(180deg,#ffffff,#fbfdff);
            border-radius: 24px;
            box-shadow: 0 8px 22px rgba(15,23,42,.045);
            overflow: hidden;
        }

        .client-panel-head {
            width: 100%;
            border: 0;
            background: transparent;
            padding: 16px;
            text-align: left;
            display: flex;
            justify-content: space-between;
            align-items: flex-start;
            gap: 12px;
            cursor: pointer;
        }

            .client-panel-head:hover {
                background: #f6faff;
            }

        .client-name {
            color: #102a52;
            font-size: 1rem;
            font-weight: 950;
            line-height: 1.2;
        }

        .client-meta {
            color: var(--muted);
            font-size: .82rem;
            font-weight: 750;
            margin-top: 4px;
        }

        .client-priority {
            color: var(--azul2);
            background: var(--azul-soft);
            border: 1px solid #cfe0ff;
            border-radius: 999px;
            padding: 6px 10px;
            font-size: .72rem;
            font-weight: 950;
            white-space: nowrap;
            display: inline-flex;
            gap: 6px;
            align-items: center;
        }

        .client-body {
            border-top: 1px solid #edf1f7;
            padding: 14px;
            background: #fbfdff;
        }

        .release-toolbar {
            display: flex;
            gap: 8px;
            align-items: center;
            overflow-x: auto;
            padding: 0 0 12px 0;
            margin-bottom: 12px;
            border-bottom: 1px solid #e6eef9;
        }

        .release-toolbar-label {
            flex: 0 0 auto;
            color: var(--muted);
            font-size: .72rem;
            font-weight: 950;
            text-transform: uppercase;
            letter-spacing: .04em;
            padding: 7px 0;
        }

        .release-btn {
            flex: 0 0 auto;
            border: 1px solid #cfe0ff;
            background: #ffffff;
            color: var(--azul2);
            border-radius: 999px;
            padding: 7px 10px;
            font-size: .75rem;
            font-weight: 950;
            display: inline-flex;
            align-items: center;
            gap: 6px;
            white-space: nowrap;
        }

            .release-btn:hover,
            .release-btn.active {
                background: var(--azul);
                border-color: var(--azul);
                color: #ffffff;
            }

        .release-count {
            border-radius: 999px;
            padding: 2px 7px;
            font-size: .68rem;
            font-weight: 950;
            background: rgba(255,255,255,.75);
            color: inherit;
            border: 1px solid rgba(255,255,255,.55);
        }

        .release-summary {
            margin-left: auto;
            flex: 0 0 auto;
            color: var(--muted);
            font-size: .75rem;
            font-weight: 850;
            padding: 7px 0;
            white-space: nowrap;
        }

        .hidden-by-release {
            display: none !important;
        }

        .cards-grid {
            display: grid;
            grid-template-columns: repeat(auto-fill,minmax(205px,1fr));
            gap: 9px
        }

        .need-card {
            background: #fff;
            border: 1px solid var(--linea);
            border-radius: 18px;
            padding: 12px;
            box-shadow: 0 6px 16px rgba(15,23,42,.040);
            position: relative;
            overflow: hidden;
            transition: .16s ease;
            min-height: 154px
        }

            .need-card:hover {
                transform: translateY(-3px);
                box-shadow: var(--shadow)
            }

            .need-card:before {
                content: "";
                position: absolute;
                left: 0;
                top: 0;
                bottom: 0;
                width: 7px;
                background: var(--azul)
            }

        .card-ok:before {
            background: var(--ok)
        }

        .card-warn:before {
            background: var(--warn)
        }

        .card-danger:before {
            background: var(--danger)
        }

        .card-muted:before {
            background: #98A2B3
        }

        .need-head {
            display: flex;
            justify-content: space-between;
            gap: 9px;
            align-items: flex-start;
            margin-bottom: 10px
        }

        .need-title {
            color: #102a52;
            font-weight: 950;
            font-size: .95rem;
            line-height: 1.2
        }

        .need-sub {
            color: var(--muted);
            font-size: .76rem;
            font-weight: 700;
            margin-top: 3px;
            display: -webkit-box;
            -webkit-line-clamp: 2;
            -webkit-box-orient: vertical;
            overflow: hidden
        }

        .estado {
            border-radius: 999px;
            padding: 5px 8px;
            font-size: .68rem;
            font-weight: 950;
            white-space: nowrap;
            border: 1px solid transparent;
            display: inline-flex;
            align-items: center;
            gap: 5px
        }

        .estado-ok {
            background: var(--ok-bg);
            color: var(--ok);
            border-color: #bcebd3
        }

        .estado-warn {
            background: var(--warn-bg);
            color: var(--warn);
            border-color: #f2d59a
        }

        .estado-danger {
            background: var(--danger-bg);
            color: var(--danger);
            border-color: #f3b8b3
        }

        .estado-muted {
            background: var(--gray-bg);
            color: #5b6472;
            border-color: #d8dde5
        }

        .data-grid {
            display: grid;
            grid-template-columns: repeat(2,minmax(0,1fr));
            gap: 7px
        }

        .data-box {
            border: 1px solid #edf1f7;
            background: #fbfdff;
            border-radius: 12px;
            padding: 8px;
            min-width: 0
        }

        .data-label {
            color: var(--muted);
            font-size: .61rem;
            font-weight: 950;
            text-transform: uppercase;
            letter-spacing: .04em;
            white-space: nowrap
        }

        .data-value {
            margin-top: 2px;
            color: #111827;
            font-size: .80rem;
            font-weight: 950;
            overflow: hidden;
            text-overflow: ellipsis;
            white-space: nowrap
        }

        .validation-row {
            display: flex;
            flex-wrap: wrap;
            gap: 4px;
            margin-top: 10px
        }

        .check {
            border-radius: 999px;
            padding: 4px 7px;
            font-size: .64rem;
            font-weight: 950;
            border: 1px solid transparent;
            display: inline-flex;
            align-items: center;
            gap: 4px;
            white-space: nowrap
        }

            .check.ok {
                background: var(--ok-bg);
                color: var(--ok);
                border-color: #bcebd3
            }

            .check.no {
                background: var(--danger-bg);
                color: var(--danger);
                border-color: #f3b8b3
            }

        .msg {
            color: #35517a;
            font-size: .74rem;
            font-weight: 650;
            margin-top: 6px;
            min-height: 18px;
            white-space: nowrap;
            overflow: hidden;
            text-overflow: ellipsis
        }

        .card-actions {
            display: flex;
            gap: 8px;
            flex-wrap: wrap;
            align-items: center;
            justify-content: space-between;
            margin-top: 10px;
            padding-top: 10px;
            border-top: 1px solid #edf1f7
        }

        .btn-card-main, .btn-card-light {
            border-radius: 12px;
            padding: 7px 9px;
            font-size: .78rem;
            font-weight: 950;
            text-decoration: none;
            display: inline-flex;
            align-items: center;
            gap: 6px
        }

        .btn-card-main {
            border: none;
            color: #fff;
