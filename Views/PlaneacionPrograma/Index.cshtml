@model ERP.NSQuell.Models.PlaneacionProgramaNecesidadFiltroVm
@using ERP.NSQuell.Models
@using System.Linq
@using System.Collections.Generic

@functions {
    public static string Txt(string? value)
    {
        return string.IsNullOrWhiteSpace(value) ? "-" : value;
    }

    public static string F(DateTime? value)
    {
        return value.HasValue ? value.Value.ToString("dd/MM/yyyy") : "-";
    }

    public static string N0(int? value)
    {
        return value.HasValue ? value.Value.ToString("N0") : "0";
    }

    public static string D2(decimal? value)
    {
        return value.HasValue ? value.Value.ToString("N2") : "0.00";
    }

    public static string D4(decimal? value)
    {
        return value.HasValue ? value.Value.ToString("N4") : "0.0000";
    }

    public static bool NecesitaProduccion(PlaneacionProgramaNecesidadVm x)
    {
        return (x.PiezasAProducir ?? 0) > 0;
    }

    public static bool StockOk(PlaneacionProgramaNecesidadVm x)
    {
        return (x.PiezasDesdePT ?? 0) > 0 || !NecesitaProduccion(x);
    }

    public static bool MpOk(PlaneacionProgramaNecesidadVm x)
    {
        if (!NecesitaProduccion(x))
            return true;

        return (x.MPDisponibleKg ?? 0) >= (x.MPRequeridaKg ?? 0)
            && (x.MPRequeridaKg ?? 0) > 0;
    }

    public static bool EmbalajeOk(PlaneacionProgramaNecesidadVm x)
    {
        if (!NecesitaProduccion(x))
            return true;

        return (x.EmbalajeDisponible ?? 0) >= (x.EmbalajeRequerido ?? 0)
            && (x.EmbalajeRequerido ?? 0) > 0;
    }

    public static bool MoldeOk(PlaneacionProgramaNecesidadVm x)
    {
        return !NecesitaProduccion(x) || x.MoldeID.HasValue;
    }

    public static bool MaquinaOk(PlaneacionProgramaNecesidadVm x)
    {
        return !NecesitaProduccion(x) || x.MaquinaSugeridaID.HasValue;
    }

    public static bool MaterialOk(PlaneacionProgramaNecesidadVm x)
    {
        return !NecesitaProduccion(x) || x.MaterialID.HasValue || !string.IsNullOrWhiteSpace(x.MaterialCodigo);
    }

    public static bool CavidadesOk(PlaneacionProgramaNecesidadVm x)
    {
        return !NecesitaProduccion(x) || ((x.Cavidades ?? 0) > 0);
    }

    public static bool CicloOk(PlaneacionProgramaNecesidadVm x)
    {
        return !NecesitaProduccion(x) || !string.IsNullOrWhiteSpace(x.Ciclo);
    }

    public static bool ObjetivoOk(PlaneacionProgramaNecesidadVm x)
    {
        return !NecesitaProduccion(x) || ((x.ObjetivoHora ?? 0) > 0);
    }

    public static bool PesoOk(PlaneacionProgramaNecesidadVm x)
    {
        return !NecesitaProduccion(x) || ((x.PesoBrutoPieza ?? 0) > 0);
    }

    public static bool DatosTecnicosOk(PlaneacionProgramaNecesidadVm x)
    {
        return MaterialOk(x)
            && MoldeOk(x)
            && MaquinaOk(x)
            && CavidadesOk(x)
            && CicloOk(x)
            && ObjetivoOk(x)
            && PesoOk(x);
    }

    public static bool ListoCambioMolde(PlaneacionProgramaNecesidadVm x)
    {
        return !x.ProgramaProduccionID.HasValue
            && NecesitaProduccion(x)
            && DatosTecnicosOk(x)
            && MpOk(x)
            && EmbalajeOk(x);
    }

    public static bool PendienteAbasto(PlaneacionProgramaNecesidadVm x)
    {
        return !x.ProgramaProduccionID.HasValue
            && NecesitaProduccion(x)
            && DatosTecnicosOk(x)
            && (!MpOk(x) || !EmbalajeOk(x));
    }

    public static bool PendienteDatosTecnicos(PlaneacionProgramaNecesidadVm x)
    {
        return !x.ProgramaProduccionID.HasValue
            && NecesitaProduccion(x)
            && !DatosTecnicosOk(x);
    }

    public static bool CubiertoOProgramado(PlaneacionProgramaNecesidadVm x)
    {
        return x.ProgramaProduccionID.HasValue || !NecesitaProduccion(x);
    }

    public static string ClienteNombre(PlaneacionProgramaNecesidadVm x)
    {
        return string.IsNullOrWhiteSpace(x.ClienteNombre) ? "Sin cliente" : x.ClienteNombre!;
    }

    public static string ParteClave(PlaneacionProgramaNecesidadVm x)
    {
        if (!string.IsNullOrWhiteSpace(x.NumeroParte))
            return x.NumeroParte!;

        if (!string.IsNullOrWhiteSpace(x.ReferenciaSAP))
            return x.ReferenciaSAP!;

        return "-";
    }

    public static string EstadoTexto(PlaneacionProgramaNecesidadVm x)
    {
        if (x.ProgramaProduccionID.HasValue)
            return "Ya programado";

        if (!NecesitaProduccion(x))
            return "Cubierto";

        if (ListoCambioMolde(x))
            return "Listo para Cambio de Molde";

        if (PendienteAbasto(x))
            return "Pendiente de abasto";

        return "Pendiente de datos técnicos";
    }

    public static string EstadoClase(PlaneacionProgramaNecesidadVm x)
    {
        if (ListoCambioMolde(x))
            return "estado-ok";

        if (PendienteAbasto(x))
            return "estado-warn";

        if (PendienteDatosTecnicos(x))
            return "estado-danger";

        return "estado-muted";
    }

    public static string CheckClase(bool ok)
    {
        return ok ? "check ok" : "check no";
    }

    public static string CheckIcono(bool ok)
    {
        return ok ? "fa-circle-check" : "fa-circle-xmark";
    }

    public static string CollapseId(string prefix, int a, int b = 0, int c = 0)
    {
        return prefix + "_" + a.ToString() + "_" + b.ToString() + "_" + c.ToString();
    }
}

@{
    Layout = null;

    var necesidades = Model.Necesidades ?? new List<PlaneacionProgramaNecesidadVm>();

    var listos = necesidades
        .Where(ListoCambioMolde)
        .OrderBy(x => ClienteNombre(x))
        .ThenBy(x => ParteClave(x))
        .ThenBy(x => x.FechaRequerida)
        .ToList();

    var abasto = necesidades
        .Where(PendienteAbasto)
        .OrderBy(x => ClienteNombre(x))
        .ThenBy(x => ParteClave(x))
        .ThenBy(x => x.FechaRequerida)
        .ToList();

    var datosTecnicos = necesidades
        .Where(PendienteDatosTecnicos)
        .OrderBy(x => ClienteNombre(x))
        .ThenBy(x => ParteClave(x))
        .ThenBy(x => x.FechaRequerida)
        .ToList();

    var resueltos = necesidades
        .Where(CubiertoOProgramado)
        .OrderBy(x => ClienteNombre(x))
        .ThenBy(x => ParteClave(x))
        .ThenBy(x => x.FechaRequerida)
        .ToList();

    var totalAProducir = necesidades.Sum(x => x.PiezasAProducir ?? 0);
    var totalStock = necesidades.Sum(x => x.PiezasDesdePT ?? 0);
    var totalHoras = necesidades.Sum(x => x.HorasNecesarias ?? 0);
}

<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <title>Programa de Planeación</title>
    <meta name="viewport" content="width=device-width, initial-scale=1" />

    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet" />
    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.2/css/all.min.css" rel="stylesheet" />

    <style>
        :root {
            --azul: #0b4ea2;
            --azul2: #063a78;
            --fondo: #f3f6fb;
            --card: #ffffff;
            --linea: #d9e3f1;
            --texto: #1f2937;
            --muted: #667085;
            --ok: #0f7a4f;
            --ok-bg: #ebfff4;
            --warn: #b86b00;
            --warn-bg: #fff7e6;
            --danger: #b42318;
            --danger-bg: #fff1f0;
            --gray-bg: #f4f5f7;
            --shadow: 0 16px 36px rgba(15, 23, 42, .08);
        }

        body {
            margin: 0;
            background: radial-gradient(circle at 0% 0%, rgba(11, 78, 162, .10), transparent 32%), linear-gradient(180deg, #f8fbff 0%, #edf2f8 100%);
            font-family: "Segoe UI", Arial, sans-serif;
            color: var(--texto);
        }

        .page {
            max-width: 1720px;
            margin: 0 auto;
            padding: 24px;
        }

        .hero {
            border-radius: 26px;
            padding: 28px 30px;
            margin-bottom: 20px;
            color: #fff;
            background: linear-gradient(135deg, var(--azul), var(--azul2));
            box-shadow: var(--shadow);
        }

            .hero h1 {
                margin: 0 0 8px 0;
                font-size: 2rem;
                font-weight: 900;
            }

            .hero p {
                margin: 0;
                opacity: .92;
                max-width: 1050px;
            }

        .hero-actions {
            display: flex;
            gap: 10px;
            flex-wrap: wrap;
            margin-top: 16px;
        }

        .btn-glass {
            color: #fff;
            text-decoration: none;
            border: 1px solid rgba(255,255,255,.35);
            background: rgba(255,255,255,.13);
            border-radius: 14px;
            padding: 9px 14px;
            font-weight: 800;
        }

            .btn-glass:hover {
                color: var(--azul);
                background: #fff;
            }

        .kpis {
            display: grid;
            grid-template-columns: repeat(6, minmax(0, 1fr));
            gap: 12px;
            margin-bottom: 18px;
        }

        .kpi {
            background: var(--card);
            border: 1px solid var(--linea);
            border-radius: 18px;
            padding: 15px;
            box-shadow: 0 8px 22px rgba(15,23,42,.05);
        }

            .kpi .label {
                color: var(--muted);
                font-size: .76rem;
                font-weight: 900;
                text-transform: uppercase;
                letter-spacing: .04em;
            }

            .kpi .value {
                margin-top: 5px;
                font-size: 1.55rem;
                font-weight: 950;
                color: var(--azul2);
            }

        .filter-card {
            background: #fff;
            border: 1px solid var(--linea);
            border-radius: 22px;
            padding: 18px;
            margin-bottom: 18px;
            box-shadow: 0 8px 22px rgba(15,23,42,.05);
        }

        .form-label {
            color: var(--muted);
            font-size: .78rem;
            font-weight: 900;
            text-transform: uppercase;
        }

        .form-control,
        .form-select {
            border-radius: 13px;
            border: 1px solid var(--linea);
            padding: 10px 12px;
        }

        .btn-main {
            border: none;
            border-radius: 13px;
            padding: 10px 14px;
            color: #fff;
            background: linear-gradient(135deg, var(--azul), var(--azul2));
            font-weight: 900;
            text-decoration: none;
            display: inline-flex;
            gap: 8px;
            align-items: center;
            justify-content: center;
        }

            .btn-main:hover {
                color: #fff;
                opacity: .95;
            }

        .section {
            background: #fff;
            border: 1px solid var(--linea);
            border-radius: 24px;
            overflow: hidden;
            box-shadow: var(--shadow);
            margin-bottom: 20px;
        }

        .section-head {
            padding: 17px 20px;
            border-bottom: 1px solid #edf1f7;
            display: flex;
            justify-content: space-between;
            gap: 14px;
            align-items: center;
            flex-wrap: wrap;
            cursor: pointer;
            background: linear-gradient(180deg, #fff, #f8fbff);
        }

        .section-title {
            margin: 0;
            font-size: 1.12rem;
            font-weight: 950;
            color: var(--azul2);
        }

        .section-sub {
            margin-top: 3px;
            color: var(--muted);
            font-size: .9rem;
        }

        .count-pill {
            border-radius: 999px;
            padding: 8px 12px;
            font-size: .86rem;
            font-weight: 900;
            background: #eef4ff;
            color: var(--azul);
            border: 1px solid #cfe0ff;
        }

        .client-box {
            margin: 14px 16px;
            border: 1px solid var(--linea);
            border-radius: 18px;
            overflow: hidden;
            background: #fbfdff;
        }

        .client-head {
            background: linear-gradient(180deg, #fff, #f7faff);
            padding: 14px 16px;
            border-bottom: 1px solid #edf1f7;
            display: flex;
            justify-content: space-between;
            gap: 12px;
            align-items: center;
            flex-wrap: wrap;
            cursor: pointer;
        }

        .client-title {
            margin: 0;
            font-size: 1.02rem;
            font-weight: 950;
        }

        .client-meta {
            color: var(--muted);
            font-size: .88rem;
        }

        .part-box {
            margin: 12px;
            border: 1px solid #e4ebf5;
            border-radius: 16px;
            background: #fff;
            overflow: hidden;
        }

        .part-head {
            padding: 12px 14px;
            background: #fbfdff;
            border-bottom: 1px solid #edf1f7;
            display: flex;
            justify-content: space-between;
            gap: 12px;
            align-items: center;
            flex-wrap: wrap;
            cursor: pointer;
        }

        .part-title {
            font-weight: 950;
            color: #12284a;
        }

        .part-desc {
            color: var(--muted);
            font-size: .87rem;
            margin-top: 2px;
        }

        .table-wrap {
            padding: 0;
            overflow-x: auto;
        }

        .table-clean {
            min-width: 1500px;
            width: 100%;
            border-collapse: collapse;
        }

            .table-clean th,
            .table-clean td {
                border-bottom: 1px solid #edf1f7;
                padding: 10px;
                vertical-align: middle;
                font-size: .86rem;
            }

            .table-clean th {
                position: sticky;
                top: 0;
                z-index: 3;
                background: #f8fbff;
                color: #4b5563;
                font-size: .72rem;
                font-weight: 950;
                text-transform: uppercase;
                letter-spacing: .04em;
                white-space: nowrap;
            }

            .table-clean td {
                background: #fff;
            }

            .table-clean tr:hover td {
                background: #f8fbff;
            }

        .estado {
            border-radius: 999px;
            padding: 6px 10px;
            font-size: .74rem;
            font-weight: 900;
            white-space: nowrap;
            border: 1px solid transparent;
            display: inline-flex;
            align-items: center;
            gap: 6px;
        }

        .estado-ok {
            background: var(--ok-bg);
            color: var(--ok);
            border-color: #bcebd3;
        }

        .estado-warn {
            background: var(--warn-bg);
            color: var(--warn);
            border-color: #f2d59a;
        }

        .estado-danger {
            background: var(--danger-bg);
            color: var(--danger);
            border-color: #f3b8b3;
        }

        .estado-muted {
            background: var(--gray-bg);
            color: #5b6472;
            border-color: #d8dde5;
        }

        .check {
            border-radius: 999px;
            padding: 5px 9px;
            font-size: .74rem;
            font-weight: 900;
            border: 1px solid transparent;
            display: inline-flex;
            align-items: center;
            gap: 5px;
            margin: 2px;
            white-space: nowrap;
        }

            .check.ok {
                background: var(--ok-bg);
                color: var(--ok);
                border-color: #bcebd3;
            }

            .check.no {
                background: var(--danger-bg);
                color: var(--danger);
                border-color: #f3b8b3;
            }

        .msg {
            min-width: 220px;
            color: #35517a;
            font-size: .84rem;
            font-weight: 650;
        }

        .empty {
            margin: 16px;
            padding: 28px 16px;
            text-align: center;
            color: var(--muted);
            border: 1px dashed var(--linea);
            border-radius: 18px;
            background: #fbfdff;
            font-weight: 750;
        }

        .chev {
            transition: transform .18s ease;
            color: var(--azul);
        }

        [aria-expanded="true"] .chev {
            transform: rotate(90deg);
        }

        .small-link {
            color: var(--azul);
            font-weight: 900;
            text-decoration: none;
            white-space: nowrap;
        }

            .small-link:hover {
                text-decoration: underline;
            }

        @@media (max-width: 1200px) {
            .kpis

        {
            grid-template-columns: repeat(3, 1fr);
        }

        }

        @@media (max-width: 700px) {
            .page

        {
            padding: 14px;
        }

        .kpis {
            grid-template-columns: 1fr;
        }

        }</style>
</head>

<body>
    <div class="page">

        <section class="hero">
            <h1>
                <i class="fa-solid fa-list-check me-2"></i>
                Programa de Planeación
            </h1>
            <p>
                Vista por filas, desplegable por sección, cliente y parte. Aquí se valida stock, material, cavidades,
                ciclos, molde, máquina y horas programadas antes de pasar a Programa Cambio de Molde.
            </p>

            <div class="hero-actions">
                <a asp-controller="PlaneacionRelease" asp-action="Index" class="btn-glass">
                    <i class="fa-solid fa-inbox"></i>
                    Releases
                </a>
                <a asp-controller="PlaneacionPrograma" asp-action="Maquinas" class="btn-glass">
                    <i class="fa-solid fa-gears"></i>
                    Máquinas / Cambio de Molde
                </a>
                <a asp-controller="PlaneacionPanorama" asp-action="Index" class="btn-glass">
                    <i class="fa-solid fa-chart-line"></i>
                    Panorama
                </a>
            </div>
        </section>

        @if (TempData["Success"] != null)
        {
            <div class="alert alert-success rounded-4 fw-semibold">
                <i class="fa-solid fa-circle-check me-2"></i>
                @TempData["Success"]
            </div>
        }

        @if (TempData["Error"] != null)
        {
            <div class="alert alert-danger rounded-4 fw-semibold">
                <i class="fa-solid fa-triangle-exclamation me-2"></i>
                @TempData["Error"]
            </div>
        }

        <section class="filter-card">
            <form asp-controller="PlaneacionPrograma" asp-action="Index" method="get">
                <div class="row g-3 align-items-end">
                    <div class="col-xl-3 col-md-6">
                        <label class="form-label">Cliente</label>
                        <select asp-for="ClienteID" asp-items="Model.Clientes" class="form-select">
                            <option value="">Todos</option>
                        </select>
                    </div>

                    <div class="col-xl-3 col-md-6">
                        <label class="form-label">Parte</label>
                        <select asp-for="ParteID" asp-items="Model.Partes" class="form-select">
                            <option value="">Todas</option>
                        </select>
                    </div>

                    <div class="col-xl-2 col-md-6">
                        <label class="form-label">Desde</label>
                        <input asp-for="FechaDesde" type="date" class="form-control" />
                    </div>

                    <div class="col-xl-2 col-md-6">
                        <label class="form-label">Hasta</label>
                        <input asp-for="FechaHasta" type="date" class="form-control" />
                    </div>

                    <div class="col-xl-2 col-md-12">
                        <button type="submit" class="btn-main w-100">
                            <i class="fa-solid fa-magnifying-glass"></i>
                            Consultar
                        </button>
                    </div>

                    <div class="col-12 d-flex gap-2 flex-wrap">
                        <a class="btn btn-outline-primary rounded-3 fw-bold"
                           asp-controller="PlaneacionPrograma"
                           asp-action="Index"
                           asp-route-soloListos="true">
                            Listos para Cambio de Molde
                        </a>

                        <a class="btn btn-outline-warning rounded-3 fw-bold"
                           asp-controller="PlaneacionPrograma"
                           asp-action="Index"
                           asp-route-soloPendienteAbasto="true">
                            Pendiente abasto
                        </a>

                        <a class="btn btn-outline-danger rounded-3 fw-bold"
                           asp-controller="PlaneacionPrograma"
                           asp-action="Index"
                           asp-route-soloPendienteDatosTecnicos="true">
                            Pendiente datos técnicos
                        </a>

                        <a class="btn btn-outline-secondary rounded-3 fw-bold"
                           asp-controller="PlaneacionPrograma"
                           asp-action="Index">
                            Limpiar
                        </a>
                    </div>
                </div>
            </form>
        </section>

        <section class="kpis">
            <div class="kpi">
                <div class="label">Listos cambio molde</div>
                <div class="value">@listos.Count.ToString("N0")</div>
            </div>

            <div class="kpi">
                <div class="label">Pendiente abasto</div>
                <div class="value">@abasto.Count.ToString("N0")</div>
            </div>

            <div class="kpi">
                <div class="label">Pendiente datos técnicos</div>
                <div class="value">@datosTecnicos.Count.ToString("N0")</div>
            </div>

            <div class="kpi">
                <div class="label">A producir</div>
                <div class="value">@totalAProducir.ToString("N0")</div>
            </div>

            <div class="kpi">
                <div class="label">Stock usado</div>
                <div class="value">@totalStock.ToString("N0")</div>
            </div>

            <div class="kpi">
                <div class="label">Horas prog.</div>
                <div class="value">@totalHoras.ToString("N2")</div>
            </div>
        </section>

        @{
            var secciones = new List<dynamic>
                {
                new { Titulo = "1. Listas para Programa Cambio de Molde", Sub = "Renglones con producción pendiente y datos suficientes para pasar al siguiente paso.", Items = listos, Id = "listos", Open = true },
                new { Titulo = "2. Pendientes de abastecimiento", Sub = "Tienen datos técnicos, pero no pasan porque falta MP o embalaje.", Items = abasto, Id = "abasto", Open = false },
                new { Titulo = "3. Pendientes de datos técnicos", Sub = "Falta molde, material, cavidades, ciclo, máquina, objetivo/hra o peso bruto.", Items = datosTecnicos, Id = "datos", Open = false },
                new { Titulo = "4. Cubiertas o ya programadas", Sub = "Consulta de renglones que no requieren acción inmediata.", Items = resueltos, Id = "resueltos", Open = false }
                };

            var sectionIndex = 0;
        }

        @foreach (var sec in secciones)
        {
            sectionIndex++;
            var sectionCollapseId = CollapseId("sec", sectionIndex);
            List<PlaneacionProgramaNecesidadVm> items = sec.Items;
            bool sectionOpen = sec.Open;

            <section class="section">
                <div class="section-head"
                     data-bs-toggle="collapse"
                     data-bs-target="#@sectionCollapseId"
                     aria-expanded="@(sectionOpen ? "true" : "false")"
                     aria-controls="@sectionCollapseId">
                    <div>
                        <h2 class="section-title">
                            <i class="fa-solid fa-chevron-right chev me-2"></i>
                            @sec.Titulo
                        </h2>
                        <div class="section-sub">@sec.Sub</div>
                    </div>

                    <div class="count-pill">@items.Count.ToString("N0") registro(s)</div>
                </div>

                <div id="@sectionCollapseId" class="collapse @(sectionOpen ? "show" : "")">
                    @if (!items.Any())
                    {
                        <div class="empty">No hay registros en esta sección.</div>
                    }
                    else
                    {
                        var clientIndex = 0;

                        foreach (var cliente in items.GroupBy(ClienteNombre).OrderBy(x => x.Key))
                        {
                            clientIndex++;
                            var clienteCollapseId = CollapseId("cli", sectionIndex, clientIndex);
                            var clienteItems = cliente.ToList();
                            var clienteAProducir = clienteItems.Sum(x => x.PiezasAProducir ?? 0);
                            var clienteHoras = clienteItems.Sum(x => x.HorasNecesarias ?? 0);

                            <div class="client-box">
                                <div class="client-head"
                                     data-bs-toggle="collapse"
                                     data-bs-target="#@clienteCollapseId"
                                     aria-expanded="true"
                                     aria-controls="@clienteCollapseId">
                                    <div>
                                        <h3 class="client-title">
                                            <i class="fa-solid fa-chevron-right chev me-2"></i>
                                            @cliente.Key
                                        </h3>
                                        <div class="client-meta">
                                            @clienteItems.Count.ToString("N0") registro(s) ·
                                            @clienteAProducir.ToString("N0") a producir ·
                                            @clienteHoras.ToString("N2") hrs
                                        </div>
                                    </div>

                                    <div class="count-pill">Cliente</div>
                                </div>

                                <div id="@clienteCollapseId" class="collapse show">
                                    @{
                                        var parteIndex = 0;
                                    }

                                    @foreach (var parte in clienteItems.GroupBy(ParteClave).OrderBy(x => x.Key))
                                    {
                                        parteIndex++;
                                        var parteCollapseId = CollapseId("parte", sectionIndex, clientIndex, parteIndex);
                                        var parteItems = parte.ToList();
                                        var primera = parteItems.FirstOrDefault();
                                        var parteAProducir = parteItems.Sum(x => x.PiezasAProducir ?? 0);
                                        var parteHoras = parteItems.Sum(x => x.HorasNecesarias ?? 0);

                                        <div class="part-box">
                                            <div class="part-head"
                                                 data-bs-toggle="collapse"
                                                 data-bs-target="#@parteCollapseId"
                                                 aria-expanded="true"
                                                 aria-controls="@parteCollapseId">
                                                <div>
                                                    <div class="part-title">
                                                        <i class="fa-solid fa-chevron-right chev me-2"></i>
                                                        @parte.Key
                                                    </div>
                                                    <div class="part-desc">
                                                        @Txt(primera?.DesignacionDescripcionSAP) ·
                                                        @parteItems.Count.ToString("N0") entrega(s) ·
                                                        @parteAProducir.ToString("N0") a producir ·
                                                        @parteHoras.ToString("N2") hrs
                                                    </div>
                                                </div>

                                                <div class="count-pill">Parte</div>
                                            </div>

                                            <div id="@parteCollapseId" class="collapse show">
                                                <div class="table-wrap">
                                                    <table class="table-clean">
                                                        <thead>
                                                            <tr>
                                                                <th>Estado</th>
                                                                <th>Release</th>
                                                                <th>Fecha requerida</th>
                                                                <th>Requerido</th>
                                                                <th>Stock</th>
                                                                <th>Programado</th>
                                                                <th>A producir</th>
                                                                <th>Molde</th>
                                                                <th>Material / Resina</th>
                                                                <th>Cavidades</th>
                                                                <th>Ciclo</th>
                                                                <th>Máquina</th>
                                                                <th>Horas prog.</th>
                                                                <th>Qty día</th>
                                                                <th>Peso bruto</th>
                                                                <th>Obj/Hra</th>
                                                                <th>MP disp./req.</th>
                                                                <th>Emb. disp./req.</th>
                                                                <th>Validación</th>
                                                                <th>Observación</th>
                                                                <th>Acción</th>
                                                            </tr>
                                                        </thead>

                                                        <tbody>
                                                            @foreach (var item in parteItems)
                                                            {
                                                                <tr>
                                                                    <td>
                                                                        <span class="estado @EstadoClase(item)">
                                                                            @EstadoTexto(item)
                                                                        </span>
                                                                    </td>

                                                                    <td>@Txt(item.FolioRelease)</td>
                                                                    <td>@F(item.FechaRequerida)</td>
                                                                    <td>@item.CantidadRequerida.ToString("N0")</td>
                                                                    <td>@N0(item.PiezasDesdePT)</td>
                                                                    <td>@N0(item.ProduccionProgramadaPendiente)</td>
                                                                    <td><strong>@N0(item.PiezasAProducir)</strong></td>
                                                                    <td>@Txt(item.MoldeCodigo)</td>
                                                                    <td>
                                                                        <strong>@Txt(item.MaterialCodigo)</strong><br />
                                                                        <span class="text-muted">@Txt(item.MaterialDescripcion)</span>
                                                                    </td>
                                                                    <td>@N0(item.Cavidades)</td>
                                                                    <td>@Txt(item.Ciclo)</td>
                                                                    <td>
                                                                        <strong>@Txt(item.MaquinaSugeridaCodigo)</strong><br />
                                                                        <span class="text-muted">@Txt(item.MaquinaSugeridaNombre)</span>
                                                                    </td>
                                                                    <td>@D2(item.HorasNecesarias)</td>
                                                                    <td>@N0(item.QtyPorDia)</td>
                                                                    <td>@D4(item.PesoBrutoPieza)</td>
                                                                    <td>@N0(item.ObjetivoHora)</td>
                                                                    <td>@D4(item.MPDisponibleKg) / @D4(item.MPRequeridaKg) kg</td>
                                                                    <td>@D2(item.EmbalajeDisponible) / @D2(item.EmbalajeRequerido)</td>
                                                                    <td>
                                                                        <span class="@CheckClase(StockOk(item))"><i class="fa-solid @CheckIcono(StockOk(item))"></i> Stock</span>
                                                                        <span class="@CheckClase(MoldeOk(item))"><i class="fa-solid @CheckIcono(MoldeOk(item))"></i> Molde</span>
                                                                        <span class="@CheckClase(MaterialOk(item))"><i class="fa-solid @CheckIcono(MaterialOk(item))"></i> Material</span>
                                                                        <span class="@CheckClase(CavidadesOk(item))"><i class="fa-solid @CheckIcono(CavidadesOk(item))"></i> Cav.</span>
                                                                        <span class="@CheckClase(CicloOk(item))"><i class="fa-solid @CheckIcono(CicloOk(item))"></i> Ciclo</span>
                                                                        <span class="@CheckClase(MaquinaOk(item))"><i class="fa-solid @CheckIcono(MaquinaOk(item))"></i> Máquina</span>
                                                                        <span class="@CheckClase(ObjetivoOk(item))"><i class="fa-solid @CheckIcono(ObjetivoOk(item))"></i> Obj</span>
                                                                        <span class="@CheckClase(MpOk(item))"><i class="fa-solid @CheckIcono(MpOk(item))"></i> MP</span>
                                                                        <span class="@CheckClase(EmbalajeOk(item))"><i class="fa-solid @CheckIcono(EmbalajeOk(item))"></i> Emb.</span>
                                                                    </td>
                                                                    <td>
                                                                        <div class="msg">@Txt(item.MensajeCapacidad)</div>
                                                                    </td>
                                                                    <td>
                                                                        @if (ListoCambioMolde(item))
                                                                        {
                                                                            <a class="small-link"
                                                                               href="@Url.Action("CrearDesdeNecesidad", "PlaneacionPrograma", new { releaseDetalleId = item.ReleaseDetalleID })">
                                                                                Enviar a Cambio de Molde
                                                                            </a>
                                                                        }
                                                                        else if (item.ProgramaProduccionID.HasValue)
                                                                        {
                                                                            <a class="small-link"
                                                                               asp-controller="PlaneacionPrograma"
                                                                               asp-action="Maquinas">
                                                                                Ver en máquinas
                                                                            </a>
                                                                        }
                                                                        else
                                                                        {
                                                                            <span class="text-muted fw-semibold">Sin acción</span>
                                                                        }
                                                                    </td>
                                                                </tr>
                                                            }
                                                        </tbody>
                                                    </table>
                                                </div>
                                            </div>
                                        </div>
                                    }
                                </div>
                            </div>
                        }
                    }
                </div>
            </section>
        }

    </div>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>

</body>
</html>
