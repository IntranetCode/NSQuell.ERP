        @if (TempData["Success"] != null)
        {
            <div class="alert alert-success rounded-4 fw-semibold"><i class="fa-solid fa-circle-check me-2"></i>@TempData["Success"]</div>
        }
        @if (TempData["Error"] != null)
        {
            <div class="alert alert-danger rounded-4 fw-semibold"><i class="fa-solid fa-triangle-exclamation me-2"></i>@TempData["Error"]</div>
        }

        <section class="filter-card">
            <form asp-controller="PlaneacionPrograma" asp-action="Index" method="get">
                <div class="row g-3 align-items-end">
                    <div class="col-xl-3 col-md-6"><label class="form-label">Cliente</label><select asp-for="ClienteID" asp-items="Model.Clientes" class="form-select"><option value="">Todos</option></select></div>
                    <div class="col-xl-3 col-md-6"><label class="form-label">Parte</label><select asp-for="ParteID" asp-items="Model.Partes" class="form-select"><option value="">Todas</option></select></div>
                    <div class="col-xl-2 col-md-6"><label class="form-label">Entrega cliente desde</label><input asp-for="FechaDesde" type="date" class="form-control" /></div>
                    <div class="col-xl-2 col-md-6"><label class="form-label">Entrega cliente hasta</label><input asp-for="FechaHasta" type="date" class="form-control" /></div>
                    <div class="col-xl-2 col-md-12"><button type="submit" class="btn-main w-100"><i class="fa-solid fa-magnifying-glass"></i>Consultar</button></div>

                    <div class="col-12 d-flex gap-2 flex-wrap">
                        <a class="quick-btn quick-ok" asp-controller="PlaneacionPrograma" asp-action="Index" asp-route-soloListos="true"><i class="fa-solid fa-circle-check"></i>Listos cambio molde</a>
                        @* NSQ_ABASTO_TEMP_BYPASS_V1: filtro Pendiente abasto oculto temporalmente. *@
<a class="quick-btn" asp-controller="PlaneacionPrograma" asp-action="Index"><i class="fa-solid fa-rotate-left"></i>Limpiar</a>
                        <button type="button" class="quick-btn" id="btnCerrarTodo"><i class="fa-solid fa-down-left-and-up-right-to-center"></i>Cerrar todo</button>
                    </div>

                    <div class="col-12"><label class="form-label">Buscar en pantalla</label><input id="txtBuscarPantalla" type="search" class="form-control" placeholder="Buscar cliente, parte, release, molde, máquina, material..." /></div>
                </div>
            </form>
        </section>

        @{
            var sectionIndex = 0;
        }

        @foreach (var sec in secciones)
        {
            sectionIndex++;
            var sectionCollapseId = CollapseId("sec", sectionIndex);
            var items = sec.Items;
            var sectionOpen = sec.Open;

            <section class="section @sec.Clase" data-section data-search="@string.Join(" ", items.Select(DataSearch))">
                <div class="section-head" data-bs-toggle="collapse" data-bs-target="#@sectionCollapseId" aria-expanded="@(sectionOpen ? "true" : "false")" aria-controls="@sectionCollapseId">
                    <div>
                        <h2 class="section-title"><span class="section-icon"><i class="fa-solid @sec.Icono"></i></span><span>@sec.Titulo</span><i class="fa-solid fa-chevron-right chev"></i></h2>
                        <div class="section-sub">@sec.Sub</div>
                    </div>
                    <div class="d-flex gap-2 flex-wrap">
                        <span class="count-pill">@items.Count.ToString("N0") registro(s)</span>
                        <span class="summary-pill">@items.Sum(x => x.CantidadRequerida).ToString("N0") requerido</span>
                        <span class="summary-pill">@items.Sum(x => x.ProduccionProgramadaPendiente ?? 0).ToString("N0") programado</span>
                        <span class="summary-pill"><i class="fa-solid fa-tag"></i>@items.Sum(x => x.ProductoIncompletoApartado).ToString("N0") etiqueta blanca</span>
                        <span class="summary-pill">@items.Sum(x => x.PiezasAProducir ?? 0).ToString("N0") a producir</span>
                        <span class="summary-pill">@items.Sum(x => x.HorasNecesarias ?? 0).ToString("N2") hrs</span>
                    </div>
                </div>

                <div id="@sectionCollapseId" class="collapse @(sectionOpen ? "show" : "")" data-collapse-level="section">
                    <div class="section-body">
                        @if (!items.Any())
                        {
                            <div class="empty"><i class="fa-regular fa-folder-open fa-2x mb-2"></i><div>No hay registros en esta sección.</div></div>
                        }
                        else
                        {
                            var fechasOrdenadas = items
                            .GroupBy(FechaEntregaClave)
                            .Select(g => new
                            {
                                FechaEntrega = g.Key,
                                Items = g
                            .OrderBy(ClienteNombre)
                            .ThenBy(PrioridadEntrada)
                            .ToList(),
                                Clientes = g.Select(ClienteNombre).Distinct().Count(),
                                Releases = g.Select(ReleaseTexto).Distinct().Count(),
                                TotalRequerido = g.Sum(x => x.CantidadRequerida),
                                TotalProgramado = g.Sum(x => x.ProduccionProgramadaPendiente ?? 0),
                                TotalBlanco = g.Sum(x => x.ProductoIncompletoApartado),
                                TotalAProducir = g.Sum(x => x.PiezasAProducir ?? 0)
                            })
                            .OrderBy(g => g.FechaEntrega)
                            .ToList();

                            <div class="date-groups">
                                @{
                                    var fechaIndex = 0;
                                }

                                @foreach (var fechaGrupo in fechasOrdenadas)
                                {
                                    fechaIndex++;

                                    var fechaCollapseId = $"fecha_{sectionIndex}_{fechaIndex}";
                                    var fechaAbierta = fechaIndex == 1;

                                    var clientesOrdenados = fechaGrupo.Items
                                    .GroupBy(ClienteNombre)
                                    .Select(g => new
                                    {
                                        Cliente = g.Key,
                                        Items = g.OrderBy(PrioridadEntrada).ToList(),
                                        EntradaPrioridad = g.Min(PrioridadEntrada)
                                    })
                                    .OrderBy(g => g.EntradaPrioridad)
                                    .ThenBy(g => g.Cliente)
                                    .ToList();

                                    <article class="date-panel @FechaEntregaClase(fechaGrupo.FechaEntrega)"
                                             data-date-group
                                             data-search="@string.Join(" ", fechaGrupo.Items.Select(DataSearch))">
                                        <button type="button"
                                                class="date-panel-head"
                                                data-bs-toggle="collapse"
                                                data-bs-target="#@fechaCollapseId"
                                                aria-expanded="@(fechaAbierta ? "true" : "false")"
                                                aria-controls="@fechaCollapseId">
                                            <div class="date-panel-main">
                                                <span class="date-icon">
                                                    <i class="fa-solid fa-calendar-day"></i>
                                                </span>

                                                <div>
                                                    <div class="date-title">
                                                        Entrega: @FechaEntregaTexto(fechaGrupo.FechaEntrega)
                                                    </div>
                                                    <div class="date-meta">
                                                        @fechaGrupo.Items.Count.ToString("N0") registro(s) ·
                                                        @fechaGrupo.Clientes.ToString("N0") cliente(s) ·
                                                        @fechaGrupo.Releases.ToString("N0") release(s) ·
                                                        @fechaGrupo.TotalRequerido.ToString("N0") requerido ·
                                                        @fechaGrupo.TotalProgramado.ToString("N0") programado ·
                                                        @fechaGrupo.TotalBlanco.ToString("N0") etiqueta blanca ·
                                                        @fechaGrupo.TotalAProducir.ToString("N0") a producir
                                                    </div>
                                                </div>
                                            </div>

                                            <div class="date-panel-right">
                                                <span class="date-status">
                                                    @FechaEntregaEstado(fechaGrupo.FechaEntrega)
                                                </span>
                                                <i class="fa-solid fa-chevron-right chev"></i>
                                            </div>
                                        </button>

                                        <div id="@fechaCollapseId"
                                             class="collapse @(fechaAbierta ? "show" : "")"
                                             data-collapse-level="date">
                                            <div class="date-panel-body">
                                                <div class="client-grid">
                                                    @{
                                                        var clientIndex = 0;
                                                    }

                                                    @foreach (var clienteGrupo in clientesOrdenados)
                                                    {
                                                        clientIndex++;

                                                        var clienteCollapseId = $"cliente_{sectionIndex}_{fechaIndex}_{clientIndex}";
                                                        var clienteItems = clienteGrupo.Items;
                                                        var primerItemCliente = clienteItems.First();
                                                        var partesCliente = clienteItems.Select(ParteClave).Distinct().Count();

                                                        var releasesCliente = clienteItems
                                                        .GroupBy(ReleaseKey)
                                                        .Select(g => new
                                                        {
                                                            Key = g.Key,
                                                            Texto = ReleaseTexto(g.First()),
                                                            Items = g.OrderBy(PrioridadEntrada).ToList(),
                                                            EntradaPrioridad = g.Min(PrioridadEntrada),
                                                            TotalRequerido = g.Sum(x => x.CantidadRequerida),
                                                            TotalPT = g.Sum(x => x.PiezasDesdePT ?? 0),
                                                            TotalProgramado = g.Sum(x => x.ProduccionProgramadaPendiente ?? 0),
                                                            TotalBlanco = g.Sum(x => x.ProductoIncompletoApartado),
                                                            TotalAProducir = g.Sum(x => x.PiezasAProducir ?? 0)
                                                        })
                                                        .OrderBy(g => g.EntradaPrioridad)
                                                        .ToList();

                                                        var releaseInicial = releasesCliente.First().Key;

                                                        <article class="client-panel"
                                                                 data-client
                                                                 data-search="@clienteGrupo.Cliente @string.Join(" ", clienteItems.Select(DataSearch))">
                                                            <button type="button"
                                                                    class="client-panel-head"
                                                                    data-bs-toggle="collapse"
                                                                    data-bs-target="#@clienteCollapseId"
                                                                    aria-expanded="false"
                                                                    aria-controls="@clienteCollapseId">
                                                                <div>
                                                                    <div class="client-name">
                                                                        <i class="fa-solid fa-chevron-right chev me-2"></i>
                                                                        @clienteGrupo.Cliente
                                                                    </div>
                                                                    <div class="client-meta">
                                                                        @clienteItems.Count.ToString("N0") registro(s) ·
                                                                        @partesCliente.ToString("N0") parte(s) ·
                                                                        @clienteItems.Sum(x => x.CantidadRequerida).ToString("N0") requerido ·
                                                                        @clienteItems.Sum(x => x.ProductoIncompletoApartado).ToString("N0") etiqueta blanca ·
                                                                        @clienteItems.Sum(x => x.PiezasAProducir ?? 0).ToString("N0") a producir
                                                                    </div>
                                                                </div>

                                                                <span class="client-priority">
                                                                    <i class="fa-solid fa-calendar-check"></i>
                                                                    Entrega @F(primerItemCliente.FechaRequerida)
                                                                </span>
                                                            </button>

                                                            <div id="@clienteCollapseId"
                                                                 class="collapse"
                                                                 data-collapse-level="client">
                                                                <div class="client-body">
                                                                    <div class="release-toolbar" data-release-toolbar>
                                                                        <span class="release-toolbar-label">Release</span>

                                                                        @foreach (var rel in releasesCliente)
                                                                        {
                                                                            <button type="button"
                                                                                    class="release-btn @(rel.Key == releaseInicial ? "active" : "")"
                                                                                    data-release-btn
                                                                                    data-release-key="@rel.Key">
                                                                                <i class="fa-solid fa-layer-group"></i>
                                                                                @rel.Texto
                                                                                <span class="release-count">@rel.Items.Count</span>
                                                                            </button>
                                                                        }

                                                                        <span class="release-summary" data-release-summary>
                                                                            @releasesCliente.First().TotalRequerido.ToString("N0") requerido ·
                                                                            @releasesCliente.First().TotalBlanco.ToString("N0") etiqueta blanca ·
                                                                            @releasesCliente.First().TotalAProducir.ToString("N0") a producir ·
                                                                            @releasesCliente.First().TotalProgramado.ToString("N0") programado
                                                                        </span>
                                                                    </div>

                                                                    <div class="cards-grid">
                                                                        <div class="cards-header" aria-hidden="true">
                                                                            <div>Parte / estado</div>
                                                                            <div>Entrega cliente</div>
                                                                            <div>Requerido</div>
                                                                            <div>PT apartado</div>
                                                                            <div>Etiqueta blanca</div>
                                                                            <div>A producir</div>
                                                                            <div>Máquina</div>
                                                                            <div>Molde</div>
                                                                            <div>Horas</div>
                                                                            <div>Acciones</div>
                                                                        </div>

                                                                        @foreach (var item in clienteItems)
                                                                        {
                                                                            <article class="need-card @CardClase(item) @(ReleaseKey(item) == releaseInicial ? "" : "hidden-by-release")"
                                                                                     data-row
                                                                                     data-release-key="@ReleaseKey(item)"
                                                                                     data-requerido="@item.CantidadRequerida"
                                                                                     data-pt="@(item.PiezasDesdePT ?? 0)"
                                                                                     data-blanco="@item.ProductoIncompletoApartado"
                                                                                     data-producir="@(item.PiezasAProducir ?? 0)"
                                                                                     data-programado="@(item.ProduccionProgramadaPendiente ?? 0)"
                                                                                     data-search="@DataSearch(item)">
                                                                                <div class="need-main">
                                                                                    <div class="need-title-row">
                                                                                        <div class="need-title">@ParteClave(item)</div>
                                                                                        <span class="estado @EstadoClase(item)">
                                                                                            <i class="fa-solid fa-circle"></i>
                                                                                            @EstadoTexto(item)
                                                                                        </span>
                                                                                    </div>

                                                                                    <div class="need-sub" title="@Txt(item.DesignacionDescripcionSAP)">
                                                                                        @Txt(item.DesignacionDescripcionSAP)
                                                                                    </div>

                                                                                    <div class="compact-priority">
                                                                                        <i class="fa-solid fa-arrow-up-short-wide me-1"></i>
                                                                                        @PrioridadTexto(item)
                                                                                    </div>
                                                                                </div>

                                                                                <div class="need-cell">
                                                                                    <span class="need-cell-label">Entrega cliente</span>
                                                                                    <span class="need-cell-value">
                                                                                        <i class="fa-solid fa-calendar-day me-1"></i>
                                                                                        @F(item.FechaRequerida)
                                                                                    </span>
                                                                                </div>

                                                                                <div class="need-cell">
                                                                                    <span class="need-cell-label">Requerido</span>
                                                                                    <span class="need-cell-value">@item.CantidadRequerida.ToString("N0")</span>
                                                                                </div>

                                                                                <div class="need-cell">
                                                                                    <span class="need-cell-label">PT apartado</span>
                                                                                    <span class="need-cell-value">@N0(item.PiezasDesdePT)</span>
                                                                                </div>
                                                                                <div class="need-cell white-cell" title="Producto incompleto que Planeación ya decidió utilizar para esta necesidad.">
                                                                                    <span class="need-cell-label">Etiqueta blanca</span>
                                                                                    <span class="need-cell-value"><i class="fa-solid fa-tag me-1"></i>@item.ProductoIncompletoApartado.ToString("N0")</span>
                                                                                    @if (item.ProductoIncompletoApartado <= 0 && item.ProductoIncompletoDisponible > 0)
                                                                                    {
                                                                                        <span class="white-chip mt-1"><i class="fa-solid fa-circle-info"></i>@item.ProductoIncompletoDisponible.ToString("N0") disp.</span>
                                                                                    }
                                                                                </div>
                                                                                <div class="need-cell">
                                                                                    <span class="need-cell-label">A producir</span>
                                                                                    <span class="need-cell-value">@N0(item.PiezasAProducir)</span>
                                                                                </div>
                                                                                <div class="need-cell">
                                                                                    <span class="need-cell-label">Máquina</span>
                                                                                    <span class="need-cell-value" title="@Txt(item.MaquinaSugeridaNombre)">
                                                                                        <i class="fa-solid fa-industry me-1"></i>
                                                                                        @Txt(item.MaquinaSugeridaCodigo)
                                                                                    </span>
                                                                                </div>

                                                                                <div class="need-cell">
                                                                                    <span class="need-cell-label">Molde</span>
                                                                                    <span class="need-cell-value">
                                                                                        <i class="fa-solid fa-shapes me-1"></i>
                                                                                        @Txt(item.MoldeCodigo)
                                                                                    </span>
                                                                                </div>

                                                                                <div class="need-cell">
                                                                                    <span class="need-cell-label">Horas</span>
                                                                                    <span class="need-cell-value">
                                                                                        <i class="fa-solid fa-clock me-1"></i>
                                                                                        @D2(item.HorasNecesarias)
                                                                                    </span>
                                                                                </div>

                                                                                <div class="need-actions-row">
                                                                                    @if (!item.ProgramaProduccionID.HasValue && item.ProductoIncompletoDisponible > 0 && item.ProductoIncompletoApartado <= 0)
                                                                                    {
                                                                                        <span class="white-chip" title="Al abrir Programar molde podrás decidir si usar este producto incompleto."><i class="fa-solid fa-tag"></i>@item.ProductoIncompletoDisponible.ToString("N0") disp.</span>
                                                                                    }
                                                                                    @if (item.ProgramaProduccionID.HasValue)
                                                                                    {
                                                                                        <a class="btn-card-main"
                                                                                           asp-controller="PlaneacionPrograma"
                                                                                           asp-action="Maquinas">
                                                                                            <i class="fa-solid fa-table-columns"></i>
                                                                                            Ver máquinas
                                                                                        </a>
                                                                                    }
                                                                                    else if (ListoCambioMolde(item))
                                                                                    {
                                                                                        <a class="btn-card-main"
                                                                                           href="@Url.Action("CrearDesdeNecesidad", "PlaneacionPrograma", new { releaseDetalleId = item.ReleaseDetalleID })">
                                                                                            <i class="fa-solid fa-gears"></i>
                                                                                            Programar molde
                                                                                        </a>
                                                                                    }
                                                                                    else if (PendienteDatosTecnicos(item) && item.ParteID.HasValue)
                                                                                    {
                                                                                        <button type="button"
                                                                                                class="btn-card-main btn-datos-tecnicos"
                                                                                                data-parte-id="@item.ParteID"
                                                                                                data-release-detalle-id="@item.ReleaseDetalleID"
                                                                                                data-parte="@ParteClave(item)">
                                                                                            <i class="fa-solid fa-screwdriver-wrench"></i>
                                                                                            Completar datos y programar
                                                                                        </button>
                                                                                        <span class="row-result row-result-review">Datos técnicos</span>
                                                                                    }
                                                                                    else
                                                                                    {
                                                                                        <button type="button"
                                                                                                class="btn-card-light"
                                                                                                disabled
                                                                                                title="Esta necesidad todavía tiene validaciones pendientes.">
                                                                                            <i class="fa-solid fa-gears"></i>
                                                                                            Programar molde
                                                                                        </button>
                                                                                        <span class="row-result row-result-review">Revisar</span>
                                                                                    }
                                                                                </div>
                                                                            </article>
                                                                        }
                                                                    </div>
                                                                </div>
                                                            </div>
                                                        </article>
                                                    }
                                                </div>
                                            </div>
                                        </div>
                                    </article>
                                }
                            </div>
                        }
                    </div>
                </div>
            </section>
        }

        <section class="sticky-actions">
            <div class="d-flex justify-content-between gap-2 flex-wrap">
                <a asp-controller="PlaneacionRelease" asp-action="Index" class="btn btn-light rounded-4 fw-bold"><i class="fa-solid fa-arrow-left me-1"></i>Releases</a>
                <div class="d-flex gap-2 flex-wrap">
                    @*  <a asp-controller="PlaneacionPanorama" asp-action="Index" class="btn btn-light rounded-4 fw-bold"><i class="fa-solid fa-chart-line me-1"></i>Panorama</a>*@
                    <a asp-controller="PlaneacionPrograma" asp-action="Maquinas" class="btn-main"><i class="fa-solid fa-gears me-1"></i>Máquinas / Cambios</a>
                </div>
            </div>
        </section>
    </div>

@* NSQ_DT_MODAL_V1 *@
<div class="modal fade" id="modalDatosTecnicosRapidos" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-xl modal-dialog-centered modal-dialog-scrollable">
        <div class="modal-content border-0 rounded-4 shadow">
            <div class="modal-header">
                <div>
                    <h5 class="modal-title fw-bold">
                        <i class="fa-solid fa-screwdriver-wrench me-2"></i>
                        Completar datos técnicos
                    </h5>
                    <div class="small opacity-75" id="dtParteTitulo">-</div>
                </div>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body">
                <form id="dtTokenForm">@Html.AntiForgeryToken()</form>
                <input type="hidden" id="dtParteID" />
                <input type="hidden" id="dtReleaseDetalleID" />

                <div id="dtMensaje" class="alert d-none"></div>

                <div class="row g-3">
                    <div class="col-md-4">
                        <label class="form-label">Material *</label>
                        <select id="dtMaterialID" class="form-select"></select>
                    </div>
                    <div class="col-md-4">
                        <label class="form-label">Máquina principal *</label>
                        <select id="dtMaquinaPrincipalID" class="form-select"></select>
                    </div>
                    <div class="col-md-4">
                        <label class="form-label">Máquina sustituta</label>
                        <select id="dtMaquinaSustitutaID" class="form-select"></select>
                    </div>

                    <div class="col-md-4">
                        <label class="form-label">Molde principal *</label>
                        <select id="dtMoldePrincipalID" class="form-select"></select>
                    </div>
                    <div class="col-md-2">
                        <label class="form-label">Cavidades *</label>
                        <input id="dtCavidades" type="number" min="1" class="form-control" />
                    </div>
                    <div class="col-md-2">
                        <label class="form-label">Objetivo/h *</label>
                        <input id="dtObjetivoHora" type="number" min="1" class="form-control" />
                    </div>
                    <div class="col-md-2">
                        <label class="form-label">Pzas/caja</label>
                        <input id="dtPiezasPorCaja" type="number" min="0" class="form-control" />
                    </div>
                    <div class="col-md-2">
                        <label class="form-label">Color</label>
                        <input id="dtColor" class="form-control" />
                    </div>

                    <div class="col-md-3">
                        <label class="form-label">Ciclo *</label>
                        <input id="dtCiclo" class="form-control" placeholder="Ej. 45 s" />
                    </div>
                    <div class="col-md-3">
                        <label class="form-label">Peso bruto/pza *</label>
                        <input id="dtPesoBruto" type="number" min="0" step="0.0001" class="form-control" />
                    </div>
                    <div class="col-md-3">
                        <label class="form-label">Peso neto/pza</label>
                        <input id="dtPesoNeto" type="number" min="0" step="0.0001" class="form-control" />
                    </div>
                    <div class="col-md-3">
                        <label class="form-label">Piezas por embalaje *</label>
                        <input id="dtPiezasPorEmbalaje" type="number" min="1" step="1" class="form-control" />
                    </div>

                    <div class="col-md-3">
                        <label class="form-label">Código embalaje *</label>
                        <input id="dtEmbalajeCodigo" class="form-control" />
                    </div>
                    <div class="col-md-5">
                        <label class="form-label">Descripción embalaje</label>
                        <input id="dtEmbalajeDescripcion" class="form-control" />
                    </div>
                    <div class="col-md-2">
                        <label class="form-label">Tipo secado</label>
                        <input id="dtTipoSecado" class="form-control" />
                    </div>
                    <div class="col-md-2">
                        <label class="form-label">Horas secado</label>
                        <input id="dtHorasSecado" type="number" min="0" step="0.25" class="form-control" />
                    </div>
                </div>

                <div class="small text-muted mt-3">
                    La máquina 1200T está excluida. Al guardar se utilizarán estos datos en Planeación y después se abrirá Programar molde.
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Cancelar</button>
                <button type="button" class="btn btn-primary fw-bold" id="btnGuardarDtRapidos">
                    Guardar y programar
                </button>
            </div>
        </div>
    </div>
</div>

<script>
(() => {
    // NSQ_FILTRO_DT_DOM_V1_5
    document
        .querySelectorAll('a[href*="soloPendienteDatosTecnicos=true"]')
        .forEach(x => x.remove());

    const modalEl = document.getElementById('modalDatosTecnicosRapidos');
    if (!modalEl) return;

    const modal = bootstrap.Modal.getOrCreateInstance(modalEl);
    const qs = id => document.getElementById(id);

    function setMensaje(texto, tipo) {
        const el = qs('dtMensaje');
        if (!el) return;
        if (!texto) {
            el.className = 'alert d-none';
            el.textContent = '';
            return;
        }
        el.className = `alert alert-${tipo || 'info'}`;
        el.textContent = texto;
    }

    function option(select, value, text) {
        const opt = document.createElement('option');
        opt.value = value ?? '';
        opt.textContent = text;
        select.appendChild(opt);
    }

    function cargarSelect(select, items, current, placeholder) {
        select.innerHTML = '';
        option(select, '', placeholder);

        for (const item of items || []) {
            option(
                select,
                item.id,
                [item.codigo, item.nombre].filter(Boolean).join(' - ') || `ID ${item.id}`);
        }

        if (current !== null && current !== undefined) {
            select.value = String(current);
        }
    }

    function numberOrNull(id) {
        const value = qs(id)?.value?.trim();
        if (!value) return null;
        const number = Number(value);
        return Number.isFinite(number) ? number : null;
    }

    document.addEventListener('click', async event => {
        const btn = event.target.closest('.btn-datos-tecnicos');
        if (!btn) return;

        const parteId = btn.dataset.parteId || '';
        const releaseDetalleId = btn.dataset.releaseDetalleId || '';

        qs('dtParteID').value = parteId;
        qs('dtReleaseDetalleID').value = releaseDetalleId;
        qs('dtParteTitulo').textContent = btn.dataset.parte || `Parte ${parteId}`;
        setMensaje('Cargando datos actuales...', 'info');
        modal.show();

        try {
            const response = await fetch(
                `@Url.Action("DatosTecnicosParaProgramar","PlaneacionPrograma")?parteId=${encodeURIComponent(parteId)}&releaseDetalleId=${encodeURIComponent(releaseDetalleId)}`,
                { headers: { 'X-Requested-With': 'XMLHttpRequest' } });

            const result = await response.json();

            if (!response.ok || !result.ok) {
                throw new Error(result.mensaje || 'No fue posible cargar los datos técnicos.');
            }

            const d = result.data || {};

            cargarSelect(qs('dtMaterialID'), result.materiales, d.materialID, '-- Material --');
            cargarSelect(qs('dtMaquinaPrincipalID'), result.maquinas, d.maquinaPrincipalID, '-- Máquina principal --');
            cargarSelect(qs('dtMaquinaSustitutaID'), result.maquinas, d.maquinaSustitutaID, '-- Sin sustituta --');
            cargarSelect(qs('dtMoldePrincipalID'), result.moldes, d.moldePrincipalID, '-- Molde --');

            qs('dtCavidades').value = d.cavidades ?? '';
            qs('dtObjetivoHora').value = d.objetivoHora ?? '';
            qs('dtPiezasPorCaja').value = d.piezasPorCaja ?? '';
            qs('dtColor').value = d.color ?? '';
            qs('dtCiclo').value = d.ciclo ?? '';
            qs('dtPesoBruto').value = d.pesoBrutoPieza ?? '';
            qs('dtPesoNeto').value = d.pesoNetoPieza ?? '';
            qs('dtPiezasPorEmbalaje').value = d.piezasPorEmbalaje ?? '';
            qs('dtEmbalajeCodigo').value = d.embalajeCodigo ?? '';
            qs('dtEmbalajeDescripcion').value = d.embalajeDescripcion ?? '';
            qs('dtTipoSecado').value = d.tipoSecado ?? '';
            qs('dtHorasSecado').value = d.horasSecado ?? '';

            qs('dtParteTitulo').textContent =
                `${d.numeroParte || btn.dataset.parte || ''} · ${d.descripcion || ''}`;

                        if (Array.isArray(result.faltantes) && result.faltantes.length) {
                setMensaje(
                    `Falta completar: ${result.faltantes.join(', ')}. Los campos obligatorios están marcados con *.`,
                    'warning'
                );
            } else {
                setMensaje(
                    'Los datos técnicos obligatorios ya están completos. Puedes guardar para sincronizar la necesidad y continuar.',
                    'success'
                );
            }
        }
        catch (error) {
            setMensaje(error.message, 'danger');
        }
    });

    qs('btnGuardarDtRapidos')?.addEventListener('click', async () => {
        const button = qs('btnGuardarDtRapidos');
        const token = document.querySelector('#dtTokenForm input[name="__RequestVerificationToken"]')?.value || '';

        const payload = {
            parteID: Number(qs('dtParteID').value || 0),
            releaseDetalleID: Number(qs('dtReleaseDetalleID').value || 0), // NSQ_DT_FLUJO_VIEW_V3
            materialID: numberOrNull('dtMaterialID'),
            maquinaPrincipalID: numberOrNull('dtMaquinaPrincipalID'),
            maquinaSustitutaID: numberOrNull('dtMaquinaSustitutaID'),
            moldePrincipalID: numberOrNull('dtMoldePrincipalID'),
            color: qs('dtColor').value || null,
            cavidades: numberOrNull('dtCavidades'),
            objetivoHora: numberOrNull('dtObjetivoHora'),
            piezasPorCaja: numberOrNull('dtPiezasPorCaja'),
            ciclo: qs('dtCiclo').value || null,
            tipoSecado: qs('dtTipoSecado').value || null,
            horasSecado: numberOrNull('dtHorasSecado'),
            pesoBrutoPieza: numberOrNull('dtPesoBruto'),
            pesoNetoPieza: numberOrNull('dtPesoNeto'),
            embalajeCodigo: qs('dtEmbalajeCodigo').value || null,
            embalajeDescripcion: qs('dtEmbalajeDescripcion').value || null,
            piezasPorEmbalaje: numberOrNull('dtPiezasPorEmbalaje')
        };

        button.disabled = true;
        setMensaje('Guardando datos técnicos...', 'info');

        try {
            const response = await fetch(
                '@Url.Action("GuardarDatosTecnicosParaProgramar","PlaneacionPrograma")',
                {
                    method: 'POST',
                    headers: {
                        'Content-Type': 'application/json',
                        'RequestVerificationToken': token
                    },
                    body: JSON.stringify(payload)
                });

            const result = await response.json();

            if (!response.ok || !result.ok) {
                throw new Error(result.mensaje || 'No fue posible guardar.');
            }

            setMensaje(result.mensaje, 'success');

            const releaseDetalleId = qs('dtReleaseDetalleID').value;

            window.setTimeout(() => {
                window.location.href =
                    '@Url.Action("CrearDesdeNecesidad","PlaneacionPrograma")' +
                    `?releaseDetalleId=${encodeURIComponent(releaseDetalleId)}`;
            }, 450);
        }
        catch (error) {
            button.disabled = false;
            setMensaje(error.message, 'danger');
        }
    });
})();
</script>
