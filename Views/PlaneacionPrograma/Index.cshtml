            border-radius: 20px;
            background: #fbfdff;
            font-weight: 800
        }

        .chev {
            transition: transform .18s ease;
            color: var(--azul)
        }

        [aria-expanded="true"] .chev {
            transform: rotate(90deg)
        }

        .hidden-by-search {
            display: none !important
        }

        .compact-priority {
