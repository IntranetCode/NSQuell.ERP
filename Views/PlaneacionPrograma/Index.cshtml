@model ERP.NSQuell.Models.PlaneacionProgramaNecesidadFiltroVm
@using ERP.NSQuell.Models
@using System.Linq
@using System.Collections.Generic


@functions {
    public static string Txt(string? value) => string.IsNullOrWhiteSpace(value) ? "-" : value;
    public static string F(DateTime value) => value == DateTime.MinValue ? "-" : value.ToString("dd/MM/yyyy");
    public static string F(DateTime? value) => value.HasValue ? value.Value.ToString("dd/MM/yyyy") : "-";
    public static string N0(int? value) => value.HasValue ? value.Value.ToString("N0") : "0";
    public static string N0(decimal? value) => value.HasValue ? value.Value.ToString("N0") : "0";
    public static string D2(decimal? value) => value.HasValue ? value.Value.ToString("N2") : "0.00";
    public static string D4(decimal? value) => value.HasValue ? value.Value.ToString("N4") : "0.0000";

    public static bool NecesitaProduccion(PlaneacionProgramaNecesidadVm x)
    {
        return (x.PiezasAProducir ?? 0) > 0;
    }
    // NSQ_PLANEACION_VISTA_ABASTO_V1
    // PT sigue fuera de este bloqueo. MP y embalajes usan disponibilidad neta de reservas.
    public static bool StockOk(PlaneacionProgramaNecesidadVm x)
    {
        // NSQ_ABASTO_TEMP_BYPASS_V1
        // TEMPORAL: MP y embalaje se conservan como datos informativos,
        // pero su disponibilidad NO bloquea Programar molde.
        // Para reactivar abastecimiento, volver a:
        // return MpOk(x) && EmbalajeOk(x);
        return true;
    }

    public static bool MpOk(PlaneacionProgramaNecesidadVm x)
    {
        if (!NecesitaProduccion(x)) return true;
        var requerido = x.MPRequeridaKg ?? 0m;
        if (requerido <= 0m) return true;
        return (x.MPDisponibleKg ?? 0m) + 0.0005m >= requerido;
    }

    public static bool EmbalajeOk(PlaneacionProgramaNecesidadVm x)
    {
        if (!NecesitaProduccion(x)) return true;
        var requerido = x.EmbalajeRequerido ?? 0m;
        if (requerido <= 0m) return true;
        return (x.EmbalajeDisponible ?? 0m) + 0.0005m >= requerido;
    }

    public static bool MoldeOk(PlaneacionProgramaNecesidadVm x)
    {
        return !NecesitaProduccion(x) || x.MoldeID.HasValue;
    }

    public static bool MaquinaOk(PlaneacionProgramaNecesidadVm x)
    {
        return !NecesitaProduccion(x) || x.MaquinaSugeridaID.HasValue;
    }

    public static bool MaterialOk(PlaneacionProgramaNecesidadVm x)
    {
        return !NecesitaProduccion(x) ||
               x.MaterialID.HasValue ||
               !string.IsNullOrWhiteSpace(x.MaterialCodigo);
    }

    public static bool CavidadesOk(PlaneacionProgramaNecesidadVm x)
    {
        return !NecesitaProduccion(x) || ((x.Cavidades ?? 0) > 0);
    }

    public static bool CicloOk(PlaneacionProgramaNecesidadVm x)
    {
        return !NecesitaProduccion(x) || !string.IsNullOrWhiteSpace(x.Ciclo);
    }

    public static bool ObjetivoOk(PlaneacionProgramaNecesidadVm x)
    {
        return !NecesitaProduccion(x) || ((x.ObjetivoHora ?? 0) > 0);
    }

    public static bool PesoOk(PlaneacionProgramaNecesidadVm x)
    {
        return !NecesitaProduccion(x) || ((x.PesoBrutoPieza ?? 0) > 0);
    }

    public static bool EmbalajeTecnicoOk(PlaneacionProgramaNecesidadVm x)
    {
        return !NecesitaProduccion(x) || (!string.IsNullOrWhiteSpace(x.EmbalajeCodigo) && (x.EmbalajeRequerido ?? 0m) > 0m);
    }

    public static bool DatosTecnicosOk(PlaneacionProgramaNecesidadVm x)
    {
        return MaterialOk(x) &&
               MoldeOk(x) &&
               MaquinaOk(x) &&
               CavidadesOk(x) &&
               CicloOk(x) &&
               ObjetivoOk(x) &&
               PesoOk(x) &&
               EmbalajeTecnicoOk(x);
    }

    public static bool ListoCambioMolde(PlaneacionProgramaNecesidadVm x)
    {
        return !x.ProgramaProduccionID.HasValue &&
               NecesitaProduccion(x) &&
               DatosTecnicosOk(x) &&
               StockOk(x);
    }

    public static bool PendienteAbasto(PlaneacionProgramaNecesidadVm x)
    {
        return !x.ProgramaProduccionID.HasValue &&
               NecesitaProduccion(x) &&
               DatosTecnicosOk(x) &&
               !StockOk(x);
    }

    public static bool PendienteDatosTecnicos(PlaneacionProgramaNecesidadVm x)
    {
        return !x.ProgramaProduccionID.HasValue &&
               NecesitaProduccion(x) &&
               !DatosTecnicosOk(x);
    }

    public static bool CubiertoOProgramado(PlaneacionProgramaNecesidadVm x)
    {
        return x.ProgramaProduccionID.HasValue || !NecesitaProduccion(x);
    }

    public static string ClienteNombre(PlaneacionProgramaNecesidadVm x)
    {
        return string.IsNullOrWhiteSpace(x.ClienteNombre) ? "Sin cliente" : x.ClienteNombre!;
    }

    public static string ParteClave(PlaneacionProgramaNecesidadVm x)
    {
        if (!string.IsNullOrWhiteSpace(x.NumeroParte)) return x.NumeroParte!;
        if (!string.IsNullOrWhiteSpace(x.ReferenciaSAP)) return x.ReferenciaSAP!;
        return "-";
    }

    public static string EstadoTexto(PlaneacionProgramaNecesidadVm x)
    {
        if (x.ProgramaProduccionID.HasValue) return "Ya programado";
        if (!NecesitaProduccion(x)) return "Cubierto";
        if (ListoCambioMolde(x)) return "Listo para Cambio de Molde";
        if (PendienteAbasto(x)) return "Pendiente de abastecimiento";
        if (PendienteDatosTecnicos(x)) return "Pendiente de datos técnicos";
        return "Pendiente de revisión";
    }

    public static string EstadoClase(PlaneacionProgramaNecesidadVm x)
    {
        if (ListoCambioMolde(x)) return "estado-ok";
        if (PendienteAbasto(x)) return "estado-warn";
        if (PendienteDatosTecnicos(x)) return "estado-danger";
        return "estado-muted";
    }

    public static string CardClase(PlaneacionProgramaNecesidadVm x)
    {
        if (ListoCambioMolde(x)) return "card-ok";
        if (PendienteAbasto(x)) return "card-warn";
        if (PendienteDatosTecnicos(x)) return "card-danger";
        return "card-muted";
    }

    public static string CollapseId(string prefix, int a) => prefix + "_" + a.ToString();

    public static string DataSearch(PlaneacionProgramaNecesidadVm item)
    {
        return string.Join(" ",
            item.FolioRelease ?? string.Empty,
            item.ClienteNombre ?? string.Empty,
            item.NumeroParte ?? string.Empty,
            item.ReferenciaSAP ?? string.Empty,
            item.DesignacionDescripcionSAP ?? string.Empty,
            item.MaterialCodigo ?? string.Empty,
            item.MaterialDescripcion ?? string.Empty,
            item.MoldeCodigo ?? string.Empty,
            item.MaquinaSugeridaCodigo ?? string.Empty,
            item.MaquinaSugeridaNombre ?? string.Empty,
            item.MensajeCapacidad ?? string.Empty
        ).ToLowerInvariant();
    }

    public static DateTime PrioridadFecha(PlaneacionProgramaNecesidadVm item)
    {
        return item.FechaRequerida == DateTime.MinValue ? DateTime.MaxValue : item.FechaRequerida;
    }

    public static int PrioridadEntrada(PlaneacionProgramaNecesidadVm item)
    {
        return item.ReleaseDetalleID;
    }

    public static string PrioridadTexto(PlaneacionProgramaNecesidadVm item)
    {
        var fecha = item.FechaRequerida == DateTime.MinValue
            ? "Sin fecha"
            : item.FechaRequerida.ToString("dd/MM/yyyy");

        return fecha + " · Entrada " + item.ReleaseDetalleID.ToString();
    }

    public static string ReleaseKey(PlaneacionProgramaNecesidadVm item)
    {
        return string.IsNullOrWhiteSpace(item.FolioRelease)
            ? "SIN_RELEASE"
            : item.FolioRelease.Replace(" ", "_").Replace("/", "_").Replace(".", "_").Replace("-", "_");
    }

    public static string ReleaseTexto(PlaneacionProgramaNecesidadVm item)
    {
        return string.IsNullOrWhiteSpace(item.FolioRelease)
            ? "Sin release"
            : item.FolioRelease!;
    }

    public static DateTime FechaEntregaClave(PlaneacionProgramaNecesidadVm item)
    {
        return item.FechaRequerida == DateTime.MinValue
            ? DateTime.MaxValue
            : item.FechaRequerida.Date;
    }

    public static string FechaEntregaTexto(DateTime fecha)
    {
        return fecha == DateTime.MaxValue
            ? "Sin fecha de entrega"
            : fecha.ToString("dddd dd 'de' MMMM 'de' yyyy");
    }

    public static string FechaEntregaEstado(DateTime fecha)
    {
        if (fecha == DateTime.MaxValue) return "Sin fecha";

        var dias = (fecha.Date - DateTime.Today).Days;

        if (dias < 0) return $"Vencida hace {Math.Abs(dias)} día(s)";
        if (dias == 0) return "Entrega hoy";
        if (dias == 1) return "Entrega mañana";

        return $"Faltan {dias} día(s)";
    }

    public static string FechaEntregaClase(DateTime fecha)
    {
        if (fecha == DateTime.MaxValue) return "date-no-date";

        var dias = (fecha.Date - DateTime.Today).Days;

        if (dias < 0) return "date-overdue";
        if (dias <= 1) return "date-critical";
        if (dias <= 3) return "date-warning";

        return "date-normal";
    }

    public sealed class SeccionUi
    {
        public string Titulo { get; set; } = "";
        public string Sub { get; set; } = "";
        public string Icono { get; set; } = "";
        public string Clase { get; set; } = "";
        public bool Open { get; set; }
        public List<PlaneacionProgramaNecesidadVm> Items { get; set; } = new();
    }
}

@{
    Layout = "~/Views/Shared/_Layout.cshtml";
    ViewData["Title"] = "Programa de Planeación | ERP QUELL";
    var necesidades = Model.Necesidades ?? new List<PlaneacionProgramaNecesidadVm>();
    var listos = necesidades
        .Where(ListoCambioMolde)
        .OrderBy(PrioridadFecha)
        .ThenBy(PrioridadEntrada)
        .ToList();

    var abasto = necesidades
        .Where(PendienteAbasto)
        .OrderBy(PrioridadFecha)
        .ThenBy(PrioridadEntrada)
        .ToList();

    var datosTecnicos = necesidades
        .Where(PendienteDatosTecnicos)
        .OrderBy(PrioridadFecha)
        .ThenBy(PrioridadEntrada)
        .ToList();

    var resueltos = necesidades
        .Where(CubiertoOProgramado)
        .OrderBy(PrioridadFecha)
        .ThenBy(PrioridadEntrada)
        .ToList();

    var secciones = new List<SeccionUi>
{
    new SeccionUi
    {
        Titulo = "Listos para Programa Cambio de Molde",
        Sub = "Renglones con datos técnicos completos. La disponibilidad de MP y embalaje es informativa y temporalmente no bloquea la programación.",
        Items = listos,
        Open = true,
        Icono = "fa-circle-check",
        Clase = "sec-ok"
    },
    new SeccionUi
    {
        Titulo = "Pendientes de abastecimiento",
        Sub = "Renglones con datos técnicos completos pero con MP o embalaje insuficiente después de reservas activas.",
        Items = abasto,
        Open = false,
        Icono = "fa-truck-ramp-box",
        Clase = "sec-warn"
    },
    new SeccionUi
    {
        Titulo = "Pendientes de datos técnicos",
        Sub = "Falta molde, material, cavidades, ciclo, máquina, objetivo/hra, peso bruto o dato técnico de embalaje.",
        Items = datosTecnicos,
        Open = false,
        Icono = "fa-screwdriver-wrench",
        Clase = "sec-danger"
    },
    new SeccionUi
    {
        Titulo = "Cubiertas o ya programadas",
        Sub = "Renglones ya enviados a máquinas o sin piezas pendientes por producir.",
        Items = resueltos,
        Open = false,
        Icono = "fa-box-check",
        Clase = "sec-muted"
    }
};
}

@section Scripts {
    <script>
        document.addEventListener("DOMContentLoaded", function () {
            const buscar = document.getElementById("txtBuscarPantalla");
            const btnCerrarTodo = document.getElementById("btnCerrarTodo");
            const sections = Array.from(document.querySelectorAll("[data-section]"));
            const clients = Array.from(document.querySelectorAll("[data-client]"));
            const rows = Array.from(document.querySelectorAll("[data-row]"));

            function limpiarPantallaCompletaCliente() {
                document.body.classList.remove("client-focus");
                sections.forEach(section => section.classList.remove("has-focus"));
                clients.forEach(client => client.classList.remove("is-fullscreen"));
            }

            function activarPantallaCompletaCliente(collapseEl) {
                const client = collapseEl.closest("[data-client]");
                const section = collapseEl.closest("[data-section]");

                if (!client || !section) return;

                limpiarPantallaCompletaCliente();

                document.body.classList.add("client-focus");
                section.classList.add("has-focus");
                client.classList.add("is-fullscreen");

                const activeRelease = client.querySelector("[data-release-btn].active") || client.querySelector("[data-release-btn]");
                if (activeRelease) {
                    filtrarReleaseCliente(client, activeRelease.dataset.releaseKey);
                }
            }

            function normalize(value) {
                return (value || "").toString().toLowerCase().normalize("NFD").replace(/[\u0300-\u036f]/g, "").trim();
            }

            function setCollapse(el, show) {
                if (!el) return;
                const instance = bootstrap.Collapse.getOrCreateInstance(el, { toggle: false });
                show ? instance.show() : instance.hide();
            }

            function actualizarResumenRelease(client, releaseKey) {
                const btn = client.querySelector(`[data-release-btn][data-release-key="${releaseKey}"]`);
                const summary = client.querySelector("[data-release-summary]");

                if (!btn || !summary) return;

                const cards = Array.from(client.querySelectorAll(`[data-row][data-release-key="${releaseKey}"]`));
                let requerido = 0;
                let pt = 0;
                let blanco = 0;
                let producir = 0;
                let programado = 0;

                cards.forEach(card => {
                    requerido += parseInt(card.dataset.requerido || "0",10);
                    pt += parseInt(card.dataset.pt || "0",10);
                    blanco += parseInt(card.dataset.blanco || "0",10);
                    producir += parseInt(card.dataset.producir || "0",10);
                    programado += parseInt(card.dataset.programado || "0",10);
                });

                summary.textContent=requerido.toLocaleString("es-MX")+" requerido · "+blanco.toLocaleString("es-MX")+" etiqueta blanca · "+producir.toLocaleString("es-MX")+" a producir · "+programado.toLocaleString("es-MX")+" programado";
            }

            function filtrarReleaseCliente(client, releaseKey) {
                if (!client || !releaseKey) return;

                client.querySelectorAll("[data-release-btn]").forEach(btn => {
                    btn.classList.toggle("active", btn.dataset.releaseKey === releaseKey);
                });

                client.querySelectorAll("[data-row]").forEach(row => {
                    row.classList.toggle("hidden-by-release", row.dataset.releaseKey !== releaseKey);
                });

                actualizarResumenRelease(client, releaseKey);
            }


            function aplicarBusqueda() {
                const q = normalize(buscar?.value || "");
                rows.forEach(row => {
                    const visible = !q || normalize(row.dataset.search).includes(q);
                    row.classList.toggle("hidden-by-search", !visible);
                });

                clients.forEach(client => {
                    const visibleRows = Array.from(client.querySelectorAll("[data-row]")).some(row => !row.classList.contains("hidden-by-search"));
                    const visibleClient = !q || normalize(client.dataset.search).includes(q) || visibleRows;
                    client.classList.toggle("hidden-by-search", !visibleClient);

                    if (q && visibleClient) {
                        setCollapse(client.querySelector("[data-collapse-level='client']"), true);
                    }
                });

                document.querySelectorAll("[data-date-group]").forEach(dateGroup => {
                    const visibleClients = Array.from(dateGroup.querySelectorAll("[data-client]"))
                        .some(client => !client.classList.contains("hidden-by-search"));

                    dateGroup.classList.toggle("hidden-by-search", q && !visibleClients);

                    if (q && visibleClients) {
                        setCollapse(dateGroup.querySelector("[data-collapse-level='date']"), true);
                    }
                });

                sections.forEach(section => {
                    const visibleClients = Array.from(section.querySelectorAll("[data-client]")).some(client => !client.classList.contains("hidden-by-search"));
                    section.classList.toggle("hidden-by-search", q && !visibleClients);
                    if (q && visibleClients) setCollapse(section.querySelector("[data-collapse-level='section']"), true);
                });
            }

            document.querySelectorAll("[data-release-btn]").forEach(btn => {
                btn.addEventListener("click", function (event) {
                    event.preventDefault();
                    event.stopPropagation();

                    const client = btn.closest("[data-client]");
                    filtrarReleaseCliente(client, btn.dataset.releaseKey);
                });
            });

            document.querySelectorAll("[data-collapse-level='client']").forEach(el => {
                el.addEventListener("shown.bs.collapse", function () {
                    activarPantallaCompletaCliente(el);
                });

                el.addEventListener("hidden.bs.collapse", function () {
                    const client = el.closest("[data-client]");
                    if (client && client.classList.contains("is-fullscreen")) {
                        limpiarPantallaCompletaCliente();
                    }
                });
            });

            document.addEventListener("keydown", function (event) {
                if (event.key !== "Escape" || !document.body.classList.contains("client-focus")) {
                    return;
                }

                const openClient = document.querySelector(".client-panel.is-fullscreen [data-collapse-level='client']");
                if (openClient) {
                    setCollapse(openClient, false);
                } else {
                    limpiarPantallaCompletaCliente();
                }
            });

            buscar?.addEventListener("input", aplicarBusqueda);
            btnCerrarTodo?.addEventListener("click", function () {
                limpiarPantallaCompletaCliente();
                document.querySelectorAll(
                    "[data-collapse-level='client'], [data-collapse-level='date'], [data-collapse-level='section']"
                ).forEach(el => setCollapse(el, false));
            });
        });
    </script>
    <script>
        /* PROGRAMA_CLIENTE_FULLSCREEN_CIERRE_CAPTURA_V1_4 */
        document.addEventListener("DOMContentLoaded", function () {
            function cerrarClienteFullscreen(client, head) {
                if (!client) return;

                const collapseEl = client.querySelector("[data-collapse-level='client']");

                // Primero retirar las clases que fuerzan el panel como fixed y
                // mantienen el collapse visible con display:block !important.
                document.body.classList.remove("client-focus");

                document.querySelectorAll("[data-section]").forEach(function (section) {
                    section.classList.remove("has-focus");
                });

                document.querySelectorAll("[data-client]").forEach(function (item) {
                    item.classList.remove("is-fullscreen");
                });

                if (head) {
                    head.setAttribute("aria-expanded", "false");
                }

                if (collapseEl) {
                    const instance = bootstrap.Collapse.getOrCreateInstance(
                        collapseEl,
                        { toggle: false }
                    );

                    instance.hide();

                    // Fallback determinista: si Bootstrap conserva el estado
                    // por la transicion, retirar show garantiza el minimizado.
                    collapseEl.classList.remove("show");
                }
            }

            // Captura = true: este listener se ejecuta antes del data-api
            // delegado de Bootstrap. Asi el mismo clic no vuelve a abrirlo.
            document.addEventListener("click", function (event) {
                const target = event.target instanceof Element ? event.target : null;
                const head = target ? target.closest(".client-panel-head") : null;

                if (!head) return;

                const client = head.closest("[data-client]");
                if (!client || !client.classList.contains("is-fullscreen")) {
                    return;
                }

                event.preventDefault();
                event.stopPropagation();
                event.stopImmediatePropagation();

                cerrarClienteFullscreen(client, head);
            }, true);

            document.addEventListener("keydown", function (event) {
                if (event.key !== "Escape") return;

                const client = document.querySelector(".client-panel.is-fullscreen");
                if (!client) return;

                const head = client.querySelector(".client-panel-head");

                event.preventDefault();
                event.stopPropagation();
                event.stopImmediatePropagation();

                cerrarClienteFullscreen(client, head);
            }, true);
        });
    </script>
    <script>
        /* PROGRAMA_CLIENTE_FULLSCREEN_CIERRE_FINAL_V1_5 */
        (function () {
            function cerrarClienteFullscreen(client, head) {
                if (!client) return;

                const collapseEl = client.querySelector("[data-collapse-level='client']");
                const section = client.closest("[data-section]");

                // 1. Salir primero del modo visual fullscreen.
                document.body.classList.remove("client-focus");

                if (section) {
                    section.classList.remove("has-focus");
                }

                document.querySelectorAll("[data-client].is-fullscreen").forEach(function (item) {
                    item.classList.remove("is-fullscreen");
                });

                // 2. Cerrar el collapse SIN volver a pasar por el toggle de Bootstrap.
                if (collapseEl) {
                    collapseEl.classList.remove("show");
                    collapseEl.classList.remove("collapsing");
                    collapseEl.style.height = "";
                }

                // 3. Sincronizar el encabezado.
                if (head) {
                    head.classList.add("collapsed");
                    head.setAttribute("aria-expanded", "false");
                }
            }

            // CAPTURE = true: este manejador corre antes del data-api de Bootstrap.
            document.addEventListener("click", function (event) {
                const head = event.target.closest(".client-panel-head");
                if (!head) return;

                const client = head.closest("[data-client]");
                if (!client || !client.classList.contains("is-fullscreen")) {
                    return;
                }

                event.preventDefault();
                event.stopPropagation();
                event.stopImmediatePropagation();

                cerrarClienteFullscreen(client, head);
            }, true);

            document.addEventListener("keydown", function (event) {
                if (event.key !== "Escape") return;

                const client = document.querySelector("[data-client].is-fullscreen");
                if (!client) return;

                const head = client.querySelector(".client-panel-head");

                event.preventDefault();
                event.stopPropagation();
                event.stopImmediatePropagation();

                cerrarClienteFullscreen(client, head);
            }, true);
        })();
    </script>
}


