        @{
            var sectionIndex = 0;
        }

        @foreach (var sec in secciones)
        {
            sectionIndex++;
            var sectionCollapseId = CollapseId("sec", sectionIndex);
            var items = sec.Items;
            var sectionOpen = sec.Open;

            <section class="section @sec.Clase" data-section data-search="@string.Join(" ", items.Select(DataSearch))">
                <div class="section-head" data-bs-toggle="collapse" data-bs-target="#@sectionCollapseId" aria-expanded="@(sectionOpen ? "true" : "false")" aria-controls="@sectionCollapseId">
                    <div>
                        <h2 class="section-title"><span class="section-icon"><i class="fa-solid @sec.Icono"></i></span><span>@sec.Titulo</span><i class="fa-solid fa-chevron-right chev"></i></h2>
                        <div class="section-sub">@sec.Sub</div>
                    </div>
                    <div class="d-flex gap-2 flex-wrap">
                        <span class="count-pill">@items.Count.ToString("N0") registro(s)</span>
                        <span class="summary-pill">@items.Sum(x => x.CantidadRequerida).ToString("N0") requerido</span>
                        <span class="summary-pill">@items.Sum(x => x.ProduccionProgramadaPendiente ?? 0).ToString("N0") programado</span>
                        <span class="summary-pill">@items.Sum(x => x.HorasNecesarias ?? 0).ToString("N2") hrs</span>
                    </div>
                </div>

                <div id="@sectionCollapseId" class="collapse @(sectionOpen ? "show" : "")" data-collapse-level="section">
                    <div class="section-body">
                        @if (!items.Any())
                        {
                            <div class="empty"><i class="fa-regular fa-folder-open fa-2x mb-2"></i><div>No hay registros en esta sección.</div></div>
                        }
                        else
                        {
                            var clientesOrdenados = items
                            .GroupBy(ClienteNombre)
                            .Select(g => new
                            {
                                Cliente = g.Key,
                                Items = g.OrderBy(PrioridadFecha).ThenBy(PrioridadEntrada).ToList(),
                                FechaPrioridad = g.Min(PrioridadFecha),
                                EntradaPrioridad = g.Min(PrioridadEntrada)
                            })
                            .OrderBy(g => g.FechaPrioridad)
                            .ThenBy(g => g.EntradaPrioridad)
                            .ThenBy(g => g.Cliente)
                            .ToList();

                            <div class="client-grid">
                                @{
                                    var clientIndex = 0;
                                }

                                @foreach (var clienteGrupo in clientesOrdenados)
                                {
                                    clientIndex++;
                                    var clienteCollapseId = "cliente_" + sectionIndex.ToString() + "_" + clientIndex.ToString();
                                    var clienteItems = clienteGrupo.Items;
                                    var primerItemCliente = clienteItems.First();
                                    var partesCliente = clienteItems.Select(ParteClave).Distinct().Count();

                                    var releasesCliente = clienteItems
                                    .GroupBy(ReleaseKey)
                                    .Select(g => new
                                    {
                                        Key = g.Key,
                                        Texto = ReleaseTexto(g.First()),
                                        Items = g.OrderBy(PrioridadFecha).ThenBy(PrioridadEntrada).ToList(),
                                        FechaPrioridad = g.Min(PrioridadFecha),
                                        EntradaPrioridad = g.Min(PrioridadEntrada),
                                        TotalRequerido = g.Sum(x => x.CantidadRequerida),
                                        TotalPT = g.Sum(x => x.PiezasDesdePT ?? 0),
                                        TotalProgramado = g.Sum(x => x.ProduccionProgramadaPendiente ?? 0)
                                    })
                                    .OrderBy(g => g.FechaPrioridad)
                                    .ThenBy(g => g.EntradaPrioridad)
                                    .ToList();

                                    var releaseInicial = releasesCliente.First().Key;

                                    <article class="client-panel" data-client data-search="@clienteGrupo.Cliente @string.Join(" ", clienteItems.Select(DataSearch))">
                                        <button type="button"
                                                class="client-panel-head"
                                                data-bs-toggle="collapse"
                                                data-bs-target="#@clienteCollapseId"
                                                aria-expanded="false"
                                                aria-controls="@clienteCollapseId">
                                            <div>
                                                <div class="client-name">
                                                    <i class="fa-solid fa-chevron-right chev me-2"></i>
                                                    @clienteGrupo.Cliente
                                                </div>
                                                <div class="client-meta">
                                                    @clienteItems.Count.ToString("N0") registro(s) ·
                                                    @partesCliente.ToString("N0") parte(s) ·
                                                    @clienteItems.Sum(x => x.CantidadRequerida).ToString("N0") requerido ·
                                                    @clienteItems.Sum(x => x.ProduccionProgramadaPendiente ?? 0).ToString("N0") programado
                                                </div>
                                            </div>

                                            <span class="client-priority">
                                                <i class="fa-solid fa-arrow-up-short-wide"></i>
                                                @PrioridadTexto(primerItemCliente)
                                            </span>
                                        </button>

                                        <div id="@clienteCollapseId" class="collapse" data-collapse-level="client">
                                            <div class="client-body">
                                                <div class="release-toolbar" data-release-toolbar>
                                                    <span class="release-toolbar-label">Release</span>

                                                    @foreach (var rel in releasesCliente)
                                                    {
                                                        <button type="button"
                                                                class="release-btn @(rel.Key == releaseInicial ? "active" : "")"
                                                                data-release-btn
                                                                data-release-key="@rel.Key">
                                                            <i class="fa-solid fa-layer-group"></i>
                                                            @rel.Texto
                                                            <span class="release-count">@rel.Items.Count</span>
                                                        </button>
                                                    }

                                                    <span class="release-summary" data-release-summary>
                                                        @releasesCliente.First().TotalRequerido.ToString("N0") requerido ·
                                                        @releasesCliente.First().TotalPT.ToString("N0") PT apartado ·
                                                        @releasesCliente.First().TotalProgramado.ToString("N0") programado
                                                    </span>
                                                </div>

                                                <div class="cards-grid">
                                                    @foreach (var item in clienteItems)
                                                    {
                                                        var modalId = ModalId(item);

                                                        <article class="need-card @CardClase(item) @(ReleaseKey(item) == releaseInicial ? "" : "hidden-by-release")" data-row data-release-key="@ReleaseKey(item)" data-requerido="@item.CantidadRequerida" data-pt="@(item.PiezasDesdePT ?? 0)" data-programado="@(item.ProduccionProgramadaPendiente ?? 0)" data-search="@DataSearch(item)">
                                                            <div class="need-head">
                                                                <div>
                                                                    <div class="need-title">@ParteClave(item)</div>
                                                                    <div class="need-sub">@Txt(item.DesignacionDescripcionSAP)</div>
                                                                    <div class="compact-priority">
                                                                        <i class="fa-solid fa-arrow-up-short-wide me-1"></i>
                                                                        @PrioridadTexto(item)
                                                                    </div>
                                                                </div>
                                                                <span class="estado @EstadoClase(item)"><i class="fa-solid fa-circle"></i>@EstadoTexto(item)</span>
                                                            </div>

                                                            <div class="mini-metrics">
                                                                <div class="mini-metric">
                                                                    <div class="mini-metric-label">Fecha</div>
                                                                    <div class="mini-metric-value">@F(item.FechaRequerida)</div>
                                                                </div>
                                                                <div class="mini-metric">
                                                                    <div class="mini-metric-label">Requerido</div>
                                                                    <div class="mini-metric-value">@item.CantidadRequerida.ToString("N0")</div>
                                                                </div>
                                                                <div class="mini-metric">
                                                                    <div class="mini-metric-label">PT apartado</div>
                                                                    <div class="mini-metric-value">@N0(item.PiezasDesdePT)</div>
                                                                </div>
                                                            </div>

                                                            <div class="compact-line">
                                                                <span class="compact-chip"><i class="fa-solid fa-industry"></i>@Txt(item.MaquinaSugeridaCodigo)</span>
                                                                <span class="compact-chip"><i class="fa-solid fa-shapes"></i>@Txt(item.MoldeCodigo)</span>
                                                                <span class="compact-chip"><i class="fa-solid fa-clock"></i>@D2(item.HorasNecesarias) hrs</span>
                                                            </div>

                                                            <div class="card-actions">
                                                                <button type="button" class="btn-card-light" data-bs-toggle="modal" data-bs-target="#@modalId">
                                                                    <i class="fa-solid fa-up-right-and-down-left-from-center"></i>
                                                                    Abrir
                                                                </button>

                                                                @if (item.ProgramaProduccionID.HasValue)
                                                                {
                                                                    <a class="btn-card-main" asp-controller="PlaneacionPrograma" asp-action="Maquinas">
                                                                        <i class="fa-solid fa-table-columns"></i>
                                                                        Máquinas
                                                                    </a>
                                                                }
                                                                else if (ListoCambioMolde(item))
                                                                {
                                                                    <span class="summary-pill">Listo</span>
                                                                }
                                                                else
                                                                {
                                                                    <span class="summary-pill">Revisar</span>
                                                                }
                                                            </div>
                                                        </article>

                                                        <div class="modal fade" id="@modalId" tabindex="-1" aria-hidden="true" data-bs-backdrop="false">
                                                            <div class="modal-dialog modal-dialog-centered modal-lg">
                                                                <div class="modal-content">
                                                                    <div class="modal-header">
                                                                        <div>
                                                                            <h5 class="modal-title"><i class="fa-solid fa-circle-info me-2"></i>Detalle de necesidad</h5>
                                                                            <div class="small opacity-75 mt-1">Revisa la información clave antes de programar el molde.</div>
                                                                        </div>
                                                                        <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Cerrar"></button>
                                                                    </div>

                                                                    <div class="modal-body">
                                                                        <div class="modal-summary">
                                                                            <div class="modal-box"><div class="modal-label">Cliente</div><div class="modal-value">@ClienteNombre(item)</div></div>
                                                                            <div class="modal-box"><div class="modal-label">Parte</div><div class="modal-value">@ParteClave(item)</div></div>
                                                                            <div class="modal-box"><div class="modal-label">Prioridad FIFO</div><div class="modal-value">@PrioridadTexto(item)</div></div>
                                                                            <div class="modal-box"><div class="modal-label">Release</div><div class="modal-value">@Txt(item.FolioRelease)</div></div>
                                                                            <div class="modal-box"><div class="modal-label">Designación</div><div class="modal-value">@Txt(item.DesignacionDescripcionSAP)</div></div>
                                                                            <div class="modal-box"><div class="modal-label">Fecha requerida</div><div class="modal-value">@F(item.FechaRequerida)</div></div>
                                                                            <div class="modal-box"><div class="modal-label">Requerido</div><div class="modal-value">@item.CantidadRequerida.ToString("N0") pzas</div></div>
                                                                            <div class="modal-box"><div class="modal-label">PT físico</div><div class="modal-value">@N0(item.PTDisponibleAlCalcular) pzas</div></div>
                                                                            <div class="modal-box"><div class="modal-label">PT apartado por otros</div><div class="modal-value">@N0(item.PTApartadoOtros) pzas</div></div>
                                                                            <div class="modal-box"><div class="modal-label">PT neto disponible</div><div class="modal-value">@N0(item.PTDisponibleNeto) pzas</div></div>
                                                                            <div class="modal-box"><div class="modal-label">PT reservado para este release</div><div class="modal-value">@N0(item.PiezasDesdePT) pzas</div></div>
                                                                            <div class="modal-box"><div class="modal-label">Programado pendiente</div><div class="modal-value">@N0(item.ProduccionProgramadaPendiente) pzas</div></div>
                                                                            <div class="modal-box"><div class="modal-label">Máquina / Molde</div><div class="modal-value">@Txt(item.MaquinaSugeridaCodigo) / @Txt(item.MoldeCodigo)</div></div>
                                                                            <div class="modal-box"><div class="modal-label">Material</div><div class="modal-value">@Txt(item.MaterialCodigo) · @Txt(item.MaterialDescripcion)</div></div>
                                                                            <div class="modal-box"><div class="modal-label">MP disp./req.</div><div class="modal-value">@D4(item.MPDisponibleKg) / @D4(item.MPRequeridaKg)</div></div>
                                                                            <div class="modal-box"><div class="modal-label">Emb. disp./req.</div><div class="modal-value">@D2(item.EmbalajeDisponible) / @D2(item.EmbalajeRequerido)</div></div>
                                                                            <div class="modal-box"><div class="modal-label">Horas / Obj-Hra</div><div class="modal-value">@D2(item.HorasNecesarias) / @N0(item.ObjetivoHora)</div></div>
                                                                        </div>

                                                                        <div class="validation-row">
                                                                            <span class="@CheckClase(StockOk(item))"><i class="fa-solid @CheckIcono(StockOk(item))"></i>Stock</span>
                                                                            <span class="@CheckClase(MoldeOk(item))"><i class="fa-solid @CheckIcono(MoldeOk(item))"></i>Molde</span>
                                                                            <span class="@CheckClase(MaterialOk(item))"><i class="fa-solid @CheckIcono(MaterialOk(item))"></i>Material</span>
                                                                            <span class="@CheckClase(CavidadesOk(item))"><i class="fa-solid @CheckIcono(CavidadesOk(item))"></i>Cav.</span>
                                                                            <span class="@CheckClase(CicloOk(item))"><i class="fa-solid @CheckIcono(CicloOk(item))"></i>Ciclo</span>
                                                                            <span class="@CheckClase(MaquinaOk(item))"><i class="fa-solid @CheckIcono(MaquinaOk(item))"></i>Máquina</span>
                                                                            <span class="@CheckClase(ObjetivoOk(item))"><i class="fa-solid @CheckIcono(ObjetivoOk(item))"></i>Obj</span>
                                                                            <span class="@CheckClase(MpOk(item))"><i class="fa-solid @CheckIcono(MpOk(item))"></i>MP</span>
                                                                            <span class="@CheckClase(EmbalajeOk(item))"><i class="fa-solid @CheckIcono(EmbalajeOk(item))"></i>Emb.</span>
                                                                        </div>
                                                                        @if (ListoCambioMolde(item))
                                                                        {
                                                                            <div class="alert alert-info rounded-4 fw-semibold mt-3 mb-0"><i class="fa-solid fa-circle-info me-2"></i>Al continuar, se abrirá la pantalla donde se define condición T.P / I.P, hora de cambio, hora de arranque y máquina final.</div>
                                                                        }
                                                                        else if (item.ProgramaProduccionID.HasValue)
                                                                        {
                                                                            <div class="alert alert-success rounded-4 fw-semibold mt-3 mb-0"><i class="fa-solid fa-circle-check me-2"></i>Esta necesidad ya fue programada. Puedes consultarla en máquinas.</div>
                                                                        }
                                                                        else
                                                                        {
                                                                            <div class="alert alert-warning rounded-4 fw-semibold mt-3 mb-0"><i class="fa-solid fa-triangle-exclamation me-2"></i>Esta necesidad todavía no está lista para programarse. Revisa las validaciones marcadas en rojo.</div>
                                                                        }
                                                                    </div>

                                                                    <div class="modal-footer">
                                                                        <button type="button" class="btn btn-light rounded-4 fw-bold" data-bs-dismiss="modal">Cerrar</button>

                                                                        @if (ListoCambioMolde(item))
                                                                        {
                                                                            <a class="btn btn-primary rounded-4 fw-bold" href="@Url.Action("CrearDesdeNecesidad", "PlaneacionPrograma", new { releaseDetalleId = item.ReleaseDetalleID })">
                                                                                Programar molde
                                                                                <i class="fa-solid fa-arrow-right ms-1"></i>
                                                                            </a>
                                                                        }
                                                                        else if (item.ProgramaProduccionID.HasValue)
                                                                        {
                                                                            <a class="btn btn-primary rounded-4 fw-bold" asp-controller="PlaneacionPrograma" asp-action="Maquinas">
                                                                                Ver en máquinas
                                                                                <i class="fa-solid fa-table-columns ms-1"></i>
                                                                            </a>
                                                                        }
                                                                    </div>
                                                                </div>
                                                            </div>
                                                        </div>
                                                    }
                                                </div>
                                            </div>
                                        </div>
                                    </article>
                                }
                            </div>
                        }
                    </div>
                </div>
            </section>
        }

        <section class="sticky-actions">
            <div class="d-flex justify-content-between gap-2 flex-wrap">
                <a asp-controller="PlaneacionRelease" asp-action="Index" class="btn btn-light rounded-4 fw-bold"><i class="fa-solid fa-arrow-left me-1"></i>Releases</a>
                <div class="d-flex gap-2 flex-wrap">
                    <a asp-controller="PlaneacionPanorama" asp-action="Index" class="btn btn-light rounded-4 fw-bold"><i class="fa-solid fa-chart-line me-1"></i>Panorama</a>
                    <a asp-controller="PlaneacionPrograma" asp-action="Maquinas" class="btn-main"><i class="fa-solid fa-gears me-1"></i>Máquinas / Cambios</a>
                </div>
            </div>
        </section>
    </div>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
    <script>
        document.addEventListener("DOMContentLoaded", function () {
            const buscar = document.getElementById("txtBuscarPantalla");
            const btnCerrarTodo = document.getElementById("btnCerrarTodo");
            const sections = Array.from(document.querySelectorAll("[data-section]"));
            const clients = Array.from(document.querySelectorAll("[data-client]"));
            const rows = Array.from(document.querySelectorAll("[data-row]"));

            function limpiarPantallaCompletaCliente() {
                document.body.classList.remove("client-focus");
                sections.forEach(section => section.classList.remove("has-focus"));
                clients.forEach(client => client.classList.remove("is-fullscreen"));
            }

            function activarPantallaCompletaCliente(collapseEl) {
                const client = collapseEl.closest("[data-client]");
                const section = collapseEl.closest("[data-section]");

                if (!client || !section) return;

                limpiarPantallaCompletaCliente();

                document.body.classList.add("client-focus");
                section.classList.add("has-focus");
                client.classList.add("is-fullscreen");

                const activeRelease = client.querySelector("[data-release-btn].active") || client.querySelector("[data-release-btn]");
                if (activeRelease) {
                    filtrarReleaseCliente(client, activeRelease.dataset.releaseKey);
                }
            }

            function normalize(value) {
                return (value || "").toString().toLowerCase().normalize("NFD").replace(/[\u0300-\u036f]/g, "").trim();
            }

            function setCollapse(el, show) {
                if (!el) return;
                const instance = bootstrap.Collapse.getOrCreateInstance(el, { toggle: false });
                show ? instance.show() : instance.hide();
            }

            function actualizarResumenRelease(client, releaseKey) {
                const btn = client.querySelector(`[data-release-btn][data-release-key="${releaseKey}"]`);
                const summary = client.querySelector("[data-release-summary]");

                if (!btn || !summary) return;

                const cards = Array.from(client.querySelectorAll(`[data-row][data-release-key="${releaseKey}"]`));
                let requerido = 0;
                let pt = 0;
                let programado = 0;

                cards.forEach(card => {
                    requerido += parseInt(card.dataset.requerido || "0", 10);
                    pt += parseInt(card.dataset.pt || "0", 10);
                    programado += parseInt(card.dataset.programado || "0", 10);
                });

                summary.textContent =
                    requerido.toLocaleString("es-MX") + " requerido · " +
                    pt.toLocaleString("es-MX") + " PT apartado · " +
                    programado.toLocaleString("es-MX") + " programado";
            }

            function filtrarReleaseCliente(client, releaseKey) {
                if (!client || !releaseKey) return;

                client.querySelectorAll("[data-release-btn]").forEach(btn => {
                    btn.classList.toggle("active", btn.dataset.releaseKey === releaseKey);
                });

                client.querySelectorAll("[data-row]").forEach(row => {
                    row.classList.toggle("hidden-by-release", row.dataset.releaseKey !== releaseKey);
                });

                actualizarResumenRelease(client, releaseKey);
            }


            function aplicarBusqueda() {
                const q = normalize(buscar?.value || "");
                rows.forEach(row => {
                    const visible = !q || normalize(row.dataset.search).includes(q);
                    row.classList.toggle("hidden-by-search", !visible);
                });

                clients.forEach(client => {
                    const visibleRows = Array.from(client.querySelectorAll("[data-row]")).some(row => !row.classList.contains("hidden-by-search"));
                    const visibleClient = !q || normalize(client.dataset.search).includes(q) || visibleRows;
                    client.classList.toggle("hidden-by-search", !visibleClient);

                    if (q && visibleClient) {
                        setCollapse(client.querySelector("[data-collapse-level='client']"), true);
                    }
                });

                sections.forEach(section => {
                    const visibleClients = Array.from(section.querySelectorAll("[data-client]")).some(client => !client.classList.contains("hidden-by-search"));
                    section.classList.toggle("hidden-by-search", q && !visibleClients);
                    if (q && visibleClients) setCollapse(section.querySelector("[data-collapse-level='section']"), true);
                });
            }

            document.querySelectorAll("[data-release-btn]").forEach(btn => {
                btn.addEventListener("click", function (event) {
                    event.preventDefault();
                    event.stopPropagation();

                    const client = btn.closest("[data-client]");
                    filtrarReleaseCliente(client, btn.dataset.releaseKey);
                });
            });

            document.querySelectorAll(".modal").forEach(modal => {
                modal.addEventListener("click", function (event) {
                    event.stopPropagation();
                });
            });

            document.querySelectorAll("[data-collapse-level='client']").forEach(el => {
                el.addEventListener("shown.bs.collapse", function () {
                    activarPantallaCompletaCliente(el);
                });

                el.addEventListener("hidden.bs.collapse", function () {
                    const client = el.closest("[data-client]");
                    if (client && client.classList.contains("is-fullscreen")) {
                        limpiarPantallaCompletaCliente();
                    }
                });
            });

            document.addEventListener("keydown", function (event) {
                if (event.key !== "Escape" || !document.body.classList.contains("client-focus")) {
                    return;
                }

                const modalAbierto = document.querySelector(".modal.show");
                if (modalAbierto) {
                    return;
                }

                const openClient = document.querySelector(".client-panel.is-fullscreen [data-collapse-level='client']");
                if (openClient) {
                    setCollapse(openClient, false);
                } else {
                    limpiarPantallaCompletaCliente();
                }
            });

            buscar?.addEventListener("input", aplicarBusqueda);
            btnCerrarTodo?.addEventListener("click", function () {
                limpiarPantallaCompletaCliente();
                document.querySelectorAll("[data-collapse-level='section']").forEach(el => setCollapse(el, false));
            });
        });
    </script>
</body>
</html>
