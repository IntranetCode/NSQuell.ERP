            border-radius: 999px;
            padding: 4px 7px;
            font-size: .66rem;
            font-weight: 900;
            display: inline-flex;
            align-items: center;
            gap: 4px
        }

        .modal-content {
            border-radius: 26px;
            border: none;
            box-shadow: var(--shadow)
        }

        .modal-header {
            background: linear-gradient(135deg,var(--azul),var(--azul2));
            color: #fff;
            border-radius: 26px 26px 0 0;
            border-bottom: none;
            padding: 22px 24px
        }

        .modal-title {
            font-weight: 950
        }

        .modal-body {
            padding: 22px 24px
        }

        .modal-summary {
            display: grid;
            grid-template-columns: repeat(2,minmax(0,1fr));
            gap: 10px
        }

        .modal-box {
            border: 1px solid var(--linea);
            border-radius: 16px;
            background: #fbfdff;
            padding: 11px
        }

        .modal-label {
            color: var(--muted);
            font-size: .70rem;
            font-weight: 950;
            text-transform: uppercase;
            letter-spacing: .04em
        }

        .modal-value {
            color: var(--texto);
            font-weight: 950;
            margin-top: 3px
        }

        .sticky-actions {
            position: sticky;
            bottom: 18px;
            z-index: 20;
            margin-top: 20px;
            background: rgba(255,255,255,.92);
            border: 1px solid var(--linea);
            backdrop-filter: blur(14px);
            border-radius: 22px;
            padding: 12px;
            box-shadow: var(--shadow)
        }

        body.client-focus {
            overflow: hidden;
        }

            body.client-focus .hero,
            body.client-focus .filter-card,
            body.client-focus .sticky-actions,
            body.client-focus .section:not(.has-focus),
            body.client-focus .section.has-focus > .section-head {
                display: none !important;
            }

            body.client-focus .page {
                max-width: none;
                padding: 0;
            }

            body.client-focus .section.has-focus {
                border: none;
                box-shadow: none;
                margin: 0;
                border-radius: 0;
                background: transparent;
            }

                body.client-focus .section.has-focus > .collapse,
                body.client-focus .section.has-focus > .collapse > .section-body,
                body.client-focus .section.has-focus .client-grid {
                    display: block !important;
                    padding: 0;
                }

            body.client-focus .client-panel:not(.is-fullscreen) {
                display: none !important;
            }

        .client-panel.is-fullscreen {
            position: fixed;
            inset: 10px;
            z-index: 1020;
            display: flex !important;
            flex-direction: column;
            background: #ffffff;
            border: 1px solid #cfe0ff;
            border-radius: 26px;
            box-shadow: 0 26px 70px rgba(15,23,42,.22);
            overflow: hidden;
        }

            .client-panel.is-fullscreen .client-panel-head {
                flex: 0 0 auto;
                background: linear-gradient(135deg,#ffffff,#f6faff);
                border-bottom: 1px solid #e6eef9;
                padding: 18px 20px;
            }

            .client-panel.is-fullscreen .client-name {
                font-size: 1.18rem;
            }

            .client-panel.is-fullscreen .client-meta {
                font-size: .88rem;
            }

            .client-panel.is-fullscreen .client-priority::after {
                content: " · Clic en el encabezado para cerrar";
            }

            .client-panel.is-fullscreen .collapse {
                display: block !important;
                flex: 1 1 auto;
                min-height: 0;
                overflow: hidden;
            }

            .client-panel.is-fullscreen .client-body {
                height: 100%;
                overflow: auto;
                padding: 16px;
                background: linear-gradient(180deg,#fbfdff,#f3f7fc);
            }

            .client-panel.is-fullscreen .cards-grid {
                grid-template-columns: repeat(auto-fill,minmax(230px,1fr));
                gap: 10px;
                align-content: start;
                padding-bottom: 24px;
            }

            .client-panel.is-fullscreen .need-card {
                min-height: 154px;
            }

            .client-panel.is-fullscreen .modal {
                z-index: 1080;
            }

                .client-panel.is-fullscreen .modal.show {
                    display: block;
                }

        @@media(max-width:1200px) {
            .cards-grid {
                grid-template-columns: repeat(auto-fill,minmax(205px,1fr))
            }
        }

        @@media(max-width:700px) {
            .page {
                padding: 14px
            }

            .hero {
                padding: 24px
            }

            .cards-grid {
                grid-template-columns: 1fr
            }

            .data-grid, .modal-summary {
                grid-template-columns: repeat(2,minmax(0,1fr))
            }
        }
    </style>
