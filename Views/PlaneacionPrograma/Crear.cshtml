                            </div>
                            <span asp-validation-for="CantidadBasePrograma" class="text-danger small"></span>

                            <div class="aumento-cajas-box">
                                <div class="aumento-cajas-header">
                                    <div>
                                        <div class="fw-bold">
                                            <i class="fa-solid fa-boxes-stacked me-1"></i>
                                            Aumento por cajas
                                        </div>
                                        <div class="small text-muted">
                                            Opcional. Transfiere piezas desde otra entrega de la misma pieza/renglón del Release actual.
                                        </div>
                                        <div class="aumento-cajas-parte">
                                            <i class="fa-solid fa-barcode"></i>
                                            <span>
                                                <strong>Pieza leida:</strong>
                                                @(string.IsNullOrWhiteSpace(Model.NumeroParte) ? "Sin numero de parte" : Model.NumeroParte)
                                            </span>
                                        </div>
                                    </div>

                                    @* NSQ_PLANEACION_AUMENTO_POR_CAJAS_V1_2 *@
                                    <span class="aumento-cajas-capacidad">
                                        @if ((Model.PiezasPorEmbalaje ?? 0) > 0)
                                        {
                                            <text>1 caja = @Convert.ToInt32(Model.PiezasPorEmbalaje!.Value).ToString("N0") pzas</text>
                                        }
                                        else if ((Model.PiezasPorCaja ?? 0) > 0)
                                        {
                                            <text>1 caja = @Model.PiezasPorCaja!.Value.ToString("N0") pzas</text>
                                        }
                                        else
                                        {
                                            <text>Sin capacidad de caja/embalaje</text>
                                        }
                                    </span>
                                </div>

                                <div id="aumentosReleaseFilas"
                                     class="aumento-cajas-lista">
                                    @for (var i = 0; i < Model.AumentosRelease.Count; i++)
                                    {
                                        <div class="aumento-cajas-fila js-aumento-fila">
                                            <div class="aumento-cajas-origen">
                                                <label class="field-label">
                                                    Descontar de entrega / fila del mismo renglon
                                                </label>
                                                <select asp-for="AumentosRelease[i].ReleaseDetalleOrigenAumentoID"
                                                        class="form-select js-aumento-origen">
                                                    <option value="">Selecciona una entrega...</option>
                                                    @foreach (var origen in Model.OrigenesAumento)
                                                    {
                                                        <option value="@origen.ReleaseDetalleID"
                                                                data-disponible="@origen.CantidadTransferible"
                                                                data-requerido="@origen.CantidadRequerida"
                                                                data-numero-parte="@origen.NumeroParte"
                                                                data-secuencia="@(origen.SecuenciaEntrega?.ToString() ?? "")">
                                                            Entrega @(origen.SecuenciaEntrega?.ToString() ?? "-") · @origen.FechaRequerida.ToString("dd/MM/yyyy") · libre @origen.CantidadTransferible.ToString("N0") pzas
                                                        </option>
                                                    }
                                                </select>
                                                <div class="aumento-cajas-info is-muted js-aumento-info">
                                                    Selecciona una entrega. El ERP sugerira solo las piezas que falten para cerrar la caja.
                                                </div>
                                                <span asp-validation-for="AumentosRelease[i].ReleaseDetalleOrigenAumentoID"
                                                      class="text-danger small"></span>
                                            </div>

                                            <div class="aumento-cajas-cantidad-wrap">
                                                <label class="field-label">
                                                    Piezas extra
                                                </label>
                                                <input asp-for="AumentosRelease[i].CantidadPiezas"
                                                       type="number"
                                                       inputmode="numeric"
                                                       class="form-control js-aumento-cantidad"
                                                       autocomplete="off" />
                                                <span asp-validation-for="AumentosRelease[i].CantidadPiezas"
                                                      class="text-danger small"></span>
                                            </div>

                                            <div class="aumento-cajas-acciones">
                                                <button type="button"
                                                        class="btn-aumento-quitar js-quitar-aumento"
                                                        title="Quitar esta fila"
                                                        aria-label="Quitar esta fila">
                                                    <i class="fa-solid fa-trash"></i>
                                                </button>
                                            </div>
                                        </div>
                                    }
                                </div>

                                <div class="aumento-cajas-footer">
                                    <button type="button"
                                            id="btnAgregarAumentoRelease"
                                            class="btn-aumento-agregar"
                                            @(Model.OrigenesAumento.Any() ? null : "disabled")>
                                        <i class="fa-solid fa-plus"></i>
                                        Agregar otra fila
                                    </button>

                                    <div class="aumento-cajas-regla">
                                        <i class="fa-solid fa-circle-info"></i>
                                        Cada entrega solo puede usarse una vez. Las piezas extra pueden ser parciales; al usar aumento, Base + extras debe cerrar exactamente cajas/embalajes completos.
                                    </div>
                                </div>

                                <template id="aumentoReleaseTemplate">
                                    <div class="aumento-cajas-fila js-aumento-fila">
                                        <div class="aumento-cajas-origen">
                                            <label class="field-label">
                                                Descontar de entrega / fila del mismo renglon
                                            </label>
                                            <select class="form-select js-aumento-origen"
                                                    name="AumentosRelease[__INDEX__].ReleaseDetalleOrigenAumentoID">
                                                <option value="">Selecciona una entrega...</option>
                                                @foreach (var origen in Model.OrigenesAumento)
                                                {
                                                    <option value="@origen.ReleaseDetalleID"
                                                            data-disponible="@origen.CantidadTransferible"
                                                            data-requerido="@origen.CantidadRequerida"
                                                            data-numero-parte="@origen.NumeroParte"
                                                            data-secuencia="@(origen.SecuenciaEntrega?.ToString() ?? "")">
                                                        Entrega @(origen.SecuenciaEntrega?.ToString() ?? "-") · @origen.NumeroParte · @origen.FechaRequerida.ToString("dd/MM/yyyy") · requerido @origen.CantidadRequerida.ToString("N0") · libre @origen.CantidadTransferible.ToString("N0") pzas
                                                    </option>
                                                }
                                            </select>
                                            <div class="aumento-cajas-info is-muted js-aumento-info">
                                                Selecciona una entrega. El ERP sugerira solo las piezas que falten para cerrar la caja.
                                            </div>
                                        </div>

                                        <div class="aumento-cajas-cantidad-wrap">
                                            <label class="field-label">Piezas extra</label>
                                            <input type="number"
                                                   inputmode="numeric"
                                                   class="form-control js-aumento-cantidad"
                                                   name="AumentosRelease[__INDEX__].CantidadPiezas"
                                                   value="0"
                                                   autocomplete="off" />
                                        </div>

                                        <div class="aumento-cajas-acciones">
                                            <button type="button"
                                                    class="btn-aumento-quitar js-quitar-aumento"
                                                    title="Quitar esta fila"
                                                    aria-label="Quitar esta fila">
                                                <i class="fa-solid fa-trash"></i>
                                            </button>
                                        </div>
                                    </div>
                                </template>
                                <div id="aumentoReleasePreview"
                                     class="aumento-cajas-resumen is-muted">
                                    Sin aumento. Se programará únicamente la necesidad base.
                                </div>

                                <div class="aumento-cajas-nota">
                                    MP y embalajes se recalcularan con la cantidad final.
                                    @if ((Model.PiezasPorEmbalaje ?? 0) > 0)
                                    {
                                        <text>
                                            Embalaje configurado: @Model.PiezasPorEmbalaje!.Value.ToString("N0") pzas por unidad.
                                        </text>
                                    }
                                </div>

                                @if (Model.ParejaLhRhDisponible)
                                {
                                    <div class="alert alert-info py-2 px-3 mt-3 mb-0 small">
                                        <strong>LH/RH:</strong>
                                        si mantienes la programación conjunta, el mismo aumento de piezas se aplicará también a
                                        <strong>@Model.ParejaLhRhNumeroParte</strong>.
                                        El ERP buscará automáticamente la entrega equivalente de su propio renglón y recalculará
                                        su MP y sus embalajes.
                                    </div>
                                }
                            </div>
                        </div>
                    </div>

                    <div class="formula-box mb-3">
                        <div class="fw-bold">
                            <i class="fa-solid fa-square-root-variable me-1"></i>
                            Fórmula horas programadas
                        </div>
                        <div class="small">
                            Cantidad programada ÷ Objetivo por hora, redondeado hacia arriba =
                            <strong id="formulaHoras">@Decimal2(Model.HorasProgramadas)</strong> hrs
                        </div>
                    </div>

                    <div class="row g-3">
                        <div class="col-12">
                            <label class="field-label">Inicio programado</label>
                            <input asp-for="FechaInicioProgramada"
                                   type="datetime-local"
                                   value="@DateTimeLocal(Model.FechaInicioProgramada)"
                                   class="form-control"
                                   id="FechaInicioProgramada"
                                   step="3600" />
                            <span asp-validation-for="FechaInicioProgramada" class="text-danger small"></span>
                            <div id="avisoHorarioPasado"
                                 class="horario-pasado-aviso"
                                 hidden>
                                <i class="fa-solid fa-triangle-exclamation"></i>
                                <span>
                                    Estas programando en un horario anterior a la fecha y hora actual. Se permite continuar, pero solo se guardara si la maquina y el molde estan disponibles.
                                </span>
                            </div>
                        </div>

                        <div class="col-md-6">
                            <label class="field-label">Hora cambio</label>
                            <input asp-for="Cambio"
                                   type="time"
                                   value="@TimeValue(Model.Cambio)"
                                   class="form-control"
                                   id="Cambio"
                                   step="3600" />
                            <span asp-validation-for="Cambio" class="text-danger small"></span>
                        </div>

                        <div class="col-md-6">
                            <label class="field-label">Hora arranque</label>
                            <input asp-for="Arranque"
                                   type="time"
                                   value="@TimeValue(Model.Arranque)"
                                   class="form-control"
                                   id="Arranque"
                                   step="3600" />
                            <span asp-validation-for="Arranque" class="text-danger small"></span>
                        </div>

                        <div class="col-md-6">
                            <label class="field-label">Horas programadas (hrs redondeadas)</label>
                            <input asp-for="HorasProgramadas"
                                   type="number"
                                   step="0.01"
                                   min="0.01"
                                   class="form-control"
                                   id="HorasProgramadas" />
                            <span asp-validation-for="HorasProgramadas" class="text-danger small"></span>
                        </div>

                        <div class="col-md-6">
                            <label class="field-label">Fin estimado</label>
                            <input asp-for="FechaFinProgramada"
                                   type="datetime-local"
                                   value="@DateTimeLocal(Model.FechaFinProgramada)"
                                   class="form-control"
                                   id="FechaFinProgramada"
                                   readonly />
                        </div>

                        <div class="col-12">
                            <label class="domingo-operativo-card" for="TrabajarDomingo">
                                <input class="form-check-input domingo-operativo-check"
                                       type="checkbox"
                                       value="true"
                                       id="TrabajarDomingo"
                                       name="TrabajarDomingo" />
                                <span class="domingo-operativo-copy">
                                    <strong>Considerar domingo como dia operativo</strong>
                                    <small>
                                        Si no se marca, el calculo corta el sabado a las 22:30 y continua el lunes a las 07:00.
                                    </small>
                                </span>
                            </label>
                        </div>

                        <div class="col-12">
                            <label class="field-label">Observaciones</label>
                            <textarea asp-for="Observaciones"
                                      rows="4"
                                      class="form-control"
                                      placeholder="Comentarios de planeación, prioridad, restricciones, paro, cambio de molde, etc."></textarea>
                        </div>
                    </div>
                </div>
            </aside>
        </div>

        <section class="sticky-actions">
            <div class="d-flex justify-content-between gap-2 flex-wrap">
                <a asp-controller="PlaneacionPrograma"
                   asp-action="Index"
                   class="btn-light-main">
                    <i class="fa-solid fa-arrow-left"></i>
                    Cancelar
                </a>

                <button type="submit" class="btn-main" id="btnGuardar">
                    <i class="fa-solid fa-floppy-disk"></i>
                    <span class="btn-label">Guardar Programa Cambio de Molde</span>
                </button>
            </div>
        </section>
    </form>
</div>
