@model ERP.NSQuell.Models.PlaneacionProgramaCrearDesdeNecesidadVm

@{
    Layout = null;

    string Valor(string? v) => string.IsNullOrWhiteSpace(v) ? "-" : v;
    string Decimal4(decimal? v) => v.HasValue ? v.Value.ToString("N4") : "-";
    string Decimal2(decimal? v) => v.HasValue ? v.Value.ToString("N2") : "-";
    string Entero(int? v) => v.HasValue ? v.Value.ToString("N0") : "-";
}

<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <title>Programa Cambio de Molde | Planeación</title>
    <meta name="viewport" content="width=device-width, initial-scale=1" />

    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.2/css/all.min.css" rel="stylesheet">

    <style>
        :root {
            --erp-blue: #004AAD;
            --erp-blue-dark: #00347a;
            --erp-gray: #f3f5f8;
            --erp-border: #d9e1ec;
            --erp-text: #263238;
            --erp-muted: #667085;
            --erp-green: #107c41;
            --erp-red: #b42318;
            --erp-orange: #b54708;
        }

        body {
            background: var(--erp-gray);
            color: var(--erp-text);
            font-family: "Segoe UI", Arial, sans-serif;
        }

        .erp-shell {
            max-width: 1500px;
            margin: 0 auto;
            padding: 28px;
        }

        .erp-header {
            background: linear-gradient(135deg, var(--erp-blue), var(--erp-blue-dark));
            color: white;
            border-radius: 22px;
            padding: 28px 32px;
            box-shadow: 0 16px 36px rgba(0, 74, 173, .23);
            margin-bottom: 22px;
        }

            .erp-header h1 {
                font-size: 1.65rem;
                margin: 0;
                font-weight: 900;
            }

            .erp-header p {
                margin: 7px 0 0;
                opacity: .92;
            }

        .stage-label {
            display: inline-flex;
            align-items: center;
            gap: 7px;
            padding: 6px 11px;
            margin-bottom: 12px;
            border: 1px solid rgba(255, 255, 255, .35);
            border-radius: 999px;
            background: rgba(255, 255, 255, .12);
            font-size: .75rem;
            font-weight: 900;
            letter-spacing: .05em;
            text-transform: uppercase;
        }

        .erp-card {
            background: white;
            border: 1px solid var(--erp-border);
            border-radius: 20px;
            box-shadow: 0 10px 24px rgba(30, 55, 90, .08);
            margin-bottom: 20px;
            overflow: hidden;
        }

        .erp-card-header {
            padding: 18px 22px;
            border-bottom: 1px solid var(--erp-border);
            display: flex;
            justify-content: space-between;
            align-items: center;
            gap: 14px;
            flex-wrap: wrap;
        }

        .erp-card-body {
            padding: 22px;
        }

        .erp-label {
            font-weight: 800;
            color: #33465f;
            font-size: .78rem;
            text-transform: uppercase;
            letter-spacing: .035em;
            margin-bottom: 5px;
        }

        .erp-value {
            font-weight: 650;
            min-height: 24px;
        }

        .erp-input,
        .erp-select,
        .erp-textarea {
            border-radius: 12px;
            border: 1px solid var(--erp-border);
            padding: 10px 12px;
        }

        .btn-erp-primary {
            background: var(--erp-blue);
            border-color: var(--erp-blue);
            color: white;
            font-weight: 800;
            border-radius: 13px;
            padding: 10px 15px;
        }

            .btn-erp-primary:hover,
            .btn-erp-primary:focus {
                background: var(--erp-blue-dark);
                border-color: var(--erp-blue-dark);
                color: white;
            }

        .btn-erp-light {
            background: white;
            border: 1px solid var(--erp-border);
            color: var(--erp-blue-dark);
            font-weight: 800;
            border-radius: 13px;
            padding: 10px 15px;
        }

            .btn-erp-light:hover {
                background: #eef3fb;
                color: var(--erp-blue-dark);
            }

        .metric-card {
            border: 1px solid var(--erp-border);
            border-radius: 16px;
            padding: 16px;
            background: #fbfdff;
            height: 100%;
        }

        .metric-label {
            color: var(--erp-muted);
            font-size: .74rem;
            font-weight: 800;
            text-transform: uppercase;
            letter-spacing: .04em;
        }

        .metric-value {
            font-size: 1.2rem;
            font-weight: 900;
            color: var(--erp-blue-dark);
        }

        .suggestion-box {
            border: 1px solid #b2ddff;
            border-radius: 16px;
            background: #eff8ff;
            padding: 15px;
            height: 100%;
        }

        .suggestion-title {
            color: #1849a9;
            font-weight: 900;
            font-size: .8rem;
            text-transform: uppercase;
            letter-spacing: .04em;
            margin-bottom: 6px;
        }

        .flow-note {
            display: flex;
            align-items: flex-start;
            gap: 12px;
            padding: 15px 17px;
            margin-bottom: 20px;
            border: 1px solid #fed7aa;
            border-radius: 16px;
            background: #fff7ed;
            color: #9a3412;
        }

        .sticky-actions {
            position: sticky;
            bottom: 0;
            background: rgba(243, 245, 248, .92);
            backdrop-filter: blur(10px);
            padding: 14px 0;
            z-index: 20;
        }

        @@media (max-width: 767.98px) {
            .erp-shell {
                padding: 16px;
            }

            .erp-header {
                padding: 22px;
                border-radius: 18px;
            }
        }
    </style>
</head>

<body>
    <div class="erp-shell">

        <div class="erp-header">
            <div class="d-flex justify-content-between align-items-start gap-3 flex-wrap">
                <div>
                    <div class="stage-label">
                        <i class="fa-solid fa-arrows-rotate"></i>
                        Etapa 3 · Cambio de Molde
                    </div>

                    <h1>
                        <i class="fa-solid fa-gears me-2"></i>
                        Programa Cambio de Molde
                    </h1>

                    <p>
                        Revisa la necesidad calculada, confirma máquina/molde y define hora de cambio, arranque y producción.
                    </p>
                </div>

                <div>
                    <a asp-controller="PlaneacionRelease"
                       asp-action="Calculadora"
                       class="btn btn-light fw-bold rounded-3">
                        <i class="fa-solid fa-arrow-left me-1"></i>
                        Volver a Programa de Planeación
                    </a>
                </div>
            </div>
        </div>

        <div class="flow-note">
            <i class="fa-solid fa-circle-info mt-1"></i>
            <div>
                <div class="fw-bold">Esta pantalla define dónde y cuándo se producirá.</div>
                <div class="small">
                    La demanda ya fue calculada en Programa de Planeación. Aquí se confirma la máquina, molde, cambio y arranque antes de generar la OF.
                </div>
            </div>
        </div>

        <form asp-controller="PlaneacionPrograma" asp-action="Crear" method="post" id="formPrograma">
            @Html.AntiForgeryToken()

            <div asp-validation-summary="ModelOnly" class="alert alert-danger rounded-4 fw-semibold"></div>

            <input type="hidden" asp-for="ReleaseDetalleID" />
            <input type="hidden" asp-for="ReleaseID" />
            <input type="hidden" asp-for="FolioRelease" />

            <input type="hidden" asp-for="ClienteID" />
            <input type="hidden" asp-for="ClienteNombre" />

            <input type="hidden" asp-for="ParteID" />
            <input type="hidden" asp-for="NumeroParte" />
            <input type="hidden" asp-for="ReferenciaSAP" />
            <input type="hidden" asp-for="DesignacionDescripcionSAP" />

            <input type="hidden" asp-for="CantidadRequerida" />
            <input type="hidden" asp-for="PiezasDesdePT" />
            <input type="hidden" asp-for="PiezasAProducir" />

            <input type="hidden" asp-for="MaquinaCodigo" />
            <input type="hidden" asp-for="MaquinaNombre" />
            <input type="hidden" asp-for="MoldeCodigo" />

            <input type="hidden" asp-for="ObjetivoHora" />
            <input type="hidden" asp-for="Ciclo" />
            <input type="hidden" asp-for="Cavidades" />
            <input type="hidden" asp-for="PesoBrutoPieza" />

            <input type="hidden" asp-for="MaterialID" />
            <input type="hidden" asp-for="MaterialCodigo" />
            <input type="hidden" asp-for="MaterialDescripcion" />
            <input type="hidden" asp-for="CantidadMpKg" />

            <input type="hidden" asp-for="EmbalajeCodigo" />
            <input type="hidden" asp-for="EmbalajeDescripcion" />
            <input type="hidden" asp-for="PiezasPorEmbalaje" />
            <input type="hidden" asp-for="CantidadEmbalajes" />

            <div class="erp-card">
                <div class="erp-card-header">
                    <div>
                        <h2 class="h5 fw-bold m-0 text-primary">
                            <i class="fa-solid fa-file-lines me-2"></i>
                            Necesidad origen
                        </h2>
                        <div class="text-muted small">
                            Datos calculados desde Release / Programa de Planeación.
                        </div>
                    </div>
                </div>

                <div class="erp-card-body">
                    <div class="row g-3">
                        <div class="col-md-3">
                            <div class="erp-label">Release</div>
                            <div class="erp-value">@Valor(Model.FolioRelease)</div>
                        </div>

                        <div class="col-md-3">
                            <div class="erp-label">Cliente</div>
                            <div class="erp-value">@Valor(Model.ClienteNombre)</div>
                        </div>

                        <div class="col-md-3">
                            <div class="erp-label">Referencia SAP / Cliente</div>
                            <div class="erp-value">@Valor(Model.ReferenciaSAP ?? Model.NumeroParte)</div>
                        </div>

                        <div class="col-md-3">
                            <div class="erp-label">Color</div>
                            <input asp-for="Color"
                                   class="form-control erp-input"
                                   maxlength="100"
                                   placeholder="Ej. Natural, Negro, Azul, Rojo..." />
                        </div>

                        <div class="col-md-12">
                            <div class="erp-label">Designación / descripción</div>
                            <div class="erp-value">@Valor(Model.DesignacionDescripcionSAP)</div>
                        </div>
                    </div>

                    <div class="row g-3 mt-2">
                        <div class="col-md-2">
                            <div class="metric-card">
                                <div class="metric-label">Requeridas</div>
                                <div class="metric-value">@Model.CantidadRequerida.ToString("N0")</div>
                            </div>
                        </div>

                        <div class="col-md-2">
                            <div class="metric-card">
                                <div class="metric-label">Desde PT</div>
                                <div class="metric-value">@Model.PiezasDesdePT.ToString("N0")</div>
                            </div>
                        </div>

                        <div class="col-md-2">
                            <div class="metric-card">
                                <div class="metric-label">A producir</div>
                                <div class="metric-value">@Model.PiezasAProducir.ToString("N0")</div>
                            </div>
                        </div>

                        <div class="col-md-2">
                            <div class="metric-card">
                                <div class="metric-label">MP kg</div>
                                <div class="metric-value">@Decimal4(Model.CantidadMpKg)</div>
                            </div>
                        </div>

                        <div class="col-md-2">
                            <div class="metric-card">
                                <div class="metric-label">Embalajes</div>
                                <div class="metric-value">@Decimal4(Model.CantidadEmbalajes)</div>
                            </div>
                        </div>

                        <div class="col-md-2">
                            <div class="metric-card">
                                <div class="metric-label">Horas calc.</div>
                                <div class="metric-value">@Decimal2(Model.HorasProgramadas)</div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <div class="erp-card">
                <div class="erp-card-header">
                    <div>
                        <h2 class="h5 fw-bold m-0 text-primary">
                            <i class="fa-solid fa-lightbulb me-2"></i>
                            Sugerencia inicial
                        </h2>
                        <div class="text-muted small">
                            Datos sugeridos desde el catálogo técnico de la parte. Puedes cambiarlos antes de guardar.
                        </div>
                    </div>
                </div>

                <div class="erp-card-body">
                    <div class="row g-3">
                        <div class="col-md-6">
                            <div class="suggestion-box">
                                <div class="suggestion-title">
                                    <i class="fa-solid fa-industry me-1"></i>
                                    Máquina sugerida
                                </div>
                                <div class="erp-value">
                                    @Valor(Model.MaquinaCodigo)
                                    @if (!string.IsNullOrWhiteSpace(Model.MaquinaNombre))
                                    {
                                        <span class="text-muted"> · @Model.MaquinaNombre</span>
                                    }
                                </div>
                            </div>
                        </div>

                        <div class="col-md-6">
                            <div class="suggestion-box">
                                <div class="suggestion-title">
                                    <i class="fa-solid fa-cube me-1"></i>
                                    Molde sugerido
                                </div>
                                <div class="erp-value">@Valor(Model.MoldeCodigo)</div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <div class="erp-card">
                <div class="erp-card-header">
                    <div>
                        <h2 class="h5 fw-bold m-0 text-primary">
                            <i class="fa-solid fa-gears me-2"></i>
                            Decisión de cambio de molde
                        </h2>
                        <div class="text-muted small">
                            Selecciona la máquina final, molde final, hora de cambio y hora de arranque.
                        </div>
                    </div>
                </div>

                <div class="erp-card-body">
                    <div class="row g-3">
                        <div class="col-md-3">
                            <label class="erp-label">Cantidad a producir</label>
                            <input asp-for="CantidadProgramada"
                                   type="number"
                                   min="1"
                                   max="@Model.PiezasAProducir"
                                   class="form-control erp-input" />
                            <div class="text-muted small mt-1">
                                Máximo sugerido: @Model.PiezasAProducir.ToString("N0")
                            </div>
                        </div>

                        <div class="col-md-3">
                            <label class="erp-label">Máquina final</label>
                            <select asp-for="MaquinaID" class="form-select erp-select">
                                <option value="">-- Selecciona máquina --</option>
                                @foreach (var maq in Model.Maquinas)
                                {
                                    <option value="@maq.Value" selected="@(Model.MaquinaID?.ToString() == maq.Value)">
                                        @maq.Text
                                    </option>
                                }
                            </select>
                            <span asp-validation-for="MaquinaID" class="text-danger small"></span>
                        </div>

                        <div class="col-md-3">
                            <label class="erp-label">Molde final</label>
                            <select asp-for="MoldeID" class="form-select erp-select">
                                <option value="">-- Selecciona molde --</option>
                                @foreach (var mol in Model.Moldes)
                                {
                                    <option value="@mol.Value" selected="@(Model.MoldeID?.ToString() == mol.Value)">
                                        @mol.Text
                                    </option>
                                }
                            </select>
                            <span asp-validation-for="MoldeID" class="text-danger small"></span>
                        </div>

                        <div class="col-md-3">
                            <label class="erp-label">Condición producción</label>
                            <select asp-for="CondicionProduccion" class="form-select erp-select">
                                @foreach (var c in Model.Condiciones)
                                {
                                    <option value="@c.Value" selected="@(Model.CondicionProduccion == c.Value)">
                                        @c.Text
                                    </option>
                                }
                            </select>
                        </div>

                        <div class="col-md-3">
                            <label class="erp-label">Inicio programado</label>
                            <input asp-for="FechaInicioProgramada"
                                   type="datetime-local"
                                   value="@(Model.FechaInicioProgramada?.ToString("yyyy-MM-ddTHH:mm"))"
                                   class="form-control erp-input"
                                   id="FechaInicioProgramada" />
                            <span asp-validation-for="FechaInicioProgramada" class="text-danger small"></span>
                        </div>

                        <div class="col-md-3">
                            <label class="erp-label">Hora cambio de molde</label>
                            <input type="time"
                                   name="Cambio"
                                   value="@(Model.Cambio?.ToString(@"hh\:mm"))"
                                   class="form-control erp-input"
                                   id="Cambio" />
                            <span asp-validation-for="Cambio" class="text-danger small"></span>
                        </div>

                        <div class="col-md-3">
                            <label class="erp-label">Hora arranque</label>
                            <input type="time"
                                   name="Arranque"
                                   value="@(Model.Arranque?.ToString(@"hh\:mm"))"
                                   class="form-control erp-input"
                                   id="Arranque" />
                            <span asp-validation-for="Arranque" class="text-danger small"></span>
                        </div>

                        <div class="col-md-3">
                            <label class="erp-label">Horas programadas</label>
                            <input asp-for="HorasProgramadas"
                                   type="number"
                                   step="0.01"
                                   min="0.01"
                                   class="form-control erp-input"
                                   id="HorasProgramadas" />
                            <span asp-validation-for="HorasProgramadas" class="text-danger small"></span>
                        </div>

                        <div class="col-md-4">
                            <label class="erp-label">Fin programado estimado</label>
                            <input asp-for="FechaFinProgramada"
                                   type="datetime-local"
                                   value="@(Model.FechaFinProgramada?.ToString("yyyy-MM-ddTHH:mm"))"
                                   class="form-control erp-input"
                                   id="FechaFinProgramada"
                                   readonly />
                        </div>

                        <div class="col-md-8">
                            <label class="erp-label">Observaciones</label>
                            <textarea asp-for="Observaciones"
                                      rows="3"
                                      class="form-control erp-textarea"
                                      placeholder="Comentarios de planeación, prioridad, restricciones, cambio de molde, etc."></textarea>
                        </div>
                    </div>
                </div>
            </div>

            <div class="sticky-actions">
                <div class="d-flex justify-content-between gap-2 flex-wrap">
                    <a asp-controller="PlaneacionRelease"
                       asp-action="Calculadora"
                       class="btn btn-erp-light">
                        <i class="fa-solid fa-arrow-left me-1"></i>
                        Cancelar
                    </a>

                    <button type="submit" class="btn btn-erp-primary" id="btnGuardar">
                        <i class="fa-solid fa-floppy-disk me-1"></i>
                        <span class="btn-label">Guardar cambio de molde</span>
                    </button>
                </div>
            </div>
        </form>

    </div>

    <script>
        const inicioInput = document.getElementById('FechaInicioProgramada');
        const horasInput = document.getElementById('HorasProgramadas');
        const finInput = document.getElementById('FechaFinProgramada');
        const cambioInput = document.getElementById('Cambio');
        const arranqueInput = document.getElementById('Arranque');
        const formPrograma = document.getElementById('formPrograma');
        const btnGuardar = document.getElementById('btnGuardar');

        function formatearFechaLocal(fecha) {
            const yyyy = fecha.getFullYear();
            const mm = String(fecha.getMonth() + 1).padStart(2, '0');
            const dd = String(fecha.getDate()).padStart(2, '0');
            const hh = String(fecha.getHours()).padStart(2, '0');
            const mi = String(fecha.getMinutes()).padStart(2, '0');

            return `${yyyy}-${mm}-${dd}T${hh}:${mi}`;
        }

        function obtenerHoraDesdeFechaLocal(value) {
            if (!value || value.length < 16) return '';
            return value.substring(11, 16);
        }

        function recalcularFin() {
            if (!inicioInput || !horasInput || !finInput) return;

            const inicioValue = inicioInput.value;
            const horas = Number(horasInput.value || 0);

            if (!inicioValue || horas <= 0) {
                finInput.value = '';
                return;
            }

            const inicio = new Date(inicioValue);
            inicio.setMinutes(inicio.getMinutes() + Math.round(horas * 60));
            finInput.value = formatearFechaLocal(inicio);
        }

        function sincronizarHorasCambioArranque() {
            if (!inicioInput) return;

            const hora = obtenerHoraDesdeFechaLocal(inicioInput.value);

            if (!hora) return;

            if (cambioInput && !cambioInput.value) {
                cambioInput.value = hora;
            }

            if (arranqueInput && !arranqueInput.value) {
                arranqueInput.value = hora;
            }
        }

        inicioInput?.addEventListener('change', function () {
            sincronizarHorasCambioArranque();
            recalcularFin();
        });

        horasInput?.addEventListener('input', recalcularFin);

        formPrograma?.addEventListener('submit', function () {
            if (!btnGuardar) return;

            btnGuardar.disabled = true;
            btnGuardar.querySelector('i').className = 'fa-solid fa-spinner fa-spin me-1';
            btnGuardar.querySelector('.btn-label').textContent = 'Guardando cambio...';
        });

        document.addEventListener('DOMContentLoaded', function () {
            sincronizarHorasCambioArranque();
            recalcularFin();
        });
    </script>
</body>
</html>
