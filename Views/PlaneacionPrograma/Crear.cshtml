@model ERP.NSQuell.Models.PlaneacionProgramaCrearDesdeNecesidadVm
@using Microsoft.AspNetCore.Mvc.Rendering

@{
    Layout = "~/Views/Shared/_Layout.cshtml";
    ViewData["Title"] = "Programar Molde | ERP QUELL";
    var cantidadBase = Model.CantidadOriginalAProducir > 0 ? Model.CantidadOriginalAProducir : Model.PiezasAProducir;
    // NSQ_PLANEACION_AUMENTO_EXTENSION_V4
    var cantidadBaseCapturada = Model.CantidadBasePrograma > 0 ? Model.CantidadBasePrograma : cantidadBase;
    var aumentoCapturado = Model.AumentosRelease == null
        ? 0
        : Model.AumentosRelease.Where(x => x != null && x.CantidadPiezas > 0).Sum(x => x.CantidadPiezas);
    var totalVisualInicial = cantidadBaseCapturada + aumentoCapturado;
}

@section Scripts {
    <script>
        const objetivoHora = Number('@(Model.ObjetivoHora ?? 0)');
        const cantidadInput = document.getElementById('CantidadBasePrograma');
        const cantidadBaseServidorInput = document.getElementById('CantidadBaseProgramaServidor');

        // NSQ_PLANEACION_AUMENTO_POR_CAJAS_V1
        const cantidadBaseRelease = Number('@Model.PiezasAProducir');
        const piezasPorCajaRelease = Number('@((Model.PiezasPorEmbalaje ?? 0) > 0 ? Convert.ToInt32(Model.PiezasPorEmbalaje!.Value) : (Model.PiezasPorCaja ?? 0) > 0 ? Model.PiezasPorCaja!.Value : 0)');
        const aumentosReleaseFilas = document.getElementById('aumentosReleaseFilas');
        const aumentoReleaseTemplate = document.getElementById('aumentoReleaseTemplate');
        const btnAgregarAumentoRelease = document.getElementById('btnAgregarAumentoRelease');
        const aumentoPreview = document.getElementById('aumentoReleasePreview');

        const inicioInput = document.getElementById('FechaInicioProgramada');
        const horasInput = document.getElementById('HorasProgramadas');
        const finInput = document.getElementById('FechaFinProgramada');
        const cambioInput = document.getElementById('Cambio');
        const arranqueInput = document.getElementById('Arranque');
        const formulaHoras = document.getElementById('formulaHoras');
        const formPrograma = document.getElementById('formPrograma');
        const btnGuardar = document.getElementById('btnGuardar');
        const condicionInput = document.getElementById('CondicionProduccion');
        const trabajarDomingoInput = document.getElementById('TrabajarDomingo');


        function toDecimal(value) {
            const n = Number(value || 0);
            return isNaN(n) ? 0 : n;
        }

        function formatearFechaLocal(fecha) {
            const yyyy = fecha.getFullYear();
            const mm = String(fecha.getMonth() + 1).padStart(2, '0');
            const dd = String(fecha.getDate()).padStart(2, '0');
            const hh = String(fecha.getHours()).padStart(2, '0');
            const mi = String(fecha.getMinutes()).padStart(2, '0');

            return `${yyyy}-${mm}-${dd}T${hh}:${mi}`;
        }

        function esInterrupcionProduccion() {
            const valor = (condicionInput?.value || '').toLowerCase();

            return valor.includes('interrumpir') ||
                   valor.includes('i.p') ||
                   valor.includes('ip');
        }

        function redondearSiguienteHora(fecha) {
            const f = new Date(fecha);

            const tieneMinutos =
                f.getMinutes() !== 0 ||
                f.getSeconds() !== 0 ||
                f.getMilliseconds() !== 0;

            f.setMinutes(0);
            f.setSeconds(0);
            f.setMilliseconds(0);

            if (tieneMinutos) {
                f.setHours(f.getHours() + 1);
            }

            return f;
        }

        function minimoFechaHoraPermitido() {
            return formatearFechaLocal(redondearSiguienteHora(new Date()));
        }

        function horaCompletaTexto(fecha) {
            return String(fecha.getHours()).padStart(2, '0') + ':00';
        }

        function normalizarTimeHoraCompleta(input) {
            if (!input || !input.value || input.value.length < 5) return;

            const partes = input.value.split(':');
            const hh = Number(partes[0] || 0);

            input.value = String(hh).padStart(2, '0') + ':00';
        }

        function sumarUnaHoraCompleta(horaValue) {
            if (!horaValue || horaValue.length < 5) return '';

            const partes = horaValue.split(':');
            const hh = Number(partes[0] || 0);

            const fecha = new Date();
            fecha.setHours(hh);
            fecha.setMinutes(0);
            fecha.setSeconds(0);
            fecha.setMilliseconds(0);
            fecha.setHours(fecha.getHours() + 1);

            return String(fecha.getHours()).padStart(2, '0') + ':00';
        }

        function construirFechaArranque() {
            if (!inicioInput || !inicioInput.value) return null;

            const inicio = new Date(inicioInput.value);

            if (!arranqueInput || !arranqueInput.value || arranqueInput.value.length < 5) {
                return inicio;
            }

            const partes = arranqueInput.value.split(':');
            const hh = Number(partes[0] || 0);
            const mm = Number(partes[1] || 0);

            const fechaArranque = new Date(inicio);
            fechaArranque.setHours(hh);
            fechaArranque.setMinutes(mm);
            fechaArranque.setSeconds(0);
            fechaArranque.setMilliseconds(0);

            if (fechaArranque < inicio) {
                fechaArranque.setDate(fechaArranque.getDate() + 1);
            }

            return fechaArranque;
        }

        // NSQ_PLANEACION_AUMENTO_MULTIFILA_ES_V1_4
        function filasAumentoRelease() {
            return Array.from(
                aumentosReleaseFilas?.querySelectorAll('.js-aumento-fila') || []
            );
        }

        function reindexarAumentosRelease() {
            filasAumentoRelease().forEach((fila, index) => {
                const select = fila.querySelector('.js-aumento-origen');
                const input = fila.querySelector('.js-aumento-cantidad');

                if (select) {
                    select.name = `AumentosRelease[${index}].ReleaseDetalleOrigenAumentoID`;
                }

                if (input) {
                    input.name = `AumentosRelease[${index}].CantidadPiezas`;
                }
            });
        }

                // NSQ_PLANEACION_CANTIDAD_PARCIAL_CIERRE_CAJAS_V1_6
        function cantidadBaseActual() {
            return Math.max(0, Math.trunc(Number(
                cantidadBaseServidorInput?.value ?? cantidadInput?.value ?? 0
            )));
        }

        function sincronizarCantidadTotalVisible(totalForzado = null) {
            if (!cantidadInput) return;
            const total = totalForzado == null
                ? cantidadBaseActual() + totalExtrasActual()
                : Math.max(0, Math.trunc(Number(totalForzado || 0)));
            cantidadInput.value = String(total);
        }

        function actualizarBaseDesdeTotalVisible() {
            if (!cantidadInput || !cantidadBaseServidorInput) return;
            const totalVisual = Math.max(0, Math.trunc(Number(cantidadInput.value || 0)));
            const extras = totalExtrasActual();
            cantidadBaseServidorInput.value = String(Math.max(0, totalVisual - extras));
        }

        function totalExtrasActual(excluirFila = null) {
            let total = 0;

            filasAumentoRelease().forEach(fila => {
                if (fila === excluirFila) return;
                const input = fila.querySelector('.js-aumento-cantidad');
                total += Math.max(0, Math.trunc(Number(input?.value || 0)));
            });

            return total;
        }

        function cantidadTotalPrograma() {
            return cantidadBaseActual() + totalExtrasActual();
        }

        function faltanteParaCerrarCaja(total) {
            if (piezasPorCajaRelease <= 0) return 0;
            const residuo = Math.max(0, Math.trunc(total)) % piezasPorCajaRelease;
            return residuo === 0 ? 0 : piezasPorCajaRelease - residuo;
        }

        function textoNumero(value) {
            return Math.max(0, Math.trunc(Number(value || 0))).toLocaleString('es-MX');
        }

        function actualizarInfoFilaAumento(fila) {
            const select = fila.querySelector('.js-aumento-origen');
            const info = fila.querySelector('.js-aumento-info');
            const opcion = select?.selectedOptions?.[0];

            if (!info) return;

            if (!select?.value || !opcion) {
                info.textContent =
                    'Selecciona una entrega. El ERP sugerira solo las piezas que falten para cerrar la caja.';
                info.classList.remove('text-danger', 'text-success', 'text-muted', 'is-ok', 'is-error', 'is-muted');
                info.classList.add('is-muted');
                return;
            }

            const requerido = Number(opcion.dataset.requerido || 0);
            const disponible = Number(opcion.dataset.disponible || 0);
            const numeroParte = opcion.dataset.numeroParte || 'Sin numero de parte';

            info.textContent =
                `Parte ${numeroParte} · requerido ${textoNumero(requerido)} pzas · ` +
                `libre ${textoNumero(disponible)} pzas.`;

            info.classList.remove('text-danger', 'text-success', 'text-muted', 'is-ok', 'is-error', 'is-muted');
            info.classList.add(disponible > 0 ? 'is-ok' : 'is-error');
        }

        function validarFilaAumento(fila, seleccionados) {
            const select = fila.querySelector('.js-aumento-origen');
            const input = fila.querySelector('.js-aumento-cantidad');
            const opcion = select?.selectedOptions?.[0];
            const origenId = select?.value || '';
            const cantidad = Math.trunc(Number(input?.value || 0));
            const disponible = Number(opcion?.dataset?.disponible || 0);

            select?.setCustomValidity('');
            input?.setCustomValidity('');

            if (!origenId && cantidad <= 0) {
                return { valido: true, cantidad: 0 };
            }

            if (!origenId) {
                select?.setCustomValidity(
                    'Selecciona la entrega del Release de la cual se descontaran las piezas.'
                );
                return { valido: false, cantidad: Math.max(0, cantidad) };
            }

            if (seleccionados.has(origenId)) {
                select?.setCustomValidity(
                    'Esta entrega del Release ya fue seleccionada en otra fila.'
                );
                return { valido: false, cantidad: Math.max(0, cantidad) };
            }

            seleccionados.add(origenId);

            if (cantidad <= 0) {
                input?.setCustomValidity(
                    'Indica una cantidad mayor que cero para la entrega seleccionada.'
                );
                return { valido: false, cantidad: 0 };
            }

            if (cantidad > disponible) {
                input?.setCustomValidity(
                    `No puedes tomar mas de las ${textoNumero(disponible)} piezas libres de esta entrega.`
                );
                return { valido: false, cantidad };
            }

            // Ya NO exigimos que cada fila extra sea un multiplo de caja.
            // Puede aportar exactamente el remanente necesario para cerrar el total.
            return { valido: true, cantidad };
        }

        function validarCantidadBase(totalExtra) {
            if (!cantidadInput) return true;

            cantidadInput.setCustomValidity('');
            const base = cantidadBaseActual();

            if (base <= 0) {
                cantidadInput.setCustomValidity('La cantidad base debe ser mayor que cero.');
                return false;
            }

            if (base > cantidadBaseRelease) {
                cantidadInput.setCustomValidity(
                    `Solo quedan ${textoNumero(cantidadBaseRelease)} piezas pendientes en esta entrega.`
                );
                return false;
            }

            if (totalExtra > 0) {
                if (piezasPorCajaRelease <= 0) {
                    cantidadInput.setCustomValidity(
                        'Para usar Aumento por cajas la pieza debe tener capacidad de caja/embalaje configurada.'
                    );
                    return false;
                }

                const totalFinal = base + totalExtra;
                const faltante = faltanteParaCerrarCaja(totalFinal);

                if (faltante > 0) {
                    cantidadInput.setCustomValidity(
                        `Con Aumento por cajas, Base + Piezas extra debe cerrar cajas completas. ` +
                        `Total actual: ${textoNumero(totalFinal)}; faltan ${textoNumero(faltante)} pieza(s).`
                    );
                    return false;
                }
            }

            return true;
        }

        function recalcularAumentosRelease() {
            const seleccionados = new Set();
            let totalExtra = 0;
            let todoValido = true;

            filasAumentoRelease().forEach(fila => {
                actualizarInfoFilaAumento(fila);
                const resultado = validarFilaAumento(fila, seleccionados);
                totalExtra += Math.max(0, resultado.cantidad || 0);
                if (!resultado.valido) todoValido = false;
            });

            if (!validarCantidadBase(totalExtra)) {
                todoValido = false;
            }

            const base = cantidadBaseActual();
            const totalFinal = base + totalExtra;
            sincronizarCantidadTotalVisible(totalFinal);

            if (aumentoPreview) {
                if (totalExtra <= 0) {
                    aumentoPreview.textContent =
                        `Base seleccionada: ${textoNumero(base)} pzas. Sin aumento por cajas.`;
                    aumentoPreview.classList.remove('text-danger', 'text-success', 'text-muted', 'is-ok', 'is-error', 'is-muted');
                    aumentoPreview.classList.add(todoValido ? 'is-muted' : 'is-error');
                }
                else {
                    const faltante = faltanteParaCerrarCaja(totalFinal);

                    if (piezasPorCajaRelease > 0 && faltante === 0) {
                        const cajas = totalFinal / piezasPorCajaRelease;
                        aumentoPreview.textContent =
                            `Base ${textoNumero(base)} + extra ${textoNumero(totalExtra)} = ` +
                            `${textoNumero(totalFinal)} pzas = ${Number(cajas).toLocaleString('es-MX')} caja(s) completas.`;
                    }
                    else {
                        aumentoPreview.textContent =
                            `Base ${textoNumero(base)} + extra ${textoNumero(totalExtra)} = ` +
                            `${textoNumero(totalFinal)} pzas. ` +
                            (piezasPorCajaRelease > 0
                                ? `Faltan ${textoNumero(faltante)} pieza(s) para cerrar la siguiente caja.`
                                : 'Falta configurar la capacidad de caja/embalaje.');
                    }

                    aumentoPreview.classList.remove('text-muted', 'text-danger', 'text-success', 'is-ok', 'is-error', 'is-muted');
                    aumentoPreview.classList.add(todoValido ? 'is-ok' : 'is-error');
                }
            }

            recalcularHorasPorCantidad();
            recalcularFin();

            return todoValido;
        }

        function autocompletarCantidadDesdeOrigen(fila) {
            const select = fila.querySelector('.js-aumento-origen');
            const input = fila.querySelector('.js-aumento-cantidad');
            const opcion = select?.selectedOptions?.[0];

            if (!input) return;

            if (!select?.value || !opcion) {
                input.value = '0';
                recalcularAumentosRelease();
                return;
            }

            const disponible = Math.max(0, Math.trunc(Number(opcion.dataset.disponible || 0)));
            const totalSinEstaFila = cantidadBaseActual() + totalExtrasActual(fila);
            const faltante = faltanteParaCerrarCaja(totalSinEstaFila);

            // Sugerimos solo lo necesario para cerrar la caja. Si una entrega no
            // alcanza, puede agregarse otra fila para completar el faltante restante.
            input.value = String(Math.min(disponible, faltante));
            recalcularAumentosRelease();
        }

        function agregarFilaAumentoRelease() {
            if (!aumentoReleaseTemplate || !aumentosReleaseFilas) return;

            const index = filasAumentoRelease().length;
            const html = aumentoReleaseTemplate.innerHTML.replaceAll('__INDEX__', String(index));
            aumentosReleaseFilas.insertAdjacentHTML('beforeend', html);
            reindexarAumentosRelease();
            recalcularAumentosRelease();
        }
        function recalcularHorasPorCantidad() {
            if (!cantidadInput || !horasInput || objetivoHora <= 0) return;

            const cantidad = cantidadTotalPrograma();
            const horas = cantidad > 0 ? Math.ceil(cantidad / objetivoHora) : 0;

            if (horas > 0) {
                horasInput.value = horas.toFixed(0);

                if (formulaHoras) {
                    formulaHoras.textContent = horas.toFixed(0);
                }
            }
        }

        function obtenerIntervaloOperativoJs(fecha) {
            const dia = new Date(fecha);
            dia.setHours(0, 0, 0, 0);

            const dow = fecha.getDay();

            if (dow === 0) {
                if (!trabajarDomingoInput?.checked) return null;

                return {
                    apertura: new Date(dia),
                    cierre: new Date(dia.getTime() + 24 * 60 * 60 * 1000)
                };
            }

            if (dow === 1) {
                const apertura = new Date(dia);
                apertura.setHours(7, 0, 0, 0);

                return {
                    apertura: apertura,
                    cierre: new Date(dia.getTime() + 24 * 60 * 60 * 1000)
                };
            }

            if (dow >= 2 && dow <= 5) {
                return {
                    apertura: new Date(dia),
                    cierre: new Date(dia.getTime() + 24 * 60 * 60 * 1000)
                };
            }

            if (dow === 6) {
                const cierre = new Date(dia);

                // Producción opera el sábado hasta las 22:30.
                // Si domingo no está autorizado, después de este cierre
                // el cálculo continúa el lunes a las 07:00.
                cierre.setHours(22, 30, 0, 0);

                return {
                    apertura: new Date(dia),
                    cierre: cierre
                };
            }

            return null;
        }

        function siguienteAperturaOperativaJs(fecha) {
            let actual = new Date(fecha);

            for (let i = 0; i < 21; i++) {
                const intervalo = obtenerIntervaloOperativoJs(actual);

                if (intervalo) {
                    if (actual < intervalo.apertura) return intervalo.apertura;
                    if (actual >= intervalo.apertura && actual < intervalo.cierre) return actual;
                }

                actual = new Date(actual.getFullYear(), actual.getMonth(), actual.getDate() + 1, 0, 0, 0, 0);
            }

            return fecha;
        }

        function sumarHorasOperativasJs(inicio, horas) {
            let actual = new Date(inicio);
            let restante = Number(horas || 0);

            if (restante <= 0) return actual;

            while (restante > 0) {
                const intervalo = obtenerIntervaloOperativoJs(actual);

                if (!intervalo) {
                    actual = siguienteAperturaOperativaJs(actual);
                    continue;
                }

                if (actual < intervalo.apertura) actual = intervalo.apertura;

                if (actual >= intervalo.cierre) {
                    actual = siguienteAperturaOperativaJs(new Date(intervalo.cierre.getTime() + 60000));
                    continue;
                }

                const disponibles = (intervalo.cierre - actual) / 3600000;

                if (disponibles >= restante) {
                    return new Date(actual.getTime() + restante * 3600000);
                }

                restante -= disponibles;
                actual = siguienteAperturaOperativaJs(new Date(intervalo.cierre.getTime() + 60000));
            }

            return actual;
        }

        function recalcularFin() {
            if (!horasInput || !finInput) return;

            const horas = Math.ceil(toDecimal(horasInput.value));
            const base = construirFechaArranque();

            if (!base || horas <= 0) {
                finInput.value = '';
                return;
            }

            const fin = sumarHorasOperativasJs(base, horas);
            finInput.value = formatearFechaLocal(fin);
        }

        // NSQ_PLANEACION_DISENO_HORARIO_ESTRICTO_V1_5
        function actualizarAvisoHorarioPasado() {
            if (!inicioInput) return;

            const aviso = document.getElementById('avisoHorarioPasado');
            if (!aviso) return;

            if (!inicioInput.value) {
                aviso.hidden = true;
                inicioInput.classList.remove('is-past-schedule');
                return;
            }

            const fechaSeleccionada = new Date(inicioInput.value);
            const esPasado =
                !Number.isNaN(fechaSeleccionada.getTime()) &&
                fechaSeleccionada < new Date();

            aviso.hidden = !esPasado;
            inicioInput.classList.toggle('is-past-schedule', esPasado);
        }
        function normalizarInicioCambioArranque() {
            if (!inicioInput || !inicioInput.value) return;

            if (esInterrupcionProduccion()) {
                recalcularFin();
                return;
            }

            const inicioRedondeado = redondearSiguienteHora(new Date(inicioInput.value));

            inicioInput.value = formatearFechaLocal(inicioRedondeado);

            if (cambioInput) {
                cambioInput.value = horaCompletaTexto(inicioRedondeado);
            }

            if (arranqueInput) {
                arranqueInput.value = sumarUnaHoraCompleta(cambioInput.value);
            }

            recalcularFin();
        }

        cantidadInput?.addEventListener('input', function () {
            actualizarBaseDesdeTotalVisible();
            recalcularAumentosRelease();
        });

        aumentosReleaseFilas?.addEventListener('change', function (event) {
            const select = event.target?.closest?.('.js-aumento-origen');
            if (!select) return;
            const fila = select.closest('.js-aumento-fila');
            if (fila) autocompletarCantidadDesdeOrigen(fila);
        });

        aumentosReleaseFilas?.addEventListener('input', function (event) {
            if (!event.target?.classList?.contains('js-aumento-cantidad')) return;
            recalcularAumentosRelease();
        });

        aumentosReleaseFilas?.addEventListener('click', function (event) {
            const boton = event.target?.closest?.('.js-quitar-aumento');
            if (!boton) return;

            const fila = boton.closest('.js-aumento-fila');
            if (!fila) return;

            const filas = filasAumentoRelease();
            if (filas.length <= 1) {
                const select = fila.querySelector('.js-aumento-origen');
                const input = fila.querySelector('.js-aumento-cantidad');
                if (select) {
                    select.value = '';
                    select.dispatchEvent(new Event('change', { bubbles: true }));
                }
                if (input) input.value = '0';
            }
            else {
                fila.remove();
            }

            reindexarAumentosRelease();
            recalcularAumentosRelease();
        });

        btnAgregarAumentoRelease?.addEventListener('click', agregarFilaAumentoRelease);

        reindexarAumentosRelease();
        filasAumentoRelease().forEach(actualizarInfoFilaAumento);
        recalcularAumentosRelease();

        trabajarDomingoInput?.addEventListener('change', recalcularFin);

        horasInput?.addEventListener('input', function () {
            const horas = Math.ceil(toDecimal(horasInput.value));

            if (horas > 0) {
                horasInput.value = horas.toFixed(0);
            }

            if (formulaHoras) {
                formulaHoras.textContent = horas > 0 ? horas.toFixed(0) : '0';
            }

            recalcularFin();
        });

        inicioInput?.addEventListener('change', function () {
            normalizarInicioCambioArranque();
            actualizarAvisoHorarioPasado();
        });

        cambioInput?.addEventListener('change', function () {
            if (esInterrupcionProduccion()) {
                recalcularFin();
                return;
            }

            normalizarTimeHoraCompleta(cambioInput);

            if (inicioInput && inicioInput.value && cambioInput.value) {
                const fechaInicio = new Date(inicioInput.value);
                const partes = cambioInput.value.split(':');

                fechaInicio.setHours(Number(partes[0] || 0));
                fechaInicio.setMinutes(0);
                fechaInicio.setSeconds(0);
                fechaInicio.setMilliseconds(0);

                inicioInput.value = formatearFechaLocal(fechaInicio);
            }

            if (arranqueInput) {
                arranqueInput.value = sumarUnaHoraCompleta(cambioInput.value);
            }

            recalcularFin();
        });

        arranqueInput?.addEventListener('change', function () {
            if (!esInterrupcionProduccion()) {
                normalizarTimeHoraCompleta(arranqueInput);
            }

            recalcularFin();
        });

        condicionInput?.addEventListener('change', function () {
            normalizarInicioCambioArranque();
        });

        formPrograma?.addEventListener('submit', function (event) {
            reindexarAumentosRelease();
            const aumentosValidos = recalcularAumentosRelease();

            if (!aumentosValidos) {
                event.preventDefault();

                const primerInvalido = aumentosReleaseFilas?.querySelector(':invalid');
                const mensaje = primerInvalido?.validationMessage ||
                    'Revisa las filas de aumento antes de guardar.';

                alert(mensaje);
                primerInvalido?.focus?.();
                return;
            }

            if (inicioInput) {
                // Se permite un horario pasado. Solo mostramos la advertencia.
                inicioInput.removeAttribute('min');
                actualizarAvisoHorarioPasado();
            }

            if (!esInterrupcionProduccion()) {
                normalizarInicioCambioArranque();
            }

            recalcularHorasPorCantidad();
            recalcularFin();

            if (!btnGuardar) return;

            btnGuardar.disabled = true;
            btnGuardar.querySelector('i').className = 'fa-solid fa-spinner fa-spin';
            btnGuardar.querySelector('.btn-label').textContent = 'Guardando cambio...';
        });

        document.addEventListener('DOMContentLoaded', function () {
            if (inicioInput) {
                inicioInput.removeAttribute('min');

                if (!inicioInput.value) {
                    inicioInput.value =
                        formatearFechaLocal(
                            redondearSiguienteHora(new Date()));
                }
            }

            if (!esInterrupcionProduccion()) {
                normalizarInicioCambioArranque();
            }

            recalcularHorasPorCantidad();
            recalcularFin();
            actualizarAvisoHorarioPasado();

            const modalConflictoHorario = document.getElementById('modalConflictoHorario');

            if (modalConflictoHorario && window.bootstrap) {
                const modal = new bootstrap.Modal(modalConflictoHorario);
                modal.show();
            }
        });
    </script>
}


