                        }
                    </div>
                    <div class="machine-actions"><button type="button" class="btn btn-main" data-bs-toggle="modal" data-bs-target="#@modalId"><i class="fa-solid fa-up-right-and-down-left-from-center me-1"></i>Abrir tablero</button></div>
                </article>

                <div class="modal fade" id="@modalId" tabindex="-1" aria-hidden="true" data-machine-board-modal data-maquina-id="@maq.MaquinaID" data-nsq-marker="NSQ_MACHINE_BOARD_MODAL_V1">
                    <div class="modal-dialog modal-fullscreen">
                        <div class="modal-content">
                            <div class="modal-header-pro">
                                <div class="d-flex justify-content-between align-items-start gap-3 flex-wrap w-100">
                                    <div>
                                        <h2 class="modal-title-pro"><i class="fa-solid fa-gears me-2"></i>@Valor(maq.MaquinaCodigo)</h2>
                                        <div class="modal-sub-pro">@Valor(maq.MaquinaNombre) · @estadoTexto · Rango @Model.FechaDesde.ToString("dd/MM/yyyy") - @Model.FechaHasta.ToString("dd/MM/yyyy")</div>
                                        <div class="chip-row mt-3"><span class="pill pill-primary">@maq.Programas.Count.ToString("N0") programas</span><span class="pill pill-warning">@maq.Programas.Sum(x => x.CantidadPendiente).ToString("N0") pendientes</span><span class="pill pill-success">@maq.Programas.Count(x => x.TieneOF).ToString("N0") con OF</span><span class="pill pill-muted">@maq.Programas.Count(x => x.PuedeGenerarOF).ToString("N0") OF pendientes</span></div>
                                    </div>
                                    <button type="button" class="btn btn-light fw-bold rounded-4" data-bs-dismiss="modal"><i class="fa-solid fa-xmark me-1"></i>Cerrar</button>
                                </div>
                            </div>
                            <div class="modal-body-pro">
                                @if (maq.Programas.Any())
                                {
                                    <div class="machine-layout">
                                        <main>
                                            <div class="stage-panel">
                                                <div class="stage-head">
                                                    <h3 class="stage-title">Timeline operativo</h3>
                                                    <div class="stage-desc">Carga de la máquina dentro del rango seleccionado. El mapa compacto queda debajo y el panel operativo se mantiene a la derecha.</div>
                                                </div>
                                                <div class="stage-body">
                                                    <div class="timeline-panel">
                                                        @{
                                                            var diasTimeline = DiasRango();
                                                            var columnasTimeline = Math.Max(1, diasTimeline.Count);
                                                        }

                                                        <div class="timeline-title">
                                                            <i class="fa-solid fa-timeline me-2"></i>
                                                            Línea de tiempo operativa
                                                        </div>

                                                        <div class="timeline-help">
                                                            <span class="pill pill-primary"><i class="fa-solid fa-circle"></i> Programado</span>
                                                            <span class="pill pill-success"><i class="fa-solid fa-play"></i> En producción</span>
                                                            <span class="pill pill-warning"><i class="fa-solid fa-wrench"></i> Preparación</span>
                                                            <span class="pill pill-danger"><i class="fa-solid fa-pause"></i> Pausado</span>
                                                            <span class="pill pill-muted"><i class="fa-solid fa-map"></i> El mapa compacto reemplaza el detalle largo</span>
                                                        </div>

                                                        <div class="timeline-scale" data-nsq-style="grid-template-columns: repeat(@columnasTimeline, minmax(120px, 1fr));">
                                                            @foreach (var dia in diasTimeline)
                                                            {
                                                                <div class="timeline-scale-day">
                                                                    <div class="timeline-day-name">@dia.ToString("dddd", new System.Globalization.CultureInfo("es-MX"))</div>
                                                                    <div class="timeline-day-date">@dia.ToString("dd/MM/yyyy")</div>
                                                                </div>
                                                            }
                                                        </div>

                                                        <div class="timeline-track machine-board-track"
                                             data-machine-board-track
                                             data-maquina-id="@maq.MaquinaID"
                                             data-inicio-periodo="@RangoInicio().ToString("yyyy-MM-ddTHH:mm:ss")"
                                             data-fin-periodo="@RangoFin().ToString("yyyy-MM-ddTHH:mm:ss")" data-nsq-marker="NSQ_MACHINE_BOARD_TRACK_V1">
                                                            <div class="timeline-day-grid" data-nsq-style="grid-template-columns: repeat(@columnasTimeline, minmax(120px, 1fr));">
                                                                @foreach (var dia in diasTimeline)
                                                                {
                                                                    <div class="timeline-day-column"></div>
                                                                }
                                                            </div>

                                                            <div class="timeline-hour-line"></div>

                                                            <div class="timeline-now-line" data-nsq-style="@TimelineNowStyle()">
                                                                <span class="timeline-now-label">Ahora</span>
                                                            </div>

                                                            @for (var idxTimeline = 0; idxTimeline < programasOrdenados.Count; idxTimeline++)
                                                            {
                                                                var p = programasOrdenados[idxTimeline];
                                                                var carrilTimeline = idxTimeline % 5;
                                                                var topTimeline = 18 + (carrilTimeline * 42);

                                                                <div class="timeline-item @TimelineClass(p) machine-board-block"
                                                                     draggable="true"
                                                                     data-programa-id="@p.ProgramaProduccionID"
                                                                     data-maquina-id="@maq.MaquinaID"
                                                                     data-estatus-id="@p.EstatusID"
                                                                     data-nsq-marker="NSQ_MACHINE_BOARD_BLOCK_V1"
                                                                     data-nsq-style="@TimelineStyle(p) top:@(topTimeline)px;"
                                                                     title="@Valor(p.ReferenciaSAP ?? p.NumeroParte) · @FechaHora(p.FechaInicioProgramada) - @FechaHora(p.FechaFinProgramada)">
                                                                    <span class="timeline-ref">@Valor(p.ReferenciaSAP ?? p.NumeroParte)</span>
                                                                    <small>@InicioVisible(p).ToString("dd/MM HH:mm") - @FinVisible(p).ToString("dd/MM HH:mm")</small>
                                                                </div>
                                                            }
                                                        </div>

                                                        <div class="timeline-legend">
                                                            <span>Inicio del rango: @Model.FechaDesde.ToString("dd/MM/yyyy 00:00")</span>
                                                            <span>Fin del rango: @Model.FechaHasta.ToString("dd/MM/yyyy 23:59")</span>
                                                        </div>

                                                        <div class="production-map-panel">
                                                            <div class="production-map-head">
                                                                <div>
                                                                    <h4 class="production-map-title">
                                                                        <i class="fa-solid fa-map-location-dot me-2"></i>
                                                                        Mapa compacto de producción
                                                                    </h4>
                                                                    <div class="production-map-sub">
                                                                        Resumen por programa: pieza, horario, molde y cálculo de piezas necesarias.
                                                                    </div>
                                                                </div>

                                                                <div class="chip-row">
                                                                    <span class="pill pill-primary">@programasOrdenados.Count.ToString("N0") programas</span>
                                                                    <span class="pill pill-warning">@programasOrdenados.Sum(x => x.CantidadPendiente).ToString("N0") pzas necesarias</span>
                                                                    <span class="pill pill-success">@programasOrdenados.Count(x => x.TieneOF).ToString("N0") con OF</span>
                                                                </div>
                                                            </div>

                                                            <div class="production-map-grid">
                                                                @foreach (var p in programasOrdenados)
                                                                {
                                                                    var esActual = maq.Actual?.ProgramaProduccionID == p.ProgramaProduccionID;
                                                                    var piezasNecesarias = p.CantidadPendiente > 0 ? p.CantidadPendiente : p.CantidadProgramada;
                                                                    var claseActual = esActual ? "is-current" : "";

                                                                    <div class="production-map-card @claseActual">
                                                                        <div class="production-map-top">
                                                                            <div>
                                                                                <div class="production-map-part">@Valor(p.ReferenciaSAP ?? p.NumeroParte)</div>
                                                                                <div class="production-map-desc">@Valor(p.DesignacionDescripcionSAP)</div>
                                                                            </div>

                                                                            <span class="pill @ClaseEstatus(p.EstatusID)">
                                                                                @p.EstatusNombre
                                                                            </span>
                                                                        </div>

                                                                        <div class="chip-row">
                                                                            @if (esActual)
                                                                            {
                                                                                <span class="pill pill-success"><i class="fa-solid fa-play"></i> Actual</span>
                                                                            }
                                                                            <span class="pill pill-primary">@Valor(p.CondicionProduccion)</span>
                                                                            <span class="pill pill-purple">Molde @Valor(p.MoldeCodigo)</span>
                                                                        </div>

                                                                        <div class="production-map-values">
                                                                            <div class="production-map-value">
                                                                                <div class="production-map-label">Necesarias</div>
                                                                                <div class="production-map-number">@piezasNecesarias.ToString("N0")</div>
                                                                            </div>
                                                                            <div class="production-map-value">
                                                                                <div class="production-map-label">Programadas</div>
                                                                                <div class="production-map-number">@p.CantidadProgramada.ToString("N0")</div>
                                                                            </div>
                                                                            <div class="production-map-value">
                                                                                <div class="production-map-label">Pendientes</div>
                                                                                <div class="production-map-number">@p.CantidadPendiente.ToString("N0")</div>
                                                                            </div>
                                                                        </div>

                                                                        <div class="text-muted small fw-semibold mt-2">
                                                                            @FechaHora(p.FechaInicioProgramada) - @FechaHora(p.FechaFinProgramada)
                                                                        </div>

                                                                        @if (p.PuedeGenerarOF || p.TieneOF)
                                                                        {
                                                                            <div class="production-map-actions">
                                                                                @if (p.PuedeGenerarOF)
                                                                                {
                                                                                    <button type="button"
                                                                                            class="btn btn-sm btn-main btn-generar-of"
                                                                                            data-programa-id="@p.ProgramaProduccionID"
                                                                                            data-referencia="@Valor(p.ReferenciaSAP ?? p.NumeroParte)"
                                                                                            data-designacion="@Valor(p.DesignacionDescripcionSAP)"
                                                                                            data-maquina="@Valor(p.MaquinaCodigo)"
                                                                                            data-molde="@Valor(p.MoldeCodigo)"
                                                                                            data-cantidad="@p.CantidadProgramada.ToString("N0")">
                                                                                        <i class="fa-solid fa-file-circle-plus me-1"></i>
                                                                                        Generar OF
                                                                                    </button>
                                                                                }
                                                                                else if (p.TieneOF)
                                                                                {
                                                                                    <a asp-controller="Planeacion"
                                                                                       asp-action="Detalle"
                                                                                       asp-route-id="@p.SolicitudProduccionID"
                                                                                       class="btn btn-sm btn-success rounded-4 fw-bold">
                                                                                        <i class="fa-solid fa-circle-check me-1"></i>
                                                                                        Ver OF
                                                                                    </a>
                                                                                }
                                                                            </div>
                                                                        }
                                                                    </div>
                                                                }
                                                            </div>
                                                        </div>
                                                    </div>
                                                </div>
                                            </div>
                                        </main>

                                        <aside class="side-panel">
                                            <div class="side-card">
                                                <div class="side-title">
                                                    <i class="fa-solid fa-play text-success me-2"></i>
                                                    Programa actual
                                                </div>

                                                @if (maq.Actual != null)
                                                {
                                                    var actual = maq.Actual;
                                                    var piezasNecesariasActual = actual.CantidadPendiente > 0
                                                        ? actual.CantidadPendiente
                                                        : actual.CantidadProgramada;

                                                    <div class="queue-item">
                                                        <div class="fw-bold">@Valor(actual.ReferenciaSAP ?? actual.NumeroParte)</div>
                                                        <div class="text-muted small">@Valor(actual.DesignacionDescripcionSAP)</div>

                                                        <div class="chip-row mt-2">
                                                            <span class="pill pill-success">@actual.EstatusNombre</span>
                                                            <span class="pill pill-primary">@Valor(actual.MoldeCodigo)</span>
                                                            <span class="pill pill-warning">@piezasNecesariasActual.ToString("N0") pzas necesarias</span>
                                                        </div>

                                                        <div class="text-muted small fw-semibold mt-2">
                                                            @FechaHora(actual.FechaInicioProgramada) - @FechaHora(actual.FechaFinProgramada)
                                                        </div>
                                                    </div>
                                                }
                                                else
                                                {
                                                    <div class="text-muted small">No hay programa marcado como actual.</div>
                                                }
                                            </div>

                                            <div class="side-card">
                                                <div class="side-title">
                                                    <i class="fa-solid fa-forward-step text-primary me-2"></i>
                                                    Siguiente producción
                                                </div>

                                                @if (maq.Siguiente != null)
                                                {
                                                    var sig = maq.Siguiente;
                                                    var piezasNecesariasSiguiente = sig.CantidadPendiente > 0
                                                        ? sig.CantidadPendiente
                                                        : sig.CantidadProgramada;

                                                    <div class="queue-item">
                                                        <div class="fw-bold">@Valor(sig.ReferenciaSAP ?? sig.NumeroParte)</div>
                                                        <div class="text-muted small">@Valor(sig.DesignacionDescripcionSAP)</div>

                                                        <div class="chip-row mt-2">
                                                            <span class="pill pill-primary">@FechaHora(sig.FechaInicioProgramada)</span>
                                                            <span class="pill pill-purple">@Valor(sig.MoldeCodigo)</span>
                                                            <span class="pill pill-warning">@piezasNecesariasSiguiente.ToString("N0") pzas necesarias</span>
                                                        </div>
                                                    </div>
                                                }
                                                else
                                                {
                                                    <div class="text-muted small">No hay siguiente producción identificada.</div>
                                                }
                                            </div>

                                           
                                        </aside>
                                    </div>
                         
                                                        }
                                                        else
                            {
                                <div class="empty-machine"><i class="fa-regular fa-calendar-xmark fa-3x mb-3"></i><h3 class="fw-bold text-primary">Máquina libre</h3><p class="mb-0">No hay producciones ni cambios programados en este rango.</p></div>
                            }
                        </div>
                    </div>
                </div>
            </div>
                        }
        </section>

        <section class="sticky-actions">
            <div class="d-flex justify-content-between gap-2 flex-wrap">
                <a asp-controller="PlaneacionPrograma" asp-action="Index" class="btn btn-light-main"><i class="fa-solid fa-arrow-left me-1"></i>Volver a Volver</a>
                <div class="d-flex gap-2 flex-wrap"><a asp-controller="PlaneacionPanorama" asp-action="Index" class="btn btn-light-main"><i class="fa-solid fa-chart-line me-1"></i>Panorama</a><a asp-controller="PlaneacionPrograma" asp-action="Index" class="btn btn-main"><i class="fa-solid fa-list me-1"></i>Programa general</a></div>
            </div>
        </section>
    </div>

    <form asp-controller="PlaneacionPrograma" asp-action="GenerarOF" method="post" id="formGenerarOF" class="d-none">
        @Html.AntiForgeryToken()
        <input type="hidden" name="programaProduccionId" id="programaProduccionIdGenerarOF" />
    </form>

    <div class="modal fade" id="modalGenerarOF" tabindex="-1" aria-labelledby="modalGenerarOFLabel" aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content rounded-4 border-0 shadow-lg">
                <div class="modal-header border-0 pb-0">
                    <div><h5 class="modal-title fw-bold text-primary" id="modalGenerarOFLabel"><i class="fa-solid fa-file-circle-plus me-2"></i>Generar Orden de Fabricación</h5><div class="text-muted small">Confirma que deseas generar la OF desde este programa de máquina.</div></div>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Cerrar"></button>
                </div>
                <div class="modal-body">
                    <div class="alert alert-warning rounded-4 mb-3"><i class="fa-solid fa-triangle-exclamation me-2"></i>Al confirmar se creará una nueva OF y quedará ligada al programa de producción.</div>
                    <div class="border rounded-4 p-3 bg-light">
                        <div class="mb-2"><div class="modal-value-label">Referencia SAP</div><div class="fw-bold" id="modalOFReferencia">-</div></div>
                        <div class="mb-2"><div class="modal-value-label">Designación</div><div id="modalOFDesignacion">-</div></div>
                        <div class="row g-2"><div class="col-4"><div class="modal-value-label">Máquina</div><div class="fw-semibold" id="modalOFMaquina">-</div></div><div class="col-4"><div class="modal-value-label">Molde</div><div class="fw-semibold" id="modalOFMolde">-</div></div><div class="col-4"><div class="modal-value-label">Cantidad</div><div class="fw-semibold" id="modalOFCantidad">-</div></div></div>
                    </div>
                </div>
                <div class="modal-footer border-0 pt-0"><button type="button" class="btn btn-light-main" data-bs-dismiss="modal">Cancelar</button><button type="button" class="btn btn-main" id="btnConfirmarGenerarOF"><i class="fa-solid fa-check me-1"></i>Sí, generar OF</button></div>
            </div>
        </div>
    </div>

@* NSQ_CALENDARIO_EDITABLE_LINK_V1 *@
<script>
document.addEventListener('DOMContentLoaded', function () {
    if (document.getElementById('nsqCalendarioEditableLink')) return;

    const host =
        document.querySelector('.hero-actions') ||
        document.querySelector('.d-flex.gap-2.flex-wrap');

    if (!host) return;

    const link = document.createElement('a');
    link.id = 'nsqCalendarioEditableLink';
    link.className = 'btn-glass';
    link.href = '@Url.Action("Index","PlaneacionCalendarioMaquinas", new { vista = "semana", fecha = Model.FechaDesde.ToString("yyyy-MM-dd") })';
    link.innerHTML =
        '<i class="fa-solid fa-arrows-left-right-to-line"></i> Mover horarios por hora';

    host.appendChild(link);
});
</script>