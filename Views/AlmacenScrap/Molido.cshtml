@using System.Globalization
@model ERP.NSQuell.Models.ViewModels.Almacen.AlmacenScrapMolidoVm
@{
    Layout = "~/Views/Shared/_AlmacenLayout.cshtml";
    ViewData["Title"] = "Realizar MP Molido";
    var peso = Model.PesoMolidoKg.ToString("0.0000", CultureInfo.InvariantCulture);
}

<link rel="stylesheet" href="~/css/Almacen/almacen-forms-v5.css" asp-append-version="true" />
<link rel="stylesheet" href="~/css/Almacen/almacen-scrap.css" asp-append-version="true" />

<section class="alm-hero scrap-hero scrap-hero--molido">
    <div>
        <small>SCRAP #@Model.ScrapRegistroID · TRANSFORMACIÓN</small>
        <h1>Realizar MP Molido</h1>
        <p>
            Captura el peso real obtenido. Al guardar se crea una Entrada de MP tipo
            <strong>Molido</strong> y el Scrap queda enlazado al movimiento generado.
        </p>
    </div>
    <div class="alm-actions">
        <a class="alm-btn secondary" asp-action="Detalle" asp-route-id="@Model.ScrapRegistroID">
            <i class="fa-solid fa-arrow-left"></i>
            Volver al detalle
        </a>
    </div>
</section>

<section class="scrap-molido-layout">
    <article class="alm-card">
        <header>
            <span><i class="fa-solid fa-fingerprint"></i> Trazabilidad origen</span>
            <span>Datos bloqueados</span>
        </header>

        <div class="scrap-readonly-grid">
            <div><small>Origen</small><strong>@Model.Origen</strong></div>
            <div><small>OF</small><strong>@Model.NumeroOF</strong></div>
            <div><small>Número de parte</small><strong>@Model.NumeroParte</strong></div>
            <div><small>Designación</small><strong>@Model.Designacion</strong></div>
            <div><small>Piezas Scrap</small><strong>@Model.CantidadPiezas.ToString("N0") PZA</strong></div>
            <div><small>Lote</small><strong>@Model.Lote</strong></div>
        </div>

        <div class="scrap-barcode-display">
            <small>Código original</small>
            <code>@Model.CodigoBarras</code>
        </div>
    </article>

    <article class="alm-card scrap-molido-form-card">
        <header>
            <span><i class="fa-solid fa-gears"></i> Entrada de MP Molido</span>
            <span>Unidad fija: KG</span>
        </header>

        @if (!Model.MaterialID.HasValue)
        {
            <div class="alm-alert danger">
                <strong>No se puede generar MP Molido.</strong>
                <div>@Model.MaterialError</div>
                <div>Corrige la relación de material de esta parte en ERP_ParteDatosTecnicos antes de continuar.</div>
            </div>
        }

        <form method="post" class="alm-form">
            <div asp-validation-summary="ModelOnly" class="alm-alert danger full"></div>

            <input asp-for="ScrapRegistroID" type="hidden" />

            <div class="alm-field full">
                <label>Material MP resuelto desde la parte</label>
                <div class="scrap-material-lock @(Model.MaterialID.HasValue ? "is-ok" : "is-error")">
                    <i class="fa-solid @(Model.MaterialID.HasValue ? "fa-link" : "fa-triangle-exclamation")"></i>
                    <div>
                        @if (Model.MaterialID.HasValue)
                        {
                            <strong>@Model.MaterialCodigo · @Model.MaterialNombre</strong>
                            <small>MaterialID @Model.MaterialID · Tipo de existencia: Molido</small>
                        }
                        else
                        {
                            <strong>Sin material único</strong>
                            <small>@Model.MaterialError</small>
                        }
                    </div>
                </div>
            </div>

            <div class="alm-field">
                <label asp-for="PesoMolidoKg"></label>
                <div class="alm-unit-input">
                    <input asp-for="PesoMolidoKg"
                           class="alm-input"
                           type="number"
                           min="0.001"
                           step="0.001"
                           inputmode="decimal"
                           value="@peso"
                           placeholder="0.000" />
                    <span class="alm-unit-input__suffix">KG</span>
                </div>
                <span asp-validation-for="PesoMolidoKg"></span>
            </div>

            <div class="alm-field">
                <label asp-for="UbicacionID"></label>
                <select asp-for="UbicacionID" class="alm-select">
                    <option value="">Selecciona ubicación MP</option>
                    @foreach (var item in Model.Ubicaciones)
                    {
                        <option value="@item.Id">@item.Texto</option>
                    }
                </select>
                <span asp-validation-for="UbicacionID"></span>
            </div>

            <div class="alm-field full">
                <label asp-for="ObservacionesMolido">Observaciones del molido</label>
                <textarea asp-for="ObservacionesMolido"
                          class="alm-textarea"
                          maxlength="800"
                          rows="3"
                          placeholder="Opcional: molino, turno, condición, observaciones..."></textarea>
                <span asp-validation-for="ObservacionesMolido"></span>
            </div>

            <div class="scrap-conversion-warning full">
                <i class="fa-solid fa-circle-exclamation"></i>
                <div>
                    <strong>Esta acción sí impacta inventario MP.</strong>
                    <span>
                        Se creará un movimiento Entrada / Molido por el peso indicado,
                        conservando OF, parte, designación y lote en la trazabilidad del Scrap.
                    </span>
                </div>
            </div>

            <div class="scrap-form-actions full">
                <a class="alm-btn secondary"
                   asp-action="Detalle"
                   asp-route-id="@Model.ScrapRegistroID">
                    Cancelar
                </a>

                <button type="submit"
                        class="alm-btn"
                        disabled="@(!Model.PuedeGuardar ? "disabled" : null)"
                        onclick="return confirm('¿Generar la Entrada de MP Molido con este peso?');">
                    <i class="fa-solid fa-floppy-disk"></i>
                    Guardar y generar MP Molido
                </button>
            </div>
        </form>
    </article>
</section>
