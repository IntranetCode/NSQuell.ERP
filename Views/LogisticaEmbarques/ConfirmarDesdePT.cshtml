@using ERP.NSQuell.Models.ViewModels.Logistica
@model LogisticaCrearVm
@{
    Layout = "~/Views/Shared/_Layout.cshtml";
    ViewData["Title"] = "Flujo anterior de embarque";
    var seleccionadas = (Model.CajasPT ?? new List<LogisticaCajaPtCrearVm>())
        .Where(x => x.Seleccionada)
        .OrderBy(x => x.FechaEntrada)
        .ThenBy(x => x.CajaID)
        .ToList();
    var cliente = seleccionadas.FirstOrDefault()?.Cliente
        ?? Model.Clientes.FirstOrDefault(x => Model.ClienteID.HasValue && x.Id == Model.ClienteID.Value)?.Texto
        ?? string.Empty;
    var totalPiezas = seleccionadas.Sum(x => (long)x.Disponible);
}

@section Styles {
    <style>
        :root {
            --pt-blue: #173a7a;
            --pt-blue-soft: #eef5ff;
            --pt-text: #172033;
            --pt-muted: #667085;
            --pt-border: #dbe4f0;
            --pt-bg: #f4f7fb;
            --pt-surface: #fff;
            --pt-warning: #b54708;
            --pt-danger: #b42318
        }

        body {
            background: var(--pt-bg)
        }

        .legacy-page {
            max-width: 1240px;
            margin: 0 auto;
            padding: 22px 18px 36px;
            color: var(--pt-text)
        }

        .legacy-head {
            display: flex;
            align-items: center;
            justify-content: space-between;
            gap: 14px;
            flex-wrap: wrap;
            padding: 16px 18px;
            margin-bottom: 14px;
            border: 1px solid var(--pt-border);
            border-left: 4px solid var(--pt-blue);
            border-radius: 14px;
            background: var(--pt-surface)
        }

        .legacy-title {
            margin: 0;
            color: var(--pt-text);
            font-size: 1.42rem;
            font-weight: 900
        }

            .legacy-title i {
                color: var(--pt-blue)
            }

        .legacy-subtitle {
            margin: 4px 0 0;
            color: var(--pt-muted);
            font-size: .82rem;
            font-weight: 650
        }

        .notice {
            display: flex;
            align-items: flex-start;
            gap: 11px;
            padding: 14px 15px;
            margin-bottom: 14px;
            border: 1px solid #efcf8d;
            border-left: 4px solid var(--pt-warning);
            border-radius: 12px;
            background: #fff9ea
        }

            .notice > i {
                margin-top: 2px;
                color: var(--pt-warning);
                font-size: 1.1rem
            }

            .notice strong {
                display: block;
                margin-bottom: 3px;
                color: #7c4d00;
                font-size: .86rem;
                font-weight: 900
            }

            .notice span {
                display: block;
                color: #735f37;
                font-size: .76rem;
                line-height: 1.5;
                font-weight: 650
            }

        .card-shell {
            overflow: hidden;
            margin-bottom: 14px;
            border: 1px solid var(--pt-border);
            border-radius: 14px;
            background: var(--pt-surface)
        }

        .card-head {
            padding: 12px 14px;
            border-bottom: 1px solid var(--pt-border);
            background: #f8fbff
        }

            .card-head h2 {
                margin: 0;
                color: var(--pt-blue);
                font-size: .94rem;
                font-weight: 900
            }

            .card-head p {
                margin: 3px 0 0;
                color: var(--pt-muted);
                font-size: .72rem;
                font-weight: 650
            }

        .flow {
            display: grid;
            grid-template-columns: repeat(4,minmax(0,1fr))
        }

        .flow-item {
            padding: 15px;
            min-height: 126px;
            border-right: 1px solid var(--pt-border)
        }

            .flow-item:last-child {
                border-right: 0
            }

        .flow-number {
            width: 30px;
            height: 30px;
            display: grid;
            place-items: center;
            margin-bottom: 8px;
            border-radius: 50%;
            background: var(--pt-blue-soft);
            color: var(--pt-blue);
            font-size: .76rem;
            font-weight: 950
        }

        .flow-item strong {
            display: block;
            margin-bottom: 3px;
            color: var(--pt-text);
            font-size: .8rem;
            font-weight: 900
        }

        .flow-item span {
            display: block;
            color: var(--pt-muted);
            font-size: .71rem;
            line-height: 1.45;
            font-weight: 650
        }

        .legacy-selection {
            padding: 14px
        }

        .selection-summary {
            display: grid;
            grid-template-columns: repeat(4,minmax(0,1fr));
            gap: 8px;
            margin-bottom: 12px
        }

            .selection-summary > div {
                padding: 9px 10px;
                border: 1px solid var(--pt-border);
                border-radius: 9px;
                background: #f8fafc
            }

            .selection-summary span {
                display: block;
                color: var(--pt-muted);
                font-size: .66rem;
                font-weight: 700;
                text-transform: uppercase
            }

            .selection-summary strong {
                display: block;
                margin-top: 2px;
                color: var(--pt-blue);
                font-size: .85rem;
                font-weight: 900
            }

        .selection-table-wrap {
            overflow-x: auto;
            border: 1px solid var(--pt-border);
            border-radius: 9px
        }

        .selection-table {
            width: 100%;
            min-width: 760px;
            margin: 0;
            border-collapse: collapse;
            font-size: .74rem
        }

            .selection-table th {
                padding: 7px 8px;
                border-bottom: 1px solid var(--pt-border);
                background: #f5f7fa;
                color: #5f6d80;
                font-size: .65rem;
                text-transform: uppercase;
                text-align: left;
                white-space: nowrap
            }

            .selection-table td {
                padding: 8px;
                border-bottom: 1px solid #e9edf2;
                vertical-align: top
            }

            .selection-table tr:last-child td {
                border-bottom: 0
            }

            .selection-table .num {
                text-align: right;
                font-weight: 900;
                color: var(--pt-blue)
            }

        .selection-warning {
            margin-top: 10px;
            padding: 9px 11px;
            border: 1px dashed #e5b7b3;
            border-radius: 9px;
            background: #fff7f6;
            color: var(--pt-danger);
            font-size: .72rem;
            line-height: 1.45;
            font-weight: 700
        }

        .actions {
            display: grid;
            grid-template-columns: repeat(3,minmax(0,1fr));
            gap: 11px
        }

        .action-card {
            display: flex;
            flex-direction: column;
            min-height: 180px;
            padding: 16px;
            border: 1px solid var(--pt-border);
            border-radius: 13px;
            background: var(--pt-surface)
        }

        .action-icon {
            width: 40px;
            height: 40px;
            display: grid;
            place-items: center;
            margin-bottom: 10px;
            border-radius: 10px;
            background: var(--pt-blue-soft);
            color: var(--pt-blue)
        }

        .action-card h3 {
            margin: 0 0 4px;
            color: var(--pt-text);
            font-size: .88rem;
            font-weight: 900
        }

        .action-card p {
            margin: 0 0 13px;
            color: var(--pt-muted);
            font-size: .72rem;
            line-height: 1.45;
            font-weight: 650
        }

        .action-card .btn {
            min-height: 39px;
            margin-top: auto;
            display: inline-flex;
            align-items: center;
            justify-content: center;
            gap: 7px;
            border-radius: 9px;
            font-weight: 850
        }

        .btn-primary-flow {
            background: var(--pt-blue);
            border-color: var(--pt-blue);
            color: #fff
        }

            .btn-primary-flow:hover {
                background: #102e65;
                border-color: #102e65;
                color: #fff
            }

        .final-note {
            margin-top: 14px;
            padding: 11px 13px;
            border: 1px dashed #cad6e3;
            border-radius: 10px;
            background: #fafbfd;
            color: var(--pt-muted);
            font-size: .72rem;
            line-height: 1.5;
            font-weight: 650
        }

            .final-note strong {
                color: var(--pt-text)
            }

        html[data-nsq-theme="dark"] {
            --pt-text: #eef4fb;
            --pt-muted: #9badc2;
            --pt-border: #2b3d53;
            --pt-bg: #08111e;
            --pt-surface: #111c2d;
            --pt-blue-soft: #172b47;
            color-scheme: dark
        }

            html[data-nsq-theme="dark"] .card-head {
                background: #0d1828
            }

            html[data-nsq-theme="dark"] .notice {
                background: #2b2414;
                border-color: #765f2c
            }

                html[data-nsq-theme="dark"] .notice strong {
                    color: #ffd78a
                }

                html[data-nsq-theme="dark"] .notice span {
                    color: #dfcda8
                }

            html[data-nsq-theme="dark"] .selection-summary > div,
            html[data-nsq-theme="dark"] .selection-table th,
            html[data-nsq-theme="dark"] .final-note {
                background: #0d1828
            }

            html[data-nsq-theme="dark"] .selection-warning {
                background: #2b1718;
                border-color: #744247;
                color: #ffb4ad
            }

        @@media(max-width:900px) {
            .flow {
                grid-template-columns: repeat(2,minmax(0,1fr))
            }

            .flow-item:nth-child(2) {
                border-right: 0
            }

            .flow-item:nth-child(-n+2) {
                border-bottom: 1px solid var(--pt-border)
            }

            .selection-summary {
                grid-template-columns: repeat(2,minmax(0,1fr))
            }

            .actions {
                grid-template-columns: 1fr
            }

            .action-card {
                min-height: 0
            }
        }

        @@media(max-width:600px) {
            .legacy-page {
                padding: 12px 9px 28px
            }

            .legacy-head {
                align-items: stretch
            }

                .legacy-head .btn {
                    width: 100%;
                    justify-content: center
                }

            .flow {
                grid-template-columns: 1fr
            }

            .flow-item {
                min-height: 0;
                border-right: 0;
                border-bottom: 1px solid var(--pt-border)
            }

                .flow-item:last-child {
                    border-bottom: 0
                }

            .selection-summary {
                grid-template-columns: 1fr
            }
        }
    </style>
}

<div class="legacy-page">
    <section class="legacy-head">
        <div>
            <h1 class="legacy-title"><i class="fa-solid fa-triangle-exclamation me-2"></i>Flujo anterior de embarque</h1>
            <p class="legacy-subtitle">Esta pantalla se conserva únicamente para evitar que una ruta antigua termine creando un embarque por un proceso paralelo.</p>
        </div>
        <a asp-controller="LogisticaEmbarques" asp-action="Index" class="btn btn-outline-secondary btn-sm">
            <i class="fa-solid fa-arrow-left me-1"></i>
            Regresar a embarques
        </a>
    </section>

    @if (TempData["LogisticaError"] != null)
    {
        <div class="alert alert-danger py-2 px-3 mb-3">
            <i class="fa-solid fa-triangle-exclamation me-1"></i>@TempData["LogisticaError"]
        </div>
    }

    <div class="notice">
        <i class="fa-solid fa-circle-info"></i>
        <div>
            <strong>Ya no se confirma un embarque desde una selección previa de cajas PT.</strong>
            <span>El flujo vigente inicia desde una programación de carga. Centro Operativo toma las programaciones pendientes, crea el embarque y después continúa con preparación, documentación y carga física. Esta vista ya no envía información a CrearDesdePT ni reserva cajas.</span>
        </div>
    </div>

    <section class="card-shell">
        <div class="card-head">
            <h2>Flujo vigente</h2>
            <p>Un solo origen de datos para evitar embarques duplicados o cajas reservadas por rutas diferentes.</p>
        </div>
        <div class="flow">
            <div class="flow-item">
                <div class="flow-number">1</div>
                <strong>Programar carga</strong>
                <span>Lista de carga define el día correspondiente a los Releases pendientes.</span>
            </div>
            <div class="flow-item">
                <div class="flow-number">2</div>
                <strong>Iniciar embarque</strong>
                <span>Centro Operativo selecciona las programaciones pendientes del cliente y fecha.</span>
            </div>
            <div class="flow-item">
                <div class="flow-number">3</div>
                <strong>Operar</strong>
                <span>Preparación, documentos y carga física se realizan sobre el embarque ya creado.</span>
            </div>
            <div class="flow-item">
                <div class="flow-number">4</div>
                <strong>Salida y entrega</strong>
                <span>La salida física se confirma en el punto correspondiente y la Entrega interna se sincroniza con el viaje del chofer.</span>
            </div>
        </div>
    </section>

    @if (seleccionadas.Count > 0)
    {
        <section class="card-shell">
            <div class="card-head">
                <h2>Selección proveniente del flujo anterior</h2>
                <p>Se muestra únicamente como referencia. No será guardada ni convertida en embarque desde esta pantalla.</p>
            </div>
            <div class="legacy-selection">
                <div class="selection-summary">
                    <div><span>Cliente</span><strong>@(string.IsNullOrWhiteSpace(cliente) ? "-" : cliente)</strong></div>
                    <div><span>Cajas seleccionadas</span><strong>@seleccionadas.Count.ToString("N0")</strong></div>
                    <div><span>Piezas</span><strong>@totalPiezas.ToString("N0") PZA</strong></div>
                    <div><span>Partes</span><strong>@seleccionadas.Select(x => x.ParteID).Distinct().Count().ToString("N0")</strong></div>
                </div>

                <div class="selection-table-wrap">
                    <table class="selection-table">
                        <thead>
                            <tr>
                                <th>Caja</th>
                                <th>Parte</th>
                                <th>OF origen</th>
                                <th>Lote / etiqueta</th>
                                <th>Ubicación</th>
                                <th class="num">Piezas</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var caja in seleccionadas)
                            {
                                <tr>
                                    <td><strong>#@caja.NumeroCaja</strong><br /><small>ID @caja.CajaID</small></td>
                                    <td><strong>@caja.NumeroParte</strong><br /><small>@(string.IsNullOrWhiteSpace(caja.Descripcion) ? "-" : caja.Descripcion)</small></td>
                                    <td>@(string.IsNullOrWhiteSpace(caja.NumeroOF) ? "-" : caja.NumeroOF)</td>
                                    <td>@(string.IsNullOrWhiteSpace(caja.Lote) ? "-" : caja.Lote)<br /><small>@caja.Etiqueta</small></td>
                                    <td>@(string.IsNullOrWhiteSpace(caja.Ubicacion) ? "Sin ubicar" : caja.Ubicacion)</td>
                                    <td class="num">@caja.Disponible.ToString("N0")</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>

                <div class="selection-warning">
                    <i class="fa-solid fa-ban me-1"></i>
                    Esta selección no se enviará a <strong>CrearDesdePT</strong>. Regresa al flujo vigente para iniciar correctamente el embarque.
                </div>
            </div>
        </section>
    }

    <div class="actions">
        <section class="action-card">
            <div class="action-icon"><i class="fa-solid fa-table-columns"></i></div>
            <h3>Centro Operativo</h3>
            <p>Usa las programaciones ya existentes para iniciar el embarque y continuar todas sus etapas operativas.</p>
            <a asp-controller="LogisticaOperacion" asp-action="Index" class="btn btn-primary-flow">
                <i class="fa-solid fa-arrow-right"></i>
                Ir a Centro Operativo
            </a>
        </section>

        <section class="action-card">
            <div class="action-icon"><i class="fa-solid fa-calendar-plus"></i></div>
            <h3>Lista de carga</h3>
            <p>Si el Release todavía no tiene fecha de carga, programa primero el día correspondiente sin crear todavía el embarque.</p>
            <a asp-controller="LogisticaListaCarga" asp-action="Index" class="btn btn-outline-primary">
                <i class="fa-solid fa-calendar-days"></i>
                Ir a Lista de carga
            </a>
        </section>

        <section class="action-card">
            <div class="action-icon"><i class="fa-solid fa-list"></i></div>
            <h3>Embarques</h3>
            <p>Consulta programaciones listas para iniciar y los embarques que ya se encuentran en operación.</p>
            <a asp-controller="LogisticaEmbarques" asp-action="Index" class="btn btn-outline-primary">
                <i class="fa-solid fa-truck-fast"></i>
                Ver embarques
            </a>
        </section>
    </div>

    <div class="final-note">
        <strong>Carga física:</strong> el escaneo de cajas sigue existiendo, pero ocurre después de crear el embarque. Tanto Centro Operativo como el chofer autorizado pueden escanear sobre la misma carga, sin importar la hora. Esta pantalla solamente retira el camino antiguo que intentaba formar el embarque directamente desde cajas PT.
    </div>
</div>
