@using ERP.NSQuell.Models.ViewModels.Logistica
@model LogisticaCrearVm
@{
    Layout = "~/Views/Shared/_Layout.cshtml";
    ViewData["Title"] = "Confirmar embarque PT";
    var seleccionadas = (Model.CajasPT ?? new List<LogisticaCajaPtCrearVm>()).Where(x => x.Seleccionada).OrderBy(x => x.FechaEntrada).ThenBy(x => x.CajaID).ToList();
    var cliente = seleccionadas.FirstOrDefault()?.Cliente ?? Model.Clientes.FirstOrDefault(x => Model.ClienteID.HasValue && x.Id == Model.ClienteID.Value)?.Texto ?? string.Empty;
    var totalPiezas = seleccionadas.Sum(x => (long)x.Disponible);
    var fechaEntregaVisual = Model.FechaEntregaProgramada?.ToString("dd/MM/yyyy") ?? "-";
}
@section Styles {
    <link rel="stylesheet" href="~/css/logistica.css" asp-append-version="true" />
}
<style>
    :root {
        --lg-blue: #173a7a;
        --lg-text: #172033;
        --lg-muted: #6d7888;
        --lg-border: #dce4ee;
        --lg-soft: #f7f9fc;
        --lg-danger: #b42318;
        --lg-ok: #17633a;
        --lg-shadow: 0 8px 24px rgba(22,42,75,.055)
    }

    .page {
        max-width: 1500px;
        margin: 0 auto;
        padding: 18px 20px 32px;
        color: var(--lg-text)
    }

    .head {
        display: flex;
        justify-content: space-between;
        gap: 12px;
        align-items: center;
        padding: 15px 17px;
        margin-bottom: 14px;
        border: 1px solid var(--lg-border);
        border-left: 4px solid var(--lg-blue);
        border-radius: 12px;
        background: #fff;
        box-shadow: var(--lg-shadow)
    }

    .title {
        margin: 0;
        font-size: 1.4rem;
        font-weight: 800
    }

    .subtitle {
        margin: 3px 0 0;
        color: var(--lg-muted);
        font-size: .82rem
    }

    .step {
        font-size: .7rem;
        color: var(--lg-blue);
        font-weight: 800;
        text-transform: uppercase;
        letter-spacing: .05em
    }

    .card {
        margin-bottom: 12px;
        padding: 14px 15px;
        border: 1px solid var(--lg-border);
        border-radius: 12px;
        background: #fff;
        box-shadow: var(--lg-shadow)
    }

    .card-title {
        margin: 0 0 6px;
        padding-left: 10px;
        border-left: 3px solid var(--lg-blue);
        font-size: .96rem;
        font-weight: 800
    }

    .card-sub {
        margin: 0 0 11px;
        color: var(--lg-muted);
        font-size: .73rem
    }

    .summary {
        display: grid;
        grid-template-columns: repeat(4,minmax(130px,1fr));
        gap: 8px
    }

        .summary > div {
            padding: 10px;
            border: 1px solid var(--lg-border);
            border-radius: 9px;
            background: #f8fafc
        }

        .summary span {
            display: block;
            color: var(--lg-muted);
            font-size: .68rem
        }

        .summary strong {
            display: block;
            margin-top: 2px;
            color: var(--lg-blue);
            font-size: .92rem
        }

    .box-table {
        width: 100%;
        border-collapse: collapse;
        font-size: .76rem
    }

        .box-table th {
            padding: 7px 8px;
            border-bottom: 1px solid #d8e1eb;
            color: #66768b;
            font-size: .66rem;
            text-align: left;
            text-transform: uppercase
        }

        .box-table td {
            padding: 8px;
            border-bottom: 1px solid #e7ecf2;
            vertical-align: top
        }

        .box-table .num {
            text-align: right;
            font-weight: 800;
            color: var(--lg-blue)
        }

    .grid {
        display: grid;
        grid-template-columns: repeat(12,1fr);
        gap: 10px 12px
    }

    .g3 {
        grid-column: span 3
    }

    .g4 {
        grid-column: span 4
    }

    .g5 {
        grid-column: span 5
    }

    .g6 {
        grid-column: span 6
    }

    .g8 {
        grid-column: span 8
    }

    .g12 {
        grid-column: span 12
    }

    .form-label {
        font-size: .73rem;
        font-weight: 700;
        color: #4d596a;
        margin-bottom: 3px
    }

    .required:after {
        content: " *";
        color: #dc3545;
        font-weight: 800
    }

    .form-control, .form-select {
        min-height: 38px;
        border-color: #d3dde8;
        border-radius: 8px;
        font-size: .82rem
    }

    .readonly-box {
        min-height: 38px;
        display: flex;
        align-items: center;
        padding: 7px 10px;
        border: 1px solid #dce4ee;
        border-radius: 8px;
        background: #f6f8fb;
        color: #3f4f64;
        font-size: .82rem
    }

        .readonly-box small {
            margin-left: 6px;
            color: #7b8798
        }

    .transport-panel {
        margin-top: 9px;
        padding: 11px;
        border: 1px solid var(--lg-border);
        border-radius: 9px;
        background: #f8fafc
    }

    .hidden {
        display: none !important
    }

    .selected-strip {
        padding: 10px 12px;
        border: 1px solid #cfdced;
        border-radius: 9px;
        background: #f6f9fd;
        color: #43536a;
        font-size: .77rem
    }

        .selected-strip strong {
            color: var(--lg-blue)
        }

    .option-note {
        padding: 9px 10px;
        border: 1px dashed #ced8e5;
        border-radius: 8px;
        background: #fff;
        color: #627186;
        font-size: .72rem
    }

    .footer {
        display: flex;
        justify-content: space-between;
        gap: 10px;
        align-items: center;
        margin-top: 14px;
        padding: 13px 14px;
        border: 1px solid #d2ddea;
        border-radius: 11px;
        background: #fff;
        box-shadow: 0 8px 24px rgba(22,42,75,.07)
    }

    .footer-actions {
        display: flex;
        gap: 8px
    }

    .footer small {
        display: block;
        color: #6f7d90;
        max-width: 700px
    }

    .lg-btn {
        min-height: 42px !important;
        padding: 0 16px !important;
        border-radius: 9px !important;
        font-size: .78rem !important;
        font-weight: 800 !important;
        display: inline-flex !important;
        align-items: center !important;
        justify-content: center !important;
        gap: 6px !important;
        text-decoration: none !important
    }

    .lg-btn-primary {
        background: #0b4f8a !important;
        border: 1px solid #0b4f8a !important;
        color: #fff !important
    }

    .lg-btn-secondary {
        background: #fff !important;
        border: 1px solid #b8c9dc !important;
        color: var(--lg-blue) !important
    }

    html[data-nsq-theme="dark"] .page {
        color: #e7edf6
    }

    html[data-nsq-theme="dark"] .head, html[data-nsq-theme="dark"] .card, html[data-nsq-theme="dark"] .footer {
        background: #111b2d;
        border-color: #2a3a50;
        box-shadow: none
    }

    html[data-nsq-theme="dark"] .summary > div, html[data-nsq-theme="dark"] .transport-panel, html[data-nsq-theme="dark"] .readonly-box, html[data-nsq-theme="dark"] .selected-strip {
        background: #162237;
        border-color: #2a3a50
    }

    html[data-nsq-theme="dark"] .form-control, html[data-nsq-theme="dark"] .form-select {
        background: #0e1828;
        border-color: #31445c;
        color: #eef4fb
    }

    @@media(max-width:900px) {
        .g3, .g4, .g5, .g6, .g8 {
            grid-column: span 6
        }

        .summary {
            grid-template-columns: repeat(2,1fr)
        }

        .footer {
            align-items: stretch;
            flex-direction: column
        }

        .footer-actions {
            width: 100%
        }

            .footer-actions .btn {
                flex: 1
            }
    }

    @@media(max-width:600px) {
        .page {
            padding: 12px 8px 24px
        }

        .g3, .g4, .g5, .g6, .g8 {
            grid-column: span 12
        }

        .summary {
            grid-template-columns: 1fr
        }

        .box-table-wrap {
            overflow-x: auto
        }

        .box-table {
            min-width: 850px
        }
    }
</style>

<div class="page">
    <div class="head">
        <div>
            <div class="step">Paso 2 de 2</div>
            <h1 class="title"><i class="fa-solid fa-clipboard-check me-1"></i>Confirmar embarque desde PT</h1>
            <p class="subtitle">Revisa el Picking List y captura únicamente los datos operativos que sí utiliza Logística.</p>
        </div>
        <button type="button" class="btn lg-btn lg-btn-secondary" onclick="history.back()"><i class="fa-solid fa-arrow-left"></i>Volver a cajas</button>
    </div>

    <form asp-controller="LogisticaEmbarques" asp-action="CrearDesdePT" method="post" id="formConfirmarPT" autocomplete="off">
        @Html.AntiForgeryToken()
        <input asp-for="ClienteID" type="hidden" />
        <div asp-validation-summary="ModelOnly" class="alert alert-danger py-2 px-3"></div>

        @for (var i = 0; i < seleccionadas.Count; i++)
        {
            <input type="hidden" name="CajasPT[@i].Seleccionada" value="true" />
            <input type="hidden" name="CajasPT[@i].CajaID" value="@seleccionadas[i].CajaID" />
        }

        <section class="card">
            <h2 class="card-title">Picking List</h2>
            <p class="card-sub">Estos son los datos físicos seleccionados desde PT para formar el embarque.</p>
            <div class="summary mb-3">
                <div><span>Cliente</span><strong>@cliente</strong></div>
                <div><span>Cajas completas</span><strong>@seleccionadas.Count.ToString("N0")</strong></div>
                <div><span>Piezas totales</span><strong>@totalPiezas.ToString("N0") PZA</strong></div>
                <div><span>Partes</span><strong>@seleccionadas.Select(x => x.ParteID).Distinct().Count().ToString("N0")</strong></div>
            </div>
            <div class="box-table-wrap">
                <table class="box-table">
                    <thead><tr><th>Caja</th><th>Parte</th><th>OF origen</th><th>Lote / etiqueta</th><th>Entrada</th><th>Ubicación</th><th class="num">Piezas</th></tr></thead>
                    <tbody>
                        @foreach (var caja in seleccionadas)
                        {
                            <tr>
                                <td><strong>#@caja.NumeroCaja</strong><br /><small>ID @caja.CajaID</small></td>
                                <td><strong>@caja.NumeroParte</strong><br /><small>@caja.Descripcion</small></td>
                                <td>@(string.IsNullOrWhiteSpace(caja.NumeroOF) ? "-" : caja.NumeroOF)</td>
                                <td>@(string.IsNullOrWhiteSpace(caja.Lote) ? "-" : caja.Lote)<br /><small>@caja.Etiqueta</small></td>
                                <td>@caja.FechaEntrada.ToString("dd/MM/yyyy HH:mm")</td>
                                <td>@(string.IsNullOrWhiteSpace(caja.Ubicacion) ? "Sin ubicar" : caja.Ubicacion)</td>
                                <td class="num">@caja.Disponible.ToString("N0")</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
            <div class="selected-strip mt-3"><strong>Cajas completas:</strong> la cantidad no se captura manualmente. El servidor vuelve a leer el saldo vigente antes de guardar.</div>
        </section>

        <section class="card">
            <h2 class="card-title">Programación de carga</h2>
            <p class="card-sub">La fecha/hora de carga es la programación operativa de Logística. La fecha de entrega se conserva solo como referencia visual del Release.</p>
            <div class="grid">
                <div class="g3">
                    <label asp-for="TipoOperacion" class="form-label required">Operación</label>
                    <select asp-for="TipoOperacion" id="TipoOperacion" class="form-select" required>
                        <option value="Nacional">Nacional</option>
                        <option value="Exportacion">Exportación</option>
                    </select>
                </div>
                <div class="g3">
                    <label asp-for="FechaCargaProgramada" class="form-label required">Fecha de carga</label>
                    <input asp-for="FechaCargaProgramada" type="date" class="form-control" required />
                    <span asp-validation-for="FechaCargaProgramada" class="text-danger small"></span>
                </div>
                <div class="g3">
                    <label asp-for="HoraCargaProgramada" class="form-label required">Hora de carga</label>
                    <input asp-for="HoraCargaProgramada" type="time" class="form-control" required />
                    <span asp-validation-for="HoraCargaProgramada" class="text-danger small"></span>
                </div>
                <div class="g3">
                    <label class="form-label">Fecha de entrega</label>
                    <div class="readonly-box">@fechaEntregaVisual <small>Solo visual</small></div>
                </div>
                <div class="g4">
                    <label asp-for="Destino" class="form-label required">Destino</label>
                    <input asp-for="Destino" maxlength="300" class="form-control" required />
                    <span asp-validation-for="Destino" class="text-danger small"></span>
                </div>
                <div class="g8">
                    <label asp-for="DireccionEntrega" class="form-label">Dirección de entrega</label>
                    <input asp-for="DireccionEntrega" maxlength="600" class="form-control" />
                </div>
                <div class="g3 hidden" id="aduanaWrap">
                    <label asp-for="PasaAduana" class="form-label required">¿Pasa por aduana?</label>
                    <select asp-for="PasaAduana" class="form-select">
                        <option value="">Selecciona...</option>
                        <option value="true">Sí</option>
                        <option value="false">No</option>
                    </select>
                </div>
            </div>
        </section>

        <section class="card">
            <h2 class="card-title">Quién recoge / salida del embarque</h2>
            <p class="card-sub">Selecciona el escenario real de recolección. Los campos obligatorios cambian según la opción.</p>
            <div class="grid">
                <div class="g4">
                    <label asp-for="FormaEnvio" class="form-label required">Tipo de recolección</label>
                    <select asp-for="FormaEnvio" id="FormaEnvio" class="form-select" required>
                        <option value="Interno">Interno</option>
                        <option value="Cliente">Cliente recoge</option>
                        <option value="Paqueteria">Paquetería</option>
                    </select>
                </div>
            </div>

            <div class="transport-panel" id="internoPanel">
                <div class="grid">
                    <div class="g4">
                        <label asp-for="RutaID" class="form-label required">Ruta</label>
                        <select asp-for="RutaID" class="form-select js-interno">
                            <option value="">Selecciona...</option>
                            @foreach (var r in Model.Rutas)
                            {
                                <option value="@r.Id">@r.Texto</option>
                            }
                        </select>
                        <span asp-validation-for="RutaID" class="text-danger small"></span>
                    </div>
                    <div class="g4">
                        <label asp-for="UnidadID" class="form-label required">Unidad</label>
                        <select asp-for="UnidadID" class="form-select js-interno">
                            <option value="">Selecciona...</option>
                            @foreach (var u in Model.Unidades)
                            {
                                <option value="@u.Id">@u.Texto</option>
                            }
                        </select>
                        <span asp-validation-for="UnidadID" class="text-danger small"></span>
                    </div>
                    <div class="g4">
                        <label asp-for="ChoferUsuarioID" class="form-label required">Chofer</label>
                        <select asp-for="ChoferUsuarioID" class="form-select js-interno">
                            <option value="">Selecciona...</option>
                            @foreach (var c in Model.Choferes)
                            {
                                <option value="@c.Id">@c.Texto</option>
                            }
                        </select>
                        <span asp-validation-for="ChoferUsuarioID" class="text-danger small"></span>
                    </div>
                </div>
                <div class="option-note mt-2">Para salida interna deben quedar definidos ruta, unidad y chofer.</div>
            </div>

            <div class="transport-panel hidden" id="clientePanel">
                <div class="grid">
                    <div class="g5">
                        <label asp-for="ChoferExterno" class="form-label required">Persona / transportista que recoge</label>
                        <input asp-for="ChoferExterno" maxlength="200" class="form-control js-cliente" />
                        <span asp-validation-for="ChoferExterno" class="text-danger small"></span>
                    </div>
                    <div class="g4">
                        <label asp-for="UnidadExterna" class="form-label">Unidad / vehículo</label>
                        <input asp-for="UnidadExterna" maxlength="100" class="form-control" />
                    </div>
                    <div class="g3">
                        <label asp-for="PlacasExternas" class="form-label">Placas</label>
                        <input asp-for="PlacasExternas" maxlength="100" class="form-control" />
                    </div>
                </div>
                <div class="option-note mt-2">Cuando el cliente recolecta, la persona o transportista que recibe la mercancía debe quedar identificado.</div>
            </div>

            <div class="transport-panel hidden" id="paqueteriaPanel">
                <div class="grid">
                    <div class="g3">
                        <label asp-for="ModalidadEnvio" class="form-label required">Modalidad</label>
                        <select asp-for="ModalidadEnvio" class="form-select js-paq">
                            <option value="">Selecciona...</option>
                            <option value="Terrestre">Terrestre</option>
                            <option value="Aereo">Aérea</option>
                            <option value="Maritimo">Marítima</option>
                        </select>
                    </div>
                    <div class="g4">
                        <label asp-for="Transportista" class="form-label required">Compañía / paquetería</label>
                        <input asp-for="Transportista" maxlength="200" class="form-control js-paq" />
                    </div>
                    <div class="g5">
                        <label asp-for="GuiaReferencia" class="form-label">Guía / referencia</label>
                        <input asp-for="GuiaReferencia" maxlength="150" class="form-control" />
                    </div>
                    <div class="g4">
                        <label asp-for="ChoferExterno" class="form-label">Chofer externo</label>
                        <input asp-for="ChoferExterno" maxlength="200" class="form-control" />
                    </div>
                    <div class="g4">
                        <label asp-for="UnidadExterna" class="form-label">Unidad externa</label>
                        <input asp-for="UnidadExterna" maxlength="100" class="form-control" />
                    </div>
                    <div class="g4">
                        <label asp-for="PlacasExternas" class="form-label">Placas</label>
                        <input asp-for="PlacasExternas" maxlength="100" class="form-control" />
                    </div>
                </div>
                <div class="option-note mt-2">La documentación obligatoria se validará después según la operación: factura o remisión por excepción, guía y documentos adicionales correspondientes.</div>
            </div>
        </section>

        <section class="card">
            <h2 class="card-title">Información adicional</h2>
            <label asp-for="Observaciones" class="form-label">Observaciones</label>
            <textarea asp-for="Observaciones" maxlength="1200" rows="3" class="form-control"></textarea>
        </section>

        <div class="footer">
            <small><strong>Guardar programación</strong> reserva las cajas para Logística. La salida física de PT se confirma posteriormente desde el detalle del embarque, cuando realmente salga de planta.</small>
            <div class="footer-actions">
                <button type="button" class="btn lg-btn lg-btn-secondary" onclick="history.back()"><i class="fa-solid fa-arrow-left"></i>Volver</button>
                <button type="submit" name="confirmarSalidaPT" value="false" class="btn lg-btn lg-btn-primary"><i class="fa-solid fa-calendar-check"></i>Guardar programación</button>
            </div>
        </div>
    </form>
</div>

@section Scripts {
    <script>
        (()=>{
            const forma=document.getElementById('FormaEnvio');
            const tipo=document.getElementById('TipoOperacion');
            const interno=document.getElementById('internoPanel');
            const cliente=document.getElementById('clientePanel');
            const paq=document.getElementById('paqueteriaPanel');
            const aduana=document.getElementById('aduanaWrap');

            const actualizarForma=()=>{
                const valor=forma?.value||'Interno';
                const esInterno=valor==='Interno';
                const esCliente=valor==='Cliente';
                const esPaq=valor==='Paqueteria';
                interno?.classList.toggle('hidden',!esInterno);
                cliente?.classList.toggle('hidden',!esCliente);
                paq?.classList.toggle('hidden',!esPaq);
                document.querySelectorAll('.js-interno').forEach(x=>x.required=esInterno);
                document.querySelectorAll('.js-cliente').forEach(x=>x.required=esCliente);
                document.querySelectorAll('.js-paq').forEach(x=>x.required=esPaq);
            };

            const actualizarOperacion=()=>{
                const esExport=tipo?.value==='Exportacion';
                aduana?.classList.toggle('hidden',!esExport);
                const control=aduana?.querySelector('select');
                if(control) control.required=esExport;
            };

            forma?.addEventListener('change',actualizarForma);
            tipo?.addEventListener('change',actualizarOperacion);
            actualizarForma();
            actualizarOperacion();
        })();
    </script>
}
