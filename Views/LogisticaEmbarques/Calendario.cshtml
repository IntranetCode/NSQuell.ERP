@{
    Layout = "~/Views/Shared/_Layout.cshtml";
    ViewData["Title"] = "Calendario de cargas";
}
@section Styles {
    <link rel="stylesheet" href="~/css/logistica.css" asp-append-version="true" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/fullcalendar@6.1.15/index.global.min.css" />
}
<style>
    :root {
        --lg-blue: #173a7a;
        --lg-blue2: #2f63ad;
        --lg-text: #172033;
        --lg-muted: #6d7888;
        --lg-border: #dce4ee;
        --lg-shadow: 0 8px 24px rgba(22,42,75,.055)
    }

    .page {
        max-width: 1720px;
        margin: 0 auto;
        padding: 18px 20px 30px;
        color: var(--lg-text)
    }

    .head {
        display: flex;
        justify-content: space-between;
        align-items: center;
        gap: 12px;
        flex-wrap: wrap;
        padding: 15px 17px;
        margin-bottom: 12px;
        border: 1px solid var(--lg-border);
        border-left: 4px solid var(--lg-blue);
        border-radius: 12px;
        background: #fff;
        box-shadow: var(--lg-shadow)
    }

    .title {
        margin: 0;
        color: var(--lg-text);
        font-size: 1.46rem;
        font-weight: 800;
        letter-spacing: -.02em
    }

        .title i {
            color: var(--lg-blue)
        }

    .sub {
        margin: 3px 0 0;
        color: var(--lg-muted);
        font-size: .84rem;
        font-weight: 500
    }

    .head .btn {
        min-height: 34px;
        display: inline-flex;
        align-items: center;
        border-radius: 8px;
        font-weight: 600
    }

    .toolbar {
        display: grid;
        grid-template-columns: minmax(220px,1fr) minmax(260px,1.3fr) 180px auto;
        gap: 8px;
        align-items: end;
        padding: 11px 12px;
        margin-bottom: 10px;
        border: 1px solid var(--lg-border);
        border-radius: 10px;
        background: #fff;
        box-shadow: 0 4px 14px rgba(22,42,75,.035)
    }

        .toolbar label {
            display: block;
            margin-bottom: 3px;
            color: #566273;
            font-size: .69rem;
            font-weight: 750
        }

        .toolbar .form-control, .toolbar .form-select {
            min-height: 36px;
            border-color: #d4dee9;
            border-radius: 8px;
            font-size: .8rem
        }

    .toolbar-actions {
        display: flex;
        gap: 6px;
        align-items: center
    }

        .toolbar-actions .btn {
            min-height: 36px;
            white-space: nowrap
        }

    .summary {
        display: grid;
        grid-template-columns: repeat(5,minmax(120px,1fr));
        gap: 8px;
        margin-bottom: 10px
    }

        .summary > div {
            min-height: 68px;
            padding: 10px 12px;
            border: 1px solid var(--lg-border);
            border-radius: 10px;
            background: #fff;
            box-shadow: 0 4px 13px rgba(22,42,75,.03)
        }

        .summary strong {
            display: block;
            margin-bottom: 3px;
            color: var(--lg-blue);
            font-size: 1.2rem;
            font-weight: 800
        }

        .summary span {
            color: var(--lg-muted);
            font-size: .7rem;
            font-weight: 700
        }

    .calendar-help {
        display: flex;
        align-items: center;
        gap: 8px;
        margin: 0 0 8px;
        color: #687487;
        font-size: .74rem
    }

        .calendar-help i {
            color: var(--lg-blue2)
        }

    #calendar {
        padding: 13px;
        border: 1px solid var(--lg-border);
        border-radius: 12px;
        background: #fff;
        box-shadow: var(--lg-shadow)
    }

    .fc {
        color: #2b3748;
        font-size: .8rem
    }

        .fc .fc-toolbar {
            gap: 8px;
            flex-wrap: wrap
        }

        .fc .fc-toolbar-title {
            color: #1e2b3d;
            font-size: 1.08rem;
            font-weight: 800
        }

        .fc .fc-button {
            font-size: .74rem;
            padding: .35rem .55rem
        }

        .fc .fc-button-primary {
            border-color: #d1dbe6;
            background: #fff;
            color: #334155;
            box-shadow: none
        }

            .fc .fc-button-primary:hover, .fc .fc-button-primary:not(:disabled).fc-button-active {
                border-color: var(--lg-blue);
                background: var(--lg-blue);
                color: #fff
            }

        .fc .fc-scrollgrid, .fc-theme-standard td, .fc-theme-standard th {
            border-color: #e6ebf1
        }

        .fc .fc-col-header-cell {
            background: #f7f9fb
        }

        .fc .fc-col-header-cell-cushion, .fc .fc-daygrid-day-number {
            color: #536072;
            font-weight: 700;
            text-decoration: none
        }

        .fc .fc-day-today {
            background: #f1f6fd !important
        }

        .fc .fc-daygrid-event {
            overflow: hidden;
            border: 0;
            border-radius: 6px;
            padding: 3px 5px;
            cursor: pointer;
            box-shadow: 0 2px 4px rgba(0,0,0,.08)
        }

    .evento-cliente {
        min-width: 0;
        line-height: 1.15
    }

    .evento-cliente-nombre {
        overflow: hidden;
        color: #fff;
        font-size: .73rem;
        font-weight: 750;
        text-overflow: ellipsis;
        white-space: nowrap
    }

    .evento-cliente-meta {
        overflow: hidden;
        margin-top: 2px;
        color: rgba(255,255,255,.92);
        font-size: .64rem;
        text-overflow: ellipsis;
        white-space: nowrap
    }

    #eventoModal .modal-dialog {
        max-width: 1180px
    }

    #eventoModal .modal-content {
        border: 1px solid var(--lg-border);
        border-radius: 12px;
        box-shadow: 0 18px 46px rgba(17,31,52,.16)
    }

    #eventoModal .modal-header {
        padding: 12px 16px;
        border-bottom-color: #e5ebf1;
        background: #f7f9fb
    }

    .modal-title-wrap h5 {
        margin: 0;
        color: #1c2b40;
        font-size: 1rem;
        font-weight: 800
    }

    .modal-title-wrap p {
        margin: 2px 0 0;
        color: #748093;
        font-size: .72rem
    }

    .modal-summary {
        display: grid;
        grid-template-columns: repeat(5,minmax(100px,1fr));
        gap: 7px;
        margin-bottom: 12px
    }

    .modal-summary-item {
        padding: 8px 9px;
        border: 1px solid #e2e8ef;
        border-radius: 8px;
        background: #fafbfd
    }

        .modal-summary-item label {
            display: block;
            margin-bottom: 2px;
            color: #7a8595;
            font-size: .62rem;
            font-weight: 750;
            text-transform: uppercase
        }

        .modal-summary-item strong {
            display: block;
            color: #263448;
            font-size: .82rem;
            font-weight: 750
        }

    .of-panel {
        border: 1px solid #dfe6ee;
        border-radius: 9px;
        overflow: hidden
    }

    .of-panel-head {
        display: flex;
        justify-content: space-between;
        align-items: center;
        gap: 10px;
        padding: 9px 11px;
        border-bottom: 1px solid #e4e9ef;
        background: #f7f9fb
    }

        .of-panel-head strong {
            font-size: .78rem
        }

        .of-panel-head span {
            color: #7a8595;
            font-size: .68rem
        }

    .of-table-wrap {
        overflow-x: auto
    }

    .of-table {
        width: 100%;
        margin: 0;
        border-collapse: collapse;
        font-size: .74rem
    }

        .of-table th {
            padding: 7px 8px;
            border-bottom: 1px solid #dfe6ee;
            background: #fbfcfd;
            color: #687487;
            font-size: .62rem;
            font-weight: 800;
            text-transform: uppercase;
            white-space: nowrap
        }

        .of-table td {
            padding: 8px;
            border-bottom: 1px solid #edf1f5;
            color: #344255;
            vertical-align: middle
        }

    .of-code {
        color: #193b76;
        font-weight: 800;
        white-space: nowrap
    }

    .of-part {
        font-weight: 700;
        white-space: nowrap
    }

    .of-description {
        min-width: 180px;
        max-width: 280px;
        color: #687487
    }

    .of-number {
        text-align: right;
        white-space: nowrap
    }

    .embarque-cell strong {
        display: block;
        font-size: .72rem
    }

    .embarque-cell small {
        display: block;
        color: #8791a0;
        font-size: .63rem
    }

    .badge-status {
        display: inline-flex;
        align-items: center;
        min-height: 21px;
        padding: 2px 7px;
        border-radius: 20px;
        font-size: .61rem;
        font-weight: 750;
        white-space: nowrap
    }

    .st-programado {
        border: 1px solid #cbd7e7;
        background: #f4f7fb;
        color: #34517c
    }

    .st-preparando {
        border: 1px solid #ecdca9;
        background: #fff8df;
        color: #846514
    }

    .st-preparado {
        border: 1px solid #bcd6e2;
        background: #eef8fb;
        color: #2c687e
    }

    .st-cargado {
        border: 1px solid #b9d0ef;
        background: #edf5ff;
        color: #235e9d
    }

    .st-ruta {
        border: 1px solid #aebfe9;
        background: #eef2ff;
        color: #304e9f
    }

    .st-entregado {
        border: 1px solid #acd9bb;
        background: #effaf2;
        color: #26713d
    }

    .st-cancelado {
        border: 1px solid #ced3d9;
        background: #f3f4f5;
        color: #666f79
    }

    .st-mixto {
        border: 1px solid #d7c9aa;
        background: #faf6eb;
        color: #725f31
    }

    .btn-ver {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        width: 29px;
        height: 28px;
        border: 1px solid #cbd6e3;
        border-radius: 6px;
        background: #fff;
        color: #355a8c;
        text-decoration: none
    }

    .empty-of {
        padding: 24px 15px;
        color: #7b8796;
        text-align: center;
        font-size: .78rem
    }

    .loading-calendar {
        opacity: .65;
        pointer-events: none
    }

    html[data-nsq-theme="dark"] .page {
        color: #e7edf6
    }

    html[data-nsq-theme="dark"] .head, html[data-nsq-theme="dark"] .toolbar, html[data-nsq-theme="dark"] .summary > div, html[data-nsq-theme="dark"] #calendar, html[data-nsq-theme="dark"] #eventoModal .modal-content {
        background: #111b2d;
        border-color: #2a3a50;
        box-shadow: none
    }

    html[data-nsq-theme="dark"] .title, html[data-nsq-theme="dark"] .fc .fc-toolbar-title, html[data-nsq-theme="dark"] .modal-title-wrap h5 {
        color: #eef4fb
    }

    html[data-nsq-theme="dark"] .fc .fc-col-header-cell, html[data-nsq-theme="dark"] #eventoModal .modal-header, html[data-nsq-theme="dark"] .of-panel-head, html[data-nsq-theme="dark"] .of-table th, html[data-nsq-theme="dark"] .modal-summary-item {
        background: #162237;
        border-color: #2a3a50
    }

    @@media(max-width:1100px) {
        .summary {
            grid-template-columns: repeat(3,minmax(0,1fr))
        }

        .modal-summary {
            grid-template-columns: repeat(3,minmax(0,1fr))
        }
    }

    @@media(max-width:800px) {
        .toolbar {
            grid-template-columns: 1fr
        }

        .toolbar-actions {
            width: 100%
        }

            .toolbar-actions .btn {
                flex: 1
            }

        .page {
            padding: 14px 10px 24px
        }

        .summary, .modal-summary {
            grid-template-columns: repeat(2,minmax(0,1fr))
        }
    }
</style>

<div class="page">
    <div class="head">
        <div>
            <h1 class="title"><i class="fa-solid fa-calendar-days me-1"></i>Calendario de cargas</h1>
            <p class="sub">Programación operativa por fecha y hora de carga. La fecha de entrega del Release es únicamente informativa y no define el calendario.</p>
        </div>
        <a asp-controller="LogisticaEmbarques" asp-action="Index" class="btn btn-outline-secondary btn-sm"><i class="fa-solid fa-arrow-left me-1"></i>Embarques</a>
    </div>

    <div class="toolbar">
        <div><label>Cliente</label><select id="cliente" class="form-select"><option value="">Todos los clientes</option></select></div>
        <div><label>Buscar</label><input id="q" class="form-control" autocomplete="off" placeholder="Cliente, OF, parte, Release, folio o destino" /></div>
        <div><label>Estatus</label><select id="estatus" class="form-select"><option value="">Todos</option><option>Programado</option><option>Preparando</option><option>Preparado</option><option>Cargado</option><option>En ruta</option><option>Entregado</option><option>Cancelado</option></select></div>
        <div class="toolbar-actions"><button id="btnAplicar" class="btn btn-primary btn-sm" type="button"><i class="fa-solid fa-filter me-1"></i>Aplicar</button><button id="btnLimpiar" class="btn btn-outline-secondary btn-sm" type="button"><i class="fa-solid fa-rotate-left me-1"></i>Limpiar</button></div>
    </div>

    <div class="summary">
        <div><strong id="totalClientes">0</strong><span>clientes / fecha de carga</span></div>
        <div><strong id="totalOfs">0</strong><span>OF programadas</span></div>
        <div><strong id="totalEmbarques">0</strong><span>embarques</span></div>
        <div><strong id="totalPiezas">0</strong><span>piezas programadas</span></div>
        <div><strong id="totalExpeditados">0</strong><span>cargas expeditadas</span></div>
    </div>

    <div class="calendar-help"><i class="fa-solid fa-circle-info"></i><span>Cada evento corresponde a una <strong>fecha de carga</strong>. Haz clic sobre el cliente para consultar las OF y embarques que deben quedar cargados ese día.</span></div>
    <div id="calendar"></div>
</div>

<div class="modal fade" id="eventoModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-xl modal-dialog-centered modal-dialog-scrollable">
        <div class="modal-content">
            <div class="modal-header">
                <div class="modal-title-wrap"><h5 id="mTitulo">Carga</h5><p id="mSubtitulo">Detalle de carga programada</p></div>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Cerrar"></button>
            </div>
            <div class="modal-body">
                <div class="modal-summary">
                    <div class="modal-summary-item"><label>Cliente</label><strong id="mCliente">-</strong></div>
                    <div class="modal-summary-item"><label>Fecha carga</label><strong id="mFecha">-</strong></div>
                    <div class="modal-summary-item"><label>OF</label><strong id="mOfs">0</strong></div>
                    <div class="modal-summary-item"><label>Embarques</label><strong id="mEmbarques">0</strong></div>
                    <div class="modal-summary-item"><label>Piezas</label><strong id="mPiezas">0</strong></div>
                </div>
                <div id="mAlerta" class="alert alert-danger py-2 px-3 d-none"></div>
                <div class="of-panel">
                    <div class="of-panel-head"><strong><i class="fa-solid fa-list-check me-1"></i>OF programadas para esta carga</strong><span id="mEstadoGeneral">-</span></div>
                    <div class="of-table-wrap">
                        <table class="of-table">
                            <thead><tr><th>Hora carga</th><th>OF</th><th>Parte</th><th>Descripción</th><th class="text-end">Cantidad</th><th>Embarque</th><th>Destino</th><th>Estatus</th><th class="text-center"></th></tr></thead>
                            <tbody id="mEntregas"></tbody>
                        </table>
                    </div>
                    <div id="mSinEntregas" class="empty-of d-none">No se encontraron partidas programadas para esta carga.</div>
                </div>
            </div>
            <div class="modal-footer py-2">
                <div class="me-auto small text-muted" id="mFooterResumen"></div>
                <button type="button" class="btn btn-outline-secondary btn-sm" data-bs-dismiss="modal">Cerrar</button>
                <a id="mAbrirUnico" class="btn btn-primary btn-sm d-none" href="#"><i class="fa-solid fa-arrow-up-right-from-square me-1"></i>Abrir embarque</a>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/fullcalendar@6.1.15/index.global.min.js"></script>
    <script>
        (()=>{
            const q=document.getElementById('q'),estatus=document.getElementById('estatus'),cliente=document.getElementById('cliente'),calendarEl=document.getElementById('calendar');
            let raw=[];
            const numero=v=>Number(v||0).toLocaleString('es-MX');
            const fechaMostrar=v=>{if(!v)return '-';const p=String(v).split('-');return p.length===3?`${p[2]}/${p[1]}/${p[0]}`:v;};
            const fechaIsoLocal=f=>`${f.getFullYear()}-${String(f.getMonth()+1).padStart(2,'0')}-${String(f.getDate()).padStart(2,'0')}`;
            const claveCliente=x=>Number(x.clienteId||0)>0?`id:${Number(x.clienteId)}`:`nombre:${String(x.cliente||'').trim().toUpperCase()}`;
            const color=x=>x.expeditado?'#c83e4d':x.estatus==='Entregado'?'#2f7d4a':x.estatus==='En ruta'?'#2f63ad':x.estatus==='Cargado'?'#3878a8':x.estatus==='Cancelado'?'#727b86':x.estatus==='Mixto'?'#92752e':'#173a7a';
            const claseEstado=v=>v==='Programado'?'st-programado':v==='Preparando'?'st-preparando':v==='Preparado'?'st-preparado':v==='Cargado'?'st-cargado':v==='En ruta'?'st-ruta':v==='Entregado'?'st-entregado':v==='Cancelado'?'st-cancelado':'st-mixto';
            const crearCelda=(tr,texto,clase)=>{const td=document.createElement('td');if(clase)td.className=clase;td.textContent=texto??'-';tr.appendChild(td);return td;};

            const cal=new FullCalendar.Calendar(calendarEl,{
                locale:'es',initialView:'dayGridMonth',firstDay:1,height:'auto',displayEventTime:false,dayMaxEvents:4,
                headerToolbar:{left:'prev,next today',center:'title',right:'dayGridMonth,timeGridWeek,listWeek'},
                buttonText:{today:'Hoy',month:'Mes',week:'Semana',list:'Lista'},
                datesSet:()=>cargar(),
                eventClick:info=>{info.jsEvent.preventDefault();mostrar(info.event.extendedProps);},
                eventContent:info=>{
                    const p=info.event.extendedProps,contenedor=document.createElement('div'),nombre=document.createElement('div'),meta=document.createElement('div');
                    contenedor.className='evento-cliente';nombre.className='evento-cliente-nombre';meta.className='evento-cliente-meta';
                    nombre.textContent=`${p.hora?p.hora+' · ':''}${p.cliente||'Sin cliente'}`;
                    meta.textContent=`${numero(p.totalOfs)} OF · ${numero(p.totalEmbarques)} emb. · ${numero(p.totalPiezas)} pz`;
                    contenedor.append(nombre,meta);return{domNodes:[contenedor]};
                },
                eventDidMount:info=>{const p=info.event.extendedProps;info.el.title=`${p.cliente||'Sin cliente'}\nCarga ${fechaMostrar(p.fecha)} ${p.hora||''}\n${numero(p.totalOfs)} OF\n${numero(p.totalEmbarques)} embarque(s)\n${numero(p.totalPiezas)} pieza(s)\n${p.expeditado?'EXPEDITADO':p.estatus||''}`;}
            });

            async function cargar(){
                const ini=cal.view.activeStart,fin=new Date(cal.view.activeEnd);fin.setDate(fin.getDate()-1);
                const qs=new URLSearchParams({desde:fechaIsoLocal(ini),hasta:fechaIsoLocal(fin)});
                if(q.value.trim())qs.set('q',q.value.trim());
                if(estatus.value)qs.set('estatus',estatus.value);
                calendarEl.classList.add('loading-calendar');
                try{
                    const response=await fetch('@Url.Action("EventosCalendario", "LogisticaEmbarques")?'+qs.toString(),{headers:{'X-Requested-With':'XMLHttpRequest'}});
                    const data=await response.json();
                    if(!response.ok||!data.ok)throw new Error(data.mensaje||'No fue posible cargar el calendario.');
                    raw=Array.isArray(data.eventos)?data.eventos:[];
                    cargarClientes();pintar();
                }catch(error){
                    raw=[];cal.removeAllEvents();cargarClientes();actualizarResumen([]);alert(error.message||'No fue posible cargar el calendario.');
                }finally{calendarEl.classList.remove('loading-calendar');}
            }

            function cargarClientes(){
                const actual=cliente.value,mapa=new Map();
                raw.forEach(x=>mapa.set(claveCliente(x),String(x.cliente||'Sin cliente').trim()||'Sin cliente'));
                const items=[...mapa.entries()].sort((a,b)=>a[1].localeCompare(b[1],'es',{sensitivity:'base'}));
                cliente.replaceChildren(new Option('Todos los clientes',''));
                items.forEach(([v,t])=>cliente.appendChild(new Option(t,v)));
                if(actual&&items.some(x=>x[0]===actual))cliente.value=actual;
            }

            function pintar(){
                const filtro=cliente.value,visibles=raw.filter(x=>!filtro||claveCliente(x)===filtro);
                cal.removeAllEvents();
                cal.addEventSource(visibles.map(x=>({id:x.id,title:x.cliente||'Sin cliente',start:x.fecha,allDay:true,backgroundColor:color(x),borderColor:color(x),textColor:'#fff',extendedProps:x})));
                actualizarResumen(visibles);
            }

            function actualizarResumen(visibles){
                document.getElementById('totalClientes').textContent=numero(visibles.length);
                document.getElementById('totalOfs').textContent=numero(visibles.reduce((s,x)=>s+Number(x.totalOfs||0),0));
                document.getElementById('totalEmbarques').textContent=numero(visibles.reduce((s,x)=>s+Number(x.totalEmbarques||0),0));
                document.getElementById('totalPiezas').textContent=numero(visibles.reduce((s,x)=>s+Number(x.totalPiezas||0),0));
                document.getElementById('totalExpeditados').textContent=numero(visibles.filter(x=>x.expeditado).length);
            }

            function mostrar(p){
                document.getElementById('mTitulo').textContent=p.cliente||'Carga';
                document.getElementById('mSubtitulo').textContent=`Carga programada · ${fechaMostrar(p.fecha)}${p.hora?' · '+p.hora:''}`;
                document.getElementById('mCliente').textContent=p.cliente||'-';
                document.getElementById('mFecha').textContent=`${fechaMostrar(p.fecha)}${p.hora?' · '+p.hora:''}`;
                document.getElementById('mOfs').textContent=numero(p.totalOfs);
                document.getElementById('mEmbarques').textContent=numero(p.totalEmbarques);
                document.getElementById('mPiezas').textContent=numero(p.totalPiezas);
                document.getElementById('mEstadoGeneral').textContent=p.expeditado?`EXPEDITADO · ${p.estatus||''}`:p.estatus||'-';
                const alerta=document.getElementById('mAlerta'),mensajes=[];
                if(p.expeditado)mensajes.push('La fecha programada de carga ya fue superada y el embarque sigue pendiente.');
                if(p.incidencia)mensajes.push('Uno o más embarques tienen una incidencia activa.');
                alerta.classList.toggle('d-none',mensajes.length===0);alerta.textContent=mensajes.join(' ');
                const tbody=document.getElementById('mEntregas'),sin=document.getElementById('mSinEntregas');tbody.replaceChildren();
                const entregas=Array.isArray(p.entregas)?p.entregas:[];
                sin.classList.toggle('d-none',entregas.length>0);
                entregas.forEach(item=>{
                    const tr=document.createElement('tr');
                    crearCelda(tr,item.hora||'-');
                    const tdOf=crearCelda(tr,item.numeroOF||'-','of-code');if(item.folioRelease)tdOf.title=`Release: ${item.folioRelease}`;
                    crearCelda(tr,item.numeroParte||'-','of-part');crearCelda(tr,item.descripcion||'-','of-description');crearCelda(tr,numero(item.cantidad),'of-number');
                    const tdEmb=document.createElement('td');tdEmb.className='embarque-cell';const strong=document.createElement('strong');strong.textContent=item.folio||`Embarque ${item.embarqueId||''}`;tdEmb.appendChild(strong);if(item.folioRelease){const small=document.createElement('small');small.textContent=item.folioRelease;tdEmb.appendChild(small);}tr.appendChild(tdEmb);
                    crearCelda(tr,item.destino||'-');
                    const tdEstado=document.createElement('td'),badge=document.createElement('span');badge.className=`badge-status ${claseEstado(item.estatus)}`;badge.textContent=item.estatus||'-';tdEstado.appendChild(badge);tr.appendChild(tdEstado);
                    const tdAccion=document.createElement('td');tdAccion.className='text-center';if(item.url){const a=document.createElement('a');a.href=item.url;a.className='btn-ver';a.title='Abrir embarque';a.innerHTML='<i class="fa-solid fa-arrow-up-right-from-square"></i>';tdAccion.appendChild(a);}tr.appendChild(tdAccion);tbody.appendChild(tr);
                });
                document.getElementById('mFooterResumen').textContent=`${numero(p.totalOfs)} OF · ${numero(p.totalEmbarques)} embarque(s) · ${numero(p.totalPiezas)} pieza(s)`;
                const unico=document.getElementById('mAbrirUnico');
                if(Number(p.totalEmbarques||0)===1&&p.url){unico.href=p.url;unico.classList.remove('d-none');}else{unico.href='#';unico.classList.add('d-none');}
                bootstrap.Modal.getOrCreateInstance(document.getElementById('eventoModal')).show();
            }

            document.getElementById('btnAplicar').addEventListener('click',cargar);
            document.getElementById('btnLimpiar').addEventListener('click',()=>{q.value='';estatus.value='';cliente.value='';cargar();});
            cliente.addEventListener('change',pintar);
            q.addEventListener('keydown',e=>{if(e.key==='Enter'){e.preventDefault();cargar();}});
            cal.render();
        })();
    </script>
}
