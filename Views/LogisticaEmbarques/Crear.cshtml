@using ERP.NSQuell.Models.ViewModels.Logistica
@model LogisticaCrearVm
@{
    Layout = "~/Views/Shared/_Layout.cshtml";
    ViewData["Title"] = "Nuevo embarque";
    var clienteNombre = Model.Clientes.FirstOrDefault(x => Model.ClienteID.HasValue && x.Id == Model.ClienteID.Value)?.Texto ?? string.Empty;
}
@section Styles {
    <link rel="stylesheet" href="~/css/logistica.css" asp-append-version="true" />
}
<style>
    :root {
        --lg-blue: #173a7a;
        --lg-text: #172033;
        --lg-muted: #6d7888;
        --lg-border: #dce4ee;
        --lg-danger: #b42318;
        --lg-ok: #17633a;
        --lg-shadow: 0 8px 24px rgba(22,42,75,.055)
    }

    .page {
        max-width: 1680px;
        margin: 0 auto;
        padding: 18px 20px 118px;
        color: var(--lg-text)
    }

    .head {
        display: flex;
        justify-content: space-between;
        align-items: center;
        gap: 12px;
        flex-wrap: wrap;
        padding: 15px 17px;
        margin-bottom: 14px;
        border: 1px solid var(--lg-border);
        border-left: 4px solid var(--lg-blue);
        border-radius: 12px;
        background: #fff;
        box-shadow: var(--lg-shadow)
    }

    .title {
        margin: 0;
        font-size: 1.48rem;
        font-weight: 800
    }

        .title i {
            color: var(--lg-blue)
        }

    .subtitle {
        margin: 3px 0 0;
        color: var(--lg-muted);
        font-size: .84rem
    }

    .section {
        margin-bottom: 12px;
        padding: 14px 15px;
        border: 1px solid var(--lg-border);
        border-radius: 12px;
        background: #fff;
        box-shadow: var(--lg-shadow)
    }

    .section-title {
        position: relative;
        padding-left: 11px;
        margin: 0 0 5px;
        font-size: .98rem;
        font-weight: 800
    }

        .section-title:before {
            content: "";
            position: absolute;
            left: 0;
            top: 2px;
            width: 3px;
            height: 16px;
            border-radius: 5px;
            background: var(--lg-blue)
        }

    .section-sub {
        margin: 0 0 11px;
        color: var(--lg-muted);
        font-size: .74rem
    }

    .grid {
        display: grid;
        grid-template-columns: repeat(12,1fr);
        gap: 10px 12px
    }

    .g6 {
        grid-column: span 6
    }

    .form-label {
        margin-bottom: 4px;
        font-size: .75rem;
        font-weight: 700
    }

    .required:after {
        content: " *";
        color: #dc3545;
        font-weight: 800
    }

    .form-control, .form-select {
        min-height: 38px;
        border-color: #d3dde8;
        border-radius: 8px;
        font-size: .82rem
    }

    .client-strip {
        display: flex;
        gap: 0;
        flex-wrap: wrap;
        margin-top: 10px;
        padding: 9px 12px;
        border: 1px solid #d6e0eb;
        border-radius: 9px;
        background: #f8fafc
    }

        .client-strip > div {
            min-width: 150px;
            padding: 3px 16px;
            border-right: 1px solid #dfe6ee
        }

            .client-strip > div:last-child {
                border-right: 0
            }

        .client-strip span {
            display: block;
            color: var(--lg-muted);
            font-size: .68rem
        }

        .client-strip strong {
            display: block;
            color: var(--lg-blue);
            font-size: .88rem
        }

    .scan {
        position: sticky;
        top: 10px;
        z-index: 35;
        display: grid;
        grid-template-columns: minmax(0,1fr) auto;
        gap: 12px;
        align-items: end;
        padding: 14px;
        margin-bottom: 14px;
        border: 1px solid #cfdced;
        border-left: 4px solid var(--lg-blue);
        border-radius: 11px;
        background: #f8fbff;
        box-shadow: 0 8px 22px rgba(23,58,122,.08)
    }

    .scan-label {
        display: block;
        margin-bottom: 5px;
        color: #40516a;
        font-size: .72rem;
        font-weight: 800;
        text-transform: uppercase
    }

    .scan-wrap {
        position: relative
    }

        .scan-wrap > i {
            position: absolute;
            left: 13px;
            top: 50%;
            transform: translateY(-50%);
            color: var(--lg-blue)
        }

    .scan-input {
        width: 100%;
        min-height: 48px;
        padding: 8px 12px 8px 40px;
        border: 2px solid #9fb7d9;
        border-radius: 9px;
        background: #fff;
        font-size: 1rem;
        font-weight: 700;
        outline: none
    }

    .scan-message {
        min-height: 20px;
        margin-top: 6px;
        color: #53647b;
        font-size: .76rem;
        font-weight: 600
    }

        .scan-message.ok {
            color: var(--lg-ok)
        }

        .scan-message.error {
            color: var(--lg-danger)
        }

    .scan-actions {
        display: flex;
        gap: 7px
    }

    .parts {
        display: grid;
        gap: 9px
    }

    details.part {
        overflow: hidden;
        border: 1px solid #dbe4ee;
        border-radius: 10px;
        background: #fff
    }

        details.part.has-selection {
            border-color: #7599cf;
            box-shadow: inset 4px 0 0 var(--lg-blue)
        }

        details.part > summary {
            display: grid;
            grid-template-columns: minmax(250px,1.5fr) 100px 130px 135px 145px 20px;
            gap: 10px;
            align-items: center;
            min-height: 62px;
            padding: 10px 12px;
            list-style: none;
            background: #f8fafc;
            cursor: pointer
        }

            details.part > summary::-webkit-details-marker {
                display: none
            }

            details.part > summary:after {
                content: "\f078";
                font-family: "Font Awesome 6 Free";
                font-weight: 900;
                color: #63758c
            }

        details.part[open] > summary:after {
            content: "\f077"
        }

    .muted {
        color: var(--lg-muted);
        font-size: .68rem
    }

    .part-main {
        font-size: .83rem;
        font-weight: 800
    }

    .boxes {
        padding: 10px 11px 11px;
        border-top: 1px solid #e5ebf1
    }

    .box-list {
        display: flex;
        flex-direction: column;
        gap: 7px
    }

    .box {
        display: grid;
        grid-template-columns: 34px minmax(280px,1.45fr) minmax(150px,.75fr) minmax(180px,.9fr) 130px;
        gap: 11px;
        align-items: center;
        min-height: 66px;
        padding: 8px 10px;
        border: 1px solid #dce4ed;
        border-radius: 8px;
        background: #fbfcfe
    }

        .box.selected {
            border-color: #6f96ce;
            background: #eef5ff;
            box-shadow: inset 3px 0 0 var(--lg-blue)
        }

    .box-main strong, .box-main span, .box-main small, .box-meta span, .box-meta strong, .box-meta small, .box-qty span, .box-qty strong, .box-qty small {
        display: block
    }

    .box-main strong {
        font-size: .84rem
    }

    .box-main span {
        font-size: .75rem;
        font-weight: 700
    }

    .box-main small, .box-meta small, .box-qty small {
        color: #7a8798;
        font-size: .67rem
    }

    .box-meta span, .box-qty span {
        color: #748195;
        font-size: .66rem;
        text-transform: uppercase
    }

    .box-meta strong {
        font-size: .75rem
    }

    .box-qty {
        text-align: right
    }

        .box-qty strong {
            color: var(--lg-blue);
            font-size: .92rem
        }

    .release-panel {
        margin-top: 9px;
        overflow: hidden;
        border: 1px solid #dce5ef;
        border-radius: 9px;
        background: #f8fafc
    }

    .release-head {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 10px;
        padding: 8px 10px
    }

        .release-head strong {
            font-size: .8rem
        }

        .release-head span {
            color: #637187;
            font-size: .7rem
        }

    .release-table {
        width: 100%;
        border-collapse: collapse;
        font-size: .73rem
    }

        .release-table th {
            padding: 5px 7px;
            border-top: 1px solid #d8e1eb;
            border-bottom: 1px solid #d8e1eb;
            color: #647184;
            text-align: left;
            font-size: .65rem;
            text-transform: uppercase
        }

        .release-table td {
            padding: 7px;
            border-bottom: 1px solid #e6ebf1
        }

        .release-table .num {
            text-align: right;
            font-weight: 800
        }

    .visual-only {
        display: inline-flex;
        padding: 2px 6px;
        border-radius: 999px;
        background: #eef2f6;
        color: #5e6b7c;
        font-size: .62rem;
        font-weight: 700;
        text-transform: uppercase
    }

    .footer-info {
        display: grid;
        grid-template-columns: repeat(4,minmax(130px,1fr));
        gap: 8px;
        margin-top: 13px
    }

        .footer-info > div {
            padding: 9px 10px;
            border: 1px solid #dce4ed;
            border-radius: 8px
        }

        .footer-info span {
            display: block;
            color: #68768a;
            font-size: .68rem
        }

        .footer-info strong {
            display: block;
            font-size: .88rem
        }

    .floating {
        position: fixed;
        left: 50%;
        bottom: 14px;
        transform: translateX(-50%);
        z-index: 1060;
        width: min(1180px,calc(100vw - 36px));
        display: grid;
        grid-template-columns: minmax(0,1fr) auto;
        gap: 16px;
        align-items: center;
        padding: 11px 13px;
        border: 1px solid #c9d7e8;
        border-radius: 12px;
        background: rgba(255,255,255,.97);
        box-shadow: 0 16px 40px rgba(20,42,75,.2)
    }

    .floating-info {
        display: flex;
        align-items: center;
        gap: 16px
    }

    .step-badge {
        display: inline-flex;
        align-items: center;
        gap: 7px;
        padding: 6px 9px;
        border-radius: 8px;
        background: #eef4fc;
        color: var(--lg-blue);
        font-size: .72rem;
        font-weight: 800
    }

    .floating-summary small {
        display: block;
        color: #6f7e92;
        font-size: .68rem
    }

    .floating-summary strong {
        display: block;
        font-size: .9rem
    }

        .floating-summary strong.error {
            color: var(--lg-danger)
        }

    .floating-actions {
        display: flex;
        gap: 8px
    }

        .floating-actions .btn {
            min-height: 42px;
            font-weight: 800
        }

        .floating-actions .btn-primary {
            min-width: 250px;
            background: #0b4f8a;
            border-color: #0b4f8a
        }

    .empty {
        padding: 18px;
        border: 1px dashed #cfd8e3;
        border-radius: 9px;
        background: #fafbfd;
        text-align: center;
        color: #66758a
    }

    @@media(max-width:1050px) {
        details.part > summary {
            grid-template-columns: minmax(220px,1fr) repeat(2,110px) 20px
        }

        .box {
            grid-template-columns: 34px 1fr 120px
        }

        .footer-info {
            grid-template-columns: repeat(2,1fr)
        }
    }

    @@media(max-width:760px) {
        .page {
            padding: 12px 10px 160px
        }

        .g6 {
            grid-column: span 12
        }

        .scan {
            position: static;
            grid-template-columns: 1fr
        }

        .floating {
            grid-template-columns: 1fr;
            width: calc(100vw - 20px);
            bottom: 8px
        }

        .floating-actions .btn-primary {
            min-width: 0;
            flex: 1
        }

        details.part > summary {
            grid-template-columns: 1fr 90px 20px
        }

        .box {
            grid-template-columns: 34px 1fr
        }

        .release-panel {
            overflow-x: auto
        }

        .release-table {
            min-width: 680px
        }
    }
</style>

<div class="page">
    <div class="head">
        <div>
            <h1 class="title"><i class="fa-solid fa-truck-ramp-box me-1"></i>Nuevo embarque</h1>
            <p class="subtitle">Paso 1: selecciona cliente y cajas PT. Los datos de carga y recolección se capturan en el siguiente paso.</p>
        </div>
        <a asp-controller="LogisticaEmbarques" asp-action="Index" class="btn btn-outline-secondary btn-sm">Regresar</a>
    </div>
    @if (TempData["LogisticaError"] != null)
    {
        <div class="alert alert-danger py-2 px-3">@TempData["LogisticaError"]</div>
    }
    <form asp-controller="LogisticaEmbarques" asp-action="PrepararDesdePT" method="post" id="formCrear" autocomplete="off">
        @Html.AntiForgeryToken()
        <div asp-validation-summary="ModelOnly" class="text-danger small mb-2"></div>
        <div class="section">
            <h2 class="section-title">1. Cliente</h2>
            <p class="section-sub">Solo se muestran cajas PT liberadas relacionadas con Releases pendientes del cliente.</p>
            <div class="grid">
                <div class="g6">
                    <label asp-for="ClienteID" class="form-label required">Cliente</label>
                    <select asp-for="ClienteID" class="form-select" id="ClienteID" required>
                        <option value="">Selecciona un cliente...</option>
                        @foreach (var c in Model.Clientes)
                        {
                            <option value="@c.Id">@c.Texto</option>
                        }
                    </select>
                    <span asp-validation-for="ClienteID" class="text-danger small"></span>
                </div>
            </div>
            @if (Model.ClienteID.HasValue)
            {
                <div class="client-strip">
                    <div><span>Cliente</span><strong>@clienteNombre</strong></div>
                    <div><span>Cajas PT</span><strong>@Model.CajasPT.Count.ToString("N0")</strong></div>
                    <div><span>Piezas PT</span><strong>@Model.CajasPT.Sum(x => (long)x.Disponible).ToString("N0")</strong></div>
                    <div><span>Seleccionadas</span><strong id="resCajasPt">0</strong></div>
                </div>
            }
        </div>

        @if (Model.ClienteID.HasValue)
        {
            var cajasIndexadas = Model.CajasPT.Select((caja, index) => new { Caja = caja, Index = index }).ToList();
            var gruposPt = cajasIndexadas.GroupBy(x => new { x.Caja.ParteID, x.Caja.NumeroParte, x.Caja.Descripcion }).OrderBy(g => g.Min(x => x.Caja.FechaEntrada)).ThenBy(g => g.Key.NumeroParte).ToList();
            <div class="section">
                <h2 class="section-title">2. Packing List / selección de PT</h2>
                <p class="section-sub">Escanea o selecciona cajas completas. Esta selección será la base del Packing List del embarque.</p>
                <div class="scan">
                    <div>
                        <label class="scan-label" for="logisticaScanInput">Escáner de cajas PT</label>
                        <div class="scan-wrap"><i class="fa-solid fa-barcode"></i><input id="logisticaScanInput" class="scan-input" type="text" autocomplete="off" inputmode="none" autofocus placeholder="Escanea la etiqueta y presiona Enter/Tab..." /></div>
                        <div id="logisticaScanMessage" class="scan-message">Cursor listo.</div>
                    </div>
                    <div class="scan-actions">
                        <button type="button" class="btn btn-outline-secondary btn-sm" id="btnFocusScan">Enfocar escáner</button>
                        <button type="button" class="btn btn-outline-danger btn-sm" id="btnClearPtSelection">Limpiar selección</button>
                    </div>
                </div>
                @if (Model.CajasPT.Count == 0)
                {
                    <div class="empty"><strong>Sin PT disponible para este cliente</strong><div class="small mt-1">No existen cajas liberadas con saldo disponible y demanda pendiente.</div></div>
                }
                else
                {
                    <div class="client-strip mb-3">
                        <div><span>Partes con PT</span><strong>@gruposPt.Count.ToString("N0")</strong></div>
                        <div><span>Cajas disponibles</span><strong>@Model.CajasPT.Count.ToString("N0")</strong></div>
                        <div><span>PT disponible</span><strong>@Model.CajasPT.Sum(x => (long)x.Disponible).ToString("N0") PZA</strong></div>
                        <div><span>Seleccionado</span><strong id="resPiezasPt">0 PZA</strong></div>
                    </div>
                    <div class="parts">
                        @foreach (var grupo in gruposPt)
                        {
                            var piezasDisponibles = grupo.Sum(x => (long)x.Caja.Disponible);
                            var releasesPendientes = grupo.Max(x => x.Caja.ReleasesPendientes);
                            var piezasPendientesRelease = grupo.Max(x => x.Caja.PiezasPendientesRelease);
                            var primeraEntrada = grupo.Min(x => x.Caja.FechaEntrada);
                            var releasesParte = Model.Partidas.Where(x => string.Equals(x.NumeroParte, grupo.Key.NumeroParte, StringComparison.OrdinalIgnoreCase) && x.PendienteProgramar > 0).OrderBy(x => x.FechaCarga ?? x.FechaEntrega).ThenBy(x => x.FechaEntrega).ThenBy(x => x.ReleaseDetalleID).ToList();
                            <details class="part">
                                <summary>
                                    <div><div class="muted">PARTE</div><div class="part-main">@grupo.Key.NumeroParte</div><div class="muted">@(string.IsNullOrWhiteSpace(grupo.Key.Descripcion) ? "Sin descripción" : grupo.Key.Descripcion)</div></div>
                                    <div><div class="muted">Cajas PT</div><strong>@grupo.Count().ToString("N0")</strong></div>
                                    <div><div class="muted">PT disponible</div><strong>@piezasDisponibles.ToString("N0")</strong></div>
                                    <div><div class="muted">Releases</div><strong>@releasesPendientes.ToString("N0")</strong></div>
                                    <div><div class="muted">Entrada más antigua</div><strong>@primeraEntrada.ToString("dd/MM/yyyy")</strong></div>
                                    <span></span>
                                </summary>
                                <div class="boxes">
                                    @if (releasesPendientes <= 0 || piezasPendientesRelease <= 0)
                                    {
                                        <div class="alert alert-warning py-2 px-3"><strong>SIN RELEASE PENDIENTE</strong></div>
                                    }
                                    else
                                    {

                                        <div class="muted mb-2">Pendiente total de Releases: <strong>@piezasPendientesRelease.ToString("N0") PZA</strong></div>
                                    }
                                    <div class="box-list">
                                        @foreach (var item in grupo.OrderBy(x => x.Caja.FechaEntrada).ThenBy(x => x.Caja.CajaID))
                                        {
                                            var i = item.Index; var caja = item.Caja;
                                            <div class="box js-box-pt-row" data-i="@i" data-parte="@caja.ParteID" data-etiqueta="@caja.Etiqueta" data-lote="@caja.Lote" data-caja-id="@caja.CajaID" data-numero-caja="@caja.NumeroCaja" data-numero-parte="@caja.NumeroParte" data-disponible="@caja.Disponible" data-pendiente-parte="@piezasPendientesRelease">
                                                @if (caja.TieneReleasePendiente)
                                                {
                                                    <input asp-for="CajasPT[i].Seleccionada" class="form-check-input js-caja-pt" data-i="@i" />
                                                }
                                                else
                                                {

                                                    <input type="checkbox" class="form-check-input" disabled />
                                                    <input type="hidden" name="CajasPT[@i].Seleccionada" value="false" />
                }
                                                <input asp-for="CajasPT[i].CajaID" type="hidden" />
                                                <div class="box-main"><strong>Caja #@caja.NumeroCaja</strong><span>@(string.IsNullOrWhiteSpace(caja.Lote) ? "Sin lote" : caja.Lote)</span><small>Etiqueta: @caja.Etiqueta</small></div>
                                                <div class="box-meta"><span>OF origen</span><strong>@(string.IsNullOrWhiteSpace(caja.NumeroOF) ? "-" : caja.NumeroOF)</strong><small>@caja.FechaEntrada.ToString("dd/MM/yyyy HH:mm")</small></div>
                                                <div class="box-meta"><span>Ubicación</span><strong>@(string.IsNullOrWhiteSpace(caja.Ubicacion) ? "Sin ubicar" : caja.Ubicacion)</strong><small>Calidad: @caja.EstadoCalidad</small></div>
                                                <div class="box-qty"><span>Caja completa</span><strong>@caja.Disponible.ToString("N0") PZA</strong><small>Original @caja.CantidadInicial.ToString("N0")</small></div>
                                            </div>
                                        }
                                    </div>
                                    <div class="release-panel">
                                        <div class="release-head"><strong>Releases relacionados</strong><span>Fecha de entrega: solo visual</span></div>
                                        @if (releasesParte.Count == 0)
                                        {
                                            <div class="p-2 text-muted small">No existe Release pendiente para esta parte.</div>
                                        }
                                        else
                                        {
                                            <table class="release-table">
                                                <thead><tr><th>Release</th><th>OF</th><th>Fecha carga</th><th>Fecha entrega <span class="visual-only">Visual</span></th><th class="num">Pendiente</th></tr></thead>
                                                <tbody>
                                                    @foreach (var rel in releasesParte)
                                                    {
                                                        <tr><td><strong>@rel.FolioRelease</strong></td><td>@(string.IsNullOrWhiteSpace(rel.NumeroOF) ? "-" : rel.NumeroOF)</td><td>@(rel.FechaCarga?.ToString("dd/MM/yyyy") ?? "-")</td><td>@rel.FechaEntrega.ToString("dd/MM/yyyy")</td><td class="num">@rel.PendienteProgramar.ToString("N0") PZA</td></tr>
                                                    }
                                                </tbody>
                                            </table>
                                        }
                                    </div>
                                </div>
                            </details>
                        }
                    </div>
                    <div class="footer-info">
                        <div><span>Demanda pendiente</span><strong>@Model.Partidas.Sum(x => (long)x.PendienteProgramar).ToString("N0") PZA</strong></div>
                        <div><span>Cajas físicas</span><strong>@Model.CajasPT.Count.ToString("N0")</strong></div>
                        <div><span>PT disponible</span><strong>@Model.CajasPT.Sum(x => (long)x.Disponible).ToString("N0") PZA</strong></div>
                        <div><span>Siguiente paso</span><strong>Datos de carga y recolección</strong></div>
                    </div>
                    <div class="alert alert-light border mt-2 mb-0 small"><strong>Importante:</strong> aquí no se captura fecha de entrega, ruta, chofer ni paquetería. Eso se captura en el paso 2.</div>
                }
            </div>
        }

        <div class="floating">
            <div class="floating-info"><div class="step-badge">Paso 1 de 2</div><div class="floating-summary"><small>Packing List / selección PT</small><strong id="nextSummary">Selecciona o escanea al menos una caja completa</strong></div></div>
            <div class="floating-actions"><a asp-action="Index" class="btn btn-outline-secondary">Cancelar</a><button type="submit" class="btn btn-primary" id="btnGuardar" disabled>Siguiente: datos del embarque</button></div>
        </div>
    </form>
</div>

@section Scripts {
    <script>
        (()=>{
         const cliente=document.getElementById('ClienteID'),form=document.getElementById('formCrear'),scanInput=document.getElementById('logisticaScanInput'),scanMessage=document.getElementById('logisticaScanMessage'),btnFocus=document.getElementById('btnFocusScan'),btnClear=document.getElementById('btnClearPtSelection'),btnGuardar=document.getElementById('btnGuardar'),resCajas=document.getElementById('resCajasPt'),resPiezas=document.getElementById('resPiezasPt'),nextSummary=document.getElementById('nextSummary');
         cliente?.addEventListener('change',()=>{const id=cliente.value;window.location.href=id?'@Url.Action("Crear", "LogisticaEmbarques")?clienteId='+encodeURIComponent(id):'@Url.Action("Crear", "LogisticaEmbarques")';});
         const norm=v=>(v||'').trim().toUpperCase();
         const msg=(t,c='')=>{if(!scanMessage)return;scanMessage.textContent=t;scanMessage.classList.remove('ok','error');if(c)scanMessage.classList.add(c);};
         const actualizar=()=>{let cajas=0,piezas=0,excede=false;const porParte=new Map(),pendientes=new Map();document.querySelectorAll('.js-box-pt-row').forEach(r=>{const p=r.dataset.parte||'',q=Number(r.dataset.pendienteParte||0);if(p&&q>0)pendientes.set(p,q);});document.querySelectorAll('.js-caja-pt').forEach(chk=>{const r=document.querySelector(`.js-box-pt-row[data-i="${chk.dataset.i}"]`);if(!r)return;r.classList.toggle('selected',chk.checked);if(chk.checked){cajas++;const q=Number(r.dataset.disponible||0);piezas+=q;const p=r.dataset.parte||'';porParte.set(p,(porParte.get(p)||0)+q);}});porParte.forEach((q,p)=>{const pend=pendientes.get(p)||0;if(pend>0&&q>pend)excede=true;});document.querySelectorAll('details.part').forEach(d=>{const s=!!d.querySelector('.js-caja-pt:checked');d.classList.toggle('has-selection',s);if(s)d.open=true;});if(resCajas)resCajas.textContent=cajas.toLocaleString('es-MX');if(resPiezas)resPiezas.textContent=piezas.toLocaleString('es-MX')+' PZA';if(btnGuardar)btnGuardar.disabled=cajas===0||excede;if(nextSummary){nextSummary.classList.toggle('error',excede);nextSummary.textContent=excede?'La selección excede el pendiente de un Release.':cajas===0?'Selecciona o escanea al menos una caja completa':`${cajas.toLocaleString('es-MX')} caja(s) · ${piezas.toLocaleString('es-MX')} PZA`;}};
         const escanear=()=>{if(!scanInput)return;const code=norm(scanInput.value);if(!code){msg('El lector no envió contenido.','error');return;}const rows=Array.from(document.querySelectorAll('.js-box-pt-row'));let cand=rows.filter(r=>norm(r.dataset.etiqueta)===code);if(cand.length===0)cand=rows.filter(r=>norm(r.dataset.lote)===code);if(cand.length!==1){msg(cand.length===0?'La etiqueta no corresponde a una caja disponible.':'La lectura coincide con más de una caja.','error');scanInput.select();return;}const r=cand[0],chk=document.querySelector(`.js-caja-pt[data-i="${r.dataset.i}"]`);if(!chk){msg('La caja no tiene Release pendiente.','error');return;}if(chk.checked){msg('La caja ya estaba seleccionada.','error');scanInput.value='';return;}chk.checked=true;r.closest('details')?.setAttribute('open','open');actualizar();msg(`Caja #${r.dataset.numeroCaja||r.dataset.cajaId||''} seleccionada.`,'ok');scanInput.value='';setTimeout(()=>scanInput.focus(),120);};
         document.querySelectorAll('.js-caja-pt').forEach(c=>c.addEventListener('change',actualizar));scanInput?.addEventListener('keydown',e=>{if(e.key==='Enter'||e.key==='Tab'){e.preventDefault();escanear();}});btnFocus?.addEventListener('click',()=>scanInput?.focus());btnClear?.addEventListener('click',()=>{document.querySelectorAll('.js-caja-pt:checked').forEach(c=>c.checked=false);actualizar();msg('Selección limpia.');scanInput?.focus();});form?.addEventListener('submit',e=>{actualizar();if(btnGuardar?.disabled){e.preventDefault();msg('Selecciona al menos una caja válida.','error');scanInput?.focus();}});actualizar();setTimeout(()=>scanInput?.focus(),120);
        })();
    </script>
}
