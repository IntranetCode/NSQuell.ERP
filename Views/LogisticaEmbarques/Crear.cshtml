                    backdrop-filter: blur(10px);
                }

                .v32-next-info {
                    min-width: 0;
                    display: flex;
                    align-items: center;
                    gap: 18px;
                }

                .v32-next-step {
                    flex: 0 0 auto;
                    display: inline-flex;
                    align-items: center;
                    gap: 7px;
                    padding: 6px 9px;
                    border-radius: 8px;
