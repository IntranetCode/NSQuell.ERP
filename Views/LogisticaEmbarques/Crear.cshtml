@using ERP.NSQuell.Models.ViewModels.Logistica
@model LogisticaCrearVm
@{
    Layout = "~/Views/Shared/_Layout.cshtml";
    ViewData["Title"] = "Iniciar embarque";
}

@section Styles {
    <style>
        :root {
            --legacy-blue: #173a7a;
            --legacy-blue-soft: #eef5ff;
            --legacy-text: #172033;
            --legacy-muted: #667085;
            --legacy-border: #dbe4f0;
            --legacy-surface: #fff;
            --legacy-bg: #f4f7fb;
            --legacy-green: #107c41;
            --legacy-warn: #b54708
        }

        body {
            background: var(--legacy-bg)
        }

        .legacy-page {
            max-width: 1180px;
            margin: 0 auto;
            padding: 24px 18px 40px;
            color: var(--legacy-text)
        }

        .legacy-head {
            display: flex;
            align-items: center;
            justify-content: space-between;
            gap: 14px;
            flex-wrap: wrap;
            padding: 17px 18px;
            margin-bottom: 14px;
            border: 1px solid var(--legacy-border);
            border-left: 4px solid var(--legacy-blue);
            border-radius: 15px;
            background: var(--legacy-surface)
        }

        .legacy-title {
            margin: 0;
            font-size: 1.45rem;
            font-weight: 900;
            color: var(--legacy-text)
        }

            .legacy-title i {
                color: var(--legacy-blue)
            }

        .legacy-subtitle {
            margin: 4px 0 0;
            color: var(--legacy-muted);
            font-size: .82rem;
            font-weight: 650
        }

        .legacy-back {
            min-height: 38px;
            display: inline-flex;
            align-items: center;
            gap: 7px;
            border-radius: 9px;
            font-weight: 800
        }

        .legacy-alert {
            display: flex;
            gap: 12px;
            align-items: flex-start;
            padding: 15px 16px;
            margin-bottom: 14px;
            border: 1px solid #efcf8d;
            border-left: 4px solid var(--legacy-warn);
            border-radius: 13px;
            background: #fff9ea
        }

            .legacy-alert > i {
                margin-top: 2px;
                color: var(--legacy-warn);
                font-size: 1.15rem
            }

            .legacy-alert strong {
                display: block;
                margin-bottom: 3px;
                color: #7c4d00;
                font-size: .88rem;
                font-weight: 900
            }

            .legacy-alert span {
                display: block;
                color: #735f37;
                font-size: .78rem;
                line-height: 1.5;
                font-weight: 650
            }

        .flow-card {
            overflow: hidden;
            margin-bottom: 14px;
            border: 1px solid var(--legacy-border);
            border-radius: 15px;
            background: var(--legacy-surface)
        }

        .flow-card-head {
            padding: 13px 15px;
            border-bottom: 1px solid var(--legacy-border);
            background: #f8fbff
        }

            .flow-card-head h2 {
                margin: 0;
                font-size: .95rem;
                font-weight: 900;
                color: var(--legacy-blue)
            }

            .flow-card-head p {
                margin: 3px 0 0;
                color: var(--legacy-muted);
                font-size: .74rem;
                font-weight: 650
            }

        .flow-steps {
            display: grid;
            grid-template-columns: repeat(4,minmax(0,1fr));
            gap: 0
        }

        .flow-step {
            position: relative;
            min-height: 135px;
            padding: 16px;
            border-right: 1px solid var(--legacy-border)
        }

            .flow-step:last-child {
                border-right: 0
            }

        .flow-step-num {
            width: 31px;
            height: 31px;
            display: grid;
            place-items: center;
            margin-bottom: 9px;
            border-radius: 50%;
            background: var(--legacy-blue-soft);
            color: var(--legacy-blue);
            font-size: .78rem;
            font-weight: 950
        }

        .flow-step strong {
            display: block;
            margin-bottom: 4px;
            color: var(--legacy-text);
            font-size: .82rem;
            font-weight: 900
        }

        .flow-step span {
            display: block;
            color: var(--legacy-muted);
            font-size: .72rem;
            line-height: 1.45;
            font-weight: 650
        }

        .actions-grid {
            display: grid;
            grid-template-columns: repeat(3,minmax(0,1fr));
            gap: 12px
        }

        .action-card {
            display: flex;
            flex-direction: column;
            min-height: 190px;
            padding: 17px;
            border: 1px solid var(--legacy-border);
            border-radius: 14px;
            background: var(--legacy-surface)
        }

        .action-icon {
            width: 42px;
            height: 42px;
            display: grid;
            place-items: center;
            margin-bottom: 11px;
            border-radius: 11px;
            background: var(--legacy-blue-soft);
            color: var(--legacy-blue);
            font-size: 1rem
        }

        .action-card h3 {
            margin: 0 0 5px;
            color: var(--legacy-text);
            font-size: .9rem;
            font-weight: 900
        }

        .action-card p {
            margin: 0 0 14px;
            color: var(--legacy-muted);
            font-size: .74rem;
            line-height: 1.45;
            font-weight: 650
        }

        .action-card .btn {
            margin-top: auto;
            min-height: 39px;
            display: inline-flex;
            align-items: center;
            justify-content: center;
            gap: 7px;
            border-radius: 9px;
            font-weight: 850
        }

        .btn-main {
            background: var(--legacy-blue);
            border-color: var(--legacy-blue);
            color: #fff
        }

            .btn-main:hover {
                background: #102e65;
                border-color: #102e65;
                color: #fff
            }

        .legacy-footer-note {
            margin-top: 14px;
            padding: 11px 13px;
            border: 1px dashed #cbd7e3;
            border-radius: 11px;
            background: #fafbfd;
            color: var(--legacy-muted);
            font-size: .73rem;
            line-height: 1.45;
            font-weight: 650
        }

            .legacy-footer-note strong {
                color: var(--legacy-text)
            }

        html[data-nsq-theme="dark"] {
            --legacy-text: #eef4fb;
            --legacy-muted: #9badc2;
            --legacy-border: #2b3d53;
            --legacy-surface: #111c2d;
            --legacy-bg: #08111e;
            --legacy-blue-soft: #172b47;
            color-scheme: dark
        }

            html[data-nsq-theme="dark"] .flow-card-head {
                background: #0d1828
            }

            html[data-nsq-theme="dark"] .legacy-alert {
                background: #2b2414;
                border-color: #765f2c
            }

                html[data-nsq-theme="dark"] .legacy-alert strong {
                    color: #ffd78a
                }

                html[data-nsq-theme="dark"] .legacy-alert span {
                    color: #dfcda8
                }

            html[data-nsq-theme="dark"] .legacy-footer-note {
                background: #0d1828
            }

        @@media(max-width:900px) {
            .flow-steps {
                grid-template-columns: repeat(2,minmax(0,1fr))
            }

            .flow-step:nth-child(2) {
                border-right: 0
            }

            .flow-step:nth-child(-n+2) {
                border-bottom: 1px solid var(--legacy-border)
            }

            .actions-grid {
                grid-template-columns: 1fr
            }

            .action-card {
                min-height: 0
            }
        }

        @@media(max-width:600px) {
            .legacy-page {
                padding: 12px 9px 28px
            }

            .legacy-head {
                align-items: stretch
            }

            .legacy-back {
                width: 100%;
                justify-content: center
            }

            .flow-steps {
                grid-template-columns: 1fr
            }

            .flow-step {
                min-height: 0;
                border-right: 0;
                border-bottom: 1px solid var(--legacy-border)
            }

                .flow-step:last-child {
                    border-bottom: 0
                }
        }
    </style>
}

<div class="legacy-page">
    <section class="legacy-head">
        <div>
            <h1 class="legacy-title"><i class="fa-solid fa-truck-ramp-box me-2"></i>Iniciar embarque</h1>
            <p class="legacy-subtitle">El alta operativa de embarques se realiza desde la programación vigente de Logística.</p>
        </div>
        <a asp-controller="LogisticaEmbarques" asp-action="Index" class="btn btn-outline-secondary btn-sm legacy-back">
            <i class="fa-solid fa-arrow-left"></i>
            Regresar a embarques
        </a>
    </section>

    @if (TempData["LogisticaError"] != null)
    {
        <div class="alert alert-danger py-2 px-3 mb-3">
            <i class="fa-solid fa-triangle-exclamation me-1"></i>@TempData["LogisticaError"]
        </div>
    }

    <div class="legacy-alert">
        <i class="fa-solid fa-circle-info"></i>
        <div>
            <strong>Esta pantalla ya no debe crear embarques seleccionando cajas PT directamente.</strong>
            <span>La selección manual de PT en este punto pertenecía al flujo anterior. Primero se programa la fecha de carga; después, desde Centro Operativo, se inicia el embarque utilizando las programaciones pendientes. La reserva, documentación y carga física se realizan posteriormente dentro del flujo del embarque.</span>
        </div>
    </div>

    <section class="flow-card">
        <div class="flow-card-head">
            <h2>Flujo vigente para iniciar un embarque</h2>
            <p>Las dos vistas principales trabajan sobre la misma programación y el mismo embarque.</p>
        </div>
        <div class="flow-steps">
            <div class="flow-step">
                <div class="flow-step-num">1</div>
                <strong>Lista de carga</strong>
                <span>Define el día de carga de los Releases pendientes. Aquí todavía no se crea el embarque.</span>
            </div>
            <div class="flow-step">
                <div class="flow-step-num">2</div>
                <strong>Centro Operativo</strong>
                <span>Las programaciones pendientes aparecen disponibles para iniciar el embarque por cliente y fecha.</span>
            </div>
            <div class="flow-step">
                <div class="flow-step-num">3</div>
                <strong>Iniciar embarque</strong>
                <span>Se seleccionan las programaciones que formarán el embarque y se crea una sola operación vinculada.</span>
            </div>
            <div class="flow-step">
                <div class="flow-step-num">4</div>
                <strong>Operar embarque</strong>
                <span>Preparación, documentación, carga física, salida y entrega continúan sobre el mismo embarque.</span>
            </div>
        </div>
    </section>

    <div class="actions-grid">
        <section class="action-card">
            <div class="action-icon"><i class="fa-solid fa-calendar-days"></i></div>
            <h3>Centro Operativo</h3>
            <p>Abre el calendario operativo para localizar las programaciones listas e iniciar el embarque desde el flujo vigente.</p>
            <a asp-controller="LogisticaOperacion" asp-action="Index" class="btn btn-main">
                <i class="fa-solid fa-table-columns"></i>
                Ir a Centro Operativo
            </a>
        </section>

        <section class="action-card">
            <div class="action-icon"><i class="fa-solid fa-list-check"></i></div>
            <h3>Lista de carga</h3>
            <p>Si el Release todavía no tiene día de carga, prográmalo primero aquí. Esta pantalla solo agenda la carga; no genera el embarque.</p>
            <a asp-controller="LogisticaListaCarga" asp-action="Index" class="btn btn-outline-primary">
                <i class="fa-solid fa-calendar-plus"></i>
                Ir a Lista de carga
            </a>
        </section>

        <section class="action-card">
            <div class="action-icon"><i class="fa-solid fa-truck-fast"></i></div>
            <h3>Vista lista de embarques</h3>
            <p>Consulta las programaciones listas para iniciar y los embarques que ya están en operación desde la vista de lista.</p>
            <a asp-controller="LogisticaEmbarques" asp-action="Index" class="btn btn-outline-primary">
                <i class="fa-solid fa-list"></i>
                Ver embarques
            </a>
        </section>
    </div>

    <div class="legacy-footer-note">
        <strong>Importante:</strong> el escaneo de cajas que ocurre durante la <strong>carga física</strong> no desaparece. Ese escaneo se conserva dentro del embarque ya creado y puede realizarse tanto desde Centro Operativo como desde el portal del chofer cuando corresponda. Lo que se elimina de esta pantalla es la selección anticipada de cajas PT para crear un embarque por un camino paralelo.
    </div>
</div>
