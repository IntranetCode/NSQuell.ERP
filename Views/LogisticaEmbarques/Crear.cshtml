                    font-size: .9rem;
                }

                .v32-next-actions {
                    display: flex;
                    align-items: center;
                    gap: 8px;
                }

                #v32NextButton {
                    min-width: 245px;
                    min-height: 42px;
                    font-weight: 800;
                    border-radius: 9px;
                }

                #v32NextButton:disabled {
                    opacity: .48;
                    cursor: not-allowed;
                }

                /* LOGISTICA_BUTTON_SYSTEM_V3_4 */
                #v32NextButton,
                #v32TopButton,
                #btnFocusScan,
                #btnClearPtSelection {
                    min-height: 42px !important;
                    padding: 0 16px !important;
                    border-radius: 9px !important;
                    font-size: .78rem !important;
                    font-weight: 800 !important;
                    line-height: 1 !important;
                    display: inline-flex !important;
                    align-items: center !important;
                    justify-content: center !important;
                    gap: 6px !important;
                    box-shadow: none !important;
                    text-decoration: none !important;
                    transition: transform .14s ease, background .14s ease, border-color .14s ease, box-shadow .14s ease !important;
                }

                #v32NextButton {
                    min-width: 245px;
                    background: #0b4f8a !important;
                    border: 1px solid #0b4f8a !important;
                    color: #fff !important;
                    box-shadow: 0 7px 16px rgba(11,79,138,.18) !important;
                }

                #v32NextButton:hover:not(:disabled) {
                    background: #083f70 !important;
                    border-color: #083f70 !important;
                    transform: translateY(-1px);
                    box-shadow: 0 9px 19px rgba(11,79,138,.22) !important;
                }

                #v32TopButton,
                #btnFocusScan {
                    background: #fff !important;
                    border: 1px solid #b8c9dc !important;
                    color: #173a7a !important;
                }

                #v32TopButton:hover,
                #btnFocusScan:hover {
                    background: #eef4fb !important;
                    border-color: #8fa9c8 !important;
                    color: #0b4f8a !important;
                    transform: translateY(-1px);
                }

                #btnClearPtSelection {
                    background: #fff !important;
                    border: 1px solid #d9aeb3 !important;
                    color: #a12631 !important;
                }

                #btnClearPtSelection:hover {
                    background: #fff4f5 !important;
                    border-color: #c77d86 !important;
                    color: #821d27 !important;
                    transform: translateY(-1px);
                }

                .v32-release-toggle {
                    border-radius: 8px !important;
                    font-weight: 800 !important;
                    box-shadow: none !important;
                }

                html[data-nsq-theme="dark"] #v32TopButton,
                html[data-nsq-theme="dark"] #btnFocusScan,
                html[data-nsq-theme="dark"] #btnClearPtSelection {
                    background: #162237 !important;
                }

                .v32-next-error {
                    color: #b42318 !important;
                }

                html[data-nsq-theme="dark"] #v32FloatingNext {
                    background: rgba(17,27,45,.97);
                    border-color: #334963;
                }

                html[data-nsq-theme="dark"] .v32-next-summary strong {
                    color: #eef4fb;
                }

                html[data-nsq-theme="dark"] .v32-next-step {
                    background: #1a2b45;
                    color: #cfe0f7;
                }

                html[data-nsq-theme="dark"] details.part,
                html[data-nsq-theme="dark"] details.part .boxes {
                    background: #111b2d !important;
                    border-color: #2b3d55 !important;
                }

                html[data-nsq-theme="dark"] details.part > summary.part-head,
                html[data-nsq-theme="dark"] details.part.v32-has-selection > summary.part-head,
                html[data-nsq-theme="dark"] details.part .box,
                html[data-nsq-theme="dark"] .lg-release-panel {
                    background: #162237 !important;
                }

                @@media (max-width: 760px) {
                    .page { padding-bottom: 160px !important; }
                    #v32FloatingNext {
                        grid-template-columns: 1fr;
                        width: calc(100vw - 20px);
                        bottom: 8px;
                        gap: 9px;
                    }
                    .v32-next-info { gap: 9px; }
                    .v32-next-actions { width: 100%; }
                    #v32NextButton { min-width: 0; flex: 1; }
                }
            `;
            document.head.appendChild(style);

            const bar = document.createElement('div');
            bar.id = 'v32FloatingNext';
            bar.innerHTML = `
                <div class="v32-next-info">
                    <div class="v32-next-step"><i class="fa-solid fa-boxes-packing"></i> Paso 1 de 2</div>
                    <div class="v32-next-summary">
                        <small>Seleccion de Producto Terminado</small>
                        <strong id="v32NextSummaryText">Selecciona o escanea al menos una caja completa</strong>
                    </div>
                </div>
                <div class="v32-next-actions">
                    <button type="button" class="btn btn-outline-secondary" id="v32TopButton">
                        <i class="fa-solid fa-arrow-up me-1"></i> Escaner
                    </button>
                    <button type="submit" form="formCrear" class="btn btn-primary" id="v32NextButton" disabled>
                        Siguiente: datos del embarque <i class="fa-solid fa-arrow-right ms-1"></i>
                    </button>
                </div>
            `;
            document.body.appendChild(bar);

            const nextButton = document.getElementById('v32NextButton');
            const summaryText = document.getElementById('v32NextSummaryText');
            const topButton = document.getElementById('v32TopButton');
            const scanInputV32 = document.getElementById('logisticaScanInput');
            const clearButtonV32 = document.getElementById('btnClearPtSelection');

            const collapseReleasePanels = () => {
                document.querySelectorAll('.lg-release-panel').forEach(panel => {
                    const head = panel.querySelector('.lg-release-panel__head');
                    if (!head || head.querySelector('.v32-release-toggle')) return;

                    const rows = panel.querySelectorAll('tbody tr').length;
                    const button = document.createElement('button');
                    button.type = 'button';
                    button.className = 'v32-release-toggle';
                    button.innerHTML = `<i class="fa-solid fa-list me-1"></i> Ver Releases${rows ? ` (${rows})` : ''}`;
                    head.appendChild(button);
                    panel.classList.add('v32-collapsed');

                    button.addEventListener('click', () => {
                        const collapsed = panel.classList.toggle('v32-collapsed');
                        button.innerHTML = collapsed
                            ? `<i class="fa-solid fa-list me-1"></i> Ver Releases${rows ? ` (${rows})` : ''}`
                            : '<i class="fa-solid fa-chevron-up me-1"></i> Ocultar Releases';
                    });
                });
            };

            const syncV32 = () => {
                let cajas = 0;
                let piezas = 0;
                const porParte = new Map();
                const pendientes = new Map();

                document.querySelectorAll('.js-box-pt-row').forEach(row => {
                    const parte = row.dataset.parte || '';
                    const pendiente = Number(row.dataset.pendienteParte || 0);
                    if (parte && pendiente > 0) pendientes.set(parte, pendiente);
                });

                document.querySelectorAll('.js-caja-pt').forEach(chk => {
                    const i = chk.dataset.i;
                    const row = document.querySelector(`.js-box-pt-row[data-i="${i}"]`);
                    if (!row) return;

                    if (chk.checked) {
                        cajas++;
                        const disponibles = Number(row.dataset.disponible || 0);
                        piezas += disponibles;
                        const parte = row.dataset.parte || '';
                        porParte.set(parte, (porParte.get(parte) || 0) + disponibles);
                    }
                });

                let excede = false;
                porParte.forEach((cantidad, parte) => {
                    const pendiente = pendientes.get(parte) || 0;
                    if (pendiente > 0 && cantidad > pendiente) excede = true;
                });

                document.querySelectorAll('details.part').forEach(part => {
                    const hasSelection = !!part.querySelector('.js-caja-pt:checked');
                    part.classList.toggle('v32-has-selection', hasSelection);
                    if (hasSelection) part.open = true;
                });

                if (nextButton) nextButton.disabled = cajas === 0 || excede;

                if (summaryText) {
                    summaryText.classList.toggle('v32-next-error', excede);
                    if (excede) {
                        summaryText.textContent = 'La seleccion completa excede el pendiente de un Release. Deselecciona una caja.';
                    }
                    else if (cajas === 0) {
                        summaryText.textContent = 'Selecciona o escanea al menos una caja completa';
                    }
                    else {
                        summaryText.textContent = `${cajas.toLocaleString('es-MX')} caja(s) completa(s) Â· ${piezas.toLocaleString('es-MX')} PZA seleccionadas`;
                    }
                }
            };

            collapseReleasePanels();

            document.querySelectorAll('details.part').forEach(part => {
                if (!part.querySelector('.js-caja-pt:checked')) part.open = false;
            });

            document.querySelectorAll('.js-caja-pt').forEach(chk => {
                chk.addEventListener('change', syncV32);
            });

            scanInputV32?.addEventListener('keydown', event => {
                if (event.key === 'Enter' || event.key === 'Tab') {
                    window.setTimeout(syncV32, 0);
                }
            });

            clearButtonV32?.addEventListener('click', () => {
                window.setTimeout(syncV32, 0);
            });

            topButton?.addEventListener('click', () => {
                document.querySelector('.lg-pt-scan')?.scrollIntoView({ behavior: 'smooth', block: 'center' });
                window.setTimeout(() => {
                    scanInputV32?.focus();
                    scanInputV32?.select();
                }, 250);
            });

            form.addEventListener('submit', event => {
                syncV32();
                if (nextButton?.disabled) {
                    event.preventDefault();
                    scanInputV32?.focus();
                }
            });

            syncV32();
        })();
    </script>
