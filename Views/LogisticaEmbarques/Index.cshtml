@using ERP.NSQuell.Models.ViewModels.Logistica
@model LogisticaIndexVm
@{
    Layout = "~/Views/Shared/_Layout.cshtml"; ViewData["Title"] = "Embarques";
    var periodo = ViewBag.Periodo as string ?? "hoy"; var mes = ViewBag.MesSeleccionado is int m ? m : DateTime.Today.Month; var anio = ViewBag.AnioSeleccionado is int a ? a : DateTime.Today.Year;
    var grupos = (Model.Demandas ?? new List<LogisticaDemandaVm>()).Where(x => x.PendienteProgramar > 0).GroupBy(x => new { ClienteID = x.ClienteID ?? 0, Cliente = x.Cliente }).OrderBy(x => x.Key.Cliente).ToList();
    string Badge(string e) => e switch { "Programado" => "bg-primary", "Preparando" => "bg-info text-dark", "Preparado" => "bg-warning text-dark", "Cargado" => "bg-dark", "En ruta" => "bg-primary", "Entregado" => "bg-success", "Cancelado" => "bg-secondary", _ => "bg-light text-dark" };
    string FH(DateTime? f, TimeSpan? h) => !f.HasValue ? "-" : h.HasValue ? $"{f.Value:dd/MM/yyyy} {h.Value:hh\\:mm}" : f.Value.ToString("dd/MM/yyyy");
}
@section Styles {
    <link rel="stylesheet" href="~/css/logistica.css" asp-append-version="true" />
}
<style>
    .page {
        padding: 18px 20px 30px
    }

    .head {
        display: flex;
        justify-content: space-between;
        gap: 12px;
        flex-wrap: wrap;
        margin-bottom: 14px
    }

    .title {
        margin: 0;
        font-size: 1.35rem;
        font-weight: 700
    }

    .sub {
        margin: 3px 0 0;
        color: #6c757d;
        font-size: .86rem
    }

    .actions {
        display: flex;
        gap: 6px;
        flex-wrap: wrap
    }

    .summary {
        display: flex;
        flex-wrap: wrap;
        gap: 10px 22px;
        padding: 10px 0 12px;
        border-top: 1px solid #e9ecef;
        border-bottom: 1px solid #e9ecef;
        margin-bottom: 12px
    }

        .summary div {
            display: flex;
            gap: 5px;
            align-items: baseline
        }

        .summary strong {
            font-size: 1rem
        }

        .summary span {
            font-size: .75rem;
            color: #6c757d
        }

    .periods {
        display: flex;
        gap: 6px;
        flex-wrap: wrap;
        margin-bottom: 12px
    }

        .periods .btn {
            font-size: .75rem
        }

    .section {
        padding: 14px 0;
        border-top: 1px solid #e9ecef
    }

    .section-head {
        display: flex;
        justify-content: space-between;
        gap: 8px;
        align-items: center;
        flex-wrap: wrap;
        margin-bottom: 9px
    }

    .section-title {
        font-size: .92rem;
        font-weight: 700;
        margin: 0
    }

    .section-sub {
        font-size: .73rem;
        color: #6c757d;
        margin: 2px 0 0
    }

    .client {
        border: 1px solid #e0e6ed;
        border-radius: 9px;
        margin-bottom: 10px;
        overflow: hidden
    }

    .client-head {
        display: grid;
        grid-template-columns: minmax(180px,1.5fr) 100px 120px 120px auto;
        gap: 10px;
        align-items: center;
        padding: 9px 10px;
        background: #f8fafc
    }

    .client-name {
        font-weight: 700;
        font-size: .84rem
    }

    .mini {
        font-size: .7rem;
        color: #6c757d
    }

    .table-wrap {
        overflow-x: auto
    }

    .table {
        font-size: .77rem;
        margin: 0
    }

        .table thead th {
            font-size: .67rem;
            text-transform: uppercase;
            background: #fbfcfd;
            white-space: nowrap
        }

    .exp {
        color: #dc3545;
        font-weight: 700
    }

    .folio {
        font-weight: 700
    }

    .empty {
        padding: 24px;
        text-align: center;
        color: #6c757d
    }

    .badge {
        font-size: .67rem
    }

    @@media (max-width:800px) {
        .client-head {
            grid-template-columns: 1fr 1fr
        }

            .client-head > *:last-child {
                grid-column: span 2
            }

        .page {
            padding: 14px 10px 24px
        }
    }


    /* =========================================================
           LOGISTICA ERP - CAPA VISUAL
           Mantiene la estructura y funcionalidad de la vista.
           ========================================================= */
    :root {
        --lg-blue: #173a7a;
        --lg-blue-2: #2f63ad;
        --lg-text: #172033;
        --lg-muted: #6d7888;
        --lg-border: #dce4ee;
        --lg-soft: #f6f8fb;
        --lg-shadow: 0 8px 24px rgba(22,42,75,.06);
    }

    .page {
        max-width: 1720px;
        margin: 0 auto;
        color: var(--lg-text);
    }

    .head {
        align-items: center;
        padding: 15px 17px;
        margin-bottom: 14px;
        border: 1px solid var(--lg-border);
        border-left: 4px solid var(--lg-blue);
        border-radius: 12px;
        background: #fff;
        box-shadow: var(--lg-shadow);
    }

    .title {
        color: var(--lg-text);
        font-size: 1.48rem;
        font-weight: 800;
        letter-spacing: -.02em;
    }

        .title i {
            color: var(--lg-blue);
        }

    .sub {
        color: var(--lg-muted);
        font-weight: 500;
    }

    .actions .btn {
        min-height: 34px;
        display: inline-flex;
        align-items: center;
        border-radius: 8px;
        font-weight: 600;
    }

    .summary {
        display: grid;
        grid-template-columns: repeat(6,minmax(130px,1fr));
        gap: 8px;
        padding: 0;
        border: 0;
        margin-bottom: 12px;
    }

        .summary > div {
            display: block;
            min-height: 72px;
            padding: 10px 12px;
            border: 1px solid var(--lg-border);
            border-radius: 10px;
            background: #fff;
            box-shadow: 0 4px 13px rgba(22,42,75,.035);
        }

        .summary strong {
            display: block;
            margin-bottom: 3px;
            color: var(--lg-blue);
            font-size: 1.22rem;
            font-weight: 800;
            line-height: 1.15;
        }

        .summary span {
            display: block;
            color: var(--lg-muted);
            font-size: .7rem;
            font-weight: 700;
            letter-spacing: .01em;
        }

    .periods {
        padding: 8px;
        border: 1px solid var(--lg-border);
        border-radius: 10px;
        background: #fff;
        box-shadow: 0 4px 13px rgba(22,42,75,.03);
    }

        .periods .btn,
        .periods .form-control,
        .periods .form-select {
            min-height: 32px;
            border-radius: 7px;
            font-weight: 600;
        }

    .section {
        margin-bottom: 12px;
        padding: 14px;
        border: 1px solid var(--lg-border);
        border-radius: 12px;
        background: #fff;
        box-shadow: var(--lg-shadow);
    }

        .section + .section {
            border-top: 1px solid var(--lg-border);
        }

    .section-head {
        padding-bottom: 9px;
        margin-bottom: 11px;
        border-bottom: 1px solid #e9eef4;
    }

    .section-title {
        position: relative;
        padding-left: 10px;
        color: var(--lg-text);
        font-size: .98rem;
        font-weight: 800;
    }

        .section-title::before {
            content: "";
            position: absolute;
            left: 0;
            top: 2px;
            width: 3px;
            height: 16px;
            border-radius: 5px;
            background: var(--lg-blue);
        }

    .section-sub {
        color: var(--lg-muted);
    }

    .client {
        border-color: #d9e2ec;
        border-radius: 10px;
        box-shadow: 0 3px 12px rgba(22,42,75,.025);
        transition: box-shadow .15s ease,border-color .15s ease;
    }

        .client:hover {
            border-color: #c7d5e6;
            box-shadow: 0 6px 16px rgba(22,42,75,.055);
        }

    .client-head {
        padding: 10px 12px;
        background: linear-gradient(180deg,#f8fafc,#f3f6f9);
        border-bottom: 1px solid #e6ebf1;
    }

    .client-name {
        color: #1d2a3b;
        font-size: .88rem;
        font-weight: 800;
    }

    .mini {
        color: var(--lg-muted);
        font-weight: 600;
    }

    .table-wrap {
        border: 1px solid #e2e8ef;
        border-radius: 9px;
        background: #fff;
        overflow-x: auto;
    }

    .table thead th {
        padding: .55rem .55rem;
        color: #536072;
        background: #f5f7fa;
        border-bottom: 1px solid #dce3eb;
        font-weight: 800;
        letter-spacing: .025em;
    }

    .table tbody td {
        padding: .52rem .55rem;
        border-color: #edf1f5;
        vertical-align: middle;
    }

    .table tbody tr:nth-child(even) td {
        background: #fbfcfd;
    }

    .table tbody tr:hover td {
        background: #f4f8fc;
    }

    .folio {
        color: var(--lg-blue);
        font-weight: 800;
    }

    .badge {
        border-radius: 6px;
        font-weight: 700;
    }

    .empty {
        margin: 3px;
        border: 1px dashed #d3dce7;
        border-radius: 9px;
        background: #fafbfd;
    }

    html[data-nsq-theme="dark"] .page {
        color: #e7edf6;
    }

    html[data-nsq-theme="dark"] .head,
    html[data-nsq-theme="dark"] .summary > div,
    html[data-nsq-theme="dark"] .periods,
    html[data-nsq-theme="dark"] .section,
    html[data-nsq-theme="dark"] .client,
    html[data-nsq-theme="dark"] .table-wrap {
        background: #111b2d;
        border-color: #2a3a50;
        box-shadow: none;
    }

    html[data-nsq-theme="dark"] .title,
    html[data-nsq-theme="dark"] .section-title,
    html[data-nsq-theme="dark"] .client-name {
        color: #eef4fb;
    }

    html[data-nsq-theme="dark"] .client-head,
    html[data-nsq-theme="dark"] .table thead th {
        background: #162237;
        border-color: #2a3a50;
        color: #cbd7e6;
    }

    html[data-nsq-theme="dark"] .table tbody td {
        border-color: #243349;
    }

    html[data-nsq-theme="dark"] .table tbody tr:nth-child(even) td {
        background: #101a2a;
    }

    html[data-nsq-theme="dark"] .table tbody tr:hover td {
        background: #17253a;
    }

    html[data-nsq-theme="dark"] .sub,
    html[data-nsq-theme="dark"] .section-sub,
    html[data-nsq-theme="dark"] .mini,
    html[data-nsq-theme="dark"] .summary span {
        color: #9eacbf;
    }

    @@media (max-width:1100px) {
        .summary {
            grid-template-columns: repeat(3,minmax(0,1fr));
        }
    }

    @@media (max-width:650px) {
        .summary {
            grid-template-columns: repeat(2,minmax(0,1fr));
        }

        .head {
            padding: 12px;
        }

        .section {
            padding: 11px;
        }
    }

</style>
<div class="page">
    <div class="head"><div><h1 class="title"><i class="fa-solid fa-truck-ramp-box me-1"></i>Embarques</h1><p class="sub">Programación por cliente, preparación, salida y entrega de producto terminado.</p></div><div class="actions"><a asp-action="Crear" class="btn btn-primary btn-sm"><i class="fa-solid fa-plus me-1"></i>Nuevo embarque</a><a asp-action="Calendario" class="btn btn-outline-secondary btn-sm"><i class="fa-solid fa-calendar-days me-1"></i>Calendario</a><a asp-controller="LogisticaCatalogos" asp-action="Index" class="btn btn-outline-secondary btn-sm">Catálogos</a></div></div>
    @if (TempData["LogisticaOk"] != null)
    {
        <div class="alert alert-success py-2 px-3">@TempData["LogisticaOk"]</div>
    }
    @if (TempData["LogisticaError"] != null)
    {
        <div class="alert alert-danger py-2 px-3">@TempData["LogisticaError"]</div>
    }
    <div class="summary"><div><strong>@grupos.Count</strong><span>clientes por programar</span></div><div><strong>@Model.PiezasPendientes.ToString("N0")</strong><span>pzas pendientes</span></div><div><strong>@Model.PiezasPTListas.ToString("N0")</strong><span>PT disponible</span></div><div><strong>@Model.EmbarquesActivos</strong><span>embarques activos</span></div><div><strong class="text-danger">@Model.EntregasAtrasadas</strong><span>expeditados</span></div><div><strong>@Model.EmbarquesEnRuta</strong><span>en ruta</span></div></div>
    <div class="periods">
        <a asp-action="Index" asp-route-periodo="vencidos" class="btn btn-outline-danger @(periodo == "vencidos" ? "active" : "")">Expeditados</a><a asp-action="Index" asp-route-periodo="hoy" class="btn btn-outline-secondary @(periodo == "hoy" ? "active" : "")">Hoy</a><a asp-action="Index" asp-route-periodo="semana" class="btn btn-outline-secondary @(periodo == "semana" ? "active" : "")">Semana</a><a asp-action="Index" asp-route-periodo="mes" class="btn btn-outline-secondary @(periodo == "mes" ? "active" : "")">Mes</a><form asp-action="Index" method="get" class="d-flex gap-1">
            <input type="hidden" name="periodo" value="seleccionar_mes" /><select name="mes" class="form-select form-select-sm">
                @for (var i = 1; i <= 12; i++)
                {
                    <option value="@i" selected="@(i == mes ? "selected" : null)">@(new DateTime(2026, i, 1).ToString("MMMM"))</option>
                }
            </select><input name="anio" type="number" min="2020" max="2100" value="@anio" class="form-control form-control-sm" style="width:90px" /><button class="btn btn-dark btn-sm">Ir</button>
        </form>
    </div>
    <div class="section">
        <div class="section-head"><div><h2 class="section-title">Pendientes por cliente</h2><p class="section-sub">Cada cliente puede consolidar varias partes/OF en un solo embarque.</p></div><span class="badge bg-light text-dark">@grupos.Count cliente(s)</span></div>
        @if (grupos.Count == 0)
        {
            <div class="empty">No hay entregas pendientes para el periodo seleccionado.</div>
        }
        else
        {
            @foreach (var g in grupos)
            {
                var piezas = g.Sum(x => x.PendienteProgramar); var cajas = g.Sum(x => x.CajasPTDisponibles); var exp = g.Any(x => x.FechaEntrega.Date < DateTime.Today);
                <div class="client">
                    <div class="client-head">
                        <div>
                            <div class="client-name">
                                @g.Key.Cliente @if(exp){
                                <span class="badge bg-danger ms-1">Expeditado</span>
                            }
                        </div><div class="mini">@g.Count() entrega(s) / parte(s) pendientes</div>
                    </div><div><div class="mini">Pendiente</div><strong>@piezas.ToString("N0")</strong></div><div><div class="mini">Cajas PT</div><strong>@cajas.ToString("N0")</strong></div><div><div class="mini">Próxima entrega</div><strong>@g.Min(x => x.FechaEntrega).ToString("dd/MM/yyyy")</strong></div><div class="text-end">
                        @if (g.Key.ClienteID > 0)
                        {
                            <a asp-action="Crear" asp-route-clienteId="@g.Key.ClienteID" class="btn btn-primary btn-sm"><i class="fa-solid fa-calendar-plus me-1"></i>Programar cliente</a>
                        }
                    </div>
                </div><div class="table-wrap">
                    <table class="table table-sm">
                        <thead><tr><th>Parte</th><th>Descripción</th><th>OF</th><th>Entrega</th><th class="text-end">Pendiente</th><th class="text-end">PT disponible</th><th class="text-end">Cajas</th></tr></thead>
                        <tbody>
                            @foreach (var d in g.OrderBy(x => x.FechaEntrega))
                            {
                                var dexp = d.FechaEntrega.Date < DateTime.Today;
                                <tr><td class="fw-semibold">@d.NumeroParte</td><td>@(string.IsNullOrWhiteSpace(d.Descripcion) ? "-" : d.Descripcion)</td><td>@(string.IsNullOrWhiteSpace(d.NumeroOF) ? "-" : d.NumeroOF)</td><td class="@(dexp ? "exp" : "")">@d.FechaEntrega.ToString("dd/MM/yyyy") @(dexp ? "· EXPEDITADO" : "")</td><td class="text-end fw-semibold">@d.PendienteProgramar.ToString("N0")</td><td class="text-end">@d.PiezasPTDisponibles.ToString("N0")</td><td class="text-end">@d.CajasPTDisponibles.ToString("N0")</td></tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        }
                }
    </div>
    <div class="section">
        <div class="section-head"><div><h2 class="section-title">Embarques programados</h2><p class="section-sub">Seguimiento por cliente y fecha comprometida de entrega.</p></div><span class="badge bg-light text-dark">@Model.Embarques.Count</span></div><div class="table-wrap">
            <table class="table table-sm table-hover">
                <thead><tr><th>Folio</th><th>Cliente</th><th>Destino</th><th>Carga</th><th>Entrega</th><th>Partidas</th><th>Piezas</th><th>Estatus</th><th></th></tr></thead>
                <tbody>
                    @foreach (var e in Model.Embarques)
                    {
                        var exp = e.Estatus is not "Entregado" and not "Cancelado" && e.FechaEntregaProgramada.HasValue && e.FechaEntregaProgramada.Value.Date < DateTime.Today;
                        <tr><td class="folio">@e.Folio</td><td>@e.Cliente</td><td>@e.Destino</td><td>@FH(e.FechaCargaProgramada, e.HoraCargaProgramada)</td><td class="@(exp ? "exp" : "")">@FH(e.FechaEntregaProgramada, e.HoraEntregaProgramada) @(exp ? "· EXPEDITADO" : "")</td><td class="text-center">@e.TotalPartidas</td><td class="text-end">@e.TotalPiezasSolicitadas.ToString("N0")</td><td><span class="badge @(exp ? "bg-danger" : Badge(e.Estatus))">@(exp ? "Expeditado" : e.Estatus)</span></td><td class="text-end"><a asp-action="Detalle" asp-route-id="@e.EmbarqueID" class="btn btn-outline-primary btn-sm"><i class="fa-solid fa-eye"></i></a></td></tr>
                    }
                    @if (Model.Embarques.Count == 0)
                    {
                        <tr><td colspan="9" class="empty">No hay embarques registrados.</td></tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>
