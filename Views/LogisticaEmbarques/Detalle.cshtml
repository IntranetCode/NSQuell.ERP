        .checklist, .doc-required {
            grid-template-columns: 1fr
        }

        .header-actions {
            width: 100%
        }

            .header-actions .btn {
                flex: 1
            }

        .history-row {
            display: block
        }

        .history-date, .history-user {
            display: block;
            margin-bottom: 3px
        }
    }

