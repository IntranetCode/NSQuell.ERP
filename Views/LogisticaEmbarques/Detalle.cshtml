    }

    html[data-nsq-theme="dark"] .info-box, html[data-nsq-theme="dark"] .scan-item, html[data-nsq-theme="dark"] .load-kpi, html[data-nsq-theme="dark"] .check-item, html[data-nsq-theme="dark"] .doc-required-item {
