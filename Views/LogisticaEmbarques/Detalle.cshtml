    .history-date, .history-user {
        color: #6c757d
    }

    .danger-zone {
        padding-top: 14px;
        border-top: 1px solid #f1b0b7
    }

    @@media(max-width:900px) {
        .i2, .i3, .i4, .i6, .i8, .f2, .f3, .f4, .f5, .f6, .f8, .f10 {
            grid-column: span 6
        }

        .doc-required {
            grid-template-columns: repeat(2,minmax(0,1fr))
        }

        .history-row {
            grid-template-columns: 125px 140px 1fr
        }

        .history-user {
            display: none
        }
    }

    @@media(max-width:600px) {
        .detalle-page {
            padding: 14px 10px 24px
        }

