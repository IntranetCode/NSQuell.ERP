        background: #162237;
        border-color: #2a3a50;
    }

    html[data-nsq-theme="dark"] .compact-table thead th {
        background: #162237;
        color: #cbd7e6;
    }

    html[data-nsq-theme="dark"] .compact-table tbody td {
        border-color: #243349;
    }

    html[data-nsq-theme="dark"] .form-grid .form-control,
