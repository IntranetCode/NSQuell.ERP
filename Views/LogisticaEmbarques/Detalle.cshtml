            let modalCargaRapida = null;
            document.getElementById('lgAbrirCargaRapida')?.addEventListener('click', () => { const el = document.getElementById('modalCargaRapidaDetalle'); if (!el) return; modalCargaRapida = bootstrap.Modal.getOrCreateInstance(el); modalCargaRapida.show(); });
            document.getElementById('formCargaRapidaDetalle')?.addEventListener('submit', async e => {
                e.preventDefault();
                if (!rowVersionActual) { try { await cargarCargaFisica(); } catch (err) { alert(err.message); return; } }
                const form = e.currentTarget, motivo = form.querySelector('[name="motivo"]')?.value?.trim() || '', acepta = document.getElementById('lgCargaRapidaResponsabilidad')?.checked === true;
                const archivos = [...(document.getElementById('lgCargaRapidaCamara')?.files || []), ...(document.getElementById('lgCargaRapidaGaleria')?.files || [])];
                if (!motivo) { alert('Captura el motivo de la Carga rápida.'); return; } if (!acepta) { alert('Confirma la responsabilidad de la Carga rápida.'); return; } if (!archivos.length) { alert('Adjunta al menos una fotografía.'); return; }
                const btn = document.getElementById('lgConfirmarCargaRapida'), original = btn.innerHTML, fd = new FormData(); fd.append('__RequestVerificationToken',token); fd.append('embarqueId',String(embarqueId)); fd.append('rowVersion',rowVersionActual); fd.append('motivo',motivo); fd.append('aceptaResponsabilidad','true'); archivos.forEach(x => fd.append('evidencias',x,x.name));
