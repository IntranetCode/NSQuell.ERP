@using ERP.NSQuell.Models.ViewModels.Logistica
@model LogisticaDetalleVm
@{
    Layout = "~/Views/Shared/_Layout.cshtml";
    ViewData["Title"] = $"Embarque {Model.Folio}";
    string BadgeEstatus(string estatus) => estatus switch
    {
        "Programado" => "bg-primary",
        "Preparando" => "bg-info text-dark",
        "Preparado" => "bg-warning text-dark",
        "Cargado" => "bg-dark",
        "En ruta" => "bg-primary",
        "Entregado" => "bg-success",
        "Cancelado" => "bg-secondary",
        _ => "bg-light text-dark"
    };
    string BadgeSeveridad(string severidad) => severidad switch
    {
        "Crítica" => "bg-danger",
        "Alta" => "bg-warning text-dark",
        "Media" => "bg-info text-dark",
        "Baja" => "bg-secondary",
        _ => "bg-light text-dark"
    };
    string TextoFechaHora(DateTime? fecha, TimeSpan? hora)
    {
        if (!fecha.HasValue) return "-";
        return hora.HasValue ? $"{fecha.Value:dd/MM/yyyy} {hora.Value:hh\\:mm}" : fecha.Value.ToString("dd/MM/yyyy");
    }
    string FormaEnvioTexto() => Model.FormaEnvio switch
    {
        "Interno" => "Interno",
        "Cliente" => "Cliente recoge",
        "Paqueteria" => "Paquetería",
        _ => string.IsNullOrWhiteSpace(Model.FormaEnvio) ? "-" : Model.FormaEnvio
    };
    var puedePreparar = Model.Estatus is "Programado" or "Preparando";
    var puedeEntregar = Model.Estatus == "En ruta";
    var puedeCancelar = Model.Estatus is "Programado" or "Preparando" or "Preparado";
    var puedeReprogramar = Model.Estatus is "Programado" or "Preparando" or "Preparado";
    var puedeEditarCajas = Model.Estatus is "Programado" or "Preparando";
    var puedeAgregarPartida = Model.Estatus is "Programado" or "Preparando";
}
@section Styles {
    <link rel="stylesheet" href="~/css/logistica.css" asp-append-version="true" />
}
<style>
    :root {
        --lg-blue: #173a7a;
        --lg-text: #172033;
        --lg-muted: #6d7888;
        --lg-border: #dce4ee;
        --lg-soft: #f7f9fc;
        --lg-danger: #b42318;
        --lg-ok: #17633a;
        --lg-shadow: 0 8px 24px rgba(22,42,75,.055)
    }

    .detalle-page {
        max-width: 1760px;
        margin: 0 auto;
        padding: 18px 20px 32px;
        color: var(--lg-text)
    }

    .detalle-header {
        display: flex;
        justify-content: space-between;
        align-items: center;
        gap: 12px;
        flex-wrap: wrap;
        padding: 15px 17px;
        margin-bottom: 12px;
        border: 1px solid var(--lg-border);
        border-left: 4px solid var(--lg-blue);
        border-radius: 12px;
        background: #fff;
        box-shadow: var(--lg-shadow)
    }

    .detalle-title {
        margin: 0;
        font-size: 1.5rem;
        font-weight: 800
    }

        .detalle-title i {
            color: var(--lg-blue)
        }

    .detalle-subtitle {
        margin: 3px 0 0;
        color: var(--lg-muted);
        font-size: .86rem
    }

    .header-actions {
        display: flex;
        gap: 7px;
        flex-wrap: wrap
    }

        .header-actions .btn {
            min-height: 35px;
            border-radius: 8px;
            font-weight: 650
        }

    .status-strip {
        display: grid;
        grid-template-columns: repeat(auto-fit,minmax(145px,1fr));
        gap: 8px;
        margin-bottom: 10px
    }

    .status-item {
        min-height: 67px;
        padding: 9px 11px;
        border: 1px solid var(--lg-border);
        border-radius: 10px;
        background: #fff;
        box-shadow: 0 4px 13px rgba(22,42,75,.03)
    }

        .status-item span {
            display: block;
            margin-bottom: 3px;
            color: var(--lg-muted);
            font-size: .68rem;
            font-weight: 700
        }

        .status-item strong {
            display: block;
            font-size: .98rem;
            font-weight: 800
        }

    .progress-line {
        height: 6px;
        margin: 8px 1px 15px;
        background: #e6ebf1;
        border-radius: 999px;
        overflow: hidden
    }

        .progress-line > div {
            height: 100%;
            background: linear-gradient(90deg,#173a7a,#3b72c5)
        }

    .section {
        margin-bottom: 12px;
        padding: 14px 15px 13px;
        border: 1px solid var(--lg-border);
        border-radius: 12px;
        background: #fff;
        box-shadow: var(--lg-shadow)
    }

    .section-head {
        display: flex;
        justify-content: space-between;
        align-items: center;
        gap: 8px;
        flex-wrap: wrap;
        margin-bottom: 9px;
        padding-bottom: 8px;
        border-bottom: 1px solid #e7edf3
    }

    .section-title {
        display: flex;
        align-items: center;
        gap: 8px;
        margin: 0;
        color: var(--lg-text);
        font-size: .98rem;
        font-weight: 800
    }

        .section-title:before {
            content: "";
            width: 4px;
            height: 18px;
            border-radius: 8px;
            background: var(--lg-blue)
        }

    .section-subtitle {
        margin: 2px 0 0 12px;
        color: var(--lg-muted);
        font-size: .73rem
    }

    .info-grid {
        display: grid;
        grid-template-columns: repeat(12,1fr);
        gap: 10px
    }

    .i3 {
        grid-column: span 3
    }

    .i4 {
        grid-column: span 4
    }

    .i6 {
        grid-column: span 6
    }

    .i12 {
        grid-column: span 12
    }

    .info-grid > div {
        min-height: 60px;
        padding: 9px 10px;
        border: 1px solid #edf1f5;
        border-radius: 8px;
        background: #fbfcfd
    }

    .info-label {
        margin-bottom: 2px;
        color: #798495;
        font-size: .68rem;
        font-weight: 750;
        text-transform: uppercase
    }

    .info-value {
        color: #263448;
        font-size: .86rem;
        font-weight: 650;
        word-break: break-word
    }

    .visual-only {
        display: inline-flex;
        margin-left: 5px;
        padding: 2px 6px;
        border-radius: 999px;
        background: #eef2f6;
        color: #5e6b7c;
        font-size: .6rem;
        font-weight: 800;
        text-transform: uppercase
    }

    .form-grid {
        display: grid;
        grid-template-columns: repeat(12,1fr);
        gap: 9px;
        align-items: end
    }

    .f2 {
        grid-column: span 2
    }

    .f3 {
        grid-column: span 3
    }

    .f4 {
        grid-column: span 4
    }

    .f6 {
        grid-column: span 6
    }

    .f8 {
        grid-column: span 8
    }

    .f10 {
        grid-column: span 10
    }

    .f12 {
        grid-column: span 12
    }

    .form-grid label {
        display: block;
        margin-bottom: 3px;
        color: #465164;
        font-size: .71rem;
        font-weight: 700
    }

    .form-grid .form-control, .form-grid .form-select {
        min-height: 37px;
        border-color: #d3dde8;
        border-radius: 8px;
        font-size: .8rem
    }

    .required:after {
        content: " *";
        color: #dc3545;
        font-weight: 800
    }

    .table-wrap {
        width: 100%;
        overflow-x: auto;
        border: 1px solid #dfe6ee;
        border-radius: 9px;
        background: #fff
    }

    .compact-table {
        margin-bottom: 0;
        font-size: .78rem;
        vertical-align: middle
    }

        .compact-table thead th {
            padding: .54rem;
            background: #f4f7fa;
            color: #536072;
            font-size: .68rem;
            font-weight: 800;
            text-transform: uppercase;
            white-space: nowrap
        }

        .compact-table tbody td {
            padding: .52rem;
            border-color: #edf0f4
        }

        .compact-table tbody tr:nth-child(even) td {
            background: #fbfcfd
        }

    .empty {
        padding: 22px 10px;
        text-align: center;
        color: #6c757d;
        font-size: .8rem
    }

    .badge-mini {
        font-size: .67rem;
        padding: .34em .54em
    }

    .checklist {
        display: grid;
        grid-template-columns: repeat(2,minmax(0,1fr));
        gap: 8px 16px
    }

    .check-item {
        display: flex;
        gap: 8px;
        align-items: flex-start;
        min-height: 58px;
        padding: 9px 10px;
        border: 1px solid #dfe6ee;
        border-radius: 9px;
        background: #fafbfd
    }

        .check-item strong {
            display: block;
            font-size: .79rem
        }

        .check-item small {
            display: block;
            color: #6c757d;
            font-size: .71rem
        }

    .doc-required {
        display: grid;
        grid-template-columns: repeat(4,minmax(0,1fr));
        gap: 8px;
        margin-bottom: 10px
    }

    .doc-required-item {
        min-height: 76px;
        padding: 9px 10px;
        border: 1px solid #dfe6ee;
        border-radius: 9px;
        background: #fafbfd;
        font-size: .75rem
    }

    .doc-note {
        margin-bottom: 10px;
        padding: 9px 11px;
        border: 1px dashed #cbd8e6;
        border-radius: 9px;
        background: #f8fbff;
        color: #56667b;
        font-size: .74rem
    }

    .history-row {
        display: grid;
        grid-template-columns: 145px 160px 1fr 150px;
        gap: 10px;
        padding: 10px;
        border-bottom: 1px solid #e9edf2;
        border-left: 3px solid #d7e1ec;
        background: #fbfcfd;
        font-size: .77rem
    }

    .history-date, .history-user {
        color: #798394
    }

    .danger-zone {
        margin-top: 14px;
        padding: 14px;
        border: 1px solid #efc5ca;
        border-radius: 12px;
        background: #fff8f8
    }

    .lg-ops {
        margin: 0 0 14px;
        padding: 16px;
        border: 1px solid #cfdbea;
        border-radius: 14px;
        background: linear-gradient(135deg,#f8fbff,#fff);
        box-shadow: 0 10px 30px rgba(23,58,122,.07)
    }

    .lg-ops-head {
        display: flex;
        justify-content: space-between;
        align-items: flex-start;
        gap: 14px;
        margin-bottom: 12px
    }

    .lg-ops-kicker {
        font-size: .68rem;
        font-weight: 800;
        letter-spacing: .05em;
        text-transform: uppercase;
        color: #5d6d83
    }

    .lg-ops-title {
        margin: 2px 0 0;
        font-size: 1.08rem;
        font-weight: 850;
        color: var(--lg-blue)
    }

    .lg-ops-sub {
        margin: 3px 0 0;
        font-size: .76rem;
        color: #68778a
    }

    .lg-steps {
        display: grid;
        grid-template-columns: repeat(5,1fr);
        gap: 7px;
        margin-bottom: 13px
    }

    .lg-step {
        padding: 9px 10px;
        border: 1px solid #dce5ef;
        border-radius: 9px;
        background: #fff
    }

        .lg-step span {
            display: block;
            font-size: .63rem;
            color: #7b8797;
            text-transform: uppercase
        }

        .lg-step strong {
            display: block;
            margin-top: 2px;
            font-size: .76rem;
            color: #3b485a
        }

        .lg-step.done {
            border-color: #b9d7ca;
            background: #f5fbf8
        }

            .lg-step.done strong {
                color: #17633a
            }

        .lg-step.current {
            border-color: #7fa0cf;
            background: #f1f6fd;
            box-shadow: inset 3px 0 0 var(--lg-blue)
        }

            .lg-step.current strong {
                color: var(--lg-blue)
            }

    .lg-primary-action {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 14px;
        padding: 13px;
        border: 1px solid #d9e3ef;
        border-radius: 11px;
        background: #fff
    }

    .lg-primary-copy strong {
        display: block;
        font-size: .9rem
    }

    .lg-primary-copy small {
        display: block;
        margin-top: 3px;
        color: #6d7a8d;
        font-size: .72rem
    }

    .lg-op-btn {
        min-height: 43px;
        padding: 0 18px;
        border: 0;
        border-radius: 9px;
        background: #0f4f91;
        color: #fff;
        font-weight: 800;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: 8px;
        text-decoration: none
    }

        .lg-op-btn.secondary {
            background: #fff;
            color: var(--lg-blue);
            border: 1px solid #9fb5d0
        }

    .lg-scan {
        margin-top: 12px;
        padding: 12px;
        border: 1px solid #cfdaea;
        border-radius: 10px;
        background: #f8fbff
    }

    .lg-scan-row {
        display: grid;
        grid-template-columns: minmax(0,1fr) auto;
        gap: 9px
    }

    .lg-scan-input {
        min-height: 45px;
        border: 2px solid #8faad0;
        border-radius: 9px;
        padding: 8px 12px;
        font-weight: 750
    }

    .lg-scan-msg {
        margin-top: 6px;
        font-size: .72rem;
        color: #66778c
    }

        .lg-scan-msg.ok {
            color: #17633a
        }

        .lg-scan-msg.error {
            color: #b42318
        }

    .lg-box-confirm-list {
        display: grid;
        gap: 7px;
        margin-top: 10px
    }

    .lg-salida-box {
        display: grid;
        grid-template-columns: 34px minmax(220px,1fr) minmax(120px,.55fr) 100px;
        align-items: center;
        gap: 10px;
        padding: 9px 10px;
        border: 1px solid #dce4ee;
        border-radius: 9px;
        background: #fff
    }

        .lg-salida-box.checked {
            border-color: #72a08a;
            background: #f5fbf8
        }

        .lg-salida-box small {
            display: block;
            color: #7a8798;
            font-size: .67rem
        }

        .lg-salida-box .qty {
            text-align: right;
            color: var(--lg-blue);
            font-weight: 850
        }

    .lg-scan-check {
        width: 20px;
        height: 20px
    }

    .collapse-btn {
        margin-left: auto;
        min-height: 30px;
        padding: 0 10px;
        border: 1px solid #ccd7e4;
        border-radius: 7px;
        background: #fff;
        color: #43546a;
        font-size: .7rem;
        font-weight: 750
    }

    .collapsed-section > :not(.section-head) {
        display: none !important
    }

    @@media(max-width:900px) {
        .i3, .i4, .i6, .f2, .f3, .f4, .f6, .f8, .f10 {
            grid-column: span 6
        }

        .doc-required {
            grid-template-columns: repeat(2,minmax(0,1fr))
        }

        .history-row {
            grid-template-columns: 125px 140px 1fr
        }

        .history-user {
            display: none
        }

        .lg-steps {
            grid-template-columns: 1fr 1fr
        }
    }

    @@media(max-width:600px) {
        .detalle-page {
            padding: 12px 8px 24px
        }

        .i3, .i4, .i6, .i12, .f2, .f3, .f4, .f6, .f8, .f10, .f12 {
            grid-column: span 12
        }

        .checklist, .doc-required {
            grid-template-columns: 1fr
        }

        .status-strip {
            grid-template-columns: repeat(2,minmax(0,1fr))
        }

        .header-actions {
            width: 100%
        }

            .header-actions .btn {
                flex: 1
            }

        .history-row {
            display: block
        }

        .history-date, .history-user {
            display: block;
            margin-bottom: 3px
        }

        .lg-primary-action {
            align-items: stretch;
            flex-direction: column
        }

        .lg-op-btn {
            width: 100%
        }

        .lg-scan-row {
            grid-template-columns: 1fr
        }

        .lg-salida-box {
            grid-template-columns: 30px 1fr 85px
        }
    }
</style>

<div class="detalle-page">
    <div class="detalle-header">
        <div>
            <h1 class="detalle-title"><i class="fa-solid fa-truck-ramp-box me-1"></i>@Model.Folio</h1>
            <p class="detalle-subtitle">@Model.Cliente · @Model.Destino</p>
        </div>
        <div class="header-actions">
            <a asp-controller="LogisticaEmbarques" asp-action="Index" class="btn btn-outline-secondary btn-sm"><i class="fa-solid fa-arrow-left me-1"></i>Regresar</a>
            <a asp-controller="LogisticaEmbarques" asp-action="Calendario" class="btn btn-outline-secondary btn-sm"><i class="fa-solid fa-calendar-days me-1"></i>Calendario</a>
        </div>
    </div>

    @if (TempData["LogisticaOk"] != null)
    {
        <div class="alert alert-success py-2 px-3 mb-3">@TempData["LogisticaOk"]</div>
    }
    @if (TempData["LogisticaError"] != null)
    {
        <div class="alert alert-danger py-2 px-3 mb-3">@TempData["LogisticaError"]</div>
    }

    <div class="status-strip">
        <div class="status-item"><span>Estatus</span><strong><span class="badge @BadgeEstatus(Model.Estatus)">@Model.Estatus</span></strong></div>
        <div class="status-item"><span>Avance</span><strong>@Model.PorcentajeAvance%</strong></div>
        <div class="status-item"><span>Preparado</span><strong>@Model.TotalPiezasPreparadas.ToString("N0") / @Model.TotalPiezasSolicitadas.ToString("N0")</strong></div>
        <div class="status-item"><span>Cajas</span><strong>@Model.TotalCajasAsignadas</strong></div>
        <div class="status-item"><span>Cargadas</span><strong>@Model.TotalCajasCargadas</strong></div>
        @if (Model.IncidenciasAbiertas > 0)
        {
            <div class="status-item text-danger"><span>Incidencias</span><strong>@Model.IncidenciasAbiertas</strong></div>
        }
        @if (Model.EnRiesgo)
        {
            <div class="status-item text-danger"><span>Riesgo de carga</span><strong>@Model.MensajeRiesgo</strong></div>
        }
    </div>
    <div class="progress-line"><div style="width:@Math.Clamp(Model.PorcentajeAvance, 0, 100)%"></div></div>

    <section class="lg-ops">
        <div class="lg-ops-head">
            <div><div class="lg-ops-kicker">Control operativo</div><h2 class="lg-ops-title">@Model.ProximaAccion</h2><p class="lg-ops-sub">@Model.ProximaAccionDetalle</p></div>
            <span class="badge @BadgeEstatus(Model.Estatus)">@Model.Estatus</span>
        </div>
        <div class="lg-steps">
            <div class="lg-step @(Model.Estatus is "Preparando" or "Preparado" or "Cargado" or "En ruta" or "Entregado" ? "done" : "current")"><span>1</span><strong>Programado</strong></div>
            <div class="lg-step @(Model.Estatus is "Preparado" or "Cargado" or "En ruta" or "Entregado" ? "done" : Model.Estatus == "Preparando" ? "current" : "")"><span>2</span><strong>Preparación</strong></div>
            <div class="lg-step @(Model.Estatus is "Cargado" or "En ruta" or "Entregado" ? "done" : Model.Estatus == "Preparado" ? "current" : "")"><span>3</span><strong>Verificar cajas</strong></div>
            <div class="lg-step @(Model.Estatus is "En ruta" or "Entregado" ? "done" : Model.Estatus == "Cargado" ? "current" : "")"><span>4</span><strong>Salida</strong></div>
            <div class="lg-step @(Model.Estatus == "Entregado" ? "done" : Model.Estatus == "En ruta" ? "current" : "")"><span>5</span><strong>Entrega</strong></div>
        </div>

        @if (Model.Estatus is "Programado" or "Preparando")
        {
            <div class="lg-primary-action">
                <div class="lg-primary-copy"><strong>Confirmar preparación completa</strong><small>@Model.TotalPiezasPreparadas.ToString("N0") de @Model.TotalPiezasSolicitadas.ToString("N0") PZA asignadas.</small></div>
                <form asp-controller="LogisticaEmbarques" asp-action="MarcarPreparado" method="post">@Html.AntiForgeryToken()<input type="hidden" name="embarqueId" value="@Model.EmbarqueID" /><button class="lg-op-btn" type="submit" onclick="return confirm('¿Confirmar preparación completa?');">Confirmar preparación</button></form>
            </div>
        }
        else if (Model.Estatus == "Preparado")
        {
            <form asp-controller="LogisticaEmbarques" asp-action="ConfirmarSalidaViajeDesdePT" method="post" id="lgSalidaForm">
                @Html.AntiForgeryToken()<input type="hidden" name="embarqueId" value="@Model.EmbarqueID" />
                <div class="lg-primary-action">
                    <div class="lg-primary-copy"><strong>Escanea las cajas que realmente van a salir</strong><small>Deben coincidir exactamente con las cajas programadas. La salida física PT se registra al confirmar.</small></div>
                    <button class="lg-op-btn" id="lgConfirmarSalida" type="submit" disabled><i class="fa-solid fa-truck-fast"></i>Confirmar salida de planta</button>
                </div>
                <div class="lg-scan">
                    <div class="lg-scan-row"><input id="lgSalidaScan" class="lg-scan-input" type="text" autocomplete="off" inputmode="none" placeholder="Escanea etiqueta de caja y presiona Enter/Tab..." autofocus /><button type="button" class="lg-op-btn secondary" id="lgLimpiarSalida">Limpiar</button></div>
                    <div class="lg-scan-msg" id="lgSalidaMsg">0 de @Model.CajasAsignadas.Count caja(s) confirmadas.</div>
                    <div class="lg-box-confirm-list">
                        @foreach (var c in Model.CajasAsignadas)
                        {
                            <label class="lg-salida-box" data-caja-id="@c.CajaID" data-numero-caja="@c.NumeroCaja" data-etiqueta="@c.Etiqueta" data-lote="@c.Lote">
                                <input class="lg-scan-check" type="checkbox" name="cajaIdsConfirmadas" value="@c.CajaID" />
                                <div><strong>Caja #@c.NumeroCaja · @c.NumeroParte</strong><small>@c.Etiqueta</small></div>
                                <div><strong>@(string.IsNullOrWhiteSpace(c.Lote) ? "Sin lote" : c.Lote)</strong><small>OF @c.NumeroOF</small></div>
                                <div class="qty">@c.CantidadAsignada.ToString("N0") PZA</div>
                            </label>
                        }
                    </div>
                </div>
            </form>
        }
        else if (Model.Estatus == "Cargado")
        {
            <div class="lg-primary-action">
                <div class="lg-primary-copy"><strong>Producto cargado</strong><small>La salida permanece bloqueada hasta completar documentación y checklist.</small></div>
                @if (Model.PuedeSalir)
                {
                    <form asp-controller="LogisticaEmbarques" asp-action="Despachar" method="post">@Html.AntiForgeryToken()<input type="hidden" name="embarqueId" value="@Model.EmbarqueID" /><button class="lg-op-btn" type="submit" onclick="return confirm('¿Confirmar salida del embarque?');">Confirmar salida</button></form>
                }
                else
                {

                    <span class="text-warning fw-semibold">Salida bloqueada por checklist/documentación.</span>
                }
            </div>
        }
        else if (Model.Estatus == "En ruta")
        {
            <div class="lg-primary-action"><div class="lg-primary-copy"><strong>Embarque en tránsito</strong><small>El siguiente paso es confirmar la entrega.</small></div><a href="#lgEntrega" class="lg-op-btn">Ir a entrega</a></div>
        }
        else if (Model.Estatus == "Entregado")
        {
            <div class="lg-primary-action"><div class="lg-primary-copy"><strong>Embarque completado</strong><small>La entrega está cerrada y conserva su trazabilidad.</small></div></div>
        }
    </section>

    <div class="section">
        <div class="section-head"><div><h2 class="section-title">Datos del embarque</h2><p class="section-subtitle">La fecha de carga es el dato operativo; la fecha de entrega se muestra solo como referencia del Release.</p></div></div>
        <div class="info-grid">
            <div class="i3"><div class="info-label">Cliente</div><div class="info-value">@Model.Cliente</div></div>
            <div class="i3"><div class="info-label">Destino</div><div class="info-value">@Model.Destino</div></div>
            <div class="i3"><div class="info-label">Operación</div><div class="info-value">@Model.TipoOperacion</div></div>
            <div class="i3"><div class="info-label">Recolección</div><div class="info-value">@FormaEnvioTexto()</div></div>
            <div class="i6"><div class="info-label">Dirección</div><div class="info-value">@(string.IsNullOrWhiteSpace(Model.DireccionEntrega) ? "-" : Model.DireccionEntrega)</div></div>
            <div class="i3"><div class="info-label">Carga programada</div><div class="info-value">@TextoFechaHora(Model.FechaCargaProgramada, Model.HoraCargaProgramada)</div></div>
            <div class="i3"><div class="info-label">Fecha entrega <span class="visual-only">Visual</span></div><div class="info-value">@(Model.FechaEntregaProgramada?.ToString("dd/MM/yyyy") ?? "-")</div></div>

            @if (Model.FormaEnvio == "Interno")
            {
                <div class="i4"><div class="info-label">Ruta</div><div class="info-value">@(string.IsNullOrWhiteSpace(Model.Ruta) ? "Pendiente" : Model.Ruta)</div></div>
                <div class="i4"><div class="info-label">Unidad</div><div class="info-value">@Model.VehiculoMostrar</div></div>
                <div class="i4"><div class="info-label">Chofer</div><div class="info-value">@Model.ChoferMostrar</div></div>
            }
            else if (Model.FormaEnvio == "Cliente")
            {
                <div class="i4"><div class="info-label">Persona / transportista que recoge</div><div class="info-value">@Model.ChoferMostrar</div></div>
                <div class="i4"><div class="info-label">Vehículo</div><div class="info-value">@Model.VehiculoMostrar</div></div>
            }
            else if (Model.FormaEnvio == "Paqueteria")
            {
                <div class="i3"><div class="info-label">Modalidad</div><div class="info-value">@(string.IsNullOrWhiteSpace(Model.ModalidadEnvio) ? "Pendiente" : Model.ModalidadEnvio)</div></div>
                <div class="i3"><div class="info-label">Paquetería / transportista</div><div class="info-value">@(string.IsNullOrWhiteSpace(Model.Transportista) ? "Pendiente" : Model.Transportista)</div></div>
                <div class="i3"><div class="info-label">Guía / referencia</div><div class="info-value">@(string.IsNullOrWhiteSpace(Model.GuiaReferencia) ? "-" : Model.GuiaReferencia)</div></div>
                <div class="i3"><div class="info-label">Chofer externo</div><div class="info-value">@Model.ChoferMostrar</div></div>
                <div class="i4"><div class="info-label">Vehículo externo</div><div class="info-value">@Model.VehiculoMostrar</div></div>
            }
            @if (Model.TipoOperacion == "Exportacion")
            {
                <div class="i3"><div class="info-label">Aduana</div><div class="info-value">@(Model.PasaAduana == true ? "Sí" : Model.PasaAduana == false ? "No" : "Pendiente")</div></div>
            }
            <div class="i3"><div class="info-label">Referencia operación</div><div class="info-value">@(string.IsNullOrWhiteSpace(Model.ReferenciaOperacion) ? "-" : Model.ReferenciaOperacion)</div></div>
            @if (!string.IsNullOrWhiteSpace(Model.Observaciones))
            {
                <div class="i12"><div class="info-label">Observaciones</div><div class="info-value" style="white-space:pre-line">@Model.Observaciones</div></div>
            }
        </div>
    </div>

    @if (puedeReprogramar)
    {
        <div class="section collapsible">
            <div class="section-head"><div><h2 class="section-title">Reprogramar carga</h2><p class="section-subtitle">Solo modifica la fecha y hora de carga. La entrega del Release no se modifica aquí.</p></div></div>
            <form asp-controller="LogisticaEmbarques" asp-action="Reprogramar" method="post" class="form-grid">
                @Html.AntiForgeryToken()<input type="hidden" name="EmbarqueID" value="@Model.EmbarqueID" />
                <div class="f3"><label class="required">Nueva fecha de carga</label><input type="date" name="FechaCargaProgramada" value="@Model.FechaCargaProgramada?.ToString("yyyy-MM-dd")" class="form-control" required /></div>
                <div class="f3"><label class="required">Hora de carga</label><input type="time" name="HoraCargaProgramada" value="@Model.HoraCargaProgramada?.ToString(@"hh\:mm")" class="form-control" required /></div>
                <div class="f3"><label class="required">Motivo</label><input type="text" name="Motivo" maxlength="80" class="form-control" required /></div>
                <div class="f3"><label>Observaciones</label><input type="text" name="Observaciones" maxlength="1200" class="form-control" /></div>
                <div class="f12 text-end"><button class="btn btn-outline-primary btn-sm" type="submit">Reprogramar carga</button></div>
            </form>
        </div>
    }

    <div class="section collapsible">
        <div class="section-head"><div><h2 class="section-title">Picking List / partidas</h2><p class="section-subtitle">Partes y Releases consolidados para este embarque.</p></div></div>
        @if (puedeAgregarPartida && Model.DemandasDisponibles.Any())
        {
            <form asp-controller="LogisticaEmbarques" asp-action="AgregarDetalle" method="post" class="form-grid mb-2">
                @Html.AntiForgeryToken()<input type="hidden" name="EmbarqueID" value="@Model.EmbarqueID" />
                <div class="f8"><label class="required">Agregar Release del mismo cliente</label><select name="ReleaseDetalleID" id="releaseAgregar" class="form-select" required><option value="">Selecciona...</option>@foreach(var d in Model.DemandasDisponibles){
                <option value="@d.ReleaseDetalleID" data-pendiente="@d.PendienteProgramar">@d.FolioRelease · @d.NumeroParte · OF @d.NumeroOF · pendiente @d.PendienteProgramar.ToString("N0")</option>
            }
</select></div>
            <div class="f2"><label class="required">Cantidad</label><input type="number" name="CantidadSolicitada" id="cantidadAgregar" min="1" class="form-control" required /></div>
            <div class="f2"><button type="submit" class="btn btn-outline-primary btn-sm w-100">Agregar</button></div>
        </form>
                }
        <div class="table-wrap">
            <table class="table table-sm compact-table">
                <thead><tr><th>Release</th><th>Parte</th><th>Descripción</th><th>OF</th><th class="text-end">Solicitado</th><th class="text-end">Asignado</th><th class="text-end">Despachado</th><th class="text-end">Pendiente</th></tr></thead>
                <tbody>
                    @foreach (var p in Model.Partidas)
                    {
                        <tr><td>@p.FolioRelease</td><td class="fw-semibold">@p.NumeroParte</td><td>@(string.IsNullOrWhiteSpace(p.Descripcion) ? "-" : p.Descripcion)</td><td>@(string.IsNullOrWhiteSpace(p.NumeroOF) ? "-" : p.NumeroOF)</td><td class="text-end">@p.CantidadSolicitada.ToString("N0")</td><td class="text-end">@p.CantidadAsignada.ToString("N0")</td><td class="text-end">@p.CantidadDespachada.ToString("N0")</td><td class="text-end fw-semibold">@p.PendienteAsignar.ToString("N0")</td></tr>
                    }
                    @if (!Model.Partidas.Any())
                    {
                        <tr><td colspan="8"><div class="empty">Sin partidas.</div></td></tr>
                    }
                </tbody>
            </table>
        </div>
    </div>

    <div class="section collapsible">
        <div class="section-head"><div><h2 class="section-title">Cajas asignadas</h2><p class="section-subtitle">@Model.TotalPiezasPreparadas.ToString("N0") de @Model.TotalPiezasSolicitadas.ToString("N0") piezas preparadas.</p></div></div>
        <div class="table-wrap">
            <table class="table table-sm compact-table">
                <thead><tr><th>Caja</th><th>Etiqueta</th><th>Parte</th><th>OF</th><th>Lote</th><th class="text-end">Cantidad</th><th>Estatus</th><th></th></tr></thead>
                <tbody>
                    @foreach (var c in Model.CajasAsignadas)
                    {
                        <tr>
                            <td>#@c.NumeroCaja</td>
                            <td class="fw-semibold">@c.Etiqueta</td>
                            <td>@c.NumeroParte</td>
                            <td>@c.NumeroOF</td>
                            <td>@c.Lote</td>
                            <td class="text-end">@c.CantidadAsignada.ToString("N0")</td>
                            <td><span class="badge bg-light text-dark badge-mini">@c.Estatus</span></td>
                            <td class="text-end">@if(puedeEditarCajas){
                            <form asp-controller="LogisticaEmbarques" asp-action="LiberarCaja" method="post" class="d-inline">@Html.AntiForgeryToken()<input type="hidden" name="embarqueId" value="@Model.EmbarqueID" /><input type="hidden" name="embarqueCajaId" value="@c.EmbarqueCajaID" /><button class="btn btn-outline-danger btn-sm" type="submit" onclick="return confirm('¿Liberar esta caja?');"><i class="fa-solid fa-xmark"></i></button></form>
                        }
</td>
                    </tr>
                                        }
                    @if (!Model.CajasAsignadas.Any())
                    {
                        <tr><td colspan="8"><div class="empty">Todavía no hay cajas asignadas.</div></td></tr>
                    }
                </tbody>
            </table>
        </div>
    </div>

    @if (puedeEditarCajas)
    {
        <div class="section collapsible">
            <div class="section-head"><div><h2 class="section-title">Cajas PT disponibles por Release</h2><p class="section-subtitle">Reserva cantidades únicamente cuando necesites ajustar la preparación.</p></div></div>
            <div class="table-wrap">
                <table class="table table-sm compact-table">
                    <thead><tr><th>Release</th><th>Caja</th><th>Etiqueta</th><th>Parte</th><th>OF</th><th>Lote</th><th>Ubicación</th><th class="text-end">Residual</th><th>Reservar</th></tr></thead>
                    <tbody>
                        @foreach (var c in Model.CajasDisponibles)
                        {
                            var partidaCaja = Model.Partidas.FirstOrDefault(x => x.EmbarqueDetalleID == c.EmbarqueDetalleID);
                            var maxReserva = Math.Min(c.Disponible, partidaCaja?.PendienteAsignar ?? 0);
                            <tr>
                                <td class="fw-semibold">@(string.IsNullOrWhiteSpace(partidaCaja?.FolioRelease) ? "-" : partidaCaja!.FolioRelease)</td>
                                <td>#@c.NumeroCaja</td>
                                <td class="fw-semibold">@c.Etiqueta</td>
                                <td>@c.NumeroParte</td>
                                <td>@c.NumeroOF</td>
                                <td>@c.Lote</td>
                                <td>@c.Ubicacion</td>
                                <td class="text-end fw-semibold">@c.Disponible.ToString("N0")</td>
                                <td>@if(maxReserva>0){
                                <form asp-controller="LogisticaEmbarques" asp-action="ReservarCaja" method="post" class="d-flex gap-1">@Html.AntiForgeryToken()<input type="hidden" name="embarqueId" value="@Model.EmbarqueID" /><input type="hidden" name="embarqueDetalleId" value="@c.EmbarqueDetalleID" /><input type="hidden" name="cajaId" value="@c.CajaID" /><input type="number" name="cantidad" min="1" max="@maxReserva" value="@maxReserva" class="form-control form-control-sm" style="max-width:110px" required /><button class="btn btn-outline-primary btn-sm" type="submit">Reservar</button></form>
                            }else
                            {

                                <span class="text-muted small">Release cubierto</span>
                            }
    </td>
                        </tr>
                    }
                    @if (!Model.CajasDisponibles.Any())
                    {
                        <tr><td colspan="9"><div class="empty">Sin cajas PT disponibles.</div></td></tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
        }

    <div class="section">
        <div class="section-head"><div><h2 class="section-title">Checklist de salida</h2><p class="section-subtitle">La salida se habilita cuando todo lo obligatorio está completo.</p></div></div>
        <div class="checklist">@foreach(var item in Model.Checklist){
        <div class="check-item"><i class="fa-solid @item.Icono text-@item.Clase"></i><div><strong>@item.Concepto</strong><small>@item.Descripcion</small></div></div>
                }
</div>
    </div>

    <div class="section collapsible">
        <div class="section-head">
            <div><h2 class="section-title">Documentación</h2><p class="section-subtitle">Requisitos según @FormaEnvioTexto() y operación @Model.TipoOperacion.</p></div>
            <span class="badge @(Model.DocumentacionCompleta ? "bg-success" : "bg-warning text-dark")">@(Model.DocumentacionCompleta ? "Completa" : $"{Model.DocumentosFaltantes} pendiente(s)")</span>
        </div>
        <div class="doc-note">
            @if (Model.FormaEnvio == "Interno")
            {
                <text><strong>Interno:</strong> Factura firmada y sellada; si no hay factura por excepción, se permite Remisión indicando motivo.</text>
            }
            else if (Model.FormaEnvio == "Cliente")
            {

                <text><strong>Cliente recoge:</strong> Factura firmada por quien recoge/transportista; si no hay factura por excepción, se permite Remisión indicando motivo.</text>
            }
            else if (Model.FormaEnvio == "Paqueteria")
            {

                <text><strong>Paquetería:</strong> Factura firmada por transportista o Remisión por excepción, Guía y documentos adicionales requeridos como Packing List/Carta Porte.</text>
            }
        </div>
        <div class="doc-required">
            @foreach (var r in Model.DocumentosRequeridos)
            {
                <div class="doc-required-item"><div class="fw-semibold">@r.TipoDocumento</div><div class="text-muted">@r.AreaResponsable</div><div class="mt-1">@if(r.Cargado){
                <span class="text-success">Cargado</span>@if(r.Validado){
                <span class="text-success ms-2">Validado</span>
            }else
            {

                <span class="text-warning ms-2">Pendiente validar</span>
            }
}else
{
                <span class="text-danger">Faltante</span>
            }
</div></div>
                        }
        </div>
        <form asp-controller="LogisticaEmbarques" asp-action="SubirDocumento" method="post" enctype="multipart/form-data" class="form-grid mb-2">
            @Html.AntiForgeryToken()<input type="hidden" name="embarqueId" value="@Model.EmbarqueID" />
            <div class="f3"><label class="required">Tipo documento</label><select name="tipoDocumento" id="tipoDocumento" class="form-select" required><option value="">Selecciona...</option><option>Commercial Invoice</option><option>Carta Porte</option><option>Packing List</option><option>Factura</option><option>Remisión</option><option>Guía</option><option>XML</option><option>Carta de instrucciones</option><option>Booking</option><option>Pedimento</option><option>Otro</option></select></div>
            <div class="f4"><label class="required">Archivo</label><input type="file" name="archivo" class="form-control" accept=".pdf,.xml,.xlsx,.xls,.docx,.doc,.jpg,.jpeg,.png" required /></div>
            <div class="f3"><label id="lblObsDocumento">Observaciones</label><input type="text" name="observaciones" id="obsDocumento" maxlength="1000" class="form-control" /></div>
            <div class="f2"><button class="btn btn-outline-primary btn-sm w-100" type="submit">Subir</button></div>
        </form>
        <div class="table-wrap">
            <table class="table table-sm compact-table">
                <thead><tr><th>Tipo</th><th>Archivo</th><th>Área</th><th>Carga</th><th>Validación</th><th></th></tr></thead>
                <tbody>
                    @foreach (var d in Model.Documentos)
                    {
                        <tr>
                            <td>@d.TipoDocumento</td>
                            <td>@d.NombreOriginal</td>
                            <td>@d.AreaResponsable</td>
                            <td>@d.FechaCarga.ToString("dd/MM/yyyy HH:mm") · @d.UsuarioCargaNombre</td>
                            <td>@if(d.Validado){
                            <span class="text-success">Validado @(d.FechaValidacion?.ToString("dd/MM/yyyy HH:mm"))</span>
                        }else
                        {

                            <span class="text-warning">Pendiente</span>
                        }
</td>
                        <td class="text-end text-nowrap">
                            <a asp-controller="LogisticaEmbarques" asp-action="VerDocumento" asp-route-id="@d.EmbarqueDocumentoID" target="_blank" class="btn btn-outline-secondary btn-sm"><i class="fa-solid fa-eye"></i></a>
                            @if (!d.Validado)
                            {
                                <form asp-controller="LogisticaEmbarques" asp-action="ValidarDocumento" method="post" class="d-inline">@Html.AntiForgeryToken()<input type="hidden" name="documentoId" value="@d.EmbarqueDocumentoID" /><input type="hidden" name="embarqueId" value="@Model.EmbarqueID" /><button class="btn btn-outline-success btn-sm" type="submit"><i class="fa-solid fa-check"></i></button></form>
                            }
                            <button type="button" class="btn btn-outline-danger btn-sm" onclick="mostrarRetiroDocumento(@d.EmbarqueDocumentoID)"><i class="fa-solid fa-xmark"></i></button>
                            <form id="retirar-doc-@d.EmbarqueDocumentoID" asp-controller="LogisticaEmbarques" asp-action="RetirarDocumento" method="post" class="d-none">@Html.AntiForgeryToken()<input type="hidden" name="documentoId" value="@d.EmbarqueDocumentoID" /><input type="hidden" name="embarqueId" value="@Model.EmbarqueID" /><input type="hidden" name="motivo" id="motivo-doc-@d.EmbarqueDocumentoID" /></form>
                        </td>
                    </tr>
                                        }
                    @if (!Model.Documentos.Any())
                    {
                        <tr><td colspan="6"><div class="empty">Sin documentos cargados.</div></td></tr>
                    }
                </tbody>
            </table>
        </div>
    </div>

    <div class="section collapsible">
        <div class="section-head"><div><h2 class="section-title">Evidencias</h2><p class="section-subtitle">Carga, salida, entrega o incidencia.</p></div></div>
        <form asp-controller="LogisticaEmbarques" asp-action="SubirEvidencia" method="post" enctype="multipart/form-data" class="form-grid mb-2">
            @Html.AntiForgeryToken()<input type="hidden" name="embarqueId" value="@Model.EmbarqueID" />
            <div class="f3"><label class="required">Tipo</label><select name="tipoEvidencia" class="form-select" required><option value="">Selecciona...</option><option>Carga</option><option>Salida</option><option>Entrega</option><option>Incidencia</option></select></div>
            <div class="f4"><label class="required">Archivo</label><input type="file" name="archivo" accept=".jpg,.jpeg,.png,.pdf" class="form-control" required /></div>
            <div class="f3"><label>Observaciones</label><input type="text" name="observaciones" maxlength="1000" class="form-control" /></div>
            <div class="f2"><button class="btn btn-outline-primary btn-sm w-100" type="submit">Subir</button></div>
        </form>
        <div class="table-wrap">
            <table class="table table-sm compact-table">
                <thead><tr><th>Tipo</th><th>Archivo</th><th>Tamaño</th><th>Usuario</th><th>Fecha</th><th>Observaciones</th><th></th></tr></thead>
                <tbody>
                    @foreach (var e in Model.Evidencias)
                    {
                        <tr><td>@e.TipoEvidencia</td><td>@e.NombreOriginal</td><td>@e.TamanoTexto</td><td>@e.UsuarioNombre</td><td>@e.FechaCarga.ToString("dd/MM/yyyy HH:mm")</td><td>@e.Observaciones</td><td class="text-end text-nowrap"><a asp-controller="LogisticaEmbarques" asp-action="VerEvidencia" asp-route-id="@e.EvidenciaID" target="_blank" class="btn btn-outline-secondary btn-sm"><i class="fa-solid fa-eye"></i></a><a asp-controller="LogisticaEmbarques" asp-action="DescargarEvidencia" asp-route-id="@e.EvidenciaID" class="btn btn-outline-secondary btn-sm"><i class="fa-solid fa-download"></i></a><button type="button" class="btn btn-outline-danger btn-sm" onclick="retirarEvidencia(@e.EvidenciaID)"><i class="fa-solid fa-xmark"></i></button><form id="retirar-evidencia-@e.EvidenciaID" asp-controller="LogisticaEmbarques" asp-action="EliminarEvidencia" method="post" class="d-none">@Html.AntiForgeryToken()<input type="hidden" name="evidenciaId" value="@e.EvidenciaID" /><input type="hidden" name="embarqueId" value="@Model.EmbarqueID" /><input type="hidden" name="motivo" id="motivo-evidencia-@e.EvidenciaID" /></form></td></tr>
                    }
                    @if (!Model.Evidencias.Any())
                    {
                        <tr><td colspan="7"><div class="empty">Sin evidencias.</div></td></tr>
                    }
                </tbody>
            </table>
        </div>
    </div>

    @if (Model.Estatus != "Cancelado")
    {
        <div class="section collapsible">
            <div class="section-head"><div><h2 class="section-title">Registrar incidencia</h2></div></div>
            <form asp-controller="LogisticaEmbarques" asp-action="RegistrarIncidencia" method="post" class="form-grid">
                @Html.AntiForgeryToken()<input type="hidden" name="EmbarqueID" value="@Model.EmbarqueID" />
                <div class="f3"><label class="required">Tipo</label><select name="Tipo" class="form-select" required><option value="">Selecciona...</option><option>Producto incompleto</option><option>Caja dañada</option><option>Unidad no disponible</option><option>Retraso</option><option>Ruta</option><option>Documentación</option><option>Cliente / destino</option><option>Seguridad</option><option>Otro</option></select></div>
                <div class="f2"><label class="required">Severidad</label><select name="Severidad" class="form-select" required><option>Baja</option><option selected>Media</option><option>Alta</option><option>Crítica</option></select></div>
                <div class="f2"><label>Responsable</label><input type="text" name="Responsable" maxlength="200" class="form-control" /></div>
                <div class="f2"><label>Compromiso</label><input type="datetime-local" name="FechaCompromiso" class="form-control" /></div>
                <div class="f3"><label class="required">Descripción</label><input type="text" name="Descripcion" maxlength="1200" class="form-control" required /></div>
                <div class="f12 text-end"><button class="btn btn-outline-danger btn-sm" type="submit">Registrar</button></div>
            </form>
        </div>
    }

    <div class="section collapsible">
        <div class="section-head"><div><h2 class="section-title">Incidencias</h2></div></div>
        <div class="table-wrap">
            <table class="table table-sm compact-table">
                <thead><tr><th>Folio</th><th>Fecha</th><th>Tipo</th><th>Severidad</th><th>Descripción</th><th>Responsable</th><th>Estatus</th><th></th></tr></thead>
                <tbody>
                    @foreach (var i in Model.Incidencias)
                    {
                        <tr><td>@i.Folio</td><td>@i.FechaRegistro.ToString("dd/MM/yyyy HH:mm")</td><td>@i.Tipo</td><td><span class="badge @BadgeSeveridad(i.Severidad) badge-mini">@i.Severidad</span></td><td>@i.Descripcion</td><td>@i.Responsable</td><td>@i.Estatus</td><td>@if(i.EstaAbierta){
                        <form asp-controller="LogisticaEmbarques" asp-action="CerrarIncidencia" method="post" class="d-flex gap-1">@Html.AntiForgeryToken()<input type="hidden" name="IncidenciaID" value="@i.IncidenciaID" /><input type="hidden" name="EmbarqueID" value="@Model.EmbarqueID" /><input type="text" name="Solucion" maxlength="1200" class="form-control form-control-sm" placeholder="Solución" required /><button class="btn btn-outline-success btn-sm" type="submit"><i class="fa-solid fa-check"></i></button></form>
                    }
</td></tr>
                                        }
                    @if (!Model.Incidencias.Any())
                    {
                        <tr><td colspan="8"><div class="empty">Sin incidencias.</div></td></tr>
                    }
                </tbody>
            </table>
        </div>
    </div>

    @if (puedeEntregar)
    {
        <div class="section" id="lgEntrega">
            <div class="section-head"><div><h2 class="section-title">Registrar entrega</h2></div></div>
            <form asp-controller="LogisticaEmbarques" asp-action="Entregar" method="post" class="form-grid">
                @Html.AntiForgeryToken()<input type="hidden" name="EmbarqueID" value="@Model.EmbarqueID" />
                <div class="f4"><label class="required">Recibe</label><input type="text" name="ReceptorNombre" maxlength="200" class="form-control" required /></div>
                <div class="f3"><label>Folio remisión</label><input type="text" name="FolioRemision" maxlength="100" class="form-control" /></div>
                <div class="f3"><label>Observaciones</label><input type="text" name="Observaciones" maxlength="1200" class="form-control" /></div>
                <div class="f2"><button class="btn btn-success btn-sm w-100" type="submit" onclick="return confirm('¿Confirmar entrega?');">Entregar</button></div>
            </form>
        </div>
    }

    <div class="section collapsible">
        <div class="section-head"><div><h2 class="section-title">Historial</h2></div></div>
        @foreach (var h in Model.Historial)
        {
            <div class="history-row"><div class="history-date">@h.Fecha.ToString("dd/MM/yyyy HH:mm")</div><div class="fw-semibold">@h.Evento.Replace("_", " ")</div><div>@if(!string.IsNullOrWhiteSpace(h.EstadoAnterior)||!string.IsNullOrWhiteSpace(h.EstadoNuevo)){
            <div>@h.EstadoAnterior @if(!string.IsNullOrWhiteSpace(h.EstadoNuevo)){
            <text>→ @h.EstadoNuevo</text>
        }
</div>
                }
@if (!string.IsNullOrWhiteSpace(h.Observaciones))
{
            <div class="text-muted">@h.Observaciones</div>
        }
</div><div class="history-user">@h.Usuario</div></div>
                }
        @if (!Model.Historial.Any())
        {
            <div class="empty">Sin historial.</div>
        }
    </div>

    @if (puedeCancelar)
    {
        <div class="danger-zone">
            <div class="section-title text-danger mb-2">Cancelar embarque</div>
            <form asp-controller="LogisticaEmbarques" asp-action="Cancelar" method="post" class="form-grid">
                @Html.AntiForgeryToken()<input type="hidden" name="embarqueId" value="@Model.EmbarqueID" />
                <div class="f10"><label class="required">Motivo</label><input type="text" name="motivo" maxlength="1200" class="form-control" required /></div>
                <div class="f2"><button class="btn btn-outline-danger btn-sm w-100" type="submit" onclick="return confirm('¿Seguro que deseas cancelar este embarque?');">Cancelar</button></div>
            </form>
        </div>
    }
</div>

@section Scripts {
    <script>
        (()=>{
            const release=document.getElementById('releaseAgregar'),cantidad=document.getElementById('cantidadAgregar');
            release?.addEventListener('change',()=>{const option=release.options[release.selectedIndex],max=Number(option?.dataset?.pendiente||0);if(cantidad&&max>0){cantidad.max=max;cantidad.value=max;}});
            window.mostrarRetiroDocumento=id=>{const motivo=prompt('Motivo para retirar el documento:');if(!motivo||!motivo.trim())return;const input=document.getElementById(`motivo-doc-${id}`),form=document.getElementById(`retirar-doc-${id}`);if(input&&form){input.value=motivo.trim();form.submit();}};
            window.retirarEvidencia=id=>{const motivo=prompt('Motivo para retirar la evidencia:');if(!motivo||!motivo.trim())return;const input=document.getElementById(`motivo-evidencia-${id}`),form=document.getElementById(`retirar-evidencia-${id}`);if(input&&form){input.value=motivo.trim();form.submit();}};

            const tipoDoc=document.getElementById('tipoDocumento'),obsDoc=document.getElementById('obsDocumento'),lblObs=document.getElementById('lblObsDocumento');
            const syncDocumento=()=>{const remision=tipoDoc?.value==='Remisión';if(obsDoc)obsDoc.required=remision;if(lblObs)lblObs.classList.toggle('required',remision);if(remision&&obsDoc)obsDoc.placeholder='Motivo obligatorio: cierre de mes, Finanzas fuera de servicio, etc.';else if(obsDoc)obsDoc.placeholder='';};
            tipoDoc?.addEventListener('change',syncDocumento);syncDocumento();

            const scan=document.getElementById('lgSalidaScan'),scanMsg=document.getElementById('lgSalidaMsg'),salidaBtn=document.getElementById('lgConfirmarSalida'),limpiar=document.getElementById('lgLimpiarSalida');
            const checks=Array.from(document.querySelectorAll('.lg-scan-check')),rows=Array.from(document.querySelectorAll('.lg-salida-box')),norm=v=>(v||'').trim().toUpperCase();
            const updateSalida=(message,type='')=>{const marked=checks.filter(x=>x.checked).length;rows.forEach(r=>r.classList.toggle('checked',r.querySelector('.lg-scan-check')?.checked===true));if(salidaBtn)salidaBtn.disabled=checks.length===0||marked!==checks.length;if(scanMsg){scanMsg.textContent=message||`${marked} de ${checks.length} caja(s) confirmadas.`;scanMsg.classList.remove('ok','error');if(type)scanMsg.classList.add(type);}};
            const scanCaja=()=>{if(!scan)return;const code=norm(scan.value);if(!code){updateSalida('El lector no envió contenido.','error');return;}let candidates=rows.filter(r=>norm(r.dataset.etiqueta)===code);if(candidates.length===0)candidates=rows.filter(r=>norm(r.dataset.lote)===code||norm(r.dataset.cajaId)===code||norm(r.dataset.numeroCaja)===code);if(candidates.length!==1){updateSalida(candidates.length===0?'La caja escaneada no pertenece a este embarque.':'La lectura es ambigua; escanea la etiqueta completa.','error');scan.select();return;}const chk=candidates[0].querySelector('.lg-scan-check');if(chk.checked){updateSalida(`La caja #${candidates[0].dataset.numeroCaja} ya estaba confirmada.`,'error');scan.value='';return;}chk.checked=true;scan.value='';updateSalida(`Caja #${candidates[0].dataset.numeroCaja} confirmada.`,'ok');scan.focus();};
            scan?.addEventListener('keydown',e=>{if(e.key==='Enter'||e.key==='Tab'){e.preventDefault();scanCaja();}});checks.forEach(x=>x.addEventListener('change',()=>updateSalida()));limpiar?.addEventListener('click',()=>{checks.forEach(x=>x.checked=false);updateSalida('Confirmación limpiada.');scan?.focus();});
            document.getElementById('lgSalidaForm')?.addEventListener('submit',e=>{if(checks.length===0||checks.some(x=>!x.checked)){e.preventDefault();updateSalida('Debes confirmar todas las cajas antes de salir.','error');return;}if(!confirm('¿Confirmar salida física de PT?'))e.preventDefault();});
            updateSalida();

            document.querySelectorAll('.collapsible').forEach(section=>{const head=section.querySelector(':scope > .section-head');if(!head)return;const btn=document.createElement('button');btn.type='button';btn.className='collapse-btn';btn.innerHTML='<i class="fa-solid fa-chevron-down me-1"></i> Ver';head.appendChild(btn);section.classList.add('collapsed-section');btn.addEventListener('click',()=>{const closed=section.classList.toggle('collapsed-section');btn.innerHTML=closed?'<i class="fa-solid fa-chevron-down me-1"></i> Ver':'<i class="fa-solid fa-chevron-up me-1"></i> Ocultar';});});
        })();
    </script>
}
