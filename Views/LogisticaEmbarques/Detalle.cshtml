    }

    .f2 {
        grid-column: span 2
    }

    .f3 {
        grid-column: span 3
    }

    .f4 {
        grid-column: span 4
    }

    .f5 {
        grid-column: span 5
    }

    .f6 {
        grid-column: span 6
    }

    .f8 {
        grid-column: span 8
    }

    .f10 {
        grid-column: span 10
    }

    .f12 {
        grid-column: span 12
