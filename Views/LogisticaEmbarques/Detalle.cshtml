@using ERP.NSQuell.Models.ViewModels.Logistica
@model LogisticaDetalleVm
@{
    Layout = "~/Views/Shared/_Layout.cshtml";
    ViewData["Title"] = $"Embarque {Model.Folio}";

    string BadgeEstatus(string estatus) => estatus switch
    {
        "Programado" => "bg-primary",
        "Preparando" => "bg-info text-dark",
        "Preparado" => "bg-warning text-dark",
        "Cargando" => "bg-warning text-dark",
        "Cargado" => "bg-dark",
        "En ruta" => "bg-primary",
        "Entregado" => "bg-success",
        "Cancelado" => "bg-secondary",
        _ => "bg-light text-dark"
    };

    string BadgeSeveridad(string severidad) => severidad switch
    {
        "Crítica" => "bg-danger",
        "Alta" => "bg-warning text-dark",
        "Media" => "bg-info text-dark",
        "Baja" => "bg-secondary",
        _ => "bg-light text-dark"
    };

    string TextoFechaHora(DateTime? fecha, TimeSpan? hora)
    {
        if (!fecha.HasValue) return "-";
        return hora.HasValue ? $"{fecha.Value:dd/MM/yyyy} {hora.Value:hh\\:mm}" : fecha.Value.ToString("dd/MM/yyyy");
    }

    string FormaEnvioTexto() => Model.FormaEnvio switch
    {
        "Interno" => "Entrega",
        "Cliente" => "Cliente recoge",
        "Paqueteria" => "Paquetería",
        "Pendiente" => "Por definir",
        _ => string.IsNullOrWhiteSpace(Model.FormaEnvio) ? "Por definir" : Model.FormaEnvio
    };

    var requiereDefinirSalida = (ViewBag.RequiereDefinirSalida as bool?) == true || Model.TipoOperacion == "Pendiente" || Model.FormaEnvio == "Pendiente" || string.IsNullOrWhiteSpace(Model.TipoOperacion) || string.IsNullOrWhiteSpace(Model.FormaEnvio);
    var puedeDefinirSalida = (ViewBag.PuedeDefinirSalida as bool?) ?? (Model.Estatus is "Programado" or "Preparando" or "Preparado");
    var puedeCancelar = Model.Estatus is "Programado" or "Preparando" or "Preparado";
    var puedeReprogramar = Model.Estatus is "Programado" or "Preparando" or "Preparado";
    var puedeEditarCajas = Model.Estatus is "Programado" or "Preparando";
    var puedeAgregarPartida = Model.Estatus is "Programado" or "Preparando";
    var incidenciasAbiertas = Model.Incidencias?.Count(x => x.EstaAbierta) ?? 0;
    var totalEvidencias = Model.Evidencias?.Count ?? 0;

    var programacionCompleta = Model.FechaCargaProgramada.HasValue && Model.HoraCargaProgramada.HasValue && Model.TotalPiezasSolicitadas > 0;
    var salidaConfigurada = !requiereDefinirSalida;
    var preparacionConfirmada = Model.Estatus is "Preparado" or "Cargando" or "Cargado" or "En ruta" or "Entregado";
    var documentacionCompleta = salidaConfigurada && Model.DocumentacionCompleta;
    var cargaFisicaCompleta = Model.Estatus is "Cargado" or "En ruta" or "Entregado";
    var salidaPlantaCompleta = Model.Estatus is "En ruta" or "Entregado";
    var entregaCompleta = Model.Estatus == "Entregado";
    var esEntrega = Model.FormaEnvio == "Interno";
    var esCliente = Model.FormaEnvio == "Cliente";
    var esPaqueteria = Model.FormaEnvio == "Paqueteria";
    var salidaDesdeCentro = esCliente || esPaqueteria;
    var puedeEntregar = Model.Estatus == "En ruta" && salidaDesdeCentro;
    var puedeTrabajarCarga = salidaConfigurada && programacionCompleta && (Model.Estatus is "Programado" or "Preparando" or "Preparado" or "Cargando");
    var porcentajeAvanceVista = Model.Estatus == "Cargando" ? 65 : Model.PorcentajeAvance;

    string ClasePaso(bool completo, bool actual)
    {
        if (completo) return "done";
        if (actual) return "current";
        return string.Empty;
    }

    var actualProgramacion = Model.Estatus != "Cancelado" && !programacionCompleta;
    var actualSalida = Model.Estatus != "Cancelado" && programacionCompleta && !salidaConfigurada;
    var actualPreparacion = Model.Estatus != "Cancelado" && salidaConfigurada && !preparacionConfirmada;
    var actualCarga = Model.Estatus != "Cancelado" && preparacionConfirmada && !cargaFisicaCompleta;
    var actualDocumentos = Model.Estatus != "Cancelado" && cargaFisicaCompleta && !documentacionCompleta;
    var actualSalidaPlanta = Model.Estatus != "Cancelado" && cargaFisicaCompleta && documentacionCompleta && !salidaPlantaCompleta;
    var actualEntrega = Model.Estatus != "Cancelado" && salidaPlantaCompleta && !entregaCompleta;

    var proximaAccionVista = Model.Estatus switch
    {
        "Cancelado" => "Embarque cancelado",
        "Entregado" => "Proceso completado",
        "En ruta" when esEntrega => "Seguimiento de entrega con chofer",
        "En ruta" => "Confirmar entrega",
        "Cargado" when !documentacionCompleta => "Completar documentación",
        "Cargado" when esCliente => "Confirmar recolección",
        "Cargado" when esEntrega => "Iniciar viaje",
        "Cargado" when esPaqueteria => "Confirmar salida de planta",
        "Programado" or "Preparando" or "Preparado" or "Cargando" when salidaConfigurada => "Carga física",
        _ when requiereDefinirSalida => "Configurar salida en Centro Operativo",
        _ => "Revisar operación"
    };

    var proximaAccionDetalleVista = Model.Estatus switch
    {
        "Cancelado" => "No hay acciones operativas pendientes.",
        "Entregado" => "La entrega está cerrada y conserva su trazabilidad.",
        "En ruta" when esEntrega => "El viaje está en curso. El chofer administra las paradas y confirma la entrega desde su portal.",
        "En ruta" => "Registra quién recibió la mercancía y adjunta una o más evidencias de entrega.",
        "Cargado" when !documentacionCompleta => "La carga ya quedó confirmada. Completa la documentación obligatoria antes de liberar la mercancía.",
        "Cargado" when esCliente => "Registra quién recoge y la evidencia. Al confirmar se despacha PT y el embarque queda Entregado.",
        "Cargado" when esEntrega => "Logística puede iniciar el viaje desde Centro Operativo o el chofer puede iniciarlo desde su portal.",
        "Cargado" when esPaqueteria => "Confirma la salida cuando la mercancía sea entregada físicamente a la paquetería o transportista.",
        "Programado" or "Preparando" or "Preparado" or "Cargando" when !documentacionCompleta => "Selecciona o escanea las cajas disponibles. También puedes usar Carga rápida. La documentación puede completarse en paralelo.",
        "Programado" or "Preparando" or "Preparado" or "Cargando" => "Selecciona cajas por número de parte, escanéalas o utiliza Carga rápida. Si no hay PT completo, el faltante quedará Expeditado.",
        _ when requiereDefinirSalida => "La forma de salida, ruta, unidad y chofer se configuran únicamente desde Centro Operativo.",
        _ => "Revisa el estado actual del embarque."
    };
}
@section Styles {
    <link rel="stylesheet" href="~/css/logistica.css" asp-append-version="true" />
}
<style>
    :root {
        --lg-blue: #173a7a;
        --lg-text: #172033;
        --lg-muted: #6d7888;
        --lg-border: #dce4ee;
        --lg-soft: #f7f9fc;
        --lg-shadow: 0 8px 24px rgba(22,42,75,.055)
    }

    .detalle-page {
        max-width: 1760px;
        margin: 0 auto;
        padding: 16px 18px 28px;
        color: var(--lg-text)
    }

    .detalle-header {
        display: flex;
        justify-content: space-between;
        align-items: center;
        gap: 12px;
        flex-wrap: wrap;
        padding: 14px 16px;
        margin-bottom: 10px;
        border: 1px solid var(--lg-border);
        border-left: 4px solid var(--lg-blue);
        border-radius: 12px;
        background: #fff;
        box-shadow: var(--lg-shadow)
    }

    .detalle-title {
        margin: 0;
        font-size: 1.42rem;
        font-weight: 800
    }

        .detalle-title i {
            color: var(--lg-blue)
        }

    .detalle-subtitle {
        margin: 3px 0 0;
        color: var(--lg-muted);
        font-size: .84rem
    }

    .header-actions {
        display: flex;
        gap: 6px;
        flex-wrap: wrap
    }

        .header-actions .btn {
            min-height: 34px;
            border-radius: 8px;
            font-weight: 700;
            display: inline-flex;
            align-items: center
        }

    .status-strip {
        display: grid;
        grid-template-columns: repeat(6,minmax(120px,1fr));
        gap: 7px;
        margin-bottom: 10px
    }

    .status-item {
        padding: 8px 10px;
        border: 1px solid var(--lg-border);
        border-radius: 9px;
        background: #fff
    }

        .status-item span {
            display: block;
            color: var(--lg-muted);
            font-size: .64rem;
            font-weight: 800;
            text-transform: uppercase
        }

        .status-item strong {
            display: block;
            margin-top: 2px;
            font-size: .83rem;
            font-weight: 800;
            white-space: nowrap;
            overflow: hidden;
            text-overflow: ellipsis
        }

    .progress-line {
        height: 5px;
        margin: 0 1px 10px;
        background: #e6ebf1;
        border-radius: 999px;
        overflow: hidden
    }

        .progress-line > div {
            height: 100%;
            background: linear-gradient(90deg,#173a7a,#3b72c5)
        }

    .workflow {
        display: grid;
        grid-template-columns: repeat(7,minmax(0,1fr));
        gap: 6px;
        margin-bottom: 10px
    }

    .workflow-step {
        padding: 8px 10px;
        border: 1px solid var(--lg-border);
        border-radius: 9px;
        background: #fafbfd
    }

        .workflow-step span {
            display: block;
            color: #7a8796;
            font-size: .6rem;
            text-transform: uppercase
        }

        .workflow-step strong {
            display: block;
            margin-top: 2px;
            font-size: .72rem
        }

        .workflow-step.done {
            border-color: #b9d7ca;
            background: #f4fbf7
        }

            .workflow-step.done strong {
                color: #17633a
            }

        .workflow-step.current {
            border-color: #7fa0cf;
            background: #f1f6fd;
            box-shadow: inset 3px 0 0 var(--lg-blue)
        }

            .workflow-step.current strong {
                color: var(--lg-blue)
            }

    .salida-pendiente {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 14px;
        margin-bottom: 10px;
        padding: 13px 14px;
        border: 1px solid #e8c56f;
        border-left: 4px solid #d99a14;
        border-radius: 11px;
        background: linear-gradient(90deg,#fff8e4,#fffdf7);
        box-shadow: var(--lg-shadow)
    }

        .salida-pendiente .sp-main {
            display: flex;
            gap: 11px;
            align-items: flex-start;
            min-width: 0
        }

        .salida-pendiente .sp-icon {
            width: 34px;
            height: 34px;
            flex: 0 0 34px;
            display: flex;
            align-items: center;
            justify-content: center;
            border-radius: 9px;
            background: #fff0bf;
            color: #8a5d00;
            font-size: 1rem
        }

        .salida-pendiente strong {
            display: block;
            color: #5d4100;
            font-size: .86rem
        }

        .salida-pendiente small {
            display: block;
            margin-top: 3px;
            color: #79653a;
            font-size: .71rem;
            line-height: 1.35
        }

        .salida-pendiente .btn-definir {
            flex: 0 0 auto;
            min-height: 38px;
            padding: 0 14px;
            border-radius: 8px;
            border: 1px solid #b98000;
            background: #8b6100;
            color: #fff;
            text-decoration: none;
            font-size: .76rem;
            font-weight: 800;
            display: inline-flex;
            align-items: center;
            gap: 6px
        }

            .salida-pendiente .btn-definir:hover {
                background: #704e00;
                color: #fff
            }

    .stage {
        margin-bottom: 10px;
        padding: 13px 14px;
        border: 1px solid var(--lg-border);
        border-radius: 12px;
        background: #fff;
        box-shadow: var(--lg-shadow)
    }

    .stage-head {
        display: flex;
        justify-content: space-between;
        align-items: center;
        gap: 10px;
        flex-wrap: wrap;
        margin-bottom: 9px;
        padding-bottom: 8px;
        border-bottom: 1px solid #e8edf3
    }

    .stage-title {
        margin: 0;
        font-size: .96rem;
        font-weight: 800
    }

    .stage-sub {
        margin: 2px 0 0;
        color: var(--lg-muted);
        font-size: .72rem
    }

    .stage-action {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 12px;
        padding: 10px 11px;
        border: 1px solid #d9e3ef;
        border-radius: 9px;
        background: #fbfcfe
    }

        .stage-action strong {
            display: block;
            font-size: .84rem
        }

        .stage-action small {
            display: block;
            margin-top: 2px;
            color: #6d7a8d;
            font-size: .7rem
        }

    .stage-btn {
        min-height: 38px;
        padding: 0 14px;
        border: 0;
        border-radius: 8px;
        background: #0f4f91;
        color: #fff;
        font-size: .78rem;
        font-weight: 800;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: 6px;
        text-decoration: none
    }

    .scan-box {
        margin-top: 9px;
        padding: 10px;
        border: 1px solid #cfdaea;
        border-radius: 9px;
        background: #f8fbff
    }

    .scan-row {
        display: grid;
        grid-template-columns: minmax(0,1fr) auto;
        gap: 8px
    }

    .scan-input {
        min-height: 41px;
        border: 2px solid #8faad0;
        border-radius: 8px;
        padding: 7px 10px;
        font-size: .82rem;
        font-weight: 700
    }

    .scan-msg {
        margin-top: 5px;
        color: #66778c;
        font-size: .7rem
    }

        .scan-msg.ok {
            color: #17633a
        }

        .scan-msg.error {
            color: #b42318
        }

    .load-kpis {
        display: grid;
        grid-template-columns: repeat(4,minmax(0,1fr));
        gap: 6px;
        margin-top: 8px
    }

    .load-kpi {
        padding: 7px 8px;
        border: 1px solid #dce4ee;
        border-radius: 8px;
        background: #fff
    }

        .load-kpi span {
            display: block;
            color: #7a8796;
            font-size: .6rem;
            font-weight: 800;
            text-transform: uppercase
        }

        .load-kpi strong {
            display: block;
            margin-top: 2px;
            color: var(--lg-blue);
            font-size: .84rem
        }

    .scan-state {
        width: 28px;
        height: 28px;
        border-radius: 50%;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        background: #edf2f7;
        color: #66758a
    }

    .scan-item.checked .scan-state {
        background: #e5f5ed;
        color: #087443
    }

    .delivery-files {
        margin-top: 4px;
        color: var(--lg-muted);
        font-size: .69rem
    }

    .scan-list {
        display: grid;
        gap: 6px;
        margin-top: 8px
    }

    .scan-item {
        display: grid;
        grid-template-columns: 28px minmax(220px,1fr) minmax(120px,.55fr) 90px;
        align-items: center;
        gap: 8px;
        padding: 8px 9px;
        border: 1px solid #dce4ee;
        border-radius: 8px;
        background: #fff
    }

        .scan-item.checked {
            border-color: #72a08a;
            background: #f5fbf8
        }

        .scan-item small {
            display: block;
            color: #7a8798;
            font-size: .65rem
        }

        .scan-item .qty {
            text-align: right;
            color: var(--lg-blue);
            font-weight: 800
        }

    .scan-check {
        width: 19px;
        height: 19px
    }

    .tabs-shell {
        border: 1px solid var(--lg-border);
        border-radius: 12px;
        background: #fff;
        box-shadow: var(--lg-shadow);
        overflow: hidden
    }

    .nav-tabs {
        padding: 0 10px;
        background: #f8fafc;
        border-bottom: 1px solid var(--lg-border)
    }

        .nav-tabs .nav-link {
            padding: .7rem .8rem;
            border: 0;
            border-bottom: 2px solid transparent;
            color: #687386;
            font-size: .77rem;
            font-weight: 700
        }

            .nav-tabs .nav-link.active {
                color: var(--lg-blue);
                background: transparent;
                border-bottom-color: var(--lg-blue)
            }

    .tab-content {
        padding: 12px
    }

    .section-head {
        display: flex;
        justify-content: space-between;
        align-items: center;
        gap: 8px;
        flex-wrap: wrap;
        margin-bottom: 9px
    }

        .section-head h3 {
            margin: 0;
            font-size: .9rem;
            font-weight: 800
        }

        .section-head p {
            margin: 2px 0 0;
            color: var(--lg-muted);
            font-size: .69rem
        }

    .info-grid {
        display: grid;
        grid-template-columns: repeat(12,1fr);
        gap: 8px
    }

    .i3 {
        grid-column: span 3
    }

    .i4 {
        grid-column: span 4
    }

    .i6 {
        grid-column: span 6
    }

    .i12 {
        grid-column: span 12
    }

    .info-box {
        padding: 8px 9px;
        border: 1px solid #edf1f5;
        border-radius: 8px;
        background: #fbfcfd
    }

    .info-label {
        margin-bottom: 2px;
        color: #798495;
        font-size: .63rem;
        font-weight: 800;
        text-transform: uppercase
    }

    .info-value {
        font-size: .8rem;
        font-weight: 650;
        word-break: break-word
    }

    .visual-only {
        display: inline-flex;
        margin-left: 4px;
        padding: 1px 5px;
        border-radius: 999px;
        background: #eef2f6;
        color: #5e6b7c;
        font-size: .56rem;
        font-weight: 800;
        text-transform: uppercase
    }

    .compact-form {
        display: grid;
        grid-template-columns: repeat(12,1fr);
        gap: 8px;
        align-items: end
    }

    .f1 {
        grid-column: span 1
    }

    .f2 {
        grid-column: span 2
    }

    .f3 {
        grid-column: span 3
    }

    .f4 {
        grid-column: span 4
    }

    .f6 {
        grid-column: span 6
    }

    .f8 {
        grid-column: span 8
    }

    .f10 {
        grid-column: span 10
    }

    .f12 {
        grid-column: span 12
    }

    .compact-form label {
        display: block;
        margin-bottom: 3px;
        color: #465164;
        font-size: .7rem;
        font-weight: 700
    }

    .compact-form .form-control, .compact-form .form-select {
        min-height: 36px;
        border-color: #d3dde8;
        border-radius: 8px;
        font-size: .79rem
    }

    .required:after {
        content: " *";
        color: #dc3545;
        font-weight: 800
    }

    .table-wrap {
        width: 100%;
        overflow-x: auto;
        border: 1px solid #dfe6ee;
        border-radius: 9px;
        background: #fff
    }

    .compact-table {
        margin: 0;
        font-size: .77rem
    }

        .compact-table th {
            padding: .5rem;
            background: #f4f7fa;
            color: #536072;
            font-size: .66rem;
            font-weight: 800;
            text-transform: uppercase;
            white-space: nowrap
        }

        .compact-table td {
            padding: .48rem;
            vertical-align: middle;
            border-color: #edf0f4
        }

        .compact-table tbody tr:nth-child(even) td {
            background: #fbfcfd
        }

    .badge-mini {
        font-size: .66rem;
        padding: .34em .54em
    }

    .checklist {
        display: grid;
        grid-template-columns: repeat(2,minmax(0,1fr));
        gap: 7px
    }

    .check-item {
        display: flex;
        gap: 8px;
        align-items: flex-start;
        padding: 8px 9px;
        border: 1px solid #dfe6ee;
        border-radius: 8px;
        background: #fafbfd
    }

        .check-item strong {
            display: block;
            font-size: .77rem
        }

        .check-item small {
            display: block;
            color: #6c757d;
            font-size: .68rem
        }

    .doc-required {
        display: grid;
        grid-template-columns: repeat(4,minmax(0,1fr));
        gap: 7px;
        margin-bottom: 9px
    }

    .doc-required-item {
        padding: 8px 9px;
        border: 1px solid #dfe6ee;
        border-radius: 8px;
        background: #fafbfd;
        font-size: .72rem
    }

    .doc-note {
        margin-bottom: 9px;
        padding: 8px 10px;
        border: 1px dashed #cbd8e6;
        border-radius: 8px;
        background: #f8fbff;
        color: #56667b;
        font-size: .71rem
    }

    .doc-upload-box {
        grid-column: span 5;
        min-width: 0
    }

    .doc-picker {
        display: flex;
        gap: 7px;
        flex-wrap: wrap
    }

        .doc-picker .btn {
            min-height: 36px;
            display: inline-flex;
            align-items: center;
            justify-content: center;
            gap: 6px;
            font-weight: 700
        }

    .doc-picker-help {
        margin-top: 5px;
        color: var(--lg-muted);
        font-size: .67rem;
        line-height: 1.4
    }

    .doc-selected-list {
        display: grid;
        gap: 6px;
        margin-top: 8px
    }

    .doc-selected-item {
        display: grid;
        grid-template-columns: 34px minmax(0,1fr) auto;
        gap: 8px;
        align-items: center;
        padding: 7px 8px;
        border: 1px solid #dfe6ee;
        border-radius: 8px;
        background: #fff
    }

    .doc-selected-icon {
        width: 34px;
        height: 34px;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        border-radius: 8px;
        background: #eef5ff;
        color: var(--lg-blue)
    }

    .doc-selected-item strong {
        display: block;
        overflow: hidden;
        color: var(--lg-text);
        font-size: .76rem;
        text-overflow: ellipsis;
        white-space: nowrap
    }

    .doc-selected-item small {
        display: block;
        margin-top: 1px;
        color: var(--lg-muted);
        font-size: .64rem
    }

    .doc-selected-remove {
        width: 31px;
        height: 31px;
        border: 1px solid #efc5ca;
        border-radius: 8px;
        background: #fff8f8;
        color: #b42318
    }

    .doc-selected-summary {
        margin-top: 6px;
        color: var(--lg-muted);
        font-size: .68rem;
        text-align: right
    }

    html[data-nsq-theme="dark"] .doc-selected-item {
        background: #162237;
        border-color: #2a3a50
    }

    html[data-nsq-theme="dark"] .doc-selected-icon {
        background: #172b47
    }

    .history-row {
        display: grid;
        grid-template-columns: 140px 155px 1fr 145px;
        gap: 9px;
        padding: 8px;
        border-bottom: 1px solid #e9edf2;
        font-size: .75rem
    }

        .history-row:nth-child(even) {
            background: #fbfcfd
        }

    .history-date, .history-user {
        color: #798394
    }

    .empty {
        padding: 22px 10px;
        border: 1px dashed #d8e0e8;
        border-radius: 8px;
        background: #fbfcfd;
        color: #6c757d;
        text-align: center;
        font-size: .78rem
    }

    .danger-box {
        margin-top: 12px;
        padding: 10px;
        border: 1px solid #efc5ca;
        border-radius: 9px;
        background: #fff8f8
    }

    html[data-nsq-theme="dark"] .detalle-page {
        color: #e7edf6
    }

    html[data-nsq-theme="dark"] .detalle-header, html[data-nsq-theme="dark"] .status-item, html[data-nsq-theme="dark"] .stage, html[data-nsq-theme="dark"] .tabs-shell {
