                }
                actualizarResumenSeleccion();
                const mensaje = data?.puedeConfirmar ? (data?.cargaParcial ? `${nf(cargadas)} PZA seleccionadas. Puedes confirmar la carga parcial; ${nf(pendientes)} PZA quedarán Expeditadas.` : 'La carga seleccionada cubre el embarque. Ya puedes confirmar.') : `Selecciona o escanea al menos una caja. Pendientes: ${nf(pendientes)} PZA.`;
                mostrarMensajeCarga(mensaje, data?.puedeConfirmar ? 'ok' : '');
            }
            async function cargarCargaFisica() {
                const response = await fetch(`${urlObtenerCarga}?embarqueId=${encodeURIComponent(embarqueId)}`, { method:'GET', cache:'no-store', headers:{'X-Requested-With':'XMLHttpRequest'} });
                const data = await leerJson(response); if (!response.ok || !data.ok) throw new Error(data.mensaje || 'No fue posible consultar la carga física.'); renderCarga(data); return data;
            }
            document.getElementById('lgCargaLista')?.addEventListener('change', e => { if (e.target.closest('.load-box-check')) actualizarResumenSeleccion(); });
            document.getElementById('lgMarcarSugeridas')?.addEventListener('click', () => { document.querySelectorAll('#lgCargaLista .load-box-check').forEach(chk => { if (!chk.disabled) { const card = chk.closest('.box-option'); chk.checked = card?.dataset.sugerida === 'true' || card?.classList.contains('selected'); } }); actualizarResumenSeleccion(); });
            document.getElementById('lgRecargarCajas')?.addEventListener('click', async () => { try { await cargarCargaFisica(); } catch (e) { mostrarMensajeCarga(e.message,'error'); } });
            document.getElementById('lgGuardarSeleccion')?.addEventListener('click', async () => {
                const checks = [...document.querySelectorAll('#lgCargaLista .load-box-check:checked')]; if (!checks.length) { mostrarMensajeCarga('Selecciona al menos una caja.','error'); return; }
                if (!rowVersionActual) await cargarCargaFisica();
                const btn = document.getElementById('lgGuardarSeleccion'), original = btn.innerHTML, datos = new URLSearchParams();
                datos.append('__RequestVerificationToken', token); datos.append('embarqueId', String(embarqueId)); datos.append('rowVersion', rowVersionActual); checks.forEach(x => datos.append('cajaIds', x.value));
                try { btn.disabled = true; btn.innerHTML = '<i class="fa-solid fa-spinner fa-spin"></i> Guardando...'; const r = await fetch(urlSeleccionarCajas,{method:'POST',headers:{'Content-Type':'application/x-www-form-urlencoded; charset=UTF-8','X-Requested-With':'XMLHttpRequest'},body:datos.toString()}); const j = await leerJson(r); if (!r.ok || !j.ok) throw new Error(j.mensaje || 'No fue posible guardar la selección.'); if (j.rowVersion) rowVersionActual = j.rowVersion; mostrarMensajeCarga(j.mensaje || 'Selección guardada.','ok'); await cargarCargaFisica(); } catch (e) { mostrarMensajeCarga(e.message,'error'); } finally { btn.innerHTML = original; }
            });
            const scan = document.getElementById('lgCargaScan'), btnEscanear = document.getElementById('lgEscanearCarga');
            async function escanearCaja() {
                if (!scan) return; const codigo = (scan.value || '').trim(); if (!codigo) { mostrarMensajeCarga('Escanea o captura una etiqueta de caja.','error'); scan.focus(); return; }
                const original = btnEscanear?.innerHTML;
                try { if (btnEscanear) { btnEscanear.disabled = true; btnEscanear.innerHTML = '<i class="fa-solid fa-spinner fa-spin"></i> Validando...'; } const datos = new URLSearchParams(); datos.append('__RequestVerificationToken',token); datos.append('embarqueId',String(embarqueId)); datos.append('codigo',codigo); const r = await fetch(urlEscanearCarga,{method:'POST',headers:{'Content-Type':'application/x-www-form-urlencoded; charset=UTF-8','X-Requested-With':'XMLHttpRequest'},body:datos.toString()}); const j = await leerJson(r); if (!r.ok || !j.ok) throw new Error(j.mensaje || 'No fue posible registrar la caja.'); if (j.rowVersion) rowVersionActual = j.rowVersion; scan.value = ''; mostrarMensajeCarga(j.mensaje || 'Caja registrada.','ok'); await cargarCargaFisica(); scan.focus(); } catch (e) { mostrarMensajeCarga(e.message,'error'); scan.select(); } finally { if (btnEscanear) { btnEscanear.disabled = false; btnEscanear.innerHTML = original || '<i class="fa-solid fa-barcode"></i>Registrar'; } }
            }
            scan?.addEventListener('keydown', e => { if (e.key === 'Enter' || e.key === 'Tab') { e.preventDefault(); escanearCaja(); } }); btnEscanear?.addEventListener('click', escanearCaja);
            document.getElementById('lgConfirmarCargaFisica')?.addEventListener('click', async () => {
                if (!cargaActual?.puedeConfirmar) { mostrarMensajeCarga('Selecciona o escanea al menos una caja completa antes de confirmar.','error'); return; }
                if (!rowVersionActual) await cargarCargaFisica();
                const parcial = Boolean(cargaActual?.cargaParcial), pendientes = Number(cargaActual?.piezasPendientes || 0);
                const texto = parcial ? `¿Confirmar carga parcial? ${nf(pendientes)} PZA quedarán automáticamente como Expeditadas para un siguiente embarque.` : '¿Confirmar la carga física?';
                if (!confirm(texto)) return;
                const btn = document.getElementById('lgConfirmarCargaFisica'), original = btn.innerHTML;
                try { btn.disabled = true; btn.innerHTML = '<i class="fa-solid fa-spinner fa-spin"></i> Confirmando...'; const datos = new URLSearchParams(); datos.append('__RequestVerificationToken',token); datos.append('embarqueId',String(embarqueId)); datos.append('rowVersion',rowVersionActual); const r = await fetch(urlConfirmarCarga,{method:'POST',headers:{'Content-Type':'application/x-www-form-urlencoded; charset=UTF-8','X-Requested-With':'XMLHttpRequest'},body:datos.toString()}); const j = await leerJson(r); if (!r.ok || !j.ok) throw new Error(j.mensaje || 'No fue posible confirmar la carga.'); alert(j.mensaje || 'Carga confirmada.'); window.location.reload(); } catch (e) { mostrarMensajeCarga(e.message,'error'); btn.disabled = false; btn.innerHTML = original; }
