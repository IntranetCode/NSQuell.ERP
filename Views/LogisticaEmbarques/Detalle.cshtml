                        const grid = grupo.querySelector('.box-grid');
                        if (!cajas.length) grid.innerHTML = '<div class="part-empty">No hay cajas completas disponibles para esta parte.</div>';
                        cajas.forEach(caja => {
                            const seleccionada = Boolean(caja.seleccionada), sugerida = !seleccionada && sugeridas.has(Number(caja.cajaId));
                            const card = document.createElement('label'); card.className = `box-option${seleccionada ? ' selected' : ''}${sugerida ? ' suggested' : ''}`; card.dataset.sugerida = sugerida ? 'true' : 'false';
                            card.innerHTML = `<input class="load-box-check" type="checkbox" value="${Number(caja.cajaId || 0)}" data-cantidad="${Number(caja.cantidad || 0)}" ${seleccionada ? 'checked' : ''} ${cerrado ? 'disabled' : ''}/><div class="box-main"><strong>${esc(caja.etiqueta || `Caja ${caja.cajaId}`)}</strong><span>Caja ${nf(caja.numeroCaja)} · OF ${esc(caja.numeroOF || '—')}${caja.lote ? ` · Lote ${esc(caja.lote)}` : ''}</span><span><i class="fa-solid fa-location-dot"></i> ${esc(caja.ubicacion || 'Ubicación no registrada')}${caja.fechaEntrada ? ` · ${esc(caja.fechaEntrada)}` : ''}</span></div><div class="box-qty"><strong>${nf(caja.cantidad)} PZA</strong><span>${seleccionada ? 'Seleccionada' : sugerida ? 'Sugerida' : (caja.estatus || 'Disponible')}</span></div>`;
