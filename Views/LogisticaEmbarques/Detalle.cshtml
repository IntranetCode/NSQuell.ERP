            });
            document.getElementById('lgConfirmarSalidaPlanta')?.addEventListener('click', async () => {
                if (formaEnvio !== 'Paqueteria') { alert('Esta acción corresponde únicamente a Paquetería.'); return; }
                try { if (!rowVersionActual) await cargarCargaFisica(); } catch (e) { alert(e.message); return; }
                if (!confirm('¿Confirmar que la mercancía fue entregada físicamente a la paquetería? El embarque pasará a En ruta.')) return;
                const btn = document.getElementById('lgConfirmarSalidaPlanta'), original = btn.innerHTML;
                try { btn.disabled = true; btn.innerHTML = '<i class="fa-solid fa-spinner fa-spin"></i> Confirmando...'; const datos = new URLSearchParams(); datos.append('__RequestVerificationToken',token); datos.append('embarqueId',String(embarqueId)); datos.append('rowVersion',rowVersionActual); const r = await fetch(urlConfirmarSalidaPlanta,{method:'POST',headers:{'Content-Type':'application/x-www-form-urlencoded; charset=UTF-8','X-Requested-With':'XMLHttpRequest'},body:datos.toString()}); const j = await leerJson(r); if (!r.ok || !j.ok) throw new Error(j.mensaje || 'No fue posible confirmar la salida.'); alert(j.mensaje || 'Salida confirmada.'); window.location.reload(); } catch (e) { alert(e.message); btn.disabled = false; btn.innerHTML = original; }
            });
            document.getElementById('formRecoleccionCliente')?.addEventListener('submit', async e => {
                e.preventDefault(); const form = e.currentTarget, files = [...(document.getElementById('lgRecoleccionEvidencias')?.files || [])]; if (!files.length) { alert('Adjunta al menos una evidencia de la recolección.'); return; }
                try { if (!rowVersionActual) await cargarCargaFisica(); } catch (err) { alert(err.message); return; }
                const row = document.getElementById('lgRecoleccionRowVersion'); if (row) row.value = rowVersionActual; if (!confirm('¿Confirmar la recolección? Al hacerlo, el embarque quedará Entregado y cerrado.')) return;
                const btn = document.getElementById('lgConfirmarRecoleccion'), original = btn.innerHTML, fd = new FormData(form); fd.set('rowVersion',rowVersionActual);
                try { btn.disabled = true; btn.innerHTML = '<i class="fa-solid fa-spinner fa-spin"></i> Cerrando...'; const r = await fetch(urlConfirmarRecoleccion,{method:'POST',headers:{'X-Requested-With':'XMLHttpRequest'},body:fd}); const j = await leerJson(r); if (!r.ok || !j.ok) throw new Error(j.mensaje || 'No fue posible confirmar la recolección.'); alert(j.mensaje || 'Recolección confirmada.'); window.location.reload(); } catch (err) { alert(err.message); btn.disabled = false; btn.innerHTML = original; }
            });
            const fechaEntrega = document.getElementById('lgFechaEntrega');
            if (fechaEntrega && !fechaEntrega.value) { const ahora = new Date(); ahora.setMinutes(ahora.getMinutes() - ahora.getTimezoneOffset()); fechaEntrega.value = ahora.toISOString().slice(0,16); }
            const evidenciasEntrega = document.getElementById('lgEntregaEvidencias'), infoEvidencias = document.getElementById('lgEntregaEvidenciasInfo');
            evidenciasEntrega?.addEventListener('change', () => { const archivos = [...evidenciasEntrega.files]; if (infoEvidencias) infoEvidencias.textContent = archivos.length ? `${archivos.length} archivo(s) seleccionado(s) · ${archivos.map(x => x.name).join(' · ')}` : 'Selecciona al menos una foto o PDF. Máximo 15 archivos.'; });
            document.getElementById('formEntregaOperacion')?.addEventListener('submit', async e => {
                e.preventDefault(); const form = e.currentTarget, archivos = [...(evidenciasEntrega?.files || [])]; if (!archivos.length) { alert('Adjunta al menos una evidencia de entrega.'); return; }
                try { if (!rowVersionActual) await cargarCargaFisica(); } catch (err) { alert(err.message); return; }
                const rowInput = document.getElementById('lgEntregaRowVersion'); if (rowInput) rowInput.value = rowVersionActual; if (!confirm('¿Confirmar la entrega y cerrar este embarque?')) return;
                const btn = document.getElementById('lgConfirmarEntrega'), original = btn.innerHTML, datos = new FormData(form);
                try { btn.disabled = true; btn.innerHTML = '<i class="fa-solid fa-spinner fa-spin me-1"></i>Guardando...'; const r = await fetch(urlCerrarEntrega,{method:'POST',headers:{'X-Requested-With':'XMLHttpRequest'},body:datos}); const j = await leerJson(r); if (!r.ok || !j.ok) throw new Error(j.mensaje || 'No fue posible confirmar la entrega.'); alert(j.mensaje || 'Entrega confirmada.'); window.location.reload(); } catch (err) { alert(err.message); btn.disabled = false; btn.innerHTML = original; }
            });
            document.querySelectorAll('form.js-single-submit').forEach(form => form.addEventListener('submit', e => { if (e.defaultPrevented) return; if (form.dataset.enviando === '1') { e.preventDefault(); return; } form.dataset.enviando = '1'; const btn = form.querySelector('button[type="submit"]'); if (btn) btn.disabled = true; }));
            if (['Programado','Preparando','Preparado','Cargando','Cargado','En ruta'].includes(estatusInicial) && formaEnvio && formaEnvio !== 'Pendiente') {
