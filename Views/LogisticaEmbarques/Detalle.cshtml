    /* =========================================================
           LOGISTICA ERP - AJUSTE FINAL DE JERARQUIA VISUAL
           No modifica acciones, formularios ni reglas de negocio.
           ========================================================= */
    :root {
        --lg-blue: #173a7a;
        --lg-blue-2: #2f63ad;
        --lg-text: #172033;
        --lg-muted: #6d7888;
        --lg-border: #dce4ee;
        --lg-shadow: 0 8px 24px rgba(22,42,75,.055);
    }

    .detalle-page {
        max-width: 1760px;
        margin: 0 auto;
        color: var(--lg-text);
    }

    .detalle-header {
        align-items: center;
        padding: 15px 17px;
        margin-bottom: 12px;
        border: 1px solid var(--lg-border);
        border-left: 4px solid var(--lg-blue);
        border-radius: 12px;
        background: #fff;
        box-shadow: var(--lg-shadow);
    }

    .detalle-title {
        font-size: 1.5rem;
        font-weight: 800;
    }

    .detalle-subtitle {
        color: var(--lg-muted);
    }

    .header-actions .btn {
        min-height: 35px;
        border-radius: 8px;
        font-weight: 650;
    }

    .status-strip {
        display: grid;
        grid-template-columns: repeat(auto-fit,minmax(145px,1fr));
        gap: 8px;
        padding: 0;
        border: 0;
        background: transparent;
        box-shadow: none;
    }

    .status-item {
        display: block;
        min-height: 67px;
        padding: 9px 11px;
        border: 1px solid var(--lg-border) !important;
        border-radius: 10px;
        background: #fff;
        box-shadow: 0 4px 13px rgba(22,42,75,.03);
    }

        .status-item span {
            display: block;
            margin-bottom: 3px;
            color: var(--lg-muted);
            font-size: .68rem;
            font-weight: 700;
        }

        .status-item strong {
            display: block;
            color: var(--lg-text);
            font-size: .98rem;
            font-weight: 800;
        }

            .status-item strong .badge {
                display: inline-block;
                margin: 0;
            }

    .progress-line {
        height: 6px;
        margin: 8px 1px 15px;
    }

    .section {
        margin-bottom: 12px;
        padding: 14px 15px 13px;
        border-color: var(--lg-border);
        border-radius: 12px;
        background: #fff;
        box-shadow: var(--lg-shadow);
    }

        .section-head,
        .section > .section-title {
            border-bottom-color: #e7edf3;
        }

    .section-title {
        color: var(--lg-text);
        font-size: .98rem;
        font-weight: 800;
    }

        .section-title::before {
            background: var(--lg-blue);
        }

    .section-subtitle {
        color: var(--lg-muted);
    }

    .info-grid > div {
        min-height: 60px;
        padding: 9px 10px;
        border: 1px solid #edf1f5;
        border-radius: 8px;
        background: #fbfcfd;
    }

    .info-label {
        color: #798495;
        font-weight: 750;
    }

    .info-value {
        color: #263448;
        font-weight: 650;
    }

    .table-wrap {
        border-color: #dfe6ee;
        border-radius: 9px;
        box-shadow: 0 2px 8px rgba(22,42,75,.02);
    }

    .compact-table thead th {
        background: #f4f7fa;
        color: #536072;
        font-weight: 800;
    }

    .form-grid .form-control,
    .form-grid .form-select {
        min-height: 37px;
        border-color: #d3dde8;
        border-radius: 8px;
    }

    .check-item,
    .doc-required-item {
        border-color: #dfe6ee;
        background: #fafbfd;
    }

    .action-row {
        padding: 9px;
        border: 1px solid #e2e8ef;
        border-radius: 9px;
        background: #f8fafc;
    }

    .history-row {
        padding: 10px;
        border-left: 3px solid #d7e1ec;
        background: #fbfcfd;
    }

    .danger-zone {
        background: #fff8f8;
        box-shadow: 0 5px 15px rgba(159,39,50,.035);
    }

    html[data-nsq-theme="dark"] .detalle-page {
        color: #e7edf6;
    }

    html[data-nsq-theme="dark"] .detalle-header,
    html[data-nsq-theme="dark"] .status-item,
    html[data-nsq-theme="dark"] .section,
