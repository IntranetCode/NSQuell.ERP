@using ERP.NSQuell.Models.ViewModels.Logistica
@model LogisticaDetalleVm
@{
    Layout = "~/Views/Shared/_Layout.cshtml";
    ViewData["Title"] = $"Embarque {Model.Folio}";

    string BadgeEstatus(string estatus) => estatus switch
    {
        "Programado" => "bg-primary",
        "Preparando" => "bg-info text-dark",
        "Preparado" => "bg-warning text-dark",
        "Cargado" => "bg-dark",
        "En ruta" => "bg-primary",
        "Entregado" => "bg-success",
        "Cancelado" => "bg-secondary",
        _ => "bg-light text-dark"
    };

    string BadgeSeveridad(string severidad) => severidad switch
    {
        "Crítica" => "bg-danger",
        "Alta" => "bg-warning text-dark",
        "Media" => "bg-info text-dark",
        "Baja" => "bg-secondary",
        _ => "bg-light text-dark"
    };

    string TextoFechaHora(DateTime? fecha, TimeSpan? hora)
    {
        if (!fecha.HasValue) return "-";
        return hora.HasValue ? $"{fecha.Value:dd/MM/yyyy} {hora.Value:hh\\:mm}" : fecha.Value.ToString("dd/MM/yyyy");
    }

    string FormaEnvioTexto() => Model.FormaEnvio switch
    {
        "Interno" => "Entrega NS",
        "Cliente" => "Cliente recoge",
        "Paqueteria" => "Paquetería",
        "Pendiente" => "Por definir",
        _ => string.IsNullOrWhiteSpace(Model.FormaEnvio) ? "Por definir" : Model.FormaEnvio
    };

    var requiereDefinirSalida = (ViewBag.RequiereDefinirSalida as bool?) == true || Model.TipoOperacion == "Pendiente" || Model.FormaEnvio == "Pendiente" || string.IsNullOrWhiteSpace(Model.TipoOperacion) || string.IsNullOrWhiteSpace(Model.FormaEnvio);
    var puedeDefinirSalida = (ViewBag.PuedeDefinirSalida as bool?) ?? (Model.Estatus is "Programado" or "Preparando" or "Preparado");
    var puedePreparar = Model.Estatus is "Programado" or "Preparando";
    var puedeEntregar = Model.Estatus == "En ruta";
    var puedeCancelar = Model.Estatus is "Programado" or "Preparando" or "Preparado";
    var puedeReprogramar = Model.Estatus is "Programado" or "Preparando" or "Preparado";
    var puedeEditarCajas = Model.Estatus is "Programado" or "Preparando";
    var puedeAgregarPartida = Model.Estatus is "Programado" or "Preparando";
    var incidenciasAbiertas = Model.Incidencias?.Count(x => x.EstaAbierta) ?? 0;
    var totalDocumentos = Model.Documentos?.Count ?? 0;
    var totalEvidencias = Model.Evidencias?.Count ?? 0;
}
@section Styles {
    <link rel="stylesheet" href="~/css/logistica.css" asp-append-version="true" />
}
<style>
    :root {
        --lg-blue: #173a7a;
        --lg-text: #172033;
        --lg-muted: #6d7888;
        --lg-border: #dce4ee;
        --lg-soft: #f7f9fc;
        --lg-shadow: 0 8px 24px rgba(22,42,75,.055)
    }

    .detalle-page {
        max-width: 1760px;
        margin: 0 auto;
        padding: 16px 18px 28px;
        color: var(--lg-text)
    }

    .detalle-header {
        display: flex;
        justify-content: space-between;
        align-items: center;
        gap: 12px;
        flex-wrap: wrap;
        padding: 14px 16px;
        margin-bottom: 10px;
        border: 1px solid var(--lg-border);
        border-left: 4px solid var(--lg-blue);
        border-radius: 12px;
        background: #fff;
        box-shadow: var(--lg-shadow)
    }

    .detalle-title {
        margin: 0;
        font-size: 1.42rem;
        font-weight: 800
    }

        .detalle-title i {
            color: var(--lg-blue)
        }

    .detalle-subtitle {
        margin: 3px 0 0;
        color: var(--lg-muted);
        font-size: .84rem
    }

    .header-actions {
        display: flex;
        gap: 6px;
        flex-wrap: wrap
    }

        .header-actions .btn {
            min-height: 34px;
            border-radius: 8px;
            font-weight: 700;
            display: inline-flex;
            align-items: center
        }

    .status-strip {
        display: grid;
        grid-template-columns: repeat(6,minmax(120px,1fr));
        gap: 7px;
        margin-bottom: 10px
    }

    .status-item {
        padding: 8px 10px;
        border: 1px solid var(--lg-border);
        border-radius: 9px;
        background: #fff
    }

        .status-item span {
            display: block;
            color: var(--lg-muted);
            font-size: .64rem;
            font-weight: 800;
            text-transform: uppercase
        }

        .status-item strong {
            display: block;
            margin-top: 2px;
            font-size: .83rem;
            font-weight: 800;
            white-space: nowrap;
            overflow: hidden;
            text-overflow: ellipsis
        }

    .progress-line {
        height: 5px;
        margin: 0 1px 10px;
        background: #e6ebf1;
        border-radius: 999px;
        overflow: hidden
    }

        .progress-line > div {
            height: 100%;
            background: linear-gradient(90deg,#173a7a,#3b72c5)
        }

    .workflow {
        display: grid;
        grid-template-columns: repeat(5,1fr);
        gap: 6px;
        margin-bottom: 10px
    }

    .workflow-step {
        padding: 8px 10px;
        border: 1px solid var(--lg-border);
        border-radius: 9px;
        background: #fafbfd
    }

        .workflow-step span {
            display: block;
            color: #7a8796;
            font-size: .6rem;
            text-transform: uppercase
        }

        .workflow-step strong {
            display: block;
            margin-top: 2px;
            font-size: .72rem
        }

        .workflow-step.done {
            border-color: #b9d7ca;
            background: #f4fbf7
        }

            .workflow-step.done strong {
                color: #17633a
            }

        .workflow-step.current {
            border-color: #7fa0cf;
            background: #f1f6fd;
            box-shadow: inset 3px 0 0 var(--lg-blue)
        }

            .workflow-step.current strong {
                color: var(--lg-blue)
            }

    .salida-pendiente {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 14px;
        margin-bottom: 10px;
        padding: 13px 14px;
        border: 1px solid #e8c56f;
        border-left: 4px solid #d99a14;
        border-radius: 11px;
        background: linear-gradient(90deg,#fff8e4,#fffdf7);
        box-shadow: var(--lg-shadow)
    }

        .salida-pendiente .sp-main {
            display: flex;
            gap: 11px;
            align-items: flex-start;
            min-width: 0
        }

        .salida-pendiente .sp-icon {
            width: 34px;
            height: 34px;
            flex: 0 0 34px;
            display: flex;
            align-items: center;
            justify-content: center;
            border-radius: 9px;
            background: #fff0bf;
            color: #8a5d00;
            font-size: 1rem
        }

        .salida-pendiente strong {
            display: block;
            color: #5d4100;
            font-size: .86rem
        }

        .salida-pendiente small {
            display: block;
            margin-top: 3px;
            color: #79653a;
            font-size: .71rem;
            line-height: 1.35
        }

        .salida-pendiente .btn-definir {
            flex: 0 0 auto;
            min-height: 38px;
            padding: 0 14px;
            border-radius: 8px;
            border: 1px solid #b98000;
            background: #8b6100;
            color: #fff;
            text-decoration: none;
            font-size: .76rem;
            font-weight: 800;
            display: inline-flex;
            align-items: center;
            gap: 6px
        }

            .salida-pendiente .btn-definir:hover {
                background: #704e00;
                color: #fff
            }

    .stage {
        margin-bottom: 10px;
        padding: 13px 14px;
        border: 1px solid var(--lg-border);
        border-radius: 12px;
        background: #fff;
        box-shadow: var(--lg-shadow)
    }

    .stage-head {
        display: flex;
        justify-content: space-between;
        align-items: center;
        gap: 10px;
        flex-wrap: wrap;
        margin-bottom: 9px;
        padding-bottom: 8px;
        border-bottom: 1px solid #e8edf3
    }

    .stage-title {
        margin: 0;
        font-size: .96rem;
        font-weight: 800
    }

    .stage-sub {
        margin: 2px 0 0;
        color: var(--lg-muted);
        font-size: .72rem
    }

    .stage-action {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 12px;
        padding: 10px 11px;
        border: 1px solid #d9e3ef;
        border-radius: 9px;
        background: #fbfcfe
    }

        .stage-action strong {
            display: block;
            font-size: .84rem
        }

        .stage-action small {
            display: block;
            margin-top: 2px;
            color: #6d7a8d;
            font-size: .7rem
        }

    .stage-btn {
        min-height: 38px;
        padding: 0 14px;
        border: 0;
        border-radius: 8px;
        background: #0f4f91;
        color: #fff;
        font-size: .78rem;
        font-weight: 800;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: 6px;
        text-decoration: none
    }

    .scan-box {
        margin-top: 9px;
        padding: 10px;
        border: 1px solid #cfdaea;
        border-radius: 9px;
        background: #f8fbff
    }

    .scan-row {
        display: grid;
        grid-template-columns: minmax(0,1fr) auto;
        gap: 8px
    }

    .scan-input {
        min-height: 41px;
        border: 2px solid #8faad0;
        border-radius: 8px;
        padding: 7px 10px;
        font-size: .82rem;
        font-weight: 700
    }

    .scan-msg {
        margin-top: 5px;
        color: #66778c;
        font-size: .7rem
    }

        .scan-msg.ok {
            color: #17633a
        }

        .scan-msg.error {
            color: #b42318
        }

    .scan-list {
        display: grid;
        gap: 6px;
        margin-top: 8px
    }

    .scan-item {
        display: grid;
        grid-template-columns: 28px minmax(220px,1fr) minmax(120px,.55fr) 90px;
        align-items: center;
        gap: 8px;
        padding: 8px 9px;
        border: 1px solid #dce4ee;
        border-radius: 8px;
        background: #fff
    }

        .scan-item.checked {
            border-color: #72a08a;
            background: #f5fbf8
        }

        .scan-item small {
            display: block;
            color: #7a8798;
            font-size: .65rem
        }

        .scan-item .qty {
            text-align: right;
            color: var(--lg-blue);
            font-weight: 800
        }

    .scan-check {
        width: 19px;
        height: 19px
    }

    .tabs-shell {
        border: 1px solid var(--lg-border);
        border-radius: 12px;
        background: #fff;
        box-shadow: var(--lg-shadow);
        overflow: hidden
    }

    .nav-tabs {
        padding: 0 10px;
        background: #f8fafc;
        border-bottom: 1px solid var(--lg-border)
    }

        .nav-tabs .nav-link {
            padding: .7rem .8rem;
            border: 0;
            border-bottom: 2px solid transparent;
            color: #687386;
            font-size: .77rem;
            font-weight: 700
        }

            .nav-tabs .nav-link.active {
                color: var(--lg-blue);
                background: transparent;
                border-bottom-color: var(--lg-blue)
            }

    .tab-content {
        padding: 12px
    }

    .section-head {
        display: flex;
        justify-content: space-between;
        align-items: center;
        gap: 8px;
        flex-wrap: wrap;
        margin-bottom: 9px
    }

        .section-head h3 {
            margin: 0;
            font-size: .9rem;
            font-weight: 800
        }

        .section-head p {
            margin: 2px 0 0;
            color: var(--lg-muted);
            font-size: .69rem
        }

    .info-grid {
        display: grid;
        grid-template-columns: repeat(12,1fr);
        gap: 8px
    }

    .i3 {
        grid-column: span 3
    }

    .i4 {
        grid-column: span 4
    }

    .i6 {
        grid-column: span 6
    }

    .i12 {
        grid-column: span 12
    }

    .info-box {
        padding: 8px 9px;
        border: 1px solid #edf1f5;
        border-radius: 8px;
        background: #fbfcfd
    }

    .info-label {
        margin-bottom: 2px;
        color: #798495;
        font-size: .63rem;
        font-weight: 800;
        text-transform: uppercase
    }

    .info-value {
        font-size: .8rem;
        font-weight: 650;
        word-break: break-word
    }

    .visual-only {
        display: inline-flex;
        margin-left: 4px;
        padding: 1px 5px;
        border-radius: 999px;
        background: #eef2f6;
        color: #5e6b7c;
        font-size: .56rem;
        font-weight: 800;
        text-transform: uppercase
    }

    .compact-form {
        display: grid;
        grid-template-columns: repeat(12,1fr);
        gap: 8px;
        align-items: end
    }

    .f1 {
        grid-column: span 1
    }

    .f2 {
        grid-column: span 2
    }

    .f3 {
        grid-column: span 3
    }

    .f4 {
        grid-column: span 4
    }

    .f6 {
        grid-column: span 6
    }

    .f8 {
        grid-column: span 8
    }

    .f10 {
        grid-column: span 10
    }

    .f12 {
        grid-column: span 12
    }

    .compact-form label {
        display: block;
        margin-bottom: 3px;
        color: #465164;
        font-size: .7rem;
        font-weight: 700
    }

    .compact-form .form-control, .compact-form .form-select {
        min-height: 36px;
        border-color: #d3dde8;
        border-radius: 8px;
        font-size: .79rem
    }

    .required:after {
        content: " *";
        color: #dc3545;
        font-weight: 800
    }

    .table-wrap {
        width: 100%;
        overflow-x: auto;
        border: 1px solid #dfe6ee;
        border-radius: 9px;
        background: #fff
    }

    .compact-table {
        margin: 0;
        font-size: .77rem
    }

        .compact-table th {
            padding: .5rem;
            background: #f4f7fa;
            color: #536072;
            font-size: .66rem;
            font-weight: 800;
            text-transform: uppercase;
            white-space: nowrap
        }

        .compact-table td {
            padding: .48rem;
            vertical-align: middle;
            border-color: #edf0f4
        }

        .compact-table tbody tr:nth-child(even) td {
            background: #fbfcfd
        }

    .badge-mini {
        font-size: .66rem;
        padding: .34em .54em
    }

    .checklist {
        display: grid;
        grid-template-columns: repeat(2,minmax(0,1fr));
        gap: 7px
    }

    .check-item {
        display: flex;
        gap: 8px;
        align-items: flex-start;
        padding: 8px 9px;
        border: 1px solid #dfe6ee;
        border-radius: 8px;
        background: #fafbfd
    }

        .check-item strong {
            display: block;
            font-size: .77rem
        }

        .check-item small {
            display: block;
            color: #6c757d;
            font-size: .68rem
        }

    .doc-required {
        display: grid;
        grid-template-columns: repeat(4,minmax(0,1fr));
        gap: 7px;
        margin-bottom: 9px
    }

    .doc-required-item {
        padding: 8px 9px;
        border: 1px solid #dfe6ee;
        border-radius: 8px;
        background: #fafbfd;
        font-size: .72rem
    }

    .doc-note {
        margin-bottom: 9px;
        padding: 8px 10px;
        border: 1px dashed #cbd8e6;
        border-radius: 8px;
        background: #f8fbff;
        color: #56667b;
        font-size: .71rem
    }

    .history-row {
        display: grid;
        grid-template-columns: 140px 155px 1fr 145px;
        gap: 9px;
        padding: 8px;
        border-bottom: 1px solid #e9edf2;
        font-size: .75rem
    }

        .history-row:nth-child(even) {
            background: #fbfcfd
        }

    .history-date, .history-user {
        color: #798394
    }

    .empty {
        padding: 22px 10px;
        border: 1px dashed #d8e0e8;
        border-radius: 8px;
        background: #fbfcfd;
        color: #6c757d;
        text-align: center;
        font-size: .78rem
    }

    .danger-box {
        margin-top: 12px;
        padding: 10px;
        border: 1px solid #efc5ca;
        border-radius: 9px;
        background: #fff8f8
    }

    html[data-nsq-theme="dark"] .detalle-page {
        color: #e7edf6
    }

    html[data-nsq-theme="dark"] .detalle-header, html[data-nsq-theme="dark"] .status-item, html[data-nsq-theme="dark"] .stage, html[data-nsq-theme="dark"] .tabs-shell {
        background: #111b2d;
        border-color: #2a3a50;
        box-shadow: none
    }

    html[data-nsq-theme="dark"] .nav-tabs {
        background: #162237;
        border-color: #2a3a50
    }

    html[data-nsq-theme="dark"] .info-box, html[data-nsq-theme="dark"] .scan-item, html[data-nsq-theme="dark"] .check-item, html[data-nsq-theme="dark"] .doc-required-item {
        background: #162237;
        border-color: #2a3a50
    }

    @@media(max-width:1100px) {
        .status-strip {
            grid-template-columns: repeat(3,1fr)
        }

        .workflow {
            grid-template-columns: repeat(3,1fr)
        }

        .doc-required {
            grid-template-columns: repeat(2,1fr)
        }
    }

    @@media(max-width:850px) {
        .i3, .i4, .i6, .f1, .f2, .f3, .f4, .f6, .f8, .f10 {
            grid-column: span 6
        }

        .scan-item {
            grid-template-columns: 28px 1fr 90px
        }

            .scan-item > div:nth-child(3) {
                display: none
            }

        .history-row {
            grid-template-columns: 125px 135px 1fr
        }

        .history-user {
            display: none
        }
    }

    @@media(max-width:600px) {
        .detalle-page {
            padding: 12px 8px 22px
        }

        .status-strip, .workflow {
            grid-template-columns: repeat(2,1fr)
        }

        .header-actions {
            width: 100%
        }

            .header-actions .btn {
                flex: 1
            }

        .stage-action {
            align-items: stretch;
            flex-direction: column
        }

        .salida-pendiente {
            align-items: stretch;
            flex-direction: column
        }

            .salida-pendiente .btn-definir {
                width: 100%;
                justify-content: center
            }

        .stage-btn {
            width: 100%
        }

        .scan-row {
            grid-template-columns: 1fr
        }

        .i3, .i4, .i6, .i12, .f1, .f2, .f3, .f4, .f6, .f8, .f10, .f12 {
            grid-column: span 12
        }

        .checklist, .doc-required {
            grid-template-columns: 1fr
        }

        .history-row {
            display: block
        }

        .history-date, .history-user {
            display: block;
            margin-bottom: 3px
        }

        .nav-tabs {
            overflow-x: auto;
            flex-wrap: nowrap
        }

            .nav-tabs .nav-link {
                white-space: nowrap
            }
    }
</style>

<div class="detalle-page">
    <div class="detalle-header">
        <div>
            <h1 class="detalle-title"><i class="fa-solid fa-truck-ramp-box me-1"></i>@Model.Folio</h1>
            <div class="detalle-subtitle">@Model.Cliente · @Model.Destino</div>
        </div>
        <div class="header-actions">
            <a asp-controller="LogisticaEmbarques" asp-action="Index" class="btn btn-outline-secondary btn-sm"><i class="fa-solid fa-arrow-left me-1"></i>Regresar</a>
            <a asp-controller="LogisticaEmbarques" asp-action="Calendario" class="btn btn-outline-secondary btn-sm"><i class="fa-solid fa-calendar-days me-1"></i>Calendario</a>
        </div>
    </div>

    @if (TempData["LogisticaOk"] != null)
    {
        <div class="alert alert-success py-2 px-3 mb-2">@TempData["LogisticaOk"]</div>
    }
    @if (TempData["LogisticaError"] != null)
    {
        <div class="alert alert-danger py-2 px-3 mb-2">@TempData["LogisticaError"]</div>
    }

    @if (requiereDefinirSalida)
    {
        <div class="salida-pendiente">
            <div class="sp-main">
                <div class="sp-icon"><i class="fa-solid fa-truck-arrow-right"></i></div>
                <div>
                    <strong>Falta definir cómo saldrá este embarque</strong>
                    <small>Este embarque puede haber sido generado desde Lista de carga. Antes de continuar con la preparación y salida, define si el cliente recoge, si NS realiza la entrega o si se enviará por paquetería.</small>
                </div>
            </div>
            @if (puedeDefinirSalida)
            {
                <a asp-controller="LogisticaEmbarques" asp-action="DefinirSalida" asp-route-id="@Model.EmbarqueID" class="btn-definir">
                    <i class="fa-solid fa-gear"></i>Definir forma de salida
                </a>
            }
            else
            {
                <span class="badge bg-secondary align-self-center">Ya no editable</span>
            }
        </div>
    }

    <div class="status-strip">
        <div class="status-item"><span>Estatus</span><strong><span class="badge @BadgeEstatus(Model.Estatus)">@Model.Estatus</span></strong></div>
        <div class="status-item"><span>Avance</span><strong>@Model.PorcentajeAvance%</strong></div>
        <div class="status-item"><span>Preparado</span><strong>@Model.TotalPiezasPreparadas.ToString("N0") / @Model.TotalPiezasSolicitadas.ToString("N0")</strong></div>
        <div class="status-item"><span>Cajas</span><strong>@Model.TotalCajasAsignadas</strong></div>
        <div class="status-item"><span>Cargadas</span><strong>@Model.TotalCajasCargadas</strong></div>
        <div class="status-item"><span>Documentos</span><strong>@(Model.DocumentacionCompleta ? "Completa" : $"{Model.DocumentosFaltantes} pendiente(s)")</strong></div>
    </div>
    <div class="progress-line"><div style="width:@Math.Clamp(Model.PorcentajeAvance, 0, 100)%"></div></div>

    <div class="workflow">
        <div class="workflow-step @(Model.Estatus is "Preparando" or "Preparado" or "Cargado" or "En ruta" or "Entregado" ? "done" : "current")"><span>Paso 1</span><strong>Programado</strong></div>
        <div class="workflow-step @(Model.Estatus is "Preparado" or "Cargado" or "En ruta" or "Entregado" ? "done" : Model.Estatus == "Preparando" ? "current" : "")"><span>Paso 2</span><strong>Preparación</strong></div>
        <div class="workflow-step @(Model.Estatus is "Cargado" or "En ruta" or "Entregado" ? "done" : Model.Estatus == "Preparado" ? "current" : "")"><span>Paso 3</span><strong>Verificar cajas</strong></div>
        <div class="workflow-step @(Model.Estatus is "En ruta" or "Entregado" ? "done" : Model.Estatus == "Cargado" ? "current" : "")"><span>Paso 4</span><strong>Salida</strong></div>
        <div class="workflow-step @(Model.Estatus == "Entregado" ? "done" : Model.Estatus == "En ruta" ? "current" : "")"><span>Paso 5</span><strong>Entrega</strong></div>
    </div>

    <section class="stage">
        <div class="stage-head">
            <div>
                <h2 class="stage-title">Etapa actual: @Model.ProximaAccion</h2>
                <div class="stage-sub">@Model.ProximaAccionDetalle</div>
            </div>
            <span class="badge @BadgeEstatus(Model.Estatus)">@Model.Estatus</span>
        </div>

        @if (requiereDefinirSalida && puedeDefinirSalida)
        {
            <div class="stage-action" style="border-color:#ead28e;background:#fffaf0">
                <div>
                    <strong>Define la forma de salida antes de continuar</strong>
                    <small>La cantidad y fecha ya están programadas. Falta indicar cómo saldrá físicamente la mercancía.</small>
                </div>
                <a asp-controller="LogisticaEmbarques" asp-action="DefinirSalida" asp-route-id="@Model.EmbarqueID" class="stage-btn" style="background:#8b6100">
                    <i class="fa-solid fa-truck-arrow-right"></i>Definir salida
                </a>
            </div>
        }
        else if (Model.Estatus is "Programado" or "Preparando")
        {
            <div class="stage-action">
                <div><strong>Confirmar preparación completa</strong><small>@Model.TotalPiezasPreparadas.ToString("N0") de @Model.TotalPiezasSolicitadas.ToString("N0") PZA asignadas.</small></div>
                <form asp-controller="LogisticaEmbarques" asp-action="MarcarPreparado" method="post">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="embarqueId" value="@Model.EmbarqueID" />
                    <button class="stage-btn" type="submit" onclick="return confirm('¿Confirmar preparación completa?');"><i class="fa-solid fa-check"></i>Confirmar preparación</button>
                </form>
            </div>
        }
        else if (Model.Estatus == "Preparado")
        {
            <form asp-controller="LogisticaEmbarques" asp-action="ConfirmarSalidaViajeDesdePT" method="post" id="lgSalidaForm">
                @Html.AntiForgeryToken()
                <input type="hidden" name="embarqueId" value="@Model.EmbarqueID" />
                <div class="stage-action">
                    <div><strong>Escanea las cajas que realmente van a salir</strong><small>Deben coincidir exactamente con las cajas programadas.</small></div>
                    <button class="stage-btn" id="lgConfirmarSalida" type="submit" disabled><i class="fa-solid fa-truck-fast"></i>Confirmar salida de planta</button>
                </div>
                <div class="scan-box">
                    <div class="scan-row">
                        <input id="lgSalidaScan" class="scan-input" type="text" autocomplete="off" inputmode="none" placeholder="Escanea etiqueta de caja y presiona Enter/Tab..." autofocus />
                        <button type="button" class="stage-btn" id="lgLimpiarSalida" style="background:#fff;color:#173a7a;border:1px solid #9fb5d0">Limpiar</button>
                    </div>
                    <div class="scan-msg" id="lgSalidaMsg">0 de @Model.CajasAsignadas.Count caja(s) confirmadas.</div>
                    <div class="scan-list">
                        @foreach (var c in Model.CajasAsignadas)
                        {
                            <label class="scan-item" data-caja-id="@c.CajaID" data-numero-caja="@c.NumeroCaja" data-etiqueta="@c.Etiqueta" data-lote="@c.Lote">
                                <input class="scan-check" type="checkbox" name="cajaIdsConfirmadas" value="@c.CajaID" />
                                <div><strong>Caja #@c.NumeroCaja · @c.NumeroParte</strong><small>@c.Etiqueta</small></div>
                                <div><strong>@(string.IsNullOrWhiteSpace(c.Lote) ? "Sin lote" : c.Lote)</strong><small>OF @c.NumeroOF</small></div>
                                <div class="qty">@c.CantidadAsignada.ToString("N0") PZA</div>
                            </label>
                        }
                    </div>
                </div>
            </form>
        }
        else if (Model.Estatus == "Cargado")
        {
            <div class="stage-action">
                <div><strong>Producto cargado</strong><small>La salida se habilita cuando checklist, documentación y demás validaciones estén completas.</small></div>
                @if (Model.PuedeSalir)
                {
                    <form asp-controller="LogisticaEmbarques" asp-action="Despachar" method="post" class="js-single-submit">
                        @Html.AntiForgeryToken()
                        <input type="hidden" name="embarqueId" value="@Model.EmbarqueID" />
                        <button class="stage-btn" type="submit" onclick="return confirm('¿Confirmar salida del embarque?');"><i class="fa-solid fa-truck"></i>Confirmar salida</button>
                    </form>
                }
                else
                {
                    <span class="text-warning fw-semibold small">Salida bloqueada por checklist/documentación.</span>
                }
            </div>
        }
        else if (Model.Estatus == "En ruta")
        {
            <div class="stage-action">
                <div><strong>Embarque en tránsito</strong><small>El siguiente paso es confirmar la entrega al destinatario.</small></div>
                <a href="#tabEntrega" class="stage-btn" data-bs-toggle="tab" data-bs-target="#tabEntrega"><i class="fa-solid fa-box-open"></i>Ir a entrega</a>
            </div>
        }
        else if (Model.Estatus == "Entregado")
        {
            <div class="stage-action"><div><strong>Embarque completado</strong><small>La entrega está cerrada y conserva su trazabilidad.</small></div></div>
        }
        else
        {
            <div class="stage-action"><div><strong>Embarque cancelado</strong><small>No hay acciones operativas pendientes.</small></div></div>
        }
    </section>

    <div class="tabs-shell">
        <ul class="nav nav-tabs" role="tablist">
            <li class="nav-item"><button class="nav-link active" data-bs-toggle="tab" data-bs-target="#tabDatos" type="button"><i class="fa-solid fa-circle-info me-1"></i>Datos</button></li>
            <li class="nav-item"><button class="nav-link" data-bs-toggle="tab" data-bs-target="#tabPreparacion" type="button"><i class="fa-solid fa-boxes-stacked me-1"></i>Preparación</button></li>
            <li class="nav-item">
                <button class="nav-link" data-bs-toggle="tab" data-bs-target="#tabDocumentos" type="button">
                    <i class="fa-solid fa-file-lines me-1"></i>Documentos @if(Model.DocumentosFaltantes>0){
                    <span class="badge bg-warning text-dark ms-1">@Model.DocumentosFaltantes</span>
                                        }
                </button>
            </li>
            <li class="nav-item"><button class="nav-link" data-bs-toggle="tab" data-bs-target="#tabEvidencias" type="button"><i class="fa-solid fa-paperclip me-1"></i>Evidencias <span class="badge bg-secondary ms-1">@totalEvidencias</span></button></li>
            <li class="nav-item">
                <button class="nav-link" data-bs-toggle="tab" data-bs-target="#tabIncidencias" type="button">
                    <i class="fa-solid fa-triangle-exclamation me-1"></i>Incidencias @if(incidenciasAbiertas>0){
                    <span class="badge bg-danger ms-1">@incidenciasAbiertas</span>
                                        }
                </button>
            </li>
            @if (puedeEntregar)
            {
                <li class="nav-item"><button class="nav-link" id="tabEntregaBtn" data-bs-toggle="tab" data-bs-target="#tabEntrega" type="button"><i class="fa-solid fa-box-open me-1"></i>Entrega</button></li>
            }
            <li class="nav-item"><button class="nav-link" data-bs-toggle="tab" data-bs-target="#tabHistorial" type="button"><i class="fa-solid fa-clock-rotate-left me-1"></i>Historial</button></li>
        </ul>

        <div class="tab-content">
            <div class="tab-pane fade show active" id="tabDatos">
                <div class="section-head"><div><h3>Datos del embarque</h3><p>La fecha de carga es operativa; la fecha de entrega es referencia del Release.</p></div></div>
                <div class="info-grid">
                    <div class="i3 info-box"><div class="info-label">Cliente</div><div class="info-value">@Model.Cliente</div></div>
                    <div class="i3 info-box"><div class="info-label">Destino</div><div class="info-value">@Model.Destino</div></div>
                    <div class="i3 info-box"><div class="info-label">Operación</div><div class="info-value">@(Model.TipoOperacion == "Pendiente" || string.IsNullOrWhiteSpace(Model.TipoOperacion) ? "Por definir" : Model.TipoOperacion)</div></div>
                    <div class="i3 info-box">
                        <div class="info-label">Forma de salida</div>
                        <div class="info-value">
                            @FormaEnvioTexto()
                            @if (requiereDefinirSalida && puedeDefinirSalida)
                            {
                                <a asp-controller="LogisticaEmbarques" asp-action="DefinirSalida" asp-route-id="@Model.EmbarqueID" class="btn btn-outline-warning btn-sm ms-2 py-0 px-2" style="font-size:.65rem">
                                    Definir
                                </a>
                            }
                        </div>
                    </div>
                    <div class="i6 info-box"><div class="info-label">Dirección</div><div class="info-value">@(string.IsNullOrWhiteSpace(Model.DireccionEntrega) ? "-" : Model.DireccionEntrega)</div></div>
                    <div class="i3 info-box"><div class="info-label">Carga programada</div><div class="info-value">@TextoFechaHora(Model.FechaCargaProgramada, Model.HoraCargaProgramada)</div></div>
                    <div class="i3 info-box"><div class="info-label">Fecha entrega <span class="visual-only">Visual</span></div><div class="info-value">@(Model.FechaEntregaProgramada?.ToString("dd/MM/yyyy") ?? "-")</div></div>

                    @if (Model.FormaEnvio == "Interno")
                    {
                        <div class="i4 info-box"><div class="info-label">Ruta</div><div class="info-value">@(string.IsNullOrWhiteSpace(Model.Ruta) ? "Pendiente" : Model.Ruta)</div></div>
                        <div class="i4 info-box"><div class="info-label">Unidad</div><div class="info-value">@Model.VehiculoMostrar</div></div>
                        <div class="i4 info-box"><div class="info-label">Chofer</div><div class="info-value">@Model.ChoferMostrar</div></div>
                    }
                    else if (Model.FormaEnvio == "Cliente")
                    {
                        <div class="i4 info-box"><div class="info-label">Persona / transportista</div><div class="info-value">@Model.ChoferMostrar</div></div>
                        <div class="i4 info-box"><div class="info-label">Vehículo</div><div class="info-value">@Model.VehiculoMostrar</div></div>
                    }
                    else if (Model.FormaEnvio == "Paqueteria")
                    {
                        <div class="i3 info-box"><div class="info-label">Modalidad</div><div class="info-value">@(string.IsNullOrWhiteSpace(Model.ModalidadEnvio) ? "Pendiente" : Model.ModalidadEnvio)</div></div>
                        <div class="i3 info-box"><div class="info-label">Paquetería / transportista</div><div class="info-value">@(string.IsNullOrWhiteSpace(Model.Transportista) ? "Pendiente" : Model.Transportista)</div></div>
                        <div class="i3 info-box"><div class="info-label">Guía / referencia</div><div class="info-value">@(string.IsNullOrWhiteSpace(Model.GuiaReferencia) ? "-" : Model.GuiaReferencia)</div></div>
                        <div class="i3 info-box"><div class="info-label">Chofer externo</div><div class="info-value">@Model.ChoferMostrar</div></div>
                        <div class="i4 info-box"><div class="info-label">Vehículo externo</div><div class="info-value">@Model.VehiculoMostrar</div></div>
                    }

                    @if (Model.TipoOperacion == "Exportacion")
                    {
                        <div class="i3 info-box"><div class="info-label">Aduana</div><div class="info-value">@(Model.PasaAduana == true ? "Sí" : Model.PasaAduana == false ? "No" : "Pendiente")</div></div>
                    }
                    <div class="i3 info-box"><div class="info-label">Referencia operación</div><div class="info-value">@(string.IsNullOrWhiteSpace(Model.ReferenciaOperacion) ? "-" : Model.ReferenciaOperacion)</div></div>
                    @if (!string.IsNullOrWhiteSpace(Model.Observaciones))
                    {
                        <div class="i12 info-box"><div class="info-label">Observaciones</div><div class="info-value" style="white-space:pre-line">@Model.Observaciones</div></div>
                    }
                </div>

                @if (puedeReprogramar)
                {
                    <div class="danger-box mt-3" style="border-color:#d7e1ec;background:#fbfcfe">
                        <button class="btn btn-outline-primary btn-sm" type="button" data-bs-toggle="collapse" data-bs-target="#reprogramarCarga"><i class="fa-solid fa-calendar-arrow-up me-1"></i>Reprogramar carga</button>
                        <div class="collapse mt-2" id="reprogramarCarga">
                            <form asp-controller="LogisticaEmbarques" asp-action="Reprogramar" method="post" class="compact-form js-single-submit">
                                @Html.AntiForgeryToken()
                                <input type="hidden" name="EmbarqueID" value="@Model.EmbarqueID" />
                                <div class="f3"><label class="required">Nueva fecha</label><input type="date" name="FechaCargaProgramada" value="@Model.FechaCargaProgramada?.ToString("yyyy-MM-dd")" class="form-control" required /></div>
                                <div class="f3"><label class="required">Hora</label><input type="time" name="HoraCargaProgramada" value="@Model.HoraCargaProgramada?.ToString(@"hh\:mm")" class="form-control" required /></div>
                                <div class="f3"><label class="required">Motivo</label><input type="text" name="Motivo" maxlength="80" class="form-control" required /></div>
                                <div class="f3"><label>Observaciones</label><input type="text" name="Observaciones" maxlength="1200" class="form-control" /></div>
                                <div class="f12 text-end"><button class="btn btn-outline-primary btn-sm" type="submit">Reprogramar</button></div>
                            </form>
                        </div>
                    </div>
                }

                @if (puedeCancelar)
                {
                    <div class="danger-box">
                        <button class="btn btn-outline-danger btn-sm" type="button" data-bs-toggle="collapse" data-bs-target="#cancelarEmbarque"><i class="fa-solid fa-ban me-1"></i>Cancelar embarque</button>
                        <div class="collapse mt-2" id="cancelarEmbarque">
                            <form asp-controller="LogisticaEmbarques" asp-action="Cancelar" method="post" class="compact-form js-single-submit">
                                @Html.AntiForgeryToken()
                                <input type="hidden" name="embarqueId" value="@Model.EmbarqueID" />
                                <div class="f10"><label class="required">Motivo</label><input type="text" name="motivo" maxlength="1200" class="form-control" required /></div>
                                <div class="f2"><button class="btn btn-danger btn-sm w-100" type="submit" onclick="return confirm('¿Seguro que deseas cancelar este embarque?');">Cancelar</button></div>
                            </form>
                        </div>
                    </div>
                }
            </div>

            <div class="tab-pane fade" id="tabPreparacion">
                <div class="section-head">
                    <div><h3>Packing List / partidas</h3><p>Partes y Releases consolidados para este embarque.</p></div>
                    @if (puedeAgregarPartida && Model.DemandasDisponibles.Any())
                    {
                        <button class="btn btn-outline-primary btn-sm" type="button" data-bs-toggle="collapse" data-bs-target="#agregarPartida"><i class="fa-solid fa-plus me-1"></i>Agregar Release</button>
                    }
                </div>

                @if (puedeAgregarPartida && Model.DemandasDisponibles.Any())
                {
                    <div class="collapse mb-3" id="agregarPartida">
                        <form asp-controller="LogisticaEmbarques" asp-action="AgregarDetalle" method="post" class="compact-form js-single-submit">
                            @Html.AntiForgeryToken()
                            <input type="hidden" name="EmbarqueID" value="@Model.EmbarqueID" />
                            <div class="f8">
                                <label class="required">Release del mismo cliente</label><select name="ReleaseDetalleID" id="releaseAgregar" class="form-select" required>
                                    <option value="">Selecciona...</option>@foreach(var d in Model.DemandasDisponibles){
                                    <option value="@d.ReleaseDetalleID" data-pendiente="@d.PendienteProgramar">@d.FolioRelease · @d.NumeroParte · OF @d.NumeroOF · pendiente @d.PendienteProgramar.ToString("N0")</option>
                                }
                            </select>
                        </div>
                        <div class="f2"><label class="required">Cantidad</label><input type="number" name="CantidadSolicitada" id="cantidadAgregar" min="1" class="form-control" required /></div>
                        <div class="f2"><button type="submit" class="btn btn-outline-primary btn-sm w-100">Agregar</button></div>
                    </form>
                </div>
                                }

                <div class="table-wrap mb-3">
                    <table class="table table-sm compact-table">
                        <thead><tr><th>Release</th><th>Parte</th><th>Descripción</th><th>OF</th><th class="text-end">Solicitado</th><th class="text-end">Asignado</th><th class="text-end">Despachado</th><th class="text-end">Pendiente</th></tr></thead>
                        <tbody>
                            @foreach (var p in Model.Partidas)
                            {
                                <tr><td>@p.FolioRelease</td><td class="fw-semibold">@p.NumeroParte</td><td>@(string.IsNullOrWhiteSpace(p.Descripcion) ? "-" : p.Descripcion)</td><td>@(string.IsNullOrWhiteSpace(p.NumeroOF) ? "-" : p.NumeroOF)</td><td class="text-end">@p.CantidadSolicitada.ToString("N0")</td><td class="text-end">@p.CantidadAsignada.ToString("N0")</td><td class="text-end">@p.CantidadDespachada.ToString("N0")</td><td class="text-end fw-semibold">@p.PendienteAsignar.ToString("N0")</td></tr>
                            }
                            @if (!Model.Partidas.Any())
                            {
                                <tr><td colspan="8"><div class="empty">Sin partidas.</div></td></tr>
                            }
                        </tbody>
                    </table>
                </div>

                <div class="section-head"><div><h3>Cajas asignadas</h3><p>@Model.TotalPiezasPreparadas.ToString("N0") de @Model.TotalPiezasSolicitadas.ToString("N0") piezas preparadas.</p></div></div>
                <div class="table-wrap mb-3">
                    <table class="table table-sm compact-table">
                        <thead><tr><th>Caja</th><th>Etiqueta</th><th>Parte</th><th>OF</th><th>Lote</th><th class="text-end">Cantidad</th><th>Estatus</th><th></th></tr></thead>
                        <tbody>
                            @foreach (var c in Model.CajasAsignadas)
                            {
                                <tr>
                                    <td>#@c.NumeroCaja</td>
                                    <td class="fw-semibold">@c.Etiqueta</td>
                                    <td>@c.NumeroParte</td>
                                    <td>@c.NumeroOF</td>
                                    <td>@c.Lote</td>
                                    <td class="text-end">@c.CantidadAsignada.ToString("N0")</td>
                                    <td><span class="badge bg-light text-dark badge-mini">@c.Estatus</span></td>
                                    <td class="text-end">
                                        @if (puedeEditarCajas)
                                        {
                                            <form asp-controller="LogisticaEmbarques" asp-action="LiberarCaja" method="post" class="d-inline js-single-submit">@Html.AntiForgeryToken()<input type="hidden" name="embarqueId" value="@Model.EmbarqueID" /><input type="hidden" name="embarqueCajaId" value="@c.EmbarqueCajaID" /><button class="btn btn-outline-danger btn-sm" type="submit" onclick="return confirm('¿Liberar esta caja?');"><i class="fa-solid fa-xmark"></i></button></form>
                                        }
                                    </td>
                                </tr>
                            }
                            @if (!Model.CajasAsignadas.Any())
                            {
                                <tr><td colspan="8"><div class="empty">Todavía no hay cajas asignadas.</div></td></tr>
                            }
                        </tbody>
                    </table>
                </div>

                @if (puedeEditarCajas)
                {
                    <div class="section-head"><div><h3>Cajas PT disponibles por Release</h3><p>Úsalas solo cuando necesites ajustar la preparación.</p></div></div>
                    <div class="table-wrap mb-3">
                        <table class="table table-sm compact-table">
                            <thead><tr><th>Release</th><th>Caja</th><th>Etiqueta</th><th>Parte</th><th>OF</th><th>Lote</th><th>Ubicación</th><th class="text-end">Residual</th><th>Reservar</th></tr></thead>
                            <tbody>
                                @foreach (var c in Model.CajasDisponibles)
                                {
                                    var partidaCaja = Model.Partidas.FirstOrDefault(x => x.EmbarqueDetalleID == c.EmbarqueDetalleID);
                                    var maxReserva = Math.Min(c.Disponible, partidaCaja?.PendienteAsignar ?? 0);
                                    <tr>
                                        <td class="fw-semibold">@(string.IsNullOrWhiteSpace(partidaCaja?.FolioRelease) ? "-" : partidaCaja!.FolioRelease)</td>
                                        <td>#@c.NumeroCaja</td>
                                        <td class="fw-semibold">@c.Etiqueta</td>
                                        <td>@c.NumeroParte</td>
                                        <td>@c.NumeroOF</td>
                                        <td>@c.Lote</td>
                                        <td>@c.Ubicacion</td>
                                        <td class="text-end fw-semibold">@c.Disponible.ToString("N0")</td>
                                        <td>
                                            @if (maxReserva > 0)
                                            {
                                                <form asp-controller="LogisticaEmbarques" asp-action="ReservarCaja" method="post" class="d-flex gap-1 js-single-submit">@Html.AntiForgeryToken()<input type="hidden" name="embarqueId" value="@Model.EmbarqueID" /><input type="hidden" name="embarqueDetalleId" value="@c.EmbarqueDetalleID" /><input type="hidden" name="cajaId" value="@c.CajaID" /><input type="number" name="cantidad" min="1" max="@maxReserva" value="@maxReserva" class="form-control form-control-sm" style="max-width:95px" required /><button class="btn btn-outline-primary btn-sm" type="submit">Reservar</button></form>
                                            }
                                            else
                                            {

                                                <span class="text-muted small">Release cubierto</span>
                                            }
                                        </td>
                                    </tr>
                                }
                                @if (!Model.CajasDisponibles.Any())
                                {
                                    <tr><td colspan="9"><div class="empty">Sin cajas PT disponibles.</div></td></tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }

                <div class="section-head"><div><h3>Checklist de salida</h3><p>La salida se habilita cuando lo obligatorio esté completo.</p></div></div>
                <div class="checklist">
                    @foreach (var item in Model.Checklist)
                    {
                        <div class="check-item"><i class="fa-solid @item.Icono text-@item.Clase"></i><div><strong>@item.Concepto</strong><small>@item.Descripcion</small></div></div>
                    }
                </div>
            </div>

            <div class="tab-pane fade" id="tabDocumentos">
                <div class="section-head">
                    <div><h3>Documentación</h3><p>@(requiereDefinirSalida ? "Define primero la forma de salida para determinar los requisitos documentales." : $"Requisitos según {FormaEnvioTexto()} y operación {Model.TipoOperacion}.")</p></div>
                    @if (!requiereDefinirSalida)
                    {
                        <button class="btn btn-outline-primary btn-sm" type="button" data-bs-toggle="collapse" data-bs-target="#subirDocumento"><i class="fa-solid fa-plus me-1"></i>Subir documento</button>
                    }
                    else if (puedeDefinirSalida)
                    {
                        <a asp-controller="LogisticaEmbarques" asp-action="DefinirSalida" asp-route-id="@Model.EmbarqueID" class="btn btn-outline-warning btn-sm"><i class="fa-solid fa-gear me-1"></i>Definir salida</a>
                    }
                </div>

                <div class="doc-note">
                    @if (requiereDefinirSalida)
                    {
                        <text><strong>Forma de salida pendiente:</strong> define primero si el cliente recoge, si NS realiza la entrega o si se enviará por paquetería. Los documentos requeridos se determinarán con base en esa selección.</text>
                    }
                    else if (Model.FormaEnvio == "Interno")
                    {
                        <text><strong>Interno:</strong> Factura firmada y sellada; si no hay factura por excepción, se permite Remisión indicando motivo.</text>
                    }
                    else if (Model.FormaEnvio == "Cliente")
                    {

                        <text><strong>Cliente recoge:</strong> Factura firmada por quien recoge/transportista; si no hay factura por excepción, se permite Remisión indicando motivo.</text>
                    }
                    else if (Model.FormaEnvio == "Paqueteria")
                    {

                        <text><strong>Paquetería:</strong> Factura firmada por transportista o Remisión por excepción, Guía y documentos adicionales requeridos como Packing List/Carta Porte.</text>
                    }
                </div>

                <div class="doc-required">
                    @foreach (var r in Model.DocumentosRequeridos)
                    {
                        <div class="doc-required-item">
                            <div class="fw-semibold">@r.TipoDocumento</div>
                            <div class="text-muted">@r.AreaResponsable</div>
                            <div class="mt-1">
                                @if (r.Cargado)
                                {
                                    <span class="text-success">Cargado</span>@if(r.Validado){
                                    <span class="text-success ms-2">Validado</span>
                                }
                                else
                                {

                                    <span class="text-warning ms-2">Pendiente validar</span>
                                }
                            }
                                                        else
                            {
                                <span class="text-danger">Faltante</span>
                            }
                        </div>
                    </div>
                                        }
                </div>

                <div class="collapse mb-3" id="subirDocumento">
                    <form asp-controller="LogisticaEmbarques" asp-action="SubirDocumento" method="post" enctype="multipart/form-data" class="compact-form js-single-submit">
                        @Html.AntiForgeryToken()
                        <input type="hidden" name="embarqueId" value="@Model.EmbarqueID" />
                        <div class="f3"><label class="required">Tipo documento</label><select name="tipoDocumento" id="tipoDocumento" class="form-select" required><option value="">Selecciona...</option><option>Commercial Invoice</option><option>Carta Porte</option><option>Packing List</option><option>Factura</option><option>Remisión</option><option>Guía</option><option>XML</option><option>Carta de instrucciones</option><option>Booking</option><option>Pedimento</option><option>Otro</option></select></div>
                        <div class="f4"><label class="required">Archivo</label><input type="file" name="archivo" class="form-control" accept=".pdf,.xml,.xlsx,.xls,.docx,.doc,.jpg,.jpeg,.png" required /></div>
                        <div class="f3"><label id="lblObsDocumento">Observaciones</label><input type="text" name="observaciones" id="obsDocumento" maxlength="1000" class="form-control" /></div>
                        <div class="f2"><button class="btn btn-outline-primary btn-sm w-100" type="submit">Subir</button></div>
                    </form>
                </div>

                <div class="table-wrap">
                    <table class="table table-sm compact-table">
                        <thead><tr><th>Tipo</th><th>Archivo</th><th>Área</th><th>Carga</th><th>Validación</th><th></th></tr></thead>
                        <tbody>
                            @foreach (var d in Model.Documentos)
                            {
                                <tr>
                                    <td>@d.TipoDocumento</td>
                                    <td>@d.NombreOriginal</td>
                                    <td>@d.AreaResponsable</td>
                                    <td>@d.FechaCarga.ToString("dd/MM/yyyy HH:mm") · @d.UsuarioCargaNombre</td>
                                    <td>
                                        @if (d.Validado)
                                        {
                                            <span class="text-success">Validado @(d.FechaValidacion?.ToString("dd/MM/yyyy HH:mm"))</span>
                                        }
                                        else
                                        {

                                            <span class="text-warning">Pendiente</span>
                                        }
                                    </td>
                                    <td class="text-end text-nowrap">
                                        <a asp-controller="LogisticaEmbarques" asp-action="VerDocumento" asp-route-id="@d.EmbarqueDocumentoID" target="_blank" class="btn btn-outline-secondary btn-sm"><i class="fa-solid fa-eye"></i></a>
                                        @if (!d.Validado)
                                        {
                                            <form asp-controller="LogisticaEmbarques" asp-action="ValidarDocumento" method="post" class="d-inline js-single-submit">@Html.AntiForgeryToken()<input type="hidden" name="documentoId" value="@d.EmbarqueDocumentoID" /><input type="hidden" name="embarqueId" value="@Model.EmbarqueID" /><button class="btn btn-outline-success btn-sm" type="submit"><i class="fa-solid fa-check"></i></button></form>
                                        }
                                        <button type="button" class="btn btn-outline-danger btn-sm" onclick="mostrarRetiroDocumento(@d.EmbarqueDocumentoID)"><i class="fa-solid fa-xmark"></i></button>
                                        <form id="retirar-doc-@d.EmbarqueDocumentoID" asp-controller="LogisticaEmbarques" asp-action="RetirarDocumento" method="post" class="d-none">@Html.AntiForgeryToken()<input type="hidden" name="documentoId" value="@d.EmbarqueDocumentoID" /><input type="hidden" name="embarqueId" value="@Model.EmbarqueID" /><input type="hidden" name="motivo" id="motivo-doc-@d.EmbarqueDocumentoID" /></form>
                                    </td>
                                </tr>
                            }
                            @if (!Model.Documentos.Any())
                            {
                                <tr><td colspan="6"><div class="empty">Sin documentos cargados.</div></td></tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>

            <div class="tab-pane fade" id="tabEvidencias">
                <div class="section-head">
                    <div><h3>Evidencias</h3><p>Carga, salida, entrega o incidencia.</p></div>
                    @if (Model.Estatus != "Cancelado")
                    {
                        <button class="btn btn-outline-primary btn-sm" type="button" data-bs-toggle="collapse" data-bs-target="#subirEvidencia"><i class="fa-solid fa-plus me-1"></i>Agregar evidencia</button>
                    }
                </div>

                @if (Model.Estatus != "Cancelado")
                {
                    <div class="collapse mb-3" id="subirEvidencia">
                        <form asp-controller="LogisticaEmbarques" asp-action="SubirEvidencia" method="post" enctype="multipart/form-data" class="compact-form js-single-submit">
                            @Html.AntiForgeryToken()
                            <input type="hidden" name="embarqueId" value="@Model.EmbarqueID" />
                            <div class="f3"><label class="required">Tipo</label><select name="tipoEvidencia" class="form-select" required><option value="">Selecciona...</option><option>Carga</option><option>Salida</option><option>Entrega</option><option>Incidencia</option></select></div>
                            <div class="f4"><label class="required">Archivo</label><input type="file" name="archivo" accept=".jpg,.jpeg,.png,.pdf" class="form-control" required /></div>
                            <div class="f3"><label>Observaciones</label><input type="text" name="observaciones" maxlength="1000" class="form-control" /></div>
                            <div class="f2"><button class="btn btn-outline-primary btn-sm w-100" type="submit">Subir</button></div>
                        </form>
                    </div>
                }

                <div class="table-wrap">
                    <table class="table table-sm compact-table">
                        <thead><tr><th>Tipo</th><th>Archivo</th><th>Tamaño</th><th>Usuario</th><th>Fecha</th><th>Observaciones</th><th></th></tr></thead>
                        <tbody>
                            @foreach (var e in Model.Evidencias)
                            {
                                <tr><td>@e.TipoEvidencia</td><td>@e.NombreOriginal</td><td>@e.TamanoTexto</td><td>@e.UsuarioNombre</td><td>@e.FechaCarga.ToString("dd/MM/yyyy HH:mm")</td><td>@e.Observaciones</td><td class="text-end text-nowrap"><a asp-controller="LogisticaEmbarques" asp-action="VerEvidencia" asp-route-id="@e.EvidenciaID" target="_blank" class="btn btn-outline-secondary btn-sm"><i class="fa-solid fa-eye"></i></a><a asp-controller="LogisticaEmbarques" asp-action="DescargarEvidencia" asp-route-id="@e.EvidenciaID" class="btn btn-outline-secondary btn-sm"><i class="fa-solid fa-download"></i></a><button type="button" class="btn btn-outline-danger btn-sm" onclick="retirarEvidencia(@e.EvidenciaID)"><i class="fa-solid fa-xmark"></i></button><form id="retirar-evidencia-@e.EvidenciaID" asp-controller="LogisticaEmbarques" asp-action="EliminarEvidencia" method="post" class="d-none">@Html.AntiForgeryToken()<input type="hidden" name="evidenciaId" value="@e.EvidenciaID" /><input type="hidden" name="embarqueId" value="@Model.EmbarqueID" /><input type="hidden" name="motivo" id="motivo-evidencia-@e.EvidenciaID" /></form></td></tr>
                            }
                            @if (!Model.Evidencias.Any())
                            {
                                <tr><td colspan="7"><div class="empty">Sin evidencias.</div></td></tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>

            <div class="tab-pane fade" id="tabIncidencias">
                <div class="section-head">
                    <div><h3>Incidencias</h3><p>Registro y seguimiento operativo.</p></div>
                    @if (Model.Estatus != "Cancelado")
                    {
                        <button class="btn btn-outline-danger btn-sm" type="button" data-bs-toggle="collapse" data-bs-target="#nuevaIncidencia"><i class="fa-solid fa-plus me-1"></i>Nueva incidencia</button>
                    }
                </div>

                @if (Model.Estatus != "Cancelado")
                {
                    <div class="collapse mb-3" id="nuevaIncidencia">
                        <form asp-controller="LogisticaEmbarques" asp-action="RegistrarIncidencia" method="post" class="compact-form js-single-submit">
                            @Html.AntiForgeryToken()
                            <input type="hidden" name="EmbarqueID" value="@Model.EmbarqueID" />
                            <div class="f3"><label class="required">Tipo</label><select name="Tipo" class="form-select" required><option value="">Selecciona...</option><option>Producto incompleto</option><option>Caja dañada</option><option>Unidad no disponible</option><option>Retraso</option><option>Ruta</option><option>Documentación</option><option>Cliente / destino</option><option>Seguridad</option><option>Otro</option></select></div>
                            <div class="f2"><label class="required">Severidad</label><select name="Severidad" class="form-select" required><option>Baja</option><option selected>Media</option><option>Alta</option><option>Crítica</option></select></div>
                            <div class="f2"><label>Responsable</label><input type="text" name="Responsable" maxlength="200" class="form-control" /></div>
                            <div class="f2"><label>Compromiso</label><input type="datetime-local" name="FechaCompromiso" class="form-control" /></div>
                            <div class="f3"><label class="required">Descripción</label><input type="text" name="Descripcion" maxlength="1200" class="form-control" required /></div>
                            <div class="f12 text-end"><button class="btn btn-outline-danger btn-sm" type="submit">Registrar</button></div>
                        </form>
                    </div>
                }

                <div class="table-wrap">
                    <table class="table table-sm compact-table">
                        <thead><tr><th>Folio</th><th>Fecha</th><th>Tipo</th><th>Severidad</th><th>Descripción</th><th>Responsable</th><th>Estatus</th><th></th></tr></thead>
                        <tbody>
                            @foreach (var i in Model.Incidencias)
                            {
                                <tr>
                                    <td>@i.Folio</td>
                                    <td>@i.FechaRegistro.ToString("dd/MM/yyyy HH:mm")</td>
                                    <td>@i.Tipo</td>
                                    <td><span class="badge @BadgeSeveridad(i.Severidad) badge-mini">@i.Severidad</span></td>
                                    <td>@i.Descripcion</td>
                                    <td>@i.Responsable</td>
                                    <td>@i.Estatus</td>
                                    <td>
                                        @if (i.EstaAbierta)
                                        {
                                            <form asp-controller="LogisticaEmbarques" asp-action="CerrarIncidencia" method="post" class="d-flex gap-1 js-single-submit">@Html.AntiForgeryToken()<input type="hidden" name="IncidenciaID" value="@i.IncidenciaID" /><input type="hidden" name="EmbarqueID" value="@Model.EmbarqueID" /><input type="text" name="Solucion" maxlength="1200" class="form-control form-control-sm" placeholder="Solución" required /><button class="btn btn-outline-success btn-sm" type="submit"><i class="fa-solid fa-check"></i></button></form>
                                        }
                                    </td>
                                </tr>
                            }
                            @if (!Model.Incidencias.Any())
                            {
                                <tr><td colspan="8"><div class="empty">Sin incidencias.</div></td></tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>

            @if (puedeEntregar)
            {
                <div class="tab-pane fade" id="tabEntrega">
                    <div class="section-head"><div><h3>Registrar entrega</h3><p>Confirma quién recibe y cierra el embarque.</p></div></div>
                    <form asp-controller="LogisticaEmbarques" asp-action="Entregar" method="post" class="compact-form js-single-submit">
                        @Html.AntiForgeryToken()
                        <input type="hidden" name="EmbarqueID" value="@Model.EmbarqueID" />
                        <div class="f4"><label class="required">Recibe</label><input type="text" name="ReceptorNombre" maxlength="200" class="form-control" required /></div>
                        <div class="f3"><label>Folio remisión</label><input type="text" name="FolioRemision" maxlength="100" class="form-control" /></div>
                        <div class="f3"><label>Observaciones</label><input type="text" name="Observaciones" maxlength="1200" class="form-control" /></div>
                        <div class="f2"><button class="btn btn-success btn-sm w-100" type="submit" onclick="return confirm('¿Confirmar entrega?');">Entregar</button></div>
                    </form>
                </div>
            }

            <div class="tab-pane fade" id="tabHistorial">
                <div class="section-head"><div><h3>Historial</h3><p>Trazabilidad completa del embarque.</p></div></div>
                @foreach (var h in Model.Historial)
                {
                    <div class="history-row">
                        <div class="history-date">@h.Fecha.ToString("dd/MM/yyyy HH:mm")</div>
                        <div class="fw-semibold">@h.Evento.Replace("_", " ")</div>
                        <div>
                            @if (!string.IsNullOrWhiteSpace(h.EstadoAnterior) || !string.IsNullOrWhiteSpace(h.EstadoNuevo))
                            {
                                <div>
                                    @h.EstadoAnterior @if(!string.IsNullOrWhiteSpace(h.EstadoNuevo)){
                                    <text>→ @h.EstadoNuevo</text>
                                }
                            </div>
                        }
                        @if (!string.IsNullOrWhiteSpace(h.Observaciones))
                        {
                            <div class="text-muted">@h.Observaciones</div>
                        }
                    </div>
                    <div class="history-user">@h.Usuario</div>
                </div>
                                }
                @if (!Model.Historial.Any())
                {
                    <div class="empty">Sin historial.</div>
                }
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        (()=>{
            const release=document.getElementById('releaseAgregar'),cantidad=document.getElementById('cantidadAgregar');
            release?.addEventListener('change',()=>{const option=release.options[release.selectedIndex],max=Number(option?.dataset?.pendiente||0);if(cantidad&&max>0){cantidad.max=max;cantidad.value=max;}});

            window.mostrarRetiroDocumento=id=>{const motivo=prompt('Motivo para retirar el documento:');if(!motivo||!motivo.trim())return;const input=document.getElementById(`motivo-doc-${id}`),form=document.getElementById(`retirar-doc-${id}`);if(input&&form){input.value=motivo.trim();form.submit();}};
            window.retirarEvidencia=id=>{const motivo=prompt('Motivo para retirar la evidencia:');if(!motivo||!motivo.trim())return;const input=document.getElementById(`motivo-evidencia-${id}`),form=document.getElementById(`retirar-evidencia-${id}`);if(input&&form){input.value=motivo.trim();form.submit();}};

            const tipoDoc=document.getElementById('tipoDocumento'),obsDoc=document.getElementById('obsDocumento'),lblObs=document.getElementById('lblObsDocumento');
            const syncDocumento=()=>{const remision=tipoDoc?.value==='Remisión';if(obsDoc)obsDoc.required=remision;if(lblObs)lblObs.classList.toggle('required',remision);if(remision&&obsDoc)obsDoc.placeholder='Motivo obligatorio: cierre de mes, Finanzas fuera de servicio, etc.';else if(obsDoc)obsDoc.placeholder='';};
            tipoDoc?.addEventListener('change',syncDocumento);syncDocumento();

            const scan=document.getElementById('lgSalidaScan'),scanMsg=document.getElementById('lgSalidaMsg'),salidaBtn=document.getElementById('lgConfirmarSalida'),limpiar=document.getElementById('lgLimpiarSalida');
            const checks=Array.from(document.querySelectorAll('.scan-check')),rows=Array.from(document.querySelectorAll('.scan-item')),norm=v=>(v||'').trim().toUpperCase();
            const updateSalida=(message,type='')=>{const marked=checks.filter(x=>x.checked).length;rows.forEach(r=>r.classList.toggle('checked',r.querySelector('.scan-check')?.checked===true));if(salidaBtn)salidaBtn.disabled=checks.length===0||marked!==checks.length;if(scanMsg){scanMsg.textContent=message||`${marked} de ${checks.length} caja(s) confirmadas.`;scanMsg.classList.remove('ok','error');if(type)scanMsg.classList.add(type);}};
            const scanCaja=()=>{if(!scan)return;const code=norm(scan.value);if(!code){updateSalida('El lector no envió contenido.','error');return;}let candidates=rows.filter(r=>norm(r.dataset.etiqueta)===code);if(candidates.length===0)candidates=rows.filter(r=>norm(r.dataset.lote)===code||norm(r.dataset.cajaId)===code||norm(r.dataset.numeroCaja)===code);if(candidates.length!==1){updateSalida(candidates.length===0?'La caja escaneada no pertenece a este embarque.':'La lectura es ambigua; escanea la etiqueta completa.','error');scan.select();return;}const chk=candidates[0].querySelector('.scan-check');if(chk.checked){updateSalida(`La caja #${candidates[0].dataset.numeroCaja} ya estaba confirmada.`,'error');scan.value='';return;}chk.checked=true;scan.value='';updateSalida(`Caja #${candidates[0].dataset.numeroCaja} confirmada.`,'ok');scan.focus();};
            scan?.addEventListener('keydown',e=>{if(e.key==='Enter'||e.key==='Tab'){e.preventDefault();scanCaja();}});checks.forEach(x=>x.addEventListener('change',()=>updateSalida()));limpiar?.addEventListener('click',()=>{checks.forEach(x=>x.checked=false);updateSalida('Confirmación limpiada.');scan?.focus();});

            const salidaForm=document.getElementById('lgSalidaForm');
            salidaForm?.addEventListener('submit',e=>{
                if(checks.length===0||checks.some(x=>!x.checked)){e.preventDefault();updateSalida('Debes confirmar todas las cajas antes de salir.','error');return;}
                if(!confirm('¿Confirmar salida física de PT?')){e.preventDefault();return;}
                if(salidaForm.dataset.enviando==='1'){e.preventDefault();return;}
                salidaForm.dataset.enviando='1';
                if(salidaBtn){salidaBtn.disabled=true;salidaBtn.innerHTML='<i class="fa-solid fa-spinner fa-spin"></i> Procesando...';}
            });
            updateSalida();

            document.querySelectorAll('form.js-single-submit').forEach(form=>{
                form.addEventListener('submit',e=>{
                    if(e.defaultPrevented)return;
                    if(form.dataset.enviando==='1'){e.preventDefault();return;}
                    form.dataset.enviando='1';
                    const btn=form.querySelector('button[type="submit"]');
                    if(btn){btn.disabled=true;setTimeout(()=>{if(!form.isConnected)return;},0);}
                });
            });
        })();
    </script>
}
