</style>

<div class="detalle-page">
    <div class="detalle-header">
        <div>
            <h1 class="detalle-title"><i class="fa-solid fa-truck-ramp-box me-1"></i>@Model.Folio</h1>
            <div class="detalle-subtitle">@Model.Cliente · @Model.Destino</div>
        </div>
        <div class="header-actions">
            <a asp-controller="LogisticaEmbarques" asp-action="Index" class="btn btn-outline-secondary btn-sm"><i class="fa-solid fa-arrow-left me-1"></i>Regresar</a>
            <a asp-controller="LogisticaEmbarques" asp-action="Calendario" class="btn btn-outline-secondary btn-sm"><i class="fa-solid fa-calendar-days me-1"></i>Calendario</a>
        </div>
    </div>

    @if (TempData["LogisticaOk"] != null)
    {
        <div class="alert alert-success py-2 px-3 mb-2">@TempData["LogisticaOk"]</div>
    }
    @if (TempData["LogisticaError"] != null)
    {
        <div class="alert alert-danger py-2 px-3 mb-2">@TempData["LogisticaError"]</div>
    }

    @if (requiereDefinirSalida)
    {
        <div class="salida-pendiente">
            <div class="sp-main">
                <div class="sp-icon"><i class="fa-solid fa-truck-arrow-right"></i></div>
                <div>
                    <strong>Falta definir cómo saldrá este embarque</strong>
                    <small>Este embarque continúa el flujo iniciado desde el Centro Operativo. La configuración de salida se administra únicamente desde Centro Operativo para mantener sincronizados ruta, unidad, chofer y transporte.</small>
                </div>
            </div>
            @if (puedeDefinirSalida)
            {
                <a asp-controller="LogisticaOperacion" asp-action="Index" asp-route-q="@Model.Folio" class="btn-definir">
                    <i class="fa-solid fa-arrow-up-right-from-square"></i>Abrir Centro Operativo
                </a>
            }
            else
            {
                <span class="badge bg-secondary align-self-center">Ya no editable</span>
            }
        </div>
    }

    <div class="status-strip">
        <div class="status-item"><span>Estatus</span><strong><span class="badge @BadgeEstatus(Model.Estatus)">@Model.Estatus</span></strong></div>
        <div class="status-item"><span>Avance</span><strong>@porcentajeAvanceVista%</strong></div>
        <div class="status-item"><span>Preparado</span><strong>@Model.TotalPiezasPreparadas.ToString("N0") / @Model.TotalPiezasSolicitadas.ToString("N0")</strong></div>
        <div class="status-item"><span>Cajas</span><strong>@Model.TotalCajasAsignadas</strong></div>
        <div class="status-item"><span>Cargadas</span><strong>@Model.TotalCajasCargadas</strong></div>
        <div class="status-item"><span>Documentos</span><strong>@(Model.DocumentacionCompleta ? "Completa" : $"{Model.DocumentosFaltantes} pendiente(s)")</strong></div>
    </div>
    <div class="progress-line"><div style="width:@Math.Clamp(porcentajeAvanceVista, 0, 100)%"></div></div>

    <div class="workflow">
        <div class="workflow-step @(ClasePaso(programacionCompleta, actualProgramacion))"><span>Paso 1</span><strong>Programación</strong></div>
        <div class="workflow-step @(ClasePaso(salidaConfigurada, actualSalida))"><span>Paso 2</span><strong>Forma de salida</strong></div>
        <div class="workflow-step @(ClasePaso(preparacionConfirmada, actualPreparacion))"><span>Paso 3</span><strong>Disponibilidad PT</strong></div>
        <div class="workflow-step @(ClasePaso(documentacionCompleta, actualDocumentos))"><span>Paso 4</span><strong>Documentación</strong></div>
        <div class="workflow-step @(ClasePaso(cargaFisicaCompleta, actualCarga))"><span>Paso 5</span><strong>Carga física</strong></div>
        <div class="workflow-step @(ClasePaso(salidaPlantaCompleta, actualSalidaPlanta))"><span>Paso 6</span><strong>@(esCliente ? "Entrega al cliente" : "Salida de planta")</strong></div>
        <div class="workflow-step @(ClasePaso(entregaCompleta, actualEntrega))"><span>Paso 7</span><strong>@(esCliente ? "Cierre" : "Entrega")</strong></div>
    </div>

    <section class="stage">
        <div class="stage-head">
            <div>
                <h2 class="stage-title">Etapa actual: @proximaAccionVista</h2>
                <div class="stage-sub">@proximaAccionDetalleVista</div>
            </div>
            <span class="badge @BadgeEstatus(Model.Estatus)">@Model.Estatus</span>
        </div>

        @if (requiereDefinirSalida && puedeDefinirSalida)
        {
            <div class="stage-action" style="border-color:#ead28e;background:#fffaf0">
                <div>
                    <strong>Configura la forma de salida desde Centro Operativo</strong>
                    <small>La cantidad y fecha ya están programadas. Ruta, unidad, chofer y transporte se administran desde una sola pantalla para evitar configuraciones duplicadas.</small>
                </div>
                <a asp-controller="LogisticaOperacion" asp-action="Index" asp-route-q="@Model.Folio" class="stage-btn" style="background:#8b6100">
                    <i class="fa-solid fa-arrow-up-right-from-square"></i>Abrir Centro Operativo
                </a>
            </div>
        }
        else if (puedeTrabajarCarga)
        {
            @if (!Model.DocumentacionCompleta)
            {
                <div class="stage-action mb-2" style="border-color:#e8c56f;background:#fffaf0">
                    <div>
                        <strong>La carga puede avanzar mientras completas documentos</strong>
                        <small>Faltan @Model.DocumentosFaltantes documento(s). No bloquean la carga física, pero sí la salida de planta.</small>
                    </div>
                    <a asp-controller="LogisticaOperacion" asp-action="Index" asp-route-q="@Model.Folio" class="stage-btn" style="background:#8b6100"><i class="fa-solid fa-file-circle-check"></i>Documentación</a>
                </div>
            }
            <div class="stage-action">
                <div>
                    <strong>Carga física</strong>
                    <small>Escanea, selecciona cajas de PT o usa Carga rápida. Si el PT es parcial, el faltante regresará a Lista de carga como Expeditado.</small>
                </div>
                <button class="stage-btn" id="lgConfirmarCargaFisica" type="button" disabled><i class="fa-solid fa-circle-check"></i>Confirmar carga</button>
            </div>
            <div class="load-kpis load-kpis-large">
                <div class="load-kpi"><span>PZA programadas</span><strong id="lgCargaTotal">—</strong></div>
                <div class="load-kpi"><span>PZA seleccionadas</span><strong id="lgCargaCargadas">—</strong></div>
                <div class="load-kpi"><span>Cajas seleccionadas</span><strong id="lgCargaCajas">—</strong></div>
                <div class="load-kpi"><span>PZA pendientes</span><strong id="lgCargaPendientes">—</strong></div>
            </div>
            <div class="partial-warning" id="lgCargaParcialAviso"><i class="fa-solid fa-triangle-exclamation"></i><span id="lgCargaParcialTexto"></span></div>
            <div class="load-workspace">
                <div class="load-left">
                    <div class="scan-box load-card">
                        <div class="load-card-title"><i class="fa-solid fa-barcode"></i><div><strong>Escanear caja</strong><span>Registra una caja físicamente cargada.</span></div></div>
                        <div class="scan-row">
                            <input id="lgCargaScan" class="scan-input" type="text" autocomplete="off" inputmode="none" placeholder="Escanea la etiqueta y presiona Enter" autofocus />
                            <button type="button" class="stage-btn" id="lgEscanearCarga"><i class="fa-solid fa-barcode"></i>Registrar</button>
                        </div>
                    </div>
                    <div class="quick-load-card">
                        <div class="load-card-title"><i class="fa-solid fa-bolt"></i><div><strong>Carga rápida</strong><span>Selecciona automáticamente el máximo PT posible sin partir cajas.</span></div></div>
                        <button class="stage-btn quick-btn" type="button" id="lgAbrirCargaRapida"><i class="fa-solid fa-bolt"></i>Usar carga rápida</button>
                    </div>
                    <div class="scan-msg" id="lgCargaMsg">Consultando cajas disponibles...</div>
                </div>
                <div class="load-manual-panel">
                    <div class="load-toolbar">
                        <div><strong>Cajas PT disponibles por parte</strong><span id="lgCargaSeleccionResumen">Selecciona las cajas que realmente saldrán.</span></div>
                        <div class="load-toolbar-actions">
                            <button class="btn btn-outline-primary btn-sm" type="button" id="lgMarcarSugeridas"><i class="fa-solid fa-wand-magic-sparkles me-1"></i>Usar sugeridas</button>
                            <button class="btn btn-outline-secondary btn-sm" type="button" id="lgRecargarCajas"><i class="fa-solid fa-rotate me-1"></i>Actualizar</button>
                            <button class="btn btn-primary btn-sm" type="button" id="lgGuardarSeleccion"><i class="fa-solid fa-floppy-disk me-1"></i>Guardar selección</button>
                        </div>
                    </div>
                    <div class="load-parts-scroll" id="lgCargaLista"><div class="empty">Consultando cajas...</div></div>
                </div>
            </div>
        }
        else if (Model.Estatus == "Cargado")
        {
            @if (!Model.DocumentacionCompleta)
            {
                <div class="stage-action" style="border-color:#e8c56f;background:#fffaf0">
                    <div><strong>Completa la documentación antes de liberar la mercancía</strong><small>La carga ya quedó confirmada. Faltan @Model.DocumentosFaltantes documento(s) obligatorio(s).</small></div>
                    <a asp-controller="LogisticaOperacion" asp-action="Index" asp-route-q="@Model.Folio" class="stage-btn" style="background:#8b6100"><i class="fa-solid fa-file-circle-check"></i>Completar documentación</a>
                </div>
            }
            else if (esEntrega)
            {
                <div class="stage-action" style="border-color:#b9d7ca;background:#f4fbf7">
                    <div><strong>Viaje listo para iniciar</strong><small>Logística puede iniciarlo desde Centro Operativo. El chofer también puede iniciarlo desde su portal.</small></div>
                    <a asp-controller="LogisticaOperacion" asp-action="Index" asp-route-q="@Model.Folio" class="stage-btn"><i class="fa-solid fa-truck-fast"></i>Abrir Centro Operativo</a>
                </div>
            }
            else if (esCliente)
            {
                <div class="stage-action mb-2">
                    <div><strong>Confirmar recolección del cliente</strong><small>Al confirmar, PT se despacha y el embarque queda Entregado. No pasa por En ruta.</small></div>
                    <span class="badge bg-success">Cierre directo</span>
                </div>
                <form id="formRecoleccionCliente" class="collection-form" enctype="multipart/form-data">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="embarqueId" value="@Model.EmbarqueID" />
                    <input type="hidden" name="rowVersion" id="lgRecoleccionRowVersion" />
                    <div class="field"><label class="required">Quién recoge</label><input class="form-control" type="text" name="receptorNombre" maxlength="200" value="@(Model.ChoferMostrar == "Sin asignar" ? "" : Model.ChoferMostrar)" required /></div>
                    <div class="field"><label>Folio remisión</label><input class="form-control" type="text" name="folioRemision" maxlength="100" /></div>
                    <div class="field wide"><label>Observaciones</label><input class="form-control" type="text" name="observaciones" maxlength="1200" /></div>
                    <div class="field wide"><label class="required">Evidencia</label><input class="form-control" type="file" id="lgRecoleccionEvidencias" name="evidencias" accept="image/*,.pdf" multiple required /><small>Foto, remisión firmada o evidencia equivalente. Máximo 15 archivos.</small></div>
                    <div class="field wide"><label>Observación de evidencia</label><input class="form-control" type="text" name="observacionesEvidencia" maxlength="1000" /></div>
                    <div class="collection-actions"><button class="stage-btn" type="submit" id="lgConfirmarRecoleccion" @(Model.IncidenciasCriticas > 0 ? "disabled" : null)><i class="fa-solid fa-handshake"></i>Confirmar recolección y cerrar</button></div>
                </form>
                @if (Model.IncidenciasCriticas > 0)
                {
                    <div class="scan-msg error mt-2">Existen @Model.IncidenciasCriticas incidencia(s) crítica(s) abierta(s). Deben resolverse antes de entregar.</div>
                }
            }
            else if (esPaqueteria)
            {
                <div class="stage-action">
                    <div><strong>Confirmar salida de planta</strong><small>Confirma cuando la mercancía sea entregada físicamente a la paquetería o transportista.</small></div>
                    <button class="stage-btn" id="lgConfirmarSalidaPlanta" type="button" disabled="@(Model.IncidenciasCriticas > 0 ? "disabled" : null)"><i class="fa-solid fa-truck-fast"></i>Confirmar salida</button>
                </div>
                @if (Model.IncidenciasCriticas > 0)
                {
                    <div class="scan-msg error mt-2">Existen @Model.IncidenciasCriticas incidencia(s) crítica(s) abierta(s). Deben resolverse antes de la salida.</div>
                }
            }
            else
            {
                <div class="stage-action"><div><strong>Forma de salida incompleta</strong><small>Corrige la configuración desde Centro Operativo.</small></div><a asp-controller="LogisticaOperacion" asp-action="Index" asp-route-q="@Model.Folio" class="stage-btn"><i class="fa-solid fa-arrow-up-right-from-square"></i>Centro Operativo</a></div>
            }
        }
        else if (Model.Estatus == "En ruta")
        {
            @if (esEntrega)
            {
                <div class="stage-action" style="border-color:#b9d7ca;background:#f4fbf7">
                    <div>
                        <strong>Entrega administrada por el chofer</strong>
                        <small>El viaje está en curso. El chofer confirma llegada, receptor, remisión y evidencias desde su portal; este detalle permanece como consulta y trazabilidad.</small>
                    </div>
                    <span class="badge bg-info text-dark">En ruta</span>
                </div>
            }
            else
            {
                <div class="stage-action">
                    <div>
                        <strong>Embarque en tránsito</strong>
                        <small>El siguiente paso es confirmar quién recibió la mercancía y adjuntar al menos una evidencia.</small>
                    </div>
                    <a href="#tabEntrega" class="stage-btn" data-bs-toggle="tab" data-bs-target="#tabEntrega">
                        <i class="fa-solid fa-box-open"></i>Ir a entrega
                    </a>
                </div>
            }
        }
        else if (Model.Estatus == "Entregado")
        {
            <div class="stage-action"><div><strong>Embarque completado</strong><small>La entrega está cerrada y conserva su trazabilidad.</small></div></div>
        }
        else
        {
            <div class="stage-action"><div><strong>Embarque cancelado</strong><small>No hay acciones operativas pendientes.</small></div></div>
        }
    </section>

    <div class="tabs-shell">
        <ul class="nav nav-tabs" role="tablist">
            <li class="nav-item"><button class="nav-link active" data-bs-toggle="tab" data-bs-target="#tabDatos" type="button"><i class="fa-solid fa-circle-info me-1"></i>Datos</button></li>
            <li class="nav-item"><button class="nav-link" data-bs-toggle="tab" data-bs-target="#tabPreparacion" type="button"><i class="fa-solid fa-boxes-stacked me-1"></i>Preparación</button></li>
            <li class="nav-item">
                <button class="nav-link" data-bs-toggle="tab" data-bs-target="#tabDocumentos" type="button">
                    <i class="fa-solid fa-file-lines me-1"></i>Documentos @if(Model.DocumentosFaltantes>0){
                    <span class="badge bg-warning text-dark ms-1">@Model.DocumentosFaltantes</span>
                                        }
                </button>
            </li>
            <li class="nav-item"><button class="nav-link" data-bs-toggle="tab" data-bs-target="#tabEvidencias" type="button"><i class="fa-solid fa-paperclip me-1"></i>Evidencias <span class="badge bg-secondary ms-1">@totalEvidencias</span></button></li>
            <li class="nav-item">
                <button class="nav-link" data-bs-toggle="tab" data-bs-target="#tabIncidencias" type="button">
                    <i class="fa-solid fa-triangle-exclamation me-1"></i>Incidencias @if(incidenciasAbiertas>0){
                    <span class="badge bg-danger ms-1">@incidenciasAbiertas</span>
                                        }
                </button>
            </li>
            @if (puedeEntregar)
            {
                <li class="nav-item"><button class="nav-link" id="tabEntregaBtn" data-bs-toggle="tab" data-bs-target="#tabEntrega" type="button"><i class="fa-solid fa-box-open me-1"></i>Entrega</button></li>
            }
            <li class="nav-item"><button class="nav-link" data-bs-toggle="tab" data-bs-target="#tabHistorial" type="button"><i class="fa-solid fa-clock-rotate-left me-1"></i>Historial</button></li>
        </ul>

        <div class="tab-content">
            <div class="tab-pane fade show active" id="tabDatos">
                <div class="section-head"><div><h3>Datos del embarque</h3><p>La fecha de carga es operativa; la fecha de entrega es referencia del Release.</p></div></div>
                <div class="info-grid">
                    <div class="i3 info-box"><div class="info-label">Cliente</div><div class="info-value">@Model.Cliente</div></div>
                    <div class="i3 info-box"><div class="info-label">Destino</div><div class="info-value">@Model.Destino</div></div>
                    <div class="i3 info-box"><div class="info-label">Operación</div><div class="info-value">@(Model.TipoOperacion == "Pendiente" || string.IsNullOrWhiteSpace(Model.TipoOperacion) ? "Por definir" : Model.TipoOperacion)</div></div>
                    <div class="i3 info-box">
                        <div class="info-label">Forma de salida</div>
                        <div class="info-value">
                            @FormaEnvioTexto()
                            @if (requiereDefinirSalida && puedeDefinirSalida)
                            {
                                <a asp-controller="LogisticaOperacion" asp-action="Index" asp-route-q="@Model.Folio" class="btn btn-outline-warning btn-sm ms-2 py-0 px-2" style="font-size:.65rem">
                                    Configurar
                                </a>
                            }
                        </div>
                    </div>
                    <div class="i6 info-box"><div class="info-label">Dirección</div><div class="info-value">@(string.IsNullOrWhiteSpace(Model.DireccionEntrega) ? "-" : Model.DireccionEntrega)</div></div>
                    <div class="i3 info-box"><div class="info-label">Carga programada</div><div class="info-value">@TextoFechaHora(Model.FechaCargaProgramada, Model.HoraCargaProgramada)</div></div>
                    <div class="i3 info-box"><div class="info-label">Fecha entrega <span class="visual-only">Visual</span></div><div class="info-value">@(Model.FechaEntregaProgramada?.ToString("dd/MM/yyyy") ?? "-")</div></div>

                    @if (Model.FormaEnvio == "Interno")
                    {
                        <div class="i4 info-box"><div class="info-label">Ruta</div><div class="info-value">@(string.IsNullOrWhiteSpace(Model.Ruta) ? "Pendiente" : Model.Ruta)</div></div>
                        <div class="i4 info-box"><div class="info-label">Unidad</div><div class="info-value">@Model.VehiculoMostrar</div></div>
                        <div class="i4 info-box"><div class="info-label">Chofer</div><div class="info-value">@Model.ChoferMostrar</div></div>
                    }
                    else if (Model.FormaEnvio == "Cliente")
                    {
                        <div class="i4 info-box"><div class="info-label">Persona / transportista</div><div class="info-value">@Model.ChoferMostrar</div></div>
                        <div class="i4 info-box"><div class="info-label">Vehículo</div><div class="info-value">@Model.VehiculoMostrar</div></div>
                    }
                    else if (Model.FormaEnvio == "Paqueteria")
                    {
                        <div class="i3 info-box"><div class="info-label">Modalidad</div><div class="info-value">@(string.IsNullOrWhiteSpace(Model.ModalidadEnvio) ? "Pendiente" : Model.ModalidadEnvio)</div></div>
                        <div class="i3 info-box"><div class="info-label">Paquetería / transportista</div><div class="info-value">@(string.IsNullOrWhiteSpace(Model.Transportista) ? "Pendiente" : Model.Transportista)</div></div>
                        <div class="i3 info-box"><div class="info-label">Guía / referencia</div><div class="info-value">@(string.IsNullOrWhiteSpace(Model.GuiaReferencia) ? "-" : Model.GuiaReferencia)</div></div>
                        <div class="i3 info-box"><div class="info-label">Chofer externo</div><div class="info-value">@Model.ChoferMostrar</div></div>
                        <div class="i4 info-box"><div class="info-label">Vehículo externo</div><div class="info-value">@Model.VehiculoMostrar</div></div>
                    }

                    @if (Model.TipoOperacion == "Exportacion")
                    {
                        <div class="i3 info-box"><div class="info-label">Aduana</div><div class="info-value">@(Model.PasaAduana == true ? "Sí" : Model.PasaAduana == false ? "No" : "Pendiente")</div></div>
                    }
                    <div class="i3 info-box"><div class="info-label">Referencia operación</div><div class="info-value">@(string.IsNullOrWhiteSpace(Model.ReferenciaOperacion) ? "-" : Model.ReferenciaOperacion)</div></div>
                    @if (!string.IsNullOrWhiteSpace(Model.Observaciones))
                    {
                        <div class="i12 info-box"><div class="info-label">Observaciones</div><div class="info-value" style="white-space:pre-line">@Model.Observaciones</div></div>
                    }
                </div>

                @if (puedeReprogramar)
                {
                    <div class="danger-box mt-3" style="border-color:#d7e1ec;background:#fbfcfe">
                        <button class="btn btn-outline-primary btn-sm" type="button" data-bs-toggle="collapse" data-bs-target="#reprogramarCarga"><i class="fa-solid fa-calendar-arrow-up me-1"></i>Reprogramar carga</button>
                        <div class="collapse mt-2" id="reprogramarCarga">
                            <form asp-controller="LogisticaEmbarques" asp-action="Reprogramar" method="post" class="compact-form js-single-submit">
                                @Html.AntiForgeryToken()
                                <input type="hidden" name="EmbarqueID" value="@Model.EmbarqueID" />
                                <div class="f3"><label class="required">Nueva fecha</label><input type="date" name="FechaCargaProgramada" value="@Model.FechaCargaProgramada?.ToString("yyyy-MM-dd")" class="form-control" required /></div>
                                <div class="f3"><label class="required">Hora</label><input type="time" name="HoraCargaProgramada" value="@Model.HoraCargaProgramada?.ToString(@"hh\:mm")" class="form-control" required /></div>
                                <div class="f3"><label class="required">Motivo</label><input type="text" name="Motivo" maxlength="80" class="form-control" required /></div>
                                <div class="f3"><label>Observaciones</label><input type="text" name="Observaciones" maxlength="1200" class="form-control" /></div>
                                <div class="f12 text-end"><button class="btn btn-outline-primary btn-sm" type="submit">Reprogramar</button></div>
                            </form>
                        </div>
                    </div>
                }

                @if (puedeCancelar)
                {
                    <div class="danger-box">
                        <button class="btn btn-outline-danger btn-sm" type="button" data-bs-toggle="collapse" data-bs-target="#cancelarEmbarque"><i class="fa-solid fa-ban me-1"></i>Cancelar embarque</button>
                        <div class="collapse mt-2" id="cancelarEmbarque">
                            <form asp-controller="LogisticaEmbarques" asp-action="Cancelar" method="post" class="compact-form js-single-submit">
                                @Html.AntiForgeryToken()
                                <input type="hidden" name="embarqueId" value="@Model.EmbarqueID" />
                                <div class="f10"><label class="required">Motivo</label><input type="text" name="motivo" maxlength="1200" class="form-control" required /></div>
                                <div class="f2"><button class="btn btn-danger btn-sm w-100" type="submit" onclick="return confirm('¿Seguro que deseas cancelar este embarque?');">Cancelar</button></div>
                            </form>
                        </div>
                    </div>
                }
            </div>

            <div class="tab-pane fade" id="tabPreparacion">
                <div class="section-head">
                    <div><h3>Packing List / partidas</h3><p>Partes y Releases consolidados para este embarque.</p></div>
                    @if (puedeAgregarPartida && Model.DemandasDisponibles.Any())
                    {
                        <button class="btn btn-outline-primary btn-sm" type="button" data-bs-toggle="collapse" data-bs-target="#agregarPartida"><i class="fa-solid fa-plus me-1"></i>Agregar Release</button>
                    }
                </div>

                @if (puedeAgregarPartida && Model.DemandasDisponibles.Any())
                {
                    <div class="collapse mb-3" id="agregarPartida">
                        <form asp-controller="LogisticaEmbarques" asp-action="AgregarDetalle" method="post" class="compact-form js-single-submit">
                            @Html.AntiForgeryToken()
                            <input type="hidden" name="EmbarqueID" value="@Model.EmbarqueID" />
                            <div class="f8">
                                <label class="required">Release del mismo cliente</label><select name="ReleaseDetalleID" id="releaseAgregar" class="form-select" required>
                                    <option value="">Selecciona...</option>@foreach(var d in Model.DemandasDisponibles){
                                    <option value="@d.ReleaseDetalleID" data-pendiente="@d.PendienteProgramar">@d.FolioRelease · @d.NumeroParte · OF @d.NumeroOF · pendiente @d.PendienteProgramar.ToString("N0")</option>
                                }
                            </select>
                        </div>
                        <div class="f2"><label class="required">Cantidad</label><input type="number" name="CantidadSolicitada" id="cantidadAgregar" min="1" class="form-control" required /></div>
                        <div class="f2"><button type="submit" class="btn btn-outline-primary btn-sm w-100">Agregar</button></div>
                    </form>
                </div>
                                }

                <div class="table-wrap mb-3">
                    <table class="table table-sm compact-table">
                        <thead><tr><th>Release</th><th>Parte</th><th>Descripción</th><th>OF</th><th class="text-end">Solicitado</th><th class="text-end">Asignado</th><th class="text-end">Despachado</th><th class="text-end">Pendiente</th></tr></thead>
                        <tbody>
                            @foreach (var p in Model.Partidas)
                            {
                                <tr><td>@p.FolioRelease</td><td class="fw-semibold">@p.NumeroParte</td><td>@(string.IsNullOrWhiteSpace(p.Descripcion) ? "-" : p.Descripcion)</td><td>@(string.IsNullOrWhiteSpace(p.NumeroOF) ? "-" : p.NumeroOF)</td><td class="text-end">@p.CantidadSolicitada.ToString("N0")</td><td class="text-end">@p.CantidadAsignada.ToString("N0")</td><td class="text-end">@p.CantidadDespachada.ToString("N0")</td><td class="text-end fw-semibold">@p.PendienteAsignar.ToString("N0")</td></tr>
                            }
                            @if (!Model.Partidas.Any())
                            {
                                <tr><td colspan="8"><div class="empty">Sin partidas.</div></td></tr>
                            }
                        </tbody>
                    </table>
                </div>

                <div class="section-head"><div><h3>Cajas asignadas</h3><p>@Model.TotalPiezasPreparadas.ToString("N0") de @Model.TotalPiezasSolicitadas.ToString("N0") piezas preparadas.</p></div></div>
                <div class="table-wrap mb-3">
                    <table class="table table-sm compact-table">
                        <thead><tr><th>Caja</th><th>Etiqueta</th><th>Parte</th><th>OF</th><th>Lote</th><th class="text-end">Cantidad</th><th>Estatus</th><th></th></tr></thead>
                        <tbody>
                            @foreach (var c in Model.CajasAsignadas)
                            {
                                <tr>
                                    <td>#@c.NumeroCaja</td>
                                    <td class="fw-semibold">@c.Etiqueta</td>
                                    <td>@c.NumeroParte</td>
                                    <td>@c.NumeroOF</td>
                                    <td>@c.Lote</td>
                                    <td class="text-end">@c.CantidadAsignada.ToString("N0")</td>
                                    <td><span class="badge bg-light text-dark badge-mini">@c.Estatus</span></td>
                                    <td class="text-end">
                                        @if (puedeEditarCajas)
                                        {
                                            <form asp-controller="LogisticaEmbarques" asp-action="LiberarCaja" method="post" class="d-inline js-single-submit">@Html.AntiForgeryToken()<input type="hidden" name="embarqueId" value="@Model.EmbarqueID" /><input type="hidden" name="embarqueCajaId" value="@c.EmbarqueCajaID" /><button class="btn btn-outline-danger btn-sm" type="submit" onclick="return confirm('¿Liberar esta caja?');"><i class="fa-solid fa-xmark"></i></button></form>
                                        }
                                    </td>
                                </tr>
                            }
                            @if (!Model.CajasAsignadas.Any())
                            {
                                <tr><td colspan="8"><div class="empty">Todavía no hay cajas asignadas.</div></td></tr>
                            }
                        </tbody>
                    </table>
                </div>

                @if (puedeEditarCajas)
                {
                    <div class="section-head"><div><h3>Cajas PT disponibles por Release</h3><p>Úsalas solo cuando necesites ajustar la preparación.</p></div></div>
                    <div class="table-wrap mb-3">
                        <table class="table table-sm compact-table">
                            <thead><tr><th>Release</th><th>Caja</th><th>Etiqueta</th><th>Parte</th><th>OF</th><th>Lote</th><th>Ubicación</th><th class="text-end">Residual</th><th>Reservar</th></tr></thead>
                            <tbody>
                                @foreach (var c in Model.CajasDisponibles)
                                {
                                    var partidaCaja = Model.Partidas.FirstOrDefault(x => x.EmbarqueDetalleID == c.EmbarqueDetalleID);
                                    var maxReserva = Math.Min(c.Disponible, partidaCaja?.PendienteAsignar ?? 0);
                                    <tr>
                                        <td class="fw-semibold">@(string.IsNullOrWhiteSpace(partidaCaja?.FolioRelease) ? "-" : partidaCaja!.FolioRelease)</td>
                                        <td>#@c.NumeroCaja</td>
                                        <td class="fw-semibold">@c.Etiqueta</td>
                                        <td>@c.NumeroParte</td>
                                        <td>@c.NumeroOF</td>
                                        <td>@c.Lote</td>
                                        <td>@c.Ubicacion</td>
                                        <td class="text-end fw-semibold">@c.Disponible.ToString("N0")</td>
                                        <td>
                                            @if (maxReserva > 0)
                                            {
                                                <form asp-controller="LogisticaEmbarques" asp-action="ReservarCaja" method="post" class="d-flex gap-1 js-single-submit">@Html.AntiForgeryToken()<input type="hidden" name="embarqueId" value="@Model.EmbarqueID" /><input type="hidden" name="embarqueDetalleId" value="@c.EmbarqueDetalleID" /><input type="hidden" name="cajaId" value="@c.CajaID" /><input type="number" name="cantidad" min="1" max="@maxReserva" value="@maxReserva" class="form-control form-control-sm" style="max-width:95px" required /><button class="btn btn-outline-primary btn-sm" type="submit">Reservar</button></form>
                                            }
                                            else
                                            {

                                                <span class="text-muted small">Release cubierto</span>
                                            }
                                        </td>
                                    </tr>
                                }
                                @if (!Model.CajasDisponibles.Any())
                                {
                                    <tr><td colspan="9"><div class="empty">Sin cajas PT disponibles.</div></td></tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }

                <div class="section-head"><div><h3>Checklist de salida</h3><p>La salida se habilita cuando lo obligatorio esté completo.</p></div></div>
                <div class="checklist">
                    @foreach (var item in Model.Checklist)
                    {
                        <div class="check-item"><i class="fa-solid @item.Icono text-@item.Clase"></i><div><strong>@item.Concepto</strong><small>@item.Descripcion</small></div></div>
                    }
                </div>
            </div>

            <div class="tab-pane fade" id="tabDocumentos">
                <div class="section-head">
                    <div><h3>Documentación</h3><p>@(requiereDefinirSalida ? "Primero configura la forma de salida desde Centro Operativo para determinar los requisitos documentales." : $"Consulta del expediente requerido para {FormaEnvioTexto()} y operación {Model.TipoOperacion}.")</p></div>
                    <a asp-controller="LogisticaOperacion" asp-action="Index" asp-route-q="@Model.Folio" class="btn btn-outline-primary btn-sm"><i class="fa-solid fa-arrow-up-right-from-square me-1"></i>@(requiereDefinirSalida ? "Configurar en Centro Operativo" : "Gestionar en Centro Operativo")</a>
                </div>
                <div class="doc-note">
                    @if (requiereDefinirSalida)
                    {
                        <text><strong>Forma de salida pendiente:</strong> la configuración se realiza únicamente desde Centro Operativo. Al definir Entrega, Cliente recoge o Paquetería se calcularán automáticamente los documentos requeridos.</text>
                    }
                    else if (Model.FormaEnvio == "Interno")
                    {
                        <text><strong>Entrega:</strong> Factura firmada y sellada; si no hay factura por excepción, se permite Remisión indicando motivo. La carga de documentos se concentra en Centro Operativo.</text>
                    }
                    else if (Model.FormaEnvio == "Cliente")
                    {
                        <text><strong>Cliente recoge:</strong> Factura firmada por quien recoge/transportista; si no hay factura por excepción, se permite Remisión indicando motivo. La carga de documentos se concentra en Centro Operativo.</text>
                    }
                    else if (Model.FormaEnvio == "Paqueteria")
                    {
                        <text><strong>Paquetería:</strong> Factura firmada por transportista o Remisión por excepción, Guía y los documentos adicionales aplicables. La carga se administra desde Centro Operativo.</text>
                    }
                </div>
                <div class="doc-required">
                    @foreach (var r in Model.DocumentosRequeridos)
                    {
                        <div class="doc-required-item">
                            <div class="fw-semibold">@r.TipoDocumento</div>
                            <div class="text-muted">@r.AreaResponsable</div>
                            <div class="mt-1">
                                @if (r.Cargado && r.Validado)
                                {
                                    <span class="text-success"><i class="fa-solid fa-circle-check me-1"></i>Completo</span>
                                }
                                else if (r.Cargado)
                                {
                                    <span class="text-warning"><i class="fa-solid fa-clock me-1"></i>Pendiente de completar</span>
                                }
                                else
                                {
                                    <span class="text-danger"><i class="fa-solid fa-circle-exclamation me-1"></i>Faltante</span>
                                }
                            </div>
                        </div>
                    }
                    @if (!Model.DocumentosRequeridos.Any())
                    {
                        <div class="empty" style="grid-column:1/-1">No hay requisitos documentales definidos para la configuración actual.</div>
                    }
                </div>
                <div class="section-head mt-3"><div><h3>Documentos del embarque</h3><p>Esta vista conserva la consulta. Altas, reemplazos y retiros se realizan desde Centro Operativo para evitar dos flujos distintos.</p></div></div>
                <div class="table-wrap">
                    <table class="table table-sm compact-table">
                        <thead><tr><th>Tipo</th><th>Archivo</th><th>Área</th><th>Carga</th><th>Estado</th><th></th></tr></thead>
                        <tbody>
                            @foreach (var d in Model.Documentos)
                            {
                                <tr>
                                    <td>@d.TipoDocumento</td>
                                    <td>@d.NombreOriginal</td>
                                    <td>@d.AreaResponsable</td>
                                    <td>@d.FechaCarga.ToString("dd/MM/yyyy HH:mm") · @d.UsuarioCargaNombre</td>
                                    <td>
                                        @if (d.Validado)
                                        {
                                            <span class="text-success"><i class="fa-solid fa-circle-check me-1"></i>Completo @(d.FechaValidacion?.ToString("dd/MM/yyyy HH:mm"))</span>
                                        }
                                        else
                                        {
                                            <span class="text-warning"><i class="fa-solid fa-clock me-1"></i>Pendiente</span>
                                        }
                                    </td>
                                    <td class="text-end text-nowrap"><a asp-controller="LogisticaEmbarques" asp-action="VerDocumento" asp-route-id="@d.EmbarqueDocumentoID" target="_blank" class="btn btn-outline-secondary btn-sm" title="Ver documento"><i class="fa-solid fa-eye"></i></a></td>
                                </tr>
                            }
                            @if (!Model.Documentos.Any())
                            {
                                <tr><td colspan="6"><div class="empty">Sin documentos cargados.</div></td></tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>

            <div class="tab-pane fade" id="tabEvidencias">
                <div class="section-head">
                    <div><h3>Evidencias</h3><p>Carga, salida, entrega o incidencia.</p></div>
                    @if (Model.Estatus != "Cancelado")
                    {
                        <button class="btn btn-outline-primary btn-sm" type="button" data-bs-toggle="collapse" data-bs-target="#subirEvidencia"><i class="fa-solid fa-plus me-1"></i>Agregar evidencia</button>
                    }
                </div>

                @if (Model.Estatus != "Cancelado")
                {
                    <div class="collapse mb-3" id="subirEvidencia">
                        <form asp-controller="LogisticaEmbarques" asp-action="SubirEvidencia" method="post" enctype="multipart/form-data" class="compact-form js-single-submit">
                            @Html.AntiForgeryToken()
                            <input type="hidden" name="embarqueId" value="@Model.EmbarqueID" />
                            <div class="f3"><label class="required">Tipo</label><select name="tipoEvidencia" class="form-select" required><option value="">Selecciona...</option><option>Carga</option><option>Salida</option><option>Entrega</option><option>Incidencia</option></select></div>
                            <div class="f4"><label class="required">Archivo</label><input type="file" name="archivo" accept=".jpg,.jpeg,.png,.pdf" class="form-control" required /></div>
                            <div class="f3"><label>Observaciones</label><input type="text" name="observaciones" maxlength="1000" class="form-control" /></div>
                            <div class="f2"><button class="btn btn-outline-primary btn-sm w-100" type="submit">Subir</button></div>
                        </form>
                    </div>
                }

                <div class="table-wrap">
                    <table class="table table-sm compact-table">
                        <thead><tr><th>Tipo</th><th>Archivo</th><th>Tamaño</th><th>Usuario</th><th>Fecha</th><th>Observaciones</th><th></th></tr></thead>
                        <tbody>
                            @foreach (var e in Model.Evidencias)
                            {
                                <tr><td>@e.TipoEvidencia</td><td>@e.NombreOriginal</td><td>@e.TamanoTexto</td><td>@e.UsuarioNombre</td><td>@e.FechaCarga.ToString("dd/MM/yyyy HH:mm")</td><td>@e.Observaciones</td><td class="text-end text-nowrap"><a asp-controller="LogisticaEmbarques" asp-action="VerEvidencia" asp-route-id="@e.EvidenciaID" target="_blank" class="btn btn-outline-secondary btn-sm"><i class="fa-solid fa-eye"></i></a><a asp-controller="LogisticaEmbarques" asp-action="DescargarEvidencia" asp-route-id="@e.EvidenciaID" class="btn btn-outline-secondary btn-sm"><i class="fa-solid fa-download"></i></a><button type="button" class="btn btn-outline-danger btn-sm" onclick="retirarEvidencia(@e.EvidenciaID)"><i class="fa-solid fa-xmark"></i></button><form id="retirar-evidencia-@e.EvidenciaID" asp-controller="LogisticaEmbarques" asp-action="EliminarEvidencia" method="post" class="d-none">@Html.AntiForgeryToken()<input type="hidden" name="evidenciaId" value="@e.EvidenciaID" /><input type="hidden" name="embarqueId" value="@Model.EmbarqueID" /><input type="hidden" name="motivo" id="motivo-evidencia-@e.EvidenciaID" /></form></td></tr>
                            }
                            @if (!Model.Evidencias.Any())
                            {
                                <tr><td colspan="7"><div class="empty">Sin evidencias.</div></td></tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>

            <div class="tab-pane fade" id="tabIncidencias">
                <div class="section-head">
                    <div><h3>Incidencias</h3><p>Registro y seguimiento operativo.</p></div>
                    @if (Model.Estatus != "Cancelado")
                    {
                        <button class="btn btn-outline-danger btn-sm" type="button" data-bs-toggle="collapse" data-bs-target="#nuevaIncidencia"><i class="fa-solid fa-plus me-1"></i>Nueva incidencia</button>
                    }
                </div>

                @if (Model.Estatus != "Cancelado")
                {
                    <div class="collapse mb-3" id="nuevaIncidencia">
                        <form asp-controller="LogisticaEmbarques" asp-action="RegistrarIncidencia" method="post" class="compact-form js-single-submit">
                            @Html.AntiForgeryToken()
                            <input type="hidden" name="EmbarqueID" value="@Model.EmbarqueID" />
                            <div class="f3"><label class="required">Tipo</label><select name="Tipo" class="form-select" required><option value="">Selecciona...</option><option>Producto incompleto</option><option>Caja dañada</option><option>Unidad no disponible</option><option>Retraso</option><option>Ruta</option><option>Documentación</option><option>Cliente / destino</option><option>Seguridad</option><option>Otro</option></select></div>
                            <div class="f2"><label class="required">Severidad</label><select name="Severidad" class="form-select" required><option>Baja</option><option selected>Media</option><option>Alta</option><option>Crítica</option></select></div>
                            <div class="f2"><label>Responsable</label><input type="text" name="Responsable" maxlength="200" class="form-control" /></div>
                            <div class="f2"><label>Compromiso</label><input type="datetime-local" name="FechaCompromiso" class="form-control" /></div>
                            <div class="f3"><label class="required">Descripción</label><input type="text" name="Descripcion" maxlength="1200" class="form-control" required /></div>
                            <div class="f12 text-end"><button class="btn btn-outline-danger btn-sm" type="submit">Registrar</button></div>
                        </form>
                    </div>
                }

                <div class="table-wrap">
                    <table class="table table-sm compact-table">
                        <thead><tr><th>Folio</th><th>Fecha</th><th>Tipo</th><th>Severidad</th><th>Descripción</th><th>Responsable</th><th>Estatus</th><th></th></tr></thead>
                        <tbody>
                            @foreach (var i in Model.Incidencias)
                            {
                                <tr>
                                    <td>@i.Folio</td>
                                    <td>@i.FechaRegistro.ToString("dd/MM/yyyy HH:mm")</td>
                                    <td>@i.Tipo</td>
                                    <td><span class="badge @BadgeSeveridad(i.Severidad) badge-mini">@i.Severidad</span></td>
                                    <td>@i.Descripcion</td>
                                    <td>@i.Responsable</td>
                                    <td>@i.Estatus</td>
                                    <td>
                                        @if (i.EstaAbierta)
                                        {
                                            <form asp-controller="LogisticaEmbarques" asp-action="CerrarIncidencia" method="post" class="d-flex gap-1 js-single-submit">@Html.AntiForgeryToken()<input type="hidden" name="IncidenciaID" value="@i.IncidenciaID" /><input type="hidden" name="EmbarqueID" value="@Model.EmbarqueID" /><input type="text" name="Solucion" maxlength="1200" class="form-control form-control-sm" placeholder="Solución" required /><button class="btn btn-outline-success btn-sm" type="submit"><i class="fa-solid fa-check"></i></button></form>
                                        }
                                    </td>
                                </tr>
                            }
                            @if (!Model.Incidencias.Any())
                            {
                                <tr><td colspan="8"><div class="empty">Sin incidencias.</div></td></tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>

            @if (puedeEntregar)
            {
                <div class="tab-pane fade" id="tabEntrega">
                    <div class="section-head">
                        <div><h3>Registrar entrega</h3><p>Confirma quién recibe y adjunta una o más evidencias. La evidencia es obligatoria para cerrar el embarque.</p></div>
                    </div>
                    <form id="formEntregaOperacion" enctype="multipart/form-data" class="compact-form">
                        @Html.AntiForgeryToken()
                        <input type="hidden" name="EmbarqueID" value="@Model.EmbarqueID" />
                        <input type="hidden" name="RowVersion" id="lgEntregaRowVersion" />
                        <div class="f3"><label class="required">Recibe</label><input type="text" name="ReceptorNombre" maxlength="200" class="form-control" required /></div>
                        <div class="f3"><label class="required">Fecha y hora de entrega</label><input type="datetime-local" name="FechaEntrega" id="lgFechaEntrega" class="form-control" required /></div>
                        <div class="f3"><label>Folio remisión</label><input type="text" name="FolioRemision" maxlength="100" class="form-control" /></div>
                        <div class="f3"><label>Observación evidencias</label><input type="text" name="ObservacionesEvidencia" maxlength="500" class="form-control" /></div>
                        <div class="f8"><label>Observaciones</label><input type="text" name="Observaciones" maxlength="1200" class="form-control" /></div>
                        <div class="f4">
                            <label class="required">Evidencias</label>
                            <input type="file" id="lgEntregaEvidencias" name="Evidencias" accept="image/*,.pdf" multiple class="form-control" required />
                            <div class="delivery-files" id="lgEntregaEvidenciasInfo">Selecciona al menos una foto o PDF. Máximo 15 archivos.</div>
                        </div>
                        <div class="f12 text-end">
                            <button class="btn btn-success btn-sm" id="lgConfirmarEntrega" type="submit">
                                <i class="fa-solid fa-circle-check me-1"></i>Confirmar entrega
                            </button>
                        </div>
                    </form>
                </div>
            }

            <div class="tab-pane fade" id="tabHistorial">
                <div class="section-head"><div><h3>Historial</h3><p>Trazabilidad completa del embarque.</p></div></div>
                @foreach (var h in Model.Historial)
                {
                    <div class="history-row">
                        <div class="history-date">@h.Fecha.ToString("dd/MM/yyyy HH:mm")</div>
                        <div class="fw-semibold">@h.Evento.Replace("_", " ")</div>
                        <div>
                            @if (!string.IsNullOrWhiteSpace(h.EstadoAnterior) || !string.IsNullOrWhiteSpace(h.EstadoNuevo))
                            {
                                <div>
                                    @h.EstadoAnterior @if(!string.IsNullOrWhiteSpace(h.EstadoNuevo)){
                                    <text>→ @h.EstadoNuevo</text>
                                }
                            </div>
                        }
                        @if (!string.IsNullOrWhiteSpace(h.Observaciones))
                        {
                            <div class="text-muted">@h.Observaciones</div>
                        }
                    </div>
                    <div class="history-user">@h.Usuario</div>
                </div>
                                }
                @if (!Model.Historial.Any())
                {
                    <div class="empty">Sin historial.</div>
                }
            </div>
        </div>
    </div>
</div>


<div class="modal fade quick-modal" id="modalCargaRapidaDetalle" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered modal-dialog-scrollable">
        <div class="modal-content">
            <div class="modal-header"><div><h5 class="modal-title"><i class="fa-solid fa-bolt me-1"></i>Carga rápida</h5><div class="text-muted small">Usa el máximo PT disponible sin escanear caja por caja.</div></div><button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Cerrar"></button></div>
            <form id="formCargaRapidaDetalle" enctype="multipart/form-data">
                <div class="modal-body">
                    @Html.AntiForgeryToken()
                    <div class="mb-3"><label class="form-label required">Motivo</label><textarea class="form-control" name="motivo" rows="3" maxlength="1000" placeholder="Ej. salida urgente solicitada por cliente" required></textarea></div>
                    <div class="mb-3"><label class="form-label required">Tomar fotografía</label><input class="form-control" type="file" id="lgCargaRapidaCamara" accept="image/*" capture="environment" /><div class="form-text">En celular prioriza la cámara trasera.</div></div>
                    <div class="mb-3"><label class="form-label">Elegir fotografías existentes</label><input class="form-control" type="file" id="lgCargaRapidaGaleria" accept="image/*" multiple /></div>
                    <label class="quick-responsibility"><input type="checkbox" id="lgCargaRapidaResponsabilidad" /><span><strong>Confirmo que verifiqué físicamente la mercancía seleccionada.</strong><br />Acepto utilizar Carga rápida sin escaneo individual.</span></label>
                </div>
                <div class="modal-footer"><button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Cancelar</button><button type="submit" class="btn btn-warning fw-bold" id="lgConfirmarCargaRapida"><i class="fa-solid fa-bolt me-1"></i>Confirmar carga rápida</button></div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        (() => {
            const embarqueId = @Model.EmbarqueID;
            const estatusInicial = '@Model.Estatus';
            const formaEnvio = '@Model.FormaEnvio';
            const token = document.querySelector('input[name="__RequestVerificationToken"]')?.value || '';
            const urlObtenerCarga = '@Url.Action("ObtenerCargaFisica", "LogisticaOperacion")';
            const urlSeleccionarCajas = '@Url.Action("SeleccionarCajasCarga", "LogisticaOperacion")';
            const urlEscanearCarga = '@Url.Action("EscanearCajaCarga", "LogisticaOperacion")';
            const urlConfirmarCarga = '@Url.Action("ConfirmarCargaFisica", "LogisticaOperacion")';
            const urlConfirmarCargaRapida = '@Url.Action("ConfirmarCargaRapida", "LogisticaOperacion")';
            const urlConfirmarSalidaPlanta = '@Url.Action("ConfirmarSalidaPlanta", "LogisticaOperacion")';
            const urlConfirmarRecoleccion = '@Url.Action("ConfirmarRecoleccionCliente", "LogisticaOperacion")';
            const urlCerrarEntrega = '@Url.Action("CerrarConEvidencia", "LogisticaOperacion")';
            let rowVersionActual = '';
            let cargaActual = null;
            const release = document.getElementById('releaseAgregar');
            const cantidad = document.getElementById('cantidadAgregar');
            release?.addEventListener('change', () => {
                const option = release.options[release.selectedIndex];
                const max = Number(option?.dataset?.pendiente || 0);
                if (cantidad && max > 0) { cantidad.max = max; cantidad.value = max; }
            });
            window.retirarEvidencia = id => {
                const motivo = prompt('Motivo para retirar la evidencia:');
                if (!motivo || !motivo.trim()) return;
                const input = document.getElementById(`motivo-evidencia-${id}`);
                const form = document.getElementById(`retirar-evidencia-${id}`);
                if (input && form) { input.value = motivo.trim(); form.submit(); }
            };
            const esc = value => String(value ?? '').replaceAll('&','&amp;').replaceAll('<','&lt;').replaceAll('>','&gt;').replaceAll('"','&quot;').replaceAll("'",'&#039;');
            const nf = value => Number(value || 0).toLocaleString('es-MX');
            async function leerJson(response) { try { return await response.json(); } catch { throw new Error(`El servidor respondió ${response.status} y no devolvió JSON.`); } }
            function mostrarMensajeCarga(texto, tipo = '') {
                const msg = document.getElementById('lgCargaMsg'); if (!msg) return;
                msg.textContent = texto || ''; msg.classList.remove('ok','error'); if (tipo) msg.classList.add(tipo);
            }
            function cajasSugeridasParte(parte) {
                const cajas = (parte?.cajas || []).filter(x => !x.seleccionada && Number(x.cantidad || 0) > 0).sort((a,b) => String(a.fechaEntrada || '').localeCompare(String(b.fechaEntrada || '')) || Number(a.cajaId || 0) - Number(b.cajaId || 0));
                let restante = Math.max(0, Number(parte?.requerido || 0) - Number(parte?.piezasSeleccionadas || 0));
                const ids = new Set();
                for (const caja of cajas) { const q = Number(caja.cantidad || 0); if (q > 0 && q <= restante) { ids.add(Number(caja.cajaId)); restante -= q; } if (restante <= 0) break; }
                if (restante > 0) {
                    for (const caja of cajas.filter(x => !ids.has(Number(x.cajaId))).sort((a,b) => Number(a.cantidad || 0) - Number(b.cantidad || 0))) { const q = Number(caja.cantidad || 0); if (q > 0 && q <= restante) { ids.add(Number(caja.cajaId)); restante -= q; } if (restante <= 0) break; }
                }
                return ids;
            }
            function alternarParte(grupo, forzar = null) {
                if (!grupo) return;
                const abrir = forzar === null ? grupo.classList.contains('collapsed') : Boolean(forzar);
                grupo.classList.toggle('collapsed', !abrir);
                const head = grupo.querySelector('.load-part-head'); if (head) head.setAttribute('aria-expanded', abrir ? 'true' : 'false');
                const btn = grupo.querySelector('.load-part-toggle'); if (btn) { btn.setAttribute('aria-expanded', abrir ? 'true' : 'false'); const t = btn.querySelector('span'); if (t) t.textContent = abrir ? 'Ocultar' : 'Ver cajas'; }
            }
            function actualizarResumenSeleccion() {
                const lista = document.getElementById('lgCargaLista');
                const resumen = document.getElementById('lgCargaSeleccionResumen');
                const guardar = document.getElementById('lgGuardarSeleccion');
                if (!lista || !resumen || !guardar) return;
                const checks = [...lista.querySelectorAll('.load-box-check')];
                const marcados = checks.filter(x => x.checked);
                const piezas = marcados.reduce((a,x) => a + Number(x.dataset.cantidad || 0), 0);
                let excedido = false;
                lista.querySelectorAll('.load-part').forEach(grupo => {
                    const requerido = Number(grupo.dataset.requerido || 0);
                    const seleccion = [...grupo.querySelectorAll('.load-box-check:checked')].reduce((a,x) => a + Number(x.dataset.cantidad || 0), 0);
                    grupo.classList.toggle('over', seleccion > requerido); if (seleccion > requerido) excedido = true;
                    const el = grupo.querySelector('[data-parte-seleccion]'); if (el) el.textContent = `${nf(seleccion)} PZA`;
                    grupo.querySelectorAll('.box-option').forEach(card => { const chk = card.querySelector('.load-box-check'); if (chk) card.classList.toggle('selected', chk.checked); });
                });
                const total = Number(cargaActual?.totalPiezas || 0); const pendiente = Math.max(0, total - piezas);
                resumen.innerHTML = `<strong>${nf(marcados.length)} caja(s) · ${nf(piezas)} PZA</strong>${pendiente > 0 ? ` · quedarían ${nf(pendiente)} PZA pendientes` : ''}${excedido ? ' · <span class="text-danger fw-bold">Hay una parte excedida</span>' : ''}`;
                const cerrado = ['Cargado','En ruta','Entregado','Cancelado'].includes(cargaActual?.estatus || '');
                guardar.disabled = cerrado || marcados.length === 0 || excedido;
            }
            function renderCarga(data) {
                cargaActual = data;
                if (data?.rowVersion) {
                    rowVersionActual = data.rowVersion;
                    const r1 = document.getElementById('lgEntregaRowVersion'); if (r1) r1.value = rowVersionActual;
                    const r2 = document.getElementById('lgRecoleccionRowVersion'); if (r2) r2.value = rowVersionActual;
                }
                const total = Number(data?.totalPiezas || 0), cargadas = Number(data?.piezasCargadas || 0), pendientes = Math.max(0, Number(data?.piezasPendientes ?? total - cargadas));
                const elTotal = document.getElementById('lgCargaTotal'); if (elTotal) elTotal.textContent = `${nf(total)} PZA`;
                const elCargadas = document.getElementById('lgCargaCargadas'); if (elCargadas) elCargadas.textContent = `${nf(cargadas)} PZA`;
                const elCajas = document.getElementById('lgCargaCajas'); if (elCajas) elCajas.textContent = nf(data?.cajasAsignadas);
                const elPend = document.getElementById('lgCargaPendientes'); if (elPend) elPend.textContent = `${nf(pendientes)} PZA`;
                const aviso = document.getElementById('lgCargaParcialAviso'), avisoTexto = document.getElementById('lgCargaParcialTexto');
                if (aviso && avisoTexto) { const mostrar = cargadas > 0 && pendientes > 0; aviso.classList.toggle('show', mostrar); avisoTexto.textContent = mostrar ? `Carga parcial: ${nf(cargadas)} de ${nf(total)} PZA. Al confirmar, ${nf(pendientes)} PZA volverán a Lista de carga como Expeditadas.` : ''; }
                const confirmar = document.getElementById('lgConfirmarCargaFisica');
                if (confirmar) { confirmar.disabled = !data?.puedeConfirmar; confirmar.innerHTML = data?.cargaParcial ? '<i class="fa-solid fa-circle-check"></i>Confirmar carga parcial' : '<i class="fa-solid fa-circle-check"></i>Confirmar carga'; }
                const cerrado = ['Cargado','En ruta','Entregado','Cancelado'].includes(data?.estatus || '');
                const lista = document.getElementById('lgCargaLista');
                if (lista) {
