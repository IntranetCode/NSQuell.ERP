                        grupo.querySelector('.load-suggest')?.addEventListener('click', e => { e.stopPropagation(); alternarParte(grupo, true); grupo.querySelectorAll('.load-box-check').forEach(chk => { if (!chk.disabled) chk.checked = chk.closest('.box-option')?.dataset.sugerida === 'true' || chk.closest('.box-option')?.classList.contains('selected'); }); actualizarResumenSeleccion(); });
                        lista.appendChild(grupo);
