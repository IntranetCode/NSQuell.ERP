            margin-top: 2px
        }

        .check-item strong {
            display: block;
            font-size: .79rem
        }

        .check-item small {
            display: block;
            color: #6c757d;
            font-size: .71rem
        }

    .doc-required {
        display: grid;
        grid-template-columns: repeat(4,minmax(0,1fr));
        gap: 8px;
        margin-bottom: 10px
    }

    .doc-required-item {
        padding: 7px 8px;
        border: 1px solid #e9ecef;
        border-radius: 6px;
        font-size: .75rem
    }

    .history-row {
        display: grid;
        grid-template-columns: 145px 160px 1fr 150px;
        gap: 10px;
        padding: 7px 3px;
        border-bottom: 1px solid #f1f3f5;
        font-size: .77rem
