@model ERP.NSQuell.Models.ViewModels.Almacen.AlmacenOFIndexVm
@{
    Layout = "~/Views/Shared/_Layout.cshtml";
    ViewData["Title"] = "Material OF Solicitados";

    string BuildPageUrl(int page)
    {
        return Url.Action("Index", "AlmacenOF", new
        {
            q = Model.Busqueda,
            estatus = Model.EstatusID,
            area = Model.Area,
            desde = Model.Desde?.ToString("yyyy-MM-dd"),
            hasta = Model.Hasta?.ToString("yyyy-MM-dd"),
            pagina = page
        }) ?? "#";
    }

    string NombreMaquina(string? maquina) =>
        string.IsNullOrWhiteSpace(maquina)
            ? "Sin máquina asignada"
            : maquina.Trim();

    var ordenesPendientes = Model.Ordenes
        .Where(x => x.TienePendientesAlmacen)
        .ToList();

    var maquinasVisibles = ordenesPendientes
        .Select(x => NombreMaquina(x.Maquina))
        .Distinct(System.StringComparer.OrdinalIgnoreCase)
        .Count();
}

@section Styles {
    <link rel="stylesheet" href="~/css/Almacen/almacen-navegacion.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/nsquell-erp-theme.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/Almacen/almacen.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/Almacen/almacen-vistas.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/Almacen/almacen-temas.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/Almacen/almacen-of-v4.css" asp-append-version="true" />

    <style>
        /* NSQ_DEVOLUCION_MATERIALES_V1_2 */
        .of-return-priority {
            display: inline-flex;
            align-items: center;
            gap: 6px;
            padding: 5px 8px;
            border-radius: 999px;
            background: #b4232d;
            color: #fff;
            font-size: .68rem;
            font-weight: 900;
            text-transform: uppercase;
            letter-spacing: .03em;
        }

        .of4-item.devuelto {
            border-color: #dc5961 !important;
            background: #fff5f5 !important;
        }

        .of4-item.validacion {
            border-color: #e4b554 !important;
            background: #fffaf0 !important;
        }

        .of-return-detail {
            margin: 6px 0 9px;
            padding: 10px 12px;
            border: 1px solid #efb6ba;
            border-radius: 11px;
            background: #fff1f2;
            color: #8d2028;
            font-size: .73rem;
        }

        .of-return-detail strong {
            display: block;
            margin-bottom: 3px;
            font-weight: 950;
        }

        .of-return-detail p {
            margin: 4px 0 7px;
        }

        .of-return-evidence {
            display: inline-flex;
            align-items: center;
            gap: 6px;
            padding: 6px 9px;
            border-radius: 8px;
            background: #8d2028;
            color: #fff !important;
            text-decoration: none;
            font-weight: 850;
        }

        .of-validation-note {
            display: block;
            margin-top: 3px;
            color: #9a6700;
            font-size: .64rem;
            font-weight: 850;
        }

        html[data-nsq-theme="dark"] .of4-item.devuelto,
        html[data-bs-theme="dark"] .of4-item.devuelto {
            background: #32171b !important;
        }

        html[data-nsq-theme="dark"] .of4-item.validacion,
        html[data-bs-theme="dark"] .of4-item.validacion {
            background: #2a2415 !important;
        }

        /* NSQ_DEVOLUCION_MATERIALES_V1_3 */
        .of-return-evidence {
            border: 0;
            cursor: pointer;
        }

        .return-evidence-modal[hidden] {
            display: none !important;
        }

        .return-evidence-modal {
            position: fixed;
            inset: 0;
            z-index: 1100;
            display: grid;
            place-items: center;
            padding: 18px;
            background: rgba(7,15,30,.72);
            backdrop-filter: blur(4px);
        }

        .return-evidence-card {
            width: min(980px,94vw);
            max-height: 88vh;
            overflow: hidden;
            display: flex;
            flex-direction: column;
            border: 1px solid #d6deea;
            border-radius: 18px;
            background: #fff;
            color: #162238;
            box-shadow: 0 28px 80px rgba(0,0,0,.32);
        }

        .return-evidence-head {
            display: flex;
            align-items: flex-start;
            justify-content: space-between;
            gap: 12px;
            padding: 16px 18px;
            border-bottom: 1px solid #dce4ef;
        }

        .return-evidence-head h3 {
            margin: 0;
            font-size: 1rem;
            font-weight: 950;
        }

        .return-evidence-head p {
            margin: 4px 0 0;
            color: #6d798f;
            font-size: .72rem;
        }

        .return-evidence-close {
            width: 38px;
            height: 38px;
            flex: none;
            border: 1px solid #dce4ef;
            border-radius: 10px;
            background: #fff;
            color: #17233d;
            cursor: pointer;
        }

        .return-evidence-content {
            min-height: 0;
            overflow: auto;
            padding: 16px 18px 18px;
        }

        .return-evidence-info {
            display: grid;
            grid-template-columns: 1fr 1fr;
            gap: 10px;
            margin-bottom: 14px;
        }

        .return-evidence-info > div {
            padding: 10px 12px;
            border: 1px solid #e3e8ef;
            border-radius: 11px;
            background: #f7f9fc;
        }

        .return-evidence-info span {
            display: block;
            margin-bottom: 3px;
            color: #738097;
            font-size: .62rem;
            font-weight: 900;
            text-transform: uppercase;
        }

        .return-evidence-info strong {
            font-size: .78rem;
        }

        .return-evidence-comment {
            grid-column: 1 / -1;
        }

        .return-evidence-image-wrap {
            height: min(55vh,520px);
            display: grid;
            place-items: center;
            overflow: hidden;
            border: 1px solid #dce4ef;
            border-radius: 13px;
            background: #0f192b;
        }

        .return-evidence-image {
            display: block;
            width: 100%;
            height: 100%;
            object-fit: contain;
        }

        html[data-nsq-theme="dark"] .return-evidence-card,
        html[data-bs-theme="dark"] .return-evidence-card {
            background: #111b2d;
            color: #e8eef7;
            border-color: #314158;
        }

        html[data-nsq-theme="dark"] .return-evidence-head,
        html[data-bs-theme="dark"] .return-evidence-head {
            border-color: #314158;
        }

        html[data-nsq-theme="dark"] .return-evidence-close,
        html[data-bs-theme="dark"] .return-evidence-close {
            background: #17243a;
            color: #e8eef7;
            border-color: #314158;
        }

        html[data-nsq-theme="dark"] .return-evidence-info > div,
        html[data-bs-theme="dark"] .return-evidence-info > div {
            background: #17243a;
            border-color: #314158;
        }

        @@media (max-width: 700px) {
            .return-evidence-info {
                grid-template-columns: 1fr;
            }

            .return-evidence-comment {
                grid-column: auto;
            }

            .return-evidence-image-wrap {
                height: 46vh;
            }
        }
        html[data-nsq-theme="dark"] .of-return-detail,
        html[data-bs-theme="dark"] .of-return-detail {
            background: #35181c;
            color: #ffb9be;
            border-color: #73353b;
        }
    </style>
}


@section Scripts {
    <script src="~/js/Almacen/almacen-vistas.js" asp-append-version="true"></script>
    <script src="~/js/shared/nsq-dynamic-style.js" asp-append-version="true"></script>

    <script>
        // NSQ_DEVOLUCION_MATERIALES_V1_3
        document.addEventListener('DOMContentLoaded', function () {
            const modal = document.getElementById('returnEvidenceModal');
            const image = document.getElementById('returnEvidenceImage');
            const motivo = document.getElementById('returnEvidenceReason');
            const comentario = document.getElementById('returnEvidenceComment');
            // NSQ_DEVOLUCION_MATERIALES_V1_4
            const usuario = document.getElementById('returnEvidenceUser');
            const meta = document.getElementById('returnEvidenceMeta');

            function closeEvidenceModal() {
                if (!modal) return;

                modal.hidden = true;
                modal.setAttribute('aria-hidden', 'true');
                document.body.style.overflow = '';

                if (image) {
                    image.removeAttribute('src');
                }
            }

            document.querySelectorAll('.js-return-evidence').forEach(function (button) {
                button.addEventListener('click', function () {
                    if (!modal || !image) return;

                    const url = button.dataset.url || '';
                    const reason = button.dataset.motivo || 'Sin motivo registrado';
                    const comment =
                        button.dataset.comentario
                        || 'Sin comentario adicional';
                    const user =
                        button.dataset.usuario
                        || 'Usuario de Producción';
                    const quantity = button.dataset.cantidad || '0';
                    const unit = button.dataset.unidad || '';
                    const date = button.dataset.fecha || '';

                    if (motivo) motivo.textContent = reason;
                    if (comentario) comentario.textContent = comment;
                    if (usuario) usuario.textContent = user;

                    if (meta) {
                        meta.textContent =
                            quantity + ' ' + unit
                            + (date ? ' · ' + date : '');
                    }

                    image.src = url;

                    modal.hidden = false;
                    modal.setAttribute('aria-hidden', 'false');
                    document.body.style.overflow = 'hidden';
                });
            });

            document.querySelectorAll('.js-return-evidence-close').forEach(function (button) {
                button.addEventListener('click', closeEvidenceModal);
            });

            if (modal) {
                modal.addEventListener('click', function (event) {
                    if (event.target === modal) {
                        closeEvidenceModal();
                    }
                });
            }

            document.addEventListener('keydown', function (event) {
                if (event.key === 'Escape'
                    && modal
                    && !modal.hidden) {
                    closeEvidenceModal();
                }
            });
        });
    </script>
}


<div class="return-evidence-modal"
     id="returnEvidenceModal"
     hidden
     aria-hidden="true">
    <div class="return-evidence-card"
         role="dialog"
         aria-modal="true"
         aria-labelledby="returnEvidenceTitle">
        <div class="return-evidence-head">
            <div>
                <h3 id="returnEvidenceTitle">
                    <i class="fa-solid fa-camera"></i>
                    Evidencia de devolución
                </h3>
                <p id="returnEvidenceMeta"></p>
            </div>

            <button class="return-evidence-close js-return-evidence-close"
                    type="button"
                    aria-label="Cerrar">
                <i class="fa-solid fa-xmark"></i>
            </button>
        </div>

        <div class="return-evidence-content">
            <div class="return-evidence-info">
                <div>
                    <span>Motivo</span>
                    <strong id="returnEvidenceReason">—</strong>
                </div>

                <div>
                    <span>Devuelto por</span>
                    <strong id="returnEvidenceUser">—</strong>
                </div>

                <div class="return-evidence-comment">
                    <span>Comentario / descripción del problema</span>
                    <strong id="returnEvidenceComment">—</strong>
                </div>
            </div>

            <div class="return-evidence-image-wrap">
                <img id="returnEvidenceImage"
                     class="return-evidence-image"
                     alt="Evidencia fotográfica de la devolución" />
            </div>
        </div>
    </div>
</div>
@await Html.PartialAsync("_AlmacenNavegacion")

@await Html.PartialAsync("_AlmacenMensajes")


<section class="alm-hero of4-hero">
    <div>
        <small>ALMACÉN · MATERIALES POR OF</small>
        <h1>Material OF Solicitados</h1>
        <p>
            Listado general de órdenes pendientes. Cada OF muestra su máquina, materia prima,
            embalajes y producto terminado sin agruparlas en bloques separados.
        </p>
    </div>
    <div class="alm-actions">
        <a class="alm-btn" asp-controller="AlmacenOF" asp-action="Historico">
            <i class="fa-solid fa-clock-rotate-left"></i> Histórico OF
        </a>
        <a class="alm-btn secondary" asp-controller="AlmacenMP" asp-action="Index">
            <i class="fa-solid fa-flask"></i> Inventario MP
        </a>
        <a class="alm-btn secondary" asp-controller="AlmacenEmbalajes" asp-action="Index">
            <i class="fa-solid fa-box-open"></i> Embalajes
        </a>
        <a class="alm-btn secondary" asp-controller="AlmacenPT" asp-action="Index">
            <i class="fa-solid fa-boxes-stacked"></i> Inventario PT
        </a>
    </div>
</section>

@if (!Model.Configurado)
{
    <div class="alm-alert warning">@Model.MensajeConfiguracion</div>
}
else
{
    <section class="alm-grid of4-kpis">
        <div class="alm-kpi"><small>OF visibles</small><strong>@ordenesPendientes.Count</strong></div>
        <div class="alm-kpi"><small>Máquinas involucradas</small><strong>@maquinasVisibles</strong></div>
        <div class="alm-kpi"><small>MP pendiente</small><strong>@Model.PendientesMP</strong></div>
        <div class="alm-kpi"><small>Embalaje pendiente</small><strong>@Model.PendientesEmbalaje</strong></div>
        <div class="alm-kpi"><small>Con movimientos</small><strong>@Model.OFConMovimientos</strong></div>
    </section>

    <section class="alm-card of4-catalog">
        <header class="of4-card-header">
            <div>
                <strong>Órdenes con materiales solicitados</strong>
                <small>@ordenesPendientes.Count registro(s) · página @Model.Pagina de @Model.TotalPaginas</small>
            </div>
        </header>

        <form method="get" class="of4-filter">
            <div class="alm-field of4-search">
                <label for="q">Buscar OF, cliente, parte, MP o embalaje</label>
                <input id="q" class="alm-input" type="search" name="q" value="@Model.Busqueda"
                       placeholder="Folio, OF, cliente, parte o material" />
            </div>

            <div class="alm-field">
                <label for="estatus">Estatus</label>
                <select id="estatus" class="alm-select" name="estatus">
                    <option value="">Todos</option>
                    @foreach (var estado in Model.EstatusDisponibles)
                    {
                        <option value="@estado.EstatusID" selected="@(Model.EstatusID == estado.EstatusID)">@estado.Nombre</option>
                    }
                </select>
            </div>

            <div class="alm-field">
                <label for="area">Atención de Almacén</label>
                <select id="area" class="alm-select" name="area">
                    <option value="">Todas</option>
                    <option value="PENDIENTES" selected="@(Model.Area == "PENDIENTES")">Con pendientes</option>
                    <option value="CON_MOVIMIENTOS" selected="@(Model.Area == "CON_MOVIMIENTOS")">Con movimientos</option>
                    <option value="MP" selected="@(Model.Area == "MP")">Requiere MP</option>
                    <option value="EMBALAJE" selected="@(Model.Area == "EMBALAJE")">Requiere embalaje</option>
                </select>
            </div>

            <div class="alm-field">
                <label for="desde">Desde</label>
                <input id="desde" class="alm-input" type="date" name="desde" value="@Model.Desde?.ToString("yyyy-MM-dd")" />
            </div>

            <div class="alm-field">
                <label for="hasta">Hasta</label>
                <input id="hasta" class="alm-input" type="date" name="hasta" value="@Model.Hasta?.ToString("yyyy-MM-dd")" />
            </div>

            <div class="of4-filter-actions">
                <button class="alm-btn" type="submit"><i class="fa-solid fa-filter"></i> Filtrar</button>
                <a class="alm-btn secondary" asp-controller="AlmacenOF" asp-action="Index">
                    <i class="fa-solid fa-filter-circle-xmark"></i> Limpiar
                </a>
            </div>
        </form>

        <div class="of4-list of7-flat-orders">
            @foreach (var x in ordenesPendientes)
            {
                var hasMp = x.MaterialesEntrega.Any();
                var hasPackaging = x.EmbalajesEntrega.Any();
                var hasPt = x.PartesEntrega.Any();
                var completed =
                    (!hasMp || x.MaterialesEntrega.All(i => i.Pendiente <= 0.0005m))
                    && (!hasPackaging || x.EmbalajesEntrega.All(i => i.Pendiente <= 0.0005m))
                    && (!hasPt || x.PartesEntrega.All(i => i.Pendiente <= 0.0005m));
                var numeroOf = !string.IsNullOrWhiteSpace(x.NumeroOFRecibida)
                    ? x.NumeroOFRecibida
                    : x.FolioSolicitud;

                <article class="of4-row @(completed ? "is-complete" : string.Empty)">
                    <header class="of4-row-head">
                        <div class="of4-identity">
                            <span class="of4-icon"><i class="fa-solid fa-file-lines"></i></span>
                            <div>
                                <a class="of4-of-link" asp-controller="AlmacenOF" asp-action="Detalle"
                                   asp-route-id="@x.SolicitudProduccionID">@x.NumeroOFClave</a>
                                <small>
                                    @(string.IsNullOrWhiteSpace(x.FolioSolicitud) ? "Folio no asignado" : x.FolioSolicitud)
                                    · @x.TotalRenglones renglón(es)
                                    · Máquina: @NombreMaquina(x.Maquina)
                                </small>
                            </div>
                        </div>

                        <div class="of4-client">
                            <span>Cliente</span>
                            <strong title="@x.Cliente">@(string.IsNullOrWhiteSpace(x.Cliente) ? "Sin cliente" : x.Cliente)</strong>
                        </div>

                        <div class="of4-dates">
                            <span>Solicitud</span>
                            <strong>@x.FechaSolicitud.ToString("dd/MM/yyyy")</strong>
                            <small>Requerida: @(x.FechaRequerida?.ToString("dd/MM/yyyy") ?? "Sin fecha")</small>
                        </div>

                        <div class="of4-state-block">
                            @if (x.TieneDevolucionPendiente)
                            {
                                <span class="of-return-priority">
                                    <i class="fa-solid fa-arrow-rotate-left"></i>
                                    DEVOLUCIÓN · @x.DevolucionesPendientes
                                </span>
                            }
                            <span class="of-status">@x.EstatusNombre</span>
                            <span class="of-priority @x.PrioridadClase">@x.Prioridad</span>
                        </div>

                        <a class="of4-detail-btn" asp-controller="AlmacenOF" asp-action="Detalle"
                           asp-route-id="@x.SolicitudProduccionID" title="Ver detalle para Almacén">
                            <i class="fa-solid fa-eye"></i><span>Ver detalle</span>
                        </a>
                    </header>

                    <div class="of4-material-grid of5-material-grid">
                        @if (hasMp)
                        {
                            <section class="of4-material-section">
                                <div class="of4-section-title">
                                    <span><i class="fa-solid fa-flask"></i> Materia prima</span>
                                    <small>@x.MaterialesEntrega.Count material(es)</small>
                                </div>
                                <div class="of4-items">
                                    @foreach (var item in x.MaterialesEntrega)
                                    {
                                        var puedeEntregar = item.PuedeEntregar && x.TieneNumeroOF;
                                        var url = puedeEntregar
                                            ? Url.Action("Movimiento", "AlmacenMP", new { materialId = item.CatalogoID, solicitudProduccionId = x.SolicitudProduccionID, entregaOF = true })
                                            : null;
                                        <a class="of4-item @item.Clase @(!puedeEntregar ? "disabled" : string.Empty)" href="@url" aria-disabled="@(!puedeEntregar)">
                                            <span class="of4-item-copy"><strong>@item.Codigo</strong><small title="@item.Descripcion">@item.Descripcion</small></span>
                                            <span class="of4-item-progress">
                                                <span>
                                                    <strong>Producción aceptó @item.Entregado.ToString("0.###") / @item.Requerido.ToString("0.###") @item.Unidad</strong>
                                                    <em>@item.Estado</em>
                                                    @if (item.EnValidacionProduccion > 0.0005m)
                                                    {
                                                        <small class="of-validation-note">En validación de Producción: @item.EnValidacionProduccion.ToString("0.###") @item.Unidad</small>
                                                    }
                                                </span>
                                                <i><b data-nsq-style="width:@item.Porcentaje%"></b></i>
                                            </span>
                                        </a>
                                        @if (item.TieneDevolucionPendiente)
                                        {
                                            <div class="of-return-detail">
                                                <strong><i class="fa-solid fa-triangle-exclamation"></i> Producción devolvió @item.CantidadDevuelta?.ToString("0.###") @item.Unidad</strong>
                                                <span>
                                                    @item.FechaDevolucion?.ToString("dd/MM/yyyy HH:mm")
                                                    · @item.UsuarioDevolucionNombre
                                                </span>
                                                <p>@item.MotivoDevolucion</p>
                                                <button class="of-return-evidence js-return-evidence"
                                                        type="button"
                                                        data-url="@Url.Action("EvidenciaDevolucion", "ProduccionPreparacion", new { id = item.DevolucionMaterialID })"
                                                        data-motivo="@item.MotivoDevolucion"
                                                        data-comentario="@item.ComentarioDevolucion"
                                                        data-usuario="@item.UsuarioDevolucionNombre"
                                                        data-cantidad="@item.CantidadDevuelta?.ToString("0.###")"
                                                        data-unidad="@item.Unidad"
                                                        data-fecha="@item.FechaDevolucion?.ToString("dd/MM/yyyy HH:mm")">
                                                    <i class="fa-solid fa-camera"></i> Ver evidencia
                                                </button>
                                            </div>
                                        }
                                    }
                                </div>
                            </section>
                        }

                        @if (hasPackaging)
                        {
                            <section class="of4-material-section">
                                <div class="of4-section-title">
                                    <span><i class="fa-solid fa-box-open"></i> Embalajes</span>
                                    <small>@x.EmbalajesEntrega.Count embalaje(s)</small>
                                </div>
                                <div class="of4-items">
                                    @foreach (var item in x.EmbalajesEntrega)
                                    {
                                        var puedeEntregar = item.PuedeEntregar && x.TieneNumeroOF;
                                        var url = puedeEntregar
                                            ? Url.Action("Movimiento", "AlmacenEmbalajes", new { embalajeId = item.CatalogoID, solicitudProduccionId = x.SolicitudProduccionID, entregaOF = true })
                                            : null;
                                        <a class="of4-item @item.Clase @(!puedeEntregar ? "disabled" : string.Empty)" href="@url" aria-disabled="@(!puedeEntregar)">
                                            <span class="of4-item-copy"><strong>@item.Codigo</strong><small title="@item.Descripcion">@item.Descripcion</small></span>
                                            <span class="of4-item-progress">
                                                <span>
                                                    <strong>Producción aceptó @item.Entregado.ToString("0.###") / @item.Requerido.ToString("0.###") @item.Unidad</strong>
                                                    <em>@item.Estado</em>
                                                    @if (item.EnValidacionProduccion > 0.0005m)
                                                    {
                                                        <small class="of-validation-note">En validación de Producción: @item.EnValidacionProduccion.ToString("0.###") @item.Unidad</small>
                                                    }
                                                </span>
                                                <i><b data-nsq-style="width:@item.Porcentaje%"></b></i>
                                            </span>
                                        </a>
                                        @if (item.TieneDevolucionPendiente)
                                        {
                                            <div class="of-return-detail">
                                                <strong><i class="fa-solid fa-triangle-exclamation"></i> Producción devolvió @item.CantidadDevuelta?.ToString("0.###") @item.Unidad</strong>
                                                <span>
                                                    @item.FechaDevolucion?.ToString("dd/MM/yyyy HH:mm")
                                                    · @item.UsuarioDevolucionNombre
                                                </span>
                                                <p>@item.MotivoDevolucion</p>
                                                <button class="of-return-evidence js-return-evidence"
                                                        type="button"
                                                        data-url="@Url.Action("EvidenciaDevolucion", "ProduccionPreparacion", new { id = item.DevolucionMaterialID })"
                                                        data-motivo="@item.MotivoDevolucion"
                                                        data-comentario="@item.ComentarioDevolucion"
                                                        data-usuario="@item.UsuarioDevolucionNombre"
                                                        data-cantidad="@item.CantidadDevuelta?.ToString("0.###")"
                                                        data-unidad="@item.Unidad"
                                                        data-fecha="@item.FechaDevolucion?.ToString("dd/MM/yyyy HH:mm")">
                                                    <i class="fa-solid fa-camera"></i> Ver evidencia
                                                </button>
                                            </div>
                                        }
                                    }
                                </div>
                            </section>
                        }

                        @if (hasPt)
                        {
                            <section class="of4-material-section of5-pt-section">
                                <div class="of4-section-title">
                                    <span><i class="fa-solid fa-boxes-stacked"></i> Surtimiento desde PT</span>
                                    <small>@x.PartesEntrega.Count parte(s)</small>
                                </div>
                                <div class="of4-items">
                                    @foreach (var item in x.PartesEntrega)
                                    {
                                        var cantidadSugerida = Convert.ToInt32(Math.Min(item.Pendiente, item.DisponibleInventario));
                                        var puedeEntregar = item.PuedeEntregar && x.TieneNumeroOF && cantidadSugerida > 0;
                                        var url = puedeEntregar
                                            ? Url.Action("Movimiento", "AlmacenPT", new { parteId = item.CatalogoID, tipo = "Salida", numeroOF = numeroOf, cantidad = cantidadSugerida })
                                            : null;
                                        <a class="of4-item of5-pt-item @item.Clase @(!puedeEntregar ? "disabled" : string.Empty)" href="@url" aria-disabled="@(!puedeEntregar)">
                                            <span class="of4-item-copy"><strong>@item.Codigo</strong><small title="@item.Descripcion">@item.Descripcion</small></span>
                                            <span class="of4-item-progress">
                                                <span><strong>@item.Entregado.ToString("0") / @item.Requerido.ToString("0") PZS</strong><em>@item.Estado</em></span>
                                                <i><b data-nsq-style="width:@item.Porcentaje%"></b></i>
                                                <small class="of5-pt-available">Disponible en PT: @item.DisponibleInventario.ToString("N0") PZS</small>
                                            </span>
                                        </a>
                                    }
                                </div>
                            </section>
                        }

                        @if (!hasMp && !hasPackaging && !hasPt)
                        {
                            <div class="of4-empty-materials"><i class="fa-solid fa-circle-info"></i> Esta OF no tiene materiales pendientes de surtimiento.</div>
                        }
                    </div>
                </article>
            }

            @if (!ordenesPendientes.Any())
            {
                <div class="alm-empty of4-empty">No hay órdenes de fabricación que coincidan con los filtros.</div>
            }
        </div>

        <footer class="of4-pagination">
            <span>@ordenesPendientes.Count registro(s) · máximo @Model.TamanoPagina por página</span>
            <div>
                @if (Model.Pagina > 1)
                {
                    <a class="alm-btn secondary" href="@BuildPageUrl(Model.Pagina - 1)">Anterior</a>
                }
                else
                {
                    <span class="alm-btn secondary disabled">Anterior</span>
                }

                @if (Model.Pagina < Model.TotalPaginas)
                {
                    <a class="alm-btn secondary" href="@BuildPageUrl(Model.Pagina + 1)">Siguiente</a>
                }
                else
                {
                    <span class="alm-btn secondary disabled">Siguiente</span>
                }
            </div>
        </footer>
    </section>
}
