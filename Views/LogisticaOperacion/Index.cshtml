    /* Altura adaptable por cliente: la fila crece solo cuando necesita espacio. */
    .lg-client-row {
        transition: height .16s ease,min-height .16s ease
    }

    .lg-client-day {
        overflow: hidden
    }

    .lg-client-day .lg-summary-empty {
        min-height: 54px
    }

