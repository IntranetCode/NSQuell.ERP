                document.getElementById('vKmIni').textContent=card.dataset.kmSalida?`${number(card.dataset.kmSalida)} km`:'Pendiente';
                document.getElementById('vKmFin').textContent=card.dataset.kmRegreso?`${number(card.dataset.kmRegreso)} km`:'Pendiente';
                document.getElementById('vKmRec').textContent=card.dataset.kmRecorridos?`${number(card.dataset.kmRecorridos)} km`:'—';
                document.getElementById('vEmbarques').textContent=number(card.dataset.embarques);
                document.getElementById('vPiezas').textContent=`${number(card.dataset.piezas)} PZA`;
