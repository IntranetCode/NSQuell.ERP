    @@media(max - width:980px) {
        .lg-doc-batch-row

    {
        grid-template-columns: 1fr 1.2fr
    }

    .lg-doc-file-picker {
        grid-column: 1/-1
    }

    }
    @@media(max - width:700px) {
        .lg-doc-workspace-head,.lg-doc-batch-summary

    {
        flex-direction: column;
        align-items: stretch
    }

    .lg-doc-counter {
        align-self: flex-start
    }

    .lg-doc-batch-row {
        grid-template-columns: 1fr
    }

    .lg-doc-file-picker {
        grid-column: auto
    }

    .lg-doc-current {
        grid-template-columns: 34px minmax(0,1fr) auto
    }

        .lg-doc-current .lg-doc-state {
            grid-column: 2
        }

        .lg-doc-current .lg-doc-icon-btn {
            grid-row: 1;
            align-self: center
        }

            .lg-doc-current .lg-doc-icon-btn.danger {
                grid-column: 3
            }

    }
</style>

<div class="lg-page">
    <div class="lg-toolbar">
        <div class="lg-title">
            <div class="lg-title-icon"><i class="fa-solid fa-truck-fast"></i></div>
            <div>
                <h1>@tituloVista</h1>
                <p>@descripcionVista</p>
            </div>
        </div>
        <div class="lg-actions">
            <span class="lg-role-pill @(esAdministradorERP ? "" : puedeProgramar && !puedeOperar ? "plan" : "log")"><i class="fa-solid @(esAdministradorERP ? "fa-user-shield" : puedeProgramar && !puedeOperar ? "fa-calendar-check" : "fa-truck-fast")"></i> @etiquetaVista</span>
            <div class="lg-segment">
                <a asp-action="Index" asp-route-vista="Dia" asp-route-fecha="@Model.FechaReferencia.ToString("yyyy-MM-dd")" class="@(Model.Vista == "Dia" ? "active" : "")">Día</a>
                <a asp-action="Index" asp-route-vista="Semana" asp-route-fecha="@Model.FechaReferencia.ToString("yyyy-MM-dd")" class="@(Model.Vista == "Semana" ? "active" : "")">Semana</a>
                <a asp-action="Index" asp-route-vista="Mes" asp-route-fecha="@Model.FechaReferencia.ToString("yyyy-MM-dd")" class="@(Model.Vista == "Mes" ? "active" : "")">Mes</a>
            </div>
            @if (puedeOperar)
            {
                <a class="lg-btn" asp-controller="LogisticaListaCarga" asp-action="Index"><i class="fa-solid fa-list-check"></i> Lista de carga</a>
                <a class="lg-btn" asp-controller="LogisticaEmbarques" asp-action="Index"><i class="fa-solid fa-boxes-packing"></i> Embarques</a>
            }
        </div>
    </div>

    <div class="lg-role-note">
        <i class="fa-solid @(esAdministradorERP ? "fa-layer-group" : puedeProgramar && !puedeOperar ? "fa-calendar-days" : "fa-route")"></i>
        @if (esAdministradorERP)
        {
            <span><strong>Vista completa.</strong> Puedes ver pendientes de Planeación, programaciones listas para Logística, embarques y flota en una sola pantalla.</span>
        }
        else if (puedeProgramar && !puedeOperar)
        {
            <span><strong>Vista Planeación.</strong> Aquí solo aparecen Releases por programar. Lo ya programado deja de mostrarse en esta vista para evitar mezclar responsabilidades.</span>
        }
        else
        {
            <span><strong>Vista Logística.</strong> Aquí solo aparecen Releases ya programados, embarques y viajes. Los pendientes de Planeación no se muestran.</span>
        }
    </div>

    <form method="get" asp-action="Index" id="formFiltros" class="lg-filterbar @(!puedeOperar ? "lg-filterbar-plan" : "")">
        <input type="hidden" name="vista" value="@Model.Vista" />
        <input type="hidden" name="fecha" value="@Model.FechaReferencia.ToString("yyyy-MM-dd")" />
        <div class="lg-field">
            <label>Buscar</label>
            <input class="lg-input" name="q" value="@Model.Busqueda" placeholder="Cliente, release, parte, OF, embarque..." />
        </div>
        <div class="lg-field">
            <label>Cliente</label>
            <select class="lg-select" name="clienteId">
                <option value="">Todos</option>
                @foreach (var c in Model.ClientesFiltro)
                {
                    <option value="@c.ClienteID" selected="@(Model.ClienteID == c.ClienteID)">@c.Cliente</option>
                }
            </select>
        </div>
        <div class="lg-field">
            <label>Estatus</label>
            <select class="lg-select" name="estatus">
                <option value="">Todos</option>
                @if (puedeProgramar)
                {
                    foreach (var s in new[] { "Requerido", "Sin programar" })
                    {
                        <option value="@s" selected="@(Model.Estatus == s)">@s</option>
                    }
                }
                @if (puedeOperar)
                {
                    foreach (var s in new[] { "Por generar", "Programado", "Preparando", "Preparado", "Cargando", "Cargado", "En ruta", "Entregado", "Cancelado" })
                    {
                        <option value="@s" selected="@(Model.Estatus == s)">@s</option>
                    }
                }
            </select>
        </div>
        @if (puedeOperar)
        {
            <div class="lg-field">
                <label>Forma salida</label>
                <select class="lg-select" name="formaEnvio">
                    <option value="">Todas</option>
                    <option value="Pendiente" selected="@(Model.FormaEnvio == "Pendiente")">Por definir</option>
                    <option value="Interno" selected="@(Model.FormaEnvio == "Interno")">Entrega</option>
                    <option value="Cliente" selected="@(Model.FormaEnvio == "Cliente")">Cliente recoge</option>
                    <option value="Paqueteria" selected="@(Model.FormaEnvio == "Paqueteria")">Paquetería</option>
                </select>
            </div>
        }
        else
        {
            <input type="hidden" name="formaEnvio" value="" />
        }
        <div class="lg-filter-actions">
            <button class="lg-btn lg-btn-primary" type="submit"><i class="fa-solid fa-filter"></i> Aplicar</button>
            <a class="lg-btn" asp-action="Index" asp-route-vista="@Model.Vista" asp-route-fecha="@Model.FechaReferencia.ToString("yyyy-MM-dd")">Limpiar</a>
        </div>
        <div class="lg-checkline">
            <label><input type="checkbox" name="soloExpeditados" value="true" checked="@Model.SoloExpeditados" /> Solo expeditados</label>
            @if (puedeOperar)
            {
                <label><input type="checkbox" name="soloIncidencias" value="true" checked="@Model.SoloIncidencias" /> Solo con incidencias</label>
            }
            else
            {
                <input type="hidden" name="soloIncidencias" value="false" />
            }
        </div>
    </form>

    <div class="lg-strip">
        <span><strong>@Model.PeriodoTexto</strong></span>
        <span>@totalClientesVisibles clientes</span>
        @if (puedeProgramar)
        {
            <span>@totalRequerimientosVisibles por programar</span>
        }
        @if (puedeOperar)
        {
            <span>@totalProgramacionesVisibles programados</span>
            <span>@totalEmbarquesVisibles embarques</span>
        }
        <span>@totalPiezasVisibles.ToString("N0") PZA visibles</span>
        @if (puedeOperar)
        {
            <span><strong>@Model.TotalUnidades</strong> unidades</span>
            <span><strong>@Model.UnidadesDisponibles</strong> disponibles</span>
            @if (Model.ViajesActivos > 0)
            {
                <span><strong>@Model.ViajesActivos</strong> viajes activos</span>
            }
        }
        @if (Model.Expeditados > 0)
        {
            <span class="danger"><i class="fa-solid fa-triangle-exclamation"></i> @Model.Expeditados expeditados</span>
        }
        @if (Model.ConIncidencia > 0)
        {
            <span class="warn"><i class="fa-solid fa-circle-exclamation"></i> @Model.ConIncidencia incidencias</span>
        }
    </div>

    <div class="lg-navperiod">
        <div class="lg-navleft">
            <a class="lg-btn" asp-action="Index" asp-route-vista="@Model.Vista" asp-route-fecha="@Model.FechaAnterior.ToString("yyyy-MM-dd")" asp-route-q="@Model.Busqueda" asp-route-clienteId="@Model.ClienteID" asp-route-estatus="@Model.Estatus" asp-route-formaEnvio="@Model.FormaEnvio" asp-route-soloExpeditados="@Model.SoloExpeditados" asp-route-soloIncidencias="@Model.SoloIncidencias"><i class="fa-solid fa-chevron-left"></i> Anterior</a>
            <div class="lg-period">
                <strong>@Model.PeriodoTexto</strong>
                <span>@Model.RangoTexto</span>
            </div>
            <a class="lg-btn" asp-action="Index" asp-route-vista="@Model.Vista" asp-route-fecha="@Model.FechaSiguiente.ToString("yyyy-MM-dd")" asp-route-q="@Model.Busqueda" asp-route-clienteId="@Model.ClienteID" asp-route-estatus="@Model.Estatus" asp-route-formaEnvio="@Model.FormaEnvio" asp-route-soloExpeditados="@Model.SoloExpeditados" asp-route-soloIncidencias="@Model.SoloIncidencias">Siguiente <i class="fa-solid fa-chevron-right"></i></a>
        </div>
        <a class="lg-btn" asp-action="Index" asp-route-vista="@Model.Vista" asp-route-fecha="@DateTime.Today.ToString("yyyy-MM-dd")"><i class="fa-regular fa-calendar-check"></i> Hoy</a>
    </div>

    <section class="lg-board @(Model.Vista == "Mes" ? "lg-month" : "")" style="--dias:@dias.Count">
        <div class="lg-grid-head">
            <div class="lg-head-client">@(puedeProgramar && !puedeOperar ? "CLIENTE / PLANEACIÓN" : "CLIENTE / OPERACIÓN")</div>
            @foreach (var dia in dias)
            {
                <div class="lg-day-head @(dia.Date == hoy ? "today" : "")">
                    <strong>@DiaCorto(dia) @dia.Day.ToString("00")</strong>
                    <span>@dia.ToString("MM/yyyy")</span>
                    @if (dia.Date == hoy)
                    {
                        <span class="today-tag">HOY</span>
                    }
                    @if (Model.Vista != "Mes")
                    {
                        <div class="lg-hours-head">
                            @for (int h = 0; h <= 23; h++)
                            {
                                <span>@h.ToString("00")</span>
                            }
                        </div>
                    }
                </div>
            }
        </div>

        @if (clientesVisibles.Count == 0)
        {
            <div style="padding:45px;text-align:center;color:var(--lg-muted)">
                <i class="fa-solid fa-calendar-xmark" style="font-size:28px;opacity:.45"></i>
                <div style="font-size:12px;font-weight:900;color:var(--lg-navy);margin-top:7px">Sin operación para este periodo</div>
                <div style="font-size:8px;margin-top:2px">@(puedeProgramar && !puedeOperar ? "No hay Releases pendientes por programar con los filtros actuales." : "No hay programaciones, embarques o actividad logística con los filtros actuales.")</div>
            </div>
        }
        else
        {
            @foreach (var cliente in clientesVisibles)
            {
                var altoFilaCliente = 78;
                foreach (var diaAltura in dias)
                {
                    var eventosAltura = cliente.EventosDia(diaAltura).Where(EventoVisible).ToList();
                    var resumenesAltura = 0;
                    if (eventosAltura.Any(x => x.EsRequerimiento)) resumenesAltura++;
                    if (eventosAltura.Any(x => x.EsProgramacion)) resumenesAltura++;
                    var embarquesConHoraAltura = eventosAltura.Count(x => x.EsEmbarque && x.HoraProgramada.HasValue);
                    var embarquesSinHoraAltura = eventosAltura.Count(x => x.EsEmbarque && !x.HoraProgramada.HasValue);
                    var altoResumen = resumenesAltura > 0 ? 8 + (resumenesAltura * 35) : 8;
                    var altoEmbarques = embarquesConHoraAltura > 0 ? 8 + (embarquesConHoraAltura * 39) : 0;
                    var altoSinHora = embarquesSinHoraAltura > 0 ? 28 : 0;
                    var altoDia = Math.Max(78, altoResumen + altoEmbarques + altoSinHora + 8);
                    if (altoDia > altoFilaCliente) altoFilaCliente = altoDia;
                }
                altoFilaCliente = Math.Min(altoFilaCliente, 310);
                <div class="lg-row lg-client-row" data-cliente-id="@cliente.ClienteID" style="--client-row-height:@(altoFilaCliente)px">
                    <aside class="lg-client">
                        <div class="lg-client-name">@cliente.Cliente</div>
                        <div class="lg-client-sub">@cliente.TotalPiezas.ToString("N0") PZA visibles</div>
                        <div class="lg-client-badges">
                            @if (puedeProgramar)
                            {
                                var totalReqCliente = cliente.Eventos.Count(x => x.EsRequerimiento);
                                if (totalReqCliente > 0)
                                {
                                    <span class="lg-badge blue">@totalReqCliente req.</span>
                                }
                            }
                            @if (puedeOperar)
                            {
                                var totalProgCliente = cliente.Eventos.Count(x => x.EsProgramacion);
                                var totalEmbCliente = cliente.Eventos.Count(x => x.EsEmbarque);
                                if (totalProgCliente > 0)
                                {
                                    <span class="lg-badge amber">@totalProgCliente prog.</span>
                                }
                                if (totalEmbCliente > 0)
                                {
                                    <span class="lg-badge">@totalEmbCliente 🚚</span>
                                }
                            }
                            @if (cliente.TieneExpeditados)
                            {
                                <span class="lg-badge red">Expeditado</span>
                            }
                            @if (cliente.TieneIncidencias)
                            {
                                <span class="lg-badge red">Incidencia</span>
                            }
                        </div>
                    </aside>

                    @foreach (var dia in dias)
                    {
                        var eventos = cliente.EventosDia(dia).Where(EventoVisible).ToList();
                        var requerimientos = puedeProgramar ? eventos.Where(x => x.EsRequerimiento).ToList() : new List<LogisticaOperacionEventoVm>();
                        var programaciones = puedeOperar ? eventos.Where(x => x.EsProgramacion).ToList() : new List<LogisticaOperacionEventoVm>();
                        var embarques = puedeOperar ? eventos.Where(x => x.EsEmbarque).ToList() : new List<LogisticaOperacionEventoVm>();
                        var reqPiezas = requerimientos.Sum(x => (long)x.CantidadPendienteProgramar);
                        var progPiezas = programaciones.Sum(x => (long)Math.Max(0, x.CantidadProgramada - x.CantidadGenerada));
                        var embPiezas = embarques.Sum(x => (long)x.TotalPiezas);
                        var reqExp = requerimientos.Count(x => x.EsExpeditado);
                        var resumenesDia = (requerimientos.Any() ? 1 : 0) + (programaciones.Any() ? 1 : 0);
                        var timedTopDia = resumenesDia > 0 ? 8 + (resumenesDia * 35) : 8;

                        <div class="lg-client-day @(dia.Date == hoy ? "today" : "")" data-cliente-id="@cliente.ClienteID" data-fecha="@dia.ToString("yyyy-MM-dd")" style="--timed-top:@(timedTopDia)px">
                            <div class="lg-day-summary">
                                @if (!eventos.Any())
                                {
                                    <div class="lg-summary-empty">Sin operación</div>
                                }
                                else
                                {
                                    @if (requerimientos.Any())
                                    {
                                        <button type="button" class="lg-summary-btn req @(reqExp > 0 ? "exp" : "")" data-open-day="requerimientos">
                                            <span class="left">
                                                <span class="lg-summary-icon"><i class="fa-solid fa-clipboard-list"></i></span>
                                                <span class="lg-summary-text">
                                                    <strong>@requerimientos.Count release@(requerimientos.Count == 1 ? "" : "s") por programar</strong>
                                                    <span>
                                                        @reqPiezas.ToString("N0") PZA @if(reqExp > 0){
                                                        <text>· @reqExp exp.</text>
                                                    }
                                                </span>
                                            </span>
                                        </span>
                                        <span class="lg-summary-count">@requerimientos.Count</span>
                                    </button>
                                }
                                @if (programaciones.Any())
                                {
                                    var programacionIds = string.Join(",", programaciones.Select(x => x.ListaCargaProgramacionID.ToString()));
                                    <button type="button"
                                            draggable="true"
                                            class="lg-summary-btn prog"
                                            data-start-shipment="true"
                                            data-drag-type="programacion-grupo"
                                            data-programacion-ids="@programacionIds"
                                            data-cliente-id="@cliente.ClienteID"
                                            data-fecha="@dia.ToString("yyyy-MM-dd")"
                                            title="Clic: iniciar embarque · Arrastrar: reprogramar estos Releases a otro día">
                                        <span class="left">
                                            <span class="lg-summary-icon"><i class="fa-solid fa-cart-flatbed"></i></span>
                                            <span class="lg-summary-text">
                                                <strong>@programaciones.Count release@(programaciones.Count == 1 ? "" : "s") programado@(programaciones.Count == 1 ? "" : "s")</strong>
                                                <span>@progPiezas.ToString("N0") PZA · Clic para iniciar embarque · arrastra para cambiar día</span>
                                            </span>
                                        </span>
                                        <span class="lg-summary-count">@programaciones.Count</span>
                                    </button>
                                }
                                @if (Model.Vista == "Mes" && embarques.Any())
                                {
                                    <button type="button" class="lg-summary-btn emb" data-open-day="embarques">
                                        <span class="left">
                                            <span class="lg-summary-icon"><i class="fa-solid fa-truck"></i></span>
                                            <span class="lg-summary-text"><strong>@embarques.Count embarque@(embarques.Count == 1 ? "" : "s")</strong><span>@embPiezas.ToString("N0") PZA</span></span>
                                        </span>
                                        <span class="lg-summary-count">@embarques.Count</span>
                                    </button>
                                }
                            }
                        </div>

                        @if (Model.Vista != "Mes")
                        {
                            var embarquesConHora = embarques.Where(x => x.HoraProgramada.HasValue).OrderBy(x => x.HoraProgramada).ToList();
                            var sinHoraEmb = embarques.Count(x => !x.HoraProgramada.HasValue);
                            <div class="lg-timed-layer">
                                @{
                                    var laneEmb = 0;
                                }
                                @foreach (var e in embarquesConHora)
                                {
                                    var left = LeftEvento(e);
                                    var top = 6 + laneEmb * 39;
                                    var puedeMoverVista = e.Estatus == "Programado" || e.Estatus == "Preparando" || e.Estatus == "Preparado";
                                    var tituloEvento = puedeMoverVista
                                    ? $"{e.HoraTexto} · {e.Folio} · {e.Estatus} · Clic para abrir · Arrastra para reprogramar"
                                    : $"{e.HoraTexto} · {e.Folio} · {e.Estatus} · Clic para abrir";
                                    laneEmb++;
                                    <button type="button"
                                            draggable="@puedeMoverVista.ToString().ToLowerInvariant()"
                                            class="lg-timed-event emb @(e.EsExpeditado ? "exp" : "")"
                                            style="left:@left.ToString("0.##", CultureInfo.InvariantCulture)%;top:@(top)px"
                                            data-open-flow="@e.EmbarqueID"
                                            data-drag-type="embarque"
                                            data-embarque-id="@e.EmbarqueID"
                                            data-cliente-id="@e.ClienteID"
                                            data-fecha="@e.FechaProgramada.ToString("yyyy-MM-dd")"
                                            data-hora="@(e.HoraProgramada?.ToString(@"hh\:mm") ?? "")"
                                            data-row-version="@e.RowVersion"
                                            data-puede-mover="@puedeMoverVista.ToString().ToLowerInvariant()"
                                            data-estatus="@e.Estatus"
                                            data-title-base="@tituloEvento"
                                            data-alerta-atraso=""
                                            title="@tituloEvento">
                                        <span class="time">@e.HoraTexto</span>
                                        <strong>@e.Folio</strong>
                                        <span>@e.TotalPiezas.ToString("N0") PZA · @e.Estatus</span>
                                    </button>
                                }
                            </div>
                            @if (sinHoraEmb > 0)
                            {
                                <div class="lg-no-time-strip">
                                    <button type="button" class="lg-no-time-btn" data-open-day="embarques"><i class="fa-solid fa-truck"></i> @sinHoraEmb embarque@(sinHoraEmb == 1 ? "" : "s") sin hora</button>
                                </div>
                            }
                        }

                        <div class="lg-client-day-data">
                            @foreach (var e in eventos)
                            {
                                <span class="lg-day-event-data"
                                      data-tipo="@(e.EsRequerimiento ? "requerimiento" : e.EsProgramacion ? "programacion" : "embarque")"
                                      data-evento-id="@e.EventoID"
                                      data-release-id="@e.ReleaseDetalleID"
                                      data-programacion-id="@e.ListaCargaProgramacionID"
                                      data-embarque-id="@e.EmbarqueID"
                                      data-parte-id="@e.ParteID"
                                      data-cliente-id="@e.ClienteID"
                                      data-cliente="@e.Cliente"
                                      data-folio="@(string.IsNullOrWhiteSpace(e.Folio) ? e.EventoKey : e.Folio)"
                                      data-folio-release="@e.FolioRelease"
                                      data-numero-parte="@(string.IsNullOrWhiteSpace(e.NumeroParte) ? e.NumeroParteResumen : e.NumeroParte)"
                                      data-descripcion="@(string.IsNullOrWhiteSpace(e.DescripcionParte) ? e.DescripcionResumen : e.DescripcionParte)"
                                      data-of="@e.NumeroOF"
                                      data-cantidad="@(e.EsRequerimiento? e.CantidadPendienteProgramar: e.EsProgramacion? Math.Max(0, e.CantidadProgramada - e.CantidadGenerada):e.TotalPiezas)"
                                      data-fecha-requerida="@e.FechaRequeridaTexto"
                                      data-fecha-programada="@e.FechaProgramada.ToString("yyyy-MM-dd")"
                                      data-hora="@(e.HoraProgramada?.ToString(@"hh\:mm") ?? "")"
                                      data-estatus="@e.Estatus"
                                      data-expeditado="@e.EsExpeditado.ToString().ToLowerInvariant()"
                                      data-atraso="@e.AtrasoTexto"
                                      data-incidencias="@e.IncidenciasAbiertas"
                                      data-row-version="@e.RowVersion"></span>
                            }
                        </div>
                    </div>
                }
            </div>
        }
                }

        @if (puedeOperar)
        {
        <div class="lg-row lg-section-divider">
            <aside class="lg-client">
                <i class="fa-solid fa-truck-moving"></i>
                <div class="lg-client-name">FLOTA / VIAJES</div>
            </aside>
            <div class="lg-section-divider-main">
                <span><strong>@Model.TotalUnidades</strong> unidades activas</span>
                <span><strong>@Model.UnidadesDisponibles</strong> disponibles en el periodo</span>
                <span><strong>@Model.ViajesActivos</strong> viajes activos</span>
                <span>Salida, recorrido y regreso de las unidades de Logística</span>
            </div>
        </div>

        @if (Model.Unidades.Count == 0)
        {
            <div class="lg-row lg-unit-row">
                <aside class="lg-client">
                    <div class="lg-unit-icon"><i class="fa-solid fa-truck"></i></div>
                    <div class="lg-client-name">Sin unidades</div>
                    <div class="lg-client-sub">No existen unidades activas en Logística.</div>
                </aside>
                <div class="lg-section-divider-main" style="grid-column:2/-1;color:var(--lg-muted);background:#fbfdff">
                    No hay unidades activas para mostrar.
                </div>
            </div>
        }
        else
        {
            @foreach (var unidad in Model.Unidades)
            {
                <div class="lg-row lg-unit-row" data-unidad-id="@unidad.UnidadID">
                    <aside class="lg-client">
                        <div class="lg-unit-icon"><i class="fa-solid fa-truck"></i></div>
                        <div class="lg-client-name">@unidad.UnidadTexto</div>
                        <div class="lg-client-sub">@unidad.DescripcionUnidad</div>
                        <div class="lg-client-badges">
                            @if (unidad.CapacidadPiezas.HasValue)
                            {
                                <span class="lg-badge">@unidad.CapacidadPiezas.Value.ToString("N0") PZA</span>
                            }
                            @if (unidad.CapacidadPesoKg.HasValue)
                            {
                                <span class="lg-badge">@unidad.CapacidadPesoKg.Value.ToString("N0") kg</span>
                            }
                        </div>
                        <span class="lg-unit-status @(unidad.Eventos.Any(x => x.EsViajeActivo) ? "busy" : "")">
                            <i class="fa-solid @(unidad.Eventos.Any(x => x.EsViajeActivo) ? "fa-route" : "fa-circle-check")"></i>
                            @unidad.EstadoActual
                        </span>
                    </aside>

                    @foreach (var dia in dias)
                    {
                        var viajesDia = unidad.Eventos
                            .Where(x => FechaVisualViaje(x) == dia.Date)
                            .GroupBy(x => x.ViajeID)
                            .Select(x => x.First())
                            .OrderBy(x => x.FechaSalidaReal?.TimeOfDay ?? x.HoraSalidaProgramada ?? TimeSpan.Zero)
                            .ToList();
                        <div class="lg-unit-cell @(dia.Date == hoy ? "today" : "")" data-unidad-id="@unidad.UnidadID" data-fecha="@dia.ToString("yyyy-MM-dd")">
                            @if (!viajesDia.Any())
                            {
                                <div class="lg-unit-available"><i class="fa-solid fa-circle-check"></i> UNIDAD DISPONIBLE</div>
                            }
                            else
                            {
                                @foreach (var viaje in viajesDia)
                                {
                                    var leftViaje = LeftViaje(viaje);
                                    <article class="lg-unit-event @ClaseViaje(viaje)"
                                             style="left:@leftViaje.ToString("0.##", CultureInfo.InvariantCulture)%;top:8px"
                                             data-viaje-id="@viaje.ViajeID"
                                             data-folio="@viaje.Folio"
                                             data-unidad="@unidad.UnidadTexto"
                                             data-placas="@unidad.Placas"
                                             data-operador="@viaje.Operador"
                                             data-ruta="@viaje.Ruta"
                                             data-origen="@viaje.Origen"
                                             data-destino="@viaje.Destino"
                                             data-cliente="@viaje.ClienteResumen"
                                             data-estatus="@viaje.EstadoVisual"
                                             data-salida="@viaje.FechaSalidaReal?.ToString("dd/MM/yyyy HH:mm")"
                                             data-regreso="@viaje.FechaRegresoReal?.ToString("dd/MM/yyyy HH:mm")"
                                             data-km-salida="@viaje.KilometrajeSalida"
                                             data-km-regreso="@viaje.KilometrajeRegreso"
                                             data-km-recorridos="@viaje.KilometrosRecorridos"
                                             data-evid-salida="@viaje.EvidenciasSalida"
                                             data-evid-regreso="@viaje.EvidenciasRegreso"
                                             data-evid-trayecto="@viaje.EvidenciasTrayecto"
                                             data-evid-incidencia="@viaje.EvidenciasIncidencia"
                                             data-incidencias="@viaje.IncidenciasAbiertas"
                                             data-criticas="@viaje.IncidenciasCriticas"
                                             data-embarques="@viaje.TotalEmbarques"
                                             data-piezas="@viaje.TotalPiezas">
                                        <div class="lg-unit-event-top">
                                            <span>@(string.IsNullOrWhiteSpace(viaje.Folio) ? $"VIAJE {viaje.ViajeID}" : viaje.Folio)</span>
                                            <span>@viaje.HoraTexto</span>
                                        </div>
                                        <div class="lg-unit-event-main">
                                            <i class="fa-solid @viaje.Icono"></i>
                                            <div>
                                                <strong>@viaje.ClienteResumen</strong>
                                                <span>@(string.IsNullOrWhiteSpace(viaje.Operador) ? "Chofer por definir" : viaje.Operador)</span>
                                            </div>
                                        </div>
                                        <div class="lg-unit-event-foot">
                                            <span>@viaje.EstadoVisual</span>
                                            <span>@viaje.TotalEmbarques emb. · @viaje.TotalPiezas.ToString("N0") PZA</span>
                                            @if (viaje.IncidenciasAbiertas > 0)
                                            {
                                                <span class="lg-unit-alert">⚠ @viaje.IncidenciasAbiertas</span>
                                            }
                                        </div>
                                    </article>
                                }
                            }
                        </div>
                    }
                </div>
            }
        }

        }

        <div class="lg-legend">
            @if (puedeProgramar)
            {
                <span><i class="lg-dot" style="background:#f4f7fb;border-color:#b9c7d6"></i> Release por programar</span>
            }
            @if (puedeOperar)
            {
                <span><i class="lg-dot" style="background:#fff7e8;border-color:#e5bd72"></i> Release programado</span>
                <span><i class="lg-dot" style="background:#eaf3ff;border-color:#8ab7ee"></i> Programado</span>
                <span><i class="lg-dot" style="background:#fff7e1;border-color:#e2be67"></i> Preparando</span>
                <span><i class="lg-dot" style="background:#fff0e6;border-color:#f0a96d"></i> Preparado</span>
                <span><i class="lg-dot" style="background:#f1edff;border-color:#bca8ef"></i> Cargado</span>
                <span><i class="lg-dot" style="background:#e8f8fb;border-color:#8fd6e3"></i> En ruta</span>
                <span><i class="lg-dot" style="background:#eaf8f2;border-color:#8ed6b7"></i> Entregado</span>
                <span><i class="lg-dot" style="background:#f1fbf6;border-color:#a8d6c2"></i> Unidad disponible</span>
                <span><i class="lg-dot" style="background:#eaf3ff;border-color:#8ab7ee"></i> Viaje programado</span>
                <span><i class="lg-dot" style="background:#e7f8fb;border-color:#78cbd9"></i> Unidad en ruta</span>
                <span><i class="lg-dot late"></i> Alerta por atraso operativo</span>
            }
            <span><i class="lg-dot" style="background:#fff1f1;border-color:#ef8585"></i> Expeditado</span>
            <span><i class="lg-dot now"></i> Hora actual</span>
        </div>
    </section>
</div>

<div class="lg-modal-backdrop" id="modalClienteDia">
    <div class="lg-modal lg-day-modal">
        <div class="lg-modal-head">
            <div><h2 id="dayTitulo">Operación del cliente</h2><p id="daySub">Planea Releases y continúa con el embarque desde el mismo calendario.</p></div>
            <button class="lg-close" type="button" data-close="modalClienteDia">✕</button>
        </div>
        <div class="lg-modal-body">
            <div class="lg-day-modal-toolbar">
                <div class="lg-day-modal-tabs">
                    <button type="button" class="lg-day-tab @(puedeProgramar && !puedeOperar ? "active" : "")" data-day-tab="requerimientos" style="@(puedeProgramar ? "" : "display:none")">Por programar <span id="cntReq">0</span></button>
                    <button type="button" class="lg-day-tab @(!puedeProgramar && puedeOperar ? "active" : "")" data-day-tab="programaciones" style="@(puedeOperar ? "" : "display:none")">Programados <span id="cntProg">0</span></button>
                    <button type="button" class="lg-day-tab" data-day-tab="embarques" style="@(puedeOperar ? "" : "display:none")">Embarques <span id="cntEmb">0</span></button>
