            document.getElementById('fdEstado').textContent=j.documentacionCompleta?'Completa':'Pendiente';
            if(req){
                req.innerHTML='';
                const requeridos=j.requeridos||[];
                if(!requeridos.length)req.innerHTML='<div class="lg-disabled-note" style="grid-column:1/-1;padding:12px">No hay requisitos documentales definidos para la forma de salida actual.</div>';
                requeridos.forEach(x=>{
                    const d=document.createElement('div');
                    d.className='lg-doc-required';
                    d.innerHTML=`<div style="min-width:0"><strong>${esc(x.tipoDocumento||'Documento')}</strong><small>${esc(x.areaResponsable||'Sin área')} · ${x.obligatorio?'Obligatorio':'Opcional'}</small></div><span class="lg-doc-state ${x.cumplido?'ok':''}"><i class="fa-solid ${x.cumplido?'fa-circle-check':'fa-clock'}"></i> ${x.cumplido?'Cumplido':'Pendiente'}</span>`;
                    req.appendChild(d);
                });
            }
            if(select){
                const actual=select.value;
                select.innerHTML='<option value="">Selecciona...</option>';
                (j.tiposPermitidos||[]).forEach(tipo=>{const o=document.createElement('option');o.value=tipo;o.textContent=tipo;if(tipo===actual)o.selected=true;select.appendChild(o)});
            }
            const puedeModificar=Boolean(j.puedeModificar);
            if(form)form.querySelectorAll('input,select,textarea').forEach(x=>x.disabled=!puedeModificar);
            if(btnSubir)btnSubir.disabled=!puedeModificar;
            if(lista){
                lista.innerHTML='';
                const documentos=j.documentos||[];
                if(!documentos.length){lista.innerHTML='<div class="lg-disabled-note" style="padding:12px">Todavía no hay documentos cargados.</div>';return}
                documentos.forEach(x=>{
                    const row=document.createElement('div');
                    row.className='lg-doc-row';
                    const estado=x.validado?'<span class="lg-doc-state ok"><i class="fa-solid fa-circle-check"></i> Validado</span>':'<span class="lg-doc-state"><i class="fa-solid fa-clock"></i> Pendiente</span>';
                    row.innerHTML=`<div class="lg-doc-icon"><i class="fa-solid ${iconoDocumento(x.nombreOriginal,x.tipoContenido)}"></i></div><div style="min-width:0"><strong title="${esc(x.nombreOriginal||'Documento')}">${esc(x.tipoDocumento||'Documento')} · ${esc(x.nombreOriginal||'')}</strong><small>${esc(x.areaResponsable||'Sin área')} · ${tamanoArchivo(x.tamanoBytes)} · ${esc(x.fechaCarga||'')} ${x.usuarioCarga?`· ${esc(x.usuarioCarga)}`:''}</small>${x.observaciones?`<small title="${esc(x.observaciones)}">Obs.: ${esc(x.observaciones)}</small>`:''}</div><div class="lg-doc-actions">${estado}<a class="lg-btn" style="height:27px;padding:0 7px" href="${esc(x.verUrl||'#')}" target="_blank" rel="noopener" title="Ver documento"><i class="fa-solid fa-eye"></i></a>${!x.validado&&puedeModificar?`<button class="lg-btn lg-btn-success" style="height:27px;padding:0 7px" type="button" data-validar-documento="${x.documentoId}"><i class="fa-solid fa-check"></i> Validar</button>`:''}${puedeModificar?`<button class="lg-btn lg-btn-danger" style="height:27px;padding:0 7px" type="button" data-retirar-documento="${x.documentoId}"><i class="fa-solid fa-trash-can"></i></button>`:''}</div>`;
                    lista.appendChild(row);
                });
            }
        }

        async function ejecutarAccionDocumento(url,data,mensajeError){
