        function buildSalidaFormData(){
            const fd=new FormData(document.getElementById('formSalida'));
            fd.append('__RequestVerificationToken',token);
            const tipo=document.querySelector('input[name="TipoOperacion"]:checked')?.value||'';
            const forma=document.querySelector('input[name="FormaEnvio"]:checked')?.value||'';
            if(tipo==='Exportacion')fd.set('PasaAduana','true');else fd.delete('PasaAduana');
            if(forma==='Paqueteria'){
                fd.set('ChoferExterno',document.getElementById('fsChoferExternoPaq').value||'');
