        }

    .lg-doc-state,
    .lg-mini-status,
    .lg-gate-state {
        font-size: 10px;
        padding: 5px 8px
    }

    .lg-doc-upload-grid {
        grid-template-columns: 260px minmax(0,1fr);
        gap: 10px;
        align-items: start
    }

    .lg-doc-upload-help {
        margin-top: 5px;
        color: var(--lg-muted);
        font-size: 10px;
        line-height: 1.4
    }

    .lg-doc-picker-actions {
        display: flex;
        gap: 8px;
        flex-wrap: wrap
    }

        .lg-doc-picker-actions .lg-btn {
