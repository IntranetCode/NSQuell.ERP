        async function openFlujo(id){
            if(!id)return;
            openModal('modalFlujo');
            document.getElementById('flowLoading').style.display='';
            document.getElementById('flowBody').style.display='none';
            try{
                const r=await fetch(`${urlFlujo}?embarqueId=${encodeURIComponent(id)}`,{headers:{'X-Requested-With':'XMLHttpRequest'}});
                let j;try{j=await r.json()}catch{throw new Error(`El servidor respondió ${r.status} y no devolvió JSON.`)}
                if(!r.ok||!j.ok)throw new Error(j.mensaje||`Error HTTP ${r.status}.`);
                flujoActual=j.flujo;
                documentosActual=null;
                cargaFisicaActual=null;
                renderFlujo(flujoActual);
                document.getElementById('flowLoading').style.display='none';
                document.getElementById('flowBody').style.display='';
            }catch(err){document.getElementById('flowLoading').innerHTML=`<div style="color:var(--lg-red)">${esc(err.message||'Error')}</div>`}
        }

        function renderFlujo(f){
            document.getElementById('flowTitulo').textContent=f.folio||`Embarque ${f.embarqueID}`;
            document.getElementById('flowSub').textContent=`${f.cliente||''}${f.destino?` · ${f.destino}`:''}`;
            document.getElementById('fCliente').textContent=f.cliente||'—';
            document.getElementById('fEstatus').textContent=f.estatus||'—';
            document.getElementById('fCarga').textContent=`${f.fechaCargaProgramada||'Sin fecha'} ${f.horaCargaProgramada||''}`.trim();
            document.getElementById('fPiezas').textContent=`${number(f.totalPiezas)} PZA`;
            document.getElementById('fPreparadas').textContent=`${number(f.totalPiezasPreparadas)} PZA`;
            ['btnVistaCompletaFlow','btnPreparacionVista','btnDocumentosVista','btnCargaVista','btnSalidaVista'].forEach(id=>{const a=document.getElementById(id);if(a)a.href=`${urlDetalleEmb}/${f.embarqueID}`});

            renderTimeline(f.pasos||[]);
            cargarSalidaForm(f);
            document.getElementById('fpFecha').textContent=f.fechaCargaProgramada||'—';
            document.getElementById('fpHora').textContent=f.horaCargaProgramada||'—';
            document.getElementById('fpPiezas').textContent=`${number(f.totalPiezas)} PZA`;
            document.getElementById('fpEntrega').textContent=f.fechaEntregaProgramada||'—';

            document.getElementById('frTotal').textContent=`${number(f.totalPiezas)} PZA`;
            document.getElementById('frPreparadas').textContent=`${number(f.totalPiezasPreparadas)} PZA`;
            document.getElementById('frCajas').textContent=number(f.totalCajas);
            const pctPreparacion=f.totalPiezas>0?Math.min(100,Math.round((Number(f.totalPiezasPreparadas||0)*100)/Number(f.totalPiezas||1))):0;
            document.getElementById('frAvance').textContent=`${pctPreparacion}%`;
            document.getElementById('frBar').style.width=`${pctPreparacion}%`;

            const totalCajas=Number(f.totalCajas||0);
            const cargadas=Number(f.totalCajasCargadas||0);
            const pendientes=Math.max(0,totalCajas-cargadas);
            const pctCarga=totalCajas>0?Math.min(100,Math.round((cargadas*100)/totalCajas)):0;
            document.getElementById('fcCajas').textContent=number(totalCajas);
            document.getElementById('fcCargadas').textContent=number(cargadas);
            document.getElementById('fcPendientes').textContent=number(pendientes);
            document.getElementById('fcEstatus').textContent=f.estatus||'—';
            document.getElementById('fcBar').style.width=`${pctCarga}%`;

            const pasoDocumentos=(f.pasos||[]).find(x=>x.clave==='documentos');
            document.getElementById('fdFaltantes').textContent=pasoDocumentos?.disponible||pasoDocumentos?.completo?number(f.documentosFaltantes):'—';
            document.getElementById('fdForma').textContent=formaTexto(f.salida?.formaEnvio);
            document.getElementById('fdTipo').textContent=tipoTexto(f.salida?.tipoOperacion);
            document.getElementById('fdEstado').textContent=pasoDocumentos?.completo?'Completa':pasoDocumentos?.disponible?'Pendiente':'Bloqueada';

            document.getElementById('fspInc').textContent=number(f.incidenciasAbiertas);
            document.getElementById('fspCrit').textContent=number(f.incidenciasCriticas);
            document.getElementById('fspDesp').textContent=`${number(f.totalPiezasDespachadas)} PZA`;
            document.getElementById('fspViaje').textContent=f.viajeID?`VIA-${String(f.viajeID).padStart(6,'0')}`:'—';

            const forma=f.salida?.formaEnvio||'';
            const ayudaSalida=document.getElementById('salidaPlantaAyuda');
            const btnSalidaPlanta=document.getElementById('btnConfirmarSalidaPlanta');
            if(btnSalidaPlanta){
                btnSalidaPlanta.style.display='none';
                btnSalidaPlanta.disabled=false;
                btnSalidaPlanta.title='';
            }
            if(forma==='Interno'){
                ayudaSalida.innerHTML=f.estatus==='En ruta'||f.estatus==='Entregado'
                    ?'<strong>Entrega:</strong> la salida de planta ya fue confirmada por el chofer y el embarque se encuentra '+esc(f.estatus)+'.'
                    :f.viajeID
                        ?`<strong>Entrega:</strong> el viaje VIA-${String(f.viajeID).padStart(6,'0')} ya está vinculado. La salida física la confirma exclusivamente el chofer desde su portal; al registrarla, PT se descuenta y el embarque pasa a En ruta.`
                        :'<strong>Entrega:</strong> falta crear o vincular el viaje del chofer antes de la salida.';
            }else if(forma==='Cliente'||forma==='Paqueteria'){
                if(f.estatus==='Cargado'){
                    if(Number(f.incidenciasCriticas||0)>0){
                        ayudaSalida.innerHTML=`<strong>Salida bloqueada:</strong> existen ${number(f.incidenciasCriticas)} incidencia(s) crítica(s) abierta(s). Deben resolverse antes de confirmar la salida de planta.`;
                        if(btnSalidaPlanta){btnSalidaPlanta.style.display='';btnSalidaPlanta.disabled=true;btnSalidaPlanta.title='Resuelve las incidencias críticas antes de continuar.'}
                    }else{
                        ayudaSalida.innerHTML=forma==='Cliente'
                            ?'<strong>Cliente recoge:</strong> la carga física está completa. Confirma la salida cuando la mercancía abandone realmente la planta; en ese momento se descontará PT y el embarque pasará a En ruta.'
                            :'<strong>Paquetería:</strong> la carga física está completa. Confirma la salida cuando la mercancía sea entregada al transportista; en ese momento se descontará PT y el embarque pasará a En ruta.';
                        if(btnSalidaPlanta)btnSalidaPlanta.style.display='';
                    }
                }else if(f.estatus==='En ruta'||f.estatus==='Entregado'){
                    ayudaSalida.innerHTML='<strong>Salida confirmada:</strong> la mercancía ya salió de planta y el descuento de PT fue registrado.';
                }else{
                    ayudaSalida.innerHTML='<strong>Salida externa:</strong> primero completa Documentación y Carga física. El botón de salida se habilitará cuando el embarque quede Cargado.';
                }
            }else{
                ayudaSalida.innerHTML='<strong>Salida:</strong> primero define y confirma la forma de salida del embarque.';
            }

            document.getElementById('entregaAyuda').innerHTML=f.estatus==='En ruta'?'<strong>Entrega disponible:</strong> captura al receptor y adjunta una o más evidencias para cerrar el embarque.':'<strong>Entrega:</strong> esta etapa se habilita cuando la salida física deja el embarque En ruta.';
            renderEvidenciasCompartidas(f.evidencias||[]);

            const btnEntrega=document.getElementById('btnEntregaFlow');
            btnEntrega.style.display=f.estatus==='En ruta'?'':'none';
            const actual=(f.pasos||[]).find(x=>x.actual)||(f.pasos||[]).find(x=>x.disponible&&!x.completo)||(f.pasos||[])[0];
            activateStage(actual?.clave||'programacion',false);
            actualizarBadges(f.pasos||[]);
        }

        function renderEvidenciasCompartidas(evidencias){
            const cont=document.getElementById('flowEvidencias');
            if(!cont)return;
            cont.innerHTML='';
            if(!evidencias.length){cont.innerHTML='<div class="lg-disabled-note" style="grid-column:1/-1;padding:12px">Todavía no hay evidencias registradas para el embarque o su viaje relacionado.</div>';return}
            evidencias.forEach(x=>{
                const esViaje=String(x.origen||'').toLowerCase()==='viaje';
                const href=`${esViaje?urlVerEvidenciaViaje:urlVerEvidenciaEmbarque}?id=${encodeURIComponent(x.evidenciaID)}`;
                const item=document.createElement('div');
                item.className='lg-evidence-item';
                item.innerHTML=`<i class="fa-solid ${x.esPdf?'fa-file-pdf':x.esImagen?'fa-image':'fa-paperclip'}"></i><div class="data"><strong title="${esc(x.nombreOriginal||'Evidencia')}">${esc(x.nombreOriginal||'Evidencia')}</strong><small>${esc(x.tipoEvidencia||'Evidencia')} · ${esc(x.fechaCarga||'')} · ${esc(x.usuario||'')}</small></div><span class="lg-origin-chip ${esViaje?'viaje':''}">${esViaje?'Viaje':'Embarque'}</span><a class="lg-btn" style="height:27px;padding:0 7px" href="${href}" target="_blank" rel="noopener" title="Ver evidencia"><i class="fa-solid fa-eye"></i></a>`;
                cont.appendChild(item);
            });
        }

