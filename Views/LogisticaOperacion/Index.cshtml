    }

    .lg-modal .lg-input,
    .lg-modal .lg-select {
        height: 40px;
        font-size: 14px;
        padding-left: 10px;
        padding-right: 10px
    }

    .lg-modal textarea.lg-input {
        height: auto;
        min-height: 80px;
        padding: 10px;
        line-height: 1.4;
        resize: vertical
    }

    .lg-doc-observaciones {
        min-height: 86px !important
    }

    .lg-detail-grid,
    .lg-trip-modal-summary {
        gap: 9px
    }

    .lg-detail {
        padding: 10px 11px
    }

        .lg-detail span {
            font-size: 10px;
            line-height: 1.25
        }

        .lg-detail strong {
            display: block;
            margin-top: 3px;
            font-size: 13px;
