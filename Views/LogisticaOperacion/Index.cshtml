    }

    .lg-flow-modal {
        width: min(1280px,calc(100vw - 48px))
    }

    .lg-day-modal {
        width: min(1180px,calc(100vw - 48px))
    }

    .lg-modal-sm {
        width: min(760px,calc(100vw - 48px))
    }

    .lg-modal-head {
        padding: 16px 18px;
        align-items: center
    }

        .lg-modal-head h2 {
            font-size: 20px;
