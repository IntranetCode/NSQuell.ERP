        }

    .lg-flow-summary {
        gap: 9px;
        margin-bottom: 14px
    }

    .lg-flow-layout {
        grid-template-columns: 275px minmax(0,1fr);
        gap: 14px
    }

    .lg-flow-side {
        padding: 11px
    }

        .lg-flow-side h3 {
            font-size: 13px;
            margin-bottom: 9px
        }

    .lg-flow-side-item {
        padding: 10px;
        margin-bottom: 7px
    }

        .lg-flow-side-item strong {
            font-size: 12px
        }

        .lg-flow-side-item span {
            font-size: 10px;
            line-height: 1.35
        }

    .lg-stage-head {
        padding-bottom: 11px;
        margin-bottom: 12px
    }

        .lg-stage-head h3 {
            font-size: 17px;
            line-height: 1.25
        }

        .lg-stage-head p {
            font-size: 12px;
            line-height: 1.45;
            margin-top: 4px
        }

    .lg-stage-badge {
        font-size: 10px;
        padding: 6px 9px
    }

    .lg-helpbox,
    .lg-flex-note,
    .lg-flow-warning,
    .lg-stage-lock,
    .lg-disabled-note {
        font-size: 12px;
        line-height: 1.45;
        padding: 10px 11px
    }

    .lg-inline-panel,
    .lg-subsection {
        padding: 12px;
        margin-top: 10px
    }

        .lg-inline-panel h4,
        .lg-subsection h4 {
            font-size: 12px;
            margin-bottom: 9px
        }

    .lg-radio-card {
        padding: 11px
    }

        .lg-radio-card strong {
            font-size: 12px
        }

        .lg-radio-card small {
            font-size: 10px;
            line-height: 1.35
        }

    .lg-step-dot {
        width: 42px;
        height: 42px;
        font-size: 15px
    }

    .lg-timeline:before {
        top: 21px
    }

    .lg-step-title {
