    }

    .lg-month .lg-unit-event-main {
        grid-template-columns: 1fr;
        margin-top: 1px
    }

    .lg-trip-modal-summary {
        display: grid;
        grid-template-columns: repeat(4,1fr);
        gap: 6px
    }

    .lg-modal-backdrop {
        z-index: 2147483000 !important
    }

    .lg-modal {
        position: relative;
        z-index: 2147483001
