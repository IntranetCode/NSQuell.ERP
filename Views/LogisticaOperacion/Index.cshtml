        display: grid;
        grid-template-columns: repeat(2,minmax(0,1fr));
        gap: 6px;
        margin-top: 8px
    }

    .lg-gate {
        border: 1px solid var(--lg-line);
        background: #fff;
        border-radius: 8px;
        padding: 7px 8px;
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 8px
    }

        .lg-gate .label {
            min-width: 0
        }

        .lg-gate strong {
            display: block;
            color: var(--lg-navy);
            font-size: 8px
        }

        .lg-gate small {
            display: block;
            color: var(--lg-muted);
            font-size: 6px;
            margin-top: 2px
        }

    .lg-gate-state {
        border-radius: 999px;
        padding: 3px 6px;
        font-size: 6px;
        font-weight: 900;
        white-space: nowrap;
        background: var(--lg-amber-soft);
        color: #8a5a0b
    }

        .lg-gate-state.ok {
            background: var(--lg-green-soft);
            color: var(--lg-green)
        }

        .lg-gate-state.block {
            background: var(--lg-red-soft);
            color: var(--lg-red)
        }

    @@media(max-width:760px) {
        .lg-pt-kpis, .lg-gates {
            grid-template-columns: 1fr 1fr
        }
    }

    @@media(max-width:520px) {
        .lg-pt-kpis, .lg-gates {
            grid-template-columns: 1fr
        }
    }

    /* ================================================================
                   CALENDARIO V2 - ALINEACION DE FILAS Y COLUMNAS
                   Corrige el desfase entre encabezados, dias y filas del calendario.
                   ================================================================ */
    .lg-board,
    .lg-board *,
    .lg-board *::before,
    .lg-board *::after {
        box-sizing: border-box;
    }

    .lg-board {
        --lg-client-col: 220px;
        --lg-day-min: 190px;
        scrollbar-gutter: stable;
        background: #fff;
    }

    .lg-grid-head,
    .lg-row {
        grid-template-columns: var(--lg-client-col) repeat(var(--dias), minmax(var(--lg-day-min), 1fr));
        width: 100%;
        min-width: calc(var(--lg-client-col) + (var(--dias) * var(--lg-day-min)));
        align-items: stretch;
    }

        .lg-grid-head > *,
        .lg-row > * {
            min-width: 0 !important;
        }

    .lg-head-client,
    .lg-client {
        width: var(--lg-client-col);
        min-width: var(--lg-client-col) !important;
        max-width: var(--lg-client-col);
    }

    .lg-day-head,
    .lg-client-day,
    .lg-unit-cell {
        width: 100%;
        min-width: 0 !important;
        max-width: none;
        border-right: 1px solid #c8d6e5;
    }

    .lg-grid-head {
        box-shadow: 0 2px 0 rgba(13,55,109,.08);
    }

    .lg-day-head {
        overflow: hidden;
        padding-left: 6px;
        padding-right: 6px;
    }

    .lg-hours-head {
        width: 100%;
        overflow: hidden;
    }

        .lg-hours-head span {
            min-width: 0;
            padding-left: 1px;
            border-right: 1px solid #d7e2ed;
        }

    .lg-row {
        border-bottom: 2px solid #c8d5e3;
        position: relative;
    }

        .lg-row:last-of-type {
            border-bottom-width: 1px;
        }

    .lg-client-row {
        min-height: var(--client-row-height,86px) !important;
        height: var(--client-row-height,86px) !important;
    }

        .lg-client-row .lg-client,
        .lg-client-row .lg-client-day {
            min-height: var(--client-row-height,86px) !important;
            height: var(--client-row-height,86px) !important;
        }

        .lg-client-row .lg-client {
            border-bottom: 0;
            background: #f9fbfd;
        }

    .lg-client-day {
        padding: 7px;
        overflow: hidden;
        background: repeating-linear-gradient( to right, transparent 0, transparent calc(100% / 24 - 1px), rgba(164,184,205,.62) calc(100% / 24 - 1px), rgba(164,184,205,.62) calc(100% / 24) ), #fff;
    }

        .lg-client-day.today {
            background: repeating-linear-gradient( to right, transparent 0, transparent calc(100% / 24 - 1px), rgba(93,145,201,.58) calc(100% / 24 - 1px), rgba(93,145,201,.58) calc(100% / 24) ), #f4f9ff;
        }

    .lg-client-row:nth-child(even) .lg-client-day:not(.today) {
        background: repeating-linear-gradient( to right, transparent 0, transparent calc(100% / 24 - 1px), rgba(164,184,205,.62) calc(100% / 24 - 1px), rgba(164,184,205,.62) calc(100% / 24) ), #fbfdff;
    }

    .lg-day-summary {
        width: min(100%, 310px);
        max-width: 310px;
    }

    .lg-summary-btn {
        max-width: 100% !important;
    }

    .lg-timed-layer {
        left: 7px;
        right: 7px;
    }

    .lg-timed-event {
        max-width: calc(100% - 8px);
    }

    .lg-unit-row,
    .lg-unit-row .lg-client,
    .lg-unit-cell {
        box-sizing: border-box;
    }

    .lg-unit-row {
        border-bottom: 2px solid #c8d5e3;
    }

    .lg-section-divider {
        border-bottom: 2px solid #0c2a4f;
    }

    .lg-month {
        --lg-day-min: 72px;
    }

        .lg-month .lg-grid-head,
        .lg-month .lg-row {
            grid-template-columns: var(--lg-client-col) repeat(var(--dias), minmax(var(--lg-day-min), 1fr));
            min-width: calc(var(--lg-client-col) + (var(--dias) * var(--lg-day-min)));
        }

        .lg-month .lg-day-head,
        .lg-month .lg-client-day,
        .lg-month .lg-unit-cell {
            min-width: 0 !important;
            width: 100%;
        }

    @@media (max-width: 900px) {
        .lg-board {
            --lg-client-col: 190px;
        }
    }



    /* ================================================================
                   CALENDARIO V3 - DIVISIONES, HORA ACTUAL Y EMBARQUES VENCIDOS
                   ================================================================ */
    .lg-client-row > .lg-client,
    .lg-client-row > .lg-client-day {
        box-shadow: inset 0 -2px 0 #9fb3c8;
    }

    .lg-client-row > .lg-client {
        border-right: 2px solid #aebfd1 !important;
    }

    .lg-client-row:nth-of-type(even) > .lg-client {
        background: #f5f8fc;
    }

    .lg-client-row:hover > .lg-client,
    .lg-client-row:hover > .lg-client-day {
        box-shadow: inset 0 -2px 0 #7895b3, inset 0 0 0 9999px rgba(31,102,194,.018);
    }

    .lg-client-day.today,
    .lg-day-head.today,
    .lg-unit-cell.today {
        position: relative;
    }

    .lg-now-line {
        position: absolute;
        top: 0;
        bottom: 0;
        width: 2px;
        background: #e11d48;
        z-index: 18;
        pointer-events: none;
        box-shadow: 0 0 0 1px rgba(255,255,255,.7), 0 0 7px rgba(225,29,72,.35);
    }

    .lg-day-head .lg-now-line {
        z-index: 35;
    }

    .lg-now-line::before {
        content: "";
        position: absolute;
        top: -1px;
        left: 50%;
        transform: translateX(-50%);
        width: 7px;
        height: 7px;
        border-radius: 50%;
        background: #e11d48;
    }

    .lg-now-label {
        position: absolute;
        top: 21px;
        left: 6px;
        padding: 2px 5px;
        border-radius: 5px;
        background: #e11d48;
        color: #fff;
        font-size: 6px;
        line-height: 1.2;
        font-weight: 900;
        white-space: nowrap;
        box-shadow: 0 3px 8px rgba(120,20,45,.22);
    }

    .lg-timed-event.emb.is-overdue {
        background: #fff1f2 !important;
        border-color: #e11d48 !important;
        color: #9f1239 !important;
        box-shadow: inset 4px 0 0 #e11d48, 0 4px 12px rgba(225,29,72,.18) !important;
        animation: lgLatePulse 1.8s ease-in-out infinite;
    }

        .lg-timed-event.emb.is-overdue::after {
            content: attr(data-alerta-atraso);
            position: absolute;
            right: 4px;
            bottom: 3px;
            padding: 1px 4px;
            border-radius: 999px;
            background: #be123c;
            color: #fff;
            font-size: 5px;
            font-weight: 900;
            letter-spacing: .02em;
        }

    .lg-late-hint {
        display: block !important;
        margin-top: 2px !important;
        padding-right: 55px;
        color: #be123c !important;
        font-size: 5.5px !important;
        font-weight: 900;
        opacity: 1 !important;
    }

    @@keyframes lgLatePulse {
        0%, 100% {
            box-shadow: inset 4px 0 0 #e11d48, 0 4px 12px rgba(225,29,72,.15);
        }

        50% {
            box-shadow: inset 4px 0 0 #e11d48, 0 5px 16px rgba(225,29,72,.34);
        }
    }

    .lg-month .lg-now-line,
    .lg-month .lg-now-label {
        display: none !important;
    }

    .lg-legend .lg-dot.now {
        width: 2px;
        border: 0;
        border-radius: 0;
        background: #e11d48;
    }

    .lg-legend .lg-dot.late {
        background: #fff1f2;
        border-color: #e11d48;
    }


    /* ================================================================
               MODALES V4 - LEGIBLES EN ESCRITORIO + RESPONSIVE + DOCUMENTOS
               ================================================================ */
    .lg-modal-backdrop {
        padding: 24px;
        background: rgba(8,22,42,.58)
    }

    .lg-modal {
        width: min(1100px,calc(100vw - 48px));
