                    <tbody id="dayProgBody"></tbody>
                </table>
            </section>

            <section class="lg-day-list" data-day-list="embarques">
                <table class="lg-day-table">
                    <thead><tr><th>Embarque</th><th>Parte / Cliente</th><th>Fecha / Hora</th><th>Piezas</th><th>Estatus</th><th style="width:110px">Acción</th></tr></thead>
                    <tbody id="dayEmbBody"></tbody>
                </table>
            </section>
        </div>
        <div class="lg-modal-foot">
            <button class="lg-btn" type="button" data-close="modalClienteDia">Cerrar</button>
        </div>
    </div>
</div>



<div class="lg-modal-backdrop" id="modalIniciarEmbarque">
    <div class="lg-modal lg-modal-sm">
        <div class="lg-modal-head">
            <div><h2>Iniciar embarque</h2><p id="ieSub">Selecciona los Releases planeados que Logística tomará para este embarque.</p></div>
            <button class="lg-close" type="button" data-close="modalIniciarEmbarque">✕</button>
        </div>
        <form id="formIniciarEmbarque">
            <div class="lg-modal-body">
                <input type="hidden" id="ieClienteID" name="ClienteID" />
                <input type="hidden" id="ieFecha" name="FechaProgramada" />
                <div class="lg-helpbox"><strong>Separación de responsabilidades:</strong> Planeación ya definió el día. Al iniciar el embarque, Logística únicamente toma esas programaciones y comienza su flujo operativo. No se abrirá el timeline automáticamente.</div>
                <div class="lg-form-grid" style="margin-bottom:8px">
                    <div class="lg-field"><label>Cliente</label><input class="lg-input" id="ieCliente" readonly /></div>
                    <div class="lg-field"><label>Día planeado</label><input class="lg-input" id="ieFechaTexto" readonly /></div>
                    <div class="lg-field"><label>Hora de carga *</label><input class="lg-input" type="time" id="ieHora" name="HoraProgramada" step="60" required /></div>
                    <div class="lg-field"><label>Releases seleccionados</label><input class="lg-input" id="ieSeleccionados" readonly value="0" /></div>
                    <div class="lg-field full"><label>Observaciones</label><textarea class="lg-input" style="height:62px;padding-top:7px" id="ieObservaciones" name="Observaciones" maxlength="500" placeholder="Opcional"></textarea></div>
                </div>
                <div style="border:1px solid var(--lg-line);border-radius:8px;overflow:hidden">
                    <table class="lg-day-table">
                        <thead><tr><th style="width:34px"><input type="checkbox" id="ieCheckAll" checked /></th><th>Release / Parte</th><th>Fecha requerida</th><th>Pendiente</th><th>Prioridad</th></tr></thead>
                        <tbody id="ieBody"><tr><td colspan="5" style="text-align:center;color:var(--lg-muted);padding:18px"><i class="fa-solid fa-spinner fa-spin"></i> Cargando programaciones...</td></tr></tbody>
                    </table>
                </div>
            </div>
            <div class="lg-modal-foot">
                <button class="lg-btn" type="button" data-close="modalIniciarEmbarque">Cancelar</button>
                <button class="lg-btn lg-btn-primary" type="submit" id="btnCrearEmbarque"><i class="fa-solid fa-truck-fast"></i> Crear embarque</button>
            </div>
        </form>
    </div>
</div>

<div class="lg-modal-backdrop" id="modalAsignarHora">
    <div class="lg-modal lg-modal-sm">
