        async function guardarSalida(confirmar){
            const url=confirmar?urlConfirmarSalida:urlGuardarSalida;
            const btn=confirmar?document.getElementById('btnGuardarContinuar'):document.getElementById('btnGuardarSalir');
            try{
                btn.disabled=true;
                const r=await fetch(url,{method:'POST',body:buildSalidaFormData()});
                let j;try{j=await r.json()}catch{throw new Error(`El servidor respondió ${r.status} y no devolvió JSON.`)}
                if(!r.ok||!j.ok)throw new Error(j.mensaje||'No fue posible guardar la forma de salida.');
                document.getElementById('fsRowVersion').value=j.rowVersion||document.getElementById('fsRowVersion').value;
                const card=document.querySelector(`.lg-event[data-embarque-id="${flujoActual?.embarqueID}"]`);if(card&&j.rowVersion)card.dataset.rowVersion=j.rowVersion;
                toast(j.mensaje||'Información guardada.');
                if(!confirmar){closeModal('modalFlujo');return}
                await refrescarFlujoActual('preparacion');
            }catch(err){toast(err.message||'Error al guardar.','error')}
            finally{btn.disabled=false}
        }
        document.getElementById('btnGuardarSalir')?.addEventListener('click',()=>guardarSalida(false));
        document.getElementById('btnGuardarContinuar')?.addEventListener('click',()=>guardarSalida(true));

