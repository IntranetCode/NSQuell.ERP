            <div class="lg-day-program-bar" id="bulkProgramBar" style="@(!puedeProgramar ? "display:none" : "")">
                <div class="lg-field">
                    <label>Programar releases seleccionados</label>
                    <div style="font-size:8px;color:var(--lg-muted)">Usará la cantidad pendiente completa de cada Release.</div>
