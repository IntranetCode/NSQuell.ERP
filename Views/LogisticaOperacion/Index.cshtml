        }

        .lg-doc-file-picker.selected {
            border-style: solid;
            border-color: #8fc9ad;
            background: #f3fbf7
        }

        .lg-doc-file-picker.disabled {
            opacity: .55;
            cursor: not-allowed
        }

        .lg-doc-file-picker input {
            position: absolute;
            width: 1px;
            height: 1px;
            opacity: 0;
            pointer-events: none
        }

        .lg-doc-file-picker > i {
            width: 32px;
            height: 32px;
            border-radius: 8px;
            display: flex;
            align-items: center;
            justify-content: center;
