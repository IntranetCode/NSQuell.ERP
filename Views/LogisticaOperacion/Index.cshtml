            <section class="lg-day-list active" data-day-list="requerimientos">
                <table class="lg-day-table">
                    <thead><tr><th style="width:30px"><input type="checkbox" id="checkAllReq" /></th><th>Release / Parte</th><th>Fecha requerida</th><th>Pendiente</th><th>Prioridad</th><th style="width:110px">Acción</th></tr></thead>
                    <tbody id="dayReqBody"></tbody>
                </table>
            </section>

            <section class="lg-day-list" data-day-list="programaciones">
