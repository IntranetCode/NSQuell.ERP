        let evidenciasEntregaDT=new DataTransfer();
        const inputEvidenciasEntrega=document.getElementById('cEvidencias');

        function tamanoArchivo(bytes){
            const n=Number(bytes||0);
            if(n<1024)return `${n} B`;
            if(n<1024*1024)return `${(n/1024).toFixed(1)} KB`;
            return `${(n/1024/1024).toFixed(1)} MB`;
        }

        function renderEvidenciasEntrega(){
            if(!inputEvidenciasEntrega)return;
            inputEvidenciasEntrega.files=evidenciasEntregaDT.files;
            const lista=document.getElementById('cEvidenciasLista');
            const resumen=document.getElementById('cEvidenciasResumen');
            lista.innerHTML='';
            const archivos=[...evidenciasEntregaDT.files];
            archivos.forEach((file,index)=>{
                const ext=(file.name.split('.').pop()||'').toLowerCase();
                const imagen=file.type.startsWith('image/')||['jpg','jpeg','png','webp','heic','heif'].includes(ext);
                const item=document.createElement('div');
                item.className='lg-file-item';
                item.innerHTML=`<div class="lg-file-item-icon"><i class="fa-solid ${imagen?'fa-image':'fa-file-pdf'}"></i></div><div><strong title="${esc(file.name)}">${esc(file.name)}</strong><small>${tamanoArchivo(file.size)}</small></div><button type="button" class="lg-file-remove" data-remove-evidencia="${index}" title="Quitar"><i class="fa-solid fa-xmark"></i></button>`;
                lista.appendChild(item);
            });
            const total=archivos.reduce((a,x)=>a+x.size,0);
            resumen.textContent=`${archivos.length} evidencia(s) · ${tamanoArchivo(total)}`;
        }

        function limpiarEvidenciasEntrega(){
            evidenciasEntregaDT=new DataTransfer();
            renderEvidenciasEntrega();
        }

        inputEvidenciasEntrega?.addEventListener('change',e=>{
            const nuevas=[...e.target.files];
            const existentes=[...evidenciasEntregaDT.files];
            for(const file of nuevas){
                const ext=(file.name.split('.').pop()||'').toLowerCase();
                if(!['jpg','jpeg','png','webp','heic','heif','pdf'].includes(ext)){toast(`${file.name}: formato no permitido.`,'error');continue}
                if(file.size>10*1024*1024){toast(`${file.name}: excede 10 MB.`,'error');continue}
                if(existentes.some(x=>x.name===file.name&&x.size===file.size&&x.lastModified===file.lastModified)){toast(`${file.name}: ya fue agregado.`,'error');continue}
                if(evidenciasEntregaDT.items.length>=15){toast('Puedes adjuntar como máximo 15 evidencias.','error');break}
                const totalActual=[...evidenciasEntregaDT.files].reduce((a,x)=>a+x.size,0);
                if(totalActual+file.size>100*1024*1024){toast('El total de evidencias no puede exceder 100 MB.','error');break}
                evidenciasEntregaDT.items.add(file);
                existentes.push(file);
            }
            renderEvidenciasEntrega();
        });

        document.getElementById('cEvidenciasLista')?.addEventListener('click',e=>{
            const btn=e.target.closest('[data-remove-evidencia]');
            if(!btn)return;
            const quitar=Number(btn.dataset.removeEvidencia);
            const nuevo=new DataTransfer();
            [...evidenciasEntregaDT.files].forEach((file,index)=>{if(index!==quitar)nuevo.items.add(file)});
            evidenciasEntregaDT=nuevo;
            renderEvidenciasEntrega();
        });

        document.getElementById('btnConfirmarSalidaPlanta')?.addEventListener('click',async()=>{
            if(!flujoActual?.embarqueID)return;
            const forma=flujoActual.salida?.formaEnvio||'';
            if(forma==='Interno'){toast('La salida de esta Entrega debe confirmarla el chofer desde su portal.','error');return}
            if(forma!=='Cliente'&&forma!=='Paqueteria'){toast('Primero confirma una forma de salida válida.','error');return}
            if(flujoActual.estatus!=='Cargado'){toast(`El embarque debe estar Cargado antes de confirmar la salida. Estado actual: ${flujoActual.estatus||'sin estado'}.`,'error');return}
            if(Number(flujoActual.incidenciasCriticas||0)>0){toast('Existen incidencias críticas abiertas. Resuélvelas antes de confirmar la salida.','error');return}
            const textoForma=forma==='Cliente'?'Cliente recoge':'Paquetería';
            if(!window.confirm(`¿Confirmar la salida real de planta para ${textoForma}? Esta acción registrará la salida de PT y cambiará el embarque a En ruta.`))return;
            const btn=document.getElementById('btnConfirmarSalidaPlanta');
            const original=btn.innerHTML;
            const data=new URLSearchParams();
            data.append('__RequestVerificationToken',token);
            data.append('embarqueId',String(flujoActual.embarqueID));
            data.append('rowVersion',flujoActual.rowVersion||document.getElementById('fsRowVersion')?.value||'');
            try{
                btn.disabled=true;
                btn.innerHTML='<i class="fa-solid fa-spinner fa-spin"></i> Confirmando salida...';
                const r=await fetch(urlConfirmarSalidaPlanta,{method:'POST',headers:{'Content-Type':'application/x-www-form-urlencoded; charset=UTF-8','X-Requested-With':'XMLHttpRequest'},body:data.toString()});
                let j;try{j=await r.json()}catch{throw new Error(`El servidor respondió ${r.status} y no devolvió JSON.`)}
                if(!r.ok||!j.ok)throw new Error(j.mensaje||'No fue posible confirmar la salida de planta.');
                if(j.rowVersion){
                    flujoActual.rowVersion=j.rowVersion;
                    document.getElementById('fsRowVersion').value=j.rowVersion;
                    document.querySelectorAll(`[data-embarque-id="${flujoActual.embarqueID}"]`).forEach(x=>{if(x.dataset)x.dataset.rowVersion=j.rowVersion});
                }
                toast(j.mensaje||'Salida de planta confirmada.');
                await refrescarFlujoActual('entrega');
            }catch(err){toast(err.message||'Error al confirmar la salida de planta.','error')}
            finally{btn.disabled=false;btn.innerHTML=original}
        });

        document.getElementById('btnEntregaFlow')?.addEventListener('click',()=>{
            if(!flujoActual)return;
            closeModal('modalFlujo');
            const form=document.getElementById('formCerrar');
            form.reset();
            limpiarEvidenciasEntrega();
            document.getElementById('cEmbarqueID').value=flujoActual.embarqueID;
            document.getElementById('cRowVersion').value=flujoActual.rowVersion||document.querySelector(`.lg-event[data-embarque-id="${flujoActual.embarqueID}"]`)?.dataset.rowVersion||'';
            const now=new Date();now.setMinutes(now.getMinutes()-now.getTimezoneOffset());document.getElementById('cFecha').value=now.toISOString().slice(0,16);
            openModal('modalCerrar');
        });

        document.getElementById('formCerrar')?.addEventListener('submit',async e=>{
            e.preventDefault();
            if(evidenciasEntregaDT.files.length===0){toast('Adjunta al menos una evidencia de entrega.','error');return}
            const btn=document.getElementById('btnConfirmarEntrega');
            const original=btn.innerHTML;
            const fd=new FormData(e.currentTarget);
            fd.append('__RequestVerificationToken',token);
            try{
                btn.disabled=true;btn.innerHTML='<i class="fa-solid fa-spinner fa-spin"></i> Guardando...';
                const r=await fetch(urlCerrar,{method:'POST',body:fd});
                let j;try{j=await r.json()}catch{throw new Error(`El servidor respondió ${r.status} y no devolvió JSON.`)}
                if(!r.ok||!j.ok)throw new Error(j.mensaje||'No fue posible cerrar la entrega.');
                closeModal('modalCerrar');
                toast(j.mensaje||'Entrega confirmada.');
                setTimeout(()=>location.reload(),650);
            }catch(err){toast(err.message||'Error al cerrar la entrega.','error')}
            finally{btn.disabled=false;btn.innerHTML=original}
        });
    })();
</script>
