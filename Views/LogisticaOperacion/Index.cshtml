                document.getElementById('vIncidencias').textContent=crit>0?`${inc} abiertas · ${crit} críticas`:String(inc);
                document.getElementById('vRuta').textContent=card.dataset.ruta||'—';
                document.getElementById('vOrigen').textContent=card.dataset.origen||'—';
                document.getElementById('vDestino').textContent=card.dataset.destino||'—';
                document.getElementById('vPlacas').textContent=card.dataset.placas||'—';
                document.getElementById('vEvSalida').textContent=number(card.dataset.evidSalida);
                document.getElementById('vEvTrayecto').textContent=number(card.dataset.evidTrayecto);
                document.getElementById('vEvRegreso').textContent=number(card.dataset.evidRegreso);
                document.getElementById('vEvIncidencia').textContent=number(card.dataset.evidIncidencia);
                openModal('modalViaje');
            });
        });

        async function openFlujo(id){
            if(!id)return;
            openModal('modalFlujo');
            document.getElementById('flowLoading').style.display='';
            document.getElementById('flowBody').style.display='none';
            try{
                const r=await fetch(`${urlFlujo}?embarqueId=${encodeURIComponent(id)}`,{headers:{'X-Requested-With':'XMLHttpRequest'}});
                let j;try{j=await r.json()}catch{throw new Error(`El servidor respondió ${r.status} y no devolvió JSON.`)}
                if(!r.ok||!j.ok)throw new Error(j.mensaje||`Error HTTP ${r.status}.`);
                flujoActual=j.flujo;
                renderFlujo(flujoActual);
                document.getElementById('flowLoading').style.display='none';
                document.getElementById('flowBody').style.display='';
            }catch(err){document.getElementById('flowLoading').innerHTML=`<div style="color:var(--lg-red)">${esc(err.message||'Error')}</div>`}
        }

        function renderFlujo(f){
            document.getElementById('flowTitulo').textContent=f.folio||`Embarque ${f.embarqueID}`;
            document.getElementById('flowSub').textContent=`${f.cliente||''}${f.destino?` · ${f.destino}`:''}`;
            document.getElementById('fCliente').textContent=f.cliente||'—';
            document.getElementById('fEstatus').textContent=f.estatus||'—';
            document.getElementById('fCarga').textContent=`${f.fechaCargaProgramada||'Sin fecha'} ${f.horaCargaProgramada||''}`.trim();
            document.getElementById('fPiezas').textContent=`${number(f.totalPiezas)} PZA`;
            document.getElementById('fPreparadas').textContent=`${number(f.totalPiezasPreparadas)} PZA`;
            document.getElementById('btnVistaCompletaFlow').href=`${urlDetalleEmb}/${f.embarqueID}`;
            document.getElementById('btnPreparacionVista').href=`${urlDetalleEmb}/${f.embarqueID}`;

            renderTimeline(f.pasos||[]);
            cargarSalidaForm(f);
            document.getElementById('fpFecha').textContent=f.fechaCargaProgramada||'—';
            document.getElementById('fpHora').textContent=f.horaCargaProgramada||'—';
            document.getElementById('fpPiezas').textContent=`${number(f.totalPiezas)} PZA`;
            document.getElementById('fpEntrega').textContent=f.fechaEntregaProgramada||'—';
            document.getElementById('frTotal').textContent=`${number(f.totalPiezas)} PZA`;
            document.getElementById('frPreparadas').textContent=`${number(f.totalPiezasPreparadas)} PZA`;
            document.getElementById('frCajas').textContent=number(f.totalCajas);
            const pct=f.totalPiezas>0?Math.min(100,Math.round((Number(f.totalPiezasPreparadas||0)*100)/Number(f.totalPiezas||1))):0;
            document.getElementById('frAvance').textContent=`${pct}%`;document.getElementById('frBar').style.width=`${pct}%`;
            document.getElementById('fcCajas').textContent=number(f.totalCajas);document.getElementById('fcCargadas').textContent=number(f.totalCajasCargadas);
            document.getElementById('fcEvidencias').textContent=number(f.totalEvidencias);document.getElementById('fcEstatus').textContent=f.estatus||'—';
            document.getElementById('fdFaltantes').textContent=number(f.documentosFaltantes);document.getElementById('fdForma').textContent=formaTexto(f.salida?.formaEnvio);
            document.getElementById('fdTipo').textContent=tipoTexto(f.salida?.tipoOperacion);document.getElementById('fdEvidencias').textContent=number(f.totalEvidencias);
            document.getElementById('fspInc').textContent=number(f.incidenciasAbiertas);document.getElementById('fspCrit').textContent=number(f.incidenciasCriticas);
            document.getElementById('fspDesp').textContent=`${number(f.totalPiezasDespachadas)} PZA`;document.getElementById('fspEst').textContent=f.estatus||'—';
            const btnEntrega=document.getElementById('btnEntregaFlow');btnEntrega.style.display=f.estatus==='En ruta'?'':'none';
            const actual=(f.pasos||[]).find(x=>x.actual)||(f.pasos||[]).find(x=>x.disponible&&!x.completo)||(f.pasos||[])[0];
            activateStage(actual?.clave||'programacion');
            actualizarBadges(f.pasos||[]);
        }

        function renderTimeline(pasos){
            const top=document.getElementById('flowTimeline'),side=document.getElementById('flowSide');top.innerHTML='';side.innerHTML='';
            pasos.forEach(p=>{
                const cls=p.completo?'complete':p.actual?'actual':!p.disponible?'blocked':'';
                const d=document.createElement('div');d.className=`lg-step ${cls}`;d.innerHTML=`<div class="lg-step-dot"><i class="fa-solid ${esc(p.icono||'fa-circle')}"></i></div><div class="lg-step-title">${esc(p.numero)}. ${esc(p.titulo)}</div><div class="lg-step-state">${esc(p.estadoTexto)}</div>`;top.appendChild(d);
                const s=document.createElement('div');s.className=`lg-flow-side-item ${p.completo?'complete':''} ${p.actual?'active':''} ${!p.disponible&&!p.completo?'blocked':''}`;s.dataset.stage=p.clave;s.innerHTML=`<strong>${esc(p.numero)}. ${esc(p.titulo)}</strong><span>${esc(p.descripcion)}</span>`;if(p.disponible||p.completo)s.addEventListener('click',()=>activateStage(p.clave));side.appendChild(s);
            });
        }

        function actualizarBadges(pasos){
            const map={programacion:'badgeProgramacion',salida:'badgeSalida',preparacion:'badgePreparacion',carga:'badgeCarga',documentos:'badgeDocumentos',salidaPlanta:'badgeSalidaPlanta',entrega:'badgeEntrega'};
            pasos.forEach(p=>{const b=document.getElementById(map[p.clave]);if(!b)return;b.textContent=p.estadoTexto;b.className=`lg-stage-badge ${p.completo?'ok':p.actual?'current':''}`});
        }

        function activateStage(clave){
            document.querySelectorAll('.lg-stage').forEach(x=>x.classList.toggle('active',x.dataset.stage===clave));
            document.querySelectorAll('.lg-flow-side-item').forEach(x=>x.classList.toggle('active',x.dataset.stage===clave));
        }
        document.querySelectorAll('[data-next-stage]').forEach(b=>b.addEventListener('click',()=>activateStage(b.dataset.nextStage)));

        function setRadio(name,value){
            document.querySelectorAll(`#formSalida input[name="${name}"]`).forEach(x=>x.checked=String(x.value)===String(value??''));
        }
        function fillSelect(id,items,value){
            const s=document.getElementById(id);s.innerHTML='<option value="">Selecciona...</option>';(items||[]).forEach(x=>{const o=document.createElement('option');o.value=x.id;o.textContent=x.texto;if(String(x.id)===String(value??''))o.selected=true;s.appendChild(o)});
        }
        function cargarSalidaForm(f){
            const s=f.salida||{};
            document.getElementById('fsEmbarqueID').value=f.embarqueID;
            document.getElementById('fsRowVersion').value=s.rowVersion||f.rowVersion||'';
            setRadio('TipoOperacion',s.tipoOperacion);setRadio('FormaEnvio',s.formaEnvio);
            if(s.pasaAduana===true)setRadio('PasaAduana','true');else if(s.pasaAduana===false)setRadio('PasaAduana','false');else document.querySelectorAll('input[name="PasaAduana"]').forEach(x=>x.checked=false);
            fillSelect('fsRuta',f.rutas,s.rutaID);fillSelect('fsUnidad',f.unidades,s.unidadID);fillSelect('fsChofer',f.choferes,s.choferUsuarioID);
            document.getElementById('fsModalidad').value=s.modalidadEnvio||'';document.getElementById('fsTransportista').value=s.transportista||'';document.getElementById('fsGuia').value=s.guiaReferencia||'';
            document.getElementById('fsChoferExterno').value=s.choferExterno||'';document.getElementById('fsUnidadExterna').value=s.unidadExterna||'';document.getElementById('fsPlacasExternas').value=s.placasExternas||'';
            document.getElementById('fsChoferExternoPaq').value=s.choferExterno||'';document.getElementById('fsUnidadExternaPaq').value=s.unidadExterna||'';document.getElementById('fsPlacasExternasPaq').value=s.placasExternas||'';
            syncSalidaVisibility();
        }

        function syncSalidaVisibility(){
            const tipo=document.querySelector('input[name="TipoOperacion"]:checked')?.value||'';
            const forma=document.querySelector('input[name="FormaEnvio"]:checked')?.value||'';
            document.getElementById('bloqueAduana').style.display=tipo==='Exportacion'?'':'none';
            document.getElementById('salidaInterna').style.display=forma==='Interno'?'':'none';
            document.getElementById('salidaCliente').style.display=forma==='Cliente'?'':'none';
            document.getElementById('salidaPaqueteria').style.display=forma==='Paqueteria'?'':'none';
        }
        document.querySelectorAll('input[name="TipoOperacion"],input[name="FormaEnvio"]').forEach(x=>x.addEventListener('change',syncSalidaVisibility));

        function buildSalidaFormData(){
            const fd=new FormData(document.getElementById('formSalida'));
            fd.append('__RequestVerificationToken',token);
            const forma=document.querySelector('input[name="FormaEnvio"]:checked')?.value||'';
            if(forma==='Paqueteria'){
                fd.set('ChoferExterno',document.getElementById('fsChoferExternoPaq').value||'');
                fd.set('UnidadExterna',document.getElementById('fsUnidadExternaPaq').value||'');
                fd.set('PlacasExternas',document.getElementById('fsPlacasExternasPaq').value||'');
            }
            return fd;
        }

        async function guardarSalida(confirmar){
            const url=confirmar?urlConfirmarSalida:urlGuardarSalida;
            const btn=confirmar?document.getElementById('btnGuardarContinuar'):document.getElementById('btnGuardarSalir');
            try{
                btn.disabled=true;
                const r=await fetch(url,{method:'POST',body:buildSalidaFormData()});
                let j;try{j=await r.json()}catch{throw new Error(`El servidor respondió ${r.status} y no devolvió JSON.`)}
                if(!r.ok||!j.ok)throw new Error(j.mensaje||'No fue posible guardar la forma de salida.');
                document.getElementById('fsRowVersion').value=j.rowVersion||document.getElementById('fsRowVersion').value;
                const card=document.querySelector(`.lg-event[data-embarque-id="${flujoActual?.embarqueID}"]`);if(card&&j.rowVersion)card.dataset.rowVersion=j.rowVersion;
                toast(j.mensaje||'Información guardada.');
                if(!confirmar){closeModal('modalFlujo');return}
                await refrescarFlujoActual('preparacion');
            }catch(err){toast(err.message||'Error al guardar.','error')}
            finally{btn.disabled=false}
        }
        document.getElementById('btnGuardarSalir')?.addEventListener('click',()=>guardarSalida(false));
        document.getElementById('btnGuardarContinuar')?.addEventListener('click',()=>guardarSalida(true));

        async function refrescarFlujoActual(stage){
            if(!flujoActual?.embarqueID)return;
            try{
                const r=await fetch(`${urlFlujo}?embarqueId=${encodeURIComponent(flujoActual.embarqueID)}`);const j=await r.json();if(!r.ok||!j.ok)throw new Error(j.mensaje||'No fue posible actualizar el flujo.');
                flujoActual=j.flujo;renderFlujo(flujoActual);if(stage)activateStage(stage);
            }catch(err){toast(err.message||'No fue posible actualizar el flujo.','error')}
        }


        document.getElementById('formAsignarHora')?.addEventListener('submit',async e=>{
            e.preventDefault();
            const id=document.getElementById('ahID').value;
            const fecha=document.getElementById('ahFecha').value;
            const hora=document.getElementById('ahHora').value;
            const obs=document.getElementById('ahObs').value;
            if(!fecha||!hora){toast('Captura fecha y hora.','error');return}
            const data=new URLSearchParams();
            data.append('__RequestVerificationToken',token);
            try{
                const url=urlMoverEmb;
                data.append('EmbarqueID',id);
                data.append('FechaCargaProgramada',fecha);
                data.append('HoraCargaProgramada',hora);
                data.append('RowVersion',document.getElementById('ahRowVersion').value||'');
                if(obs)data.append('Observaciones',obs);
                const r=await fetch(url,{method:'POST',headers:{'Content-Type':'application/x-www-form-urlencoded; charset=UTF-8'},body:data.toString()});
                let j;try{j=await r.json()}catch{throw new Error(`El servidor respondió ${r.status}.`)}
                if(!r.ok||!j.ok)throw new Error(j.mensaje||'No fue posible guardar la hora.');
                closeModal('modalAsignarHora');
                toast(j.mensaje||'Hora guardada correctamente.');
                setTimeout(()=>location.reload(),650);
            }catch(err){toast(err.message||'Error al guardar la hora.','error')}
        });

        document.getElementById('btnEntregaFlow')?.addEventListener('click',()=>{
            if(!flujoActual)return;
            closeModal('modalFlujo');
            document.getElementById('cEmbarqueID').value=flujoActual.embarqueID;
            document.getElementById('cRowVersion').value=flujoActual.rowVersion||document.querySelector(`.lg-event[data-embarque-id="${flujoActual.embarqueID}"]`)?.dataset.rowVersion||'';
            const now=new Date();now.setMinutes(now.getMinutes()-now.getTimezoneOffset());document.getElementById('cFecha').value=now.toISOString().slice(0,16);
            openModal('modalCerrar');
        });

        document.getElementById('formCerrar')?.addEventListener('submit',async e=>{
            e.preventDefault();const fd=new FormData(e.currentTarget);fd.append('__RequestVerificationToken',token);
            try{const r=await fetch(urlCerrar,{method:'POST',body:fd});const j=await r.json();if(!r.ok||!j.ok)throw new Error(j.mensaje||'No fue posible cerrar.');closeModal('modalCerrar');toast(j.mensaje||'Entrega confirmada.');setTimeout(()=>location.reload(),650)}
            catch(err){toast(err.message||'Error al cerrar.','error')}
        });
    })();
</script>
