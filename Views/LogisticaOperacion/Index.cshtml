<div class="lg-modal-backdrop" id="modalFlujo">
    <div class="lg-modal lg-flow-modal">
        <div class="lg-modal-head">
            <div>
                <h2 id="flowTitulo">Flujo operativo del embarque</h2>
                <p id="flowSub">Cargando información...</p>
            </div>
            <button class="lg-close" type="button" data-close="modalFlujo">✕</button>
        </div>
        <div class="lg-modal-body">
            <div id="flowLoading" style="text-align:center;padding:42px;color:var(--lg-muted)"><i class="fa-solid fa-spinner fa-spin"></i> Cargando flujo operativo...</div>
            <div id="flowBody" style="display:none">
                <div class="lg-flow-summary">
                    <div class="lg-detail"><span>Cliente</span><strong id="fCliente">—</strong></div>
                    <div class="lg-detail"><span>Estatus</span><strong id="fEstatus">—</strong></div>
                    <div class="lg-detail"><span>Carga programada</span><strong id="fCarga">—</strong></div>
                    <div class="lg-detail"><span>Piezas</span><strong id="fPiezas">—</strong></div>
                    <div class="lg-detail"><span>PT disponible</span><strong id="fPreparadas">—</strong></div>
                </div>

                <div class="lg-timeline" id="flowTimeline"></div>

                <div class="lg-flow-layout">
                    <aside class="lg-flow-side">
                        <h3>ETAPAS DEL EMBARQUE</h3>
                        <div id="flowSide"></div>
                    </aside>

                    <section class="lg-flow-main">
                        <div class="lg-stage" data-stage="programacion">
                            <div class="lg-stage-head">
                                <div><h3>1. Programación</h3><p>Consulta o modifica la fecha y hora mientras la carga física no haya comenzado.</p></div>
                                <span class="lg-stage-badge" id="badgeProgramacion">Pendiente</span>
                            </div>
                            <div class="lg-detail-grid">
                                <div class="lg-detail"><span>Fecha carga</span><strong id="fpFecha">—</strong></div>
                                <div class="lg-detail"><span>Hora carga</span><strong id="fpHora">—</strong></div>
                                <div class="lg-detail"><span>Total piezas</span><strong id="fpPiezas">—</strong></div>
                                <div class="lg-detail"><span>Entrega requerida</span><strong id="fpEntrega">—</strong></div>
                            </div>
                            <div class="lg-flex-note"><strong>Flujo flexible:</strong> puedes volver a Programación, Forma de salida, Disponibilidad PT o Documentación en el orden que necesites. La salida de planta seguirá validando que todo esté completo.</div>
                            <div class="lg-flow-actions">
                                <button class="lg-btn" type="button" id="btnReprogramarFlow"><i class="fa-regular fa-calendar"></i> Reprogramar fecha / hora</button>
                                <button class="lg-btn" type="button" data-next-stage="documentos"><i class="fa-solid fa-file-circle-check"></i> Documentación</button>
                                <button class="lg-btn lg-btn-primary" type="button" data-next-stage="salida">Forma de salida</button>
                            </div>
                        </div>

                        <div class="lg-stage" data-stage="salida">
                            <div class="lg-stage-head">
                                <div><h3>2. Forma de salida</h3><p>Puedes capturarla o modificarla mientras la carga física no haya comenzado.</p></div>
                                <span class="lg-stage-badge" id="badgeSalida">Pendiente</span>
                            </div>
                            <form id="formSalida">
                                <input type="hidden" name="EmbarqueID" id="fsEmbarqueID" />
                                <input type="hidden" name="RowVersion" id="fsRowVersion" />
                                <div class="lg-subsection">
                                    <h4>TIPO DE OPERACIÓN</h4>
                                    <div class="lg-radio-row">
                                        <label class="lg-radio-card"><input type="radio" name="TipoOperacion" value="Nacional" /><strong>Nacional</strong><small>Entrega dentro de México.</small></label>
                                        <label class="lg-radio-card"><input type="radio" name="TipoOperacion" value="Exportacion" /><strong>Exportación</strong><small>Operación de exportación.</small></label>
                                    </div>
                                </div>
                                <div class="lg-subsection" id="bloqueAduana" style="display:none">
                                    <h4>ADUANA</h4>
                                    <input type="hidden" name="PasaAduana" id="fsPasaAduana" value="" />
                                    <div class="lg-helpbox" style="margin:0"><strong>Exportación:</strong> la operación se registra con paso por aduana y no puede utilizar la opción Entrega.</div>
                                </div>
                                <div class="lg-subsection">
                                    <h4>FORMA DE SALIDA</h4>
                                    <div class="lg-radio-row">
                                        <label class="lg-radio-card"><input type="radio" name="FormaEnvio" value="Interno" /><strong><i class="fa-solid fa-truck"></i> Entrega</strong><small>Ruta, unidad y chofer interno.</small></label>
                                        <label class="lg-radio-card"><input type="radio" name="FormaEnvio" value="Cliente" /><strong><i class="fa-solid fa-user-check"></i> Cliente recoge</strong><small>Persona o transportista que recoge.</small></label>
                                        <label class="lg-radio-card"><input type="radio" name="FormaEnvio" value="Paqueteria" /><strong><i class="fa-solid fa-box"></i> Paquetería</strong><small>Compañía y modalidad de envío.</small></label>
                                    </div>
                                </div>
                                <div class="lg-subsection" id="salidaInterna" style="display:none">
                                    <h4>ENTREGA</h4>
                                    <div class="lg-form-grid">
                                        <div class="lg-field"><label>Ruta</label><select class="lg-select" name="RutaID" id="fsRuta"><option value="">Selecciona...</option></select></div>
                                        <div class="lg-field"><label>Unidad</label><select class="lg-select" name="UnidadID" id="fsUnidad"><option value="">Selecciona...</option></select></div>
                                        <div class="lg-field full"><label>Chofer</label><select class="lg-select" name="ChoferUsuarioID" id="fsChofer"><option value="">Selecciona...</option></select></div>
                                    </div>
                                </div>
                                <div class="lg-subsection" id="salidaCliente" style="display:none">
                                    <h4>CLIENTE RECOGE</h4>
                                    <div class="lg-form-grid">
                                        <div class="lg-field full"><label>Persona / transportista que recoge</label><input class="lg-input" name="ChoferExterno" id="fsChoferExterno" maxlength="200" /></div>
                                        <div class="lg-field"><label>Unidad / vehículo</label><input class="lg-input" name="UnidadExterna" id="fsUnidadExterna" maxlength="100" /></div>
                                        <div class="lg-field"><label>Placas</label><input class="lg-input" name="PlacasExternas" id="fsPlacasExternas" maxlength="100" /></div>
                                    </div>
                                </div>
                                <div class="lg-subsection" id="salidaPaqueteria" style="display:none">
                                    <h4>PAQUETERÍA</h4>
                                    <div class="lg-form-grid">
                                        <div class="lg-field">
                                            <label>Modalidad</label>
                                            <select class="lg-select" name="ModalidadEnvio" id="fsModalidad">
                                                <option value="">Selecciona...</option>
                                                <option value="Terrestre">Terrestre</option>
                                                <option value="Aereo">Aéreo</option>
                                                <option value="Maritimo">Marítimo</option>
                                            </select>
                                        </div>
                                        <div class="lg-field"><label>Compañía / paquetería</label><input class="lg-input" name="Transportista" id="fsTransportista" maxlength="200" /></div>
                                        <div class="lg-field full"><label>Guía / referencia</label><input class="lg-input" name="GuiaReferencia" id="fsGuia" maxlength="150" /></div>
                                        <div class="lg-field full"><label>Chofer / persona que recoge <small>(opcional)</small></label><input class="lg-input" id="fsChoferExternoPaq" maxlength="200" /></div>
                                        <div class="lg-field"><label>Unidad externa <small>(opcional)</small></label><input class="lg-input" id="fsUnidadExternaPaq" maxlength="100" /></div>
                                        <div class="lg-field"><label>Placas *</label><input class="lg-input" id="fsPlacasExternasPaq" maxlength="100" placeholder="Obligatorias para paquetería" /></div>
                                    </div>
                                </div>
                                <div class="lg-flex-note"><strong>No necesitas seguir un orden rígido.</strong> Puedes guardar esta información y después ir a Disponibilidad PT o Documentación. Cuando inicie la carga física, los datos de transporte dejan de ser editables desde este flujo.</div>
                                <div class="lg-flow-actions">
                                    <button class="lg-btn" type="button" id="btnGuardarSalir"><i class="fa-regular fa-floppy-disk"></i> Guardar y cerrar</button>
                                    <button class="lg-btn" type="button" data-next-stage="documentos"><i class="fa-solid fa-file-circle-check"></i> Ir a documentación</button>
                                    <button class="lg-btn lg-btn-primary" type="button" id="btnGuardarContinuar"><i class="fa-solid fa-boxes-stacked"></i> Guardar e ir a PT</button>
                                </div>
                            </form>
                        </div>

                        <div class="lg-stage" data-stage="preparacion">
                            <div class="lg-stage-head">
                                <div><h3>3. Disponibilidad PT</h3><p>Compara lo requerido por el embarque contra la existencia utilizable de cada número de parte en Almacén PT.</p></div>
                                <span class="lg-stage-badge" id="badgePreparacion">Pendiente</span>
                            </div>
                            <div class="lg-pt-kpis">
                                <div class="lg-detail"><span>Piezas requeridas</span><strong id="frRequeridas">—</strong></div>
                                <div class="lg-detail"><span>PT disponible aplicable</span><strong id="frDisponibles">—</strong></div>
                                <div class="lg-detail"><span>Faltantes</span><strong id="frFaltantes">—</strong></div>
                                <div class="lg-detail"><span>Cobertura</span><strong id="frCobertura">—</strong></div>
                            </div>
                            <div class="lg-progress"><span id="frBar" style="width:0%"></span></div>
                            <div class="lg-pt-status" id="frEstado">
                                <i class="fa-solid fa-circle-info"></i>
                                <div><strong>Consultando disponibilidad...</strong><span>La disponibilidad se calcula por número de parte, no solo por el total global.</span></div>
                            </div>
                            <div class="lg-inline-panel">
                                <h4>DISPONIBILIDAD POR NÚMERO DE PARTE</h4>
                                <div class="lg-pt-table-wrap">
                                    <table class="lg-pt-table">
                                        <thead><tr><th>Parte</th><th class="num">Requerido</th><th class="num">Libre</th><th class="num">Reservado</th><th class="num">Disponible</th><th class="num">Faltante</th><th>Estado</th></tr></thead>
                                        <tbody id="frPartes"><tr><td colspan="7" style="text-align:center;color:var(--lg-muted);padding:14px">Abre el embarque para consultar PT.</td></tr></tbody>
                                    </table>
                                </div>
                            </div>
                            <div class="lg-flex-note"><strong>Esta etapa es informativa.</strong> No reserva ni descuenta cajas. Puedes avanzar con la documentación aunque todavía falte material. La carga física seguirá validando cada caja realmente escaneada.</div>
                            <div class="lg-flow-actions">
                                <a class="lg-btn" id="btnPreparacionVista" href="#"><i class="fa-solid fa-arrow-up-right-from-square"></i> Vista completa</a>
                                <button class="lg-btn" type="button" data-next-stage="salida"><i class="fa-solid fa-route"></i> Forma de salida</button>
                                <button class="lg-btn" type="button" data-next-stage="documentos"><i class="fa-solid fa-file-circle-check"></i> Documentación</button>
                                <button class="lg-btn lg-btn-primary" type="button" data-next-stage="carga"><i class="fa-solid fa-dolly"></i> Carga física</button>
                            </div>
                        </div>

                        <div class="lg-stage" data-stage="documentos">
                            <div class="lg-stage-head">
                                <div><h3>4. Documentación</h3><p>Adjunta un archivo por requisito y guarda todo en un solo paso. Los documentos se confirman automáticamente al guardarse.</p></div>
                                <span class="lg-stage-badge" id="badgeDocumentos">Pendiente</span>
                            </div>
                            <div class="lg-detail-grid">
                                <div class="lg-detail"><span>Documentos faltantes</span><strong id="fdFaltantes">—</strong></div>
                                <div class="lg-detail"><span>Forma de salida</span><strong id="fdForma">—</strong></div>
                                <div class="lg-detail"><span>Tipo operación</span><strong id="fdTipo">—</strong></div>
                                <div class="lg-detail"><span>Estado</span><strong id="fdEstado">—</strong></div>
                            </div>
                            <div class="lg-flex-note" id="fdContexto"><strong>Expediente documental:</strong> cada requisito tiene su propia fila y acepta un solo archivo. Ya no necesitas escoger primero el tipo ni validar documento por documento. La documentación debe quedar completa antes de confirmar la salida de planta.</div>
                            <div class="lg-inline-panel lg-doc-workspace">
                                <div class="lg-doc-workspace-head">
                                    <div><h4>EXPEDIENTE DOCUMENTAL</h4><p>Adjunta únicamente los archivos que falten. Los documentos ya guardados se conservan y puedes reemplazarlos si es necesario.</p></div>
                                    <span class="lg-doc-counter" id="docContador">—</span>
                                </div>
                                <form id="formDocumentoFlow" enctype="multipart/form-data">
                                    <div id="docRequisitos" class="lg-doc-batch"><div class="lg-disabled-note" style="padding:12px"><i class="fa-solid fa-spinner fa-spin"></i> Abre esta etapa para consultar los requisitos.</div></div>
                                    <div id="docExtrasWrap" class="lg-doc-extras-wrap" style="display:none">
                                        <div class="lg-doc-extras-title">OTROS DOCUMENTOS CARGADOS</div>
                                        <div id="docExtras" class="lg-doc-list"></div>
                                    </div>
                                    <div class="lg-doc-batch-summary">
                                        <div><i class="fa-solid fa-circle-info"></i> Máximo 10 MB por archivo y 100 MB en total. Formatos: PDF, XML, Excel, Word e imágenes.</div>
                                        <strong id="docArchivosResumen">Sin archivos nuevos</strong>
                                    </div>
                                    <div class="lg-flow-actions">
                                        <button class="lg-btn lg-btn-primary" type="submit" id="btnSubirDocumento"><i class="fa-solid fa-cloud-arrow-up"></i> <span>Guardar documentación</span></button>
                                        <button class="lg-btn" type="button" data-next-stage="carga"><i class="fa-solid fa-dolly"></i> Ir a carga física</button>
                                    </div>
                                </form>
                            </div>
                        </div>

                        <div class="lg-stage" data-stage="carga">
                            <div class="lg-stage-head">
                                <div><h3>5. Carga física</h3><p>Escanea cada caja cuando realmente sea cargada. Puedes hacerlo aunque la documentación todavía esté en proceso.</p></div>
                                <span class="lg-stage-badge" id="badgeCarga">Pendiente</span>
                            </div>
                            <div class="lg-detail-grid">
                                <div class="lg-detail"><span>Cajas asignadas</span><strong id="fcCajas">—</strong></div>
                                <div class="lg-detail"><span>Cajas cargadas</span><strong id="fcCargadas">—</strong></div>
                                <div class="lg-detail"><span>Piezas pendientes</span><strong id="fcPendientes">—</strong></div>
                                <div class="lg-detail"><span>Estatus</span><strong id="fcEstatus">—</strong></div>
                            </div>
                            <div class="lg-progress"><span id="fcBar" style="width:0%"></span></div>
                            <div class="lg-load-stats">
                                <div class="lg-detail"><span>Total piezas</span><strong id="fcTotalPiezas">—</strong></div>
                                <div class="lg-detail"><span>Piezas cargadas</span><strong id="fcPiezasCargadas">—</strong></div>
                                <div class="lg-detail"><span>Piezas reservadas</span><strong id="fcPiezasReservadas">—</strong></div>
                                <div class="lg-detail"><span>Avance carga</span><strong id="fcAvance">—</strong></div>
                            </div>
                            <div class="lg-stage-lock" id="fcDocumentacionAviso"><strong>Documentación:</strong> se comprobará antes de la salida de planta.</div>
                            <div class="lg-scan-box">
                                <form id="formEscanearCajaFlow">
                                    <div class="lg-scan-row">
                                        <div class="lg-field">
                                            <label>Escanear etiqueta de caja</label>
                                            <input class="lg-scan-input" id="fcCodigo" name="codigo" autocomplete="off" maxlength="500" placeholder="Escanea o captura la etiqueta y presiona Enter" />
                                        </div>
                                        <button class="lg-btn lg-btn-primary" style="height:42px" type="submit" id="btnEscanearCaja"><i class="fa-solid fa-barcode"></i> Registrar caja</button>
                                    </div>
                                    <div class="lg-scan-help"><i class="fa-solid fa-circle-info"></i> El lector puede enviar Enter automáticamente. La caja se valida contra PT, cliente, pieza, calidad y disponibilidad. El primer escaneo inicia físicamente la carga.</div>
                                </form>
                            </div>
                            <div class="lg-inline-panel">
                                <h4>CAJAS DEL EMBARQUE</h4>
                                <div id="fcListaCajas" class="lg-load-list"><div class="lg-disabled-note" style="padding:12px">Abre esta etapa para consultar las cajas.</div></div>
                            </div>
                            <div class="lg-flow-actions">
                                <a class="lg-btn" id="btnCargaVista" href="#"><i class="fa-solid fa-arrow-up-right-from-square"></i> Vista completa</a>
                                <button class="lg-btn" type="button" data-next-stage="documentos"><i class="fa-solid fa-file-circle-check"></i> Documentación</button>
                                <button class="lg-btn lg-btn-success" type="button" id="btnConfirmarCargaFisica" disabled><i class="fa-solid fa-circle-check"></i> Confirmar carga física</button>
                                <button class="lg-btn" type="button" data-next-stage="salidaPlanta">Ver salida de planta</button>
                            </div>
                        </div>

                        <div class="lg-stage" data-stage="salidaPlanta">
                            <div class="lg-stage-head">
                                <div><h3>6. Salida de planta</h3><p>Este es el candado operativo: aquí sí se valida que programación, transporte, PT, documentación, carga e incidencias estén correctos.</p></div>
                                <span class="lg-stage-badge" id="badgeSalidaPlanta">Pendiente</span>
                            </div>
                            <div class="lg-detail-grid">
                                <div class="lg-detail"><span>Incidencias abiertas</span><strong id="fspInc">—</strong></div>
                                <div class="lg-detail"><span>Críticas</span><strong id="fspCrit">—</strong></div>
                                <div class="lg-detail"><span>Piezas despachadas</span><strong id="fspDesp">—</strong></div>
                                <div class="lg-detail"><span>Viaje</span><strong id="fspViaje">—</strong></div>
                            </div>
                            <div class="lg-gates">
                                <div class="lg-gate"><div class="label"><strong>Programación</strong><small>Fecha, hora y piezas definidas</small></div><span class="lg-gate-state" id="gateProgramacion">Pendiente</span></div>
                                <div class="lg-gate"><div class="label"><strong>Forma de salida</strong><small>Transporte y recursos completos</small></div><span class="lg-gate-state" id="gateSalida">Pendiente</span></div>
                                <div class="lg-gate"><div class="label"><strong>Disponibilidad PT</strong><small>Cobertura por número de parte</small></div><span class="lg-gate-state" id="gatePt">Pendiente</span></div>
                                <div class="lg-gate"><div class="label"><strong>Documentación</strong><small>Obligatorios cargados y validados</small></div><span class="lg-gate-state" id="gateDocumentos">Pendiente</span></div>
                                <div class="lg-gate"><div class="label"><strong>Carga física</strong><small>Todas las cajas físicamente cargadas</small></div><span class="lg-gate-state" id="gateCarga">Pendiente</span></div>
                                <div class="lg-gate"><div class="label"><strong>Incidencias críticas</strong><small>Deben estar en cero para salir</small></div><span class="lg-gate-state" id="gateIncidencias">Pendiente</span></div>
                            </div>
                            <div class="lg-helpbox" id="salidaPlantaAyuda" style="margin-top:8px"><strong>Salida:</strong> esperando información del embarque.</div>
                            <div class="lg-flow-actions">
                                <a class="lg-btn" id="btnSalidaVista" href="#"><i class="fa-solid fa-arrow-up-right-from-square"></i> Abrir operación</a>
                                <button class="lg-btn" type="button" data-next-stage="documentos"><i class="fa-solid fa-file-circle-check"></i> Revisar documentación</button>
                                <button class="lg-btn lg-btn-success" type="button" id="btnConfirmarSalidaPlanta" style="display:none"><i class="fa-solid fa-truck-fast"></i> Confirmar salida de planta</button>
                            </div>
                        </div>

                        <div class="lg-stage" data-stage="entrega">
                            <div class="lg-stage-head">
                                <div><h3>7. Entrega</h3><p>Cierre del embarque con receptor y una o más evidencias.</p></div>
                                <span class="lg-stage-badge" id="badgeEntrega">Pendiente</span>
                            </div>
                            <div class="lg-helpbox" id="entregaAyuda"><strong>Entrega:</strong> cuando el embarque esté En ruta podrás registrar al receptor y adjuntar evidencias.</div>
                            <div class="lg-subsection">
                                <h4>EVIDENCIAS COMPARTIDAS</h4>
                                <div id="flowEvidencias" class="lg-evidence-list"></div>
                            </div>
                            <div class="lg-flow-actions"><button class="lg-btn lg-btn-success" type="button" id="btnEntregaFlow" style="display:none"><i class="fa-solid fa-circle-check"></i> Confirmar entrega</button></div>
                        </div>
                    </section>
                </div>
            </div>
        </div>
        <div class="lg-modal-foot">
            <button class="lg-btn" type="button" data-close="modalFlujo">Cerrar</button>
            <a class="lg-btn" id="btnVistaCompletaFlow" href="#"><i class="fa-solid fa-arrow-up-right-from-square"></i> Vista completa</a>
        </div>
    </div>
</div>


<div class="lg-modal-backdrop" id="modalViaje">
    <div class="lg-modal lg-modal-sm">
        <div class="lg-modal-head">
            <div><h2 id="viajeTitulo">Viaje</h2><p id="viajeSub">Resumen operativo de la unidad</p></div>
            <button class="lg-close" type="button" data-close="modalViaje">✕</button>
        </div>
        <div class="lg-modal-body">
            <div class="lg-trip-modal-summary">
                <div class="lg-detail"><span>Unidad</span><strong id="vUnidad">—</strong></div>
                <div class="lg-detail"><span>Estatus</span><strong id="vEstatus">—</strong></div>
                <div class="lg-detail"><span>Chofer</span><strong id="vChofer">—</strong></div>
                <div class="lg-detail"><span>Cliente / destino</span><strong id="vCliente">—</strong></div>
                <div class="lg-detail"><span>Salida</span><strong id="vSalida">—</strong></div>
                <div class="lg-detail"><span>Regreso</span><strong id="vRegreso">—</strong></div>
                <div class="lg-detail"><span>KM inicial</span><strong id="vKmIni">—</strong></div>
                <div class="lg-detail"><span>KM final</span><strong id="vKmFin">—</strong></div>
                <div class="lg-detail"><span>KM recorridos</span><strong id="vKmRec">—</strong></div>
                <div class="lg-detail"><span>Embarques</span><strong id="vEmbarques">—</strong></div>
                <div class="lg-detail"><span>Piezas</span><strong id="vPiezas">—</strong></div>
                <div class="lg-detail"><span>Incidencias</span><strong id="vIncidencias">—</strong></div>
            </div>
            <div class="lg-subsection">
                <h4>RECORRIDO</h4>
                <div class="lg-detail-grid">
                    <div class="lg-detail"><span>Ruta</span><strong id="vRuta">—</strong></div>
                    <div class="lg-detail"><span>Origen</span><strong id="vOrigen">—</strong></div>
                    <div class="lg-detail"><span>Destino</span><strong id="vDestino">—</strong></div>
                    <div class="lg-detail"><span>Placas</span><strong id="vPlacas">—</strong></div>
                </div>
            </div>
            <div class="lg-subsection">
                <h4>EVIDENCIAS DEL VIAJE</h4>
                <div class="lg-detail-grid">
                    <div class="lg-detail"><span>Salida</span><strong id="vEvSalida">0</strong></div>
                    <div class="lg-detail"><span>Trayecto</span><strong id="vEvTrayecto">0</strong></div>
                    <div class="lg-detail"><span>Regreso</span><strong id="vEvRegreso">0</strong></div>
                    <div class="lg-detail"><span>Incidencia</span><strong id="vEvIncidencia">0</strong></div>
                </div>
            </div>
            <div class="lg-helpbox"><strong>Siguiente integración:</strong> desde este mismo modal agregaremos inicio de viaje con KM inicial y fotos, evidencias durante el trayecto y regreso con KM final y fotos.</div>
        </div>
        <div class="lg-modal-foot"><button class="lg-btn" type="button" data-close="modalViaje">Cerrar</button></div>
    </div>
</div>

<div class="lg-modal-backdrop" id="modalCerrar">
    <div class="lg-modal lg-modal-sm">
        <div class="lg-modal-head">
            <div><h2>Confirmar entrega</h2><p>Registra al receptor y adjunta una o más evidencias de entrega.</p></div>
            <button class="lg-close" type="button" data-close="modalCerrar">✕</button>
        </div>
        <form id="formCerrar" enctype="multipart/form-data">
            <div class="lg-modal-body">
                <input type="hidden" name="EmbarqueID" id="cEmbarqueID" />
                <input type="hidden" name="RowVersion" id="cRowVersion" />
                <div class="lg-form-grid">
                    <div class="lg-field"><label>Receptor *</label><input class="lg-input" name="ReceptorNombre" required maxlength="200" /></div>
                    <div class="lg-field"><label>Fecha entrega *</label><input class="lg-input" type="datetime-local" name="FechaEntrega" id="cFecha" required /></div>
                    <div class="lg-field"><label>Remisión</label><input class="lg-input" name="FolioRemision" maxlength="100" /></div>
                    <div class="lg-field"><label>Observación evidencias</label><input class="lg-input" name="ObservacionesEvidencia" maxlength="500" /></div>
                    <div class="lg-field full"><label>Observaciones</label><textarea class="lg-input" style="height:65px;padding-top:7px" name="Observaciones" maxlength="1200"></textarea></div>
                    <div class="lg-field full">
                        <label>Evidencias *</label>
                        <label class="lg-file lg-file-picker" for="cEvidencias">
                            <span><strong><i class="fa-solid fa-camera"></i> Agregar evidencia</strong><small>Fotos o PDF · hasta 15 archivos · máximo 10 MB por archivo</small></span>
                            <input type="file" id="cEvidencias" name="Evidencias" accept="image/*,.pdf" multiple />
                        </label>
                        <div class="lg-file-list" id="cEvidenciasLista"></div>
                        <div class="lg-file-summary" id="cEvidenciasResumen">0 evidencias seleccionadas</div>
                    </div>
                </div>
            </div>
            <div class="lg-modal-foot"><button class="lg-btn" type="button" data-close="modalCerrar">Cancelar</button><button class="lg-btn lg-btn-success" type="submit" id="btnConfirmarEntrega"><i class="fa-solid fa-circle-check"></i> Confirmar entrega</button></div>
        </form>
    </div>
</div>

<div class="lg-toast-wrap" id="toastWrap"></div>

<script>
        (() => {
            const token=document.querySelector('input[name="__RequestVerificationToken"]')?.value||'';
            const puedeProgramar=@puedeProgramar.ToString().ToLowerInvariant();
            const puedeOperar=@puedeOperar.ToString().ToLowerInvariant();
            const esAdministradorERP=@esAdministradorERP.ToString().ToLowerInvariant();
            const urlProgramar='@Url.Action("ProgramarRelease", "LogisticaOperacion")';
            const urlProgramarSeleccionados='@Url.Action("ProgramarReleasesSeleccionados", "LogisticaOperacion")';
            const urlMoverProg='@Url.Action("MoverProgramacion", "LogisticaOperacion")';
            const urlMoverEmb='@Url.Action("ReprogramarDragDrop", "LogisticaOperacion")';
            const urlFlujo='@Url.Action("ObtenerFlujo", "LogisticaOperacion")';
            const urlGuardarSalida='@Url.Action("GuardarBorradorSalida", "LogisticaOperacion")';
            const urlConfirmarSalida='@Url.Action("ConfirmarSalidaConfigurada", "LogisticaOperacion")';
            const urlObtenerDocumentos='@Url.Action("ObtenerDocumentosModal", "LogisticaEmbarques")';
            const urlSubirDocumento='@Url.Action("SubirDocumento", "LogisticaEmbarques")';
            const urlValidarDocumento='@Url.Action("ValidarDocumento", "LogisticaEmbarques")';
            const urlRetirarDocumento='@Url.Action("RetirarDocumento", "LogisticaEmbarques")';
            const urlObtenerCargaFisica='@Url.Action("ObtenerCargaFisica", "LogisticaOperacion")';
            const urlEscanearCajaCarga='@Url.Action("EscanearCajaCarga", "LogisticaOperacion")';
            const urlConfirmarCargaFisica='@Url.Action("ConfirmarCargaFisica", "LogisticaOperacion")';
            const urlConfirmarSalidaPlanta='@Url.Action("ConfirmarSalidaPlanta", "LogisticaOperacion")';
            const urlCerrar='@Url.Action("CerrarConEvidencia", "LogisticaOperacion")';
            const urlProgramacionesEmbarque='@Url.Action("ObtenerProgramacionesParaEmbarque", "LogisticaOperacion")';
            const urlCrearEmbarque='@Url.Action("CrearEmbarqueDesdeProgramaciones", "LogisticaOperacion")';
            const urlDetalleEmb='@Url.Action("Detalle", "LogisticaEmbarques")';
            const urlVerEvidenciaEmbarque='@Url.Action("VerEvidencia", "LogisticaEmbarques")';
            const urlVerEvidenciaViaje='@Url.Action("VerEvidencia", "LogisticaViajes")';
            const horaInicio=0;
            const horaFin=1440;
            let dragCard=null,flujoActual=null,documentosActual=null,cargaFisicaActual=null;
            let documentosFilaSeleccionados=new Map();

            document.querySelectorAll('.lg-modal-backdrop').forEach(modal=>{
                if(modal.parentElement!==document.body)document.body.appendChild(modal);
            });

            function toast(msg,tipo='ok'){const w=document.getElementById('toastWrap');const n=document.createElement('div');n.className=`lg-toast ${tipo}`;n.textContent=msg;w.appendChild(n);setTimeout(()=>n.remove(),4200)}
            function openModal(id){document.getElementById(id)?.classList.add('show');document.body.style.overflow='hidden'}
            function closeModal(id){document.getElementById(id)?.classList.remove('show');if(!document.querySelector('.lg-modal-backdrop.show'))document.body.style.overflow=''}
            document.querySelectorAll('[data-close]').forEach(b=>b.addEventListener('click',()=>closeModal(b.dataset.close)));
            document.querySelectorAll('.lg-modal-backdrop').forEach(m=>m.addEventListener('mousedown',e=>{if(e.target===m)closeModal(m.id)}));
            function minutesFromDrop(cell,x){const r=cell.getBoundingClientRect();const pos=Math.max(0,Math.min(r.width,x-r.left));let min=horaInicio+(pos/Math.max(1,r.width))*(horaFin-horaInicio);min=Math.round(min/5)*5;return Math.max(horaInicio,Math.min(horaFin-5,min))}
            function horaDesdeMinutos(min){const h=Math.floor(min/60);const m=min%60;return `${String(h).padStart(2,'0')}:${String(m).padStart(2,'0')}`}
            function limpiarIndicadorDrop(){document.querySelectorAll('.lg-drop-time-indicator').forEach(x=>x.remove())}
            function mostrarIndicadorDrop(cell,e){limpiarIndicadorDrop();const minutos=minutesFromDrop(cell,e.clientX);const r=cell.getBoundingClientRect();const pct=Math.max(0,Math.min(100,((minutos-horaInicio)/(horaFin-horaInicio))*100));const d=document.createElement('div');d.className='lg-drop-time-indicator';d.style.left=`${pct}%`;d.innerHTML=`<span>${horaDesdeMinutos(minutos)}</span>`;cell.appendChild(d);return minutos}
            function hhmm(min){return `${String(Math.floor(min/60)).padStart(2,'0')}:${String(min%60).padStart(2,'0')}`}
            function esc(v){return String(v??'').replaceAll('&','&amp;').replaceAll('<','&lt;').replaceAll('>','&gt;').replaceAll('"','&quot;').replaceAll("'","&#039;")}
            function number(v){return Number(v||0).toLocaleString('es-MX')}
            function formaTexto(v){if(v==='Interno')return'Entrega';if(v==='Cliente')return'Cliente recoge';if(v==='Paqueteria')return'Paquetería';return'Por definir'}
            function tipoTexto(v){return v==='Exportacion'?'Exportación':v==='Nacional'?'Nacional':'Por definir'}


            let dayCellActual=null;

            function dayEvents(cell){
                return [...cell.querySelectorAll('.lg-day-event-data')].map(x=>({...x.dataset}));
            }

            function setDayTab(tab){
                if(tab==='requerimientos'&&!puedeProgramar)tab=puedeOperar?'programaciones':'requerimientos';
                if((tab==='programaciones'||tab==='embarques')&&!puedeOperar)tab=puedeProgramar?'requerimientos':'programaciones';
                document.querySelectorAll('.lg-day-tab').forEach(x=>x.classList.toggle('active',x.dataset.dayTab===tab));
                document.querySelectorAll('.lg-day-list').forEach(x=>x.classList.toggle('active',x.dataset.dayList===tab));
                const bulk=document.getElementById('bulkProgramBar');
                if(bulk)bulk.style.display=puedeProgramar&&tab==='requerimientos'?'grid':'none';
            }

            function renderClienteDia(cell,tab='requerimientos'){
                dayCellActual=cell;
                const events=dayEvents(cell);
                const req=puedeProgramar?events.filter(x=>x.tipo==='requerimiento'):[];
                const prog=puedeOperar?events.filter(x=>x.tipo==='programacion'):[];
                const emb=puedeOperar?events.filter(x=>x.tipo==='embarque'):[];
                const cliente=req[0]?.cliente||prog[0]?.cliente||emb[0]?.cliente||`Cliente ${cell.dataset.clienteId}`;
                const fecha=cell.dataset.fecha||'';
                document.getElementById('dayTitulo').textContent=cliente;
                document.getElementById('daySub').textContent=esAdministradorERP?`Operación del ${fecha} · Planeación y Logística en una sola vista.`:puedeProgramar&&!puedeOperar?`Planeación del ${fecha} · programa únicamente los Releases pendientes.`:`Operación logística del ${fecha} · toma lo ya programado y continúa con el embarque.`;
                document.getElementById('bulkFecha').value=fecha;
                document.getElementById('cntReq').textContent=req.length;
                document.getElementById('cntProg').textContent=prog.length;
                document.getElementById('cntEmb').textContent=emb.length;
                document.getElementById('selectedReq').textContent='0';
                const checkAllReq=document.getElementById('checkAllReq');if(checkAllReq)checkAllReq.checked=false;

                const rb=document.getElementById('dayReqBody');rb.innerHTML='';
                if(!req.length)rb.innerHTML='<tr><td colspan="6" style="color:var(--lg-muted)">No hay Releases pendientes para este día.</td></tr>';
                req.forEach(x=>{
                    const tr=document.createElement('tr');
                    tr.innerHTML=`<td><input type="checkbox" class="req-check" data-release-id="${esc(x.releaseId)}" data-cliente-id="${esc(x.clienteId)}" data-parte-id="${esc(x.parteId)}" data-cantidad="${esc(x.cantidad)}"></td>
                    <td><div class="lg-row-title">${esc(x.folioRelease||x.folio)}</div><div class="lg-row-sub">${esc(x.numeroParte||'Sin parte')} ${x.descripcion?`· ${esc(x.descripcion)}`:''}</div></td>
                    <td>${esc(x.fechaRequerida||'—')}</td>
                    <td><strong>${number(x.cantidad)} PZA</strong></td>
                    <td>${x.expeditado==='true'?`<span class="lg-mini-status red">${esc(x.atraso||'EXPEDITADO')}</span>`:'<span class="lg-mini-status">Requerido</span>'}</td>
                    <td><button type="button" class="lg-btn btn-program-one" data-release-id="${esc(x.releaseId)}" data-cliente-id="${esc(x.clienteId)}" data-parte-id="${esc(x.parteId)}" data-cantidad="${esc(x.cantidad)}" data-folio="${esc(x.folioRelease||x.folio)}">Programar</button></td>`;
                    rb.appendChild(tr);
                });

                const pb=document.getElementById('dayProgBody');pb.innerHTML='';
                if(!prog.length)pb.innerHTML='<tr><td colspan="6" style="color:var(--lg-muted)">No hay Releases programados pendientes de iniciar embarque.</td></tr>';
                prog.forEach(x=>{
                    const tr=document.createElement('tr');
                    tr.innerHTML=`<td><div class="lg-row-title">${esc(x.folio||`PROG-${x.programacionId}`)}</div></td>
                    <td><div class="lg-row-title">${esc(x.folioRelease||'—')}</div><div class="lg-row-sub">${esc(x.numeroParte||'Sin parte')}</div></td>
                    <td>${esc(x.fechaProgramada||'—')}</td>
                    <td><strong>${number(x.cantidad)} PZA</strong></td>
                    <td><span class="lg-mini-status amber">Listo para embarque</span></td>
                    <td><button type="button" class="lg-btn lg-btn-primary btn-start-shipment" data-cliente-id="${esc(x.clienteId)}" data-fecha="${esc(x.fechaProgramada||fecha)}"><i class="fa-solid fa-truck-fast"></i> Iniciar embarque</button></td>`;
                    pb.appendChild(tr);
                });

                const eb=document.getElementById('dayEmbBody');eb.innerHTML='';
                if(!emb.length)eb.innerHTML='<tr><td colspan="6" style="color:var(--lg-muted)">No hay embarques para este día.</td></tr>';
                emb.forEach(x=>{
                    const tr=document.createElement('tr');
                    tr.innerHTML=`<td><div class="lg-row-title">${esc(x.folio||`Embarque ${x.embarqueId}`)}</div></td>
                    <td><div class="lg-row-title">${esc(x.numeroParte||'—')}</div><div class="lg-row-sub">${esc(x.cliente||'')}</div></td>
                    <td>${esc(x.fechaProgramada||'—')} ${esc(x.hora||'')}</td>
                    <td><strong>${number(x.cantidad)} PZA</strong></td>
                    <td><span class="lg-mini-status blue">${esc(x.estatus||'')}</span></td>
                    <td><div style="display:flex;gap:4px;flex-wrap:wrap"><button type="button" class="lg-btn btn-open-flow" data-embarque-id="${esc(x.embarqueId)}">Abrir flujo</button>${!x.hora?`<button type="button" class="lg-btn btn-set-hour" data-tipo="embarque" data-id="${esc(x.embarqueId)}" data-fecha="${esc(x.fechaProgramada||'')}" data-hora="" data-row-version="${esc(x.rowVersion||'')}">Asignar hora</button>`:''}</div></td>`;
                    eb.appendChild(tr);
                });

                rb.querySelectorAll('.req-check').forEach(x=>x.addEventListener('change',actualizarSeleccionReq));
                rb.querySelectorAll('.btn-program-one').forEach(b=>b.addEventListener('click',()=>{
                    closeModal('modalClienteDia');
                    document.getElementById('pReleaseID').value=b.dataset.releaseId||'';
                    document.getElementById('pClienteID').value=b.dataset.clienteId||'';
                    document.getElementById('pParteID').value=b.dataset.parteId||'';
                    document.getElementById('pCantidad').value=b.dataset.cantidad||'';
                    document.getElementById('pFecha').value=fecha;
                    document.getElementById('progSub').textContent=`${b.dataset.folio||'Release'} · ${number(b.dataset.cantidad)} PZA`;
                    openModal('modalProgramar');
                }));
                eb.querySelectorAll('.btn-open-flow').forEach(b=>b.addEventListener('click',()=>{closeModal('modalClienteDia');openFlujo(b.dataset.embarqueId)}));
                eb.querySelectorAll('.btn-set-hour').forEach(b=>b.addEventListener('click',()=>{
                    document.getElementById('ahTipo').value='embarque';
                    document.getElementById('ahID').value=b.dataset.id||'';
                    document.getElementById('ahFecha').value=b.dataset.fecha||fecha;
                    document.getElementById('ahHora').value=b.dataset.hora||'';
                    document.getElementById('ahRowVersion').value=b.dataset.rowVersion||'';
                    document.getElementById('ahObs').value='';
                    document.getElementById('horaTitulo').textContent=b.dataset.hora?'Cambiar fecha/hora del embarque':'Asignar hora al embarque';
                    closeModal('modalClienteDia');
                    openModal('modalAsignarHora');
                }));
                const tabInicial=puedeProgramar&&!puedeOperar?'requerimientos':!puedeProgramar&&puedeOperar?(prog.length?'programaciones':'embarques'):tab;
                setDayTab(tabInicial);
                openModal('modalClienteDia');
            }

            function actualizarSeleccionReq(){
                const n=document.querySelectorAll('#dayReqBody .req-check:checked').length;
                document.getElementById('selectedReq').textContent=n;
                const all=document.querySelectorAll('#dayReqBody .req-check').length;
                document.getElementById('checkAllReq').checked=all>0&&n===all;
            }
            document.addEventListener('click',e=>{
                const startShipment=e.target.closest('[data-start-shipment]');
                if(startShipment){
                    e.preventDefault();
                    e.stopPropagation();
                    if(!puedeOperar){toast('Esta acción corresponde a Logística.','error');return}
                    abrirIniciarEmbarque(Number(startShipment.dataset.clienteId||0),startShipment.dataset.fecha||'');
                    return;
                }
                const btn=e.target.closest('[data-open-day]');
                if(!btn)return;
                const cell=btn.closest('.lg-client-day');
                if(cell)renderClienteDia(cell,btn.dataset.openDay||'requerimientos');
            });
    document.querySelectorAll('.lg-day-tab').forEach(btn=>btn.addEventListener('click',()=>setDayTab(btn.dataset.dayTab)));
            document.getElementById('checkAllReq')?.addEventListener('change',e=>{
                document.querySelectorAll('#dayReqBody .req-check').forEach(x=>x.checked=e.target.checked);
                actualizarSeleccionReq();
            });

            document.getElementById('btnProgramarSeleccionados')?.addEventListener('click',async()=>{
                if(!puedeProgramar){toast('La programación de Releases corresponde a Planeación.','error');return}
                const seleccion=[...document.querySelectorAll('#dayReqBody .req-check:checked')];
                if(!seleccion.length){toast('Selecciona al menos un Release.','error');return}
                const fecha=document.getElementById('bulkFecha').value;
                if(!fecha){toast('Selecciona la fecha de carga.','error');return}
                const ids=[...new Set(seleccion.map(x=>Number(x.dataset.releaseId||0)).filter(x=>x>0))];
                if(!ids.length){toast('No fue posible identificar los Releases seleccionados.','error');return}
                const btn=document.getElementById('btnProgramarSeleccionados');
                const textoOriginal=btn.innerHTML;
                try{
                    btn.disabled=true;
                    btn.innerHTML='<i class="fa-solid fa-spinner fa-spin"></i> Programando...';
                    const fd=new FormData();
                    fd.append('__RequestVerificationToken',token);
                    ids.forEach(id=>fd.append('releaseDetalleIds',String(id)));
                    fd.append('fechaProgramadaCarga',fecha);
                    const r=await fetch(urlProgramarSeleccionados,{method:'POST',body:fd,headers:{'X-Requested-With':'XMLHttpRequest'}});
                    let j;
                    try{j=await r.json()}catch{throw new Error(`El servidor respondió ${r.status} y no devolvió JSON.`)}
                    if(!r.ok||!j.ok)throw new Error(j.mensaje||'No fue posible programar los Releases seleccionados.');
                    closeModal('modalClienteDia');
                    toast(j.mensaje||`${ids.length} Release(s) programado(s) correctamente.`);
                    setTimeout(()=>location.reload(),650);
                }catch(err){
                    toast(err.message||'Error al programar los Releases seleccionados.','error');
                }finally{
                    btn.disabled=false;
                    btn.innerHTML=textoOriginal;
                }
            });



            async function abrirIniciarEmbarque(clienteId,fecha){
                if(!puedeOperar){toast('Esta acción corresponde a Logística.','error');return}
                if(!clienteId||!fecha){toast('No fue posible identificar el cliente o el día planeado.','error');return}
                const body=document.getElementById('ieBody');
                body.innerHTML='<tr><td colspan="5" style="text-align:center;color:var(--lg-muted);padding:18px"><i class="fa-solid fa-spinner fa-spin"></i> Cargando programaciones...</td></tr>';
                document.getElementById('ieClienteID').value=clienteId;
                document.getElementById('ieFecha').value=fecha;
                document.getElementById('ieCliente').value='';
                document.getElementById('ieFechaTexto').value=fecha;
                document.getElementById('ieHora').value='';
                document.getElementById('ieObservaciones').value='';
                document.getElementById('ieSeleccionados').value='0';
                openModal('modalIniciarEmbarque');
                try{
                    const r=await fetch(`${urlProgramacionesEmbarque}?clienteId=${encodeURIComponent(clienteId)}&fecha=${encodeURIComponent(fecha)}`,{headers:{'X-Requested-With':'XMLHttpRequest'}});
                    let j;try{j=await r.json()}catch{throw new Error(`El servidor respondió ${r.status} y no devolvió JSON.`)}
                    if(!r.ok||!j.ok)throw new Error(j.mensaje||'No fue posible cargar las programaciones listas para embarque.');
                    document.getElementById('ieCliente').value=j.cliente||`Cliente ${clienteId}`;
                    document.getElementById('ieFechaTexto').value=j.fechaTexto||fecha;
                    body.innerHTML='';
                    (j.programaciones||[]).forEach(x=>{
                        const tr=document.createElement('tr');
                        tr.innerHTML=`<td><input type="checkbox" class="ie-check" name="ProgramacionIDs" value="${esc(x.listaCargaProgramacionID)}" checked></td>
                        <td><div class="lg-row-title">${esc(x.folioRelease||`PROG-${x.listaCargaProgramacionID}`)}</div><div class="lg-row-sub">${esc(x.numeroParte||'Sin parte')}${x.descripcion?` · ${esc(x.descripcion)}`:''}${x.numeroOF?` · OF ${esc(x.numeroOF)}`:''}</div></td>
                        <td>${esc(x.fechaRequeridaTexto||x.fechaRequerida||'—')}</td>
                        <td><strong>${number(x.cantidadPendiente)} PZA</strong></td>
                        <td>${x.esExpeditado?'<span class="lg-mini-status red">Expeditado</span>':'<span class="lg-mini-status blue">Planeado</span>'}</td>`;
                        body.appendChild(tr);
                    });
                    if(!(j.programaciones||[]).length)body.innerHTML='<tr><td colspan="5" style="color:var(--lg-muted);padding:14px">No hay programaciones pendientes para iniciar embarque.</td></tr>';
                    document.getElementById('ieCheckAll').checked=(j.programaciones||[]).length>0;
                    actualizarSeleccionEmbarque();
                }catch(err){body.innerHTML=`<tr><td colspan="5" style="color:var(--lg-red);padding:14px">${esc(err.message||'Error')}</td></tr>`;toast(err.message||'Error al cargar las programaciones.','error')}
            }

            function actualizarSeleccionEmbarque(){
                const checks=[...document.querySelectorAll('#ieBody .ie-check')];
                const seleccionados=checks.filter(x=>x.checked);
                document.getElementById('ieSeleccionados').value=String(seleccionados.length);
                const all=document.getElementById('ieCheckAll');
                if(all){all.checked=checks.length>0&&seleccionados.length===checks.length;all.indeterminate=seleccionados.length>0&&seleccionados.length<checks.length}
            }

            document.getElementById('ieBody')?.addEventListener('change',e=>{if(e.target.classList.contains('ie-check'))actualizarSeleccionEmbarque()});
            document.getElementById('ieCheckAll')?.addEventListener('change',e=>{document.querySelectorAll('#ieBody .ie-check').forEach(x=>x.checked=e.target.checked);actualizarSeleccionEmbarque()});
            document.addEventListener('click',e=>{
                const btn=e.target.closest('[data-start-shipment],.btn-start-shipment');
                if(!btn)return;
                e.preventDefault();e.stopPropagation();
                const clienteId=btn.dataset.clienteId||btn.closest('.lg-client-day')?.dataset.clienteId;
                const fecha=btn.dataset.fecha||btn.closest('.lg-client-day')?.dataset.fecha;
                if(document.getElementById('modalClienteDia')?.classList.contains('show'))closeModal('modalClienteDia');
                abrirIniciarEmbarque(clienteId,fecha);
            });

            document.getElementById('formIniciarEmbarque')?.addEventListener('submit',async e=>{
                e.preventDefault();
                if(!puedeOperar){toast('Esta acción corresponde a Logística.','error');return}
                const ids=[...document.querySelectorAll('#ieBody .ie-check:checked')].map(x=>x.value).filter(Boolean);
                const hora=document.getElementById('ieHora').value;
                if(!ids.length){toast('Selecciona al menos un Release planeado.','error');return}
                if(!hora){toast('Captura la hora de carga para iniciar el embarque.','error');return}
                const fd=new FormData();
                fd.append('__RequestVerificationToken',token);
                fd.append('ClienteID',document.getElementById('ieClienteID').value);
                fd.append('FechaProgramada',document.getElementById('ieFecha').value);
                fd.append('HoraProgramada',hora);
                fd.append('Observaciones',document.getElementById('ieObservaciones').value||'');
                ids.forEach(id=>fd.append('ProgramacionIDs',id));
                const btn=document.getElementById('btnCrearEmbarque');const original=btn.innerHTML;
                try{
                    btn.disabled=true;btn.innerHTML='<i class="fa-solid fa-spinner fa-spin"></i> Creando...';
                    const r=await fetch(urlCrearEmbarque,{method:'POST',body:fd,headers:{'X-Requested-With':'XMLHttpRequest'}});
                    let j;try{j=await r.json()}catch{throw new Error(`El servidor respondió ${r.status} y no devolvió JSON.`)}
                    if(!r.ok||!j.ok)throw new Error(j.mensaje||'No fue posible crear el embarque.');
                    closeModal('modalIniciarEmbarque');
                    toast(j.mensaje||'Embarque creado correctamente. Ya aparece en el calendario; ábrelo cuando Logística quiera continuar.');
                    setTimeout(()=>location.reload(),650);
                }catch(err){toast(err.message||'Error al crear el embarque.','error')}
                finally{btn.disabled=false;btn.innerHTML=original}
            });

            let shipmentPress=null;
            let shipmentWasDragged=false;

            document.querySelectorAll('.lg-summary-btn.prog[draggable="true"]').forEach(card=>{
                card.addEventListener('dragstart',e=>{
                    dragCard=card;
                    card.classList.add('dragging');
                    e.dataTransfer.effectAllowed='move';
                    e.dataTransfer.setData('text/plain','programacion-grupo');
                });
                card.addEventListener('dragend',()=>{
                    card.classList.remove('dragging');
                    document.querySelectorAll('.lg-client-day.drag-over').forEach(x=>x.classList.remove('drag-over'));
                    limpiarIndicadorDrop();
                    setTimeout(()=>{dragCard=null},0);
                });
            });

            document.querySelectorAll('.lg-timed-event.emb[data-open-flow]').forEach(card=>{
                card.addEventListener('pointerdown',e=>{
                    if(e.button!==0)return;
                    shipmentWasDragged=false;
                    shipmentPress={card,x:e.clientX,y:e.clientY,pointerId:e.pointerId};
                });

                card.addEventListener('pointermove',e=>{
                    if(!shipmentPress||shipmentPress.card!==card)return;
                    const dx=Math.abs(e.clientX-shipmentPress.x);
                    const dy=Math.abs(e.clientY-shipmentPress.y);
                    if(dx>6||dy>6)shipmentWasDragged=true;
                });

                card.addEventListener('pointerup',e=>{
                    if(e.button!==0||!shipmentPress||shipmentPress.card!==card)return;
                    const dx=Math.abs(e.clientX-shipmentPress.x);
                    const dy=Math.abs(e.clientY-shipmentPress.y);
                    const fueMovimiento=shipmentWasDragged||dx>6||dy>6||card.classList.contains('dragging');
                    shipmentPress=null;
                    if(fueMovimiento)return;
                    e.preventDefault();
                    e.stopPropagation();
                    const embarqueId=Number(card.dataset.openFlow||0);
                    if(embarqueId>0)openFlujo(embarqueId);
                });

                card.addEventListener('pointercancel',()=>{
                    shipmentPress=null;
                });

                card.addEventListener('click',e=>{
                    e.preventDefault();
                    e.stopPropagation();
                });

                card.addEventListener('keydown',e=>{
                    if(e.key!=='Enter'&&e.key!==' ')return;
                    e.preventDefault();
                    const embarqueId=Number(card.dataset.openFlow||0);
                    if(embarqueId>0)openFlujo(embarqueId);
                });

                card.addEventListener('dragstart',e=>{
                    if(card.dataset.puedeMover!=='true'){
                        e.preventDefault();
                        return;
                    }
                    shipmentWasDragged=true;
                    dragCard=card;
                    card.classList.add('dragging');
                    e.dataTransfer.effectAllowed='move';
                    e.dataTransfer.setData('text/plain','embarque');
                });

                card.addEventListener('dragend',()=>{
                    shipmentWasDragged=true;
                    shipmentPress=null;
                    card.classList.remove('dragging');
                    document.querySelectorAll('.lg-client-day.drag-over').forEach(x=>x.classList.remove('drag-over'));
                    limpiarIndicadorDrop();
                    setTimeout(()=>{
                        dragCard=null;
                        shipmentWasDragged=false;
                    },120);
                });
            });

            document.querySelectorAll('.lg-client-day').forEach(cell=>{
                cell.addEventListener('dragover',e=>{
                    if(!dragCard)return;
                    if(String(cell.dataset.clienteId)!==String(dragCard.dataset.clienteId))return;
                    e.preventDefault();
                    e.dataTransfer.dropEffect='move';
                    cell.classList.add('drag-over');
                    if(dragCard.dataset.dragType==='embarque')mostrarIndicadorDrop(cell,e);
                    else limpiarIndicadorDrop();
                });
                cell.addEventListener('dragleave',e=>{
                    if(!cell.contains(e.relatedTarget)){cell.classList.remove('drag-over');limpiarIndicadorDrop()}
                });
                cell.addEventListener('drop',async e=>{
                    if(!dragCard)return;
                    e.preventDefault();
                    cell.classList.remove('drag-over');
                    if(String(cell.dataset.clienteId)!==String(dragCard.dataset.clienteId)){toast('No puedes mover una operación a otro cliente.','error');return}
                    const fecha=cell.dataset.fecha;
                    limpiarIndicadorDrop();
                    if(dragCard.dataset.dragType==='programacion-grupo'){
                        if(fecha===dragCard.dataset.fecha){toast('Las programaciones ya se encuentran en ese día.','error');return}
                        const ids=(dragCard.dataset.programacionIds||'').split(',').map(x=>Number(x)).filter(x=>x>0);
                        if(!ids.length){toast('No fue posible identificar las programaciones.','error');return}
                        await moverGrupoProgramaciones(ids,fecha,dragCard);
                        return;
                    }
                    const minutos=minutesFromDrop(cell,e.clientX);
                    const hora=horaDesdeMinutos(minutos);
                    const data=new URLSearchParams();
                    data.append('__RequestVerificationToken',token);
                    data.append('EmbarqueID',dragCard.dataset.embarqueId||'');
                    data.append('FechaCargaProgramada',fecha);
                    data.append('HoraCargaProgramada',hora);
                    data.append('RowVersion',dragCard.dataset.rowVersion||'');
                    await postMove(urlMoverEmb,data,dragCard,cell,fecha,hora);
                });
            });

            async function moverGrupoProgramaciones(ids,fecha,card){
                const hoy=new Date();hoy.setHours(0,0,0,0);
                const destino=new Date(`${fecha}T00:00:00`);
                if(destino<hoy){toast('No puedes mover la programación a un día que ya terminó.','error');return}
                let movidas=0;
                try{
                    card.classList.add('dragging');
                    card.style.pointerEvents='none';
                    for(const id of ids){
                        const data=new URLSearchParams();
                        data.append('__RequestVerificationToken',token);
                        data.append('ListaCargaProgramacionID',String(id));
                        data.append('FechaProgramadaCarga',fecha);
                        const r=await fetch(urlMoverProg,{method:'POST',headers:{'Content-Type':'application/x-www-form-urlencoded; charset=UTF-8'},body:data.toString()});
                        let j;try{j=await r.json()}catch{throw new Error(`El servidor respondió ${r.status} y no devolvió JSON.`)}
                        if(!r.ok||!j.ok)throw new Error(j.mensaje||`No fue posible mover la programación ${id}.`);
                        movidas++;
                    }
                    toast(`${movidas} programación(es) movida(s) al ${fecha}.`);
                    setTimeout(()=>location.reload(),450);
                }catch(err){
                    toast(`${movidas} movida(s). ${err.message||'Error al mover las programaciones.'}`,'error');
                    if(movidas>0)setTimeout(()=>location.reload(),900);
                }finally{
                    card.classList.remove('dragging');
                    card.style.pointerEvents='';
                }
            }

            async function postMove(url,data,card,cell,fecha,hora){
                try{
                    card.style.opacity='.45';card.style.pointerEvents='none';
                    const r=await fetch(url,{method:'POST',headers:{'Content-Type':'application/x-www-form-urlencoded; charset=UTF-8'},body:data.toString()});
                    let j;try{j=await r.json()}catch{throw new Error(`El servidor respondió ${r.status} y no devolvió JSON.`)}
                    if(!r.ok||!j.ok)throw new Error(j.mensaje||'No fue posible mover la operación.');
                    if(j.rowVersion)card.dataset.rowVersion=j.rowVersion;
                    toast(j.mensaje||'Operación reprogramada.');
                    setTimeout(()=>location.reload(),450);
                }catch(err){toast(err.message||'Error al reprogramar.','error')}
                finally{card.style.opacity='';card.style.pointerEvents=''}
            }


            document.getElementById('formProgramar')?.addEventListener('submit',async e=>{
                e.preventDefault();
                if(!puedeProgramar){toast('La programación de Releases corresponde a Planeación.','error');return}
                const fd=new FormData(e.currentTarget);fd.append('__RequestVerificationToken',token);
                try{const r=await fetch(urlProgramar,{method:'POST',body:fd});const j=await r.json();if(!r.ok||!j.ok)throw new Error(j.mensaje||'No fue posible programar.');closeModal('modalProgramar');toast(j.mensaje||'Programación guardada.');setTimeout(()=>location.reload(),650)}
                catch(err){toast(err.message||'Error al programar.','error')}
            });



            document.querySelectorAll('.lg-unit-event').forEach(card=>{
                card.addEventListener('click',()=>{
                    document.getElementById('viajeTitulo').textContent=card.dataset.folio||`Viaje ${card.dataset.viajeId||''}`;
                    document.getElementById('viajeSub').textContent=`${card.dataset.unidad||'Unidad'} · ${card.dataset.estatus||''}`;
                    document.getElementById('vUnidad').textContent=card.dataset.unidad||'—';
                    document.getElementById('vEstatus').textContent=card.dataset.estatus||'—';
                    document.getElementById('vChofer').textContent=card.dataset.operador||'Por definir';
                    document.getElementById('vCliente').textContent=card.dataset.cliente||card.dataset.destino||'—';
                    document.getElementById('vSalida').textContent=card.dataset.salida||'Pendiente';
                    document.getElementById('vRegreso').textContent=card.dataset.regreso||'Pendiente';
                    document.getElementById('vKmIni').textContent=card.dataset.kmSalida?`${number(card.dataset.kmSalida)} km`:'Pendiente';
                    document.getElementById('vKmFin').textContent=card.dataset.kmRegreso?`${number(card.dataset.kmRegreso)} km`:'Pendiente';
                    document.getElementById('vKmRec').textContent=card.dataset.kmRecorridos?`${number(card.dataset.kmRecorridos)} km`:'—';
                    document.getElementById('vEmbarques').textContent=number(card.dataset.embarques);
                    document.getElementById('vPiezas').textContent=`${number(card.dataset.piezas)} PZA`;
                    const inc=Number(card.dataset.incidencias||0),crit=Number(card.dataset.criticas||0);
                    document.getElementById('vIncidencias').textContent=crit>0?`${inc} abiertas · ${crit} críticas`:String(inc);
                    document.getElementById('vRuta').textContent=card.dataset.ruta||'—';
                    document.getElementById('vOrigen').textContent=card.dataset.origen||'—';
                    document.getElementById('vDestino').textContent=card.dataset.destino||'—';
                    document.getElementById('vPlacas').textContent=card.dataset.placas||'—';
                    document.getElementById('vEvSalida').textContent=number(card.dataset.evidSalida);
                    document.getElementById('vEvTrayecto').textContent=number(card.dataset.evidTrayecto);
                    document.getElementById('vEvRegreso').textContent=number(card.dataset.evidRegreso);
                    document.getElementById('vEvIncidencia').textContent=number(card.dataset.evidIncidencia);
                    openModal('modalViaje');
                });
            });

            async function openFlujo(id){
                if(!id)return;
                limpiarDocumentosSeleccionados();
                openModal('modalFlujo');
                document.getElementById('flowLoading').style.display='';
                document.getElementById('flowBody').style.display='none';
                try{
                    const r=await fetch(`${urlFlujo}?embarqueId=${encodeURIComponent(id)}`,{headers:{'X-Requested-With':'XMLHttpRequest'}});
                    let j;try{j=await r.json()}catch{throw new Error(`El servidor respondió ${r.status} y no devolvió JSON.`)}
                    if(!r.ok||!j.ok)throw new Error(j.mensaje||`Error HTTP ${r.status}.`);
                    flujoActual=j.flujo;
                    documentosActual=null;
                    cargaFisicaActual=null;
                    renderFlujo(flujoActual);
                    document.getElementById('flowLoading').style.display='none';
                    document.getElementById('flowBody').style.display='';
                }catch(err){document.getElementById('flowLoading').innerHTML=`<div style="color:var(--lg-red)">${esc(err.message||'Error')}</div>`}
            }

            function renderFlujo(f){
                document.getElementById('flowTitulo').textContent=f.folio||`Embarque ${f.embarqueID}`;
                document.getElementById('flowSub').textContent=`${f.cliente||''}${f.destino?` · ${f.destino}`:''}`;
                document.getElementById('fCliente').textContent=f.cliente||'—';
                document.getElementById('fEstatus').textContent=f.estatus||'—';
                document.getElementById('fCarga').textContent=`${f.fechaCargaProgramada||'Sin fecha'} ${f.horaCargaProgramada||''}`.trim();
                document.getElementById('fPiezas').textContent=`${number(f.totalPiezas)} PZA`;
                const pt=f.disponibilidadPT||{};
                document.getElementById('fPreparadas').textContent=`${number(pt.piezasPTUtilizables??f.totalPiezasPreparadas)} PZA`;
                ['btnVistaCompletaFlow','btnPreparacionVista','btnDocumentosVista','btnCargaVista','btnSalidaVista'].forEach(id=>{const a=document.getElementById(id);if(a)a.href=`${urlDetalleEmb}/${f.embarqueID}`});

                renderTimeline(f.pasos||[]);
                cargarSalidaForm(f);
                document.getElementById('fpFecha').textContent=f.fechaCargaProgramada||'—';
                document.getElementById('fpHora').textContent=f.horaCargaProgramada||'—';
                document.getElementById('fpPiezas').textContent=`${number(f.totalPiezas)} PZA`;
                document.getElementById('fpEntrega').textContent=f.fechaEntregaProgramada||'—';
                const btnReprogramar=document.getElementById('btnReprogramarFlow');
                if(btnReprogramar){btnReprogramar.disabled=!Boolean(f.puedeReprogramar);btnReprogramar.title=f.puedeReprogramar?'Cambiar fecha y hora del embarque.':'La carga física ya comenzó o el embarque ya no admite reprogramación.'}

                const requerido=Number(pt.requerido??f.totalPiezas??0);
                const disponible=Number(pt.piezasPTUtilizables??0);
                const faltante=Number(pt.faltante??Math.max(0,requerido-disponible));
                const cobertura=Number(pt.cobertura??(requerido>0?Math.min(100,(disponible*100)/requerido):0));
                const suficiente=Boolean(pt.suficiente??(requerido>0&&disponible>=requerido));
                document.getElementById('frRequeridas').textContent=`${number(requerido)} PZA`;
                document.getElementById('frDisponibles').textContent=`${number(disponible)} PZA`;
                document.getElementById('frFaltantes').textContent=`${number(faltante)} PZA`;
                document.getElementById('frCobertura').textContent=`${cobertura.toLocaleString('es-MX',{maximumFractionDigits:1})}%`;
                document.getElementById('frBar').style.width=`${Math.max(0,Math.min(100,cobertura))}%`;
                const estadoPt=document.getElementById('frEstado');
                if(estadoPt){
                    const partesFaltantes=(pt.partes||[]).filter(x=>!x.suficiente).length;
                    estadoPt.className=`lg-pt-status ${suficiente?'ok':'warn'}`;
                    estadoPt.innerHTML=suficiente
                        ?`<i class="fa-solid fa-circle-check"></i><div><strong>Existencia suficiente en Almacén PT</strong><span>${number(requerido)} PZA requeridas · ${number(disponible)} PZA disponibles aplicables al embarque.</span></div>`
                        :`<i class="fa-solid fa-triangle-exclamation"></i><div><strong>Disponibilidad PT incompleta</strong><span>Faltan ${number(faltante)} PZA${partesFaltantes>0?` en ${number(partesFaltantes)} número(s) de parte`:''}. Puedes continuar con otras actividades mientras se completa PT.</span></div>`;
                }
                const tbodyPt=document.getElementById('frPartes');
                if(tbodyPt){
                    tbodyPt.innerHTML='';
                    const partes=pt.partes||[];
                    if(!partes.length)tbodyPt.innerHTML='<tr><td colspan="7" style="text-align:center;color:var(--lg-muted);padding:14px">No se encontró detalle de disponibilidad por número de parte.</td></tr>';
                    partes.forEach(x=>{
                        const tr=document.createElement('tr');
                        const falta=Number(x.faltante||0);
                        tr.innerHTML=`<td><strong>${esc(x.numeroParte||`Parte ${x.parteId||''}`)}</strong></td><td class="num">${number(x.requerido)} PZA</td><td class="num">${number(x.libre)} PZA</td><td class="num">${number(x.reservado)} PZA</td><td class="num">${number(x.disponible)} PZA</td><td class="num ${falta>0?'missing':'enough'}">${number(falta)} PZA</td><td><span class="lg-doc-state ${x.suficiente?'ok':''}"><i class="fa-solid ${x.suficiente?'fa-circle-check':'fa-triangle-exclamation'}"></i> ${x.suficiente?'Suficiente':'Faltante'}</span></td>`;
                        tbodyPt.appendChild(tr);
                    });
                }

                const totalCajas=Number(f.totalCajas||0);
                const cargadas=Number(f.totalCajasCargadas||0);
                const pendientes=Math.max(0,totalCajas-cargadas);
                const pctCarga=totalCajas>0?Math.min(100,Math.round((cargadas*100)/totalCajas)):0;
                document.getElementById('fcCajas').textContent=number(totalCajas);
                document.getElementById('fcCargadas').textContent=number(cargadas);
                document.getElementById('fcPendientes').textContent=number(pendientes);
                document.getElementById('fcEstatus').textContent=f.estatus||'—';
                document.getElementById('fcBar').style.width=`${pctCarga}%`;

                const pasos=f.pasos||[];
                const pasoProgramacion=pasos.find(x=>x.clave==='programacion');
                const pasoSalida=pasos.find(x=>x.clave==='salida');
                const pasoPt=pasos.find(x=>x.clave==='preparacion');
                const pasoDocumentos=pasos.find(x=>x.clave==='documentos');
                const pasoCarga=pasos.find(x=>x.clave==='carga');
                document.getElementById('fdFaltantes').textContent=number(f.documentosFaltantes);
                document.getElementById('fdForma').textContent=formaTexto(f.salida?.formaEnvio);
                document.getElementById('fdTipo').textContent=tipoTexto(f.salida?.tipoOperacion);
                document.getElementById('fdEstado').textContent=pasoDocumentos?.completo?'Completa':'Pendiente';
                const fdContexto=document.getElementById('fdContexto');
                if(fdContexto){
                    const salidaDefinida=Boolean(f.salida?.formaEnvio)&&Boolean(f.salida?.tipoOperacion);
                    fdContexto.innerHTML=salidaDefinida
                        ?'<strong>Flujo flexible:</strong> puedes completar documentos antes, durante o después de preparar PT. Deben quedar validados antes de confirmar la salida de planta.'
                        :'<strong>Puedes adelantar documentos.</strong> La forma de salida aún no está completamente definida; los requisitos finales pueden cambiar cuando la confirmes. La salida de planta siempre volverá a validar los obligatorios.';
                }
                const avisoDocs=document.getElementById('fcDocumentacionAviso');
                if(avisoDocs){
                    const docsOk=Boolean(pasoDocumentos?.completo);
                    avisoDocs.className=`lg-stage-lock ${docsOk?'ok':''}`;
                    avisoDocs.innerHTML=docsOk
                        ?'<strong>Documentación completa:</strong> todos los documentos obligatorios están validados.'
                        :`<strong>Documentación pendiente:</strong> faltan ${number(f.documentosFaltantes)} documento(s) obligatorio(s). Puedes continuar con la carga física; la salida de planta permanecerá bloqueada hasta completarlos.`;
                }

                document.getElementById('fspInc').textContent=number(f.incidenciasAbiertas);
                document.getElementById('fspCrit').textContent=number(f.incidenciasCriticas);
                document.getElementById('fspDesp').textContent=`${number(f.totalPiezasDespachadas)} PZA`;
                document.getElementById('fspViaje').textContent=f.viajeID?`VIA-${String(f.viajeID).padStart(6,'0')}`:'—';

                function gate(id,ok,detail){
                    const el=document.getElementById(id);if(!el)return;
                    el.textContent=ok?'Cumplido':'Pendiente';
                    el.className=`lg-gate-state ${ok?'ok':'block'}`;
                    if(detail)el.title=detail;
                }
                const programacionOk=Boolean(pasoProgramacion?.completo);
                const salidaOk=Boolean(pasoSalida?.completo);
                const ptOk=Boolean(pasoPt?.completo)||['Cargado','En ruta','Entregado'].includes(f.estatus||'');
                const documentosOk=Boolean(pasoDocumentos?.completo);
                const cargaOk=Boolean(pasoCarga?.completo)||['Cargado','En ruta','Entregado'].includes(f.estatus||'');
                const incidenciasOk=Number(f.incidenciasCriticas||0)===0;
                gate('gateProgramacion',programacionOk,'Fecha, hora y piezas del embarque.');
                gate('gateSalida',salidaOk,'Forma de salida y recursos de transporte.');
                gate('gatePt',ptOk,ptOk?'Cobertura PT suficiente.':`Faltan ${number(faltante)} PZA.`);
                gate('gateDocumentos',documentosOk,documentosOk?'Documentación completa.':`Faltan ${number(f.documentosFaltantes)} documento(s).`);
                gate('gateCarga',cargaOk,'Carga física completa.');
                gate('gateIncidencias',incidenciasOk,incidenciasOk?'Sin incidencias críticas.':`${number(f.incidenciasCriticas)} crítica(s) abierta(s).`);

                const forma=f.salida?.formaEnvio||'';
                const ayudaSalida=document.getElementById('salidaPlantaAyuda');
                const btnSalidaPlanta=document.getElementById('btnConfirmarSalidaPlanta');
                if(btnSalidaPlanta){btnSalidaPlanta.style.display='none';btnSalidaPlanta.disabled=false;btnSalidaPlanta.title=''}
                const requisitosSalida=programacionOk&&salidaOk&&ptOk&&documentosOk&&cargaOk&&incidenciasOk;
                if(forma==='Interno'){
                    ayudaSalida.innerHTML=f.estatus==='En ruta'||f.estatus==='Entregado'
                        ?'<strong>Entrega:</strong> la salida de planta ya fue confirmada por el chofer y el embarque se encuentra '+esc(f.estatus)+'.'
                        :!documentosOk
                            ?`<strong>Entrega pendiente:</strong> el chofer no podrá confirmar la salida mientras falten ${number(f.documentosFaltantes)} documento(s) obligatorio(s) validados.`
                            :f.viajeID
                                ?`<strong>Entrega:</strong> el viaje VIA-${String(f.viajeID).padStart(6,'0')} ya está vinculado. La salida física la confirma exclusivamente el chofer desde su portal.`
                                :'<strong>Entrega:</strong> falta crear o vincular el viaje del chofer antes de la salida.';
                }else if(forma==='Cliente'||forma==='Paqueteria'){
                    if(f.estatus==='En ruta'||f.estatus==='Entregado'){
                        ayudaSalida.innerHTML='<strong>Salida confirmada:</strong> la mercancía ya salió de planta y el descuento de PT fue registrado.';
                    }else if(f.estatus==='Cargado'){
                        if(!requisitosSalida){
                            const faltan=[];
                            if(!programacionOk)faltan.push('programación');
                            if(!salidaOk)faltan.push('forma de salida');
                            if(!ptOk)faltan.push('disponibilidad PT');
                            if(!documentosOk)faltan.push('documentación');
                            if(!cargaOk)faltan.push('carga física');
                            if(!incidenciasOk)faltan.push('incidencias críticas');
                            ayudaSalida.innerHTML=`<strong>Salida bloqueada:</strong> falta completar ${esc(faltan.join(', '))}.`;
                            if(btnSalidaPlanta){btnSalidaPlanta.style.display='';btnSalidaPlanta.disabled=true;btnSalidaPlanta.title='Completa los requisitos pendientes.'}
                        }else{
                            ayudaSalida.innerHTML=forma==='Cliente'
                                ?'<strong>Cliente recoge:</strong> todos los requisitos están completos. Confirma la salida cuando la mercancía abandone realmente la planta.'
                                :'<strong>Paquetería:</strong> todos los requisitos están completos. Confirma la salida cuando la mercancía sea entregada al transportista.';
                            if(btnSalidaPlanta)btnSalidaPlanta.style.display='';
                        }
                    }else{
                        ayudaSalida.innerHTML='<strong>Salida pendiente:</strong> puedes revisar esta etapa en cualquier momento. La confirmación se habilitará cuando la carga quede completa y todos los requisitos anteriores estén cumplidos.';
                    }
                }else{
                    ayudaSalida.innerHTML='<strong>Salida:</strong> falta definir la forma de salida. Puedes volver a esa etapa sin perder el trabajo de documentación o PT.';
                }

                document.getElementById('entregaAyuda').innerHTML=f.estatus==='En ruta'?'<strong>Entrega disponible:</strong> captura al receptor y adjunta una o más evidencias para cerrar el embarque.':'<strong>Entrega:</strong> puedes consultar esta etapa; el cierre se habilita cuando la salida física deje el embarque En ruta.';
                renderEvidenciasCompartidas(f.evidencias||[]);
                const btnEntrega=document.getElementById('btnEntregaFlow');
                btnEntrega.style.display=f.estatus==='En ruta'?'':'none';
                const actual=pasos.find(x=>x.actual)||pasos.find(x=>!x.completo)||pasos[0];
                activateStage(actual?.clave||'programacion',false);
                actualizarBadges(pasos);
            }

            function renderEvidenciasCompartidas(evidencias){
                const cont=document.getElementById('flowEvidencias');
                if(!cont)return;
                cont.innerHTML='';
                if(!evidencias.length){cont.innerHTML='<div class="lg-disabled-note" style="grid-column:1/-1;padding:12px">Todavía no hay evidencias registradas para el embarque o su viaje relacionado.</div>';return}
                evidencias.forEach(x=>{
                    const esViaje=String(x.origen||'').toLowerCase()==='viaje';
                    const href=`${esViaje?urlVerEvidenciaViaje:urlVerEvidenciaEmbarque}?id=${encodeURIComponent(x.evidenciaID)}`;
                    const item=document.createElement('div');
                    item.className='lg-evidence-item';
                    item.innerHTML=`<i class="fa-solid ${x.esPdf?'fa-file-pdf':x.esImagen?'fa-image':'fa-paperclip'}"></i><div class="data"><strong title="${esc(x.nombreOriginal||'Evidencia')}">${esc(x.nombreOriginal||'Evidencia')}</strong><small>${esc(x.tipoEvidencia||'Evidencia')} · ${esc(x.fechaCarga||'')} · ${esc(x.usuario||'')}</small></div><span class="lg-origin-chip ${esViaje?'viaje':''}">${esViaje?'Viaje':'Embarque'}</span><a class="lg-btn" style="height:27px;padding:0 7px" href="${href}" target="_blank" rel="noopener" title="Ver evidencia"><i class="fa-solid fa-eye"></i></a>`;
                    cont.appendChild(item);
                });
            }

            async function cargarDocumentosModal(){
                if(!flujoActual?.embarqueID)return;
                const req=document.getElementById('docRequisitos');
                if(req)req.innerHTML='<div class="lg-disabled-note" style="padding:12px"><i class="fa-solid fa-spinner fa-spin"></i> Consultando expediente documental...</div>';
                try{
                    const r=await fetch(`${urlObtenerDocumentos}?embarqueId=${encodeURIComponent(flujoActual.embarqueID)}`,{headers:{'X-Requested-With':'XMLHttpRequest'}});
                    let j;try{j=await r.json()}catch{throw new Error(`El servidor respondió ${r.status} y no devolvió JSON.`)}
                    if(!r.ok||!j.ok)throw new Error(j.mensaje||'No fue posible consultar los documentos.');
                    documentosActual=j;
                    renderDocumentosModal(j);
                }catch(err){
                    if(req)req.innerHTML=`<div class="lg-disabled-note" style="padding:12px;color:var(--lg-red)">${esc(err.message||'Error al consultar la documentación.')}</div>`;
                }
            }

            function iconoDocumento(nombre,tipoContenido){
                const ext=String(nombre||'').split('.').pop()?.toLowerCase()||'';
                if(String(tipoContenido||'').startsWith('image/')||['jpg','jpeg','png','webp','heic','heif'].includes(ext))return'fa-image';
                if(ext==='pdf')return'fa-file-pdf';
                if(['xls','xlsx'].includes(ext))return'fa-file-excel';
                if(['doc','docx'].includes(ext))return'fa-file-word';
                if(ext==='xml')return'fa-code';
                return'fa-file';
            }

            function esRequisitoFacturaRemision(tipo){
                return tipo==='Factura firmada y sellada / Remisión'||tipo==='Factura firmada por transportista / Remisión';
            }

            function opcionesDocumentoRequisito(tipo){
                if(esRequisitoFacturaRemision(tipo))return['Factura','Remisión'];
                if(tipo==='Commercial Invoice / Carta Porte')return['Commercial Invoice','Carta Porte'];
                return[tipo];
            }

            function documentoCumpleRequisitoUi(requisito,tipoDocumento){
                const req=String(requisito||'').trim();
                const tipo=String(tipoDocumento||'').trim();
                if(esRequisitoFacturaRemision(req))return tipo==='Factura'||tipo==='Remisión';
                if(req==='Commercial Invoice / Carta Porte')return tipo==='Commercial Invoice'||tipo==='Carta Porte';
                return req.toLocaleLowerCase('es-MX')===tipo.toLocaleLowerCase('es-MX');
            }

            function obtenerDocumentoActualRequisito(requisito,documentos){
                const candidatos=(documentos||[]).filter(x=>documentoCumpleRequisitoUi(requisito,x.tipoDocumento));
                candidatos.sort((a,b)=>{
                    const validado=Number(Boolean(b.validado))-Number(Boolean(a.validado));
                    if(validado!==0)return validado;
                    return Number(b.documentoId||0)-Number(a.documentoId||0);
                });
                return candidatos[0]||null;
            }

            function validarArchivoDocumento(file){
                if(!file)return'No se recibió el archivo.';
                const ext=(file.name.split('.').pop()||'').toLowerCase();
                const permitidas=['pdf','xml','xlsx','xls','docx','doc','jpg','jpeg','png','webp','heic','heif'];
                const esImagen=file.type?.startsWith('image/')||['jpg','jpeg','png','webp','heic','heif'].includes(ext);
                if(!esImagen&&!permitidas.includes(ext))return`${file.name}: formato no permitido.`;
                if(file.size<=0)return`${file.name}: el archivo está vacío.`;
                if(file.size>10*1024*1024)return`${file.name}: excede 10 MB.`;
                return'';
            }

            function tipoSeleccionadoFila(row){
                return row.querySelector('[data-doc-tipo]:checked')?.value||row.dataset.tipoUnico||'';
            }

            function actualizarVisibilidadRemision(row){
                const bloque=row.querySelector('[data-remision-motivo]');
                if(!bloque)return;
                const tipo=tipoSeleccionadoFila(row);
                const tieneArchivo=documentosFilaSeleccionados.has(row.dataset.docIndex);
                bloque.style.display=tipo==='Remisión'&&tieneArchivo?'':'none';
                const textarea=bloque.querySelector('textarea');
                if(textarea)textarea.required=tipo==='Remisión'&&tieneArchivo;
            }

            function actualizarArchivoFila(row,file){
                const index=row.dataset.docIndex;
                const nombre=row.querySelector('[data-doc-file-name]');
                const ayuda=row.querySelector('[data-doc-file-help]');
                const picker=row.querySelector('.lg-doc-file-picker');
                if(file){
                    documentosFilaSeleccionados.set(index,file);
                    if(nombre)nombre.textContent=file.name;
                    if(ayuda)ayuda.textContent=tamanoArchivo(file.size);
                    picker?.classList.add('selected');
                }else{
                    documentosFilaSeleccionados.delete(index);
                    if(nombre)nombre.textContent=row.dataset.documentoId?'Reemplazar archivo':'Seleccionar archivo';
                    if(ayuda)ayuda.textContent=row.dataset.documentoId?'El documento actual se conservará si no eliges otro.':'Un archivo para este requisito.';
                    picker?.classList.remove('selected');
                }
                actualizarVisibilidadRemision(row);
                actualizarResumenDocumentosLote();
            }

            function actualizarResumenDocumentosLote(){
                const archivos=[...documentosFilaSeleccionados.values()];
                const total=archivos.reduce((s,x)=>s+x.size,0);
                const resumen=document.getElementById('docArchivosResumen');
                if(resumen)resumen.textContent=archivos.length?`${archivos.length} archivo(s) nuevo(s) · ${tamanoArchivo(total)}`:'Sin archivos nuevos';
                const btn=document.getElementById('btnSubirDocumento');
                const pendientes=[...document.querySelectorAll('#docRequisitos [data-doc-row]')].filter(row=>row.dataset.documentoId&&row.dataset.documentoValidado!=='true').length;
                const texto=btn?.querySelector('span');
                if(texto)texto.textContent=archivos.length||pendientes?`Guardar documentación (${archivos.length+pendientes})`:'Guardar documentación';
            }

            function limpiarDocumentosSeleccionados(){
                documentosFilaSeleccionados.clear();
                document.querySelectorAll('#docRequisitos [data-doc-input]').forEach(input=>input.value='');
                actualizarResumenDocumentosLote();
            }

            function renderDocumentoActual(actual,puedeModificar){
                if(!actual)return'<div class="lg-doc-current empty"><i class="fa-solid fa-file-circle-xmark"></i><div><strong>Sin archivo cargado</strong><small>Adjunta el archivo correspondiente.</small></div></div>';
                const estado=actual.validado?'Confirmado':'Pendiente de guardar';
                return `<div class="lg-doc-current ${actual.validado?'ok':'pending'}"><i class="fa-solid ${iconoDocumento(actual.nombreOriginal,actual.tipoContenido)}"></i><div class="lg-doc-current-data"><strong title="${esc(actual.nombreOriginal||'Documento')}">${esc(actual.nombreOriginal||'Documento')}</strong><small>${esc(actual.fechaCarga||'')} ${actual.usuarioCarga?`· ${esc(actual.usuarioCarga)}`:''}</small></div><span class="lg-doc-state ${actual.validado?'ok':''}">${estado}</span><a class="lg-doc-icon-btn" href="${esc(actual.verUrl||'#')}" target="_blank" rel="noopener" title="Ver archivo"><i class="fa-solid fa-eye"></i></a>${puedeModificar?`<button class="lg-doc-icon-btn danger" type="button" data-retirar-documento="${actual.documentoId}" title="Retirar archivo"><i class="fa-solid fa-trash-can"></i></button>`:''}</div>`;
            }

            function renderDocumentosModal(j){
                const req=document.getElementById('docRequisitos');
                const extras=document.getElementById('docExtras');
                const extrasWrap=document.getElementById('docExtrasWrap');
                const form=document.getElementById('formDocumentoFlow');
                const btnSubir=document.getElementById('btnSubirDocumento');
                documentosFilaSeleccionados.clear();
                document.getElementById('fdFaltantes').textContent=number(j.documentosFaltantes);
                document.getElementById('fdEstado').textContent=j.documentacionCompleta?'Completa':'Pendiente';
                const requeridos=j.requeridos||[];
                const documentos=j.documentos||[];
                const puedeModificar=Boolean(j.puedeModificar)&&!Boolean(j.requiereDefinirSalida);
                const contador=document.getElementById('docContador');
                if(contador)contador.textContent=j.requiereDefinirSalida?'Define primero la salida':j.documentacionCompleta?'Expediente completo':`${number(j.documentosFaltantes)} pendiente(s)`;
                if(req){
                    req.innerHTML='';
                    if(j.requiereDefinirSalida){
                        req.innerHTML='<div class="lg-disabled-note" style="padding:14px"><i class="fa-solid fa-route"></i> Primero define el tipo de operación y la forma de salida para conocer el expediente documental requerido.</div>';
                    }else if(!requeridos.length){
                        req.innerHTML='<div class="lg-disabled-note" style="padding:14px">No hay requisitos documentales definidos para la forma de salida actual.</div>';
                    }else{
                        requeridos.forEach((x,index)=>{
                            const actual=obtenerDocumentoActualRequisito(x.tipoDocumento,documentos);
                            const opciones=opcionesDocumentoRequisito(x.tipoDocumento);
                            const tipoInicial=actual&&opciones.includes(actual.tipoDocumento)?actual.tipoDocumento:opciones[0];
                            const row=document.createElement('div');
                            row.className=`lg-doc-batch-row ${x.cumplido?'complete':''}`;
                            row.dataset.docRow='true';
                            row.dataset.docIndex=String(index);
                            row.dataset.requisito=x.tipoDocumento||'';
                            row.dataset.obligatorio=String(Boolean(x.obligatorio));
                            row.dataset.documentoId=actual?.documentoId?String(actual.documentoId):'';
                            row.dataset.documentoValidado=String(Boolean(actual?.validado));
                            if(opciones.length===1)row.dataset.tipoUnico=opciones[0];
                            const selector=opciones.length>1?`<div class="lg-doc-choice">${opciones.map((op,i)=>`<label><input type="radio" name="docTipo_${index}" data-doc-tipo value="${esc(op)}" ${op===tipoInicial?'checked':''} ${!puedeModificar?'disabled':''}/> <span>${esc(op)}</span></label>`).join('')}</div>`:`<div class="lg-doc-type-fixed"><i class="fa-solid fa-file-lines"></i> ${esc(opciones[0])}</div>`;
                            row.innerHTML=`<div class="lg-doc-requirement-info"><div class="lg-doc-title-line"><strong>${esc(x.tipoDocumento||'Documento')}</strong><span class="lg-doc-required-tag ${x.obligatorio?'required':'optional'}">${x.obligatorio?'Obligatorio':'Opcional'}</span></div><small>${esc(x.areaResponsable||'Sin área responsable')}</small>${selector}</div><div class="lg-doc-middle">${renderDocumentoActual(actual,puedeModificar)}<div class="lg-doc-remision-reason" data-remision-motivo style="display:none"><label>Motivo para usar Remisión *</label><textarea class="lg-input" maxlength="1000" placeholder="Ej. cierre de mes o Factura temporalmente no disponible."></textarea></div></div><label class="lg-doc-file-picker ${!puedeModificar?'disabled':''}"><input type="file" data-doc-input accept=".pdf,.xml,.xlsx,.xls,.docx,.doc,.jpg,.jpeg,.png,.webp,.heic,.heif,image/*" ${!puedeModificar?'disabled':''}/><i class="fa-solid fa-paperclip"></i><div><strong data-doc-file-name>${actual?'Reemplazar archivo':'Seleccionar archivo'}</strong><small data-doc-file-help>${actual?'El documento actual se conservará si no eliges otro.':'Un archivo para este requisito.'}</small></div></label>`;
                            req.appendChild(row);
                            actualizarVisibilidadRemision(row);
                        });
                    }
                }
                const utilizados=new Set();
                requeridos.forEach(r=>{
                    documentos.filter(d=>documentoCumpleRequisitoUi(r.tipoDocumento,d.tipoDocumento)).forEach(d=>utilizados.add(Number(d.documentoId)));
                });
                const otros=documentos.filter(d=>!utilizados.has(Number(d.documentoId)));
                if(extras&&extrasWrap){
                    extras.innerHTML='';
                    extrasWrap.style.display=otros.length?'':'none';
                    otros.forEach(x=>{
                        const row=document.createElement('div');
                        row.className='lg-doc-row';
                        row.innerHTML=`<div class="lg-doc-icon"><i class="fa-solid ${iconoDocumento(x.nombreOriginal,x.tipoContenido)}"></i></div><div style="min-width:0"><strong title="${esc(x.nombreOriginal||'Documento')}">${esc(x.tipoDocumento||'Documento')} · ${esc(x.nombreOriginal||'')}</strong><small>${esc(x.areaResponsable||'Sin área')} · ${tamanoArchivo(x.tamanoBytes)} · ${esc(x.fechaCarga||'')}</small></div><div class="lg-doc-actions"><span class="lg-doc-state ${x.validado?'ok':''}">${x.validado?'Confirmado':'Cargado'}</span><a class="lg-doc-icon-btn" href="${esc(x.verUrl||'#')}" target="_blank" rel="noopener" title="Ver archivo"><i class="fa-solid fa-eye"></i></a>${puedeModificar?`<button class="lg-doc-icon-btn danger" type="button" data-retirar-documento="${x.documentoId}" title="Retirar archivo"><i class="fa-solid fa-trash-can"></i></button>`:''}</div>`;
                        extras.appendChild(row);
                    });
                }
                if(form)form.querySelectorAll('input,textarea,button').forEach(x=>{if(x.id!=='btnSubirDocumento'&&!x.hasAttribute('data-next-stage')&&!x.hasAttribute('data-retirar-documento'))x.disabled=!puedeModificar});
                if(btnSubir)btnSubir.disabled=!puedeModificar||!requeridos.length;
                actualizarResumenDocumentosLote();
            }

            async function validarDocumentoAutomatico(documentoId){
                const data=new URLSearchParams();
                data.append('__RequestVerificationToken',token);
                data.append('documentoId',String(documentoId));
                data.append('embarqueId',String(flujoActual.embarqueID));
                const r=await fetch(urlValidarDocumento,{method:'POST',headers:{'Content-Type':'application/x-www-form-urlencoded; charset=UTF-8','X-Requested-With':'XMLHttpRequest'},body:data.toString()});
                let j;try{j=await r.json()}catch{throw new Error(`El servidor respondió ${r.status} al confirmar un documento.`)}
                if(!r.ok||!j.ok)throw new Error(j.mensaje||'No fue posible confirmar uno de los documentos.');
                return j;
            }

            async function ejecutarAccionDocumento(url,data,mensajeError){
                const r=await fetch(url,{method:'POST',headers:{'Content-Type':'application/x-www-form-urlencoded; charset=UTF-8','X-Requested-With':'XMLHttpRequest'},body:data.toString()});
                let j;try{j=await r.json()}catch{throw new Error(`El servidor respondió ${r.status} y no devolvió JSON.`)}
                if(!r.ok||!j.ok)throw new Error(j.mensaje||mensajeError);
                toast(j.mensaje||'Documento actualizado.');
                await refrescarFlujoActual('documentos');
            }

            async function cargarCargaFisica(){
                if(!flujoActual?.embarqueID)return;
                const lista=document.getElementById('fcListaCajas');
                if(lista)lista.innerHTML='<div class="lg-disabled-note" style="padding:12px"><i class="fa-solid fa-spinner fa-spin"></i> Consultando cajas...</div>';
                try{
                    const r=await fetch(`${urlObtenerCargaFisica}?embarqueId=${encodeURIComponent(flujoActual.embarqueID)}`,{headers:{'X-Requested-With':'XMLHttpRequest'}});
                    let j;try{j=await r.json()}catch{throw new Error(`El servidor respondió ${r.status} y no devolvió JSON.`)}
                    if(!r.ok||!j.ok)throw new Error(j.mensaje||'No fue posible consultar la carga física.');
                    cargaFisicaActual=j;
                    renderCargaFisica(j);
                    setTimeout(()=>{const input=document.getElementById('fcCodigo');if(input&&!input.disabled)input.focus()},80);
                }catch(err){
                    if(lista)lista.innerHTML=`<div class="lg-disabled-note" style="padding:12px;color:var(--lg-red)">${esc(err.message||'Error al consultar las cajas.')}</div>`;
                }
            }

            function renderCargaFisica(j){
                const total=Number(j.totalPiezas||0);
                const cargadas=Number(j.piezasCargadas||0);
                const reservadas=Number(j.piezasReservadas||0);
                const pendientes=Math.max(0,Number(j.piezasPendientes??(total-cargadas)));
                const pct=total>0?Math.min(100,Math.round((cargadas*100)/total)):0;
                document.getElementById('fcCajas').textContent=number(j.cajasAsignadas);
                document.getElementById('fcCargadas').textContent=number(j.cajasCargadas);
                document.getElementById('fcPendientes').textContent=`${number(pendientes)} PZA`;
                document.getElementById('fcEstatus').textContent=j.estatus||'—';
                document.getElementById('fcTotalPiezas').textContent=`${number(total)} PZA`;
                document.getElementById('fcPiezasCargadas').textContent=`${number(cargadas)} PZA`;
                document.getElementById('fcPiezasReservadas').textContent=`${number(reservadas)} PZA`;
                document.getElementById('fcAvance').textContent=`${pct}%`;
                document.getElementById('fcBar').style.width=`${pct}%`;
                const cerrado=['Cargado','En ruta','Entregado','Cancelado'].includes(j.estatus||'');
                const programacionLista=Boolean(flujoActual?.fechaCargaProgramada)&&Boolean(flujoActual?.horaCargaProgramada)&&Number(flujoActual?.totalPiezas||0)>0;
                const input=document.getElementById('fcCodigo');
                const btnScan=document.getElementById('btnEscanearCaja');
                if(input){input.disabled=cerrado||!programacionLista;if(cerrado)input.value='';input.title=!programacionLista?'Primero define fecha y hora de carga.':''}
                if(btnScan){btnScan.disabled=cerrado||!programacionLista;btnScan.title=!programacionLista?'Primero define fecha y hora de carga.':''}
                const btnConfirmar=document.getElementById('btnConfirmarCargaFisica');
                if(btnConfirmar){btnConfirmar.disabled=!j.puedeConfirmar;btnConfirmar.title=j.puedeConfirmar?'Confirmar que todas las cajas ya fueron cargadas físicamente.':'Completa el escaneo de todas las piezas antes de confirmar.'}
                const lista=document.getElementById('fcListaCajas');
                if(!lista)return;
                lista.innerHTML='';
                const cajas=j.cajas||[];
                if(!cajas.length){lista.innerHTML='<div class="lg-disabled-note" style="padding:12px">Todavía no hay cajas asignadas o escaneadas para este embarque.</div>';return}
                cajas.forEach(x=>{
                    const cargada=['Cargada','Despachada'].includes(x.estatus);
                    const row=document.createElement('div');
                    row.className='lg-load-row';
                    row.innerHTML=`<div class="lg-load-check ${cargada?'':'pending'}"><i class="fa-solid ${cargada?'fa-check':'fa-clock'}"></i></div><div><strong>${esc(x.etiqueta||`Caja ${x.cajaId}`)} · ${number(x.cantidadAsignada)} PZA</strong><small>Parte ${esc(x.numeroParte||'—')} · OF ${esc(x.numeroOF||'—')} ${x.lote?`· Lote ${esc(x.lote)}`:''}</small><small>${cargada?`Cargada ${esc(x.fechaCarga||'')} ${x.usuarioCarga?`· ${esc(x.usuarioCarga)}`:''}`:`Reservada ${esc(x.fechaReserva||'')}`}</small></div><span class="lg-doc-state ${cargada?'ok':''}">${esc(x.estatus||'Pendiente')}</span>`;
                    lista.appendChild(row);
                });
            }

            function renderTimeline(pasos){
                const top=document.getElementById('flowTimeline'),side=document.getElementById('flowSide');top.innerHTML='';side.innerHTML='';
                pasos.forEach(p=>{
                    const estadoVisual=p.completo?'Completo':p.actual?'En proceso':'Pendiente';
                    const cls=p.completo?'complete':p.actual?'actual':'';
                    const d=document.createElement('div');
                    d.className=`lg-step navigable ${cls}`;
                    d.title=`Abrir ${p.titulo}`;
                    d.innerHTML=`<div class="lg-step-dot"><i class="fa-solid ${esc(p.icono||'fa-circle')}"></i></div><div class="lg-step-title">${esc(p.numero)}. ${esc(p.titulo)}</div><div class="lg-step-state">${esc(estadoVisual)}</div>`;
                    d.addEventListener('click',()=>activateStage(p.clave));
                    top.appendChild(d);
                    const s=document.createElement('div');
                    s.className=`lg-flow-side-item ${p.completo?'complete':'pending'} ${p.actual?'active':''}`;
                    s.dataset.stage=p.clave;
                    s.innerHTML=`<strong>${esc(p.numero)}. ${esc(p.titulo)}</strong><span>${esc(p.descripcion)}</span>`;
                    s.addEventListener('click',()=>activateStage(p.clave));
                    side.appendChild(s);
                });
            }

            function actualizarBadges(pasos){
                const map={programacion:'badgeProgramacion',salida:'badgeSalida',preparacion:'badgePreparacion',documentos:'badgeDocumentos',carga:'badgeCarga',salidaPlanta:'badgeSalidaPlanta',entrega:'badgeEntrega'};
                pasos.forEach(p=>{const b=document.getElementById(map[p.clave]);if(!b)return;b.textContent=p.completo?'Completo':p.actual?'En proceso':'Pendiente';b.className=`lg-stage-badge ${p.completo?'ok':p.actual?'current':''}`});
            }

            function activateStage(clave,avisar=true){
                const existe=document.querySelector(`.lg-stage[data-stage="${clave}"]`);
                if(!existe){if(avisar)toast('La etapa solicitada no está disponible en esta vista.','error');return false}
                document.querySelectorAll('.lg-stage').forEach(x=>x.classList.toggle('active',x.dataset.stage===clave));
                document.querySelectorAll('.lg-flow-side-item').forEach(x=>x.classList.toggle('active',x.dataset.stage===clave));
                if(clave==='documentos')cargarDocumentosModal();
                if(clave==='carga')cargarCargaFisica();
                return true;
            }
            document.querySelectorAll('[data-next-stage]').forEach(b=>b.addEventListener('click',()=>activateStage(b.dataset.nextStage,true)));
            document.getElementById('btnReprogramarFlow')?.addEventListener('click',()=>{
                if(!flujoActual?.embarqueID)return;
                if(!flujoActual.puedeReprogramar){toast('Este embarque ya inició carga física o ya no admite reprogramación.','error');return}
                document.getElementById('ahTipo').value='embarque';
                document.getElementById('ahID').value=flujoActual.embarqueID;
                document.getElementById('ahFecha').value=flujoActual.fechaCargaProgramada||'';
                document.getElementById('ahHora').value=flujoActual.horaCargaProgramada||'';
                document.getElementById('ahRowVersion').value=flujoActual.rowVersion||'';
                document.getElementById('ahObs').value='';
                document.getElementById('horaTitulo').textContent='Reprogramar embarque';
                document.getElementById('horaSub').textContent='Puedes cambiar fecha y hora mientras la carga física no haya comenzado.';
                closeModal('modalFlujo');
                openModal('modalAsignarHora');
            });

            function setRadio(name,value){
                document.querySelectorAll(`#formSalida input[name="${name}"]`).forEach(x=>x.checked=String(x.value)===String(value??''));
            }
            function fillSelect(id,items,value){
                const s=document.getElementById(id);s.innerHTML='<option value="">Selecciona...</option>';(items||[]).forEach(x=>{const o=document.createElement('option');o.value=x.id;o.textContent=x.texto;if(String(x.id)===String(value??''))o.selected=true;s.appendChild(o)});
            }
            function cargarSalidaForm(f){
                const s=f.salida||{};
                document.getElementById('fsEmbarqueID').value=f.embarqueID;
                document.getElementById('fsRowVersion').value=s.rowVersion||f.rowVersion||'';
                setRadio('TipoOperacion',s.tipoOperacion);
                setRadio('FormaEnvio',s.formaEnvio);
                document.getElementById('fsPasaAduana').value=s.tipoOperacion==='Exportacion'?'true':'';
