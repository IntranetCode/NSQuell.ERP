                    </aside>

                    <section class="lg-flow-main">
                        <div class="lg-stage" data-stage="programacion">
                            <div class="lg-stage-head">
                                <div><h3>1. Programación</h3><p>Fecha, hora y cantidad que ya forman parte del embarque.</p></div>
