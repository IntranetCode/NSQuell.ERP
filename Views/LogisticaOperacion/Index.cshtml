            document.getElementById('formCerrar')?.addEventListener('submit',async e=>{
                e.preventDefault();
                if(evidenciasEntregaDT.files.length===0){toast('Adjunta al menos una evidencia de entrega.','error');return}
                const btn=document.getElementById('btnConfirmarEntrega');
                const original=btn.innerHTML;
                const fd=new FormData(e.currentTarget);
                fd.append('__RequestVerificationToken',token);
                try{
                    btn.disabled=true;btn.innerHTML='<i class="fa-solid fa-spinner fa-spin"></i> Guardando...';
                    const r=await fetch(urlCerrar,{method:'POST',body:fd});
                    let j;try{j=await r.json()}catch{throw new Error(`El servidor respondió ${r.status} y no devolvió JSON.`)}
                    if(!r.ok||!j.ok)throw new Error(j.mensaje||'No fue posible cerrar la entrega.');
                    closeModal('modalCerrar');
                    toast(j.mensaje||'Entrega confirmada.');
                    setTimeout(()=>location.reload(),650);
                }catch(err){toast(err.message||'Error al cerrar la entrega.','error')}
                finally{btn.disabled=false;btn.innerHTML=original}
            });


            // ============================================================
            // CALENDARIO V3 - linea de tiempo real y alertas de atraso.
            // ============================================================
            function actualizarLineaTiempoReal(){
                if(document.querySelector('.lg-board')?.classList.contains('lg-month'))return;
                const ahora=new Date();
                const fechaLocal=`${ahora.getFullYear()}-${String(ahora.getMonth()+1).padStart(2,'0')}-${String(ahora.getDate()).padStart(2,'0')}`;
                const minutos=ahora.getHours()*60+ahora.getMinutes()+ahora.getSeconds()/60;
                const pct=Math.max(0,Math.min(100,(minutos/1440)*100));
                document.querySelectorAll('.lg-now-line').forEach(x=>x.remove());
                document.querySelectorAll(`[data-fecha="${fechaLocal}"].lg-client-day, [data-fecha="${fechaLocal}"].lg-unit-cell`).forEach(cell=>{
                    const line=document.createElement('div');
                    line.className='lg-now-line';
                    line.style.left=`${pct}%`;
                    cell.appendChild(line);
                });
                const todayHead=document.querySelector('.lg-day-head.today');
                if(todayHead){
                    const line=document.createElement('div');
                    line.className='lg-now-line';
                    line.style.left=`${pct}%`;
                    const label=document.createElement('span');
                    label.className='lg-now-label';
                    label.textContent=`AHORA ${String(ahora.getHours()).padStart(2,'0')}:${String(ahora.getMinutes()).padStart(2,'0')}`;
                    line.appendChild(label);
                    todayHead.appendChild(line);
                }
            }

            function actualizarAlertasEmbarquesVencidos(){
                const ahora=new Date();
                document.querySelectorAll('.lg-timed-event.emb[data-fecha][data-hora]').forEach(card=>{
                    card.classList.remove('is-overdue');
                    card.querySelector('.lg-late-hint')?.remove();
                    card.dataset.alertaAtraso='';
                    const baseTitle=card.dataset.titleBase||card.title||'';
                    card.title=baseTitle;
                    const fecha=card.dataset.fecha||'';
                    const hora=card.dataset.hora||'';
                    const estatus=(card.dataset.estatus||'').trim();
                    const puedeMover=card.dataset.puedeMover==='true';
                    if(!fecha||!hora||!estatus)return;
                    if(['En ruta','Entregado','Cancelado'].includes(estatus))return;
                    const programada=new Date(`${fecha}T${hora}:00`);
                    if(Number.isNaN(programada.getTime())||programada>=ahora)return;
                    const diffMin=Math.max(1,Math.floor((ahora-programada)/60000));
                    const retraso=diffMin>=60?`${Math.floor(diffMin/60)} h ${diffMin%60} min`:`${diffMin} min`;
                    let etiqueta='⚠ ATRASADO';
                    let detalle=`${retraso} de atraso`;
                    let titulo='HORARIO PROGRAMADO VENCIDO';
                    if(estatus==='Programado'){
                        etiqueta='⚠ REPROGRAMAR';
                        detalle=`${retraso} de atraso · el embarque aún no inicia`;
                        titulo='CARGA PROGRAMADA VENCIDA';
                    }else if(estatus==='Preparando'){
                        etiqueta='⚠ ATRASADO';
                        detalle=`${retraso} de atraso · preparación en proceso`;
                        titulo='PREPARACIÓN CON RETRASO';
                    }else if(estatus==='Preparado'){
                        etiqueta='⚠ CARGA PENDIENTE';
                        detalle=`${retraso} de atraso · listo para carga física`;
                        titulo='CARGA FÍSICA PENDIENTE';
                    }else if(estatus==='Cargando'){
                        etiqueta='⚠ CARGANDO TARDE';
                        detalle=`${retraso} de atraso · carga física en proceso`;
                        titulo='CARGA FÍSICA CON RETRASO';
                    }else if(estatus==='Cargado'){
                        etiqueta='⚠ SALIDA PENDIENTE';
                        detalle=`${retraso} desde la hora programada · embarque cargado`;
                        titulo='SALIDA DE PLANTA PENDIENTE';
                    }else{
                        return;
                    }
                    if(puedeMover&&estatus==='Programado')detalle+=' · arrastra para reprogramar';
                    else if(puedeMover&&estatus==='Preparando')detalle+=' · abre para continuar o arrastra si cambiarás la programación';
                    card.dataset.alertaAtraso=etiqueta;
                    card.classList.add('is-overdue');
                    card.title=`${baseTitle} · ${titulo}`.trim();
                    const hint=document.createElement('span');
                    hint.className='lg-late-hint';
                    hint.textContent=`⚠ ${detalle}`;
                    card.appendChild(hint);
                });
            }

            actualizarLineaTiempoReal();
            actualizarAlertasEmbarquesVencidos();
            window.setInterval(()=>{
                actualizarLineaTiempoReal();
                actualizarAlertasEmbarquesVencidos();
            },30000);

        })();
</script>
