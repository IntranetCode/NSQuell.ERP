            <div class="lg-modal-body">
                <input type="hidden" id="ahTipo" />
                <input type="hidden" id="ahID" />
                <input type="hidden" id="ahRowVersion" />
                <div class="lg-form-grid">
                    <div class="lg-field"><label>Fecha</label><input class="lg-input" type="date" id="ahFecha" required /></div>
                    <div class="lg-field"><label>Hora *</label><input class="lg-input" type="time" id="ahHora" step="60" required /></div>
                    <div class="lg-field full"><label>Observaciones</label><input class="lg-input" id="ahObs" maxlength="500" placeholder="Opcional" /></div>
