            background: repeating-linear-gradient(to right,transparent 0,transparent calc(100%/24 - 1px),rgba(130,166,209,.45) calc(100%/24 - 1px),rgba(130,166,209,.45) calc(100%/24)),#f4f9ff
        }

    .lg-unit-available {
