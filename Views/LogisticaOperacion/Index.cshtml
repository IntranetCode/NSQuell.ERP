        function activateStage(clave,avisar=true){
            const paso=(flujoActual?.pasos||[]).find(x=>x.clave===clave);
            if(paso&&!paso.disponible&&!paso.completo){if(avisar)toast(`Primero completa la etapa anterior: ${paso.titulo}.`,'error');return false}
            document.querySelectorAll('.lg-stage').forEach(x=>x.classList.toggle('active',x.dataset.stage===clave));
