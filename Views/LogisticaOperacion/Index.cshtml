    }

    .lg-month .lg-unit-row {
        min-height: 100px
    }

        .lg-month .lg-unit-row .lg-client {
            min-height: 100px
        }

    .lg-month .lg-unit-event {
        position: relative;
        left: auto;
        right: auto;
        top: auto !important;
        margin: 4px;
