            document.getElementById('formDocumentoFlow')?.addEventListener('submit',async e=>{
                e.preventDefault();
                if(!flujoActual?.embarqueID||!documentosActual)return;
                const rows=[...document.querySelectorAll('#docRequisitos [data-doc-row]')];
                if(!rows.length){toast('No hay requisitos documentales disponibles para guardar.','error');return}
                const faltantes=[];
                for(const row of rows){
                    const tieneArchivo=documentosFilaSeleccionados.has(row.dataset.docIndex);
                    const tieneActual=Boolean(row.dataset.documentoId);
                    if(row.dataset.obligatorio==='true'&&!tieneArchivo&&!tieneActual)faltantes.push(row.dataset.requisito||'Documento');
                    if(tieneArchivo&&tipoSeleccionadoFila(row)==='Remisión'){
                        const motivo=row.querySelector('[data-remision-motivo] textarea')?.value?.trim()||'';
                        if(!motivo){toast(`Captura el motivo para utilizar Remisión en ${row.dataset.requisito||'el requisito seleccionado'}.`,'error');return}
                    }
                }
                if(faltantes.length){toast(`Falta adjuntar: ${faltantes.join(', ')}.`,'error');return}
                const archivos=[...documentosFilaSeleccionados.values()];
                const pendientesExistentes=rows.filter(row=>row.dataset.documentoId&&row.dataset.documentoValidado!=='true'&&!documentosFilaSeleccionados.has(row.dataset.docIndex));
                if(!archivos.length&&!pendientesExistentes.length){
                    toast(documentosActual.documentacionCompleta?'La documentación ya está completa.':'No hay archivos nuevos por guardar.');
                    return;
                }
                const btn=document.getElementById('btnSubirDocumento');
                const original=btn.innerHTML;
                let procesados=0;
                try{
                    btn.disabled=true;
                    for(const row of rows){
                        const file=documentosFilaSeleccionados.get(row.dataset.docIndex);
                        if(file){
                            const tipo=tipoSeleccionadoFila(row);
                            if(!tipo)throw new Error(`No fue posible determinar el tipo documental de ${row.dataset.requisito||file.name}.`);
                            const observaciones=tipo==='Remisión'?(row.querySelector('[data-remision-motivo] textarea')?.value?.trim()||''):'';
                            btn.innerHTML=`<i class="fa-solid fa-spinner fa-spin"></i> Guardando ${procesados+1} de ${archivos.length+pendientesExistentes.length}...`;
                            const fd=new FormData();
                            fd.append('__RequestVerificationToken',token);
                            fd.append('embarqueId',String(flujoActual.embarqueID));
                            fd.append('tipoDocumento',tipo);
                            fd.append('observaciones',observaciones);
                            fd.append('archivo',file,file.name);
                            const r=await fetch(urlSubirDocumento,{method:'POST',headers:{'X-Requested-With':'XMLHttpRequest'},body:fd});
                            let j;try{j=await r.json()}catch{throw new Error(`El servidor respondió ${r.status} al guardar ${file.name}.`)}
                            if(!r.ok||!j.ok)throw new Error(j.mensaje||`No fue posible guardar ${file.name}.`);
                            const ids=(j.documentosIds||[j.documentoId]).filter(Boolean);
                            for(const id of ids)await validarDocumentoAutomatico(id);
                            procesados++;
                        }else if(row.dataset.documentoId&&row.dataset.documentoValidado!=='true'){
                            btn.innerHTML=`<i class="fa-solid fa-spinner fa-spin"></i> Confirmando ${procesados+1} de ${archivos.length+pendientesExistentes.length}...`;
                            await validarDocumentoAutomatico(row.dataset.documentoId);
                            procesados++;
                        }
                    }
                    limpiarDocumentosSeleccionados();
                    toast(`Documentación guardada correctamente. ${procesados} documento(s) procesado(s).`);
                    await refrescarFlujoActual('documentos');
                }catch(err){
                    toast(err.message||'No fue posible guardar la documentación.','error');
                    await cargarDocumentosModal();
                }finally{
                    btn.innerHTML=original;
                    btn.disabled=Boolean(documentosActual&&!documentosActual.puedeModificar);
                    actualizarResumenDocumentosLote();
                }
            });

