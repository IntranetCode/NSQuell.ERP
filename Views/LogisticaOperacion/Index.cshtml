@using ERP.NSQuell.Models.ViewModels.Logistica
@using System.Globalization
@model LogisticaOperacionIndexVm
@{
    Layout = "~/Views/Shared/_Layout.cshtml";
    ViewData["Title"] = "Centro Operativo de Logística";

    var cultura = new CultureInfo("es-MX");
    var dias = Model.DiasPeriodo.ToList();
    var hoy = DateTime.Today;

    string DiaCorto(DateTime f) => f.DayOfWeek switch
    {
        DayOfWeek.Monday => "LUN.",
        DayOfWeek.Tuesday => "MAR.",
        DayOfWeek.Wednesday => "MIÉ.",
        DayOfWeek.Thursday => "JUE.",
        DayOfWeek.Friday => "VIE.",
        DayOfWeek.Saturday => "SÁB.",
        DayOfWeek.Sunday => "DOM.",
        _ => f.ToString("ddd", cultura).ToUpperInvariant()
    };

    string ClaseTipo(LogisticaOperacionEventoVm e)
    {
        if (e.EsRequerimiento) return e.EsExpeditado ? "evt-release evt-expeditado" : "evt-release";
        if (e.EsProgramacion) return e.EsExpeditado ? "evt-programacion evt-expeditado" : "evt-programacion";
        return e.EsExpeditado ? $"{e.ClaseEvento} evt-expeditado" : e.ClaseEvento;
    }

    string TextoTipo(LogisticaOperacionEventoVm e)
    {
        if (e.EsRequerimiento) return "REQUERIMIENTO";
        if (e.EsProgramacion) return "PROGRAMACIÓN";
        return "EMBARQUE";
    }

    string SubtituloEvento(LogisticaOperacionEventoVm e)
    {
        if (!string.IsNullOrWhiteSpace(e.NumeroParte)) return e.NumeroParte;
        if (!string.IsNullOrWhiteSpace(e.NumeroParteResumen)) return e.NumeroParteResumen;
        return e.Folio;
    }

    double LeftEvento(LogisticaOperacionEventoVm e)
    {
        if (!e.HoraProgramada.HasValue) return 0;
        var min = e.HoraProgramada.Value.TotalMinutes;
        var pct = min / 1440d * 100d;
        return Math.Max(0d, Math.Min(94d, pct));
    }

    double LeftViaje(LogisticaOperacionUnidadEventoVm e)
    {
        var hora = e.FechaSalidaReal?.TimeOfDay ?? e.HoraSalidaProgramada;
        if (!hora.HasValue) return 0;
        var pct = hora.Value.TotalMinutes / 1440d * 100d;
        return Math.Max(0d, Math.Min(94d, pct));
    }

    string ClaseViaje(LogisticaOperacionUnidadEventoVm e) => e.ClaseEstatus;
    var columnasTiempo = Model.Vista == "Mes" ? Math.Max(1, dias.Count) : Math.Max(1, dias.Count);
}
