            font-size: 12px;
            color: var(--lg-navy);
            line-height: 1.3
        }

    .lg-doc-requirement-info > small {
        display: block;
        margin-top: 3px;
        font-size: 10px;
        color: var(--lg-muted)
    }

    .lg-doc-required-tag {
        display: inline-flex;
        align-items: center;
        border-radius: 999px;
        padding: 3px 6px;
        font-size: 8px;
        font-weight: 900
    }

        .lg-doc-required-tag.required {
            background: var(--lg-red-soft);
            color: var(--lg-red)
        }

        .lg-doc-required-tag.optional {
            background: #eef2f7;
            color: #65768a
        }

    .lg-doc-choice {
        display: flex;
        gap: 5px;
        flex-wrap: wrap;
        margin-top: 8px
    }

        .lg-doc-choice label {
            display: inline-flex;
            align-items: center;
            gap: 4px;
            min-height: 29px;
            padding: 4px 8px;
            border: 1px solid var(--lg-line);
            border-radius: 7px;
            background: #fff;
            color: var(--lg-text);
            font-size: 9px;
            font-weight: 800;
            cursor: pointer
        }

            .lg-doc-choice label:has(input:checked) {
                border-color: #8cb1db;
                background: #eef5ff;
                color: var(--lg-navy)
            }

        .lg-doc-choice input {
            accent-color: var(--lg-blue)
        }

    .lg-doc-type-fixed {
        display: inline-flex;
        align-items: center;
        gap: 5px;
        margin-top: 7px;
        padding: 4px 7px;
        border-radius: 6px;
        background: #f4f7fb;
        color: #65768a;
        font-size: 9px;
        font-weight: 800
    }

    .lg-doc-middle {
        min-width: 0
    }

    .lg-doc-current {
        display: grid;
        grid-template-columns: 34px minmax(0,1fr) auto auto auto;
        gap: 7px;
        align-items: center;
        min-height: 48px;
        padding: 7px 8px;
        border: 1px solid var(--lg-line);
        border-radius: 8px;
        background: #fff
    }

        .lg-doc-current > i {
            width: 34px;
            height: 34px;
            border-radius: 7px;
            display: flex;
            align-items: center;
            justify-content: center;
            background: #eef4fb;
            color: var(--lg-blue)
        }

        .lg-doc-current.ok {
            border-color: #b7dfcc;
            background: #f6fcf9
        }

        .lg-doc-current.pending {
            border-color: #ead09a;
            background: #fffaf0
        }

        .lg-doc-current.empty {
            grid-template-columns: 34px minmax(0,1fr);
            border-style: dashed;
            background: #fafbfd
        }

    .lg-doc-current-data {
        min-width: 0
    }

        .lg-doc-current-data strong, .lg-doc-current.empty strong {
            display: block;
            font-size: 10px;
            color: var(--lg-navy);
            white-space: nowrap;
            overflow: hidden;
            text-overflow: ellipsis
        }

        .lg-doc-current-data small, .lg-doc-current.empty small {
            display: block;
            margin-top: 2px;
            font-size: 8px;
            color: var(--lg-muted)
        }

    .lg-doc-icon-btn {
        width: 30px;
        height: 30px;
        border: 1px solid var(--lg-line);
        border-radius: 7px;
        background: #fff;
        color: var(--lg-navy);
        display: inline-flex;
        align-items: center;
        justify-content: center;
        text-decoration: none;
        cursor: pointer
    }

        .lg-doc-icon-btn.danger {
            border-color: #efc3c3;
            color: var(--lg-red);
            background: #fff8f8
        }

    .lg-doc-file-picker {
        min-height: 58px;
        border: 1px dashed #aebfd1;
        border-radius: 9px;
        background: #fafcff;
        padding: 9px;
        display: flex;
        align-items: center;
        gap: 8px;
        cursor: pointer;
        transition: .15s
    }

        .lg-doc-file-picker:hover {
