@using ERP.NSQuell.Models.ViewModels.Logistica
@using System.Globalization
@model LogisticaOperacionIndexVm
@{
    Layout = "~/Views/Shared/_Layout.cshtml";
    ViewData["Title"] = "Centro Operativo de Logística";

    var cultura = new CultureInfo("es-MX");
    var dias = Model.DiasPeriodo.ToList();
    var hoy = DateTime.Today;

    bool BanderaVista(string clave) => ViewData.TryGetValue(clave, out var valor) && valor is bool bandera && bandera;
    var permisosVistaDefinidos = ViewData.ContainsKey("EsAdministradorERP") || ViewData.ContainsKey("EsPlaneacion") || ViewData.ContainsKey("EsLogistica");
    var esAdministradorERP = BanderaVista("EsAdministradorERP");
    var esPlaneacion = BanderaVista("EsPlaneacion");
    var esLogistica = BanderaVista("EsLogistica");
    if (!permisosVistaDefinidos)
    {
        esAdministradorERP = true;
        esPlaneacion = true;
        esLogistica = true;
    }
    var puedeProgramar = esAdministradorERP || esPlaneacion;
    var puedeOperar = esAdministradorERP || esLogistica;
    var tituloVista = esAdministradorERP ? "Centro Operativo · Vista Administrador" : puedeProgramar && !puedeOperar ? "Programación de Releases" : "Centro Operativo de Logística";
    var descripcionVista = esAdministradorERP
        ? "Vista completa: Planeación programa los Releases y Logística continúa con embarques, preparación, salida, viajes y entrega."
        : puedeProgramar && !puedeOperar
            ? "Planeación visualiza únicamente Releases pendientes y su programación. La operación posterior queda reservada para Logística."
            : "Logística visualiza únicamente lo ya programado y continúa con embarques, preparación, salida, viajes y entrega.";
    var etiquetaVista = esAdministradorERP ? "ADMINISTRADOR" : puedeProgramar && !puedeOperar ? "PLANEACIÓN" : "LOGÍSTICA";

    bool EventoVisible(LogisticaOperacionEventoVm e)
    {
        if (esAdministradorERP) return true;
        if (puedeProgramar && e.EsRequerimiento) return true;
        if (puedeOperar && (e.EsProgramacion || e.EsEmbarque)) return true;
        return false;
    }

    long PiezasEventoVisible(LogisticaOperacionEventoVm e)
    {
        if (e.EsRequerimiento) return Math.Max(0, e.CantidadPendienteProgramar);
        if (e.EsProgramacion) return Math.Max(0, e.CantidadProgramada - e.CantidadGenerada);
        return Math.Max(0, e.TotalPiezas);
    }

    DateTime FechaVisualViaje(LogisticaOperacionUnidadEventoVm e)
    {
        var fecha = (e.FechaSalidaReal ?? e.FechaProgramada).Date;
        if (dias.Count > 0 && string.Equals(e.Estatus, "En curso", StringComparison.OrdinalIgnoreCase) && fecha < dias[0].Date && (!e.FechaRegresoReal.HasValue || e.FechaRegresoReal.Value.Date >= dias[0].Date)) return dias[0].Date;
        return fecha;
    }

    var clientesVisibles = Model.Clientes.Where(c => c.Eventos.Any(EventoVisible)).ToList();
    var eventosVisibles = clientesVisibles.SelectMany(c => c.Eventos.Where(EventoVisible)).ToList();
    var totalClientesVisibles = clientesVisibles.Count;
    var totalRequerimientosVisibles = eventosVisibles.Count(x => x.EsRequerimiento);
    var totalProgramacionesVisibles = eventosVisibles.Count(x => x.EsProgramacion);
    var totalEmbarquesVisibles = eventosVisibles.Count(x => x.EsEmbarque);
    var totalPiezasVisibles = eventosVisibles.Sum(PiezasEventoVisible);

    string DiaCorto(DateTime f) => f.DayOfWeek switch
    {
        DayOfWeek.Monday => "LUN.",
        DayOfWeek.Tuesday => "MAR.",
        DayOfWeek.Wednesday => "MIÉ.",
        DayOfWeek.Thursday => "JUE.",
        DayOfWeek.Friday => "VIE.",
        DayOfWeek.Saturday => "SÁB.",
        DayOfWeek.Sunday => "DOM.",
        _ => f.ToString("ddd", cultura).ToUpperInvariant()
    };

    string ClaseTipo(LogisticaOperacionEventoVm e)
    {
        if (e.EsRequerimiento) return e.EsExpeditado ? "evt-release evt-expeditado" : "evt-release";
        if (e.EsProgramacion) return e.EsExpeditado ? "evt-programacion evt-expeditado" : "evt-programacion";
        return e.EsExpeditado ? $"{e.ClaseEvento} evt-expeditado" : e.ClaseEvento;
    }

    string TextoTipo(LogisticaOperacionEventoVm e)
    {
        if (e.EsRequerimiento) return "REQUERIMIENTO";
        if (e.EsProgramacion) return "PROGRAMACIÓN";
        return "EMBARQUE";
    }

    string SubtituloEvento(LogisticaOperacionEventoVm e)
    {
        if (!string.IsNullOrWhiteSpace(e.NumeroParte)) return e.NumeroParte;
        if (!string.IsNullOrWhiteSpace(e.NumeroParteResumen)) return e.NumeroParteResumen;
        return e.Folio;
    }

    double LeftEvento(LogisticaOperacionEventoVm e)
    {
        if (!e.HoraProgramada.HasValue) return 0;
        var min = e.HoraProgramada.Value.TotalMinutes;
        var pct = min / 1440d * 100d;
        return Math.Max(0d, Math.Min(94d, pct));
    }

    double LeftViaje(LogisticaOperacionUnidadEventoVm e)
    {
        var hora = e.FechaSalidaReal?.TimeOfDay ?? e.HoraSalidaProgramada;
        if (!hora.HasValue) return 0;
        var pct = hora.Value.TotalMinutes / 1440d * 100d;
        return Math.Max(0d, Math.Min(94d, pct));
    }

    string ClaseViaje(LogisticaOperacionUnidadEventoVm e) => e.ClaseEstatus;
    var columnasTiempo = Model.Vista == "Mes" ? Math.Max(1, dias.Count) : Math.Max(1, dias.Count);
}
@Html.AntiForgeryToken()

