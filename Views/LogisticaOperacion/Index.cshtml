                const d=document.createElement('div');d.className=`lg-step ${cls}`;d.innerHTML=`<div class="lg-step-dot"><i class="fa-solid ${esc(p.icono||'fa-circle')}"></i></div><div class="lg-step-title">${esc(p.numero)}. ${esc(p.titulo)}</div><div class="lg-step-state">${esc(p.estadoTexto)}</div>`;top.appendChild(d);
                const s=document.createElement('div');s.className=`lg-flow-side-item ${p.completo?'complete':''} ${p.actual?'active':''} ${!p.disponible&&!p.completo?'blocked':''}`;s.dataset.stage=p.clave;s.innerHTML=`<strong>${esc(p.numero)}. ${esc(p.titulo)}</strong><span>${esc(p.descripcion)}</span>`;if(p.disponible||p.completo)s.addEventListener('click',()=>activateStage(p.clave));side.appendChild(s);
