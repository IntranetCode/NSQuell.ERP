                    <tbody id="dayReqBody"></tbody>
                </table>
            </section>

            <section class="lg-day-list" data-day-list="programaciones">
                <table class="lg-day-table">
                    <thead><tr><th>Programación</th><th>Release / Parte</th><th>Día definido</th><th>Pendiente</th><th>Estatus</th><th style="width:135px">Acción logística</th></tr></thead>
                    <tbody id="dayProgBody"></tbody>
                </table>
            </section>

            <section class="lg-day-list" data-day-list="embarques">
                <table class="lg-day-table">
                    <thead><tr><th>Embarque</th><th>Parte / Cliente</th><th>Fecha / Hora</th><th>Piezas</th><th>Estatus</th><th style="width:110px">Acción</th></tr></thead>
                    <tbody id="dayEmbBody"></tbody>
                </table>
            </section>
        </div>
        <div class="lg-modal-foot">
            <button class="lg-btn" type="button" data-close="modalClienteDia">Cerrar</button>
        </div>
    </div>
</div>



