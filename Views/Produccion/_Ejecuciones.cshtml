<div class="ejec-panel" id="panelEjecucionesOperativo">
    <div class="ejec-toolbar">
        <div class="ejec-toolbar-top">
            <div>
                <h3 class="ejec-title">
                    <i class="bi bi-activity"></i>
                    Ejecuciones de producción
                </h3>
                <div class="ejec-sub">
                    Estado actual de cada máquina considerando Producción, Calidad, paros y reliberaciones.
                </div>
            </div>
            <div class="ejec-visible-count">
                <i class="bi bi-list-ul"></i>
                <span class="js-ejec-visible-number">@totalOperativas</span>
                visible(s)
            </div>
        </div>

        <div class="ejec-tabs">
            <button type="button"
                    class="ejec-tab is-active"
                    data-filtro-operativo="TODAS">
                <i class="bi bi-lightning-charge"></i>
                Operativas
                <span class="ejec-tab-count">@totalOperativas</span>
            </button>

            <button type="button"
                    class="ejec-tab"
                    data-filtro-operativo="PREPARACION">
                <i class="bi bi-tools"></i>
                Preparación
                <span class="ejec-tab-count">@totalPreparacion</span>
            </button>

            <button type="button"
                    class="ejec-tab tab-calidad"
                    data-filtro-operativo="CALIDAD">
                <i class="bi bi-shield-check"></i>
                Esperando Calidad
                <span class="ejec-tab-count">@totalCalidad</span>
            </button>

            <button type="button"
                    class="ejec-tab tab-liberada"
                    data-filtro-operativo="LIBERADA_CALIDAD">
                <i class="bi bi-patch-check"></i>
                Liberadas por Calidad
                <span class="ejec-tab-count">@totalLiberadasCalidad</span>
            </button>

            <button type="button"
                    class="ejec-tab"
                    data-filtro-operativo="PRODUCIENDO">
                <i class="bi bi-play-circle"></i>
                Produciendo
                <span class="ejec-tab-count">@totalProduciendo</span>
            </button>

            <button type="button"
                    class="ejec-tab tab-pausada"
                    data-filtro-operativo="PAUSADA">
                <i class="bi bi-pause-circle"></i>
                Pausadas
                <span class="ejec-tab-count">@totalPausadas</span>
            </button>

            <button type="button"
                    class="ejec-tab tab-reliberacion"
                    data-filtro-operativo="RELIBERACION">
                <i class="bi bi-arrow-repeat"></i>
                Reliberación
                <span class="ejec-tab-count">@totalReliberacion</span>
            </button>

            <button type="button"
                    class="ejec-tab tab-liberada-maquina"
                    data-filtro-operativo="MAQUINA_LIBERADA">
                <i class="bi bi-unlock"></i>
                Máquina liberada
                <span class="ejec-tab-count">@totalMaquinasLiberadas</span>
            </button>
        </div>
    </div>

    @if (!grupos.Any())
    {
        <div class="ejec-empty">
            <div class="ejec-empty-icon">
                <i class="bi bi-inbox"></i>
            </div>
            <div class="ejec-empty-title">Sin ejecuciones para mostrar</div>
            <div class="ejec-empty-text">
                No existen ejecuciones operativas que coincidan con los filtros seleccionados.
            </div>
        </div>
    }
    else
    {
        <div class="ejec-empty js-ejec-empty-filter" style="display:none;">
            <div class="ejec-empty-icon">
                <i class="bi bi-funnel"></i>
            </div>
            <div class="ejec-empty-title">Sin registros en este estado</div>
            <div class="ejec-empty-text">
                No hay máquinas que actualmente coincidan con el estado operativo seleccionado.
            </div>
        </div>

        @foreach (var grupo in grupos)
        {
            <section class="ejec-machine js-ejec-machine">
                <div class="ejec-machine-head">
                    <div>
                        <span class="ejec-machine-code">
                            <i class="bi bi-hdd-network me-1"></i>
                            @grupo.Key.Codigo
                        </span>

                        @if (!string.IsNullOrWhiteSpace(grupo.Key.Nombre))
                        {
                            <span class="ejec-machine-name">
                                @grupo.Key.Nombre
                            </span>
                        }
                    </div>

                    <div class="ejec-machine-count">
                        <i class="bi bi-gear"></i>
                        <span class="js-machine-visible-count">@grupo.Count()</span>
                        ejecución(es)
                    </div>
                </div>

                <div class="ejec-table-wrap">
                    <table class="ejec-table">
                        <colgroup>
                            <col style="width:95px;" />
                            <col style="width:210px;" />
                            <col style="width:105px;" />
                            <col style="width:145px;" />
                            <col style="width:125px;" />
                            <col style="width:105px;" />
                            <col style="width:82px;" />
                            <col style="width:72px;" />
                            <col style="width:82px;" />
                            <col style="width:72px;" />
                            <col style="width:135px;" />
                            <col style="width:240px;" />
                            <col style="width:86px;" />
                        </colgroup>

                        <thead>
                            <tr>
                                <th>Programa / OF</th>
                                <th>Parte</th>
                                <th>Molde</th>
                                <th>Operador</th>
                                <th>Inicio real</th>
                                <th>Planeado</th>
                                <th>OK</th>
                                <th>Sosp.</th>
                                <th>Scrap</th>
                                <th>Pend.</th>
                                <th>Avance</th>
                                <th>Estado operativo</th>
                                <th></th>
                            </tr>
                        </thead>

                        <tbody>
                            @foreach (var item in grupo
                                                .OrderBy(x => x.EstadoOperativoPrioridad)
                                                .ThenBy(x => x.ProgramaProduccionID)
                                                .ThenBy(x => x.EjecucionProduccionID))
                            {
                                var avance = item.PorcentajeAvance;

                                if (avance < 0)
                                    avance = 0;

                                if (avance > 100)
                                    avance = 100;

                                var avanceCss = avance.ToString(
                                "0.##",
                                System.Globalization.CultureInfo.InvariantCulture);

                                var categoria = CategoriaOperativa(item);
                                var esOperativa = item.EsOperacionActiva ? "1" : "0";

                                <tr class="@ClaseFila(item.EstadoOperativoClave) js-ejec-row"
                                    data-categoria-operativa="@categoria"
                                    data-es-operativa="@esOperativa">
                                    <td>
                                        <span class="ejec-programa">
                                            Programa @item.ProgramaProduccionID
                                        </span>

                                        @if (item.SolicitudProduccionID.HasValue)
                                        {
                                            <span class="ejec-small">
                                                OF @item.SolicitudProduccionID
                                            </span>
                                        }

                                        @if (item.ReleaseID.HasValue)
                                        {
                                            <span class="ejec-small">
                                                Rel. @item.ReleaseID
                                            </span>
                                        }
                                </td>

                                <td title="@Txt(item.DescripcionParte)">
                                    <div class="ejec-parte">
                                        @Txt(item.TituloPrograma)
                                    </div>
                                    <span class="ejec-desc">
                                        @Txt(item.DescripcionParte)
                                    </span>
                                </td>

                                <td>
                                    @(string.IsNullOrWhiteSpace(item.MoldeCodigo)
                                                                ? "-"
                                                                : item.MoldeCodigo)
                        </td>

                                    <td title="@item.TextoOperador">
                                        <div class="ejec-parte">
                                            @item.TextoOperador
                                        </div>

                            @if (!string.IsNullOrWhiteSpace(item.OperadorAuxiliarNombre))
                                        {
                                            <span class="ejec-small">
                                                Aux: @item.OperadorAuxiliarNombre
                                            </span>
                                        }
                                    </td>

                                    <td>
                                        @Fecha(item.FechaInicioReal)
                                    </td>

                                    <td class="ejec-num">
                                        @Num(item.CantidadPlaneada)
                                    </td>

                                    <td class="ejec-num ok">
                                        @item.CantidadOKTotal.ToString("N0")
                                    </td>

                                    <td class="ejec-num sos">
                                        @item.CantidadSospechosaTotal.ToString("N0")
                                    </td>

                                    <td class="ejec-num scrap">
                                        @item.CantidadScrapTotal.ToString("N0")
                                    </td>

                                    <td class="ejec-num">
                                        @item.CantidadPendiente.ToString("N0")
                                    </td>

                                    <td>
                                        <div class="ejec-avance">
                                            <div class="ejec-avance-top">
                                                <span>@item.PorcentajeAvance.ToString("0.##")%</span>
                                                <span>
                                                    @item.CantidadOKTotal.ToString("N0")/@Num(item.CantidadPlaneada)
                                                </span>
                                            </div>

                                            <div class="ejec-progress">
                                                <span style="width:@avanceCss%"></span>
                                            </div>
                                        </div>
                                    </td>

                                    <td>
                                        <div class="ejec-status-wrap">
                                            <span class="ejec-status @item.EstadoOperativoClase">
                                                <i class="bi @IconoEstado(item.EstadoOperativoClave)"></i>
                                                @item.EstadoOperativoNombre
                                            </span>

                                            @if (!string.IsNullOrWhiteSpace(item.EstadoOperativoDescripcion))
                                            {
                                                <span class="ejec-status-detail">
                                                    @item.EstadoOperativoDescripcion
                                                </span>
                                            }
                                        </div>
                                    </td>

                                    <td class="ejec-action">
                                        <a href="@Url.Action("Detalle", "Produccion", new { id = item.EjecucionProduccionID })"
                                           class="btn btn-sm btn-outline-primary"
                                           title="Abrir ejecución">
                                            <i class="bi bi-eye"></i>
                                            Abrir
                                        </a>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </section>
        }
    }
</div>

<script>
    (function () {
        const panel = document.getElementById('panelEjecucionesOperativo');

        if (!panel)
            return;

        const tabs = Array.from(
            panel.querySelectorAll('[data-filtro-operativo]')
        );

        const rows = Array.from(
            panel.querySelectorAll('.js-ejec-row')
        );

        const machines = Array.from(
            panel.querySelectorAll('.js-ejec-machine')
        );

        const visibleNumber =
            panel.querySelector('.js-ejec-visible-number');

        const emptyFilter =
            panel.querySelector('.js-ejec-empty-filter');

        function aplicarFiltro(filtro) {
            let totalVisible = 0;

            rows.forEach(function (row) {
                const categoria =
                    row.getAttribute('data-categoria-operativa');

                const esOperativa =
                    row.getAttribute('data-es-operativa') === '1';

                let mostrar = false;

                if (filtro === 'TODAS') {
                    mostrar = esOperativa;
                } else {
                    mostrar = categoria === filtro;
                }

                row.style.display = mostrar ? '' : 'none';

                if (mostrar)
                    totalVisible++;
            });

            machines.forEach(function (machine) {
                const machineRows = Array.from(
                    machine.querySelectorAll('.js-ejec-row')
                );

                const visiblesMaquina =
                    machineRows.filter(function (row) {
                        return row.style.display !== 'none';
                    }).length;

                machine.style.display =
                    visiblesMaquina > 0 ? '' : 'none';

                const contador =
                    machine.querySelector('.js-machine-visible-count');

                if (contador)
                    contador.textContent = visiblesMaquina.toString();
            });

            tabs.forEach(function (tab) {
                tab.classList.toggle(
                    'is-active',
                    tab.getAttribute('data-filtro-operativo') === filtro
                );
            });

            if (visibleNumber)
                visibleNumber.textContent = totalVisible.toString();

            if (emptyFilter)
                emptyFilter.style.display =
                    totalVisible === 0 ? '' : 'none';
        }

        tabs.forEach(function (tab) {
            tab.addEventListener('click', function () {
                const filtro =
                    tab.getAttribute('data-filtro-operativo') || 'TODAS';

                aplicarFiltro(filtro);
            });
        });

        aplicarFiltro('TODAS');
    })();
</script>