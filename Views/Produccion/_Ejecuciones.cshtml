@model ERP.NSQuell.Models.ProduccionBandejaVm

@{
    Layout = null;

    static string Txt(string? value)
    {
        return string.IsNullOrWhiteSpace(value) ? "-" : value.Trim();
    }

    static string Num(int? value)
    {
        return value.HasValue ? value.Value.ToString("N0") : "-";
    }

    static string Fecha(DateTime? value)
    {
        return value.HasValue ? value.Value.ToString("dd/MM/yyyy HH:mm") : "-";
    }

    static string CategoriaOperativa(ERP.NSQuell.Models.ProduccionEjecucionVm item)
    {
        if (item.EstadoOperativoClave == ERP.NSQuell.Models.ProduccionEstadoOperativo.MaquinaLiberada)
            return "MAQUINA_LIBERADA";

        if (item.EstadoOperativoClave == ERP.NSQuell.Models.ProduccionEstadoOperativo.ReliberacionPendiente ||
            item.EstadoOperativoClave == ERP.NSQuell.Models.ProduccionEstadoOperativo.ReliberacionRechazada ||
            item.EstadoOperativoClave == ERP.NSQuell.Models.ProduccionEstadoOperativo.ReliberacionAutorizada)
            return "RELIBERACION";

        if (item.EstadoOperativoClave == ERP.NSQuell.Models.ProduccionEstadoOperativo.EsperandoCalidad ||
            item.EstadoOperativoClave == ERP.NSQuell.Models.ProduccionEstadoOperativo.PrimerasPiezas)
            return "CALIDAD";

        if (item.EstadoOperativoClave == ERP.NSQuell.Models.ProduccionEstadoOperativo.LiberadaCalidad)
            return "LIBERADA_CALIDAD";

        if (item.EstadoOperativoClave == ERP.NSQuell.Models.ProduccionEstadoOperativo.Produciendo)
            return "PRODUCIENDO";

        if (item.EstadoOperativoClave == ERP.NSQuell.Models.ProduccionEstadoOperativo.Pausada)
            return "PAUSADA";

        return "PREPARACION";
    }

    static string ClaseFila(string clave)
    {
        if (clave == ERP.NSQuell.Models.ProduccionEstadoOperativo.Produciendo)
            return "ejec-row-produccion";

        if (clave == ERP.NSQuell.Models.ProduccionEstadoOperativo.Pausada)
            return "ejec-row-pausada";

        if (clave == ERP.NSQuell.Models.ProduccionEstadoOperativo.EsperandoCalidad ||
            clave == ERP.NSQuell.Models.ProduccionEstadoOperativo.PrimerasPiezas)
            return "ejec-row-calidad";

        if (clave == ERP.NSQuell.Models.ProduccionEstadoOperativo.LiberadaCalidad)
            return "ejec-row-liberada";

        if (clave == ERP.NSQuell.Models.ProduccionEstadoOperativo.ReliberacionPendiente)
            return "ejec-row-reliberacion";

        if (clave == ERP.NSQuell.Models.ProduccionEstadoOperativo.ReliberacionRechazada)
            return "ejec-row-rechazada";

        if (clave == ERP.NSQuell.Models.ProduccionEstadoOperativo.ReliberacionAutorizada)
            return "ejec-row-reliberacion-ok";

        if (clave == ERP.NSQuell.Models.ProduccionEstadoOperativo.AjustesCalidad)
            return "ejec-row-ajustes";

        if (clave == ERP.NSQuell.Models.ProduccionEstadoOperativo.MaquinaLiberada)
            return "ejec-row-maquina-liberada";

        if (clave == ERP.NSQuell.Models.ProduccionEstadoOperativo.Pendiente)
            return "ejec-row-pendiente";

        return "ejec-row-preparacion";
    }

    static string IconoEstado(string clave)
    {
        if (clave == ERP.NSQuell.Models.ProduccionEstadoOperativo.Produciendo)
            return "bi-play-circle-fill";

        if (clave == ERP.NSQuell.Models.ProduccionEstadoOperativo.Pausada)
            return "bi-pause-circle-fill";

        if (clave == ERP.NSQuell.Models.ProduccionEstadoOperativo.EsperandoCalidad)
            return "bi-hourglass-split";

        if (clave == ERP.NSQuell.Models.ProduccionEstadoOperativo.PrimerasPiezas)
            return "bi-search";

        if (clave == ERP.NSQuell.Models.ProduccionEstadoOperativo.ArranqueControlado)
            return "bi-speedometer2";

        if (clave == ERP.NSQuell.Models.ProduccionEstadoOperativo.LiberadaCalidad)
            return "bi-patch-check-fill";

        if (clave == ERP.NSQuell.Models.ProduccionEstadoOperativo.ReliberacionPendiente)
            return "bi-arrow-repeat";

        if (clave == ERP.NSQuell.Models.ProduccionEstadoOperativo.ReliberacionRechazada)
            return "bi-x-octagon-fill";

        if (clave == ERP.NSQuell.Models.ProduccionEstadoOperativo.ReliberacionAutorizada)
            return "bi-check-circle-fill";

        if (clave == ERP.NSQuell.Models.ProduccionEstadoOperativo.AjustesCalidad)
            return "bi-exclamation-triangle-fill";

        if (clave == ERP.NSQuell.Models.ProduccionEstadoOperativo.MaquinaLiberada)
            return "bi-unlock-fill";

        if (clave == ERP.NSQuell.Models.ProduccionEstadoOperativo.Pendiente)
            return "bi-clock";

        return "bi-tools";
    }

    var todas = Model.Ejecuciones
        .Where(x => x.EsOperacionActiva || x.MaquinaLiberada)
        .OrderBy(x => string.IsNullOrWhiteSpace(x.MaquinaCodigo) ? "ZZZ" : x.MaquinaCodigo)
        .ThenBy(x => x.EstadoOperativoPrioridad)
        .ThenBy(x => x.ProgramaProduccionID)
        .ThenBy(x => x.EjecucionProduccionID)
        .ToList();

    var grupos = todas
        .GroupBy(x => new
        {
            MaquinaID = x.MaquinaID ?? 0,
            Codigo = string.IsNullOrWhiteSpace(x.MaquinaCodigo)
                ? "SIN MÁQUINA"
                : x.MaquinaCodigo!.Trim(),
            Nombre = string.IsNullOrWhiteSpace(x.MaquinaNombre)
                ? ""
                : x.MaquinaNombre!.Trim()
        })
        .OrderBy(x => x.Key.Codigo)
        .ToList();

    var totalOperativas = todas.Count(x => x.EsOperacionActiva);
    var totalPreparacion = todas.Count(x => x.EsOperacionActiva && x.EsPreparacionOperativa);
    var totalCalidad = todas.Count(x => x.EsOperacionActiva && x.EsEsperandoCalidad);
    var totalLiberadasCalidad = todas.Count(x => x.EsOperacionActiva && x.EsLiberadaPorCalidad);
    var totalProduciendo = todas.Count(x => x.EsOperacionActiva && x.EsProduciendo);
    var totalPausadas = todas.Count(x => x.EsOperacionActiva && x.EsPausada);
    var totalReliberacion = todas.Count(x => x.EsOperacionActiva && x.EsReliberacion);
    var totalMaquinasLiberadas = todas.Count(x => x.MaquinaLiberada);
}

