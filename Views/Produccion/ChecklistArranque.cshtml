<body>
    <div class="page">
        <section class="hero">
            <div class="d-flex justify-content-between align-items-start flex-wrap gap-3">
                <div>
                    <h1 class="hero-title"><i class="bi @IconoFormato(Model.TipoChecklist) me-2"></i>@Model.TituloChecklist</h1>
                    <div class="hero-sub">
                        @Model.TextoFormato · OF @(Model.SolicitudProduccionID?.ToString() ?? "-") @if(Model.TurnoID.HasValue){
                        <text> · Turno @Model.TextoTurno</text>
                                                }
                    </div>
                </div>
                <a href="@Url.Action("Detalle", "Produccion", new { id = Model.EjecucionProduccionID })" class="btn-hero"><i class="bi bi-arrow-left"></i>Volver a producción</a>
            </div>
        </section>

        @if (TempData["Success"] != null)
        {
            <div class="alert alert-success alert-dismissible fade show">@TempData["Success"]<button type="button" class="btn-close" data-bs-dismiss="alert"></button></div>
        }
        @if (TempData["Error"] != null)
        {
            <div class="alert alert-danger alert-dismissible fade show">@TempData["Error"]<button type="button" class="btn-close" data-bs-dismiss="alert"></button></div>
        }



        <div class="layout">
            <aside>
                <div class="panel">
                    <div class="panel-head"><i class="bi bi-info-circle me-1"></i>Datos del checklist</div>
                    <div class="panel-body">
                        <div class="data-row"><div class="data-k">Checklist</div><div class="data-v">@Model.ChecklistArranqueID</div></div>
                        <div class="data-row"><div class="data-k">Formato</div><div class="data-v">@Model.TextoFormato</div></div>
                        <div class="data-row"><div class="data-k">Tipo</div><div class="data-v">@Txt(Model.TipoChecklist)</div></div>
                        <div class="data-row"><div class="data-k">Fecha</div><div class="data-v">@Model.FechaChecklist.ToString("dd/MM/yyyy HH:mm")</div></div>
                        @if (Model.TurnoID.HasValue)
                        {
                            <div class="data-row"><div class="data-k">Turno</div><div class="data-v">@Model.TextoTurno</div></div>
                        }
                        <div class="data-row"><div class="data-k">Máquina</div><div class="data-v">@Txt(Model.MaquinaCodigo)<div class="text-muted small">@Txt(Model.MaquinaNombre)</div></div></div>
                        <div class="data-row"><div class="data-k">Molde</div><div class="data-v">@Txt(Model.MoldeCodigo)</div></div>
                        <div class="data-row"><div class="data-k">Parte</div><div class="data-v">@Model.TextoParte<div class="text-muted small">@Txt(Model.DescripcionParte)</div></div></div>
                        <div class="data-row"><div class="data-k">Estatus</div><div class="data-v"><span class="badge @Model.EstatusClase">@Model.EstatusNombre</span></div></div>
                    </div>
                </div>
                <div class="panel">
                    <div class="panel-head"><i class="bi bi-graph-up me-1"></i>Avance</div>
                    <div class="panel-body">
                        <div class="d-flex justify-content-between mb-1"><strong class="text-primary" id="txtPorcentaje">@porcentajeAvance.ToString("0.##")%</strong><span class="text-muted"><span id="txtConfirmadas">@totalRespondidas</span> / @totalPreguntas</span></div>
                        <div class="progress mb-3"><div id="barraAvance" class="progress-bar" style="width:@porcentajeAvance.ToString("0.##", System.Globalization.CultureInfo.InvariantCulture)%"></div></div>
                        <div class="note mb-0"><i class="bi bi-toggle-on me-1"></i>El switch inicia en OK. Al apagarlo se registra NOK. También puedes marcar N/A.</div>
                    </div>
                </div>
            </aside>

            <main>
                <form method="post" action="@Url.Action("GuardarChecklistArranque", "Produccion")" id="formChecklist">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="ChecklistArranqueID" value="@Model.ChecklistArranqueID" />
                    <input type="hidden" name="EjecucionProduccionID" value="@Model.EjecucionProduccionID" />
                    <input type="hidden" id="EnviarACalidad" name="EnviarACalidad" value="false" />

                    <div class="note"><i class="bi bi-info-circle me-1"></i>Cada verificación inicia en OK. Apaga el switch para registrar NOK o marca N/A. En ambos casos deberás capturar una observación.</div>

                    @{
                        var index = 0;
                    }
                    @foreach (var seccion in seccionesProduccion)
                    {
                        var preguntas = seccion.Preguntas.Where(x => x.Activo && !x.EsPreguntaCalidad).OrderBy(x => x.OrdenPregunta).ThenBy(x => x.PreguntaID).ToList();
                        if (preguntas.Count == 0) { continue; }
                        <section class="section-card check-section">
                            <div class="section-head">
                                <div><div class="section-title"><i class="bi bi-list-check me-2 text-primary"></i>@seccion.Seccion</div></div>
                                <div class="d-flex gap-2 flex-wrap">
                                    <span class="pill"><i class="bi bi-check-circle"></i><span class="contador-seccion">@seccion.TotalRespondidas / @seccion.TotalPreguntas</span></span>@if(seccion.TotalNOK > 0){
                                    <span class="pill text-danger"><i class="bi bi-x-circle"></i>@seccion.TotalNOK NOK</span>
                                }
                            </div>
                        </div>

                        @foreach (var pregunta in preguntas)
                        {
                            var prefix = $"Respuestas[{index}]";
                            var resultado = ResultadoActual(pregunta.Resultado);
                            if (string.IsNullOrWhiteSpace(resultado)) { resultado = "OK"; }
                            <div class="question pregunta-row" data-row data-requiere-nok="@(pregunta.RequiereObservacionSiNOK.ToString().ToLowerInvariant())" data-requiere-na="@(pregunta.RequiereObservacionSiNA.ToString().ToLowerInvariant())" data-requiere-valor="@(pregunta.RequiereCapturarValor.ToString().ToLowerInvariant())">
                                <div><div class="num">@pregunta.OrdenPregunta</div></div>
                                <div>
                                    <div class="question-text">@pregunta.TextoPregunta</div>
                                    @if (pregunta.RequiereCapturarValor)
                                    {
                                        <div class="question-meta">
                                            <span class="pill text-primary"><i class="bi bi-input-cursor-text"></i>Valor requerido</span>
                                        </div>
                                    }
                                </div>
                                <div class="answer-box">
                                    <input type="hidden" name="@(prefix + ".ChecklistArranqueDetalleID")" value="@pregunta.ChecklistArranqueDetalleID" />
                                    <input type="hidden" name="@(prefix + ".PreguntaID")" value="@pregunta.PreguntaID" />
                                    <input type="hidden" class="confirmado-hidden" name="@(prefix + ".Confirmado")" value="@pregunta.Confirmado.ToString().ToLowerInvariant()" />
                                    @if (puedeEditar)
                                    {
                                        var esNA = resultado == "NA";
                                        var esOK = resultado != "NOK" && !esNA;
                                        <input type="hidden" class="resultado-hidden" name="@(prefix + ".Resultado")" value="@(esNA ? "NA" : esOK ? "OK" : "NOK")" />
                                        <div class="status-controls">
                                            <label class="ok-control">
                                                <input type="checkbox" class="form-check-input switch-ok" role="switch" @(esOK ? "checked" : "") @(esNA ? "disabled" : "") />
                                                <span class="status-text estado-switch">@(esOK ? "OK" : esNA ? "N/A" : "NOK")</span>
                                            </label>
                                            <label class="na-control">
                                                <input type="checkbox" class="form-check-input na-check" @(esNA ? "checked" : "") />
                                                <span>No aplica</span>
                                            </label>
                                        </div>
                                        <div class="status-help">Encendido = OK · Apagado = NOK · N/A deshabilita el switch.</div>
                                        @if (pregunta.RequiereCapturarValor)
                                        {
                                            <div class="extra-field">
                                                <label class="form-label fw-bold small">
                                                    Valor capturado @if(!string.IsNullOrWhiteSpace(pregunta.Unidad)){
                                                    <text>(@pregunta.Unidad)</text>
                                                }
                                            </label><input type="text" class="form-control valor-capturado" name="@(prefix + ".ValorCapturado")" maxlength="100" value="@pregunta.ValorCapturado" placeholder="Captura el valor real" />
                                        </div>
                                        @if (!string.IsNullOrWhiteSpace(pregunta.Especificacion) || !string.IsNullOrWhiteSpace(pregunta.Tolerancia))
                                        {
                                            <div class="small text-muted mt-1">Especificación: @Txt(pregunta.Especificacion) · Tolerancia: @Txt(pregunta.Tolerancia)</div>
                                        }
                                    }
                                    <div class="obs-wrap"><label class="form-label fw-bold small">Observación obligatoria</label><textarea class="form-control observacion" name="@(prefix + ".Observaciones")" maxlength="500" rows="2" placeholder="Indica por qué no cumple o por qué no aplica">@pregunta.Observaciones</textarea></div>
                                }
                                                                else
                                {
                                    <div><span class="@BadgeResultado(pregunta)">@TextoResultado(pregunta)</span></div>
                                    @if (!string.IsNullOrWhiteSpace(pregunta.ValorCapturado))
                                    {
                                        <div class="mt-2"><strong>Valor:</strong> @pregunta.ValorCapturado @pregunta.Unidad</div>
                                    }
                                    @if (!string.IsNullOrWhiteSpace(pregunta.Observaciones))
                                    {
                                        <div class="mt-2 text-muted">@pregunta.Observaciones</div>
                                    }
                                }
                            </div>
                        </div>
                        index++;
                                                }
                    </section>
                                        }

                    <div class="panel"><div class="panel-head"><i class="bi bi-chat-left-text me-1"></i>Observaciones generales</div><div class="panel-body"><textarea name="ObservacionesGenerales" class="form-control" rows="4" maxlength="1000" @(puedeEditar ? "" : "readonly")>@Model.ObservacionesGenerales</textarea></div></div>

                    <div class="sticky-actions">
                        <div class="d-flex justify-content-between gap-2 flex-wrap">
                            <a href="@Url.Action("Detalle", "Produccion", new { id = Model.EjecucionProduccionID })" class="btn btn-light btn-strong"><i class="bi bi-arrow-left me-1"></i>Volver</a>
                            @if (puedeEditar)
                            {
                                <div class="d-flex gap-2 flex-wrap">
                                    <button type="button" id="btnGuardar" class="btn btn-primary btn-strong"><i class="bi bi-save me-1"></i>Guardar checklist</button>
                                    @if (esArranqueLiberacion)
                                    {
                                        <button type="button" id="btnEnviarCalidad" class="btn btn-success btn-strong"><i class="bi bi-send-check me-1"></i>Enviar a Calidad</button>
                                    }
                                </div>
                            }
                            else
                            {

                                <span class="pill"><i class="bi bi-lock"></i>Checklist bloqueado para edición</span>
                            }
                        </div>
                    </div>
                </form>

                @if (esMonitoreoPerifericos)
                {
                    <section class="section-card">
                        <div class="section-head"><div><div class="section-title"><i class="bi bi-exclamation-triangle me-2 text-warning"></i>Problemas durante el turno</div><div class="section-meta">Registra una fila por cada falla detectada. Puedes actualizarla cuando se determine la causa o la solución.</div></div><span class="pill">@(Model.ProblemasPerifericos?.Count ?? 0) registros</span></div>
                        <div class="panel-body">
                            @if (puedeEditar)
                            {
                                <form method="post" action="@Url.Action("GuardarProblemaPerifericos", "Produccion")" class="mb-4">
                                    @Html.AntiForgeryToken()
                                    <input type="hidden" name="ChecklistArranqueID" value="@Model.ChecklistArranqueID" />
                                    <input type="hidden" name="MonitoreoPerifericoProblemaID" value="0" />
                                    <div class="row g-3">
                                        <div class="col-12"><label class="form-label">Descripción de la falla</label><textarea class="form-control" name="DescripcionFalla" rows="2" maxlength="1000" required placeholder="Describe qué ocurrió y en qué periférico"></textarea></div>
                                        <div class="col-md-6"><label class="form-label">Causa raíz</label><textarea class="form-control" name="CausaRaiz" rows="2" maxlength="1000" placeholder="Puede completarse después"></textarea></div>
                                        <div class="col-md-6"><label class="form-label">Acciones realizadas</label><textarea class="form-control" name="Acciones" rows="2" maxlength="1000" placeholder="Ajuste, reparación o seguimiento"></textarea></div>
                                        <div class="col-12 d-flex justify-content-between align-items-center flex-wrap gap-2"><label class="form-check d-flex align-items-center gap-2 m-0 fw-bold"><input class="form-check-input" type="checkbox" name="Solucionado" value="true" /><input type="hidden" name="Solucionado" value="false" />Problema solucionado</label><button class="btn btn-warning btn-strong" type="submit"><i class="bi bi-plus-circle me-1"></i>Agregar problema</button></div>
                                    </div>
                                </form>
                            }

                            @if (Model.ProblemasPerifericos == null || Model.ProblemasPerifericos.Count == 0)
                            {
                                <div class="empty-state"><i class="bi bi-check-circle fs-3 d-block mb-2"></i>No se registraron problemas durante este turno.</div>
                            }
                            else
                            {
                                @foreach (var problema in Model.ProblemasPerifericos)
                                {
                                    <div class="problem-card @(problema.Solucionado ? "resuelto" : "")">
                                        <form method="post" action="@Url.Action("GuardarProblemaPerifericos", "Produccion")">
                                            @Html.AntiForgeryToken()
                                            <input type="hidden" name="ChecklistArranqueID" value="@Model.ChecklistArranqueID" />
                                            <input type="hidden" name="MonitoreoPerifericoProblemaID" value="@problema.MonitoreoPerifericoProblemaID" />
                                            <div class="d-flex justify-content-between align-items-center flex-wrap gap-2 mb-3"><div class="problem-title"><i class="bi @(problema.Solucionado ? "bi-check-circle" : "bi-exclamation-circle") me-1"></i>Problema #@problema.MonitoreoPerifericoProblemaID</div><span class="badge @(problema.Solucionado ? "bg-success" : "bg-warning text-dark")">@(problema.Solucionado ? "Solucionado" : "Pendiente")</span></div>
                                            <div class="row g-3">
                                                <div class="col-12"><label class="form-label">Descripción</label><textarea class="form-control" name="DescripcionFalla" rows="2" maxlength="1000" required @(puedeEditar ? "" : "readonly")>@problema.DescripcionFalla</textarea></div>
                                                <div class="col-md-6"><label class="form-label">Causa raíz</label><textarea class="form-control" name="CausaRaiz" rows="2" maxlength="1000" @(puedeEditar ? "" : "readonly")>@problema.CausaRaiz</textarea></div>
                                                <div class="col-md-6"><label class="form-label">Acciones</label><textarea class="form-control" name="Acciones" rows="2" maxlength="1000" @(puedeEditar ? "" : "readonly")>@problema.Acciones</textarea></div>
                                                <div class="col-12 d-flex justify-content-between align-items-center flex-wrap gap-2">
                                                    <div>
                                                        <label class="form-check d-inline-flex align-items-center gap-2 m-0 fw-bold"><input class="form-check-input" type="checkbox" name="Solucionado" value="true" @(problema.Solucionado ? "checked" : "") @(puedeEditar ? "" : "disabled") /><input type="hidden" name="Solucionado" value="false" />Solucionado</label>@if (problema.FechaSolucion.HasValue){
                                                        <span class="text-muted small ms-2">@problema.FechaSolucion.Value.ToString("dd/MM/yyyy HH:mm") · @Txt(problema.UsuarioSolucionNombre)</span>
                                                    }
                                                </div>
                                                @if (puedeEditar)
                                                {
                                                    <div class="d-flex gap-2"><button class="btn btn-outline-primary btn-sm fw-bold" type="submit"><i class="bi bi-save me-1"></i>Actualizar</button><button class="btn btn-outline-danger btn-sm fw-bold" type="submit" formaction="@Url.Action("EliminarProblemaPerifericos", "Produccion")" name="monitoreoPerifericoProblemaId" value="@problema.MonitoreoPerifericoProblemaID" onclick="return confirm('¿Eliminar este problema?');"><input type="hidden" name="checklistArranqueId" value="@Model.ChecklistArranqueID" /><i class="bi bi-trash me-1"></i>Eliminar</button></div>
                                                }
                                            </div>
                                        </div>
                                    </form>
                                </div>
                            }
                        }
                    </div>
                </section>

                <section class="section-card">
                    <div class="section-head">
                        <div><div class="section-title"><i class="bi bi-arrow-left-right me-2 text-primary"></i>Entrega y recepción del turno</div><div class="section-meta">El usuario en sesión queda registrado como quien entrega. Selecciona al técnico que recibe.</div></div>@if(Model.FechaEntregaTurno.HasValue){
                        <span class="badge bg-success">Entrega registrada</span>
                                                }
                    </div>
                    <div class="panel-body">
                        @if (Model.FechaEntregaTurno.HasValue)
                        {
                            <div class="turno-grid mb-3"><div class="summary"><div class="summary-k">Entrega</div><div class="data-v mt-1">@Txt(Model.TecnicoEntregaNombre)</div><div class="text-muted small">@Model.FechaEntregaTurno.Value.ToString("dd/MM/yyyy HH:mm")</div></div><div class="summary"><div class="summary-k">Recibe</div><div class="data-v mt-1">@Txt(Model.TecnicoRecibeNombre)</div><div class="text-muted small">@(Model.FechaRecepcionTurno?.ToString("dd/MM/yyyy HH:mm") ?? "-")</div></div></div>
                        }
                        @if (puedeEditar)
                        {
                            <form method="post" action="@Url.Action("GuardarEntregaTurnoPerifericos", "Produccion")">
                                @Html.AntiForgeryToken()
                                <input type="hidden" name="ChecklistArranqueID" value="@Model.ChecklistArranqueID" />
                                <div class="row g-3 align-items-end">
                                    <div class="col-md-8">
                                        <label class="form-label">Técnico que recibe</label><select class="form-select" name="TecnicoRecibePersonaID" required>
                                            <option value="">Selecciona al técnico</option>@foreach(var tecnico in tecnicosProduccion){
                                            <option value="@tecnico.Value" selected="@(tecnico.Value == Model.TecnicoRecibePersonaID?.ToString())">@tecnico.Text</option>
                                        }
                                    </select>
                                </div><div class="col-md-4 d-grid"><button class="btn btn-success btn-strong" type="submit"><i class="bi bi-person-check me-1"></i>Confirmar entrega</button></div>
                            </div>
                        </form>
                                                }
                    </div>
                </section>
                                }

            </main>
        </div>
    </div>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
    <script>
        document.addEventListener('DOMContentLoaded', function () {
            const form = document.getElementById('formChecklist');
            if (!form) return;

            const enviarCampo = document.getElementById('EnviarACalidad');
            const rows = Array.from(form.querySelectorAll('[data-row]'));
            const btnGuardar = document.getElementById('btnGuardar');
            const btnEnviarCalidad = document.getElementById('btnEnviarCalidad');
            let enviando = false;

            function ponerTexto(id, valor) {
                const elemento = document.getElementById(id);
                if (elemento) elemento.textContent = valor;
            }

            function resultado(row) {
                return (row.querySelector('.resultado-hidden')?.value || 'OK').toUpperCase();
            }

            function estaConfirmada(row) {
                return row.querySelector('.confirmado-hidden')?.value === 'true';
            }

            function actualizarFila(row) {
                const sw = row.querySelector('.switch-ok');
                const na = row.querySelector('.na-check');
                const hidden = row.querySelector('.resultado-hidden');
                const texto = row.querySelector('.estado-switch');
                const obsWrap = row.querySelector('.obs-wrap');
                const obs = row.querySelector('.observacion');
                let valor = 'OK';

                if (na?.checked) {
                    valor = 'NA';
                    if (sw) sw.disabled = true;
                } else {
                    if (sw) sw.disabled = false;
                    valor = sw?.checked ? 'OK' : 'NOK';
                }

                if (hidden) hidden.value = valor;
                if (texto) texto.textContent = valor === 'NA' ? 'N/A' : valor;

                const requiereObservacion = valor === 'NOK' || valor === 'NA';
                obsWrap?.classList.toggle('visible', requiereObservacion);
                if (obs) {
                    obs.required = requiereObservacion;
                    obs.disabled = !requiereObservacion;
                    if (!requiereObservacion) obs.classList.remove('is-invalid');
                }
            }

            function actualizarResumen() {
                const total = rows.length;
                let confirmadas = 0, totalOK = 0, totalNOK = 0, totalNA = 0;

                rows.forEach(row => {
                    if (!estaConfirmada(row)) return;
                    confirmadas++;
                    const valor = resultado(row);
                    if (valor === 'OK') totalOK++;
                    else if (valor === 'NOK') totalNOK++;
                    else if (valor === 'NA' || valor === 'N/A') totalNA++;
                });

                const pendientes = Math.max(0, total - confirmadas);
                const porcentaje = total > 0 ? Math.round(confirmadas * 100 / total) : 0;

                ponerTexto('resumenPreguntas', total);
                ponerTexto('resumenRespondidas', confirmadas);
                ponerTexto('resumenPendientes', pendientes);
                ponerTexto('resumenOK', totalOK);
                ponerTexto('resumenNOK', totalNOK);
                ponerTexto('resumenNA', totalNA);
                ponerTexto('txtConfirmadas', confirmadas);
                ponerTexto('txtTotalPreguntas', total);
                ponerTexto('txtPorcentaje', porcentaje + '%');

                document.querySelectorAll('.contador-seccion').forEach(contador => {
                    const seccion = contador.closest('.check-section');
                    if (!seccion) return;
                    const filasSeccion = Array.from(seccion.querySelectorAll('[data-row]'));
                    const confirmadasSeccion = filasSeccion.filter(estaConfirmada).length;
                    contador.textContent = confirmadasSeccion + ' / ' + filasSeccion.length;
                });

                const barra = document.getElementById('barraAvance');
                if (barra) {
                    barra.style.width = porcentaje + '%';
                    barra.setAttribute('aria-valuenow', porcentaje.toString());
                }
            }

            function validar() {
                const errores = [];
                rows.forEach(row => {
                    actualizarFila(row);
                    const valorActual = resultado(row);
                    const obs = row.querySelector('.observacion');
                    const valorCapturado = row.querySelector('.valor-capturado');
                    const requiereObsNok = row.dataset.requiereNok === 'true';
                    const requiereObsNa = row.dataset.requiereNa === 'true';
                    const observacionObligatoria = (valorActual === 'NOK' && requiereObsNok) || (valorActual === 'NA' && requiereObsNa);

                    if (observacionObligatoria && obs && !obs.value.trim()) {
                        obs.disabled = false;
                        obs.classList.add('is-invalid');
                        errores.push('Las respuestas NOK o N/A indicadas requieren observación.');
                    }

                    if (row.dataset.requiereValor === 'true' && valorCapturado && !valorCapturado.value.trim()) {
                        valorCapturado.classList.add('is-invalid');
                        errores.push('Faltan valores requeridos.');
                    }
                });

                if (errores.length) {
                    alert([...new Set(errores)].join('\n'));
                    return false;
                }
                return true;
            }

            function enviar(aCalidad) {
                if (enviando || !validar()) return;

                rows.forEach(row => {
                    const confirmado = row.querySelector('.confirmado-hidden');
                    const hiddenResultado = row.querySelector('.resultado-hidden');
                    if (confirmado) confirmado.value = 'true';
                    if (hiddenResultado && !hiddenResultado.value) hiddenResultado.value = 'OK';
                    const obs = row.querySelector('.observacion');
                    if (obs) obs.disabled = false;
                });

                if (enviarCampo) enviarCampo.value = aCalidad ? 'true' : 'false';
                enviando = true;
                if (btnGuardar) btnGuardar.disabled = true;
                if (btnEnviarCalidad) btnEnviarCalidad.disabled = true;
                form.submit();
            }

            rows.forEach(row => {
                actualizarFila(row);
                row.querySelector('.switch-ok')?.addEventListener('change', function () {
                    actualizarFila(row);
                });
                row.querySelector('.na-check')?.addEventListener('change', function () {
                    actualizarFila(row);
                });
                row.querySelector('.observacion')?.addEventListener('input', function (event) {
                    event.target.classList.remove('is-invalid');
                });
                row.querySelector('.valor-capturado')?.addEventListener('input', function (event) {
                    event.target.classList.remove('is-invalid');
                });
            });

            btnGuardar?.addEventListener('click', function () { enviar(false); });
            btnEnviarCalidad?.addEventListener('click', function () { enviar(true); });
            form.addEventListener('submit', function (event) {
                if (!enviando) event.preventDefault();
            });

            actualizarResumen();
        });
    </script>
</body>
</html>
