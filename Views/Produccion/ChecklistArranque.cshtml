            }

        .data-k {
            color: var(--muted);
            font-size: .72rem;
            text-transform: uppercase;
            font-weight: 900;
        }

        .data-v {
            font-weight: 800;
            word-break: break-word;
        }

        .note {
            border: 1px solid #bfdbfe;
