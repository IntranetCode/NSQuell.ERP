@model ERP.NSQuell.Models.ProduccionChecklistArranqueVm

@{
    Layout = "_Layout";
    var puedeEditar = ERP.NSQuell.Models.ProduccionChecklistEstatus.PuedeEditarProduccion(Model.EstatusID);
    var esArranqueLiberacion = string.Equals(Model.TipoChecklist, "ARRANQUE_LIBERACION", StringComparison.OrdinalIgnoreCase);
    var esMonitoreoPerifericos = string.Equals(Model.TipoChecklist, "MONITOREO_PERIFERICOS", StringComparison.OrdinalIgnoreCase);
    var tecnicosProduccion = ViewBag.TecnicosProduccion as IEnumerable<Microsoft.AspNetCore.Mvc.Rendering.SelectListItem> ?? Enumerable.Empty<Microsoft.AspNetCore.Mvc.Rendering.SelectListItem>();
    var seccionesProduccion = Model.Secciones.Where(x => !x.EsSeccionCalidad && !(x.Seccion ?? "").Contains("PARO", StringComparison.OrdinalIgnoreCase)).OrderBy(x => x.OrdenSeccion).ToList();
    var preguntasProduccion = seccionesProduccion.SelectMany(x => x.Preguntas).Where(x => x.Activo && !x.EsPreguntaCalidad).ToList();
    var totalPreguntas = preguntasProduccion.Count;
    var totalRespondidas = preguntasProduccion.Count(x => x.Confirmado);
    var totalPendientes = Math.Max(0, totalPreguntas - totalRespondidas);
    var totalOK = preguntasProduccion.Count(x => x.Confirmado && ResultadoActual(x.Resultado) == "OK");
    var totalNOK = preguntasProduccion.Count(x => x.Confirmado && ResultadoActual(x.Resultado) == "NOK");
    var totalNA = preguntasProduccion.Count(x => x.Confirmado && ResultadoActual(x.Resultado) == "NA");
    var porcentajeAvance = totalPreguntas > 0 ? Math.Round((decimal)totalRespondidas * 100m / totalPreguntas, 2) : 0m;
}

@functions {
    public static string Txt(string? value) => string.IsNullOrWhiteSpace(value) ? "-" : value.Trim();
    public static string ResultadoActual(string? value) { var r = (value ?? "").Trim().ToUpperInvariant(); return r == "N/A" ? "NA" : r; }
    public static string BadgeResultado(ERP.NSQuell.Models.ProduccionChecklistPreguntaVm p) { if (!p.Confirmado) return "badge bg-warning text-dark"; return p.Resultado == "OK" ? "badge bg-success" : p.Resultado == "NOK" ? "badge bg-danger" : p.Resultado == "NA" ? "badge bg-secondary" : "badge bg-warning text-dark"; }
    public static string TextoResultado(ERP.NSQuell.Models.ProduccionChecklistPreguntaVm p) { if (!p.Confirmado) return "Pendiente"; return p.Resultado == "NA" ? "N/A" : Txt(p.Resultado); }
    public static string IconoFormato(string? tipo) => tipo switch { "CAMBIO_MOLDE" => "bi-tools", "MONITOREO_PARAMETROS" => "bi-sliders", "MONITOREO_PERIFERICOS" => "bi-cpu", _ => "bi-clipboard2-check" };
}

<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <script>
        (function () {
            const STORAGE_KEY = 'nsq-theme';

            function applyStoredTheme(value) {
                const theme = value === 'light' ? 'light' : 'dark';
                const root = document.documentElement;

                root.setAttribute('data-nsq-theme', theme);
                root.setAttribute('data-bs-theme', theme);
                root.style.colorScheme = theme;
            }

            let savedTheme = 'dark';

            try {
                savedTheme = localStorage.getItem(STORAGE_KEY) || 'dark';
            } catch (_) {
                savedTheme = 'dark';
            }

            applyStoredTheme(savedTheme);

            window.addEventListener('storage', function (event) {
                if (event.key === STORAGE_KEY) {
                    applyStoredTheme(event.newValue || 'dark');
                }
            });
        })();
    </script>
    <title>@Model.TituloChecklist | Producción</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet" />
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.css" rel="stylesheet" />
    <style>
