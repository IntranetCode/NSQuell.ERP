@model ERP.NSQuell.Models.ProduccionChecklistArranqueVm

@{
    Layout = null;

    var preguntaIndex = 0;
    var puedeEditarProduccion = Model.PuedeEditarProduccion;
}

<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Checklist de arranque</title>

    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.css" rel="stylesheet">

    <style>
        body {
            background: #f4f7fb;
            font-family: Arial, Helvetica, sans-serif;
        }

        .page-shell {
            max-width: 1500px;
            margin: 0 auto;
            padding: 22px;
        }

        .hero {
            background: linear-gradient(135deg, #0f2f63, #194c9b);
            color: white;
            border-radius: 24px;
            padding: 24px;
            box-shadow: 0 18px 38px rgba(15, 47, 99, .20);
        }

        .hero-title {
            font-size: 1.75rem;
            font-weight: 900;
            margin: 0;
        }

        .hero-subtitle {
            opacity: .88;
            margin-top: 5px;
        }

        .metric-card {
            background: white;
            border-radius: 18px;
            padding: 16px;
            border: 1px solid #e5eaf3;
            box-shadow: 0 10px 24px rgba(15, 23, 42, .05);
            height: 100%;
        }

        .metric-label {
            color: #667085;
            font-size: .78rem;
            font-weight: 800;
            text-transform: uppercase;
            letter-spacing: .04em;
        }

        .metric-value {
            font-size: 1.65rem;
            font-weight: 900;
            color: #102a56;
            margin-top: 6px;
            line-height: 1;
        }

        .panel {
            background: white;
            border-radius: 20px;
            border: 1px solid #e5eaf3;
            box-shadow: 0 12px 28px rgba(15, 23, 42, .06);
            overflow: hidden;
        }

        .panel-header {
            padding: 16px 18px;
            background: #f8fafc;
            border-bottom: 1px solid #e5eaf3;
            color: #102a56;
            font-weight: 900;
        }

        .panel-body {
            padding: 18px;
        }

        .data-label {
            color: #667085;
            font-size: .76rem;
            font-weight: 800;
            text-transform: uppercase;
            letter-spacing: .04em;
        }

        .data-value {
            color: #102a56;
            font-weight: 800;
        }

        .muted-small {
            color: #667085;
            font-size: .82rem;
        }

        .section-card {
            background: white;
            border: 1px solid #e5eaf3;
            border-radius: 20px;
            overflow: hidden;
            box-shadow: 0 12px 28px rgba(15, 23, 42, .055);
            margin-bottom: 18px;
        }

        .section-header {
            padding: 15px 18px;
            background: #f8fafc;
            border-bottom: 1px solid #e5eaf3;
        }

        .section-title {
            font-weight: 900;
            color: #102a56;
            margin: 0;
        }

        .question-row {
            padding: 16px 18px;
            border-bottom: 1px solid #eef2f7;
        }

            .question-row:last-child {
                border-bottom: 0;
            }

        .question-text {
            color: #102a56;
            font-weight: 800;
            line-height: 1.25;
        }

        .question-meta {
            color: #667085;
            font-size: .78rem;
            margin-top: 4px;
        }

        .result-group {
            display: flex;
            flex-wrap: wrap;
            gap: 8px;
            justify-content: flex-end;
        }

        .result-option {
            position: relative;
        }

            .result-option input {
                position: absolute;
                opacity: 0;
                pointer-events: none;
            }

            .result-option label {
                min-width: 66px;
                text-align: center;
                border-radius: 999px;
                padding: 8px 12px;
                border: 1px solid #d0d7e2;
                background: #fff;
                color: #344054;
                font-weight: 900;
                cursor: pointer;
                user-select: none;
                transition: all .15s ease;
            }

            .result-option input:checked + label.ok {
                background: #16a34a;
                border-color: #16a34a;
                color: white;
            }

            .result-option input:checked + label.nok {
                background: #dc2626;
                border-color: #dc2626;
                color: white;
            }

            .result-option input:checked + label.na {
                background: #64748b;
                border-color: #64748b;
                color: white;
            }

            .result-option input:disabled + label {
                opacity: .55;
                cursor: not-allowed;
            }

        .obs-box {
            margin-top: 12px;
        }

        .sticky-actions {
            position: sticky;
            bottom: 0;
            z-index: 50;
            background: rgba(244, 247, 251, .96);
            backdrop-filter: blur(8px);
            border-top: 1px solid #dbe3f0;
            padding: 14px 0;
            margin-top: 22px;
        }

        .quality-locked {
            background: #fff7ed;
            border: 1px solid #fed7aa;
            color: #9a3412;
            border-radius: 14px;
            padding: 12px 14px;
            font-size: .9rem;
            font-weight: 700;
        }

        .readonly-banner {
            background: #eff6ff;
            border: 1px solid #bfdbfe;
            color: #1d4ed8;
            border-radius: 14px;
            padding: 12px 14px;
            font-weight: 700;
        }

        .btn-big {
            padding: 12px 18px;
            font-weight: 900;
            border-radius: 14px;
        }

        @@media (max-width: 992px) {
            .result-group {
                justify-content: flex-start;
                margin-top: 12px;
            }

            .hero-title {
                font-size: 1.35rem;
            }
        }
    </style>
</head>

<body>
    <div class="page-shell">

        <div class="hero mb-4">
            <div class="d-flex flex-wrap align-items-center justify-content-between gap-3">
                <div>
                    <h1 class="hero-title">
                        <i class="bi bi-clipboard2-check me-2"></i>
                        Checklist de arranque
                    </h1>
                    <div class="hero-subtitle">
                        @Model.TextoFormato · Programa @Model.ProgramaProduccionID · @Model.TextoMaquina
                    </div>
                </div>

                <div class="d-flex flex-wrap align-items-center gap-2">
                    <span class="badge @Model.EstatusClase fs-6">
                        @Model.EstatusNombre
                    </span>

                    <a href="@Url.Action("Detalle", "Produccion", new { id = Model.EjecucionProduccionID })"
                       class="btn btn-light fw-bold">
                        <i class="bi bi-arrow-left me-1"></i>
                        Volver
                    </a>
                </div>
            </div>
        </div>

        @if (TempData["Success"] != null)
        {
            <div class="alert alert-success alert-dismissible fade show" role="alert">
                <i class="bi bi-check-circle me-1"></i>
                @TempData["Success"]
                <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
            </div>
        }

        @if (TempData["Error"] != null)
        {
            <div class="alert alert-danger alert-dismissible fade show" role="alert">
                <i class="bi bi-exclamation-triangle me-1"></i>
                @TempData["Error"]
                <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
            </div>
        }

        @if (!puedeEditarProduccion)
        {
            <div class="readonly-banner mb-4">
                <i class="bi bi-info-circle me-1"></i>
                Este checklist ya no está editable para Producción. Puedes consultarlo, pero no modificarlo.
            </div>
        }

        <div class="row g-3 mb-4">
            <div class="col-6 col-lg">
                <div class="metric-card">
                    <div class="metric-label">Preguntas</div>
                    <div class="metric-value">@Model.TotalPreguntas</div>
                </div>
            </div>

            <div class="col-6 col-lg">
                <div class="metric-card">
                    <div class="metric-label">Respondidas</div>
                    <div class="metric-value">@Model.TotalRespondidas</div>
                </div>
            </div>

            <div class="col-6 col-lg">
                <div class="metric-card">
                    <div class="metric-label">OK</div>
                    <div class="metric-value text-success">@Model.TotalOK</div>
                </div>
            </div>

            <div class="col-6 col-lg">
                <div class="metric-card">
                    <div class="metric-label">NOK</div>
                    <div class="metric-value text-danger">@Model.TotalNOK</div>
                </div>
            </div>

            <div class="col-6 col-lg">
                <div class="metric-card">
                    <div class="metric-label">N/A</div>
                    <div class="metric-value text-secondary">@Model.TotalNA</div>
                </div>
            </div>

            <div class="col-6 col-lg">
                <div class="metric-card">
                    <div class="metric-label">Estatus</div>
                    <div class="mt-2">
                        <span class="badge @Model.EstatusClase fs-6">
                            @Model.EstatusNombre
                        </span>
                    </div>
                </div>
            </div>
        </div>

        <div class="panel mb-4">
            <div class="panel-header">
                <i class="bi bi-info-circle me-1"></i>
                Datos del arranque
            </div>

            <div class="panel-body">
                <div class="row g-3">
                    <div class="col-6 col-lg-3">
                        <div class="data-label">Programa</div>
                        <div class="data-value">@Model.ProgramaProduccionID</div>
                    </div>

                    <div class="col-6 col-lg-3">
                        <div class="data-label">Máquina</div>
                        <div class="data-value">@Model.MaquinaCodigo</div>
                        <div class="muted-small">@Model.MaquinaNombre</div>
                    </div>

                    <div class="col-6 col-lg-3">
                        <div class="data-label">Molde</div>
                        <div class="data-value">@(Model.MoldeCodigo ?? "Sin molde")</div>
                    </div>

                    <div class="col-6 col-lg-3">
                        <div class="data-label">Parte</div>
                        <div class="data-value">@Model.TextoParte</div>
                        <div class="muted-small">@Model.DescripcionParte</div>
                    </div>

                    <div class="col-6 col-lg-3">
                        <div class="data-label">Fecha checklist</div>
                        <div class="data-value">@Model.FechaChecklist.ToString("dd/MM/yyyy HH:mm")</div>
                    </div>

                    <div class="col-6 col-lg-3">
                        <div class="data-label">Captura producción</div>
                        <div class="data-value">
                            @(Model.FechaCapturaProduccion?.ToString("dd/MM/yyyy HH:mm") ?? "-")
                        </div>
                    </div>

                    <div class="col-6 col-lg-3">
                        <div class="data-label">Validación calidad</div>
                        <div class="data-value">
                            @(Model.FechaValidacionCalidad?.ToString("dd/MM/yyyy HH:mm") ?? "Pendiente")
                        </div>
                    </div>

                    <div class="col-6 col-lg-3">
                        <div class="data-label">Formato</div>
                        <div class="data-value">@Model.TextoFormato</div>
                    </div>
                </div>
            </div>
        </div>

        <form method="post" action="@Url.Action("GuardarChecklistArranque", "Produccion")" id="formChecklistArranque">
            @Html.AntiForgeryToken()

            <input type="hidden" name="ChecklistArranqueID" value="@Model.ChecklistArranqueID" />
            <input type="hidden" name="EjecucionProduccionID" value="@Model.EjecucionProduccionID" />

            @foreach (var seccion in Model.Secciones.OrderBy(x => x.OrdenSeccion))
            {
                var esCalidad = seccion.EsSeccionCalidad;
                var editableSeccion = puedeEditarProduccion && !esCalidad;

                <div class="section-card">
                    <div class="section-header">
                        <div class="d-flex flex-wrap align-items-center justify-content-between gap-2">
                            <div>
                                <h5 class="section-title">
                                    @seccion.Seccion
                                </h5>
                                <div class="muted-small">
                                    Responsable: @(seccion.ResponsableSugerido ?? "No definido")
                                </div>
                            </div>

                            <div class="d-flex flex-wrap gap-2">
                                <span class="badge bg-light text-dark border">
                                    @seccion.TotalRespondidas / @seccion.TotalPreguntas respondidas
                                </span>

                                @if (seccion.TotalNOK > 0)
                                {
                                    <span class="badge bg-danger">
                                        @seccion.TotalNOK NOK
                                    </span>
                                }

                                @if (esCalidad)
                                {
                                    <span class="badge bg-warning text-dark">
                                        Calidad
                                    </span>
                                }
                            </div>
                        </div>

                        @if (esCalidad)
                        {
                            <div class="quality-locked mt-3">
                                <i class="bi bi-lock-fill me-1"></i>
                                Esta sección queda preparada para Calidad. Producción no debe capturarla.
                            </div>
                        }
                    </div>

                    @foreach (var pregunta in seccion.Preguntas.OrderBy(x => x.OrdenPregunta))
                    {
                        var disabledAttr = editableSeccion ? null : "disabled";
                        var requiereObs = pregunta.RequiereObservacionSiNOK;

                        <div class="question-row">
                            <div class="row g-3 align-items-start">
                                <div class="col-12 col-lg-7">
                                    <div class="question-text">
                                        @pregunta.OrdenPregunta. @pregunta.TextoPregunta
                                    </div>

                                    <div class="question-meta">
                                        Responsable sugerido: @(pregunta.ResponsableSugerido ?? "-")
                                        @if (requiereObs)
                                        {
                                            <span> · Si es NOK requiere observación</span>
                                        }
                                    </div>

                                    @if (editableSeccion)
                                    {
                                        <input type="hidden" name="Respuestas[@preguntaIndex].ChecklistArranqueDetalleID" value="@pregunta.ChecklistArranqueDetalleID" />
                                        <input type="hidden" name="Respuestas[@preguntaIndex].PreguntaID" value="@pregunta.PreguntaID" />
                                    }
                                </div>

                                <div class="col-12 col-lg-5">
                                    <div class="result-group">
                                        <div class="result-option">
                                            <input type="radio"
                                                   id="r_(@pregunta.ChecklistArranqueDetalleID)_ok"
                                                   name="Respuestas[@preguntaIndex].Resultado"
                                                   value="OK"
                                                   checked="@(pregunta.Resultado == "OK")"
                                                   disabled="@disabledAttr" />
                                            <label class="ok" for="r_@pregunta.(ChecklistArranqueDetalleID)_ok">
                                                OK
                                            </label>
                                        </div>

                                        <div class="result-option">
                                            <input type="radio"
                                                   id="r_@pregunta.(ChecklistArranqueDetalleID)_nok"
                                                   name="Respuestas[@preguntaIndex].Resultado"
                                                   value="NOK"
                                                   checked="@(pregunta.Resultado == "NOK")"
                                                   disabled="@disabledAttr" />
                                            <label class="nok" for="r_(@pregunta.ChecklistArranqueDetalleID)_nok">
                                                NOK
                                            </label>
                                        </div>

                                        <div class="result-option">
                                            <input type="radio"
                                                   id="r_@(pregunta.ChecklistArranqueDetalleID)_na"
                                                   name="Respuestas[@preguntaIndex].Resultado"
                                                   value="NA"
                                                   checked="@(pregunta.Resultado == "NA")"
                                                   disabled="@disabledAttr" />
                                            <label class="na" for="r_(@pregunta.ChecklistArranqueDetalleID)_na">
                                                N/A
                                            </label>
                                        </div>
                                    </div>

                                    <div class="obs-box">
                                        <textarea name="Respuestas[@preguntaIndex].Observaciones"
                                          class="form-control"
                                          rows="2"
                                          maxlength="500"
                                          placeholder="Observaciones..."
                                          disabled="@disabledAttr">@pregunta.Observaciones</textarea>

                                        @if (pregunta.TieneErrorCaptura)
                                        {
                                            <div class="text-danger small fw-bold mt-1">
                                                Esta pregunta está NOK y requiere observación.
                                            </div>
                                        }
                                    </div>
                                </div>
                            </div>
                        </div>

                        if (editableSeccion)
                        {
                            preguntaIndex++;
                        }
                    }
                </div>
            }

            <div class="panel mb-4">
                <div class="panel-header">
                    <i class="bi bi-chat-left-text me-1"></i>
                    Observaciones generales de Producción
                </div>

                <div class="panel-body">
                    <textarea name="ObservacionesGenerales"
                              class="form-control"
                              rows="3"
                              maxlength="1000"
                              placeholder="Observaciones generales del arranque..."
                              disabled="@(puedeEditarProduccion ? null : "disabled")">@Model.ObservacionesGenerales</textarea>

                    @if (!string.IsNullOrWhiteSpace(Model.ObservacionesCalidad))
                    {
                        <div class="mt-3">
                            <div class="data-label">Observaciones de Calidad</div>
                            <div class="alert alert-warning mb-0">
                                @Model.ObservacionesCalidad
                            </div>
                        </div>
                    }
                </div>
            </div>

            @if (puedeEditarProduccion)
            {
                <div class="sticky-actions">
                    <div class="d-flex flex-wrap justify-content-between align-items-center gap-3">
                        <div class="muted-small">
                            <i class="bi bi-info-circle me-1"></i>
                            Guarda como borrador o envía el checklist a validación de Calidad.
                            Si hay respuestas NOK, deben tener observación.
                        </div>

                        <div class="d-flex flex-wrap gap-2">
                            <a href="@Url.Action("Detalle", "Produccion", new { id = Model.EjecucionProduccionID })"
                               class="btn btn-outline-secondary btn-big">
                                Cancelar
                            </a>

                            <button type="submit"
                                    name="GuardarBorrador"
                                    value="true"
                                    class="btn btn-primary btn-big">
                                <i class="bi bi-save me-1"></i>
                                Guardar borrador
                            </button>

                            <button type="submit"
                                    name="EnviarACalidad"
                                    value="true"
                                    class="btn btn-success btn-big"
                                    onclick="return confirmarEnvioCalidad();">
                                <i class="bi bi-send-check me-1"></i>
                                Enviar a Calidad
                            </button>
                        </div>
                    </div>
                </div>
            }
        </form>

    </div>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>

    <script>
        function confirmarEnvioCalidad() {
            return confirm('¿Confirmas enviar el checklist a validación de Calidad? Después de enviarlo ya no podrá editarse desde Producción.');
        }

        document.addEventListener('DOMContentLoaded', function () {
            const form = document.getElementById('formChecklistArranque');

            if (!form) {
                return;
            }

            form.addEventListener('submit', function (event) {
                const submitter = event.submitter;

                if (!submitter || submitter.name !== 'EnviarACalidad') {
                    return;
                }

                const rows = document.querySelectorAll('.question-row');
                let faltantes = 0;
                let nokSinObservacion = 0;

                rows.forEach(function (row) {
                    const radios = row.querySelectorAll('input[type="radio"]:not(:disabled)');
                    if (!radios || radios.length === 0) {
                        return;
                    }

                    const checked = row.querySelector('input[type="radio"]:checked:not(:disabled)');

                    if (!checked) {
                        faltantes++;
                        row.style.background = '#fff7ed';
                        return;
                    }

                    const textarea = row.querySelector('textarea:not(:disabled)');

                    if (checked.value === 'NOK' && textarea && textarea.value.trim() === '') {
                        nokSinObservacion++;
                        row.style.background = '#fef2f2';
                        return;
                    }

                    row.style.background = '';
                });

                if (faltantes > 0) {
                    event.preventDefault();
                    alert('Hay preguntas de Producción sin responder. Responde todo antes de enviar a Calidad.');
                    return;
                }

                if (nokSinObservacion > 0) {
                    event.preventDefault();
                    alert('Hay respuestas NOK sin observación. Agrega observación antes de enviar a Calidad.');
                    return;
                }
            });
        });
    </script>
</body>
</html>