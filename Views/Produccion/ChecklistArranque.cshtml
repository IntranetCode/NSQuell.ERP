            color: var(--azul);
            font-weight: 900;
        }

        .question-text {
            font-weight: 800;
            line-height: 1.4;
        }

        .question-meta {
            display: flex;
            flex-wrap: wrap;
            gap: 6px;
            margin-top: 8px;
        }

        .answer-box {
            border: 1px solid #e4eaf2;
            border-radius: 14px;
            padding: 10px;
            background: #fbfdff;
        }

        .status-controls {
            display: flex;
            align-items: center;
            justify-content: space-between;
            gap: 14px;
            flex-wrap: wrap;
        }

        .ok-control, .na-control {
            display: flex;
            align-items: center;
            gap: 9px;
            font-weight: 900;
        }

        .ok-control {
            color: #067647;
        }

        .na-control {
            color: #475467;
        }

        .switch-ok {
            width: 52px !important;
            height: 28px;
            margin: 0;
            cursor: pointer;
            border-color: #f04438;
            background-color: #f04438;
        }

            .switch-ok:checked {
                border-color: #12b76a;
                background-color: #12b76a;
            }

            .switch-ok:disabled {
                opacity: .45;
                cursor: not-allowed;
            }

        .na-check {
            width: 20px;
            height: 20px;
            margin: 0;
            cursor: pointer;
        }

        .status-text {
            min-width: 42px;
            font-size: .82rem;
        }

        .status-help {
            margin-top: 8px;
            color: var(--muted);
            font-size: .76rem;
            font-weight: 650;
        }

        .extra-field {
            margin-top: 9px;
        }

        .obs-wrap {
            margin-top: 9px;
            display: none;
        }

            .obs-wrap.visible {
                display: block;
            }

        .form-control {
            border-radius: 10px;
            border-color: #d7e2f1;
        }

        .sticky-actions {
            position: sticky;
            bottom: 0;
            z-index: 20;
            background: rgba(255,255,255,.95);
            border: 1px solid var(--borde);
            border-radius: 16px;
            padding: 12px;
            box-shadow: 0 -8px 24px rgba(15,23,42,.08);
        }

        .btn-strong {
            border-radius: 11px;
            font-weight: 900;
        }

        .progress {
            height: 10px;
            border-radius: 999px;
        }


        .problem-card {
            border: 1px solid #fed7aa;
            border-radius: 14px;
            background: #fffaf5;
            padding: 14px;
            margin-bottom: 12px;
        }

            .problem-card.resuelto {
                border-color: #bbf7d0;
                background: #f0fdf4;
            }

        .problem-title {
            font-weight: 900;
            color: #9a3412;
        }

        .problem-card.resuelto .problem-title {
            color: #166534;
        }

        .turno-grid {
            display: grid;
            grid-template-columns: repeat(2,minmax(0,1fr));
            gap: 12px;
        }

        .empty-state {
            border: 1px dashed #cbd5e1;
            border-radius: 14px;
            padding: 20px;
            text-align: center;
            color: var(--muted);
            background: #f8fafc;
        }

        .form-label {
            font-weight: 800;
            color: #344054;
        }

        @@media(max-width:1100px) {
            .layout {
                grid-template-columns: 1fr
            }

            .question {
                grid-template-columns: 42px minmax(0,1fr)
            }

            .answer-box {
                grid-column: 1/-1
            }

            .summary-grid {
                grid-template-columns: repeat(3,1fr)
            }

            .turno-grid {
                grid-template-columns: 1fr;
            }
        }

        @@media(max-width:650px) {
            .page {
                padding: 11px
            }

            .summary-grid {
                grid-template-columns: repeat(2,1fr)
            }

            .section-head {
                flex-direction: column
            }

            .question {
                padding: 13px
            }
        }
    

