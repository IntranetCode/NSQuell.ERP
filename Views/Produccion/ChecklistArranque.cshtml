        .section-title {
            font-weight: 900;
            font-size: 1.04rem;
        }

        .section-meta {
            color: var(--muted);
            font-size: .82rem;
            margin-top: 3px;
        }

        .pill {
            display: inline-flex;
            align-items: center;
            gap: 5px;
            border: 1px solid #d0d5dd;
            border-radius: 999px;
            padding: 5px 9px;
            background: #fff;
            font-size: .74rem;
            font-weight: 850;
        }

        .question {
            display: grid;
            grid-template-columns: 46px minmax(0,1fr) 350px;
            gap: 12px;
            padding: 15px 17px;
            border-bottom: 1px solid #edf2f7;
        }

            .question:last-child {
                border-bottom: 0;
            }

        .num {
            width: 36px;
            height: 36px;
            display: flex;
            align-items: center;
            justify-content: center;
            border-radius: 50%;
            background: #eff6ff;
