<div class="prox-panel">

    <div class="prox-header">
        <div class="prox-header-top">
            <div>
                <h3 class="prox-title">
                    <i class="bi bi-alarm me-1"></i>
                    Pendientes y próximos a iniciar
                </h3>

                <div class="prox-sub">
                    OF atrasadas que todavía no han iniciado y programas previstos para los próximos 15 minutos.
                </div>
            </div>

            <span class="prox-summary-pill">
                <i class="bi bi-clock-history"></i>
                <strong>@proximos.Count</strong>
                visible(s)
            </span>
        </div>

        <div class="prox-summary">
            <span class="prox-summary-pill">
                <i class="bi bi-exclamation-triangle"></i>
                <strong>@atrasados.Count</strong>
                atrasada(s)
            </span>

            <span class="prox-summary-pill">
                <i class="bi bi-alarm"></i>
                <strong>@enVentana.Count</strong>
                próximos 15 min
            </span>

            <span class="prox-summary-pill">
                <i class="bi bi-hdd-network"></i>
                <strong>@maquinasConProximos</strong>
                máquina(s)
            </span>

            <span class="prox-summary-pill is-ready">
                <i class="bi bi-play-circle"></i>
                <strong>@disponiblesParaIniciar</strong>
                lista(s) para iniciar
            </span>

            <span class="prox-summary-pill is-blocked">
                <i class="bi bi-lock"></i>
                <strong>@bloqueadosPorMaquina</strong>
                bloqueada(s) por máquina
            </span>
        </div>
    </div>

    @if (!proximos.Any())
    {
        <div class="prox-empty">
            <i class="bi bi-clock"></i>
            <strong>No hay OF pendientes o próximas a iniciar.</strong>
            <div class="mt-1">
                La bandeja mostrará aquí las atrasadas y las que entren en la ventana de 15 minutos.
            </div>
        </div>
    }
    else
    {
        <div class="prox-list">
            @foreach (var item in proximos)
            {
                var fechaInicio = item.FechaInicioProgramada!.Value;

                var estaAtrasado = fechaInicio < DateTime.Now;

                var operador =
                string.IsNullOrWhiteSpace(item.OperadorSugeridoNombre)
                ? ""
                : item.OperadorSugeridoNombre.Trim();

                var turno =
                string.IsNullOrWhiteSpace(item.TurnoSugeridoNombre)
                ? ""
                : item.TurnoSugeridoNombre.Trim();

                var maquinaOcupada =
                item.MaquinaID.HasValue &&
                maquinasOcupadas.Contains(item.MaquinaID.Value);

                <article class="prox-card @ClaseTiempo(fechaInicio) @(maquinaOcupada ? "is-machine-busy" : "")">

                    <div class="prox-main">
                        <div class="prox-program">
                            Programa @item.ProgramaProduccionID
                        </div>

                        <div class="prox-of">
                            @Txt(item.TituloPrograma)

                            @if (item.SolicitudProduccionID.HasValue)
                            {
                                <span>
                                    · OF ID @item.SolicitudProduccionID
                                </span>
                            }
                    </div>

                    <div class="prox-machine @(maquinaOcupada ? "is-busy" : "")">
                        <i class="bi @(maquinaOcupada ? "bi-lock-fill" : "bi-hdd-network")"></i>

                        @(string.IsNullOrWhiteSpace(item.MaquinaCodigo)
                                            ? "Sin máquina"
                                            : item.MaquinaCodigo)

                    @if (!string.IsNullOrWhiteSpace(item.MaquinaNombre))
                            {
                                <span>
                                    · @item.MaquinaNombre
                                </span>
                            }
                    </div>
                </div>

                <div>
                    <div class="prox-part">
                        @Txt(item.TextoParte)
                    </div>

                    <div class="prox-description">
                        @Txt(item.DescripcionParte)
                    </div>

                    <div class="mt-2 d-flex gap-2 flex-wrap">
                        <span class="prox-summary-pill">
                            <i class="bi bi-nut"></i>
                            @(string.IsNullOrWhiteSpace(item.MoldeCodigo)
                                                    ? "Sin molde"
                                                    : item.MoldeCodigo)
                                                                   </span>

                        <span class="prox-summary-pill">
                            <i class="bi bi-box"></i>
                            @Num(item.CantidadProgramada)
                        </span>
                    </div>
                </div>

                <div>
                    <div class="prox-meta-label">
                        Inicio programado
                    </div>

                    <div class="prox-meta-value">
                        @Fecha(item.FechaInicioProgramada)
                    </div>

                    <div class="mt-2">
                        <span class="prox-time @ClaseBadgeTiempo(fechaInicio)">
                            <i class="bi bi-alarm"></i>
                            @TextoTiempo(fechaInicio)
                        </span>
                    </div>
                </div>

                <div class="prox-operator-col">
                    <div class="prox-meta-label">
                        Operador sugerido
                    </div>

                    <div class="prox-operator @(string.IsNullOrWhiteSpace(operador) ? "" : "has-operator")">
                        <i class="bi @(string.IsNullOrWhiteSpace(operador) ? "bi-person-dash" : "bi-person-check")"></i>

                        @(string.IsNullOrWhiteSpace(operador)
                                            ? "Sin operador"
                                            : operador)
                </div>

                @if (!string.IsNullOrWhiteSpace(turno))
                        {
                            <div class="prox-description">
                                Turno: @turno
                            </div>
                        }
                    </div>

                    <div class="prox-action">
                        @if (!item.PuedeIniciar)
                        {
                            <span class="badge text-bg-warning">
                                <i class="bi bi-exclamation-triangle me-1"></i>
                                No disponible
                            </span>
                        }
                        else if (maquinaOcupada)
                        {
                            <div class="d-flex gap-2 flex-wrap justify-content-end">
                                @if (estaAtrasado)
                                {
                                    <button type="button"
                                            class="btn btn-sm btn-outline-warning btn-solicitar-reprogramacion"
                                            data-bs-toggle="modal"
                                            data-bs-target="#modalSolicitarReprogramacion"
                                            data-programa-id="@item.ProgramaProduccionID"
                                            data-titulo="@Data(item.TituloPrograma)"
                                            data-maquina="@Data(item.MaquinaCodigo) @Data(item.MaquinaNombre)"
                                            data-inicio="@Fecha(item.FechaInicioProgramada)">
                                        <i class="bi bi-calendar2-event me-1"></i>
                                        Solicitar reprogramación
                                    </button>
                                }
                                <button type="button"
                                        class="btn btn-sm btn-secondary"
                                        disabled
                                        title="La máquina todavía tiene otra ejecución activa.">
                                    <i class="bi bi-lock-fill me-1"></i>
                                    Máquina ocupada
                                </button>
                            </div>
                            <div class="prox-blocked-note">
                                Esperando cierre de la OF anterior.
                            </div>
                        }
                        else
                        {
                            <div class="d-flex gap-2 flex-wrap justify-content-end">
                                @if (estaAtrasado)
                                {
                                    <button type="button"
                                            class="btn btn-sm btn-outline-warning btn-solicitar-reprogramacion"
                                            data-bs-toggle="modal"
                                            data-bs-target="#modalSolicitarReprogramacion"
                                            data-programa-id="@item.ProgramaProduccionID"
                                            data-titulo="@Data(item.TituloPrograma)"
                                            data-maquina="@Data(item.MaquinaCodigo) @Data(item.MaquinaNombre)"
                                            data-inicio="@Fecha(item.FechaInicioProgramada)">
                                        <i class="bi bi-calendar2-event me-1"></i>
                                        Solicitar reprogramación
                                    </button>
                                }
                                <button type="button"
                                        class="btn btn-sm btn-success btn-iniciar-preparacion"
                                        data-bs-toggle="modal"
                                        data-bs-target="#modalIniciarPreparacion"
                                        data-programa-id="@item.ProgramaProduccionID"
                                        data-titulo="@Data(item.TituloPrograma)"
                                        data-maquina="@Data(item.MaquinaCodigo) @Data(item.MaquinaNombre)"
                                        data-maquina-id="@(item.MaquinaID?.ToString() ?? "")"
                                        data-parte-id="@(item.ParteID?.ToString() ?? "")"
                                        data-parte="@Data(item.TextoParte)"
                                        data-descripcion="@Data(item.DescripcionParte)"
                                        data-molde="@Data(item.MoldeCodigo)"
                                        data-cantidad="@Num(item.CantidadProgramada)"
                                        data-inicio="@Fecha(item.FechaInicioProgramada)"
                                        data-fin="@Fecha(item.FechaFinProgramada)"
                                        data-operador-id="@(item.OperadorSugeridoID?.ToString() ?? "")"
                                        data-operador-nombre="@Data(item.OperadorSugeridoNombre)"
                                        data-turno="@Data(item.TurnoSugeridoNombre)">
                                    <i class="bi bi-play-fill me-1"></i>
                                    Iniciar preparación
                                </button>
                            </div>
                        }
                    </div>

                </article>
            }
        </div>
    }
</div>
