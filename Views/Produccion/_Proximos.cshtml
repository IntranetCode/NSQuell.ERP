    }

    html[data-nsq-theme="dark"] .prox-card-danger,
    html[data-nsq-theme="dark"] .prox-card-overdue,
    html[data-nsq-theme="dark"] .prox-card-now,
    html[data-nsq-theme="dark"] .prox-card-soon {
