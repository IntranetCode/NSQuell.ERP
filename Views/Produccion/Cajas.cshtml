                background: #7f56d9;
            }

            .metric-card.green::before {
                background: #12b76a;
            }

            .metric-card.blue::before {
                background: #2e90fa;
            }

            .metric-card.finished::before {
                background: #344054;
            }

            .metric-card.red::before {
                background: #d92d20;
            }

        .metric-number {
            margin-top: 5px;
            color: #101828;
            font-size: 1.7rem;
            font-weight: 950;
            line-height: 1;
