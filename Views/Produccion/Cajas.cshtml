        }

        .k {
            color: var(--gray);
            font-size: .69rem;
            font-weight: 950;
            letter-spacing: .04em;
            text-transform: uppercase;
        }

        .v {
            margin-top: 4px;
            color: var(--blue-dark);
            font-size: 1.03rem;
            font-weight: 950;
            line-height: 1.15;
            word-break: break-word;
        }

        .sub {
            margin-top: 4px;
            color: var(--gray);
            font-size: .81rem;
            font-weight: 650;
            line-height: 1.4;
        }

        .metrics {
            display: grid;
            grid-template-columns: repeat(6,minmax(0,1fr));
            gap: 10px;
            margin-bottom: 14px;
        }

        .metric-card {
            position: relative;
            overflow: hidden;
            min-height: 103px;
            padding: 14px;
            border-radius: 17px;
        }

            .metric-card::before {
                position: absolute;
                top: 0;
                bottom: 0;
                left: 0;
                width: 5px;
                content: "";
