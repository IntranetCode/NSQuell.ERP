@model ERP.NSQuell.Models.ProduccionOperadorCajasVm
@using System.Linq

@{
    Layout = "~/Views/Shared/_Layout.cshtml";

    var cajas = Model.Cajas ?? new List<ERP.NSQuell.Models.ProduccionOperadorCajaVm>();
    var cajasAsignadas = Model.CajasIncompletasDisponibles ?? new List<ERP.NSQuell.Models.ProduccionCajaIncompletaDisponibleVm>();

    var totalCapturado = Model.CantidadOKTotal + Model.CantidadSospechosaTotal + Model.CantidadScrapTotal;
    var totalEnCajas = Model.CantidadOKEnCajas + Model.CantidadSospechosaEnCajas + Model.CantidadScrapEnCajas + Model.CantidadRetencionEnCajas;

    var pendientesCalidad = cajas.Count(x => x.EstadoCajaID == 2);
    var liberadasCalidad = cajas.Count(x => x.EstadoCajaID >= 3 && x.EtiquetaVerde);
    var enZonaVerde = cajas.Count(x => x.EstadoCajaID == 5);
    var salidasProduccion = cajas.Count(x => x.EstadoCajaID >= 6);

    var pendienteEmpaque = totalCapturado - totalEnCajas;
    if (pendienteEmpaque < 0)
    {
        pendienteEmpaque = 0;
    }

    var avanceCajas = totalCapturado > 0
        ? Math.Round(((decimal)totalEnCajas * 100m) / totalCapturado, 2)
        : 0m;

    if (avanceCajas < 0)
    {
        avanceCajas = 0;
    }

    if (avanceCajas > 100)
    {
        avanceCajas = 100;
    }

    var avanceTexto = avanceCajas.ToString("0.##", System.Globalization.CultureInfo.InvariantCulture);
    var cajasOKNuevasFormadas = cajas.Count(x => string.Equals(x.TipoCaja, "OK", StringComparison.OrdinalIgnoreCase) && !x.FechaCompletadoIncompleto.HasValue);
    var avanceEmbalajes = Model.CajasEsperadas > 0 ? Math.Min(100m, Math.Round((decimal)cajasOKNuevasFormadas * 100m / Model.CajasEsperadas, 2)) : 0m;
    var avanceEmbalajesTexto = avanceEmbalajes.ToString("0.##", System.Globalization.CultureInfo.InvariantCulture);
    var piezasPlaneadasPendientes = Math.Max(0, Model.CantidadPlaneada - Model.PiezasOKEmpacadas);
    var cajasConEtiquetaFisica = cajas.Count(x => x.TieneEtiquetaFisica);
    var cajasPendientesRecepcionCalidad = cajas.Count(x => x.PendienteRecepcionFisicaCalidad);
    var cajasRecibidasFisicamenteCalidad = cajas.Count(x => x.RecibidaFisicamenteCalidad);
}

@functions {
    public static string Txt(string value)
    {
        return string.IsNullOrWhiteSpace(value) ? "-" : value.Trim();
    }

    public static string TxtNullable(string value)
    {
        return string.IsNullOrWhiteSpace(value) ? "-" : value.Trim();
    }

    public static string Numero(int value)
    {
        return value.ToString("N0");
    }

    public static string FechaTxt(DateTime? value)
    {
        return value.HasValue
            ? value.Value.ToString("dd/MM/yyyy HH:mm")
            : "-";
    }

    public static string FechaTxtNoNullable(DateTime value)
    {
        return value == DateTime.MinValue
            ? "-"
            : value.ToString("dd/MM/yyyy HH:mm");
    }

    public static string OFTexto(ERP.NSQuell.Models.ProduccionOperadorCajasVm item)
    {
        if (!string.IsNullOrWhiteSpace(item.NumeroOFRecibida))
            return item.NumeroOFRecibida;

        if (!string.IsNullOrWhiteSpace(item.FolioSolicitud))
            return item.FolioSolicitud;

        return "Programa " + item.ProgramaProduccionID.ToString();
    }

    public static string ParteTexto(ERP.NSQuell.Models.ProduccionOperadorCajasVm item)
    {
        if (!string.IsNullOrWhiteSpace(item.ReferenciaSAP))
            return item.ReferenciaSAP;

        if (!string.IsNullOrWhiteSpace(item.NumeroParte))
            return item.NumeroParte;

        return "-";
    }

    public static string EstadoClaseCaja(ERP.NSQuell.Models.ProduccionOperadorCajaVm caja)
    {
        if (caja.EstadoCajaID == 1)
            return "badge-neutral";

        if (caja.EstadoCajaID == 2)
            return "badge-warning";

        if (caja.EstadoCajaID == 3)
            return "badge-success";

        if (caja.EstadoCajaID == 4)
            return "badge-danger";

        if (caja.EstadoCajaID == 5)
            return "badge-green";

        if (caja.EstadoCajaID == 6)
            return "badge-blue";

        if (caja.EstadoCajaID == 7)
            return "badge-darkx";

        return "badge-neutral";
    }

    public static string TipoClase(string tipo)
    {
        var t = string.IsNullOrWhiteSpace(tipo)
            ? ""
            : tipo.Trim().ToUpperInvariant();

        if (t == "OK")
            return "type-ok";

        if (t == "SOSPECHOSO")
            return "type-sos";

        if (t == "SCRAP")
            return "type-scrap";

        if (t == "RETENCION")
            return "type-ret";

        if (t == "INCOMPLETA" || t == "INCOMPLETO")
            return "type-white";

        return "type-default";
    }
}
