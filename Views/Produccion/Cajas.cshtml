@model ERP.NSQuell.Models.ProduccionOperadorCajasVm
@using System
@using System.Collections.Generic
@using System.Globalization
@using System.Linq

@{
    Layout = "~/Views/Shared/_Layout.cshtml";
    ViewData["Title"] = "Cajas de Producción";

    var cajas = Model.Cajas ?? new List<ERP.NSQuell.Models.ProduccionOperadorCajaVm>();
    var cajasEstimadas = Model.CajasEstimadas ?? new List<ERP.NSQuell.Models.ProduccionCajaEstimadaVm>();
    var cajasIncompletas = Model.CajasIncompletasDisponibles ?? new List<ERP.NSQuell.Models.ProduccionCajaIncompletaDisponibleVm>();

    var cajasPendientesValidacionCalidad = cajas.Count(x =>
        x.EstadoCajaID == ERP.NSQuell.Models.ProduccionCajaEstatus.PendienteCalidad &&
        x.FechaEscaneoCalidad.HasValue &&
        !x.FechaLiberacionCalidad.HasValue);

    var cajasLegacyPendientesEscaneo = cajas.Count(x =>
        x.EstadoCajaID == ERP.NSQuell.Models.ProduccionCajaEstatus.PendienteCalidad &&
        !x.FechaEscaneoCalidad.HasValue);

    var cajasPendientesEntregaAlmacen = cajas.Count(x =>
        (x.EstadoCajaID == ERP.NSQuell.Models.ProduccionCajaEstatus.LiberadaCalidad ||
         x.EstadoCajaID == ERP.NSQuell.Models.ProduccionCajaEstatus.ZonaVerde) &&
        x.EtiquetaVerde &&
        !x.FechaSalidaProduccion.HasValue);

    var cajasPendientesRecepcionAlmacen = cajas.Count(x =>
        (x.EstadoCajaID == ERP.NSQuell.Models.ProduccionCajaEstatus.SalidaProduccion ||
         x.FechaSalidaProduccion.HasValue) &&
        !x.FechaRecepcionAlmacen.HasValue);

    var cajasRecibidasAlmacen = cajas.Count(x =>
        x.EstadoCajaID == ERP.NSQuell.Models.ProduccionCajaEstatus.RecibidaAlmacenPt ||
        x.FechaRecepcionAlmacen.HasValue);

    var cajasRetenidas = cajas.Count(x =>
        x.EstadoCajaID == ERP.NSQuell.Models.ProduccionCajaEstatus.RetenidaGp12Scrap);

    var cajasDevueltas = cajas.Count(x =>
        x.EstadoCajaID == ERP.NSQuell.Models.ProduccionCajaEstatus.FormadaProduccion &&
        string.Equals(x.ResultadoCalidad, "DEVUELTA", StringComparison.OrdinalIgnoreCase));

    var puedeEscanearEntrega = cajasPendientesEntregaAlmacen > 0;

    var porcentajeProduccion = Model.CantidadPlaneada > 0
        ? Math.Min(100m, Math.Round((decimal)Model.CantidadOKTotal * 100m / Model.CantidadPlaneada, 1))
        : 0m;

    var porcentajeMaterializado = Model.CantidadPlaneada > 0
        ? Math.Min(100m, Math.Round((decimal)Model.CantidadOKEnCajas * 100m / Model.CantidadPlaneada, 1))
        : 0m;

    var porcentajeProduccionTexto = porcentajeProduccion.ToString("0.##", CultureInfo.InvariantCulture);
    var porcentajeMaterializadoTexto = porcentajeMaterializado.ToString("0.##", CultureInfo.InvariantCulture);
}

@functions {
    public static string Txt(string? value)
    {
        return string.IsNullOrWhiteSpace(value) ? "-" : value.Trim();
    }

    public static string Numero(int value)
    {
        return value.ToString("N0");
    }

    public static string FechaTxt(DateTime? value)
    {
        return value.HasValue ? value.Value.ToString("dd/MM/yyyy HH:mm") : "-";
    }

    public static string OFTexto(ERP.NSQuell.Models.ProduccionOperadorCajasVm item)
    {
        if (!string.IsNullOrWhiteSpace(item.NumeroOFRecibida)) return item.NumeroOFRecibida;
        if (!string.IsNullOrWhiteSpace(item.FolioSolicitud)) return item.FolioSolicitud;
        return $"Programa {item.ProgramaProduccionID}";
    }

    public static string ParteTexto(ERP.NSQuell.Models.ProduccionOperadorCajasVm item)
    {
        if (!string.IsNullOrWhiteSpace(item.ReferenciaSAP)) return item.ReferenciaSAP;
        if (!string.IsNullOrWhiteSpace(item.NumeroParte)) return item.NumeroParte;
        return "-";
    }

    public static string TipoClase(string? tipo)
    {
        var valor = string.IsNullOrWhiteSpace(tipo) ? string.Empty : tipo.Trim().ToUpperInvariant();
        return valor switch
        {
            "OK" => "type-ok",
            "SOSPECHOSO" => "type-warning",
            "SOSPECHOSA" => "type-warning",
            "SCRAP" => "type-danger",
            "RETENCION" => "type-warning",
            "RETENCIÓN" => "type-warning",
            "INCOMPLETA" => "type-white",
            "INCOMPLETO" => "type-white",
            _ => "type-default"
        };
    }

    public static string EstadoOperativo(ERP.NSQuell.Models.ProduccionOperadorCajaVm caja)
    {
        if (caja.FechaRecepcionAlmacen.HasValue || caja.EstadoCajaID == ERP.NSQuell.Models.ProduccionCajaEstatus.RecibidaAlmacenPt)
            return "Recibida en Almacén PT";

        if (caja.FechaSalidaProduccion.HasValue || caja.EstadoCajaID == ERP.NSQuell.Models.ProduccionCajaEstatus.SalidaProduccion)
            return "Pendiente recepción Almacén PT";

        if ((caja.EstadoCajaID == ERP.NSQuell.Models.ProduccionCajaEstatus.LiberadaCalidad ||
             caja.EstadoCajaID == ERP.NSQuell.Models.ProduccionCajaEstatus.ZonaVerde) &&
            caja.EtiquetaVerde)
            return "Pendiente entrega a Almacén";

        if (caja.EstadoCajaID == ERP.NSQuell.Models.ProduccionCajaEstatus.PendienteCalidad &&
            caja.FechaEscaneoCalidad.HasValue)
            return "Escaneada por Calidad · pendiente validación";

        if (caja.EstadoCajaID == ERP.NSQuell.Models.ProduccionCajaEstatus.PendienteCalidad)
            return "Pendiente escaneo Calidad";

        if (caja.EstadoCajaID == ERP.NSQuell.Models.ProduccionCajaEstatus.RetenidaGp12Scrap)
        {
            if (string.Equals(caja.ResultadoCalidad, "GP12", StringComparison.OrdinalIgnoreCase)) return "En GP12";
            if (string.Equals(caja.ResultadoCalidad, "SCRAP", StringComparison.OrdinalIgnoreCase)) return "Scrap";
            return "Retenida por Calidad";
        }

        if (caja.EstadoCajaID == ERP.NSQuell.Models.ProduccionCajaEstatus.FormadaProduccion &&
            string.Equals(caja.ResultadoCalidad, "DEVUELTA", StringComparison.OrdinalIgnoreCase))
            return "Devuelta por Calidad";

        if (caja.EsProductoIncompleto) return "Producto incompleto";

        return string.IsNullOrWhiteSpace(caja.EstadoCajaNombre)
            ? "Caja registrada"
            : caja.EstadoCajaNombre;
    }

    public static string EstadoClase(ERP.NSQuell.Models.ProduccionOperadorCajaVm caja)
    {
        if (caja.FechaRecepcionAlmacen.HasValue || caja.EstadoCajaID == ERP.NSQuell.Models.ProduccionCajaEstatus.RecibidaAlmacenPt)
            return "status-finished";

        if (caja.FechaSalidaProduccion.HasValue || caja.EstadoCajaID == ERP.NSQuell.Models.ProduccionCajaEstatus.SalidaProduccion)
            return "status-blue";

        if ((caja.EstadoCajaID == ERP.NSQuell.Models.ProduccionCajaEstatus.LiberadaCalidad ||
             caja.EstadoCajaID == ERP.NSQuell.Models.ProduccionCajaEstatus.ZonaVerde) &&
            caja.EtiquetaVerde)
            return "status-green";

        if (caja.EstadoCajaID == ERP.NSQuell.Models.ProduccionCajaEstatus.PendienteCalidad &&
            caja.FechaEscaneoCalidad.HasValue)
            return "status-quality";

        if (caja.EstadoCajaID == ERP.NSQuell.Models.ProduccionCajaEstatus.PendienteCalidad)
            return "status-warning";

        if (caja.EstadoCajaID == ERP.NSQuell.Models.ProduccionCajaEstatus.RetenidaGp12Scrap)
            return "status-red";

        if (caja.EstadoCajaID == ERP.NSQuell.Models.ProduccionCajaEstatus.FormadaProduccion &&
            string.Equals(caja.ResultadoCalidad, "DEVUELTA", StringComparison.OrdinalIgnoreCase))
            return "status-red";

        return "status-neutral";
    }
}

@section Styles {
