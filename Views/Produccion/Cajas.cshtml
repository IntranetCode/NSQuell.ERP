            background: #f8fafc;
            text-align: center;
            font-weight: 800;
        }

        .white-grid {
            display: grid;
            grid-template-columns: repeat(auto-fill,minmax(260px,1fr));
            gap: 10px;
        }

        .white-card {
            padding: 13px;
            border: 1px solid #d0d5dd;
            border-radius: 15px;
            background: #f9fafb;
        }

        .white-title {
            color: #344054;
            font-size: 1rem;
            font-weight: 950;
        }

        .white-data-grid {
            display: grid;
            grid-template-columns: repeat(3,minmax(0,1fr));
            gap: 7px;
            margin: 10px 0;
        }

        .white-data {
            padding: 8px;
            border: 1px solid #e4e7ec;
            border-radius: 10px;
            background: #fff;
        }

            .white-data .n {
                margin-top: 2px;
                font-weight: 950;
            }

        .form-message {
            display: none;
            margin-top: 8px;
            padding: 8px 10px;
            border-radius: 10px;
            font-size: .8rem;
            font-weight: 800;
        }

            .form-message.error {
                display: block;
                color: #b42318;
                background: #fef3f2;
                border: 1px solid #fecdca;
            }

        @@media(max-width:1350px) {
            .info-grid, .metrics {
                grid-template-columns: repeat(3,minmax(0,1fr));
            }

            .scanner-grid {
                grid-template-columns: 1fr;
            }
        }

        @@media(max-width:760px) {
            .page {
                padding: 12px;
            }

            .hero {
                padding: 18px;
            }

            .info-grid, .metrics, .progress-area {
                grid-template-columns: 1fr;
            }

            .white-data-grid, .scanner-stats {
                grid-template-columns: 1fr;
            }
        }
    </style>
}

<div class="page">
    <section class="hero">
        <div class="hero-top">
            <div>
                <h1><i class="fa-solid fa-boxes-stacked me-2"></i>Cajas de Producción</h1>
                <p>
                    El ERP estima automáticamente las cajas posibles con base en la producción OK y la capacidad del embalaje.
                    Producción forma las cajas únicamente de manera física. Planeación coloca la etiqueta y Calidad realiza el primer escaneo.
                    Una caja existe realmente en el ERP cuando Calidad escanea su etiqueta.
                </p>
            </div>
            <div class="hero-actions">
                <a href="@Url.Action("Detalle", "Produccion", new { id = Model.EjecucionProduccionID })" class="btn-hero">
                    <i class="fa-solid fa-arrow-left"></i>Volver
                </a>
                <a href="@Url.Action("Cajas", "Produccion", new { id = Model.EjecucionProduccionID })" class="btn-hero">
                    <i class="fa-solid fa-rotate-right"></i>Actualizar
                </a>
            </div>
        </div>
    </section>

    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success rounded-4 fw-bold">@TempData["Success"]</div>
    }
    @if (TempData["Info"] != null)
    {
        <div class="alert alert-info rounded-4 fw-bold">@TempData["Info"]</div>
    }
    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger rounded-4 fw-bold">@TempData["Error"]</div>
    }

    <section class="info-grid">
        <div class="info-card">
            <div class="k">OF</div>
            <div class="v">@OFTexto(Model)</div>
            <div class="sub">Programa @Model.ProgramaProduccionID</div>
        </div>
        <div class="info-card">
            <div class="k">Cliente</div>
            <div class="v">@Txt(Model.ClienteNombre)</div>
            <div class="sub">Ejecución @Model.EjecucionProduccionID</div>
        </div>
        <div class="info-card">
            <div class="k">Máquina</div>
            <div class="v">@Txt(Model.MaquinaCodigo)</div>
            <div class="sub">@Txt(Model.MaquinaNombre)</div>
        </div>
        <div class="info-card">
            <div class="k">Parte</div>
            <div class="v">@ParteTexto(Model)</div>
            <div class="sub">@Txt(Model.DescripcionParte)</div>
        </div>
        <div class="info-card">
            <div class="k">Capacidad por caja</div>
            <div class="v">@(Model.PiezasPorCajaSugeridas > 0 ? Numero(Model.PiezasPorCajaSugeridas) : "-")</div>
            <div class="sub">@Txt(Model.EmbalajeCodigo) · @Txt(Model.EmbalajeDescripcion)</div>
        </div>
        <div class="info-card">
            <div class="k">Cantidad planeada</div>
            <div class="v">@Numero(Model.CantidadPlaneada)</div>
            <div class="sub">OK producido: @Numero(Model.CantidadOKTotal)</div>
        </div>
    </section>

    <section class="metrics">
        <div class="metric-card estimated">
            <div class="k">Cajas estimadas disponibles</div>
            <div class="metric-number">@Numero(Model.TotalCajasEstimadas)</div>
            <div class="sub">Posibles cajas físicas aún no escaneadas por Calidad.</div>
        </div>
        <div class="metric-card quality">
            <div class="k">Pendiente validación Calidad</div>
            <div class="metric-number">@Numero(cajasPendientesValidacionCalidad)</div>
            <div class="sub">Ya existen en ERP porque Calidad las escaneó.</div>
        </div>
        <div class="metric-card green">
            <div class="k">Pendiente entrega Almacén</div>
            <div class="metric-number">@Numero(cajasPendientesEntregaAlmacen)</div>
            <div class="sub">Validadas en verde y listas para entregar.</div>
        </div>
        <div class="metric-card blue">
            <div class="k">Pendiente recepción Almacén</div>
            <div class="metric-number">@Numero(cajasPendientesRecepcionAlmacen)</div>
            <div class="sub">Producción ya escaneó su entrega.</div>
        </div>
        <div class="metric-card finished">
            <div class="k">Recibidas Almacén PT</div>
            <div class="metric-number">@Numero(cajasRecibidasAlmacen)</div>
            <div class="sub">Flujo físico completado.</div>
        </div>
        <div class="metric-card red">
            <div class="k">Retenidas / devueltas</div>
            <div class="metric-number">@Numero(cajasRetenidas + cajasDevueltas)</div>
            <div class="sub">Requieren atención antes de continuar.</div>
        </div>
    </section>

    <section class="progress-area">
        <div class="progress-card">
            <div class="d-flex justify-content-between">
                <div>
                    <div class="k">Avance producción OK</div>
                    <strong>@Numero(Model.CantidadOKTotal) / @Numero(Model.CantidadPlaneada)</strong>
                </div>
                <strong>@porcentajeProduccion.ToString("0.#")%</strong>
            </div>
            <div class="progress">
                <div class="progress-bar" style="width:@porcentajeProduccionTexto%"></div>
            </div>
        </div>
        <div class="progress-card">
            <div class="d-flex justify-content-between">
                <div>
                    <div class="k">Piezas ya relacionadas a cajas reales</div>
                    <strong>@Numero(Model.CantidadOKEnCajas) / @Numero(Model.CantidadPlaneada)</strong>
                </div>
                <strong>@porcentajeMaterializado.ToString("0.#")%</strong>
            </div>
            <div class="progress">
                <div class="progress-bar green" style="width:@porcentajeMaterializadoTexto%"></div>
            </div>
        </div>
    </section>

    <section class="estimate-panel">
        <div class="estimate-head">
            <div class="estimate-title">
                <i class="fa-solid fa-calculator me-2"></i>
                Estimación automática de cajas posibles
            </div>
            <span class="badge text-bg-warning">@Numero(Model.TotalCajasEstimadas) estimada(s)</span>
        </div>
        <div class="estimate-body">
            <div class="note mb-3">
                <i class="fa-solid fa-circle-info me-1"></i>
                Estas cajas <strong>no son registros reales</strong>, y no requieren que Producción capture nada.
                Solo representan cajas que podrían estar físicamente listas con las piezas OK actualmente producidas.
                Cuando Calidad escanee la etiqueta real, esa caja se registrará en ERP.
            </div>

            @if (Model.PiezasPorCajaSugeridas <= 0)
            {
                <div class="warning-note">
                    <i class="fa-solid fa-triangle-exclamation me-1"></i>
                    No se puede calcular la estimación porque la parte no tiene configuradas las piezas por embalaje.
                </div>
            }
            else if (!cajasEstimadas.Any() && !Model.TieneAcumulacionSiguienteCaja)
            {
                <div class="empty">
                    <i class="fa-solid fa-box-open fa-2x mb-2 d-block"></i>
                    Todavía no hay suficientes piezas OK disponibles para estimar una caja nueva.
                </div>
            }
            else
            {
                @if (cajasEstimadas.Any())
                {
                    <div class="estimate-grid">
                        @foreach (var estimada in cajasEstimadas)
                        {
                            <div class="estimate-card @(estimada.EsParcial ? "partial" : "")">
                                <div class="d-flex justify-content-between align-items-start gap-2">
                                    <div>
                                        <div class="k">Referencia visual</div>
                                        <div class="estimate-code">@estimada.ClaveEstimada</div>
                                    </div>
                                    @if (estimada.EsUltimaPlaneada)
                                    {
                                        <span class="badge text-bg-primary">Última planeada</span>
                                    }
                            </div>

                            <div class="estimate-qty">@Numero(estimada.CantidadPiezas) <small class="fs-6">pza(s)</small></div>
                            <div class="sub">Capacidad: @Numero(estimada.CapacidadCaja)</div>

                            <div class="estimate-badge">
                                <i class="fa-solid fa-hourglass-half"></i>
                                Pendiente escaneo Calidad
                            </div>

                            <div class="sub mt-2">
                                @(estimada.EsParcial
                                                        ? "Caja parcial final estimada."
                                                        : "Caja completa estimada.")
                    </div>
                </div>
                                }
                    </div>
                }

                @if (Model.TieneAcumulacionSiguienteCaja)
                {
                    <div class="accumulation">
                        <div class="accumulation-icon">
                            <i class="fa-solid fa-box-open"></i>
                        </div>
                        <div>
                            <div class="fw-bold text-primary">Piezas acumulándose para la siguiente caja</div>
                            <div class="sub">
                                Actualmente hay <strong>@Numero(Model.PiezasAcumuladasSiguienteCaja)</strong> pieza(s) OK disponibles que todavía no completan la siguiente caja estimada.
                            </div>
                        </div>
                        <div class="text-end">
                            <div class="k">Faltan</div>
                            <div class="fw-bold fs-5 text-primary">@Numero(Model.PiezasFaltantesSiguienteCaja)</div>
                        </div>
                    </div>
                }
            }

            @if (cajasLegacyPendientesEscaneo > 0)
            {
                <div class="warning-note mt-3">
                    Existen @Numero(cajasLegacyPendientesEscaneo) caja(s) del flujo anterior pendientes de escaneo por Calidad.
                    Se conservarán para compatibilidad hasta terminar la transición.
                </div>
            }
        </div>
    </section>

    <section class="scanner-panel">
        <div class="scanner-head">
            <div class="scanner-title">
                <i class="fa-solid fa-truck-ramp-box me-2"></i>
                Entrega física de Producción a Almacén PT
            </div>
            @if (puedeEscanearEntrega)
            {
                <span class="status status-green">
                    <i class="fa-solid fa-barcode"></i>
                    Lector habilitado
                </span>
            }
            else
            {
                <span class="status status-neutral">
                    <i class="fa-solid fa-lock"></i>
                    Sin cajas verdes
                </span>
            }
        </div>
        <div class="scanner-body">
            @if (puedeEscanearEntrega)
            {
                <div class="success-note mb-3">
                    Hay <strong>@Numero(cajasPendientesEntregaAlmacen)</strong> caja(s) validadas por Calidad.
                    Escanea únicamente la caja que estás entregando físicamente. Puedes entregar las cajas una por una.
                </div>
            }
            else
            {
                <div class="note mb-3">
                    Producción no necesita escanear ninguna caja hasta que Calidad la haya validado con etiqueta verde.
                </div>
            }

            <div class="scanner-grid">
                <form method="post" action="@Url.Action("EscanearSalidaCaja","Produccion")" id="formEntregaAlmacen" autocomplete="off">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="ejecucionProduccionId" value="@Model.EjecucionProduccionID" />

                    <label class="k mb-2 d-block" for="etiquetaEntrega">Etiqueta de la caja que estás entregando</label>
                    <div class="scanner-input-wrap">
                        <input type="text"
                               id="etiquetaEntrega"
                               name="etiquetaEscaneada"
                               maxlength="500"
                               class="form-control scanner-input"
                               placeholder="Escanea la etiqueta..."
                               autocomplete="off"
                               autocapitalize="off"
                               spellcheck="false"
                               @(puedeEscanearEntrega ? "" : "disabled") />
                        <i class="fa-solid fa-barcode scanner-icon"></i>
                    </div>
                    <div class="sub mt-2">
                        El ERP solo aceptará cajas previamente escaneadas y liberadas en verde por Calidad.
                    </div>
                    <div class="form-message" id="mensajeEntrega"></div>
                </form>

                <div class="scanner-side">
                    <div class="k">Flujo físico</div>
                    <strong>Calidad valida → Producción entrega → Almacén recibe</strong>
                    <div class="sub">
                        Este escaneo significa que la caja realmente está saliendo de Producción hacia Almacén PT.
                    </div>
                    <div class="scanner-stats">
                        <div class="scanner-stat">
                            <div class="k">Listas</div>
                            <div class="n text-success">@Numero(cajasPendientesEntregaAlmacen)</div>
                        </div>
                        <div class="scanner-stat">
                            <div class="k">Entregadas</div>
                            <div class="n text-primary">@Numero(cajasPendientesRecepcionAlmacen)</div>
                        </div>
                        <div class="scanner-stat">
                            <div class="k">Recibidas</div>
                            <div class="n">@Numero(cajasRecibidasAlmacen)</div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </section>

    <section class="panel">
        <div class="panel-head">
            <div class="panel-title">
                <i class="fa-solid fa-list-check me-2"></i>
                Cajas reales registradas
            </div>
            <span class="badge text-bg-light">@Numero(cajas.Count) caja(s)</span>
        </div>
        <div class="panel-body">
            @if (!cajas.Any())
            {
                <div class="empty">
                    <i class="fa-solid fa-barcode fa-2x mb-2 d-block"></i>
                    Todavía no existen cajas reales registradas para esta ejecución.
                    <div class="sub mt-2">La primera aparecerá cuando Calidad escanee una etiqueta física.</div>
                </div>
            }
            else
            {
                <div class="table-wrap">
                    <table class="table">
                        <thead>
                            <tr>
                                <th>Caja</th>
                                <th>Tipo</th>
                                <th>Cantidad</th>
                                <th>Estado</th>
                                <th>Etiqueta física</th>
                                <th>Calidad</th>
                                <th>Producción</th>
                                <th>Almacén PT</th>
                                <th>Acción</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var caja in cajas.OrderBy(x => x.NumeroCaja))
                            {
                                var listaEntrega =
                                (caja.EstadoCajaID == ERP.NSQuell.Models.ProduccionCajaEstatus.LiberadaCalidad ||
                                caja.EstadoCajaID == ERP.NSQuell.Models.ProduccionCajaEstatus.ZonaVerde) &&
                                caja.EtiquetaVerde &&
                                !caja.FechaSalidaProduccion.HasValue;

                                var pendienteRecepcion =
                                (caja.EstadoCajaID == ERP.NSQuell.Models.ProduccionCajaEstatus.SalidaProduccion ||
                                caja.FechaSalidaProduccion.HasValue) &&
                                !caja.FechaRecepcionAlmacen.HasValue;

                                var recibida =
                                caja.EstadoCajaID == ERP.NSQuell.Models.ProduccionCajaEstatus.RecibidaAlmacenPt ||
                                caja.FechaRecepcionAlmacen.HasValue;

                                var devuelta =
                                caja.EstadoCajaID == ERP.NSQuell.Models.ProduccionCajaEstatus.FormadaProduccion &&
                                string.Equals(caja.ResultadoCalidad, "DEVUELTA", StringComparison.OrdinalIgnoreCase);

                                <tr>
                                    <td>
                                        <strong>#@caja.NumeroCaja.ToString("000")</strong>
                                        <div class="sub">@Txt(caja.FolioCaja)</div>
                                    </td>
                                    <td>
                                        <span class="type-pill @TipoClase(caja.TipoCaja)">@Txt(caja.TipoCaja)</span>
                                    </td>
                                    <td>
                                        <strong>@Numero(caja.CantidadPiezas)</strong>
                                    </td>
                                    <td>
                                        <span class="status @EstadoClase(caja)">
                                            @if (recibida)
                                            {
                                                <i class="fa-solid fa-warehouse"></i>
                                            }
                                            else if (pendienteRecepcion)
                                            {
                                                <i class="fa-solid fa-truck-ramp-box"></i>
                                            }
                                            else if (listaEntrega)
                                            {
                                                <i class="fa-solid fa-circle-check"></i>
                                            }
                                            else if (caja.EstadoCajaID == ERP.NSQuell.Models.ProduccionCajaEstatus.PendienteCalidad && caja.FechaEscaneoCalidad.HasValue)
                                            {
                                                <i class="fa-solid fa-microscope"></i>
                                            }
                                            else if (caja.EstadoCajaID == ERP.NSQuell.Models.ProduccionCajaEstatus.RetenidaGp12Scrap || devuelta)
                                            {
                                                <i class="fa-solid fa-triangle-exclamation"></i>
                                            }
                                            else
                                            {
                                                <i class="fa-solid fa-box"></i>
                                            }
                                            @EstadoOperativo(caja)
                                        </span>
                                        @if (!string.IsNullOrWhiteSpace(caja.MotivoCalidad))
                                        {
                                            <div class="sub text-danger">@caja.MotivoCalidad</div>
                                        }
                                    </td>
                                    <td>
                                        @if (!string.IsNullOrWhiteSpace(caja.CodigoBarrasOrigen))
                                        {
                                            <span class="physical physical-ok">
                                                <i class="fa-solid fa-barcode"></i>Asociada
                                            </span>
                                            <div class="code-text mt-1" title="@caja.CodigoBarrasOrigen">@caja.CodigoBarrasOrigen</div>
                                            <div class="sub">
                                                OF @Txt(caja.NumeroOFEtiqueta) · Parte @Txt(caja.NumeroParteEtiqueta)
                                            </div>
                                        }
                                        else
                                        {
                                            <span class="physical physical-wait">
                                                <i class="fa-solid fa-barcode"></i>Pendiente
                                            </span>
                                        }
                                    </td>
                                    <td>
                                        @if (caja.FechaLiberacionCalidad.HasValue)
                                        {
                                            <strong>@Txt(caja.ResultadoCalidad)</strong>
                                            <div class="sub">@FechaTxt(caja.FechaLiberacionCalidad)</div>
                                            @if (caja.EtiquetaVerde)
                                            {
                                                <span class="physical physical-ok mt-1">
                                                    <i class="fa-solid fa-tag"></i>Verde
                                                </span>
                                            }
                                        }
                                        else if (caja.FechaEscaneoCalidad.HasValue)
                                        {
                                            <strong style="color:#6941c6">Escaneada</strong>
                                            <div class="sub">@FechaTxt(caja.FechaEscaneoCalidad)</div>
                                            <div class="sub">Pendiente decisión.</div>
                                        }
                                        else
                                        {
                                            <span class="text-muted">-</span>
                                        }
                                    </td>
                                    <td>
                                        @if (caja.FechaSalidaProduccion.HasValue)
                                        {
                                            <strong class="text-primary">Entregada</strong>
                                            <div class="sub">@FechaTxt(caja.FechaSalidaProduccion)</div>
                                        }
                                        else if (listaEntrega)
                                        {
                                            <strong class="text-success">Lista para entregar</strong>
                                            <div class="sub">Escanea en el lector superior.</div>
                                        }
                                        else
                                        {
                                            <span class="text-muted">-</span>
                                        }
                                    </td>
                                    <td>
                                        @if (caja.FechaRecepcionAlmacen.HasValue)
                                        {
                                            <strong>Recibida</strong>
                                            <div class="sub">@FechaTxt(caja.FechaRecepcionAlmacen)</div>
                                        }
                                        else if (pendienteRecepcion)
                                        {
                                            <strong class="text-primary">Pendiente recepción</strong>
                                            <div class="sub">Almacén debe escanearla.</div>
                                        }
                                        else
                                        {
                                            <span class="text-muted">-</span>
                                        }
                                    </td>
                                    <td>
                                        @if (devuelta)
                                        {
                                            <div class="correction-box">
                                                <details>
                                                    <summary>
                                                        <i class="fa-solid fa-screwdriver-wrench me-1"></i>Registrar corrección
                                                    </summary>
                                                    <div class="correction-body">
                                                        @if (!string.IsNullOrWhiteSpace(caja.MotivoCalidad))
                                                        {
                                                            <div class="danger-note mb-2">@caja.MotivoCalidad</div>
                                                        }
                                                        <form method="post" action="@Url.Action("CorregirCajaDevuelta","Produccion")" class="form-correccion">
                                                            @Html.AntiForgeryToken()
                                                            <input type="hidden" name="cajaProduccionId" value="@caja.CajaProduccionID" />
                                                            <textarea name="correccionRealizada"
                                                          rows="3"
                                                          maxlength="1000"
                                                          class="form-control correccion-texto"
                                                          placeholder="Describe la corrección..."
                                                          required></textarea>
                                                            <button type="submit" class="btn-dangerx mt-2">
                                                                <i class="fa-solid fa-rotate-right"></i>Regresar a Calidad
                                                            </button>
                                                            <div class="form-message"></div>
                                                        </form>
                                                    </div>
                                                </details>
                                            </div>
                                        }
                                        else if (listaEntrega)
                                        {
                                            <span class="action-text text-success">
                                                <i class="fa-solid fa-barcode"></i>Escanear al entregar
                                            </span>
                                        }
                                        else if (pendienteRecepcion)
                                        {
                                            <span class="action-text text-primary">
                                                <i class="fa-solid fa-hourglass-half"></i>Esperando Almacén
                                            </span>
                                        }
                                        else if (recibida)
                                        {
                                            <span class="action-text text-success">
                                                <i class="fa-solid fa-circle-check"></i>Completada
                                            </span>
                                        }
                                        else if (caja.EstadoCajaID == ERP.NSQuell.Models.ProduccionCajaEstatus.PendienteCalidad)
                                        {
                                            <span class="action-text" style="color:#6941c6">
                                                <i class="fa-solid fa-microscope"></i>Esperando Calidad
                                            </span>
                                        }
                                        else if (caja.EstadoCajaID == ERP.NSQuell.Models.ProduccionCajaEstatus.RetenidaGp12Scrap)
                                        {
                                            <span class="action-text text-danger">
                                                <i class="fa-solid fa-triangle-exclamation"></i>Retenida
                                            </span>
                                        }
                                        else
                                        {
                                            <span class="text-muted">-</span>
                                        }
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
        </div>
    </section>

    @if (cajasIncompletas.Any())
    {
        <section class="panel">
            <div class="panel-head">
                <div class="panel-title">
                    <i class="fa-solid fa-tag me-2"></i>
                    Producto incompleto asignado
                </div>
                <span class="badge text-bg-light">@Numero(cajasIncompletas.Count)</span>
            </div>
            <div class="panel-body">
                <div class="note mb-3">
                    Este apartado corresponde al flujo especial de producto incompleto y se mantiene separado de las cajas normales estimadas.
                </div>
                <div class="white-grid">
                    @foreach (var blanca in cajasIncompletas)
                    {
                        var maximoCompletar = Math.Min(blanca.CantidadPendienteCompletar, Model.CantidadOKDisponible);
                        var puedeCompletar = Model.EstatusID == ERP.NSQuell.Models.ProduccionEstatus.EnProduccion &&
                        !Model.TieneParoAbierto &&
                        maximoCompletar > 0;

                        <div class="white-card">
                            <div class="k">Etiqueta blanca</div>
                            <div class="white-title">@Txt(blanca.EtiquetaBlanca)</div>
                            <div class="sub">Origen: @Txt(blanca.FolioCaja)</div>

                            <div class="white-data-grid">
                                <div class="white-data">
                                    <div class="k">Existentes</div>
                                    <div class="n">@Numero(blanca.CantidadPiezas)</div>
                                </div>
                                <div class="white-data">
                                    <div class="k">Capacidad</div>
                                    <div class="n">@Numero(blanca.CapacidadObjetivoCaja)</div>
                                </div>
                                <div class="white-data">
                                    <div class="k">Faltan</div>
                                    <div class="n text-primary">@Numero(blanca.CantidadPendienteCompletar)</div>
                                </div>
                            </div>

                            <form method="post" action="@Url.Action("CompletarCajaIncompleta","Produccion")" class="form-completar">
                                @Html.AntiForgeryToken()
                                <input type="hidden" name="EjecucionProduccionID" value="@Model.EjecucionProduccionID" />
                                <input type="hidden" name="CajaProduccionID" value="@blanca.CajaProduccionID" />

                                <label class="k mb-1 d-block">Piezas a agregar</label>
                                <input type="number"
                                       name="CantidadPiezas"
                                       min="1"
                                       max="@Math.Max(1, maximoCompletar)"
                                       value="@(maximoCompletar > 0 ? maximoCompletar : null)"
                                       class="form-control cantidad-completar"
                                       data-pendiente="@blanca.CantidadPendienteCompletar"
                                       data-disponible="@Model.CantidadOKDisponible"
                                       @(!puedeCompletar ? "disabled" : "")
                                       required />

                                <textarea name="Observaciones"
                                  rows="2"
                                  maxlength="500"
                                  class="form-control mt-2"
                                  placeholder="Observaciones opcionales..."
                                  @(!puedeCompletar ? "disabled" : "")></textarea>

                                <button type="submit" class="btn-main mt-2" @(!puedeCompletar ? "disabled" : "")>
                                    <i class="fa-solid fa-box-open"></i>Agregar piezas
                                </button>
                                <div class="form-message"></div>
                            </form>
                        </div>
                    }
                </div>
            </div>
        </section>
    }

    @if (cajasRetenidas > 0 || cajasDevueltas > 0)
    {
        <section class="panel">
            <div class="panel-head">
                <div class="panel-title">
                    <i class="fa-solid fa-triangle-exclamation me-2"></i>
                    Atención requerida
                </div>
            </div>
            <div class="panel-body">
                @if (cajasDevueltas > 0)
                {
                    <div class="danger-note mb-2">
                        <strong>@Numero(cajasDevueltas)</strong> caja(s) fueron devueltas por Calidad y requieren corrección de Producción.
                    </div>
                }
                @if (cajasRetenidas > 0)
                {
                    <div class="warning-note">
                        <strong>@Numero(cajasRetenidas)</strong> caja(s) están retenidas por Calidad / GP12 / Scrap.
                    </div>
                }
            </div>
        </section>
    }
</div>

@section Scripts {
    <script>
        (() => {
            function mostrarError(elemento,mensaje){
                if(!elemento)return;
                elemento.textContent=mensaje;
                elemento.className='form-message error';
            }

            function limpiarError(elemento){
                if(!elemento)return;
                elemento.textContent='';
                elemento.className='form-message';
            }

            const formEntrega=document.getElementById('formEntregaAlmacen');
            const etiquetaEntrega=document.getElementById('etiquetaEntrega');
            const mensajeEntrega=document.getElementById('mensajeEntrega');
            let enviando=false;

            etiquetaEntrega?.addEventListener('keydown',e=>{
                if(e.key!=='Enter')return;
                e.preventDefault();
                if(enviando)return;

                limpiarError(mensajeEntrega);
                const codigo=etiquetaEntrega.value.trim();

                if(!codigo){
                    mostrarError(mensajeEntrega,'Escanea la etiqueta de la caja que estás entregando.');
                    etiquetaEntrega.focus();
                    return;
                }

                enviando=true;
                etiquetaEntrega.readOnly=true;
                formEntrega?.requestSubmit();
            });

            formEntrega?.addEventListener('submit',e=>{
                const codigo=etiquetaEntrega?.value.trim()||'';

                if(!codigo){
                    e.preventDefault();
                    enviando=false;
                    mostrarError(mensajeEntrega,'Escanea una etiqueta antes de continuar.');

                    if(etiquetaEntrega){
                        etiquetaEntrega.readOnly=false;
                        etiquetaEntrega.focus();
                    }
                }
            });

            document.querySelectorAll('.form-correccion').forEach(form=>{
                form.addEventListener('submit',e=>{
                    const texto=form.querySelector('.correccion-texto');
                    const mensaje=form.querySelector('.form-message');
                    const boton=form.querySelector('button[type="submit"]');

                    limpiarError(mensaje);

                    if(!texto?.value.trim()){
                        e.preventDefault();
                        mostrarError(mensaje,'Describe la corrección realizada.');
                        texto?.focus();
                        return;
                    }

                    if(boton){
                        boton.disabled=true;
                        boton.innerHTML='<i class="fa-solid fa-spinner fa-spin"></i> Registrando...';
                    }
                });
            });

            document.querySelectorAll('.form-completar').forEach(form=>{
                form.addEventListener('submit',e=>{
                    const input=form.querySelector('.cantidad-completar');
                    const mensaje=form.querySelector('.form-message');
                    const boton=form.querySelector('button[type="submit"]');

                    limpiarError(mensaje);

                    const cantidad=Number(input?.value||0);
                    const pendiente=Number(input?.dataset.pendiente||0);
                    const disponible=Number(input?.dataset.disponible||0);

                    if(cantidad<=0){
                        e.preventDefault();
                        mostrarError(mensaje,'Captura una cantidad mayor a cero.');
                        return;
                    }

                    if(cantidad>pendiente){
                        e.preventDefault();
                        mostrarError(mensaje,'La cantidad supera las piezas pendientes de esta caja.');
                        return;
                    }

                    if(cantidad>disponible){
                        e.preventDefault();
                        mostrarError(mensaje,'La cantidad supera las piezas OK disponibles.');
                        return;
                    }

                    if(boton){
                        boton.disabled=true;
                        boton.innerHTML='<i class="fa-solid fa-spinner fa-spin"></i> Aplicando...';
                    }
                });
            });

            window.addEventListener('load',()=>{
                if(etiquetaEntrega&&!etiquetaEntrega.disabled){
                    etiquetaEntrega.value='';
                    etiquetaEntrega.focus();
                }
            });
        })();
    </script>
}