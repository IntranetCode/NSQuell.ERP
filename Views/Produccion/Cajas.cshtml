            }

            .hero {
                border-radius: 22px;
                padding: 20px;
            }

                .hero h1 {
                    font-size: 1.45rem;
                }

            .metrics,
            .info-grid,
            .flow-metrics {
                grid-template-columns: 1fr;
            }

            .actions-grid {
                grid-template-columns: 1fr;
                min-width: 260px;
            }

            .scan-row {
                flex-direction: column;
                align-items: stretch;
            }

            .white-grid {
                grid-template-columns: 1fr;
            }

            .scan-stats {
                grid-template-columns: 1fr;
            }
        }
    </style>
}

<div class="page">

    <section class="hero">
        <div class="hero-top">
            <div>
                <h1>
                    <i class="fa-solid fa-boxes-stacked me-2"></i>
                    Cajas de Producción
                </h1>
                <p>
                    Gestión de cajas para Auxiliar de Producción. Escanea la etiqueta física para formar y enviar la caja a Calidad; el sistema valida OF, parte, cantidad y duplicados antes de registrarla.
                </p>
            </div>

            <div class="hero-actions">
                <a href="@Url.Action("Detalle", "Produccion", new { id = Model.EjecucionProduccionID })" class="btn-hero">
                    <i class="fa-solid fa-arrow-left"></i>
                    Volver al detalle
                </a>

                <a href="@Url.Action("Index", "Produccion")" class="btn-hero">
                    <i class="fa-solid fa-industry"></i>
                    Producción
                </a>

                <a href="@Url.Action("Cajas", "Produccion", new { id = Model.EjecucionProduccionID })" class="btn-hero">
                    <i class="fa-solid fa-rotate-right"></i>
                    Actualizar
                </a>
            </div>
        </div>
    </section>

    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success rounded-4 fw-bold">
            <i class="fa-solid fa-circle-check me-1"></i>
            @TempData["Success"]
        </div>
    }

    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger rounded-4 fw-bold">
            <i class="fa-solid fa-triangle-exclamation me-1"></i>
            @TempData["Error"]
        </div>
    }

    <section class="info-grid">
        <div class="info">
            <div class="k">OF / Solicitud</div>
            <div class="v">@OFTexto(Model)</div>
            <div class="sub">
                @if (Model.SolicitudProduccionID.HasValue)
                {
                    <span>Solicitud @Model.SolicitudProduccionID.Value</span>
                }
                else
                {
                    <span>Sin solicitud vinculada</span>
                }
            </div>
        </div>

        <div class="info">
            <div class="k">Cliente</div>
            <div class="v">@TxtNullable(Model.ClienteNombre)</div>
            <div class="sub">Programa @Model.ProgramaProduccionID</div>
        </div>

        <div class="info">
            <div class="k">Máquina</div>
            <div class="v">@TxtNullable(Model.MaquinaCodigo)</div>
            <div class="sub">@TxtNullable(Model.MaquinaNombre)</div>
        </div>

        <div class="info">
            <div class="k">Parte</div>
            <div class="v">@ParteTexto(Model)</div>
            <div class="sub">@TxtNullable(Model.DescripcionParte)</div>
        </div>

        <div class="info">
            <div class="k">Molde</div>
            <div class="v">@TxtNullable(Model.MoldeCodigo)</div>
            <div class="sub">
                @TxtNullable(Model.MaterialCodigo)
                @if (!string.IsNullOrWhiteSpace(Model.MaterialDescripcion))
                {
                    <span> · @Model.MaterialDescripcion</span>
                }
            </div>
        </div>

        <div class="info">
            <div class="k">Estatus producción</div>
            <div class="v">@Model.EstatusNombre</div>
            <div class="sub @(Model.TieneParoAbierto ? "text-danger" : "")">
                @(Model.TieneParoAbierto ? "Paro abierto" : "Ejecución disponible")
            </div>
        </div>
    </section>

    <section class="metrics">
        <div class="metric"><div class="k">Piezas por embalaje</div><div class="num text-primary">@Numero(Model.PiezasPorCajaSugeridas)</div><div class="sub">Capacidad estándar</div></div>
        <div class="metric"><div class="k">Cajas esperadas</div><div class="num text-primary">@Numero(Model.CajasEsperadas)</div><div class="sub">Según Planeación</div></div>
        <div class="metric"><div class="k">Cajas nuevas OK</div><div class="num text-success">@Numero(cajasOKNuevasFormadas)</div><div class="sub">Pendientes de embalaje nuevo: @Numero(Math.Max(0, Model.CajasEsperadas - cajasOKNuevasFormadas))</div></div>
        <div class="metric"><div class="k">OK empacado</div><div class="num text-success">@Numero(Model.PiezasOKEmpacadas)</div><div class="sub">Pendiente planeado: @Numero(piezasPlaneadasPendientes)</div></div>
        <div class="metric"><div class="k">Siguiente sugerida</div><div class="num text-warning">@Numero(Model.CantidadSugeridaSiguienteCaja)</div><div class="sub">Última puede ser parcial</div></div>
        <div class="metric"><div class="k">Embalaje</div><div class="num" style="font-size:1rem">@TxtNullable(Model.EmbalajeCodigo)</div><div class="sub">@TxtNullable(Model.EmbalajeDescripcion)</div></div>
    </section>

    @if (!Model.TieneConfiguracionEmbalaje)
    {
        <div class="warn-note mb-3"><i class="fa-solid fa-triangle-exclamation me-1"></i>Esta ejecución no tiene configuración completa de embalaje. Podrás formar cajas con piezas capturadas, pero no se podrá validar automáticamente la cantidad esperada de cajas ni su capacidad estándar.</div>
    }


    <section class="scanner-panel">
        <div class="scanner-head">
            <div class="scanner-title">
                <i class="fa-solid fa-barcode"></i>
                Escaneo de caja física
            </div>
            <span class="scanner-status"><i class="fa-solid fa-circle"></i>Lector listo</span>
        </div>
        <div class="scanner-body">
            @if (Model.TieneParoAbierto)
            {
                <div class="danger-note mb-3"><i class="fa-solid fa-circle-pause me-1"></i>Hay un paro abierto. Cierra el paro antes de registrar una nueva caja.</div>
            }
            else if (Model.EstatusID != 3)
            {
                <div class="warn-note mb-3"><i class="fa-solid fa-triangle-exclamation me-1"></i>El escaneo de cajas está disponible únicamente mientras la corrida se encuentre en Producción.</div>
            }
            else
            {
                <div class="success-note mb-3"><i class="fa-solid fa-circle-check me-1"></i>Escanea la etiqueta física. Si OF, número de parte, cantidad y disponibilidad coinciden, la caja se formará y Calidad quedará notificada automáticamente.</div>
            }
            <div class="scanner-grid">
                <form method="post" action="@Url.Action("EscanearCaja", "Produccion")" id="formEscanearCaja" autocomplete="off">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="EjecucionProduccionID" value="@Model.EjecucionProduccionID" />
                    <label class="form-label" for="CodigoBarras">Etiqueta física</label>
                    <div class="scanner-input-wrap">
                        <input type="text" name="CodigoBarras" id="CodigoBarras" maxlength="500" class="form-control scanner-input" placeholder="Escanea aquí y el lector enviará ENTER..." autocomplete="off" autocapitalize="off" spellcheck="false" @(Model.PuedeFormarCaja ? "" : "disabled") autofocus />
                        <i class="fa-solid fa-barcode scanner-icon"></i>
                    </div>
                    <div class="scanner-help">No captures OF, parte ni cantidad manualmente. El sistema toma esos datos de la etiqueta y los compara con la corrida actual.</div>
                    <div class="form-message" id="mensajeEscaneoCaja"></div>
                </form>
                <div class="scanner-side">
                    <div class="k">Debe coincidir con esta corrida</div>
                    <strong>@OFTexto(Model)</strong>
                    <div class="sub">Parte: @ParteTexto(Model) · Siguiente caja esperada: @Numero(Model.CantidadSugeridaSiguienteCaja) pza(s)</div>
                    <div class="scan-stats">
                        <div class="scan-stat"><div class="k">Etiquetas escaneadas</div><div class="n">@Numero(cajasConEtiquetaFisica)</div></div>
                        <div class="scan-stat"><div class="k">Esperando recepción Calidad</div><div class="n text-warning">@Numero(cajasPendientesRecepcionCalidad)</div></div>
                        <div class="scan-stat"><div class="k">Recibidas por Calidad</div><div class="n text-success">@Numero(cajasRecibidasFisicamenteCalidad)</div></div>
                    </div>
                </div>
            </div>
        </div>
    </section>

    <div class="layout">

        <aside>
            <section class="panel @(Model.PuedeFormarCaja ? "" : "disabled-area")">
                <div class="panel-head">
                    <i class="fa-solid fa-screwdriver-wrench me-2"></i>
                    Excepciones de empaque
                </div>

                <div class="panel-body">
                    @if (Model.TieneParoAbierto)
                    {
                        <div class="danger-note mb-3">
                            <i class="fa-solid fa-circle-pause me-1"></i>
                            Hay un paro abierto. Cierra el paro antes de formar cajas.
                        </div>
                    }
                    else if (Model.EstatusID != 3)
                    {
                        <div class="warn-note mb-3">
                            <i class="fa-solid fa-triangle-exclamation me-1"></i>
                            Solo puedes formar cajas cuando la producción está en serie.
                        </div>
                    }
                    else
                    {
                        <div class="note mb-3">
                            <i class="fa-solid fa-circle-info me-1"></i>
                            El flujo normal ahora es por escáner. Usa este formulario solo para excepciones, material sospechoso, scrap, retención o producto incompleto.
                        </div>
                    }

                    <form method="post"
                          action="@Url.Action("FormarCaja", "Produccion")"
                          id="formFormarCaja">
                        @Html.AntiForgeryToken()

                        <input type="hidden"
                               name="ejecucionProduccionId"
                               value="@Model.EjecucionProduccionID" />

                        <div class="mb-3">
                            <label class="form-label">Tipo de caja</label>
                            <select name="tipoCaja" class="form-select" id="tipoCaja" required>
                                <option value="OK" data-disponible="@Model.CantidadOKDisponible">Producto conforme</option>
                                <option value="SOSPECHOSO" data-disponible="@Model.CantidadSospechosaDisponible">Sospechoso</option>
                                <option value="SCRAP" data-disponible="@Model.CantidadScrapDisponible">Scrap</option>
                                <option value="RETENCION" data-disponible="@Model.CantidadSospechosaDisponible">Retención</option>
                                <option value="INCOMPLETA" data-disponible="@Model.CantidadOKExcedentePendienteResguardo">Producto incompleto / etiqueta blanca</option>
                            </select>
                            <div class="sub mt-1">
                                OK disponible: @Numero(Model.CantidadOKDisponible) · Sospechoso: @Numero(Model.CantidadSospechosaDisponible) · Scrap: @Numero(Model.CantidadScrapDisponible) · Sobreproducción sin resguardar: @Numero(Model.CantidadOKExcedentePendienteResguardo)
                            </div>
                        </div>

                        <div class="availability-box mb-3">
                            Disponible para el tipo seleccionado:
                            <span class="availability-number" id="cantidadDisponible">@Numero(Model.CantidadOKDisponible)</span>
                            pieza(s)
                        </div>

                        <div class="success-note mb-3" id="sugerenciaCaja">
                            <div class="k">Siguiente caja sugerida</div>
                            <div style="font-size:1.45rem;font-weight:950"><span id="cantidadSugerida">@Numero(Model.CantidadSugeridaSiguienteCaja)</span> pieza(s)</div>
                            <div class="sub" id="textoSugerenciaCaja">Para producto OK se respeta la capacidad del embalaje. La última caja puede ser parcial.</div>
                        </div>

                        <div class="mb-3">
                            <label class="form-label">Cantidad de piezas</label>
                            <input type="number" name="cantidadPiezas" id="cantidadPiezas" min="1" step="1" inputmode="numeric" class="form-control" value="@(Model.CantidadSugeridaSiguienteCaja > 0 ? Model.CantidadSugeridaSiguienteCaja : null)" required />
                            <div class="sub mt-1" id="ayudaCantidad">Máximo por embalaje OK: @(Model.PiezasPorCajaSugeridas > 0 ? Numero(Model.PiezasPorCajaSugeridas) : "Sin configuración").</div>
                        </div>

                        <div class="note mb-3">
                            <i class="fa-solid fa-circle-info me-1"></i>
                            Para cajas OK normales usa el escáner superior. Este formulario manual se conserva únicamente como contingencia y para tipos especiales.
                        </div>

                        <div class="mb-3">
                            <label class="form-label">Observaciones</label>
                            <textarea name="observaciones"
                                      rows="3"
                                      maxlength="500"
                                      class="form-control"
                                      placeholder="Comentarios de empaque o condición de la caja..."></textarea>
                        </div>

                        <button type="submit" class="btn-main" id="btnFormarCaja">
                            <i class="fa-solid fa-box"></i>
                            Formar caja manual
                        </button>
                        <div class="form-message" id="mensajeFormarCaja"></div>
                    </form>
                </div>
            </section>

            <section class="panel">
                <div class="panel-head">
                    <i class="fa-solid fa-tag me-2"></i>
                    Producto incompleto asignado por Planeación
                </div>
                <div class="panel-body">
                    @if (!cajasAsignadas.Any())
                    {
                        <div class="empty">
                            <i class="fa-solid fa-tag fa-2x mb-3 d-block"></i>
                            Esta OF no tiene etiquetas blancas asignadas por Planeación. Producción no puede tomar producto incompleto libre.
                        </div>
                    }
                    else
                    {
                        <div class="note mb-3">
                            <i class="fa-solid fa-circle-info me-1"></i>
                            Estas etiquetas ya fueron elegidas en Planeación para esta OF. Las piezas que agregues salen de la producción OK de esta ejecución; el origen anterior se conserva en trazabilidad.
                        </div>
                        @foreach (var blanca in cajasAsignadas)
                        {
                            var maximoCompletar = Math.Min(blanca.CantidadPendienteCompletar, Model.CantidadOKDisponible);
                            var puedeCompletarBlanca = Model.PuedeFormarCaja && maximoCompletar > 0;
                            <div class="white-card">
                                <div class="d-flex justify-content-between align-items-start gap-2 flex-wrap">
                                    <div>
                                        <div class="k">Etiqueta blanca asignada</div>
                                        <div class="white-title">@TxtNullable(blanca.EtiquetaBlanca)</div>
                                        <div class="sub">Origen: @TxtNullable(blanca.FolioCaja) · Ejecución @blanca.EjecucionProduccionID</div>
                                    </div>
                                    <span class="badge-flow badge-neutral"><i class="fa-solid fa-lock"></i>@blanca.TextoEstado</span>
                                </div>
                                <div class="white-grid">
                                    <div class="white-data"><div class="k">Piezas existentes</div><div class="n">@Numero(blanca.CantidadPiezas)</div></div>
                                    <div class="white-data"><div class="k">Capacidad caja</div><div class="n">@Numero(blanca.CapacidadObjetivoCaja)</div></div>
                                    <div class="white-data"><div class="k">Faltan para completar</div><div class="n text-primary">@Numero(blanca.CantidadPendienteCompletar)</div></div>
                                </div>
                                <form method="post" action="@Url.Action("CompletarCajaIncompleta", "Produccion")" class="form-completar-blanca">
                                    @Html.AntiForgeryToken()
                                    <input type="hidden" name="EjecucionProduccionID" value="@Model.EjecucionProduccionID" />
                                    <input type="hidden" name="CajaProduccionID" value="@blanca.CajaProduccionID" />
                                    <div class="mb-3">
                                        <label class="form-label">Piezas nuevas a agregar</label>
                                        <input type="number" name="CantidadPiezas" min="1" max="@Math.Max(1, maximoCompletar)" step="1" inputmode="numeric" class="form-control cantidad-completar-blanca" data-pendiente="@blanca.CantidadPendienteCompletar" data-disponible="@Model.CantidadOKDisponible" value="@(maximoCompletar > 0 ? maximoCompletar : null)" disabled="@(!puedeCompletarBlanca ? "disabled" : null)" required />
                                        <div class="sub mt-1">OK disponible de esta OF: @Numero(Model.CantidadOKDisponible). Puedes completar en una sola captura o parcialmente.</div>
                                    </div>
                                    <div class="mb-3">
                                        <label class="form-label">Observaciones</label>
                                        <textarea name="Observaciones" rows="2" maxlength="500" class="form-control" placeholder="Opcional..."></textarea>
                                    </div>
                                    <button type="submit" class="btn-main" disabled="@(!puedeCompletarBlanca ? "disabled" : null)">
                                        <i class="fa-solid fa-box-open"></i>
                                        @(!Model.PuedeFormarCaja ? "Disponible al estar en producción" : maximoCompletar <= 0 ? "Sin piezas OK disponibles" : "Agregar piezas a etiqueta blanca")
                                    </button>
                                    <div class="form-message"></div>
                                </form>
                            </div>
                        }
                    }
                </div>
            </section>
        </aside>

        <main>
            <section class="panel">
                <div class="panel-head">
                    <i class="fa-solid fa-list-check me-2"></i>
                    Cajas registradas
                </div>

                <div class="panel-body">
                    @if (!cajas.Any())
                    {
                        <div class="empty">
                            <i class="fa-solid fa-box-open fa-2x mb-3 d-block"></i>
                            Todavía no hay cajas formadas para esta ejecución.
                        </div>
                    }
                    else
                    {
                        <div class="table-wrap">
                            <table class="table">
                                <thead>
                                    <tr>
                                        <th>Caja</th>
                                        <th>Folio ERP</th>
                                        <th>Tipo</th>
                                        <th>Cantidad</th>
                                        <th>Estado</th>
                                        <th>Etiqueta física</th>
                                        <th>Recepción Calidad</th>
                                        <th>Etiqueta verde</th>
                                        <th>Formación</th>
                                        <th>Calidad</th>
                                        <th>Zona verde</th>
                                        <th>Salida producción</th>
                                        <th>Almacén</th>
                                        <th>Acciones</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var caja in cajas)
                                    {
                                        <tr>
                                            <td>
                                                <strong>@caja.NumeroCaja.ToString("000")</strong>
                                            </td>

                                            <td>
                                                <div class="fw-bold">@TxtNullable(caja.FolioCaja)</div>
                                                <div class="sub">Folio interno ERP</div>
                                            </td>

                                            <td>
                                                <span class="type-pill @TipoClase(caja.TipoCaja)">
                                                    @caja.TipoCaja
                                                </span>
                                            </td>

                                            <td>
                                                <strong>@Numero(caja.CantidadPiezas)</strong>
                                            </td>

                                            <td>
                                                <span class="badge-flow @EstadoClaseCaja(caja)">
                                                    @if (caja.EstadoCajaID == 1)
                                                    {
                                                        <i class="fa-solid fa-box"></i>
                                                    }
                                                    else if (caja.EstadoCajaID == 2)
                                                    {
                                                        <i class="fa-solid fa-hourglass-half"></i>
                                                    }
                                                    else if (caja.EstadoCajaID == 3)
                                                    {
                                                        <i class="fa-solid fa-circle-check"></i>
                                                    }
                                                    else if (caja.EstadoCajaID == 4)
                                                    {
                                                        <i class="fa-solid fa-triangle-exclamation"></i>
                                                    }
                                                    else if (caja.EstadoCajaID == 5)
                                                    {
                                                        <i class="fa-solid fa-location-dot"></i>
                                                    }
                                                    else if (caja.EstadoCajaID == 6)
                                                    {
                                                        <i class="fa-solid fa-barcode"></i>
                                                    }
                                                    else if (caja.EstadoCajaID == 7)
                                                    {
                                                        <i class="fa-solid fa-warehouse"></i>
                                                    }

                                                    @caja.EstadoCajaNombre
                                                </span>

                                                @if (!string.IsNullOrWhiteSpace(caja.MotivoCalidad))
                                                {
                                                    <div class="sub text-danger mt-1">
                                                        @caja.MotivoCalidad
                                                    </div>
                                                }
                                            </td>

                                            <td>
                                                @if (caja.TieneEtiquetaFisica)
                                                {
                                                    <span class="physical-chip physical-ok"><i class="fa-solid fa-barcode"></i>Escaneada</span>
                                                    <div class="code-text mt-1" title="@caja.CodigoBarrasOrigen">@TxtNullable(caja.CodigoBarrasOrigen)</div>
                                                    <div class="sub">@TxtNullable(caja.NumeroOFEtiqueta) · @TxtNullable(caja.NumeroParteEtiqueta) · @Numero(caja.CantidadEtiqueta ?? caja.CantidadPiezas) pza(s)</div>
                                                }
                                                else
                                                {
                                                    <span class="physical-chip physical-none"><i class="fa-solid fa-keyboard"></i>Registro manual</span>
                                                }
                                            </td>

                                            <td>
                                                @if (caja.RecibidaFisicamenteCalidad)
                                                {
                                                    <span class="physical-chip physical-ok"><i class="fa-solid fa-circle-check"></i>Recibida</span>
                                                    <div class="sub mt-1">@FechaTxt(caja.FechaEscaneoCalidad)</div>
                                                }
                                                else if (caja.PendienteRecepcionFisicaCalidad)
                                                {
                                                    <span class="physical-chip physical-pending"><i class="fa-solid fa-hourglass-half"></i>Esperando escaneo</span>
                                                    <div class="sub mt-1">Calidad ya sabe que viene</div>
                                                }
                                                else
                                                {
                                                    <span class="physical-chip physical-none">No aplica</span>
                                                }
                                            </td>

                                            <td>
                                                @if (caja.EtiquetaVerde)
                                                {
                                                    <span class="badge-flow badge-success">
                                                        <i class="fa-solid fa-tag"></i>
                                                        Sí
                                                    </span>
                                                }
                                                else
                                                {
                                                    <span class="badge-flow badge-neutral">
                                                        No
                                                    </span>
                                                }
                                            </td>

                                            <td>
                                                @FechaTxtNoNullable(caja.FechaFormacion)
                                            </td>

                                            <td>
                                                @FechaTxt(caja.FechaLiberacionCalidad)
                                                @if (!string.IsNullOrWhiteSpace(caja.ResultadoCalidad))
                                                {
                                                    <div class="sub">@caja.ResultadoCalidad</div>
                                                }
                                            </td>

                                            <td>
                                                @FechaTxt(caja.FechaZonaVerde)
                                            </td>

                                            <td>
                                                @FechaTxt(caja.FechaSalidaProduccion)
                                            </td>

                                            <td>
                                                @FechaTxt(caja.FechaRecepcionAlmacen)
                                            </td>

                                            <td>
                                                <div class="actions-grid">

                                                    @if (caja.PuedeSolicitarCalidad)
                                                    {
                                                        <form method="post"
                                                              action="@Url.Action("SolicitarLiberacionCaja", "Produccion")"
                                                              class="small-form accion-form"
                                                              data-confirm="¿Enviar esta caja a Calidad para su liberación?">
                                                            @Html.AntiForgeryToken()

                                                            <input type="hidden"
                                                                   name="cajaProduccionId"
                                                                   value="@caja.CajaProduccionID" />

                                                            <button type="submit" class="btn-warningx">
                                                                <i class="fa-solid fa-microscope"></i>
                                                                Enviar a Calidad
                                                            </button>
                                                        </form>
                                                    }
                                                    else
                                                    {
                                                        <button type="button" class="btn-mutedx" disabled>
                                                            <i class="fa-solid fa-microscope"></i>
                                                            Calidad
                                                        </button>
                                                    }

                                                    @if (caja.PuedeMoverZonaVerde)
                                                    {
                                                        <form method="post"
                                                              action="@Url.Action("MoverCajaZonaVerde", "Produccion")"
                                                              class="small-form accion-form"
                                                              data-confirm="¿Confirmar el movimiento de esta caja a zona verde?">
                                                            @Html.AntiForgeryToken()

                                                            <input type="hidden"
                                                                   name="cajaProduccionId"
                                                                   value="@caja.CajaProduccionID" />

                                                            <button type="submit" class="btn-green">
                                                                <i class="fa-solid fa-location-dot"></i>
                                                                Zona verde
                                                            </button>
                                                        </form>
                                                    }
                                                    else
                                                    {
                                                        <button type="button" class="btn-mutedx" disabled>
                                                            <i class="fa-solid fa-lock"></i>
                                                            Zona verde
                                                        </button>
                                                    }

                                                    @if (caja.PuedeEscanearSalidaProduccion)
                                                    {
                                                        <form method="post"
                                                              action="@Url.Action("EscanearSalidaCaja", "Produccion")"
                                                              class="small-form accion-form"
                                                              data-confirm="¿Registrar la salida de Producción para esta caja?">
                                                            @Html.AntiForgeryToken()

                                                            <input type="hidden"
                                                                   name="cajaProduccionId"
                                                                   value="@caja.CajaProduccionID" />

                                                            <div class="scan-row">
                                                                <input type="text"
                                                                       name="etiquetaEscaneada"
                                                                       maxlength="100"
                                                                       class="form-control"
                                                                       placeholder="Escanear etiqueta" />

                                                                <button type="submit" class="btn-blue">
                                                                    <i class="fa-solid fa-barcode"></i>
                                                                    Salida
                                                                </button>
                                                            </div>
                                                        </form>
                                                    }
                                                    else
                                                    {
                                                        <button type="button" class="btn-mutedx" disabled>
                                                            <i class="fa-solid fa-lock"></i>
                                                            Salida
                                                        </button>
                                                    }

                                                </div>
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    }
                </div>
            </section>
        </main>
    </div>
</div>

<div class="confirm-backdrop" id="confirmBackdrop" aria-hidden="true">
    <div class="confirm-box" role="dialog" aria-modal="true" aria-labelledby="confirmTitle">
        <div class="confirm-head" id="confirmTitle"><i class="fa-solid fa-circle-question me-2"></i>Confirmar operación</div>
        <div class="confirm-body" id="confirmText">¿Deseas continuar?</div>
        <div class="confirm-actions">
            <button type="button" class="btn-mutedx" id="confirmCancelar">Cancelar</button>
            <button type="button" class="btn-main" id="confirmAceptar">Confirmar</button>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        (() => {
            const formEscanearCaja=document.getElementById('formEscanearCaja');
            const codigoBarras=document.getElementById('CodigoBarras');
            const mensajeEscaneoCaja=document.getElementById('mensajeEscaneoCaja');
            let enviandoEscaneo=false;
            function enviarEscaneo(){
                if(!formEscanearCaja||!codigoBarras||codigoBarras.disabled||enviandoEscaneo)return;
                const codigo=codigoBarras.value.trim();
                if(!codigo){mostrarError(mensajeEscaneoCaja,'Escanea una etiqueta física.');codigoBarras.focus();return;}
                enviandoEscaneo=true;
                limpiarError(mensajeEscaneoCaja);
                codigoBarras.readOnly=true;
                formEscanearCaja.requestSubmit();
            }
            codigoBarras?.addEventListener('keydown',e=>{if(e.key==='Enter'){e.preventDefault();enviarEscaneo();}});
            window.addEventListener('load',()=>{if(codigoBarras&&!codigoBarras.disabled){codigoBarras.value='';codigoBarras.focus();}});
            document.addEventListener('click',e=>{if(codigoBarras&&!codigoBarras.disabled&&!e.target.closest('input,textarea,select,button,a,summary'))codigoBarras.focus();});
            const formFormarCaja=document.getElementById('formFormarCaja');
            const tipoCaja=document.getElementById('tipoCaja');
            const cantidadPiezas=document.getElementById('cantidadPiezas');
            const cantidadDisponible=document.getElementById('cantidadDisponible');
            const cantidadSugerida=document.getElementById('cantidadSugerida');
            const sugerenciaCaja=document.getElementById('sugerenciaCaja');
            const textoSugerenciaCaja=document.getElementById('textoSugerenciaCaja');
            const ayudaCantidad=document.getElementById('ayudaCantidad');
            const btnFormarCaja=document.getElementById('btnFormarCaja');
            const mensajeFormarCaja=document.getElementById('mensajeFormarCaja');
            const disponibles={OK:@Model.CantidadOKDisponible,SOSPECHOSO:@Model.CantidadSospechosaDisponible,SCRAP:@Model.CantidadScrapDisponible,RETENCION:@Model.CantidadSospechosaDisponible,INCOMPLETA:@Model.CantidadOKExcedentePendienteResguardo};
            const piezasPorEmbalaje=@Model.PiezasPorCajaSugeridas;
            const sugeridaOk=@Model.CantidadSugeridaSiguienteCaja;
            function mostrarError(elemento,mensaje){if(!elemento)return;elemento.textContent=mensaje;elemento.className='form-message error';}
            function limpiarError(elemento){if(!elemento)return;elemento.textContent='';elemento.className='form-message';}
            function datos(){const tipo=tipoCaja?.value||'OK';const disponible=Number(disponibles[tipo]||0);let maximo=disponible;let sugerida=disponible;if((tipo==='OK'||tipo==='INCOMPLETA')&&piezasPorEmbalaje>0){maximo=Math.min(disponible,tipo==='INCOMPLETA'?Math.max(0,piezasPorEmbalaje-1):piezasPorEmbalaje);sugerida=tipo==='OK'?Math.min(sugeridaOk>0?sugeridaOk:disponible,maximo):maximo;}return{tipo,disponible,maximo,sugerida};}
            function actualizar(){if(!tipoCaja||!cantidadPiezas||!cantidadDisponible||!btnFormarCaja)return;limpiarError(mensajeFormarCaja);const d=datos();cantidadDisponible.textContent=d.disponible.toLocaleString('es-MX');cantidadPiezas.max=String(Math.max(0,d.maximo));if(cantidadSugerida)cantidadSugerida.textContent=d.sugerida.toLocaleString('es-MX');if(sugerenciaCaja){sugerenciaCaja.style.display=(d.tipo==='OK'||d.tipo==='INCOMPLETA')?'':'none';if(textoSugerenciaCaja)textoSugerenciaCaja.textContent=d.tipo==='INCOMPLETA'?'La etiqueta blanca solo puede formarse con sobreproducción OK y siempre debe quedar por debajo de la capacidad completa del embalaje.':'Para producto OK se respeta la capacidad del embalaje. La última caja puede ser parcial.';}if(ayudaCantidad){if(d.tipo==='OK'&&piezasPorEmbalaje>0)ayudaCantidad.textContent='Máximo por embalaje OK: '+piezasPorEmbalaje.toLocaleString('es-MX')+' pieza(s).';else if(d.tipo==='INCOMPLETA'&&piezasPorEmbalaje>0)ayudaCantidad.textContent='Producto incompleto: máximo '+Math.max(0,piezasPorEmbalaje-1).toLocaleString('es-MX')+' pieza(s); solo sobreproducción OK.';else ayudaCantidad.textContent='Máximo disponible para '+d.tipo+': '+d.disponible.toLocaleString('es-MX')+' pieza(s).';}if(d.disponible<=0||d.maximo<=0){cantidadPiezas.value='';cantidadPiezas.disabled=true;btnFormarCaja.disabled=true;return;}cantidadPiezas.disabled=false;btnFormarCaja.disabled=false;const actual=Number(cantidadPiezas.value||0);if(actual<=0||actual>d.maximo)cantidadPiezas.value=d.sugerida>0?String(d.sugerida):String(d.maximo);}
            tipoCaja?.addEventListener('change',actualizar);actualizar();
            formFormarCaja?.addEventListener('submit',e=>{limpiarError(mensajeFormarCaja);const d=datos();const cantidad=Number(cantidadPiezas?.value||0);let mensaje='';if(cantidad<=0)mensaje='La cantidad de piezas debe ser mayor a cero.';else if(cantidad>d.disponible)mensaje='La cantidad excede lo disponible para '+d.tipo+'. Disponible: '+d.disponible.toLocaleString('es-MX')+'.';else if(d.tipo==='OK'&&piezasPorEmbalaje>0&&cantidad>piezasPorEmbalaje)mensaje='La caja excede la capacidad del embalaje. Máximo: '+piezasPorEmbalaje.toLocaleString('es-MX')+' pieza(s).';else if(d.tipo==='INCOMPLETA'&&piezasPorEmbalaje>0&&cantidad>=piezasPorEmbalaje)mensaje='Una etiqueta blanca debe quedar incompleta. Captura menos de '+piezasPorEmbalaje.toLocaleString('es-MX')+' pieza(s).';if(mensaje){e.preventDefault();mostrarError(mensajeFormarCaja,mensaje);return;}btnFormarCaja.disabled=true;btnFormarCaja.innerHTML='<i class="fa-solid fa-spinner fa-spin"></i> Formando caja...';});
            document.querySelectorAll('.form-completar-blanca').forEach(form=>{form.addEventListener('submit',e=>{const input=form.querySelector('.cantidad-completar-blanca');const mensaje=form.querySelector('.form-message');const btn=form.querySelector('button[type="submit"]');limpiarError(mensaje);const cantidad=Number(input?.value||0);const pendiente=Number(input?.dataset.pendiente||0);const disponible=Number(input?.dataset.disponible||0);if(cantidad<=0){e.preventDefault();mostrarError(mensaje,'Captura una cantidad mayor a cero.');return;}if(cantidad>pendiente){e.preventDefault();mostrarError(mensaje,'La cantidad supera las piezas pendientes para completar esta etiqueta blanca.');return;}if(cantidad>disponible){e.preventDefault();mostrarError(mensaje,'La cantidad supera las piezas OK disponibles de esta OF.');return;}if(btn){btn.disabled=true;btn.innerHTML='<i class="fa-solid fa-spinner fa-spin"></i> Aplicando piezas...';}});});
            const backdrop=document.getElementById('confirmBackdrop');const confirmText=document.getElementById('confirmText');const btnAceptar=document.getElementById('confirmAceptar');const btnCancelar=document.getElementById('confirmCancelar');let formPendiente=null;
            function cerrarConfirmacion(){backdrop?.classList.remove('show');backdrop?.setAttribute('aria-hidden','true');formPendiente=null;}
            document.querySelectorAll('.accion-form').forEach(form=>{form.addEventListener('submit',e=>{if(form.dataset.confirmado==='1'){form.dataset.confirmado='';const btn=form.querySelector('button[type="submit"]');if(btn){btn.disabled=true;btn.innerHTML='<i class="fa-solid fa-spinner fa-spin"></i> Procesando...';}return;}const mensaje=form.dataset.confirm;if(!mensaje)return;e.preventDefault();formPendiente=form;if(confirmText)confirmText.textContent=mensaje;backdrop?.classList.add('show');backdrop?.setAttribute('aria-hidden','false');});});
            btnCancelar?.addEventListener('click',cerrarConfirmacion);backdrop?.addEventListener('click',e=>{if(e.target===backdrop)cerrarConfirmacion();});
            btnAceptar?.addEventListener('click',()=>{if(!formPendiente){cerrarConfirmacion();return;}const form=formPendiente;form.dataset.confirmado='1';backdrop?.classList.remove('show');backdrop?.setAttribute('aria-hidden','true');form.requestSubmit();});
            document.addEventListener('keydown',e=>{if(e.key==='Escape'&&backdrop?.classList.contains('show'))cerrarConfirmacion();});
        })();
    </script>
}
