                                <div class="info-line">
                                    <div class="info-k">Máquina</div>
                                    <div class="info-v" id="modalMaquinaTexto">-</div>
                                </div>

                                <div class="info-line">
                                    <div class="info-k">Molde</div>
                                    <div class="info-v" id="modalMoldeTexto">-</div>
                                </div>

                                <div class="info-line">
                                    <div class="info-k">Cantidad</div>
                                    <div class="info-v" id="modalCantidadTexto">-</div>
                                </div>
                            </div>

                            <div class="col-md-6">
                                <div class="info-line">
                                    <div class="info-k">Parte</div>
                                    <div class="info-v" id="modalParteTexto">-</div>
                                </div>

                                <div class="info-line">
                                    <div class="info-k">Descripción</div>
                                    <div class="info-v" id="modalDescripcionTexto">-</div>
