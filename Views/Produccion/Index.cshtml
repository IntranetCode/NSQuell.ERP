            background: #fff9e8 !important;
        }

        .production-row.row-produccion > td {
            background: #eef7ff !important;
        }

        .production-row.row-pausado > td {
            background: #fff0f2 !important;
        }

        .production-row.row-terminado > td {
            background: #eefbf3 !important;
        }

        .production-row.row-preparacion > td:first-child {
            box-shadow: inset 4px 0 0 #e6b422;
        }

        .production-row.row-produccion > td:first-child {
            box-shadow: inset 4px 0 0 #4b8fd8;
        }

        .production-row.row-pausado > td:first-child {
            box-shadow: inset 4px 0 0 #d46a78;
        }

        .production-row.row-terminado > td:first-child {
            box-shadow: inset 4px 0 0 #4f9f72;
