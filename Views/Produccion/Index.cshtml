            background: #f8fafc;
            box-shadow: 0 4px 14px rgba(16,42,78,.035);
        }

        .production-nav-btn {
            min-height: 47px;
            border-radius: 9px;
            font-size: .82rem;
            font-weight: 800;
            box-shadow: none;
        }

            .production-nav-btn:hover {
                transform: none;
                box-shadow: 0 2px 7px rgba(16,42,78,.06);
            }

            .production-nav-btn[data-production-panel="proximos"] {
                background: #fffdfa;
            }

                .production-nav-btn[data-production-panel="proximos"].is-active {
                    background: #fff5de;
                    box-shadow: inset 0 -2px 0 #e6a72e;
                }

            .production-nav-btn[data-production-panel="ejecuciones"] {
