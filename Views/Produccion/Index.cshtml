            font-size: .82rem;
            font-weight: 800;
        }

            #formFiltrosProduccion .btn-primary:hover {
                background: linear-gradient(180deg, #1f7ed5 0%, #0e68bb 100%);
                box-shadow: 0 6px 14px rgba(20,114,201,.20);
