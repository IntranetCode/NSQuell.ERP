                                    <div class="info-k">Fin prog.</div>
                                    <div class="info-v" id="modalFinTexto">-</div>
                                </div>
                            </div>
                        </div>

                        <div class="operator-box" id="boxOperadorSugerido">
                            <div class="operator-title" id="tituloOperadorSugerido">
                                Operador sugerido desde RRHH
                            </div>
                            <div class="small text-muted mt-1" id="detalleOperadorSugerido">
                                -
                            </div>
                        </div>

                        <div class="row g-3">
                            <div class="col-md-7">
                                <label class="form-label">Operador real al iniciar</label>
                                <select name="operadorId" id="modalOperadorId" class="form-select">
                                    @foreach (var op in operadoresProduccion)
                                    {
                                        <option value="@op.Value">
                                            @op.Text
                                        </option>
                                    }
                                </select>

                                <div class="small text-muted mt-1">
                                    Puede quedar sin operador o cambiarse a la mera hora.
                                </div>
                            </div>

                            <div class="col-md-5">
                                <label class="form-label">Nombre manual</label>
                                <input type="text"
                                       id="modalOperadorManual"
                                       class="form-control"
                                       maxlength="200"
                                       placeholder="Solo si no aparece en la lista" />

                                <div class="small text-muted mt-1">
                                    Este nombre se guardará si no seleccionas operador del catálogo.
                                </div>
                            </div>

                            <div class="col-12">
                                <label class="form-label">Observaciones</label>
                                <textarea name="observaciones"
                                          id="modalObservaciones"
                                          class="form-control"
                                          rows="3"
                                          maxlength="500"
                                          placeholder="Observaciones de preparación, cambio de operador, indicaciones especiales..."></textarea>
                            </div>
