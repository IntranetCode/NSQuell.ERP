            margin: 20px auto;
        }

        #modalIniciarPreparacion .modal-content {
            max-height: calc(100vh - 40px);
            display: flex;
            flex-direction: column;
            overflow: hidden;
        }

            #modalIniciarPreparacion .modal-content > form {
