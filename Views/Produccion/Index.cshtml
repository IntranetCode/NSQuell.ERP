                left: 0;
                top: 13px;
                bottom: 13px;
                width: 3px;
                border-radius: 0 4px 4px 0;
                background: #2f6fbd;
            }

        .production-filters .section-title {
            color: #163b68;
            font-size: .98rem;
            font-weight: 800;
        }

            .production-filters .section-title i {
                width: 25px;
                height: 25px;
                display: inline-grid;
                place-items: center;
                margin-right: 6px !important;
                border: 1px solid #d5e2f1;
                border-radius: 8px;
                background: #f1f6fc;
                color: #2f6fbd;
                font-size: .76rem;
            }

        .production-filters .section-sub {
            margin-left: 34px;
