        /* ==========================================================
                                                           TEMA OSCURO INTERACTIVO - PRODUCCION
                                                           Se activa con html[data-nsq-theme="dark"].
                                                           El script al final sincroniza esta vista con el switch
                                                           Claro/Oscuro existente en _Layout.
                                                           ========================================================== */
        html[data-nsq-theme="dark"] {
            color-scheme: dark;
            --azul: #7db7ff;
            --azul2: #4f9cff;
            --borde: #304159;
            --bg: #0b1220;
            --txt: #e7eef9;
            --muted: #9aa9bd;
            --success: #4ade80;
            --warning: #fbbf24;
            --danger: #fb7185;
            --purple: #b7a3ff;
        }

        body,
        .section,
        .section-head,
        .production-nav,
        .production-nav-btn,
        .production-content-shell,
        .form-control,
        .form-select,
        .modal-content,
        .operator-box,
        .program-alert,
        .panel-loading,
        .panel-error {
            transition: background-color .22s ease, border-color .22s ease, color .22s ease, box-shadow .22s ease;
        }

        html[data-nsq-theme="dark"] body {
            color: #e7eef9;
        }

