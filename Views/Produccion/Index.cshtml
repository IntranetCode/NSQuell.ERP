            min-height: 260px;
        }

        .panel-loading,
        .panel-error {
            border: 1px solid var(--borde);
            border-radius: 18px;
            background: #fff;
            padding: 52px 20px;
            text-align: center;
            color: var(--muted);
            font-weight: 750;
        }

            .panel-loading .spinner-border {
                width: 2rem;
                height: 2rem;
                margin-bottom: 10px;
                color: var(--azul);
            }

            .panel-error i {
                display: block;
                margin-bottom: 8px;
                color: var(--danger);
                font-size: 2rem;
            }

        @@media (max-width: 700px) {
            .production-nav

        {
            flex-wrap: nowrap;
