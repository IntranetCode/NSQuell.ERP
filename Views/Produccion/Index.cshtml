        /* ==========================================================
                   PRODUCTO INCOMPLETO / ETIQUETAS BLANCAS AL INICIAR
                   ========================================================== */
        .pi-start-box {
            border: 1px solid #d7e2f1;
            border-radius: 16px;
            background: #fbfdff;
            overflow: hidden;
        }

        .pi-start-head {
            display: flex;
            align-items: flex-start;
            justify-content: space-between;
            gap: 12px;
            padding: 14px 16px;
            border-bottom: 1px solid #e5edf6;
            background: linear-gradient(180deg, #f8fbff 0%, #f3f7fc 100%);
        }

        .pi-start-title {
            color: #163b68;
            font-weight: 900;
        }

        .pi-start-sub {
            margin-top: 3px;
            color: #667085;
            font-size: .78rem;
            font-weight: 650;
        }

        .pi-start-summary {
            display: grid;
            grid-template-columns: repeat(3, minmax(0, 1fr));
            gap: 9px;
            padding: 12px 14px;
            border-bottom: 1px solid #edf2f7;
            background: #fff;
        }

        .pi-start-summary-item {
            min-width: 0;
            padding: 10px 12px;
            border: 1px solid #e0e7ef;
            border-radius: 12px;
            background: #f9fbfd;
        }

            .pi-start-summary-item.is-selected {
                border-color: #b8ccef;
                background: #f4f8ff;
            }

            .pi-start-summary-item.is-net {
                border-color: #abefc6;
                background: #f0fdf4;
            }

        .pi-start-summary-label {
            color: #667085;
            font-size: .68rem;
            font-weight: 850;
            text-transform: uppercase;
            letter-spacing: .035em;
        }

        .pi-start-summary-value {
            margin-top: 2px;
            color: #182437;
            font-size: 1.18rem;
            font-weight: 950;
        }

        .pi-start-alert {
            margin: 12px 14px 0;
            padding: 10px 12px;
            border: 1px solid #fecdca;
            border-radius: 11px;
            background: #fef3f2;
            color: #b42318;
            font-size: .78rem;
            font-weight: 750;
        }

        .pi-start-list {
            display: grid;
            gap: 8px;
            max-height: 285px;
            overflow-y: auto;
            padding: 12px 14px;
            scrollbar-gutter: stable;
        }

        .pi-start-loading,
        .pi-start-empty {
            padding: 18px 12px;
            text-align: center;
            color: #667085;
            font-size: .82rem;
            font-weight: 700;
        }

        .pi-start-item {
            display: grid;
            grid-template-columns: auto minmax(0, 1fr) auto;
            gap: 11px;
            align-items: start;
            padding: 11px 12px;
            border: 1px solid #dfe6ef;
            border-radius: 12px;
            background: #fff;
            cursor: pointer;
            transition: border-color .15s ease, background-color .15s ease, box-shadow .15s ease;
        }

            .pi-start-item:hover {
                border-color: #a9c2df;
                box-shadow: 0 4px 12px rgba(16,42,78,.06);
            }

            .pi-start-item.is-selected {
                border-color: #6eb995;
                background: #f2fbf6;
                box-shadow: 0 0 0 2px rgba(16,124,65,.06);
            }

        .pi-start-check {
            width: 18px;
            height: 18px;
            margin-top: 2px;
            cursor: pointer;
        }

        .pi-start-name {
            color: #182437;
            font-weight: 900;
        }

        .pi-start-meta {
            display: flex;
            flex-wrap: wrap;
            gap: 5px 12px;
            margin-top: 4px;
            color: #667085;
            font-size: .72rem;
            font-weight: 650;
        }

        .pi-start-qty {
            min-width: 88px;
            padding: 7px 9px;
            border-radius: 10px;
            background: #eef4ff;
            color: #194185;
            text-align: right;
            font-size: .73rem;
            font-weight: 800;
        }

            .pi-start-qty strong {
                display: block;
                font-size: 1rem;
                line-height: 1.1;
            }

        .pi-start-rule {
            display: flex;
            align-items: flex-start;
            gap: 8px;
            padding: 10px 14px 13px;
            color: #667085;
            font-size: .74rem;
            font-weight: 650;
        }

        html[data-nsq-theme="dark"] .pi-start-box {
            background: #111b2d;
            border-color: #31455f;
        }

        html[data-nsq-theme="dark"] .pi-start-head {
            background: #16243a;
            border-bottom-color: #31455f;
        }

        html[data-nsq-theme="dark"] .pi-start-title,
        html[data-nsq-theme="dark"] .pi-start-name,
        html[data-nsq-theme="dark"] .pi-start-summary-value {
            color: #edf4fd;
        }

        html[data-nsq-theme="dark"] .pi-start-sub,
        html[data-nsq-theme="dark"] .pi-start-meta,
        html[data-nsq-theme="dark"] .pi-start-rule,
        html[data-nsq-theme="dark"] .pi-start-loading,
        html[data-nsq-theme="dark"] .pi-start-empty,
        html[data-nsq-theme="dark"] .pi-start-summary-label {
            color: #9eacc0;
        }

        html[data-nsq-theme="dark"] .pi-start-summary {
            background: #111b2d;
            border-bottom-color: #2d3d54;
        }

        html[data-nsq-theme="dark"] .pi-start-summary-item {
            background: #162133;
            border-color: #33465e;
        }

            html[data-nsq-theme="dark"] .pi-start-summary-item.is-selected {
                background: #152a43;
                border-color: #39699b;
            }

            html[data-nsq-theme="dark"] .pi-start-summary-item.is-net {
                background: #102a20;
                border-color: #286446;
            }

        html[data-nsq-theme="dark"] .pi-start-item {
            background: #162133;
            border-color: #33465e;
        }

            html[data-nsq-theme="dark"] .pi-start-item:hover {
                background: #1a2940;
                border-color: #506b8c;
            }

            html[data-nsq-theme="dark"] .pi-start-item.is-selected {
                background: #122a21;
                border-color: #347a58;
            }

        html[data-nsq-theme="dark"] .pi-start-qty {
            background: #102b4c;
            color: #a9d2ff;
        }

        html[data-nsq-theme="dark"] .pi-start-alert {
            background: #351719;
            border-color: #7f2b32;
            color: #fecdd3;
        }

        @@media (max-width: 700px) {
            .pi-start-summary {
                grid-template-columns: 1fr;
            }

            .pi-start-item {
                grid-template-columns: auto minmax(0, 1fr);
            }

            .pi-start-qty {
                grid-column: 2;
                width: fit-content;
                text-align: left;
            }
        }

    </style>

}

<div class="page">

    <nav class="production-page-nav" aria-label="Navegación de Producción">
        <a class="production-back-btn"
           asp-controller="Menu"
           asp-action="Grupo"
           asp-route-id="2"
           title="Regresar al menú de Producción"
           aria-label="Regresar al menú de Producción">
            <i class="bi bi-arrow-left"></i>
            Regresar
        </a>
    </nav>

    <header class="topbar">
        <div class="d-flex justify-content-between align-items-center gap-3 flex-wrap">
            <div>
                <h1 class="topbar-title">
                    <i class="bi bi-gear-wide-connected me-2"></i>
                    Producción
                </h1>
                <div class="topbar-sub">
                    Centro operativo de Producción: ejecución, próximos inicios y cola programada.
                </div>
            </div>

            <div class="d-flex align-items-center gap-2 flex-wrap">
               
                @* NSQ_PRODUCCION_CALENDARIO_MENU_V1 *@
                <a class="production-nav-btn"
                   href="@Url.RouteUrl("ProduccionCalendario")">
                    <i class="bi bi-calendar3-week"></i>
                    Calendario de Producci&oacute;n
                </a>

                <a class="production-nav-btn"
                   asp-controller="Produccion"
                   asp-action="ProductoIncompleto">
                    <i class="bi bi-box-seam"></i>
                    Producto incompleto
                </a>

                <a class="production-nav-btn"
                   asp-controller="Produccion"
                   asp-action="Historial">
                    <i class="bi bi-clock-history"></i>
                    Historial
                </a>

                <div class="text-end ms-2">
                    <div class="small opacity-75">Fecha</div>
                    <div class="fw-bold">@DateTime.Now.ToString("dd/MM/yyyy HH:mm")</div>
                </div>
            </div>
        </div>
    </header>

    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show" role="alert">
            <i class="bi bi-check-circle me-1"></i>
            @TempData["Success"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show" role="alert">
            <i class="bi bi-exclamation-triangle me-1"></i>
            @TempData["Error"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    @if (TempData["Info"] != null)
    {
        <div class="alert alert-info alert-dismissible fade show" role="alert">
            <i class="bi bi-info-circle me-1"></i>
            @TempData["Info"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    <section class="section production-filters">
        <div class="section-head">
            <div>
                <h2 class="section-title">
                    <i class="bi bi-funnel"></i>
                    Filtros
                </h2>
                <div class="section-sub">
                    Busca por máquina, parte, molde, operador, programa u OF.
                </div>
            </div>
        </div>

        <div class="filters">
            <form method="get" action="@Url.Action("Index", "Produccion")" id="formFiltrosProduccion" class="row g-3 align-items-end">
                <div class="col-12 col-xl-3">
                    <label class="form-label">Buscar</label>
                    <input type="text"
                           name="busqueda"
                           value="@Model.Busqueda"
                           class="form-control"
                           placeholder="Máquina, parte, molde, operador..." />
                </div>

                <div class="col-12 col-md-6 col-xl-2">
                    <label class="form-label">Máquina</label>
                    <select name="maquinaId" class="form-select">
                        @foreach (var item in Model.Maquinas)
                        {
                            <option value="@item.Value" selected="@(item.Value == Model.MaquinaID?.ToString())">
                                @item.Text
                            </option>
                        }
                    </select>
                </div>

                <div class="col-12 col-md-6 col-xl-2">
                    <label class="form-label">Estatus (ejecuciones)</label>
                    <select name="estatusId" class="form-select">
                        @foreach (var item in Model.Estatus)
                        {
                            <option value="@item.Value" selected="@(item.Value == Model.EstatusID?.ToString())">
                                @item.Text
                            </option>
                        }
                    </select>
                </div>

                <div class="col-6 col-xl-2">
                    <label class="form-label">Desde</label>
                    <input type="date"
                           name="fechaDesde"
                           value="@(Model.FechaDesde?.ToString("yyyy-MM-dd"))"
                           class="form-control" />
                </div>

                <div class="col-6 col-xl-2">
                    <label class="form-label">Hasta</label>
                    <input type="date"
                           name="fechaHasta"
                           value="@(Model.FechaHasta?.ToString("yyyy-MM-dd"))"
                           class="form-control" />
                </div>

                <div class="col-12 col-xl-1 d-grid">
                    <button type="submit" class="btn btn-primary btn-action">
                        <i class="bi bi-search me-1"></i>
                        Buscar
                    </button>
                </div>
            </form>
        </div>
    </section>

    @{
        var totalActivas =
        Model.Pendientes +
        Model.EnPreparacion +
        Model.EnProduccion +
        Model.Pausados;
    }

    <nav class="production-nav" aria-label="Navegación operativa de Producción">
        <button type="button"
                class="production-nav-btn is-active"
                data-production-panel="proximos"
                data-url="@Url.Action("PanelProximos", "Produccion")">
            <i class="bi bi-alarm"></i>
            Pendientes / próximos
            <span class="production-nav-count">@Model.TotalProximosAIniciar</span>
        </button>

        <button type="button"
                class="production-nav-btn"
                data-production-panel="ejecuciones"
                data-url="@Url.Action("PanelEjecuciones", "Produccion")">
            <i class="bi bi-activity"></i>
            En ejecución
            <span class="production-nav-count">@totalActivas</span>
        </button>

        <button type="button"
                class="production-nav-btn"
                data-production-panel="cola"
                data-url="@Url.Action("PanelCola", "Produccion")">
            <i class="bi bi-list-ol"></i>
            Cola
            <span class="production-nav-count">@Model.TotalDisponibles</span>
        </button>


    </nav>

    <section class="production-content-shell" id="contenidoProduccion" aria-live="polite">
        <div class="panel-loading">
            <div class="spinner-border" role="status" aria-hidden="true"></div>
            <div>Cargando operaciones...</div>
        </div>
    </section>
</div>

<button type="button"
        class="alerts-floating-button @(Model.TotalAlertasMuyRecientes > 0 ? "has-highlight" : "")"
        data-bs-toggle="modal"
        data-bs-target="#modalMovimientosProgramacion"
        title="Ver movimientos de programación"
        aria-label="Ver movimientos de programación">
    <i class="bi bi-bell-fill"></i>

    @if (Model.TotalAlertasReprogramacion > 0)
    {
        <span class="alerts-floating-badge">
            @(Model.TotalAlertasReprogramacion > 99
                    ? "99+"
                    : Model.TotalAlertasReprogramacion.ToString())
    </span>
        }
</button>

<div class="modal fade alerts-modal"
     id="modalMovimientosProgramacion"
     tabindex="-1"
     aria-labelledby="modalMovimientosProgramacionLabel"
     aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered modal-dialog-scrollable modal-xl">
        <div class="modal-content">
            <div class="modal-header">
                <div>
                    <h5 class="modal-title" id="modalMovimientosProgramacionLabel">
                        <i class="bi bi-bell-fill me-2"></i>
                        Movimientos de programación
                    </h5>
                    <div class="small opacity-75 mt-1">
                        Destacadas: últimas 2 horas. Visibles: últimas 24 horas.
                    </div>
                </div>

                <button type="button"
                        class="btn-close btn-close-white"
                        data-bs-dismiss="modal"
                        aria-label="Cerrar">
                </button>
            </div>

            <div class="alerts-modal-summary">
                @if (Model.TotalAlertasMuyRecientes > 0)
                {
                    <span class="tag tag-warn">
                        <i class="bi bi-lightning-charge"></i>
                        @Model.TotalAlertasMuyRecientes destacada(s)
                    </span>
                }

                <span class="tag tag-blue">
                    <i class="bi bi-bell"></i>
                    @Model.TotalAlertasReprogramacion cambio(s)
                </span>
            </div>

            @if (ViewBag.ErrorAlertasReprogramacion != null)
            {
                <div class="alert alert-warning mx-3 mt-3 mb-0">
                    <i class="bi bi-exclamation-triangle me-1"></i>
                    @ViewBag.ErrorAlertasReprogramacion
                </div>
            }

            <div class="alerts-list">
                @if (!alertasOrdenadas.Any())
                {
                    <div class="alerts-modal-empty">
                        <i class="bi bi-bell-slash"></i>
                        No hay movimientos de programación en las últimas 24 horas.
                    </div>
                }
                else
                {
                    foreach (var alerta in alertasOrdenadas)
                    {
                        <article class="program-alert @(alerta.EsMuyReciente ? "is-highlighted" : "")">
                            <div class="program-alert-icon">
                                <i class="bi @(alerta.EsMovimientoAutomatico ? "bi-shuffle" : alerta.CambioMaquina ? "bi-arrow-left-right" : "bi-calendar2-week")"></i>
                            </div>

                            <div>
                                <div class="program-alert-title">
                                    @alerta.Titulo · Programa @alerta.ProgramaProduccionID · @alerta.TextoParte
                                </div>

                                <div class="program-alert-message">
                                    @alerta.Mensaje
                                </div>

                                <div class="program-alert-meta">
                                    @if (!string.IsNullOrWhiteSpace(alerta.Motivo))
                                    {
                                        <span>
                                            <i class="bi bi-chat-left-text me-1"></i>
                                            Motivo: @alerta.Motivo
                                        </span>
                                    }

                                    @if (alerta.EsMovimientoAutomatico && alerta.ProgramaOrigenMovimientoID.HasValue)
                                    {
                                        <span>
                                            <i class="bi bi-diagram-3 me-1"></i>
                                            Originado por programa @alerta.ProgramaOrigenMovimientoID
                                        </span>
                                    }

                                    @if (!string.IsNullOrWhiteSpace(alerta.UsuarioNombre))
                                    {
                                        <span>
                                            <i class="bi bi-person me-1"></i>
                                            @alerta.UsuarioNombre
                                        </span>
                                    }
                                </div>
                            </div>

                            <div class="program-alert-date">
                                @if (alerta.EsMuyReciente)
                                {
                                    <span class="badge bg-warning text-dark mb-1">
                                        Destacada
                                    </span>
                                    <br />
                                }

                                @alerta.FechaCambioTexto
                            </div>
                        </article>
                    }
                }
            </div>

            <div class="modal-footer border-0 px-4 pb-4 pt-0">
                <button type="button"
                        class="btn btn-primary btn-action"
                        data-bs-dismiss="modal">
                    <i class="bi bi-check2 me-1"></i>
                    Cerrar
                </button>
            </div>
        </div>
    </div>
</div>

<div class="modal fade" id="modalSolicitarReprogramacion" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <form method="post" action="@Url.Action("SolicitarReprogramacion","Produccion")" id="formSolicitarReprogramacion">
                @Html.AntiForgeryToken()
                <input type="hidden" name="programaProduccionId" id="reprogramacionProgramaID" />
                <div class="modal-header">
                    <div>
                        <h5 class="modal-title fw-bold">
                            <i class="bi bi-calendar2-event me-1"></i>
                            Solicitar reprogramación
                        </h5>
                        <div class="small text-muted" id="reprogramacionResumen"></div>
                    </div>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Cerrar"></button>
                </div>
                <div class="modal-body">
                    <div class="alert alert-warning">
                        Esta acción no cambia directamente la programación. Planeación recibirá la solicitud y decidirá la nueva fecha y hora.
                    </div>
                    <div class="mb-3">
                        <label class="form-label">Motivo</label>
                        <select name="motivo" id="reprogramacionMotivo" class="form-select" required>
                            <option value="">Selecciona...</option>
                            <option value="MAQUINA_OCUPADA">Máquina ocupada</option>
                            <option value="MATERIAL_NO_DISPONIBLE">Material no disponible</option>
                            <option value="OPERADOR_NO_DISPONIBLE">Operador no disponible</option>
                            <option value="MOLDE_HERRAMENTAL">Molde / herramental no disponible</option>
                            <option value="MANTENIMIENTO">Mantenimiento</option>
                            <option value="CALIDAD">Pendiente de Calidad</option>
                            <option value="OTRO">Otro</option>
                        </select>
                    </div>
                    <div>
                        <label class="form-label">Explica la situación</label>
                        <textarea name="observaciones"
                                  id="reprogramacionObservaciones"
                                  class="form-control"
                                  maxlength="500"
                                  rows="4"
                                  required
                                  placeholder="Ej. La máquina continúa ocupada por la OF anterior y no es posible iniciar esta corrida en el horario programado."></textarea>
                        <div class="form-text">Máximo 500 caracteres.</div>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-light" data-bs-dismiss="modal">Cancelar</button>
                    <button type="submit" class="btn btn-warning fw-bold" id="btnEnviarReprogramacion">
                        <i class="bi bi-send me-1"></i>
                        Enviar solicitud
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

<div class="modal fade" id="modalIniciarPreparacion" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered modal-dialog-scrollable modal-lg">
        <div class="modal-content">
            <form method="post" action="@Url.Action("Iniciar", "Produccion")" id="formIniciarPreparacion">
                @Html.AntiForgeryToken()

                <div class="modal-header">
                    <div>
                        <h5 class="modal-title">
                            <i class="bi bi-play-circle me-2"></i>
                            Confirmar inicio de preparación
                        </h5>
                        <div class="small opacity-75">
                            Revisa el programa y confirma al operador principal, al auxiliar de producción y, si aplica, al Técnico en Producción antes de tomar la OF.
