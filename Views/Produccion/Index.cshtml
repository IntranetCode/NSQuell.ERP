        /* =========================================================
           MODALES INTEGRADOS CON EL LAYOUT GLOBAL
           - El backdrop cubre también el navbar.
           - El modal siempre queda por encima del layout.
           - Los modales altos hacen scroll internamente.
           ========================================================= */
        #modalIniciarPreparacion .modal-dialog {
            width: min(760px, calc(100vw - 32px));
            max-width: 760px;
            margin: 20px auto;
