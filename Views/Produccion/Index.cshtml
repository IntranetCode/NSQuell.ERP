            border-color: #d5dfeb;
            border-radius: 10px;
            background: #fff;
            color: #26364a;
            font-size: .84rem;
            transition: border-color .15s ease, box-shadow .15s ease, background .15s ease;
        }

            .production-filters .form-control:hover,
            .production-filters .form-select:hover {
                border-color: #b6c9df;
                background: #fcfdff;
            }

            .production-filters .form-control:focus,
            .production-filters .form-select:focus {
                border-color: #7ea8dd;
                background: #fff;
                box-shadow: 0 0 0 .18rem rgba(47,111,189,.10);
            }

        #formFiltrosProduccion .btn-primary {
            min-height: 44px;
            border: 1px solid #1769c2;
            border-radius: 10px;
            background: linear-gradient(180deg, #2585dc 0%, #1472c9 100%);
