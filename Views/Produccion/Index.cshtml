        /* ==========================================================
                   TEMA OSCURO INTERACTIVO - PRODUCCION
                   Se activa con html[data-produccion-theme="dark"].
                   El script al final sincroniza esta vista con el switch
                   Claro/Oscuro existente en _Layout.
                   ========================================================== */
        html[data-produccion-theme="dark"] {
            color-scheme: dark;
            --azul: #7db7ff;
            --azul2: #4f9cff;
            --borde: #304159;
            --bg: #0b1220;
            --txt: #e7eef9;
            --muted: #9aa9bd;
            --success: #4ade80;
            --warning: #fbbf24;
            --danger: #fb7185;
            --purple: #b7a3ff;
        }

        body,
        .section,
        .section-head,
        .production-nav,
        .production-nav-btn,
        .production-content-shell,
        .form-control,
        .form-select,
        .modal-content,
        .operator-box,
        .program-alert,
        .panel-loading,
        .panel-error {
            transition: background-color .22s ease, border-color .22s ease, color .22s ease, box-shadow .22s ease;
        }

        html[data-produccion-theme="dark"] body {
            background: #0b1220;
            color: #e7eef9;
        }

        html[data-produccion-theme="dark"] .topbar {
            background: linear-gradient(135deg, #0b2343, #123f73);
            border-color: #34577e;
            box-shadow: 0 12px 28px rgba(0, 0, 0, .22);
        }

        html[data-produccion-theme="dark"] .section,
        html[data-produccion-theme="dark"] .production-content-shell {
            background: #111b2d;
            border-color: #2c3d55;
            box-shadow: 0 8px 22px rgba(0, 0, 0, .12);
        }

        html[data-produccion-theme="dark"] .section-head {
            background: #152238;
            border-bottom-color: #2c3d55;
        }

        html[data-produccion-theme="dark"] .section-title,
        html[data-produccion-theme="dark"] .machine-title,
        html[data-produccion-theme="dark"] .line-main,
        html[data-produccion-theme="dark"] .info-v,
        html[data-produccion-theme="dark"] .operator-title,
        html[data-produccion-theme="dark"] .modal-title {
            color: #eef5ff;
        }

        html[data-produccion-theme="dark"] .section-sub,
        html[data-produccion-theme="dark"] .machine-sub,
        html[data-produccion-theme="dark"] .line-sub,
        html[data-produccion-theme="dark"] .info-k,
        html[data-produccion-theme="dark"] .form-label {
            color: #9aa9bd;
        }

        html[data-produccion-theme="dark"] .form-control,
        html[data-produccion-theme="dark"] .form-select {
            background-color: #0d1727;
            border-color: #354961;
            color: #eaf2ff;
        }

            html[data-produccion-theme="dark"] .form-control::placeholder {
                color: #75869d;
            }

            html[data-produccion-theme="dark"] .form-control:focus,
            html[data-produccion-theme="dark"] .form-select:focus {
                background-color: #101c2f;
                border-color: #5da6ff;
                color: #fff;
                box-shadow: 0 0 0 .2rem rgba(93, 166, 255, .14);
            }

        html[data-produccion-theme="dark"] input[type="date"]::-webkit-calendar-picker-indicator,
        html[data-produccion-theme="dark"] input[type="time"]::-webkit-calendar-picker-indicator {
            filter: invert(1) brightness(1.25);
            opacity: .78;
        }

        html[data-produccion-theme="dark"] .btn-action {
            background: linear-gradient(135deg, #1769c2, #2b8ee8);
            border-color: #4ea3f7;
            box-shadow: 0 5px 14px rgba(32, 121, 211, .22);
        }

        html[data-produccion-theme="dark"] .production-nav {
            background: #101a2b;
            border-color: #2d4059;
            box-shadow: 0 5px 16px rgba(0, 0, 0, .14);
        }

        html[data-produccion-theme="dark"] .production-nav-btn {
            background: #152136;
            border-color: #31455f;
            color: #cbd7e7;
        }

            html[data-produccion-theme="dark"] .production-nav-btn:hover {
                background: #1a2941;
                border-color: #58779e;
                color: #f3f7ff;
