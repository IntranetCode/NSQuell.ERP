@model ERP.NSQuell.Models.ProduccionBandejaVm
@using Microsoft.AspNetCore.Mvc.Rendering

@{
    Layout = "~/Views/Shared/_Layout.cshtml";
    ViewData["Title"] = "Producción";

    var operadoresProduccion =
        ViewBag.OperadoresProduccion as List<SelectListItem>
        ?? new List<SelectListItem>();

    var programasPorMaquina = Model.ProgramasDisponibles
        .OrderBy(x => string.IsNullOrWhiteSpace(x.MaquinaCodigo) ? "ZZZ" : x.MaquinaCodigo)
        .ThenBy(x => x.FechaInicioProgramada ?? DateTime.MaxValue)
        .ThenBy(x => x.ProgramaProduccionID)
        .GroupBy(x => string.IsNullOrWhiteSpace(x.MaquinaCodigo) ? "SIN_MAQUINA" : x.MaquinaCodigo)
        .ToList();

    var proximosPorMaquina = Model.ProximosAIniciar
        .OrderBy(x => string.IsNullOrWhiteSpace(x.MaquinaCodigo) ? "ZZZ" : x.MaquinaCodigo)
        .ThenBy(x => x.FechaInicioProgramada ?? DateTime.MaxValue)
        .ThenBy(x => x.ProgramaProduccionID)
        .GroupBy(x => string.IsNullOrWhiteSpace(x.MaquinaCodigo) ? "SIN_MAQUINA" : x.MaquinaCodigo)
        .ToList();

    var alertasOrdenadas = Model.AlertasReprogramacion
        .OrderByDescending(x => x.EsMuyReciente)
        .ThenByDescending(x => x.FechaCambio)
        .ThenByDescending(x => x.ReprogramacionHistorialID)
        .ToList();

    var ejecucionesPorMaquina = Model.Ejecuciones
     .OrderBy(x => string.IsNullOrWhiteSpace(x.MaquinaCodigo) ? "ZZZ" : x.MaquinaCodigo)
     .ThenBy(x => x.ProgramaProduccionID)
     .ThenBy(x => x.EjecucionProduccionID)
     .GroupBy(x => string.IsNullOrWhiteSpace(x.MaquinaCodigo) ? "SIN_MAQUINA" : x.MaquinaCodigo)
     .ToList();
}

@functions {
    public static string Txt(string? value)
    {
        return string.IsNullOrWhiteSpace(value) ? "-" : value.Trim();
    }

    public static string Fecha(DateTime? value)
    {
        return value.HasValue ? value.Value.ToString("dd/MM/yyyy HH:mm") : "-";
    }

    public static string Num(int? value)
    {
        return value.HasValue ? value.Value.ToString("N0") : "-";
    }

    public static string Num0(int value)
    {
        return value.ToString("N0");
    }

    public static string Data(string? value)
    {
        return string.IsNullOrWhiteSpace(value)
            ? ""
            : value.Replace("\"", "&quot;").Replace("\r", " ").Replace("\n", " ");
    }

    public static string PorcentajeClase(decimal porcentaje)
    {
        if (porcentaje >= 100) return "bg-success";
        if (porcentaje >= 60) return "bg-primary";
        if (porcentaje > 0) return "bg-warning";
        return "bg-secondary";
    }

    public static string EstatusRowClase(int estatusId)
    {
        if (estatusId == ERP.NSQuell.Models.ProduccionEstatus.EnProduccion) return "row-produccion";
        if (estatusId == ERP.NSQuell.Models.ProduccionEstatus.EnPreparacion) return "row-preparacion";
        if (estatusId == ERP.NSQuell.Models.ProduccionEstatus.Pausado) return "row-pausado";
        if (estatusId == ERP.NSQuell.Models.ProduccionEstatus.Terminado ||
            estatusId == ERP.NSQuell.Models.ProduccionEstatus.TerminadoParcial) return "row-terminado";

        return "";
    }

    public static string MachineKey(string? value)
    {
        var raw = string.IsNullOrWhiteSpace(value) ? "SIN_MAQUINA" : value.Trim();

        return raw
            .Replace(" ", "_")
            .Replace("-", "_")
            .Replace("/", "_")
            .Replace(".", "_")
            .Replace(":", "_");
    }
}

@section Styles {
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.css" rel="stylesheet" />
    <link rel="stylesheet" href="~/css/Produccion/index.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/Produccion/proximos.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/Produccion/cola.css" asp-append-version="true" />
}

<div class="page">

    <header class="topbar">
        <div class="d-flex justify-content-between align-items-start gap-3 flex-wrap">
            <div>
                <h1 class="topbar-title">
                    <i class="bi bi-gear-wide-connected me-2"></i>
                    Producción
                </h1>
                <div class="topbar-sub">
                    Centro operativo de Producción: ejecución, próximos inicios y cola programada.
                </div>
            </div>
            <div class="d-flex align-items-center gap-3 flex-wrap">
                <a class="production-nav-btn"
                   asp-controller="Produccion"
                   asp-action="Preparacion">
                    <i class="bi bi-tools"></i>
                    Preparación próxima
                </a>

                <div class="text-end">
                    <div class="small opacity-75">Fecha</div>
                    <div class="fw-bold">@DateTime.Now.ToString("dd/MM/yyyy HH:mm")</div>
                </div>
            </div>
        </div>
    </header>

    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show" role="alert">
            <i class="bi bi-check-circle me-1"></i>
            @TempData["Success"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show" role="alert">
            <i class="bi bi-exclamation-triangle me-1"></i>
            @TempData["Error"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    @if (TempData["Info"] != null)
    {
        <div class="alert alert-info alert-dismissible fade show" role="alert">
            <i class="bi bi-info-circle me-1"></i>
            @TempData["Info"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    <section class="section production-filters">
        <div class="section-head">
            <div>
                <h2 class="section-title">
                    <i class="bi bi-funnel"></i>
                    Filtros
                </h2>
                <div class="section-sub">
                    Busca por máquina, parte, molde, operador, programa u OF.
                </div>
            </div>
        </div>

        <div class="filters">
            <form method="get" action="@Url.Action("Index", "Produccion")" id="formFiltrosProduccion" class="row g-3 align-items-end">
                <div class="col-12 col-xl-3">
                    <label class="form-label">Buscar</label>
                    <input type="text"
                           name="busqueda"
                           value="@Model.Busqueda"
                           class="form-control"
                           placeholder="Máquina, parte, molde, operador..." />
                </div>

                <div class="col-12 col-md-6 col-xl-2">
                    <label class="form-label">Máquina</label>
                    <select name="maquinaId" class="form-select">
                        @foreach (var item in Model.Maquinas)
                        {
                            <option value="@item.Value" selected="@(item.Value == Model.MaquinaID?.ToString())">
                                @item.Text
                            </option>
                        }
                    </select>
                </div>

                <div class="col-12 col-md-6 col-xl-2">
                    <label class="form-label">Estatus (ejecuciones)</label>
                    <select name="estatusId" class="form-select">
                        @foreach (var item in Model.Estatus)
                        {
                            <option value="@item.Value" selected="@(item.Value == Model.EstatusID?.ToString())">
                                @item.Text
                            </option>
                        }
                    </select>
                </div>

                <div class="col-6 col-xl-2">
                    <label class="form-label">Desde</label>
                    <input type="date"
                           name="fechaDesde"
                           value="@(Model.FechaDesde?.ToString("yyyy-MM-dd"))"
                           class="form-control" />
                </div>

                <div class="col-6 col-xl-2">
                    <label class="form-label">Hasta</label>
                    <input type="date"
                           name="fechaHasta"
                           value="@(Model.FechaHasta?.ToString("yyyy-MM-dd"))"
                           class="form-control" />
                </div>

                <div class="col-12 col-xl-1 d-grid">
                    <button type="submit" class="btn btn-primary btn-action">
                        <i class="bi bi-search me-1"></i>
                        Buscar
                    </button>
                </div>
            </form>
        </div>
    </section>

    @{
        var totalActivas =
        Model.Pendientes +
        Model.EnPreparacion +
        Model.EnProduccion +
        Model.Pausados;
    }

    <nav class="production-nav" aria-label="Navegación operativa de Producción">
        <button type="button"
                class="production-nav-btn is-active"
                data-production-panel="proximos"
                data-url="@Url.Action("PanelProximos", "Produccion")">
            <i class="bi bi-alarm"></i>
            Pendientes / próximos
            <span class="production-nav-count">@Model.TotalProximosAIniciar</span>
        </button>

        <button type="button"
                class="production-nav-btn"
                data-production-panel="ejecuciones"
                data-url="@Url.Action("PanelEjecuciones", "Produccion")">
            <i class="bi bi-activity"></i>
            En ejecución
            <span class="production-nav-count">@totalActivas</span>
        </button>

        <button type="button"
                class="production-nav-btn"
                data-production-panel="cola"
                data-url="@Url.Action("PanelCola", "Produccion")">
            <i class="bi bi-list-ol"></i>
            Cola
            <span class="production-nav-count">@Model.TotalDisponibles</span>
        </button>


    </nav>

    <section class="production-content-shell" id="contenidoProduccion" aria-live="polite">
        <div class="panel-loading">
            <div class="spinner-border" role="status" aria-hidden="true"></div>
            <div>Cargando operaciones...</div>
        </div>
    </section>
</div>

<button type="button"
        class="alerts-floating-button @(Model.TotalAlertasMuyRecientes > 0 ? "has-highlight" : "")"
        data-bs-toggle="modal"
        data-bs-target="#modalMovimientosProgramacion"
        title="Ver movimientos de programación"
        aria-label="Ver movimientos de programación">
    <i class="bi bi-bell-fill"></i>

    @if (Model.TotalAlertasReprogramacion > 0)
    {
        <span class="alerts-floating-badge">
            @(Model.TotalAlertasReprogramacion > 99
                    ? "99+"
                    : Model.TotalAlertasReprogramacion.ToString())
    </span>
        }
</button>

<div class="modal fade alerts-modal"
     id="modalMovimientosProgramacion"
     tabindex="-1"
     aria-labelledby="modalMovimientosProgramacionLabel"
     aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered modal-dialog-scrollable modal-xl">
        <div class="modal-content">
            <div class="modal-header">
                <div>
                    <h5 class="modal-title" id="modalMovimientosProgramacionLabel">
                        <i class="bi bi-bell-fill me-2"></i>
                        Movimientos de programación
                    </h5>
                    <div class="small opacity-75 mt-1">
                        Destacadas: últimas 2 horas. Visibles: últimas 24 horas.
                    </div>
                </div>

                <button type="button"
                        class="btn-close btn-close-white"
                        data-bs-dismiss="modal"
                        aria-label="Cerrar">
                </button>
            </div>

            <div class="alerts-modal-summary">
                @if (Model.TotalAlertasMuyRecientes > 0)
                {
                    <span class="tag tag-warn">
                        <i class="bi bi-lightning-charge"></i>
                        @Model.TotalAlertasMuyRecientes destacada(s)
                    </span>
                }

                <span class="tag tag-blue">
                    <i class="bi bi-bell"></i>
                    @Model.TotalAlertasReprogramacion cambio(s)
                </span>
            </div>

            @if (ViewBag.ErrorAlertasReprogramacion != null)
            {
                <div class="alert alert-warning mx-3 mt-3 mb-0">
                    <i class="bi bi-exclamation-triangle me-1"></i>
                    @ViewBag.ErrorAlertasReprogramacion
                </div>
            }

            <div class="alerts-list">
                @if (!alertasOrdenadas.Any())
                {
                    <div class="alerts-modal-empty">
                        <i class="bi bi-bell-slash"></i>
                        No hay movimientos de programación en las últimas 24 horas.
                    </div>
                }
                else
                {
                    foreach (var alerta in alertasOrdenadas)
                    {
                        <article class="program-alert @(alerta.EsMuyReciente ? "is-highlighted" : "")">
                            <div class="program-alert-icon">
                                <i class="bi @(alerta.EsMovimientoAutomatico ? "bi-shuffle" : alerta.CambioMaquina ? "bi-arrow-left-right" : "bi-calendar2-week")"></i>
                            </div>

                            <div>
                                <div class="program-alert-title">
                                    @alerta.Titulo · Programa @alerta.ProgramaProduccionID · @alerta.TextoParte
                                </div>

                                <div class="program-alert-message">
                                    @alerta.Mensaje
                                </div>

                                <div class="program-alert-meta">
                                    @if (!string.IsNullOrWhiteSpace(alerta.Motivo))
                                    {
                                        <span>
                                            <i class="bi bi-chat-left-text me-1"></i>
                                            Motivo: @alerta.Motivo
                                        </span>
                                    }

                                    @if (alerta.EsMovimientoAutomatico && alerta.ProgramaOrigenMovimientoID.HasValue)
                                    {
                                        <span>
                                            <i class="bi bi-diagram-3 me-1"></i>
                                            Originado por programa @alerta.ProgramaOrigenMovimientoID
                                        </span>
                                    }

                                    @if (!string.IsNullOrWhiteSpace(alerta.UsuarioNombre))
                                    {
                                        <span>
                                            <i class="bi bi-person me-1"></i>
                                            @alerta.UsuarioNombre
                                        </span>
                                    }
                                </div>
                            </div>

                            <div class="program-alert-date">
                                @if (alerta.EsMuyReciente)
                                {
                                    <span class="badge bg-warning text-dark mb-1">
                                        Destacada
                                    </span>
                                    <br />
                                }

                                @alerta.FechaCambioTexto
                            </div>
                        </article>
                    }
                }
            </div>

            <div class="modal-footer border-0 px-4 pb-4 pt-0">
                <button type="button"
                        class="btn btn-primary btn-action"
                        data-bs-dismiss="modal">
                    <i class="bi bi-check2 me-1"></i>
                    Cerrar
                </button>
            </div>
        </div>
    </div>
</div>

<div class="modal fade" id="modalIniciarPreparacion" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered modal-dialog-scrollable modal-lg">
        <div class="modal-content">
            <form method="post" action="@Url.Action("Iniciar", "Produccion")" id="formIniciarPreparacion">
                @Html.AntiForgeryToken()

                <div class="modal-header">
                    <div>
                        <h5 class="modal-title">
                            <i class="bi bi-play-circle me-2"></i>
                            Confirmar inicio de preparación
                        </h5>
                        <div class="small opacity-75">
                            Revisa el programa y confirma al operador principal y, si aplica, al auxiliar antes de tomar la OF.
                        </div>
                    </div>

                    <button type="button"
                            class="btn-close btn-close-white"
                            data-bs-dismiss="modal"
                            aria-label="Cerrar">
                    </button>
                </div>

                <div class="modal-body">
                    <input type="hidden" name="programaProduccionId" id="modalProgramaProduccionId" />
                    <input type="hidden" name="operadorNombre" id="modalOperadorNombre" />
                    <input type="hidden" name="operadorAuxiliarNombre" id="modalOperadorAuxiliarNombre" />

                    <div class="row g-3 mb-3">
                        <div class="col-md-6">
                            <div class="info-line">
                                <div class="info-k">Programa</div>
                                <div class="info-v" id="modalProgramaTexto">-</div>
                            </div>

                            <div class="info-line">
                                <div class="info-k">Máquina</div>
                                <div class="info-v" id="modalMaquinaTexto">-</div>
                            </div>

                            <div class="info-line">
                                <div class="info-k">Molde</div>
                                <div class="info-v" id="modalMoldeTexto">-</div>
                            </div>

                            <div class="info-line">
                                <div class="info-k">Cantidad</div>
                                <div class="info-v" id="modalCantidadTexto">-</div>
                            </div>
                        </div>

                        <div class="col-md-6">
                            <div class="info-line">
                                <div class="info-k">Parte</div>
                                <div class="info-v" id="modalParteTexto">-</div>
                            </div>

                            <div class="info-line">
                                <div class="info-k">Descripción</div>
                                <div class="info-v" id="modalDescripcionTexto">-</div>
                            </div>

                            <div class="info-line">
                                <div class="info-k">Inicio prog.</div>
                                <div class="info-v" id="modalInicioTexto">-</div>
                            </div>

                            <div class="info-line">
                                <div class="info-k">Fin prog.</div>
                                <div class="info-v" id="modalFinTexto">-</div>
                            </div>
                        </div>
                    </div>

                    <div class="operator-box" id="boxOperadorSugerido">
                        <div class="operator-title" id="tituloOperadorSugerido">
                            Operador principal sugerido desde RRHH
                        </div>
                        <div class="small text-muted mt-1" id="detalleOperadorSugerido">-</div>
                    </div>

                    <div class="modal-validation-message" id="mensajeValidacionOperadores" role="alert">
                        <i class="bi bi-exclamation-triangle-fill mt-1"></i>
                        <div id="textoValidacionOperadores"></div>
                    </div>

                    <div class="row g-3 mb-3">
                        <div class="col-lg-6">
                            <div class="operator-role-card required">
                                <div class="operator-role-head">
                                    <div class="operator-role-name"><i class="bi bi-person-badge me-1"></i>Operador principal</div>
                                    <span class="operator-required-badge">Obligatorio</span>
                                </div>
                                <div class="mb-3">
                                    <label class="form-label">Seleccionar operador</label>
                                    <select name="operadorId" id="modalOperadorId" class="form-select">
                                        @foreach (var op in operadoresProduccion)
                                        {
                                            <option value="@op.Value">@op.Text</option>
                                        }
                                    </select>
                                    <div class="small text-muted mt-1" id="modalPolivalenciaInfo">Si la pieza tiene matriz, se mostrarán solo operadores evaluados y su nivel.</div>
                                </div>
                                <div>
                                    <label class="form-label">Nombre manual</label>
                                    <input type="text" id="modalOperadorManual" class="form-control" maxlength="200" placeholder="Se selecciona desde Escala de Personal" />
                                    <div class="small text-muted mt-1">El operador principal se controla desde Escala de Personal.</div>
                                </div>
                            </div>
                        </div>

                        <div class="col-lg-6">
                            <div class="operator-role-card">
                                <div class="operator-role-head">
                                    <div class="operator-role-name"><i class="bi bi-person-plus me-1"></i>Operador auxiliar</div>
                                    <span class="operator-optional-badge">Opcional</span>
                                </div>
                                <div class="mb-3">
                                    <label class="form-label">Seleccionar auxiliar</label>
                                    <select name="operadorAuxiliarId" id="modalOperadorAuxiliarId" class="form-select">
                                        @foreach (var op in operadoresProduccion)
                                        {
                                            <option value="@op.Value">@op.Text</option>
                                        }
                                    </select>
                                    <div class="small text-muted mt-1">Puede dejarse sin auxiliar si la preparación no lo requiere.</div>
                                </div>
                                <div>
                                    <label class="form-label">Nombre manual auxiliar</label>
                                    <input type="text" id="modalOperadorAuxiliarManual" class="form-control" maxlength="200" placeholder="Se selecciona desde Escala de Personal" />
                                    <div class="small text-muted mt-1">El auxiliar es opcional y no puede ser la misma persona que el operador principal.</div>
                                </div>
                            </div>
                        </div>
                    </div>

                    <div class="row g-3">
                        <div class="col-12">
                            <label class="form-label">Observaciones</label>
                            <textarea name="observaciones" id="modalObservaciones" class="form-control" rows="3" maxlength="500" placeholder="Observaciones de preparación, cambio de operador, indicaciones especiales..."></textarea>
                        </div>
                    </div>
                </div>

                <div class="modal-footer border-0 px-4 pb-4">
                    <button type="button"
                            class="btn btn-light btn-action"
                            data-bs-dismiss="modal">
                        Cancelar
                    </button>

                    <button type="submit"
                            class="btn btn-success btn-action"
                            id="btnConfirmarInicio">
                        <i class="bi bi-play-fill me-1"></i>
                        Iniciar preparación
                    </button>
                </div>


            </form>


        </div>
    </div>
</div>

@section Scripts {
    <script>
                (() => {
                    const contenidoProduccion = document.getElementById('contenidoProduccion');
                    const formFiltros = document.getElementById('formFiltrosProduccion');
                    const navButtons = Array.from(document.querySelectorAll('[data-production-panel]'));

                    const modalProgramaProduccionId = document.getElementById('modalProgramaProduccionId');
                    const modalProgramaTexto = document.getElementById('modalProgramaTexto');
                    const modalMaquinaTexto = document.getElementById('modalMaquinaTexto');
                    const modalParteTexto = document.getElementById('modalParteTexto');
                    const modalDescripcionTexto = document.getElementById('modalDescripcionTexto');
                    const modalMoldeTexto = document.getElementById('modalMoldeTexto');
                    const modalCantidadTexto = document.getElementById('modalCantidadTexto');
                    const modalInicioTexto = document.getElementById('modalInicioTexto');
                    const modalFinTexto = document.getElementById('modalFinTexto');

                    const boxOperadorSugerido = document.getElementById('boxOperadorSugerido');
                    const tituloOperadorSugerido = document.getElementById('tituloOperadorSugerido');
                    const detalleOperadorSugerido = document.getElementById('detalleOperadorSugerido');

                    const modalOperadorId = document.getElementById('modalOperadorId');
                    const modalOperadorNombre = document.getElementById('modalOperadorNombre');
                    const modalOperadorManual = document.getElementById('modalOperadorManual');
                    const modalOperadorAuxiliarId = document.getElementById('modalOperadorAuxiliarId');
                    const modalOperadorAuxiliarNombre = document.getElementById('modalOperadorAuxiliarNombre');
                    const modalOperadorAuxiliarManual = document.getElementById('modalOperadorAuxiliarManual');
                    const modalPolivalenciaInfo = document.getElementById('modalPolivalenciaInfo');
                    const opcionesOperadorBase = modalOperadorId?.innerHTML || '';
                    const opcionesAuxiliarBase = modalOperadorAuxiliarId?.innerHTML || '';
                    const modalObservaciones = document.getElementById('modalObservaciones');
                    const mensajeValidacionOperadores = document.getElementById('mensajeValidacionOperadores');
                    const textoValidacionOperadores = document.getElementById('textoValidacionOperadores');

                    const formIniciarPreparacion = document.getElementById('formIniciarPreparacion');
                    const btnConfirmarInicio = document.getElementById('btnConfirmarInicio');

                    let panelActivo = 'proximos';
                    let controladorCarga = null;

                    function texto(value) {
                        if (!value || !value.trim()) return '-';
                        return value.trim();
                    }

                    function seleccionarPersonaSiExiste(select, personaId) {
                        if (!select) return false;
                        const id = personaId || '';
                        for (const option of select.options) {
                            if (option.value === id) {
                                select.value = id;
                                return true;
                            }
                        }
                        select.value = '';
                        return false;
                    }

                    function obtenerTextoSeleccionado(select) {
                        if (!select || !select.value) return '';
                        const selected = select.options[select.selectedIndex];
                        return selected ? (selected.textContent || '').trim() : '';
                    }

                    function limpiarSelectEscala(select, placeholder) {
                        if (!select) return;
                        select.innerHTML = '';
                        const vacio = document.createElement('option');
                        vacio.value = '';
                        vacio.textContent = placeholder;
                        select.appendChild(vacio);
                    }

                    function textoPersonaEscala(x, mostrarNivel) {
                        const sep = ' \u00B7 ';
                        const partes = [];

                        if (mostrarNivel && x.nivel) partes.push(`N${x.nivel}`);
                        partes.push(x.nombre || '');
                        if (x.numeroControl) partes.push(`Ctrl ${x.numeroControl}`);
                        if (x.enEscala) partes.push('EN ESCALA');
                        if (x.turnoNombre) partes.push(x.turnoNombre);
                        if (x.maquinaCodigo) partes.push(x.maquinaCodigo);

                        return partes.filter(Boolean).join(sep);
                    }
                    function sincronizarModoManual(select, manual, tipo = 'principal') {
                        if (!manual) return;

                        const haySeleccion = !!select?.value;
                        manual.disabled = haySeleccion;

                        if (haySeleccion) {
                            manual.value = '';
                            manual.placeholder = tipo === 'auxiliar'
                                ? 'Bloqueado: ya seleccionaste un auxiliar'
                                : 'Bloqueado: ya seleccionaste un operador';
                        }
                        else {
                            manual.placeholder = tipo === 'auxiliar'
                                ? 'Escribe el nombre si no seleccionas auxiliar'
                                : 'Escribe el nombre si no seleccionas operador';
                        }
                    }
        async function cargarOperadoresPolivalencia(programaId, parteId, maquinaId, operadorPreferido, auxiliarPreferido) {
                        limpiarSelectEscala(modalOperadorId, '-- Cargando operadores --');
                        limpiarSelectEscala(modalOperadorAuxiliarId, '-- Cargando auxiliares --');

                        if (modalOperadorManual) {
                            modalOperadorManual.disabled = false;
                            modalOperadorManual.placeholder = 'Escribe el nombre si no seleccionas operador';
                        }
                        if (modalOperadorAuxiliarManual) {
                            modalOperadorAuxiliarManual.disabled = false;
                            modalOperadorAuxiliarManual.placeholder = 'Escribe el nombre si no seleccionas auxiliar';
                        }

                        try {
                            const params = new URLSearchParams();
                            if (programaId) params.set('programaId', programaId);
                            if (parteId) params.set('parteId', parteId);
                            if (maquinaId) params.set('maquinaId', maquinaId);

                            const url = '@Url.Action("OperadoresPolivalenciaParte", "Produccion")' + '?' + params.toString();
                            const response = await fetch(url, { headers: { 'X-Requested-With': 'XMLHttpRequest' } });
                            if (!response.ok) throw new Error(`HTTP ${response.status}`);
                            const data = await response.json();

                            if (!data?.configurado) {
                                limpiarSelectEscala(modalOperadorId, '-- Polivalencia no configurada --');
                                limpiarSelectEscala(modalOperadorAuxiliarId, '-- Auxiliares no disponibles --');
                                if (modalPolivalenciaInfo) {
                                    modalPolivalenciaInfo.textContent = 'No esta disponible la configuracion de Polivalencia.';
                                    modalPolivalenciaInfo.className = 'small text-danger fw-semibold mt-1';
                                }
                                return;
                            }

                            const operadores = Array.isArray(data.operadores) ? data.operadores : [];
                            const auxiliares = Array.isArray(data.auxiliares) ? data.auxiliares : [];
                            const tieneMatriz = data.tieneMatriz === true;
                            const numeroParte = data.numeroParte || '';
                            const etiquetaEscala = data.escalaEncontrada
                                ? `${data.escalaFolio || 'Escala'} - ${data.escalaEstado || ''}`
                                : 'Sin Escala aplicable';

                            limpiarSelectEscala(
                                modalOperadorId,
                                tieneMatriz
                                    ? (operadores.length > 0
                                        ? '-- Seleccionar operador evaluado N1-N4 --'
                                        : '-- Sin operadores evaluados N1-N4 --')
                                    : '-- Seleccionar operador --');

                            operadores.forEach(x => {
                                const op = document.createElement('option');
                                op.value = String(x.personaID);
                                op.textContent = textoPersonaEscala(x, tieneMatriz);
                                if (x.nivel) op.dataset.nivel = String(x.nivel);
                                modalOperadorId?.appendChild(op);
                            });

                            // Solo conserva el sugerido si tambien esta dentro del listado permitido.
                            seleccionarPersonaSiExiste(modalOperadorId, operadorPreferido);
                            sincronizarModoManual(modalOperadorId, modalOperadorManual);

                            limpiarSelectEscala(
                                modalOperadorAuxiliarId,
                                auxiliares.length > 0
                                    ? '-- Seleccionar auxiliar --'
                                    : '-- Sin auxiliares activos --');

                            auxiliares.forEach(x => {
                                const op = document.createElement('option');
                                op.value = String(x.personaID);
                                op.textContent = textoPersonaEscala(x, false);
                                modalOperadorAuxiliarId?.appendChild(op);
                            });
                            seleccionarPersonaSiExiste(modalOperadorAuxiliarId, auxiliarPreferido);
                            sincronizarModoManual(modalOperadorAuxiliarId, modalOperadorAuxiliarManual, 'auxiliar');

                            if (modalPolivalenciaInfo) {
                                if (tieneMatriz) {
                                    modalPolivalenciaInfo.textContent = operadores.length > 0
                                        ? `Parte ${numeroParte || ''} enlazada a Polivalencia: ${operadores.length} operador(es) evaluados N1-N4. Los asignados en ${etiquetaEscala} aparecen primero; despues N4 -> N1.`
                                        : `Parte ${numeroParte || ''} tiene matriz, pero no hay operadores activos evaluados N1-N4.`;
                                    modalPolivalenciaInfo.className = operadores.length > 0
                                        ? 'small text-success fw-semibold mt-1'
                                        : 'small text-danger fw-semibold mt-1';
                                } else {
                                    modalPolivalenciaInfo.textContent =
                                        `La parte ${numeroParte || ''} no tiene matriz de Polivalencia; puedes seleccionar del catalogo general o capturar un nombre manual.`;
                                    modalPolivalenciaInfo.className = 'small text-warning fw-semibold mt-1';
                                }
                            }

                            if (tieneMatriz) {
                                if (operadores.length > 0) {
                                    boxOperadorSugerido?.classList.remove('warn');
                                    if (tituloOperadorSugerido) {
                                        tituloOperadorSugerido.textContent = 'Operadores evaluados para la pieza';
                                        tituloOperadorSugerido.className = 'operator-title';
                                    }
                                    if (detalleOperadorSugerido) {
                                        detalleOperadorSugerido.textContent =
                                            `${operadores.length} operador(es) con nivel N1-N4 para ${numeroParte || 'esta pieza'}. No se muestran personas sin nivel. Auxiliares disponibles: ${auxiliares.length}.`;
                                    }
                                } else {
                                    boxOperadorSugerido?.classList.add('warn');
                                    if (tituloOperadorSugerido) {
                                        tituloOperadorSugerido.textContent = 'Sin operadores evaluados';
                                        tituloOperadorSugerido.className = 'operator-title warn';
                                    }
                                    if (detalleOperadorSugerido) {
                                        detalleOperadorSugerido.textContent =
                                            `La pieza ${numeroParte || ''} tiene matriz, pero no hay personas activas con N1-N4.`;
                                    }
                                }
                            } else {
                                boxOperadorSugerido?.classList.add('warn');
                                if (tituloOperadorSugerido) {
                                    tituloOperadorSugerido.textContent = 'Pieza sin matriz de polivalencia';
                                    tituloOperadorSugerido.className = 'operator-title warn';
                                }
                                if (detalleOperadorSugerido) {
                                    detalleOperadorSugerido.textContent =
                                        'Se habilita el catalogo general. Si la persona no aparece, tambien puedes capturar el nombre manualmente.';
                                }
                            }
                        }
                        catch (error) {
                            console.error('Polivalencia:', error);
                            limpiarSelectEscala(modalOperadorId, '-- Error al cargar operadores --');
                            limpiarSelectEscala(modalOperadorAuxiliarId, '-- Error al cargar auxiliares --');
                            if (modalPolivalenciaInfo) {
                                modalPolivalenciaInfo.textContent = 'No fue posible consultar Polivalencia.';
                                modalPolivalenciaInfo.className = 'small text-danger fw-semibold mt-1';
                            }
                        }
                    }

                    function limpiarValidacionOperadores() {
                        mensajeValidacionOperadores?.classList.remove('show', 'is-success');
                        if (textoValidacionOperadores) textoValidacionOperadores.textContent = '';
                        [modalOperadorId, modalOperadorManual, modalOperadorAuxiliarId, modalOperadorAuxiliarManual]
                            .forEach(x => x?.classList.remove('operator-field-invalid'));
                    }

                    function mostrarValidacionOperadores(mensaje, campos = [], exito = false) {
                        limpiarValidacionOperadores();
                        if (textoValidacionOperadores) textoValidacionOperadores.textContent = mensaje;
                        mensajeValidacionOperadores?.classList.add('show');
                        if (exito) mensajeValidacionOperadores?.classList.add('is-success');
                        campos.forEach(x => x?.classList.add('operator-field-invalid'));
                        campos.find(x => x)?.focus();
                    }

                    function marcarPanelActivo(panel) {
                        panelActivo = panel || 'proximos';

                        navButtons.forEach(btn => {
                            btn.classList.toggle(
                                'is-active',
                                btn.dataset.productionPanel === panelActivo);
                        });
                    }

                    function parametrosFiltros(panel, maquinaForzada = null) {
                        const params = new URLSearchParams();

                        if (!formFiltros) {
                            if (maquinaForzada) params.set('maquinaId', maquinaForzada);
                            return params;
                        }

                        const data = new FormData(formFiltros);

                        const busqueda = (data.get('busqueda') || '').toString().trim();
                        const maquinaId = maquinaForzada ?? (data.get('maquinaId') || '').toString();
                        const estatusId = (data.get('estatusId') || '').toString();
                        const fechaDesde = (data.get('fechaDesde') || '').toString();
                        const fechaHasta = (data.get('fechaHasta') || '').toString();

                        if (busqueda) params.set('busqueda', busqueda);
                        if (maquinaId) params.set('maquinaId', maquinaId);
                        if (fechaDesde) params.set('fechaDesde', fechaDesde);
                        if (fechaHasta) params.set('fechaHasta', fechaHasta);

                        if (panel === 'ejecuciones' && estatusId) {
                            params.set('estatusId', estatusId);
                        }

                        return params;
                    }

                    function urlPanel(panel, maquinaForzada = null) {
                        const btn = navButtons.find(x => x.dataset.productionPanel === panel);
                        const baseUrl = btn?.dataset.url;

                        if (!baseUrl) return null;

                        const params = parametrosFiltros(panel, maquinaForzada);
                        const query = params.toString();

                        return query ? `${baseUrl}?${query}` : baseUrl;
                    }

                    async function cargarPanel(panel, url = null, maquinaForzada = null) {
                        if (!contenidoProduccion) return;

                        const destino = url || urlPanel(panel, maquinaForzada);
                        if (!destino) return;

                        marcarPanelActivo(panel);

                        if (controladorCarga) {
                            controladorCarga.abort();
                        }

                        controladorCarga = new AbortController();

                        contenidoProduccion.innerHTML = `
                            <div class="panel-loading">
                                <div class="spinner-border" role="status" aria-hidden="true"></div>
                                <div>Cargando ${panel === 'cola' ? 'cola' : panel === 'proximos' ? 'próximos inicios' : 'ejecuciones'}...</div>
                            </div>`;

                        try {
                            const response = await fetch(destino, {
                                method: 'GET',
                                headers: {
                                    'X-Requested-With': 'XMLHttpRequest'
                                },
                                signal: controladorCarga.signal
                            });

                            if (response.status === 401) {
                                window.location.href = '@Url.Action("Login", "Login")';
                                return;
                            }

                            if (!response.ok) {
                                throw new Error(`HTTP ${response.status}`);
                            }

                            contenidoProduccion.innerHTML = await response.text();
                        }
                        catch (error) {
                            if (error?.name === 'AbortError') return;

                            console.error(error);

                            contenidoProduccion.innerHTML = `
                                <div class="panel-error">
                                    <i class="bi bi-exclamation-triangle"></i>
                                    <div>No fue posible cargar el panel de Producción.</div>
                                    <button type="button" class="btn btn-outline-primary btn-sm mt-3" id="btnReintentarPanel">
                                        <i class="bi bi-arrow-clockwise me-1"></i>
                                        Reintentar
                                    </button>
                                </div>`;
                        }
                    }

                    navButtons.forEach(btn => {
                        btn.addEventListener('click', () => {
                            cargarPanel(btn.dataset.productionPanel || 'proximos');
                        });
                    });

                    formFiltros?.addEventListener('submit', event => {
                        event.preventDefault();
                        cargarPanel(panelActivo);
                    });

                    document.addEventListener('click', event => {
                        const reintentar = event.target.closest('#btnReintentarPanel');
                        if (reintentar) {
                            cargarPanel(panelActivo);
                            return;
                        }

                        const linkPanel = event.target.closest('a.js-panel-produccion');
                        if (linkPanel && contenidoProduccion?.contains(linkPanel)) {
                            event.preventDefault();
                            cargarPanel('ejecuciones', linkPanel.href);
                            return;
                        }

                        const maquinaCola = event.target.closest('[data-panel-cola-maquina]');
                        if (maquinaCola && contenidoProduccion?.contains(maquinaCola)) {
                            const maquinaId = maquinaCola.getAttribute('data-panel-cola-maquina');
                            cargarPanel('cola', null, maquinaId);
                            return;
                        }

                        const btnInicio = event.target.closest('.btn-iniciar-preparacion');
                        if (!btnInicio) return;

                        const programaId = btnInicio.dataset.programaId || '';
                        const titulo = btnInicio.dataset.titulo || '';
                        const maquina = btnInicio.dataset.maquina || '';
                        const maquinaId = btnInicio.dataset.maquinaId || '';
                        const parteId = btnInicio.dataset.parteId || '';
                        const parte = btnInicio.dataset.parte || '';
                        const descripcion = btnInicio.dataset.descripcion || '';
                        const molde = btnInicio.dataset.molde || '';
                        const cantidad = btnInicio.dataset.cantidad || '';
                        const inicio = btnInicio.dataset.inicio || '';
                        const fin = btnInicio.dataset.fin || '';
                        const operadorId = btnInicio.dataset.operadorId || '';
                        const operadorNombre = btnInicio.dataset.operadorNombre || '';
                        const operadorAuxiliarId = btnInicio.dataset.operadorAuxiliarId || '';
                        const operadorAuxiliarNombre = btnInicio.dataset.operadorAuxiliarNombre || '';
                        const turno = btnInicio.dataset.turno || '';

                        if (modalProgramaProduccionId) modalProgramaProduccionId.value = programaId;
                        if (modalProgramaTexto) modalProgramaTexto.textContent = 'Programa ' + texto(programaId) + ' · ' + texto(titulo);
                        if (modalMaquinaTexto) modalMaquinaTexto.textContent = texto(maquina);
                        if (modalParteTexto) modalParteTexto.textContent = texto(parte);
                        if (modalDescripcionTexto) modalDescripcionTexto.textContent = texto(descripcion);
                        if (modalMoldeTexto) modalMoldeTexto.textContent = texto(molde);
                        if (modalCantidadTexto) modalCantidadTexto.textContent = texto(cantidad);
                        if (modalInicioTexto) modalInicioTexto.textContent = texto(inicio);
                        if (modalFinTexto) modalFinTexto.textContent = texto(fin);

                        if (modalObservaciones) modalObservaciones.value = '';
                        if (modalOperadorManual) modalOperadorManual.value = '';
                        if (modalOperadorNombre) modalOperadorNombre.value = '';
                        if (modalOperadorAuxiliarManual) modalOperadorAuxiliarManual.value = '';
                        if (modalOperadorAuxiliarNombre) modalOperadorAuxiliarNombre.value = '';
                        if (modalOperadorAuxiliarId) modalOperadorAuxiliarId.value = '';
                        limpiarValidacionOperadores();

                        const pudoSeleccionar = seleccionarPersonaSiExiste(modalOperadorId, operadorId);
                        const pudoSeleccionarAuxiliar = seleccionarPersonaSiExiste(modalOperadorAuxiliarId, operadorAuxiliarId);

                        if (operadorAuxiliarNombre && !pudoSeleccionarAuxiliar && modalOperadorAuxiliarManual) {
                            modalOperadorAuxiliarManual.value = operadorAuxiliarNombre;
                        }

                        if (operadorNombre) {
                            boxOperadorSugerido?.classList.remove('warn');

                            if (tituloOperadorSugerido) {
                                tituloOperadorSugerido.textContent = 'Operador principal sugerido desde RRHH';
                                tituloOperadorSugerido.className = 'operator-title';
                            }

                            if (detalleOperadorSugerido) {
                                detalleOperadorSugerido.textContent =
                                    operadorNombre +
                                    (turno ? ' · Turno: ' + turno : '') +
                                    (pudoSeleccionar ? '' : ' · No aparece en el catálogo, se puede capturar manual.');
                            }

                            if (!pudoSeleccionar && modalOperadorManual) {
                                modalOperadorManual.value = operadorNombre;
                            }
                        }
                        else {
                            boxOperadorSugerido?.classList.add('warn');

                            if (tituloOperadorSugerido) {
                                tituloOperadorSugerido.textContent = 'Sin operador sugerido';
                                tituloOperadorSugerido.className = 'operator-title warn';
                            }

                            if (detalleOperadorSugerido) {
                                detalleOperadorSugerido.textContent =
                                    'No hay operador principal sugerido en la escala RRHH para este horario. Debes seleccionar un operador del catálogo o capturar su nombre manual antes de iniciar.';
                            }
                        }

                        cargarOperadoresPolivalencia(
                            programaId,
                            parteId,
                            maquinaId,
                            operadorId,
                            operadorAuxiliarId);
                    });

                    modalOperadorId?.addEventListener('change', () => {
                        if (modalOperadorId.value && modalOperadorManual) modalOperadorManual.value = '';
                        sincronizarModoManual(modalOperadorId, modalOperadorManual);
                        limpiarValidacionOperadores();
                    });

                    modalOperadorManual?.addEventListener('input', () => {
                        if (modalOperadorManual.value.trim() && modalOperadorId) modalOperadorId.value = '';
                        sincronizarModoManual(modalOperadorId, modalOperadorManual);
                        limpiarValidacionOperadores();
                    });

                    modalOperadorAuxiliarId?.addEventListener('change', () => {
                        if (modalOperadorAuxiliarId.value && modalOperadorAuxiliarManual) modalOperadorAuxiliarManual.value = '';
                        sincronizarModoManual(modalOperadorAuxiliarId, modalOperadorAuxiliarManual, 'auxiliar');
                        limpiarValidacionOperadores();
                    });

                    modalOperadorAuxiliarManual?.addEventListener('input', () => {
                        if (modalOperadorAuxiliarManual.value.trim() && modalOperadorAuxiliarId) modalOperadorAuxiliarId.value = '';
                        sincronizarModoManual(modalOperadorAuxiliarId, modalOperadorAuxiliarManual, 'auxiliar');
                        limpiarValidacionOperadores();
                    });

                    formIniciarPreparacion?.addEventListener('submit', event => {
                        event.preventDefault();
                        limpiarValidacionOperadores();

                        const principalId = modalOperadorId?.value || '';
                        const principalManual = modalOperadorManual?.value.trim() || '';
                        const auxiliarId = modalOperadorAuxiliarId?.value || '';
                        const auxiliarManual = modalOperadorAuxiliarManual?.value.trim() || '';

                        if (!principalId && !principalManual) {
                            mostrarValidacionOperadores(
                                'Falta confirmar el operador principal. Selecciona un OPERADOR de la lista o captura su nombre manual antes de iniciar la preparación.',
                                [modalOperadorId, modalOperadorManual]);
                            return;
                        }

                        if (principalId && principalManual) {
                            mostrarValidacionOperadores(
                                'Para el operador principal usa solamente una opción: selección del catálogo o nombre manual.',
                                [modalOperadorId, modalOperadorManual]);
                            return;
                        }

                        if (auxiliarId && auxiliarManual) {
                            mostrarValidacionOperadores(
                                'Para el operador auxiliar usa solamente una opción: selección del catálogo o nombre manual.',
                                [modalOperadorAuxiliarId, modalOperadorAuxiliarManual]);
                            return;
                        }

                        const nombrePrincipal = principalId
                            ? obtenerTextoSeleccionado(modalOperadorId)
                            : principalManual;

                        const nombreAuxiliar = auxiliarId
                            ? obtenerTextoSeleccionado(modalOperadorAuxiliarId)
                            : auxiliarManual;

                        if (principalId && auxiliarId && principalId === auxiliarId) {
                            mostrarValidacionOperadores(
                                'El operador principal y el auxiliar no pueden ser la misma persona.',
                                [modalOperadorId, modalOperadorAuxiliarId]);
                            return;
                        }

                        if (nombrePrincipal && nombreAuxiliar &&
                            nombrePrincipal.localeCompare(nombreAuxiliar, 'es', { sensitivity: 'base' }) === 0) {
                            mostrarValidacionOperadores(
                                'El operador principal y el auxiliar no pueden tener el mismo nombre.',
                                [modalOperadorManual, modalOperadorAuxiliarManual]);
                            return;
                        }

                        if (modalOperadorNombre) modalOperadorNombre.value = nombrePrincipal;
                        if (modalOperadorAuxiliarNombre) modalOperadorAuxiliarNombre.value = nombreAuxiliar;

                        if (btnConfirmarInicio) {
                            btnConfirmarInicio.disabled = true;
                            btnConfirmarInicio.innerHTML = '<span class="spinner-border spinner-border-sm me-1"></span> Iniciando...';
                        }

                        formIniciarPreparacion.submit();
                    });

                    // Panel inicial: pendientes / próximos.
                    cargarPanel('proximos');
                })();
    </script>

    <script>
        (() => {
            const root = document.documentElement;

            function textoNormalizado(el) {
                return (el?.textContent || '')
                    .replace(/\s+/g, ' ')
                    .trim()
                    .toLowerCase();
            }

            function detectarTemaERP() {
                const html = document.documentElement;
                const body = document.body;

                const pistas = [
                    html.getAttribute('data-nsq-theme'),
                    html.getAttribute('data-theme'),
                    html.getAttribute('data-bs-theme'),
                    html.getAttribute('data-color-mode'),
                    html.className,
                    body?.getAttribute('data-nsq-theme'),
                    body?.getAttribute('data-theme'),
                    body?.getAttribute('data-bs-theme'),
                    body?.getAttribute('data-color-mode'),
                    body?.className
                ]
                    .filter(Boolean)
                    .join(' ')
                    .toLowerCase();

                if (/(^|\s|[-_])(dark|oscuro|night)(\s|$|[-_])/.test(pistas)) {
                    return 'dark';
                }

                if (/(^|\s|[-_])(light|claro)(\s|$|[-_])/.test(pistas)) {
                    return 'light';
                }

                // En el layout actual el botón muestra el modo al que puedes cambiar:
                // si dice "Claro", el ERP está actualmente en oscuro;
                // si dice "Oscuro", el ERP está actualmente en claro.
                const controles = Array.from(document.querySelectorAll('button, a, [role="button"]'));
                const switchTema = controles.find(el => {
                    const txt = textoNormalizado(el);
                    return txt === 'claro' || txt === 'oscuro' ||
                           txt.startsWith('claro ') || txt.startsWith('oscuro ');
                });

                if (switchTema) {
                    const txt = textoNormalizado(switchTema);
                    if (txt.startsWith('claro')) return 'dark';
                    if (txt.startsWith('oscuro')) return 'light';
                }

                return window.matchMedia?.('(prefers-color-scheme: dark)').matches
                    ? 'dark'
                    : 'light';
            }

            let temaActual = '';

            function sincronizarTemaProduccion() {
                const tema = detectarTemaERP();
                if (tema === temaActual) return;

                temaActual = tema;
                root.setAttribute('data-produccion-theme', tema);
            }

            sincronizarTemaProduccion();

            const observer = new MutationObserver(() => {
                window.requestAnimationFrame(sincronizarTemaProduccion);
            });

            observer.observe(document.documentElement, {
                attributes: true,
                attributeFilter: ['class', 'data-nsq-theme', 'data-theme', 'data-bs-theme', 'data-color-mode']
            });

            if (document.body) {
                observer.observe(document.body, {
                    attributes: true,
                    childList: true,
                    subtree: true,
                    attributeFilter: ['class', 'data-nsq-theme', 'data-theme', 'data-bs-theme', 'data-color-mode']
                });
            }

            document.addEventListener('click', () => {
                setTimeout(sincronizarTemaProduccion, 0);
                setTimeout(sincronizarTemaProduccion, 120);
                setTimeout(sincronizarTemaProduccion, 300);
            }, true);

            window.matchMedia?.('(prefers-color-scheme: dark)')
                .addEventListener?.('change', sincronizarTemaProduccion);
        })();
    </script>

}
