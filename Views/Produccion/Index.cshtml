            </div>
        </div>
    </div>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>

    <script>
        (() => {
            const contenidoProduccion = document.getElementById('contenidoProduccion');
            const formFiltros = document.getElementById('formFiltrosProduccion');
            const navButtons = Array.from(document.querySelectorAll('[data-production-panel]'));

            const modalProgramaProduccionId = document.getElementById('modalProgramaProduccionId');
            const modalProgramaTexto = document.getElementById('modalProgramaTexto');
            const modalMaquinaTexto = document.getElementById('modalMaquinaTexto');
            const modalParteTexto = document.getElementById('modalParteTexto');
            const modalDescripcionTexto = document.getElementById('modalDescripcionTexto');
            const modalMoldeTexto = document.getElementById('modalMoldeTexto');
            const modalCantidadTexto = document.getElementById('modalCantidadTexto');
            const modalInicioTexto = document.getElementById('modalInicioTexto');
            const modalFinTexto = document.getElementById('modalFinTexto');

            const boxOperadorSugerido = document.getElementById('boxOperadorSugerido');
            const tituloOperadorSugerido = document.getElementById('tituloOperadorSugerido');
            const detalleOperadorSugerido = document.getElementById('detalleOperadorSugerido');

            const modalOperadorId = document.getElementById('modalOperadorId');
            const modalOperadorNombre = document.getElementById('modalOperadorNombre');
            const modalOperadorManual = document.getElementById('modalOperadorManual');
            const modalObservaciones = document.getElementById('modalObservaciones');

            const formIniciarPreparacion = document.getElementById('formIniciarPreparacion');
            const btnConfirmarInicio = document.getElementById('btnConfirmarInicio');

            let panelActivo = 'ejecuciones';
            let controladorCarga = null;

            function texto(value) {
                if (!value || !value.trim()) return '-';
                return value.trim();
            }

            function seleccionarOperadorSiExiste(operadorId) {
                if (!modalOperadorId) return false;

                const id = operadorId || '';

                for (const option of modalOperadorId.options) {
                    if (option.value === id) {
                        modalOperadorId.value = id;
                        return true;
                    }
                }

                modalOperadorId.value = '';
                return false;
            }

            function obtenerTextoOperadorSeleccionado() {
                if (!modalOperadorId || !modalOperadorId.value) {
                    return '';
                }

                const selected = modalOperadorId.options[modalOperadorId.selectedIndex];
                return selected ? (selected.textContent || '').trim() : '';
            }

            function marcarPanelActivo(panel) {
                panelActivo = panel || 'ejecuciones';

                navButtons.forEach(btn => {
                    btn.classList.toggle(
                        'is-active',
                        btn.dataset.productionPanel === panelActivo);
                });
            }

            function parametrosFiltros(panel, maquinaForzada = null) {
                const params = new URLSearchParams();

                if (!formFiltros) {
                    if (maquinaForzada) params.set('maquinaId', maquinaForzada);
                    return params;
                }

                const data = new FormData(formFiltros);

                const busqueda = (data.get('busqueda') || '').toString().trim();
                const maquinaId = maquinaForzada ?? (data.get('maquinaId') || '').toString();
                const estatusId = (data.get('estatusId') || '').toString();
                const fechaDesde = (data.get('fechaDesde') || '').toString();
                const fechaHasta = (data.get('fechaHasta') || '').toString();

                if (busqueda) params.set('busqueda', busqueda);
                if (maquinaId) params.set('maquinaId', maquinaId);
                if (fechaDesde) params.set('fechaDesde', fechaDesde);
                if (fechaHasta) params.set('fechaHasta', fechaHasta);

                if (panel === 'ejecuciones' && estatusId) {
                    params.set('estatusId', estatusId);
                }

                return params;
            }

            function urlPanel(panel, maquinaForzada = null) {
                const btn = navButtons.find(x => x.dataset.productionPanel === panel);
                const baseUrl = btn?.dataset.url;

                if (!baseUrl) return null;

                const params = parametrosFiltros(panel, maquinaForzada);
                const query = params.toString();

                return query ? `${baseUrl}?${query}` : baseUrl;
            }

            async function cargarPanel(panel, url = null, maquinaForzada = null) {
                if (!contenidoProduccion) return;

                const destino = url || urlPanel(panel, maquinaForzada);
                if (!destino) return;

                marcarPanelActivo(panel);

                if (controladorCarga) {
                    controladorCarga.abort();
                }

                controladorCarga = new AbortController();

                contenidoProduccion.innerHTML = `
                    <div class="panel-loading">
                        <div class="spinner-border" role="status" aria-hidden="true"></div>
                        <div>Cargando ${panel === 'cola' ? 'cola' : panel === 'proximos' ? 'próximos inicios' : 'ejecuciones'}...</div>
                    </div>`;

                try {
                    const response = await fetch(destino, {
                        method: 'GET',
                        headers: {
                            'X-Requested-With': 'XMLHttpRequest'
                        },
                        signal: controladorCarga.signal
                    });

                    if (response.status === 401) {
                        window.location.href = '@Url.Action("Login", "Login")';
                        return;
                    }

                    if (!response.ok) {
                        throw new Error(`HTTP ${response.status}`);
                    }

                    contenidoProduccion.innerHTML = await response.text();
                }
                catch (error) {
                    if (error?.name === 'AbortError') return;

                    console.error(error);

                    contenidoProduccion.innerHTML = `
                        <div class="panel-error">
                            <i class="bi bi-exclamation-triangle"></i>
                            <div>No fue posible cargar el panel de Producción.</div>
                            <button type="button" class="btn btn-outline-primary btn-sm mt-3" id="btnReintentarPanel">
                                <i class="bi bi-arrow-clockwise me-1"></i>
                                Reintentar
                            </button>
                        </div>`;
                }
            }

            navButtons.forEach(btn => {
                btn.addEventListener('click', () => {
                    cargarPanel(btn.dataset.productionPanel || 'ejecuciones');
                });
            });

            formFiltros?.addEventListener('submit', event => {
                event.preventDefault();
                cargarPanel(panelActivo);
            });

            document.addEventListener('click', event => {
                const reintentar = event.target.closest('#btnReintentarPanel');
                if (reintentar) {
                    cargarPanel(panelActivo);
                    return;
                }

                const linkPanel = event.target.closest('a.js-panel-produccion');
                if (linkPanel && contenidoProduccion?.contains(linkPanel)) {
                    event.preventDefault();
                    cargarPanel('ejecuciones', linkPanel.href);
                    return;
                }

                const maquinaCola = event.target.closest('[data-panel-cola-maquina]');
                if (maquinaCola && contenidoProduccion?.contains(maquinaCola)) {
                    const maquinaId = maquinaCola.getAttribute('data-panel-cola-maquina');
                    cargarPanel('cola', null, maquinaId);
                    return;
                }

                const btnInicio = event.target.closest('.btn-iniciar-preparacion');
                if (!btnInicio) return;

                const programaId = btnInicio.dataset.programaId || '';
                const titulo = btnInicio.dataset.titulo || '';
                const maquina = btnInicio.dataset.maquina || '';
                const parte = btnInicio.dataset.parte || '';
                const descripcion = btnInicio.dataset.descripcion || '';
                const molde = btnInicio.dataset.molde || '';
                const cantidad = btnInicio.dataset.cantidad || '';
                const inicio = btnInicio.dataset.inicio || '';
                const fin = btnInicio.dataset.fin || '';
                const operadorId = btnInicio.dataset.operadorId || '';
                const operadorNombre = btnInicio.dataset.operadorNombre || '';
                const turno = btnInicio.dataset.turno || '';

                if (modalProgramaProduccionId) modalProgramaProduccionId.value = programaId;
                if (modalProgramaTexto) modalProgramaTexto.textContent = 'Programa ' + texto(programaId) + ' · ' + texto(titulo);
                if (modalMaquinaTexto) modalMaquinaTexto.textContent = texto(maquina);
                if (modalParteTexto) modalParteTexto.textContent = texto(parte);
                if (modalDescripcionTexto) modalDescripcionTexto.textContent = texto(descripcion);
                if (modalMoldeTexto) modalMoldeTexto.textContent = texto(molde);
                if (modalCantidadTexto) modalCantidadTexto.textContent = texto(cantidad);
                if (modalInicioTexto) modalInicioTexto.textContent = texto(inicio);
                if (modalFinTexto) modalFinTexto.textContent = texto(fin);

                if (modalObservaciones) modalObservaciones.value = '';
                if (modalOperadorManual) modalOperadorManual.value = '';
                if (modalOperadorNombre) modalOperadorNombre.value = '';

                const pudoSeleccionar = seleccionarOperadorSiExiste(operadorId);

                if (operadorNombre) {
                    boxOperadorSugerido?.classList.remove('warn');

                    if (tituloOperadorSugerido) {
                        tituloOperadorSugerido.textContent = 'Operador sugerido desde RRHH';
                        tituloOperadorSugerido.className = 'operator-title';
                    }

                    if (detalleOperadorSugerido) {
                        detalleOperadorSugerido.textContent =
                            operadorNombre +
                            (turno ? ' · Turno: ' + turno : '') +
                            (pudoSeleccionar ? '' : ' · No aparece en el catálogo, se puede capturar manual.');
                    }

                    if (!pudoSeleccionar && modalOperadorManual) {
                        modalOperadorManual.value = operadorNombre;
                    }
                }
                else {
                    boxOperadorSugerido?.classList.add('warn');

                    if (tituloOperadorSugerido) {
                        tituloOperadorSugerido.textContent = 'Sin operador sugerido';
                        tituloOperadorSugerido.className = 'operator-title warn';
                    }

                    if (detalleOperadorSugerido) {
                        detalleOperadorSugerido.textContent =
                            'No hay operador asignado en la escala RRHH para este horario. Puedes seleccionar uno manualmente o iniciar sin operador.';
                    }
                }
            });

            modalOperadorId?.addEventListener('change', () => {
                if (modalOperadorId.value && modalOperadorManual) {
                    modalOperadorManual.value = '';
                }
            });

            modalOperadorManual?.addEventListener('input', () => {
                if (modalOperadorManual.value.trim() && modalOperadorId) {
                    modalOperadorId.value = '';
                }
            });

            formIniciarPreparacion?.addEventListener('submit', () => {
                let nombreFinal = '';

                if (modalOperadorId?.value) {
                    nombreFinal = obtenerTextoOperadorSeleccionado();
                }
                else if (modalOperadorManual?.value.trim()) {
                    nombreFinal = modalOperadorManual.value.trim();
                }

                if (modalOperadorNombre) {
                    modalOperadorNombre.value = nombreFinal;
                }

                if (btnConfirmarInicio) {
                    btnConfirmarInicio.disabled = true;
                    btnConfirmarInicio.innerHTML =
                        '<span class="spinner-border spinner-border-sm me-1"></span> Iniciando...';
                }
            });

            // Panel inicial: ejecuciones activas.
            cargarPanel('ejecuciones');
        })();
    </script>
</body>
</html>
