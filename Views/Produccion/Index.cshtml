            place-items: center;
            background: #fff;
            border: 1px solid #bfd3f2;
            font-size: .7rem;
            font-weight: 950;
        }

        .production-content-shell {
            min-height: 260px;
        }

        .panel-loading,
        .panel-error {
            border: 1px solid var(--borde);
            border-radius: 18px;
            background: #fff;
            padding: 52px 20px;
            text-align: center;
            color: var(--muted);
            font-weight: 750;
        }

            .panel-loading .spinner-border {
                width: 2rem;
                height: 2rem;
                margin-bottom: 10px;
                color: var(--azul);
            }

            .panel-error i {
                display: block;
                margin-bottom: 8px;
                color: var(--danger);
                font-size: 2rem;
            }

        @@media (max-width: 700px) {
            .production-nav {
                flex-wrap: nowrap;
                overflow-x: auto;
            }

            .production-nav-btn {
                flex: 0 0 auto;
            }
        }


        /* =========================================================
                   AJUSTE VISUAL AMIGABLE - PRODUCCION
                   Mantiene la estructura y la logica original.
                   ========================================================= */

        body {
            background: radial-gradient(circle at 12% 2%, rgba(25, 76, 155, .055), transparent 27%), var(--bg);
        }

        .page {
            max-width: 1680px;
            padding: 24px 28px 34px;
        }

        .topbar {
            border: 0;
            border-radius: 20px;
            padding: 22px 24px;
            margin-bottom: 18px;
            background: linear-gradient(135deg, #123a75 0%, #1d5cac 100%);
            box-shadow: 0 12px 28px rgba(15, 47, 99, .14);
        }

        .topbar-title {
            font-size: 1.7rem;
            letter-spacing: -.025em;
        }

        .topbar-sub {
            margin-top: 6px;
            font-size: .9rem;
            max-width: 720px;
        }

        .topbar .text-end {
            min-width: 154px;
            padding: 9px 13px;
            border: 1px solid rgba(255,255,255,.18);
            border-radius: 14px;
            background: rgba(255,255,255,.09);
        }

        .summary-strip {
            display: grid;
            grid-template-columns: repeat(8, minmax(105px, 1fr));
            gap: 10px;
            margin-bottom: 18px;
        }

        .summary-item {
            min-height: 72px;
            display: flex;
            flex-direction: column;
            align-items: flex-start;
            justify-content: center;
            gap: 2px;
            padding: 12px 14px;
            border: 1px solid #d8e2ef;
            border-radius: 15px;
            background: rgba(255,255,255,.96);
            color: #123a75;
            font-size: 1.25rem;
            line-height: 1;
            box-shadow: 0 5px 16px rgba(16, 42, 78, .055);
            transition: transform .16s ease, box-shadow .16s ease, border-color .16s ease;
        }

            .summary-item:hover {
                transform: translateY(-2px);
                border-color: #b7cce7;
                box-shadow: 0 9px 22px rgba(16, 42, 78, .085);
            }

            .summary-item span {
                margin-top: 5px;
                font-size: .72rem;
                line-height: 1.2;
                color: #667085;
                text-transform: none;
                letter-spacing: 0;
            }

            .summary-item:nth-child(3),
            .summary-item:nth-child(4),
            .summary-item:nth-child(5) {
                border-top: 3px solid #f2b84b;
            }

            .summary-item:nth-child(6) {
                border-top: 3px solid #3b82f6;
            }

            .summary-item:nth-child(7) {
                border-top: 3px solid #ef8f8f;
            }

            .summary-item:nth-child(8) {
                border-top: 3px solid #55b987;
            }

        .section {
            border-color: #d9e3ef;
            border-radius: 18px;
            margin-bottom: 16px;
            box-shadow: 0 7px 22px rgba(16, 42, 78, .045);
        }

        .section-head {
            padding: 15px 18px;
            background: linear-gradient(180deg, #fbfdff, #f6f9fd);
        }

        .section-title {
            font-size: 1.04rem;
        }

        .section-sub {
            margin-top: 4px;
            font-size: .84rem;
        }

        .filters {
            padding: 18px;
        }

            .filters .row {
                --bs-gutter-x: 14px;
                --bs-gutter-y: 13px;
            }

        .form-label {
            margin-bottom: 7px;
            color: #475467;
            font-size: .73rem;
        }

        .form-control,
        .form-select {
            min-height: 46px;
            border-color: #d4deeb;
            border-radius: 12px;
            background-color: #fbfdff;
            font-size: .9rem;
        }

            .form-control:hover,
            .form-select:hover {
                border-color: #adc4e1;
            }

        .btn-action {
            min-height: 46px;
            border-radius: 12px;
            font-weight: 850;
            transition: transform .15s ease, box-shadow .15s ease;
        }

            .btn-action:hover {
                transform: translateY(-1px);
            }

        #formFiltrosProduccion .btn-primary {
            box-shadow: 0 6px 14px rgba(0, 74, 173, .18);
        }

        .production-nav {
            display: grid;
            grid-template-columns: repeat(3, minmax(0, 1fr));
            gap: 10px;
            padding: 8px;
            margin-bottom: 16px;
            border: 1px solid #d9e3ef;
            border-radius: 17px;
            background: rgba(255,255,255,.92);
            box-shadow: 0 6px 20px rgba(16, 42, 78, .04);
        }

        .production-nav-btn {
            min-height: 52px;
            justify-content: center;
            border: 1px solid #d8e2ef;
            border-radius: 12px;
            background: #fff;
            color: #526071;
            font-size: .88rem;
            font-weight: 850;
            transition: background .16s ease, border-color .16s ease, color .16s ease, transform .16s ease, box-shadow .16s ease;
        }

            .production-nav-btn:hover {
                transform: translateY(-1px);
                box-shadow: 0 6px 14px rgba(16, 42, 78, .08);
            }

            /* Pendientes / próximos: ámbar */
            .production-nav-btn[data-production-panel="proximos"] {
                border-color: #f2d9aa;
                background: #fffaf1;
                color: #8a5705;
            }

                .production-nav-btn[data-production-panel="proximos"]:hover {
                    border-color: #efbd60;
                    background: #fff4dc;
                    color: #744600;
                }

                .production-nav-btn[data-production-panel="proximos"].is-active {
                    border-color: #e9ad3d;
                    background: linear-gradient(180deg, #fff4d8 0%, #ffe9b5 100%);
                    color: #744600;
                    box-shadow: 0 6px 14px rgba(191, 126, 18, .12);
                }

            /* En ejecución: azul */
            .production-nav-btn[data-production-panel="ejecuciones"] {
                border-color: #c8d9f2;
                background: #f7faff;
                color: #245b9f;
            }

                .production-nav-btn[data-production-panel="ejecuciones"]:hover {
                    border-color: #8fb7e9;
                    background: #edf5ff;
                    color: #0f4e9a;
                }

                .production-nav-btn[data-production-panel="ejecuciones"].is-active {
                    border-color: #75a8e3;
                    background: linear-gradient(180deg, #eaf4ff 0%, #dcecff 100%);
                    color: #0f4e9a;
                    box-shadow: 0 6px 14px rgba(25, 76, 155, .12);
                }

            /* Cola: índigo suave */
            .production-nav-btn[data-production-panel="cola"] {
                border-color: #d8d2ee;
                background: #fbfaff;
                color: #65558e;
            }

                .production-nav-btn[data-production-panel="cola"]:hover {
                    border-color: #b8a9df;
                    background: #f3efff;
                    color: #51417f;
                }

                .production-nav-btn[data-production-panel="cola"].is-active {
                    border-color: #a794d8;
                    background: linear-gradient(180deg, #f2edff 0%, #e8e0ff 100%);
                    color: #51417f;
                    box-shadow: 0 6px 14px rgba(94, 72, 151, .12);
                }

        .production-nav-count {
            min-width: 26px;
            height: 26px;
            padding: 0 7px;
            display: inline-flex;
            align-items: center;
            justify-content: center;
            border-radius: 999px;
            background: rgba(255,255,255,.92);
            border: 1px solid currentColor;
            font-size: .75rem;
            line-height: 1;
        }

        .production-content-shell {
            min-height: 180px;
            border-color: #d9e3ef;
            border-radius: 18px;
            box-shadow: 0 8px 24px rgba(16, 42, 78, .045);
        }

        .panel-loading {
            min-height: 176px;
        }

        .alerts-floating-button {
            width: 58px;
            height: 58px;
            box-shadow: 0 10px 24px rgba(15, 47, 99, .2);
        }

        @@media (max-width: 1280px) {
            .summary-strip {
                grid-template-columns: repeat(4, minmax(120px, 1fr));
            }
        }

        @@media (max-width: 768px) {
            .page {
                padding: 14px;
            }

            .topbar {
                padding: 18px;
                border-radius: 17px;
            }

            .summary-strip {
                grid-template-columns: repeat(2, minmax(0, 1fr));
            }

            .summary-item {
                min-height: 68px;
            }

            .production-nav {
                grid-template-columns: 1fr;
            }

            .production-nav-btn {
                justify-content: flex-start;
                padding-left: 16px;
            }
        }


        /* =========================================================
                   REFINAMIENTO PROFESIONAL - PRODUCCION
                   Ajustes de jerarquia, espaciado y consistencia visual.
                   ========================================================= */

        .page {
            max-width: 1660px;
            padding-top: 22px;
        }

        .topbar {
            margin-bottom: 16px;
            border: 1px solid rgba(255,255,255,.08);
            box-shadow: 0 10px 26px rgba(15, 47, 99, .12);
        }

        .topbar-title {
            font-size: 1.58rem;
        }

        .topbar-sub {
            color: rgba(255,255,255,.78);
            font-size: .86rem;
        }

        .section.production-filters {
            overflow: visible;
            margin-bottom: 14px;
            border-color: #d8e2ef;
            box-shadow: 0 5px 16px rgba(16, 42, 78, .04);
        }

        .production-filters .section-head {
            position: relative;
            padding: 14px 17px;
            border-bottom-color: #dde6f0;
            background: #fbfcfe;
        }

            .production-filters .section-head::before {
                content: "";
