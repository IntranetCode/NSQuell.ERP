@model ERP.NSQuell.Models.ProduccionDetalleVm

@{
    Layout = "_Layout";
    var e = Model.Ejecucion;
    var monitoreoTurno = Model.MonitoreoTurnoActual;
    var cambioTurnoTecnico = Model.CambioTurnoTecnico;
    var esReinicioSerie = ViewBag.EsReinicioSerie is bool reinicio && reinicio;
    var puedeGestionarCajas = ViewBag.PuedeGestionarCajas is bool gestionarCajas && gestionarCajas;
    var puedeVerCapturasHora = ViewBag.PuedeVerCapturasHora is bool verCapturasHora && verCapturasHora;
    var puedeCorregirCapturasHora = ViewBag.PuedeCorregirCapturasHora is bool corregirCapturasHora && corregirCapturasHora;
    var ejecucionPermiteCorregirCapturas = e.EstatusID == ERP.NSQuell.Models.ProduccionEstatus.EnProduccion || e.EstatusID == ERP.NSQuell.Models.ProduccionEstatus.Pausado || e.EstatusID == ERP.NSQuell.Models.ProduccionEstatus.TerminadoParcial;
    var puedeCorregirCapturasAhora = puedeCorregirCapturasHora && ejecucionPermiteCorregirCapturas;
    var puedeGestionarSugerenciaCambioTurno = ViewBag.PuedeGestionarSugerenciaCambioTurno is bool gestionarSugerenciaTurno && gestionarSugerenciaTurno;
    var puedeGestionarConfiguracionCorrida = ViewBag.PuedeGestionarConfiguracionCorrida is bool gestionarConfiguracionCorrida && gestionarConfiguracionCorrida;
    var puedeGestionarChecklistArranque = ViewBag.PuedeGestionarChecklistArranque is bool gestionarChecklistArranque && gestionarChecklistArranque;
    var puedeGestionarMonitoreoPerifericos = ViewBag.PuedeGestionarMonitoreoPerifericos is bool gestionarMonitoreoPerifericos && gestionarMonitoreoPerifericos;
    var workspaceProduccion = (ViewBag.WorkspaceProduccion as string ?? "CONSULTA").Trim().ToUpperInvariant();
    var puedeVerCapturasEnDetalle = puedeVerCapturasHora && (workspaceProduccion == "AUXILIAR" || workspaceProduccion == "SUPERVISION");
    var terminarParcialAutorizado = ViewBag.TerminarParcialAutorizado is bool parcialAutorizado && parcialAutorizado;
    var puedeEjecutarTerminacionParcial = ViewBag.PuedeEjecutarTerminacionParcial is bool ejecutarParcial && ejecutarParcial;
    var motivoTerminacionParcial = ViewBag.TerminarParcialMotivo as string;
    var fechaAutorizacionTerminacionParcial = ViewBag.TerminarParcialFechaAutorizacion as DateTime?;
    var faltantesOk = Math.Max(0, (e.CantidadPlaneada ?? 0) - e.CantidadOKTotal);
    var metaOkCumplida = faltantesOk == 0;
    var configuracionTiempoReal = Model.ConfiguracionTiempoReal;
    var configuracionActual = configuracionTiempoReal?.ConfiguracionActual;
    var tieneConfiguracionCorrida = configuracionActual?.EstaVigente == true;

    var cavidadesReferencia = configuracionActual?.CavidadesUsadas ?? configuracionTiempoReal?.CavidadesBD;
    var cicloReferencia = configuracionActual?.TiempoCicloSegundos ?? configuracionTiempoReal?.TiempoCicloBD;

    decimal? objetivoReferencia = null;

    if (cavidadesReferencia.HasValue &&
        cavidadesReferencia.Value > 0 &&
        cicloReferencia.HasValue &&
        cicloReferencia.Value > 0)
    {
        objetivoReferencia =
            (3600m / cicloReferencia.Value) *
            cavidadesReferencia.Value;
    }

    var horaInicio = new TimeSpan(DateTime.Now.Hour, 0, 0);
    var horaFin = horaInicio.Add(TimeSpan.FromHours(1));

    if (horaFin.TotalHours >= 24)
    {
        horaFin = new TimeSpan(23, 59, 0);
    }

    var avancePct = e.PorcentajeAvance;

    if (avancePct < 0)
    {
        avancePct = 0;
    }

    if (avancePct > 100)
    {
        avancePct = 100;
    }

    var esPreparacion =
        e.EstatusID == ERP.NSQuell.Models.ProduccionEstatus.EnPreparacion;

    var esProduccion =
        e.EstatusID == ERP.NSQuell.Models.ProduccionEstatus.EnProduccion;

    var calidadRequiereAtencion =
        Model.CalidadResumen == null ||
        !string.IsNullOrWhiteSpace(Model.CalidadResumen.MotivoDevolucion) ||
        Model.CalidadResumen.ConfiguracionInvalidada ||
        (esPreparacion && Model.CalidadResumen.PuedeIniciarSerie != true);

    var accionActual = "SEGUIMIENTO";

    if (terminarParcialAutorizado && puedeEjecutarTerminacionParcial && e.PuedeTerminar)
    {
        accionActual = "TERMINAR";
    }
    else if (Model.TieneParoAbierto)
    {
        accionActual = "CERRAR_PARO";
    }
    else if (puedeGestionarMonitoreoPerifericos && Model.MostrarAvisoMonitoreoTurno && monitoreoTurno != null)
    {
        accionActual = "MONITOREO_TURNO";
    }
    else if (puedeGestionarChecklistArranque && Model.ChecklistResumen == null)
    {
        accionActual = "GENERAR_CHECKLIST";
    }
    else if (esPreparacion && puedeGestionarConfiguracionCorrida && !tieneConfiguracionCorrida)
    {
        accionActual = "CONFIGURAR_CORRIDA";
    }
    else if (esPreparacion && Model.CalidadResumen?.PuedeIniciarSerie != true)
    {
        accionActual = "ESPERAR_CALIDAD";
    }
    else if (esPreparacion)
    {
        accionActual = esReinicioSerie ? "REINICIAR_SERIE" : "INICIAR_SERIE";
    }
    else if (e.PuedeTerminar && !Model.TieneParoAbierto)
    {
        accionActual = "TERMINAR";
    }

    var accionDestino = accionActual switch
    {
        "CERRAR_PARO" => "#panelParo",
        "MONITOREO_TURNO" => "#panelMonitoreoTurno",
        "GENERAR_CHECKLIST" => "#panelChecklist",
        "CONFIGURAR_CORRIDA" => "#panelConfiguracionCorrida",
        "ESPERAR_CALIDAD" => "#panelCalidad",
        "INICIAR_SERIE" => "#panelIniciarSerie",
        "REINICIAR_SERIE" => "#panelIniciarSerie",
        "TERMINAR" => "#panelTerminar",
        _ => puedeVerCapturasEnDetalle ? "#panelCapturas" : "#panelDatosEjecucion"
    };

    var textoContextoPuesto = workspaceProduccion switch
    {
        "SUPERVISION" => "Supervisión de Producción",
        "TECNICO" => "Técnico de Producción",
        "SMED" => "SMED / Preparación",
        "AUXILIAR" => "Auxiliar de Producción",
        _ => "Consulta"
    };

    ViewData["AccionActualProduccion"] = accionActual;

    var cortesTiempoExtra = Model.RegistrosHora.Count(x => x.EsTiempoExtra);
    var minutosTiempoExtra = Model.RegistrosHora
        .Where(x => x.EsTiempoExtra)
        .Sum(x => x.MinutosProductivos ?? 0m);
    var piezasFisicasTiempoExtra = Model.RegistrosHora
        .Where(x => x.EsTiempoExtra)
        .Sum(x => x.PiezasCalculadasContador ?? x.TotalCapturado);
}

@functions {
    public static string Txt(string? value)
    {
        return string.IsNullOrWhiteSpace(value) ? "-" : value.Trim();
    }

    public static string Fecha(DateTime? value)
    {
        return value.HasValue ? value.Value.ToString("dd/MM/yyyy HH:mm") : "-";
    }


    public static string Dec4(decimal? value)
    {
        return value.HasValue ? value.Value.ToString("N4") : "-";
    }

    public static string TipoClase(string? tipo)
    {
        if (string.Equals(tipo, "MP", StringComparison.OrdinalIgnoreCase))
            return "badge bg-primary";

        if (string.Equals(tipo, "COMPONENTE", StringComparison.OrdinalIgnoreCase))
            return "badge bg-info text-dark";

        if (string.Equals(tipo, "EMBALAJE", StringComparison.OrdinalIgnoreCase))
            return "badge bg-success";

        if (string.Equals(tipo, "ETIQUETA", StringComparison.OrdinalIgnoreCase))
            return "badge bg-warning text-dark";

        return "badge bg-secondary";
    }
}

