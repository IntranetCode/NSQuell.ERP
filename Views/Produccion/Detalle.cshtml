        html[data-nsq-theme="dark"] .segment-card,
        html[data-nsq-theme="dark"] .capture-history,
        html[data-nsq-theme="dark"] .capture-history-value,
        html[data-nsq-theme="dark"] .adjust-summary,
        html[data-nsq-theme="dark"] .adjust-summary-item {
            background: #101a2b;
            border-color: #2d3e55;
            color: #dce7f6;
        }

        html[data-nsq-theme="dark"] .capture-history-item {
            border-bottom-color: #2d3e55;
        }

        html[data-nsq-theme="dark"] .capture-history-motive,
        html[data-nsq-theme="dark"] .adjust-summary-label {
            color: #9aa9bd;
        }

        html[data-nsq-theme="dark"] .adjust-summary-value {
            color: #eaf2ff;
        }

        html[data-nsq-theme="dark"] .capture-adjusted-badge {
            background: #2b2313;
            color: #f6cc6d;
            border-color: #76571e;
        }

        html[data-nsq-theme="dark"] .adjust-preview {
            background: #17345c;
            border-color: #28598b;
            color: #9dcaff;
        }

            html[data-nsq-theme="dark"] .adjust-preview.is-invalid {
                background: #351719;
                border-color: #7f2b32;
                color: #ff9aa5;
            }

            html[data-nsq-theme="dark"] .adjust-preview.is-valid {
                background: #102a20;
                border-color: #286446;
                color: #79e3a8;
            }

        html[data-nsq-theme="dark"] .capture-type {
            background: #17345c;
            color: #9dcaff;
        }

            html[data-nsq-theme="dark"] .capture-type.extra {
                background: #2d2148;
                color: #c4b5fd;
            }
    </style>
</head>

<body>
    <div class="page-shell">

        <div class="hero mb-4">
            <div class="d-flex flex-wrap align-items-center justify-content-between gap-3">
                <div>
                    <h1 class="hero-title">
                        <i class="bi bi-gear-wide-connected me-2"></i>
                        Producción - Programa @e.ProgramaProduccionID
                    </h1>
                    <div class="hero-subtitle">
                        @e.TituloPrograma · @e.TextoMaquina
                    </div>
                </div>

                <div class="d-flex flex-wrap align-items-center gap-2">
                    <span class="badge @e.EstatusClase fs-6">
                        @e.EstatusNombre
                    </span>

                    @if (puedeGestionarCajas)
                    {
                        <a href="@Url.Action("Cajas", "Produccion", new { id = e.EjecucionProduccionID })"
                           class="btn btn-warning fw-bold">
                            <i class="bi bi-box-seam me-1"></i>
                            Gestión de cajas
                        </a>
                    }

                    <a href="@Url.Action("Index", "Produccion")" class="btn btn-light fw-bold">
                        <i class="bi bi-arrow-left me-1"></i>
                        Volver
                    </a>
                </div>
            </div>
        </div>

        @if (TempData["Success"] != null)
        {
            <div class="alert alert-success alert-dismissible fade show">
                <i class="bi bi-check-circle me-1"></i>
                @TempData["Success"]
                <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
            </div>
        }

        @if (TempData["Error"] != null)
        {
            <div class="alert alert-danger alert-dismissible fade show">
                <i class="bi bi-exclamation-triangle me-1"></i>
                @TempData["Error"]
                <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
            </div>
        }

        @if (TempData["Info"] != null)
        {
            <div class="alert alert-info alert-dismissible fade show">
                <i class="bi bi-info-circle me-1"></i>
                @TempData["Info"]
                <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
            </div>
        }

        <div class="row g-3 mb-4">
            <div class="col-6 col-lg">
                <div class="metric-card">
                    <div class="metric-label">Planeado</div>
                    <div class="metric-value">@(e.CantidadPlaneada?.ToString("N0") ?? "-")</div>
                </div>
            </div>

            <div class="col-6 col-lg">
                <div class="metric-card">
                    <div class="metric-label">Verdes / OK</div>
                    <div class="metric-value text-success">@Model.TotalOK.ToString("N0")</div>
                </div>
            </div>

            <div class="col-6 col-lg">
                <div class="metric-card">
                    <div class="metric-label">Rojas / Scrap</div>
                    <div class="metric-value text-danger">@Model.TotalScrap.ToString("N0")</div>
                </div>
            </div>

            <div class="col-6 col-lg">
                <div class="metric-card">
                    <div class="metric-label">Pendiente</div>
                    <div class="metric-value">@e.CantidadPendiente.ToString("N0")</div>
                </div>
            </div>

            <div class="col-6 col-lg">
                <div class="metric-card">
                    <div class="metric-label">Avance</div>
                    <div class="metric-value">@e.PorcentajeAvance.ToString("0.##")%</div>
                </div>
            </div>
        </div>

        <div class="panel mb-4">
            <div class="panel-body">
                <div class="d-flex justify-content-between small mb-1">
                    <span class="fw-bold text-primary">Avance de producción</span>
                    <span>@e.PorcentajeAvance.ToString("0.##")%</span>
                </div>
                <div class="progress">
                    <div class="progress-bar"
                         style="width:@avancePct.ToString("0.##", System.Globalization.CultureInfo.InvariantCulture)%">
                    </div>
                </div>
            </div>
        </div>

        <section class="smart-workspace mb-4" id="smartWorkspace" data-smart-workspace data-priority-target="@accionDestino">
            <div class="smart-toolbar">
                <div>
                    <div class="smart-toolbar-title">
                        <i class="bi bi-stars me-1"></i>
                        Centro de trabajo inteligente
                    </div>
                    <div class="smart-toolbar-subtitle">
                        Vista adaptada a @textoContextoPuesto · solo se abre primero lo que requiere atención.
                    </div>
                </div>
                <div class="smart-status-row">
                    @if (Model.TieneParoAbierto)
                    {
                        <span class="smart-chip danger"><i class="bi bi-pause-circle"></i>Paro abierto</span>
                    }
                    @if (!tieneConfiguracionCorrida && esPreparacion)
                    {
                        <span class="smart-chip warning"><i class="bi bi-sliders"></i>Configuración pendiente</span>
                    }
                    @if (Model.CalidadResumen?.PuedeIniciarSerie == true)
                    {
                        <span class="smart-chip success"><i class="bi bi-patch-check"></i>Calidad liberó</span>
                    }
                    else if (calidadRequiereAtencion && esPreparacion)
                    {
                        <span class="smart-chip warning"><i class="bi bi-patch-exclamation"></i>Calidad pendiente</span>
                    }
                    @if (e.MaquinaLiberada)
                    {
                        <span class="smart-chip success"><i class="bi bi-unlock"></i>Máquina liberada</span>
                    }
                    @if (cortesTiempoExtra > 0)
                    {
                        <span class="smart-chip"><i class="bi bi-stopwatch"></i>@cortesTiempoExtra corte(s) extra · @minutosTiempoExtra.ToString("0.#") min · @piezasFisicasTiempoExtra.ToString("N0") pzas</span>
                    }
                </div>
            </div>

            <section class="next-action mb-4 @(accionActual == "CERRAR_PARO" ? "is-danger" : accionActual == "MONITOREO_TURNO" || accionActual == "ESPERAR_CALIDAD" || accionActual == "CONFIGURAR_CORRIDA" ? "is-warning" : accionActual == "INICIAR_SERIE" || accionActual == "REINICIAR_SERIE" || accionActual == "TERMINAR" ? "is-success" : "")">
                <div class="d-flex flex-wrap align-items-center justify-content-between gap-3">
                    <div class="d-flex align-items-start gap-3">
                        <div class="next-action-icon">
                            <i class="bi @(accionActual == "CERRAR_PARO" ? "bi-pause-circle" : accionActual == "MONITOREO_TURNO" ? "bi-arrow-repeat" : accionActual == "GENERAR_CHECKLIST" ? "bi-clipboard-check" : accionActual == "CONFIGURAR_CORRIDA" ? "bi-sliders" : accionActual == "ESPERAR_CALIDAD" ? "bi-hourglass-split" : accionActual == "INICIAR_SERIE" || accionActual == "REINICIAR_SERIE" ? "bi-play-fill" : accionActual == "TERMINAR" ? "bi-flag" : "bi-activity")"></i>
                        </div>
                        <div>
                            <div class="data-label">Acción requerida ahora</div>

                            @if (accionActual == "CERRAR_PARO")
                            {
                                <h2 class="next-action-title">Cerrar el paro antes de continuar</h2>
                                <p class="next-action-text">La ejecución permanece detenida mientras exista un paro abierto.</p>
                            }
                            else if (accionActual == "MONITOREO_TURNO")
                            {
                                <h2 class="next-action-title">Completar el monitoreo del turno</h2>
                                <p class="next-action-text">Registra las verificaciones de periféricos y la entrega-recepción del turno actual.</p>
                            }
                            else if (accionActual == "GENERAR_CHECKLIST")
                            {
                                <h2 class="next-action-title">Generar el checklist de arranque</h2>
                                <p class="next-action-text">La preparación debe documentarse antes de enviar la corrida a Calidad.</p>
                            }
                            else if (accionActual == "CONFIGURAR_CORRIDA")
                            {
                                <h2 class="next-action-title">Confirmar configuración real de la corrida</h2>
                                <p class="next-action-text">El técnico debe confirmar cavidades, ciclo y contador base. Si no modifica cavidades o ciclo, se conservarán los valores de referencia disponibles en BD.</p>
                            }
                            else if (accionActual == "ESPERAR_CALIDAD")
                            {
                                <h2 class="next-action-title">Atender o esperar la liberación de Calidad</h2>
                                <p class="next-action-text">La producción en serie permanece bloqueada hasta recibir etiqueta verde.</p>
                            }
                            else if (accionActual == "REINICIAR_SERIE")
                            {
                                <h2 class="next-action-title">Reiniciar producción en serie</h2>
                                <p class="next-action-text">Calidad autorizó la reliberación. Confirma el reinicio real para reanudar las capturas horarias desde este momento.</p>
                            }
                            else if (accionActual == "INICIAR_SERIE")
                            {
                                <h2 class="next-action-title">Iniciar producción en serie</h2>
                                <p class="next-action-text">La preparación está lista y Calidad ya permite continuar.</p>
                            }
                            else if (accionActual == "TERMINAR")
                            {
                                <h2 class="next-action-title">Revisar y terminar la producción</h2>
                                <p class="next-action-text">La ejecución está en condiciones de pasar al cierre de producción.</p>
                            }
                            else
                            {
                                <h2 class="next-action-title">Continuar seguimiento de la ejecución</h2>
                                <p class="next-action-text">Revisa capturas, materiales y paros conforme avance el turno.</p>
                            }
                        </div>
                    </div>

                    <a class="btn btn-primary btn-strong"
                       href="#@(accionActual == "CERRAR_PARO" ? "panelParo" : accionActual == "MONITOREO_TURNO" ? "panelMonitoreoTurno" : accionActual == "GENERAR_CHECKLIST" ? "panelChecklist" : accionActual == "CONFIGURAR_CORRIDA" ? "panelConfiguracionCorrida" : accionActual == "ESPERAR_CALIDAD" ? "panelCalidad" : accionActual == "INICIAR_SERIE" || accionActual == "REINICIAR_SERIE" ? "panelIniciarSerie" : accionActual == "TERMINAR" ? "panelTerminar" : "panelCapturas")"
                       data-open-target data-smart-priority-link>
                        <i class="bi @(accionActual == "INICIAR_SERIE" || accionActual == "REINICIAR_SERIE" ? "bi-play-circle" : "bi-arrow-down-circle") me-1"></i>
                        @(accionActual == "CONFIGURAR_CORRIDA" ? "Configurar corrida" : accionActual == "REINICIAR_SERIE" ? "Reiniciar ahora" : accionActual == "INICIAR_SERIE" ? "Iniciar ahora" : "Ir a la acción")
                    </a>
                </div>
            </section>

            <div id="zonaPrioritaria" class="smart-priority-zone"></div>

            <div class="smart-section-label">
                <span><i class="bi bi-grid me-1"></i>Accesos rápidos</span>
                <span>El resto permanece plegado</span>
            </div>

            <div class="smart-quick-actions">
                <button type="button" class="smart-quick-btn" data-smart-open="#panelDatosEjecucion"><i class="bi bi-info-circle me-1"></i>Datos</button>
                @if (configuracionTiempoReal != null)
                {
                    <button type="button" class="smart-quick-btn" data-smart-open="#panelConfiguracionCorrida"><i class="bi bi-sliders me-1"></i>Configuración</button>
                }
                <button type="button" class="smart-quick-btn" data-smart-open="#panelChecklist"><i class="bi bi-clipboard-check me-1"></i>Checklist</button>
                <button type="button" class="smart-quick-btn" data-smart-open="#panelCalidad"><i class="bi bi-patch-check me-1"></i>Calidad</button>
                @if (monitoreoTurno != null)
                {
                    <button type="button" class="smart-quick-btn" data-smart-open="#panelMonitoreoTurno"><i class="bi bi-cpu me-1"></i>Turno</button>
                }
                @if (e.PuedePausar || Model.TieneParoAbierto)
                {
                    <button type="button" class="smart-quick-btn" data-smart-open="#panelParo"><i class="bi bi-pause-circle me-1"></i>Paros</button>
                }
                @if (puedeVerCapturasHora)
                {
                    <button type="button" class="smart-quick-btn" data-smart-open="#panelCapturas"><i class="bi bi-clock-history me-1"></i>Capturas</button>
                }
                <button type="button" class="smart-quick-btn" data-smart-open="#panelMateriales"><i class="bi bi-box-seam me-1"></i>Materiales</button>
                <button type="button" class="smart-quick-btn" data-smart-open="#panelHistorialParos"><i class="bi bi-clock-history me-1"></i>Historial paros</button>
                @if (puedeGestionarCajas)
                {
                    <a class="smart-quick-btn text-decoration-none" href="@Url.Action("Cajas", "Produccion", new { id = e.EjecucionProduccionID })"><i class="bi bi-boxes me-1"></i>Cajas</a>
                }
            </div>
            <div class="smart-help">
                <i class="bi bi-lightning-charge me-1"></i>
                Cuando cambia el estado de la ejecución, el bloque necesario se mueve automáticamente a esta zona y se abre. No tienes que buscarlo más abajo.
            </div>
        </section>

        @if (esProduccion || e.MaquinaLiberada)
        {
            <section class="machine-release-card mb-4 @(e.MaquinaLiberada ? "is-released" : Model.TieneParoAbierto ? "is-blocked" : "")" id="panelLiberarMaquina">
                <div class="d-flex flex-wrap align-items-center justify-content-between gap-3">
                    <div class="d-flex align-items-start gap-3 flex-grow-1">
                        <div class="machine-release-icon">
                            <i class="bi @(e.MaquinaLiberada ? "bi-check-circle-fill" : Model.TieneParoAbierto ? "bi-exclamation-triangle" : "bi-unlock")"></i>
                        </div>
                        <div>
                            <div class="data-label">Disponibilidad física de máquina</div>
                            @if (e.MaquinaLiberada)
                            {
                                <h2 class="machine-release-title">Máquina liberada para la siguiente OF</h2>
                                <p class="machine-release-text">La ejecución continúa abierta para cajas, Calidad, GP12 y cierre documental, pero esta máquina ya no bloquea el siguiente programa.</p>
                                <div class="d-flex flex-wrap gap-2 mt-2">
                                    <span class="badge bg-success">
                                        <i class="bi bi-clock me-1"></i>
                                        @(e.FechaLiberacionMaquina?.ToString("dd/MM/yyyy HH:mm") ?? "Liberada")
                                    </span>
                                    @if (e.UsuarioLiberacionMaquinaID.HasValue)
                                    {
                                        <span class="badge bg-secondary">Usuario @e.UsuarioLiberacionMaquinaID.Value</span>
                                    }
                                </div>
                                @if (!string.IsNullOrWhiteSpace(e.ObservacionesLiberacionMaquina))
                                {
                                    <div class="muted-small mt-2"><strong>Observaciones:</strong> @e.ObservacionesLiberacionMaquina</div>
                                }
                            }
                            else if (Model.TieneParoAbierto)
                            {
                                <h2 class="machine-release-title">La máquina no puede liberarse con un paro abierto</h2>
                                <p class="machine-release-text">Cierra primero el paro actual. Después podrás registrar el fin físico de la corrida sin esperar a que concluyan Calidad, cajas o GP12.</p>
                            }
                            else
                            {
                                <h2 class="machine-release-title">Liberar máquina al terminar la corrida física</h2>
                                <p class="machine-release-text">Usa esta acción cuando ya salió la última pieza y no habrá más producción en esta máquina para la OF. El sistema validará las capturas horarias requeridas antes de liberar.</p>
                            }
                        </div>
                    </div>
                    @if (!e.MaquinaLiberada)
                    {
                        <form method="post" action="@Url.Action("LiberarMaquina", "Produccion")" class="machine-release-form">
                            @Html.AntiForgeryToken()
                            <input type="hidden" name="EjecucionProduccionID" value="@e.EjecucionProduccionID" />
                            <label class="form-label" for="ObservacionesLiberacionMaquina">Observaciones de liberación</label>
                            <textarea class="form-control mb-2" id="ObservacionesLiberacionMaquina" name="Observaciones" rows="2" maxlength="500" placeholder="Opcional: última pieza, entrega a siguiente OF, condición de máquina, etc." disabled="@Model.TieneParoAbierto"></textarea>
                            <button type="submit" class="btn @(Model.TieneParoAbierto ? "btn-warning" : "btn-primary") w-100 btn-strong" disabled="@Model.TieneParoAbierto">
                                <i class="bi bi-unlock me-1"></i>
                                Liberar máquina
                            </button>
                            @if (!Model.TieneParoAbierto)
                            {
                                <div class="form-text mt-2">Esta acción no termina la ejecución ni cierra Calidad.</div>
                            }
                        </form>
                    }
                </div>
            </section>
        }

        @if (e.EstatusID == ERP.NSQuell.Models.ProduccionEstatus.EnPreparacion && !Model.TieneParoAbierto)
        {
            var puedeIniciarSerieCompleto =
            Model.CalidadResumen?.PuedeIniciarSerie == true &&
            tieneConfiguracionCorrida;

            <section class="primary-series-action mb-4 @(puedeIniciarSerieCompleto ? "" : "is-blocked")" id="panelIniciarSerie">
                <div class="d-flex flex-wrap align-items-center justify-content-between gap-3">
                    <div class="d-flex align-items-start gap-3 flex-grow-1">
                        <div class="next-action-icon">
                            <i class="bi bi-play-fill"></i>
                        </div>

                        <div>
                            <div class="data-label">
                                @(esReinicioSerie ? "Acción principal" : "Inicio de serie")
                            </div>

                            <h2 class="series-title">
                                @(esReinicioSerie ? "Reiniciar producción en serie" : "Iniciar producción en serie")
                            </h2>

                            <p class="series-text">
                                @if (esReinicioSerie)
                                {
                                    <text>
                                        La OF está lista para regresar a producción. Confirma el contador físico actual de la máquina; ese valor será la nueva base para las capturas posteriores.
                                    </text>
                                }
                                else
                                {
                                    <text>
                                        Para iniciar serie se requiere liberación de Calidad y una configuración técnica vigente de cavidades, ciclo y contador base.
                                    </text>
                                }
                            </p>
                        </div>
                    </div>

                    <div class="series-status">
                        <form method="post" action="@Url.Action("IniciarSerie","Produccion")">
                            @Html.AntiForgeryToken()

                            <input type="hidden"
                                   name="ejecucionProduccionId"
                                   value="@e.EjecucionProduccionID" />

                            @if (esReinicioSerie)
                            {
                                <div class="mb-3 text-start">
                                    <label class="form-label fw-bold" for="ContadorMaquinaReinicio">
                                        <i class="bi bi-speedometer2 me-1"></i>
                                        Contador actual de la máquina *
                                    </label>

                                    <input type="number"
                                           id="ContadorMaquinaReinicio"
                                           name="contadorMaquinaActual"
                                           min="0"
                                           step="1"
                                           required
                                           autocomplete="off"
                                           class="form-control form-control-lg fw-bold"
                                           placeholder="Ej. 12850" />

                                    <div class="form-text">
                                        Captura exactamente el valor que muestra físicamente la máquina en este momento.
                                        Será la nueva base de la OF y los ciclos realizados durante el paro, la urgencia o las primeras piezas no se sumarán a esta producción.
                                    </div>
                                </div>
                            }

                            <button type="submit"
                                    class="btn btn-success w-100 btn-strong"
                                    disabled="@(!puedeIniciarSerieCompleto)"
                                    onclick="return confirm('@(esReinicioSerie ? "¿Confirmas reiniciar la producción en serie con el contador físico capturado como nueva base?" : "¿Confirmas iniciar producción en serie?")');">
                                <i class="bi bi-play-fill me-1"></i>
                                @(esReinicioSerie ? "Reiniciar serie ahora" : "Iniciar serie")
                            </button>

                            @if (!tieneConfiguracionCorrida)
                            {
                                <div class="text-warning-emphasis fw-bold small mt-2 text-center">
                                    <i class="bi bi-sliders me-1"></i>
                                    Pendiente de configuración técnica de la corrida.
                                </div>
                            }

                            @if (Model.CalidadResumen?.PuedeIniciarSerie != true)
                            {
                                <div class="text-warning-emphasis fw-bold small mt-2 text-center">
                                    <i class="bi bi-hourglass-split me-1"></i>
                                    Pendiente de liberación verde por Calidad.
                                </div>
                            }

                            @if (puedeIniciarSerieCompleto)
                            {
                                <div class="text-success fw-bold small mt-2 text-center">
                                    <i class="bi bi-check-circle me-1"></i>
                                    @(esReinicioSerie
                                                                ? "Retorno listo. Confirma el contador físico para continuar."
                                                                : "Calidad y configuración técnica listas.")
                        </div>
                                                }
                        </form>
                    </div>
                </div>
            </section>
        }

        <div class="row g-4">
            <div class="col-12 col-xl-4">

                <div class="panel mb-4" id="panelDatosEjecucion" data-collapsible data-default-open="false">
                    <div class="panel-header">
                        <i class="bi bi-info-circle me-1"></i>
                        Datos de ejecución
                    </div>

                    <div class="panel-body">
                        <div class="row g-3">
                            <div class="col-6">
                                <div class="data-label">Máquina</div>
                                <div class="data-value">@e.MaquinaCodigo</div>
                                <div class="muted-small">@e.MaquinaNombre</div>
                            </div>

                            <div class="col-6">
                                <div class="data-label">Molde</div>
                                <div class="data-value">@(e.MoldeCodigo ?? "Sin molde")</div>
                            </div>

                            <div class="col-12">
                                <div class="data-label">Parte</div>
                                <div class="data-value">@e.TituloPrograma</div>
                                <div class="muted-small">@e.DescripcionParte</div>
                            </div>

                            <div class="col-12">
                                <div class="operator-line">
                                    <div>
                                        <div class="data-label">Operador principal</div>
                                        <div class="data-value">@e.TextoOperador</div>
                                        <div class="muted-small mt-1">
                                            <strong>Auxiliar:</strong>
                                            @(string.IsNullOrWhiteSpace(e.OperadorAuxiliarNombre)
                                                                                        ? "Sin auxiliar"
                                                                                        : e.OperadorAuxiliarNombre)
                                        </div>
                                    </div>

                                    @if (e.PuedePausar || Model.TieneParoAbierto)
                                    {
                                        <button type="button"
                                                class="btn btn-sm btn-outline-primary fw-bold"
                                                data-bs-toggle="modal"
                                                data-bs-target="#modalCambiarOperador">
                                            <i class="bi bi-people me-1"></i>
                                            Cambiar
                                        </button>
                                    }
                                </div>

                                @if (e.OperadoresModificadosManual)
                                {
                                    <div class="alert alert-info py-2 px-3 mt-2 mb-0">
                                        <strong>Asignación modificada durante el turno.</strong>
                                        @if (!string.IsNullOrWhiteSpace(e.MotivoCambioOperadores))
                                        {
                                            <div class="small mt-1">@e.MotivoCambioOperadores</div>
                                        }
                                    </div>
                                }
                            </div>

                            <div class="col-6">
                                <div class="data-label">Inicio real</div>
                                <div class="data-value">
                                    @(e.FechaInicioReal?.ToString("dd/MM/yyyy HH:mm") ?? "-")
                                </div>
                            </div>

                            <div class="col-6">
                                <div class="data-label">Fin real</div>
                                <div class="data-value">
                                    @(e.FechaFinReal?.ToString("dd/MM/yyyy HH:mm") ?? "-")
                                </div>
                            </div>

                            <div class="col-12">
                                <div class="data-label">Estado físico de máquina</div>
                                @if (e.MaquinaLiberada)
                                {
                                    <div class="data-value text-success">
                                        <i class="bi bi-unlock me-1"></i>
                                        Liberada el @(e.FechaLiberacionMaquina?.ToString("dd/MM/yyyy HH:mm") ?? "-")
                                    </div>
                                }
                                else
                                {
                                    <div class="data-value text-primary">
                                        <i class="bi bi-lock me-1"></i>
                                        Ocupada por esta ejecución
                                    </div>
                                }
                            </div>

                            <div class="col-6">
                                <div class="data-label">Programa</div>
                                <div class="data-value">@e.ProgramaProduccionID</div>
                            </div>

                            <div class="col-6">
                                <div class="data-label">Ejecución</div>
                                <div class="data-value">@e.EjecucionProduccionID</div>
                            </div>
                        </div>
                    </div>
                </div>

                @if (configuracionTiempoReal != null)
                {
                    var cfg = configuracionTiempoReal.ConfiguracionActual;
                    var accionConfiguracion = tieneConfiguracionCorrida
                    ? Url.Action("CambiarConfiguracionCorrida", "Produccion")
                    : Url.Action("GuardarConfiguracionCorrida", "Produccion");

                    var cavidadesDefaultFormulario = tieneConfiguracionCorrida
                    ? cfg?.CavidadesUsadas
                    : configuracionTiempoReal.CavidadesBD;

                    var cicloDefaultFormulario = tieneConfiguracionCorrida
                    ? cfg?.TiempoCicloSegundos
                    : configuracionTiempoReal.TiempoCicloBD;

                    <div class="panel mb-4" id="panelConfiguracionCorrida" data-collapsible data-default-open="@(!tieneConfiguracionCorrida ? "true" : "false")">
                        <div class="panel-header d-flex justify-content-between align-items-center gap-2">
                            <span>
                                <i class="bi bi-sliders me-1"></i>
                                Configuración real de la corrida
                            </span>

                            @if (tieneConfiguracionCorrida)
                            {
                                <span class="badge bg-success">Configuración activa</span>
                            }
                            else
                            {
                                <span class="badge bg-warning text-dark">Pendiente técnico</span>
                            }
                    </div>

                    <div class="panel-body">
                        <div class="config-run-card mb-3 @(tieneConfiguracionCorrida ? "is-active" : "is-pending")">
                            <div class="d-flex align-items-start justify-content-between gap-2 mb-2">
                                <div>
                                    <div class="data-label">
                                        @(tieneConfiguracionCorrida ? "Configuración vigente" : "Configuración requerida")
                                    </div>
                                    <div class="data-value fs-5">
                                        @(tieneConfiguracionCorrida
                                                                                ? cfg?.TextoConfiguracion
                                                                                : "El técnico debe confirmar la corrida")
                                                                                                                     </div>
                                                                                                                 </div>
                                                                                                                 <i class="bi @(tieneConfiguracionCorrida ? "bi-check-circle-fill text-success" : "bi-exclamation-triangle-fill text-warning") fs-4"></i>
                                                                                                             </div>

                            <div class="muted-small">
                                El operador no modifica cavidades ni ciclo. Estos valores pertenecen al Técnico de Producción y se utilizan para calcular automáticamente el objetivo y las piezas reales.
                            </div>
                        </div>

                        <div class="data-label mb-2">Valores de referencia</div>
                        <div class="config-reference-grid mb-3">
                            <div class="config-reference-item">
                                <div class="data-label">Cavidades BD</div>
                                <div class="config-reference-value">
                                    @(configuracionTiempoReal.CavidadesBD?.ToString("N0") ?? "Sin dato")
                                </div>
                                <div class="muted-small">Sugerencia inicial</div>
                            </div>

                            <div class="config-reference-item">
                                <div class="data-label">Ciclo BD</div>
                                <div class="config-reference-value">
                                    @(configuracionTiempoReal.TiempoCicloBD.HasValue
                                                                        ? configuracionTiempoReal.TiempoCicloBD.Value.ToString("0.####") + " s"
                                                                        : "Sin dato")
                                                                                 </div>
                                                                                 <div class="muted-small">Se interpreta aunque el valor legado tenga “seg”.</div>
                                                                             </div>

                            <div class="config-reference-item">
                                <div class="data-label">Objetivo referencia</div>
                                <div class="config-reference-value">
                                    @(objetivoReferencia.HasValue
                                                                        ? Math.Round(objetivoReferencia.Value, 0, MidpointRounding.AwayFromZero).ToString("N0") + " pzas/h"
                                                                        : "Sin cálculo")
                                </div>
                                <div class="muted-small">3600 / ciclo × cavidades</div>
                            </div>
                        </div>

                        @if (tieneConfiguracionCorrida && cfg != null)
                            {
                                <div class="soft-box mb-3">
                                    <div class="row g-3">
                                        <div class="col-6">
                                            <div class="data-label">Cavidades en uso</div>
                                            <div class="data-value fs-5">@cfg.CavidadesUsadas.ToString("N0")</div>
                                        </div>
                                        <div class="col-6">
                                            <div class="data-label">Ciclo real</div>
                                            <div class="data-value fs-5">@cfg.TiempoCicloSegundos.ToString("0.####") s</div>
                                        </div>
                                        <div class="col-6">
                                            <div class="data-label">Objetivo real</div>
                                            <div class="data-value fs-5">@cfg.ObjetivoHoraOperativo.ToString("N0") pzas/h</div>
                                        </div>
                                        <div class="col-6">
                                            <div class="data-label">Contador base</div>
                                            <div class="data-value fs-5">@(cfg.ContadorInicioVigencia?.ToString("N0") ?? "-")</div>
                                        </div>
                                        <div class="col-12">
                                            <div class="data-label">Última lectura conocida</div>
                                            <div class="data-value">@(configuracionTiempoReal.UltimoContadorMaquina?.ToString("N0") ?? "Sin lectura")</div>
                                        </div>
                                    </div>
                                </div>
                            }

                            @if (puedeGestionarConfiguracionCorrida)
                            {
                                <div class="config-form-box mb-3">
                                    <div class="fw-bold mb-1">
                                        <i class="bi bi-person-badge me-1"></i>
                                        @(tieneConfiguracionCorrida ? "Cambiar configuración técnica" : "Confirmar configuración inicial")
                                    </div>
                                    <div class="muted-small mb-3">
                                        Si no cambias cavidades o ciclo, se utilizarán automáticamente los valores mostrados como referencia. El contador actual sí debe capturarse porque no existe un valor seguro por defecto.
                                    </div>

                                    <form method="post"
                                          action="@accionConfiguracion"
                                          data-config-form
                                          novalidate>
                                        @Html.AntiForgeryToken()

                                        <input type="hidden"
                                               name="EjecucionProduccionID"
                                               value="@e.EjecucionProduccionID" />

                                        <div class="row g-3">
                                            <div class="col-12 col-md-6">
                                                <label class="form-label" for="CavidadesUsadasConfig">
                                                    Cavidades utilizadas
                                                </label>
                                                <input type="number"
                                                       min="1"
                                                       step="1"
                                                       class="form-control"
                                                       id="CavidadesUsadasConfig"
                                                       name="CavidadesUsadas"
                                                       value="@(cavidadesDefaultFormulario?.ToString(System.Globalization.CultureInfo.InvariantCulture) ?? "")"
                                                       data-config-cavidades
                                                       data-default-value="@(cavidadesDefaultFormulario?.ToString(System.Globalization.CultureInfo.InvariantCulture) ?? "")"
                                                       placeholder="@(configuracionTiempoReal.CavidadesBD?.ToString() ?? "Capturar cavidades")" />
                                                <div class="form-text">
                                                    Déjalo sin cambios para conservar el valor por defecto.
                                                </div>
                                            </div>

                                            <div class="col-12 col-md-6">
                                                <label class="form-label" for="TiempoCicloSegundosConfig">
                                                    Tiempo de ciclo real (segundos)
                                                </label>
                                                <input type="number"
                                                       min="0.0001"
                                                       step="0.0001"
                                                       class="form-control"
                                                       id="TiempoCicloSegundosConfig"
                                                       name="TiempoCicloSegundos"
                                                       value="@(cicloDefaultFormulario?.ToString("0.####", System.Globalization.CultureInfo.InvariantCulture) ?? "")"
                                                       data-config-ciclo
                                                       data-default-value="@(cicloDefaultFormulario?.ToString("0.####", System.Globalization.CultureInfo.InvariantCulture) ?? "")"
                                                       placeholder="@(configuracionTiempoReal.TiempoCicloBD?.ToString("0.####") ?? "Capturar ciclo")" />
                                                <div class="form-text">
                                                    Captura solo el número; el ERP lo guarda en segundos.
                                                </div>
                                            </div>

                                            <div class="col-12">
                                                <label class="form-label" for="ContadorMaquinaActualConfig">
                                                    Contador actual de la máquina *
                                                </label>
                                                <input type="number"
                                                       min="0"
                                                       step="1"
                                                       class="form-control"
                                                       id="ContadorMaquinaActualConfig"
                                                       name="ContadorMaquinaActual"
                                                       data-config-contador
                                                       placeholder="Ej. 12850" />
                                                <div class="form-text">
                                                    Este dato es obligatorio. Si la máquina fue reiniciada, captura el valor que muestra físicamente en este momento.
                                                </div>
                                            </div>

                                            <div class="col-12">
                                                <div class="config-formula" data-config-objetivo>
                                                    Objetivo estimado: @(objetivoReferencia.HasValue? Math.Round(objetivoReferencia.Value, 0, MidpointRounding.AwayFromZero).ToString("N0") + " pzas/h" : "pendiente de datos")
                                                </div>
                                            </div>

                                            @if (tieneConfiguracionCorrida)
                                            {
                                                <div class="col-12">
                                                    <div class="config-preview-loading" data-config-preview-loading>
                                                        <span class="spinner-border spinner-border-sm me-1"></span>
                                                        Calculando impacto en la programación...
                                                    </div>

                                                    <div class="config-preview" data-config-preview>
                                                        <div class="d-flex justify-content-between align-items-start gap-2">
                                                            <div>
                                                                <div class="data-label">Vista previa del cambio</div>
                                                                <div class="fw-bold mt-1" data-config-preview-title>
                                                                    Impacto estimado en la OF
                                                                </div>
                                                            </div>
                                                            <span class="badge bg-secondary" data-config-preview-badge>
                                                                Sin cambios
                                                            </span>
                                                        </div>

                                                        <div class="config-preview-grid">
                                                            <div class="config-preview-item">
                                                                <div class="config-preview-label">Objetivo</div>
                                                                <div class="config-preview-value" data-config-preview-objetivo>
                                                                    -
                                                                </div>
                                                            </div>

                                                            <div class="config-preview-item">
                                                                <div class="config-preview-label">Piezas pendientes</div>
                                                                <div class="config-preview-value" data-config-preview-pendiente>
                                                                    -
                                                                </div>
                                                            </div>

                                                            <div class="config-preview-item">
                                                                <div class="config-preview-label">Tiempo restante</div>
                                                                <div class="config-preview-value" data-config-preview-tiempo>
                                                                    -
                                                                </div>
                                                            </div>

                                                            <div class="config-preview-item">
                                                                <div class="config-preview-label">Fin programado</div>
                                                                <div class="config-preview-value" data-config-preview-fin>
                                                                    -
                                                                </div>
                                                            </div>
                                                        </div>

                                                        <div class="config-preview-impact" data-config-preview-impact>
                                                            -
                                                        </div>

                                                        <div class="muted-small mt-2">
                                                            <i class="bi bi-info-circle me-1"></i>
                                                            Esta es solo una simulación. El calendario no cambia hasta aplicar la nueva configuración.
                                                        </div>
                                                    </div>
                                                </div>
                                            }

                                            <div class="col-12">
                                                <label class="form-label" for="MotivoCambioConfiguracion">
                                                    @(tieneConfiguracionCorrida ? "Motivo del cambio *" : "Observaciones")
                                                </label>
                                                <textarea class="form-control"
                                                  id="MotivoCambioConfiguracion"
                                                  name="MotivoCambio"
                                                  rows="2"
                                                  maxlength="500"
                                                  placeholder="@(tieneConfiguracionCorrida ? "Ej. se bloqueó una cavidad, ajuste de proceso, cambio real de ciclo, etc." : "Opcional: condición inicial de la corrida")"></textarea>
                                            </div>

                                            <div class="col-12">
                                                <div class="config-validation" data-config-validation></div>
                                            </div>

                                            <div class="col-12 d-grid">
                                                <button type="submit" class="btn @(tieneConfiguracionCorrida ? "btn-primary" : "btn-warning") btn-strong">
                                                    <i class="bi @(tieneConfiguracionCorrida ? "bi-arrow-repeat" : "bi-check2-circle") me-1"></i>
                                                    @(tieneConfiguracionCorrida ? "Aplicar nueva configuración" : "Confirmar configuración técnica")
                                                </button>
                                            </div>
                                        </div>
                                    </form>
                                </div>
                            }
                            else
                            {
                                <div class="alert alert-secondary mb-3">
                                    <i class="bi bi-lock me-1"></i>
                                    Solo el Técnico de Producción asignado, el Encargado de Producción o un Administrador pueden modificar cavidades y ciclo.
                                </div>
                            }

                            @if (configuracionTiempoReal.HistorialConfiguraciones != null &&
                                                    configuracionTiempoReal.HistorialConfiguraciones.Any())
                            {
                                <div class="data-label mb-2">Historial técnico</div>
                                <div class="config-history">
                                    @foreach (var h in configuracionTiempoReal.HistorialConfiguraciones)
                                    {
                                        <div class="config-history-item">
                                            <div class="d-flex flex-wrap justify-content-between align-items-start gap-2">
                                                <div>
                                                    <div class="fw-bold">
                                                        @h.CavidadesUsadas.ToString("N0") cav. · @h.TiempoCicloSegundos.ToString("0.####") s · @h.ObjetivoHoraOperativo.ToString("N0") pzas/h
                                                    </div>
                                                    <div class="muted-small">
                                                        @h.FechaInicioVigencia.ToString("dd/MM/yyyy HH:mm")
                                                        → @(h.FechaFinVigencia?.ToString("dd/MM/yyyy HH:mm") ?? "Vigente")
                                                    </div>
                                                </div>
                                                <span class="badge @(h.EstaVigente ? "bg-success" : "bg-secondary")">
                                                    @(h.EstaVigente ? "Actual" : "Cerrada")
                                                </span>
                                            </div>

                                            <div class="muted-small mt-1">
                                                Contador: @(h.ContadorInicioVigencia?.ToString("N0") ?? "-")
                                                → @(h.ContadorFinVigencia?.ToString("N0") ?? "-")
                                            </div>

                                            @if (!string.IsNullOrWhiteSpace(h.TecnicoProduccionNombre))
                                            {
                                                <div class="muted-small mt-1">
                                                    <strong>Técnico:</strong> @h.TecnicoProduccionNombre
                                                </div>
                                            }

                                            @if (!string.IsNullOrWhiteSpace(h.MotivoCambio))
                                            {
                                                <div class="small mt-1">
                                                    <strong>Motivo:</strong> @h.MotivoCambio
                                                </div>
                                            }
                                        </div>
                                    }
                                </div>
                            }
                        </div>
                    </div>
                }

                @if (cambioTurnoTecnico != null && puedeGestionarSugerenciaCambioTurno)
                {
                    <div class="panel mb-4" id="panelCambioTurnoTecnico" data-collapsible data-default-open="true">
                        <div class="panel-header d-flex justify-content-between align-items-center gap-2">
                            <span>
                                <i class="bi bi-person-badge me-1"></i>
                                Sugerencia para cambio de turno
                            </span>
                            @if (cambioTurnoTecnico.TieneSugerencia)
                            {
                                <span class="badge bg-primary">Sugerencia activa</span>
                            }
                            else
                            {
                                <span class="badge bg-secondary">Sin sugerencia</span>
                            }
                        </div>
                        <div class="panel-body">
                            <div class="turn-tech-card mb-3">
                                <div class="data-label">Operador actual</div>
                                <div class="data-value fs-5">@cambioTurnoTecnico.TextoOperadorActual</div>
                                <div class="muted-small mt-1">
                                    @cambioTurnoTecnico.TextoMaquina · @cambioTurnoTecnico.TextoParte
                                </div>
                            </div>

                            @if (cambioTurnoTecnico.SugerenciaActual != null && cambioTurnoTecnico.SugerenciaActual.EstaVigente)
                            {
                                var sug = cambioTurnoTecnico.SugerenciaActual;
                                <div class="turn-tech-current mb-3">
                                    <div class="data-label">Sugerencia vigente</div>
                                    <div class="data-value fs-5">@sug.TextoOperador</div>
                                    <div class="muted-small mt-1">
                                        @if (!string.IsNullOrWhiteSpace(sug.TurnoNombre))
                                        {
                                            <span>Turno @sug.TurnoNombre</span>
                                        }
                                        @if (sug.NivelPolivalencia.HasValue)
                                        {
                                            <span> · Nivel N@sug.NivelPolivalencia.Value</span>
                                        }
                                        <span> · @(sug.EnEscala ? "Programado en escala" : "Fuera de escala actual")</span>
                                    </div>
                                    <div class="muted-small mt-1">
                                        Sugerida el @sug.TextoFecha
                                    </div>
                                    @if (!string.IsNullOrWhiteSpace(sug.Observaciones))
                                    {
                                        <div class="small mt-2">@sug.Observaciones</div>
                                    }
                                </div>
                            }

                            @if (cambioTurnoTecnico.Operadores != null && cambioTurnoTecnico.Operadores.Any())
                            {
                                <form method="post" action="@Url.Action("GuardarSugerenciaCambioTurno","Produccion")">
                                    @Html.AntiForgeryToken()
                                    <input type="hidden" name="EjecucionProduccionID" value="@e.EjecucionProduccionID" />

                                    <div class="mb-3">
                                        <label class="form-label" for="OperadorSugeridoID">Operador recomendado para el siguiente turno</label>
                                        <select class="form-select" id="OperadorSugeridoID" name="OperadorSugeridoID" required>
                                            <option value="">-- Seleccionar operador --</option>
                                            @foreach (var op in cambioTurnoTecnico.Operadores)
                                            {
                                                var seleccionado = cambioTurnoTecnico.SugerenciaActual?.OperadorSugeridoID == op.PersonaID;
                                                <option value="@op.PersonaID" selected="@seleccionado">
                                                    @op.Nombre@(op.Nivel.HasValue ? $" · N{op.Nivel.Value}" : "")@(string.IsNullOrWhiteSpace(op.TurnoNombre) ? "" : $" · {op.TurnoNombre}")@(op.EnEscala ? " · ESCALA" : "")
                                                </option>
                                            }
                                        </select>
                                        <div class="form-text">
                                            Esta selección es una sugerencia para el operador saliente. El operador podrá cambiarla al momento real de entregar el turno.
                                        </div>
                                    </div>

                                    <div class="mb-3">
                                        <label class="form-label" for="ObservacionesSugerenciaTurno">Observaciones</label>
                                        <textarea class="form-control"
                                          id="ObservacionesSugerenciaTurno"
                                          name="Observaciones"
                                          rows="3"
                                          maxlength="500"
                                          placeholder="Ej. dejar a este operador por experiencia en la pieza, continuidad de máquina, cobertura del siguiente turno, etc.">@cambioTurnoTecnico.SugerenciaActual?.Observaciones</textarea>
                                    </div>

                                    <div class="d-grid gap-2">
                                        <button type="submit" class="btn btn-primary btn-strong">
                                            <i class="bi bi-person-check me-1"></i>
                                            @(cambioTurnoTecnico.TieneSugerencia ? "Actualizar sugerencia" : "Guardar sugerencia")
                                        </button>
                                    </div>
                                </form>

                                @if (cambioTurnoTecnico.TieneSugerencia)
                                {
                                    <form method="post" action="@Url.Action("CancelarSugerenciaCambioTurno","Produccion")" class="mt-2">
                                        @Html.AntiForgeryToken()
                                        <input type="hidden" name="ejecucionProduccionId" value="@e.EjecucionProduccionID" />
                                        <button type="submit" class="btn btn-outline-secondary w-100 btn-strong">
                                            <i class="bi bi-x-circle me-1"></i>
                                            Retirar sugerencia
                                        </button>
                                    </form>
                                }

                            }
                            else
                            {
                                <div class="alert alert-warning mb-0">
                                    <i class="bi bi-exclamation-triangle me-1"></i>
                                    No existen operadores candidatos disponibles para sugerir en este momento.
                                </div>
                            }
                        </div>
                    </div>
                }

                <div class="panel mb-4" id="panelChecklist" data-collapsible data-default-open="@(accionActual == "GENERAR_CHECKLIST" ? "true" : "false")">
                    <div class="panel-header">
                        <i class="bi bi-clipboard2-check me-1"></i>
                        Checklist de arranque
                    </div>

                    <div class="panel-body">
                        @if (Model.ChecklistResumen == null)
                        {
                            <div class="alert alert-secondary mb-3">
                                <strong>Sin checklist generado.</strong><br />
                                Abre el checklist para generarlo y comenzar la captura de arranque.
                            </div>

                            <a href="@Url.Action("ChecklistArranque", "Produccion", new { ejecucionProduccionId = e.EjecucionProduccionID })"
                               class="btn btn-primary w-100 btn-strong">
                                <i class="bi bi-clipboard-check me-1"></i>
                                Generar checklist de arranque
                            </a>
                        }
                        else
                        {
                            var checklist = Model.ChecklistResumen;

                            <div class="d-flex flex-wrap justify-content-between align-items-start gap-3 mb-3">
                                <div>
                                    <div class="data-label">Estatus checklist</div>
                                    <div class="mt-1">
                                        <span class="badge @checklist.EstatusClase fs-6">
                                            @checklist.EstatusNombre
                                        </span>
                                    </div>
                                </div>

                                <div>
                                    <div class="data-label">Formato</div>
                                    <div class="data-value">
                                        @checklist.CodigoFormato @checklist.VersionFormato
                                    </div>
                                </div>

                                <div>
                                    <div class="data-label">Fecha</div>
                                    <div class="data-value">
                                        @checklist.FechaChecklist.ToString("dd/MM/yyyy HH:mm")
                                    </div>
                                </div>
                            </div>

                            <div class="row g-2 mb-3">
                                <div class="col-4">
                                    <div class="mini-stat">
                                        <div class="mini-stat-label">Preguntas</div>
                                        <div class="mini-stat-value">@checklist.TotalPreguntas</div>
                                    </div>
                                </div>

                                <div class="col-4">
                                    <div class="mini-stat">
                                        <div class="mini-stat-label">Respondidas</div>
                                        <div class="mini-stat-value text-success">@checklist.TotalRespondidas</div>
                                    </div>
                                </div>

                                <div class="col-4">
                                    <div class="mini-stat">
                                        <div class="mini-stat-label">NOK</div>
                                        <div class="mini-stat-value text-danger">@checklist.TotalNOK</div>
                                    </div>
                                </div>
                            </div>

                            @if (checklist.TotalNOK > 0)
                            {
                                <div class="alert alert-warning mb-3">
                                    <i class="bi bi-exclamation-triangle me-1"></i>
                                    Este checklist tiene respuestas NOK. Revisa que tengan observación.
                                </div>
                            }

                            <a href="@Url.Action("ChecklistArranque", "Produccion", new { ejecucionProduccionId = e.EjecucionProduccionID })"
                               class="btn btn-primary w-100 btn-strong">
                                <i class="bi bi-clipboard-check me-1"></i>
                                Abrir checklist de arranque
                            </a>
                        }
                    </div>
                </div>

                @if (monitoreoTurno != null)
                {
                    var porcentajeMonitoreo = monitoreoTurno.PorcentajeAvance;
                    <div class="panel mb-4 @(Model.MostrarAvisoMonitoreoTurno ? "turno-monitor-card" : "")" id="panelMonitoreoTurno" data-collapsible data-default-open="@(Model.MostrarAvisoMonitoreoTurno ? "true" : "false")">
                        <div class="panel-header d-flex justify-content-between align-items-center gap-2">
                            <span><i class="bi bi-cpu me-1"></i>Monitoreo de periféricos</span>
                            <span class="badge @(Model.MostrarAvisoMonitoreoTurno ? "bg-warning text-dark" : "bg-success")">@(Model.MostrarAvisoMonitoreoTurno ? "Pendiente" : "Completo")</span>
                        </div>
                        <div class="panel-body">
                            <div class="d-flex align-items-start gap-3 mb-3">
                                <div class="turno-monitor-icon"><i class="bi bi-arrow-repeat"></i></div>
                                <div class="flex-grow-1">
                                    <div class="data-label">Turno actual</div>
                                    <div class="data-value fs-5">@Txt(monitoreoTurno.TurnoNombre)</div>
                                    <div class="muted-small">Fecha operativa: @monitoreoTurno.FechaOperacion.ToString("dd/MM/yyyy")</div>
                                    <div class="muted-small">Máquina: @Txt(monitoreoTurno.MaquinaCodigo) · @Txt(monitoreoTurno.MaquinaNombre)</div>
                                </div>
                            </div>
                            <div class="d-flex justify-content-between small mb-1"><span class="fw-bold text-primary">Verificaciones</span><span>@monitoreoTurno.TotalConfirmadas / @monitoreoTurno.TotalPreguntas</span></div>
                            <div class="progress turno-monitor-progress mb-3"><div class="progress-bar" style="width:@porcentajeMonitoreo.ToString("0.##", System.Globalization.CultureInfo.InvariantCulture)%"></div></div>
                            <div class="soft-box mb-3"><div class="d-flex justify-content-between align-items-center gap-2"><span class="fw-bold"><i class="bi bi-people me-1"></i>Entrega y recepción</span><span class="badge @(monitoreoTurno.EntregaTurnoRegistrada ? "bg-success" : "bg-warning text-dark")">@(monitoreoTurno.EntregaTurnoRegistrada ? "Registrada" : "Pendiente")</span></div></div>
                            <a href="@Url.Action("ChecklistFormato", "Produccion", new { id = monitoreoTurno.ChecklistArranqueID })" class="btn @(Model.MostrarAvisoMonitoreoTurno ? "btn-warning" : "btn-outline-primary") w-100 btn-strong"><i class="bi bi-clipboard-check me-1"></i>@(Model.MostrarAvisoMonitoreoTurno ? "Realizar monitoreo del turno" : "Consultar monitoreo del turno")</a>
                        </div>
                    </div>
                }

                <div class="panel mb-4" id="panelCalidad" data-collapsible data-default-open="@(accionActual == "ESPERAR_CALIDAD" ? "true" : "false")">
                    <div class="panel-header">
                        <i class="bi bi-patch-check me-1"></i>
                        Liberación de Calidad
                    </div>

                    <div class="panel-body">
                        @if (Model.CalidadResumen == null)
                        {
                            <div class="alert alert-secondary mb-0">
                                El checklist todavía no ha sido enviado a Calidad.
                            </div>
                        }
                        else
                        {
                            var calidad = Model.CalidadResumen;

                            <div class="d-flex flex-wrap justify-content-between gap-3 mb-3">
                                <div>
                                    <div class="data-label">Estado de Calidad</div>
                                    <span class="badge @calidad.ClaseBadge fs-6 mt-1">
                                        @calidad.EstadoTexto
                                    </span>
                                </div>

                                <div>
                                    <div class="data-label">Notificación</div>
                                    <div class="data-value">
                                        @(calidad.FechaNotificacionCalidad?.ToString("dd/MM/yyyy HH:mm") ?? "-")
                                    </div>
                                </div>

                                <div>
                                    <div class="data-label">Etiqueta verde</div>
                                    <div class="data-value">
                                        @(calidad.FechaLiberacionProduccion?.ToString("dd/MM/yyyy HH:mm") ?? "-")
                                    </div>
                                </div>
                            </div>

                            @if (!string.IsNullOrWhiteSpace(calidad.MotivoDevolucion))
                            {
                                <div class="alert alert-danger mb-3">
                                    <strong>Corrección solicitada por Calidad:</strong><br />
                                    @calidad.MotivoDevolucion
                                </div>
                            }

                            @if (calidad.ConfiguracionInvalidada)
                            {
                                <div class="alert alert-danger mb-3">
                                    La configuración de la corrida fue invalidada por cambios en Planeación.
                                </div>
                            }

                        }
                    </div>
                </div>

                @if (Model.TieneParoAbierto)
                {
                    var paroAbierto = Model.ParoAbierto;

                    <div class="panel mb-4 @(paroAbierto?.EsInterrupcionUrgente == true ? "border-warning" : "border-danger")" id="panelParo">
                        <div class="panel-header @(paroAbierto?.EsInterrupcionUrgente == true ? "text-warning" : "text-danger")">
                            <i class="bi @(paroAbierto?.EsInterrupcionUrgente == true ? "bi-lightning-charge-fill" : "bi-pause-circle") me-1"></i>
                            @(paroAbierto?.EsInterrupcionUrgente == true ? "Interrupción urgente de Planeación" : "Paro abierto")
                        </div>

                        <div class="panel-body">
                            <p class="mb-1">
                                <strong>Motivo:</strong> @(paroAbierto?.MotivoParoTexto ?? "Sin motivo")
                            </p>

                            <p class="mb-3">
                                <strong>Duración:</strong> @(paroAbierto?.DuracionTexto ?? "-")
                            </p>

                            @if (paroAbierto?.EsInterrupcionUrgente == true)
                            {
                                <div class="alert alert-warning border-0 mb-0">
                                    <div class="fw-bold mb-2">
                                        <i class="bi bi-lightning-charge-fill me-1"></i>
                                        Esta OF fue pausada automáticamente por una prioridad urgente
                                    </div>

                                    @if (paroAbierto.SolicitudUrgenteID.HasValue)
                                    {
                                        <div class="mb-2">
                                            La máquina está siendo utilizada temporalmente por la
                                            <strong>OF @paroAbierto.SolicitudUrgenteID.Value</strong>.
                                        </div>
                                    }
                                    else if (paroAbierto.ProgramaUrgenteID.HasValue)
                                    {
                                        <div class="mb-2">
                                            La máquina está siendo utilizada temporalmente por el
                                            <strong>Programa @paroAbierto.ProgramaUrgenteID.Value</strong>.
                                        </div>
                                    }

                                    <div class="small">
                                        Este paro no puede cerrarse manualmente. Cuando finalice la producción urgente, el ERP cerrará automáticamente la interrupción y determinará si esta OF puede continuar directamente o debe regresar a preparación y Calidad.
                                    </div>
                                </div>
                            }
                            else
                            {
                                <form method="post" action="@Url.Action("CerrarParo", "Produccion")">
                                    @Html.AntiForgeryToken()
                                    <input type="hidden" name="ParoID" value="@paroAbierto?.ParoID" />

                                    <div class="mb-3">
                                        <label class="form-label fw-bold">Observaciones de cierre</label>
                                        <textarea name="ObservacionesCierre" rows="2" maxlength="500" class="form-control"></textarea>
                                    </div>

                                    <button type="submit" class="btn btn-primary w-100 btn-strong">
                                        <i class="bi bi-play-circle me-1"></i>
                                        Cerrar paro y reanudar
                                    </button>
                                </form>
                            }
                        </div>
                    </div>
                }
                else if (e.PuedePausar)
                {
                    <div class="panel mb-4" id="panelParo" data-collapsible data-default-open="false">
                        <div class="panel-header">
                            <i class="bi bi-pause-circle me-1"></i>
                            Registrar paro
                        </div>

                        <div class="panel-body">
                            <form method="post" action="@Url.Action("IniciarParo", "Produccion")">
                                @Html.AntiForgeryToken()
                                <input type="hidden" name="EjecucionProduccionID" value="@e.EjecucionProduccionID" />

                                <div class="mb-3">
                                    <label class="form-label fw-bold">Motivo</label>
                                    <select name="MotivoParoID" class="form-select">
                                        @foreach (var item in Model.MotivosParo)
                                        {
                                            <option value="@item.Value">@item.Text</option>
                                        }
                                    </select>
                                </div>

                                <div class="mb-3">
                                    <label class="form-label fw-bold">Descripción</label>
                                    <textarea name="Descripcion" rows="2" maxlength="500" class="form-control"></textarea>
                                </div>

                                <button type="submit" class="btn btn-warning w-100 btn-strong">
                                    <i class="bi bi-pause-fill me-1"></i>
                                    Iniciar paro
                                </button>
                            </form>
                        </div>
                    </div>
                }

                @if (e.PuedeTerminar && (!Model.TieneParoAbierto || terminarParcialAutorizado))
                {
                    <div class="panel" id="panelTerminar" data-collapsible data-default-open="@(accionActual == "TERMINAR" ? "true" : "false")">
                        <div class="panel-header">
                            <i class="bi bi-flag me-1"></i>
                            @(terminarParcialAutorizado ? "Terminación parcial autorizada" : "Terminar producción")
                        </div>

                        <div class="panel-body">
                            @if (terminarParcialAutorizado)
                            {
                                <div class="alert alert-warning border-warning">
                                    <div class="fw-bold mb-1">
                                        <i class="bi bi-exclamation-triangle-fill me-1"></i>
                                        Planeación autorizó la terminación parcial
                                    </div>

                                    <div class="small">
                                        Producción no está tomando esta decisión. La orden fue emitida desde Planeación durante la interrupción de la OF.
                                    </div>

                                    @if (!string.IsNullOrWhiteSpace(motivoTerminacionParcial))
                                    {
                                        <div class="mt-2">
                                            <strong>Motivo:</strong>
                                            @motivoTerminacionParcial
                                        </div>
                                    }

                                    @if (fechaAutorizacionTerminacionParcial.HasValue)
                                    {
                                        <div class="small text-muted mt-1">
                                            Autorizado el @fechaAutorizacionTerminacionParcial.Value.ToString("dd/MM/yyyy HH:mm")
                                        </div>
                                    }
                                </div>

                                <div class="mb-3">
                                    <div class="d-flex justify-content-between small mb-1">
                                        <strong>Piezas OK actuales</strong>
                                        <span>@e.CantidadOKTotal.ToString("N0") / @(e.CantidadPlaneada?.ToString("N0") ?? "-")</span>
                                    </div>

                                    @if (faltantesOk > 0)
                                    {
                                        <div class="text-warning fw-bold small">
                                            <i class="bi bi-info-circle me-1"></i>
                                            Faltan @faltantesOk.ToString("N0") pieza(s) OK para la meta normal; por eso este cierre será parcial.
                                        </div>
                                    }
                                </div>

                                @if (puedeEjecutarTerminacionParcial)
                                {
                                    <form method="post" action="@Url.Action("Terminar","Produccion")">
                                        @Html.AntiForgeryToken()

                                        <input type="hidden" name="EjecucionProduccionID" value="@e.EjecucionProduccionID" />
                                        <input type="hidden" name="TerminarParcial" value="true" />

                                        <div class="mb-3">
                                            <label class="form-label fw-bold">
                                                Observaciones del cierre
                                            </label>

                                            <textarea name="Observaciones"
                                          rows="2"
                                          maxlength="500"
                                          class="form-control"
                                          placeholder="Observaciones de la ejecución física del cierre parcial..."></textarea>
                                        </div>

                                        <div class="alert alert-danger small">
                                            <i class="bi bi-exclamation-octagon-fill me-1"></i>
                                            Al confirmar, esta OF quedará terminada parcialmente y no regresará después de finalizar la producción urgente.
                                        </div>

                                        <button type="submit"
                                                class="btn btn-danger w-100 btn-strong"
                                                onclick="return confirm('Planeación autorizó terminar parcialmente esta OF. ¿Confirmas que el cierre físico ya puede ejecutarse?');">
                                            <i class="bi bi-check2-circle me-1"></i>
                                            Ejecutar terminación parcial autorizada
                                        </button>
                                    </form>
                                }
                                else
                                {
                                    <div class="alert alert-info mb-0">
                                        <i class="bi bi-person-lock me-1"></i>
                                        La terminación parcial ya fue autorizada por Planeación, pero únicamente puede ejecutarla un Auxiliar o Técnico de Producción.
                                    </div>
                                }
                            }
                            else
                            {
                                <form method="post" action="@Url.Action("Terminar","Produccion")">
                                    @Html.AntiForgeryToken()

                                    <input type="hidden" name="EjecucionProduccionID" value="@e.EjecucionProduccionID" />
                                    <input type="hidden" name="TerminarParcial" value="false" />

                                    <div class="mb-3">
                                        <div class="d-flex justify-content-between small mb-1">
                                            <strong>Meta de piezas OK</strong>
                                            <span>@e.CantidadOKTotal.ToString("N0") / @(e.CantidadPlaneada?.ToString("N0") ?? "-")</span>
                                        </div>

                                        @if (!metaOkCumplida)
                                        {
                                            <div class="alert alert-warning mb-0">
                                                <i class="bi bi-hourglass-split me-1"></i>
                                                Esta OF todavía no puede terminar normalmente.
                                                Faltan <strong>@faltantesOk.ToString("N0") pieza(s) OK</strong>.
                                                El Scrap no cuenta para completar la meta de la OF.
                                            </div>
                                        }
                                        else
                                        {
                                            <div class="alert alert-success mb-0">
                                                <i class="bi bi-check-circle-fill me-1"></i>
                                                La meta de piezas OK ya fue alcanzada.
                                            </div>
                                        }
                                    </div>

                                    <div class="mb-3">
                                        <label class="form-label fw-bold">
                                            Observaciones
                                        </label>

                                        <textarea name="Observaciones"
                                          rows="2"
                                          maxlength="500"
                                          class="form-control"></textarea>
                                    </div>

                                    <button type="submit"
                                            class="btn btn-danger w-100 btn-strong"
                                            disabled="@(!metaOkCumplida)">
                                        <i class="bi bi-check2-circle me-1"></i>
                                        Terminar producción
                                    </button>
                                </form>
                            }
                        </div>
                    </div>
                }

            </div>

            <div class="col-12 col-xl-8">

                <div class="panel mb-4" id="panelMateriales" data-collapsible data-default-open="false">
                    <div class="panel-header d-flex flex-wrap justify-content-between align-items-center gap-2">
                        <span>
                            <i class="bi bi-box-seam me-1"></i>
                            Entregas de Almacén contra OF
                        </span>

                        <span class="badge bg-primary">
                            @(Model.RecepcionesOF?.Count ?? 0) movimiento(s)
                        </span>
                    </div>

                    <div class="panel-body">
                        <div class="almacen-note mb-3">
                            <i class="bi bi-arrow-repeat me-1"></i>
                            Esta información se obtiene automáticamente de los movimientos de Almacén.
                            Las salidas y consumos representan entregas a Producción; los retornos se muestran con cantidad negativa.
                        </div>

                        <div class="table-responsive">
                            <table class="table table-hover align-middle mb-0">
                                <thead>
                                    <tr>
                                        <th>Tipo</th>
                                        <th>Movimiento</th>
                                        <th>Código / descripción</th>
                                        <th>Lote / tipo MP</th>
                                        <th class="text-end">Cantidad</th>
                                        <th>Entregó / recibió</th>
                                        <th>Fecha</th>
                                        <th>OF / referencia</th>
                                        <th>Observaciones</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @if (Model.RecepcionesOF == null || !Model.RecepcionesOF.Any())
                                    {
                                        <tr>
                                            <td colspan="9" class="text-center text-muted py-4">
                                                <i class="bi bi-inbox fs-4 d-block mb-2"></i>
                                                Almacén todavía no registra entregas para esta OF.
                                            </td>
                                        </tr>
                                    }
                                    else
                                    {
                                        foreach (var r in Model.RecepcionesOF)
                                        {
                                            var esRetorno = string.Equals(
                                            r.TipoMovimiento,
                                            "Retorno",
                                            StringComparison.OrdinalIgnoreCase);

                                            var claseMovimiento = esRetorno
                                            ? "badge bg-warning text-dark"
                                            : string.Equals(r.TipoMovimiento, "Consumo", StringComparison.OrdinalIgnoreCase)
                                            ? "badge bg-info text-dark"
                                            : "badge bg-success";

                                            <tr class="@(esRetorno ? "movimiento-retorno" : "")">
                                                <td>
                                                    <span class="@TipoClase(r.TipoRecepcion)">
                                                        @r.TextoTipo
                                                    </span>
                                                </td>

                                                <td>
                                                    <span class="@claseMovimiento">
                                                        @Txt(r.TipoMovimiento)
                                                    </span>
                                                    <div class="text-muted small mt-1">
                                                        Movimiento #@r.MovimientoID
                                                    </div>
                                                </td>

                                                <td>
                                                    <div class="fw-bold">@Txt(r.Codigo)</div>
                                                    <div class="text-muted small">@Txt(r.Descripcion)</div>
                                                </td>

                                                <td>
                                                    <div><strong>Lote:</strong> @Txt(r.Lote)</div>
                                                    <div class="text-muted small">
                                                        <strong>Tipo MP:</strong> @Txt(r.NumeroUI)
                                                    </div>
                                                </td>

                                                <td class="text-end fw-bold @(esRetorno ? "text-danger" : "text-success")">
                                                    @Dec4(r.Cantidad)
                                                    <div class="text-muted small">@Txt(r.Unidad)</div>
                                                </td>

                                                <td>
                                                    <div><strong>Entregó:</strong> @Txt(r.EntregadoPor)</div>
                                                    <div class="text-muted small">
                                                        <strong>Recibió:</strong> @Txt(r.RecibidoPor)
                                                    </div>
                                                </td>

                                                <td>
                                                    @r.FechaRecepcion.ToString("dd/MM/yyyy HH:mm")
                                                </td>

                                                <td>
                                                    <div><strong>OF:</strong> @Txt(r.NumeroOF)</div>
                                                    <div class="text-muted small text-break">
                                                        <strong>Ref.:</strong> @Txt(r.ReferenciaOperacion)
                                                    </div>
                                                </td>

                                                <td>
                                                    @Txt(r.Observaciones)
                                                </td>
                                            </tr>
                                        }
                                    }
                                </tbody>
                            </table>
                        </div>
                    </div>
                </div>

                @if (puedeVerCapturasHora)
                {
                    var registrosOrdenados = Model.RegistrosHora
                    .OrderByDescending(x => x.FechaProduccion)
                    .ThenByDescending(x => x.HoraInicio)
                    .ThenByDescending(x => x.RegistroHoraID)
                    .ToList();
                    var indiceCaptura = 0;

                    <div class="panel mb-4" id="panelCapturas" data-collapsible data-default-open="@(accionActual == "SEGUIMIENTO" ? "true" : "false")">
                        <div class="panel-header d-flex flex-wrap justify-content-between align-items-center gap-2">
                            <span>
                                <i class="bi bi-clock-history me-1"></i>
                                Capturas de producción
                            </span>
                            <div class="d-flex flex-wrap gap-2">
                                <span class="badge bg-primary">@registrosOrdenados.Count registro(s)</span>
                                @if (cortesTiempoExtra > 0)
                                {
                                    <span class="badge bg-purple text-white" style="background:#7c3aed!important;">@cortesTiempoExtra tiempo extra</span>
                                }
                                @if (registrosOrdenados.Any(x => x.TieneAjustesProduccion))
                                {
                                    <span class="badge bg-warning text-dark">@registrosOrdenados.Count(x => x.TieneAjustesProduccion) ajustada(s)</span>
                                }
                            </div>
                        </div>

                        <div class="capture-list">
                            @if (!registrosOrdenados.Any())
                            {
                                <div class="text-center text-muted py-4">
                                    <i class="bi bi-inbox fs-4 d-block mb-2"></i>
                                    Sin capturas registradas.
                                </div>
                            }
                            else
                            {
                                @if (puedeCorregirCapturasHora && !ejecucionPermiteCorregirCapturas)
                                {
                                    <div class="alert alert-secondary mb-0">
                                        <i class="bi bi-lock me-1"></i>
                                        Las capturas conservan su historial, pero esta ejecución ya no está en un estado que permita correcciones operativas.
                                    </div>
                                }

                                foreach (var r in registrosOrdenados)
                                {
                                    indiceCaptura++;
                                    var objetivoRegistro = r.ObjetivoBloque ?? r.ObjetivoHora;
                                    var piezasFisicas = r.PiezasCalculadasContador ?? r.TotalCapturado;
                                    var minutosRegistro = r.MinutosProductivos;
                                    if (!minutosRegistro.HasValue)
                                    {
                                        var duracion = r.HoraFin >= r.HoraInicio
                                        ? r.HoraFin - r.HoraInicio
                                        : (TimeSpan.FromDays(1) - r.HoraInicio) + r.HoraFin;
                                        minutosRegistro = Convert.ToDecimal(duracion.TotalMinutes);
                                    }
                                    var ocultarInicial = indiceCaptura > 8;
                                    var idSegmentos = $"segmentosRegistro_{r.RegistroHoraID}";
                                    var idAjustes = $"ajustesRegistro_{r.RegistroHoraID}";
                                    var ajustes = r.AjustesProduccion?.Where(x => x.Activo).OrderByDescending(x => x.FechaAjuste).ThenByDescending(x => x.AjusteProduccionID).ToList() ?? new List<ERP.NSQuell.Models.ProduccionRegistroHoraAjusteProduccionVm>();
                                    var primerAjuste = ajustes.OrderBy(x => x.FechaAjuste).ThenBy(x => x.AjusteProduccionID).FirstOrDefault();
                                    var tieneOriginalCapturado = r.CantidadOKOriginal != 0 || r.CantidadScrapOriginal != 0 || (r.CantidadOK == 0 && r.CantidadScrap == 0);
                                    var verdesOriginales = tieneOriginalCapturado ? r.CantidadOKOriginal : primerAjuste?.OKAntes ?? r.CantidadOK;
                                    var rojasOriginales = tieneOriginalCapturado ? r.CantidadScrapOriginal : primerAjuste?.ScrapAntes ?? r.CantidadScrap;
                                    var diferenciaNoLocalizada = Math.Max(0, piezasFisicas - r.CantidadOK - r.CantidadScrap);

                                    <article class="capture-card @(r.EsTiempoExtra ? "is-extra" : "is-normal") @(ocultarInicial ? "capture-hidden" : "")" data-capture-card>
                                        <div class="capture-heading">
                                            <div class="d-flex flex-wrap align-items-center gap-2">
                                                <span class="capture-type @(r.EsTiempoExtra ? "extra" : "")">
                                                    <i class="bi @(r.EsTiempoExtra ? "bi-stopwatch" : "bi-clock")"></i>
                                                    @if (r.EsTiempoExtra)
                                                    {
                                                        <text>@(string.IsNullOrWhiteSpace(r.TipoBloque) ? "TIEMPO EXTRA" : r.TipoBloque.Replace("_", " "))</text>
                                                    }
                                                    else
                                                    {
                                                        <text>CAPTURA NORMAL</text>
                                                    }
                                                </span>
                                                <span class="capture-time">@r.FechaProduccion.ToString("dd/MM/yyyy") · @r.RangoHora</span>
                                                @if (ajustes.Any())
                                                {
                                                    <span class="capture-adjusted-badge"><i class="bi bi-pencil-square"></i>Ajustada por Producción</span>
                                                }
                                            </div>

                                            <div class="capture-adjust-actions">
                                                @if (!objetivoRegistro.HasValue || objetivoRegistro.Value <= 0)
                                                {
                                                    <span class="objective-result neutral"><span>Sin objetivo</span><small>No evaluable</small></span>
                                                }
                                                else if (r.CumplioObjetivo == true)
                                                {
                                                    <span class="objective-result ok"><span><i class="bi bi-check-circle me-1"></i>Cumplió</span><small>@(r.PorcentajeCumplimiento?.ToString("0.#") ?? "-")%</small></span>
                                                }
                                                else
                                                {
                                                    <span class="objective-result fail"><span><i class="bi bi-x-circle me-1"></i>No cumplió</span><small>@(r.PorcentajeCumplimiento?.ToString("0.#") ?? "-")%</small></span>
                                                }

                                                @if (puedeCorregirCapturasAhora)
                                                {
                                                    <button type="button"
                                                            class="btn btn-sm btn-outline-warning fw-bold"
                                                            data-ajustar-captura
                                                            data-registro-id="@r.RegistroHoraID"
                                                            data-ejecucion-id="@r.EjecucionProduccionID"
                                                            data-fecha="@r.FechaProduccion.ToString("dd/MM/yyyy")"
                                                            data-rango="@r.RangoHora"
                                                            data-fisicas="@piezasFisicas"
                                                            data-ok="@r.CantidadOK"
                                                            data-scrap="@r.CantidadScrap"
                                                            data-original-ok="@verdesOriginales"
                                                            data-original-scrap="@rojasOriginales"
                                                            data-bs-toggle="modal"
                                                            data-bs-target="#modalCorregirCapturaHora">
                                                        <i class="bi bi-pencil-square me-1"></i>Corregir cantidades
                                                    </button>
                                                }
                                            </div>
                                        </div>

                                        <div class="capture-grid">
                                            <div class="capture-stat">
                                                <div class="capture-stat-label">Físicas máquina</div>
                                                <div class="capture-stat-value">@piezasFisicas.ToString("N0")</div>
                                            </div>
                                            <div class="capture-stat">
                                                <div class="capture-stat-label">Verdes / OK</div>
                                                <div class="capture-stat-value text-success">@r.CantidadOK.ToString("N0")</div>
                                            </div>
                                            <div class="capture-stat">
                                                <div class="capture-stat-label">Rojas / Scrap</div>
                                                <div class="capture-stat-value text-danger">@r.CantidadScrap.ToString("N0")</div>
                                            </div>
                                            <div class="capture-stat">
                                                <div class="capture-stat-label">No localizadas</div>
                                                <div class="capture-stat-value @(diferenciaNoLocalizada > 0 ? "text-warning" : "")">@diferenciaNoLocalizada.ToString("N0")</div>
                                            </div>
                                            <div class="capture-stat">
                                                <div class="capture-stat-label">Min. productivos</div>
                                                <div class="capture-stat-value">@minutosRegistro.Value.ToString("0.##")</div>
                                            </div>
                                            <div class="capture-stat">
                                                <div class="capture-stat-label">Contador</div>
                                                <div class="capture-stat-value">@(r.ContadorInicial?.ToString("N0") ?? "-") → @(r.ContadorFinal?.ToString("N0") ?? "-")</div>
                                            </div>
                                            <div class="capture-stat">
                                                <div class="capture-stat-label">Objetivo</div>
                                                <div class="capture-stat-value">@(objetivoRegistro?.ToString("N0") ?? "-")</div>
                                            </div>
                                        </div>

                                        @if (diferenciaNoLocalizada > 0)
                                        {
                                            <div class="alert alert-warning py-2 px-3 mt-2 mb-0 small">
                                                <i class="bi bi-exclamation-triangle me-1"></i>
                                                La máquina registró @piezasFisicas.ToString("N0") pieza(s), pero el dato operativo vigente conserva @(r.CantidadOK + r.CantidadScrap).ToString("N0"). La diferencia de @diferenciaNoLocalizada.ToString("N0") pieza(s) quedó como pérdida/no localizada sin alterar el contador físico.
                                            </div>
                                        }

                                        @if (!string.IsNullOrWhiteSpace(r.Observaciones))
                                        {
                                            <div class="capture-observation">
                                                <i class="bi bi-chat-left-text me-1"></i>@r.Observaciones
                                            </div>
                                        }

                                        @if (r.TieneCambioConfiguracion || r.TieneReinicioContador || (r.Segmentos?.Count ?? 0) > 1)
                                        {
                                            <div class="d-flex flex-wrap gap-2 mt-2">
                                                @if (r.TieneCambioConfiguracion)
                                                {
                                                    <span class="badge bg-info text-dark"><i class="bi bi-sliders me-1"></i>Cambio de configuración</span>
                                                }
                                                @if (r.TieneReinicioContador)
                                                {
                                                    <span class="badge bg-warning text-dark"><i class="bi bi-arrow-counterclockwise me-1"></i>Reinicio de contador</span>
                                                }
                                                @if ((r.Segmentos?.Count ?? 0) > 1)
                                                {
                                                    <span class="badge bg-secondary">@r.Segmentos.Count segmentos</span>
                                                }
                                            </div>
                                        }

                                        <div class="d-flex flex-wrap gap-2 mt-2">
                                            @if (r.Segmentos != null && r.Segmentos.Any())
                                            {
                                                <button type="button" class="btn btn-sm btn-outline-secondary fw-bold" data-bs-toggle="collapse" data-bs-target="#@idSegmentos" aria-expanded="false">
                                                    <i class="bi bi-diagram-3 me-1"></i>Ver detalle técnico
                                                </button>
                                            }
                                            @if (ajustes.Any())
                                            {
                                                <button type="button" class="btn btn-sm btn-outline-warning fw-bold" data-bs-toggle="collapse" data-bs-target="#@idAjustes" aria-expanded="false">
                                                    <i class="bi bi-clock-history me-1"></i>Historial de ajustes (@ajustes.Count)
                                                </button>
                                            }
                                        </div>

                                        @if (r.Segmentos != null && r.Segmentos.Any())
                                        {
                                            <div class="capture-segments collapse" id="@idSegmentos">
                                                <div class="segment-grid">
                                                    @foreach (var s in r.Segmentos.OrderBy(x => x.NumeroSegmento))
                                                    {
                                                        <div class="segment-card">
                                                            <div class="d-flex justify-content-between gap-2">
                                                                <strong>Segmento @s.NumeroSegmento</strong>
                                                                <span>@s.Rango</span>
                                                            </div>
                                                            <div class="mt-1">Contador: <strong>@s.ContadorInicial.ToString("N0") → @s.ContadorFinal.ToString("N0")</strong></div>
                                                            <div>Cavidades: <strong>@s.CavidadesUsadas</strong> · Ciclo: <strong>@s.TiempoCicloSegundos.ToString("0.####") s</strong></div>
                                                            <div>Piezas: <strong>@s.PiezasCalculadas.ToString("N0")</strong> · Min: <strong>@s.MinutosProductivos.ToString("0.##")</strong></div>
                                                            @if (!string.IsNullOrWhiteSpace(s.Observaciones))
                                                            {
                                                                <div class="mt-1 text-warning">@s.Observaciones</div>
                                                            }
                                                        </div>
                                                    }
                                                </div>
                                            </div>
                                        }

                                        @if (ajustes.Any())
                                        {
                                            <div class="collapse" id="@idAjustes">
                                                <div class="capture-history">
                                                    @foreach (var ajuste in ajustes)
                                                    {
                                                        <div class="capture-history-item">
                                                            <div class="d-flex flex-wrap justify-content-between align-items-start gap-2">
                                                                <div>
                                                                    <div class="fw-bold"><i class="bi bi-pencil-square me-1"></i>Ajuste de Producción</div>
                                                                    <div class="muted-small">@ajuste.FechaAjuste.ToString("dd/MM/yyyy HH:mm") · @Txt(ajuste.UsuarioAjusteNombre)</div>
                                                                </div>
                                                                <div class="d-flex flex-wrap gap-1">
                                                                    @if (ajuste.DiferenciaOK != 0)
                                                                    {
                                                                        <span class="badge @(ajuste.DiferenciaOK > 0 ? "bg-success" : "bg-danger")">Bonus @(ajuste.DiferenciaOK > 0 ? "+" : "")@ajuste.DiferenciaOK.ToString("N0")</span>
                                                                    }
                                                                    @if (ajuste.MovimientoBonusID.HasValue)
                                                                    {
                                                                        <span class="badge bg-secondary">Mov. #@ajuste.MovimientoBonusID.Value</span>
                                                                    }
                                                                </div>
                                                            </div>
                                                            <div class="capture-history-values">
                                                                <div class="capture-history-value">
                                                                    <div class="data-label">Verdes / OK</div>
                                                                    <div class="fw-bold text-success">@ajuste.OKAntes.ToString("N0") → @ajuste.OKDespues.ToString("N0")</div>
                                                                </div>
                                                                <div class="capture-history-value">
                                                                    <div class="data-label">Rojas / Scrap</div>
                                                                    <div class="fw-bold text-danger">@ajuste.ScrapAntes.ToString("N0") → @ajuste.ScrapDespues.ToString("N0")</div>
                                                                </div>
                                                            </div>
                                                            <div class="capture-history-motive"><strong>Motivo:</strong> @ajuste.Motivo</div>
                                                        </div>
                                                    }
                                                </div>
                                            </div>
                                        }
                                    </article>
                                }

                                @if (registrosOrdenados.Count > 8)
                                {
                                    <button type="button" class="btn btn-outline-primary btn-strong" data-capture-show-all>
                                        <i class="bi bi-chevron-down me-1"></i>
                                        Mostrar @(registrosOrdenados.Count - 8) captura(s) anteriores
                                    </button>
                                }
                            }
                        </div>
                    </div>
                }

                <div class="panel" id="panelHistorialParos" data-collapsible data-default-open="false">
                    <div class="panel-header">
                        <i class="bi bi-pause-circle me-1"></i>
                        Historial de paros
                    </div>

                    <div class="table-responsive">
                        <table class="table table-hover mb-0 align-middle">
                            <thead>
                                <tr>
                                    <th>Inicio</th>
                                    <th>Fin</th>
                                    <th>Duración</th>
                                    <th>Motivo</th>
                                    <th>Mayor a 15 min</th>
                                    <th>Descripción</th>
                                </tr>
                            </thead>
                            <tbody>
                                @if (!Model.Paros.Any())
                                {
                                    <tr>
                                        <td colspan="6" class="text-center text-muted py-4">
                                            Sin paros registrados.
                                        </td>
                                    </tr>
                                }
                                else
                                {
                                    foreach (var p in Model.Paros)
                                    {
                                        <tr>
                                            <td>@p.FechaInicioParo.ToString("dd/MM/yyyy HH:mm")</td>
                                            <td>@(p.FechaFinParo?.ToString("dd/MM/yyyy HH:mm") ?? "Abierto")</td>
                                            <td class="fw-bold">@p.DuracionTexto</td>
                                            <td>@p.MotivoParoTexto</td>
                                            <td>
                                                @if (p.EsMayorA15Minutos)
                                                {
                                                    <span class="badge bg-danger">Sí</span>
                                                }
                                                else
                                                {
                                                    <span class="badge bg-secondary">No</span>
                                                }
                                            </td>
                                            <td>@p.Descripcion</td>
                                        </tr>
                                    }
                                }
                            </tbody>
                        </table>
                    </div>
                </div>

            </div>
        </div>

    </div>

    @if (Model.MostrarAvisoMonitoreoTurno && monitoreoTurno != null)
    {
        <div class="modal fade" id="modalMonitoreoTurno" tabindex="-1" aria-labelledby="modalMonitoreoTurnoLabel" aria-hidden="true" data-bs-backdrop="static" data-bs-keyboard="false">
            <div class="modal-dialog modal-dialog-centered">
                <div class="modal-content">
                    <div class="modal-header modal-monitor-header">
                        <h5 class="modal-title fw-bold" id="modalMonitoreoTurnoLabel"><i class="bi bi-exclamation-triangle me-2"></i>Cambio de turno detectado</h5>
                        <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Cerrar"></button>
                    </div>
                    <div class="modal-body p-4">
                        <div class="modal-monitor-icon"><i class="bi bi-cpu"></i></div>
                        <h4 class="text-center fw-bold text-danger mb-2">Monitoreo de periféricos pendiente</h4>
                        <p class="text-center text-muted mb-4">Completa el formato <strong>GQ-F-PR01-14 Ver.01</strong> correspondiente al turno actual.</p>
                        <div class="soft-box mb-3">
                            <div class="row g-3">
                                <div class="col-6"><div class="data-label">Turno</div><div class="data-value">@Txt(monitoreoTurno.TurnoNombre)</div></div>
                                <div class="col-6"><div class="data-label">Fecha operativa</div><div class="data-value">@monitoreoTurno.FechaOperacion.ToString("dd/MM/yyyy")</div></div>
                                <div class="col-12"><div class="data-label">Máquina</div><div class="data-value">@Txt(monitoreoTurno.MaquinaCodigo) · @Txt(monitoreoTurno.MaquinaNombre)</div></div>
                            </div>
                        </div>
                        <div class="row g-2 mb-3">
                            <div class="col-6"><div class="mini-stat"><div class="mini-stat-label">Verificaciones</div><div class="mini-stat-value">@monitoreoTurno.TotalConfirmadas / @monitoreoTurno.TotalPreguntas</div></div></div>
                            <div class="col-6"><div class="mini-stat"><div class="mini-stat-label">Entrega de turno</div><div class="mini-stat-value fs-6 @(monitoreoTurno.EntregaTurnoRegistrada ? "text-success" : "text-warning")">@(monitoreoTurno.EntregaTurnoRegistrada ? "Registrada" : "Pendiente")</div></div></div>
                        </div>
                        <div class="alert alert-warning mb-0"><i class="bi bi-info-circle me-1"></i>Si cierras esta advertencia, volverá a mostrarse al recargar mientras el monitoreo siga pendiente.</div>
                    </div>
                    <div class="modal-footer border-0 pt-0 px-4 pb-4">
                        <button type="button" class="btn btn-light btn-strong" data-bs-dismiss="modal">Continuar después</button>
                        <a href="@Url.Action("ChecklistFormato", "Produccion", new { id = monitoreoTurno.ChecklistArranqueID })" class="btn btn-warning btn-strong"><i class="bi bi-clipboard-check me-1"></i>Realizar monitoreo</a>
                    </div>
                </div>
            </div>
        </div>
    }

    @if (e.PuedePausar || Model.TieneParoAbierto)
    {
        <div class="modal fade"
             id="modalCambiarOperador"
             tabindex="-1"
             aria-labelledby="modalCambiarOperadorLabel"
             aria-hidden="true">

            <div class="modal-dialog modal-dialog-centered">
                <div class="modal-content">

                    <form method="post"
                          action="@Url.Action("CambiarOperadores","Produccion")"
                          id="formCambiarOperador">

                        @Html.AntiForgeryToken()

                        <div class="modal-header">
                            <div>
                                <h5 class="modal-title fw-bold"
                                    id="modalCambiarOperadorLabel">
                                    <i class="bi bi-people me-1"></i>
                                    Cambiar operador
                                </h5>

                                <div class="text-muted small mt-1">
                                    Selecciona qué asignación deseas modificar.
                                </div>
                            </div>

                            <button type="button"
                                    class="btn-close"
                                    data-bs-dismiss="modal"
                                    aria-label="Cerrar">
                            </button>
                        </div>

                        <div class="modal-body">

                            <input type="hidden"
                                   name="ejecucionProduccionId"
                                   value="@e.EjecucionProduccionID" />

                            <div class="soft-box mb-3">
                                <div class="row g-2">

                                    <div class="col-12">
                                        <div class="data-label">
                                            Operador principal actual
                                        </div>

                                        <div class="data-value">
                                            @Txt(e.OperadorNombre)
                                        </div>
                                    </div>

                                    <div class="col-12">
                                        <div class="data-label">
                                            Auxiliar actual
                                        </div>

                                        <div class="data-value">
                                            @(string.IsNullOrWhiteSpace(
                                                                                    e.OperadorAuxiliarNombre)
                                                                                    ? "Sin auxiliar"
                                                                                    : e.OperadorAuxiliarNombre)
                                    </div>
                                </div>

                                </div>
                            </div>

                            <div class="mb-3">
                                <label class="form-label">
                                    ¿Qué deseas cambiar?
                                </label>

                                <div class="d-flex gap-3 flex-wrap">

                                    <div class="form-check">
                                        <input class="form-check-input"
                                               type="radio"
                                               name="tipoCambio"
                                               id="tipoCambioPrincipal"
                                               value="PRINCIPAL"
                                               checked />

                                        <label class="form-check-label fw-bold"
                                               for="tipoCambioPrincipal">
                                            Operador principal
                                        </label>
                                    </div>

                                    <div class="form-check">
                                        <input class="form-check-input"
                                               type="radio"
                                               name="tipoCambio"
                                               id="tipoCambioAuxiliar"
                                               value="AUXILIAR" />

                                        <label class="form-check-label fw-bold"
                                               for="tipoCambioAuxiliar">
                                            Auxiliar
                                        </label>
                                    </div>

                                </div>
                            </div>

                            <div class="mb-3">
                                <label class="form-label"
                                       for="personaNuevaId">
                                    Nueva persona
                                </label>

                                <select name="personaNuevaId"
                                        id="personaNuevaId"
                                        class="form-select"
                                        required>

                                    <option value="">
                                        -- Seleccionar persona --
                                    </option>

                                @if (ViewBag.OperadoresProduccion
                                                                is IEnumerable<SelectListItem> operadores)
                                    {
                                        foreach (var operador in operadores)
                                        {
                                            if (!string.IsNullOrWhiteSpace(
                                            operador.Value))
                                            {
                                                <option value="@operador.Value">
                                                    @operador.Text
                                                </option>
                                            }
                                        }
                                    }

                                </select>
                            </div>

                            <div class="mb-0">
                                <label class="form-label"
                                       for="motivoCambio">
                                    Motivo del cambio *
                                </label>

                                <textarea name="motivoCambio"
                                      id="motivoCambio"
                                      class="form-control"
                                      rows="3"
                                      maxlength="1000"
                                      required
                                      placeholder="Ej. cambio de puesto, cobertura de descanso, ajuste de asignación, ausencia, etc."></textarea>

                                <div class="form-text">
                                    El motivo es obligatorio y quedará registrado
                                    en la bitácora de la ejecución.
                                </div>
                            </div>

                        </div>

                        <div class="modal-footer">
                            <button type="button"
                                    class="btn btn-light fw-bold"
                                    data-bs-dismiss="modal">
                                Cancelar
                            </button>

                            <button type="submit"
                                    class="btn btn-primary fw-bold">
                                <i class="bi bi-check2-circle me-1"></i>
                                Guardar cambio
                            </button>
                        </div>

                    </form>

                </div>
            </div>
        </div>
    }

    @if (puedeCorregirCapturasAhora)
    {
        <div class="modal fade" id="modalCorregirCapturaHora" tabindex="-1" aria-labelledby="modalCorregirCapturaHoraLabel" aria-hidden="true">
            <div class="modal-dialog modal-lg modal-dialog-centered modal-dialog-scrollable">
                <div class="modal-content">
                    <form method="post" action="@Url.Action("CorregirCapturaHora","Produccion")" id="formCorregirCapturaHora">
                        @Html.AntiForgeryToken()
                        <div class="modal-header">
                            <div>
                                <h5 class="modal-title fw-bold" id="modalCorregirCapturaHoraLabel">
                                    <i class="bi bi-pencil-square me-1"></i>Corregir cantidades de producción
                                </h5>
                                <div class="text-muted small mt-1">El contador de máquina no se modifica. Cada corrección conserva antes/después, motivo, usuario, fecha y movimiento de bonus.</div>
                            </div>
                            <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Cerrar"></button>
                        </div>
                        <div class="modal-body">
                            <input type="hidden" name="EjecucionProduccionID" id="ajusteEjecucionProduccionID" value="@e.EjecucionProduccionID" />
                            <input type="hidden" name="RegistroHoraID" id="ajusteRegistroHoraID" />

                            <div class="adjust-summary mb-3">
                                <div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-2">
                                    <div>
                                        <div class="data-label">Captura seleccionada</div>
                                        <div class="data-value" id="ajusteCapturaTexto">-</div>
                                    </div>
                                    <span class="badge bg-secondary" id="ajusteRegistroBadge">Registro -</span>
                                </div>
                                <div class="adjust-summary-grid">
                                    <div class="adjust-summary-item">
                                        <div class="adjust-summary-label">Físicas máquina</div>
                                        <div class="adjust-summary-value" id="ajusteFisicas">0</div>
                                    </div>
                                    <div class="adjust-summary-item">
                                        <div class="adjust-summary-label">Verdes originales</div>
                                        <div class="adjust-summary-value text-success" id="ajusteOriginalOK">0</div>
                                    </div>
                                    <div class="adjust-summary-item">
                                        <div class="adjust-summary-label">Rojas originales</div>
                                        <div class="adjust-summary-value text-danger" id="ajusteOriginalScrap">0</div>
                                    </div>
                                    <div class="adjust-summary-item">
                                        <div class="adjust-summary-label">No localizadas actuales</div>
                                        <div class="adjust-summary-value text-warning" id="ajusteNoLocalizadasActual">0</div>
                                    </div>
                                </div>
                            </div>

                            <div class="alert alert-info py-2 px-3 small">
                                <i class="bi bi-speedometer2 me-1"></i>
                                El valor de <strong>piezas físicas</strong> proviene del contador de máquina y queda como referencia histórica. Puedes reducir verdes o rojas cuando físicamente faltaron piezas; la diferencia quedará visible como no localizada/pérdida.
                            </div>

                            <div class="row g-3">
                                <div class="col-12 col-md-6">
                                    <label class="form-label" for="ajusteCantidadOK">Verdes / OK vigentes *</label>
                                    <input type="number" min="0" step="1" class="form-control form-control-lg fw-bold" id="ajusteCantidadOK" name="CantidadOK" required />
                                    <div class="form-text">El cambio en verdes ajustará el bonus del operador con un movimiento +/-, sin borrar el movimiento original.</div>
                                </div>
                                <div class="col-12 col-md-6">
                                    <label class="form-label" for="ajusteCantidadScrap">Rojas / Scrap vigentes *</label>
                                    <input type="number" min="0" step="1" class="form-control form-control-lg fw-bold" id="ajusteCantidadScrap" name="CantidadScrap" required />
                                    <div class="form-text">Si el Scrap ya tiene defectos clasificados, el backend protegerá esa clasificación y no permitirá inconsistencias.</div>
                                </div>
                                <div class="col-12">
                                    <div class="adjust-preview" id="ajustePreview">Modifica una cantidad para ver el impacto.</div>
                                </div>
                                <div class="col-12">
                                    <label class="form-label" for="ajusteMotivo">Motivo de la corrección *</label>
                                    <textarea class="form-control" id="ajusteMotivo" name="Motivo" rows="3" minlength="5" maxlength="1000" required placeholder="Ej. se detectaron 12 piezas caídas durante traslado; el conteo físico real fue menor al dato reportado por máquina."></textarea>
                                    <div class="form-text">Mínimo 5 caracteres. El motivo quedará permanentemente en el historial.</div>
                                </div>
                            </div>
                        </div>
                        <div class="modal-footer">
                            <button type="button" class="btn btn-light fw-bold" data-bs-dismiss="modal">Cancelar</button>
                            <button type="submit" class="btn btn-warning fw-bold" id="btnGuardarAjusteCaptura" disabled>
                                <i class="bi bi-check2-circle me-1"></i>Guardar corrección
                            </button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    }

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
    <script>
        document.addEventListener('DOMContentLoaded', function () {
            const workspace = document.querySelector('[data-smart-workspace]');
            const zonaPrioritaria = document.getElementById('zonaPrioritaria');

            function abrirPanel(panel, desplazar) {
                if (!panel) return;
                panel.classList.remove('is-collapsed');
                const header = panel.querySelector(':scope > .panel-header');
                if (header) header.setAttribute('aria-expanded', 'true');
                if (desplazar) {
                    window.setTimeout(function () {
                        panel.scrollIntoView({ behavior: 'smooth', block: 'start' });
                    }, 40);
                }
            }

            if (workspace && zonaPrioritaria) {
                const selectorPrioridad = workspace.dataset.priorityTarget;
                if (selectorPrioridad) {
                    const panelPrioritario = document.querySelector(selectorPrioridad);
                    if (panelPrioritario) {
                        panelPrioritario.classList.add('smart-priority-panel');
                        zonaPrioritaria.appendChild(panelPrioritario);
                        abrirPanel(panelPrioritario, false);
                    }
                }
            }

            document.querySelectorAll('[data-smart-open]').forEach(function (button) {
                button.addEventListener('click', function () {
                    const selector = button.dataset.smartOpen;
                    if (!selector) return;
                    abrirPanel(document.querySelector(selector), true);
                });
            });

            const botonCapturas = document.querySelector('[data-capture-show-all]');
            if (botonCapturas) {
                botonCapturas.addEventListener('click', function () {
                    document.querySelectorAll('.capture-hidden').forEach(function (item) {
                        item.classList.add('is-visible');
                    });
                    botonCapturas.remove();
                });
            }

            const modalAjuste = document.getElementById('modalCorregirCapturaHora');
            const formAjuste = document.getElementById('formCorregirCapturaHora');
            const ajusteRegistroId = document.getElementById('ajusteRegistroHoraID');
            const ajusteEjecucionId = document.getElementById('ajusteEjecucionProduccionID');
            const ajusteCapturaTexto = document.getElementById('ajusteCapturaTexto');
            const ajusteRegistroBadge = document.getElementById('ajusteRegistroBadge');
            const ajusteFisicas = document.getElementById('ajusteFisicas');
            const ajusteOriginalOK = document.getElementById('ajusteOriginalOK');
            const ajusteOriginalScrap = document.getElementById('ajusteOriginalScrap');
            const ajusteNoLocalizadasActual = document.getElementById('ajusteNoLocalizadasActual');
            const ajusteCantidadOK = document.getElementById('ajusteCantidadOK');
            const ajusteCantidadScrap = document.getElementById('ajusteCantidadScrap');
            const ajusteMotivo = document.getElementById('ajusteMotivo');
            const ajustePreview = document.getElementById('ajustePreview');
            const btnGuardarAjuste = document.getElementById('btnGuardarAjusteCaptura');
            let ajusteFisicasReferencia = 0;
            let ajusteOKActual = 0;
            let ajusteScrapActual = 0;

            function enteroAjuste(value) {
                const numero = Number.parseInt(value ?? '0', 10);
                return Number.isFinite(numero) ? numero : 0;
            }

            function formatearAjuste(value) {
                return enteroAjuste(value).toLocaleString('es-MX');
            }

            function validarAjusteCaptura() {
                if (!formAjuste || !ajusteCantidadOK || !ajusteCantidadScrap || !ajustePreview || !btnGuardarAjuste) return;
                const ok = enteroAjuste(ajusteCantidadOK.value);
                const scrap = enteroAjuste(ajusteCantidadScrap.value);
                const motivo = (ajusteMotivo?.value || '').trim();
                const totalVigente = ok + scrap;
                const noLocalizadas = Math.max(0, ajusteFisicasReferencia - totalVigente);
                const diferenciaOK = ok - ajusteOKActual;
                const diferenciaScrap = scrap - ajusteScrapActual;
                const cambio = diferenciaOK !== 0 || diferenciaScrap !== 0;
                const cantidadesValidas = ok >= 0 && scrap >= 0 && totalVigente <= ajusteFisicasReferencia;
                const motivoValido = motivo.length >= 5 && motivo.length <= 1000;
                ajustePreview.classList.remove('is-valid', 'is-invalid');

                if (!cantidadesValidas) {
                    ajustePreview.classList.add('is-invalid');
                    ajustePreview.textContent = `La propuesta suma ${totalVigente.toLocaleString('es-MX')} pieza(s), pero la referencia de máquina es ${ajusteFisicasReferencia.toLocaleString('es-MX')}. No puedes superar el contador físico.`;
                }
                else if (!cambio) {
                    ajustePreview.textContent = 'No hay cambios respecto al valor vigente. Modifica verdes o rojas para continuar.';
                }
                else {
                    ajustePreview.classList.add('is-valid');
                    const bonus = diferenciaOK === 0 ? 'sin cambio en bonus' : `bonus ${(diferenciaOK > 0 ? '+' : '')}${diferenciaOK.toLocaleString('es-MX')}`;
                    ajustePreview.textContent = `Vigente propuesto: ${totalVigente.toLocaleString('es-MX')} pieza(s) · no localizadas/pérdida: ${noLocalizadas.toLocaleString('es-MX')} · ${bonus}.`;
                }
                btnGuardarAjuste.disabled = !(cantidadesValidas && cambio && motivoValido);
            }

            document.querySelectorAll('[data-ajustar-captura]').forEach(function (button) {
                button.addEventListener('click', function () {
                    const registroId = enteroAjuste(button.dataset.registroId);
                    const ejecucionId = enteroAjuste(button.dataset.ejecucionId);
                    ajusteFisicasReferencia = enteroAjuste(button.dataset.fisicas);
                    ajusteOKActual = enteroAjuste(button.dataset.ok);
                    ajusteScrapActual = enteroAjuste(button.dataset.scrap);
                    const originalOK = enteroAjuste(button.dataset.originalOk);
                    const originalScrap = enteroAjuste(button.dataset.originalScrap);
                    const noLocalizadasActual = Math.max(0, ajusteFisicasReferencia - ajusteOKActual - ajusteScrapActual);
                    if (ajusteRegistroId) ajusteRegistroId.value = registroId.toString();
                    if (ajusteEjecucionId) ajusteEjecucionId.value = ejecucionId.toString();
                    if (ajusteCapturaTexto) ajusteCapturaTexto.textContent = `${button.dataset.fecha || '-'} · ${button.dataset.rango || '-'}`;
                    if (ajusteRegistroBadge) ajusteRegistroBadge.textContent = `Registro #${registroId}`;
                    if (ajusteFisicas) ajusteFisicas.textContent = formatearAjuste(ajusteFisicasReferencia);
                    if (ajusteOriginalOK) ajusteOriginalOK.textContent = formatearAjuste(originalOK);
                    if (ajusteOriginalScrap) ajusteOriginalScrap.textContent = formatearAjuste(originalScrap);
                    if (ajusteNoLocalizadasActual) ajusteNoLocalizadasActual.textContent = formatearAjuste(noLocalizadasActual);
                    if (ajusteCantidadOK) ajusteCantidadOK.value = ajusteOKActual.toString();
                    if (ajusteCantidadScrap) ajusteCantidadScrap.value = ajusteScrapActual.toString();
                    if (ajusteMotivo) ajusteMotivo.value = '';
                    validarAjusteCaptura();
                });
            });

            [ajusteCantidadOK, ajusteCantidadScrap, ajusteMotivo].forEach(function (input) {
                input?.addEventListener('input', validarAjusteCaptura);
            });

            formAjuste?.addEventListener('submit', function (event) {
                validarAjusteCaptura();
                if (btnGuardarAjuste?.disabled) {
                    event.preventDefault();
                    return;
                }
                if (!window.confirm('¿Confirmas guardar esta corrección? Se actualizarán los totales de la OF y, si cambian las piezas verdes, se generará el movimiento correspondiente en el bonus del operador.')) {
                    event.preventDefault();
                    return;
                }
                btnGuardarAjuste.disabled = true;
                btnGuardarAjuste.innerHTML = '<span class="spinner-border spinner-border-sm me-1"></span>Guardando...';
            });

            modalAjuste?.addEventListener('hidden.bs.modal', function () {
                formAjuste?.reset();
                ajusteFisicasReferencia = 0;
                ajusteOKActual = 0;
                ajusteScrapActual = 0;
                if (ajustePreview) {
                    ajustePreview.classList.remove('is-valid', 'is-invalid');
                    ajustePreview.textContent = 'Modifica una cantidad para ver el impacto.';
                }
                if (btnGuardarAjuste) btnGuardarAjuste.disabled = true;
            });

            document.querySelectorAll('.panel[data-collapsible]').forEach(function (panel) {
                const header = panel.querySelector(':scope > .panel-header');
                const abierto = panel.classList.contains('smart-priority-panel') || panel.dataset.defaultOpen === 'true';

                panel.classList.toggle('is-collapsed', !abierto);

                if (!header) return;

                header.setAttribute('role', 'button');
                header.setAttribute('tabindex', '0');
                header.setAttribute('aria-expanded', abierto ? 'true' : 'false');

                function alternar() {
                    const colapsado = panel.classList.toggle('is-collapsed');
                    header.setAttribute('aria-expanded', colapsado ? 'false' : 'true');
                }

                header.addEventListener('click', function (event) {
                    if (event.target.closest('a, button, input, select, textarea, label')) return;
                    alternar();
                });

                header.addEventListener('keydown', function (event) {
                    if (event.key !== 'Enter' && event.key !== ' ') return;
                    event.preventDefault();
                    alternar();
                });
            });

            document.querySelectorAll('[data-open-target]').forEach(function (link) {
                link.addEventListener('click', function () {
                    const selector = link.getAttribute('href');
                    if (!selector || !selector.startsWith('#')) return;

                    const panel = document.querySelector(selector);
                    if (!panel) return;

                    panel.classList.remove('is-collapsed');

                    const header = panel.querySelector(':scope > .panel-header');
                    if (header) header.setAttribute('aria-expanded', 'true');

                    window.setTimeout(function () {
                        panel.scrollIntoView({ behavior: 'smooth', block: 'start' });
                    }, 40);
                });
            });

                    document.querySelectorAll('form[data-config-form]').forEach(function (form) {
            const cavidades = form.querySelector('[data-config-cavidades]');
            const ciclo = form.querySelector('[data-config-ciclo]');
            const contador = form.querySelector('[data-config-contador]');
            const objetivo = form.querySelector('[data-config-objetivo]');
            const validacion = form.querySelector('[data-config-validation]');
            const motivo = form.querySelector('textarea[name="MotivoCambio"]');
            const preview = form.querySelector('[data-config-preview]');
            const previewLoading = form.querySelector('[data-config-preview-loading]');
            const previewTitle = form.querySelector('[data-config-preview-title]');
            const previewBadge = form.querySelector('[data-config-preview-badge]');
            const previewObjetivo = form.querySelector('[data-config-preview-objetivo]');
            const previewPendiente = form.querySelector('[data-config-preview-pendiente]');
            const previewTiempo = form.querySelector('[data-config-preview-tiempo]');
            const previewFin = form.querySelector('[data-config-preview-fin]');
            const previewImpacto = form.querySelector('[data-config-preview-impact]');
            const esCambio = form.action && form.action.toLowerCase().includes('cambiarconfiguracioncorrida');
            const ejecucionProduccionId = @e.EjecucionProduccionID;
            const previewUrl = '@Url.Action("PrevisualizarCambioConfiguracion", "Produccion")';
            let temporizadorPreview = null;
            let solicitudPreviewNumero = 0;

            function valorConDefault(input) {
                if (!input) return '';
                const actual = (input.value || '').trim();
                if (actual) return actual;
                return (input.dataset.defaultValue || '').trim();
            }

            function numeroFlexible(value) {
                if (!value) return NaN;
                return Number(String(value).replace(',', '.'));
            }

            function mostrarError(mensaje) {
                if (!validacion) return;
                validacion.textContent = mensaje || '';
                validacion.classList.toggle('is-visible', !!mensaje);
            }

            function numero(value, decimales = 0) {
                const n = Number(value);
                if (!Number.isFinite(n)) return '-';

                return n.toLocaleString('es-MX', {
                    minimumFractionDigits: decimales,
                    maximumFractionDigits: decimales
                });
            }

            function fechaHora(value) {
                if (!value) return '-';

                const fecha = new Date(value);

                if (Number.isNaN(fecha.getTime()))
                    return '-';

                return fecha.toLocaleString('es-MX', {
                    day: '2-digit',
                    month: '2-digit',
                    year: 'numeric',
                    hour: '2-digit',
                    minute: '2-digit',
                    hour12: false
                });
            }

            function recalcularObjetivo() {
                if (!objetivo) return;

                const cav = numeroFlexible(valorConDefault(cavidades));
                const cic = numeroFlexible(valorConDefault(ciclo));

                if (!Number.isFinite(cav) || cav <= 0 ||
                    !Number.isFinite(cic) || cic <= 0) {
                    objetivo.textContent = 'Objetivo estimado: pendiente de datos';
                    return;
                }

                const calculado = (3600 / cic) * cav;

                objetivo.textContent =
                    'Objetivo estimado: ' +
                    Math.round(calculado).toLocaleString('es-MX') +
                    ' pzas/h · (3600 / ' +
                    cic.toLocaleString('es-MX') +
                    ') × ' +
                    cav.toLocaleString('es-MX');
            }

            function limpiarPreview() {
                if (!preview) return;

                preview.classList.remove(
                    'is-visible',
                    'is-warning',
                    'is-success',
                    'is-neutral'
                );

                if (previewLoading)
                    previewLoading.classList.remove('is-visible');
            }

            function mostrarPreviewError(mensaje) {
                if (!preview) return;

                if (previewLoading)
                    previewLoading.classList.remove('is-visible');

                preview.classList.remove(
                    'is-warning',
                    'is-success'
                );

                preview.classList.add(
                    'is-visible',
                    'is-neutral'
                );

                if (previewTitle)
                    previewTitle.textContent = 'No fue posible calcular la vista previa';

                if (previewBadge) {
                    previewBadge.className = 'badge bg-secondary';
                    previewBadge.textContent = 'Sin cálculo';
                }

                if (previewObjetivo)
                    previewObjetivo.textContent = '-';

                if (previewPendiente)
                    previewPendiente.textContent = '-';

                if (previewTiempo)
                    previewTiempo.textContent = '-';

                if (previewFin)
                    previewFin.textContent = '-';

                if (previewImpacto)
                    previewImpacto.textContent = mensaje || 'No disponible.';
            }

            function pintarPreview(data) {
                if (!preview)
                    return;

                if (previewLoading)
                    previewLoading.classList.remove('is-visible');

                preview.classList.remove(
                    'is-warning',
                    'is-success',
                    'is-neutral'
                );

                preview.classList.add('is-visible');

                if (data.extiendeProgramacion)
                    preview.classList.add('is-warning');
                else if (data.reduceProgramacion)
                    preview.classList.add('is-success');
                else
                    preview.classList.add('is-neutral');

                if (previewTitle) {
                    if (data.extiendeProgramacion)
                        previewTitle.textContent = 'La OF terminará después de lo programado';
                    else if (data.reduceProgramacion)
                        previewTitle.textContent = 'La OF terminará antes de lo programado';
                    else
                        previewTitle.textContent = 'La duración de la OF permanece prácticamente igual';
                }

                if (previewBadge) {
                    if (data.extiendeProgramacion) {
                        previewBadge.className = 'badge bg-warning text-dark';
                        previewBadge.textContent = '+' + Math.abs(Number(data.deltaMinutos || 0)) + ' min';
                    }
                    else if (data.reduceProgramacion) {
                        previewBadge.className = 'badge bg-success';
                        previewBadge.textContent = '-' + Math.abs(Number(data.deltaMinutos || 0)) + ' min';
                    }
                    else {
                        previewBadge.className = 'badge bg-secondary';
                        previewBadge.textContent = 'Sin impacto';
                    }
                }

                if (previewObjetivo) {
                    previewObjetivo.textContent =
                        numero(data.configuracionActual?.objetivoHora) +
                        ' → ' +
                        numero(data.configuracionNueva?.objetivoHora) +
                        ' pzas/h';
                }

                if (previewPendiente) {
                    previewPendiente.textContent =
                        numero(data.cantidadPendiente) +
                        ' pzas';
                }

                if (previewTiempo) {
                    previewTiempo.textContent =
                        numero(data.horasRestantesActuales, 2) +
                        ' → ' +
                        numero(data.horasRestantesNuevas, 2) +
                        ' h';
                }

                if (previewFin) {
                    previewFin.textContent =
                        fechaHora(data.fechaFinActual) +
                        ' → ' +
                        fechaHora(data.fechaFinProyectada);
                }

                if (previewImpacto) {
                    previewImpacto.innerHTML = '';

                    const icono = document.createElement('i');
                    icono.className =
                        data.extiendeProgramacion
                            ? 'bi bi-exclamation-triangle-fill me-1 text-warning'
                            : data.reduceProgramacion
                                ? 'bi bi-check-circle-fill me-1 text-success'
                                : 'bi bi-info-circle-fill me-1 text-primary';

                    previewImpacto.appendChild(icono);
                    previewImpacto.appendChild(
                        document.createTextNode(data.mensaje || '')
                    );
                }
            }

            async function consultarPreview() {
                if (!esCambio || !preview)
                    return;

                const cav = numeroFlexible(valorConDefault(cavidades));
                const cicTexto = valorConDefault(ciclo);
                const cic = numeroFlexible(cicTexto);

                if (!Number.isFinite(cav) || cav <= 0 ||
                    !Number.isFinite(cic) || cic <= 0) {
                    limpiarPreview();
                    return;
                }

                const numeroSolicitud = ++solicitudPreviewNumero;

                if (previewLoading)
                    previewLoading.classList.add('is-visible');

                try {
                    const parametros = new URLSearchParams({
                        ejecucionProduccionId: ejecucionProduccionId.toString(),
                        cavidadesUsadas: Math.trunc(cav).toString(),
                        tiempoCicloSegundos: cicTexto
                    });

                    const response = await fetch(
                        previewUrl + '?' + parametros.toString(),
                        {
                            method: 'GET',
                            headers: {
                                'Accept': 'application/json'
                            },
                            cache: 'no-store'
                        });

                    const data = await response.json();

                    if (numeroSolicitud !== solicitudPreviewNumero)
                        return;

                    if (!data || data.ok !== true) {
                        mostrarPreviewError(
                            data?.mensaje ||
                            'No fue posible calcular el impacto.'
                        );
                        return;
                    }

                    pintarPreview(data);
                }
                catch (error) {
                    if (numeroSolicitud !== solicitudPreviewNumero)
                        return;

                    mostrarPreviewError(
                        'No fue posible consultar el impacto en el calendario.'
                    );

                    console.warn(
                        'Error al previsualizar cambio de configuración:',
                        error
                    );
                }
            }

            function programarPreview() {
                if (!esCambio || !preview)
                    return;

                if (temporizadorPreview)
                    window.clearTimeout(temporizadorPreview);

                temporizadorPreview =
                    window.setTimeout(
                        consultarPreview,
                        350
                    );
            }

            [cavidades, ciclo].forEach(function (input) {
                if (!input) return;

                input.addEventListener('input', function () {
                    recalcularObjetivo();
                    programarPreview();
                });

                input.addEventListener('blur', function () {
                    recalcularObjetivo();
                    programarPreview();
                });
            });

            form.addEventListener('submit', function (event) {
                mostrarError('');

                if (cavidades && !(cavidades.value || '').trim())
                    cavidades.value = cavidades.dataset.defaultValue || '';

                if (ciclo && !(ciclo.value || '').trim())
                    ciclo.value = ciclo.dataset.defaultValue || '';

                const cav = numeroFlexible(cavidades?.value);
                const cic = numeroFlexible(ciclo?.value);
                const cont = numeroFlexible(contador?.value);

                if (!Number.isFinite(cav) || cav <= 0) {
                    event.preventDefault();
                    mostrarError(
                        'No existe un valor de cavidades por defecto. El técnico debe capturar cuántas cavidades se utilizarán.'
                    );
                    cavidades?.focus();
                    return;
                }

                if (!Number.isFinite(cic) || cic <= 0) {
                    event.preventDefault();
                    mostrarError(
                        'No existe un tiempo de ciclo válido por defecto. El técnico debe capturar el ciclo real en segundos.'
                    );
                    ciclo?.focus();
                    return;
                }

                if (!Number.isFinite(cont) || cont < 0) {
                    event.preventDefault();
                    mostrarError(
                        'Captura el contador actual de la máquina. Este dato no tiene un valor seguro por defecto.'
                    );
                    contador?.focus();
                    return;
                }

                if (esCambio && (!motivo || !(motivo.value || '').trim())) {
                    event.preventDefault();
                    mostrarError(
                        'Para cambiar una configuración activa debes indicar el motivo del cambio.'
                    );
                    motivo?.focus();
                    return;
                }

                recalcularObjetivo();
            });

            recalcularObjetivo();

            if (esCambio)
                programarPreview();
        });

        });
    </script>
    @if (Model.MostrarAvisoMonitoreoTurno && monitoreoTurno != null)
    {
        <script>
            document.addEventListener('DOMContentLoaded', function () {
                const elemento = document.getElementById('modalMonitoreoTurno');
                if (elemento) bootstrap.Modal.getOrCreateInstance(elemento).show();
            });
        </script>
    }


</body>
</html>