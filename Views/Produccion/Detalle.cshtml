            color: #dce7f6;
        }

        html[data-nsq-theme="dark"] .capture-card {
            background: #111b2d;
            border-color: #2d3e55;
        }

            html[data-nsq-theme="dark"] .capture-card.is-extra {
                background: linear-gradient(90deg,#211a35,#111b2d 36%);
                border-left-color: #a78bfa;
            }

            html[data-nsq-theme="dark"] .capture-card.is-normal {
                border-left-color: #5da6ff;
            }

        html[data-nsq-theme="dark"] .capture-stat,
        html[data-nsq-theme="dark"] .capture-observation,
        html[data-nsq-theme="dark"] .segment-card,
        html[data-nsq-theme="dark"] .capture-history,
        html[data-nsq-theme="dark"] .capture-history-value,
        html[data-nsq-theme="dark"] .adjust-summary,
        html[data-nsq-theme="dark"] .adjust-summary-item {
            background: #101a2b;
            border-color: #2d3e55;
            color: #dce7f6;
        }

        html[data-nsq-theme="dark"] .capture-history-item {
            border-bottom-color: #2d3e55;
        }

        html[data-nsq-theme="dark"] .capture-history-motive,
        html[data-nsq-theme="dark"] .adjust-summary-label {
            color: #9aa9bd;
        }

        html[data-nsq-theme="dark"] .adjust-summary-value {
            color: #eaf2ff;
        }

        html[data-nsq-theme="dark"] .capture-adjusted-badge {
            background: #2b2313;
            color: #f6cc6d;
            border-color: #76571e;
        }

        html[data-nsq-theme="dark"] .adjust-preview {
            background: #17345c;
            border-color: #28598b;
            color: #9dcaff;
        }

            html[data-nsq-theme="dark"] .adjust-preview.is-invalid {
                background: #351719;
                border-color: #7f2b32;
                color: #ff9aa5;
            }

            html[data-nsq-theme="dark"] .adjust-preview.is-valid {
                background: #102a20;
                border-color: #286446;
                color: #79e3a8;
            }

        html[data-nsq-theme="dark"] .capture-type {
            background: #17345c;
            color: #9dcaff;
        }

            html[data-nsq-theme="dark"] .capture-type.extra {
                background: #2d2148;
                color: #c4b5fd;
            }
    </style>
</head>

<body>
    <div class="page-shell">

        <div class="hero mb-4">
            <div class="d-flex flex-wrap align-items-center justify-content-between gap-3">
                <div>
                    <h1 class="hero-title">
                        <i class="bi bi-gear-wide-connected me-2"></i>
                        Producción - Programa @e.ProgramaProduccionID
                    </h1>
                    <div class="hero-subtitle">
                        @e.TituloPrograma · @e.TextoMaquina
                    </div>
                </div>

                <div class="d-flex flex-wrap align-items-center gap-2">
                    <span class="badge @e.EstatusClase fs-6">
                        @e.EstatusNombre
                    </span>

                    @if (puedeGestionarCajas)
                    {
                        <a href="@Url.Action("Cajas", "Produccion", new { id = e.EjecucionProduccionID })"
                           class="btn btn-warning fw-bold">
                            <i class="bi bi-box-seam me-1"></i>
                            Gestión de cajas
                        </a>
                    }

                    <a href="@Url.Action("Index", "Produccion")" class="btn btn-light fw-bold">
                        <i class="bi bi-arrow-left me-1"></i>
                        Volver
                    </a>
                </div>
            </div>
        </div>

        @if (TempData["Success"] != null)
        {
            <div class="alert alert-success alert-dismissible fade show">
                <i class="bi bi-check-circle me-1"></i>
                @TempData["Success"]
                <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
            </div>
        }

        @if (TempData["Error"] != null)
        {
            <div class="alert alert-danger alert-dismissible fade show">
                <i class="bi bi-exclamation-triangle me-1"></i>
                @TempData["Error"]
                <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
            </div>
        }

        @if (TempData["Info"] != null)
        {
            <div class="alert alert-info alert-dismissible fade show">
                <i class="bi bi-info-circle me-1"></i>
                @TempData["Info"]
                <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
            </div>
        }

        <div class="row g-3 mb-4">
            <div class="col-6 col-lg">
                <div class="metric-card">
                    <div class="metric-label">Planeado</div>
                    <div class="metric-value">@(e.CantidadPlaneada?.ToString("N0") ?? "-")</div>
                </div>
            </div>

            <div class="col-6 col-lg">
                <div class="metric-card">
                    <div class="metric-label">Verdes / OK</div>
                    <div class="metric-value text-success">@Model.TotalOK.ToString("N0")</div>
                </div>
            </div>

            <div class="col-6 col-lg">
                <div class="metric-card">
                    <div class="metric-label">Rojas / Scrap</div>
                    <div class="metric-value text-danger">@Model.TotalScrap.ToString("N0")</div>
                </div>
            </div>

            <div class="col-6 col-lg">
                <div class="metric-card">
                    <div class="metric-label">Pendiente</div>
                    <div class="metric-value">@e.CantidadPendiente.ToString("N0")</div>
                </div>
            </div>

            <div class="col-6 col-lg">
                <div class="metric-card">
                    <div class="metric-label">Avance</div>
                    <div class="metric-value">@e.PorcentajeAvance.ToString("0.##")%</div>
                </div>
            </div>
        </div>

        <div class="panel mb-4">
            <div class="panel-body">
                <div class="d-flex justify-content-between small mb-1">
                    <span class="fw-bold text-primary">Avance de producción</span>
                    <span>@e.PorcentajeAvance.ToString("0.##")%</span>
                </div>
                <div class="progress">
                    <div class="progress-bar"
                         style="width:@avancePct.ToString("0.##", System.Globalization.CultureInfo.InvariantCulture)%">
                    </div>
                </div>
            </div>
        </div>

        <section class="smart-workspace mb-4" id="smartWorkspace" data-smart-workspace data-priority-target="@accionDestino">
            <div class="smart-toolbar">
                <div>
                    <div class="smart-toolbar-title">
                        <i class="bi bi-stars me-1"></i>
                        Centro de trabajo inteligente
                    </div>
                    <div class="smart-toolbar-subtitle">
                        Vista adaptada a @textoContextoPuesto · solo se abre primero lo que requiere atención.
                    </div>
                </div>
                <div class="smart-status-row">
                    @if (Model.TieneParoAbierto)
                    {
                        <span class="smart-chip danger"><i class="bi bi-pause-circle"></i>Paro abierto</span>
                    }
                    @if (!tieneConfiguracionCorrida && esPreparacion)
                    {
                        <span class="smart-chip warning"><i class="bi bi-sliders"></i>Configuración pendiente</span>
                    }
                    @if (Model.CalidadResumen?.PuedeIniciarSerie == true)
                    {
                        <span class="smart-chip success"><i class="bi bi-patch-check"></i>Calidad liberó</span>
                    }
                    else if (calidadRequiereAtencion && esPreparacion)
                    {
                        <span class="smart-chip warning"><i class="bi bi-patch-exclamation"></i>Calidad pendiente</span>
                    }
                    @if (e.MaquinaLiberada)
                    {
                        <span class="smart-chip success"><i class="bi bi-unlock"></i>Máquina liberada</span>
                    }
                    @if (cortesTiempoExtra > 0)
                    {
                        <span class="smart-chip"><i class="bi bi-stopwatch"></i>@cortesTiempoExtra corte(s) extra · @minutosTiempoExtra.ToString("0.#") min · @piezasFisicasTiempoExtra.ToString("N0") pzas</span>
                    }
                </div>
            </div>

            <section class="next-action mb-4 @(accionActual == "CERRAR_PARO" ? "is-danger" : accionActual == "MONITOREO_TURNO" || accionActual == "ESPERAR_CALIDAD" || accionActual == "CONFIGURAR_CORRIDA" ? "is-warning" : accionActual == "INICIAR_SERIE" || accionActual == "REINICIAR_SERIE" || accionActual == "TERMINAR" ? "is-success" : "")">
                <div class="d-flex flex-wrap align-items-center justify-content-between gap-3">
                    <div class="d-flex align-items-start gap-3">
                        <div class="next-action-icon">
                            <i class="bi @(accionActual == "CERRAR_PARO" ? "bi-pause-circle" : accionActual == "MONITOREO_TURNO" ? "bi-arrow-repeat" : accionActual == "GENERAR_CHECKLIST" ? "bi-clipboard-check" : accionActual == "CONFIGURAR_CORRIDA" ? "bi-sliders" : accionActual == "ESPERAR_CALIDAD" ? "bi-hourglass-split" : accionActual == "INICIAR_SERIE" || accionActual == "REINICIAR_SERIE" ? "bi-play-fill" : accionActual == "TERMINAR" ? "bi-flag" : "bi-activity")"></i>
                        </div>
                        <div>
                            <div class="data-label">Acción requerida ahora</div>

                            @if (accionActual == "CERRAR_PARO")
                            {
                                <h2 class="next-action-title">Cerrar el paro antes de continuar</h2>
                                <p class="next-action-text">La ejecución permanece detenida mientras exista un paro abierto.</p>
                            }
                            else if (accionActual == "MONITOREO_TURNO")
                            {
                                <h2 class="next-action-title">Completar el monitoreo del turno</h2>
                                <p class="next-action-text">Registra las verificaciones de periféricos y la entrega-recepción del turno actual.</p>
                            }
                            else if (accionActual == "GENERAR_CHECKLIST")
                            {
                                <h2 class="next-action-title">Generar el checklist de arranque</h2>
                                <p class="next-action-text">La preparación debe documentarse antes de enviar la corrida a Calidad.</p>
                            }
                            else if (accionActual == "CONFIGURAR_CORRIDA")
                            {
                                <h2 class="next-action-title">Confirmar configuración real de la corrida</h2>
                                <p class="next-action-text">El técnico debe confirmar cavidades, ciclo y contador base. Si no modifica cavidades o ciclo, se conservarán los valores de referencia disponibles en BD.</p>
                            }
                            else if (accionActual == "ESPERAR_CALIDAD")
                            {
                                <h2 class="next-action-title">Atender o esperar la liberación de Calidad</h2>
                                <p class="next-action-text">La producción en serie permanece bloqueada hasta recibir etiqueta verde.</p>
                            }
                            else if (accionActual == "REINICIAR_SERIE")
                            {
                                <h2 class="next-action-title">Reiniciar producción en serie</h2>
                                <p class="next-action-text">Calidad autorizó la reliberación. Confirma el reinicio real para reanudar las capturas horarias desde este momento.</p>
                            }
                            else if (accionActual == "INICIAR_SERIE")
                            {
                                <h2 class="next-action-title">Iniciar producción en serie</h2>
                                <p class="next-action-text">La preparación está lista y Calidad ya permite continuar.</p>
                            }
                            else if (accionActual == "TERMINAR")
                            {
                                <h2 class="next-action-title">Revisar y terminar la producción</h2>
                                <p class="next-action-text">La ejecución está en condiciones de pasar al cierre de producción.</p>
                            }
                            else
                            {
                                <h2 class="next-action-title">Continuar seguimiento de la ejecución</h2>
                                <p class="next-action-text">Revisa capturas, materiales y paros conforme avance el turno.</p>
                            }
                        </div>
                    </div>

                    <a class="btn btn-primary btn-strong"
                       href="@accionDestino"
                       data-open-target data-smart-priority-link>
                        <i class="bi @(accionActual == "INICIAR_SERIE" || accionActual == "REINICIAR_SERIE" ? "bi-play-circle" : "bi-arrow-down-circle") me-1"></i>
                        @(accionActual == "CONFIGURAR_CORRIDA" ? "Configurar corrida" : accionActual == "REINICIAR_SERIE" ? "Reiniciar ahora" : accionActual == "INICIAR_SERIE" ? "Iniciar ahora" : "Ir a la acción")
                    </a>
                </div>
            </section>

            <div id="zonaPrioritaria" class="smart-priority-zone"></div>

            <div class="smart-section-label">
                <span><i class="bi bi-grid me-1"></i>Accesos rápidos</span>
                <span>El resto permanece plegado</span>
            </div>

            <div class="smart-quick-actions">
                <button type="button" class="smart-quick-btn" data-smart-open="#panelDatosEjecucion"><i class="bi bi-info-circle me-1"></i>Datos</button>

                @if (puedeGestionarConfiguracionCorrida && configuracionTiempoReal != null)
                {
                    <button type="button" class="smart-quick-btn" data-smart-open="#panelConfiguracionCorrida"><i class="bi bi-sliders me-1"></i>Configuración</button>
                }

                @if (puedeGestionarChecklistArranque)
                {
                    <button type="button" class="smart-quick-btn" data-smart-open="#panelChecklist"><i class="bi bi-clipboard-check me-1"></i>Checklist</button>
                }

                <button type="button" class="smart-quick-btn" data-smart-open="#panelCalidad"><i class="bi bi-patch-check me-1"></i>Calidad</button>

                @if (puedeGestionarMonitoreoPerifericos && monitoreoTurno != null)
                {
                    <button type="button" class="smart-quick-btn" data-smart-open="#panelMonitoreoTurno"><i class="bi bi-cpu me-1"></i>Turno</button>
                }

                @if (e.PuedePausar || Model.TieneParoAbierto)
                {
                    <button type="button" class="smart-quick-btn" data-smart-open="#panelParo"><i class="bi bi-pause-circle me-1"></i>Paros</button>
                }

                @if (puedeVerCapturasEnDetalle)
                {
                    <button type="button" class="smart-quick-btn" data-smart-open="#panelCapturas"><i class="bi bi-clock-history me-1"></i>Capturas</button>
                }

                <button type="button" class="smart-quick-btn" data-smart-open="#panelMateriales"><i class="bi bi-box-seam me-1"></i>Materiales</button>
                <button type="button" class="smart-quick-btn" data-smart-open="#panelHistorialParos"><i class="bi bi-clock-history me-1"></i>Historial paros</button>

                @if (puedeGestionarCajas)
                {
                    <a class="smart-quick-btn text-decoration-none" href="@Url.Action("Cajas", "Produccion", new { id = e.EjecucionProduccionID })"><i class="bi bi-boxes me-1"></i>Cajas</a>
                }
            </div>
            <div class="smart-help">
                <i class="bi bi-lightning-charge me-1"></i>
                Cuando cambia el estado de la ejecución, el bloque necesario se mueve automáticamente a esta zona y se abre. No tienes que buscarlo más abajo.
            </div>
        </section>

        @if (esProduccion || e.MaquinaLiberada)
        {
            <section class="machine-release-card mb-4 @(e.MaquinaLiberada ? "is-released" : Model.TieneParoAbierto ? "is-blocked" : "")" id="panelLiberarMaquina">
                <div class="d-flex flex-wrap align-items-center justify-content-between gap-3">
                    <div class="d-flex align-items-start gap-3 flex-grow-1">
                        <div class="machine-release-icon">
                            <i class="bi @(e.MaquinaLiberada ? "bi-check-circle-fill" : Model.TieneParoAbierto ? "bi-exclamation-triangle" : "bi-unlock")"></i>
                        </div>
                        <div>
                            <div class="data-label">Disponibilidad física de máquina</div>
                            @if (e.MaquinaLiberada)
                            {
                                <h2 class="machine-release-title">Máquina liberada para la siguiente OF</h2>
                                <p class="machine-release-text">La ejecución continúa abierta para cajas, Calidad, GP12 y cierre documental, pero esta máquina ya no bloquea el siguiente programa.</p>
                                <div class="d-flex flex-wrap gap-2 mt-2">
                                    <span class="badge bg-success">
                                        <i class="bi bi-clock me-1"></i>
                                        @(e.FechaLiberacionMaquina?.ToString("dd/MM/yyyy HH:mm") ?? "Liberada")
                                    </span>
                                    @if (e.UsuarioLiberacionMaquinaID.HasValue)
                                    {
                                        <span class="badge bg-secondary">Usuario @e.UsuarioLiberacionMaquinaID.Value</span>
                                    }
                                </div>
                                @if (!string.IsNullOrWhiteSpace(e.ObservacionesLiberacionMaquina))
                                {
                                    <div class="muted-small mt-2"><strong>Observaciones:</strong> @e.ObservacionesLiberacionMaquina</div>
                                }
                            }
                            else if (Model.TieneParoAbierto)
                            {
                                <h2 class="machine-release-title">La máquina no puede liberarse con un paro abierto</h2>
                                <p class="machine-release-text">Cierra primero el paro actual. Después podrás registrar el fin físico de la corrida sin esperar a que concluyan Calidad, cajas o GP12.</p>
                            }
                            else
                            {
                                <h2 class="machine-release-title">Liberar máquina al terminar la corrida física</h2>
                                <p class="machine-release-text">Usa esta acción cuando ya salió la última pieza y no habrá más producción en esta máquina para la OF. El sistema validará las capturas horarias requeridas antes de liberar.</p>
                            }
                        </div>
                    </div>
                    @if (!e.MaquinaLiberada)
                    {
                        <form method="post" action="@Url.Action("LiberarMaquina", "Produccion")" class="machine-release-form">
                            @Html.AntiForgeryToken()
                            <input type="hidden" name="EjecucionProduccionID" value="@e.EjecucionProduccionID" />
                            <label class="form-label" for="ObservacionesLiberacionMaquina">Observaciones de liberación</label>
                            <textarea class="form-control mb-2" id="ObservacionesLiberacionMaquina" name="Observaciones" rows="2" maxlength="500" placeholder="Opcional: última pieza, entrega a siguiente OF, condición de máquina, etc." disabled="@Model.TieneParoAbierto"></textarea>
                            <button type="submit" class="btn @(Model.TieneParoAbierto ? "btn-warning" : "btn-primary") w-100 btn-strong" disabled="@Model.TieneParoAbierto">
                                <i class="bi bi-unlock me-1"></i>
                                Liberar máquina
                            </button>
                            @if (!Model.TieneParoAbierto)
                            {
                                <div class="form-text mt-2">Esta acción no termina la ejecución ni cierra Calidad.</div>
                            }
                        </form>
                    }
                </div>
            </section>
        }

        @if (e.EstatusID == ERP.NSQuell.Models.ProduccionEstatus.EnPreparacion && !Model.TieneParoAbierto)
        {
            var puedeIniciarSerieCompleto =
            Model.CalidadResumen?.PuedeIniciarSerie == true &&
            tieneConfiguracionCorrida;

            <section class="primary-series-action mb-4 @(puedeIniciarSerieCompleto ? "" : "is-blocked")" id="panelIniciarSerie">
                <div class="d-flex flex-wrap align-items-center justify-content-between gap-3">
                    <div class="d-flex align-items-start gap-3 flex-grow-1">
                        <div class="next-action-icon">
                            <i class="bi bi-play-fill"></i>
                        </div>

                        <div>
                            <div class="data-label">
                                @(esReinicioSerie ? "Acción principal" : "Inicio de serie")
                            </div>

                            <h2 class="series-title">
                                @(esReinicioSerie ? "Reiniciar producción en serie" : "Iniciar producción en serie")
                            </h2>

                            <p class="series-text">
                                @if (esReinicioSerie)
                                {
                                    <text>
                                        La OF está lista para regresar a producción. Confirma el contador físico actual de la máquina; ese valor será la nueva base para las capturas posteriores.
                                    </text>
                                }
                                else
                                {
                                    <text>
                                        Para iniciar serie se requiere liberación de Calidad y una configuración técnica vigente de cavidades, ciclo y contador base.
                                    </text>
                                }
                            </p>
                        </div>
                    </div>

                    <div class="series-status">
                        <form method="post" action="@Url.Action("IniciarSerie","Produccion")">
                            @Html.AntiForgeryToken()

                            <input type="hidden"
                                   name="ejecucionProduccionId"
                                   value="@e.EjecucionProduccionID" />

                            @if (esReinicioSerie)
                            {
                                <div class="mb-3 text-start">
                                    <label class="form-label fw-bold" for="ContadorMaquinaReinicio">
                                        <i class="bi bi-speedometer2 me-1"></i>
                                        Contador actual de la máquina *
                                    </label>

                                    <input type="number"
                                           id="ContadorMaquinaReinicio"
                                           name="contadorMaquinaActual"
                                           min="0"
                                           step="1"
                                           required
                                           autocomplete="off"
                                           class="form-control form-control-lg fw-bold"
                                           placeholder="Ej. 12850" />

                                    <div class="form-text">
                                        Captura exactamente el valor que muestra físicamente la máquina en este momento.
                                        Será la nueva base de la OF y los ciclos realizados durante el paro, la urgencia o las primeras piezas no se sumarán a esta producción.
                                    </div>
                                </div>
                            }

                            <button type="submit"
                                    class="btn btn-success w-100 btn-strong"
                                    disabled="@(!puedeIniciarSerieCompleto)"
                                    onclick="return confirm('@(esReinicioSerie ? "¿Confirmas reiniciar la producción en serie con el contador físico capturado como nueva base?" : "¿Confirmas iniciar producción en serie?")');">
                                <i class="bi bi-play-fill me-1"></i>
                                @(esReinicioSerie ? "Reiniciar serie ahora" : "Iniciar serie")
                            </button>

                            @if (!tieneConfiguracionCorrida)
                            {
                                <div class="text-warning-emphasis fw-bold small mt-2 text-center">
                                    <i class="bi bi-sliders me-1"></i>
                                    Pendiente de configuración técnica de la corrida.
                                </div>
                            }

                            @if (Model.CalidadResumen?.PuedeIniciarSerie != true)
                            {
                                <div class="text-warning-emphasis fw-bold small mt-2 text-center">
                                    <i class="bi bi-hourglass-split me-1"></i>
                                    Pendiente de liberación verde por Calidad.
                                </div>
                            }

                            @if (puedeIniciarSerieCompleto)
                            {
                                <div class="text-success fw-bold small mt-2 text-center">
                                    <i class="bi bi-check-circle me-1"></i>
                                    @(esReinicioSerie
                                                                ? "Retorno listo. Confirma el contador físico para continuar."
                                                                : "Calidad y configuración técnica listas.")
                        </div>
                                                }
                        </form>
                    </div>
                </div>
            </section>
        }

        <div class="row g-4">

            <div class="col-12 col-xl-4">

                <partial name="~/Views/Produccion/Partials/Detalle/Comun/_DatosEjecucion.cshtml"
                         model="Model" />

                @if (workspaceProduccion == "SUPERVISION")
                {
                    <partial name="~/Views/Produccion/Partials/Detalle/_WorkspaceSupervision.cshtml"
                             model="Model" />
                }
                else if (workspaceProduccion == "TECNICO")
                {
                    <partial name="~/Views/Produccion/Partials/Detalle/_WorkspaceTecnico.cshtml"
                             model="Model" />
                }
                else if (workspaceProduccion == "SMED")
                {
                    <partial name="~/Views/Produccion/Partials/Detalle/_WorkspaceSMED.cshtml"
                             model="Model" />
                }
                else if (workspaceProduccion == "AUXILIAR")
                {
                    <partial name="~/Views/Produccion/Partials/Detalle/_WorkspaceAuxiliar.cshtml"
                             model="Model" />
                }

                <partial name="~/Views/Produccion/Partials/Detalle/Comun/_CalidadResumen.cshtml"
                         model="Model" />

                <partial name="~/Views/Produccion/Partials/Detalle/Operacion/_Paros.cshtml"
                         model="Model" />

                <partial name="~/Views/Produccion/Partials/Detalle/Operacion/_Terminacion.cshtml"
                         model="Model" />

            </div>

            <div class="col-12 col-xl-8">

                <partial name="~/Views/Produccion/Partials/Detalle/Comun/_Materiales.cshtml"
                         model="Model" />

                <partial name="~/Views/Produccion/Partials/Detalle/Operacion/_CapturasHora.cshtml"
                         model="Model" />

                <partial name="~/Views/Produccion/Partials/Detalle/Comun/_HistorialParos.cshtml"
                         model="Model" />

            </div>

        </div>

    </div>

    @if (puedeGestionarMonitoreoPerifericos && Model.MostrarAvisoMonitoreoTurno && monitoreoTurno != null)
    {
        <div class="modal fade" id="modalMonitoreoTurno" tabindex="-1" aria-labelledby="modalMonitoreoTurnoLabel" aria-hidden="true" data-bs-backdrop="static" data-bs-keyboard="false">
            <div class="modal-dialog modal-dialog-centered">
                <div class="modal-content">
                    <div class="modal-header modal-monitor-header">
                        <h5 class="modal-title fw-bold" id="modalMonitoreoTurnoLabel"><i class="bi bi-exclamation-triangle me-2"></i>Cambio de turno detectado</h5>
                        <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Cerrar"></button>
                    </div>
                    <div class="modal-body p-4">
                        <div class="modal-monitor-icon"><i class="bi bi-cpu"></i></div>
                        <h4 class="text-center fw-bold text-danger mb-2">Monitoreo de periféricos pendiente</h4>
                        <p class="text-center text-muted mb-4">Completa el formato <strong>GQ-F-PR01-14 Ver.01</strong> correspondiente al turno actual.</p>
                        <div class="soft-box mb-3">
                            <div class="row g-3">
                                <div class="col-6"><div class="data-label">Turno</div><div class="data-value">@Txt(monitoreoTurno.TurnoNombre)</div></div>
                                <div class="col-6"><div class="data-label">Fecha operativa</div><div class="data-value">@monitoreoTurno.FechaOperacion.ToString("dd/MM/yyyy")</div></div>
                                <div class="col-12"><div class="data-label">Máquina</div><div class="data-value">@Txt(monitoreoTurno.MaquinaCodigo) · @Txt(monitoreoTurno.MaquinaNombre)</div></div>
                            </div>
                        </div>
                        <div class="row g-2 mb-3">
                            <div class="col-6"><div class="mini-stat"><div class="mini-stat-label">Verificaciones</div><div class="mini-stat-value">@monitoreoTurno.TotalConfirmadas / @monitoreoTurno.TotalPreguntas</div></div></div>
                            <div class="col-6"><div class="mini-stat"><div class="mini-stat-label">Entrega de turno</div><div class="mini-stat-value fs-6 @(monitoreoTurno.EntregaTurnoRegistrada ? "text-success" : "text-warning")">@(monitoreoTurno.EntregaTurnoRegistrada ? "Registrada" : "Pendiente")</div></div></div>
                        </div>
                        <div class="alert alert-warning mb-0"><i class="bi bi-info-circle me-1"></i>Si cierras esta advertencia, volverá a mostrarse al recargar mientras el monitoreo siga pendiente.</div>
                    </div>
                    <div class="modal-footer border-0 pt-0 px-4 pb-4">
                        <button type="button" class="btn btn-light btn-strong" data-bs-dismiss="modal">Continuar después</button>
                        <a href="@Url.Action("ChecklistFormato", "Produccion", new { id = monitoreoTurno.ChecklistArranqueID })" class="btn btn-warning btn-strong"><i class="bi bi-clipboard-check me-1"></i>Realizar monitoreo</a>
                    </div>
                </div>
            </div>
        </div>
    }

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
    <script>
        document.addEventListener('DOMContentLoaded', function () {
            const workspace = document.querySelector('[data-smart-workspace]');
            const zonaPrioritaria = document.getElementById('zonaPrioritaria');

            function abrirPanel(panel, desplazar) {
                if (!panel) return;
                panel.classList.remove('is-collapsed');
                const header = panel.querySelector(':scope > .panel-header');
                if (header) header.setAttribute('aria-expanded', 'true');
                if (desplazar) {
                    window.setTimeout(function () {
                        panel.scrollIntoView({ behavior: 'smooth', block: 'start' });
                    }, 40);
                }
            }

            if (workspace && zonaPrioritaria) {
                const selectorPrioridad = workspace.dataset.priorityTarget;
                if (selectorPrioridad) {
                    const panelPrioritario = document.querySelector(selectorPrioridad);
                    if (panelPrioritario) {
                        panelPrioritario.classList.add('smart-priority-panel');
                        zonaPrioritaria.appendChild(panelPrioritario);
                        abrirPanel(panelPrioritario, false);
                    }
                }
            }

            document.querySelectorAll('[data-smart-open]').forEach(function (button) {
                button.addEventListener('click', function () {
                    const selector = button.dataset.smartOpen;
                    if (!selector) return;
                    abrirPanel(document.querySelector(selector), true);
                });
            });

            const botonCapturas = document.querySelector('[data-capture-show-all]');
            if (botonCapturas) {
                botonCapturas.addEventListener('click', function () {
                    document.querySelectorAll('.capture-hidden').forEach(function (item) {
                        item.classList.add('is-visible');
                    });
                    botonCapturas.remove();
                });
            }

            const modalAjuste = document.getElementById('modalCorregirCapturaHora');
            const formAjuste = document.getElementById('formCorregirCapturaHora');
            const ajusteRegistroId = document.getElementById('ajusteRegistroHoraID');
            const ajusteEjecucionId = document.getElementById('ajusteEjecucionProduccionID');
            const ajusteCapturaTexto = document.getElementById('ajusteCapturaTexto');
            const ajusteRegistroBadge = document.getElementById('ajusteRegistroBadge');
            const ajusteFisicas = document.getElementById('ajusteFisicas');
            const ajusteOriginalOK = document.getElementById('ajusteOriginalOK');
            const ajusteOriginalScrap = document.getElementById('ajusteOriginalScrap');
            const ajusteNoLocalizadasActual = document.getElementById('ajusteNoLocalizadasActual');
            const ajusteCantidadOK = document.getElementById('ajusteCantidadOK');
            const ajusteCantidadScrap = document.getElementById('ajusteCantidadScrap');
            const ajusteMotivo = document.getElementById('ajusteMotivo');
            const ajustePreview = document.getElementById('ajustePreview');
            const btnGuardarAjuste = document.getElementById('btnGuardarAjusteCaptura');
            let ajusteFisicasReferencia = 0;
            let ajusteOKActual = 0;
            let ajusteScrapActual = 0;

            function enteroAjuste(value) {
                const numero = Number.parseInt(value ?? '0', 10);
                return Number.isFinite(numero) ? numero : 0;
            }

            function formatearAjuste(value) {
                return enteroAjuste(value).toLocaleString('es-MX');
            }

            function validarAjusteCaptura() {
                if (!formAjuste || !ajusteCantidadOK || !ajusteCantidadScrap || !ajustePreview || !btnGuardarAjuste) return;
                const ok = enteroAjuste(ajusteCantidadOK.value);
                const scrap = enteroAjuste(ajusteCantidadScrap.value);
                const motivo = (ajusteMotivo?.value || '').trim();
                const totalVigente = ok + scrap;
                const noLocalizadas = Math.max(0, ajusteFisicasReferencia - totalVigente);
                const diferenciaOK = ok - ajusteOKActual;
                const diferenciaScrap = scrap - ajusteScrapActual;
                const cambio = diferenciaOK !== 0 || diferenciaScrap !== 0;
                const cantidadesValidas = ok >= 0 && scrap >= 0 && totalVigente <= ajusteFisicasReferencia;
                const motivoValido = motivo.length >= 5 && motivo.length <= 1000;
                ajustePreview.classList.remove('is-valid', 'is-invalid');

                if (!cantidadesValidas) {
                    ajustePreview.classList.add('is-invalid');
                    ajustePreview.textContent = `La propuesta suma ${totalVigente.toLocaleString('es-MX')} pieza(s), pero la referencia de máquina es ${ajusteFisicasReferencia.toLocaleString('es-MX')}. No puedes superar el contador físico.`;
                }
                else if (!cambio) {
                    ajustePreview.textContent = 'No hay cambios respecto al valor vigente. Modifica verdes o rojas para continuar.';
                }
                else {
                    ajustePreview.classList.add('is-valid');
                    const bonus = diferenciaOK === 0 ? 'sin cambio en bonus' : `bonus ${(diferenciaOK > 0 ? '+' : '')}${diferenciaOK.toLocaleString('es-MX')}`;
                    ajustePreview.textContent = `Vigente propuesto: ${totalVigente.toLocaleString('es-MX')} pieza(s) · no localizadas/pérdida: ${noLocalizadas.toLocaleString('es-MX')} · ${bonus}.`;
                }
                btnGuardarAjuste.disabled = !(cantidadesValidas && cambio && motivoValido);
            }

            document.querySelectorAll('[data-ajustar-captura]').forEach(function (button) {
                button.addEventListener('click', function () {
                    const registroId = enteroAjuste(button.dataset.registroId);
                    const ejecucionId = enteroAjuste(button.dataset.ejecucionId);
                    ajusteFisicasReferencia = enteroAjuste(button.dataset.fisicas);
                    ajusteOKActual = enteroAjuste(button.dataset.ok);
                    ajusteScrapActual = enteroAjuste(button.dataset.scrap);
                    const originalOK = enteroAjuste(button.dataset.originalOk);
                    const originalScrap = enteroAjuste(button.dataset.originalScrap);
                    const noLocalizadasActual = Math.max(0, ajusteFisicasReferencia - ajusteOKActual - ajusteScrapActual);
                    if (ajusteRegistroId) ajusteRegistroId.value = registroId.toString();
                    if (ajusteEjecucionId) ajusteEjecucionId.value = ejecucionId.toString();
                    if (ajusteCapturaTexto) ajusteCapturaTexto.textContent = `${button.dataset.fecha || '-'} · ${button.dataset.rango || '-'}`;
                    if (ajusteRegistroBadge) ajusteRegistroBadge.textContent = `Registro #${registroId}`;
                    if (ajusteFisicas) ajusteFisicas.textContent = formatearAjuste(ajusteFisicasReferencia);
                    if (ajusteOriginalOK) ajusteOriginalOK.textContent = formatearAjuste(originalOK);
                    if (ajusteOriginalScrap) ajusteOriginalScrap.textContent = formatearAjuste(originalScrap);
                    if (ajusteNoLocalizadasActual) ajusteNoLocalizadasActual.textContent = formatearAjuste(noLocalizadasActual);
                    if (ajusteCantidadOK) ajusteCantidadOK.value = ajusteOKActual.toString();
                    if (ajusteCantidadScrap) ajusteCantidadScrap.value = ajusteScrapActual.toString();
                    if (ajusteMotivo) ajusteMotivo.value = '';
                    validarAjusteCaptura();
                });
            });

            [ajusteCantidadOK, ajusteCantidadScrap, ajusteMotivo].forEach(function (input) {
                input?.addEventListener('input', validarAjusteCaptura);
            });

            formAjuste?.addEventListener('submit', function (event) {
                validarAjusteCaptura();
                if (btnGuardarAjuste?.disabled) {
                    event.preventDefault();
                    return;
                }
                if (!window.confirm('¿Confirmas guardar esta corrección? Se actualizarán los totales de la OF y, si cambian las piezas verdes, se generará el movimiento correspondiente en el bonus del operador.')) {
                    event.preventDefault();
                    return;
                }
                btnGuardarAjuste.disabled = true;
                btnGuardarAjuste.innerHTML = '<span class="spinner-border spinner-border-sm me-1"></span>Guardando...';
            });

            modalAjuste?.addEventListener('hidden.bs.modal', function () {
                formAjuste?.reset();
                ajusteFisicasReferencia = 0;
                ajusteOKActual = 0;
                ajusteScrapActual = 0;
                if (ajustePreview) {
                    ajustePreview.classList.remove('is-valid', 'is-invalid');
                    ajustePreview.textContent = 'Modifica una cantidad para ver el impacto.';
                }
                if (btnGuardarAjuste) btnGuardarAjuste.disabled = true;
            });

            document.querySelectorAll('.panel[data-collapsible]').forEach(function (panel) {
                const header = panel.querySelector(':scope > .panel-header');
                const abierto = panel.classList.contains('smart-priority-panel') || panel.dataset.defaultOpen === 'true';

                panel.classList.toggle('is-collapsed', !abierto);

                if (!header) return;

                header.setAttribute('role', 'button');
                header.setAttribute('tabindex', '0');
                header.setAttribute('aria-expanded', abierto ? 'true' : 'false');

                function alternar() {
                    const colapsado = panel.classList.toggle('is-collapsed');
                    header.setAttribute('aria-expanded', colapsado ? 'false' : 'true');
                }

                header.addEventListener('click', function (event) {
                    if (event.target.closest('a, button, input, select, textarea, label')) return;
                    alternar();
                });

                header.addEventListener('keydown', function (event) {
                    if (event.key !== 'Enter' && event.key !== ' ') return;
                    event.preventDefault();
                    alternar();
                });
            });

            document.querySelectorAll('[data-open-target]').forEach(function (link) {
                link.addEventListener('click', function () {
                    const selector = link.getAttribute('href');
                    if (!selector || !selector.startsWith('#')) return;

                    const panel = document.querySelector(selector);
                    if (!panel) return;

                    panel.classList.remove('is-collapsed');

                    const header = panel.querySelector(':scope > .panel-header');
                    if (header) header.setAttribute('aria-expanded', 'true');

                    window.setTimeout(function () {
                        panel.scrollIntoView({ behavior: 'smooth', block: 'start' });
                    }, 40);
                });
            });

                    document.querySelectorAll('form[data-config-form]').forEach(function (form) {
            const cavidades = form.querySelector('[data-config-cavidades]');
            const ciclo = form.querySelector('[data-config-ciclo]');
            const contador = form.querySelector('[data-config-contador]');
            const objetivo = form.querySelector('[data-config-objetivo]');
            const validacion = form.querySelector('[data-config-validation]');
            const motivo = form.querySelector('textarea[name="MotivoCambio"]');
            const preview = form.querySelector('[data-config-preview]');
            const previewLoading = form.querySelector('[data-config-preview-loading]');
            const previewTitle = form.querySelector('[data-config-preview-title]');
            const previewBadge = form.querySelector('[data-config-preview-badge]');
            const previewObjetivo = form.querySelector('[data-config-preview-objetivo]');
            const previewPendiente = form.querySelector('[data-config-preview-pendiente]');
            const previewTiempo = form.querySelector('[data-config-preview-tiempo]');
            const previewFin = form.querySelector('[data-config-preview-fin]');
            const previewImpacto = form.querySelector('[data-config-preview-impact]');
            const esCambio = form.action && form.action.toLowerCase().includes('cambiarconfiguracioncorrida');
            const ejecucionProduccionId = @e.EjecucionProduccionID;
            const previewUrl = '@Url.Action("PrevisualizarCambioConfiguracion", "Produccion")';
            let temporizadorPreview = null;
            let solicitudPreviewNumero = 0;

            function valorConDefault(input) {
                if (!input) return '';
                const actual = (input.value || '').trim();
                if (actual) return actual;
                return (input.dataset.defaultValue || '').trim();
            }

            function numeroFlexible(value) {
                if (!value) return NaN;
                return Number(String(value).replace(',', '.'));
            }

            function mostrarError(mensaje) {
                if (!validacion) return;
                validacion.textContent = mensaje || '';
                validacion.classList.toggle('is-visible', !!mensaje);
            }

            function numero(value, decimales = 0) {
                const n = Number(value);
                if (!Number.isFinite(n)) return '-';

                return n.toLocaleString('es-MX', {
                    minimumFractionDigits: decimales,
                    maximumFractionDigits: decimales
                });
            }

            function fechaHora(value) {
                if (!value) return '-';

                const fecha = new Date(value);

                if (Number.isNaN(fecha.getTime()))
                    return '-';

                return fecha.toLocaleString('es-MX', {
                    day: '2-digit',
                    month: '2-digit',
                    year: 'numeric',
                    hour: '2-digit',
                    minute: '2-digit',
                    hour12: false
                });
            }

            function recalcularObjetivo() {
                if (!objetivo) return;

                const cav = numeroFlexible(valorConDefault(cavidades));
                const cic = numeroFlexible(valorConDefault(ciclo));

                if (!Number.isFinite(cav) || cav <= 0 ||
                    !Number.isFinite(cic) || cic <= 0) {
                    objetivo.textContent = 'Objetivo estimado: pendiente de datos';
                    return;
                }

                const calculado = (3600 / cic) * cav;

                objetivo.textContent =
                    'Objetivo estimado: ' +
                    Math.round(calculado).toLocaleString('es-MX') +
                    ' pzas/h · (3600 / ' +
                    cic.toLocaleString('es-MX') +
                    ') × ' +
                    cav.toLocaleString('es-MX');
            }

            function limpiarPreview() {
                if (!preview) return;

                preview.classList.remove(
                    'is-visible',
                    'is-warning',
                    'is-success',
                    'is-neutral'
                );

                if (previewLoading)
                    previewLoading.classList.remove('is-visible');
            }

            function mostrarPreviewError(mensaje) {
                if (!preview) return;

                if (previewLoading)
                    previewLoading.classList.remove('is-visible');

                preview.classList.remove(
                    'is-warning',
                    'is-success'
                );

                preview.classList.add(
                    'is-visible',
                    'is-neutral'
                );

                if (previewTitle)
                    previewTitle.textContent = 'No fue posible calcular la vista previa';

                if (previewBadge) {
                    previewBadge.className = 'badge bg-secondary';
                    previewBadge.textContent = 'Sin cálculo';
                }

                if (previewObjetivo)
                    previewObjetivo.textContent = '-';

                if (previewPendiente)
                    previewPendiente.textContent = '-';

                if (previewTiempo)
                    previewTiempo.textContent = '-';

                if (previewFin)
                    previewFin.textContent = '-';

                if (previewImpacto)
                    previewImpacto.textContent = mensaje || 'No disponible.';
            }

            function pintarPreview(data) {
                if (!preview)
                    return;

                if (previewLoading)
                    previewLoading.classList.remove('is-visible');

                preview.classList.remove(
                    'is-warning',
                    'is-success',
                    'is-neutral'
                );

                preview.classList.add('is-visible');

                if (data.extiendeProgramacion)
                    preview.classList.add('is-warning');
                else if (data.reduceProgramacion)
                    preview.classList.add('is-success');
                else
                    preview.classList.add('is-neutral');

                if (previewTitle) {
                    if (data.extiendeProgramacion)
                        previewTitle.textContent = 'La OF terminará después de lo programado';
                    else if (data.reduceProgramacion)
                        previewTitle.textContent = 'La OF terminará antes de lo programado';
                    else
                        previewTitle.textContent = 'La duración de la OF permanece prácticamente igual';
                }

                if (previewBadge) {
                    if (data.extiendeProgramacion) {
                        previewBadge.className = 'badge bg-warning text-dark';
                        previewBadge.textContent = '+' + Math.abs(Number(data.deltaMinutos || 0)) + ' min';
                    }
                    else if (data.reduceProgramacion) {
                        previewBadge.className = 'badge bg-success';
                        previewBadge.textContent = '-' + Math.abs(Number(data.deltaMinutos || 0)) + ' min';
                    }
                    else {
                        previewBadge.className = 'badge bg-secondary';
                        previewBadge.textContent = 'Sin impacto';
                    }
                }

                if (previewObjetivo) {
                    previewObjetivo.textContent =
                        numero(data.configuracionActual?.objetivoHora) +
                        ' → ' +
                        numero(data.configuracionNueva?.objetivoHora) +
                        ' pzas/h';
                }

                if (previewPendiente) {
                    previewPendiente.textContent =
                        numero(data.cantidadPendiente) +
                        ' pzas';
                }

                if (previewTiempo) {
                    previewTiempo.textContent =
                        numero(data.horasRestantesActuales, 2) +
                        ' → ' +
                        numero(data.horasRestantesNuevas, 2) +
                        ' h';
                }

                if (previewFin) {
                    previewFin.textContent =
                        fechaHora(data.fechaFinActual) +
                        ' → ' +
                        fechaHora(data.fechaFinProyectada);
                }

                if (previewImpacto) {
                    previewImpacto.innerHTML = '';

                    const icono = document.createElement('i');
                    icono.className =
                        data.extiendeProgramacion
                            ? 'bi bi-exclamation-triangle-fill me-1 text-warning'
                            : data.reduceProgramacion
                                ? 'bi bi-check-circle-fill me-1 text-success'
                                : 'bi bi-info-circle-fill me-1 text-primary';

                    previewImpacto.appendChild(icono);
                    previewImpacto.appendChild(
                        document.createTextNode(data.mensaje || '')
                    );
                }
            }

            async function consultarPreview() {
                if (!esCambio || !preview)
                    return;

                const cav = numeroFlexible(valorConDefault(cavidades));
                const cicTexto = valorConDefault(ciclo);
                const cic = numeroFlexible(cicTexto);

                if (!Number.isFinite(cav) || cav <= 0 ||
                    !Number.isFinite(cic) || cic <= 0) {
                    limpiarPreview();
                    return;
                }

                const numeroSolicitud = ++solicitudPreviewNumero;

                if (previewLoading)
                    previewLoading.classList.add('is-visible');

                try {
                    const parametros = new URLSearchParams({
                        ejecucionProduccionId: ejecucionProduccionId.toString(),
                        cavidadesUsadas: Math.trunc(cav).toString(),
                        tiempoCicloSegundos: cicTexto
                    });

                    const response = await fetch(
                        previewUrl + '?' + parametros.toString(),
                        {
                            method: 'GET',
                            headers: {
                                'Accept': 'application/json'
                            },
                            cache: 'no-store'
                        });

                    const data = await response.json();

                    if (numeroSolicitud !== solicitudPreviewNumero)
                        return;

                    if (!data || data.ok !== true) {
                        mostrarPreviewError(
                            data?.mensaje ||
                            'No fue posible calcular el impacto.'
                        );
                        return;
                    }

                    pintarPreview(data);
                }
                catch (error) {
                    if (numeroSolicitud !== solicitudPreviewNumero)
                        return;

                    mostrarPreviewError(
                        'No fue posible consultar el impacto en el calendario.'
                    );

                    console.warn(
                        'Error al previsualizar cambio de configuración:',
                        error
                    );
                }
            }

            function programarPreview() {
                if (!esCambio || !preview)
                    return;

                if (temporizadorPreview)
                    window.clearTimeout(temporizadorPreview);

                temporizadorPreview =
                    window.setTimeout(
                        consultarPreview,
                        350
                    );
            }

            [cavidades, ciclo].forEach(function (input) {
                if (!input) return;

                input.addEventListener('input', function () {
                    recalcularObjetivo();
                    programarPreview();
                });

                input.addEventListener('blur', function () {
                    recalcularObjetivo();
                    programarPreview();
                });
            });

            form.addEventListener('submit', function (event) {
                mostrarError('');

                if (cavidades && !(cavidades.value || '').trim())
                    cavidades.value = cavidades.dataset.defaultValue || '';

                if (ciclo && !(ciclo.value || '').trim())
                    ciclo.value = ciclo.dataset.defaultValue || '';

                const cav = numeroFlexible(cavidades?.value);
                const cic = numeroFlexible(ciclo?.value);
                const cont = numeroFlexible(contador?.value);

                if (!Number.isFinite(cav) || cav <= 0) {
                    event.preventDefault();
                    mostrarError(
                        'No existe un valor de cavidades por defecto. El técnico debe capturar cuántas cavidades se utilizarán.'
                    );
                    cavidades?.focus();
                    return;
                }

                if (!Number.isFinite(cic) || cic <= 0) {
                    event.preventDefault();
                    mostrarError(
                        'No existe un tiempo de ciclo válido por defecto. El técnico debe capturar el ciclo real en segundos.'
                    );
                    ciclo?.focus();
                    return;
                }

                if (!Number.isFinite(cont) || cont < 0) {
                    event.preventDefault();
                    mostrarError(
                        'Captura el contador actual de la máquina. Este dato no tiene un valor seguro por defecto.'
                    );
                    contador?.focus();
                    return;
                }

                if (esCambio && (!motivo || !(motivo.value || '').trim())) {
                    event.preventDefault();
                    mostrarError(
                        'Para cambiar una configuración activa debes indicar el motivo del cambio.'
                    );
                    motivo?.focus();
                    return;
                }

                recalcularObjetivo();
            });

            recalcularObjetivo();

            if (esCambio)
                programarPreview();
        });

        });
    </script>
    @if (puedeGestionarMonitoreoPerifericos && Model.MostrarAvisoMonitoreoTurno && monitoreoTurno != null)
    {
        <script>
            document.addEventListener('DOMContentLoaded', function () {
                const elemento = document.getElementById('modalMonitoreoTurno');
                if (elemento) bootstrap.Modal.getOrCreateInstance(elemento).show();
            });
        </script>
    }


</body>
</html>