@model ERP.NSQuell.Models.ProduccionDetalleVm

@{
    Layout = null;
    var e = Model.Ejecucion;

    var horaInicio = new TimeSpan(DateTime.Now.Hour, 0, 0);
    var horaFin = horaInicio.Add(TimeSpan.FromHours(1));

    if (horaFin.TotalHours >= 24)
    {
        horaFin = new TimeSpan(23, 59, 0);
    }

    var avancePct = e.PorcentajeAvance;

    if (avancePct < 0)
    {
        avancePct = 0;
    }

    if (avancePct > 100)
    {
        avancePct = 100;
    }
}

@functions {
    public static string Txt(string? value)
    {
        return string.IsNullOrWhiteSpace(value) ? "-" : value.Trim();
    }

    public static string Fecha(DateTime? value)
    {
        return value.HasValue ? value.Value.ToString("dd/MM/yyyy HH:mm") : "-";
    }

    public static string FechaInput(DateTime value)
    {
        return value.ToString("yyyy-MM-ddTHH:mm");
    }

    public static string Dec4(decimal? value)
    {
        return value.HasValue ? value.Value.ToString("N4") : "-";
    }

    public static string TipoClase(string? tipo)
    {
        if (string.Equals(tipo, "MP", StringComparison.OrdinalIgnoreCase))
            return "badge bg-primary";

        if (string.Equals(tipo, "COMPONENTE", StringComparison.OrdinalIgnoreCase))
            return "badge bg-info text-dark";

        if (string.Equals(tipo, "EMBALAJE", StringComparison.OrdinalIgnoreCase))
            return "badge bg-success";

        if (string.Equals(tipo, "ETIQUETA", StringComparison.OrdinalIgnoreCase))
            return "badge bg-warning text-dark";

        return "badge bg-secondary";
    }
}

<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Producción - Detalle</title>

    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.css" rel="stylesheet">

    <style>
        body {
            background: #f4f7fb;
            font-family: Arial, Helvetica, sans-serif;
        }

        .page-shell {
            max-width: 1500px;
            margin: 0 auto;
            padding: 22px;
        }

        .hero {
            background: linear-gradient(135deg, #0f2f63, #194c9b);
            color: white;
            border-radius: 22px;
            padding: 24px;
            box-shadow: 0 18px 38px rgba(15, 47, 99, .20);
        }

        .hero-title {
            font-size: 1.65rem;
            font-weight: 900;
            margin: 0;
        }

        .hero-subtitle {
            opacity: .86;
            margin-top: 4px;
        }

        .metric-card {
            background: white;
            border-radius: 18px;
            padding: 16px;
            border: 1px solid #e5eaf3;
            box-shadow: 0 10px 24px rgba(15, 23, 42, .05);
            height: 100%;
        }

        .metric-label {
            color: #667085;
            font-size: .78rem;
            font-weight: 800;
            text-transform: uppercase;
            letter-spacing: .04em;
        }

        .metric-value {
            font-size: 1.65rem;
            font-weight: 900;
            color: #102a56;
            margin-top: 6px;
        }

        .panel {
            background: white;
            border-radius: 20px;
            border: 1px solid #e5eaf3;
            box-shadow: 0 12px 28px rgba(15, 23, 42, .06);
            overflow: hidden;
        }

        .panel-header {
            padding: 15px 18px;
            border-bottom: 1px solid #e5eaf3;
            background: #f8fafc;
            font-weight: 900;
            color: #102a56;
        }

        .panel-body {
            padding: 18px;
        }

        .data-label {
            color: #667085;
            font-size: .78rem;
            font-weight: 800;
            text-transform: uppercase;
            letter-spacing: .04em;
        }

        .data-value {
            color: #102a56;
            font-weight: 800;
        }

        .muted-small {
            color: #667085;
            font-size: .82rem;
        }

        .progress {
            height: 10px;
            background: #e9eef7;
            border-radius: 999px;
        }

        .progress-bar {
            border-radius: 999px;
        }

        .table thead th {
            background: #f8fafc;
            color: #344054;
            font-size: .78rem;
            text-transform: uppercase;
            letter-spacing: .04em;
            border-bottom: 1px solid #e5eaf3;
            white-space: nowrap;
        }

        .table tbody td {
            vertical-align: middle;
            font-size: .88rem;
        }

        .mini-stat {
            border: 1px solid #e5eaf3;
            border-radius: 14px;
            padding: 10px;
            text-align: center;
            background: #f8fafc;
        }

        .mini-stat-label {
            color: #667085;
            font-size: .72rem;
            font-weight: 900;
            text-transform: uppercase;
            letter-spacing: .04em;
        }

        .mini-stat-value {
            font-size: 1.25rem;
            font-weight: 900;
            color: #102a56;
            line-height: 1.1;
        }

        .flow-note {
            background: #eff6ff;
            border: 1px solid #bfdbfe;
            color: #1d4ed8;
            border-radius: 14px;
            padding: 12px 14px;
            font-size: .88rem;
            font-weight: 700;
        }

        .btn-strong {
            font-weight: 900;
            border-radius: 12px;
        }

        .form-label {
            color: #344054;
            font-size: .78rem;
            font-weight: 900;
            text-transform: uppercase;
            letter-spacing: .04em;
        }

        .form-control,
        .form-select {
            border-radius: 12px;
            border: 1px solid #d7e2f1;
            box-shadow: none;
        }

            .form-control:focus,
            .form-select:focus {
                border-color: #7ca8e8;
                box-shadow: 0 0 0 .2rem rgba(0, 74, 173, .12);
            }

        .recepcion-form {
            border: 1px solid #d7e2f1;
            border-radius: 16px;
            background: #fbfdff;
            padding: 14px;
        }

        .recepcion-alert {
            border: 1px solid #fed7aa;
            background: #fff7ed;
            color: #9a3412;
            border-radius: 14px;
            padding: 12px 14px;
            font-size: .86rem;
            font-weight: 700;
        }

        .soft-box {
            border: 1px solid #e5eaf3;
            background: #f8fafc;
            border-radius: 14px;
            padding: 12px;
        }

        .modal-content {
            border-radius: 20px;
            border: 0;
            box-shadow: 0 24px 70px rgba(15, 23, 42, .25);
        }

        @@media (max-width: 992px) {
            .page-shell {
                padding: 14px;
            }
        }
    </style>
</head>

<body>
    <div class="page-shell">

        <div class="hero mb-4">
            <div class="d-flex flex-wrap align-items-center justify-content-between gap-3">
                <div>
                    <h1 class="hero-title">
                        <i class="bi bi-gear-wide-connected me-2"></i>
                        Producción - Programa @e.ProgramaProduccionID
                    </h1>
                    <div class="hero-subtitle">
                        @e.TituloPrograma · @e.TextoMaquina
                    </div>
                </div>

                <div class="d-flex flex-wrap align-items-center gap-2">
                    <span class="badge @e.EstatusClase fs-6">
                        @e.EstatusNombre
                    </span>

                    <a href="@Url.Action("Index", "Produccion")" class="btn btn-light fw-bold">
                        <i class="bi bi-arrow-left me-1"></i>
                        Volver
                    </a>
                </div>
            </div>
        </div>

        @if (TempData["Success"] != null)
        {
            <div class="alert alert-success alert-dismissible fade show">
                <i class="bi bi-check-circle me-1"></i>
                @TempData["Success"]
                <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
            </div>
        }

        @if (TempData["Error"] != null)
        {
            <div class="alert alert-danger alert-dismissible fade show">
                <i class="bi bi-exclamation-triangle me-1"></i>
                @TempData["Error"]
                <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
            </div>
        }

        @if (TempData["Info"] != null)
        {
            <div class="alert alert-info alert-dismissible fade show">
                <i class="bi bi-info-circle me-1"></i>
                @TempData["Info"]
                <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
            </div>
        }

        <div class="row g-3 mb-4">
            <div class="col-6 col-lg">
                <div class="metric-card">
                    <div class="metric-label">Planeado</div>
                    <div class="metric-value">@(e.CantidadPlaneada?.ToString("N0") ?? "-")</div>
                </div>
            </div>

            <div class="col-6 col-lg">
                <div class="metric-card">
                    <div class="metric-label">OK</div>
                    <div class="metric-value text-success">@Model.TotalOK.ToString("N0")</div>
                </div>
            </div>

            <div class="col-6 col-lg">
                <div class="metric-card">
                    <div class="metric-label">Sospechoso</div>
                    <div class="metric-value text-warning">@Model.TotalSospechoso.ToString("N0")</div>
                </div>
            </div>

            <div class="col-6 col-lg">
                <div class="metric-card">
                    <div class="metric-label">Scrap</div>
                    <div class="metric-value text-danger">@Model.TotalScrap.ToString("N0")</div>
                </div>
            </div>

            <div class="col-6 col-lg">
                <div class="metric-card">
                    <div class="metric-label">Pendiente</div>
                    <div class="metric-value">@e.CantidadPendiente.ToString("N0")</div>
                </div>
            </div>

            <div class="col-6 col-lg">
                <div class="metric-card">
                    <div class="metric-label">Avance</div>
                    <div class="metric-value">@e.PorcentajeAvance.ToString("0.##")%</div>
                </div>
            </div>
        </div>

        <div class="panel mb-4">
            <div class="panel-body">
                <div class="d-flex justify-content-between small mb-1">
                    <span class="fw-bold text-primary">Avance de producción</span>
                    <span>@e.PorcentajeAvance.ToString("0.##")%</span>
                </div>
                <div class="progress">
                    <div class="progress-bar"
                         style="width:@avancePct.ToString("0.##", System.Globalization.CultureInfo.InvariantCulture)%">
                    </div>
                </div>
            </div>
        </div>

        <div class="row g-4">
            <div class="col-12 col-xl-4">

                <div class="panel mb-4">
                    <div class="panel-header">
                        <i class="bi bi-info-circle me-1"></i>
                        Datos de ejecución
                    </div>

                    <div class="panel-body">
                        <div class="row g-3">
                            <div class="col-6">
                                <div class="data-label">Máquina</div>
                                <div class="data-value">@e.MaquinaCodigo</div>
                                <div class="muted-small">@e.MaquinaNombre</div>
                            </div>

                            <div class="col-6">
                                <div class="data-label">Molde</div>
                                <div class="data-value">@(e.MoldeCodigo ?? "Sin molde")</div>
                            </div>

                            <div class="col-12">
                                <div class="data-label">Parte</div>
                                <div class="data-value">@e.TituloPrograma</div>
                                <div class="muted-small">@e.DescripcionParte</div>
                            </div>

                            <div class="col-6">
                                <div class="data-label">Operador</div>
                                <div class="data-value">@e.TextoOperador</div>
                            </div>

                            <div class="col-6">
                                <div class="data-label">Inicio real</div>
                                <div class="data-value">
                                    @(e.FechaInicioReal?.ToString("dd/MM/yyyy HH:mm") ?? "-")
                                </div>
                            </div>

                            <div class="col-6">
                                <div class="data-label">Fin real</div>
                                <div class="data-value">
                                    @(e.FechaFinReal?.ToString("dd/MM/yyyy HH:mm") ?? "-")
                                </div>
                            </div>

                            <div class="col-6">
                                <div class="data-label">Programa</div>
                                <div class="data-value">@e.ProgramaProduccionID</div>
                            </div>

                            <div class="col-6">
                                <div class="data-label">Ejecución</div>
                                <div class="data-value">@e.EjecucionProduccionID</div>
                            </div>
                        </div>
                    </div>
                </div>

                <div class="panel mb-4">
                    <div class="panel-header">
                        <i class="bi bi-clipboard2-check me-1"></i>
                        Checklist de arranque
                    </div>

                    <div class="panel-body">
                        @if (Model.ChecklistResumen == null)
                        {
                            <div class="alert alert-secondary mb-3">
                                <strong>Sin checklist generado.</strong><br />
                                Abre el checklist para generarlo y comenzar la captura de arranque.
                            </div>

                            <a href="@Url.Action("ChecklistArranque", "Produccion", new { ejecucionProduccionId = e.EjecucionProduccionID })"
                               class="btn btn-primary w-100 btn-strong">
                                <i class="bi bi-clipboard-check me-1"></i>
                                Generar checklist de arranque
                            </a>
                        }
                        else
                        {
                            var checklist = Model.ChecklistResumen;

                            <div class="d-flex flex-wrap justify-content-between align-items-start gap-3 mb-3">
                                <div>
                                    <div class="data-label">Estatus checklist</div>
                                    <div class="mt-1">
                                        <span class="badge @checklist.EstatusClase fs-6">
                                            @checklist.EstatusNombre
                                        </span>
                                    </div>
                                </div>

                                <div>
                                    <div class="data-label">Formato</div>
                                    <div class="data-value">
                                        @checklist.CodigoFormato @checklist.VersionFormato
                                    </div>
                                </div>

                                <div>
                                    <div class="data-label">Fecha</div>
                                    <div class="data-value">
                                        @checklist.FechaChecklist.ToString("dd/MM/yyyy HH:mm")
                                    </div>
                                </div>
                            </div>

                            <div class="row g-2 mb-3">
                                <div class="col-4">
                                    <div class="mini-stat">
                                        <div class="mini-stat-label">Preguntas</div>
                                        <div class="mini-stat-value">@checklist.TotalPreguntas</div>
                                    </div>
                                </div>

                                <div class="col-4">
                                    <div class="mini-stat">
                                        <div class="mini-stat-label">Respondidas</div>
                                        <div class="mini-stat-value text-success">@checklist.TotalRespondidas</div>
                                    </div>
                                </div>

                                <div class="col-4">
                                    <div class="mini-stat">
                                        <div class="mini-stat-label">NOK</div>
                                        <div class="mini-stat-value text-danger">@checklist.TotalNOK</div>
                                    </div>
                                </div>
                            </div>

                            @if (checklist.TotalNOK > 0)
                            {
                                <div class="alert alert-warning mb-3">
                                    <i class="bi bi-exclamation-triangle me-1"></i>
                                    Este checklist tiene respuestas NOK. Revisa que tengan observación.
                                </div>
                            }

                            <a href="@Url.Action("ChecklistArranque", "Produccion", new { ejecucionProduccionId = e.EjecucionProduccionID })"
                               class="btn btn-primary w-100 btn-strong">
                                <i class="bi bi-clipboard-check me-1"></i>
                                Abrir checklist de arranque
                            </a>
                        }
                    </div>
                </div>

                <div class="panel mb-4">
                    <div class="panel-header">
                        <i class="bi bi-patch-check me-1"></i>
                        Liberación de Calidad
                    </div>

                    <div class="panel-body">
                        @if (Model.CalidadResumen == null)
                        {
                            <div class="alert alert-secondary mb-0">
                                El checklist todavía no ha sido enviado a Calidad.
                            </div>
                        }
                        else
                        {
                            var calidad = Model.CalidadResumen;

                            <div class="d-flex flex-wrap justify-content-between gap-3 mb-3">
                                <div>
                                    <div class="data-label">Estado de Calidad</div>
                                    <span class="badge @calidad.ClaseBadge fs-6 mt-1">
                                        @calidad.EstadoTexto
                                    </span>
                                </div>

                                <div>
                                    <div class="data-label">Notificación</div>
                                    <div class="data-value">
                                        @(calidad.FechaNotificacionCalidad?.ToString("dd/MM/yyyy HH:mm") ?? "-")
                                    </div>
                                </div>

                                <div>
                                    <div class="data-label">Etiqueta verde</div>
                                    <div class="data-value">
                                        @(calidad.FechaLiberacionProduccion?.ToString("dd/MM/yyyy HH:mm") ?? "-")
                                    </div>
                                </div>
                            </div>

                            @if (!string.IsNullOrWhiteSpace(calidad.MotivoDevolucion))
                            {
                                <div class="alert alert-danger mb-3">
                                    <strong>Corrección solicitada por Calidad:</strong><br />
                                    @calidad.MotivoDevolucion
                                </div>
                            }

                            @if (calidad.ConfiguracionInvalidada)
                            {
                                <div class="alert alert-danger mb-3">
                                    La configuración de la corrida fue invalidada por cambios en Planeación.
                                </div>
                            }

                            <a href="@Url.Action("Detalle", "Calidad", new { id = calidad.InspeccionID })"
                               class="btn btn-outline-primary w-100 btn-strong">
                                <i class="bi bi-box-arrow-up-right me-1"></i>
                                Abrir seguimiento de Calidad
                            </a>
                        }
                    </div>
                </div>

                @if (e.EstatusID == ERP.NSQuell.Models.ProduccionEstatus.EnPreparacion && !Model.TieneParoAbierto)
                {
                    <div class="panel mb-4">
                        <div class="panel-header">
                            <i class="bi bi-play-circle me-1"></i>
                            Iniciar producción en serie
                        </div>

                        <div class="panel-body">
                            <div class="flow-note mb-3">
                                Este paso cambia la ejecución de preparación a producción en serie.
                                Solo se permite después de que Calidad libere las primeras piezas con etiqueta verde.
                            </div>

                            <form method="post" action="@Url.Action("IniciarSerie", "Produccion")">
                                @Html.AntiForgeryToken()

                                <input type="hidden"
                                       name="ejecucionProduccionId"
                                       value="@e.EjecucionProduccionID" />

                                <button type="submit"
                                        class="btn btn-success w-100 btn-strong"
                                        disabled="@(Model.CalidadResumen?.PuedeIniciarSerie != true)"
                                        onclick="return confirm('¿Confirmas iniciar producción en serie?');">
                                    <i class="bi bi-play-fill me-1"></i>
                                    Iniciar serie
                                </button>

                                @if (Model.CalidadResumen?.PuedeIniciarSerie != true)
                                {
                                    <div class="text-danger fw-bold small mt-2">
                                        Pendiente de liberación verde por Calidad.
                                    </div>
                                }
                            </form>
                        </div>
                    </div>
                }

                @if (e.PuedeRegistrarProduccion && !Model.TieneParoAbierto)
                {
                    <div class="panel mb-4">
                        <div class="panel-header">
                            <i class="bi bi-plus-circle me-1"></i>
                            Registrar piezas por hora
                        </div>

                        <div class="panel-body">
                            <form method="post" action="@Url.Action("RegistrarHora", "Produccion")">
                                @Html.AntiForgeryToken()

                                <input type="hidden" name="EjecucionProduccionID" value="@e.EjecucionProduccionID" />

                                <div class="mb-3">
                                    <label class="form-label fw-bold">Fecha</label>
                                    <input type="date"
                                           name="FechaProduccion"
                                           value="@DateTime.Today.ToString("yyyy-MM-dd")"
                                           class="form-control" />
                                </div>

                                <div class="row g-2 mb-3">
                                    <div class="col-6">
                                        <label class="form-label fw-bold">Hora inicio</label>
                                        <input type="time"
                                               name="HoraInicio"
                                               value="@horaInicio.ToString(@"hh\:mm")"
                                               class="form-control" />
                                    </div>

                                    <div class="col-6">
                                        <label class="form-label fw-bold">Hora fin</label>
                                        <input type="time"
                                               name="HoraFin"
                                               value="@horaFin.ToString(@"hh\:mm")"
                                               class="form-control" />
                                    </div>
                                </div>

                                <div class="row g-2 mb-3">
                                    <div class="col-4">
                                        <label class="form-label fw-bold text-success">OK</label>
                                        <input type="number" name="CantidadOK" min="0" value="0" class="form-control form-control-lg text-center fw-bold" />
                                    </div>

                                    <div class="col-4">
                                        <label class="form-label fw-bold text-warning">Sospechoso</label>
                                        <input type="number" name="CantidadSospechosa" min="0" value="0" class="form-control form-control-lg text-center fw-bold" />
                                    </div>

                                    <div class="col-4">
                                        <label class="form-label fw-bold text-danger">Scrap</label>
                                        <input type="number" name="CantidadScrap" min="0" value="0" class="form-control form-control-lg text-center fw-bold" />
                                    </div>
                                </div>

                                <div class="mb-3">
                                    <label class="form-label fw-bold">Observaciones</label>
                                    <textarea name="Observaciones" rows="2" maxlength="500" class="form-control"></textarea>
                                </div>

                                <button type="submit" class="btn btn-success w-100 btn-strong">
                                    <i class="bi bi-save me-1"></i>
                                    Guardar captura
                                </button>
                            </form>
                        </div>
                    </div>
                }

                @if (Model.TieneParoAbierto)
                {
                    var paroAbierto = Model.ParoAbierto;

                    <div class="panel mb-4 border-danger">
                        <div class="panel-header text-danger">
                            <i class="bi bi-pause-circle me-1"></i>
                            Paro abierto
                        </div>

                        <div class="panel-body">
                            <p class="mb-1">
                                <strong>Motivo:</strong> @(paroAbierto?.MotivoParoTexto ?? "Sin motivo")
                            </p>

                            <p class="mb-3">
                                <strong>Duración:</strong> @(paroAbierto?.DuracionTexto ?? "-")
                            </p>

                            <form method="post" action="@Url.Action("CerrarParo", "Produccion")">
                                @Html.AntiForgeryToken()

                                <input type="hidden" name="ParoID" value="@paroAbierto?.ParoID" />

                                <div class="mb-3">
                                    <label class="form-label fw-bold">Observaciones de cierre</label>
                                    <textarea name="ObservacionesCierre" rows="2" maxlength="500" class="form-control"></textarea>
                                </div>

                                <button type="submit" class="btn btn-primary w-100 btn-strong">
                                    <i class="bi bi-play-circle me-1"></i>
                                    Cerrar paro y reanudar
                                </button>
                            </form>
                        </div>
                    </div>
                }
                else if (e.PuedePausar)
                {
                    <div class="panel mb-4">
                        <div class="panel-header">
                            <i class="bi bi-pause-circle me-1"></i>
                            Registrar paro
                        </div>

                        <div class="panel-body">
                            <form method="post" action="@Url.Action("IniciarParo", "Produccion")">
                                @Html.AntiForgeryToken()

                                <input type="hidden" name="EjecucionProduccionID" value="@e.EjecucionProduccionID" />

                                <div class="mb-3">
                                    <label class="form-label fw-bold">Motivo</label>
                                    <select name="MotivoParoID" class="form-select">
                                        @foreach (var item in Model.MotivosParo)
                                        {
                                            <option value="@item.Value">@item.Text</option>
                                        }
                                    </select>
                                </div>

                                <div class="mb-3">
                                    <label class="form-label fw-bold">Descripción</label>
                                    <textarea name="Descripcion" rows="2" maxlength="500" class="form-control"></textarea>
                                </div>

                                <button type="submit" class="btn btn-warning w-100 btn-strong">
                                    <i class="bi bi-pause-fill me-1"></i>
                                    Iniciar paro
                                </button>
                            </form>
                        </div>
                    </div>
                }

                @if (e.PuedeTerminar && !Model.TieneParoAbierto)
                {
                    <div class="panel">
                        <div class="panel-header">
                            <i class="bi bi-flag me-1"></i>
                            Terminar producción
                        </div>

                        <div class="panel-body">
                            <form method="post" action="@Url.Action("Terminar", "Produccion")">
                                @Html.AntiForgeryToken()

                                <input type="hidden" name="EjecucionProduccionID" value="@e.EjecucionProduccionID" />

                                <div class="form-check form-switch mb-3">
                                    <input class="form-check-input"
                                           type="checkbox"
                                           name="TerminarParcial"
                                           value="true"
                                           id="TerminarParcial" />
                                    <label class="form-check-label fw-bold" for="TerminarParcial">
                                        Terminar parcial
                                    </label>
                                </div>

                                <div class="mb-3">
                                    <label class="form-label fw-bold">Observaciones</label>
                                    <textarea name="Observaciones" rows="2" maxlength="500" class="form-control"></textarea>
                                </div>

                                <button type="submit" class="btn btn-danger w-100 btn-strong">
                                    <i class="bi bi-check2-circle me-1"></i>
                                    Terminar producción
                                </button>
                            </form>
                        </div>
                    </div>
                }
            </div>

            <div class="col-12 col-xl-8">

                <div class="panel mb-4">
                    <div class="panel-header">
                        <i class="bi bi-box-seam me-1"></i>
                        Recepciones parciales contra OF
                    </div>

                    <div class="panel-body">
                        <div class="recepcion-alert mb-3">
                            <i class="bi bi-info-circle me-1"></i>
                            Este registro es manual mientras Almacén termina su integración. Puede capturarse por partes:
                            materia prima, componentes, embalaje o etiquetas. No descuenta inventario.
                        </div>

                        <form method="post" action="@Url.Action("GuardarRecepcionOF", "Produccion")" class="recepcion-form mb-4" id="formRecepcionOF">
                            @Html.AntiForgeryToken()

                            <input type="hidden" name="EjecucionProduccionID" value="@e.EjecucionProduccionID" />
                            <input type="hidden" name="ProgramaProduccionID" value="@e.ProgramaProduccionID" />

                            <div class="row g-3">
                                <div class="col-md-3">
                                    <label class="form-label">Tipo</label>
                                    <select name="TipoRecepcion" id="TipoRecepcion" class="form-select" required>
                                        <option value="">-- Selecciona --</option>
                                        <option value="MP">Materia prima</option>
                                        <option value="COMPONENTE">Componente</option>
                                        <option value="EMBALAJE">Embalaje</option>
                                        <option value="ETIQUETA">Etiqueta</option>
                                    </select>
                                </div>

                                <div class="col-md-3">
                                    <label class="form-label">Código</label>
                                    <input type="text" name="Codigo" class="form-control" maxlength="100" placeholder="Código interno / SAP" />
                                </div>

                                <div class="col-md-6">
                                    <label class="form-label">Descripción</label>
                                    <input type="text" name="Descripcion" class="form-control" maxlength="300" placeholder="Material, componente, caja, etiqueta..." />
                                </div>

                                <div class="col-md-3">
                                    <label class="form-label">Lote</label>
                                    <input type="text" name="Lote" class="form-control" maxlength="100" placeholder="Lote material" />
                                </div>

                                <div class="col-md-3">
                                    <label class="form-label">N.UI / Embalaje</label>
                                    <input type="text" name="NumeroUI" class="form-control" maxlength="100" placeholder="N.UI Emb" />
                                </div>

                                <div class="col-md-3 etiqueta-field">
                                    <label class="form-label">Etiqueta inicio</label>
                                    <input type="text" name="EtiquetaInicio" class="form-control" maxlength="100" placeholder="Inicio" />
                                </div>

                                <div class="col-md-3 etiqueta-field">
                                    <label class="form-label">Etiqueta fin</label>
                                    <input type="text" name="EtiquetaFin" class="form-control" maxlength="100" placeholder="Fin" />
                                </div>

                                <div class="col-md-3">
                                    <label class="form-label">Cantidad</label>
                                    <input type="number" name="Cantidad" class="form-control" step="0.0001" min="0" placeholder="0.0000" />
                                </div>

                                <div class="col-md-3">
                                    <label class="form-label">Unidad</label>
                                    <select name="Unidad" class="form-select">
                                        <option value="">-- Unidad --</option>
                                        <option value="KG">KG</option>
                                        <option value="PZA">PZA</option>
                                        <option value="CAJA">CAJA</option>
                                        <option value="ROLLO">ROLLO</option>
                                        <option value="RANGO">RANGO</option>
                                        <option value="N/A">N/A</option>
                                    </select>
                                </div>

                                <div class="col-md-3">
                                    <label class="form-label">Entregó</label>
                                    <input type="text" name="EntregadoPor" class="form-control" maxlength="200" placeholder="Persona / área" />
                                </div>

                                <div class="col-md-3">
                                    <label class="form-label">Recibió</label>
                                    <input type="text" name="RecibidoPor" class="form-control" maxlength="200" value="@e.TextoOperador" />
                                </div>

                                <div class="col-md-4">
                                    <label class="form-label">Fecha recepción</label>
                                    <input type="datetime-local" name="FechaRecepcion" class="form-control" value="@FechaInput(DateTime.Now)" />
                                </div>

                                <div class="col-md-8">
                                    <label class="form-label">Observaciones</label>
                                    <input type="text" name="Observaciones" class="form-control" maxlength="500" placeholder="Parcial, complemento, cambio de lote, entrega manual..." />
                                </div>

                                <div class="col-12 d-flex justify-content-end">
                                    <button type="submit" class="btn btn-primary btn-strong">
                                        <i class="bi bi-save me-1"></i>
                                        Guardar recepción
                                    </button>
                                </div>
                            </div>
                        </form>

                        <div class="table-responsive">
                            <table class="table table-hover align-middle mb-0">
                                <thead>
                                    <tr>
                                        <th>Tipo</th>
                                        <th>Código / descripción</th>
                                        <th>Lote / N.UI</th>
                                        <th>Etiqueta</th>
                                        <th class="text-end">Cantidad</th>
                                        <th>Entregó / recibió</th>
                                        <th>Fecha</th>
                                        <th>Observaciones</th>
                                        <th class="text-end">Acción</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @if (Model.RecepcionesOF == null || !Model.RecepcionesOF.Any())
                                    {
                                        <tr>
                                            <td colspan="9" class="text-center text-muted py-4">
                                                Sin recepciones registradas contra la OF.
                                            </td>
                                        </tr>
                                    }
                                    else
                                    {
                                        foreach (var r in Model.RecepcionesOF)
                                        {
                                            <tr>
                                                <td>
                                                    <span class="@TipoClase(r.TipoRecepcion)">
                                                        @r.TextoTipo
                                                    </span>
                                                </td>

                                                <td>
                                                    <div class="fw-bold">@Txt(r.Codigo)</div>
                                                    <div class="text-muted small">@Txt(r.Descripcion)</div>
                                                </td>

                                                <td>
                                                    <div><strong>Lote:</strong> @Txt(r.Lote)</div>
                                                    <div class="text-muted small"><strong>N.UI:</strong> @Txt(r.NumeroUI)</div>
                                                </td>

                                                <td>
                                                    <div><strong>Ini:</strong> @Txt(r.EtiquetaInicio)</div>
                                                    <div class="text-muted small"><strong>Fin:</strong> @Txt(r.EtiquetaFin)</div>
                                                </td>

                                                <td class="text-end fw-bold">
                                                    @Dec4(r.Cantidad)
                                                    <div class="text-muted small">@Txt(r.Unidad)</div>
                                                </td>

                                                <td>
                                                    <div><strong>Entregó:</strong> @Txt(r.EntregadoPor)</div>
                                                    <div class="text-muted small"><strong>Recibió:</strong> @Txt(r.RecibidoPor)</div>
                                                </td>

                                                <td>
                                                    @r.FechaRecepcion.ToString("dd/MM/yyyy HH:mm")
                                                </td>

                                                <td>
                                                    @Txt(r.Observaciones)
                                                </td>

                                                <td class="text-end">
                                                    <button type="button"
                                                            class="btn btn-sm btn-outline-danger btn-strong"
                                                            data-bs-toggle="modal"
                                                            data-bs-target="#modalCancelarRecepcion"
                                                            data-recepcion-id="@r.RecepcionOFID"
                                                            data-tipo="@r.TextoTipo"
                                                            data-descripcion="@Txt(r.Descripcion)">
                                                        <i class="bi bi-x-circle me-1"></i>
                                                        Cancelar
                                                    </button>
                                                </td>
                                            </tr>
                                        }
                                    }
                                </tbody>
                            </table>
                        </div>
                    </div>
                </div>

                <div class="panel mb-4">
                    <div class="panel-header">
                        <i class="bi bi-clock-history me-1"></i>
                        Capturas por hora
                    </div>

                    <div class="table-responsive">
                        <table class="table table-hover mb-0 align-middle">
                            <thead>
                                <tr>
                                    <th>Fecha</th>
                                    <th>Hora</th>
                                    <th class="text-center">OK</th>
                                    <th class="text-center">Sospechoso</th>
                                    <th class="text-center">Scrap</th>
                                    <th>Observaciones</th>
                                </tr>
                            </thead>
                            <tbody>
                                @if (!Model.RegistrosHora.Any())
                                {
                                    <tr>
                                        <td colspan="6" class="text-center text-muted py-4">
                                            Sin capturas por hora.
                                        </td>
                                    </tr>
                                }
                                else
                                {
                                    foreach (var r in Model.RegistrosHora)
                                    {
                                        <tr>
                                            <td>@r.FechaProduccion.ToString("dd/MM/yyyy")</td>
                                            <td class="fw-bold">@r.RangoHora</td>
                                            <td class="text-center fw-bold text-success">@r.CantidadOK.ToString("N0")</td>
                                            <td class="text-center fw-bold text-warning">@r.CantidadSospechosa.ToString("N0")</td>
                                            <td class="text-center fw-bold text-danger">@r.CantidadScrap.ToString("N0")</td>
                                            <td>@r.Observaciones</td>
                                        </tr>
                                    }
                                }
                            </tbody>
                        </table>
                    </div>
                </div>

                <div class="panel">
                    <div class="panel-header">
                        <i class="bi bi-pause-circle me-1"></i>
                        Historial de paros
                    </div>

                    <div class="table-responsive">
                        <table class="table table-hover mb-0 align-middle">
                            <thead>
                                <tr>
                                    <th>Inicio</th>
                                    <th>Fin</th>
                                    <th>Duración</th>
                                    <th>Motivo</th>
                                    <th>Mayor a 15 min</th>
                                    <th>Descripción</th>
                                </tr>
                            </thead>
                            <tbody>
                                @if (!Model.Paros.Any())
                                {
                                    <tr>
                                        <td colspan="6" class="text-center text-muted py-4">
                                            Sin paros registrados.
                                        </td>
                                    </tr>
                                }
                                else
                                {
                                    foreach (var p in Model.Paros)
                                    {
                                        <tr>
                                            <td>@p.FechaInicioParo.ToString("dd/MM/yyyy HH:mm")</td>
                                            <td>@(p.FechaFinParo?.ToString("dd/MM/yyyy HH:mm") ?? "Abierto")</td>
                                            <td class="fw-bold">@p.DuracionTexto</td>
                                            <td>@p.MotivoParoTexto</td>
                                            <td>
                                                @if (p.EsMayorA15Minutos)
                                                {
                                                    <span class="badge bg-danger">Sí</span>
                                                }
                                                else
                                                {
                                                    <span class="badge bg-secondary">No</span>
                                                }
                                            </td>
                                            <td>@p.Descripcion</td>
                                        </tr>
                                    }
                                }
                            </tbody>
                        </table>
                    </div>
                </div>

            </div>
        </div>

    </div>

    <div class="modal fade" id="modalCancelarRecepcion" tabindex="-1" aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content">
                <form method="post" action="@Url.Action("CancelarRecepcionOF", "Produccion")">
                    @Html.AntiForgeryToken()

                    <div class="modal-header bg-danger text-white">
                        <h5 class="modal-title fw-bold">
                            <i class="bi bi-x-circle me-1"></i>
                            Cancelar recepción
                        </h5>
                        <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
                    </div>

                    <div class="modal-body">
                        <input type="hidden" name="recepcionOFId" id="cancelarRecepcionOFId" />
                        <input type="hidden" name="ejecucionProduccionId" value="@e.EjecucionProduccionID" />

                        <div class="soft-box mb-3">
                            <div class="data-label">Recepción</div>
                            <div class="data-value" id="cancelarRecepcionTexto">-</div>
                        </div>

                        <label class="form-label">Motivo de cancelación</label>
                        <textarea name="motivoCancelacion"
                                  class="form-control"
                                  rows="3"
                                  maxlength="500"
                                  required
                                  placeholder="Explica por qué se cancela esta recepción..."></textarea>
                    </div>

                    <div class="modal-footer">
                        <button type="button" class="btn btn-light btn-strong" data-bs-dismiss="modal">
                            Cerrar
                        </button>
                        <button type="submit" class="btn btn-danger btn-strong">
                            Confirmar cancelación
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>

    <script>
        const tipoRecepcion = document.getElementById('TipoRecepcion');
        const etiquetaFields = document.querySelectorAll('.etiqueta-field');

        function actualizarCamposEtiqueta() {
            const tipo = (tipoRecepcion?.value || '').toUpperCase();

            etiquetaFields.forEach(function (el) {
                el.style.display = tipo === 'ETIQUETA' ? '' : 'none';
            });
        }

        tipoRecepcion?.addEventListener('change', actualizarCamposEtiqueta);
        actualizarCamposEtiqueta();

        const modalCancelarRecepcion = document.getElementById('modalCancelarRecepcion');

        modalCancelarRecepcion?.addEventListener('show.bs.modal', function (event) {
            const btn = event.relatedTarget;

            if (!btn) return;

            const recepcionId = btn.getAttribute('data-recepcion-id') || '';
            const tipo = btn.getAttribute('data-tipo') || '';
            const descripcion = btn.getAttribute('data-descripcion') || '';

            const inputId = document.getElementById('cancelarRecepcionOFId');
            const texto = document.getElementById('cancelarRecepcionTexto');

            if (inputId) {
                inputId.value = recepcionId;
            }

            if (texto) {
                texto.textContent = tipo + ' · ' + descripcion;
            }
        });
    </script>
</body>
</html>