@using ERP.NSQuell.Models
@model ProduccionPreparacionIndexVm
@{
    Layout = "_Layout";
    ViewData["Title"] = "Preparación de producción";
    var tareas = Model.Tareas ?? new List<ProduccionPreparacionTareaVm>();
    var secados = tareas.Where(x => x.EsSecadoMaterial && !x.EstaConfirmada).OrderBy(x => x.FechaAviso).ToList();
    var embalajes = tareas.Where(x => x.EsPreparacionEmbalaje && !x.EstaConfirmada).OrderBy(x => x.FechaAviso).ToList();
    var moldes = tareas.Where(x => x.EsCambioMolde && !x.EstaConfirmada).OrderBy(x => x.FechaAviso).ToList();
    var completadas = tareas.Where(x => x.EstaConfirmada).OrderByDescending(x => x.FechaConfirmacion).Take(40).ToList();
    var filtroActual = string.IsNullOrWhiteSpace(Model.Filtro) ? "" : Model.Filtro;
    string Fecha(DateTime? fecha) => fecha?.ToString("dd/MM/yyyy HH:mm") ?? "—";
    string Hora(DateTime? fecha) => fecha?.ToString("HH:mm") ?? "—";
    string Horas(decimal? horas) => horas.HasValue ? $"{horas.Value:0.##} h" : "—";
    string Operador(ProduccionPreparacionTareaVm t) => string.IsNullOrWhiteSpace(t.TextoOperadores) ? "Sin operador asignado" : t.TextoOperadores;
    string ClaseEstado(ProduccionPreparacionTareaVm t) => t.EsVencida ? "estado-vencida" : t.EsHacerAhora ? "estado-ahora" : "estado-proxima";
    string TextoEstado(ProduccionPreparacionTareaVm t) => t.EsVencida ? "Vencida" : t.EsHacerAhora ? "Hacer ahora" : "Próxima";
    string TituloTarea(ProduccionPreparacionTareaVm t) => t.EsSecadoMaterial ? t.TextoMaterial : t.EsCambioMolde ? t.TextoCambioMolde : t.TextoEmbalaje;
    string MaquinaTexto(ProduccionPreparacionTareaVm t) => string.IsNullOrWhiteSpace(t.MaquinaNombre) ? (t.MaquinaCodigo ?? "Sin máquina") : $"{t.MaquinaCodigo} · {t.MaquinaNombre}";
}
<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <script>
        (function () {
            const STORAGE_KEY = 'nsq-theme';

            function applyStoredTheme(value) {
                const theme = value === 'light' ? 'light' : 'dark';
                const root = document.documentElement;

                root.setAttribute('data-nsq-theme', theme);
                root.setAttribute('data-bs-theme', theme);
                root.style.colorScheme = theme;
            }

            let savedTheme = 'dark';

            try {
                savedTheme = localStorage.getItem(STORAGE_KEY) || 'dark';
            } catch (_) {
                savedTheme = 'dark';
            }

            applyStoredTheme(savedTheme);

            window.addEventListener('storage', function (event) {
                if (event.key === STORAGE_KEY) {
                    applyStoredTheme(event.newValue || 'dark');
                }
            });
        })();
    </script>
    <title>@ViewData["Title"]</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet" />
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.css" rel="stylesheet" />
    <style>
        :root {
            --navy: #0d2350;
            --blue: #2857e4;
            --purple: #623cff;
            --line: #dce4ef;
            --bg: #f4f7fb;
            --text: #10224a;
            --muted: #6f7b91;
            --red: #c4322b;
            --redbg: #fff3f2;
            --orange: #d07a00;
            --orangebg: #fff8e9;
            --green: #238353;
            --greenbg: #eefaf3;
            --secado: #d89216;
            --embalaje: #4264e7;
            --molde: #7a4de0;
            --completa: #2e9561;
            --shadow: 0 12px 30px rgba(15,34,74,.07)
        }

        * {
            box-sizing: border-box
        }

        body {
            margin: 0;
            background: var(--bg);
            color: var(--text);
            font-family: Inter,system-ui,-apple-system,BlinkMacSystemFont,"Segoe UI",sans-serif
        }

        .page {
            min-height: 100vh;
            padding: 18px
        }

        .hero {
            display: flex;
            align-items: center;
            justify-content: space-between;
            gap: 16px;
            padding: 18px 20px;
            border-radius: 20px;
            background: linear-gradient(120deg,#24165e,#4439a9 68%,#6254eb);
            color: #fff;
            box-shadow: 0 18px 45px rgba(27,43,124,.18)
        }

        .hero-main {
            display: flex;
            align-items: center;
            gap: 14px
        }

        .hero-icon {
            width: 52px;
            height: 52px;
            border-radius: 15px;
            background: rgba(255,255,255,.14);
            display: grid;
            place-items: center;
            font-size: 1.45rem
        }

        .hero h1 {
            margin: 0;
            font-size: 1.45rem;
            font-weight: 950
        }

        .hero p {
            margin: 3px 0 0;
            color: rgba(255,255,255,.78);
            font-size: .8rem;
            font-weight: 650
        }

        .hero-actions {
            display: flex;
            gap: 8px;
            flex-wrap: wrap
        }

        .btnx {
            min-height: 40px;
            border-radius: 11px;
            border: 1px solid #ccd7e5;
            background: #fff;
            color: #203150;
            padding: 8px 13px;
            text-decoration: none;
            font-weight: 900;
            display: inline-flex;
            align-items: center;
            justify-content: center;
            gap: 7px;
            cursor: pointer
        }

            .btnx:hover {
                color: #1746d1
            }

        .btnx-light {
            background: rgba(255,255,255,.11);
            border-color: rgba(255,255,255,.28);
            color: #fff
        }

            .btnx-light:hover {
                background: #fff;
                color: #283d9e
            }

        .btnx-primary {
            background: var(--purple);
            border-color: var(--purple);
            color: #fff
        }

            .btnx-primary:hover {
                background: #5030e2;
                color: #fff
            }

        .filters {
            margin-top: 14px;
            background: #fff;
            border: 1px solid var(--line);
            border-radius: 16px;
            padding: 12px 14px;
            display: grid;
            grid-template-columns: minmax(220px,1fr) 260px auto;
            gap: 10px;
            align-items: end;
            box-shadow: 0 8px 22px rgba(15,34,74,.035)
        }

        .field label {
            display: block;
            margin-bottom: 5px;
            font-size: .64rem;
            font-weight: 950;
            text-transform: uppercase;
            letter-spacing: .04em;
            color: #69758b
        }

        .field input, .field select {
            width: 100%;
            min-height: 41px;
            border: 1px solid #cfd9e6;
            border-radius: 10px;
            background: #fff;
            padding: 8px 10px;
            font-weight: 750;
            color: #17233d
        }

            .field input:focus, .field select:focus {
                outline: none;
                border-color: #7180ff;
                box-shadow: 0 0 0 3px rgba(79,92,255,.11)
            }

        .alertx {
            border-radius: 14px;
            padding: 11px 13px;
            margin-top: 12px;
            font-size: .78rem;
            font-weight: 800
        }

        .type-nav {
            display: grid;
            grid-template-columns: repeat(4,minmax(0,1fr));
            gap: 10px;
            margin-top: 14px
        }

        .type-btn {
            border: 1px solid var(--line);
            background: #fff;
            border-radius: 16px;
            padding: 14px 15px;
            text-align: left;
            box-shadow: var(--shadow);
            cursor: pointer;
            transition: .15s ease;
            min-height: 96px
        }

            .type-btn:hover {
                transform: translateY(-1px);
                border-color: #b9c8dc
            }

            .type-btn.active {
                border-color: #6f7eff;
                box-shadow: 0 12px 28px rgba(79,92,255,.14)
            }

        .type-row {
            display: flex;
            align-items: center;
            gap: 10px
        }

        .type-icon {
            width: 40px;
            height: 40px;
            border-radius: 12px;
            display: grid;
            place-items: center;
            font-size: 1.05rem
        }

            .type-icon.secado {
                background: #fff3de;
                color: var(--secado)
            }

            .type-icon.embalaje {
                background: #eef3ff;
                color: var(--embalaje)
            }

            .type-icon.molde {
                background: #f4efff;
                color: var(--molde)
            }

            .type-icon.ok {
                background: var(--greenbg);
                color: var(--completa)
            }

        .type-btn h3 {
            margin: 0;
            font-size: .83rem;
            font-weight: 950
        }

        .type-btn p {
            margin: 3px 0 0;
            color: var(--muted);
            font-size: .66rem;
            font-weight: 700
        }

        .type-badges {
            display: flex;
            gap: 5px;
            flex-wrap: wrap;
            margin-top: 8px
        }

        .mini {
            display: inline-flex;
            align-items: center;
            gap: 4px;
            padding: 4px 7px;
            border-radius: 999px;
            font-size: .6rem;
            font-weight: 950
        }

            .mini.red {
                background: var(--redbg);
                color: var(--red)
            }

            .mini.orange {
                background: var(--orangebg);
                color: var(--orange)
            }

            .mini.blue {
                background: #eef2ff;
                color: #3656c8
            }

            .mini.green {
                background: var(--greenbg);
                color: var(--green)
            }

        .urgency-nav {
            display: flex;
            gap: 7px;
            overflow: auto;
            margin: 12px 0 10px;
            padding-bottom: 2px
        }

        .urgency-btn {
            white-space: nowrap;
            border: 1px solid #d2dcea;
            background: #fff;
            color: #536079;
            border-radius: 999px;
            padding: 8px 12px;
            font-size: .72rem;
            font-weight: 900;
            cursor: pointer
        }

            .urgency-btn.active {
                background: #24165e;
                color: #fff;
                border-color: #24165e
            }

        .panel {
            display: none
        }

            .panel.active {
                display: block
            }

        .section-head {
            display: flex;
            align-items: center;
            justify-content: space-between;
            gap: 12px;
            margin: 10px 2px
        }

            .section-head h2 {
                font-size: 1rem;
                margin: 0;
                font-weight: 950
            }

            .section-head p {
                margin: 2px 0 0;
                color: var(--muted);
                font-size: .71rem;
                font-weight: 650
            }

        .section-count {
            min-width: 32px;
            height: 28px;
            border-radius: 999px;
            display: grid;
            place-items: center;
            padding: 0 9px;
            background: #e9eef6;
            font-size: .71rem;
            font-weight: 950
        }

        .machine-group {
            background: #fff;
            border: 1px solid #dbe4ef;
            border-radius: 16px;
            overflow: hidden;
            box-shadow: 0 10px 26px rgba(15,34,74,.06);
            margin-bottom: 12px
        }

            .machine-group summary {
                list-style: none;
                cursor: pointer;
                padding: 13px 15px;
                display: flex;
                align-items: center;
                justify-content: space-between;
                gap: 12px;
                background: #f8faff;
                border-bottom: 1px solid transparent
            }

            .machine-group[open] summary {
                border-bottom-color: #e3e9f2
            }

            .machine-group summary::-webkit-details-marker {
                display: none
            }

            .machine-group summary::after {
                content: "\F282";
                font-family: "bootstrap-icons";
                font-size: .8rem;
                color: #64728b;
                transition: transform .15s ease
            }

            .machine-group[open] summary::after {
                transform: rotate(180deg)
            }

        .machine-group-title {
            display: flex;
            align-items: center;
            gap: 10px;
            min-width: 0
        }

            .machine-group-title strong {
                display: block;
                color: #122550;
                font-size: .82rem;
                font-weight: 950
            }

            .machine-group-title small {
                display: block;
                color: #77839a;
                font-size: .63rem;
                font-weight: 750;
                margin-top: 2px
            }

        .machine-group-icon {
            width: 36px;
            height: 36px;
            border-radius: 10px;
            display: grid;
            place-items: center;
            flex: none
        }

            .machine-group-icon.secado {
                background: #fff3de;
                color: var(--secado)
            }

            .machine-group-icon.embalaje {
                background: #eef3ff;
                color: var(--embalaje)
            }

            .machine-group-icon.molde {
                background: #f4efff;
                color: var(--molde)
            }

            .machine-group-icon.completa {
                background: var(--greenbg);
                color: var(--completa)
            }

        .machine-group-count {
            margin-left: auto;
            margin-right: 10px;
            padding: 5px 9px;
            border-radius: 999px;
            background: #eef2f8;
            color: #48566f;
            font-size: .62rem;
            font-weight: 950
        }

        .machine-group-body {
            padding: 10px;
            background: #f4f7fb
        }

        .task-list {
            display: flex;
            flex-direction: column;
            gap: 10px
        }

        .task {
            position: relative;
            background: #fff;
            border: 1px solid var(--line);
            border-radius: 16px;
            box-shadow: var(--shadow);
            overflow: hidden
        }

            .task::after {
                content: "";
                position: absolute;
                left: 0;
                right: 0;
                bottom: 0;
                height: 5px
            }

            .task.tipo-secado::after {
                background: var(--secado)
            }

            .task.tipo-embalaje::after {
                background: var(--embalaje)
            }

            .task.tipo-molde::after {
                background: var(--molde)
            }

            .task.tipo-completa::after {
                background: var(--completa)
            }

            .task.estado-vencida {
                border-left: 5px solid var(--red)
            }

            .task.estado-ahora {
                border-left: 5px solid var(--orange)
            }

            .task.estado-proxima {
                border-left: 5px solid var(--blue)
            }

            .task.completa {
                border-left: 5px solid var(--green);
                opacity: .96
            }

        .task-main {
            padding: 14px 15px;
            display: grid;
            grid-template-columns: minmax(0,1.25fr) minmax(300px,.9fr) auto;
            gap: 16px;
            align-items: center
        }

        .task-title {
            display: flex;
            gap: 11px;
            align-items: flex-start
        }

        .task-icon {
            width: 42px;
            height: 42px;
            border-radius: 12px;
            display: grid;
            place-items: center;
            flex: none;
            font-size: 1.1rem
        }

        .tipo-secado .task-icon {
            background: #fff5df;
            color: var(--secado)
        }

        .tipo-embalaje .task-icon {
            background: #eef3ff;
            color: var(--embalaje)
        }

        .tipo-molde .task-icon {
            background: #f4efff;
            color: var(--molde)
        }

        .tipo-completa .task-icon {
            background: var(--greenbg);
            color: var(--completa)
        }

        .task-kicker {
            display: flex;
            gap: 6px;
            flex-wrap: wrap;
            align-items: center;
            margin-bottom: 3px
        }

        .task-type {
            font-size: .64rem;
            font-weight: 950;
            text-transform: uppercase;
            letter-spacing: .06em
        }

        .chip {
            display: inline-flex;
            align-items: center;
            gap: 4px;
            padding: 4px 7px;
            border-radius: 999px;
            background: #f0f3f8;
            color: #56637a;
            font-size: .6rem;
            font-weight: 900
        }

        .task h3 {
            margin: 0;
            font-size: .96rem;
            font-weight: 950;
            color: #0d214d
        }

        .task-sub {
            margin-top: 3px;
            color: #677289;
            font-size: .71rem;
            font-weight: 700;
            line-height: 1.35
        }

        .task-info {
            display: grid;
            grid-template-columns: 1fr 1fr;
            gap: 7px 13px
        }

            .task-info span {
                display: block;
                color: #8791a3;
                font-size: .58rem;
                font-weight: 950;
                text-transform: uppercase;
                letter-spacing: .04em
            }

            .task-info b {
                display: block;
                color: #1c2d52;
                font-size: .72rem;
                font-weight: 900;
                white-space: nowrap;
                overflow: hidden;
                text-overflow: ellipsis
            }

        .task-action {
            text-align: right;
            min-width: 205px
        }

        .status-text {
            font-size: .74rem;
            font-weight: 950
        }

            .status-text.red {
                color: var(--red)
            }

            .status-text.orange {
                color: var(--orange)
            }

            .status-text.blue {
                color: var(--blue)
            }

            .status-text.green {
                color: var(--green)
            }

        .task-date {
            display: block;
            margin: 3px 0 8px;
            color: #7d889b;
            font-size: .65rem;
            font-weight: 700
        }

        .confirm-form {
            display: flex;
            gap: 7px;
            justify-content: flex-end;
            align-items: center
        }

            .confirm-form input[type=text] {
                width: 170px;
                min-height: 36px;
                border: 1px solid #ccd7e5;
                border-radius: 9px;
                padding: 7px 9px;
                font-size: .69rem
            }

        .task-details {
            padding: 12px 15px 15px;
            background: #fafcff;
            border-top: 1px solid #e7edf5;
            display: grid;
            grid-template-columns: repeat(4,minmax(0,1fr));
            gap: 10px
        }

        .detail {
            border-right: 1px solid #e2e8f0;
            padding-right: 10px
        }

            .detail:last-child {
                border-right: 0
            }

            .detail span {
                display: block;
                color: #8893a5;
                font-size: .58rem;
                font-weight: 950;
                text-transform: uppercase
            }

            .detail strong {
                display: block;
                margin-top: 2px;
                color: #263855;
                font-size: .71rem;
                font-weight: 850;
                line-height: 1.35
            }

        .big-number {
            font-size: 1.25rem !important;
            color: #17205f !important
        }

        .warn {
            margin-top: 6px;
            padding: 7px 9px;
            border-radius: 8px;
            background: #fff1f0;
            border: 1px solid #f5b7b2;
            color: #a61b14;
            font-size: .66rem;
            font-weight: 900
        }

        .empty {
            background: #fff;
            border: 1px dashed #c9d5e4;
            border-radius: 15px;
            padding: 28px 18px;
            text-align: center;
            color: #718096
        }

            .empty i {
                font-size: 1.5rem;
                display: block;
                margin-bottom: 7px
            }

            .empty strong {
                display: block;
                color: #33445f
            }

        .hidden-by-filter {
            display: none !important
        }

        @@media(max-width:1100px) {
            .type-nav {
                grid-template-columns: 1fr 1fr
            }

            .task-main {
                grid-template-columns: 1fr
            }

            .task-action {
                text-align: left;
                min-width: 0
            }

            .confirm-form {
                justify-content: flex-start
            }

            .task-details {
                grid-template-columns: 1fr 1fr
            }
        }

        @@media(max-width:760px) {
            .page {
                padding: 10px
            }

            .hero {
                padding: 16px;
                align-items: flex-start
            }

            .filters {
                grid-template-columns: 1fr
            }

            .type-nav {
                grid-template-columns: 1fr
            }

            .task-info {
                grid-template-columns: 1fr 1fr
            }

            .task-details {
                grid-template-columns: 1fr
            }

            .detail {
                border-right: 0;
                border-bottom: 1px solid #e2e8f0;
                padding: 0 0 8px
            }

                .detail:last-child {
                    border-bottom: 0
                }

            .confirm-form {
                flex-direction: column;
                align-items: stretch
            }

                .confirm-form input[type=text] {
                    width: 100%
                }
        }


        /* =====================================================
                   TEMA CLARO - CONTRASTE EXPLICITO
                   Evita que estilos globales del Layout oculten textos
                   dentro de tarjetas cuando data-nsq-theme="light".
                   ===================================================== */
        html[data-nsq-theme="light"] body {
            background: var(--bg);
            color: var(--text);
        }

        html[data-nsq-theme="light"] .filters,
        html[data-nsq-theme="light"] .type-btn,
        html[data-nsq-theme="light"] .machine-group,
        html[data-nsq-theme="light"] .task,
        html[data-nsq-theme="light"] .empty {
            background: #fff;
            color: #10224a;
        }

            html[data-nsq-theme="light"] .type-btn h3,
            html[data-nsq-theme="light"] .section-head h2,
            html[data-nsq-theme="light"] .machine-group-title strong,
            html[data-nsq-theme="light"] .task h3,
            html[data-nsq-theme="light"] .task-info b,
            html[data-nsq-theme="light"] .detail strong,
            html[data-nsq-theme="light"] .empty strong {
                color: #10224a !important;
                opacity: 1 !important;
                -webkit-text-fill-color: #10224a;
            }

            html[data-nsq-theme="light"] .type-btn p,
            html[data-nsq-theme="light"] .section-head p,
            html[data-nsq-theme="light"] .machine-group-title small,
            html[data-nsq-theme="light"] .task-sub,
            html[data-nsq-theme="light"] .task-date,
            html[data-nsq-theme="light"] .task-info span,
            html[data-nsq-theme="light"] .detail span {
                color: #667085 !important;
                opacity: 1 !important;
                -webkit-text-fill-color: #667085;
            }

        html[data-nsq-theme="light"] .task-type {
            color: #344054 !important;
            opacity: 1 !important;
            -webkit-text-fill-color: #344054;
        }

        html[data-nsq-theme="light"] .chip {
            background: #f0f3f8;
            color: #475467 !important;
            border: 1px solid #dbe3ee;
        }

        html[data-nsq-theme="light"] .machine-group summary {
            background: #f8faff;
            color: #10224a;
        }

        html[data-nsq-theme="light"] .machine-group-body {
            background: #f4f7fb;
        }

        html[data-nsq-theme="light"] .task-details {
            background: #fafcff;
            border-top-color: #e7edf5;
        }

        html[data-nsq-theme="light"] .field input,
        html[data-nsq-theme="light"] .field select,
        html[data-nsq-theme="light"] .confirm-form input[type=text] {
            background: #fff;
            color: #17233d !important;
            -webkit-text-fill-color: #17233d;
        }

            html[data-nsq-theme="light"] .field input::placeholder,
            html[data-nsq-theme="light"] .confirm-form input[type=text]::placeholder {
                color: #98a2b3;
                opacity: 1;
            }

        /* =====================================================
                   TEMA GLOBAL ERP
                   Esta pantalla es standalone (Layout = null), por eso
                   lee nsq-theme desde localStorage al cargar.
                   ===================================================== */
        html[data-nsq-theme="dark"] {
            --line: #2d3e55;
            --bg: #0b1220;
            --text: #e7eef9;
            --muted: #9aa9bd;
            --redbg: #351719;
            --orangebg: #2b2313;
            --greenbg: #102a20;
            --shadow: 0 12px 30px rgba(0,0,0,.16);
        }

            html[data-nsq-theme="dark"] body {
                background: #0b1220;
                color: #e7eef9;
            }

            html[data-nsq-theme="dark"] .filters,
            html[data-nsq-theme="dark"] .type-btn,
            html[data-nsq-theme="dark"] .machine-group,
            html[data-nsq-theme="dark"] .task,
            html[data-nsq-theme="dark"] .empty {
                background: #111b2d;
                border-color: #2d3e55;
            }

            html[data-nsq-theme="dark"] .btnx:not(.btnx-light):not(.btnx-primary),
            html[data-nsq-theme="dark"] .urgency-btn {
                background: #17263c;
                border-color: #354961;
                color: #dce7f6;
            }

                html[data-nsq-theme="dark"] .btnx:not(.btnx-light):not(.btnx-primary):hover,
                html[data-nsq-theme="dark"] .urgency-btn:hover {
                    background: #1d2d45;
                    border-color: #58779e;
                    color: #fff;
                }

            html[data-nsq-theme="dark"] .field label,
            html[data-nsq-theme="dark"] .task-sub,
            html[data-nsq-theme="dark"] .task-date,
            html[data-nsq-theme="dark"] .section-head p,
            html[data-nsq-theme="dark"] .machine-group-title small,
            html[data-nsq-theme="dark"] .task-info span,
            html[data-nsq-theme="dark"] .detail span {
                color: #9aa9bd;
            }

            html[data-nsq-theme="dark"] .field input,
            html[data-nsq-theme="dark"] .field select,
            html[data-nsq-theme="dark"] .confirm-form input[type=text] {
                background: #0d1727;
                border-color: #354961;
                color: #eaf2ff;
            }

                html[data-nsq-theme="dark"] .field input::placeholder,
                html[data-nsq-theme="dark"] .confirm-form input[type=text]::placeholder {
                    color: #75869d;
                }

                html[data-nsq-theme="dark"] .field input:focus,
                html[data-nsq-theme="dark"] .field select:focus,
                html[data-nsq-theme="dark"] .confirm-form input[type=text]:focus {
                    border-color: #5da6ff;
                    box-shadow: 0 0 0 3px rgba(93,166,255,.14);
                    outline: none;
                }

            html[data-nsq-theme="dark"] .type-btn:hover {
                border-color: #58779e;
            }

            html[data-nsq-theme="dark"] .type-btn.active {
                border-color: #7f8cff;
                box-shadow: 0 12px 28px rgba(79,92,255,.16);
            }

            html[data-nsq-theme="dark"] .type-icon.secado,
            html[data-nsq-theme="dark"] .machine-group-icon.secado,
            html[data-nsq-theme="dark"] .tipo-secado .task-icon {
                background: #2b2313;
            }

            html[data-nsq-theme="dark"] .type-icon.embalaje,
            html[data-nsq-theme="dark"] .machine-group-icon.embalaje,
            html[data-nsq-theme="dark"] .tipo-embalaje .task-icon {
                background: #102b4c;
            }

            html[data-nsq-theme="dark"] .type-icon.molde,
            html[data-nsq-theme="dark"] .machine-group-icon.molde,
            html[data-nsq-theme="dark"] .tipo-molde .task-icon {
                background: #241b38;
            }

            html[data-nsq-theme="dark"] .type-icon.ok,
            html[data-nsq-theme="dark"] .machine-group-icon.completa,
            html[data-nsq-theme="dark"] .tipo-completa .task-icon {
                background: #102a20;
            }

            html[data-nsq-theme="dark"] .mini.blue {
                background: #102b4c;
                color: #9dcaff;
            }

            html[data-nsq-theme="dark"] .machine-group summary {
                background: #152238;
            }

            html[data-nsq-theme="dark"] .machine-group[open] summary {
                border-bottom-color: #2d3e55;
            }

            html[data-nsq-theme="dark"] .machine-group summary::after {
                color: #9aa9bd;
            }

            html[data-nsq-theme="dark"] .machine-group-title strong,
            html[data-nsq-theme="dark"] .task h3,
            html[data-nsq-theme="dark"] .task-info b,
            html[data-nsq-theme="dark"] .detail strong,
            html[data-nsq-theme="dark"] .empty strong {
                color: #eaf2ff;
            }

            html[data-nsq-theme="dark"] .machine-group-count,
            html[data-nsq-theme="dark"] .section-count,
            html[data-nsq-theme="dark"] .chip {
                background: #17263c;
                color: #cbd7e7;
            }

            html[data-nsq-theme="dark"] .machine-group-body {
                background: #0f1828;
            }

            html[data-nsq-theme="dark"] .task-details {
                background: #101a2b;
                border-top-color: #2d3e55;
            }

            html[data-nsq-theme="dark"] .detail {
                border-color: #2d3e55;
            }

            html[data-nsq-theme="dark"] .big-number {
                color: #d9ebff !important;
            }

            html[data-nsq-theme="dark"] .warn {
                background: #351719;
                border-color: #7f2b32;
                color: #ff9ca8;
            }

            html[data-nsq-theme="dark"] .empty {
                color: #9aa9bd;
            }
    </style>
</head>
<body>
    <div class="page">
        <section class="hero"><div class="hero-main"><div class="hero-icon"><i class="bi bi-tools"></i></div><div><h1>Preparación de producción</h1><p>Organiza secado, embalaje y cambios de molde antes del arranque.</p></div></div><div class="hero-actions"><a class="btnx btnx-light" asp-controller="Produccion" asp-action="Index"><i class="bi bi-arrow-left"></i>Producción</a><a class="btnx btnx-light" asp-controller="Produccion" asp-action="Preparacion" asp-route-filtro="@Model.Filtro" asp-route-maquinaId="@Model.MaquinaID"><i class="bi bi-arrow-clockwise"></i>Actualizar</a></div></section>
        @if (TempData["Success"] != null)
        {
            <div class="alert alert-success alertx"><i class="bi bi-check-circle me-1"></i>@TempData["Success"]</div>
        }
        @if (TempData["Error"] != null)
        {
            <div class="alert alert-danger alertx"><i class="bi bi-exclamation-triangle me-1"></i>@TempData["Error"]</div>
        }
        <form method="get" asp-controller="Produccion" asp-action="Preparacion" class="filters">
            <div class="field"><label>Buscar</label><input type="text" name="filtro" value="@filtroActual" placeholder="OF, parte, material, molde, máquina..." /></div><div class="field">
                <label>Máquina</label><select name="maquinaId">
                    <option value="">Todas las máquinas</option>@foreach(var m in Model.Maquinas){if(Model.MaquinaID==m.MaquinaID){
                    <option value="@m.MaquinaID" selected>@m.Texto</option>
                                        }else
                    {

                        <option value="@m.MaquinaID">@m.Texto</option>
                    }}
                </select>
            </div><button class="btnx btnx-primary" type="submit"><i class="bi bi-search"></i>Filtrar</button>
        </form>
        <div class="type-nav">
            <button type="button" class="type-btn active" data-type="secado"><div class="type-row"><div class="type-icon secado"><i class="bi bi-thermometer-sun"></i></div><div><h3>Secado de material</h3><p>Qué material entra al secador y a qué hora.</p></div></div><div class="type-badges"><span class="mini red">@secados.Count(x => x.EsVencida) vencidas</span><span class="mini orange">@secados.Count(x => x.EsHacerAhora) ahora</span><span class="mini blue">@secados.Count(x => x.EsProxima) próximas</span></div></button>
            <button type="button" class="type-btn" data-type="embalaje"><div class="type-row"><div class="type-icon embalaje"><i class="bi bi-box-seam"></i></div><div><h3>Preparar embalaje</h3><p>Cajas y cantidades requeridas por orden.</p></div></div><div class="type-badges"><span class="mini red">@embalajes.Count(x => x.EsVencida) vencidas</span><span class="mini orange">@embalajes.Count(x => x.EsHacerAhora) ahora</span><span class="mini blue">@embalajes.Count(x => x.EsProxima) próximas</span></div></button>
            <button type="button" class="type-btn" data-type="molde"><div class="type-row"><div class="type-icon molde"><i class="bi bi-gear-wide-connected"></i></div><div><h3>Cambios de molde</h3><p>Preparación y aviso 30 minutos antes.</p></div></div><div class="type-badges"><span class="mini red">@moldes.Count(x => x.EsVencida) vencidas</span><span class="mini orange">@moldes.Count(x => x.EsHacerAhora) ahora</span><span class="mini blue">@moldes.Count(x => x.EsProxima) próximas</span></div></button>
            <button type="button" class="type-btn" data-type="completadas"><div class="type-row"><div class="type-icon ok"><i class="bi bi-check2-circle"></i></div><div><h3>Completadas</h3><p>Historial reciente de preparaciones confirmadas.</p></div></div><div class="type-badges"><span class="mini green">@completadas.Count completadas</span></div></button>
        </div>
        <div class="urgency-nav" id="urgencyNav"><button type="button" class="urgency-btn active" data-urgency="todas">Todas</button><button type="button" class="urgency-btn" data-urgency="vencida">Vencidas</button><button type="button" class="urgency-btn" data-urgency="ahora">Hacer ahora</button><button type="button" class="urgency-btn" data-urgency="proxima">Próximas</button></div>

        <section class="panel active" data-panel="secado">
            <div class="section-head"><div><h2><i class="bi bi-thermometer-sun me-1"></i>Secado de material</h2><p>Prioriza qué material debe entrar al secador y cuándo estará disponible.</p></div><span class="section-count">@secados.Count</span></div>
            @foreach (var grupo in secados.GroupBy(x => new { x.MaquinaID, x.MaquinaCodigo, x.MaquinaNombre }).OrderBy(x => x.Key.MaquinaCodigo))
            {
                var maquinaTexto = string.IsNullOrWhiteSpace(grupo.Key.MaquinaNombre) ? (grupo.Key.MaquinaCodigo ?? "Sin máquina") : $"{grupo.Key.MaquinaCodigo} · {grupo.Key.MaquinaNombre}";
                <details class="machine-group">
                    <summary><div class="machine-group-title"><span class="machine-group-icon secado"><i class="bi bi-building-gear"></i></span><div><strong>@maquinaTexto</strong><small>Secado de material</small></div></div><span class="machine-group-count">@grupo.Count() tarea@(grupo.Count() == 1 ? "" : "s")</span></summary>
                    <div class="machine-group-body task-list">
                        @foreach (var t in grupo.OrderBy(x => x.FechaAviso))
                        {
                            var urgencia = t.EsVencida ? "vencida" : t.EsHacerAhora ? "ahora" : "proxima";
                            <article class="task tipo-secado @ClaseEstado(t)" data-urgency="@urgencia">
                                <div class="task-main">
                                    <div class="task-title">
                                        <div class="task-icon"><i class="bi bi-thermometer-sun"></i></div><div>
                                            <div class="task-kicker">
                                                <span class="task-type">Secado de material</span>@if(!string.IsNullOrWhiteSpace(t.NumeroOF)){
                                                <span class="chip">OF @t.NumeroOF</span>
                                            }
                                        </div><h3>@t.TextoMaterial</h3><div class="task-sub">@t.TextoParte · @Operador(t)</div>
                                    </div>
                                </div><div class="task-info"><div><span>Iniciar secado</span><b>@Fecha(t.FechaAviso)</b></div><div><span>Debe estar listo</span><b>@Fecha(t.FechaObjetivo)</b></div><div><span>Secado requerido</span><b>@Horas(t.HorasSecado) · @(string.IsNullOrWhiteSpace(t.TipoSecado) ? "Secador" : t.TipoSecado)</b></div><div><span>Arranque</span><b>@Fecha(t.FechaArranque)</b></div></div><div class="task-action">
                                    <span class="status-text @(t.EsVencida ? "red" : t.EsHacerAhora ? "orange" : "blue")">@t.TextoTiempo</span><small class="task-date">@TextoEstado(t) · iniciar @Hora(t.FechaAviso)</small>@if(!t.EsProxima){
                                    <form asp-controller="Produccion" asp-action="ConfirmarPreparacion" method="post" class="confirm-form">@Html.AntiForgeryToken()<input type="hidden" name="PreparacionAnticipadaID" value="@t.PreparacionAnticipadaID" /><input type="text" name="Observaciones" maxlength="500" placeholder="Observación opcional" /><button class="btnx btnx-primary" type="submit"><i class="bi bi-check2"></i>Ya está en secador</button></form>
                                }
                            </div>
                        </div><div class="task-details"><div class="detail"><span>Material</span><strong>@t.TextoMaterial</strong></div><div class="detail"><span>Tiempo de secado</span><strong>@Horas(t.HorasSecado)</strong></div><div class="detail"><span>Cantidad programada</span><strong>@t.CantidadProgramada.ToString("N0") PZA</strong></div><div class="detail"><span>OF</span><strong>@(string.IsNullOrWhiteSpace(t.NumeroOF) ? "—" : t.NumeroOF)</strong></div></div>
                    </article>
                                        }
                </div>
            </details>
                        }
            @if (!secados.Any())
            {
                <div class="empty"><i class="bi bi-check-circle"></i><strong>No hay secados pendientes.</strong>No se encontraron materiales pendientes de secado.</div>
            }
        </section>

        <section class="panel" data-panel="embalaje">
            <div class="section-head"><div><h2><i class="bi bi-box-seam me-1"></i>Preparación de embalaje</h2><p>Identifica rápidamente qué caja preparar y cuántas se necesitan por orden.</p></div><span class="section-count">@embalajes.Count</span></div>
            @foreach (var grupo in embalajes.GroupBy(x => new { x.MaquinaID, x.MaquinaCodigo, x.MaquinaNombre }).OrderBy(x => x.Key.MaquinaCodigo))
            {
                var maquinaTexto = string.IsNullOrWhiteSpace(grupo.Key.MaquinaNombre) ? (grupo.Key.MaquinaCodigo ?? "Sin máquina") : $"{grupo.Key.MaquinaCodigo} · {grupo.Key.MaquinaNombre}";
                <details class="machine-group">
                    <summary><div class="machine-group-title"><span class="machine-group-icon embalaje"><i class="bi bi-building-gear"></i></span><div><strong>@maquinaTexto</strong><small>Preparación de embalaje</small></div></div><span class="machine-group-count">@grupo.Count() tarea@(grupo.Count() == 1 ? "" : "s")</span></summary>
                    <div class="machine-group-body task-list">
                        @foreach (var t in grupo.OrderBy(x => x.FechaAviso))
                        {
                            var urgencia = t.EsVencida ? "vencida" : t.EsHacerAhora ? "ahora" : "proxima";
                            <article class="task tipo-embalaje @ClaseEstado(t)" data-urgency="@urgencia">
                                <div class="task-main">
                                    <div class="task-title">
                                        <div class="task-icon"><i class="bi bi-box-seam"></i></div><div>
                                            <div class="task-kicker">
                                                <span class="task-type">Preparar embalaje</span>@if(!string.IsNullOrWhiteSpace(t.NumeroOF)){
                                                <span class="chip">OF @t.NumeroOF</span>
                                            }
                                        </div><h3>@t.TextoEmbalaje</h3><div class="task-sub">@t.TextoParte · @Operador(t)</div>
                                    </div>
                                </div><div class="task-info"><div><span>Preparar desde</span><b>@Fecha(t.FechaAviso)</b></div><div><span>Arranque</span><b>@Fecha(t.FechaArranque)</b></div><div><span>Piezas / embalaje</span><b>@(t.PiezasPorEmbalaje?.ToString("N0") ?? "—")</b></div><div><span>Embalajes requeridos</span><b class="big-number">@(t.CantidadEmbalajes?.ToString("N0") ?? "—")</b></div></div><div class="task-action">
                                    <span class="status-text @(t.EsVencida ? "red" : t.EsHacerAhora ? "orange" : "blue")">@t.TextoTiempo</span><small class="task-date">@TextoEstado(t) · preparar @Hora(t.FechaAviso)</small>@if(!t.EsProxima){
                                    <form asp-controller="Produccion" asp-action="ConfirmarPreparacion" method="post" class="confirm-form">@Html.AntiForgeryToken()<input type="hidden" name="PreparacionAnticipadaID" value="@t.PreparacionAnticipadaID" /><input type="text" name="Observaciones" maxlength="500" placeholder="Observación opcional" /><button class="btnx btnx-primary" type="submit"><i class="bi bi-check2"></i>Embalaje preparado</button></form>
                                }
                            </div>
                        </div><div class="task-details"><div class="detail"><span>Embalaje</span><strong>@t.TextoEmbalaje</strong></div><div class="detail"><span>Requeridos</span><strong class="big-number">@(t.CantidadEmbalajes?.ToString("N0") ?? "—")</strong></div><div class="detail"><span>Producción programada</span><strong>@t.CantidadProgramada.ToString("N0") PZA</strong></div><div class="detail"><span>OF</span><strong>@(string.IsNullOrWhiteSpace(t.NumeroOF) ? "—" : t.NumeroOF)</strong></div></div>
                    </article>
                                        }
                </div>
            </details>
                        }
            @if (!embalajes.Any())
            {
                <div class="empty"><i class="bi bi-check-circle"></i><strong>No hay embalajes pendientes.</strong>No se encontraron preparaciones de embalaje pendientes.</div>
            }
        </section>

        <section class="panel" data-panel="molde">
            <div class="section-head"><div><h2><i class="bi bi-gear-wide-connected me-1"></i>Cambios de molde</h2><p>Visualiza molde actual, molde próximo y la ventana de aviso operativo.</p></div><span class="section-count">@moldes.Count</span></div>
            @foreach (var grupo in moldes.GroupBy(x => new { x.MaquinaID, x.MaquinaCodigo, x.MaquinaNombre }).OrderBy(x => x.Key.MaquinaCodigo))
            {
                var maquinaTexto = string.IsNullOrWhiteSpace(grupo.Key.MaquinaNombre) ? (grupo.Key.MaquinaCodigo ?? "Sin máquina") : $"{grupo.Key.MaquinaCodigo} · {grupo.Key.MaquinaNombre}";
                <details class="machine-group">
                    <summary><div class="machine-group-title"><span class="machine-group-icon molde"><i class="bi bi-building-gear"></i></span><div><strong>@maquinaTexto</strong><small>Cambios de molde</small></div></div><span class="machine-group-count">@grupo.Count() tarea@(grupo.Count() == 1 ? "" : "s")</span></summary>
                    <div class="machine-group-body task-list">
                        @foreach (var t in grupo.OrderBy(x => x.FechaAviso))
                        {
                            var urgencia = t.EsVencida ? "vencida" : t.EsHacerAhora ? "ahora" : "proxima";
                            <article class="task tipo-molde @ClaseEstado(t)" data-urgency="@urgencia">
                                <div class="task-main">
                                    <div class="task-title">
                                        <div class="task-icon"><i class="bi bi-gear-wide-connected"></i></div><div>
                                            <div class="task-kicker">
                                                <span class="task-type">Cambio de molde</span>@if(!string.IsNullOrWhiteSpace(t.NumeroOF)){
                                                <span class="chip">OF @t.NumeroOF</span>
                                            }
                                        </div><h3>@t.TextoCambioMolde</h3><div class="task-sub">@t.TextoParte · @Operador(t)</div>
                                    </div>
                                </div><div class="task-info"><div><span>Avisar desde</span><b>@Fecha(t.FechaAviso)</b></div><div><span>Cambio programado</span><b>@Fecha(t.FechaCambioMolde)</b></div><div><span>Molde anterior</span><b>@(string.IsNullOrWhiteSpace(t.MoldeAnteriorCodigo) ? "—" : t.MoldeAnteriorCodigo)</b></div><div><span>Molde nuevo</span><b>@t.TextoMolde</b></div></div><div class="task-action">
                                    <span class="status-text @(t.EsVencida ? "red" : t.EsHacerAhora ? "orange" : "blue")">@t.TextoTiempo</span><small class="task-date">@TextoEstado(t) · aviso @Hora(t.FechaAviso)</small>@if(!t.EsProxima){
                                    <form asp-controller="Produccion" asp-action="ConfirmarPreparacion" method="post" class="confirm-form">@Html.AntiForgeryToken()<input type="hidden" name="PreparacionAnticipadaID" value="@t.PreparacionAnticipadaID" /><input type="text" name="Observaciones" maxlength="500" placeholder="Observación opcional" /><button class="btnx btnx-primary" type="submit"><i class="bi bi-check2"></i>Confirmar cambio</button></form>
                                }
                            </div>
                        </div><div class="task-details"><div class="detail"><span>Molde anterior</span><strong>@(string.IsNullOrWhiteSpace(t.MoldeAnteriorCodigo) ? "—" : t.MoldeAnteriorCodigo)</strong></div><div class="detail"><span>Molde nuevo</span><strong>@t.TextoMolde</strong></div><div class="detail"><span>Aviso operativo</span><strong>30 minutos antes</strong></div><div class="detail"><span>OF</span><strong>@(string.IsNullOrWhiteSpace(t.NumeroOF) ? "—" : t.NumeroOF)</strong></div></div>
                    </article>
                                        }
                </div>
            </details>
                        }
            @if (!moldes.Any())
            {
                <div class="empty"><i class="bi bi-check-circle"></i><strong>No hay cambios de molde pendientes.</strong>No se encontraron cambios próximos con los filtros actuales.</div>
            }
        </section>

        <section class="panel" data-panel="completadas">
            <div class="section-head"><div><h2><i class="bi bi-check2-circle me-1"></i>Preparaciones completadas</h2><p>Historial reciente de tareas confirmadas.</p></div><span class="section-count">@completadas.Count</span></div>
            @foreach (var grupo in completadas.GroupBy(x => new { x.MaquinaID, x.MaquinaCodigo, x.MaquinaNombre }).OrderBy(x => x.Key.MaquinaCodigo))
            {
                var maquinaTexto = string.IsNullOrWhiteSpace(grupo.Key.MaquinaNombre) ? (grupo.Key.MaquinaCodigo ?? "Sin máquina") : $"{grupo.Key.MaquinaCodigo} · {grupo.Key.MaquinaNombre}";
                <details class="machine-group">
                    <summary><div class="machine-group-title"><span class="machine-group-icon completa"><i class="bi bi-building-gear"></i></span><div><strong>@maquinaTexto</strong><small>Preparaciones completadas</small></div></div><span class="machine-group-count">@grupo.Count() tarea@(grupo.Count() == 1 ? "" : "s")</span></summary>
                    <div class="machine-group-body task-list">
                        @foreach (var t in grupo)
                        {
                            <article class="task tipo-completa completa">
                                <div class="task-main">
                                    <div class="task-title">
                                        <div class="task-icon"><i class="bi bi-check2-circle"></i></div><div>
                                            <div class="task-kicker">
                                                <span class="task-type">@t.TipoTareaNombre</span>@if(!string.IsNullOrWhiteSpace(t.NumeroOF)){
                                                <span class="chip">OF @t.NumeroOF</span>
                                            }
                                        </div><h3>@TituloTarea(t)</h3><div class="task-sub">@t.TextoParte · @Operador(t)</div>
                                    </div>
                                </div><div class="task-info"><div><span>Objetivo</span><b>@Fecha(t.FechaObjetivo)</b></div><div><span>Confirmado</span><b>@Fecha(t.FechaConfirmacion)</b></div><div><span>Confirmó</span><b>@(string.IsNullOrWhiteSpace(t.UsuarioConfirmacionNombre) ? $"Usuario {t.UsuarioConfirmacionID}" : t.UsuarioConfirmacionNombre)</b></div><div><span>Observación</span><b>@(string.IsNullOrWhiteSpace(t.Observaciones) ? "Sin observación" : t.Observaciones)</b></div></div><div class="task-action"><span class="status-text green"><i class="bi bi-check-circle me-1"></i>Completada</span><small class="task-date">@t.TextoTiempo</small></div>
                            </div>@if(t.EsSecadoMaterial&&t.FechaDisponibleEstimada.HasValue){
                            <div class="task-details">
                                <div class="detail"><span>Secado iniciado</span><strong>@Fecha(t.FechaConfirmacion)</strong></div><div class="detail"><span>Tiempo requerido</span><strong>@Horas(t.HorasSecado)</strong></div><div class="detail"><span>Disponible estimado</span><strong>@Fecha(t.FechaDisponibleEstimada)</strong></div><div class="detail">
                                    <span>Arranque</span><strong>@Fecha(t.FechaArranque)</strong>@if(t.SecadoLlegaraTarde){
                                    <div class="warn">Llegaría @t.MinutosRetrasoSecado min tarde al arranque.</div>
                                }
                            </div>
                        </div>
                                                }
                    </article>
                                        }
                </div>
            </details>
                        }
            @if (!completadas.Any())
            {
                <div class="empty"><i class="bi bi-check2-all"></i><strong>Todavía no hay preparaciones completadas.</strong>Las confirmaciones aparecerán aquí.</div>
            }
        </section>
    </div>
    <script>
        (() => {
            const typeButtons=[...document.querySelectorAll('[data-type]')];
            const panels=[...document.querySelectorAll('[data-panel]')];
            const urgencyButtons=[...document.querySelectorAll('[data-urgency]')];
            const urgencyNav=document.getElementById('urgencyNav');
            let activeType='secado';
            let activeUrgency='todas';

            function applyFilters(){
                typeButtons.forEach(b=>b.classList.toggle('active',b.dataset.type===activeType));
                panels.forEach(p=>p.classList.toggle('active',p.dataset.panel===activeType));
                if(urgencyNav)urgencyNav.style.display=activeType==='completadas'?'none':'flex';
                urgencyButtons.forEach(b=>b.classList.toggle('active',b.dataset.urgency===activeUrgency));
                const activePanel=document.querySelector(`[data-panel="${activeType}"]`);
                if(!activePanel)return;
                activePanel.querySelectorAll('.task[data-urgency]').forEach(task=>{
                    task.classList.toggle('hidden-by-filter',activeUrgency!=='todas'&&task.dataset.urgency!==activeUrgency);
                });
                activePanel.querySelectorAll('.machine-group').forEach(group=>{
                    const visibles=[...group.querySelectorAll('.task')].filter(x=>!x.classList.contains('hidden-by-filter')).length;
                    group.classList.toggle('hidden-by-filter',visibles===0);
                });
            }

            typeButtons.forEach(b=>b.addEventListener('click',()=>{
                activeType=b.dataset.type;
                activeUrgency='todas';
                try{localStorage.setItem('produccion-preparacion-tipo',activeType);}catch{}
                applyFilters();
            }));

            urgencyButtons.forEach(b=>b.addEventListener('click',()=>{
                activeUrgency=b.dataset.urgency;
                applyFilters();
            }));

            try{
                const saved=localStorage.getItem('produccion-preparacion-tipo');
                if(saved&&panels.some(p=>p.dataset.panel===saved))activeType=saved;
            }catch{}

            applyFilters();

            document.querySelectorAll('.confirm-form').forEach(form=>{
                form.addEventListener('submit',()=>{
                    const btn=form.querySelector('button[type="submit"]');
                    if(btn){
                        btn.disabled=true;
                        btn.innerHTML='<span class="spinner-border spinner-border-sm"></span> Guardando...';
                    }
                });
            });
        })();
    </script>
</body>
</html>