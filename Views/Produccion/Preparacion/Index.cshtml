@* PRODUCCION_PREPARACION_INDEX_V1 *@
@using ERP.NSQuell.Models
@model ProduccionPreparacionIndexVm
@{
    Layout = null;
    ViewData["Title"] = "Preparación de producción";
    var vencidas = Model.Vencidas.OrderBy(x => x.FechaObjetivo).ToList();
    var hacerAhora = Model.HacerAhora.OrderBy(x => x.FechaObjetivo).ToList();
    var proximas = Model.Proximas.OrderBy(x => x.FechaAviso).ToList();
    var completadas = Model.Completadas.OrderByDescending(x => x.FechaConfirmacion).Take(30).ToList();
    var filtroActual = string.IsNullOrWhiteSpace(Model.Filtro) ? "" : Model.Filtro;
    string Fecha(DateTime? d) => d?.ToString("dd/MM/yyyy HH:mm") ?? "—";
    string Horas(decimal? h) => h.HasValue ? $"{h.Value:0.##} h" : "—";
}
<!DOCTYPE html>
<html lang="es">
<head>
<meta charset="utf-8" />
<meta name="viewport" content="width=device-width, initial-scale=1" />
<title>@ViewData["Title"]</title>
<link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet" />
<link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.css" rel="stylesheet" />
<style>
:root{--navy:#071b31;--blue:#1746d1;--blue2:#4f5cff;--line:#dce4ef;--bg:#f4f7fb;--text:#10224a;--muted:#6d7890;--red:#bd2d24;--redbg:#fff4f3;--orange:#d97706;--orangebg:#fff8eb;--green:#278250;--greenbg:#effaf3;--shadow:0 16px 38px rgba(15,34,74,.08)}
*{box-sizing:border-box}body{margin:0;background:var(--bg);color:var(--text);font-family:Inter,system-ui,-apple-system,BlinkMacSystemFont,"Segoe UI",sans-serif}.prep-shell{min-height:100vh;padding:18px}.prep-top{display:flex;align-items:center;justify-content:space-between;gap:16px;padding:18px 20px;border-radius:20px;background:linear-gradient(120deg,#17205f,#3447b9 70%,#5362e8);color:#fff;box-shadow:0 18px 45px rgba(25,42,120,.18)}.prep-top-main{display:flex;align-items:center;gap:14px}.prep-top-icon{width:50px;height:50px;border-radius:14px;background:rgba(255,255,255,.14);display:grid;place-items:center;font-size:1.35rem}.prep-top h1{margin:0;font-size:1.45rem;font-weight:950}.prep-top p{margin:3px 0 0;color:rgba(255,255,255,.76);font-size:.79rem;font-weight:650}.prep-top-actions{display:flex;gap:8px;flex-wrap:wrap}.prep-btn{min-height:40px;border-radius:11px;border:1px solid #ccd7e5;background:#fff;color:#203150;padding:8px 13px;text-decoration:none;font-weight:900;display:inline-flex;align-items:center;justify-content:center;gap:7px;cursor:pointer}.prep-btn:hover{color:#1746d1}.prep-btn-white{background:rgba(255,255,255,.11);border-color:rgba(255,255,255,.28);color:#fff}.prep-btn-white:hover{background:#fff;color:#27399c}.prep-btn-primary{background:var(--blue2);border-color:var(--blue2);color:#fff}.prep-btn-primary:hover{background:#3d49df;color:#fff}.prep-filters{margin-top:14px;background:#fff;border:1px solid var(--line);border-radius:16px;padding:12px 14px;display:grid;grid-template-columns:minmax(220px,1fr) 260px auto;gap:10px;align-items:end;box-shadow:0 8px 22px rgba(15,34,74,.035)}.prep-field label{display:block;margin-bottom:5px;font-size:.65rem;font-weight:950;text-transform:uppercase;letter-spacing:.04em;color:#657087}.prep-field input,.prep-field select{width:100%;min-height:41px;border:1px solid #cfd9e6;border-radius:10px;background:#fff;padding:8px 10px;font-weight:750;color:#17233d}.prep-field input:focus,.prep-field select:focus{outline:none;border-color:#7180ff;box-shadow:0 0 0 3px rgba(79,92,255,.11)}.prep-tabs{display:flex;gap:7px;overflow:auto;margin:14px 0 12px;padding-bottom:2px}.prep-tab{white-space:nowrap;border:1px solid #d2dcea;background:#fff;color:#526078;border-radius:999px;padding:8px 12px;font-size:.75rem;font-weight:900;cursor:pointer}.prep-tab.active{background:#17205f;color:#fff;border-color:#17205f}.prep-tab b{margin-left:5px}.prep-alert{border-radius:14px;padding:11px 13px;margin-top:12px;font-size:.78rem;font-weight:800}.prep-section{display:none}.prep-section.active{display:block}.prep-section-head{display:flex;align-items:center;justify-content:space-between;gap:12px;margin:10px 2px}.prep-section-head h2{font-size:1rem;margin:0;font-weight:950}.prep-section-head p{margin:2px 0 0;color:var(--muted);font-size:.72rem;font-weight:650}.prep-count{min-width:32px;height:28px;border-radius:999px;display:grid;place-items:center;padding:0 9px;background:#e9eef6;font-size:.72rem;font-weight:950}.prep-list{display:flex;flex-direction:column;gap:10px}.task{background:#fff;border:1px solid var(--line);border-radius:16px;box-shadow:var(--shadow);overflow:hidden}.task.vencida{border-left:5px solid var(--red)}.task.ahora{border-left:5px solid var(--orange)}.task.proxima{border-left:5px solid var(--blue2)}.task.completa{border-left:5px solid var(--green);opacity:.93}.task-main{padding:14px 15px;display:grid;grid-template-columns:minmax(0,1.3fr) minmax(290px,.9fr) auto;gap:16px;align-items:center}.task-title{display:flex;gap:11px;align-items:flex-start}.task-icon{width:42px;height:42px;border-radius:12px;display:grid;place-items:center;flex:none;font-size:1.1rem}.task.vencida .task-icon{background:var(--redbg);color:var(--red)}.task.ahora .task-icon{background:var(--orangebg);color:var(--orange)}.task.proxima .task-icon{background:#f0f2ff;color:var(--blue2)}.task.completa .task-icon{background:var(--greenbg);color:var(--green)}.task-kicker{display:flex;gap:6px;flex-wrap:wrap;align-items:center;margin-bottom:3px}.task-type{font-size:.65rem;font-weight:950;text-transform:uppercase;letter-spacing:.06em}.task-chip{display:inline-flex;align-items:center;gap:4px;padding:4px 7px;border-radius:999px;background:#f0f3f8;color:#56637a;font-size:.61rem;font-weight:900}.task h3{margin:0;font-size:.96rem;font-weight:950;color:#0d214d}.task-sub{margin-top:3px;color:#677289;font-size:.72rem;font-weight:700;line-height:1.35}.task-info{display:grid;grid-template-columns:1fr 1fr;gap:7px 13px}.task-info span{display:block;color:#8791a3;font-size:.59rem;font-weight:950;text-transform:uppercase;letter-spacing:.04em}.task-info b{display:block;color:#1c2d52;font-size:.72rem;font-weight:900;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}.task-action{text-align:right;min-width:190px}.task-time{font-size:.74rem;font-weight:950}.task-time.red{color:var(--red)}.task-time.orange{color:var(--orange)}.task-time.blue{color:var(--blue)}.task-time.green{color:var(--green)}.task-date{display:block;margin:3px 0 8px;color:#7c8799;font-size:.66rem;font-weight:700}.task-details{padding:12px 15px;background:#fafcff;border-top:1px solid #e7edf5;display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:10px}.detail-box{border-right:1px solid #e2e8f0;padding-right:10px}.detail-box:last-child{border-right:0}.detail-box span{display:block;color:#8893a5;font-size:.59rem;font-weight:950;text-transform:uppercase}.detail-box strong{display:block;margin-top:2px;color:#263855;font-size:.71rem;font-weight:850;line-height:1.35}.task-warning{margin-top:7px;padding:7px 9px;border-radius:8px;background:#fff1f0;border:1px solid #f5b7b2;color:#a61b14;font-size:.67rem;font-weight:900}.prep-empty{background:#fff;border:1px dashed #c9d5e4;border-radius:15px;padding:28px 18px;text-align:center;color:#718096}.prep-empty i{font-size:1.5rem;display:block;margin-bottom:7px}.prep-empty strong{display:block;color:#33445f}.confirm-form{display:flex;gap:7px;justify-content:flex-end;align-items:center}.confirm-form input[type=text]{width:170px;min-height:36px;border:1px solid #ccd7e5;border-radius:9px;padding:7px 9px;font-size:.7rem}.completed-meta{color:#367652;font-size:.7rem;font-weight:850}@@media(max-width:1100px){.task-main{grid-template-columns:1fr}.task-action{text-align:left;min-width:0}.confirm-form{justify-content:flex-start}.task-details{grid-template-columns:1fr 1fr}}@@media(max-width:760px){.prep-shell{padding:10px}.prep-top{padding:16px}.prep-top-main{align-items:flex-start}.prep-filters{grid-template-columns:1fr}.task-info{grid-template-columns:1fr 1fr}.task-details{grid-template-columns:1fr}.detail-box{border-right:0;border-bottom:1px solid #e2e8f0;padding:0 0 8px}.detail-box:last-child{border-bottom:0}.confirm-form{flex-direction:column;align-items:stretch}.confirm-form input[type=text]{width:100%}}
</style>
</head>
<body>
<div class="prep-shell">
<section class="prep-top"><div class="prep-top-main"><div class="prep-top-icon"><i class="bi bi-tools"></i></div><div><h1>Preparación de producción</h1><p>Secado de material, preparación de embalaje y cambios de molde antes del arranque.</p></div></div><div class="prep-top-actions"><a class="prep-btn prep-btn-white" asp-controller="Produccion" asp-action="Index"><i class="bi bi-arrow-left"></i>Producción</a><a class="prep-btn prep-btn-white" asp-controller="Produccion" asp-action="Preparacion" asp-route-filtro="@Model.Filtro" asp-route-maquinaId="@Model.MaquinaID"><i class="bi bi-arrow-clockwise"></i>Actualizar</a></div></section>
@if(TempData["Success"]!=null){<div class="alert alert-success prep-alert"><i class="bi bi-check-circle me-1"></i>@TempData["Success"]</div>}
@if(TempData["Error"]!=null){<div class="alert alert-danger prep-alert"><i class="bi bi-exclamation-triangle me-1"></i>@TempData["Error"]</div>}
<form method="get" asp-controller="Produccion" asp-action="Preparacion" class="prep-filters"><div class="prep-field"><label>Buscar</label><input type="text" name="filtro" value="@filtroActual" placeholder="OF, parte, material, molde, máquina..." /></div><div class="prep-field"><label>Máquina</label><select name="maquinaId"><option value="">Todas las máquinas</option>@foreach(var m in Model.Maquinas){<option value="@m.MaquinaID" selected="@(Model.MaquinaID==m.MaquinaID)">@m.Texto</option>}</select></div><button class="prep-btn prep-btn-primary" type="submit"><i class="bi bi-search"></i>Filtrar</button></form>
<div class="prep-tabs"><button type="button" class="prep-tab active" data-tab="vencidas"><i class="bi bi-exclamation-octagon"></i> Vencidas <b>@vencidas.Count</b></button><button type="button" class="prep-tab" data-tab="ahora"><i class="bi bi-lightning-charge"></i> Hacer ahora <b>@hacerAhora.Count</b></button><button type="button" class="prep-tab" data-tab="proximas"><i class="bi bi-clock"></i> Próximas <b>@proximas.Count</b></button><button type="button" class="prep-tab" data-tab="completadas"><i class="bi bi-check2-circle"></i> Completadas <b>@completadas.Count</b></button></div>
@functions{
    string Icono(ProduccionPreparacionTareaVm t)=>t.EsSecadoMaterial?"bi-thermometer-sun":t.EsCambioMolde?"bi-gear-wide-connected":"bi-box-seam";
    string Titulo(ProduccionPreparacionTareaVm t)=>t.EsSecadoMaterial?t.TextoMaterial:t.EsCambioMolde?t.TextoCambioMolde:t.TextoEmbalaje;
    string TextoBoton(ProduccionPreparacionTareaVm t)=>t.EsSecadoMaterial?"Ya está en secador":t.EsCambioMolde?"Confirmar cambio":"Embalaje preparado";
}
<section class="prep-section active" data-section="vencidas"><div class="prep-section-head"><div><h2>Preparaciones vencidas</h2><p>Estas actividades ya pasaron su hora objetivo y requieren atención inmediata.</p></div><span class="prep-count">@vencidas.Count</span></div><div class="prep-list">
@foreach(var t in vencidas){<article class="task vencida"><div class="task-main"><div class="task-title"><div class="task-icon"><i class="bi @Icono(t)"></i></div><div><div class="task-kicker"><span class="task-type">@t.TipoTareaNombre</span><span class="task-chip"><i class="bi bi-building-gear"></i>@t.TextoMaquina</span>@if(!string.IsNullOrWhiteSpace(t.NumeroOF)){<span class="task-chip">OF @t.NumeroOF</span>}</div><h3>@Titulo(t)</h3><div class="task-sub">@t.TextoParte@if(!string.IsNullOrWhiteSpace(t.DescripcionParte)){<text> · @t.DescripcionParte</text>}</div></div></div><div class="task-info"><div><span>Aviso</span><b>@Fecha(t.FechaAviso)</b></div><div><span>Objetivo</span><b>@Fecha(t.FechaObjetivo)</b></div><div><span>Operadores</span><b>@t.TextoOperadores</b></div><div><span>Cantidad</span><b>@t.CantidadProgramada.ToString("N0") PZA</b></div></div><div class="task-action"><span class="task-time red">@t.TextoTiempo</span><small class="task-date">Objetivo @t.FechaObjetivo.ToString("dd/MM HH:mm")</small><form asp-controller="Produccion" asp-action="ConfirmarPreparacion" method="post" class="confirm-form">@Html.AntiForgeryToken()<input type="hidden" name="PreparacionAnticipadaID" value="@t.PreparacionAnticipadaID" /><input type="text" name="Observaciones" maxlength="500" placeholder="Observación opcional" /><button class="prep-btn prep-btn-primary" type="submit"><i class="bi bi-check2"></i>@TextoBoton(t)</button></form></div></div><div class="task-details">@if(t.EsSecadoMaterial){<div class="detail-box"><span>Tipo de secado</span><strong>@(string.IsNullOrWhiteSpace(t.TipoSecado)?"Secado requerido":t.TipoSecado)</strong></div><div class="detail-box"><span>Tiempo requerido</span><strong>@Horas(t.HorasSecado)</strong></div><div class="detail-box"><span>Material</span><strong>@t.TextoMaterial</strong></div><div class="detail-box"><span>Arranque</span><strong>@Fecha(t.FechaArranque)</strong></div>}else if(t.EsCambioMolde){<div class="detail-box"><span>Molde anterior</span><strong>@(string.IsNullOrWhiteSpace(t.MoldeAnteriorCodigo)?"—":t.MoldeAnteriorCodigo)</strong></div><div class="detail-box"><span>Molde nuevo</span><strong>@t.TextoMolde</strong></div><div class="detail-box"><span>Aviso operativo</span><strong>30 min antes</strong></div><div class="detail-box"><span>Cambio programado</span><strong>@Fecha(t.FechaCambioMolde)</strong></div>}else{<div class="detail-box"><span>Embalaje</span><strong>@t.TextoEmbalaje</strong></div><div class="detail-box"><span>Piezas / embalaje</span><strong>@(t.PiezasPorEmbalaje?.ToString("N0")??"—")</strong></div><div class="detail-box"><span>Embalajes requeridos</span><strong>@(t.CantidadEmbalajes?.ToString("N0")??"—")</strong></div><div class="detail-box"><span>Arranque</span><strong>@Fecha(t.FechaArranque)</strong></div>}</div></article>}
@if(!vencidas.Any()){<div class="prep-empty"><i class="bi bi-check-circle"></i><strong>No hay preparaciones vencidas.</strong>La cola no tiene actividades fuera de tiempo.</div>}</div></section>
<section class="prep-section" data-section="ahora"><div class="prep-section-head"><div><h2>Hacer ahora</h2><p>La ventana de preparación ya comenzó y todavía estamos antes de la hora objetivo.</p></div><span class="prep-count">@hacerAhora.Count</span></div><div class="prep-list">
@foreach(var t in hacerAhora){<article class="task ahora"><div class="task-main"><div class="task-title"><div class="task-icon"><i class="bi @Icono(t)"></i></div><div><div class="task-kicker"><span class="task-type">@t.TipoTareaNombre</span><span class="task-chip">@t.TextoMaquina</span>@if(!string.IsNullOrWhiteSpace(t.NumeroOF)){<span class="task-chip">OF @t.NumeroOF</span>}</div><h3>@Titulo(t)</h3><div class="task-sub">@t.TextoParte · @t.TextoOperadores</div></div></div><div class="task-info"><div><span>Aviso</span><b>@Fecha(t.FechaAviso)</b></div><div><span>Objetivo</span><b>@Fecha(t.FechaObjetivo)</b></div><div><span>Parte</span><b>@t.TextoParte</b></div><div><span>Cantidad</span><b>@t.CantidadProgramada.ToString("N0") PZA</b></div></div><div class="task-action"><span class="task-time orange">@t.TextoTiempo</span><small class="task-date">Objetivo @t.FechaObjetivo.ToString("dd/MM HH:mm")</small><form asp-controller="Produccion" asp-action="ConfirmarPreparacion" method="post" class="confirm-form">@Html.AntiForgeryToken()<input type="hidden" name="PreparacionAnticipadaID" value="@t.PreparacionAnticipadaID" /><input type="text" name="Observaciones" maxlength="500" placeholder="Observación opcional" /><button class="prep-btn prep-btn-primary" type="submit"><i class="bi bi-check2"></i>@TextoBoton(t)</button></form></div></div><div class="task-details">@if(t.EsSecadoMaterial){<div class="detail-box"><span>Material</span><strong>@t.TextoMaterial</strong></div><div class="detail-box"><span>Secado</span><strong>@Horas(t.HorasSecado) · @t.TipoSecado</strong></div><div class="detail-box"><span>Debe estar listo</span><strong>@Fecha(t.FechaObjetivo)</strong></div><div class="detail-box"><span>Arranque</span><strong>@Fecha(t.FechaArranque)</strong></div>}else if(t.EsCambioMolde){<div class="detail-box"><span>Molde anterior</span><strong>@(string.IsNullOrWhiteSpace(t.MoldeAnteriorCodigo)?"—":t.MoldeAnteriorCodigo)</strong></div><div class="detail-box"><span>Molde nuevo</span><strong>@t.TextoMolde</strong></div><div class="detail-box"><span>Aviso</span><strong>30 minutos antes</strong></div><div class="detail-box"><span>Cambio</span><strong>@Fecha(t.FechaCambioMolde)</strong></div>}else{<div class="detail-box"><span>Embalaje</span><strong>@t.TextoEmbalaje</strong></div><div class="detail-box"><span>Piezas / embalaje</span><strong>@(t.PiezasPorEmbalaje?.ToString("N0")??"—")</strong></div><div class="detail-box"><span>Requeridos</span><strong>@(t.CantidadEmbalajes?.ToString("N0")??"—")</strong></div><div class="detail-box"><span>Arranque</span><strong>@Fecha(t.FechaArranque)</strong></div>}</div></article>}
@if(!hacerAhora.Any()){<div class="prep-empty"><i class="bi bi-clock"></i><strong>No hay actividades para atender ahora.</strong>Las siguientes preparaciones todavía no entran en su ventana de aviso.</div>}</div></section>
<section class="prep-section" data-section="proximas"><div class="prep-section-head"><div><h2>Próximas preparaciones</h2><p>Actividades futuras visibles para que el operador pueda anticiparse.</p></div><span class="prep-count">@proximas.Count</span></div><div class="prep-list">
@foreach(var t in proximas){<article class="task proxima"><div class="task-main"><div class="task-title"><div class="task-icon"><i class="bi @Icono(t)"></i></div><div><div class="task-kicker"><span class="task-type">@t.TipoTareaNombre</span><span class="task-chip">@t.TextoMaquina</span>@if(!string.IsNullOrWhiteSpace(t.NumeroOF)){<span class="task-chip">OF @t.NumeroOF</span>}</div><h3>@Titulo(t)</h3><div class="task-sub">@t.TextoParte · @t.TextoOperadores</div></div></div><div class="task-info"><div><span>Comenzar atención</span><b>@Fecha(t.FechaAviso)</b></div><div><span>Objetivo</span><b>@Fecha(t.FechaObjetivo)</b></div><div><span>Parte</span><b>@t.TextoParte</b></div><div><span>Cantidad</span><b>@t.CantidadProgramada.ToString("N0") PZA</b></div></div><div class="task-action"><span class="task-time blue">@t.TextoTiempo</span><small class="task-date">Avisará @t.FechaAviso.ToString("dd/MM HH:mm")</small></div></div><div class="task-details">@if(t.EsSecadoMaterial){<div class="detail-box"><span>Material</span><strong>@t.TextoMaterial</strong></div><div class="detail-box"><span>Secado requerido</span><strong>@Horas(t.HorasSecado)</strong></div><div class="detail-box"><span>Inicio de secado</span><strong>@Fecha(t.FechaAviso)</strong></div><div class="detail-box"><span>Arranque</span><strong>@Fecha(t.FechaArranque)</strong></div>}else if(t.EsCambioMolde){<div class="detail-box"><span>Molde anterior</span><strong>@(string.IsNullOrWhiteSpace(t.MoldeAnteriorCodigo)?"—":t.MoldeAnteriorCodigo)</strong></div><div class="detail-box"><span>Molde nuevo</span><strong>@t.TextoMolde</strong></div><div class="detail-box"><span>Alerta</span><strong>@Fecha(t.FechaAviso)</strong></div><div class="detail-box"><span>Cambio</span><strong>@Fecha(t.FechaCambioMolde)</strong></div>}else{<div class="detail-box"><span>Embalaje</span><strong>@t.TextoEmbalaje</strong></div><div class="detail-box"><span>Piezas / embalaje</span><strong>@(t.PiezasPorEmbalaje?.ToString("N0")??"—")</strong></div><div class="detail-box"><span>Requeridos</span><strong>@(t.CantidadEmbalajes?.ToString("N0")??"—")</strong></div><div class="detail-box"><span>Preparar desde</span><strong>@Fecha(t.FechaAviso)</strong></div>}</div></article>}
@if(!proximas.Any()){<div class="prep-empty"><i class="bi bi-calendar2-check"></i><strong>No hay preparaciones próximas.</strong>No se encontraron tareas futuras con los filtros actuales.</div>}</div></section>
<section class="prep-section" data-section="completadas"><div class="prep-section-head"><div><h2>Completadas recientemente</h2><p>Últimas actividades confirmadas por los operadores.</p></div><span class="prep-count">@completadas.Count</span></div><div class="prep-list">
@foreach(var t in completadas){<article class="task completa"><div class="task-main"><div class="task-title"><div class="task-icon"><i class="bi bi-check2-circle"></i></div><div><div class="task-kicker"><span class="task-type">@t.TipoTareaNombre</span><span class="task-chip">@t.TextoMaquina</span>@if(!string.IsNullOrWhiteSpace(t.NumeroOF)){<span class="task-chip">OF @t.NumeroOF</span>}</div><h3>@Titulo(t)</h3><div class="task-sub">@t.TextoParte</div></div></div><div class="task-info"><div><span>Objetivo</span><b>@Fecha(t.FechaObjetivo)</b></div><div><span>Confirmado</span><b>@Fecha(t.FechaConfirmacion)</b></div><div><span>Operadores programa</span><b>@t.TextoOperadores</b></div><div><span>Confirmó</span><b>@(string.IsNullOrWhiteSpace(t.UsuarioConfirmacionNombre)?$"Usuario {t.UsuarioConfirmacionID}":t.UsuarioConfirmacionNombre)</b></div></div><div class="task-action"><span class="task-time green"><i class="bi bi-check-circle me-1"></i>Completada</span>@if(!string.IsNullOrWhiteSpace(t.Observaciones)){<small class="task-date">@t.Observaciones</small>}</div></div>@if(t.EsSecadoMaterial&&t.FechaDisponibleEstimada.HasValue){<div class="task-details"><div class="detail-box"><span>Secado iniciado</span><strong>@Fecha(t.FechaConfirmacion)</strong></div><div class="detail-box"><span>Tiempo requerido</span><strong>@Horas(t.HorasSecado)</strong></div><div class="detail-box"><span>Disponible estimado</span><strong>@Fecha(t.FechaDisponibleEstimada)</strong></div><div class="detail-box"><span>Arranque</span><strong>@Fecha(t.FechaArranque)</strong>@if(t.SecadoLlegaraTarde){<div class="task-warning">Llegaría @t.MinutosRetrasoSecado min tarde al arranque.</div>}</div></div>}</article>}
@if(!completadas.Any()){<div class="prep-empty"><i class="bi bi-check2-all"></i><strong>Todavía no hay preparaciones completadas.</strong>Las confirmaciones aparecerán aquí.</div>}</div></section>
</div>
<script>
(() => {const tabs=Array.from(document.querySelectorAll('[data-tab]'));const sections=Array.from(document.querySelectorAll('[data-section]'));function openTab(name){tabs.forEach(x=>x.classList.toggle('active',x.dataset.tab===name));sections.forEach(x=>x.classList.toggle('active',x.dataset.section===name));try{localStorage.setItem('produccion-preparacion-tab',name);}catch{}}tabs.forEach(x=>x.addEventListener('click',()=>openTab(x.dataset.tab)));let initial='vencidas';try{const saved=localStorage.getItem('produccion-preparacion-tab');if(saved&&sections.some(x=>x.dataset.section===saved))initial=saved;}catch{}if(document.querySelector('[data-tab="vencidas"] b')?.textContent?.trim()==='0'&&initial==='vencidas'){if(document.querySelector('[data-tab="ahora"] b')?.textContent?.trim()!=='0')initial='ahora';else if(document.querySelector('[data-tab="proximas"] b')?.textContent?.trim()!=='0')initial='proximas';}openTab(initial);document.querySelectorAll('.confirm-form').forEach(form=>{form.addEventListener('submit',()=>{const btn=form.querySelector('button[type="submit"]');if(btn){btn.disabled=true;btn.innerHTML='<span class="spinner-border spinner-border-sm"></span> Guardando...';}});});})();
</script>
</body>
</html>
