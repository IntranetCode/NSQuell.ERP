@model ERP.NSQuell.Models.ProduccionDetalleVm

@{
    var e = Model.Ejecucion;

    var puedeGestionarChecklistArranque =
        ViewBag.PuedeGestionarChecklistArranque is bool puedeChecklist
        && puedeChecklist;

    var accionActual =
        ViewData["AccionActualProduccion"] as string
        ?? string.Empty;

    var abrirPorPrioridad =
        string.Equals(
            accionActual,
            "GENERAR_CHECKLIST",
            StringComparison.OrdinalIgnoreCase);
}

@if (puedeGestionarChecklistArranque)
{
    <div class="panel mb-4"
         id="panelChecklist"
         data-collapsible
         data-default-open="@(abrirPorPrioridad ? "true" : "false")">

        <div class="panel-header">
            <i class="bi bi-clipboard2-check me-1"></i>
            Checklist de arranque
        </div>

        <div class="panel-body">

            @if (Model.ChecklistResumen == null)
            {
                <div class="alert alert-secondary mb-3">
                    <strong>Sin checklist generado.</strong>
                    <br />

                    Abre el checklist para generarlo y comenzar
                    la captura de arranque.
                </div>

                <a href="@Url.Action(
                                               "ChecklistArranque",
                                               "Produccion",
                                               new
                                               {
                                                   ejecucionProduccionId =
                                                       e.EjecucionProduccionID
                                               })"
           class="btn btn-primary w-100 btn-strong">

                    <i class="bi bi-clipboard-check me-1"></i>
                    Generar checklist de arranque
                </a>
                }
            else
            {
                var checklist =
                Model.ChecklistResumen;

                <div class="d-flex flex-wrap justify-content-between align-items-start gap-3 mb-3">

                    <div>
                        <div class="data-label">
                            Estatus checklist
                        </div>

                        <div class="mt-1">
                            <span class="badge @checklist.EstatusClase fs-6">
                                @checklist.EstatusNombre
                            </span>
                        </div>
                    </div>

                    <div>
                        <div class="data-label">
                            Formato
                        </div>

                        <div class="data-value">
                            @checklist.CodigoFormato
                            @checklist.VersionFormato
                        </div>
                    </div>

                    <div>
                        <div class="data-label">
                            Fecha
                        </div>

                        <div class="data-value">
                            @checklist.FechaChecklist.ToString(
                            "dd/MM/yyyy HH:mm")
                </div>
            </div>

        </div>

        <div class="row g-2 mb-3">

            <div class="col-4">
                <div class="mini-stat">
                    <div class="mini-stat-label">
                        Preguntas
                    </div>

                    <div class="mini-stat-value">
                        @checklist.TotalPreguntas
                    </div>
                </div>
            </div>

            <div class="col-4">
                <div class="mini-stat">
                    <div class="mini-stat-label">
                        Respondidas
                    </div>

                    <div class="mini-stat-value text-success">
                        @checklist.TotalRespondidas
                    </div>
                </div>
            </div>

            <div class="col-4">
                <div class="mini-stat">
                    <div class="mini-stat-label">
                        NOK
                    </div>

                    <div class="mini-stat-value text-danger">
                        @checklist.TotalNOK
                    </div>
                </div>
            </div>

        </div>

        @if (checklist.TotalNOK > 0)
                {
                    <div class="alert alert-warning mb-3">
                        <i class="bi bi-exclamation-triangle me-1"></i>

                        Este checklist tiene respuestas NOK.
                        Revisa que tengan observación.
                    </div>
                }

                <a href="@Url.Action(
                                               "ChecklistArranque",
                                               "Produccion",
                                               new
                                               {
                                                   ejecucionProduccionId =
                                                       e.EjecucionProduccionID
                                               })"
           class="btn btn-primary w-100 btn-strong">

                    <i class="bi bi-clipboard-check me-1"></i>
                    Abrir checklist de arranque
                </a>
                }

        </div>
    </div>
}