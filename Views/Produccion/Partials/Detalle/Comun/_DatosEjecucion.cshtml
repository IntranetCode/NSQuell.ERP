@model ERP.NSQuell.Models.ProduccionDetalleVm
@using Microsoft.AspNetCore.Mvc.Rendering

@functions {
    private static string Txt(string? value)
    {
        return string.IsNullOrWhiteSpace(value) ? "-" : value.Trim();
    }
}

@{
    var e = Model.Ejecucion;
}

<div class="panel mb-4"
     id="panelDatosEjecucion"
     data-collapsible
     data-default-open="false">

    <div class="panel-header">
        <i class="bi bi-info-circle me-1"></i>
        Datos de ejecución
    </div>

    <div class="panel-body">
        <div class="row g-3">

            <div class="col-6">
                <div class="data-label">Máquina</div>
                <div class="data-value">@e.MaquinaCodigo</div>
                <div class="muted-small">@e.MaquinaNombre</div>
            </div>

            <div class="col-6">
                <div class="data-label">Molde</div>
                <div class="data-value">@(e.MoldeCodigo ?? "Sin molde")</div>
            </div>

            <div class="col-12">
                <div class="data-label">Parte</div>
                <div class="data-value">@e.TituloPrograma</div>
                <div class="muted-small">@e.DescripcionParte</div>
            </div>

            <div class="col-12">
                <div class="operator-line">
                    <div>
                        <div class="data-label">Operador principal</div>
                        <div class="data-value">@e.TextoOperador</div>
                        <div class="muted-small mt-1">
                            <strong>Auxiliar:</strong>
                            @(string.IsNullOrWhiteSpace(e.OperadorAuxiliarNombre)
                                                        ? "Sin auxiliar"
                                                        : e.OperadorAuxiliarNombre)
                        </div>
                    </div>

                    @if (e.PuedePausar || Model.TieneParoAbierto)
                    {
                        <button type="button"
                                class="btn btn-sm btn-outline-primary fw-bold"
                                data-bs-toggle="modal"
                                data-bs-target="#modalCambiarOperador">
                            <i class="bi bi-people me-1"></i>
                            Cambiar
                        </button>
                    }
                </div>

                @if (e.OperadoresModificadosManual)
                {
                    <div class="alert alert-info py-2 px-3 mt-2 mb-0">
                        <strong>Asignación modificada durante el turno.</strong>

                        @if (!string.IsNullOrWhiteSpace(e.MotivoCambioOperadores))
                        {
                            <div class="small mt-1">
                                @e.MotivoCambioOperadores
                            </div>
                        }
                    </div>
                }
            </div>

            <div class="col-6">
                <div class="data-label">Inicio real</div>
                <div class="data-value">
                    @(e.FechaInicioReal?.ToString("dd/MM/yyyy HH:mm") ?? "-")
                </div>
            </div>

            <div class="col-6">
                <div class="data-label">Fin real</div>
                <div class="data-value">
                    @(e.FechaFinReal?.ToString("dd/MM/yyyy HH:mm") ?? "-")
                </div>
            </div>

            <div class="col-12">
                <div class="data-label">Estado físico de máquina</div>

                @if (e.MaquinaLiberada)
                {
                    <div class="data-value text-success">
                        <i class="bi bi-unlock me-1"></i>
                        Liberada el @(e.FechaLiberacionMaquina?.ToString("dd/MM/yyyy HH:mm") ?? "-")
                    </div>
                }
                else
                {
                    <div class="data-value text-primary">
                        <i class="bi bi-lock me-1"></i>
                        Ocupada por esta ejecución
                    </div>
                }
            </div>

            <div class="col-6">
                <div class="data-label">Programa</div>
                <div class="data-value">@e.ProgramaProduccionID</div>
            </div>

            <div class="col-6">
                <div class="data-label">Ejecución</div>
                <div class="data-value">@e.EjecucionProduccionID</div>
            </div>

        </div>
    </div>
</div>

@if (e.PuedePausar || Model.TieneParoAbierto)
{
    <div class="modal fade"
         id="modalCambiarOperador"
         tabindex="-1"
         aria-labelledby="modalCambiarOperadorLabel"
         aria-hidden="true">

        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content">

                <form method="post"
                      action="@Url.Action("CambiarOperadores","Produccion")"
                      id="formCambiarOperador">

                    @Html.AntiForgeryToken()

                    <div class="modal-header">
                        <div>
                            <h5 class="modal-title fw-bold"
                                id="modalCambiarOperadorLabel">
                                <i class="bi bi-people me-1"></i>
                                Cambiar operador
                            </h5>

                            <div class="text-muted small mt-1">
                                Selecciona qué asignación deseas modificar.
                            </div>
                        </div>

                        <button type="button"
                                class="btn-close"
                                data-bs-dismiss="modal"
                                aria-label="Cerrar">
                        </button>
                    </div>

                    <div class="modal-body">

                        <input type="hidden"
                               name="ejecucionProduccionId"
                               value="@e.EjecucionProduccionID" />

                        <div class="soft-box mb-3">
                            <div class="row g-2">

                                <div class="col-12">
                                    <div class="data-label">
                                        Operador principal actual
                                    </div>
                                    <div class="data-value">
                                        @Txt(e.OperadorNombre)
                                    </div>
                                </div>

                                <div class="col-12">
                                    <div class="data-label">
                                        Auxiliar actual
                                    </div>
                                    <div class="data-value">
                                        @(string.IsNullOrWhiteSpace(e.OperadorAuxiliarNombre)
                                                                            ? "Sin auxiliar"
                                                                            : e.OperadorAuxiliarNombre)
                                </div>
                            </div>

                            </div>
                        </div>

                        <div class="mb-3">
                            <label class="form-label">
                                ¿Qué deseas cambiar?
                            </label>

                            <div class="d-flex gap-3 flex-wrap">
                                <div class="form-check">
                                    <input class="form-check-input"
                                           type="radio"
                                           name="tipoCambio"
                                           id="tipoCambioPrincipal"
                                           value="PRINCIPAL"
                                           checked />
                                    <label class="form-check-label fw-bold"
                                           for="tipoCambioPrincipal">
                                        Operador principal
                                    </label>
                                </div>

                                <div class="form-check">
                                    <input class="form-check-input"
                                           type="radio"
                                           name="tipoCambio"
                                           id="tipoCambioAuxiliar"
                                           value="AUXILIAR" />
                                    <label class="form-check-label fw-bold"
                                           for="tipoCambioAuxiliar">
                                        Auxiliar
                                    </label>
                                </div>
                            </div>
                        </div>

                        <div class="mb-3">
                            <label class="form-label"
                                   for="personaNuevaId">
                                Nueva persona
                            </label>

                            <select name="personaNuevaId"
                                    id="personaNuevaId"
                                    class="form-select"
                                    required>

                                <option value="">
                                    -- Seleccionar persona --
                                </option>

                            @if (ViewBag.OperadoresProduccion
                                                        is IEnumerable<SelectListItem> operadores)
                                {
                                    foreach (var operador in operadores)
                                    {
                                        if (!string.IsNullOrWhiteSpace(operador.Value))
                                        {
                                            <option value="@operador.Value">
                                                @operador.Text
                                            </option>
                                        }
                                    }
                                }

                            </select>
                        </div>

                        <div class="mb-0">
                            <label class="form-label"
                                   for="motivoCambio">
                                Motivo del cambio *
                            </label>

                            <textarea name="motivoCambio"
                                  id="motivoCambio"
                                  class="form-control"
                                  rows="3"
                                  maxlength="1000"
                                  required
                                  placeholder="Ej. cambio de puesto, cobertura de descanso, ajuste de asignación, ausencia, etc."></textarea>

                            <div class="form-text">
                                El motivo es obligatorio y quedará registrado
                                en la bitácora de la ejecución.
                            </div>
                        </div>

                    </div>

                    <div class="modal-footer">
                        <button type="button"
                                class="btn btn-light fw-bold"
                                data-bs-dismiss="modal">
                            Cancelar
                        </button>

                        <button type="submit"
                                class="btn btn-primary fw-bold">
                            <i class="bi bi-check2-circle me-1"></i>
                            Guardar cambio
                        </button>
                    </div>

                </form>

            </div>
        </div>
    </div>
}
