@model ERP.NSQuell.Models.ProduccionDetalleVm

@{
    var workspaceProduccion =
        (ViewBag.WorkspaceProduccion as string
         ?? "CONSULTA")
        .Trim()
        .ToUpperInvariant();

    var esWorkspaceSMED =
        workspaceProduccion == "SMED";

    var puedeGestionarChecklistArranque =
        ViewBag.PuedeGestionarChecklistArranque
            is bool puedeChecklist
        && puedeChecklist;

    var puedeGestionarMonitoreoPerifericos =
        ViewBag.PuedeGestionarMonitoreoPerifericos
            is bool puedeMonitoreo
        && puedeMonitoreo;
}

@if (esWorkspaceSMED)
{
    <div data-produccion-workspace="SMED">

        @if (puedeGestionarChecklistArranque)
        {
            <partial name="~/Views/Produccion/Partials/Detalle/Preparacion/_ChecklistArranque.cshtml"
                     model="Model" />
        }

        @if (puedeGestionarMonitoreoPerifericos)
        {
            <partial name="~/Views/Produccion/Partials/Detalle/Preparacion/_MonitoreoPerifericos.cshtml"
                     model="Model" />
        }

    </div>
}