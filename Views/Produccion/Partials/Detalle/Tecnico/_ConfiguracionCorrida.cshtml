@model ERP.NSQuell.Models.ProduccionDetalleVm
@using System.Globalization

@{
    var e = Model.Ejecucion;
    var configuracionTiempoReal = Model.ConfiguracionTiempoReal;
    var configuracionActual = configuracionTiempoReal?.ConfiguracionActual;
    var configuracionPareja = configuracionTiempoReal?.ConfiguracionActualPareja;
    var parejaLhRh = configuracionTiempoReal?.ParejaLhRh;
    var esParejaLhRh = parejaLhRh != null;
    var parejaTieneEjecucion = parejaLhRh?.TieneEjecucionPareja == true;
    var parejaCompatible = parejaLhRh?.EsCompatibleFisicamente != false;
    var tieneConfiguracionCorrida = configuracionActual?.EstaVigente == true;
    var tieneConfiguracionPareja = configuracionPareja?.EstaVigente == true;
    var configuracionParejaCompleta = tieneConfiguracionCorrida && (!esParejaLhRh || tieneConfiguracionPareja);
    var configuracionParejaParcial = esParejaLhRh && parejaTieneEjecucion && (tieneConfiguracionCorrida != tieneConfiguracionPareja);
    var puedeGestionarConfiguracionCorrida = ViewBag.PuedeGestionarConfiguracionCorrida is bool puedeGestionar && puedeGestionar;
    var bloqueoPareja = esParejaLhRh && (!parejaTieneEjecucion || !parejaCompatible || configuracionParejaParcial);
}

@if (configuracionTiempoReal != null)
{
    var cfg = configuracionTiempoReal.ConfiguracionActual;
    var cfgPareja = configuracionTiempoReal.ConfiguracionActualPareja;
    var accionConfiguracion = configuracionParejaCompleta ? Url.Action("CambiarConfiguracionCorrida", "Produccion") : Url.Action("GuardarConfiguracionCorrida", "Produccion");
    var cicloDefaultFormulario = configuracionParejaCompleta ? cfg?.TiempoCicloSegundos : configuracionTiempoReal.TiempoCicloBD;
    Func<string?, SortedSet<int>> ParsearCavidadesVista = valor =>
    {
        var resultado = new SortedSet<int>();
        if (string.IsNullOrWhiteSpace(valor)) return resultado;
        foreach (var token in valor.Split(new[] { ',', ';', '|', ' ' }, StringSplitOptions.RemoveEmptyEntries))
        {
            if (int.TryParse(token.Trim(), out var numero) && numero > 0) resultado.Add(numero);
        }
        return resultado;
    };
    Func<IEnumerable<int>?, int?, List<int>> PrepararDisponibles = (origen, cantidadBD) =>
    {
        var lista = (origen ?? Enumerable.Empty<int>()).Where(x => x > 0).Distinct().OrderBy(x => x).ToList();
        if (!lista.Any() && cantidadBD.HasValue && cantidadBD.Value > 0) lista = Enumerable.Range(1, Math.Min(cantidadBD.Value, 64)).ToList();
        return lista;
    };
    var cavidadesDisponibles = PrepararDisponibles(configuracionTiempoReal.CavidadesDisponibles, configuracionTiempoReal.CavidadesBD);
    var cavidadesDisponiblesPareja = PrepararDisponibles(configuracionTiempoReal.CavidadesDisponiblesPareja, configuracionTiempoReal.CavidadesBDPareja);
    var cavidadesSeleccionadas = ParsearCavidadesVista(cfg?.CavidadesConfiguradas);
    var cavidadesSeleccionadasPareja = ParsearCavidadesVista(cfgPareja?.CavidadesConfiguradas);
    var tieneNumeracionActual = cavidadesSeleccionadas.Count > 0;
    var tieneNumeracionPareja = cavidadesSeleccionadasPareja.Count > 0;
    var cavidadesInicialesCantidad = tieneNumeracionActual ? cavidadesSeleccionadas.Count : tieneConfiguracionCorrida ? cfg?.CavidadesUsadas ?? 0 : 0;
    var cavidadesInicialesCantidadPareja = tieneNumeracionPareja ? cavidadesSeleccionadasPareja.Count : tieneConfiguracionPareja ? cfgPareja?.CavidadesUsadas ?? 0 : 0;
    var cavidadesInicialesCsv = tieneNumeracionActual ? string.Join(",", cavidadesSeleccionadas) : string.Empty;
    var cavidadesInicialesCsvPareja = tieneNumeracionPareja ? string.Join(",", cavidadesSeleccionadasPareja) : string.Empty;
    decimal? objetivoFormularioInicial = cicloDefaultFormulario.HasValue && cicloDefaultFormulario.Value > 0 && cavidadesInicialesCantidad > 0 ? (3600m / cicloDefaultFormulario.Value) * cavidadesInicialesCantidad : null;
    decimal? objetivoFormularioInicialPareja = cicloDefaultFormulario.HasValue && cicloDefaultFormulario.Value > 0 && cavidadesInicialesCantidadPareja > 0 ? (3600m / cicloDefaultFormulario.Value) * cavidadesInicialesCantidadPareja : null;
    var ciclosReferenciaDiferentes = esParejaLhRh && configuracionTiempoReal.TiempoCicloBD.HasValue && configuracionTiempoReal.TiempoCicloBDPareja.HasValue && Math.Abs(configuracionTiempoReal.TiempoCicloBD.Value - configuracionTiempoReal.TiempoCicloBDPareja.Value) >= 0.0001m;
    var ladoActual = string.IsNullOrWhiteSpace(configuracionTiempoReal.LadoLhRh) ? "OF actual" : configuracionTiempoReal.LadoLhRh!;
    var ladoPareja = string.IsNullOrWhiteSpace(configuracionTiempoReal.LadoParejaLhRh) ? "Pareja" : configuracionTiempoReal.LadoParejaLhRh!;

    <style>
        .config-cavity-box {
            border: 1px solid #d7e2f1;
            border-radius: 14px;
            background: #f8fafc;
            padding: 14px;
            height: 100%
        }

        .config-cavity-header {
            display: flex;
            flex-wrap: wrap;
            justify-content: space-between;
            align-items: flex-start;
            gap: 10px;
            margin-bottom: 12px
        }

        .config-cavity-title {
            color: #102a56;
            font-size: .82rem;
            font-weight: 900;
            text-transform: uppercase;
            letter-spacing: .04em
        }

        .config-cavity-subtitle {
            color: #667085;
            font-size: .78rem;
            margin-top: 3px
        }

        .config-cavity-actions {
            display: flex;
            flex-wrap: wrap;
            align-items: center;
            gap: 7px
        }

            .config-cavity-actions .btn {
                display: inline-flex;
                align-items: center;
                justify-content: center;
                gap: 5px;
                min-height: 34px;
                padding: 7px 12px;
                border-radius: 999px;
                font-size: .72rem;
                font-weight: 800 !important;
                line-height: 1;
                box-shadow: none !important;
                transition: background-color .15s ease,border-color .15s ease,color .15s ease,transform .15s ease
            }

                .config-cavity-actions .btn i {
                    margin-right: 0 !important;
                    font-size: .78rem
                }

            .config-cavity-actions .btn-outline-success {
                background: #fff !important;
                border: 1px solid #a9dcc0 !important;
                color: #157347 !important
            }

                .config-cavity-actions .btn-outline-success:hover, .config-cavity-actions .btn-outline-success:focus {
                    background: #edf9f2 !important;
                    border-color: #198754 !important;
                    color: #146c43 !important;
                    transform: translateY(-1px)
                }

            .config-cavity-actions .btn-outline-secondary {
                background: #fff !important;
                border: 1px solid #d0d5dd !important;
                color: #475467 !important
            }

                .config-cavity-actions .btn-outline-secondary:hover, .config-cavity-actions .btn-outline-secondary:focus {
                    background: #f2f4f7 !important;
                    border-color: #98a2b3 !important;
                    color: #344054 !important;
                    transform: translateY(-1px)
                }

        .config-cavity-grid {
            display: grid;
            grid-template-columns: repeat(auto-fill,minmax(46px,1fr));
            gap: 8px
        }

        .config-cavity-button {
            position: relative;
            min-height: 44px;
            padding: 6px 8px;
            border: 1px solid #d0d5dd;
            border-radius: 10px;
            background: #fff;
            color: #344054;
            font-size: .86rem;
            font-weight: 900;
            line-height: 1;
            box-shadow: 0 1px 2px rgba(16,24,40,.04);
            transition: background-color .15s ease,border-color .15s ease,color .15s ease,transform .15s ease,box-shadow .15s ease
        }

            .config-cavity-button:hover {
                background: #f8fbff;
                border-color: #84adf2;
                color: #175cd3;
                transform: translateY(-1px);
                box-shadow: 0 4px 10px rgba(16,24,40,.07)
            }

            .config-cavity-button.is-selected {
                background: #ecfdf3;
                border-color: #32b46c;
                color: #067647;
                box-shadow: 0 0 0 2px rgba(18,183,106,.08)
            }

                .config-cavity-button.is-selected::after {
                    content: "\F26A";
                    position: absolute;
                    top: 4px;
                    right: 5px;
                    font-family: "bootstrap-icons";
                    font-size: .58rem;
                    color: #198754
                }

        .config-cavity-summary {
            display: flex;
            flex-wrap: wrap;
            gap: 8px;
            margin-top: 12px
        }

        .config-cavity-summary-item {
            flex: 1 1 150px;
            border: 1px solid #e5eaf3;
            border-radius: 11px;
            background: #fff;
            padding: 8px 10px
        }

        .config-cavity-summary-label {
            color: #667085;
            font-size: .65rem;
            font-weight: 900;
            text-transform: uppercase
        }

        .config-cavity-summary-value {
            color: #102a56;
            font-weight: 900;
            margin-top: 2px;
            word-break: break-word
        }

        .config-cavity-legacy {
            margin-top: 10px;
            border: 1px solid #ffe69c;
            border-radius: 11px;
            background: #fff9e8;
            color: #7a5b00;
            padding: 9px 11px;
            font-size: .78rem
        }

        .config-current-detail {
            display: grid;
            grid-template-columns: repeat(2,minmax(0,1fr));
            gap: 10px;
            margin-top: 12px
        }

        .config-current-detail-item {
            border: 1px solid #e5eaf3;
            border-radius: 11px;
            background: rgba(255,255,255,.72);
            padding: 9px 10px
        }

        .config-current-detail-label {
            color: #667085;
            font-size: .65rem;
            font-weight: 900;
            text-transform: uppercase
        }

        .config-current-detail-value {
            color: #102a56;
            font-weight: 900;
            margin-top: 2px
        }

        .config-pair-banner {
            border: 1px solid #8bb7f0;
            border-radius: 16px;
            background: linear-gradient(135deg,#eef6ff 0%,#f8fbff 55%,#eefaf5 100%);
            padding: 14px;
            margin-bottom: 14px
        }

        .config-pair-banner-head {
            display: flex;
            flex-wrap: wrap;
            align-items: center;
            justify-content: space-between;
            gap: 8px;
            margin-bottom: 10px
        }

        .config-pair-title {
            font-weight: 900;
            color: #0b4a8b;
            text-transform: uppercase;
            letter-spacing: .04em;
            font-size: .82rem
        }

        .config-pair-group {
            display: inline-flex;
            align-items: center;
            gap: 5px;
            border: 1px solid #b8d4f4;
            background: #fff;
            color: #175cd3;
            border-radius: 999px;
            padding: 5px 10px;
            font-size: .7rem;
            font-weight: 900
        }

        .config-pair-grid {
            display: grid;
            grid-template-columns: repeat(2,minmax(0,1fr));
            gap: 12px
        }

        .config-pair-side {
            border: 1px solid #d8e4f3;
            border-radius: 14px;
            background: rgba(255,255,255,.9);
            padding: 12px;
            min-width: 0
        }

        .config-pair-side-head {
            display: flex;
            align-items: center;
            justify-content: space-between;
            gap: 8px;
            margin-bottom: 8px
        }

        .config-side-badge {
            display: inline-flex;
            align-items: center;
            justify-content: center;
            min-width: 42px;
            border-radius: 999px;
            padding: 5px 9px;
            background: #0d6efd;
            color: #fff;
            font-size: .7rem;
            font-weight: 900;
            letter-spacing: .05em
        }

            .config-side-badge.rh {
                background: #198754
            }

        .config-side-status {
            font-size: .68rem;
            font-weight: 900;
            border-radius: 999px;
            padding: 4px 8px;
            background: #eef2f6;
            color: #475467
        }

            .config-side-status.ok {
                background: #e9f8ef;
                color: #157347
            }

        .config-side-part {
            font-weight: 900;
            color: #102a56;
            word-break: break-word
        }

        .config-side-meta {
            color: #667085;
            font-size: .76rem;
            margin-top: 3px
        }

        .config-shared-box {
            border: 1px dashed #6ea8fe;
            border-radius: 14px;
            background: #f6faff;
            padding: 13px;
            margin-bottom: 14px
        }

        .config-shared-head {
            display: flex;
            align-items: center;
            gap: 8px;
            font-size: .78rem;
            font-weight: 900;
            color: #0b4a8b;
            text-transform: uppercase;
            letter-spacing: .04em;
            margin-bottom: 10px
        }

        .config-shared-grid {
            display: grid;
            grid-template-columns: repeat(3,minmax(0,1fr));
            gap: 10px
        }

        .config-shared-item {
            border: 1px solid #dbe7f5;
            border-radius: 11px;
            background: #fff;
            padding: 9px 10px
        }

        .config-pair-form-grid {
            display: grid;
            grid-template-columns: repeat(2,minmax(0,1fr));
            gap: 14px
        }

        .config-objectives-grid {
            display: grid;
            grid-template-columns: repeat(2,minmax(0,1fr));
            gap: 10px
        }

        .config-objective-box {
            border: 1px solid #dbe7f5;
            border-radius: 12px;
            background: #f8fbff;
            padding: 10px 12px;
            font-weight: 800;
            color: #344054
        }

            .config-objective-box strong {
                color: #102a56
            }

        .config-warning-compact {
            border-radius: 12px;
            padding: 10px 12px;
            font-size: .8rem
        }

        html[data-nsq-theme="dark"] .config-cavity-box, html[data-nsq-theme="dark"] .config-cavity-summary-item, html[data-nsq-theme="dark"] .config-current-detail-item, html[data-nsq-theme="dark"] .config-pair-side, html[data-nsq-theme="dark"] .config-shared-item, html[data-nsq-theme="dark"] .config-objective-box {
            background: #101a2b;
            border-color: #2d3e55
        }

        html[data-nsq-theme="dark"] .config-cavity-button {
            background: #111b2d;
            border-color: #354961;
            color: #dce7f6
        }

            html[data-nsq-theme="dark"] .config-cavity-button:hover {
                background: #152238;
                border-color: #5d8fca;
                color: #a9d0ff
            }

            html[data-nsq-theme="dark"] .config-cavity-button.is-selected {
                background: #102a20;
                border-color: #286446;
                color: #79e3a8
            }

        html[data-nsq-theme="dark"] .config-cavity-actions .btn-outline-success {
            background: #111b2d !important;
            border-color: #286446 !important;
            color: #79e3a8 !important
        }

            html[data-nsq-theme="dark"] .config-cavity-actions .btn-outline-success:hover, html[data-nsq-theme="dark"] .config-cavity-actions .btn-outline-success:focus {
                background: #102a20 !important;
                border-color: #3c8b62 !important;
                color: #9aefbd !important
            }

        html[data-nsq-theme="dark"] .config-cavity-actions .btn-outline-secondary {
            background: #111b2d !important;
            border-color: #354961 !important;
            color: #c2cfdf !important
        }

            html[data-nsq-theme="dark"] .config-cavity-actions .btn-outline-secondary:hover, html[data-nsq-theme="dark"] .config-cavity-actions .btn-outline-secondary:focus {
                background: #172337 !important;
                border-color: #5c708a !important;
                color: #edf4ff !important
            }

        html[data-nsq-theme="dark"] .config-cavity-title, html[data-nsq-theme="dark"] .config-cavity-summary-value, html[data-nsq-theme="dark"] .config-current-detail-value, html[data-nsq-theme="dark"] .config-side-part, html[data-nsq-theme="dark"] .config-objective-box strong {
            color: #eaf2ff
        }

        html[data-nsq-theme="dark"] .config-cavity-subtitle, html[data-nsq-theme="dark"] .config-cavity-summary-label, html[data-nsq-theme="dark"] .config-current-detail-label, html[data-nsq-theme="dark"] .config-side-meta {
            color: #9aa9bd
        }

        html[data-nsq-theme="dark"] .config-cavity-legacy {
            background: #2b2313;
            border-color: #76571e;
            color: #f6cc6d
        }

        html[data-nsq-theme="dark"] .config-pair-banner {
            background: linear-gradient(135deg,#10233a,#101a2b 55%,#10271f);
            border-color: #315f91
        }

        html[data-nsq-theme="dark"] .config-pair-title, html[data-nsq-theme="dark"] .config-shared-head {
            color: #9dc8ff
        }

        html[data-nsq-theme="dark"] .config-pair-group {
            background: #111b2d;
            border-color: #315f91;
            color: #9dc8ff
        }

        html[data-nsq-theme="dark"] .config-shared-box {
            background: #0f1c2e;
            border-color: #315f91
        }

        @@media(max-width:768px) {
            .config-pair-grid, .config-pair-form-grid, .config-objectives-grid {
                grid-template-columns: 1fr
            }

            .config-shared-grid {
                grid-template-columns: 1fr
            }
        }

        @@media(max-width:576px) {
            .config-cavity-grid {
                grid-template-columns: repeat(4,minmax(0,1fr))
            }

            .config-current-detail {
                grid-template-columns: 1fr
            }
        }
    </style>

    <div class="panel mb-4" id="panelConfiguracionCorrida" data-collapsible data-default-open="@(!configuracionParejaCompleta || configuracionParejaParcial ? "true" : "false")">
        <div class="panel-header d-flex justify-content-between align-items-center gap-2">
            <span><i class="bi bi-sliders me-1"></i>Configuración real de la corrida</span>
            @if (configuracionParejaParcial)
            {
                <span class="badge bg-danger">Configuración LH/RH incompleta</span>
            }
            else if (configuracionParejaCompleta)
            {
                <span class="badge bg-success">@(esParejaLhRh ? "Pareja configurada" : "Configuración activa")</span>
            }
            else
            {
                <span class="badge bg-warning text-dark">Pendiente técnico</span>
            }
        </div>
        <div class="panel-body">
            @if (esParejaLhRh)
            {
                <div class="config-pair-banner">
                    <div class="config-pair-banner">
                        <div class="config-pair-banner-head">
                            <div class="config-pair-title">
                                <i class="bi bi-link-45deg me-1"></i>Operación física conjunta LH / RH
                            </div>
                            <span class="config-pair-group">
                                <i class="bi bi-diagram-3"></i>Grupo @(parejaLhRh?.GrupoLhRh.ToString() ?? "-")
                            </span>
                        </div>
                    </div>
                    <div class="config-pair-grid">
                        <div class="config-pair-side">
                            <div class="config-pair-side-head">
                                <span class="config-side-badge @(string.Equals(ladoActual, "RH", StringComparison.OrdinalIgnoreCase) ? "rh" : "")">@ladoActual</span>
                                <span class="config-side-status @(tieneConfiguracionCorrida ? "ok" : "")">@(tieneConfiguracionCorrida ? "Configurada" : "Pendiente")</span>
                            </div>
                            <div class="config-side-part">@configuracionTiempoReal.TextoParte</div>
                            <div class="config-side-meta">Ejecución #@configuracionTiempoReal.EjecucionProduccionID · Programa #@configuracionTiempoReal.ProgramaProduccionID</div>
                            @if (tieneConfiguracionCorrida && cfg != null)
                            {
                                <div class="mt-2 fw-bold">@cfg.CavidadesUsadas.ToString("N0") cav. · @cfg.ObjetivoHoraOperativo.ToString("N0") pzas/h</div>
                                <div class="muted-small">Cavidades: @(string.IsNullOrWhiteSpace(cfg.CavidadesConfiguradas) ? "Sin numeración" : cfg.CavidadesConfiguradas)</div>
                            }
                        </div>
                        <div class="config-pair-side">
                            <div class="config-pair-side-head">
                                <span class="config-side-badge @(string.Equals(ladoPareja, "RH", StringComparison.OrdinalIgnoreCase) ? "rh" : "")">@ladoPareja</span>
                                <span class="config-side-status @(tieneConfiguracionPareja ? "ok" : "")">@(parejaTieneEjecucion ? (tieneConfiguracionPareja ? "Configurada" : "Pendiente") : "Sin ejecución")</span>
                            </div>
                            <div class="config-side-part">@configuracionTiempoReal.TextoOFPareja · @configuracionTiempoReal.TextoPartePareja</div>
                            <div class="config-side-meta">Programa #@(parejaLhRh?.ProgramaParejaID.ToString() ?? "-") · Ejecución @(parejaLhRh?.EjecucionParejaID.HasValue == true ? "#" + parejaLhRh.EjecucionParejaID.Value.ToString() : "pendiente")</div>
                            @if (tieneConfiguracionPareja && cfgPareja != null)
                            {
                                <div class="mt-2 fw-bold">@cfgPareja.CavidadesUsadas.ToString("N0") cav. · @cfgPareja.ObjetivoHoraOperativo.ToString("N0") pzas/h</div>
                                <div class="muted-small">Cavidades: @(string.IsNullOrWhiteSpace(cfgPareja.CavidadesConfiguradas) ? "Sin numeración" : cfgPareja.CavidadesConfiguradas)</div>
                            }
                        </div>
                    </div>
                </div>
                @if (!parejaTieneEjecucion)
                {
                    <div class="alert alert-warning config-warning-compact"><i class="bi bi-exclamation-triangle me-1"></i>La relación LH/RH existe, pero la OF pareja todavía no tiene ejecución activa. La configuración conjunta no puede guardarse hasta que existan ambas ejecuciones.</div>
                }
                else if (!parejaCompatible)
                {
                    <div class="alert alert-danger config-warning-compact"><i class="bi bi-x-octagon me-1"></i>La pareja LH/RH ya no conserva la misma máquina, molde y ventana programada. Corrige Planeación antes de modificar la configuración.</div>
                }
                else if (configuracionParejaParcial)
                {
                    <div class="alert alert-danger config-warning-compact"><i class="bi bi-exclamation-octagon me-1"></i>Solo una de las dos ejecuciones tiene configuración vigente. El controlador bloqueará cualquier cambio parcial para evitar que LH y RH queden desincronizadas.</div>
                }
                @if (configuracionParejaCompleta && cfg != null && cfgPareja != null)
                {
                    <div class="config-shared-box">
                        <div class="config-shared-head"><i class="bi bi-cpu"></i>Datos físicos compartidos por la máquina</div>
                        <div class="config-shared-grid">
                            <div class="config-shared-item"><div class="config-current-detail-label">Ciclo real</div><div class="config-current-detail-value">@cfg.TiempoCicloSegundos.ToString("0.####") s</div></div>
                            <div class="config-shared-item"><div class="config-current-detail-label">Contador base</div><div class="config-current-detail-value">@(cfg.ContadorInicioVigencia?.ToString("N0") ?? "-")</div></div>
                            <div class="config-shared-item"><div class="config-current-detail-label">Sincronización</div><div class="config-current-detail-value">@(configuracionTiempoReal.ConfiguracionFisicaSincronizada ? "Correcta" : "Revisar")</div></div>
                        </div>
                        @if (!configuracionTiempoReal.ConfiguracionFisicaSincronizada)
                        {
                            <div class="alert alert-danger mb-0 mt-2 py-2"><i class="bi bi-exclamation-triangle me-1"></i>Las configuraciones activas no tienen el mismo ciclo y contador base. Deben corregirse como una sola operación física.</div>
                        }
                    </div>
                }
            }
            else
            {
                <div class="config-run-card mb-3 @(tieneConfiguracionCorrida ? "is-active" : "is-pending")">
                    <div class="d-flex align-items-start justify-content-between gap-2">
                        <div class="flex-grow-1">
                            <div class="data-label">@(tieneConfiguracionCorrida ? "Configuración vigente" : "Configuración requerida")</div>
                            <div class="data-value fs-5 mt-1">
                                @if (tieneConfiguracionCorrida && cfg != null)
                                {
                                    <text>@cfg.CavidadesUsadas.ToString("N0") cavidad(es) · @cfg.TiempoCicloSegundos.ToString("0.####") s · @cfg.ObjetivoHoraOperativo.ToString("N0") pzas/h</text>
                                }
                                else
                                {
                                    <text>El técnico debe confirmar la corrida</text>
                                }
                            </div>
                            @if (tieneConfiguracionCorrida && cfg != null)
                            {
                                @if (!string.IsNullOrWhiteSpace(cfg.CavidadesConfiguradas))
                                {
                                    <div class="muted-small mt-1"><strong>Cavidades activas:</strong> @cfg.CavidadesConfiguradas</div>
                                }
                                else
                                {
                                    <div class="muted-small mt-1"><i class="bi bi-clock-history me-1"></i>La configuración vigente registra la cantidad de cavidades, pero no su numeración específica.</div>
                                }
                                <div class="config-current-detail">
                                    <div class="config-current-detail-item"><div class="config-current-detail-label">Contador base</div><div class="config-current-detail-value">@(cfg.ContadorInicioVigencia?.ToString("N0") ?? "-")</div></div>
                                    <div class="config-current-detail-item"><div class="config-current-detail-label">Última lectura</div><div class="config-current-detail-value">@(configuracionTiempoReal.UltimoContadorMaquina?.ToString("N0") ?? "Sin lectura")</div></div>
                                </div>
                            }
                        </div>
                        <i class="bi @(tieneConfiguracionCorrida ? "bi-check-circle-fill text-success" : "bi-exclamation-triangle-fill text-warning") fs-4"></i>
                    </div>
                </div>
            }

            <div class="data-label mb-2">Referencia técnica de BD</div>
            @if (esParejaLhRh)
            {
                <div class="config-reference-grid mb-3" style="grid-template-columns:repeat(4,minmax(0,1fr));">
                    <div class="config-reference-item"><div class="data-label">Cavidades @ladoActual</div><div class="config-reference-value">@(configuracionTiempoReal.CavidadesBD?.ToString("N0") ?? "Sin dato")</div><div class="muted-small">Referencia de @configuracionTiempoReal.TextoParte.</div></div>
                    <div class="config-reference-item"><div class="data-label">Cavidades @ladoPareja</div><div class="config-reference-value">@(configuracionTiempoReal.CavidadesBDPareja?.ToString("N0") ?? "Sin dato")</div><div class="muted-small">Referencia de @configuracionTiempoReal.TextoPartePareja.</div></div>
                    <div class="config-reference-item"><div class="data-label">Ciclo ref. @ladoActual</div><div class="config-reference-value">@(configuracionTiempoReal.TiempoCicloBD.HasValue? configuracionTiempoReal.TiempoCicloBD.Value.ToString("0.####") + " s":"Sin dato")</div></div>
                    <div class="config-reference-item"><div class="data-label">Ciclo ref. @ladoPareja</div><div class="config-reference-value">@(configuracionTiempoReal.TiempoCicloBDPareja.HasValue? configuracionTiempoReal.TiempoCicloBDPareja.Value.ToString("0.####") + " s":"Sin dato")</div></div>
                </div>
                @if (ciclosReferenciaDiferentes)
                {
                    <div class="alert alert-warning py-2"><i class="bi bi-info-circle me-1"></i>Los ciclos maestros de ambas partes son distintos. Para Producción se capturará un solo ciclo físico real compartido por LH/RH.</div>
                }
            }
            else
            {
                <div class="config-reference-grid mb-3" style="grid-template-columns:repeat(2,minmax(0,1fr));">
                    <div class="config-reference-item"><div class="data-label">Cavidades disponibles</div><div class="config-reference-value">@(configuracionTiempoReal.CavidadesBD?.ToString("N0") ?? "Sin dato")</div><div class="muted-small">Referencia maestra de la parte.</div></div>
                    <div class="config-reference-item"><div class="data-label">Ciclo de referencia</div><div class="config-reference-value">@(configuracionTiempoReal.TiempoCicloBD.HasValue? configuracionTiempoReal.TiempoCicloBD.Value.ToString("0.####") + " s":"Sin dato")</div><div class="muted-small">Valor técnico registrado en BD.</div></div>
                </div>
            }

            @if (puedeGestionarConfiguracionCorrida && !bloqueoPareja)
            {
                <div class="config-form-box mb-3">
                    <div class="fw-bold mb-1"><i class="bi bi-person-badge me-1"></i>@(configuracionParejaCompleta ? (esParejaLhRh ? "Cambiar configuración conjunta LH/RH" : "Cambiar configuración técnica") : (esParejaLhRh ? "Confirmar configuración inicial LH/RH" : "Confirmar configuración inicial"))</div>
                    <div class="muted-small mb-3">
                        @if (esParejaLhRh)
                        {
                            <text>Selecciona las cavidades reales de cada OF. El tiempo de ciclo y el contador pertenecen a la máquina, por lo que se capturan una sola vez y se guardan en ambas ejecuciones.</text>
                        }
                        else
                        {
                            <text>Selecciona las cavidades que realmente están activas. La cantidad se calculará automáticamente.</text>
                            @if (tieneConfiguracionCorrida)
                            {
                                <text> Si solo cambia el ciclo, conserva la selección actual.</text>
                            }
                        }
                    </div>
                    <form method="post" action="@accionConfiguracion" data-config-form data-es-pareja="@(esParejaLhRh?"true":"false")" data-requiere-motivo="@(configuracionParejaCompleta?"true":"false")" novalidate>
                        @Html.AntiForgeryToken()
                        <input type="hidden" name="EjecucionProduccionID" value="@e.EjecucionProduccionID" />
                        <div class="row g-3">
                            <div class="col-12">
                                <div class="@(esParejaLhRh ? "config-pair-form-grid" : "")">
                                    <div class="config-cavity-box" data-config-cavity-selector data-existing-count="@(cfg?.CavidadesUsadas ?? 0)" data-existing-numbered="@(tieneNumeracionActual ? "true" : "false")">
                                        <input type="hidden" id="CavidadesUsadasConfig" name="CavidadesUsadas" value="@(cavidadesInicialesCantidad > 0 ? cavidadesInicialesCantidad.ToString(CultureInfo.InvariantCulture) : "")" data-config-cavidades data-default-value="@(cavidadesInicialesCantidad > 0 ? cavidadesInicialesCantidad.ToString(CultureInfo.InvariantCulture) : "")" />
                                        <input type="hidden" id="CavidadesConfiguradasConfig" name="CavidadesConfiguradas" value="@cavidadesInicialesCsv" data-config-cavidades-csv />
                                        <div class="config-cavity-header">
                                            <div><div class="config-cavity-title"><i class="bi bi-grid-3x3-gap me-1"></i>@(esParejaLhRh ? $"Cavidades {ladoActual}" : "Cavidades activas")</div><div class="config-cavity-subtitle">@(esParejaLhRh? configuracionTiempoReal.TextoParte: "Marca únicamente las posiciones que están trabajando físicamente en esta corrida.")</div></div>
                                            @if (cavidadesDisponibles.Any())
                                            {
                                                <div class="config-cavity-actions"><button type="button" class="btn btn-sm btn-outline-success fw-bold" data-config-cavity-all><i class="bi bi-check2-square"></i>Todas</button><button type="button" class="btn btn-sm btn-outline-secondary fw-bold" data-config-cavity-clear><i class="bi bi-square"></i>Limpiar</button></div>
                                            }
                                        </div>
                                        @if (!cavidadesDisponibles.Any())
                                        {
                                            <div class="alert alert-warning mb-0"><i class="bi bi-exclamation-triangle me-1"></i>No fue posible determinar las cavidades disponibles para esta parte.</div>
                                        }
                                        else
                                        {
                                            <div class="config-cavity-grid">
                                                @foreach (var cavidad in cavidadesDisponibles)
                                                {
                                                    var seleccionada = cavidadesSeleccionadas.Contains(cavidad);
                                                    <button type="button" class="config-cavity-button @(seleccionada ? "is-selected" : "")" data-config-cavity-number="@cavidad" aria-pressed="@(seleccionada ? "true" : "false")">@cavidad</button>
                                                }
                                            </div>
                                            <div class="config-cavity-summary">
                                                <div class="config-cavity-summary-item"><div class="config-cavity-summary-label">Seleccionadas</div><div class="config-cavity-summary-value"><span data-config-cavity-count>@cavidadesSeleccionadas.Count</span> de @cavidadesDisponibles.Count</div></div>
                                                <div class="config-cavity-summary-item"><div class="config-cavity-summary-label">Cavidades activas</div><div class="config-cavity-summary-value" data-config-cavity-text>@(tieneNumeracionActual ? string.Join(", ", cavidadesSeleccionadas) : "Ninguna seleccionada")</div></div>
                                            </div>
                                        }
                                        @if (tieneConfiguracionCorrida && cfg != null && !tieneNumeracionActual && cfg.CavidadesUsadas > 0)
                                        {
                                            <div class="config-cavity-legacy"><i class="bi bi-clock-history me-1"></i>La configuración vigente registra <strong>@cfg.CavidadesUsadas cavidad(es)</strong>, pero fue creada antes de guardar su numeración específica. Si solo cambias el ciclo puedes conservar esa cantidad.</div>
                                        }
                                        @if (!tieneConfiguracionCorrida)
                                        {
                                            <div class="form-text mt-2"><i class="bi bi-info-circle me-1"></i>En la configuración inicial el Técnico debe confirmar cuáles cavidades están activas.</div>
                                        }
                                    </div>
                                    @if (esParejaLhRh)
                                    {
                                        <div class="config-cavity-box" data-config-cavity-selector data-existing-count="@(cfgPareja?.CavidadesUsadas ?? 0)" data-existing-numbered="@(tieneNumeracionPareja ? "true" : "false")">
                                            <input type="hidden" id="CavidadesUsadasParejaConfig" name="CavidadesUsadasPareja" value="@(cavidadesInicialesCantidadPareja > 0 ? cavidadesInicialesCantidadPareja.ToString(CultureInfo.InvariantCulture) : "")" data-config-cavidades data-default-value="@(cavidadesInicialesCantidadPareja > 0 ? cavidadesInicialesCantidadPareja.ToString(CultureInfo.InvariantCulture) : "")" />
                                            <input type="hidden" id="CavidadesConfiguradasParejaConfig" name="CavidadesConfiguradasPareja" value="@cavidadesInicialesCsvPareja" data-config-cavidades-csv />
                                            <div class="config-cavity-header">
                                                <div><div class="config-cavity-title"><i class="bi bi-grid-3x3-gap me-1"></i>Cavidades @ladoPareja</div><div class="config-cavity-subtitle">@configuracionTiempoReal.TextoOFPareja · @configuracionTiempoReal.TextoPartePareja</div></div>
                                                @if (cavidadesDisponiblesPareja.Any())
                                                {
                                                    <div class="config-cavity-actions"><button type="button" class="btn btn-sm btn-outline-success fw-bold" data-config-cavity-all><i class="bi bi-check2-square"></i>Todas</button><button type="button" class="btn btn-sm btn-outline-secondary fw-bold" data-config-cavity-clear><i class="bi bi-square"></i>Limpiar</button></div>
                                                }
                                            </div>
                                            @if (!cavidadesDisponiblesPareja.Any())
                                            {
                                                <div class="alert alert-warning mb-0"><i class="bi bi-exclamation-triangle me-1"></i>No fue posible determinar las cavidades disponibles de la OF pareja.</div>
                                            }
                                            else
                                            {
                                                <div class="config-cavity-grid">
                                                    @foreach (var cavidad in cavidadesDisponiblesPareja)
                                                    {
                                                        var seleccionada = cavidadesSeleccionadasPareja.Contains(cavidad);
                                                        <button type="button" class="config-cavity-button @(seleccionada ? "is-selected" : "")" data-config-cavity-number="@cavidad" aria-pressed="@(seleccionada ? "true" : "false")">@cavidad</button>
                                                    }
                                                </div>
                                                <div class="config-cavity-summary">
                                                    <div class="config-cavity-summary-item"><div class="config-cavity-summary-label">Seleccionadas</div><div class="config-cavity-summary-value"><span data-config-cavity-count>@cavidadesSeleccionadasPareja.Count</span> de @cavidadesDisponiblesPareja.Count</div></div>
                                                    <div class="config-cavity-summary-item"><div class="config-cavity-summary-label">Cavidades activas</div><div class="config-cavity-summary-value" data-config-cavity-text>@(tieneNumeracionPareja ? string.Join(", ", cavidadesSeleccionadasPareja) : "Ninguna seleccionada")</div></div>
                                                </div>
                                            }
                                            @if (tieneConfiguracionPareja && cfgPareja != null && !tieneNumeracionPareja && cfgPareja.CavidadesUsadas > 0)
                                            {
                                                <div class="config-cavity-legacy"><i class="bi bi-clock-history me-1"></i>La configuración de la pareja registra <strong>@cfgPareja.CavidadesUsadas cavidad(es)</strong> sin numeración específica. Si solo cambia el ciclo puedes conservar esa cantidad.</div>
                                            }
                                            @if (!tieneConfiguracionPareja)
                                            {
                                                <div class="form-text mt-2"><i class="bi bi-info-circle me-1"></i>Confirma las cavidades reales de esta OF antes de iniciar la pareja.</div>
                                            }
                                        </div>
                                    }
                                </div>
                            </div>
                            <div class="col-12">
                                <div class="config-shared-box mb-0">
                                    <div class="config-shared-head"><i class="bi bi-cpu"></i>@(esParejaLhRh ? "Datos físicos compartidos LH/RH" : "Datos físicos de máquina")</div>
                                    <div class="row g-3">
                                        <div class="col-12 col-md-6">
                                            <label class="form-label" for="TiempoCicloSegundosConfig">@(esParejaLhRh ? "Tiempo de ciclo físico compartido (segundos)" : "Tiempo de ciclo real (segundos)")</label>
                                            <input type="number" min="0.0001" step="0.0001" class="form-control" id="TiempoCicloSegundosConfig" name="TiempoCicloSegundos" value="@(cicloDefaultFormulario?.ToString("0.####", CultureInfo.InvariantCulture) ?? "")" data-config-ciclo data-default-value="@(cicloDefaultFormulario?.ToString("0.####", CultureInfo.InvariantCulture) ?? "")" placeholder="@(configuracionTiempoReal.TiempoCicloBD?.ToString("0.####") ?? "Capturar ciclo")" />
                                            <div class="form-text">@(esParejaLhRh ? "Un solo ciclo para ambas OF porque corresponde al movimiento físico de la máquina." : "Captura únicamente el número. El ERP lo guarda en segundos.")</div>
                                        </div>
                                        <div class="col-12 col-md-6">
                                            <label class="form-label" for="ContadorMaquinaActualConfig">@(esParejaLhRh ? "Contador físico actual compartido *" : "Contador actual de la máquina *")</label>
                                            <input type="number" min="0" step="1" class="form-control" id="ContadorMaquinaActualConfig" name="ContadorMaquinaActual" data-config-contador placeholder="Ej. 12850" />
                                            <div class="form-text">@(esParejaLhRh ? "La misma lectura quedará registrada como base en LH y RH." : "Captura el valor físico actual.")</div>
                                        </div>
                                    </div>
                                </div>
                            </div>
                            <div class="col-12">
                                @if (esParejaLhRh)
                                {
                                    <div class="config-objectives-grid">
                                        <div class="config-objective-box"><span>@ladoActual · @configuracionTiempoReal.TextoParte</span><br /><strong data-config-objetivo data-config-objetivo-actual>@(objetivoFormularioInicial.HasValue? Math.Round(objetivoFormularioInicial.Value, 0, MidpointRounding.AwayFromZero).ToString("N0") + " pzas/h":"Pendiente de cavidades y ciclo")</strong></div>
                                        <div class="config-objective-box"><span>@ladoPareja · @configuracionTiempoReal.TextoOFPareja</span><br /><strong data-config-objetivo-pareja>@(objetivoFormularioInicialPareja.HasValue? Math.Round(objetivoFormularioInicialPareja.Value, 0, MidpointRounding.AwayFromZero).ToString("N0") + " pzas/h":"Pendiente de cavidades y ciclo")</strong></div>
                                    </div>
                                }
                                else
                                {
                                    <div class="config-formula" data-config-objetivo data-config-objetivo-actual>Objetivo estimado: @(objetivoFormularioInicial.HasValue? Math.Round(objetivoFormularioInicial.Value, 0, MidpointRounding.AwayFromZero).ToString("N0") + " pzas/h":"pendiente de cavidades y ciclo")</div>
                                }
                            </div>
                            @if (configuracionParejaCompleta && !esParejaLhRh)
                            {
                                <div class="col-12">
                                    <div class="config-preview-loading" data-config-preview-loading><span class="spinner-border spinner-border-sm me-1"></span>Calculando impacto en la programación...</div>
                                    <div class="config-preview" data-config-preview>
                                        <div class="d-flex justify-content-between align-items-start gap-2"><div><div class="data-label">Vista previa del cambio</div><div class="fw-bold mt-1" data-config-preview-title>Impacto estimado en la OF</div></div><span class="badge bg-secondary" data-config-preview-badge>Sin cambios</span></div>
                                        <div class="config-preview-grid">
                                            <div class="config-preview-item"><div class="config-preview-label">Objetivo</div><div class="config-preview-value" data-config-preview-objetivo>-</div></div>
                                            <div class="config-preview-item"><div class="config-preview-label">Piezas pendientes</div><div class="config-preview-value" data-config-preview-pendiente>-</div></div>
                                            <div class="config-preview-item"><div class="config-preview-label">Tiempo restante</div><div class="config-preview-value" data-config-preview-tiempo>-</div></div>
                                            <div class="config-preview-item"><div class="config-preview-label">Fin programado</div><div class="config-preview-value" data-config-preview-fin>-</div></div>
                                        </div>
                                        <div class="config-preview-impact" data-config-preview-impact>-</div>
                                        <div class="muted-small mt-2"><i class="bi bi-info-circle me-1"></i>Esta es solo una simulación. El calendario no cambia hasta aplicar la nueva configuración.</div>
                                    </div>
                                </div>
                            }
                            else if (configuracionParejaCompleta && esParejaLhRh)
                            {
                                <div class="col-12"><div class="alert alert-info mb-0"><i class="bi bi-link-45deg me-1"></i>En una pareja LH/RH el impacto real se calcula usando las dos OF y el tiempo físico mayor restante. Por eso no se muestra la previsualización individual anterior, que sería engañosa.</div></div>
                            }
                            <div class="col-12">
                                <label class="form-label" for="MotivoCambioConfiguracion">@(configuracionParejaCompleta ? "Motivo del cambio *" : "Observaciones")</label>
                                <textarea class="form-control" id="MotivoCambioConfiguracion" name="MotivoCambio" rows="2" maxlength="500" placeholder="@(configuracionParejaCompleta ? "Ej. se bloqueó una cavidad, ajuste de proceso, cambio real de ciclo, etc." : "Opcional: condición inicial de la corrida")"></textarea>
                            </div>
                            <div class="col-12"><div class="config-validation" data-config-validation></div></div>
                            <div class="col-12 d-grid">
                                <button type="submit" class="btn @(configuracionParejaCompleta ? "btn-primary" : "btn-warning") btn-strong"><i class="bi @(configuracionParejaCompleta ? "bi-arrow-repeat" : "bi-check2-circle") me-1"></i>@(configuracionParejaCompleta ? (esParejaLhRh ? "Aplicar nueva configuración LH/RH" : "Aplicar nueva configuración") : (esParejaLhRh ? "Confirmar configuración técnica LH/RH" : "Confirmar configuración técnica"))</button>
                            </div>
                        </div>
                    </form>
                </div>
            }
            else if (puedeGestionarConfiguracionCorrida && bloqueoPareja)
            {
                <div class="alert alert-warning mb-3"><i class="bi bi-lock me-1"></i>La configuración técnica está bloqueada hasta resolver la condición de la pareja LH/RH indicada arriba. No se permitirá configurar solo una de las dos OF.</div>
            }
            else
            {
                <div class="alert alert-secondary mb-3"><i class="bi bi-lock me-1"></i>Solo el Técnico de Producción asignado, el Encargado de Producción o un Administrador pueden modificar cavidades y ciclo.</div>
            }

            @if (esParejaLhRh)
            {
                @if ((configuracionTiempoReal.HistorialConfiguraciones?.Any() ?? false) || (configuracionTiempoReal.HistorialConfiguracionesPareja?.Any() ?? false))
                {
                    <div class="data-label mb-2">Historial técnico LH/RH</div>
                    <div class="config-pair-grid">
                        <div class="config-pair-side">
                            <div class="config-pair-side-head"><span class="config-side-badge @(string.Equals(ladoActual, "RH", StringComparison.OrdinalIgnoreCase) ? "rh" : "")">@ladoActual</span><strong>@configuracionTiempoReal.TextoParte</strong></div>
                            <div class="config-history">
                                @if (configuracionTiempoReal.HistorialConfiguraciones != null && configuracionTiempoReal.HistorialConfiguraciones.Any())
                                {
                                    @foreach (var h in configuracionTiempoReal.HistorialConfiguraciones)
                                    {
                                        <div class="config-history-item">
                                            <div class="d-flex flex-wrap justify-content-between align-items-start gap-2"><div><div class="fw-bold">@h.CavidadesUsadas.ToString("N0") cav. · @h.TiempoCicloSegundos.ToString("0.####") s · @h.ObjetivoHoraOperativo.ToString("N0") pzas/h</div>@if(!string.IsNullOrWhiteSpace(h.CavidadesConfiguradas)){
                                            <div class="muted-small mt-1"><strong>Cavidades:</strong> @h.CavidadesConfiguradas</div>
                                        }
                <div class="muted-small">@h.FechaInicioVigencia.ToString("dd/MM/yyyy HH:mm") → @(h.FechaFinVigencia?.ToString("dd/MM/yyyy HH:mm") ?? "Vigente")</div></div><span class="badge @(h.EstaVigente ? "bg-success" : "bg-secondary")">@(h.EstaVigente ? "Actual" : "Cerrada")</span></div>
                                        <div class="muted-small mt-1">Contador: @(h.ContadorInicioVigencia?.ToString("N0") ?? "-") → @(h.ContadorFinVigencia?.ToString("N0") ?? "-")</div>
                                        @if (!string.IsNullOrWhiteSpace(h.TecnicoProduccionNombre))
                                        {
                                            <div class="muted-small mt-1"><strong>Técnico:</strong> @h.TecnicoProduccionNombre</div>
                                        }
                                        @if (!string.IsNullOrWhiteSpace(h.MotivoCambio))
                                        {
                                            <div class="small mt-1"><strong>Motivo:</strong> @h.MotivoCambio</div>
                                        }
                                    </div>
                                }
                            }
                            else
                            {
                                <div class="muted-small">Sin historial técnico.</div>
                            }
                        </div>
                    </div>
                    <div class="config-pair-side">
                        <div class="config-pair-side-head"><span class="config-side-badge @(string.Equals(ladoPareja, "RH", StringComparison.OrdinalIgnoreCase) ? "rh" : "")">@ladoPareja</span><strong>@configuracionTiempoReal.TextoOFPareja</strong></div>
                        <div class="config-history">
                            @if (configuracionTiempoReal.HistorialConfiguracionesPareja != null && configuracionTiempoReal.HistorialConfiguracionesPareja.Any())
                            {
                                @foreach (var h in configuracionTiempoReal.HistorialConfiguracionesPareja)
                                {
                                    <div class="config-history-item">
                                        <div class="d-flex flex-wrap justify-content-between align-items-start gap-2"><div><div class="fw-bold">@h.CavidadesUsadas.ToString("N0") cav. · @h.TiempoCicloSegundos.ToString("0.####") s · @h.ObjetivoHoraOperativo.ToString("N0") pzas/h</div>@if(!string.IsNullOrWhiteSpace(h.CavidadesConfiguradas)){
                                        <div class="muted-small mt-1"><strong>Cavidades:</strong> @h.CavidadesConfiguradas</div>
                                    }
            <div class="muted-small">@h.FechaInicioVigencia.ToString("dd/MM/yyyy HH:mm") → @(h.FechaFinVigencia?.ToString("dd/MM/yyyy HH:mm") ?? "Vigente")</div></div><span class="badge @(h.EstaVigente ? "bg-success" : "bg-secondary")">@(h.EstaVigente ? "Actual" : "Cerrada")</span></div>
                                    <div class="muted-small mt-1">Contador: @(h.ContadorInicioVigencia?.ToString("N0") ?? "-") → @(h.ContadorFinVigencia?.ToString("N0") ?? "-")</div>
                                    @if (!string.IsNullOrWhiteSpace(h.TecnicoProduccionNombre))
                                    {
                                        <div class="muted-small mt-1"><strong>Técnico:</strong> @h.TecnicoProduccionNombre</div>
                                    }
                                    @if (!string.IsNullOrWhiteSpace(h.MotivoCambio))
                                    {
                                        <div class="small mt-1"><strong>Motivo:</strong> @h.MotivoCambio</div>
                                    }
                                </div>
                            }
                        }
                        else
                        {
                            <div class="muted-small">Sin historial técnico.</div>
                        }
                    </div>
                </div>
            </div>
        }
                }
                else if (configuracionTiempoReal.HistorialConfiguraciones != null && configuracionTiempoReal.HistorialConfiguraciones.Any())
        {
            <div class="data-label mb-2">Historial técnico</div>
            <div class="config-history">
                @foreach (var h in configuracionTiempoReal.HistorialConfiguraciones)
                {
                    <div class="config-history-item">
                        <div class="d-flex flex-wrap justify-content-between align-items-start gap-2"><div><div class="fw-bold">@h.CavidadesUsadas.ToString("N0") cav. · @h.TiempoCicloSegundos.ToString("0.####") s · @h.ObjetivoHoraOperativo.ToString("N0") pzas/h</div>@if(!string.IsNullOrWhiteSpace(h.CavidadesConfiguradas)){
                        <div class="muted-small mt-1"><strong>Cavidades:</strong> @h.CavidadesConfiguradas</div>
                    }
    <div class="muted-small">@h.FechaInicioVigencia.ToString("dd/MM/yyyy HH:mm") → @(h.FechaFinVigencia?.ToString("dd/MM/yyyy HH:mm") ?? "Vigente")</div></div><span class="badge @(h.EstaVigente ? "bg-success" : "bg-secondary")">@(h.EstaVigente ? "Actual" : "Cerrada")</span></div>
                    <div class="muted-small mt-1">Contador: @(h.ContadorInicioVigencia?.ToString("N0") ?? "-") → @(h.ContadorFinVigencia?.ToString("N0") ?? "-")</div>
                    @if (!string.IsNullOrWhiteSpace(h.TecnicoProduccionNombre))
                    {
                        <div class="muted-small mt-1"><strong>Técnico:</strong> @h.TecnicoProduccionNombre</div>
                    }
                    @if (!string.IsNullOrWhiteSpace(h.MotivoCambio))
                    {
                        <div class="small mt-1"><strong>Motivo:</strong> @h.MotivoCambio</div>
                    }
                </div>
            }
        </div>
                }
    </div>
</div>

<script>
    document.addEventListener('DOMContentLoaded',function(){
        document.querySelectorAll('[data-config-cavity-selector]').forEach(function(root){
            const botones=Array.from(root.querySelectorAll('[data-config-cavity-number]'));
            const inputCantidad=root.querySelector('[data-config-cavidades]');
            const inputCsv=root.querySelector('[data-config-cavidades-csv]');
            const textoCantidad=root.querySelector('[data-config-cavity-count]');
            const textoCavidades=root.querySelector('[data-config-cavity-text]');
            const botonTodas=root.querySelector('[data-config-cavity-all]');
            const botonLimpiar=root.querySelector('[data-config-cavity-clear]');
            const cantidadExistente=Number.parseInt(root.dataset.existingCount||'0',10)||0;
            const tieneNumeracionExistente=root.dataset.existingNumbered==='true';
            const seleccionadas=new Set();
            function numeroCavidad(value){const numero=Number.parseInt(value||'0',10);return Number.isFinite(numero)&&numero>0?numero:0;}
            function cargarSeleccionInicial(){const csv=(inputCsv?.value||'').trim();if(!csv)return;csv.split(',').forEach(function(valor){const numero=numeroCavidad(valor);if(numero>0)seleccionadas.add(numero);});}
            function obtenerSeleccion(){return Array.from(seleccionadas).sort(function(a,b){return a-b;});}
            function emitirCambio(input){if(!input)return;input.dispatchEvent(new Event('input',{bubbles:true}));input.dispatchEvent(new Event('change',{bubbles:true}));}
            function sincronizar(huboInteraccion){
                const lista=obtenerSeleccion();
                botones.forEach(function(boton){const numero=numeroCavidad(boton.dataset.configCavityNumber);const seleccionada=seleccionadas.has(numero);boton.classList.toggle('is-selected',seleccionada);boton.setAttribute('aria-pressed',seleccionada?'true':'false');});
                if(inputCsv)inputCsv.value=lista.join(',');
                if(inputCantidad){if(lista.length>0)inputCantidad.value=lista.length.toString();else if(!huboInteraccion&&!tieneNumeracionExistente&&cantidadExistente>0)inputCantidad.value=cantidadExistente.toString();else inputCantidad.value='';}
                if(textoCantidad)textoCantidad.textContent=lista.length.toLocaleString('es-MX');
                if(textoCavidades)textoCavidades.textContent=lista.length>0?lista.join(', '):'Ninguna seleccionada';
                emitirCambio(inputCantidad);emitirCambio(inputCsv);
            }
            cargarSeleccionInicial();
            botones.forEach(function(boton){boton.addEventListener('click',function(){const numero=numeroCavidad(boton.dataset.configCavityNumber);if(numero<=0)return;if(seleccionadas.has(numero))seleccionadas.delete(numero);else seleccionadas.add(numero);sincronizar(true);});});
            botonTodas?.addEventListener('click',function(){seleccionadas.clear();botones.forEach(function(boton){const numero=numeroCavidad(boton.dataset.configCavityNumber);if(numero>0)seleccionadas.add(numero);});sincronizar(true);});
            botonLimpiar?.addEventListener('click',function(){seleccionadas.clear();sincronizar(true);});
            sincronizar(false);
        });
        const form=document.querySelector('[data-config-form]');
        if(!form)return;
        const ciclo=form.querySelector('[data-config-ciclo]');
        const contador=form.querySelector('[data-config-contador]');
        const cavidadesActual=form.querySelector('[name="CavidadesUsadas"]');
        const cavidadesPareja=form.querySelector('[name="CavidadesUsadasPareja"]');
        const objetivoActual=form.querySelector('[data-config-objetivo-actual]');
        const objetivoPareja=form.querySelector('[data-config-objetivo-pareja]');
        const validacion=form.querySelector('[data-config-validation]');
        const motivo=form.querySelector('[name="MotivoCambio"]');
        const esPareja=form.dataset.esPareja==='true';
        const requiereMotivo=form.dataset.requiereMotivo==='true';
        function numeroDecimal(valor){if(valor===null||valor===undefined||valor==='')return NaN;return Number.parseFloat(String(valor).replace(',','.'));}
        function objetivo(cantidad,cicloValor){if(!Number.isFinite(cantidad)||cantidad<=0||!Number.isFinite(cicloValor)||cicloValor<=0)return null;return Math.round((3600/cicloValor)*cantidad);}
        function textoObjetivo(valor){return valor===null?'Pendiente de cavidades y ciclo':valor.toLocaleString('es-MX')+' pzas/h';}
        function recalcularObjetivos(){
            const cicloValor=numeroDecimal(ciclo?.value);
            const cantidadActual=Number.parseInt(cavidadesActual?.value||'0',10)||0;
            const cantidadPareja=Number.parseInt(cavidadesPareja?.value||'0',10)||0;
            const objActual=objetivo(cantidadActual,cicloValor);
            const objPareja=objetivo(cantidadPareja,cicloValor);
            if(objetivoActual){if(esPareja)objetivoActual.textContent=textoObjetivo(objActual);else objetivoActual.textContent='Objetivo estimado: '+(objActual===null?'pendiente de cavidades y ciclo':objActual.toLocaleString('es-MX')+' pzas/h');}
            if(objetivoPareja)objetivoPareja.textContent=textoObjetivo(objPareja);
        }
        [ciclo,cavidadesActual,cavidadesPareja].filter(Boolean).forEach(function(input){input.addEventListener('input',recalcularObjetivos);input.addEventListener('change',recalcularObjetivos);});
        recalcularObjetivos();
        form.addEventListener('submit',function(ev){
            const errores=[];
            const cantidadActual=Number.parseInt(cavidadesActual?.value||'0',10)||0;
            const cantidadPareja=Number.parseInt(cavidadesPareja?.value||'0',10)||0;
            const cicloValor=numeroDecimal(ciclo?.value);
            const contadorValor=Number.parseInt(contador?.value??'',10);
            if(cantidadActual<=0)errores.push('Selecciona las cavidades activas de la OF actual.');
            if(esPareja&&cantidadPareja<=0)errores.push('Selecciona las cavidades activas de la OF pareja.');
            if(!Number.isFinite(cicloValor)||cicloValor<=0)errores.push('Captura un tiempo de ciclo válido.');
            if(!Number.isFinite(contadorValor)||contadorValor<0)errores.push('Captura el contador físico actual de la máquina.');
            if(requiereMotivo&&!(motivo?.value||'').trim())errores.push('Indica el motivo del cambio de configuración.');
            if(errores.length>0){ev.preventDefault();if(validacion){validacion.className='config-validation alert alert-danger mb-0';validacion.innerHTML='<strong>No se puede guardar:</strong><br>'+errores.map(function(x){return '• '+x;}).join('<br>');}validacion?.scrollIntoView({behavior:'smooth',block:'center'});return;}
            if(validacion){validacion.className='config-validation';validacion.textContent='';}
        });
    });
</script>
}
