</head>

<body class="nsq-theme-dark" data-empresa="@empresaId">
    @await Html.PartialAsync("_Overlay")

    <a href="#main-content" class="skip-link visually-hidden">Saltar al contenido principal</a>

    <div class="main-wrapper">
        <nav class="top-navbar" role="navigation" aria-label="Navegación principal">
            <div class="navbar-content">
                <div class="navbar-left">
                    <a href="@enlaceMarca" class="navbar-brand">
                        @if (esGrupoAlmacen)
                        {
                            <i class="fas fa-warehouse" aria-hidden="true"></i>
                        }
                        else if (!string.IsNullOrEmpty(logoEmpresa) && logoEmpresa != "default-logo.png")
                        {
                            <img src="~/imagenes/@logoEmpresa" alt="Logo de @nombreEmpresa" class="navbar-logo" loading="lazy" />
                        }
                        else
                        {
                            <i class="fas fa-building" aria-hidden="true"></i>
                        }

                        <span class="navbar-title">@nombreMarca</span>
                        <span class="navbar-context">· @contextoMarca</span>
                    </a>
                </div>

                <div class="navbar-right">
                    <button type="button"
                            class="theme-switcher"
                            id="btnThemeToggle"
                            data-theme-toggle
                            aria-label="Cambiar tema"
                            title="Cambiar tema">
                        <span class="theme-switcher-icon" aria-hidden="true">
                            <i class="fas fa-sun" data-theme-icon></i>
                        </span>
                        <span class="theme-switcher-text" data-theme-text>Claro</span>
                    </button>

                    <div class="user-menu">
                        <button class="user-toggle" id="userToggle" aria-expanded="false" aria-haspopup="true" aria-label="Menú de usuario">
                            <div class="user-avatar" aria-hidden="true">@(nombreUsuario.Substring(0, 1).ToUpper())</div>

                            <div class="user-info">
                                <div class="user-name">@nombreUsuario</div>
                                <div class="user-role">Colaborador</div>
                            </div>

                            <i class="fas fa-chevron-down" aria-hidden="true"></i>
                        </button>

                        <div class="user-dropdown" id="userDropdownMenu" role="menu" aria-labelledby="userToggle">
                            <a href="#" id="linkMiPerfil" class="dropdown-item" role="menuitem">
                                <i class="fas fa-user" aria-hidden="true"></i> Mi Perfil
                            </a>

                            <a href="#" class="dropdown-item" role="menuitem" data-bs-toggle="modal" data-bs-target="#modalDenunciaAnonima">
                                <i class="fas fa-user-secret" aria-hidden="true"></i> Denuncia anónima
                            </a>

                            @*
                            <a href="#" class="dropdown-item" role="menuitem">
                                <i class="fas fa-cog" aria-hidden="true"></i> Configuración
                            </a>
                            <a href="#" class="dropdown-item" role="menuitem">
                                <i class="fas fa-question-circle" aria-hidden="true"></i> Ayuda
                            </a>
                            *@

                            <a href="/Login/Logout" class="dropdown-item">
                                <i class="fas fa-sign-out-alt" aria-hidden="true"></i> Cerrar Sesión
                            </a>
                        </div>
                    </div>
                </div>
            </div>
        </nav>

        <main class="main-content" id="main-content" role="main">
            @{
                var claseBienvenida = (ViewBag.MostrarBienvenida == true) ? "welcome-section as-overlay" : "welcome-section is-pinned";
            }

            <nav class="migapan" aria-label="Ruta">
                <a class="migapan__back" href="@Url.Action("Index", "Menu")">
                    <i class="fas fa-arrow-left"></i> Regresar
                </a>

                <ol class="migapan__list">
                    <li class="migapan__item">
                        <a href="@Url.Action("Index", "Menu")">Inicio</a>
                    </li>

                    <li class="migapan__sep">›</li>

                    <li class="migapan__item migapan__item--current" aria-current="page">
                        @ViewBag.NombreGrupo
                    </li>
                </ol>
            </nav>

            <section class="group-hero" aria-labelledby="grupo-title">
                <div class="group-hero__copy">
                    <span class="section-eyebrow">Panel de operación</span>
                    <h1 id="grupo-title">@ViewBag.NombreGrupo</h1>
                    <p>Selecciona el módulo que necesitas abrir. Cada tarjeta ahora funciona como una entrada ejecutiva con estado, acceso directo y lectura más clara.</p>
                </div>

                <div class="group-hero__metric" aria-label="Módulos disponibles">
                    <div>
                        <span>@(Model?.Count ?? 0)</span>
                        <small>Módulos disponibles</small>
                    </div>
                </div>
            </section>

            <section class="quick-actions" aria-label="Módulos disponibles">
                @if (Model != null && Model.Any())
                {
                    @foreach (var menu in Model)
                    {
                        var cssClass = GetCssClassForMenu(menu.Nombre);
                        var iconClass = GetIconClassForMenu(menu.Nombre, menu.Icono);
                        var colores = GetDynamicColors(menu.MenuID);
                        var isUniversidad = Normalizar(menu.Nombre).Contains("universidad");

                        var cardStyle = $"--card-bg:{colores.Fondo}; --card-border:{colores.Borde}; --icon-bg:{colores.Icono}; --stripe-bg:{colores.Principal};";

                        <article class="action-card module-card @cssClass @(isUniversidad ? "with-logo" : "")"
                                 style="@cardStyle"
                                 data-href="@menu.Url"
                                 role="button"
                                 tabindex="0"
                                 aria-label="Abrir módulo @menu.Nombre">
                            <span class="module-accent" aria-hidden="true"></span>

                            <div class="module-card__inner">
                                <div class="module-top">
                                    <div class="action-icon module-icon" aria-hidden="true">
                                        <i class="@iconClass"></i>
                                    </div>
                                </div>

                                <div class="module-body">
                                    <span class="module-kicker">@ViewBag.NombreGrupo</span>

                                    <h2 class="action-title module-title">@menu.Nombre</h2>

                                    <p class="action-description module-description">
                                        @(!string.IsNullOrEmpty(menu.Descripcion) ? menu.Descripcion : $"Accede a {menu.Nombre}")
                                    </p>
                                </div>

                                <div class="module-footer">
                                    <span class="module-status">
                                        <i class="fas fa-circle" aria-hidden="true"></i>
                                        Disponible
                                    </span>

                                    <span class="module-open">
                                        Abrir módulo
                                        <i class="fas fa-arrow-right" aria-hidden="true"></i>
                                    </span>
                                </div>
                            </div>
                        </article>
                    }
                }
                else
                {
                    <div class="alert alert-info" role="alert">
                        No hay módulos disponibles para este grupo.
                    </div>
                }
            </section>
        </main>
    </div>

    <!-- Modal de Perfil -->
    <div class="modal fade" id="modalPerfil" tabindex="-1" aria-labelledby="modalPerfilLabel" aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content modal-perfil">
                <div class="modal-header">
                    <h5 class="modal-title" id="modalPerfilLabel">
                        <i class="fas fa-user-circle"></i> Mi Perfil
                    </h5>

                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Cerrar"></button>
                </div>

                <div class="modal-body">
                    <div class="text-center mb-3">
                        <i class="fas fa-user-circle fa-5x text-primary"></i>
                    </div>

                    <div class="perfil-info">
                        <div class="mb-3">
                            <label class="fw-bold"><i class="fas fa-user"></i> Nombre:</label>
                            <p id="perfilNombre" class="ms-3"></p>
                        </div>

                        <div class="mb-3">
                            <label class="fw-bold"><i class="fas fa-id-badge"></i> Usuario:</label>
                            <p id="perfilUsername" class="ms-3"></p>
                        </div>

                        <div class="mb-3">
                            <label class="fw-bold"><i class="fas fa-envelope"></i> Correo:</label>
                            <p id="perfilCorreo" class="ms-3"></p>
                        </div>

                        <div class="mb-3">
                            <label class="fw-bold"><i class="fas fa-phone"></i> Teléfono:</label>
                            <p id="perfilTelefono" class="ms-3"></p>
                        </div>

                        <div class="mb-3">
                            <label class="fw-bold"><i class="fas fa-user-tag"></i> Rol:</label>
                            <p id="perfilRol" class="ms-3"></p>
                        </div>

                        <div class="mb-3">
                            <label class="fw-bold"><i class="fas fa-info-circle"></i> Descripción del Rol:</label>
                            <p id="perfilDescripcionRol" class="ms-3"></p>
                        </div>
                    </div>
                </div>

                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cerrar</button>
                </div>
            </div>
        </div>
    </div>

    <!-- Modal de la denuncia anónima -->
    <div class="modal fade" id="modalDenunciaAnonima" tabindex="-1" role="dialog" aria-labelledby="modalDenunciaAnonimaLabel" aria-hidden="true">
        <div class="modal-dialog modal-lg" role="document">
            <div class="modal-content modal-denuncia">
                <div class="modal-header">
                    <h5 class="modal-title" id="modalDenunciaAnonimaLabel">
                        Denuncia anónima y confidencial
                    </h5>

                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Cerrar"></button>
                </div>

                @using (Html.BeginForm("Crear", "DenunciasAnonimas", FormMethod.Post, new { id = "formDenunciaAnonima" }))
                {
                    @Html.AntiForgeryToken()

                    <div class="modal-body">
                        <p class="text-muted small">
                            Tu identidad no se mostrará en ningún lado. La información se enviará de forma confidencial.
                        </p>

                        <div class="form-group">
                            <label for="TipoDenuncia">Tipo de denuncia *</label>
                            <select id="TipoDenuncia" name="TipoDenuncia" class="form-control" required>
                                <option value="">-- Selecciona una opción --</option>
                                <option value="Acoso">Acoso</option>
                                <option value="Fraude">Fraude</option>
                                <option value="Conducta inadecuada">Conducta inadecuada</option>
                                <option value="Seguridad">Seguridad</option>
                                <option value="Otros">Otros</option>
                            </select>
                        </div>

                        <div class="form-group">
                            <label for="DepartamentoAfectado">Departamento afectado *</label>
                            <select id="DepartamentoAfectado" name="DepartamentoAfectado" class="form-control" required>
                                <option value="">-- Selecciona una opción --</option>
                                <option value="Recursos Humanos">Recursos Humanos</option>
                                <option value="Ventas">Compras</option>
                                <option value="Proyectos">Proyectos</option>
                                <option value="Operaciones">Almacén</option>
                                <option value="Finanzas">Finanzas</option>
                                <option value="Otro">Otro</option>
                            </select>
                        </div>

                        <div class="form-group">
                            <label for="Descripcion">Descripción detallada *</label>
                            <textarea id="Descripcion" name="Descripcion" class="form-control" rows="4" required></textarea>
                        </div>

                        <div class="form-group">
                            <label for="FechaHechos">Fecha aproximada de los hechos *</label>
                            <input type="date" id="FechaHechos" name="FechaHechos" class="form-control" />
