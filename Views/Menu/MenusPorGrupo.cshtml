    <script>
        document.addEventListener("DOMContentLoaded", function () {
            const welcomeSectionOverlay = document.getElementById("welcome-section");
            const mainWrapper = document.querySelector(".main-wrapper");
            const pinnedContainer = document.getElementById("welcome-pinned-container");
        });
    </script>

    <script>
        document.addEventListener('DOMContentLoaded', function () {
            const cards = document.querySelectorAll('.action-card');

            cards.forEach(function (card) {
                card.addEventListener('click', function () {
                    const url = card.getAttribute('data-href') || card.getAttribute('data-href-external');

                    if (url && url !== "#") {
                        if (card.hasAttribute('data-href-external')) {
                            window.open(url, '_blank');
                        } else {
                            window.location.href = url;
                        }
                    }
                });

                card.addEventListener('keydown', function (e) {
                    if (e.key === 'Enter') {
                        const url = card.getAttribute('data-href') || card.getAttribute('data-href-external');

                        if (url && url !== "#") {
                            if (card.hasAttribute('data-href-external')) {
                                window.open(url, '_blank');
                            } else {
                                window.location.href = url;
                            }
                        }
                    }
                });
            });
        });
    </script>

    <script>
        document.addEventListener('DOMContentLoaded', function () {
            const toggleBtn = document.getElementById('userToggle');
            const dropdown = document.getElementById('userDropdownMenu');

            if (!toggleBtn || !dropdown) return;

            toggleBtn.addEventListener('click', function (e) {
                e.stopPropagation();
                dropdown.classList.toggle('show');
            });

            document.addEventListener('click', function (e) {
                if (!dropdown.contains(e.target) && !toggleBtn.contains(e.target)) {
                    dropdown.classList.remove('show');
                }
            });
        });
    </script>

    @Html.AntiForgeryToken()

    <script>
        document.addEventListener('DOMContentLoaded', function () {
            const linkMiPerfil = document.getElementById('linkMiPerfil');

            if (linkMiPerfil) {
                linkMiPerfil.addEventListener('click', function (e) {
                    e.preventDefault();
                    cargarPerfil();
                });
            }

            function cargarPerfil() {
                fetch('/Perfil/ObtenerMiPerfil')
                    .then(response => response.json())
                    .then(result => {
                        if (result.success) {
                            const data = result.data;

                            document.getElementById('perfilNombre').textContent = data.nombreUsuario || 'N/A';
                            document.getElementById('perfilUsername').textContent = data.username || 'N/A';
                            document.getElementById('perfilCorreo').textContent = data.correo || 'N/A';
                            document.getElementById('perfilTelefono').textContent = data.telefono || 'N/A';
                            document.getElementById('perfilRol').textContent = data.nombreRol || 'N/A';
                            document.getElementById('perfilDescripcionRol').textContent = data.descripcionRol || 'N/A';

                            const modal = new bootstrap.Modal(document.getElementById('modalPerfil'));
                            modal.show();
                        } else {
                            alert('Error: ' + result.message);
                        }
                    })
                    .catch(error => {
                        console.error('Error:', error);
                        alert('Error al cargar el perfil');
                    });
            }
        });
    </script>


    <script>
        (function () {
            const STORAGE_KEY = 'nsq-theme';

            function normalizeTheme(theme) {
                return theme === 'light' ? 'light' : 'dark';
            }

            function applyTheme(theme) {
                const selectedTheme = normalizeTheme(theme);

                document.documentElement.setAttribute('data-nsq-theme', selectedTheme);

                if (document.body) {
                    document.body.classList.remove('nsq-theme-dark', 'nsq-theme-light');
                    document.body.classList.add(selectedTheme === 'light' ? 'nsq-theme-light' : 'nsq-theme-dark');
                }

                localStorage.setItem(STORAGE_KEY, selectedTheme);

                document.querySelectorAll('[data-theme-toggle]').forEach(function (btn) {
                    const icon = btn.querySelector('[data-theme-icon]');
                    const text = btn.querySelector('[data-theme-text]');

                    btn.setAttribute('title', selectedTheme === 'light' ? 'Cambiar a modo oscuro' : 'Cambiar a modo claro');
                    btn.setAttribute('aria-label', selectedTheme === 'light' ? 'Cambiar a modo oscuro' : 'Cambiar a modo claro');

                    if (icon) {
                        icon.className = selectedTheme === 'light' ? 'fas fa-moon' : 'fas fa-sun';
                    }

                    if (text) {
                        text.textContent = selectedTheme === 'light' ? 'Oscuro' : 'Claro';
                    }
                });
            }

            document.addEventListener('DOMContentLoaded', function () {
                const savedTheme = localStorage.getItem(STORAGE_KEY) || 'dark';
                applyTheme(savedTheme);

                document.querySelectorAll('[data-theme-toggle]').forEach(function (btn) {
                    if (btn.dataset.themeInit === '1') return;

                    btn.dataset.themeInit = '1';

                    btn.addEventListener('click', function () {
                        const currentTheme = document.documentElement.getAttribute('data-nsq-theme') || 'dark';
                        const nextTheme = currentTheme === 'light' ? 'dark' : 'light';
                        applyTheme(nextTheme);
                    });
                });
            });
        })();
    </script>

</body>
</html>

@functions {
    private string GetCssClassForMenu(string menuNombre)
    {
        if (string.IsNullOrWhiteSpace(menuNombre)) return "generico";

        var nm = Normalizar(menuNombre);

        // Solo dejamos clases para casos visuales especiales, como universidad con logo.
        return nm switch
        {
            var x when x.Contains("universidad") => "universidad",
            _ => "generico"
        };
    }

    private string GetIconClassForMenu(string menuNombre, string? iconoActual)
    {
        var nm = Normalizar(menuNombre);

        // Primero detectamos por nombre para corregir cuando venga fa-cogs desde el controlador.
        if (nm.Contains("vacaciones"))
            return "fas fa-umbrella-beach";

        if (nm.Contains("cita"))
            return "fas fa-calendar-check";

        if (nm.Contains("universidad") || nm.Contains("capacitacion"))
            return "fas fa-graduation-cap";

        if (nm.Contains("lider"))
            return "fas fa-user-shield";

        if (nm.Contains("comunicado") || nm.Contains("anuncio"))
            return "fas fa-bullhorn";

        if (nm.Contains("directorio"))
            return "fas fa-address-book";

        if (nm.Contains("proyecto"))
            return "fas fa-folder-open";

        if (nm.Contains("internacional"))
            return "fas fa-plane-departure";

        if (nm.Contains("nacional"))
            return "fas fa-cart-shopping";

        if (nm.Contains("transporte"))
            return "fas fa-truck";

        if (nm.Contains("guia"))
            return "fas fa-map-location-dot";

        if (nm.Contains("embarque"))
            return "fas fa-ship";

        if (nm.Contains("usuario"))
            return "fas fa-users";

        if (nm.Contains("gestion"))
            return "fas fa-user-gear";

        if (nm.Contains("help") || nm.Contains("soporte"))
            return "fas fa-circle-question";

        if (nm.Contains("ticket"))
            return "fas fa-ticket";

        if (nm.Contains("kpi"))
            return "fas fa-chart-simple";

        // Si no se reconoció por nombre, usa el icono de BD/controlador solo si no es genérico.
        if (!string.IsNullOrWhiteSpace(iconoActual) && !EsIconoGenerico(iconoActual))
            return FormatIcon(iconoActual);

        return "fas fa-cogs";
    }

    private bool EsIconoGenerico(string? icono)
    {
        if (string.IsNullOrWhiteSpace(icono)) return true;

        var clean = icono.Trim().ToLowerInvariant();

        return clean == "fa-cogs"
            || clean == "fas fa-cogs"
            || clean == "fa-cog"
            || clean == "fas fa-cog"
            || clean == "fa-gears"
            || clean == "fas fa-gears"
            || clean == "fa-layer-group"
            || clean == "fas fa-layer-group";
    }

    private (string Fondo, string Borde, string Icono, string Principal) GetDynamicColors(int id)
    {
        var paletas = new[]
        {
            ("#eff6ff", "#bfdbfe", "linear-gradient(135deg, #3b82f6, #1d4ed8)", "#3b82f6"),
            ("#f0fdf4", "#bbf7d0", "linear-gradient(135deg, #22c55e, #15803d)", "#22c55e"),
            ("#fefce8", "#fde68a", "linear-gradient(135deg, #eab308, #ca8a04)", "#eab308"),
            ("#fff7ed", "#fed7aa", "linear-gradient(135deg, #f97316, #ea580c)", "#f97316"),
            ("#fdf2f8", "#fbcfe8", "linear-gradient(135deg, #ec4899, #db2777)", "#ec4899"),
            ("#f5f3ff", "#ddd6fe", "linear-gradient(135deg, #8b5cf6, #6d28d9)", "#8b5cf6"),
            ("#ecfeff", "#a5f3fc", "linear-gradient(135deg, #06b6d4, #0891b2)", "#06b6d4"),
            ("#f0fdfa", "#99f6e4", "linear-gradient(135deg, #14b8a6, #0f766e)", "#14b8a6"),
            ("#fef2f2", "#fecaca", "linear-gradient(135deg, #ef4444, #dc2626)", "#ef4444"),
            ("#f8fafc", "#cbd5e1", "linear-gradient(135deg, #64748b, #334155)", "#64748b")
        };

        var index = Math.Abs(id) % paletas.Length;
        return paletas[index];
    }

    private string FormatIcon(string? icono)
    {
        if (string.IsNullOrWhiteSpace(icono))
            return "fas fa-cogs";

        var clean = icono.Trim();

        if (clean.Contains(" "))
            return clean;

        return $"fas {clean}";
    }

    private string Normalizar(string texto)
    {
        if (string.IsNullOrWhiteSpace(texto)) return "";

        var normalized = texto.Trim().ToLowerInvariant()
            .Normalize(System.Text.NormalizationForm.FormD);

        var sb = new System.Text.StringBuilder();

        foreach (var c in normalized)
        {
            var category = System.Globalization.CharUnicodeInfo.GetUnicodeCategory(c);

            if (category != System.Globalization.UnicodeCategory.NonSpacingMark)
            {
                sb.Append(c);
            }
        }

        return sb.ToString().Normalize(System.Text.NormalizationForm.FormC);
    }
}
