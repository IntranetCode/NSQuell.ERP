<script id="NSQ_MENU_INDEX_LOGO_JS_V4_6">
(function () {
    function installNsQuellLogoV46() {
        var path = (window.location.pathname || '')
            .replace(/\/+$/, '')
            .toLowerCase();

        if (path !== '/menu/index' && path !== '/menu') {
            return;
        }

        var brand = document.querySelector(
            '.top-navbar .navbar-brand, nav.top-navbar .navbar-brand'
        );

        if (!brand) {
            return;
        }

        var previous = brand.querySelector(
            '[data-nsq-menu-root-logo-v46="1"]'
        );

        if (previous) {
            previous.remove();
        }

        Array.prototype.slice
            .call(brand.children)
            .forEach(function (child) {
                var isTitle =
                    child.matches(
                        '.navbar-title, .nsq-brand-title, ' +
                        '.navbar-title-mark, [class*="title"]'
                    );

                if (isTitle) {
                    return;
                }

                var isVisual =
                    child.tagName === 'IMG'
                    || child.tagName === 'I'
                    || child.matches(
                        '.brand-icon, .navbar-icon, .action-icon, ' +
                        '[class*="brand-mark"], [class*="brand-icon"], ' +
                        '[class*="navbar-logo"], [class*="nsq-brand-logo"], ' +
                        '[class*="logo"], [class*="icon"]'
                    );

                if (isVisual) {
                    child.classList.add(
                        'nsq-menu-root-old-brand-visual-v46'
                    );
                }
            });

        var logo = document.createElement('img');

        logo.src = '/Imagenes/logo-quell.png';
        logo.alt = 'NS Quell';
        logo.className = 'nsq-menu-root-logo-v46';
        logo.setAttribute(
            'data-nsq-menu-root-logo-v46',
            '1'
        );
        logo.setAttribute('loading', 'eager');

        logo.style.setProperty(
            'display',
            'block',
            'important'
        );
        logo.style.setProperty(
            'visibility',
            'visible',
            'important'
        );
        logo.style.setProperty(
            'opacity',
            '1',
            'important'
        );

        brand.insertBefore(
            logo,
            brand.firstChild
        );
    }

    if (document.readyState === 'loading') {
        document.addEventListener(
            'DOMContentLoaded',
            installNsQuellLogoV46,
            { once: true }
        );
    }
    else {
        installNsQuellLogoV46();
    }
})();
</script>
