@model List<ERP.NSQuell.Models.MenuGrupoModel>

@using System.Security.Claims
@using ERP.NSQuell.Areas.AdminUsuarios.Interfaces

@{
    Layout = null;
    ViewData["Title"] = "ERP Industrial | NSQuell";

    // Datos de sesión
    var nombreUsuario = Context.Session.GetString("NombreMostrar") ?? Context.Session.GetString("Username") ?? "Invitado";
   var nombreEmpresa = "NSQuell ERP";
var logoEmpresa = "default-logo.png";

    // SIEMPRE desde sesión
    var currentUserId = Context.Session.GetInt32("UsuarioID") ?? 0;



    var currentUrl = $"{Context.Request.Scheme}://{Context.Request.Host}{Context.Request.Path}";
}

<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <title>@ViewData["Title"]</title>
    <meta name="viewport" content="width=device-width, initial-scale=1" />

    <script>
        (function () {
            const savedTheme = localStorage.getItem('nsq-theme') || 'dark';
            const theme = savedTheme === 'light' ? 'light' : 'dark';
            document.documentElement.setAttribute('data-nsq-theme', theme);
        })();
    </script>

    <link rel="stylesheet" href="~/css/globals/variables.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/components/navbar.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/components/cards.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/pages/dashboard.css" asp-append-version="true" />

    <link href="~/css/stylesMenuGrupos.css" rel="stylesheet" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css" />
    <link rel="preload" href="~/js/dashboard.js" as="script" />

    <link rel="stylesheet" href="~/css/overlay.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/nsquell-erp-theme.css" asp-append-version="true" />

</head>

<body class="nsq-theme-dark">
    @await Html.PartialAsync("_Overlay")

    <a href="#main-content" class="skip-link visually-hidden">Saltar al contenido principal</a>

    <div class="main-wrapper">
        @* NSQ_INICIO_DISENO_ORIGINAL_NAVBAR_COMPARTIDO_V1_2 *@
        @await Html.PartialAsync("_TopNavbar")

        <main class="main-content" id="main-content" role="main">
            @{
                var claseBienvenida = (ViewBag.MostrarBienvenida == true) ? "welcome-section as-overlay" : "welcome-section is-pinned";
            }

            <section id="welcome-section" class="@claseBienvenida" aria-labelledby="welcome-title">
                <div class="welcome-box">
                    <h1 id="welcome-title" class="welcome-title">¡Hola, @nombreUsuario!</h1>
                    <p class="welcome-subtitle">
    Centro de operación industrial para producción, almacén, compras, calidad, logística y mantenimiento.
</p>
                </div>
            </section>

            <div id="welcome-pinned-container" style="display: none;"></div>

            <section class="quick-actions" aria-label="Grupos disponibles">
                @if (Model != null && Model.Any())
                {
                    @foreach (var g in Model.OrderBy(x => x.Orden))
                    {
                        var iconoGrupo = GetIconClassForGrupo(g.IconoCss);
                        var colores = GetDynamicColors(g.MenuGrupoID);
                        var cardStyle = $"--card-bg:{colores.Fondo}; --card-border:{colores.Borde}; --icon-bg:{colores.Icono}; --stripe-bg:{colores.Principal};";

                        <article class="action-card"
                                 style="@cardStyle"
                                 data-href="@Url.Action("Grupo", "Menu", new { id = g.MenuGrupoID })"
                                 role="button"
                                 tabindex="0">

                            <div class="action-icon" aria-hidden="true">
                                <i class="@iconoGrupo"></i>
                            </div>

                            <h2 class="action-title">@g.Nombre</h2>

                            <p class="action-description">
                                @(!string.IsNullOrWhiteSpace(g.Descripcion) ? g.Descripcion : $"Accede a {g.Nombre}")
                            </p>
                        </article>
                    }
                }
                else
                {
                    <div class="alert alert-info" role="alert">
                        No hay grupos disponibles.
                    </div>
                }
            </section>
        </main>
    </div>

    <script src="~/js/overlay.js" asp-append-version="true"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/dashboard.js" asp-append-version="true"></script>

    <script type="application/ld+json">
        {
            "@@context": "https://schema.org",
            "@@type": "WebApplication",
            "name": "Intranet NS Group",
            "description": "Portal interno de @nombreEmpresa",
            "url": "@currentUrl",
            "applicationCategory": "BusinessApplication",
            "operatingSystem": "Web"
        }
    </script>

    <script>
        window.mostrarBienvenida = '@((ViewBag.MostrarBienvenida == true) ? "true" : "false")';
    </script>

    <script>
        document.addEventListener("DOMContentLoaded", function () {
            const welcomeSectionOverlay = document.getElementById("welcome-section");
            const mainWrapper = document.querySelector(".main-wrapper");
            const pinnedContainer = document.getElementById("welcome-pinned-container");

            if (welcomeSectionOverlay && welcomeSectionOverlay.classList.contains("as-overlay")) {
                mainWrapper.classList.add("overlay-lock");

                const welcomePinned = welcomeSectionOverlay.cloneNode(true);
                welcomePinned.classList.remove("as-overlay", "leaving");
                welcomePinned.classList.add("is-pinned");
                welcomePinned.style.opacity = '0';
                welcomePinned.style.transition = 'opacity 0.4s ease-in-out';

                pinnedContainer.appendChild(welcomePinned);
                pinnedContainer.style.display = 'block';

                setTimeout(() => {
                    welcomeSectionOverlay.classList.add("leaving");
                    welcomePinned.style.opacity = '1';
                }, 2000);

                setTimeout(() => {
                    if (document.getElementById("welcome-section")) {
                        welcomeSectionOverlay.remove();
                        mainWrapper.classList.remove("overlay-lock");
                    }
                }, 3200);

                welcomeSectionOverlay.addEventListener("transitionend", function handler(event) {
                    if (event.propertyName === 'opacity' && welcomeSectionOverlay.classList.contains("leaving")) {
                        welcomeSectionOverlay.remove();
                        mainWrapper.classList.remove("overlay-lock");
                        welcomeSectionOverlay.removeEventListener('transitionend', handler);
                    }
                });
            }
        });
    </script>

    <script>
        document.addEventListener('DOMContentLoaded', function () {
            const cards = document.querySelectorAll('.action-card');

            cards.forEach(function (card) {
                card.addEventListener('click', function () {
                    const url = card.getAttribute('data-href') || card.getAttribute('data-href-external');

                    if (url && url !== "#") {
                        if (card.hasAttribute('data-href-external')) {
                            window.open(url, '_blank');
                        } else {
                            window.location.href = url;
                        }
                    }
                });

                card.addEventListener('keydown', function (e) {
                    if (e.key === 'Enter') {
                        const url = card.getAttribute('data-href') || card.getAttribute('data-href-external');

                        if (url && url !== "#") {
                            if (card.hasAttribute('data-href-external')) {
                                window.open(url, '_blank');
                            } else {
                                window.location.href = url;
                            }
                        }
                    }
                });
            });
        });
    </script>





    <script>
        if (window.history.replaceState) {
            window.history.replaceState(null, '', '/Menu/Index');
        }
    </script>

    @Html.AntiForgeryToken()

    <script>
        @if (TempData["RefreshMenu"] as string == "true")
        {
            <text>
                console.log('Permisos actualizados - Recargando menú...');
                setTimeout(() => {
                    if (window.Notificaciones && typeof window.Notificaciones.actualizarContador === 'function') {
                        window.Notificaciones.actualizarContador();
                    }
                }, 1000);
            </text>
        }
    </script>




</body>
</html>

@functions {
    private string GetIconClassForGrupo(string? iconoActual)
    {
        // Si el icono viene desde BD, lo respetamos.
        if (!string.IsNullOrWhiteSpace(iconoActual))
            return FormatIcon(iconoActual);

        // Si no viene icono, usamos uno genérico.
        return "fas fa-layer-group";
    }

    private (string Fondo, string Borde, string Icono, string Principal) GetDynamicColors(int id)
    {
        // Paleta automática. Cada grupo toma color según su MenuGrupoID.
        // Si entra un nuevo registro en BD, automáticamente recibe color.
        var paletas = new[]
        {
            ("#eff6ff", "#bfdbfe", "linear-gradient(135deg, #3b82f6, #1d4ed8)", "#3b82f6"),
            ("#f0fdf4", "#bbf7d0", "linear-gradient(135deg, #22c55e, #15803d)", "#22c55e"),
            ("#fefce8", "#fde68a", "linear-gradient(135deg, #eab308, #ca8a04)", "#eab308"),
            ("#fff7ed", "#fed7aa", "linear-gradient(135deg, #f97316, #ea580c)", "#f97316"),
            ("#fdf2f8", "#fbcfe8", "linear-gradient(135deg, #ec4899, #db2777)", "#ec4899"),
            ("#f5f3ff", "#ddd6fe", "linear-gradient(135deg, #8b5cf6, #6d28d9)", "#8b5cf6"),
            ("#ecfeff", "#a5f3fc", "linear-gradient(135deg, #06b6d4, #0891b2)", "#06b6d4"),
            ("#f0fdfa", "#99f6e4", "linear-gradient(135deg, #14b8a6, #0f766e)", "#14b8a6"),
            ("#fef2f2", "#fecaca", "linear-gradient(135deg, #ef4444, #dc2626)", "#ef4444"),
            ("#f8fafc", "#cbd5e1", "linear-gradient(135deg, #64748b, #334155)", "#64748b")
        };

        var index = Math.Abs(id) % paletas.Length;
        return paletas[index];
    }

    private string FormatIcon(string? icono)
    {
        if (string.IsNullOrWhiteSpace(icono))
            return "fas fa-layer-group";

        var clean = icono.Trim();

        // Si en BD viene completo: "fas fa-users"
        if (clean.Contains(" "))
            return clean;

        // Si en BD viene solo: "fa-users"
        return $"fas {clean}";
    }
}