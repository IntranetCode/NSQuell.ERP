@model ERP.NSQuell.Models.TiemposMuertosVm
@using ERP.NSQuell.Models
@using System.Globalization
@{
    Layout="~/Views/Shared/_Layout.cshtml";
    ViewData["Title"]="Tiempos de espera | Dirección";
    var total=Model.HorasNetas;
    var areaPrincipal=Model.Areas.FirstOrDefault();
    var mayorDia=Model.Dias.Count>0?Math.Max(1,Model.Dias.Max(x=>x.Horas)):1;
    var mayorArea=Model.Areas.Count>0?Math.Max(1,Model.Areas.Max(x=>x.Horas)):1;
    var maxHoras=Math.Max(1,Model.OrdenesTrabajo.Count>0?Model.OrdenesTrabajo.Max(x=>x.HorasNetas):0);
    var inv=CultureInfo.InvariantCulture;
    string Num(double n)=>n.ToString("0.###",inv);
}
@section Styles {
<link rel="stylesheet" href="~/css/Indicadores/tiempos-direccion-v1-1.css" asp-append-version="true" />
}
<section class="tdx" id="tdx-panel" data-tdx-version="1.1">
 <header class="tdx-heading">
  <div><div class="tdx-eyebrow">DIRECCIÓN · FLUJO OPERATIVO</div><h1>Tiempos de espera y paros</h1><p>Una lectura consolidada de dónde se detiene el flujo y qué requiere atención.</p></div>
  <div class="tdx-header-actions"><span class="tdx-snapshot"><span class="tdx-live-dot"></span> Consulta @Model.Actualizado.ToString("HH:mm")</span><button type="button" class="tdx-btn tdx-btn-quiet" data-tdx-print><i class="fa-solid fa-print"></i> Imprimir</button></div>
 </header>
 <form method="get" class="tdx-filter" id="tdx-filter">
  <div><label for="enfoque">Qué necesitas ver</label><select id="enfoque" name="enfoque"><option value="AHORA" selected="@(Model.Enfoque=="AHORA")">Pendientes ahora</option><option value="HISTORICO" selected="@(Model.Enfoque=="HISTORICO")">Histórico del periodo</option></select></div>
  <div><label for="departamento">Área</label><select id="departamento" name="departamento"><option value="">Todas las áreas</option>@foreach(var d in Model.Departamentos){<option value="@d" selected="@(d==Model.Departamento)">@d</option>}</select></div>
  <div><label for="maquinaId">Máquina</label><select id="maquinaId" name="maquinaId"><option value="">Todas las máquinas</option>@foreach(var m in Model.Maquinas){<option value="@m.ID" selected="@(m.ID==Model.MaquinaID)">@m.Nombre</option>}</select></div>
  <div><label for="fase">Etapa pendiente</label><select id="fase" name="fase"><option value="">Todas las etapas</option>@foreach(var f in Model.Fases){<option value="@f" selected="@(f==Model.Fase)">@f</option>}</select></div>
  <div><label for="desde">Desde</label><input id="desde" name="desde" type="date" value="@Model.Desde.ToString("yyyy-MM-dd")" /></div>
  <div><label for="hasta">Hasta</label><input id="hasta" name="hasta" type="date" value="@Model.Hasta.ToString("yyyy-MM-dd")" /></div>
  <div><label for="categoria">Medición</label><select id="categoria" name="categoria"><option value="DEMORA" selected="@(Model.Categoria=="DEMORA")">Esperas y paros</option><option value="ESPERA" selected="@(Model.Categoria=="ESPERA")">Solo esperas</option><option value="PARO" selected="@(Model.Categoria=="PARO")">Solo paros</option><option value="TRABAJO" selected="@(Model.Categoria=="TRABAJO")">Trabajo en proceso</option><option value="TODOS" selected="@(Model.Categoria=="TODOS")">Todas las actividades</option></select></div>
  <div class="tdx-search"><label for="of">OF, parte o designación</label><input id="of" name="of" type="search" placeholder="Buscar una orden o parte…" value="@Model.OF" maxlength="100" /></div>
  <label class="tdx-checkbox"><input name="soloActivos" type="checkbox" value="true" checked="@Model.SoloActivos" /> Solo abiertos</label>
  <button class="tdx-btn tdx-btn-primary" type="submit"><i class="fa-solid fa-rotate"></i> Consultar</button>
  <button class="tdx-btn tdx-btn-quiet" name="descargar" value="true" type="submit" title="Descargar resumen consolidado"><i class="fa-solid fa-download"></i> CSV</button>
  <a href="@Url.Action("Index","TiemposMuertos")" class="tdx-btn tdx-btn-quiet">Limpiar filtros</a>
 </form>
 <aside class="tdx-data-note"><i class="fa-solid fa-compass"></i><span><b>@(Model.Enfoque=="AHORA"?"Pendientes ahora":"Histórico del periodo")</b> · @(Model.Enfoque=="AHORA"?"Solo esperas y paros abiertos, desde su inicio real, aunque comenzaron antes de esta semana.":"Incluye intervalos abiertos y atendidos dentro de las fechas elegidas.") Área: @(Model.Departamento??"Todas") · Etapa: @(Model.Fase??"Todas") · @Model.OrdenesConOF OF. Las horas corresponden a los filtros seleccionados.</span></aside>
 <div class="tdx-kpis">
  <article class="tdx-kpi tdx-kpi-total"><span class="tdx-kpi-label">@(Model.Enfoque=="AHORA"?"Tiempo neto de pendientes abiertos":"Espera y paro netos")</span><div class="tdx-kpi-value">@TiemposMuertosVm.HorasTexto(total)<span>h</span></div><span class="tdx-kpi-caption">Intervalos simultáneos contados una sola vez</span><i class="fa-solid fa-stopwatch tdx-kpi-icon"></i></article>
  <article class="tdx-kpi"><span class="tdx-kpi-label"><span class="tdx-dot tdx-dot-wait"></span> Espera neta</span><div class="tdx-kpi-value">@TiemposMuertosVm.HorasTexto(Model.HorasEspera)<span>h</span></div><span class="tdx-kpi-caption">Tiempo de flujo pendiente de atención</span></article>
  <article class="tdx-kpi"><span class="tdx-kpi-label"><span class="tdx-dot tdx-dot-stop"></span> Paros registrados</span><div class="tdx-kpi-value">@TiemposMuertosVm.HorasTexto(Model.HorasParo)<span>h</span></div><span class="tdx-kpi-caption">Paros con registro operativo</span></article>
  <article class="tdx-kpi"><span class="tdx-kpi-label">OF con pendientes</span><div class="tdx-kpi-value">@Model.OrdenesAbiertas<span> / @Model.OrdenesConOF</span></div><span class="tdx-kpi-caption">OF que requieren atención en la consulta</span></article>
 </div>
 @if(Model.DatosSinCierre>0){<aside class="tdx-data-note"><i class="fa-solid fa-circle-info"></i> @Model.DatosSinCierre tareas confirmadas no tienen hora de cierre registrada. No se muestran como esperas abiertas ni se estiman sus horas finales.</aside>}
 <div class="tdx-chart-grid">
  <article class="tdx-card">
   <div class="tdx-card-heading"><div><h2>Concentración por área</h2><p>Participación en el tiempo neto del periodo</p></div><span class="tdx-pill">@Model.Areas.Count áreas</span></div>
   @if(Model.Areas.Count==0){<div class="tdx-empty"><i class="fa-solid fa-circle-check"></i><span>No hay esperas ni paros en esta consulta.</span></div>}
   @foreach(var a in Model.Areas){
    var pct=total>0?a.Horas/total*100:0;
    <div class="tdx-area"><div class="tdx-area-top"><span>@a.Nombre</span><span><b>@TiemposMuertosVm.HorasTexto(a.Horas) h</b><small>@pct.ToString("0")%</small></span></div>
     <div class="tdx-track" role="img" aria-label="@a.Nombre: @TiemposMuertosVm.Duracion(a.Horas)"><span class="tdx-fill-wait" style="width:@Num(a.HorasEspera/mayorArea*100)%"></span><span class="tdx-fill-stop" style="width:@Num(a.HorasParo/mayorArea*100)%"></span></div>
     <div class="tdx-area-foot">@a.Recursos.Count frentes @if(a.Nombre=="Áreas simultáneas"){<span>· @string.Join(" / ",a.Responsables.OrderBy(x=>x))</span>}</div>
    </div>
   }
   <div class="tdx-legend"><span><i class="tdx-dot tdx-dot-wait"></i> Espera</span><span><i class="tdx-dot tdx-dot-stop"></i> Paro</span></div>
  </article>
  <article class="tdx-card">
   <div class="tdx-card-heading"><div><h2>@(Model.Enfoque=="AHORA"?"Estado de la consulta":"Evolución diaria")</h2><p>Horas netas por día · @Model.Desde.ToString("dd MMM") — @Model.Hasta.ToString("dd MMM yyyy")</p></div><span class="tdx-pill">Sin duplicados</span></div>
   @if(Model.Enfoque=="AHORA"){
    <div class="tdx-empty"><i class="fa-solid fa-clock"></i><span>Esta consulta muestra pendientes abiertos al @Model.Actualizado.ToString("dd/MM HH:mm"). Cambia a Histórico del periodo para comparar días.</span></div>
   }
   @if(Model.Enfoque!="AHORA"){
   <div class="tdx-daily-scroll"><div class="tdx-daily" style="--tdx-days:@Model.Dias.Count" role="img" aria-label="Evolución diaria de horas de espera y paro">
   @foreach(var d in Model.Dias){<div class="tdx-day"><span class="tdx-day-value">@TiemposMuertosVm.HorasTexto(d.Horas)</span><div class="tdx-day-track"><span style="height:@Num(d.Horas/mayorDia*100)%" title="@d.Fecha.ToString("dd/MM/yyyy"): @TiemposMuertosVm.HorasTexto(d.Horas) h"></span></div><span class="tdx-day-label">@d.Fecha.ToString("dd/MM")</span></div>}
   </div></div>
   }
   <div class="tdx-insight">@if(areaPrincipal!=null){<i class="fa-solid fa-chart-simple"></i><span><b>@areaPrincipal.Nombre</b> concentra @((areaPrincipal.Horas/Math.Max(total,0.0001)*100).ToString("0"))% del tiempo neto consultado.</span>}else{<span>Selecciona otro periodo para comparar el flujo.</span>}</div>
  </article>
 </div>
 @* NSQ_TIEMPOS_POR_OF_V2_2 *@
 <details class="tdx-card tdx-orders" data-tdx-orders>
  <summary class="tdx-orders-toggle">
   <span class="tdx-orders-title"><i class="fa-solid fa-file-lines" aria-hidden="true"></i><span><b>Ver detalle por OF</b><small>Consulta dónde está detenida cada orden y qué área debe atenderla.</small></span></span>
   <span class="tdx-orders-count">@Model.OrdenesConOF OF <i class="fa-solid fa-chevron-down" aria-hidden="true"></i></span>
  </summary>
  <div class="tdx-orders-content">
  @if(Model.OrdenesTrabajo.Count==0){<div class="tdx-empty"><i class="fa-solid fa-magnifying-glass"></i><span>No se encontraron órdenes con estos filtros.</span></div>}
  @foreach(var orden in Model.OrdenesTrabajo){
   var abiertas=orden.Episodios.Where(x=>x.Abierto&&x.Categoria!="TRABAJO").ToList();
   var estado=orden.TienePendientes?"Pendiente":orden.EnProceso?"En proceso":"Atendida";
   <details class="tdx-machine tdx-order">
    <summary><span class="tdx-machine-name"><span class="tdx-machine-icon"><i class="fa-solid fa-file-lines"></i></span><span><b>@orden.Titulo</b><small>@string.Join(" / ",orden.Partes)</small><small>@string.Join(" / ",orden.Maquinas) · @orden.Episodios.Count etapas</small></span></span>
     <span class="tdx-machine-task"><span class="tdx-status @(orden.TienePendientes?"tdx-status-wait":orden.EnProceso?"tdx-status-work":"tdx-status-done")">@estado</span><small>@(orden.TienePendientes?string.Join(" · ",orden.AreasPendientes)+" · "+string.Join(" / ",abiertas.Select(x=>x.Fase).Distinct()):orden.EnProceso?"Actividad operativa en curso":"Sin pendientes abiertos en la consulta")</small></span>
     <span class="tdx-machine-hours"><b>@TiemposMuertosVm.HorasTexto(orden.HorasNetas) h</b><small>Espera @TiemposMuertosVm.HorasTexto(orden.HorasEspera) · Paro @TiemposMuertosVm.HorasTexto(orden.HorasParo)</small><span class="tdx-mini-track"><i style="width:@Num(orden.HorasNetas/maxHoras*100)%"></i></span></span><i class="fa-solid fa-chevron-down tdx-chevron"></i>
    </summary>
    <div class="tdx-machine-detail">
     <div class="tdx-of-chips">@foreach(var parte in orden.Partes){<span>@parte</span>}</div>
     <div class="tdx-detail-scroll"><table class="tdx-detail-table"><thead><tr><th>Área / etapa / máquina</th><th>Tipo</th><th>Inicio real</th><th>Cierre real</th><th>Tiempo de esta OF</th></tr></thead><tbody>
     @foreach(var episodio in orden.Episodios){
      var segundos=episodio.Horas*3600;
      <tr><td><span class="tdx-cell-title">@episodio.Fase</span><span class="tdx-cell-sub">@episodio.Departamento · @episodio.Maquina</span></td><td><span class="tdx-status @(episodio.Categoria=="PARO"?"tdx-status-stop":episodio.Categoria=="TRABAJO"?"tdx-status-work":"tdx-status-wait")">@(episodio.Categoria=="TRABAJO"?"Trabajo":episodio.Categoria=="PARO"?"Paro":"Espera")</span></td><td>@episodio.InicioReal.ToString("dd/MM HH:mm")</td><td>@(episodio.FinReal.HasValue?episodio.FinReal.Value.ToString("dd/MM HH:mm"):"Abierto")</td><td><span class="tdx-clock" data-tdx-seconds="@Num(segundos)" data-tdx-active="@(episodio.Abierto&&Model.EsPeriodoActual?"1":"0")" data-tdx-max="@Num(Math.Max(0,(Model.Hasta.AddDays(1)-episodio.InicioPeriodo).TotalSeconds))">@TiemposMuertosVm.Duracion(episodio.Horas)</span></td></tr>
      <tr class="tdx-trace-row"><td colspan="5"><details class="tdx-trace"><summary>Ver partes y registros de esta etapa (@episodio.Registros.Count)</summary>@foreach(var registro in episodio.Registros){<div><span class="tdx-cell-title">@registro.NumeroParte · @registro.Designacion</span><span class="tdx-cell-sub">Programa @registro.ProgramaID · @registro.Tarea</span>@if(!string.IsNullOrWhiteSpace(registro.Motivo)){<p>@registro.Motivo</p>}</div>}</details></td></tr>
     }
     </tbody></table></div>
    </div>
   </details>
  }
  </div>
 </details>
 <details class="tdx-method"><summary>Cómo leer estos indicadores</summary><p>Las horas se recortan al periodo elegido y se unen por máquina. Una hora con varias OF o tareas simultáneas cuenta una sola vez. Si un paro coincide con una espera, se clasifica como paro. Las áreas que coinciden comparten el grupo “Áreas simultáneas”, por eso las barras suman el total neto.</p><p>La espera de flujo puede comenzar antes del arranque de la máquina; no representa por sí sola una avería ni toda la capacidad perdida. El secado y la validación en curso son trabajo, y no se suman a espera o paro. Cada OF conserva sólo sus registros. Las horas de sus etapas se consolidan por equipo. Si varias OF comparten una espera, sus tiempos pueden coincidir: el resumen general une esos intervalos una sola vez y no se obtiene sumando las tarjetas de OF.</p><p>Los indicadores y estados corresponden a la última consulta; los relojes abiertos avanzan en pantalla. Pulsa Consultar para actualizar los estados. @Model.RegistrosConsolidados registros se agruparon dentro de etapas coincidentes.</p></details>
 <footer class="tdx-footer"><span>NS QUELL · DIRECCIÓN</span><span>@Model.Desde.ToString("dd/MM/yyyy") — @Model.Hasta.ToString("dd/MM/yyyy") · Actualizado @Model.Actualizado.ToString("dd/MM/yyyy HH:mm:ss")</span></footer>
</section>
@section Scripts {
<script src="~/js/Indicadores/tiempos-direccion-v1-1.js" asp-append-version="true"></script>
}
