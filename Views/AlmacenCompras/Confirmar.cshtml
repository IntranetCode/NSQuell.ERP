@model ERP.NSQuell.Models.ViewModels.Almacen.AlmacenCompraVm
@{ Layout = "~/Views/Shared/_Layout.cshtml"; ViewData["Title"]="Solicitar compra"; }

@section Styles {
    <link rel="stylesheet" href="~/css/Almacen/almacen-navegacion.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/nsquell-erp-theme.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/Almacen/almacen.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/Almacen/almacen-vistas.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/Almacen/almacen-temas.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/Almacen/almacen-operativo-v3.css" asp-append-version="true" />
}


@section Scripts {
    <script src="~/js/Almacen/almacen-vistas.js" asp-append-version="true"></script>
}


@await Html.PartialAsync("_AlmacenNavegacion")

@await Html.PartialAsync("_AlmacenMensajes")


<section class="ao-hero"><div><small>REABASTECIMIENTO</small><h1>Solicitar compra</h1><p>La solicitud conserva articulo, variante, stock, minimo y usuario solicitante; Compras recibe una notificacion.</p></div></section>
<section class="ao-panel ao-purchase"><div class="ao-summary"><div><small>Articulo</small><strong>@Model.Codigo</strong><span>@Model.Descripcion</span></div><div><small>Variante</small><strong>@(string.IsNullOrWhiteSpace(Model.Variante)?"N/A":Model.Variante)</strong></div><div><small>Stock</small><strong>@Model.Stock.ToString("N3") @Model.Unidad</strong></div><div><small>Minimo</small><strong>@Model.StockMinimo.ToString("N3") @Model.Unidad</strong></div></div><form method="post" class="ao-form">@Html.AntiForgeryToken()<input asp-for="Modulo" type="hidden"/><input asp-for="CatalogoID" type="hidden"/><input asp-for="Variante" type="hidden"/><input asp-for="ReturnUrl" type="hidden"/><label>Motivo o comentario<textarea asp-for="Motivo" class="alm-textarea" placeholder="Necesidad operativa, urgencia o referencia"></textarea></label><div class="ao-actions"><a class="alm-btn secondary" href="@(Model.ReturnUrl??Url.Action("Index","Almacen"))">Cancelar</a><button class="alm-btn" type="submit"><i class="fa-solid fa-cart-plus"></i> Enviar a Compras</button></div></form></section>
