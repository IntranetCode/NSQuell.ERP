@model ERP.NSQuell.Models.PlaneacionPanoramaVm
@using ERP.NSQuell.Models
@using System.Globalization
@using System.Collections.Generic
@using System.Linq

@{
    Layout = "~/Views/Shared/_Layout.cshtml";
    ViewData["Title"] = "Panorama de Planeación | ERP Quell";
    var cultura = new CultureInfo("es-MX");
}

@section Scripts {
    <script>
        const inputBusqueda = document.getElementById('buscarTexto');
        const cardsCliente = Array.from(document.querySelectorAll('.client-card'));
        const filtrosEstado = Array.from(document.querySelectorAll('.filtro-estado'));

        let estadoActivo = 'todos';

        function normalizar(valor) {
            return (valor || '')
                .toString()
                .toLowerCase()
                .normalize('NFD')
                .replace(/[\u0300-\u036f]/g, '')
                .trim();
        }

        function aplicarFiltros() {
            const texto = normalizar(inputBusqueda?.value || '');

            cardsCliente.forEach(card => {
                const search = normalizar(card.dataset.search || '');
                const estados = normalizar(card.dataset.estados || '');

                const coincideTexto = !texto || search.includes(texto);
                const coincideEstado = estadoActivo === 'todos' || estados.includes(estadoActivo);

                if (coincideTexto && coincideEstado) {
                    card.classList.remove('hidden-by-filter');
                } else {
                    card.classList.add('hidden-by-filter');
                }
            });
        }

        inputBusqueda?.addEventListener('input', aplicarFiltros);

        filtrosEstado.forEach(btn => {
            btn.addEventListener('click', function () {
                filtrosEstado.forEach(b => b.classList.remove('active'));
                this.classList.add('active');
                estadoActivo = this.dataset.estado || 'todos';
                aplicarFiltros();
            });
        });

        document.querySelectorAll('[data-piece-button]').forEach(btn => {
            btn.addEventListener('click', function () {
                const modalId = this.dataset.pieceButton;
                const pieceId = this.dataset.pieceTarget;

                document.querySelectorAll(`[data-piece-button="${modalId}"]`).forEach(b => {
                    b.classList.remove('active');
                });

                document.querySelectorAll(`[data-piece-panel="${modalId}"]`).forEach(panel => {
                    panel.classList.remove('active');
                });

                this.classList.add('active');

                const target = document.querySelector(`[data-piece-panel="${modalId}"][data-piece-id="${pieceId}"]`);

                if (target) {
                    target.classList.add('active');
                }
            });
        });

        document.querySelectorAll('.mode-switch').forEach(sw => {
            const key = sw.dataset.switch;
            const buttons = Array.from(sw.querySelectorAll('.mode-btn'));

            buttons.forEach(btn => {
                btn.addEventListener('click', function () {
                    const view = this.dataset.view;

                    buttons.forEach(b => b.classList.remove('active'));
                    this.classList.add('active');

                    document.querySelectorAll(`[data-timeline="${key}"]`).forEach(timeline => {
                        if (timeline.dataset.view === view) {
                            timeline.classList.add('active');
                        } else {
                            timeline.classList.remove('active');
                        }
                    });
                });
            });
        });
    </script>
    <script src="~/js/shared/nsq-dynamic-style.js" asp-append-version="true"></script>
}


@section Styles {
    <link rel="stylesheet" href="~/css/PlaneacionPanorama/index.css" asp-append-version="true" />
}


@functions {
    static readonly CultureInfo CulturaMx = new CultureInfo("es-MX");

    string Valor(string? v) => string.IsNullOrWhiteSpace(v) ? "-" : v;
    string Fecha(DateTime? f) => f.HasValue ? f.Value.ToString("dd/MM/yyyy") : "-";
    string FechaHora(DateTime? f) => f.HasValue ? f.Value.ToString("dd/MM/yyyy HH:mm") : "-";
    string Entero(int v) => v.ToString("N0");
    string EnteroNullable(int? v) => v.HasValue ? v.Value.ToString("N0") : "0";
    string Decimal2(decimal? v) => v.HasValue ? v.Value.ToString("N2") : "0.00";
    string Decimal2NoNull(decimal v) => v.ToString("N2");

    decimal Porcentaje(int valor, int total)
    {
        if (total <= 0)
            return 0;

        return Math.Round(((decimal)valor / total) * 100, 2);
    }

    decimal PorcentajeDecimal(decimal valor, decimal total)
    {
        if (total <= 0)
            return 0;

        return Math.Round((valor / total) * 100, 2);
    }

    string Width(decimal porcentaje)
    {
        if (porcentaje < 0)
            porcentaje = 0;

        if (porcentaje > 100)
            porcentaje = 100;

        return porcentaje.ToString("0.##", CultureInfo.InvariantCulture) + "%";
    }

    string Barra(decimal porcentaje)
    {
        if (porcentaje >= 100)
            return "bar-success";

        if (porcentaje >= 75)
            return "bar-primary";

        if (porcentaje >= 40)
            return "bar-warning";

        return "bar-danger";
    }

    string InicialCliente(string? nombre)
    {
        if (string.IsNullOrWhiteSpace(nombre))
            return "?";

        return nombre.Trim().Substring(0, 1).ToUpperInvariant();
    }

    string EstadoData(PlaneacionPanoramaRenglonVm r)
    {
        if (r.TieneOF)
            return "conof";

        if (r.EstaProgramado)
            return "programado";

        if (r.EstaPendienteProgramar)
            return "pendiente";

        return "sinpendiente";
    }

    string EstadoClase(PlaneacionPanoramaRenglonVm r)
    {
        if (r.TieneOF)
            return "pill-success";

        if (r.EstaProgramado)
            return "pill-primary";

        if (r.EstaPendienteProgramar)
            return "pill-warning";

        return "pill-muted";
    }

    string EstadoIcono(PlaneacionPanoramaRenglonVm r)
    {
        if (r.TieneOF)
            return "fa-circle-check";

        if (r.EstaProgramado)
            return "fa-gears";

        if (r.EstaPendienteProgramar)
            return "fa-clock";

        return "fa-circle-minus";
    }

    string ClienteClase(PlaneacionPanoramaClienteVm cliente)
    {
        if (cliente.TotalSinOF > 0 && cliente.TotalCantidadPendiente > 0)
            return "client-card-warning";

        if (cliente.TotalConOF > 0)
            return "client-card-success";

        return "client-card-primary";
    }

    string PeriodoDia(DateTime? fecha)
    {
        return fecha.HasValue ? fecha.Value.ToString("yyyy-MM-dd") : "SIN_FECHA";
    }

    string PeriodoSemana(DateTime? fecha)
    {
        if (!fecha.HasValue)
            return "SIN_FECHA";

        var f = fecha.Value.Date;
        var diferencia = ((int)f.DayOfWeek + 6) % 7;
        var inicio = f.AddDays(-diferencia);
        var fin = inicio.AddDays(6);

        return inicio.ToString("yyyy-MM-dd") + "|" + fin.ToString("yyyy-MM-dd");
    }

    string PeriodoMes(DateTime? fecha)
    {
        return fecha.HasValue ? fecha.Value.ToString("yyyy-MM") : "SIN_FECHA";
    }

    string TextoDia(string key)
    {
        if (key == "SIN_FECHA")
            return "Sin fecha";

        var f = DateTime.Parse(key);
        return f.ToString("ddd dd/MM", CulturaMx);
    }

    string TextoDiaLargo(string key)
    {
        if (key == "SIN_FECHA")
            return "Sin fecha";

        var f = DateTime.Parse(key);
        return f.ToString("dddd dd MMMM yyyy", CulturaMx);
    }

    string TextoSemana(string key)
    {
        if (key == "SIN_FECHA")
            return "Sin fecha";

        var partes = key.Split('|');
        var inicio = DateTime.Parse(partes[0]);
        var fin = DateTime.Parse(partes[1]);

        return "Sem. " + ISOWeek.GetWeekOfYear(inicio) + " · " +
               inicio.ToString("dd MMM", CulturaMx) + " - " +
               fin.ToString("dd MMM", CulturaMx);
    }

    string TextoMes(string key)
    {
        if (key == "SIN_FECHA")
            return "Sin fecha";

        var f = DateTime.Parse(key + "-01");
        return f.ToString("MMMM yyyy", CulturaMx);
    }

    string IdSeguro(string prefijo, int a, int b = 0)
    {
        return $"{prefijo}_{a}_{b}";
    }

    public sealed class PeriodoGrupo
    {
        public string Key { get; set; } = "";
        public List<PlaneacionPanoramaRenglonVm> Datos { get; set; } = new List<PlaneacionPanoramaRenglonVm>();
    }

    List<PeriodoGrupo> ConstruirGruposDia(IEnumerable<PlaneacionPanoramaRenglonVm> renglones, DateTime desde, DateTime hasta)
    {
        var dic = renglones
            .GroupBy(r => PeriodoDia(r.FechaRequerida ?? r.FechaInicioProgramada))
            .ToDictionary(g => g.Key, g => g.ToList());

        var lista = new List<PeriodoGrupo>();
        var inicio = desde.Date;
        var fin = hasta.Date;

        if (fin < inicio)
            fin = inicio;

        for (var fecha = inicio; fecha <= fin; fecha = fecha.AddDays(1))
        {
            var key = PeriodoDia(fecha);

            lista.Add(new PeriodoGrupo
            {
                Key = key,
                Datos = dic.ContainsKey(key) ? dic[key] : new List<PlaneacionPanoramaRenglonVm>()
            });
        }

        if (dic.ContainsKey("SIN_FECHA"))
        {
            lista.Add(new PeriodoGrupo
            {
                Key = "SIN_FECHA",
                Datos = dic["SIN_FECHA"]
            });
        }

        return lista;
    }

    List<PeriodoGrupo> ConstruirGruposSemana(IEnumerable<PlaneacionPanoramaRenglonVm> renglones, DateTime desde, DateTime hasta)
    {
        var dic = renglones
            .GroupBy(r => PeriodoSemana(r.FechaRequerida ?? r.FechaInicioProgramada))
            .ToDictionary(g => g.Key, g => g.ToList());

        var lista = new List<PeriodoGrupo>();
        var inicio = desde.Date;
        var fin = hasta.Date;

        if (fin < inicio)
            fin = inicio;

        var diferenciaInicio = ((int)inicio.DayOfWeek + 6) % 7;
        var lunes = inicio.AddDays(-diferenciaInicio);

        var diferenciaFin = ((int)fin.DayOfWeek + 6) % 7;
        var lunesFin = fin.AddDays(-diferenciaFin);

        for (var fecha = lunes; fecha <= lunesFin; fecha = fecha.AddDays(7))
        {
            var key = PeriodoSemana(fecha);

            lista.Add(new PeriodoGrupo
            {
                Key = key,
                Datos = dic.ContainsKey(key) ? dic[key] : new List<PlaneacionPanoramaRenglonVm>()
            });
        }

        if (dic.ContainsKey("SIN_FECHA"))
        {
            lista.Add(new PeriodoGrupo
            {
                Key = "SIN_FECHA",
                Datos = dic["SIN_FECHA"]
            });
        }

        return lista;
    }

    List<PeriodoGrupo> ConstruirGruposMes(IEnumerable<PlaneacionPanoramaRenglonVm> renglones, DateTime desde, DateTime hasta)
    {
        var dic = renglones
            .GroupBy(r => PeriodoMes(r.FechaRequerida ?? r.FechaInicioProgramada))
            .ToDictionary(g => g.Key, g => g.ToList());

        var lista = new List<PeriodoGrupo>();
        var inicio = new DateTime(desde.Year, desde.Month, 1);
        var fin = new DateTime(hasta.Year, hasta.Month, 1);

        if (fin < inicio)
            fin = inicio;

        for (var fecha = inicio; fecha <= fin; fecha = fecha.AddMonths(1))
        {
            var key = PeriodoMes(fecha);

            lista.Add(new PeriodoGrupo
            {
                Key = key,
                Datos = dic.ContainsKey(key) ? dic[key] : new List<PlaneacionPanoramaRenglonVm>()
            });
        }

        if (dic.ContainsKey("SIN_FECHA"))
        {
            lista.Add(new PeriodoGrupo
            {
                Key = "SIN_FECHA",
                Datos = dic["SIN_FECHA"]
            });
        }

        return lista;
    }


    DateTime InicioSemanaDesdeKey(string key)
    {
        if (key == "SIN_FECHA")
            return DateTime.Today;

        var partes = key.Split('|');
        return DateTime.Parse(partes[0]);
    }

    DateTime FinSemanaDesdeKey(string key)
    {
        if (key == "SIN_FECHA")
            return DateTime.Today;

        var partes = key.Split('|');
        return DateTime.Parse(partes[1]);
    }

    DateTime InicioMesDesdeKey(string key)
    {
        if (key == "SIN_FECHA")
            return new DateTime(DateTime.Today.Year, DateTime.Today.Month, 1);

        return DateTime.Parse(key + "-01");
    }

    DateTime FinMesDesdeKey(string key)
    {
        var inicio = InicioMesDesdeKey(key);
        return inicio.AddMonths(1).AddDays(-1);
    }

    int SumaRequerido(PeriodoGrupo g) => g.Datos.Sum(x => x.CantidadRequerida);
    int SumaPT(PeriodoGrupo g) => g.Datos.Sum(x => x.PiezasDesdePT);
    int SumaProgramado(PeriodoGrupo g) => g.Datos.Sum(x => x.CantidadProgramada);
    int SumaProducido(PeriodoGrupo g) => g.Datos.Sum(x => x.CantidadProducida);
    int SumaPendiente(PeriodoGrupo g) => g.Datos.Sum(x => x.CantidadPendiente);
    decimal SumaMp(PeriodoGrupo g) => g.Datos.Sum(x => x.CantidadMpKg ?? 0);
    decimal SumaEmbalajes(PeriodoGrupo g) => g.Datos.Sum(x => x.CantidadEmbalajes ?? 0);

    int MaxCantidad(IEnumerable<PeriodoGrupo> grupos)
    {
        var lista = grupos.ToList();

        if (!lista.Any())
            return 1;

        var max = lista
            .Select(g => new[]
            {
                SumaRequerido(g),
                SumaPT(g),
                SumaProgramado(g),
                SumaProducido(g),
                SumaPendiente(g)
            }.Max())
            .DefaultIfEmpty(1)
            .Max();

        return Math.Max(1, max);
    }

    decimal MaxDecimal(IEnumerable<PeriodoGrupo> grupos)
    {
        var max = grupos
            .Select(SumaMp)
            .DefaultIfEmpty(1m)
            .Max();

        return Math.Max(1m, max);
    }

    string SearchCliente(PlaneacionPanoramaClienteVm cliente)
    {
        return (
            cliente.ClienteNombre + " " +
            string.Join(" ", cliente.Partes.Select(p =>
                (p.NumeroParte ?? "") + " " +
                (p.ReferenciaSAP ?? "") + " " +
                (p.DesignacionDescripcionSAP ?? "") + " " +
                (p.MaquinaCodigo ?? "") + " " +
                (p.MoldeCodigo ?? "") + " " +
                (p.MaterialCodigo ?? "") + " " +
                (p.MaterialDescripcion ?? "")
            ))
        ).ToLowerInvariant();
    }
}


@* PLANEACION_NAVBAR_INJECT_V1_0 *@
    @await Html.PartialAsync("_PlaneacionNavbar")
    <div class="page">

        <section class="hero">
            <div class="d-flex justify-content-between align-items-start gap-3 flex-wrap">
                <div>
                    <div class="hero-badge">
                        <i class="fa-solid fa-chart-line"></i>
                        Panorama ejecutivo de planeación
                    </div>

                    <h1>
                        Panorama de Planeación
                    </h1>

                    <p>
                        Vista tipo Excel mejorada: clientes, piezas y carga por periodo con ceros visibles, barras comparativas,
                        estatus de programación y acciones directas hacia Cambio de Molde u OF.
                    </p>

                    <div class="chip-row mt-3">
                        <span class="pill pill-primary">
                            <i class="fa-solid fa-calendar-days"></i>
                            @PlaneacionPanoramaVista.Nombre(Model.Vista)
                        </span>

                        <span class="pill pill-success">
                            @Model.FechaDesde.ToString("dd/MM/yyyy") - @Model.FechaHasta.ToString("dd/MM/yyyy")
                        </span>

                        <span class="pill pill-warning">
                            @Entero(Model.TotalCantidadPendiente) pendientes
                        </span>
                    </div>
                </div>

                <div class="d-flex gap-2 flex-wrap">
                    <a asp-controller="PlaneacionPrograma"
                       asp-action="Index"
                       class="btn-glass">
                        <i class="fa-solid fa-arrow-left me-1"></i>
                        Programa de Planeación
                    </a>

                    <a asp-controller="PlaneacionPrograma"
                       asp-action="Maquinas"
                       class="btn-glass">
                        <i class="fa-solid fa-table-columns me-1"></i>
                        Máquinas
                    </a>
                </div>
            </div>
