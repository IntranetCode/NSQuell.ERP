@model ERP.NSQuell.Models.PlaneacionPanoramaVm
@using ERP.NSQuell.Models
@using System.Globalization
@using System.Collections.Generic
@using System.Linq

@{
    Layout = null;
    var cultura = new CultureInfo("es-MX");
}

@functions {
    static readonly CultureInfo CulturaMx = new CultureInfo("es-MX");

    string Valor(string? v) => string.IsNullOrWhiteSpace(v) ? "-" : v;
    string Fecha(DateTime? f) => f.HasValue ? f.Value.ToString("dd/MM/yyyy") : "-";
    string FechaHora(DateTime? f) => f.HasValue ? f.Value.ToString("dd/MM/yyyy HH:mm") : "-";
    string Entero(int v) => v.ToString("N0");
    string EnteroNullable(int? v) => v.HasValue ? v.Value.ToString("N0") : "0";
    string Decimal2(decimal? v) => v.HasValue ? v.Value.ToString("N2") : "0.00";
    string Decimal2NoNull(decimal v) => v.ToString("N2");

    decimal Porcentaje(int valor, int total)
    {
        if (total <= 0)
            return 0;

        return Math.Round(((decimal)valor / total) * 100, 2);
    }

    decimal PorcentajeDecimal(decimal valor, decimal total)
    {
        if (total <= 0)
            return 0;

        return Math.Round((valor / total) * 100, 2);
    }

    string Width(decimal porcentaje)
    {
        if (porcentaje < 0)
            porcentaje = 0;

        if (porcentaje > 100)
            porcentaje = 100;

        return porcentaje.ToString("0.##", CultureInfo.InvariantCulture) + "%";
    }

    string Barra(decimal porcentaje)
    {
        if (porcentaje >= 100)
            return "bar-success";

        if (porcentaje >= 75)
            return "bar-primary";

        if (porcentaje >= 40)
            return "bar-warning";

        return "bar-danger";
    }

    string InicialCliente(string? nombre)
    {
        if (string.IsNullOrWhiteSpace(nombre))
            return "?";

        return nombre.Trim().Substring(0, 1).ToUpperInvariant();
    }

    string EstadoData(PlaneacionPanoramaRenglonVm r)
    {
        if (r.TieneOF)
            return "conof";

        if (r.EstaProgramado)
            return "programado";

        if (r.EstaPendienteProgramar)
            return "pendiente";

        return "sinpendiente";
    }

    string EstadoClase(PlaneacionPanoramaRenglonVm r)
    {
        if (r.TieneOF)
            return "pill-success";

        if (r.EstaProgramado)
            return "pill-primary";

        if (r.EstaPendienteProgramar)
            return "pill-warning";

        return "pill-muted";
    }

    string EstadoIcono(PlaneacionPanoramaRenglonVm r)
    {
        if (r.TieneOF)
            return "fa-circle-check";

        if (r.EstaProgramado)
            return "fa-gears";

        if (r.EstaPendienteProgramar)
            return "fa-clock";

        return "fa-circle-minus";
    }

    string ClienteClase(PlaneacionPanoramaClienteVm cliente)
    {
        if (cliente.TotalSinOF > 0 && cliente.TotalCantidadPendiente > 0)
            return "client-card-warning";

        if (cliente.TotalConOF > 0)
            return "client-card-success";

        return "client-card-primary";
    }

    string PeriodoDia(DateTime? fecha)
    {
        return fecha.HasValue ? fecha.Value.ToString("yyyy-MM-dd") : "SIN_FECHA";
    }

    string PeriodoSemana(DateTime? fecha)
    {
        if (!fecha.HasValue)
            return "SIN_FECHA";

        var f = fecha.Value.Date;
        var diferencia = ((int)f.DayOfWeek + 6) % 7;
        var inicio = f.AddDays(-diferencia);
        var fin = inicio.AddDays(6);

        return inicio.ToString("yyyy-MM-dd") + "|" + fin.ToString("yyyy-MM-dd");
    }

    string PeriodoMes(DateTime? fecha)
    {
        return fecha.HasValue ? fecha.Value.ToString("yyyy-MM") : "SIN_FECHA";
    }

    string TextoDia(string key)
    {
        if (key == "SIN_FECHA")
            return "Sin fecha";

        var f = DateTime.Parse(key);
        return f.ToString("ddd dd/MM", CulturaMx);
    }

    string TextoDiaLargo(string key)
    {
        if (key == "SIN_FECHA")
            return "Sin fecha";

        var f = DateTime.Parse(key);
        return f.ToString("dddd dd MMMM yyyy", CulturaMx);
    }

    string TextoSemana(string key)
    {
        if (key == "SIN_FECHA")
            return "Sin fecha";

        var partes = key.Split('|');
        var inicio = DateTime.Parse(partes[0]);
        var fin = DateTime.Parse(partes[1]);

        return "Sem. " + ISOWeek.GetWeekOfYear(inicio) + " · " +
               inicio.ToString("dd MMM", CulturaMx) + " - " +
               fin.ToString("dd MMM", CulturaMx);
    }

    string TextoMes(string key)
    {
        if (key == "SIN_FECHA")
            return "Sin fecha";

        var f = DateTime.Parse(key + "-01");
        return f.ToString("MMMM yyyy", CulturaMx);
    }

    string IdSeguro(string prefijo, int a, int b = 0)
    {
        return $"{prefijo}_{a}_{b}";
    }

    public sealed class PeriodoGrupo
    {
        public string Key { get; set; } = "";
        public List<PlaneacionPanoramaRenglonVm> Datos { get; set; } = new List<PlaneacionPanoramaRenglonVm>();
    }

    List<PeriodoGrupo> ConstruirGruposDia(IEnumerable<PlaneacionPanoramaRenglonVm> renglones, DateTime desde, DateTime hasta)
    {
        var dic = renglones
            .GroupBy(r => PeriodoDia(r.FechaRequerida ?? r.FechaInicioProgramada))
            .ToDictionary(g => g.Key, g => g.ToList());

        var lista = new List<PeriodoGrupo>();
        var inicio = desde.Date;
        var fin = hasta.Date;

        if (fin < inicio)
            fin = inicio;

        for (var fecha = inicio; fecha <= fin; fecha = fecha.AddDays(1))
        {
            var key = PeriodoDia(fecha);

            lista.Add(new PeriodoGrupo
            {
                Key = key,
                Datos = dic.ContainsKey(key) ? dic[key] : new List<PlaneacionPanoramaRenglonVm>()
            });
        }

        if (dic.ContainsKey("SIN_FECHA"))
        {
            lista.Add(new PeriodoGrupo
            {
                Key = "SIN_FECHA",
                Datos = dic["SIN_FECHA"]
            });
        }

        return lista;
    }

    List<PeriodoGrupo> ConstruirGruposSemana(IEnumerable<PlaneacionPanoramaRenglonVm> renglones, DateTime desde, DateTime hasta)
    {
        var dic = renglones
            .GroupBy(r => PeriodoSemana(r.FechaRequerida ?? r.FechaInicioProgramada))
            .ToDictionary(g => g.Key, g => g.ToList());

        var lista = new List<PeriodoGrupo>();
        var inicio = desde.Date;
        var fin = hasta.Date;

        if (fin < inicio)
            fin = inicio;

        var diferenciaInicio = ((int)inicio.DayOfWeek + 6) % 7;
        var lunes = inicio.AddDays(-diferenciaInicio);

        var diferenciaFin = ((int)fin.DayOfWeek + 6) % 7;
        var lunesFin = fin.AddDays(-diferenciaFin);

        for (var fecha = lunes; fecha <= lunesFin; fecha = fecha.AddDays(7))
        {
            var key = PeriodoSemana(fecha);

            lista.Add(new PeriodoGrupo
            {
                Key = key,
                Datos = dic.ContainsKey(key) ? dic[key] : new List<PlaneacionPanoramaRenglonVm>()
            });
        }

        if (dic.ContainsKey("SIN_FECHA"))
        {
            lista.Add(new PeriodoGrupo
            {
                Key = "SIN_FECHA",
                Datos = dic["SIN_FECHA"]
            });
        }

        return lista;
    }

    List<PeriodoGrupo> ConstruirGruposMes(IEnumerable<PlaneacionPanoramaRenglonVm> renglones, DateTime desde, DateTime hasta)
    {
        var dic = renglones
            .GroupBy(r => PeriodoMes(r.FechaRequerida ?? r.FechaInicioProgramada))
            .ToDictionary(g => g.Key, g => g.ToList());

        var lista = new List<PeriodoGrupo>();
        var inicio = new DateTime(desde.Year, desde.Month, 1);
        var fin = new DateTime(hasta.Year, hasta.Month, 1);

        if (fin < inicio)
            fin = inicio;

        for (var fecha = inicio; fecha <= fin; fecha = fecha.AddMonths(1))
        {
            var key = PeriodoMes(fecha);

            lista.Add(new PeriodoGrupo
            {
                Key = key,
                Datos = dic.ContainsKey(key) ? dic[key] : new List<PlaneacionPanoramaRenglonVm>()
            });
        }

        if (dic.ContainsKey("SIN_FECHA"))
        {
            lista.Add(new PeriodoGrupo
            {
                Key = "SIN_FECHA",
                Datos = dic["SIN_FECHA"]
            });
        }

        return lista;
    }


    DateTime InicioSemanaDesdeKey(string key)
    {
        if (key == "SIN_FECHA")
            return DateTime.Today;

        var partes = key.Split('|');
        return DateTime.Parse(partes[0]);
    }

    DateTime FinSemanaDesdeKey(string key)
    {
        if (key == "SIN_FECHA")
            return DateTime.Today;

        var partes = key.Split('|');
        return DateTime.Parse(partes[1]);
    }

    DateTime InicioMesDesdeKey(string key)
    {
        if (key == "SIN_FECHA")
            return new DateTime(DateTime.Today.Year, DateTime.Today.Month, 1);

        return DateTime.Parse(key + "-01");
    }

    DateTime FinMesDesdeKey(string key)
    {
        var inicio = InicioMesDesdeKey(key);
        return inicio.AddMonths(1).AddDays(-1);
    }

    int SumaRequerido(PeriodoGrupo g) => g.Datos.Sum(x => x.CantidadRequerida);
    int SumaPT(PeriodoGrupo g) => g.Datos.Sum(x => x.PiezasDesdePT);
    int SumaProgramado(PeriodoGrupo g) => g.Datos.Sum(x => x.CantidadProgramada);
    int SumaProducido(PeriodoGrupo g) => g.Datos.Sum(x => x.CantidadProducida);
    int SumaPendiente(PeriodoGrupo g) => g.Datos.Sum(x => x.CantidadPendiente);
    decimal SumaMp(PeriodoGrupo g) => g.Datos.Sum(x => x.CantidadMpKg ?? 0);
    decimal SumaEmbalajes(PeriodoGrupo g) => g.Datos.Sum(x => x.CantidadEmbalajes ?? 0);

    int MaxCantidad(IEnumerable<PeriodoGrupo> grupos)
    {
        var lista = grupos.ToList();

        if (!lista.Any())
            return 1;

        var max = lista
            .Select(g => new[]
            {
                SumaRequerido(g),
                SumaPT(g),
                SumaProgramado(g),
                SumaProducido(g),
                SumaPendiente(g)
            }.Max())
            .DefaultIfEmpty(1)
            .Max();

        return Math.Max(1, max);
    }

    decimal MaxDecimal(IEnumerable<PeriodoGrupo> grupos)
    {
        var max = grupos
            .Select(SumaMp)
            .DefaultIfEmpty(1m)
            .Max();

        return Math.Max(1m, max);
    }

    string SearchCliente(PlaneacionPanoramaClienteVm cliente)
    {
        return (
            cliente.ClienteNombre + " " +
            string.Join(" ", cliente.Partes.Select(p =>
                (p.NumeroParte ?? "") + " " +
                (p.ReferenciaSAP ?? "") + " " +
                (p.DesignacionDescripcionSAP ?? "") + " " +
                (p.MaquinaCodigo ?? "") + " " +
                (p.MoldeCodigo ?? "") + " " +
                (p.MaterialCodigo ?? "") + " " +
                (p.MaterialDescripcion ?? "")
            ))
        ).ToLowerInvariant();
    }
}

<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <title>Panorama de Planeación | ERP Quell</title>
    <meta name="viewport" content="width=device-width, initial-scale=1" />

    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.2/css/all.min.css" rel="stylesheet">

    <style>
        :root {
            --blue: #004AAD;
            --blue-dark: #063875;
            --blue-soft: #EEF6FF;
            --green: #10804C;
            --green-soft: #ECFDF3;
            --orange: #F79009;
            --orange-soft: #FFF7ED;
            --yellow: #F7B500;
            --yellow-soft: #FFF7DF;
            --red: #B42318;
            --red-soft: #FEF3F2;
            --purple: #7F56D9;
            --purple-soft: #F4EBFF;
            --gray-bg: #F4F7FB;
            --border: #D9E2EE;
            --text: #1F2937;
            --muted: #667085;
            --shadow: 0 18px 45px rgba(16, 24, 40, .10);
            --shadow-soft: 0 10px 28px rgba(16, 24, 40, .06);
        }

        * {
            box-sizing: border-box;
        }

        body {
            margin: 0;
            background: radial-gradient(circle at top left, rgba(0, 74, 173, .13), transparent 28%), radial-gradient(circle at 88% 12%, rgba(16, 128, 76, .10), transparent 30%), linear-gradient(180deg, #F7FAFF 0%, #EEF3F9 100%);
            color: var(--text);
            font-family: "Segoe UI", Arial, sans-serif;
        }

        .page {
            max-width: 1880px;
            margin: 0 auto;
            padding: 28px;
        }

        .hero {
            background: linear-gradient(135deg, rgba(0,74,173,.99), rgba(6,56,117,.98)), url("data:image/svg+xml,%3Csvg width='1000' height='360' xmlns='http://www.w3.org/2000/svg'%3E%3Cg fill='none' stroke='rgba(255,255,255,.14)' stroke-width='2'%3E%3Cpath d='M0 250 C180 100 260 300 430 130 S700 80 1000 190'/%3E%3Cpath d='M0 80 C200 190 260 20 480 100 S650 260 1000 120'/%3E%3C/g%3E%3Cg fill='rgba(255,255,255,.08)'%3E%3Ccircle cx='860' cy='75' r='110'/%3E%3Ccircle cx='930' cy='210' r='58'/%3E%3C/g%3E%3C/svg%3E");
            background-size: cover;
            border-radius: 34px;
            padding: 32px;
            color: white;
            margin-bottom: 22px;
            box-shadow: 0 24px 60px rgba(0, 74, 173, .28);
            position: relative;
            overflow: hidden;
        }

            .hero h1 {
                font-size: 2.08rem;
                font-weight: 950;
                margin: 0;
            }

            .hero p {
                color: rgba(255,255,255,.88);
                margin-top: 8px;
                max-width: 980px;
            }

        .hero-badge {
            display: inline-flex;
            align-items: center;
            gap: 8px;
            border: 1px solid rgba(255,255,255,.35);
            background: rgba(255,255,255,.13);
            border-radius: 999px;
            padding: 7px 12px;
            font-size: .74rem;
            font-weight: 950;
            letter-spacing: .05em;
            text-transform: uppercase;
            margin-bottom: 14px;
        }

        .btn-glass,
        .btn-primary-soft,
        .btn-white-soft {
            border-radius: 15px;
            padding: 10px 15px;
            font-weight: 900;
            text-decoration: none;
            display: inline-flex;
            align-items: center;
            justify-content: center;
            gap: 7px;
        }

        .btn-glass {
            border: 1px solid rgba(255,255,255,.35);
            background: rgba(255,255,255,.14);
            color: white;
            backdrop-filter: blur(10px);
        }

            .btn-glass:hover {
                background: white;
                color: var(--blue);
            }

        .btn-primary-soft {
            background: var(--blue);
            border: 1px solid var(--blue);
            color: white;
        }

            .btn-primary-soft:hover {
                background: var(--blue-dark);
                color: white;
            }

        .btn-white-soft {
            background: white;
            border: 1px solid var(--border);
            color: var(--blue-dark);
        }

            .btn-white-soft:hover {
                background: var(--blue-soft);
                color: var(--blue);
            }

        .panel {
            background: rgba(255,255,255,.92);
            backdrop-filter: blur(12px);
            border: 1px solid var(--border);
            border-radius: 28px;
            box-shadow: var(--shadow-soft);
            margin-bottom: 22px;
            overflow: hidden;
        }

        .panel-header {
            padding: 18px 22px;
            border-bottom: 1px solid var(--border);
            display: flex;
            justify-content: space-between;
            align-items: center;
            gap: 14px;
            flex-wrap: wrap;
        }

        .panel-body {
            padding: 22px;
        }

        .input-modern {
            border-radius: 15px;
            border: 1px solid var(--border);
            padding: 11px 13px;
            box-shadow: none;
        }

        .chip-row {
            display: flex;
            flex-wrap: wrap;
            gap: 9px;
        }

        .chip {
            border: 1px solid var(--border);
            background: white;
            color: var(--blue-dark);
            border-radius: 999px;
            padding: 9px 14px;
            font-weight: 900;
            font-size: .84rem;
            cursor: pointer;
            text-decoration: none;
            display: inline-flex;
            align-items: center;
            gap: 7px;
        }

            .chip:hover,
            .chip.active {
                background: var(--blue);
                border-color: var(--blue);
                color: white;
            }

        .kpi {
            background: white;
            border: 1px solid var(--border);
            border-radius: 24px;
            box-shadow: var(--shadow-soft);
            padding: 18px;
            height: 100%;
            position: relative;
            overflow: hidden;
        }

            .kpi::before {
                content: "";
                width: 8px;
                position: absolute;
                left: 0;
                top: 0;
                bottom: 0;
                background: var(--blue);
            }

        .kpi-icon {
            width: 44px;
            height: 44px;
            border-radius: 16px;
            background: var(--blue-soft);
            color: var(--blue);
            display: inline-flex;
            align-items: center;
            justify-content: center;
            margin-bottom: 10px;
        }

        .kpi-label {
            color: var(--muted);
            text-transform: uppercase;
            font-size: .72rem;
            letter-spacing: .05em;
            font-weight: 950;
        }

        .kpi-value {
            font-size: 1.55rem;
            line-height: 1.1;
            font-weight: 950;
            color: var(--blue-dark);
        }

        .kpi-sub {
            color: var(--muted);
            font-size: .8rem;
            margin-top: 4px;
            font-weight: 650;
        }

        .client-grid {
            display: grid;
            grid-template-columns: repeat(auto-fill, minmax(350px, 1fr));
            gap: 20px;
        }

        .client-card {
            background: white;
            border: 1px solid var(--border);
            border-radius: 30px;
            box-shadow: var(--shadow-soft);
            padding: 22px;
            min-height: 350px;
            display: flex;
            flex-direction: column;
            justify-content: space-between;
            transition: .18s ease;
            position: relative;
            overflow: hidden;
        }

            .client-card:hover {
                transform: translateY(-4px);
                box-shadow: var(--shadow);
            }

            .client-card::after {
                content: "";
                position: absolute;
                right: -75px;
                top: -90px;
                width: 230px;
                height: 230px;
