            border: 1px solid transparent;
            white-space: nowrap;
        }

        .pill-success {
            background: var(--green-soft);
            color: var(--green);
            border-color: #ABEFC6;
        }

        .pill-primary {
            background: var(--blue-soft);
            color: var(--blue);
            border-color: #B2DDFF;
        }

        .pill-warning {
            background: var(--orange-soft);
            color: #B54708;
            border-color: #FED7AA;
        }

        .pill-danger {
            background: var(--red-soft);
            color: var(--red);
            border-color: #FECDCA;
        }

        .pill-purple {
            background: var(--purple-soft);
            color: var(--purple);
            border-color: #D6BBFB;
        }

        .pill-muted {
            background: #F2F4F7;
            color: #475467;
            border-color: #D0D5DD;
        }

        .modal-fullscreen .modal-content {
            border: none;
            background: #F4F7FB;
        }

        .modal-header-custom {
            background: linear-gradient(135deg, var(--blue), var(--blue-dark));
            color: white;
            padding: 26px 32px;
            border-bottom: none;
        }

        .modal-title-custom {
            font-weight: 950;
            font-size: 1.55rem;
            margin: 0;
        }

        .modal-sub-custom {
            color: rgba(255,255,255,.82);
            font-size: .92rem;
            margin-top: 6px;
        }

        .modal-body-custom {
            padding: 24px 32px 32px;
        }

        .modal-kpis {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(170px, 1fr));
            gap: 14px;
            margin-bottom: 22px;
        }

        .modal-kpi {
            background: white;
            border: 1px solid var(--border);
            border-radius: 22px;
            padding: 16px;
            box-shadow: var(--shadow-soft);
        }

        .piece-list {
            display: grid;
            grid-template-columns: 380px minmax(0, 1fr);
            gap: 22px;
            align-items: start;
        }

        .piece-sidebar {
            position: sticky;
            top: 20px;
            display: grid;
            gap: 12px;
            max-height: calc(100vh - 230px);
            overflow: auto;
            padding-right: 4px;
        }

        .piece-tab {
            background: white;
            border: 1px solid var(--border);
            border-radius: 22px;
            padding: 15px;
            text-align: left;
            cursor: pointer;
            box-shadow: var(--shadow-soft);
            transition: .16s ease;
        }

            .piece-tab:hover,
            .piece-tab.active {
                border-color: rgba(0,74,173,.45);
                background: #F7FBFF;
                transform: translateY(-2px);
            }

        .piece-tab-title {
            color: var(--text);
            font-size: .98rem;
            font-weight: 950;
            line-height: 1.2;
        }

        .piece-tab-desc {
            color: var(--muted);
            font-size: .79rem;
            margin-top: 5px;
            font-weight: 650;
        }

        .piece-tab-footer {
            display: flex;
            flex-wrap: wrap;
            gap: 7px;
            margin-top: 12px;
        }

        .piece-detail {
            display: none;
        }

            .piece-detail.active {
                display: block;
            }

        .piece-stage {
            background: white;
            border: 1px solid var(--border);
            border-radius: 30px;
            box-shadow: var(--shadow);
            overflow: hidden;
        }

        .piece-stage-header {
            padding: 24px;
            background: linear-gradient(135deg, #FFFFFF, #F6FAFF);
            border-bottom: 1px solid var(--border);
        }

        .piece-stage-title {
            color: var(--blue-dark);
            font-size: 1.35rem;
            font-weight: 950;
            margin: 0;
        }

        .piece-stage-desc {
            color: var(--muted);
            font-size: .9rem;
            margin-top: 6px;
            font-weight: 650;
        }

        .tech-row {
            display: flex;
            gap: 9px;
            flex-wrap: wrap;
            margin-top: 14px;
        }

        .piece-stage-body {
            padding: 24px;
        }

        .mode-switch {
            display: inline-flex;
            flex-wrap: wrap;
            gap: 8px;
            padding: 8px;
            background: #F3F7FC;
            border: 1px solid var(--border);
            border-radius: 18px;
        }

        .mode-btn {
            border: 1px solid transparent;
            background: white;
            color: var(--blue-dark);
            border-radius: 13px;
            padding: 9px 14px;
            font-size: .84rem;
            font-weight: 950;
            cursor: pointer;
        }

            .mode-btn:hover,
            .mode-btn.active {
                background: var(--blue);
                color: white;
            }

        .timeline-view {
            display: none;
            margin-top: 20px;
        }

            .timeline-view.active {
                display: block;
            }

        .excel-board {
            border: 1px solid var(--border);
            border-radius: 26px;
            overflow: hidden;
            background: white;
            box-shadow: var(--shadow-soft);
        }

        .excel-board-top {
            padding: 16px 18px;
            border-bottom: 1px solid var(--border);
            background: linear-gradient(135deg, #FFFFFF, #F7FBFF);
            display: flex;
            align-items: center;
            justify-content: space-between;
            gap: 14px;
            flex-wrap: wrap;
        }

        .excel-board-title {
            color: var(--blue-dark);
            font-weight: 950;
            margin: 0;
            font-size: 1rem;
        }

        .excel-board-sub {
            color: var(--muted);
            font-size: .82rem;
            font-weight: 700;
            margin-top: 3px;
        }

        .excel-scroll {
            overflow: auto;
            max-height: calc(100vh - 380px);
            background: linear-gradient(90deg, rgba(0,74,173,.06), transparent 22px) left top / 22px 100% no-repeat, white;
        }

        .planning-grid {
            display: grid;
            min-width: max-content;
        }

        .grid-cell {
            min-width: 162px;
            min-height: 74px;
            border-right: 1px solid #E7EEF8;
            border-bottom: 1px solid #E7EEF8;
            padding: 10px;
            background: #fff;
            position: relative;
        }

            .grid-cell:nth-child(even) {
                background: #FCFDFF;
            }

        .grid-sticky {
            position: sticky;
            left: 0;
            z-index: 4;
            min-width: 185px;
            background: #F8FBFF;
            color: var(--blue-dark);
            font-weight: 950;
            box-shadow: 5px 0 14px rgba(16,24,40,.05);
        }

        .grid-header {
            position: sticky;
            top: 0;
            z-index: 5;
            min-height: 74px;
            background: linear-gradient(180deg, #F8FBFF, #FFFFFF);
            color: var(--blue-dark);
            font-weight: 950;
        }

        .grid-corner {
            z-index: 8;
            background: linear-gradient(135deg, var(--blue), var(--blue-dark));
            color: white;
        }

        .period-name {
            font-weight: 950;
            font-size: .84rem;
            text-transform: capitalize;
        }

        .period-count {
            color: var(--muted);
            font-size: .72rem;
            font-weight: 800;
            margin-top: 4px;
        }

        .row-label-main {
            font-size: .82rem;
            text-transform: uppercase;
            letter-spacing: .04em;
        }

        .row-label-sub {
            color: var(--muted);
            font-size: .72rem;
            font-weight: 750;
            margin-top: 3px;
        }

        .cell-value {
            font-size: 1rem;
            font-weight: 950;
            color: var(--text);
            display: flex;
            justify-content: space-between;
            gap: 8px;
            align-items: baseline;
        }

            .cell-value small {
                color: var(--muted);
                font-size: .68rem;
                font-weight: 850;
            }

        .cell-bar {
            height: 10px;
            background: #EEF2F7;
            border-radius: 999px;
            overflow: hidden;
            margin-top: 10px;
        }

        .cell-fill {
            height: 100%;
            border-radius: 999px;
            min-width: 7px;
        }

            .cell-fill.zero {
                min-width: 0;
                width: 0 !important;
            }

        .fill-pedido {
            background: linear-gradient(90deg, #2E90FA, #004AAD);
        }

        .fill-pt {
            background: linear-gradient(90deg, #12B76A, #10804C);
        }

        .fill-programado {
            background: linear-gradient(90deg, #7F56D9, #5925DC);
        }

        .fill-producido {
            background: linear-gradient(90deg, #17B26A, #067647);
        }

        .fill-pendiente {
            background: linear-gradient(90deg, #FDB022, #DC6803);
        }

        .fill-mp {
            background: linear-gradient(90deg, #667085, #344054);
        }

        .action-cell {
            min-height: 98px;
        }

        .action-stack {
            display: flex;
            flex-direction: column;
            gap: 7px;
        }

        .movement {
            border: 1px solid var(--border);
            background: #FBFDFF;
            border-radius: 14px;
            padding: 8px 10px;
            font-size: .76rem;
            font-weight: 850;
            color: #344054;
        }

        .empty-action {
            color: var(--muted);
            font-size: .76rem;
            font-weight: 850;
        }

        .empty-state {
            background: white;
            border: 1px dashed var(--border);
            border-radius: 30px;
            box-shadow: var(--shadow-soft);
            padding: 54px 20px;
            text-align: center;
            color: var(--muted);
        }

        .hidden-by-filter {
            display: none !important;
        }

        .sticky-footer-actions {
            position: sticky;
            bottom: 18px;
            z-index: 20;
            margin-top: 24px;
            background: rgba(255,255,255,.92);
            backdrop-filter: blur(14px);
            border: 1px solid var(--border);
            border-radius: 22px;
            padding: 12px;
            box-shadow: var(--shadow);
        }


        .period-drill {
            margin-top: 14px;
            border: 1px solid var(--border);
            border-radius: 22px;
            background: #FFFFFF;
            overflow: hidden;
            box-shadow: var(--shadow-soft);
        }

        .period-drill-head {
            padding: 14px 16px;
            background: linear-gradient(135deg, #F8FBFF, #FFFFFF);
            border-bottom: 1px solid var(--border);
            display: flex;
            justify-content: space-between;
            gap: 12px;
            align-items: center;
            flex-wrap: wrap;
        }

        .period-drill-title {
            color: var(--blue-dark);
            font-weight: 950;
            font-size: .95rem;
        }

        .period-drill-sub {
            color: var(--muted);
            font-size: .78rem;
            font-weight: 800;
            margin-top: 2px;
        }

        .mini-period-strip {
            overflow-x: auto;
            padding: 14px;
            background: #FBFDFF;
        }

        .mini-period-grid {
            display: grid;
            gap: 10px;
            min-width: max-content;
        }

        .mini-period-card {
            width: 210px;
            border: 1px solid #E4EBF5;
            background: white;
            border-radius: 18px;
            padding: 12px;
        }

        .mini-period-title {
            color: var(--blue-dark);
            font-size: .82rem;
            font-weight: 950;
            text-transform: capitalize;
            min-height: 34px;
        }

        .mini-period-value {
            margin-top: 10px;
            display: grid;
            gap: 7px;
            color: var(--text);
            font-size: .76rem;
            font-weight: 850;
        }

        .mini-line {
            display: flex;
            justify-content: space-between;
            gap: 8px;
            border-bottom: 1px dashed #E4EBF5;
            padding-bottom: 5px;
        }

            .mini-line:last-child {
                border-bottom: none;
                padding-bottom: 0;
            }

            .mini-line span:first-child {
                color: var(--muted);
            }

        .month-board {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(260px, 1fr));
            gap: 14px;
        }

        .month-card {
            border: 1px solid var(--border);
            background: white;
            border-radius: 22px;
            box-shadow: var(--shadow-soft);
            overflow: hidden;
        }

        .month-card-head {
            padding: 15px;
            background: linear-gradient(135deg, #F8FBFF, #FFFFFF);
            border-bottom: 1px solid var(--border);
        }

        .month-card-title {
            color: var(--blue-dark);
            font-weight: 950;
            text-transform: capitalize;
        }

        .month-card-body {
            padding: 14px;
        }


        @@media (max-width: 1100px) {
            .piece-list {
                grid-template-columns: 1fr;
            }

            .piece-sidebar {
                position: static;
                max-height: none;
                grid-template-columns: repeat(auto-fit, minmax(260px, 1fr));
            }
        }

        @@media (max-width: 768px) {
            .page {
                padding: 16px;
            }

            .hero {
                padding: 24px;
            }

                .hero h1 {
                    font-size: 1.55rem;
                }

            .client-grid {
                grid-template-columns: 1fr;
            }

            .mini-grid {
                grid-template-columns: 1fr 1fr;
            }

            .modal-body-custom {
                padding: 18px;
            }

            .modal-header-custom {
                padding: 22px;
            }

            .grid-cell {
                min-width: 142px;
            }

            .grid-sticky {
                min-width: 160px;
            }
        }
    </style>
</head>

<body>
    <div class="page">

        <section class="hero">
            <div class="d-flex justify-content-between align-items-start gap-3 flex-wrap">
                <div>
                    <div class="hero-badge">
                        <i class="fa-solid fa-chart-line"></i>
                        Panorama ejecutivo de planeación
                    </div>

                    <h1>
                        Panorama de Planeación
                    </h1>

                    <p>
                        Vista tipo Excel mejorada: clientes, piezas y carga por periodo con ceros visibles, barras comparativas,
                        estatus de programación y acciones directas hacia Cambio de Molde u OF.
                    </p>

                    <div class="chip-row mt-3">
                        <span class="pill pill-primary">
                            <i class="fa-solid fa-calendar-days"></i>
                            @PlaneacionPanoramaVista.Nombre(Model.Vista)
                        </span>

                        <span class="pill pill-success">
                            @Model.FechaDesde.ToString("dd/MM/yyyy") - @Model.FechaHasta.ToString("dd/MM/yyyy")
                        </span>

                        <span class="pill pill-warning">
                            @Entero(Model.TotalCantidadPendiente) pendientes
                        </span>
                    </div>
                </div>

                <div class="d-flex gap-2 flex-wrap">
                    <a asp-controller="PlaneacionPrograma"
                       asp-action="Index"
                       class="btn-glass">
                        <i class="fa-solid fa-arrow-left me-1"></i>
                        Programa de Planeación
                    </a>

                    <a asp-controller="PlaneacionPrograma"
                       asp-action="Maquinas"
                       class="btn-glass">
                        <i class="fa-solid fa-table-columns me-1"></i>
                        Máquinas
                    </a>
                </div>
            </div>
        </section>

        <section class="panel">
            <div class="panel-header">
                <div>
                    <h2 class="h5 fw-bold text-primary m-0">
                        <i class="fa-solid fa-sliders me-2"></i>
                        Filtros
                    </h2>
                    <div class="text-muted small">
                        Filtra por periodo, cliente, máquina, pieza o estatus.
                    </div>
                </div>

                <div class="chip-row">
                    <a asp-controller="PlaneacionPanorama"
                       asp-action="Index"
                       asp-route-vista="@PlaneacionPanoramaVista.Dia"
                       asp-route-clienteId="@Model.ClienteID"
                       asp-route-maquinaId="@Model.MaquinaID"
                       asp-route-parteId="@Model.ParteID"
                       asp-route-estatusId="@Model.EstatusID"
                       class="chip @(Model.Vista == PlaneacionPanoramaVista.Dia ? "active" : "")">
                        <i class="fa-solid fa-sun"></i>
                        Diario
                    </a>

                    <a asp-controller="PlaneacionPanorama"
                       asp-action="Index"
                       asp-route-vista="@PlaneacionPanoramaVista.Semana"
                       asp-route-clienteId="@Model.ClienteID"
                       asp-route-maquinaId="@Model.MaquinaID"
                       asp-route-parteId="@Model.ParteID"
                       asp-route-estatusId="@Model.EstatusID"
                       class="chip @(Model.Vista == PlaneacionPanoramaVista.Semana ? "active" : "")">
                        <i class="fa-solid fa-calendar-week"></i>
                        Semana
                    </a>

                    <a asp-controller="PlaneacionPanorama"
                       asp-action="Index"
                       asp-route-vista="@PlaneacionPanoramaVista.Mes"
                       asp-route-clienteId="@Model.ClienteID"
                       asp-route-maquinaId="@Model.MaquinaID"
                       asp-route-parteId="@Model.ParteID"
                       asp-route-estatusId="@Model.EstatusID"
                       class="chip @(Model.Vista == PlaneacionPanoramaVista.Mes ? "active" : "")">
                        <i class="fa-solid fa-calendar-days"></i>
                        Mes
                    </a>

                    <a asp-controller="PlaneacionPanorama"
                       asp-action="Index"
                       asp-route-vista="@PlaneacionPanoramaVista.Anio"
                       asp-route-clienteId="@Model.ClienteID"
                       asp-route-maquinaId="@Model.MaquinaID"
                       asp-route-parteId="@Model.ParteID"
                       asp-route-estatusId="@Model.EstatusID"
                       class="chip @(Model.Vista == PlaneacionPanoramaVista.Anio ? "active" : "")">
                        <i class="fa-solid fa-calendar"></i>
                        Año
                    </a>

                    <a asp-controller="PlaneacionPanorama"
                       asp-action="Index"
                       asp-route-vista="@PlaneacionPanoramaVista.LargoPlazo"
                       asp-route-clienteId="@Model.ClienteID"
                       asp-route-maquinaId="@Model.MaquinaID"
                       asp-route-parteId="@Model.ParteID"
                       asp-route-estatusId="@Model.EstatusID"
                       class="chip @(Model.Vista == PlaneacionPanoramaVista.LargoPlazo ? "active" : "")">
                        <i class="fa-solid fa-timeline"></i>
                        Largo plazo
                    </a>
                </div>
            </div>

            <div class="panel-body">
                <form asp-controller="PlaneacionPanorama" asp-action="Index" method="get">
                    <input type="hidden" name="vista" value="@Model.Vista" />

                    <div class="row g-3 align-items-end">
                        <div class="col-xl-2 col-md-4">
                            <label class="fw-bold small text-muted">Desde</label>
                            <input type="date"
                                   name="fechaDesde"
                                   value="@Model.FechaDesde.ToString("yyyy-MM-dd")"
                                   class="form-control input-modern" />
                        </div>

                        <div class="col-xl-2 col-md-4">
                            <label class="fw-bold small text-muted">Hasta</label>
                            <input type="date"
                                   name="fechaHasta"
                                   value="@Model.FechaHasta.ToString("yyyy-MM-dd")"
                                   class="form-control input-modern" />
                        </div>

                        <div class="col-xl-2 col-md-4">
                            <label class="fw-bold small text-muted">Cliente</label>
                            <select name="clienteId" asp-items="Model.Clientes" class="form-select input-modern"></select>
                        </div>

                        <div class="col-xl-2 col-md-4">
                            <label class="fw-bold small text-muted">Máquina</label>
                            <select name="maquinaId" asp-items="Model.Maquinas" class="form-select input-modern"></select>
                        </div>

                        <div class="col-xl-2 col-md-4">
                            <label class="fw-bold small text-muted">Parte</label>
                            <select name="parteId" asp-items="Model.Partes" class="form-select input-modern"></select>
                        </div>

                        <div class="col-xl-2 col-md-4">
                            <label class="fw-bold small text-muted">Estatus</label>
                            <select name="estatusId" asp-items="Model.Estatus" class="form-select input-modern"></select>
                        </div>

                        <div class="col-xl-3 col-md-6">
                            <button type="submit" class="btn btn-primary-soft w-100">
                                <i class="fa-solid fa-magnifying-glass me-1"></i>
                                Consultar
                            </button>
                        </div>

                        <div class="col-xl-3 col-md-6">
                            <a asp-controller="PlaneacionPanorama"
                               asp-action="Index"
                               class="btn btn-white-soft w-100">
                                <i class="fa-solid fa-rotate-left me-1"></i>
                                Limpiar
                            </a>
                        </div>

                        <div class="col-xl-6">
                            <label class="fw-bold small text-muted">Buscar en pantalla</label>
                            <input id="buscarTexto"
                                   type="text"
                                   class="form-control input-modern"
                                   placeholder="Buscar cliente, pieza, máquina, molde, material..." />
                        </div>
                    </div>
                </form>

                <div class="mt-3 chip-row">
                    <button type="button" class="chip active filtro-estado" data-estado="todos">
                        <i class="fa-solid fa-layer-group"></i>
                        Todos
                    </button>

                    <button type="button" class="chip filtro-estado" data-estado="pendiente">
                        <i class="fa-solid fa-clock"></i>
                        Pendiente programar
                    </button>

                    <button type="button" class="chip filtro-estado" data-estado="programado">
                        <i class="fa-solid fa-gears"></i>
                        Programado
                    </button>

                    <button type="button" class="chip filtro-estado" data-estado="conof">
                        <i class="fa-solid fa-circle-check"></i>
                        Con OF
                    </button>
                </div>
            </div>
        </section>

        <section class="row g-3 mb-4">
            <div class="col-xl-2 col-md-4">
                <div class="kpi">
                    <div class="kpi-icon"><i class="fa-solid fa-users"></i></div>
                    <div class="kpi-label">Clientes</div>
                    <div class="kpi-value">@Entero(Model.TotalClientes)</div>
                    <div class="kpi-sub">@Entero(Model.TotalPartes) piezas</div>
                </div>
            </div>

            <div class="col-xl-2 col-md-4">
                <div class="kpi">
                    <div class="kpi-icon"><i class="fa-solid fa-boxes-stacked"></i></div>
                    <div class="kpi-label">Requerido</div>
                    <div class="kpi-value">@Entero(Model.TotalCantidadRequerida)</div>
                    <div class="kpi-sub">piezas release</div>
                </div>
            </div>

            <div class="col-xl-2 col-md-4">
                <div class="kpi">
                    <div class="kpi-icon"><i class="fa-solid fa-industry"></i></div>
                    <div class="kpi-label">Programado</div>
                    <div class="kpi-value">@Entero(Model.TotalCantidadProgramada)</div>
                    <div class="kpi-sub">@Decimal2NoNull(Model.PorcentajeProgramado)%</div>
                </div>
            </div>

            <div class="col-xl-2 col-md-4">
                <div class="kpi">
                    <div class="kpi-icon"><i class="fa-solid fa-hourglass-half"></i></div>
                    <div class="kpi-label">Pendiente</div>
                    <div class="kpi-value">@Entero(Model.TotalCantidadPendiente)</div>
                    <div class="kpi-sub">por producir</div>
                </div>
            </div>

            <div class="col-xl-2 col-md-4">
                <div class="kpi">
                    <div class="kpi-icon"><i class="fa-solid fa-weight-hanging"></i></div>
                    <div class="kpi-label">MP</div>
                    <div class="kpi-value">@Decimal2NoNull(Model.TotalMpKg)</div>
                    <div class="kpi-sub">kg estimados</div>
                </div>
            </div>

            <div class="col-xl-2 col-md-4">
                <div class="kpi">
                    <div class="kpi-icon"><i class="fa-solid fa-tags"></i></div>
                    <div class="kpi-label">Etiquetas</div>
                    <div class="kpi-value">@Decimal2NoNull(Model.TotalEtiquetas)</div>
                    <div class="kpi-sub">@Decimal2NoNull(Model.TotalEmbalajes) embalajes</div>
                </div>
            </div>
        </section>

        @if (!Model.ClientesPanorama.Any())
        {
            <section class="empty-state">
                <i class="fa-regular fa-calendar-xmark fa-3x mb-3"></i>
                <h3 class="fw-bold text-primary">Sin datos para este periodo</h3>
                <p class="mb-0">No hay releases, programas o necesidades en el rango seleccionado.</p>
            </section>
        }
        else
        {
            <section class="client-grid" id="gridClientes">
                @{
                    var clienteIndex = 0;
                }

                @foreach (var cliente in Model.ClientesPanorama)
                {
                    clienteIndex++;

                    var modalClienteId = IdSeguro("modalCliente", clienteIndex);
                    var estadosCliente = string.Join(" ", cliente.Partes.SelectMany(p => p.Renglones).Select(r => EstadoData(r)).Distinct());
                    var searchCliente = SearchCliente(cliente);

                    <article class="client-card @ClienteClase(cliente)"
                             data-search="@searchCliente"
                             data-estados="@estadosCliente">

                        <div>
                            <div class="client-avatar">
                                @InicialCliente(cliente.ClienteNombre)
                            </div>

                            <h3 class="client-title">
                                @cliente.ClienteNombre
                            </h3>

                            <div class="client-sub">
                                @Entero(cliente.TotalPartes) piezas ·
                                @Entero(cliente.TotalRenglones) movimientos ·
                                @Entero(cliente.TotalCantidadPendiente) pendientes
                            </div>

                            <div class="mini-grid">
                                <div class="mini-box">
                                    <div class="mini-label">Requerido</div>
                                    <div class="mini-value">@Entero(cliente.TotalCantidadRequerida)</div>
                                </div>

                                <div class="mini-box">
                                    <div class="mini-label">Programado</div>
                                    <div class="mini-value">@Entero(cliente.TotalCantidadProgramada)</div>
                                </div>

                                <div class="mini-box">
                                    <div class="mini-label">Pendiente</div>
                                    <div class="mini-value">@Entero(cliente.TotalCantidadPendiente)</div>
                                </div>

                                <div class="mini-box">
                                    <div class="mini-label">MP kg</div>
                                    <div class="mini-value">@Decimal2NoNull(cliente.TotalMpKg)</div>
                                </div>
                            </div>

                            <div class="mt-3">
                                <div class="d-flex justify-content-between small fw-bold text-muted mb-1">
                                    <span>Avance programado</span>
                                    <span>@Decimal2NoNull(cliente.PorcentajeProgramado)%</span>
                                </div>
                                <div class="progress-track">
                                    <div class="progress-fill @Barra(cliente.PorcentajeProgramado)"
                                         style="width:@Width(cliente.PorcentajeProgramado)"></div>
                                </div>
                            </div>
                        </div>

                        <div class="mt-4 d-grid">
                            <button type="button"
                                    class="btn btn-primary-soft"
                                    data-bs-toggle="modal"
                                    data-bs-target="#@modalClienteId">
                                <i class="fa-solid fa-up-right-and-down-left-from-center me-1"></i>
                                Abrir panorama
                            </button>
                        </div>
                    </article>

                    <div class="modal fade"
                         id="@modalClienteId"
                         tabindex="-1"
                         aria-hidden="true">
                        <div class="modal-dialog modal-fullscreen">
                            <div class="modal-content">

                                <div class="modal-header-custom">
                                    <div class="d-flex justify-content-between align-items-start gap-3 flex-wrap w-100">
                                        <div>
                                            <h2 class="modal-title-custom">
                                                <i class="fa-solid fa-building me-2"></i>
                                                @cliente.ClienteNombre
                                            </h2>

                                            <div class="modal-sub-custom">
                                                Tablero tipo Excel: periodos completos, ceros visibles, barras por métrica y acciones operativas.
                                            </div>

                                            <div class="chip-row mt-3">
                                                <span class="pill pill-primary">@Entero(cliente.TotalPartes) piezas</span>
                                                <span class="pill pill-warning">@Entero(cliente.TotalCantidadPendiente) pendientes</span>
                                                <span class="pill pill-success">@Entero(cliente.TotalConOF) con OF</span>
                                                <span class="pill pill-muted">@Entero(cliente.TotalSinOF) sin OF</span>
                                            </div>
                                        </div>

                                        <button type="button"
                                                class="btn btn-light fw-bold rounded-4"
                                                data-bs-dismiss="modal">
                                            <i class="fa-solid fa-xmark me-1"></i>
                                            Cerrar
                                        </button>
                                    </div>
                                </div>

                                <div class="modal-body-custom">
                                    <div class="modal-kpis">
                                        <div class="modal-kpi">
                                            <div class="kpi-label">Requerido</div>
                                            <div class="kpi-value">@Entero(cliente.TotalCantidadRequerida)</div>
                                        </div>

                                        <div class="modal-kpi">
                                            <div class="kpi-label">Programado</div>
                                            <div class="kpi-value">@Entero(cliente.TotalCantidadProgramada)</div>
                                        </div>

                                        <div class="modal-kpi">
                                            <div class="kpi-label">Pendiente</div>
                                            <div class="kpi-value">@Entero(cliente.TotalCantidadPendiente)</div>
                                        </div>

                                        <div class="modal-kpi">
                                            <div class="kpi-label">Horas</div>
                                            <div class="kpi-value">@Decimal2NoNull(cliente.TotalHorasProgramadas)</div>
                                        </div>

                                        <div class="modal-kpi">
                                            <div class="kpi-label">MP kg</div>
                                            <div class="kpi-value">@Decimal2NoNull(cliente.TotalMpKg)</div>
                                        </div>

                                        <div class="modal-kpi">
                                            <div class="kpi-label">Etiquetas</div>
                                            <div class="kpi-value">@Decimal2NoNull(cliente.TotalEtiquetas)</div>
                                        </div>
                                    </div>

                                    <div class="piece-list">
                                        <aside class="piece-sidebar">
                                            @{
                                                var piezaIndex = 0;
                                            }

                                            @foreach (var pieza in cliente.Partes)
                                            {
                                                piezaIndex++;

                                                var piezaKey = IdSeguro("pieza", clienteIndex, piezaIndex);
                                                var activeClass = piezaIndex == 1 ? "active" : "";

                                                <button type="button"
                                                        class="piece-tab @activeClass"
                                                        data-piece-button="@modalClienteId"
                                                        data-piece-target="@piezaKey">
                                                    <div class="piece-tab-title">
                                                        <i class="fa-solid fa-cube text-primary me-1"></i>
                                                        @Valor(pieza.ReferenciaSAP ?? pieza.NumeroParte)
                                                    </div>

                                                    <div class="piece-tab-desc">
                                                        @Valor(pieza.DesignacionDescripcionSAP)
                                                    </div>

                                                    <div class="piece-tab-footer">
                                                        <span class="pill pill-warning">@Entero(pieza.TotalCantidadPendiente) pend.</span>
                                                        <span class="pill pill-primary">@Entero(pieza.TotalCantidadProgramada) prog.</span>
                                                    </div>
                                                </button>
                                            }
                                        </aside>

                                        <main>
                                            @{
                                                var detallePiezaIndex = 0;
                                            }

                                            @foreach (var pieza in cliente.Partes)
                                            {
                                                detallePiezaIndex++;

                                                var piezaKey = IdSeguro("pieza", clienteIndex, detallePiezaIndex);
                                                var activeClass = detallePiezaIndex == 1 ? "active" : "";

                                                <section class="piece-detail @activeClass"
                                                         data-piece-panel="@modalClienteId"
                                                         data-piece-id="@piezaKey">

                                                    <div class="piece-stage">
                                                        <div class="piece-stage-header">
                                                            <div class="d-flex justify-content-between align-items-start gap-3 flex-wrap">
                                                                <div>
                                                                    <h3 class="piece-stage-title">
                                                                        @Valor(pieza.ReferenciaSAP ?? pieza.NumeroParte)
                                                                    </h3>
                                                                    <div class="piece-stage-desc">
                                                                        @Valor(pieza.DesignacionDescripcionSAP)
                                                                    </div>

                                                                    <div class="tech-row">
                                                                        <span class="pill pill-primary">
                                                                            <i class="fa-solid fa-industry"></i>
                                                                            @Valor(pieza.MaquinaCodigo)
                                                                        </span>

                                                                        <span class="pill pill-purple">
                                                                            <i class="fa-solid fa-shapes"></i>
                                                                            Molde @Valor(pieza.MoldeCodigo)
                                                                        </span>

                                                                        <span class="pill pill-muted">
                                                                            Cav. @(pieza.Cavidades?.ToString() ?? "-")
                                                                        </span>

                                                                        <span class="pill pill-muted">
                                                                            Obj/Hr @(pieza.ObjetivoHora?.ToString("N0") ?? "-")
                                                                        </span>

                                                                        <span class="pill pill-muted">
                                                                            Color @Valor(pieza.Color)
                                                                        </span>
                                                                    </div>
                                                                </div>

                                                                <div class="mode-switch" data-switch="@piezaKey">
                                                                    <button type="button" class="mode-btn active" data-view="dia">
                                                                        <i class="fa-solid fa-sun me-1"></i>
                                                                        Diario
                                                                    </button>
                                                                    <button type="button" class="mode-btn" data-view="semana">
                                                                        <i class="fa-solid fa-calendar-week me-1"></i>
                                                                        Semana
                                                                    </button>
                                                                    <button type="button" class="mode-btn" data-view="mes">
                                                                        <i class="fa-solid fa-calendar-days me-1"></i>
                                                                        Mes
                                                                    </button>
                                                                    <button type="button" class="mode-btn" data-view="anio">
                                                                        <i class="fa-solid fa-calendar me-1"></i>
                                                                        Año
                                                                    </button>
                                                                </div>
                                                            </div>
                                                        </div>

                                                        <div class="piece-stage-body">
                                                            <div class="modal-kpis">
                                                                <div class="modal-kpi">
                                                                    <div class="kpi-label">Requerido</div>
                                                                    <div class="kpi-value">@Entero(pieza.TotalCantidadRequerida)</div>
                                                                </div>

                                                                <div class="modal-kpi">
                                                                    <div class="kpi-label">Desde PT</div>
                                                                    <div class="kpi-value">@Entero(pieza.TotalPiezasDesdePT)</div>
                                                                </div>

                                                                <div class="modal-kpi">
                                                                    <div class="kpi-label">Programado</div>
                                                                    <div class="kpi-value">@Entero(pieza.TotalCantidadProgramada)</div>
                                                                </div>

                                                                <div class="modal-kpi">
                                                                    <div class="kpi-label">Producido</div>
                                                                    <div class="kpi-value">@Entero(pieza.TotalCantidadProducida)</div>
                                                                </div>

                                                                <div class="modal-kpi">
                                                                    <div class="kpi-label">Pendiente</div>
                                                                    <div class="kpi-value">@Entero(pieza.TotalCantidadPendiente)</div>
                                                                </div>

                                                                <div class="modal-kpi">
                                                                    <div class="kpi-label">MP kg</div>
                                                                    <div class="kpi-value">@Decimal2NoNull(pieza.TotalMpKg)</div>
                                                                </div>
                                                            </div>

                                                            @{
                                                                // REGLA FINAL:
                                                                // Diario  = SIEMPRE el día actual en que se abre la vista.
                                                                // Semana  = se queda día por día, según el rango recibido.
                                                                // Mes     = columnas generales por semana del mes seleccionado.
                                                                // Año     = tarjetas de todos los meses del año seleccionado.

                                                                var hoyVista = DateTime.Today;

                                                                var inicioMesVista = new DateTime(Model.FechaDesde.Year, Model.FechaDesde.Month, 1);
                                                                var finMesVista = inicioMesVista.AddMonths(1).AddDays(-1);

                                                                var inicioAnioVista = new DateTime(Model.FechaDesde.Year, 1, 1);
                                                                var finAnioVista = new DateTime(Model.FechaDesde.Year, 12, 31);

                                                                var vistas = new[]
                                                                {
                                                                                                new { Key = "dia", Titulo = "Diario", Sub = "Solo el día actual: " + hoyVista.ToString("dd/MM/yyyy"), Grupos = ConstruirGruposDia(pieza.Renglones, hoyVista, hoyVista), Texto = (Func<string, string>)TextoDiaLargo, Active = true },
                                                                                                new { Key = "semana", Titulo = "Semana", Sub = "Semana desplegada día por día.", Grupos = ConstruirGruposDia(pieza.Renglones, Model.FechaDesde, Model.FechaHasta), Texto = (Func<string, string>)TextoDia, Active = false },
                                                                                                new { Key = "mes", Titulo = "Mes", Sub = "Columnas generales por semana. Abre una semana para ver sus días.", Grupos = ConstruirGruposSemana(pieza.Renglones, inicioMesVista, finMesVista), Texto = (Func<string, string>)TextoSemana, Active = false },
                                                                                                new { Key = "anio", Titulo = "Año", Sub = "Todos los meses del año. Abre un mes para ver sus semanas.", Grupos = ConstruirGruposMes(pieza.Renglones, inicioAnioVista, finAnioVista), Texto = (Func<string, string>)TextoMes, Active = false }
                                                                                                };
                                                            }

                                                            @foreach (var vista in vistas)
                                                            {
                                                                var grupos = vista.Grupos;
                                                                var cols = Math.Max(1, grupos.Count);
                                                                var gridStyle = $"grid-template-columns: 185px repeat({cols}, minmax(162px, 1fr));";
                                                                var maxCantidad = MaxCantidad(grupos);
                                                                var maxMp = MaxDecimal(grupos);

                                                                <div class="timeline-view @(vista.Active ? "active" : "")"
                                                                     data-timeline="@piezaKey"
                                                                     data-view="@vista.Key">

                                                                    @if (vista.Key == "anio")
                                                                    {
                                                                        <div class="excel-board">
                                                                            <div class="excel-board-top">
                                                                                <div>
                                                                                    <h4 class="excel-board-title">
                                                                                        <i class="fa-solid fa-calendar me-2"></i>
                                                                                        Año · meses
                                                                                    </h4>
                                                                                    <div class="excel-board-sub">
                                                                                        Cada tarjeta es un mes del año seleccionado. Al abrirlo se muestran sus semanas, sin bajar a días.
                                                                                    </div>
                                                                                </div>

                                                                                <div class="chip-row">
                                                                                    <span class="pill pill-primary">@grupos.Count mes(es)</span>
                                                                                    <span class="pill pill-warning">@Entero(grupos.Sum(SumaPendiente)) pendientes</span>
                                                                                    <span class="pill pill-success">@Entero(grupos.Sum(SumaProgramado)) programadas</span>
                                                                                </div>
                                                                            </div>

                                                                            <div class="panel-body">
                                                                                <div class="month-board">
                                                                                    @{
                                                                                        var mesIndex = 0;
                                                                                    }

                                                                                    @foreach (var mes in grupos)
                                                                                    {
                                                                                        mesIndex++;
                                                                                        var mesId = $"{piezaKey}_mes_{mesIndex}";
                                                                                        var requeridoMes = SumaRequerido(mes);
                                                                                        var programadoMes = SumaProgramado(mes);
                                                                                        var pendienteMes = SumaPendiente(mes);
                                                                                        var producidoMes = SumaProducido(mes);
                                                                                        var mpMes = SumaMp(mes);
                                                                                        var maxMes = Math.Max(1, new[] { requeridoMes, programadoMes, pendienteMes, producidoMes }.Max());
                                                                                        var inicioMes = InicioMesDesdeKey(mes.Key);
                                                                                        var finMes = FinMesDesdeKey(mes.Key);
                                                                                        var semanasMes = ConstruirGruposSemana(mes.Datos, inicioMes, finMes);

                                                                                        <article class="month-card">
                                                                                            <div class="month-card-head">
                                                                                                <div class="d-flex justify-content-between align-items-start gap-2 flex-wrap">
                                                                                                    <div>
                                                                                                        <div class="month-card-title">@TextoMes(mes.Key)</div>
                                                                                                        <div class="period-count">@mes.Datos.Count movimiento(s)</div>
                                                                                                    </div>

                                                                                                    <button type="button"
                                                                                                            class="btn btn-white-soft btn-sm"
                                                                                                            data-bs-toggle="collapse"
                                                                                                            data-bs-target="#@mesId">
                                                                                                        <i class="fa-solid fa-chevron-down me-1"></i>
                                                                                                        Ver mes
                                                                                                    </button>
                                                                                                </div>
                                                                                            </div>

                                                                                            <div class="month-card-body">
                                                                                                <div class="mini-period-value">
                                                                                                    <div class="mini-line"><span>Pedido</span><strong>@Entero(requeridoMes)</strong></div>
                                                                                                    <div class="mini-line"><span>Programado</span><strong>@Entero(programadoMes)</strong></div>
                                                                                                    <div class="mini-line"><span>Producido</span><strong>@Entero(producidoMes)</strong></div>
                                                                                                    <div class="mini-line"><span>Pendiente</span><strong>@Entero(pendienteMes)</strong></div>
                                                                                                    <div class="mini-line"><span>MP kg</span><strong>@Decimal2NoNull(mpMes)</strong></div>
                                                                                                </div>

                                                                                                <div class="cell-bar mt-3">
                                                                                                    <div class="cell-fill fill-programado @(programadoMes == 0 ? "zero" : "")"
                                                                                                         style="width:@Width(Porcentaje(programadoMes, maxMes))"></div>
                                                                                                </div>
                                                                                            </div>

                                                                                            <div class="collapse" id="@mesId">
                                                                                                <div class="period-drill">
                                                                                                    <div class="period-drill-head">
                                                                                                        <div>
                                                                                                            <div class="period-drill-title">Semanas de @TextoMes(mes.Key)</div>
                                                                                                            <div class="period-drill-sub">Detalle semana por semana del mes seleccionado.</div>
                                                                                                        </div>
                                                                                                        <span class="pill pill-primary">@semanasMes.Count semana(s)</span>
                                                                                                    </div>

                                                                                                    <div class="mini-period-strip">
                                                                                                        <div class="mini-period-grid" style="grid-template-columns: repeat(@Math.Max(1, semanasMes.Count), 210px);">
                                                                                                            @foreach (var sem in semanasMes)
                                                                                                            {
                                                                                                                <div class="mini-period-card">
                                                                                                                    <div class="mini-period-title">@TextoSemana(sem.Key)</div>
                                                                                                                    <div class="mini-period-value">
                                                                                                                        <div class="mini-line"><span>Pedido</span><strong>@Entero(SumaRequerido(sem))</strong></div>
                                                                                                                        <div class="mini-line"><span>Prog.</span><strong>@Entero(SumaProgramado(sem))</strong></div>
                                                                                                                        <div class="mini-line"><span>Prod.</span><strong>@Entero(SumaProducido(sem))</strong></div>
                                                                                                                        <div class="mini-line"><span>Pend.</span><strong>@Entero(SumaPendiente(sem))</strong></div>
                                                                                                                        <div class="mini-line"><span>MP</span><strong>@Decimal2NoNull(SumaMp(sem))</strong></div>
                                                                                                                    </div>
                                                                                                                </div>
                                                                                                            }
                                                                                                        </div>
                                                                                                    </div>
                                                                                                </div>
                                                                                            </div>
                                                                                        </article>
                                                                                    }
                                                                                </div>
                                                                            </div>
                                                                        </div>
                                                                    }
                                                                    else
                                                                    {
                                                                        <div class="excel-board">
                                                                            <div class="excel-board-top">
                                                                                <div>
                                                                                    <h4 class="excel-board-title">
                                                                                        <i class="fa-solid fa-table-cells-large me-2"></i>
                                                                                        @vista.Titulo
                                                                                    </h4>
                                                                                    <div class="excel-board-sub">@vista.Sub</div>
                                                                                </div>

                                                                                <div class="chip-row">
                                                                                    <span class="pill pill-primary">@cols periodo(s)</span>
                                                                                    <span class="pill pill-warning">@Entero(grupos.Sum(SumaPendiente)) pendientes</span>
                                                                                    <span class="pill pill-success">@Entero(grupos.Sum(SumaProgramado)) programadas</span>
                                                                                </div>
                                                                            </div>

                                                                            <div class="excel-scroll">
                                                                                <div class="planning-grid" style="@gridStyle">
                                                                                    <div class="grid-cell grid-header grid-sticky grid-corner">
                                                                                        Métrica
                                                                                    </div>

                                                                                    @foreach (var grupo in grupos)
                                                                                    {
                                                                                        <div class="grid-cell grid-header">
                                                                                            <div class="period-name">@vista.Texto(grupo.Key)</div>
                                                                                            <div class="period-count">@grupo.Datos.Count movimiento(s)</div>
                                                                                        </div>
                                                                                    }

                                                                                    <div class="grid-cell grid-sticky">
                                                                                        <div class="row-label-main">Pedido cliente</div>
                                                                                        <div class="row-label-sub">Demanda release</div>
                                                                                    </div>

                                                                                    @foreach (var grupo in grupos)
                                                                                    {
                                                                                        var valor = SumaRequerido(grupo);

                                                                                        <div class="grid-cell">
                                                                                            <div class="cell-value">
                                                                                                <span>@Entero(valor)</span>
                                                                                                <small>pzas.</small>
                                                                                            </div>
                                                                                            <div class="cell-bar">
                                                                                                <div class="cell-fill fill-pedido @(valor == 0 ? "zero" : "")"
                                                                                                     style="width:@Width(Porcentaje(valor, maxCantidad))"></div>
                                                                                            </div>
                                                                                        </div>
                                                                                    }

                                                                                    <div class="grid-cell grid-sticky">
                                                                                        <div class="row-label-main">Desde PT</div>
                                                                                        <div class="row-label-sub">Cubierto con inventario</div>
                                                                                    </div>

                                                                                    @foreach (var grupo in grupos)
                                                                                    {
                                                                                        var valor = SumaPT(grupo);

                                                                                        <div class="grid-cell">
                                                                                            <div class="cell-value">
                                                                                                <span>@Entero(valor)</span>
                                                                                                <small>pzas.</small>
                                                                                            </div>
                                                                                            <div class="cell-bar">
                                                                                                <div class="cell-fill fill-pt @(valor == 0 ? "zero" : "")"
                                                                                                     style="width:@Width(Porcentaje(valor, maxCantidad))"></div>
                                                                                            </div>
                                                                                        </div>
                                                                                    }

                                                                                    <div class="grid-cell grid-sticky">
                                                                                        <div class="row-label-main">Programado</div>
                                                                                        <div class="row-label-sub">En máquinas / cambio molde</div>
                                                                                    </div>

                                                                                    @foreach (var grupo in grupos)
                                                                                    {
                                                                                        var valor = SumaProgramado(grupo);

                                                                                        <div class="grid-cell">
                                                                                            <div class="cell-value">
                                                                                                <span>@Entero(valor)</span>
                                                                                                <small>pzas.</small>
                                                                                            </div>
                                                                                            <div class="cell-bar">
                                                                                                <div class="cell-fill fill-programado @(valor == 0 ? "zero" : "")"
                                                                                                     style="width:@Width(Porcentaje(valor, maxCantidad))"></div>
                                                                                            </div>
                                                                                        </div>
                                                                                    }

                                                                                    <div class="grid-cell grid-sticky">
                                                                                        <div class="row-label-main">Producido</div>
                                                                                        <div class="row-label-sub">Avance real</div>
                                                                                    </div>

                                                                                    @foreach (var grupo in grupos)
                                                                                    {
                                                                                        var valor = SumaProducido(grupo);

                                                                                        <div class="grid-cell">
                                                                                            <div class="cell-value">
                                                                                                <span>@Entero(valor)</span>
                                                                                                <small>pzas.</small>
                                                                                            </div>
                                                                                            <div class="cell-bar">
                                                                                                <div class="cell-fill fill-producido @(valor == 0 ? "zero" : "")"
                                                                                                     style="width:@Width(Porcentaje(valor, maxCantidad))"></div>
                                                                                            </div>
                                                                                        </div>
                                                                                    }

                                                                                    <div class="grid-cell grid-sticky">
                                                                                        <div class="row-label-main">Pendiente</div>
                                                                                        <div class="row-label-sub">Por producir / programar</div>
                                                                                    </div>

                                                                                    @foreach (var grupo in grupos)
                                                                                    {
                                                                                        var valor = SumaPendiente(grupo);

                                                                                        <div class="grid-cell">
                                                                                            <div class="cell-value">
                                                                                                <span>@Entero(valor)</span>
                                                                                                <small>pzas.</small>
                                                                                            </div>
                                                                                            <div class="cell-bar">
                                                                                                <div class="cell-fill fill-pendiente @(valor == 0 ? "zero" : "")"
                                                                                                     style="width:@Width(Porcentaje(valor, maxCantidad))"></div>
                                                                                            </div>
                                                                                        </div>
                                                                                    }

                                                                                    <div class="grid-cell grid-sticky">
                                                                                        <div class="row-label-main">MP kg</div>
                                                                                        <div class="row-label-sub">Materia prima requerida</div>
                                                                                    </div>

                                                                                    @foreach (var grupo in grupos)
                                                                                    {
                                                                                        var valor = SumaMp(grupo);

                                                                                        <div class="grid-cell">
                                                                                            <div class="cell-value">
                                                                                                <span>@Decimal2NoNull(valor)</span>
                                                                                                <small>kg</small>
                                                                                            </div>
                                                                                            <div class="cell-bar">
                                                                                                <div class="cell-fill fill-mp @(valor == 0 ? "zero" : "")"
                                                                                                     style="width:@Width(PorcentajeDecimal(valor, maxMp))"></div>
                                                                                            </div>
                                                                                        </div>
                                                                                    }

                                                                                    <div class="grid-cell grid-sticky">
                                                                                        <div class="row-label-main">Acciones</div>
                                                                                        <div class="row-label-sub">
                                                                                            @(vista.Key == "mes" ? "Abrir semana / Cambio de molde / OF" : "Cambio de molde / OF")
                                                                                        </div>
                                                                                    </div>

                                                                                    @foreach (var grupo in grupos)
                                                                                    {
                                                                                        var semanaId = $"{piezaKey}_sem_{grupo.Key.Replace("|", "_").Replace("-", "_")}";

                                                                                        <div class="grid-cell action-cell">
                                                                                            <div class="action-stack">
                                                                                                @if (vista.Key == "mes")
                                                                                                {
                                                                                                    <button type="button"
                                                                                                            class="btn btn-white-soft btn-sm"
                                                                                                            data-bs-toggle="collapse"
                                                                                                            data-bs-target="#@semanaId">
                                                                                                        <i class="fa-solid fa-chevron-down me-1"></i>
                                                                                                        Abrir semana
                                                                                                    </button>
                                                                                                }

                                                                                                @if (!grupo.Datos.Any())
                                                                                                {
                                                                                                    <span class="empty-action">Sin movimiento</span>
                                                                                                }
                                                                                                else
                                                                                                {
                                                                                                    foreach (var r in grupo.Datos)
                                                                                                    {
                                                                                                        <span class="movement">
                                                                                                            <i class="fa-solid @EstadoIcono(r) me-1"></i>
                                                                                                            @Valor(r.FolioRelease) · @r.EstadoPanorama
                                                                                                        </span>

                                                                                                        if (r.EstaPendienteProgramar && r.ReleaseDetalleID.HasValue)
                                                                                                        {
                                                                                                            <a asp-controller="PlaneacionPrograma"
                                                                                                               asp-action="CrearDesdeNecesidad"
                                                                                                               asp-route-releaseDetalleId="@r.ReleaseDetalleID"
                                                                                                               class="btn btn-primary-soft btn-sm">
                                                                                                                <i class="fa-solid fa-gears me-1"></i>
                                                                                                                Cambio de Molde
                                                                                                            </a>
                                                                                                        }

                                                                                                        if (r.TieneOF && r.SolicitudProduccionID.HasValue)
                                                                                                        {
                                                                                                            <a asp-controller="Planeacion"
                                                                                                               asp-action="Detalle"
                                                                                                               asp-route-id="@r.SolicitudProduccionID"
                                                                                                               class="btn btn-success btn-sm rounded-4 fw-bold">
                                                                                                                <i class="fa-solid fa-circle-check me-1"></i>
                                                                                                                Ver OF
                                                                                                            </a>
                                                                                                        }
                                                                                                    }
                                                                                                }
                                                                                            </div>
                                                                                        </div>
                                                                                    }
                                                                                </div>

                                                                                @if (vista.Key == "mes")
                                                                                {
                                                                                    foreach (var semana in grupos)
                                                                                    {
                                                                                        var semanaId = $"{piezaKey}_sem_{semana.Key.Replace("|", "_").Replace("-", "_")}";
                                                                                        var inicioSemana = InicioSemanaDesdeKey(semana.Key);
                                                                                        var finSemana = FinSemanaDesdeKey(semana.Key);
                                                                                        var diasSemana = ConstruirGruposDia(semana.Datos, inicioSemana, finSemana);

                                                                                        <div class="collapse" id="@semanaId">
                                                                                            <div class="period-drill">
                                                                                                <div class="period-drill-head">
                                                                                                    <div>
                                                                                                        <div class="period-drill-title">@TextoSemana(semana.Key)</div>
                                                                                                        <div class="period-drill-sub">Detalle día por día de esta semana. Desplázate hacia la derecha.</div>
                                                                                                    </div>

                                                                                                    <div class="chip-row">
                                                                                                        <span class="pill pill-primary">@diasSemana.Count día(s)</span>
                                                                                                        <span class="pill pill-warning">@Entero(diasSemana.Sum(SumaPendiente)) pendientes</span>
                                                                                                    </div>
                                                                                                </div>

                                                                                                <div class="mini-period-strip">
                                                                                                    <div class="mini-period-grid" style="grid-template-columns: repeat(@Math.Max(1, diasSemana.Count), 210px);">
                                                                                                        @foreach (var dia in diasSemana)
                                                                                                        {
                                                                                                            <div class="mini-period-card">
                                                                                                                <div class="mini-period-title">@TextoDia(dia.Key)</div>
                                                                                                                <div class="mini-period-value">
                                                                                                                    <div class="mini-line"><span>Pedido</span><strong>@Entero(SumaRequerido(dia))</strong></div>
                                                                                                                    <div class="mini-line"><span>PT</span><strong>@Entero(SumaPT(dia))</strong></div>
                                                                                                                    <div class="mini-line"><span>Prog.</span><strong>@Entero(SumaProgramado(dia))</strong></div>
                                                                                                                    <div class="mini-line"><span>Prod.</span><strong>@Entero(SumaProducido(dia))</strong></div>
                                                                                                                    <div class="mini-line"><span>Pend.</span><strong>@Entero(SumaPendiente(dia))</strong></div>
                                                                                                                    <div class="mini-line"><span>MP</span><strong>@Decimal2NoNull(SumaMp(dia))</strong></div>
                                                                                                                </div>
                                                                                                            </div>
                                                                                                        }
                                                                                                    </div>
                                                                                                </div>
                                                                                            </div>
                                                                                        </div>
                                                                                    }
                                                                                }
                                                                            </div>
                                                                        </div>
                                                                    }
                                                                </div>
                                                            }
                                                        </div>
                                                    </div>
                                                </section>
                                            }
                                        </main>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                }
            </section>
        }

        <section class="sticky-footer-actions">
            <div class="d-flex justify-content-between gap-2 flex-wrap">
                <a asp-controller="PlaneacionPrograma"
                   asp-action="Index"
                   class="btn btn-white-soft">
                    <i class="fa-solid fa-arrow-left me-1"></i>
                    Volver
                </a>

                <div class="d-flex gap-2 flex-wrap">
                    <a asp-controller="PlaneacionPrograma"
                       asp-action="Maquinas"
                       class="btn btn-white-soft">
                        <i class="fa-solid fa-table-columns me-1"></i>
                        Máquinas
                    </a>

                    <a asp-controller="PlaneacionPrograma"
                       asp-action="Index"
                       class="btn btn-primary-soft">
                        <i class="fa-solid fa-list me-1"></i>
                        Programa general
                    </a>
                </div>
            </div>
        </section>

    </div>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>

    <script>
        const inputBusqueda = document.getElementById('buscarTexto');
        const cardsCliente = Array.from(document.querySelectorAll('.client-card'));
        const filtrosEstado = Array.from(document.querySelectorAll('.filtro-estado'));

        let estadoActivo = 'todos';

        function normalizar(valor) {
            return (valor || '')
                .toString()
                .toLowerCase()
                .normalize('NFD')
                .replace(/[\u0300-\u036f]/g, '')
                .trim();
        }

        function aplicarFiltros() {
            const texto = normalizar(inputBusqueda?.value || '');

            cardsCliente.forEach(card => {
                const search = normalizar(card.dataset.search || '');
                const estados = normalizar(card.dataset.estados || '');

                const coincideTexto = !texto || search.includes(texto);
                const coincideEstado = estadoActivo === 'todos' || estados.includes(estadoActivo);

                if (coincideTexto && coincideEstado) {
                    card.classList.remove('hidden-by-filter');
                } else {
                    card.classList.add('hidden-by-filter');
                }
            });
        }

        inputBusqueda?.addEventListener('input', aplicarFiltros);

        filtrosEstado.forEach(btn => {
            btn.addEventListener('click', function () {
                filtrosEstado.forEach(b => b.classList.remove('active'));
                this.classList.add('active');
                estadoActivo = this.dataset.estado || 'todos';
                aplicarFiltros();
            });
        });

        document.querySelectorAll('[data-piece-button]').forEach(btn => {
            btn.addEventListener('click', function () {
                const modalId = this.dataset.pieceButton;
                const pieceId = this.dataset.pieceTarget;

                document.querySelectorAll(`[data-piece-button="${modalId}"]`).forEach(b => {
                    b.classList.remove('active');
                });

                document.querySelectorAll(`[data-piece-panel="${modalId}"]`).forEach(panel => {
                    panel.classList.remove('active');
                });

                this.classList.add('active');

                const target = document.querySelector(`[data-piece-panel="${modalId}"][data-piece-id="${pieceId}"]`);

                if (target) {
                    target.classList.add('active');
                }
            });
        });

        document.querySelectorAll('.mode-switch').forEach(sw => {
            const key = sw.dataset.switch;
            const buttons = Array.from(sw.querySelectorAll('.mode-btn'));

            buttons.forEach(btn => {
                btn.addEventListener('click', function () {
                    const view = this.dataset.view;

                    buttons.forEach(b => b.classList.remove('active'));
                    this.classList.add('active');

                    document.querySelectorAll(`[data-timeline="${key}"]`).forEach(timeline => {
                        if (timeline.dataset.view === view) {
                            timeline.classList.add('active');
                        } else {
                            timeline.classList.remove('active');
                        }
                    });
                });
            });
        });
    </script>

</body>
</html>
