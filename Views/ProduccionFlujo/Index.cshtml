@model ERP.NSQuell.Models.ViewModels.Produccion.ProduccionFlujoIndexVm
@{ Layout="~/Views/Shared/_Layout.cshtml"; ViewData["Title"]="Produccion integral"; }
<link rel="stylesheet" href="~/css/Produccion/produccion-flujo-v1.css" asp-append-version="true" />
<section class="pf-hero"><div><small>PRODUCCION / TRAZABILIDAD</small><h1>Produccion integral</h1><p>Preparacion, liberacion de Calidad, captura por hora, paros, cajas y transferencia a Almacen PT.</p></div></section>
<section class="pf-panel"><form class="pf-filter" method="get"><input class="form-control" name="q" value="@Model.Busqueda" placeholder="OF, cliente, parte o maquina"/><select class="form-select" name="estado"><option value="">Todos los estados</option>@foreach(var estadoItem in new[]{"PENDIENTE","PREPARADA","ESPERANDO_CALIDAD","LIBERADA","EN_PROCESO","PAUSADA","DETENIDA_CALIDAD","TERMINADA","CERRADA"}){if(Model.Estado==estadoItem){<option value="@estadoItem" selected>@estadoItem.Replace("_"," ")</option>}else{<option value="@estadoItem">@estadoItem.Replace("_"," ")</option>}}</select><button class="btn btn-primary" type="submit">Filtrar</button></form></section>
<section class="pf-board">@if(!Model.Items.Any()){<div class="pf-empty">No existen ejecuciones con esos filtros.</div>}@foreach(var x in Model.Items){<article class="pf-card"><header><div><span class="pf-of">@x.NumeroOF</span><h2>@x.Cliente</h2><p>@x.NumeroParte · @x.Descripcion</p></div><span class="pf-state @x.Estado.ToLowerInvariant()">@x.Estado.Replace("_"," ")</span></header><div class="pf-metrics"><div><small>Maquina</small><strong>@x.Maquina</strong></div><div><small>Planeado</small><strong>@x.CantidadPlaneada.ToString("N0")</strong></div><div><small>OK</small><strong>@x.CantidadOK.ToString("N0")</strong></div><div><small>Sospechosa</small><strong>@x.Sospechosa.ToString("N0")</strong></div><div><small>Scrap</small><strong>@x.Scrap.ToString("N0")</strong></div><div><small>Personal</small><strong>@x.PersonalAsignado</strong></div></div><div class="pf-progress"><span style="width:@Math.Min(100,x.Avance).ToString("0.##",System.Globalization.CultureInfo.InvariantCulture)%"></span></div><footer><span>@x.Avance.ToString("N1")% · @(x.ChecklistAprobado?"Calidad liberada":"Sin liberar")</span><a class="btn btn-primary" asp-action="Detalle" asp-route-id="@x.EjecucionProduccionID">Abrir flujo</a></footer></article>}</section>
