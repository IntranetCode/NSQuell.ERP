@model ERP.NSQuell.Models.ViewModels.Produccion.ProduccionFlujoDetalleVm
@{ Layout="~/Views/Shared/_Layout.cshtml"; ViewData["Title"]=$"Produccion {Model.Ejecucion.NumeroOF}"; var e=Model.Ejecucion; }
<link rel="stylesheet" href="~/css/Produccion/produccion-flujo-v1.css" asp-append-version="true" />
@if(TempData["ProdOk"]!=null){<div class="alert alert-success">@TempData["ProdOk"]</div>}@if(TempData["ProdError"]!=null){<div class="alert alert-danger">@TempData["ProdError"]</div>}
<section class="pf-hero"><div><small>OF / @e.Estado.Replace("_"," ")</small><h1>@e.NumeroOF</h1><p>@e.Cliente · @e.NumeroParte · @e.Descripcion · @e.Maquina</p></div><span class="pf-state @e.Estado.ToLowerInvariant()">@e.Estado.Replace("_"," ")</span></section>
<section class="pf-flow"><div class="@(e.Estado=="PENDIENTE"?"active":"done")">1 Preparar</div><div class="@(e.Estado is "PREPARADA" or "ESPERANDO_CALIDAD"?"active":e.ChecklistAprobado?"done":"")">2 Calidad</div><div class="@(e.Estado is "LIBERADA" or "EN_PROCESO" or "PAUSADA" or "DETENIDA_CALIDAD"?"active":e.Estado is "TERMINADA" or "CERRADA"?"done":"")">3 Producir</div><div class="@(e.Estado=="TERMINADA"?"active":e.Estado=="CERRADA"?"done":"")">4 Cajas / cerrar</div></section>
<section class="pf-metrics pf-top"><div><small>Planeado</small><strong>@e.CantidadPlaneada.ToString("N0")</strong></div><div><small>OK</small><strong>@e.CantidadOK.ToString("N0")</strong></div><div><small>Sospechosa</small><strong>@e.Sospechosa.ToString("N0")</strong></div><div><small>Scrap</small><strong>@e.Scrap.ToString("N0")</strong></div><div><small>Cajas</small><strong>@e.CajasFormadas</strong></div><div><small>Checklist</small><strong>@(e.ChecklistAprobado?"Aprobado":"Pendiente")</strong></div></section>
<section class="pf-panel"><div class="pf-section-head"><div><h2>Material recibido de Almacen</h2><p>Confirma cada entrega parcial para cerrar la trazabilidad Almacen - Produccion.</p></div><a class="btn btn-outline-primary" href="/Produccion/ChecklistArranque?id=@e.EjecucionProduccionID">Abrir checklist completo</a></div><div class="pf-cards">@if(!Model.MaterialPendienteRecepcion.Any()){<div class="pf-empty">No hay entregas pendientes de confirmar.</div>}@foreach(var m in Model.MaterialPendienteRecepcion){<article><strong>@m.Modulo @m.Variante · @m.Codigo</strong><span>@m.Descripcion</span><small>@m.Cantidad.ToString("N3") @m.Unidad · Entrego @m.EntregadoPor · @m.Fecha.ToString("dd/MM HH:mm")</small><form asp-action="ConfirmarMaterial" method="post" class="pf-inline">@Html.AntiForgeryToken()<input type="hidden" name="id" value="@e.EjecucionProduccionID"/><input type="hidden" name="modulo" value="@m.Modulo"/><input type="hidden" name="movimientoID" value="@m.MovimientoID"/><input class="form-control form-control-sm" name="observaciones" placeholder="Observacion opcional"/><button class="btn btn-sm btn-success">Confirmar recepcion</button></form></article>}</div></section>
<section class="pf-grid">
<div class="pf-panel"><h2>Control de flujo</h2><div class="pf-actions">@if(e.Estado=="PENDIENTE"){<form asp-action="Preparar" method="post">@Html.AntiForgeryToken()<input type="hidden" name="id" value="@e.EjecucionProduccionID"/><select name="turno" class="form-select"><option>1</option><option>2</option><option>3</option><option>MIXTO</option></select><button class="btn btn-primary">Confirmar preparacion</button></form>}@if(e.Estado is "PREPARADA" or "DETENIDA_CALIDAD"){<form asp-action="SolicitarLiberacion" method="post">@Html.AntiForgeryToken()<input type="hidden" name="id" value="@e.EjecucionProduccionID"/><button class="btn btn-warning">Solicitar liberacion a Calidad</button></form>}@if(e.Estado=="LIBERADA"){<form asp-action="CambiarEstado" method="post">@Html.AntiForgeryToken()<input type="hidden" name="id" value="@e.EjecucionProduccionID"/><input type="hidden" name="accion" value="INICIAR"/><button class="btn btn-success">Iniciar produccion</button></form>}@if(e.Estado=="EN_PROCESO"){<form asp-action="CambiarEstado" method="post">@Html.AntiForgeryToken()<input type="hidden" name="id" value="@e.EjecucionProduccionID"/><input type="hidden" name="accion" value="PAUSAR"/><button class="btn btn-warning">Pausar</button></form><form asp-action="CambiarEstado" method="post">@Html.AntiForgeryToken()<input type="hidden" name="id" value="@e.EjecucionProduccionID"/><input type="hidden" name="accion" value="TERMINAR"/><button class="btn btn-danger">Terminar OF</button></form>}@if(e.Estado=="PAUSADA"&&!e.RequiereReliberacion){<form asp-action="CambiarEstado" method="post">@Html.AntiForgeryToken()<input type="hidden" name="id" value="@e.EjecucionProduccionID"/><input type="hidden" name="accion" value="REANUDAR"/><button class="btn btn-success">Reanudar</button></form>}@if(e.Estado=="TERMINADA"){<form asp-action="CerrarTransferir" method="post">@Html.AntiForgeryToken()<input type="hidden" name="id" value="@e.EjecucionProduccionID"/><button class="btn btn-success">Cerrar y notificar Almacen PT</button></form>}</div></div>
<div class="pf-panel"><h2>Asignar personal</h2><form asp-action="AsignarPersonal" method="post" class="pf-form">@Html.AntiForgeryToken()<input type="hidden" name="id" value="@e.EjecucionProduccionID"/><select class="form-select" name="usuarioID" required><option value="">Selecciona colaborador</option>@foreach(var p in Model.PersonalDisponible){<option value="@p.UsuarioID">@p.Nombre · @p.Puesto</option>}</select><select class="form-select" name="rol"><option>AUXILIAR</option><option>TECNICO</option><option>ENCARGADO</option><option>OPERADOR</option><option>SUPERVISOR</option></select><input class="form-control" name="turno" value="@e.Turno" placeholder="Turno"/><button class="btn btn-primary">Asignar</button></form></div>
@if(Model.UsuarioEsCalidad&&e.Estado=="ESPERANDO_CALIDAD"){<div class="pf-panel pf-quality"><h2>Validacion de Calidad</h2><p>La produccion permanece bloqueada hasta resolver el checklist.</p><form asp-action="ResolverCalidad" method="post" class="pf-form">@Html.AntiForgeryToken()<input type="hidden" name="id" value="@e.EjecucionProduccionID"/><textarea class="form-control" name="observaciones" required placeholder="Resultado del checklist, primer disparo y observaciones"></textarea><div class="pf-actions"><button class="btn btn-success" name="aprobado" value="true">Aprobar y liberar</button><button class="btn btn-danger" name="aprobado" value="false">Rechazar / ajuste tecnico</button></div></form></div>}
@if(e.Estado=="EN_PROCESO"){<div class="pf-panel"><h2>Registrar produccion por hora</h2><form asp-action="RegistrarHora" method="post" class="pf-form pf-hour">@Html.AntiForgeryToken()<input type="hidden" name="EjecucionID" value="@e.EjecucionProduccionID"/><label>Fecha<input class="form-control" type="date" name="Fecha" value="@DateTime.Today.ToString("yyyy-MM-dd")"/></label><label>Inicio<input class="form-control" type="time" name="HoraInicio" required/></label><label>Fin<input class="form-control" type="time" name="HoraFin" required/></label><label>OK<input class="form-control" type="number" name="OK" min="0" required/></label><label>Sospechosa<input class="form-control" type="number" name="Sospechosa" min="0" value="0"/></label><label>Scrap<input class="form-control" type="number" name="Scrap" min="0" value="0"/></label><label>Turno<input class="form-control" name="Turno" value="@e.Turno"/></label><label>Defecto<input class="form-control" name="Defecto"/></label><label>Etiqueta inicial<input class="form-control" name="EtiquetaInicial"/></label><label>Etiqueta final<input class="form-control" name="EtiquetaFinal"/></label><label class="wide">Observaciones<input class="form-control" name="Observaciones"/></label><button class="btn btn-primary wide">Guardar captura</button></form></div><div class="pf-panel"><h2>Registrar paro</h2><form asp-action="IniciarParo" method="post" class="pf-form">@Html.AntiForgeryToken()<input type="hidden" name="id" value="@e.EjecucionProduccionID"/><input class="form-control" name="motivo" required placeholder="Motivo de paro"/><textarea class="form-control" name="descripcion" required placeholder="Detalle y accion solicitada"></textarea><button class="btn btn-danger">Iniciar paro</button></form></div>}
<div class="pf-panel"><h2>Formar caja</h2><form asp-action="FormarCaja" method="post" class="pf-form">@Html.AntiForgeryToken()<input type="hidden" name="id" value="@e.EjecucionProduccionID"/><input class="form-control" name="etiqueta" required placeholder="Etiqueta unica"/><input class="form-control" type="number" name="cantidad" min="1" required placeholder="Cantidad"/><button class="btn btn-primary">Registrar caja</button></form></div>
</section>
<section class="pf-panel"><h2>Capturas por hora</h2><div class="pf-cards">@if(!Model.Capturas.Any()){<div class="pf-empty">Sin capturas.</div>}@foreach(var x in Model.Capturas){<article><strong>@x.Fecha.ToString("dd/MM") @x.Inicio.ToString("hh\\:mm")-@x.Fin.ToString("hh\\:mm")</strong><span>OK @x.OK · Sospechosa @x.Sospechosa · Scrap @x.Scrap</span><small>@x.Turno · @x.Defecto</small></article>}</div></section>
<section class="pf-panel"><h2>Paros</h2><div class="pf-cards">@if(!Model.Paros.Any()){<div class="pf-empty">Sin paros.</div>}@foreach(var x in Model.Paros){<article><strong>@x.Motivo</strong><span>@x.Inicio.ToString("dd/MM HH:mm") · @(x.Fin.HasValue?$"{x.Minutos} min":"Abierto")</span>@if(!x.Fin.HasValue){<form asp-action="CerrarParo" method="post">@Html.AntiForgeryToken()<input type="hidden" name="id" value="@e.EjecucionProduccionID"/><input type="hidden" name="paroID" value="@x.ParoID"/><button class="btn btn-sm btn-warning">Cerrar paro</button></form>}@if(x.RequiereReliberacion){<small>Requiere reliberacion de Calidad</small>}</article>}</div></section>
<section class="pf-panel"><h2>Cajas y liberacion</h2><div class="pf-cards">@if(!Model.Cajas.Any()){<div class="pf-empty">Sin cajas formadas.</div>}@foreach(var x in Model.Cajas){<article><strong>Caja @x.NumeroCaja · @x.Etiqueta</strong><span>@x.Cantidad pzas · @x.EstatusCalidad</span>@if(Model.UsuarioEsCalidad){<form asp-action="LiberarCaja" method="post" class="pf-inline">@Html.AntiForgeryToken()<input type="hidden" name="id" value="@e.EjecucionProduccionID"/><input type="hidden" name="cajaID" value="@x.CajaProduccionID"/><select class="form-select form-select-sm" name="estatus"><option>VERDE</option><option>AMARILLO</option><option>GP12</option><option>ROJO</option></select><button class="btn btn-sm btn-primary">Validar</button></form>}</article>}</div></section>
<section class="pf-panel"><h2>Historial transaccional</h2><div class="pf-timeline">@foreach(var x in Model.Eventos){<article><i></i><div><small>@x.Fecha.ToString("dd/MM/yyyy HH:mm") · @x.Usuario</small><strong>@x.Tipo.Replace("_"," ") @x.EstadoNuevo</strong><p>@x.Descripcion</p></div></article>}</div></section>
