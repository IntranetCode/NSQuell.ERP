@{
    var nombre = Context.Session.GetString("NombreMostrar") ?? Context.Session.GetString("Username") ?? "Usuario";
    var titulo = ViewData["Title"]?.ToString() ?? "Almacén";
}
<!DOCTYPE html>
<html lang="es">
<head>
<meta charset="utf-8" />
<meta name="viewport" content="width=device-width, initial-scale=1" />
<title>@titulo - NS Quell</title>
<link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css" />
<link rel="stylesheet" href="~/css/pages/almacen.css" asp-append-version="true" />
</head>
<body>
<header class="alm-top"><a href="/Menu/Index" class="alm-brand"><span><i class="fa-solid fa-warehouse"></i></span>NS QUELL · ALMACÉN</a><nav><a href="/AlmacenMP/Index">MP</a><a href="/AlmacenPT/Index">PT</a><a href="/AlmacenUbicaciones/Index">Ubicaciones</a><span>@nombre</span><a href="/Menu/Index">Menú</a></nav></header>
<main class="alm-main">
@if (TempData["AlmacenMensaje"] != null){<div class="alm-alert @TempData["AlmacenMensajeTipo"]">@TempData["AlmacenMensaje"]</div>}
@RenderBody()
</main>
<script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
@await RenderSectionAsync("Scripts", required: false)
</body>
</html>
