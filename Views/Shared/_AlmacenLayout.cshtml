@{
    var nombre = Context.Session.GetString("NombreMostrar")
        ?? Context.Session.GetString("Username")
        ?? "Usuario";

    var nombreEmpresa = Context.Session.GetString("EmpresaNombre") ?? "NS QUELL";
    var logoEmpresa = Context.Session.GetString("EmpresaLogo") ?? "default-logo.png";
    var rolUsuario = Context.Session.GetString("RolNombre") ?? "Colaborador";
    var inicialUsuario = string.IsNullOrWhiteSpace(nombre)
        ? "U"
        : nombre.Trim().Substring(0, 1).ToUpperInvariant();

    var titulo = ViewData["Title"]?.ToString() ?? "Almacén";
    var controller = ViewContext.RouteData.Values["controller"]?.ToString() ?? string.Empty;
    var action = ViewContext.RouteData.Values["action"]?.ToString() ?? "Index";

    var seccionActual = controller switch
    {
        "AlmacenMP" => "MP",
        "AlmacenEmbalajes" => "Embalajes",
        "AlmacenOF" => "OF",
        "AlmacenPT" => "PT",
        "AlmacenScrap" => "Scrap",
        "AlmacenUbicaciones" => "Ubicaciones",
        _ => "Almacenes"
    };

    // ALMACEN_BACK_ROUTES_V9_2
    var entregaOfRuta = string.Equals(
        Context.Request.Query["entregaOF"].ToString(),
        "true",
        StringComparison.OrdinalIgnoreCase);

    var numeroOfRuta = Context.Request.Query["numeroOF"].ToString().Trim();
    var tipoRuta = Context.Request.Query["tipo"].ToString().Trim();
    var returnUrlRuta = Context.Request.Query["returnUrl"].ToString().Trim();
    var returnUrlSeguro =
        !string.IsNullOrWhiteSpace(returnUrlRuta)
        && returnUrlRuta.StartsWith("/", StringComparison.Ordinal)
        && !returnUrlRuta.StartsWith("//", StringComparison.Ordinal)
            ? returnUrlRuta
            : null;
    var regresoPredeterminado = controller switch
    {
        "Almacen" => "/Menu/Grupo/1",
        "AlmacenAlmacenes" => "/Menu/Grupo/1",

        "AlmacenCompras" when
            action.Equals("Confirmar", StringComparison.OrdinalIgnoreCase)
            && returnUrlSeguro is not null
                => returnUrlSeguro,
        "AlmacenCompras" => "/Menu/Grupo/1",

        "AlmacenMP" when action.Equals("Index", StringComparison.OrdinalIgnoreCase)
            => "/Menu/Grupo/1",
        "AlmacenMP" when action.Equals("Material", StringComparison.OrdinalIgnoreCase)
            => "/AlmacenMP/Materiales",
        "AlmacenMP" when
            action.Equals("Movimiento", StringComparison.OrdinalIgnoreCase)
            && entregaOfRuta
                => "/AlmacenOF/Index",
        "AlmacenMP" => "/AlmacenMP/Index",

        "AlmacenEmbalajes" when action.Equals("Index", StringComparison.OrdinalIgnoreCase)
            => "/Menu/Grupo/1",
        "AlmacenEmbalajes" when action.Equals("Embalaje", StringComparison.OrdinalIgnoreCase)
            => "/AlmacenEmbalajes/Embalajes",
        "AlmacenEmbalajes" when
            action.Equals("Movimiento", StringComparison.OrdinalIgnoreCase)
            && entregaOfRuta
                => "/AlmacenOF/Index",
        "AlmacenEmbalajes" => "/AlmacenEmbalajes/Index",

        "AlmacenPT" when action.Equals("Index", StringComparison.OrdinalIgnoreCase)
            => "/Menu/Grupo/1",
        "AlmacenPT" when action.Equals("Configurar", StringComparison.OrdinalIgnoreCase)
            => "/AlmacenPT/NivelesStock",
        "AlmacenPT" when
            action.Equals("Entrada", StringComparison.OrdinalIgnoreCase)
            && entregaOfRuta
                => "/AlmacenOF/Index",
        "AlmacenPT" when
            action.Equals("Movimiento", StringComparison.OrdinalIgnoreCase)
            && tipoRuta.Equals("Salida", StringComparison.OrdinalIgnoreCase)
            && !string.IsNullOrWhiteSpace(numeroOfRuta)
                => "/AlmacenOF/Index",
        "AlmacenPT" => "/AlmacenPT/Index",

        "AlmacenScrap" when action.Equals("Index", StringComparison.OrdinalIgnoreCase)
            => "/Menu/Grupo/1",
        "AlmacenScrap" => "/AlmacenScrap/Index",
        "AlmacenOF" when action.Equals("Index", StringComparison.OrdinalIgnoreCase)
            => "/Menu/Grupo/1",
        "AlmacenOF" => "/AlmacenOF/Index",

        "AlmacenUbicaciones" when action.Equals("Index", StringComparison.OrdinalIgnoreCase)
            => "/Menu/Grupo/1",
        "AlmacenUbicaciones" => "/AlmacenUbicaciones/Index",

        _ => "/Menu/Grupo/1"
    };
}
