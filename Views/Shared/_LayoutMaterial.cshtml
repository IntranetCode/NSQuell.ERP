@{
    var title = ViewData["Title"] as string ?? "Altas - Materiales";
    var userName = User?.Identity?.Name ?? "Usuario";
}

<!DOCTYPE html>
<html lang="es" data-nsq-theme="light">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <title>@title - NSQuell ERP</title>

    <script>
        (function () {
            const theme = localStorage.getItem('nsq-theme') === 'dark' ? 'dark' : 'light';
            document.documentElement.setAttribute('data-nsq-theme', theme);
        })();
    </script>

    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/ERP.NSQuell.styles.css" asp-append-version="true" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.2/css/all.min.css" />

    <style>
        :root {
            --material-bg: #F4F7FB;
            --material-panel: #FFFFFF;
            --material-panel-soft: #F8FAFC;
            --material-text: #0D1929;
            --material-muted: #64748B;
            --material-line: rgba(41, 67, 95, .12);
            --material-orange: #FF8200;
            --material-red: #DA291C;
            --material-blue: #003A70;
            --material-sidebar-bg: rgba(255, 255, 255, .88);
            --material-sidebar-card: #FFFFFF;
            --material-shadow: 0 24px 70px rgba(41, 67, 95, .14);
        }

        html[data-nsq-theme="dark"] {
            --material-bg: #050B12;
            --material-panel: #0D1929;
            --material-panel-soft: #101D2F;
            --material-text: #FFFFFF;
            --material-muted: #CBD5E1;
            --material-line: rgba(255, 255, 255, .10);
            --material-sidebar-bg: #243142;
            --material-sidebar-card: #0D1929;
            --material-shadow: 0 24px 70px rgba(0, 0, 0, .35);
        }

        * {
            box-sizing: border-box;
        }

        body {
            min-height: 100vh;
            margin: 0;
            background:
                radial-gradient(circle at top right, rgba(255, 130, 0, .08), transparent 28rem),
                linear-gradient(135deg, var(--material-bg), #EEF4FA);
            color: var(--material-text);
            overflow-x: hidden;
        }

        html[data-nsq-theme="dark"] body {
            background:
                radial-gradient(circle at top right, rgba(255, 130, 0, .08), transparent 28rem),
                linear-gradient(135deg, #050B12, #0D1929);
        }

        .material-shell {
            min-height: 100vh;
            display: grid;
            grid-template-columns: 280px minmax(0, 1fr);
        }

        .material-sidebar {
            position: sticky;
            top: 0;
            height: 100vh;
            padding: 1.25rem;
            background: var(--material-sidebar-bg);
            border-right: 1px solid var(--material-line);
            overflow-y: auto;
            z-index: 20;
        }

        .material-sidebar-brand,
        .material-sidebar-back,
        .material-help-card {
            background: var(--material-sidebar-card);
            border: 1px solid var(--material-line);
            box-shadow: 0 18px 42px rgba(41, 67, 95, .08);
        }

        .material-sidebar-brand {
            display: flex;
            align-items: center;
            gap: .85rem;
            min-height: 82px;
            padding: .95rem;
            border-radius: 20px;
            margin-bottom: 1rem;
        }

        .material-sidebar-logo {
            width: 50px;
            height: 50px;
            border-radius: 16px;
            display: grid;
            place-items: center;
            color: #fff;
            background: linear-gradient(135deg, var(--material-orange), var(--material-red));
            box-shadow: 0 14px 26px rgba(255, 130, 0, .28);
            flex: 0 0 auto;
        }

        .material-sidebar-brand strong {
            display: block;
            color: var(--material-text);
            font-size: 1rem;
            line-height: 1.05;
            font-weight: 950;
        }

        .material-sidebar-brand span {
            display: block;
            margin-top: .2rem;
            color: var(--material-orange);
            font-size: .72rem;
            font-weight: 950;
            letter-spacing: .08em;
            text-transform: uppercase;
        }

        .material-sidebar-back {
            display: flex;
            align-items: center;
            gap: .75rem;
            min-height: 64px;
            padding: .85rem;
            border-radius: 18px;
            color: var(--material-text);
            text-decoration: none;
            font-weight: 950;
            transition: .2s ease;
            margin-bottom: 1.25rem;
        }

        .material-sidebar-back:hover {
            color: var(--material-text);
            transform: translateX(-2px);
        }

        .material-sidebar-back i {
            width: 36px;
            height: 36px;
            display: grid;
            place-items: center;
            border-radius: 12px;
            color: var(--material-orange);
            background: rgba(255, 130, 0, .10);
            border: 1px solid rgba(255, 130, 0, .20);
        }

        .material-sidebar-section {
            margin-top: 1rem;
        }

        .material-sidebar-title {
            display: block;
            margin: 0 0 .55rem .35rem;
            color: var(--material-muted);
            font-size: .70rem;
            font-weight: 950;
            letter-spacing: .14em;
            text-transform: uppercase;
        }

        .material-nav {
            display: grid;
            gap: .45rem;
        }

        .material-nav-link {
            min-height: 48px;
            display: flex;
            align-items: center;
            gap: .75rem;
            padding: .75rem .85rem;
            border-radius: 16px;
            color: var(--material-text);
            text-decoration: none;
            font-size: .88rem;
            font-weight: 950;
            transition: .2s ease;
        }

        .material-nav-link i {
            width: 20px;
            color: var(--material-orange);
            text-align: center;
        }

        .material-nav-link:hover {
            color: var(--material-text);
            background: rgba(255, 130, 0, .08);
            transform: translateX(2px);
        }

        .material-nav-link.is-primary {
            color: var(--material-text);
            background: rgba(255, 130, 0, .10);
            border: 1px solid rgba(255, 130, 0, .26);
        }

        .material-help-card {
            margin-top: 1.25rem;
            padding: .95rem;
            border-radius: 18px;
        }

        .material-help-card strong {
            display: block;
            color: var(--material-orange);
            font-size: .78rem;
            font-weight: 950;
        }

        .material-help-card span {
            display: block;
            margin-top: .25rem;
            color: var(--material-text);
            font-size: .80rem;
            line-height: 1.35;
            font-weight: 850;
        }

        .material-main {
            min-width: 0;
            display: flex;
            flex-direction: column;
        }

        .material-topbar-wrap {
            padding: 1.65rem 1.5rem 0;
        }

        .material-topbar {
            min-height: 84px;
            display: flex;
            align-items: center;
            justify-content: space-between;
            gap: 1rem;
            padding: 1rem 1.2rem;
            border-radius: 24px;
            background: var(--material-panel);
            border: 1px solid var(--material-line);
            box-shadow: var(--material-shadow);
        }

        .material-topbar-brand {
            display: flex;
            align-items: center;
            gap: .85rem;
            min-width: 0;
        }

        .material-topbar-logo {
            width: 48px;
            height: 48px;
            border-radius: 16px;
            display: grid;
            place-items: center;
            color: #fff;
            background: linear-gradient(135deg, var(--material-orange), var(--material-red));
            box-shadow: 0 14px 26px rgba(255, 130, 0, .24);
            flex: 0 0 auto;
        }

        .material-topbar-brand strong {
            display: inline-block;
            color: var(--material-text);
            font-size: 1rem;
            font-weight: 950;
            letter-spacing: .03em;
        }

        .material-topbar-brand span {
            display: inline-block;
            margin-left: .35rem;
            color: var(--material-orange);
            font-size: .70rem;
            font-weight: 950;
            letter-spacing: .10em;
            text-transform: uppercase;
        }

        .material-topbar-actions {
            display: flex;
            align-items: center;
            gap: .65rem;
            flex: 0 0 auto;
        }

        .material-theme-btn,
        .material-notif-btn,
        .material-user-chip {
            min-height: 42px;
            display: inline-flex;
            align-items: center;
            justify-content: center;
            gap: .5rem;
            border-radius: 999px;
            border: 1px solid var(--material-line);
            background: var(--material-panel-soft);
            color: var(--material-text);
            font-weight: 950;
        }

        .material-theme-btn,
        .material-notif-btn {
            padding: 0 .9rem;
        }

        .material-user-chip {
            padding: .55rem .85rem .55rem .55rem;
            max-width: 280px;
        }

        .material-user-avatar {
            width: 34px;
            height: 34px;
            border-radius: 50%;
            display: grid;
            place-items: center;
            background: #E8F0FB;
            color: var(--material-blue);
            font-weight: 950;
            flex: 0 0 auto;
        }

        .material-user-chip strong {
            display: block;
            max-width: 170px;
            color: var(--material-text);
            font-size: .82rem;
            font-weight: 950;
            overflow: hidden;
            text-overflow: ellipsis;
            white-space: nowrap;
        }

        .material-user-chip span {
            display: block;
            color: var(--material-orange);
            font-size: .68rem;
            font-weight: 950;
            overflow: hidden;
            text-overflow: ellipsis;
            white-space: nowrap;
        }

        .material-content {
            min-width: 0;
            flex: 1;
            padding: 1.5rem;
        }

        html[data-nsq-theme="dark"] .material-sidebar-brand,
        html[data-nsq-theme="dark"] .material-sidebar-back,
        html[data-nsq-theme="dark"] .material-help-card,
        html[data-nsq-theme="dark"] .material-topbar {
            background: #0D1929;
        }

        html[data-nsq-theme="dark"] .material-user-avatar {
            background: #E8F0FB;
            color: #003A70;
        }

        @@media (max-width: 1080px) {
            .material-shell {
                grid-template-columns: 1fr;
            }

            .material-sidebar {
                position: relative;
                height: auto;
                border-right: 0;
                border-bottom: 1px solid var(--material-line);
            }

            .material-nav {
                grid-template-columns: repeat(2, minmax(0, 1fr));
            }

            .material-topbar-wrap {
                padding: 1rem 1rem 0;
            }

            .material-content {
                padding: 1rem;
            }
        }

        @@media (max-width: 680px) {
            .material-nav {
                grid-template-columns: 1fr;
            }

            .material-topbar {
                align-items: flex-start;
                flex-direction: column;
            }

            .material-topbar-actions {
                width: 100%;
                justify-content: space-between;
                flex-wrap: wrap;
            }

            .material-user-chip {
                max-width: 100%;
            }
        }
    </style>

    @RenderSection("Styles", required: false)
</head>

<body>
    <div class="material-shell">
        <aside class="material-sidebar">
            <div class="material-sidebar-brand">
                <div class="material-sidebar-logo">
                    <i class="fas fa-cubes-stacked"></i>
                </div>

                <div>
                    <strong>NS GROUP</strong>
                    <span>ERP Suite</span>
                </div>
            </div>

            <a asp-controller="Menu"
               asp-action="Grupo"
               asp-route-id="8"
               class="material-sidebar-back">
                <i class="fas fa-arrow-left"></i>
                Volver a Altas
            </a>

            <div class="material-sidebar-section">
                <span class="material-sidebar-title">Altas - Materiales</span>

                <nav class="material-nav">
                    <a href="/Material/Index" class="material-nav-link is-primary">
                        <i class="fas fa-boxes-stacked"></i>
                        Catálogo de materiales
                    </a>

                    <a href="/Material/Index?estadoFiltro=activos" class="material-nav-link">
                        <i class="fas fa-check-circle"></i>
                        Materiales activos
                    </a>

                    <a href="/Material/Index?estadoFiltro=inactivos" class="material-nav-link">
                        <i class="fas fa-ban"></i>
                        Materiales inactivos
                    </a>

                    <a href="/Material/Index?estadoFiltro=stock" class="material-nav-link">
                        <i class="fas fa-warehouse"></i>
                        Stock configurado
                    </a>

                    <a href="/Material/Index?estadoFiltro=costo" class="material-nav-link">
                        <i class="fas fa-dollar-sign"></i>
                        Con costo
                    </a>

                    <a href="/Material/Index?estadoFiltro=lote" class="material-nav-link">
                        <i class="fas fa-barcode"></i>
                        Requiere lote
                    </a>
                </nav>
            </div>

            <div class="material-help-card">
                <strong>Identificación:</strong>
                <span>
                    Código, nombre, tipo, unidad, proveedor, stock, lote y costo del material.
                </span>
            </div>
        </aside>

        <main class="material-main">
            <div class="material-topbar-wrap">
                <header class="material-topbar">
                    <div class="material-topbar-brand">
                        <div class="material-topbar-logo">
                            <i class="fas fa-building"></i>
                        </div>

                        <div>
                            <strong>NS GROUP</strong>
                            <span>ERP Suite</span>
                        </div>
                    </div>

                    <div class="material-topbar-actions">
                        <button type="button" class="material-theme-btn" id="materialThemeToggle" title="Cambiar tema">
                            <i class="fas fa-moon"></i>
                            <span>Oscuro</span>
                        </button>

                        <button type="button" class="material-notif-btn" title="Notificaciones">
                            <i class="fas fa-bell"></i>
                        </button>

                        <div class="material-user-chip">
                            <div class="material-user-avatar">
                                @(string.IsNullOrWhiteSpace(userName) ? "U" : userName.Substring(0, 1).ToUpperInvariant())
                            </div>

                            <div>
                                <strong>@userName</strong>
                                <span>Administrador de ERP</span>
                            </div>

                            <i class="fas fa-chevron-down"></i>
                        </div>
                    </div>
                </header>
            </div>

            <section class="material-content">
                @RenderBody()
            </section>
        </main>
    </div>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>

    <script>
        (function () {
            const btn = document.getElementById('materialThemeToggle');

            function applyTheme(theme) {
                const selectedTheme = theme === 'dark' ? 'dark' : 'light';

                document.documentElement.setAttribute('data-nsq-theme', selectedTheme);
                document.body.classList.remove('nsq-theme-light', 'nsq-theme-dark');
                document.body.classList.add(selectedTheme === 'dark' ? 'nsq-theme-dark' : 'nsq-theme-light');

                localStorage.setItem('nsq-theme', selectedTheme);

                if (btn) {
                    btn.innerHTML = selectedTheme === 'dark'
                        ? '<i class="fas fa-sun"></i><span>Claro</span>'
                        : '<i class="fas fa-moon"></i><span>Oscuro</span>';
                }
            }

            const currentTheme = localStorage.getItem('nsq-theme') === 'dark' ? 'dark' : 'light';
            applyTheme(currentTheme);

            if (btn) {
                btn.addEventListener('click', function () {
                    const actual = document.documentElement.getAttribute('data-nsq-theme') === 'dark' ? 'dark' : 'light';
                    applyTheme(actual === 'dark' ? 'light' : 'dark');
                });
            }
        })();
    </script>

    @RenderSection("Scripts", required: false)
</body>
</html>