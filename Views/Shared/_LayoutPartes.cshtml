@using System.Security.Claims
@using Microsoft.AspNetCore.Http

@{
    var nombreUsuario =
        Context.Session.GetString("NombreMostrar")
        ?? Context.Session.GetString("Username")
        ?? User?.Identity?.Name
        ?? "Usuario";

    var rolUsuario =
        Context.Session.GetString("Rol")
        ?? Context.Session.GetString("NombreRol")
        ?? User?.FindFirst(ClaimTypes.Role)?.Value
        ?? "Colaborador";

    string inicialUsuario = string.IsNullOrWhiteSpace(nombreUsuario)
        ? "U"
        : nombreUsuario.Trim().Substring(0, 1).ToUpper();

    var estadoFiltro = Context.Request.Query["estadoFiltro"].ToString().ToLowerInvariant();

    bool EsActivo(string filtro)
    {
        if (string.IsNullOrWhiteSpace(filtro))
            return string.IsNullOrWhiteSpace(estadoFiltro);

        return estadoFiltro == filtro.ToLowerInvariant();
    }
}

<!DOCTYPE html>
<html lang="es" data-nsq-theme="light">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <title>@ViewData["Title"] - ERP NSQuell</title>

    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.2/css/all.min.css" />

    @RenderSection("Styles", required: false)

    <style>
        :root {
            --nsq-orange: #FF8200;
            --nsq-orange-dark: #DA291C;
            --nsq-dark: #0D1929;
            --nsq-dark-2: #1A2A40;
            --nsq-blue: #003A70;
            --nsq-soft: #F4F6F9;
            --nsq-muted: #64748B;
            --nsq-border: rgba(41, 67, 95, .12);
            --sidebar-width: 280px;
        }

        * { box-sizing: border-box; }
        html, body { min-height: 100%; }

        body {
            margin: 0;
            font-family: "Inter", "Segoe UI", system-ui, -apple-system, BlinkMacSystemFont, sans-serif;
            background:
                radial-gradient(circle at 95% 8%, rgba(0, 83, 155, .12), transparent 30%),
                radial-gradient(circle at 3% 0%, rgba(255, 130, 0, .09), transparent 28%),
                linear-gradient(135deg, #F4F6F9 0%, #EAEDF2 48%, #EEF4FA 100%);
            color: var(--nsq-dark);
            overflow-x: hidden;
        }

        .altas-shell {
            min-height: 100vh;
            display: grid;
            grid-template-columns: var(--sidebar-width) minmax(0, 1fr);
        }

        .altas-sidebar {
            position: sticky;
            top: 0;
            height: 100vh;
            padding: 1.15rem;
            background: rgba(255, 255, 255, .88);
            border-right: 1px solid var(--nsq-border);
            box-shadow: 18px 0 48px rgba(41, 67, 95, .10);
            backdrop-filter: blur(16px);
            overflow-y: auto;
            z-index: 80;
        }

        .sidebar-logo-card {
            display: flex;
            align-items: center;
            gap: .9rem;
            padding: 1rem;
            min-height: 74px;
            border-radius: 20px;
            background: rgba(255,255,255,.96);
            border: 1px solid rgba(41, 67, 95, .10);
            box-shadow: 0 16px 34px rgba(41, 67, 95, .10);
        }

        .sidebar-logo-icon,
        .topbar-brand-icon {
            display: grid;
            place-items: center;
            background: linear-gradient(135deg, var(--nsq-orange), var(--nsq-orange-dark));
            color: #fff;
            box-shadow: 0 14px 26px rgba(244, 123, 32, .30);
        }

        .sidebar-logo-icon {
            width: 52px;
            height: 52px;
            border-radius: 17px;
            font-size: 1.25rem;
        }

        .sidebar-logo-title {
            margin: 0;
            color: var(--nsq-dark);
            font-size: 1rem;
            font-weight: 950;
            letter-spacing: .04em;
        }

        .sidebar-logo-sub {
            display: block;
            color: var(--nsq-orange);
            font-size: .72rem;
            font-weight: 950;
            letter-spacing: .08em;
            text-transform: uppercase;
        }

        .sidebar-back {
            display: flex;
            align-items: center;
            gap: .85rem;
            margin-top: 1rem;
            padding: .95rem 1rem;
            border-radius: 20px;
            background: rgba(255,255,255,.94);
            border: 1px solid rgba(41, 67, 95, .10);
            color: var(--nsq-dark);
            text-decoration: none;
            font-weight: 950;
            box-shadow: 0 14px 28px rgba(41, 67, 95, .08);
            transition: .2s ease;
        }

        .sidebar-back:hover {
            color: var(--nsq-dark);
            background: #FFF4E8;
            border-color: rgba(255, 130, 0, .26);
            transform: translateX(-2px);
        }

        .sidebar-back-icon {
            width: 40px;
            height: 40px;
            display: grid;
            place-items: center;
            border-radius: 14px;
            background: #FFF4E8;
            color: var(--nsq-orange);
            border: 1px solid rgba(255, 130, 0, .20);
        }

        .sidebar-section-label {
            margin: 1.7rem .35rem .75rem;
            color: #64748B;
            font-size: .78rem;
            font-weight: 950;
            letter-spacing: .13em;
            text-transform: uppercase;
        }

        .sidebar-nav {
            display: grid;
            gap: .55rem;
        }

        .sidebar-link {
            display: flex;
            align-items: center;
            gap: .8rem;
            padding: .85rem 1rem;
            border-radius: 17px;
            color: #29435F;
            text-decoration: none;
            font-weight: 950;
            border: 1px solid transparent;
            transition: .2s ease;
        }

        .sidebar-link i {
            width: 18px;
            text-align: center;
            color: var(--nsq-orange);
        }

        .sidebar-link:hover,
        .sidebar-link.active {
            color: var(--nsq-dark);
            background: #FFF4E8;
            border-color: rgba(255, 130, 0, .24);
        }

        .sidebar-info {
            margin-top: 1.2rem;
            padding: 1rem;
            border-radius: 18px;
            background: rgba(255,255,255,.9);
            border: 1px solid rgba(41, 67, 95, .10);
            color: var(--nsq-dark);
            box-shadow: 0 14px 28px rgba(41, 67, 95, .08);
        }

        .sidebar-info strong {
            display: block;
            color: var(--nsq-orange);
            font-size: .82rem;
            font-weight: 950;
        }

        .sidebar-info span {
            display: block;
            margin-top: .25rem;
            color: var(--nsq-dark);
            font-size: .8rem;
            font-weight: 850;
            line-height: 1.35;
        }

        .altas-main {
            min-width: 0;
            padding: 1.6rem 1.8rem 3rem;
        }

        .altas-topbar {
            width: min(100%, 1480px);
            min-height: 78px;
            margin: 0 auto 1.7rem;
            padding: .85rem 1rem;
            display: flex;
            align-items: center;
            justify-content: space-between;
            gap: 1rem;
            border-radius: 28px;
            background: rgba(255,255,255,.86);
            border: 1px solid rgba(41, 67, 95, .10);
            box-shadow: 0 18px 50px rgba(41, 67, 95, .12);
            backdrop-filter: blur(18px);
        }

        .topbar-brand {
            display: flex;
            align-items: center;
            gap: .9rem;
            min-width: 0;
        }

        .topbar-brand-icon {
            width: 48px;
            height: 48px;
            border-radius: 16px;
        }

        .topbar-brand-title {
            color: var(--nsq-dark);
            font-weight: 950;
            letter-spacing: .04em;
            white-space: nowrap;
        }

        .topbar-brand-title span {
            color: var(--nsq-orange);
            font-size: .75rem;
            margin-left: .35rem;
            letter-spacing: .08em;
        }

        .topbar-actions {
            display: flex;
            align-items: center;
            gap: .65rem;
        }

        .theme-switcher,
        .topbar-notif,
        .topbar-user {
            border: 1px solid rgba(41, 67, 95, .10);
            background: rgba(255,255,255,.92);
            color: var(--nsq-dark);
            box-shadow: 0 10px 24px rgba(41, 67, 95, .08);
        }

        .theme-switcher,
        .topbar-notif {
            min-height: 44px;
            border-radius: 999px;
            display: inline-flex;
            align-items: center;
            justify-content: center;
            gap: .45rem;
            padding: 0 .9rem;
            font-weight: 950;
            font-size: .82rem;
        }

        .topbar-notif {
            width: 44px;
            padding: 0;
            color: var(--nsq-orange);
        }

        .topbar-user {
            min-height: 52px;
            display: flex;
            align-items: center;
            gap: .8rem;
            padding: .45rem .9rem .45rem .5rem;
            border-radius: 999px;
        }

        .topbar-user-avatar {
            width: 42px;
            height: 42px;
            border-radius: 50%;
            display: grid;
            place-items: center;
            background: #E8F0FB;
            color: var(--nsq-dark);
            font-weight: 950;
        }

        .topbar-user-name {
            display: block;
            color: var(--nsq-dark);
            font-size: .88rem;
            font-weight: 950;
            line-height: 1;
        }

        .topbar-user-role {
            display: block;
            margin-top: .15rem;
            color: var(--nsq-orange);
            font-size: .72rem;
            font-weight: 950;
        }

        html[data-nsq-theme="dark"],
        html[data-nsq-theme="dark"] body {
            background:
                radial-gradient(circle at 92% 8%, rgba(105, 183, 255, .10), transparent 30%),
                radial-gradient(circle at 4% 0%, rgba(255, 130, 0, .10), transparent 28%),
                linear-gradient(135deg, #0A0F1A 0%, #06111F 50%, #020810 100%);
            color: #fff;
        }

        html[data-nsq-theme="dark"] .altas-sidebar,
        html[data-nsq-theme="dark"] .altas-topbar,
        html[data-nsq-theme="dark"] .sidebar-logo-card,
        html[data-nsq-theme="dark"] .sidebar-back,
        html[data-nsq-theme="dark"] .sidebar-info,
        html[data-nsq-theme="dark"] .theme-switcher,
        html[data-nsq-theme="dark"] .topbar-notif,
        html[data-nsq-theme="dark"] .topbar-user {
            background: rgba(13, 25, 41, .86);
            border-color: rgba(255,255,255,.08);
            color: #fff;
        }

        html[data-nsq-theme="dark"] .sidebar-logo-title,
        html[data-nsq-theme="dark"] .sidebar-back,
        html[data-nsq-theme="dark"] .sidebar-info span,
        html[data-nsq-theme="dark"] .topbar-brand-title,
        html[data-nsq-theme="dark"] .topbar-user-name {
            color: #fff;
        }

        html[data-nsq-theme="dark"] .sidebar-link { color: #DCE8F5; }

        html[data-nsq-theme="dark"] .sidebar-link:hover,
        html[data-nsq-theme="dark"] .sidebar-link.active {
            color: #fff;
            background: rgba(255, 130, 0, .12);
            border-color: rgba(255, 130, 0, .24);
        }

        @@media (max-width: 1024px) {
            .altas-shell { grid-template-columns: 1fr; }
            .altas-sidebar { position: relative; height: auto; display: block; }
            .altas-main { padding: 1rem; }
        }

        @@media (max-width: 720px) {
            .altas-topbar { align-items: flex-start; flex-direction: column; }
            .topbar-actions { width: 100%; justify-content: space-between; }
            .topbar-user { max-width: 100%; }
        }
    </style>
</head>

<body>
    <div class="altas-shell">
        <aside class="altas-sidebar">
            <div class="sidebar-logo-card">
                <div class="sidebar-logo-icon"><i class="fas fa-building"></i></div>
                <div>
                    <h1 class="sidebar-logo-title">NS GROUP</h1>
                    <span class="sidebar-logo-sub">ERP Suite</span>
                </div>
            </div>

            <a class="sidebar-back" href="@Url.Action("Grupo", "Menu", new { id = 8 })">
                <span class="sidebar-back-icon"><i class="fas fa-arrow-left"></i></span>
                <span>Volver a Altas</span>
            </a>

            <div class="sidebar-section-label">Altas - Partes</div>

            <nav class="sidebar-nav">
                <a class="sidebar-link @(EsActivo("") ? "active" : "")" href="@Url.Action("Index", "Partes")">
                    <i class="fas fa-cubes"></i><span>Catálogo de partes</span>
                </a>

                <a class="sidebar-link @(EsActivo("activas") ? "active" : "")" href="@Url.Action("Index", "Partes", new { estadoFiltro = "activas" })">
                    <i class="fas fa-check-circle"></i><span>Partes activas</span>
                </a>

                <a class="sidebar-link @(EsActivo("inactivas") ? "active" : "")" href="@Url.Action("Index", "Partes", new { estadoFiltro = "inactivas" })">
                    <i class="fas fa-ban"></i><span>Partes inactivas</span>
                </a>

                <a class="sidebar-link @(EsActivo("stock") ? "active" : "")" href="@Url.Action("Index", "Partes", new { estadoFiltro = "stock" })">
                    <i class="fas fa-boxes-stacked"></i><span>Stock configurado</span>
                </a>


            </nav>

            <div class="sidebar-info">
                <strong>Identificación:</strong>
                <span>Número de parte, cliente, máquina, molde, stock y estado.</span>
            </div>
        </aside>

        <main class="altas-main">
            <header class="altas-topbar">
                <div class="topbar-brand">
                    <div class="topbar-brand-icon"><i class="fas fa-building"></i></div>
                    <div class="topbar-brand-title">NS GROUP <span>ERP SUITE</span></div>
                </div>

                <div class="topbar-actions">
                    <button type="button" class="theme-switcher" id="btnThemeToggle" aria-label="Cambiar tema">
                        <i class="fas fa-moon" id="themeToggleIcon"></i>
                        <span id="themeToggleText">Oscuro</span>
                    </button>

                    <button type="button" class="topbar-notif" aria-label="Notificaciones">
                        <i class="fas fa-bell"></i>
                    </button>

                    <div class="topbar-user">
                        <div class="topbar-user-avatar">@inicialUsuario</div>
                        <div>
                            <span class="topbar-user-name">@nombreUsuario</span>
                            <span class="topbar-user-role">@rolUsuario</span>
                        </div>
                        <i class="fas fa-chevron-down"></i>
                    </div>
                </div>
            </header>

            @RenderBody()
        </main>
    </div>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>

    <script>
        (function () {
            const root = document.documentElement;
            const body = document.body;
            const btn = document.getElementById('btnThemeToggle');
            const icon = document.getElementById('themeToggleIcon');
            const text = document.getElementById('themeToggleText');
            const storageKey = 'nsq-theme';

            function applyTheme(theme) {
                const selectedTheme = theme === 'dark' ? 'dark' : 'light';
                root.setAttribute('data-nsq-theme', selectedTheme);
                body.classList.toggle('nsq-theme-dark', selectedTheme === 'dark');
                body.classList.toggle('nsq-theme-light', selectedTheme !== 'dark');

                if (icon) icon.className = selectedTheme === 'dark' ? 'fas fa-sun' : 'fas fa-moon';
                if (text) text.textContent = selectedTheme === 'dark' ? 'Claro' : 'Oscuro';
                localStorage.setItem(storageKey, selectedTheme);
            }

            applyTheme(localStorage.getItem(storageKey) || 'light');

            if (btn) {
                btn.addEventListener('click', function () {
                    const current = root.getAttribute('data-nsq-theme') === 'dark' ? 'dark' : 'light';
                    applyTheme(current === 'dark' ? 'light' : 'dark');
                });
            }
        })();
    </script>

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
