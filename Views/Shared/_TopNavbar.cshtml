@using System.Security.Claims
@using Microsoft.AspNetCore.Http

@{
    // Datos dinámicos de sesión / claims
    var nombreUsuario = Context.Session.GetString("NombreMostrar")
        ?? Context.Session.GetString("Username")
        ?? User.FindFirst(ClaimTypes.Name)?.Value
        ?? "Invitado";

    var nombreEmpresa = Context.Session.GetString("EmpresaNombre") ?? "NS Group";
    var logoEmpresa = "logo-quell.png";

    var rolUsuario = Context.Session.GetString("Rol")
        ?? Context.Session.GetString("NombreRol")
        ?? User.FindFirst(ClaimTypes.Role)?.Value
        ?? "Colaborador";

    var inicialUsuario = !string.IsNullOrWhiteSpace(nombreUsuario)
        ? nombreUsuario.Trim().Substring(0, 1).ToUpper()
        : "U";
}


@* PLANEACION_NAV_GLOBAL_V1_2_RUTAS *@
@{
    var plnController = ViewContext.RouteData.Values["controller"]?.ToString() ?? string.Empty;
    var plnAction = ViewContext.RouteData.Values["action"]?.ToString() ?? "Index";

    // NSQ_NAVBAR_GLOBAL_OPERADOR_V3
    var esProduccionOperador =
        plnController.Equals("ProduccionOperador", StringComparison.OrdinalIgnoreCase);

    var navbarHomeUrl = esProduccionOperador
        ? (Url.Action("Index", "ProduccionOperador") ?? "/ProduccionOperador/Index")
        : (Url.Action("Index", "Menu") ?? "/Menu/Index");

    var navbarTitulo = esProduccionOperador ? "NS QUELL" : nombreEmpresa;

    var plnEsModulo =
        plnController.StartsWith("Planeacion", StringComparison.OrdinalIgnoreCase);

    var plnSeccion =
        plnController.StartsWith("PlaneacionRelease", StringComparison.OrdinalIgnoreCase)
            ? "Releases"
            : plnController.StartsWith("PlaneacionCalendarioMaquinas", StringComparison.OrdinalIgnoreCase)
                ? "Calendario"
                : plnController.StartsWith("PlaneacionPrograma", StringComparison.OrdinalIgnoreCase)
                    ? (plnAction.Equals("CalendarioMaquinas", StringComparison.OrdinalIgnoreCase) ? "Calendario" : "Programa")
                    : plnController.StartsWith("PlaneacionPanorama", StringComparison.OrdinalIgnoreCase)
                        ? "Panorama"
                        : plnController.StartsWith("Planeacion", StringComparison.OrdinalIgnoreCase)
                            ? "OF"
                            : "Planeacion";
}
