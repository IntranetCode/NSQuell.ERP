@{
    var title = ViewData["Title"] as string ?? "ERP";
    var userName = User?.Identity?.Name ?? "Usuario";
    var userRole = ViewData["UserRole"] as string ?? "Colaborador";
    var initial = !string.IsNullOrWhiteSpace(userName) ? userName.Substring(0, 1).ToUpper() : "U";
}

<!DOCTYPE html>
<html lang="es-mx">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <title>@title - NS Quell</title>

    <!-- Bootstrap -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet" />

    <style>
            :root {
                --ns-blue: #0b4f8f;
                --ns-blue-dark: #073763;
                --ns-blue-soft: #eaf3fb;

                --ns-orange: #ff7a00;
                --ns-orange-dark: #e85d04;
                --ns-orange-soft: #fff4e8;

                --erp-bg: #f4f7fb;
                --erp-white: #ffffff;
                --erp-text: #1f2937;
                --erp-muted: #6b7280;
                --erp-border: #e5e7eb;
                --erp-shadow: 0 14px 34px rgba(15, 23, 42, 0.08);
            }

            * {
                box-sizing: border-box;
            }

            html,
            body {
                min-height: 100%;
            }

            body {
                margin: 0;
                font-family: "Segoe UI", Arial, sans-serif;
                color: var(--erp-text);
                background:
                    radial-gradient(circle at 8% 10%, rgba(11, 79, 143, 0.08), transparent 26%),
                    radial-gradient(circle at 92% 12%, rgba(255, 122, 0, 0.08), transparent 24%),
                    linear-gradient(180deg, #f8fafc 0%, var(--erp-bg) 100%);
            }

            a {
                color: inherit;
            }

            .erp-layout {
                min-height: 100vh;
                padding: clamp(14px, 2vw, 24px);
            }

            .erp-shell {
                width: 100%;
                max-width: 1280px;
                margin: 0 auto;
            }

            .erp-topbar {
                position: relative;
                overflow: hidden;
                background: linear-gradient(135deg, var(--ns-blue-dark), var(--ns-blue));
                border: 1px solid rgba(255, 255, 255, 0.16);
                border-radius: 26px;
                padding: 12px 16px;
                margin-bottom: 20px;
                box-shadow: 0 18px 40px rgba(7, 55, 99, 0.22);
            }

            .erp-topbar::before {
                content: "";
                position: absolute;
                width: 220px;
                height: 220px;
                right: -80px;
                top: -105px;
                border-radius: 999px;
                background: rgba(255, 122, 0, 0.18);
                pointer-events: none;
            }

            .erp-topbar::after {
                content: "";
                position: absolute;
                width: 100%;
                height: 4px;
                left: 0;
                bottom: 0;
                background: linear-gradient(90deg, var(--ns-orange), rgba(255, 122, 0, 0.25), transparent);
                pointer-events: none;
            }

            .erp-navbar {
                position: relative;
                z-index: 2;
            }

            .erp-brand {
                display: flex;
                align-items: center;
                gap: 12px;
                text-decoration: none;
                color: white;
            }

            .erp-logo-box {
                width: 52px;
                height: 52px;
                border-radius: 17px;
                background: #ffffff;
                display: flex;
                align-items: center;
                justify-content: center;
                padding: 6px;
                box-shadow: 0 10px 24px rgba(0, 0, 0, 0.16);
                flex: 0 0 auto;
            }

            .erp-logo-box img {
                max-width: 100%;
                max-height: 100%;
                object-fit: contain;
                display: block;
            }

            .erp-brand-title {
                margin: 0;
                font-size: 16px;
                font-weight: 900;
                color: #ffffff;
                letter-spacing: 0.02em;
                line-height: 1.1;
            }

            .erp-brand-suite {
                color: #ffbd76;
                font-size: 10px;
                font-weight: 900;
                letter-spacing: 0.14em;
                margin-left: 6px;
            }

            .erp-brand-subtitle {
                color: rgba(255, 255, 255, 0.78);
                font-size: 11px;
                font-weight: 600;
                margin-top: 3px;
            }

            .erp-navbar-toggler {
                border: 1px solid rgba(255, 255, 255, 0.28);
                border-radius: 14px;
                padding: 8px 10px;
                color: white;
            }

            .erp-navbar-toggler:focus {
                box-shadow: 0 0 0 0.2rem rgba(255, 122, 0, 0.25);
            }

            .erp-navbar-toggler-icon {
                width: 22px;
                height: 2px;
                background: white;
                display: block;
                position: relative;
                border-radius: 999px;
            }

            .erp-navbar-toggler-icon::before,
            .erp-navbar-toggler-icon::after {
                content: "";
                position: absolute;
                left: 0;
                width: 22px;
                height: 2px;
                background: white;
                border-radius: 999px;
            }

            .erp-navbar-toggler-icon::before {
                top: -7px;
            }

            .erp-navbar-toggler-icon::after {
                top: 7px;
            }

            .erp-nav {
                display: flex;
                align-items: center;
                gap: 8px;
            }

            .erp-nav-link {
                color: rgba(255, 255, 255, 0.88);
                text-decoration: none;
                font-size: 12px;
                font-weight: 800;
                padding: 9px 13px;
                border-radius: 999px;
                background: rgba(255, 255, 255, 0.08);
                border: 1px solid rgba(255, 255, 255, 0.12);
                transition: all 0.2s ease;
                white-space: nowrap;
            }

            .erp-nav-link:hover {
                color: #ffffff;
                background: rgba(255, 122, 0, 0.25);
                border-color: rgba(255, 122, 0, 0.35);
                transform: translateY(-1px);
            }

            .erp-user {
                display: flex;
                align-items: center;
                gap: 10px;
                padding: 7px 13px 7px 7px;
                border-radius: 999px;
                background: rgba(255, 255, 255, 0.12);
                border: 1px solid rgba(255, 255, 255, 0.22);
                min-width: 200px;
                backdrop-filter: blur(10px);
            }

            .erp-user-avatar {
                width: 38px;
                height: 38px;
                border-radius: 999px;
                background: #ffffff;
                color: var(--ns-blue);
                display: flex;
                align-items: center;
                justify-content: center;
                font-weight: 900;
                flex: 0 0 auto;
            }

            .erp-user-name {
                font-size: 13px;
                font-weight: 900;
                color: #ffffff;
                line-height: 1.1;
            }

            .erp-user-role {
                font-size: 11px;
                color: #ffbd76;
                font-weight: 800;
            }

            .erp-content {
                min-height: calc(100vh - 150px);
            }

            .erp-footer {
                margin-top: 26px;
                color: var(--erp-muted);
                font-size: 12px;
                text-align: center;
                padding: 12px;
            }

            .erp-page-breadcrumb {
                background: var(--erp-white);
                border: 1px solid var(--erp-border);
                border-left: 5px solid var(--ns-orange);
                border-radius: 18px;
                padding: 13px 16px;
                margin-bottom: 18px;
                display: flex;
                align-items: center;
                gap: 10px;
                color: var(--erp-muted);
                box-shadow: 0 10px 24px rgba(15, 23, 42, 0.05);
                flex-wrap: wrap;
            }

            .erp-btn-back {
                border: 1px solid #ffd2a3;
                background: var(--ns-orange-soft);
                color: var(--ns-orange-dark);
                border-radius: 14px;
                padding: 9px 16px;
                text-decoration: none;
                font-weight: 900;
                transition: all 0.2s ease;
            }

            .erp-btn-back:hover {
                color: white;
                background: var(--ns-orange);
                border-color: var(--ns-orange);
                transform: translateY(-1px);
            }

            @@media (max-width: 991.98px) {
                .erp-topbar {
                    border-radius: 22px;
                }

                .erp-brand-title {
                    font-size: 15px;
                }

                .erp-brand-subtitle {
                    font-size: 10px;
                }

                .erp-nav {
                    width: 100%;
                    flex-direction: column;
                    align-items: stretch;
                    margin-top: 14px;
                    gap: 8px;
                }

                .erp-nav-link {
                    width: 100%;
                    display: block;
                    text-align: center;
                    border-radius: 14px;
                }

                .erp-user {
                    width: 100%;
                    margin-top: 12px;
                    border-radius: 16px;
                }
            }

            @@media (max-width: 575.98px) {
                .erp-layout {
                    padding: 12px;
                }

                .erp-logo-box {
                    width: 46px;
                    height: 46px;
                    border-radius: 15px;
                }

                .erp-brand-suite {
                    display: block;
                    margin-left: 0;
                    margin-top: 3px;
                }

                .erp-page-breadcrumb {
                    padding: 12px;
                    border-radius: 16px;
                }

                .erp-btn-back {
                    width: 100%;
                    text-align: center;
                }
            }
    </style>

    @RenderSection("Styles", required: false)
</head>

<body>
    <div class="erp-layout">
        <div class="erp-shell">

            <header class="erp-topbar">
                <nav class="navbar navbar-expand-lg erp-navbar p-0">
                    <div class="container-fluid p-0">

                        <a class="erp-brand" href="@Url.Action("Index", "Menu")">
                            <div class="erp-logo-box">
                                <img src="@Url.Content("~/Imagenes/logo-quell.png")" alt="NS Quell" />
                            </div>

                            <div>
                                <p class="erp-brand-title">
                                    NS QUELL
                                    <span class="erp-brand-suite">ERP SUITE</span>
                                </p>
                                <div class="erp-brand-subtitle">
                                    Sistema interno de gestión
                                </div>
                            </div>
                        </a>

                        <button class="navbar-toggler erp-navbar-toggler"
                                type="button"
                                data-bs-toggle="collapse"
                                data-bs-target="#erpMainNavbar"
                                aria-controls="erpMainNavbar"
                                aria-expanded="false"
                                aria-label="Abrir menú">
                            <span class="erp-navbar-toggler-icon"></span>
                        </button>

                        <div class="collapse navbar-collapse justify-content-end" id="erpMainNavbar">
                            <div class="erp-nav me-lg-3">
                                <a class="erp-nav-link" href="@Url.Action("Index", "Menu")">Inicio</a>
                                <a class="erp-nav-link" href="@Url.Action("Index", "Compras")">Compras</a>
                                <a class="erp-nav-link" href="@Url.Action("Solicitudes", "Compras")">Solicitudes</a>
                            </div>

                            <div class="erp-user">
                                <div class="erp-user-avatar">@initial</div>
                                <div>
                                    <div class="erp-user-name">@userName</div>
                                    <div class="erp-user-role">@userRole</div>
                                </div>
                            </div>
                        </div>

                    </div>
                </nav>
            </header>

            <main class="erp-content">
                @RenderBody()
            </main>

            <footer class="erp-footer">
                ERP NS Quell © @DateTime.Now.Year
            </footer>

        </div>
    </div>

    <!-- Bootstrap -->
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>

    @RenderSection("Scripts", required: false)
</body>
</html>