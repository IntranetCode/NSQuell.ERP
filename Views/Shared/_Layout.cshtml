@{
    var title = ViewData["Title"] as string ?? "ERP NSQuell";
}

<!DOCTYPE html>
<html lang="es" data-nsq-theme="dark">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <title>@title</title>

    <script>
        (function () {
            const STORAGE_KEY = 'nsq-theme';
            const savedTheme = localStorage.getItem(STORAGE_KEY) || 'dark';
            const theme = savedTheme === 'light' ? 'light' : 'dark';
            const root = document.documentElement;

            // Tema oficial del ERP.
            root.setAttribute('data-nsq-theme', theme);

            // Puente de compatibilidad para vistas/componentes Bootstrap 5.3+.
            root.setAttribute('data-bs-theme', theme);

            // Ayuda a que controles nativos del navegador acompañen el tema.
            root.style.colorScheme = theme;

            // Disponible durante la carga inicial antes de DOMContentLoaded.
            window.__NSQ_INITIAL_THEME__ = theme;
        })();
    </script>

    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/ERP.NSQuell.styles.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/nsquell-erp-theme.css" asp-append-version="true" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.2/css/all.min.css" />

    @RenderSection("Styles", required: false)

    <style>
        :root {
            --nsq-z-navbar: 3000;
            --nsq-z-alert: 8000;
            --nsq-z-modal-backdrop: 9000;
            --nsq-z-modal: 9010;
        }

        html,
        body {
            min-height: 100%;
            margin: 0;
            font-family: "Inter", "Segoe UI", system-ui, -apple-system, BlinkMacSystemFont, sans-serif;
        }

        /* El fondo oficial Claro/Oscuro lo define nsquell-erp-theme.css,
           exactamente igual que en Menu/Index. Este Layout no compite con él. */
        body {
            color: var(--ink, #0d1929);
            overflow-x: hidden;
        }

        html[data-nsq-theme="dark"] body {
            color: var(--ink, #f8fafc);
        }

        .global-layout-shell {
            min-height: 100vh;
            width: 100%;
        }

        .global-navbar-host {
            width: 100%;
            padding: clamp(1rem, 1.6vw, 1.45rem) clamp(1rem, 2vw, 1.75rem) 0;
            background: transparent;
            position: relative;
            z-index: var(--nsq-z-navbar);
        }

        .global-render-host {
            width: 100%;
            min-height: calc(100vh - 100px);
            padding: clamp(1rem, 1.6vw, 1.5rem);
        }

        .global-render-host > .container,
        .global-render-host > .container-fluid {
            max-width: none;
        }

        #global-success-alert {
            position: fixed;
            top: 20px;
            right: 20px;
            z-index: var(--nsq-z-alert);
            min-width: 300px;
            border-radius: 16px;
            border-left: 5px solid #22c55e;
            box-shadow: 0 18px 45px rgba(0, 0, 0, .18);
        }

        #global-error-alert {
            position: fixed;
            top: 20px;
            right: 20px;
            z-index: var(--nsq-z-alert);
            min-width: 300px;
            border-radius: 16px;
            border-left: 5px solid #ef4444;
            box-shadow: 0 18px 45px rgba(0, 0, 0, .18);
        }



        /* =========================================================
           CAPA GLOBAL DE MODALES
           Bootstrap usa 1040/1055 por defecto; el navbar de este ERP
           vive en 3000. Elevamos modal y backdrop para que el overlay
           cubra de forma uniforme todo el layout, incluido el navbar.
           ========================================================= */
        .modal-backdrop {
            z-index: var(--nsq-z-modal-backdrop) !important;
            --bs-backdrop-bg: #07111f;
            --bs-backdrop-opacity: .70;
            backdrop-filter: blur(2px);
            -webkit-backdrop-filter: blur(2px);
        }

        html[data-nsq-theme="dark"] .modal-backdrop {
            --bs-backdrop-bg: #020711;
            --bs-backdrop-opacity: .78;
        }

        .modal {
            z-index: var(--nsq-z-modal) !important;
        }

        body.modal-open {
            overflow: hidden !important;
            padding-right: 0 !important;
        }

        body.modal-open .global-navbar-host {
            pointer-events: none;
        }


        @@media (max-width: 768px) {
            .global-navbar-host {
                padding: .85rem .85rem 0;
            }

            .global-render-host {
                padding: .85rem;
            }
        }
    

        /* El fondo global pertenece exclusivamente al body definido por
           nsquell-erp-theme.css. Ningún host del Layout debe cubrirlo. */
        .global-layout-shell,
        .global-navbar-host,
        .global-render-host,
        #main-content {
            background: transparent !important;
            background-color: transparent !important;
        }

        html[data-nsq-theme="light"] .global-layout-shell,
        html[data-nsq-theme="light"] .global-navbar-host,
        html[data-nsq-theme="light"] .global-render-host,
        html[data-nsq-theme="light"] #main-content,
        html[data-nsq-theme="dark"] .global-layout-shell,
        html[data-nsq-theme="dark"] .global-navbar-host,
        html[data-nsq-theme="dark"] .global-render-host,
        html[data-nsq-theme="dark"] #main-content {
            background: transparent !important;
            background-color: transparent !important;
        }

    </style>
</head>

<body>
    <script>
        (function () {
            const theme = document.documentElement.getAttribute('data-nsq-theme') || 'dark';

            document.body.classList.remove(
                'nsq-theme-dark',
                'nsq-theme-light',
                'dark-mode',
                'light-mode'
            );

            if (theme === 'light') {
                document.body.classList.add('nsq-theme-light', 'light-mode');
            } else {
                document.body.classList.add('nsq-theme-dark', 'dark-mode');
            }
        })();
    </script>

    @await Html.PartialAsync("_Overlay")

    <div class="global-layout-shell">
        <div class="global-navbar-host">
            @await Html.PartialAsync("_TopNavbar")
        </div>

        <main class="global-render-host" id="main-content" role="main">
            @if (TempData["SuccessMessage"] != null)
            {
                <div id="global-success-alert"
                     class="alert alert-success d-flex align-items-center"
                     role="alert">
                    <i class="fas fa-check-circle fa-lg me-2"></i>
                    <div>@TempData["SuccessMessage"]</div>
                    <button type="button"
                            class="btn-close ms-auto"
                            data-bs-dismiss="alert"
                            aria-label="Cerrar">
                    </button>
                </div>
            }

            @if (TempData["ErrorMessage"] != null)
            {
                <div id="global-error-alert"
                     class="alert alert-danger d-flex align-items-center"
                     role="alert">
                    <i class="fas fa-triangle-exclamation fa-lg me-2"></i>
                    <div>@TempData["ErrorMessage"]</div>
                    <button type="button"
                            class="btn-close ms-auto"
                            data-bs-dismiss="alert"
                            aria-label="Cerrar">
                    </button>
                </div>
            }

            @RenderBody()
        </main>
    </div>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/lib/jquery-validation/dist/jquery.validate.min.js"></script>
    <script src="~/lib/jquery-validation-unobtrusive/jquery.validate.unobtrusive.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>

    <script>
        document.addEventListener('DOMContentLoaded', function () {
            const successAlert = document.getElementById('global-success-alert');
            const errorAlert = document.getElementById('global-error-alert');

            if (successAlert) {
                setTimeout(function () {
                    bootstrap.Alert.getOrCreateInstance(successAlert).close();
                }, 5000);
            }

            if (errorAlert) {
                setTimeout(function () {
                    bootstrap.Alert.getOrCreateInstance(errorAlert).close();
                }, 6000);
            }
        });
    </script>

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>