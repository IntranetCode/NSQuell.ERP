@model ERP.NSQuell.Models.ViewModels.Almacen.AlmacenMPIndexVm
@{
    Layout = "~/Views/Shared/_AlmacenLayout.cshtml";
    ViewData["Title"] = "Inventario de embalajes";

    var embalajes = Model.Existencias
        .OrderBy(x => x.Codigo)
        .ThenBy(x => x.Nombre)
        .ToList();

    var returnUrl = $"{Context.Request.Path}{Context.Request.QueryString}";
    // ALMACEN_EMB_INDEX_BUSQUEDA_V9_0
    var busquedaActiva = !string.IsNullOrWhiteSpace(Model.Busqueda);
}

<section class="alm-hero">
    <div>
        <small>EMBALAJES</small>
        <h1>Inventario de embalajes</h1>
        <p>Catálogo general sin divisiones. El stock mostrado es la cantidad que Almacén puede utilizar.</p>
    </div>
    <div class="alm-actions">
        <a class="alm-btn" asp-action="Movimiento">
            <i class="fa-solid fa-arrow-right-arrow-left"></i>
            Registrar movimiento
        </a>
        <a class="alm-btn secondary" asp-action="Embalajes">Catálogo</a>
        <a class="alm-btn secondary" asp-action="NivelesStock"><i class="fa-solid fa-sliders"></i> Niveles de stock</a>
        <a class="alm-btn secondary" asp-action="Historial"><i class="fa-solid fa-clock-rotate-left"></i> Historial</a>
    </div>
</section>

@if (!Model.Configurado)
{
    <div class="alm-alert warning">@Model.MensajeConfiguracion</div>
}

<section class="alm-card stock-only-catalog">
    <header>
        <span><i class="fa-solid fa-boxes-packing"></i> Catálogo de embalajes</span>
        <span>@embalajes.Count embalaje(s)</span>
    </header>

    <form method="get" class="alm-filter stock-only-filter">
                <div class="alm-field">
            <label for="q">Código o embalaje</label>
            <div class="alm-smart-search" data-alm-smart-search data-alm-smart-submit="true">
                <input id="q" class="alm-input" type="search" name="q" value="@Model.Busqueda"
                       placeholder="Escribe un código o nombre" autocomplete="off" data-alm-smart-input />
                <div class="alm-smart-search__menu" data-alm-smart-menu hidden>
                    @foreach (var item in embalajes)
                    {
                        var textoBusqueda = $"{item.Codigo} {item.Nombre}";
                        <button type="button" class="alm-smart-search__option"
                                data-alm-smart-option data-alm-smart-value="@item.Codigo" data-alm-smart-text="@textoBusqueda">
                            <strong>@item.Codigo</strong><span>@item.Nombre</span><small>@item.Saldo.ToString("0.###") @item.Unidad</small>
                        </button>
                    }
                    <div class="alm-smart-search__empty" data-alm-smart-empty hidden>Sin coincidencias.</div>
                </div>
            </div>
        </div>
        <div class="alm-field">
            <label for="estado">Nivel de stock</label>
            <select id="estado" class="alm-select" name="estado">
                <option value="" selected="@(string.IsNullOrWhiteSpace(Model.Estado))">Todos los niveles</option>
                <option value="ROJO" selected="@(Model.Estado == "ROJO")">Crítico</option>
                <option value="AMARILLO" selected="@(Model.Estado == "AMARILLO")">Aviso</option>
                <option value="VERDE" selected="@(Model.Estado == "VERDE")">Disponible</option>
                <option value="SIN_CONFIGURAR" selected="@(Model.Estado == "SIN_CONFIGURAR")">Sin configurar</option>
            </select>
        </div>
        <button class="alm-btn" type="submit"><i class="fa-solid fa-filter"></i> Filtrar</button>
        <a class="alm-btn secondary" asp-action="Index"><i class="fa-solid fa-filter-circle-xmark"></i> Limpiar</a>
    </form>

    <div class="alm-table-wrap">
        <table class="alm-table alm-table-fit stock-only-table">
            <colgroup>
                <col class="stock-col-code" />
                <col class="stock-col-description" />
                <col class="stock-col-quantity" />
                <col class="stock-col-date" />
                <col class="stock-col-actions" />
            </colgroup>
            <thead>
                <tr>
                    <th>Código</th>
                    <th>Embalaje</th>
                    <th>Stock</th>
                    <th>Último movimiento</th>
                    <th aria-label="Acciones"></th>
                </tr>
            </thead>
            <tbody>
                @foreach (var x in embalajes)
                {
                    <tr class="@(busquedaActiva ? "alm-search-hit" : "")">
                        <td data-label="Código">
                            <a class="pt-part-link" asp-action="Historial" asp-route-embalaje="@x.Codigo">
                                <strong>@x.Codigo</strong>
                            </a>
                        </td>
                        <td data-label="Embalaje">
                            <a class="pt-truncate-link" asp-action="Historial" asp-route-embalaje="@x.Codigo" title="@x.Nombre">@x.Nombre</a>
                        </td>
                        <td class="pt-stock stock-quantity-cell" data-label="Stock">
                            <span class="pt-stock-badge @x.Semaforo">
                                <strong>@Math.Max(0m, x.Saldo).ToString("0.###") @x.Unidad</strong>
                            </span>
                        </td>
                        <td class="pt-last-movement" data-label="Último movimiento">
                            @if (x.UltimoMovimiento.HasValue)
                            {
                                <strong>@x.UltimoMovimiento.Value.ToString("dd/MM/yyyy")</strong>
                                <small>@x.UltimoMovimiento.Value.ToString("HH:mm")</small>
                            }
                            else
                            {
                                <span class="pt-empty-value">Sin movimientos</span>
                            }
                        </td>
                        <td data-label="Acciones">
                            <div class="pt-actions">
                                <a class="pt-action"
                                   asp-action="Movimiento"
                                   asp-route-embalajeId="@x.MaterialID"
                                   title="Registrar movimiento">
                                    <i class="fa-solid fa-arrow-right-arrow-left"></i>
                                </a>
                                <a class="pt-action"
                                   asp-controller="AlmacenCompras"
                                   asp-action="Confirmar"
                                   asp-route-modulo="EMBALAJES"
                                   asp-route-catalogoID="@x.MaterialID"
                                   asp-route-returnUrl="@returnUrl"
                                   title="Solicitar compra">
                                    <i class="fa-solid fa-cart-plus"></i>
                                </a>
                                <a class="pt-action"
                                   asp-action="NivelesStock"
                                   asp-route-q="@x.Codigo"
                                   title="Configurar niveles">
                                    <i class="fa-solid fa-sliders"></i>
                                </a>
                                <a class="pt-action"
                                   asp-action="Historial"
                                   asp-route-embalaje="@x.Codigo"
                                   title="Ver historial">
                                    <i class="fa-solid fa-clock-rotate-left"></i>
                                </a>
                            </div>
                        </td>
                    </tr>
                }

                @if (!embalajes.Any())
                {
                    <tr>
                        <td colspan="5" class="alm-empty">No se encontraron embalajes.</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</section>

<section class="alm-card inv2-recent-card">
    <header>
        <span>@(busquedaActiva ? $"Movimientos recientes de embalajes · {Model.Busqueda}" : "5 movimientos recientes de embalajes")</span>
        <a class="alm-header-link" asp-action="Historial">Ver historial completo <i class="fa-solid fa-arrow-right"></i></a>
    </header>
    <div class="inv2-recent-list">
        @foreach (var x in Model.Movimientos.Take(5))
        {
            <article class="inv2-recent-item @(busquedaActiva ? "alm-search-hit" : "")">
                <div><small>FECHA</small><strong>@x.FechaMovimiento.ToString("dd/MM/yyyy")</strong><span>@x.FechaMovimiento.ToString("HH:mm")</span></div>
                <div class="inv2-recent-main"><small>EMBALAJE</small><a asp-action="Historial" asp-route-embalaje="@x.Codigo">@x.Codigo · @x.Material</a></div>
                <div><small>MOVIMIENTO</small><strong>@x.TipoMovimiento</strong><span>@x.Cantidad.ToString("0.###") @x.Unidad</span></div>
                <div><small>UBICACIÓN / OF</small><strong>@(string.IsNullOrWhiteSpace(x.Ubicacion) ? "Sin ubicación" : x.Ubicacion)</strong><span>@(string.IsNullOrWhiteSpace(x.NumeroOF) ? "Sin OF" : x.NumeroOF)</span></div>
                <div><small>RESPONSABLE</small><strong>@(string.IsNullOrWhiteSpace(x.Responsable) ? "Sin responsable" : x.Responsable)</strong></div>
            </article>
        }
    </div>
</section>
