@model ERP.NSQuell.Models.ViewModels.Almacen.AlmacenMPIndexVm
@{
    Layout = "~/Views/Shared/_AlmacenLayout.cshtml";
    ViewData["Title"] = "Inventario de embalajes";
    // ALMACEN_EMB_STOCK_COMPACTO_V1_0

    string Categoria(string? codigo, string? nombre)
    {
        var texto = $"{codigo} {nombre}".ToUpperInvariant();
        var tieneCaja = texto.Contains("CAJA") || texto.Contains("BOX") || texto.Contains("CARTON");
        var tieneBolsa = texto.Contains("BOLSA") || texto.Contains("BAG") || texto.Contains("SACO");

        if (texto.Contains("MIXTO") || (tieneCaja && tieneBolsa)) return "MIXTO";
        if (tieneBolsa) return "BOLSA";
        return "CAJA";
    }

    string Icono(string categoria) =>
        categoria == "BOLSA" ? "fa-bag-shopping" :
        categoria == "MIXTO" ? "fa-boxes-packing" :
        "fa-box";

    string Inicial(string categoria) =>
        categoria == "BOLSA" ? "B" : categoria == "MIXTO" ? "M" : "C";

    string GrupoId(int indice) => $"emb_tipo_{indice}";
    string EstadoTexto(string? estado) =>
        estado == "ROJO" ? "Cr&iacute;tico" :
        estado == "AMARILLO" ? "Aviso" :
        estado == "VERDE" ? "Disponible" :
        "Sin configurar";

    var categoriaFiltro = Context.Request.Query["categoria"].ToString().Trim().ToUpperInvariant();
    if (categoriaFiltro is not ("CAJA" or "BOLSA" or "MIXTO")) categoriaFiltro = string.Empty;

    var grupos = Model.Existencias
        .GroupBy(x => Categoria(x.Codigo, x.Nombre))
        .Where(g => string.IsNullOrWhiteSpace(categoriaFiltro) || g.Key == categoriaFiltro)
        .OrderBy(g => g.Key == "CAJA" ? 0 : g.Key == "BOLSA" ? 1 : 2)
        .ToList();
}

<section class="alm-hero">
    <div>
        <small>EMBALAJES</small>
        <h1>Inventario de embalajes</h1>
        <p>
            Cat&aacute;logo dividido en CAJA, BOLSA y MIXTO.
            Los grupos permanecen cerrados al entrar para mantener la vista compacta.
        </p>
    </div>

    <div class="alm-actions">
        <a class="alm-btn" asp-action="Movimiento" asp-route-tipo="Entrada">
            <i class="fa-solid fa-arrow-down"></i>
            Registrar entrada
        </a>
        <a class="alm-btn secondary" asp-action="Movimiento" asp-route-tipo="Salida">Registrar salida</a>
        <a class="alm-btn secondary" asp-action="Embalajes">Cat&aacute;logo</a>
        <a class="alm-btn secondary" asp-action="NivelesStock">
            <i class="fa-solid fa-sliders"></i>
            Niveles de stock
        </a>
        <a class="alm-btn secondary" asp-action="Historial">
            <i class="fa-solid fa-clock-rotate-left"></i>
            Historial
        </a>
    </div>
</section>

@if (!Model.Configurado)
{
    <div class="alm-alert warning">@Model.MensajeConfiguracion</div>
}

<section class="alm-grid alm-grid-6">
    <div class="alm-kpi alm-kpi-demand"><small>SOLICITADO PENDIENTE</small><strong>@Model.SolicitadoPendiente.ToString("0.###")</strong><span>Embalaje de OF todav&iacute;a no entregado.</span></div>
    <div class="alm-kpi"><small>OF PENDIENTES EMBALAJE</small><strong>@Model.OFPendientes</strong><span>&Oacute;rdenes con embalaje pendiente de surtir.</span></div>
    <div class="alm-kpi"><small>RECEPCIONES DE HOY</small><strong>@Model.RecepcionesHoy</strong><span>Entradas registradas durante el d&iacute;a.</span></div>
    <div class="alm-kpi"><small>PIEZAS RECIBIDAS HOY</small><strong>@Model.CantidadRecibidaHoy.ToString("0.###")</strong><span>Total ingresado al almac&eacute;n de embalajes.</span></div>
    <div class="alm-kpi alm-kpi-out"><small>SALIDAS DE HOY</small><strong>@Model.SalidasHoy.ToString("0.###")</strong><span>Salidas, consumos, scrap y ajustes negativos.</span></div>
    <div class="alm-kpi alm-kpi-critical"><small>EMBALAJES CR&Iacute;TICOS</small><strong>@Model.Criticos</strong><span>Embalajes actualmente en sem&aacute;foro rojo.</span></div>
</section>

<section class="alm-card pt-client-catalog emb-category-catalog">
    <header>
        <span><i class="fa-solid fa-boxes-packing"></i> Cat&aacute;logo de embalajes</span>
        <span>@Model.Existencias.Count embalaje(s)</span>
    </header>

    <form method="get" class="alm-filter pt-client-filter">
        <div class="alm-field">
            <label for="q">C&oacute;digo o embalaje</label>
            <input id="q" class="alm-input" type="search" name="q" value="@Model.Busqueda" placeholder="Escribe un c&oacute;digo o nombre" autocomplete="off" />
        </div>
        <div class="alm-field">
            <label for="estado">Nivel de stock</label>
            <select id="estado" class="alm-select" name="estado">
                <option value="" selected="@(string.IsNullOrWhiteSpace(Model.Estado))">Todos los niveles</option>
                <option value="ROJO" selected="@(Model.Estado == "ROJO")">Cr&iacute;tico</option>
                <option value="AMARILLO" selected="@(Model.Estado == "AMARILLO")">Aviso</option>
                <option value="VERDE" selected="@(Model.Estado == "VERDE")">Disponible</option>
                <option value="SIN_CONFIGURAR" selected="@(Model.Estado == "SIN_CONFIGURAR")">Sin configurar</option>
            </select>
        </div>
        <div class="alm-field">
            <label for="categoria">Categor&iacute;a</label>
            <select id="categoria" class="alm-select" name="categoria">
                <option value="" selected="@(string.IsNullOrWhiteSpace(categoriaFiltro))">Todas las categor&iacute;as</option>
                <option value="CAJA" selected="@(categoriaFiltro == "CAJA")">CAJA</option>
                <option value="BOLSA" selected="@(categoriaFiltro == "BOLSA")">BOLSA</option>
                <option value="MIXTO" selected="@(categoriaFiltro == "MIXTO")">MIXTO</option>
            </select>
        </div>
        <button class="alm-btn" type="submit"><i class="fa-solid fa-filter"></i> Filtrar</button>
        <a class="alm-btn secondary" asp-action="Index"><i class="fa-solid fa-filter-circle-xmark"></i> Limpiar</a>
    </form>

    @if (grupos.Any())
    {
        <div class="pt-client-list">
            @{ var indice = 0; }
            @foreach (var grupo in grupos)
            {
                indice++;
                var collapseId = GrupoId(indice);
                var items = grupo.OrderBy(x => x.Nombre).ThenBy(x => x.Codigo).ToList();
                var existencia = items.Sum(x => x.Saldo);
                var solicitados = items.Count(x => x.Solicitado > 0.0005m);
                var criticos = items.Count(x => x.Semaforo == "ROJO");

                <article class="pt-client-card">
                    <button type="button"
                            class="pt-client-head"
                            data-bs-toggle="collapse"
                            data-bs-target="#@collapseId"
                            aria-expanded="false"
                            aria-controls="@collapseId">
                        <span class="pt-client-head-main">
                            <span class="pt-client-avatar emb-category-avatar @grupo.Key.ToLowerInvariant()">
                                @Inicial(grupo.Key)
                            </span>
                            <span class="pt-client-copy">
                                <strong>@grupo.Key</strong>
                                <small>@items.Count embalaje(s)</small>
                            </span>
                        </span>

                        <span class="pt-client-metrics">
                            <span class="pt-client-pill"><small>Art&iacute;culos</small><strong>@items.Count</strong></span>
                            <span class="pt-client-pill is-available"><small>Existencia</small><strong>@existencia.ToString("0.###")</strong></span>
                            <span class="pt-client-pill @(solicitados > 0 ? "is-demand" : string.Empty)"><small>Solicitados</small><strong>@solicitados</strong></span>
                            @if (criticos > 0)
                            {
                                <span class="pt-client-pill is-critical"><small>Cr&iacute;ticos</small><strong>@criticos</strong></span>
                            }
                            <span class="pt-client-chevron"><i class="fa-solid fa-chevron-down"></i></span>
                        </span>
                    </button>

                    <div id="@collapseId" class="collapse">
                        <div class="pt-client-body">
                            <div class="alm-table-wrap pt-client-table-wrap">
                                <table class="alm-table alm-table-fit pt-client-table emb-category-table">
                                    <colgroup>
                                        <col class="ptc-col-part" />
                                        <col class="ptc-col-description" />
                                        <col class="ptc-col-stock" />
                                        <col class="ptc-col-requested" />
                                        <col class="ptc-col-last" />
                                        <col class="ptc-col-actions" />
                                    </colgroup>
                                    <thead>
                                        <tr>
                                            <th>C&oacute;digo</th>
                                            <th>Embalaje</th>
                                            <th>Existencia</th>
                                            <th>Solicitado</th>
                                            <th>&Uacute;ltimo movimiento</th>
                                            <th aria-label="Acciones"></th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        @foreach (var x in items)
                                        {
                                            <tr>
                                                <td data-label="C&oacute;digo">
                                                    <a class="pt-part-link" asp-action="Historial" asp-route-embalaje="@x.Codigo">
                                                        <strong>@x.Codigo</strong>
                                                        <small>@grupo.Key</small>
                                                    </a>
                                                </td>
                                                <td data-label="Embalaje">
                                                    <a class="pt-truncate-link" asp-action="Historial" asp-route-embalaje="@x.Codigo" title="@x.Nombre">@x.Nombre</a>
                                                </td>
                                                <td class="pt-stock" data-label="Existencia">
                                                    <span class="pt-stock-badge @x.Semaforo"><strong>@x.Saldo.ToString("0.###") @x.Unidad</strong></span>
                                                    </td>
                                                <td class="pt-requested" data-label="Solicitado">
                                                    @if (x.Solicitado > 0.0005m)
                                                    {
                                                        <strong>-@x.Solicitado.ToString("0.###") @x.Unidad</strong>
                                                        <small>Pendiente</small>
                                                    }
                                                    else
                                                    {
                                                        <span class="pt-empty-value">0 @x.Unidad</span>
                                                    }
                                                </td>
                                                <td class="pt-last-movement" data-label="&Uacute;ltimo movimiento">
                                                    @if (x.UltimoMovimiento.HasValue)
                                                    {
                                                        <strong>@x.UltimoMovimiento.Value.ToString("dd/MM/yyyy")</strong>
                                                        <small>@x.UltimoMovimiento.Value.ToString("HH:mm")</small>
                                                    }
                                                    else
                                                    {
                                                        <span class="pt-empty-value">Sin movimientos</span>
                                                    }
                                                </td>
                                                <td data-label="Acciones">
                                                    <div class="pt-actions">
                                                        <a class="pt-action" asp-action="Movimiento" asp-route-embalajeId="@x.MaterialID" title="Registrar movimiento"><i class="fa-solid fa-arrow-right-arrow-left"></i></a>
                                                        <a class="pt-action" asp-action="NivelesStock" asp-route-q="@x.Codigo" title="Configurar niveles"><i class="fa-solid fa-sliders"></i></a>
                                                        <a class="pt-action" asp-action="Historial" asp-route-embalaje="@x.Codigo" title="Ver historial"><i class="fa-solid fa-clock-rotate-left"></i></a>
                                                    </div>
                                                </td>
                                            </tr>
                                        }
                                    </tbody>
                                </table>
                            </div>
                        </div>
                    </div>
                </article>
            }
        </div>
    }
    else
    {
        <div class="alm-empty">No se encontraron embalajes con los filtros seleccionados.</div>
    }
</section>

<section class="alm-card inv2-recent-card">
    <header><span>5 movimientos recientes de embalajes</span><a class="alm-header-link" asp-action="Historial">Ver historial completo <i class="fa-solid fa-arrow-right"></i></a></header>
    <div class="inv2-recent-list">
        @foreach (var x in Model.Movimientos.Take(5))
        {
            <article class="inv2-recent-item">
                <div><small>FECHA</small><strong>@x.FechaMovimiento.ToString("dd/MM/yyyy")</strong><span>@x.FechaMovimiento.ToString("HH:mm")</span></div>
                <div class="inv2-recent-main"><small>EMBALAJE</small><a asp-action="Historial" asp-route-embalaje="@x.Codigo">@x.Codigo &middot; @x.Material</a></div>
                <div><small>MOVIMIENTO</small><strong>@x.TipoMovimiento</strong><span>@x.Cantidad.ToString("0.###") @x.Unidad</span></div>
                <div><small>UBICACI&Oacute;N / OF</small><strong>@(string.IsNullOrWhiteSpace(x.Ubicacion) ? "Sin ubicaci&oacute;n" : x.Ubicacion)</strong><span>@(string.IsNullOrWhiteSpace(x.NumeroOF) ? "Sin OF" : x.NumeroOF)</span></div>
                <div><small>RESPONSABLE</small><strong>@(string.IsNullOrWhiteSpace(x.Responsable) ? "Sin responsable" : x.Responsable)</strong></div>
            </article>
        }
    </div>
</section>

<!-- ALMACEN_COMPRA_EMB_V3_START -->
<script>
(() => {
  document.querySelectorAll('.pt-actions').forEach(actions => {
    if (actions.querySelector('[data-alm-buy]')) return;
    const movement = actions.querySelector('a[href*="embalajeId="]');
    if (!movement) return;
    const source = new URL(movement.href, location.origin);
    const id = source.searchParams.get('embalajeId');
    if (!id) return;
    const link = document.createElement('a');
    link.className='pt-action'; link.dataset.almBuy='1'; link.title='Solicitar compra';
    link.href=`/AlmacenCompras/Confirmar?modulo=EMBALAJES&catalogoID=${encodeURIComponent(id)}&returnUrl=${encodeURIComponent(location.pathname+location.search)}`;
    link.innerHTML='<i class="fa-solid fa-cart-plus"></i>';
    actions.appendChild(link);
  });
})();
</script>
<!-- ALMACEN_COMPRA_EMB_V3_END -->
