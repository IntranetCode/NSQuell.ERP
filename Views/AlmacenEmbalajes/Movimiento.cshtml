@model ERP.NSQuell.Models.ViewModels.Almacen.AlmacenMPMovimientoFormVm
@{ Layout="~/Views/Shared/_AlmacenLayout.cshtml"; ViewData["Title"]="Movimiento de embalajes"; }
<section class="alm-hero"><div><small>ALMACÉN DE EMBALAJES</small><h1>Registrar movimiento</h1><p>Las cantidades se capturan positivas; el tipo define si suma o resta inventario.</p></div></section><section class="alm-card"><form method="post" class="alm-form"><div asp-validation-summary="ModelOnly" class="alm-field full"></div><div class="alm-field full"><label>Embalaje</label><select asp-for="MaterialID" class="alm-select"><option value="">Selecciona</option>@foreach(var x in Model.Materiales){<option value="@x.Id" data-unidad="@x.Extra">@x.Texto</option>}</select><span asp-validation-for="MaterialID"></span></div><div class="alm-field"><label asp-for="TipoMovimiento"></label><select asp-for="TipoMovimiento" class="alm-select">@foreach(var x in Model.TiposMovimiento){<option value="@x.Extra">@x.Texto</option>}</select></div><div class="alm-field"><label asp-for="Cantidad"></label><input asp-for="Cantidad" class="alm-input"/></div><div class="alm-field"><label asp-for="Unidad"></label><input asp-for="Unidad" class="alm-input"/></div><div class="alm-field"><label asp-for="Lote"></label><input asp-for="Lote" class="alm-input"/></div><div class="alm-field"><label asp-for="UbicacionID"></label><select asp-for="UbicacionID" class="alm-select"><option value="">Sin ubicación</option>@foreach(var x in Model.Ubicaciones){<option value="@x.Id">@x.Texto</option>}</select></div><div class="alm-field"><label asp-for="NumeroOF"></label><input asp-for="NumeroOF" class="alm-input"/></div><div class="alm-field full"><label asp-for="Observaciones"></label><textarea asp-for="Observaciones" class="alm-textarea"></textarea></div><div class="alm-field full"><button class="alm-btn">Guardar movimiento</button></div></form></section>
