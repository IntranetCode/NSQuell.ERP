@using System.Globalization
@model ERP.NSQuell.Models.ViewModels.Almacen.AlmacenMPMovimientoFormVm
@{
    Layout = "~/Views/Shared/_AlmacenLayout.cshtml";
    ViewData["Title"] = Model.EsEntregaOF ? "Entrega de embalaje a OF" : "Movimiento de embalajes";
    var seleccionado = Model.Materiales.FirstOrDefault(x => x.Id == Model.MaterialID)?.Texto ?? "Embalaje no encontrado";
    var maximo = Model.CantidadPendienteOF.ToString("0.###", CultureInfo.InvariantCulture);
}

<section class="alm-hero">
    <div>
        <small>ALMACÉN DE EMBALAJES</small>
        <h1>@(Model.EsEntregaOF ? "Entregar embalaje" : "Registrar movimiento")</h1>
        <p>@(Model.EsEntregaOF
            ? "La OF, el catálogo, la unidad, el tipo, el pendiente y la fecha se validan nuevamente en el servidor."
            : "Las cantidades se capturan positivas; el tipo de movimiento determina si suma o resta inventario.")</p>
    </div>
</section>

<section class="alm-card">
    <form method="post" class="alm-form">
        <div asp-validation-summary="ModelOnly" class="alm-field full"></div>
        <input asp-for="EsEntregaOF" type="hidden" />
        <input asp-for="SolicitudProduccionID" type="hidden" />
        <input asp-for="OperacionToken" type="hidden" />
        <input asp-for="CantidadPendienteOF" type="hidden" />

        @if (Model.EsEntregaOF)
        {
            <input asp-for="MaterialID" type="hidden" />
            <input asp-for="TipoMovimiento" type="hidden" />
            <input asp-for="Unidad" type="hidden" />
            <input asp-for="NumeroOF" type="hidden" />
            <input asp-for="Lote" type="hidden" value="S/L" />
            <input asp-for="UbicacionID" type="hidden" />

            <div class="alm-field full">
                <label>Embalaje</label>
                <input class="alm-input" value="@seleccionado" readonly />
                <span asp-validation-for="MaterialID"></span>
            </div>
            <div class="alm-field">
                <label>Tipo de movimiento</label>
                <input class="alm-input" value="Salida · Entrega a OF" readonly />
            </div>
            <div class="alm-field">
                <label asp-for="FechaMovimiento"></label>
                <input class="alm-input" value="@Model.FechaMovimiento.ToString("dd/MM/yyyy HH:mm:ss")" readonly />
            </div>
            <div class="alm-field">
                <label asp-for="NumeroOF"></label>
                <input class="alm-input" value="@Model.NumeroOF" readonly />
                <span asp-validation-for="NumeroOF"></span>
            </div>
            <div class="alm-field">
                <label>Pendiente actual</label>
                <input class="alm-input" value="@Model.CantidadPendienteOF.ToString("0.###") @Model.Unidad" readonly />
            </div>
            <div class="alm-field full">
                <div class="alm-alert">
                    El pendiente se calculará nuevamente al guardar. No se permite entregar más de lo requerido ni más de la existencia disponible.
                </div>
            </div>
        }
        else
        {
            <div class="alm-field full">
                <label asp-for="MaterialID">Embalaje</label>
                <select asp-for="MaterialID" class="alm-select" id="almacenCatalogoSelect">
                    <option value="">Selecciona</option>
                    @foreach (var x in Model.Materiales)
                    {
                        <option value="@x.Id" data-unidad="@x.Extra">@x.Texto</option>
                    }
                </select>
                <span asp-validation-for="MaterialID"></span>
            </div>
            <div class="alm-field">
                <label asp-for="TipoMovimiento"></label>
                <select asp-for="TipoMovimiento" class="alm-select">
                    @foreach (var x in Model.TiposMovimiento)
                    {
                        <option value="@x.Extra">@x.Texto</option>
                    }
                </select>
                <span asp-validation-for="TipoMovimiento"></span>
            </div>
            <div class="alm-field">
                <label asp-for="Unidad"></label>
                <input asp-for="Unidad" class="alm-input" id="almacenUnidadInput" readonly />
                <small class="alm-filter-hint">Se toma automáticamente del catálogo.</small>
            </div>
            <div class="alm-field">
                <label asp-for="NumeroOF"></label>
                <input asp-for="NumeroOF" class="alm-input" />
            </div>
        }

        <div class="alm-field">
            <label asp-for="Cantidad">@(Model.EsEntregaOF ? $"Cantidad a entregar ({Model.Unidad})" : "Cantidad")</label>
            @if (Model.EsEntregaOF)
            {
                <div class="alm-unit-input">
                    <input asp-for="Cantidad" class="alm-input" required min="0.001" max="@maximo" step="0.001" placeholder="Cantidad en @Model.Unidad" />
                    <span class="alm-unit-input__suffix">@Model.Unidad</span>
                </div>
            }
            else
            {
                <input asp-for="Cantidad" class="alm-input" required min="0.001" step="0.001" />
            }
            <span asp-validation-for="Cantidad"></span>
        </div>

        @if (!Model.EsEntregaOF)
        {
            <div class="alm-field">
                <label asp-for="Lote">Lote</label>
                <input asp-for="Lote" class="alm-input" />
                <span asp-validation-for="Lote"></span>
            </div>
            <div class="alm-field full">
                <label asp-for="UbicacionID"></label>
                <select asp-for="UbicacionID" class="alm-select">
                    <option value="">Sin ubicación</option>
                    @foreach (var x in Model.Ubicaciones)
                    {
                        <option value="@x.Id">@x.Texto</option>
                    }
                </select>
                <span asp-validation-for="UbicacionID"></span>
            </div>
        }

        <div class="alm-field full">
            <label asp-for="Observaciones"></label>
            <textarea asp-for="Observaciones" class="alm-textarea" required="@(Model.EsEntregaOF ? "required" : null)"></textarea>
            <span asp-validation-for="Observaciones"></span>
        </div>
        <div class="alm-field full">
            <button class="alm-btn" type="submit">
                <i class="fa-solid fa-truck-ramp-box"></i>
                @(Model.EsEntregaOF ? "Registrar entrega de embalaje" : "Guardar movimiento")
            </button>
        </div>
    </form>
</section>

@section Scripts {
    <script>
        (() => {
            const catalogo = document.getElementById("almacenCatalogoSelect");
            const unidad = document.getElementById("almacenUnidadInput");
            if (!catalogo || !unidad) return;
            const actualizarUnidad = () => {
                const opcion = catalogo.options[catalogo.selectedIndex];
                unidad.value = opcion?.dataset?.unidad || "";
            };
            catalogo.addEventListener("change", actualizarUnidad);
            actualizarUnidad();
        })();
    </script>
}

