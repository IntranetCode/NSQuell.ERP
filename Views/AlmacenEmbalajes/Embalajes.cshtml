@model IEnumerable<ERP.NSQuell.Models.ViewModels.Almacen.AlmacenMaterialFormVm>
@{ Layout="~/Views/Shared/_AlmacenLayout.cshtml"; ViewData["Title"]="Catálogo de embalajes"; }
<section class="alm-hero"><div><small>CATÁLOGO ERP_EMBALAJES</small><h1>Embalajes</h1><p>Catálogo independiente de materiales de empaque.</p></div><div class="alm-actions"><a class="alm-btn" asp-action="Embalaje">Nuevo embalaje</a><a class="alm-btn secondary" asp-action="NivelesStock">Niveles de stock</a></div></section>
<section class="alm-card"><div class="alm-table-wrap"><table class="alm-table"><thead><tr><th>Código</th><th>Embalaje</th><th>Unidad</th><th>Mínimo</th><th>Aviso</th><th>Activo</th><th></th></tr></thead><tbody>@foreach(var x in Model){<tr><td><a class="alm-trace-link" asp-action="Historial" asp-route-embalaje="@x.Codigo"><strong>@x.Codigo</strong></a></td><td><a class="alm-trace-link" asp-action="Historial" asp-route-embalaje="@x.Codigo">@x.Nombre</a></td><td>@x.UnidadDefault</td><td>@x.StockMinimo</td><td>@x.StockAviso</td><td>@(x.Activo?"Sí":"No")</td><td><a class="alm-btn secondary small" asp-action="Embalaje" asp-route-id="@x.MaterialID">Editar</a></td></tr>}</tbody></table></div></section>
