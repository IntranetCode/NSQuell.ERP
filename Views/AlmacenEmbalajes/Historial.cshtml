@model ERP.NSQuell.Models.ViewModels.Almacen.AlmacenMPHistorialVm
@{ Layout="~/Views/Shared/_AlmacenLayout.cshtml"; ViewData["Title"]="Historial de embalajes"; var anterior=Math.Max(1,Model.Pagina-1); var siguiente=Math.Min(Model.TotalPaginas,Model.Pagina+1); }
<section class="alm-hero"><div><small>TRAZABILIDAD DE EMBALAJES</small><h1>Historial de embalajes</h1><p>Entradas, salidas, consumos, retornos, scrap y ajustes con lote, ubicación, responsable y referencia.</p>@if(!string.IsNullOrWhiteSpace(Model.FiltroMaterial)){<span class="alm-focus-chip">Embalaje filtrado: @Model.FiltroMaterial</span>}</div><div class="alm-actions"><a class="alm-btn" asp-action="Movimiento">Nuevo movimiento</a><a class="alm-btn secondary" asp-action="ExportarHistorialCsv" asp-route-embalaje="@Model.FiltroMaterial" asp-route-q="@Model.Busqueda" asp-route-tipo="@Model.TipoMovimiento" asp-route-numeroOF="@Model.NumeroOF" asp-route-responsable="@Model.Responsable" asp-route-lote="@Model.Lote" asp-route-desde="@(Model.Desde?.ToString("yyyy-MM-dd"))" asp-route-hasta="@(Model.Hasta?.ToString("yyyy-MM-dd"))">Exportar CSV</a></div></section>
<section class="alm-card"><header><span>Filtros</span><span>@Model.TotalRegistros registro(s)</span></header><form method="get" class="alm-filter alm-filter-history"><div class="alm-field"><label for="embalaje">Embalaje</label><input id="embalaje" class="alm-input" type="search" name="embalaje" value="@Model.FiltroMaterial" list="emb-hist" placeholder="Escribe o selecciona"/><datalist id="emb-hist">@foreach(var item in Model.MaterialesFiltro){<option value="@item.Extra">@item.Texto</option>}</datalist></div><div class="alm-field"><label for="q">Búsqueda libre</label><input id="q" class="alm-input" type="search" name="q" value="@Model.Busqueda" placeholder="Observación o referencia"/></div><div class="alm-field"><label for="tipo">Movimiento</label><select id="tipo" class="alm-select" name="tipo"><option value="">Todos</option>@foreach(var t in Model.TiposMovimiento){if(Model.TipoMovimiento==t){<option value="@t" selected>@t</option>}else{<option value="@t">@t</option>}}</select></div><div class="alm-field"><label for="numeroOF">OF</label><input id="numeroOF" class="alm-input" type="search" name="numeroOF" value="@Model.NumeroOF" list="emb-of"/><datalist id="emb-of">@foreach(var x in Model.OrdenesFiltro){<option value="@x"></option>}</datalist></div><div class="alm-field"><label for="responsable">Responsable</label><input id="responsable" class="alm-input" type="search" name="responsable" value="@Model.Responsable" list="emb-resp"/><datalist id="emb-resp">@foreach(var x in Model.ResponsablesFiltro){<option value="@x"></option>}</datalist></div><div class="alm-field"><label for="lote">Lote</label><input id="lote" class="alm-input" type="search" name="lote" value="@Model.Lote" list="emb-lote"/><datalist id="emb-lote">@foreach(var x in Model.LotesFiltro){<option value="@x"></option>}</datalist></div><div class="alm-field"><label for="desde">Desde</label><input id="desde" class="alm-input" type="date" name="desde" value="@(Model.Desde?.ToString("yyyy-MM-dd"))"/></div><div class="alm-field"><label for="hasta">Hasta</label><input id="hasta" class="alm-input" type="date" name="hasta" value="@(Model.Hasta?.ToString("yyyy-MM-dd"))"/></div><div class="alm-filter-actions"><button class="alm-btn">Filtrar</button><a class="alm-btn secondary" asp-action="Historial">Limpiar</a></div></form></section>
<section class="alm-card"><header><span>Movimientos de embalajes</span><span>Página @Model.Pagina de @Model.TotalPaginas</span></header><div class="alm-table-wrap"><table class="alm-table alm-table-history"><thead><tr><th>Fecha</th><th>Embalaje</th><th>Movimiento</th><th>Cantidad</th><th>Lote</th><th>Ubicación</th><th>OF</th><th>Responsable</th><th>Referencia</th><th>Observaciones</th></tr></thead><tbody>@foreach(var x in Model.Movimientos){var clase=x.TipoMovimiento is "Entrada" or "Retorno" or "AjustePositivo"?"entrada":"salida";<tr><td>@x.FechaMovimiento.ToString("dd/MM/yyyy HH:mm")</td><td><a class="alm-trace-link" asp-action="Historial" asp-route-embalaje="@x.Codigo"><strong>@x.Codigo</strong><small class="alm-subtext">@x.Material</small></a></td><td><span class="alm-movement-type @clase">@x.TipoMovimiento</span></td><td>@x.Cantidad.ToString("0.###") @x.Unidad</td><td>@x.Lote</td><td>@x.Ubicacion</td><td>@x.NumeroOF</td><td>@x.Responsable</td><td>@x.ReferenciaOperacion</td><td>@x.Observaciones</td></tr>}@if(!Model.Movimientos.Any()){<tr><td colspan="10" class="alm-empty">No se encontraron movimientos.</td></tr>}</tbody></table></div>@if(Model.TotalPaginas>1){<nav class="alm-pager"><a class="alm-btn secondary small" asp-action="Historial" asp-route-pagina="@anterior" asp-route-embalaje="@Model.FiltroMaterial">Anterior</a><span>Página <strong>@Model.Pagina</strong> de <strong>@Model.TotalPaginas</strong></span><a class="alm-btn secondary small" asp-action="Historial" asp-route-pagina="@siguiente" asp-route-embalaje="@Model.FiltroMaterial">Siguiente</a></nav>}</section>
