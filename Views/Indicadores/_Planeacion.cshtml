@model ERP.NSQuell.Models.ViewModels.Indicadores.IndicadoresDashboardVm
@{
    var p = Model.Planeacion;
    decimal backlogPct = p.Programado <= 0 ? 0m : Math.Clamp(p.Pendiente * 100m / p.Programado, 0m, 100m);
    decimal reprogramPct = p.Programas <= 0 ? 0m : Math.Clamp(p.Reprogramados * 100m / p.Programas, 0m, 100m);
    var arranquesFuera = Math.Max(0, p.ArranquesRegistrados - p.ArranquesATiempo);
    decimal Hue(decimal value) => Math.Clamp(value,0m,100m) * 1.2m;
}
<section class="ind-area-hero">
    <article class="ind-area-hero__main" style="--kpi-hue:@Hue(p.CumplimientoPct)">
        <span class="ind-overline">PLANEACIÓN</span><h3>Cumplimiento del plan</h3>
        <strong class="ind-area-big">@p.CumplimientoPct.ToString("N1")%</strong>
        <p>@p.Producido.ToString("N0") piezas producidas contra @p.Programado.ToString("N0") programadas en el periodo.</p>
        <div class="ind-meter"><i style="width:@Math.Clamp(p.CumplimientoPct,0m,100m)%"></i></div>
    </article>
    <div class="ind-area-hero__summary">
        <div><span>Programas</span><strong>@p.Programas</strong><small>@p.ProgramasConPendiente con saldo</small></div>
        <div><span>Pendiente</span><strong>@p.Pendiente.ToString("N0")</strong><small>@backlogPct.ToString("N1")% de lo programado</small></div>
        <div><span>Arranques a tiempo</span><strong>@p.ArranqueATiempoPct.ToString("N1")%</strong><small>@arranquesFuera fuera de horario</small></div>
        <div><span>Reprogramados</span><strong>@p.Reprogramados</strong><small>@reprogramPct.ToString("N1")% de programas</small></div>
    </div>
</section>
<section class="ind-area-grid">
    <article class="ind-panel">
        <header class="ind-panel__head"><div><span>LECTURA DEL PERIODO</span><h3>Presión sobre el plan</h3></div></header>
        <div class="ind-analysis-lines">
            <div><div><strong>Cumplimiento</strong><span>@p.CumplimientoPct.ToString("N1")%</span></div><div class="ind-meter"><i style="width:@Math.Clamp(p.CumplimientoPct,0m,100m)%"></i></div><small>Producido / programado.</small></div>
            <div><div><strong>Arranque a tiempo</strong><span>@p.ArranqueATiempoPct.ToString("N1")%</span></div><div class="ind-meter"><i style="width:@Math.Clamp(p.ArranqueATiempoPct,0m,100m)%"></i></div><small>@p.ArranquesATiempo de @p.ArranquesRegistrados arranques reales.</small></div>
            <div><div><strong>Saldo pendiente</strong><span>@backlogPct.ToString("N1")%</span></div><div class="ind-meter ind-meter--loss"><i style="width:@backlogPct%"></i></div><small>@p.ProgramasConPendiente programa(s) todavía abiertos.</small></div>
            <div><div><strong>Reprogramación</strong><span>@reprogramPct.ToString("N1")%</span></div><div class="ind-meter ind-meter--warn"><i style="width:@reprogramPct%"></i></div><small>@p.Reprogramados programa(s) tuvieron movimiento de fecha.</small></div>
        </div>
    </article>
    <aside class="ind-panel ind-area-source">
        <header class="ind-panel__head"><div><span>LECTURA DE DATOS</span><h3>Qué está midiendo</h3></div><button type="button" class="ind-panel-modal-btn" data-bs-toggle="modal" data-bs-target="#indPlaneacionInfo"><i class="fa-solid fa-circle-info"></i> Ver detalle</button></header>
        <div class="ind-source-cards"><div><i class="fa-solid fa-boxes-stacked"></i><strong>Cantidades</strong><small>Programado, producido y saldo por programa.</small></div><div><i class="fa-solid fa-stopwatch"></i><strong>Puntualidad</strong><small>Hora planeada contra hora real de arranque.</small></div><div><i class="fa-solid fa-arrows-rotate"></i><strong>Reprogramación</strong><small>Movimientos registrados durante el periodo.</small></div></div>
    </aside>
</section>
<div class="modal fade" id="indPlaneacionInfo" tabindex="-1" aria-hidden="true"><div class="modal-dialog modal-lg modal-dialog-centered"><div class="modal-content ind-program-modal"><div class="modal-header"><div><span class="ind-overline">PLANEACIÓN</span><h5 class="modal-title">Cómo se construye el análisis</h5></div><button type="button" class="btn-close" data-bs-dismiss="modal"></button></div><div class="modal-body"><div class="ind-origin-grid"><div><span>Programa</span><b>Planeacion_ProgramaProduccion</b><small>CantidadProgramada, CantidadProducida y fechas planeada/real.</small></div><div><span>Puntualidad</span><b>FechaInicioReal vs FechaInicioProgramada</b><small>Solo se evalúa cuando existe arranque real.</small></div><div><span>Reprogramaciones</span><b>Planeacion_ProgramaReprogramacionHistorial</b><small>Cuenta programas con cambios dentro del periodo.</small></div></div></div></div></div></div>