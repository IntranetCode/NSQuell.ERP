@model ERP.NSQuell.Models.ViewModels.Indicadores.IndicadoresDashboardVm
@{
    var l=Model.Logistica;
    decimal atrasoPct=l.Embarques<=0?0m:Math.Clamp(l.Atrasados*100m/l.Embarques,0m,100m);
    decimal incPct=l.Embarques<=0?0m:Math.Clamp(l.Incidencias*100m/l.Embarques,0m,100m);
}
<section class="ind-area-hero"><article class="ind-area-hero__main"><span class="ind-overline">LOGÍSTICA</span><h3>Puntualidad de entrega</h3><strong class="ind-area-big">@l.PuntualidadPct.ToString("N1")%</strong><p>@l.EntregadosATiempo entregas a tiempo de @l.Entregados entregadas.</p><div class="ind-meter"><i style="width:@Math.Clamp(l.PuntualidadPct,0m,100m)%"></i></div></article><div class="ind-area-hero__summary"><div><span>Entrega</span><strong>@l.EntregaPct.ToString("N1")%</strong><small>@l.Entregados / @l.Embarques</small></div><div><span>Atrasados</span><strong>@l.Atrasados</strong><small>@atrasoPct.ToString("N1")% de embarques</small></div><div><span>Incidencias</span><strong>@l.Incidencias</strong><small>@incPct.ToString("N1")% del periodo</small></div><div><span>Críticas abiertas</span><strong>@l.CriticasAbiertas</strong><small>@l.IncidenciasAbiertas abiertas</small></div></div></section>
<section class="ind-area-grid"><article class="ind-panel"><header class="ind-panel__head"><div><span>RIESGO DE SERVICIO</span><h3>Excepciones del periodo</h3></div></header><div class="ind-analysis-tiles"><div><span>Sin entregar</span><strong>@Math.Max(0,l.Embarques-l.Entregados)</strong><small>embarques todavía no entregados</small></div><div><span>Atrasados</span><strong>@l.Atrasados</strong><small>fecha programada vencida</small></div><div><span>Incidencias abiertas</span><strong>@l.IncidenciasAbiertas</strong><small>no cerradas/resueltas</small></div><div><span>Críticas</span><strong>@l.CriticasAbiertas</strong><small>severidad alta o crítica</small></div></div></article><aside class="ind-panel ind-area-source"><header class="ind-panel__head"><div><span>LECTURA DE DATOS</span><h3>Entrega real vs compromiso</h3></div><button type="button" class="ind-panel-modal-btn" data-bs-toggle="modal" data-bs-target="#indLogisticaInfo">Ver detalle</button></header><p>La puntualidad compara la fecha real contra la fecha prometida y las incidencias abiertas complementan la lectura del servicio.</p></aside></section>
<div class="modal fade" id="indLogisticaInfo" tabindex="-1" aria-hidden="true"><div class="modal-dialog modal-lg modal-dialog-centered"><div class="modal-content ind-program-modal"><div class="modal-header"><div><span class="ind-overline">LOGÍSTICA</span><h5 class="modal-title">Cómo se calcula</h5></div><button class="btn-close" data-bs-dismiss="modal"></button></div><div class="modal-body"><div class="ind-origin-grid"><div><span>Embarques</span><b>Logistica_Embarques</b><small>FechaProgramada, FechaEntregaProgramada y FechaEntrega.</small></div><div><span>Incidencias</span><b>Logistica_Incidencias</b><small>Estatus y severidad de casos abiertos.</small></div></div></div></div></div></div>