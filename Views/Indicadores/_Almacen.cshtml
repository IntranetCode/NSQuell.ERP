@model ERP.NSQuell.Models.ViewModels.Indicadores.IndicadoresDashboardVm
@{
    var a=Model.Almacen;
    decimal mpPct=a.MovimientosTotales<=0?0m:a.MovimientosMP*100m/a.MovimientosTotales;
    decimal ptPct=a.MovimientosTotales<=0?0m:a.MovimientosPT*100m/a.MovimientosTotales;
    decimal embPct=a.MovimientosTotales<=0?0m:a.MovimientosEmbalajes*100m/a.MovimientosTotales;
}
<section class="ind-area-hero ind-area-hero--neutral"><article class="ind-area-hero__main"><span class="ind-overline">ALMACÉN</span><h3>Actividad e inventario</h3><strong class="ind-area-big">@a.MovimientosTotales.ToString("N0")</strong><p>Movimientos registrados entre MP, PT y embalajes durante el periodo.</p></article><div class="ind-area-hero__summary"><div><span>MP</span><strong>@a.MovimientosMP</strong><small>@a.EntradasMP entradas · @a.SalidasMP salidas</small></div><div><span>PT</span><strong>@a.MovimientosPT</strong><small>@a.EntradasPT entradas · @a.SalidasPT salidas</small></div><div><span>Embalajes</span><strong>@a.MovimientosEmbalajes</strong><small>@embPct.ToString("N1")% de movimientos</small></div><div><span>Alertas</span><strong>@a.AlertasInventario</strong><small>inventario en condición crítica</small></div></div></section>
<section class="ind-area-grid"><article class="ind-panel"><header class="ind-panel__head"><div><span>MEZCLA OPERATIVA</span><h3>Distribución de movimientos</h3></div></header><div class="ind-analysis-lines"><div><div><strong>Materia prima</strong><span>@mpPct.ToString("N1")%</span></div><div class="ind-meter"><i style="width:@mpPct%"></i></div></div><div><div><strong>Producto terminado</strong><span>@ptPct.ToString("N1")%</span></div><div class="ind-meter"><i style="width:@ptPct%"></i></div></div><div><div><strong>Embalajes</strong><span>@embPct.ToString("N1")%</span></div><div class="ind-meter"><i style="width:@embPct%"></i></div></div></div><div class="ind-analysis-tiles ind-analysis-tiles--alerts"><div><span>MP bajo mínimo</span><strong>@a.MPBajoMinimo</strong></div><div><span>PT rojo</span><strong>@a.PTEnRojo</strong></div><div><span>Embalajes rojo</span><strong>@a.EmbalajesEnRojo</strong></div><div><span>Scrap por recibir</span><strong>@a.ScrapPendienteRecepcion</strong><small>@a.ScrapRecibidoPendienteMolienda por moler</small></div></div></article><aside class="ind-panel ind-area-source"><header class="ind-panel__head"><div><span>LECTURA DE DATOS</span><h3>Movimientos e inventario</h3></div><button type="button" class="ind-panel-modal-btn" data-bs-toggle="modal" data-bs-target="#indAlmacenInfo">Ver detalle</button></header><p>Se cruzan movimientos del periodo con las vistas vigentes de disponibilidad y el flujo de scrap proveniente de Calidad.</p></aside></section>
<div class="modal fade" id="indAlmacenInfo" tabindex="-1" aria-hidden="true"><div class="modal-dialog modal-lg modal-dialog-centered"><div class="modal-content ind-program-modal"><div class="modal-header"><div><span class="ind-overline">ALMACÉN</span><h5 class="modal-title">Fuentes operativas</h5></div><button class="btn-close" data-bs-dismiss="modal"></button></div><div class="modal-body"><div class="ind-origin-grid"><div><span>Movimientos</span><b>AlmacenMP/PT/Embalajes_Movimientos</b><small>Actividad real del periodo.</small></div><div><span>Inventario</span><b>vw_Almacen*Inventario</b><small>Stock mínimo y semáforos vigentes.</small></div><div><span>Scrap</span><b>Calidad_ScrapEntregas</b><small>Pendiente de recepción y molienda.</small></div></div></div></div></div></div>