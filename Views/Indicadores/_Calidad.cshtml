@model ERP.NSQuell.Models.ViewModels.Indicadores.IndicadoresDashboardVm
@{
    var k = Model.Calidad;
    decimal contPct = k.Inspecciones <= 0 ? 0m : Math.Clamp(k.Contenciones * 100m / k.Inspecciones,0m,100m);
    decimal pendPct = k.CantidadTotal <= 0 ? 0m : Math.Clamp(k.CantidadPendiente * 100m / k.CantidadTotal,0m,100m);
    decimal Hue(decimal value) => Math.Clamp(value,0m,100m)*1.2m;
}
<section class="ind-area-hero"><article class="ind-area-hero__main" style="--kpi-hue:@Hue(k.LiberacionPct)"><span class="ind-overline">CALIDAD</span><h3>Liberación y cobertura</h3><strong class="ind-area-big">@k.LiberacionPct.ToString("N1")%</strong><p>@k.Liberadas liberadas de @k.Inspecciones inspecciones registradas.</p><div class="ind-meter"><i style="width:@Math.Clamp(k.LiberacionPct,0m,100m)%"></i></div></article><div class="ind-area-hero__summary"><div><span>Cobertura</span><strong>@k.CoberturaPct.ToString("N1")%</strong><small>@k.CantidadRevisada.ToString("N0") revisado</small></div><div><span>Tiempo objetivo</span><strong>@k.CumplimientoTiempoPct.ToString("N1")%</strong><small>@k.MinutosLiberacionPromedio.ToString("N1") min promedio</small></div><div><span>Contenciones</span><strong>@k.Contenciones</strong><small>@contPct.ToString("N1")% de inspecciones</small></div><div><span>Pendiente</span><strong>@k.CantidadPendiente.ToString("N0")</strong><small>@pendPct.ToString("N1")% del total</small></div></div></section>
<section class="ind-area-grid"><article class="ind-panel"><header class="ind-panel__head"><div><span>RIESGO Y FLUJO</span><h3>Estado de la revisión</h3></div></header><div class="ind-analysis-tiles"><div><span>Scrap</span><strong>@k.Scrap</strong><small>inspecciones con disposición scrap</small></div><div><span>Requieren GP12</span><strong>@k.RequierenGP12</strong><small>flujo adicional de contención</small></div><div><span>Reliberación</span><strong>@k.RequierenReliberacion</strong><small>requieren una nueva liberación</small></div><div><span>Fuera de liberación</span><strong>@Math.Max(0,k.Inspecciones-k.Liberadas)</strong><small>inspecciones no liberadas</small></div></div></article><aside class="ind-panel ind-area-source"><header class="ind-panel__head"><div><span>LECTURA DE DATOS</span><h3>Cómo se obtiene</h3></div><button type="button" class="ind-panel-modal-btn" data-bs-toggle="modal" data-bs-target="#indCalidadInfo">Ver detalle</button></header><p>La sección usa el estado consolidado de cada inspección: cantidades revisadas, liberación, contención, GP12, reliberación y tiempo inicial.</p></aside></section>
<div class="modal fade" id="indCalidadInfo" tabindex="-1" aria-hidden="true"><div class="modal-dialog modal-lg modal-dialog-centered"><div class="modal-content ind-program-modal"><div class="modal-header"><div><span class="ind-overline">CALIDAD</span><h5 class="modal-title">Datos usados por el tablero</h5></div><button class="btn-close" data-bs-dismiss="modal"></button></div><div class="modal-body"><div class="ind-origin-grid"><div><span>Inspecciones</span><b>Calidad_Inspecciones</b><small>Liberado, EnContencion, EsScrap y cantidades.</small></div><div><span>Flujo</span><b>RequiereGP12 / RequiereReliberacion</b><small>Mide cuántas inspecciones requieren pasos adicionales.</small></div><div><span>Tiempo</span><b>MinutosLiberacionInicial</b><small>Promedio y cumplimiento del objetivo inicial cuando existe medición.</small></div></div></div></div></div></div>