@model ERP.NSQuell.Models.ViewModels.Indicadores.IndicadoresDashboardVm
@using System.Globalization

@{
    var kpi = Model.Produccion;
    var tendencia = Model.Tendencia.TakeLast(14).ToList();
    var maxParoMotivo = Model.ParosMotivos.Count == 0 ? 0m : Model.ParosMotivos.Max(x => x.Minutos);
    var maxParoMaquina = Model.ParosMaquinas.Count == 0 ? 0m : Model.ParosMaquinas.Max(x => x.Minutos);

    decimal Pct(decimal value) => Math.Clamp(value, 0m, 100m);
    string CssPct(decimal value) => Pct(value).ToString("0.##", CultureInfo.InvariantCulture);
    string Hue(decimal value) => (Pct(value) * 1.2m).ToString("0.##", CultureInfo.InvariantCulture);
    string HuePerdida(decimal value) => (Pct(100m - Math.Clamp(value * 10m, 0m, 100m)) * 1.2m).ToString("0.##", CultureInfo.InvariantCulture);
    string FmtMin(decimal minutos)
    {
        var total = Math.Max(0, (int)Math.Round(minutos));
        var h = total / 60;
        var m = total % 60;
        return h > 0 ? $"{h} h {m:00} min" : $"{m} min";
    }
}

<section class="ind-prod-hero-v14">
    <article class="ind-oee-card ind-sem-card" style="--kpi-hue:@Hue(kpi.OeePct)">
        <div class="ind-oee-card__copy">
            <span class="ind-overline">OEE · PRODUCCIÓN</span>
            <h3>Desempeño integral</h3>
            <p>Calculado contra el estándar técnico congelado por Planeación; los cambios de ciclo o cavidades durante la corrida no modifican este KPI.</p>
            <div class="ind-oee-components">
                <span><b>RQT</b>@kpi.RqtPct.ToString("N1")%</span>
                <span><b>RQL</b>@kpi.RqlPct.ToString("N1")%</span>
                <span><b>UE</b>@kpi.UePct.ToString("N1")%</span>
            </div>
            <button type="button" class="ind-inline-analysis" data-bs-toggle="modal" data-bs-target="#indSourceModal">
                <i class="fa-solid fa-database"></i> Ver fórmula y fuentes
            </button>
        </div>
        <div class="ind-oee-ring ind-oee-ring--semaforo" style="--oee:@CssPct(kpi.OeePct);--kpi-hue:@Hue(kpi.OeePct)">
            <div><strong>@kpi.OeePct.ToString("N1")%</strong><span>OEE</span></div>
        </div>
    </article>

    <article class="ind-prod-summary">
        <div><span>Producción OK</span><strong>@kpi.PiezasOK.ToString("N0")</strong><small>de @kpi.Objetivo.ToString("N0") objetivo estándar</small></div>
        <div><span>Tiempo observado</span><strong>@FmtMin(kpi.MinutosProduccion)</strong><small>@kpi.RegistrosHora registros hora</small></div>
        <div><span>Tiempo de paro</span><strong>@FmtMin(kpi.MinutosParo)</strong><small>@kpi.ParosPct.ToString("N2")% del tiempo observado</small></div>
        <div><span>Personal real</span><strong>@(kpi.Operadores + Model.Tecnicos.Count + Model.Auxiliares.Count)</strong><small>@kpi.Operadores operadores · @Model.Tecnicos.Count técnicos · @Model.Auxiliares.Count auxiliares</small></div>
    </article>
</section>

@if (kpi.ProgramasSinEstandar > 0)
{
    <div class="ind-standard-warning">
        <i class="fa-solid fa-triangle-exclamation"></i>
        <div><strong>@kpi.ProgramasSinEstandar programa(s) sin ObjetivoHora estándar.</strong><span>Esos programas necesitan completar el dato técnico para que RQT/OEE sean plenamente comparables.</span></div>
    </div>
}

<section class="ind-prod-metrics">
    <article class="ind-metric-card ind-sem-card" style="--kpi-hue:@Hue(kpi.RqtPct)"><span>RQT</span><strong>@kpi.RqtPct.ToString("N1")%</strong><div class="ind-meter"><i style="width:@CssPct(kpi.RqtPct)%"></i></div><small>OK / objetivo estándar</small></article>
    <article class="ind-metric-card ind-sem-card" style="--kpi-hue:@Hue(kpi.RqlPct)"><span>RQL</span><strong>@kpi.RqlPct.ToString("N1")%</strong><div class="ind-meter"><i style="width:@CssPct(kpi.RqlPct)%"></i></div><small>Calidad = 100 - % scrap</small></article>
    <article class="ind-metric-card ind-sem-card" style="--kpi-hue:@Hue(kpi.UePct)"><span>UE</span><strong>@kpi.UePct.ToString("N1")%</strong><div class="ind-meter"><i style="width:@CssPct(kpi.UePct)%"></i></div><small>Utilización efectiva · RU en el formato anterior</small></article>
    <article class="ind-metric-card ind-sem-card" style="--kpi-hue:@HuePerdida(kpi.ParosPct)"><span>% PAROS</span><strong>@kpi.ParosPct.ToString("N2")%</strong><div class="ind-meter"><i style="width:@CssPct(kpi.ParosPct)%"></i></div><small>@FmtMin(kpi.MinutosParo) acumulados</small></article>
    <article class="ind-metric-card ind-sem-card" style="--kpi-hue:@HuePerdida(kpi.ScrapPct)"><span>% SCRAP</span><strong>@kpi.ScrapPct.ToString("N2")%</strong><div class="ind-meter"><i style="width:@CssPct(kpi.ScrapPct)%"></i></div><small>@kpi.PiezasScrap.ToString("N0") piezas scrap</small></article>
    <article class="ind-metric-card"><span>NO CONFORME / SOSPECHOSO</span><strong>@kpi.PiezasSospechosas.ToString("N0")</strong><small>@kpi.TotalProducido.ToString("N0") piezas totales registradas</small></article>
</section>

<section class="ind-analytics-grid">
    <article class="ind-panel ind-panel--chart">
        <header class="ind-panel__head">
            <div><span>TENDENCIA</span><h3>OEE diario</h3></div>
            <button type="button" class="ind-panel-modal-btn" data-bs-toggle="modal" data-bs-target="#indSourceModal"><i class="fa-solid fa-circle-info"></i> Fuentes</button>
        </header>
        @if (tendencia.Count == 0)
        {
            <div class="ind-empty">No hay registros diarios en el periodo.</div>
        }
        else
        {
            <div class="ind-oee-chart" role="img" aria-label="Gráfica diaria de OEE">
                @foreach (var dia in tendencia)
                {
                    <div class="ind-oee-chart__item" title="@dia.Fecha.ToString("dd/MM/yyyy") · OEE @dia.OeePct.ToString("N1")% · RQT @dia.RqtPct.ToString("N1")% · RQL @dia.RqlPct.ToString("N1")% · UE @dia.UePct.ToString("N1")%">
                        <div class="ind-oee-chart__plot"><i style="height:@CssPct(dia.OeePct)%;--kpi-hue:@Hue(dia.OeePct)"></i><span>@dia.OeePct.ToString("N0")</span></div>
                        <small>@dia.Fecha.ToString("dd MMM")</small>
                    </div>
                }
            </div>
        }
    </article>

    <article class="ind-panel ind-panel--losses">
        <header class="ind-panel__head">
            <div><span>PÉRDIDAS</span><h3>Paros de producción</h3></div>
            <button type="button" class="ind-panel-modal-btn" data-bs-toggle="modal" data-bs-target="#indParosModal"><i class="fa-solid fa-chart-pie"></i> Abrir análisis</button>
        </header>
        <div class="ind-mini-tabs" data-ind-loss-tabs>
            <button type="button" class="active" data-ind-loss-tab="maquinas"><i class="fa-solid fa-industry"></i> Por máquina</button>
            <button type="button" data-ind-loss-tab="motivos"><i class="fa-solid fa-triangle-exclamation"></i> Por motivo</button>
        </div>

        <div data-ind-loss-panel="maquinas" class="ind-loss-machine-list">
            @foreach (var maq in Model.ParosMaquinas)
            {
                var ancho = maxParoMaquina <= 0 ? 0m : Math.Clamp(maq.Minutos * 100m / maxParoMaquina,0m,100m);
                <button type="button" class="ind-loss-machine-row" data-bs-toggle="modal" data-bs-target="#indParosModal" data-ind-paro-maquina-focus="@maq.MaquinaID">
                    <div><strong>@maq.Maquina</strong><small>@(string.IsNullOrWhiteSpace(maq.Nombre) ? "Máquina activa" : maq.Nombre)</small></div>
                    <div class="ind-loss-bar"><i style="width:@CssPct(ancho)%"></i></div>
                    <div class="ind-loss-machine-metrics"><b>@FmtMin(maq.Minutos)</b><small>@maq.Eventos evento(s)</small></div>
                </button>
            }
        </div>

        <div data-ind-loss-panel="motivos" class="ind-loss-list d-none">
            @if (!Model.ParosMotivos.Any())
            {
                <div class="ind-empty">No hay paros registrados en el periodo.</div>
            }
            else
            {
                var paroIndex = 0;
                @foreach (var paro in Model.ParosMotivos)
                {
                    var ancho = maxParoMotivo <= 0 ? 0m : Math.Clamp(paro.Minutos * 100m / maxParoMotivo,0m,100m);
                    <button type="button" class="ind-loss-row ind-loss-row--button" data-bs-toggle="modal" data-bs-target="#indParosModal" data-ind-paro-focus="@paroIndex">
                        <div><strong>@paro.Motivo</strong><small>@paro.Eventos evento(s) · @FmtMin(paro.Minutos)</small></div>
                        <div class="ind-loss-bar"><i style="width:@CssPct(ancho)%"></i></div>
                        <b>@paro.PorcentajeParo.ToString("N1")%</b>
                    </button>
                    paroIndex++;
                }
            }
        </div>
    </article>
</section>

<section class="ind-panel ind-panel--operators">
    <header class="ind-panel__head">
        <div><span>PERSONAL</span><h3>Rendimiento del personal real</h3></div>
        <small>Haz clic en una persona para ver cálculo y trazabilidad</small>
    </header>
    <div class="ind-person-tabs" data-ind-person-tabs>
        <button type="button" class="active" data-ind-person-tab="operadores"><i class="fa-solid fa-user-gear"></i> Operadores <span>@Model.Operadores.Count</span></button>
        <button type="button" data-ind-person-tab="tecnicos"><i class="fa-solid fa-screwdriver-wrench"></i> Técnicos <span>@Model.Tecnicos.Count</span></button>
        <button type="button" data-ind-person-tab="auxiliares"><i class="fa-solid fa-people-arrows"></i> Auxiliares <span>@Model.Auxiliares.Count</span></button>
    </div>

    <div data-ind-person-panel="operadores">
        @if (!Model.Operadores.Any()) { <div class="ind-empty">No hay operadores con producción en el periodo.</div> }
        else
        {
            <div class="ind-table-wrap"><table class="ind-table ind-table--analytics"><thead><tr><th>#</th><th>Operador</th><th>OEE</th><th>RQT</th><th>RQL</th><th>UE</th><th>% Paros</th><th>% Scrap</th><th>OK / Obj.</th></tr></thead><tbody>
            @{ var rankOp = 0; }
            @foreach (var op in Model.Operadores)
            {
                rankOp++;
                <tr class="ind-click-row" tabindex="0" role="button" data-bs-toggle="modal" data-bs-target="#indPersonModal" data-ind-person-detail
                    data-role="OPERADOR" data-name="@op.Operador" data-control="@op.NumeroControl" data-oee="@op.OeePct.ToString("0.##",CultureInfo.InvariantCulture)" data-rqt="@op.RqtPct.ToString("0.##",CultureInfo.InvariantCulture)" data-rql="@op.RqlPct.ToString("0.##",CultureInfo.InvariantCulture)" data-ue="@op.UePct.ToString("0.##",CultureInfo.InvariantCulture)" data-paros="@op.ParosPct.ToString("0.##",CultureInfo.InvariantCulture)" data-scrap="@op.ScrapPct.ToString("0.##",CultureInfo.InvariantCulture)" data-ok="@op.PiezasOK" data-objetivo="@op.Objetivo" data-sospechosas="@op.PiezasSospechosas" data-scrappiezas="@op.PiezasScrap" data-minutos="@op.MinutosProduccion.ToString(CultureInfo.InvariantCulture)" data-minutosparo="@op.MinutosParo.ToString(CultureInfo.InvariantCulture)" data-registros="@op.Registros">
                    <td><span class="ind-rank">@rankOp</span></td><td><strong>@op.Operador</strong><small>@(string.IsNullOrWhiteSpace(op.NumeroControl) ? $"Persona #{op.OperadorID}" : $"Control {op.NumeroControl}")</small></td><td><strong>@op.OeePct.ToString("N1")%</strong></td><td>@op.RqtPct.ToString("N1")%</td><td>@op.RqlPct.ToString("N1")%</td><td>@op.UePct.ToString("N1")%</td><td>@op.ParosPct.ToString("N2")%</td><td>@op.ScrapPct.ToString("N2")%</td><td>@op.PiezasOK.ToString("N0") / @op.Objetivo.ToString("N0")</td>
                </tr>
            }
            </tbody></table></div>
        }
    </div>

    <div data-ind-person-panel="tecnicos" class="d-none">
        @if (!Model.Tecnicos.Any()) { <div class="ind-empty">No hay técnicos confirmados en ejecuciones con producción en el periodo.</div> }
        else
        {
            <div class="ind-table-wrap"><table class="ind-table ind-table--analytics"><thead><tr><th>#</th><th>Técnico en Producción</th><th>OEE</th><th>RQT</th><th>RQL</th><th>UE</th><th>% Paros</th><th>% Scrap</th><th>OK / Obj.</th></tr></thead><tbody>
            @{ var rankTec = 0; }
            @foreach (var p in Model.Tecnicos)
            {
                rankTec++;
                <tr class="ind-click-row" tabindex="0" role="button" data-bs-toggle="modal" data-bs-target="#indPersonModal" data-ind-person-detail data-role="TECNICO" data-name="@p.Nombre" data-control="@p.NumeroControl" data-oee="@p.OeePct.ToString("0.##",CultureInfo.InvariantCulture)" data-rqt="@p.RqtPct.ToString("0.##",CultureInfo.InvariantCulture)" data-rql="@p.RqlPct.ToString("0.##",CultureInfo.InvariantCulture)" data-ue="@p.UePct.ToString("0.##",CultureInfo.InvariantCulture)" data-paros="@p.ParosPct.ToString("0.##",CultureInfo.InvariantCulture)" data-scrap="@p.ScrapPct.ToString("0.##",CultureInfo.InvariantCulture)" data-ok="@p.PiezasOK" data-objetivo="@p.Objetivo" data-sospechosas="@p.PiezasSospechosas" data-scrappiezas="@p.PiezasScrap" data-minutos="@p.MinutosProduccion.ToString(CultureInfo.InvariantCulture)" data-minutosparo="@p.MinutosParo.ToString(CultureInfo.InvariantCulture)" data-registros="@p.Registros">
                    <td><span class="ind-rank">@rankTec</span></td><td><strong>@p.Nombre</strong><small>@(string.IsNullOrWhiteSpace(p.NumeroControl) ? "Sin número de control" : $"Control {p.NumeroControl}")</small></td><td><strong>@p.OeePct.ToString("N1")%</strong></td><td>@p.RqtPct.ToString("N1")%</td><td>@p.RqlPct.ToString("N1")%</td><td>@p.UePct.ToString("N1")%</td><td>@p.ParosPct.ToString("N2")%</td><td>@p.ScrapPct.ToString("N2")%</td><td>@p.PiezasOK.ToString("N0") / @p.Objetivo.ToString("N0")</td>
                </tr>
            }
            </tbody></table></div>
        }
    </div>

    <div data-ind-person-panel="auxiliares" class="d-none">
        @if (!Model.Auxiliares.Any()) { <div class="ind-empty">No hay auxiliares confirmados en ejecuciones con producción en el periodo.</div> }
        else
        {
            <div class="ind-table-wrap"><table class="ind-table ind-table--analytics"><thead><tr><th>#</th><th>Auxiliar de Producción</th><th>OEE</th><th>RQT</th><th>RQL</th><th>UE</th><th>% Paros</th><th>% Scrap</th><th>OK / Obj.</th></tr></thead><tbody>
            @{ var rankAux = 0; }
            @foreach (var p in Model.Auxiliares)
            {
                rankAux++;
                <tr class="ind-click-row" tabindex="0" role="button" data-bs-toggle="modal" data-bs-target="#indPersonModal" data-ind-person-detail data-role="AUXILIAR" data-name="@p.Nombre" data-control="@p.NumeroControl" data-oee="@p.OeePct.ToString("0.##",CultureInfo.InvariantCulture)" data-rqt="@p.RqtPct.ToString("0.##",CultureInfo.InvariantCulture)" data-rql="@p.RqlPct.ToString("0.##",CultureInfo.InvariantCulture)" data-ue="@p.UePct.ToString("0.##",CultureInfo.InvariantCulture)" data-paros="@p.ParosPct.ToString("0.##",CultureInfo.InvariantCulture)" data-scrap="@p.ScrapPct.ToString("0.##",CultureInfo.InvariantCulture)" data-ok="@p.PiezasOK" data-objetivo="@p.Objetivo" data-sospechosas="@p.PiezasSospechosas" data-scrappiezas="@p.PiezasScrap" data-minutos="@p.MinutosProduccion.ToString(CultureInfo.InvariantCulture)" data-minutosparo="@p.MinutosParo.ToString(CultureInfo.InvariantCulture)" data-registros="@p.Registros">
                    <td><span class="ind-rank">@rankAux</span></td><td><strong>@p.Nombre</strong><small>@(string.IsNullOrWhiteSpace(p.NumeroControl) ? "Sin número de control" : $"Control {p.NumeroControl}")</small></td><td><strong>@p.OeePct.ToString("N1")%</strong></td><td>@p.RqtPct.ToString("N1")%</td><td>@p.RqlPct.ToString("N1")%</td><td>@p.UePct.ToString("N1")%</td><td>@p.ParosPct.ToString("N2")%</td><td>@p.ScrapPct.ToString("N2")%</td><td>@p.PiezasOK.ToString("N0") / @p.Objetivo.ToString("N0")</td>
                </tr>
            }
            </tbody></table></div>
        }
    </div>
</section>

<section class="ind-analytics-grid ind-analytics-grid--machines-standard">
    <article class="ind-panel">
        <header class="ind-panel__head"><div><span>ACTIVOS</span><h3>OEE por máquina</h3></div><small>Haz clic para analizar</small></header>
        @if (!Model.Maquinas.Any()) { <div class="ind-empty">Sin datos por máquina.</div> }
        else
        {
            <div class="ind-machine-list">
                @foreach (var maq in Model.Maquinas)
                {
                    <button type="button" class="ind-machine-row ind-machine-row--button ind-sem-row" style="--kpi-hue:@Hue(maq.OeePct)" data-bs-toggle="modal" data-bs-target="#indMachineModal" data-ind-machine-detail data-name="@maq.Maquina" data-oee="@maq.OeePct.ToString("0.##",CultureInfo.InvariantCulture)" data-rqt="@maq.RqtPct.ToString("0.##",CultureInfo.InvariantCulture)" data-rql="@maq.RqlPct.ToString("0.##",CultureInfo.InvariantCulture)" data-ue="@maq.UePct.ToString("0.##",CultureInfo.InvariantCulture)" data-paros="@maq.ParosPct.ToString("0.##",CultureInfo.InvariantCulture)" data-scrap="@maq.ScrapPct.ToString("0.##",CultureInfo.InvariantCulture)" data-ok="@maq.PiezasOK" data-objetivo="@maq.Objetivo" data-sospechosas="@maq.PiezasSospechosas" data-scrappiezas="@maq.PiezasScrap" data-minutos="@maq.MinutosProduccion.ToString(CultureInfo.InvariantCulture)" data-minutosparo="@maq.MinutosParo.ToString(CultureInfo.InvariantCulture)">
                        <div><strong>@maq.Maquina</strong><small>@maq.PiezasOK.ToString("N0") OK · @maq.ScrapPct.ToString("N2")% scrap · @maq.ParosPct.ToString("N2")% paros</small></div>
                        <div class="ind-machine-factors"><span>RQT <b>@maq.RqtPct.ToString("N1")%</b></span><span>RQL <b>@maq.RqlPct.ToString("N1")%</b></span><span>UE <b>@maq.UePct.ToString("N1")%</b></span></div>
                        <div class="ind-machine-oee"><strong>@maq.OeePct.ToString("N1")%</strong><div class="ind-meter"><i style="width:@CssPct(maq.OeePct)%"></i></div></div>
                    </button>
                }
            </div>
        }
    </article>

    <article class="ind-panel ind-standard-explainer">
        <header class="ind-panel__head"><div><span>ESTÁNDAR KPI</span><h3>Fuente protegida</h3></div><button type="button" class="ind-panel-modal-btn" data-bs-toggle="modal" data-bs-target="#indSourceModal"><i class="fa-solid fa-database"></i> Ver fuentes</button></header>
        <div class="ind-source-flow">
            <div><span>1</span><strong>Planeacion_ProgramaProduccion</strong><small>Snapshot de ObjetivoHora, Ciclo y Cavidades al programar.</small></div>
            <i class="fa-solid fa-arrow-down"></i>
            <div><span>2</span><strong>ERP_ParteDatosTecnicos</strong><small>Respaldo solo cuando el snapshot histórico no tiene el dato.</small></div>
            <i class="fa-solid fa-shield-halved"></i>
            <div class="protected"><strong>Fuera del KPI</strong><small>Produccion_ConfiguracionCorrida y ObjetivoHora/ObjetivoBloque operativos.</small></div>
        </div>
    </article>
</section>

<section class="ind-panel ind-panel--standards">
    <header class="ind-panel__head"><div><span>OF / PARTE</span><h3>Desglose contra estándar de base de datos</h3></div><small>Haz clic en Analizar para ver cálculo y fuentes</small></header>
    @if (!Model.ProgramasProduccion.Any()) { <div class="ind-empty">No hay OF con registros de producción en el periodo.</div> }
    else
    {
        <div class="ind-table-wrap"><table class="ind-table ind-table--standards"><thead><tr><th>OF</th><th>Parte</th><th>Máquina</th><th>Obj/h</th><th>Ciclo</th><th>Cav.</th><th>RQT</th><th>RQL</th><th>UE</th><th>OEE</th><th></th></tr></thead><tbody>
        @foreach (var item in Model.ProgramasProduccion)
        {
            <tr class="@(item.TieneEstandar ? string.Empty : "is-missing-standard")">
                <td><strong>@item.NumeroOF</strong><small>Programa @item.ProgramaProduccionID</small></td><td><strong>@item.Parte</strong><small>@item.DescripcionParte</small></td><td>@item.Maquina</td><td>@(item.ObjetivoHoraEstandar > 0 ? item.ObjetivoHoraEstandar.ToString("N0") : "—")</td><td>@(string.IsNullOrWhiteSpace(item.CicloEstandar) ? "—" : item.CicloEstandar)</td><td>@(item.CavidadesEstandar?.ToString() ?? "—")</td><td>@item.RqtPct.ToString("N1")%</td><td>@item.RqlPct.ToString("N1")%</td><td>@item.UePct.ToString("N1")%</td><td><strong>@item.OeePct.ToString("N1")%</strong></td>
                <td><button type="button" class="ind-detail-btn" data-bs-toggle="modal" data-bs-target="#indProgramModal" data-ind-program-detail data-of="@item.NumeroOF" data-programa="@item.ProgramaProduccionID" data-parte="@item.Parte" data-descripcion="@item.DescripcionParte" data-maquina="@item.Maquina" data-fuente="@item.FuenteEstandar" data-objetivohora="@item.ObjetivoHoraEstandar" data-ciclo="@item.CicloEstandar" data-cavidades="@(item.CavidadesEstandar?.ToString() ?? string.Empty)" data-ok="@item.PiezasOK" data-sospechosas="@item.PiezasSospechosas" data-scrap="@item.PiezasScrap" data-objetivo="@item.Objetivo" data-minutos="@item.MinutosProduccion.ToString(CultureInfo.InvariantCulture)" data-minutosparo="@item.MinutosParo.ToString(CultureInfo.InvariantCulture)" data-rqt="@item.RqtPct.ToString("0.##",CultureInfo.InvariantCulture)" data-rql="@item.RqlPct.ToString("0.##",CultureInfo.InvariantCulture)" data-ue="@item.UePct.ToString("0.##",CultureInfo.InvariantCulture)" data-oee="@item.OeePct.ToString("0.##",CultureInfo.InvariantCulture)" data-parospct="@item.ParosPct.ToString("0.##",CultureInfo.InvariantCulture)" data-scrappct="@item.ScrapPct.ToString("0.##",CultureInfo.InvariantCulture)"><i class="fa-solid fa-chart-line"></i> Analizar</button></td>
            </tr>
        }
        </tbody></table></div>
    }
</section>

<div class="ind-note ind-note--formula"><i class="fa-solid fa-circle-info"></i><span><b>RQT</b> = piezas OK / objetivo estándar. <b>RQL</b> = 100 - % scrap. <b>UE</b> = 100 - % paros. <b>OEE</b> = RQT (acotado a 100%) × RQL × UE.</span></div>

