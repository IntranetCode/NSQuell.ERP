@model ERP.NSQuell.Models.ViewModels.Indicadores.IndicadoresDashboardVm
@{
    var g=Model.GP12;
    decimal nokPct=g.Revisado<=0?0m:Math.Clamp(g.NOK*100m/g.Revisado,0m,100m);
    decimal retrabajoPct=g.Revisado<=0?0m:Math.Clamp(g.Retrabajado*100m/g.Revisado,0m,100m);
    decimal pendPct=g.Solicitado<=0?0m:Math.Clamp(g.Pendiente*100m/g.Solicitado,0m,100m);
}
<section class="ind-area-hero"><article class="ind-area-hero__main"><span class="ind-overline">GP12</span><h3>Conformidad de inspección</h3><strong class="ind-area-big">@g.ConformidadPct.ToString("N1")%</strong><p>@g.OK.ToString("N0") piezas OK de @g.Revisado.ToString("N0") revisadas.</p><div class="ind-meter"><i style="width:@Math.Clamp(g.ConformidadPct,0m,100m)%"></i></div></article><div class="ind-area-hero__summary"><div><span>Avance</span><strong>@g.AvancePct.ToString("N1")%</strong><small>@g.Procesado.ToString("N0") procesado</small></div><div><span>Scrap</span><strong>@g.ScrapPct.ToString("N2")%</strong><small>@g.Scrap.ToString("N0") piezas</small></div><div><span>NOK</span><strong>@nokPct.ToString("N2")%</strong><small>@g.NOK.ToString("N0") piezas</small></div><div><span>Pendiente</span><strong>@pendPct.ToString("N1")%</strong><small>@g.SolicitudesPendientes solicitudes</small></div></div></section>
<section class="ind-area-grid"><article class="ind-panel"><header class="ind-panel__head"><div><span>DESGLOSE</span><h3>Resultado del periodo</h3></div></header><div class="ind-analysis-tiles"><div><span>Solicitudes</span><strong>@g.Solicitudes</strong><small>@g.Solicitado.ToString("N0") piezas solicitadas</small></div><div><span>Inspecciones</span><strong>@g.Inspecciones</strong><small>@g.Revisado.ToString("N0") piezas revisadas</small></div><div><span>Retrabajo</span><strong>@g.Retrabajado.ToString("N0")</strong><small>@retrabajoPct.ToString("N2")% de lo revisado</small></div><div><span>Saldo</span><strong>@g.Pendiente.ToString("N0")</strong><small>cantidad aún pendiente</small></div></div></article><aside class="ind-panel ind-area-source"><header class="ind-panel__head"><div><span>LECTURA DE DATOS</span><h3>Solicitudes + inspección real</h3></div><button type="button" class="ind-panel-modal-btn" data-bs-toggle="modal" data-bs-target="#indGp12Info">Ver detalle</button></header><p>El avance viene de solicitudes; conformidad, NOK, retrabajo y scrap vienen de los resultados reales de inspección GP12.</p></aside></section>
<div class="modal fade" id="indGp12Info" tabindex="-1" aria-hidden="true"><div class="modal-dialog modal-lg modal-dialog-centered"><div class="modal-content ind-program-modal"><div class="modal-header"><div><span class="ind-overline">GP12</span><h5 class="modal-title">Cómo se construye</h5></div><button class="btn-close" data-bs-dismiss="modal"></button></div><div class="modal-body"><div class="ind-origin-grid"><div><span>Demanda</span><b>GP12_Solicitudes</b><small>Cantidad solicitada, procesada y pendiente.</small></div><div><span>Resultado</span><b>GP12_Inspecciones</b><small>Revisado, OK, NOK, retrabajo y scrap.</small></div></div></div></div></div></div>