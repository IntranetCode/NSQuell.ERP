@model ERP.NSQuell.Models.ViewModels.Indicadores.IndicadoresDashboardVm
@{
    var c=Model.Compras;
    decimal urgPct=c.PendientesFlujo<=0?0m:Math.Clamp(c.UrgentesPendientes*100m/c.PendientesFlujo,0m,100m);
}
<section class="ind-area-hero"><article class="ind-area-hero__main"><span class="ind-overline">COMPRAS</span><h3>Recepción y flujo abierto</h3><strong class="ind-area-big">@c.RecepcionATiempoPct.ToString("N1")%</strong><p>@c.RecepcionesATiempo recepciones dentro de fecha de @c.Recepciones registradas.</p><div class="ind-meter"><i style="width:@Math.Clamp(c.RecepcionATiempoPct,0m,100m)%"></i></div></article><div class="ind-area-hero__summary"><div><span>Monto de órdenes</span><strong>@c.MontoOrdenes.ToString("C0")</strong><small>@c.OrdenesCompra órdenes</small></div><div><span>Solicitudes nuevas</span><strong>@c.Solicitudes</strong><small>generadas en el periodo</small></div><div><span>Flujo abierto</span><strong>@c.PendientesFlujo</strong><small>@urgPct.ToString("N1")% prioritario</small></div><div><span>Antigüedad</span><strong>@c.PromedioDiasEnEstatus.ToString("N1") d</strong><small>promedio en estatus</small></div></div></section>
<section class="ind-area-grid"><article class="ind-panel"><header class="ind-panel__head"><div><span>SEGUIMIENTO</span><h3>Presión del flujo de compras</h3></div></header><div class="ind-analysis-tiles"><div><span>Abiertas</span><strong>@c.PendientesFlujo</strong><small>solicitudes no finales</small></div><div><span>Urgentes / críticas</span><strong>@c.UrgentesPendientes</strong><small>@urgPct.ToString("N1")% del flujo abierto</small></div><div><span>Órdenes</span><strong>@c.OrdenesCompra</strong><small>@c.MontoOrdenes.ToString("C0") emitido</small></div><div><span>Recepciones</span><strong>@c.Recepciones</strong><small>@c.RecepcionesATiempo a tiempo</small></div></div></article><aside class="ind-panel ind-area-source"><header class="ind-panel__head"><div><span>LECTURA DE DATOS</span><h3>Solicitud → orden → recepción</h3></div><button type="button" class="ind-panel-modal-btn" data-bs-toggle="modal" data-bs-target="#indComprasInfo">Ver detalle</button></header><p>El tablero sigue el flujo real de solicitud, su estatus vigente, órdenes emitidas y recepciones contra fecha estimada.</p></aside></section>
<div class="modal fade" id="indComprasInfo" tabindex="-1" aria-hidden="true"><div class="modal-dialog modal-lg modal-dialog-centered"><div class="modal-content ind-program-modal"><div class="modal-header"><div><span class="ind-overline">COMPRAS</span><h5 class="modal-title">Datos del flujo</h5></div><button class="btn-close" data-bs-dismiss="modal"></button></div><div class="modal-body"><div class="ind-origin-grid"><div><span>Solicitudes</span><b>ComprasSolicitudes / vw_ComprasSolicitudes_Flujo</b><small>Prioridad, estatus final y días en estatus.</small></div><div><span>Órdenes</span><b>ComprasOrdenes</b><small>Total y fecha de emisión.</small></div><div><span>Recepciones</span><b>ComprasRecepciones</b><small>Fecha real comparada con la estimada de la orden.</small></div></div></div></div></div></div>