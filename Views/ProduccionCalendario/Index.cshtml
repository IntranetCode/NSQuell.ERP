            border-radius: 10px;
            padding: 7px 9px;
            min-width: 120px;
            background: var(--bs-tertiary-bg);
        }

            .operativa-meta-item small {
                display: block;
                color: var(--bs-secondary-color);
                font-weight: 800;
                font-size: .64rem;
                text-transform: uppercase;
                margin-bottom: 2px;
            }

