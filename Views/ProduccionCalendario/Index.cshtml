            border: 1px solid var(--bs-border-color);
            border-radius: 16px;
            background: var(--bs-body-bg);
            padding: 14px 16px;
            box-shadow: 0 4px 14px rgba(15, 23, 42, .05);
        }

            .operativa-summary-card small {
                display: block;
                color: var(--bs-secondary-color);
                font-weight: 800;
                text-transform: uppercase;
                letter-spacing: .04em;
                margin-bottom: 4px;
                font-size: .68rem;
            }

            .operativa-summary-card strong {
                display: block;
                font-size: 1.45rem;
                line-height: 1;
            }

        .operational-attention-indicator {
            position: absolute;
            top: 4px;
            right: 4px;
            z-index: 8;
            width: 19px;
            height: 19px;
            display: inline-flex;
            align-items: center;
            justify-content: center;
            border-radius: 999px;
            background: #dc3545;
            color: #fff;
            font-size: .62rem;
            box-shadow: 0 1px 5px rgba(0, 0, 0, .22);
        }

        .operational-blocked-indicator {
            position: absolute;
            top: 4px;
            right: 27px;
            z-index: 8;
            width: 19px;
            height: 19px;
            display: inline-flex;
            align-items: center;
            justify-content: center;
            border-radius: 999px;
            background: #111827;
            color: #fff;
            font-size: .60rem;
            box-shadow: 0 1px 5px rgba(0, 0, 0, .22);
        }

        .operativa-modal-state {
            display: inline-flex;
            align-items: center;
            gap: 7px;
            padding: 6px 10px;
            border-radius: 999px;
