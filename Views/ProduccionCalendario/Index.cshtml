    </style>
}

<div class="page production-calendar-readonly vista-@vistaActual @(mostrarReglaHoras ? "calendar-with-hours" : "calendar-days-only")"
     data-calendar-view="@vistaActual"
     data-total-dias="@totalDias"
     data-total-horas="@totalHorasPeriodo"
     data-nsq-style="--dias-periodo:@totalDias;--horas-periodo:@totalHorasPeriodo;">

    <section class="hero">
        <div class="d-flex justify-content-between align-items-start gap-3 flex-wrap">
            <div>
                <div class="small fw-bold text-uppercase opacity-75 mb-2">
                    Producción / Centro operativo
                </div>

                <h1>
                    <i class="fa-solid fa-calendar-days me-2"></i>
                    CALENDARIO OPERATIVO DE PRODUCCIÓN
                </h1>

                <p>
                    Consulta la programación de las máquinas y selecciona una OF para ver qué actividad corresponde realizar ahora. Este calendario es de solo lectura y no permite mover ni reprogramar bloques.
                </p>
            </div>

            <div class="d-flex gap-2 flex-wrap">
                <a href="@Url.Action("Index", "Produccion")"
                   class="btn btn-light fw-bold">
                    <i class="fa-solid fa-arrow-left me-1"></i>
                    Producción
                </a>
            </div>
        </div>
    </section>

    <section class="metrics">
        <div class="metric">
            <span>Máquinas</span>
            <strong>@Model.TotalMaquinas</strong>
        </div>

        <div class="metric">
            <span>OF / programas visibles</span>
            <strong>@Model.TotalBloques</strong>
        </div>

        <div class="metric">
            <span>Trabajando ahora</span>
            <strong>@Model.TrabajandoAhora</strong>
        </div>
    </section>

    <section class="operativa-summary">
        <div class="operativa-summary-card">
            <small>Atención inmediata</small>
            <strong class="text-danger">@resumenOperativo.AtencionInmediata</strong>
        </div>

        <div class="operativa-summary-card">
            <small>Bloqueadas</small>
            <strong>@resumenOperativo.Bloqueadas</strong>
        </div>

        <div class="operativa-summary-card">
            <small>En preparación</small>
            <strong>@resumenOperativo.EnPreparacion</strong>
        </div>

        <div class="operativa-summary-card">
            <small>Produciendo</small>
            <strong>@resumenOperativo.Produciendo</strong>
        </div>
    </section>

    <section class="toolbar">
        <div class="d-flex justify-content-between align-items-end gap-3 flex-wrap">
            <div class="d-flex gap-2 flex-wrap">
                <a href="@UrlPeriodo(periodoAnterior)"
                   class="btn btn-outline-primary fw-bold">
                    <i class="fa-solid fa-chevron-left"></i>
                    @TextoPeriodoAnterior(Model)
                </a>

                <a asp-controller="ProduccionCalendario"
                   asp-action="Index"
                   asp-route-vista="@Model.VistaNormalizada"
                   asp-route-fecha="@DateTime.Today.ToString("yyyy-MM-dd")"
                   class="btn btn-primary fw-bold">
                    Hoy
                </a>

                <a href="@UrlPeriodo(periodoSiguiente)"
                   class="btn btn-outline-primary fw-bold">
                    @TextoPeriodoSiguiente(Model)
                    <i class="fa-solid fa-chevron-right"></i>
                </a>
            </div>

            <div data-nsq-style-id="nsq-si-e581e86b44">
                <label class="form-label fw-bold mb-1">
                    Buscar máquina, OF, cliente, parte, operador o turno
                </label>

                <input id="calendarSearch"
                       class="form-control"
                       type="search"
                       autocomplete="off"
                       placeholder="Ej. 500-T, OF 24, GOLDE, operador, turno..." />
            </div>
        </div>

        <div class="d-flex gap-2 flex-wrap mt-3">
            <a asp-controller="ProduccionCalendario"
               asp-action="Index"
               asp-route-vista="dia"
               asp-route-fecha="@fechaBaseFiltros.ToString("yyyy-MM-dd")"
               class="@ClaseVista(Model.VistaNormalizada, "dia")">
                Día
            </a>

            <a asp-controller="ProduccionCalendario"
               asp-action="Index"
               asp-route-vista="semana"
               asp-route-fecha="@fechaBaseFiltros.ToString("yyyy-MM-dd")"
               class="@ClaseVista(Model.VistaNormalizada, "semana")">
                Semana
            </a>

            <a asp-controller="ProduccionCalendario"
               asp-action="Index"
               asp-route-vista="mes"
               asp-route-fecha="@fechaBaseFiltros.ToString("yyyy-MM-dd")"
               class="@ClaseVista(Model.VistaNormalizada, "mes")">
                Mes
            </a>

            <button type="button"
                    id="btnMostrarRango"
                    class="@ClaseVista(Model.VistaNormalizada, "rango")">
                Rango
            </button>
        </div>

        <form id="formRangoCalendario"
              class="range-panel @(Model.EsVistaRango ? "active" : "")"
              asp-controller="ProduccionCalendario"
              asp-action="Index"
              method="get">
            <input type="hidden" name="vista" value="rango" />

            <div class="row g-2 align-items-end">
                <div class="col-md-4">
                    <label class="form-label fw-bold">Fecha inicio</label>
                    <input id="rangoInicio"
                           name="rangoInicio"
                           class="form-control"
                           type="date"
                           value="@rangoInicioVisible" />
                </div>

                <div class="col-md-4">
                    <label class="form-label fw-bold">Fecha fin</label>
                    <input id="rangoFin"
                           name="rangoFin"
                           class="form-control"
                           type="date"
                           value="@rangoFinVisible" />
                </div>

                <div class="col-md-4">
                    <button type="submit"
                            class="btn btn-primary fw-bold w-100">
                        Aplicar rango
                    </button>
                </div>

                <div class="col-12">
                    <small class="text-muted fw-bold">
                        El rango no puede ser mayor a 31 días.
                    </small>
                </div>
            </div>
        </form>
    </section>

    @{
        var errorCalendario = TempData["Error"] as string
        ?? TempData["CalendarioError"] as string;
    }

    @if (!string.IsNullOrWhiteSpace(errorCalendario))
    {
        <div class="calendar-status error">
            <i class="fa-solid fa-circle-exclamation me-1"></i>
            @errorCalendario
        </div>
    }

    <div id="calendarStatus" class="calendar-status operational">
        <i class="fa-solid fa-circle-info me-1"></i>
        Selecciona una OF. El modal mostrará la actividad actual, el responsable, el bloqueo si existe y el botón para continuar el flujo.
        <span class="ms-2 text-muted">
            Datos actualizados: @fechaConsultaOperativa.ToString("dd/MM/yyyy HH:mm")
        </span>
        <span class="calendar-live-clock" title="Hora local de este equipo">
            <i class="fa-regular fa-clock"></i>
            Ahora <span id="calendarLiveClock">--:--</span>
        </span>
    </div>

    <section class="calendar-card" id="calendarKiosk">
        <div class="calendar-card-header p-2 border-bottom d-flex justify-content-between align-items-center gap-3 flex-wrap">
            <div>
                <strong class="text-primary">
                    @Model.TituloPeriodo
                </strong>

                <div class="small text-muted">
                    Vista: @Model.TextoVista. El calendario es exclusivamente de consulta operativa; no permite arrastrar bloques ni modificar la programación.
                </div>
            </div>

            <div class="calendar-actions">
                <button type="button"
                        id="btnCompactarCalendario"
                        class="btn-calendar-action"
                        title="Reduce textos y espacios para mostrar más máquinas">
                    <i class="fa-solid fa-compress"></i>
                    <span>Compactar</span>
                </button>

                <button type="button"
                        id="btnPantallaCompletaCalendario"
                        class="btn-calendar-action"
                        title="Abrir calendario en modo kiosco a pantalla completa">
                    <i class="fa-solid fa-expand"></i>
                    <span class="fullscreen-label">Pantalla completa</span>
                </button>

                <span class="fullscreen-help">Esc para salir</span>
                <span id="fitScaleLabel" class="fit-scale-label"></span>
            </div>

            <div class="legend">
                <span><i data-nsq-style-id="nsq-si-93d879e3cf"></i>Programado</span>
                <span><i data-nsq-style-id="nsq-si-1c4b44484e"></i>Produciendo / en línea</span>
                <span><i data-nsq-style-id="nsq-si-31a65355ef"></i>Paro</span>
                <span><i data-nsq-style-id="nsq-si-b64b5184b1"></i>Calidad</span>
                <span><i data-nsq-style-id="nsq-si-147df738d9"></i>Reliberación</span>
                <span><i data-nsq-style-id="nsq-si-31d8aa2278"></i>Ya producido</span>
                <span><i data-nsq-style-id="nsq-si-e71927bd00"></i>Cerrado / cancelado</span>
            </div>
        </div>

        <div class="timeline-scroll">
            <div class="timeline">
                <div class="timeline-header">
                    <div class="machine-head">MÁQUINA / BLOQUES</div>

                    <div class="days">
                        @for (var day = 0; day < totalDias; day++)
                        {
                            var fecha = inicioPeriodo.AddDays(day);
                            <div class="day" data-calendar-date="@fecha.ToString("yyyy-MM-dd")">
                                <strong>@fecha.ToString("ddd", cultura).ToUpperInvariant()</strong>
                                <span>@fecha.ToString("dd/MM")</span>
                            </div>
                        }
                    </div>
                </div>

                @foreach (var maquina in Model.Maquinas)
                {
                    var rowHeight = Math.Max(56, 8 + maquina.Carriles * 48);

                    var searchText = string.Join(
                    " ",
                    maquina.Codigo,
                    maquina.Nombre,
                    string.Join(
                    " ",
                    maquina.Bloques.Select(x =>
                    $"{x.OFTexto} {x.ClienteNombre} {x.ParteTexto} {x.Descripcion} {x.MoldeCodigo} {x.MaquinaSugeridaTexto} {x.EstadoSemaforoTexto} {x.OperadorProgramadoNombre} {x.OperadorRealNombre} {x.TurnoProgramadoNombre} {x.EstatusProduccionNombre} {x.EstadoCalidad}")))
                    .ToLowerInvariant();

                    <div class="machine-row calendar-machine-row"
                         data-search="@searchText">

                        <div class="machine-info"
                             data-nsq-style="height:@(rowHeight)px">
                            <div class="machine-inline"
                                 title="@maquina.Codigo - @maquina.Nombre">
                                <span class="machine-code">@maquina.Codigo</span>
                                <span class="machine-name">@maquina.Nombre</span>
                                <span class="machine-count">@maquina.Bloques.Count</span>
                            </div>
                        </div>

                        <div class="track"
                             data-maquina-id="@maquina.MaquinaID"
                             data-nsq-style="height:@(rowHeight)px">

                            <div class="now-line d-none"
                                 data-now-line-operativo
                                 title="Hora actual"></div>

                            @if (!maquina.Bloques.Any())
                            {
                                <div class="empty-row">
                                    Sin OF programada durante este periodo.
                                </div>
                            }

                            @foreach (var bloque in maquina.Bloques)
                            {
                                var inicioVisualBloque = bloque.InicioVisual;
                                var finVisualBloque = bloque.FinVisual;
                                var visibleInicio = inicioVisualBloque < inicioPeriodo ? inicioPeriodo : inicioVisualBloque;
                                var visibleFin = finVisualBloque > finPeriodo ? finPeriodo : finVisualBloque;

                                var left =
                                (visibleInicio - inicioPeriodo).TotalMinutes
                                / totalMinutos * 100;

                                var width = Math.Max(
                                .35,
                                (visibleFin - visibleInicio).TotalMinutes
                                / totalMinutos * 100);

                                var top = 8 + bloque.Carril * 48;

                                operativaPorPrograma.TryGetValue(
                                bloque.ProgramaProduccionID,
                                out var operativa);

                                var textoOperador = bloque.TextoOperadorVisible;
                                var origenOperador = bloque.TieneOperadorReal
                                ? "Real"
                                : "Planeado";

                                var textoTurno = bloque.TextoTurnoProgramado;
                                var textoCalidad = bloque.EstadoCalidadTexto;

                                var minutosAtrasoInicio = bloque.Inicio < Model.Ahora
                                ? Math.Max(
                                0,
                                (int)Math.Floor(
                                (Model.Ahora - bloque.Inicio).TotalMinutes))
                                : 0;

                                var mostrarAlertaNoInicio =
                                bloque.EstatusID == 1
                                && minutosAtrasoInicio >= 10
                                && bloque.EstatusProduccionID != 3;

                                var textoAlertaNoInicio = mostrarAlertaNoInicio
                                ? $"Producción no inició a la hora programada. Atraso: {minutosAtrasoInicio} min."
                                : string.Empty;

                                var claseColorBloque = bloque.ClaseSemaforoCalendario;

                                if (operativa != null)
                                {
                                    if (operativa.EstadoGeneral == AgendaOperativaEstadoGeneral.Pausada
                                    || operativa.EstadoGeneral == AgendaOperativaEstadoGeneral.InterrumpidaUrgente
                                    || operativa.EstadoGeneral == AgendaOperativaEstadoGeneral.Bloqueada)
                                    {
                                        claseColorBloque = "bloque-paro";
                                    }
                                    else if (operativa.EstadoGeneral == AgendaOperativaEstadoGeneral.Reliberacion)
                                    {
                                        claseColorBloque = "bloque-reliberacion";
                                    }
                                    else if (operativa.EstadoGeneral == AgendaOperativaEstadoGeneral.EsperandoCalidad)
                                    {
                                        claseColorBloque = "bloque-calidad";
                                    }
                                    else if (operativa.EstadoGeneral == AgendaOperativaEstadoGeneral.Produciendo)
                                    {
                                        claseColorBloque = "bloque-produciendo";
                                    }
                                    else if (operativa.EstadoGeneral == AgendaOperativaEstadoGeneral.MaquinaLiberada
                                    || operativa.EstadoGeneral == AgendaOperativaEstadoGeneral.Terminada)
                                    {
                                        claseColorBloque = "bloque-producido";
                                    }
                                }
                                else
                                {
                                    var estadoCalidadNormalizado =
                                    (bloque.EstadoCalidad ?? string.Empty)
                                    .Trim()
                                    .ToUpperInvariant();

                                    if (bloque.EstatusProduccionID == 4)
                                    {
                                        claseColorBloque = "bloque-paro";
                                    }
                                    else if (bloque.RequiereReliberacion
                                    || bloque.ConfiguracionCalidadInvalidada)
                                    {
                                        claseColorBloque = "bloque-reliberacion";
                                    }
                                    else if (bloque.InspeccionCalidadID.HasValue
                                    && !string.IsNullOrWhiteSpace(estadoCalidadNormalizado)
                                    && estadoCalidadNormalizado != "CERRADA")
                                    {
                                        claseColorBloque = "bloque-calidad";
                                    }
                                    else if (bloque.EstatusProduccionID == 3)
                                    {
                                        claseColorBloque = "bloque-produciendo";
                                    }
                                }

                                var estadoOperativoTexto = operativa?.EstadoGeneralTexto
                                ?? bloque.EstadoSemaforoTexto;

                                <button type="button"
                                        class="block @claseColorBloque no-drag @(mostrarAlertaNoInicio ? "has-start-delay" : "")"
                                        draggable="false"
                                        data-nsq-style="left:@Pct(left)%;width:@Pct(width)%;top:@(top)px"
                                        data-programa-id="@bloque.ProgramaProduccionID"
                                        data-maquina-id="@bloque.MaquinaID"
                                        data-inicio-oficial="@bloque.Inicio.ToString("yyyy-MM-ddTHH:mm:ss")"
                                        data-fin-oficial="@bloque.Fin.ToString("yyyy-MM-ddTHH:mm:ss")"
                                        data-inicio-proyectado="@(bloque.InicioProyectado?.ToString("yyyy-MM-ddTHH:mm:ss") ?? "")"
                                        data-fin-proyectado="@(bloque.FinProyectado?.ToString("yyyy-MM-ddTHH:mm:ss") ?? "")"
                                        data-bs-toggle="modal"
                                        data-bs-target="#ofModal_@bloque.ProgramaProduccionID"
                                        title="@bloque.OFTexto · @bloque.ParteTexto · @estadoOperativoTexto · @bloque.InicioVisual.ToString("dd/MM HH:mm") - @bloque.FinVisual.ToString("dd/MM HH:mm") · Operador @origenOperador: @textoOperador · Turno: @textoTurno · Calidad: @textoCalidad">

                                    @if (mostrarAlertaNoInicio)
                                    {
                                        <span class="start-delay-alert"
                                              title="@textoAlertaNoInicio">
                                            <i class="fa-solid fa-bell"></i>
                                        </span>
                                    }

                                    @if (operativa?.EstaBloqueada == true)
                                    {
                                        <span class="operational-blocked-indicator"
                                              title="@(operativa.MotivoBloqueo ?? "Flujo bloqueado")">
                                            <i class="fa-solid fa-lock"></i>
                                        </span>
                                    }

                                    @if (operativa?.RequiereAtencionInmediata == true)
                                    {
                                        <span class="operational-attention-indicator"
                                              title="Requiere atención inmediata">
                                            <i class="fa-solid fa-exclamation"></i>
                                        </span>
                                    }

                                    <strong>
                                        @bloque.OFTexto · @bloque.ParteTexto
                                    </strong>

                                    <span>
                                        @(bloque.ClienteNombre ?? "Sin cliente") ·
                                        @estadoOperativoTexto
                                    </span>

                                    <span class="operator-line">
                                        <i class="fa-solid fa-user-gear"></i>
                                        @origenOperador: @textoOperador · @textoTurno
                                    </span>
                                </button>
                            }
                        </div>
                    </div>
                }
            </div>
        </div>
    </section>
</div>

@foreach (var bloque in Model.Maquinas.SelectMany(x => x.Bloques))
{
    operativaPorPrograma.TryGetValue(
        bloque.ProgramaProduccionID,
        out var operativa);

    var accionActual = operativa?.AccionActual;
    var siguienteAccion = operativa?.SiguienteAccion;
    var accionActualEsCalidad = EsAccionCalidad(accionActual);

    var textoOperadorModal = bloque.TextoOperadorProgramado;
    var textoOperadorRealModal = bloque.TextoOperadorReal;
    var textoAuxiliarModal = bloque.TextoOperadorAuxiliarProgramado;
    var textoTurnoModal = bloque.TextoTurnoProgramado;
    var textoCalidadModal = bloque.EstadoCalidadTexto;

    var textoEstatusProduccion = TextoProduccion(
        bloque.EstatusProduccionID,
        bloque.EstatusProduccionNombre);

    var porcentajeAvance = bloque.CantidadProgramada <= 0
        ? 0m
        : Math.Min(
            100m,
            Math.Round(
                (decimal)bloque.CantidadProducida
                / bloque.CantidadProgramada * 100m,
                2));

    var porcentajeCss = porcentajeAvance.ToString(
        "0.##",
        CultureInfo.InvariantCulture);

    var urlDetalleBloque = bloque.EjecucionProduccionID.HasValue
        ? Url.Action(
            "Detalle",
            "Produccion",
            new
            {
                id = bloque.EjecucionProduccionID.Value,
                returnUrl = returnUrlActual
            }) ?? "#"
