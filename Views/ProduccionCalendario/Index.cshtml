@section Scripts {
    <script>
        (() => {
            'use strict';

            const search = document.getElementById('calendarSearch');
            const btnMostrarRango = document.getElementById('btnMostrarRango');
            const formRango = document.getElementById('formRangoCalendario');
            const rangoInicio = document.getElementById('rangoInicio');
            const rangoFin = document.getElementById('rangoFin');
            const calendarKiosk = document.getElementById('calendarKiosk');
            const btnPantallaCompleta = document.getElementById('btnPantallaCompletaCalendario');
            const btnCompactar = document.getElementById('btnCompactarCalendario');
            const timelineScroll = calendarKiosk?.querySelector('.timeline-scroll');
            const timelineElement = calendarKiosk?.querySelector('.timeline');
            const fitScaleLabel = document.getElementById('fitScaleLabel');
            const calendarPage = document.querySelector('.production-calendar-readonly');

            if (calendarPage) {
                calendarPage.style.setProperty('--dias-periodo', '@totalDias');
                calendarPage.style.setProperty('--horas-periodo', '@totalHorasPeriodo');
            }

            const periodoInicioLive = new Date('@inicioPeriodo.ToString("yyyy-MM-ddTHH:mm:ss")');
            const periodoFinLive = new Date('@finPeriodo.ToString("yyyy-MM-ddTHH:mm:ss")');
            const vistaLive = '@Model.VistaNormalizada'.toLowerCase();
            const mostrarHorasLive = @(mostrarReglaHoras ? "true" : "false");
            const liveClock = document.getElementById('calendarLiveClock');
            let centradoInicialRealizado = false;

            function pad2(value) {
                return String(value).padStart(2, '0');
            }

            function claveFechaLocal(fecha) {
                return `${fecha.getFullYear()}-${pad2(fecha.getMonth() + 1)}-${pad2(fecha.getDate())}`;
            }

            function textoFechaHoraLocal(fecha) {
                return `${pad2(fecha.getDate())}/${pad2(fecha.getMonth() + 1)}/${fecha.getFullYear()} ${pad2(fecha.getHours())}:${pad2(fecha.getMinutes())}`;
            }

            function configurarReglaHorariaComoPlaneacion() {
                const days = document.querySelector('.timeline-header .days');
                const machineHead = document.querySelector('.timeline-header .machine-head');
                if (!days) return;
                days.querySelectorAll('.nsq-hour-ruler-v31').forEach(x => x.remove());
                const mostrar = vistaLive === 'dia' || vistaLive === 'semana' || (vistaLive === 'rango' && @totalDias <= 7);
                if (!mostrar) return;
                const totalHoras = Math.max(24, @totalDias * 24);
                const ruler = document.createElement('div');
                ruler.className = 'nsq-hour-ruler-v31';
                ruler.style.gridTemplateColumns = `repeat(${totalHoras}, minmax(0, 1fr))`;
                for (let i = 0; i < totalHoras; i++) {
                    const h = i % 24;
                    const cell = document.createElement('span');
                    cell.className = 'nsq-hour-cell-v31' + (h === 0 ? ' day-start' : '');
                    cell.dataset.hourIndex = String(i);
                    cell.textContent = String(h).padStart(2, '0');
                    cell.title = String(h).padStart(2, '0') + ':00';
                    ruler.appendChild(cell);
                }
                days.appendChild(ruler);
                if (timelineElement) {
                    if (vistaLive === 'dia' && machineHead) {
                        const machineWidth = Math.max(150, Math.ceil(machineHead.getBoundingClientRect().width));
                        timelineElement.style.minWidth = `${machineWidth + (24 * 48)}px`;
                    } else {
                        timelineElement.style.minWidth = '';
                    }
                }
            }

            function centrarHoraActual(porcentaje) {
                if (centradoInicialRealizado || !timelineScroll || calendarioEnPantallaCompleta()) return;
                if (!(vistaLive === 'dia' || vistaLive === 'semana' || (vistaLive === 'rango' && mostrarHorasLive))) return;

                const primerTrack = calendarKiosk?.querySelector('.track');
                if (!primerTrack || primerTrack.clientWidth <= 0) return;

                const xEnTimeline = primerTrack.offsetLeft + (primerTrack.clientWidth * porcentaje / 100);
                const destino = Math.max(0, xEnTimeline - (timelineScroll.clientWidth * .58));

                timelineScroll.scrollTo({
                    left: destino,
                    behavior: 'smooth'
                });

                centradoInicialRealizado = true;
            }

            function actualizarTiempoReal() {
                const ahora = new Date();

                if (liveClock) {
                    liveClock.textContent = `${pad2(ahora.getHours())}:${pad2(ahora.getMinutes())}`;
                    liveClock.title = textoFechaHoraLocal(ahora);
                }

                const hoy = claveFechaLocal(ahora);
                document.querySelectorAll('[data-calendar-date]').forEach(day => {
                    day.classList.toggle('is-today-live', day.dataset.calendarDate === hoy);
                });

                document.querySelectorAll('.nsq-hour-cell-v31.is-current-hour').forEach(cell => {
                    cell.classList.remove('is-current-hour');
                });

                const dentroPeriodo = ahora >= periodoInicioLive && ahora < periodoFinLive;
                const totalMs = periodoFinLive.getTime() - periodoInicioLive.getTime();
                const porcentaje = dentroPeriodo && totalMs > 0
                    ? Math.max(0, Math.min(100, ((ahora.getTime() - periodoInicioLive.getTime()) / totalMs) * 100))
                    : 0;

                document.querySelectorAll('[data-now-line-operativo]').forEach(line => {
                    line.classList.toggle('d-none', !dentroPeriodo);

                    if (dentroPeriodo) {
                        line.style.left = `${porcentaje}%`;
                        line.title = `Ahora: ${textoFechaHoraLocal(ahora)}`;
                    }
                });

                if (dentroPeriodo && mostrarHorasLive) {
                    const horasDesdeInicio = Math.floor((ahora.getTime() - periodoInicioLive.getTime()) / 3600000);
                    const celdaActual = document.querySelector(`[data-hour-index="${horasDesdeInicio}"]`);

                    if (celdaActual) {
                        celdaActual.classList.add('is-current-hour');
                        celdaActual.title = `Hora actual: ${pad2(ahora.getHours())}:${pad2(ahora.getMinutes())}`;
                    }

                    centrarHoraActual(porcentaje);
                }
            }

            function iniciarRelojTiempoReal() {
                actualizarTiempoReal();

                const msHastaSiguienteMinuto = 60000 - (Date.now() % 60000) + 50;

                window.setTimeout(() => {
                    actualizarTiempoReal();
                    window.setInterval(actualizarTiempoReal, 60000);
                }, msHastaSiguienteMinuto);
            }

            function normalizar(value) {
                return (value || '')
                    .toString()
                    .normalize('NFD')
                    .replace(/[\u0300-\u036f]/g, '')
                    .toLowerCase()
                    .trim();
            }

            function aplicarBusqueda() {
                const term = normalizar(search?.value);

                document
                    .querySelectorAll('.calendar-machine-row')
                    .forEach(row => {
                        const hayCoincidencia =
                            !term || normalizar(row.dataset.search).includes(term);

                        row.classList.toggle('d-none', !hayCoincidencia);
                    });
            }

            search?.addEventListener('input', aplicarBusqueda);

            btnMostrarRango?.addEventListener('click', () => {
                formRango?.classList.toggle('active');

                if (formRango?.classList.contains('active')) {
                    rangoInicio?.focus();
                }
            });

            formRango?.addEventListener('submit', event => {
                if (!rangoInicio?.value || !rangoFin?.value) {
                    event.preventDefault();
                    alert('Selecciona la fecha de inicio y la fecha de fin.');
                    return;
                }

                const inicio = new Date(`${rangoInicio.value}T00:00:00`);
                const fin = new Date(`${rangoFin.value}T00:00:00`);

                if (fin < inicio) {
                    event.preventDefault();
                    alert('La fecha final no puede ser anterior a la fecha inicial.');
                    return;
                }

                const dias = Math.floor((fin - inicio) / 86400000);

                if (dias > 30) {
                    event.preventDefault();
                    alert('El rango no puede ser mayor a 31 días.');
                }
            });

            function calendarioEnPantallaCompleta() {
                return document.fullscreenElement === calendarKiosk
                    || calendarKiosk?.classList.contains('fullscreen-fallback');
            }

            function actualizarBotonPantallaCompleta() {
                if (!btnPantallaCompleta) return;

                const activo = calendarioEnPantallaCompleta();
                const icon = btnPantallaCompleta.querySelector('i');
                const label = btnPantallaCompleta.querySelector('.fullscreen-label');

                if (icon) {
                    icon.className = activo
                        ? 'fa-solid fa-compress'
                        : 'fa-solid fa-expand';
                }

                if (label) {
                    label.textContent = activo
                        ? 'Salir pantalla completa'
                        : 'Pantalla completa';
                }
            }

            function ajustarCalendarioAlViewport() {
                if (!calendarKiosk || !timelineScroll || !timelineElement) return;

                timelineElement.style.transform = '';
                timelineElement.style.width = '100%';
                timelineElement.style.height = 'auto';
                calendarKiosk.classList.remove('fit-screen');

                if (!calendarioEnPantallaCompleta()) {
                    timelineScroll.style.overflowX = 'auto';
                    if (fitScaleLabel) fitScaleLabel.textContent = '';
                    return;
                }

                const viewportWidth = Math.max(
                    320,
                    calendarKiosk.clientWidth - 16);

                const contentWidth = Math.max(
                    timelineElement.scrollWidth,
                    timelineElement.getBoundingClientRect().width);

                if (contentWidth <= viewportWidth) {
                    timelineScroll.style.overflowX = 'auto';
                    if (fitScaleLabel) fitScaleLabel.textContent = '100%';
                    return;
                }

                const scale = Math.max(
                    .45,
                    Math.min(1, viewportWidth / contentWidth));

                timelineElement.style.transformOrigin = 'top left';
                timelineElement.style.transform = `scale(${scale})`;
                timelineElement.style.width = `${100 / scale}%`;
                timelineElement.style.height = `${timelineElement.scrollHeight * scale}px`;

                calendarKiosk.classList.add('fit-screen');
                timelineScroll.style.overflowX = 'hidden';

                if (fitScaleLabel) {
                    fitScaleLabel.textContent = `${Math.round(scale * 100)}%`;
                }
            }

            async function alternarPantallaCompleta() {
                if (!calendarKiosk) return;

                try {
                    if (document.fullscreenElement) {
                        await document.exitFullscreen();
                    }
                    else if (calendarKiosk.requestFullscreen) {
                        await calendarKiosk.requestFullscreen();
                    }
                    else {
                        calendarKiosk.classList.toggle('fullscreen-fallback');
                    }
                }
                catch {
                    calendarKiosk.classList.toggle('fullscreen-fallback');
                }

                setTimeout(() => {
                    actualizarBotonPantallaCompleta();
                    ajustarCalendarioAlViewport();
                }, 80);
            }

            btnPantallaCompleta?.addEventListener(
                'click',
                alternarPantallaCompleta);

            document.addEventListener('fullscreenchange', () => {
                actualizarBotonPantallaCompleta();
                setTimeout(() => {
                    ajustarCalendarioAlViewport();
                    actualizarTiempoReal();
                }, 80);
            });

            window.addEventListener('resize', () => {
                if (calendarioEnPantallaCompleta()) {
                    ajustarCalendarioAlViewport();
                }
                actualizarTiempoReal();
            });

            document.addEventListener('visibilitychange', () => {
                if (!document.hidden) actualizarTiempoReal();
            });

            btnCompactar?.addEventListener('click', () => {
                if (!calendarKiosk) return;

                calendarKiosk.classList.toggle('compact-mode');

                const activo = calendarKiosk.classList.contains('compact-mode');
                const icon = btnCompactar.querySelector('i');
                const label = btnCompactar.querySelector('span');

                if (icon) {
                    icon.className = activo
                        ? 'fa-solid fa-expand'
                        : 'fa-solid fa-compress';
                }

                if (label) {
                    label.textContent = activo
                        ? 'Expandir'
                        : 'Compactar';
                }

                setTimeout(ajustarCalendarioAlViewport, 60);
            });

            /*
             * IMPORTANTE:
             * Esta vista NO registra dragstart, dragover, drop ni dragend.
             * Todos los bloques tienen draggable="false".
             * El calendario operativo jamás modifica Planeación.
             */

            configurarReglaHorariaComoPlaneacion();
            actualizarBotonPantallaCompleta();
            iniciarRelojTiempoReal();
        })();
    </script>
}
