        }

        .estado-programado {
            background: #f1f5f9;
            color: #475569;
            border-color: #cbd5e1;
        }

        .estado-preparacion {
            background: #e0f2fe;
            color: #075985;
            border-color: #7dd3fc;
        }

        .estado-listo {
            background: #dcfce7;
            color: #166534;
            border-color: #86efac;
        }

        .estado-calidad {
            background: #fef3c7;
            color: #92400e;
            border-color: #fde68a;
        }

        .estado-reliberacion {
            background: #f3e8ff;
            color: #6b21a8;
            border-color: #d8b4fe;
        }

        .estado-produciendo {
            background: #ffedd5;
            color: #9a3412;
            border-color: #fdba74;
        }

        .estado-pausado,
        .estado-bloqueado {
            background: #fee2e2;
            color: #991b1b;
            border-color: #fca5a5;
        }

        .estado-liberado,
        .estado-terminado {
            background: #dcfce7;
            color: #166534;
            border-color: #86efac;
        }

        .operativa-action-card {
            border: 1px solid var(--bs-border-color);
            border-radius: 18px;
            padding: 18px;
            background: var(--bs-body-bg);
            position: relative;
