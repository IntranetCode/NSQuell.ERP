            }

        .production-calendar-readonly .day.is-today-live {
            background: rgba(220, 38, 38, .06);
            box-shadow: inset 0 -2px 0 #dc2626;
        }

            .production-calendar-readonly .day.is-today-live strong {
                color: #b91c1c;
            }

        .production-calendar-readonly .calendar-live-clock {
            display: inline-flex;
            align-items: center;
            gap: 5px;
            margin-left: 8px;
            padding: 2px 7px;
            border: 1px solid rgba(220, 38, 38, .24);
            border-radius: 999px;
            background: rgba(220, 38, 38, .06);
            color: #b91c1c;
            font-weight: 900;
            white-space: nowrap;
        }

        .production-calendar-readonly.compact-mode .machine-info,
        .production-calendar-readonly.compact-mode .track {
            min-height: 44px !important;
        }

        .production-calendar-readonly.compact-mode .block {
