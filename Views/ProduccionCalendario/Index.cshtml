        .operativa-notice {
            display: flex;
            align-items: flex-start;
            gap: 8px;
            border: 1px solid var(--bs-border-color);
            border-radius: 10px;
            padding: 7px 10px;
            margin-bottom: 7px;
            background: var(--bs-tertiary-bg);
            font-size: .78rem;
            line-height: 1.25;
        }

            .operativa-notice > div {
                display: -webkit-box;
                -webkit-box-orient: vertical;
                -webkit-line-clamp: 2;
                overflow: hidden;
            }

        .operativa-notice-danger {
            border-color: rgba(220, 38, 38, .35);
            background: rgba(220, 38, 38, .07);
            color: var(--bs-danger-text-emphasis);
        }

        .operativa-status-grid {
            display: grid;
            grid-template-columns: repeat(6, minmax(0, 1fr));
            gap: 6px;
            margin-bottom: 7px;
        }

        .operativa-status-item {
            min-width: 0;
            border: 1px solid var(--bs-border-color);
            border-radius: 10px;
            padding: 7px 9px;
            background: var(--bs-body-bg);
        }

            .operativa-status-item small {
                display: block;
                color: var(--bs-secondary-color);
                font-size: .59rem;
                line-height: 1;
                font-weight: 900;
                text-transform: uppercase;
                margin-bottom: 4px;
            }

            .operativa-status-item strong,
            .operativa-status-item .badge {
                max-width: 100%;
                font-size: .76rem;
                line-height: 1.15;
            }

            .operativa-status-item strong {
                display: block;
                white-space: nowrap;
                overflow: hidden;
                text-overflow: ellipsis;
            }

        .operativa-progress-compact {
            border: 1px solid var(--bs-border-color);
            border-radius: 10px;
            padding: 7px 10px;
            margin-bottom: 8px;
            background: var(--bs-tertiary-bg);
        }

        .operativa-progress-head {
            display: grid;
            grid-template-columns: auto 1fr auto;
            align-items: center;
            gap: 8px;
            margin-bottom: 5px;
            font-size: .74rem;
        }

            .operativa-progress-head span {
                color: var(--bs-secondary-color);
                font-weight: 900;
                text-transform: uppercase;
                font-size: .6rem;
            }

            .operativa-progress-head strong {
                font-size: .78rem;
            }

            .operativa-progress-head b {
                color: #2563eb;
                font-size: .82rem;
            }

        .operativa-action-layout {
            display: grid;
            grid-template-columns: minmax(0, 1.8fr) minmax(300px, 1fr);
            gap: 8px;
            align-items: stretch;
        }

        .operativa-action-card,
        .operativa-next-card {
            padding: 10px 12px;
            border-radius: 12px;
        }

        .operativa-action-card {
            min-height: 0;
        }

        .operativa-action-label {
            margin-bottom: 4px;
            font-size: .6rem;
        }

        .operativa-action-title {
            gap: 7px;
            margin-bottom: 3px;
            font-size: .9rem;
            line-height: 1.15;
        }

        .operativa-action-title-icon {
            width: 29px;
            height: 29px;
            flex: 0 0 29px;
            border-radius: 8px;
            font-size: .8rem;
        }

        .operativa-action-description {
            margin-bottom: 5px;
            font-size: .75rem;
            line-height: 1.25;
            display: -webkit-box;
            -webkit-box-orient: vertical;
            -webkit-line-clamp: 2;
            overflow: hidden;
        }

        .operativa-meta {
            gap: 5px;
            margin-top: 5px;
        }

        .operativa-meta-item {
            min-width: 102px;
            padding: 5px 7px;
            border-radius: 8px;
        }

            .operativa-meta-item small {
                margin-bottom: 1px;
                font-size: .56rem;
            }

            .operativa-meta-item strong {
                font-size: .71rem;
                line-height: 1.1;
            }

        .operativa-action-buttons-compact {
            display: flex;
            flex-wrap: wrap;
            gap: 6px;
            margin-top: 7px;
        }

            .operativa-action-buttons-compact .btn {
                padding: .33rem .62rem;
                font-size: .72rem;
            }

        .operativa-next-card .small.text-muted {
            line-height: 1.25;
            margin-bottom: 6px !important;
            display: -webkit-box;
            -webkit-box-orient: vertical;
            -webkit-line-clamp: 2;
            overflow: hidden;
        }

        .operativa-quality-wait,
        .operativa-no-action {
            padding: 10px 12px;
            border-radius: 12px;
            font-size: .78rem;
            line-height: 1.25;
        }

            .operativa-quality-wait .fs-5 {
                font-size: .95rem !important;
            }

        @@media (max-width: 1180px) {
            .operativa-modal-head {
                grid-template-columns: minmax(205px, .9fr) minmax(0, 2fr) auto;
            }

            .operativa-head-facts {
                grid-template-columns: repeat(3, minmax(0, 1fr));
            }

            .operativa-status-grid {
                grid-template-columns: repeat(3, minmax(0, 1fr));
            }
        }

        @@media (max-height: 760px) and (min-width: 992px) {
            .modal-operativa .modal-dialog {
                margin: 7px auto;
            }

            .modal-operativa .modal-content {
                max-height: calc(100vh - 14px);
            }

            .modal-operativa .modal-header {
                padding-top: 8px;
                padding-bottom: 7px;
            }

            .modal-operativa .modal-body {
                padding-top: 6px;
                padding-bottom: 8px;
            }

            .operativa-of-number {
                font-size: 1.55rem;
            }

            .operativa-head-fact {
                padding-top: 1px;
                padding-bottom: 1px;
            }

            .operativa-status-item {
                padding-top: 5px;
                padding-bottom: 5px;
            }

            .operativa-action-card,
            .operativa-next-card,
            .operativa-quality-wait,
            .operativa-no-action {
                padding-top: 8px;
                padding-bottom: 8px;
            }

                .operativa-action-description,
                .operativa-next-card .small.text-muted,
                .operativa-notice > div {
                    -webkit-line-clamp: 1;
                }
        }

        @@media (max-width: 991.98px) {
            .modal-operativa .modal-content {
                max-height: calc(100vh - 18px);
                overflow-y: auto;
            }

            .operativa-modal-head {
                grid-template-columns: 1fr;
                gap: 9px;
            }

            .operativa-head-state {
                align-items: flex-start;
            }

            .operativa-action-layout {
                grid-template-columns: 1fr;
            }
        }

        /* =========================================================
                           TIMELINE OPERATIVO V3
                           Conserva la geometría del calendario de Planeación.
                           ========================================================= */
        .production-calendar-readonly .timeline-scroll {
            overflow-x: auto;
            overflow-y: visible;
        }

        .timeline-header .days .nsq-hour-ruler-v31 {
            grid-column: 1 / -1;
            display: grid;
            background: #eef4fb;
            border-top: 1px solid #d7e1ee;
            overflow: hidden;
        }

        .timeline-header .days .nsq-hour-cell-v31 {
            min-width: 0;
            padding: 2px 0;
            border-left: 1px solid #d7e1ee;
            text-align: center;
            color: #344054;
            font-size: .48rem;
            font-weight: 900;
            line-height: 1;
            overflow: hidden;
            white-space: nowrap;
        }

            .timeline-header .days .nsq-hour-cell-v31.day-start {
                border-left: 2px solid #7d8da6;
                color: #004aad;
                background: #e4efff;
            }

            .timeline-header .days .nsq-hour-cell-v31.is-current-hour {
                color: #b91c1c !important;
                background: #fee2e2 !important;
                box-shadow: inset 0 -3px 0 #dc2626;
