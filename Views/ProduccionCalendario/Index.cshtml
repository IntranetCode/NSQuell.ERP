@model ERP.NSQuell.Models.PlaneacionCalendarioMaquinasVm
@using ERP.NSQuell.Models
@using Microsoft.AspNetCore.Routing
@using System.Collections.Generic
@using System.Linq
@using System.Globalization

@functions {
    public static string Pct(double value)
    {
        return value.ToString("0.####", CultureInfo.InvariantCulture);
    }

    public static string ClaseVista(string vistaActual, string vista)
    {
        return string.Equals(vistaActual, vista, StringComparison.OrdinalIgnoreCase)
            ? "btn btn-primary fw-bold"
            : "btn btn-outline-primary fw-bold";
    }

    public static string BadgeProduccion(int? estatusProduccionId)
    {
        return estatusProduccionId switch
        {
            1 => "badge bg-secondary",
            2 => "badge bg-info text-dark",
            3 => "badge bg-warning text-dark",
            4 => "badge bg-danger",
            5 => "badge bg-primary",
            6 => "badge bg-success",
            9 => "badge bg-dark",
            99 => "badge bg-secondary",
            _ => "badge bg-light text-dark border"
        };
    }

    public static string TextoProduccion(int? estatusProduccionId, string? estatusProduccionNombre)
    {
        if (!string.IsNullOrWhiteSpace(estatusProduccionNombre))
            return estatusProduccionNombre;

        return estatusProduccionId switch
        {
            1 => "Pendiente",
            2 => "En preparación",
            3 => "En producción",
            4 => "Pausado",
            5 => "Terminado parcial",
            6 => "Terminado",
            9 => "Cerrado",
            99 => "Cancelado",
            _ => "Sin ejecución"
        };
    }

    public static string TextoPeriodoAnterior(ERP.NSQuell.Models.PlaneacionCalendarioMaquinasVm model)
    {
        if (model.EsVistaDia) return "Día anterior";
        if (model.EsVistaMes) return "Mes anterior";
        if (model.EsVistaRango) return "Rango anterior";
        return "Semana anterior";
    }

    public static string TextoPeriodoSiguiente(ERP.NSQuell.Models.PlaneacionCalendarioMaquinasVm model)
    {
        if (model.EsVistaDia) return "Día siguiente";
        if (model.EsVistaMes) return "Mes siguiente";
        if (model.EsVistaRango) return "Rango siguiente";
        return "Semana siguiente";
    }
}

@{
    Layout = "~/Views/Shared/_Layout.cshtml";
    ViewData["Title"] = "Calendario Operativo de Producción";

    var cultura = new CultureInfo("es-MX");
    var inicioPeriodo = Model.InicioPeriodo;
    var finPeriodo = Model.FinPeriodo;

    if (finPeriodo <= inicioPeriodo)
    {
        finPeriodo = inicioPeriodo.AddDays(7);
    }

    var totalMinutos = Math.Max(1, (finPeriodo - inicioPeriodo).TotalMinutes);
    var totalDias = Math.Max(1, Model.TotalDiasPeriodo);
    var totalHorasPeriodo = Math.Max(24, totalDias * 24);
    var vistaActual = (Model.VistaNormalizada ?? "semana").Trim().ToLowerInvariant();
    var mostrarReglaHoras = vistaActual == "dia"
        || vistaActual == "semana"
        || (vistaActual == "rango" && totalDias <= 7);
    var fechaBaseFiltros = Model.Ahora.Date;

    var ahoraVisible = Model.Ahora >= inicioPeriodo && Model.Ahora < finPeriodo;
    var ahoraLeft = ahoraVisible
        ? (Model.Ahora - inicioPeriodo).TotalMinutes / totalMinutos * 100
        : 0;

    var periodoAnterior = Model.PeriodoAnterior;
    var periodoSiguiente = Model.PeriodoSiguiente;

    var rangoInicioVisible = Model.RangoInicio.HasValue
        ? Model.RangoInicio.Value.ToString("yyyy-MM-dd")
        : Model.InicioPeriodo.ToString("yyyy-MM-dd");

    var rangoFinVisible = Model.RangoFin.HasValue
        ? Model.RangoFin.Value.ToString("yyyy-MM-dd")
        : Model.FinPeriodo.AddDays(-1).ToString("yyyy-MM-dd");

    var operativaPorPrograma =
        ViewBag.OperativaPorPrograma as Dictionary<int, AgendaOperativaItemVm>
        ?? new Dictionary<int, AgendaOperativaItemVm>();

    var resumenOperativo =
        ViewBag.ResumenOperativo as AgendaOperativaResumenVm
        ?? new AgendaOperativaResumenVm();

    var fechaConsultaOperativa =
        ViewBag.FechaConsultaOperativa is DateTime fechaConsulta
            ? fechaConsulta
            : Model.Ahora;

    var returnUrlActual = $"{Context.Request.Path}{Context.Request.QueryString}";

    bool EsAccionCalidad(AgendaOperativaAccionVm? accion)
    {
        if (accion == null) return false;

        if (string.Equals(
            accion.Controlador,
            "Calidad",
            StringComparison.OrdinalIgnoreCase))
            return true;

        if (string.Equals(
            accion.AreaResponsable,
            AgendaOperativaArea.Calidad,
            StringComparison.OrdinalIgnoreCase))
            return true;

        return accion.Clave == AgendaOperativaPasoClave.Calidad
            || accion.Clave == AgendaOperativaPasoClave.PrimerasPiezas
            || accion.Clave == AgendaOperativaPasoClave.CalidadFinal;
    }

    string ClasePrioridad(string? prioridad)
    {
        return (prioridad ?? string.Empty).Trim().ToUpperInvariant() switch
        {
            AgendaOperativaPrioridad.Critica => "operativa-prioridad-critica",
            AgendaOperativaPrioridad.Alta => "operativa-prioridad-alta",
            AgendaOperativaPrioridad.Media => "operativa-prioridad-media",
            _ => "operativa-prioridad-normal"
        };
    }

    string ClaseEstadoOperativo(string? estado)
    {
        return (estado ?? string.Empty).Trim().ToUpperInvariant() switch
        {
            AgendaOperativaEstadoGeneral.Produciendo => "estado-produciendo",
            AgendaOperativaEstadoGeneral.Preparacion => "estado-preparacion",
            AgendaOperativaEstadoGeneral.ListaParaSerie => "estado-listo",
            AgendaOperativaEstadoGeneral.EsperandoCalidad => "estado-calidad",
            AgendaOperativaEstadoGeneral.Reliberacion => "estado-reliberacion",
            AgendaOperativaEstadoGeneral.Pausada => "estado-pausado",
            AgendaOperativaEstadoGeneral.InterrumpidaUrgente => "estado-pausado",
            AgendaOperativaEstadoGeneral.Bloqueada => "estado-bloqueado",
            AgendaOperativaEstadoGeneral.MaquinaLiberada => "estado-liberado",
            AgendaOperativaEstadoGeneral.Terminada => "estado-terminado",
            _ => "estado-programado"
        };
    }

    string IconoEstadoOperativo(string? estado)
    {
        return (estado ?? string.Empty).Trim().ToUpperInvariant() switch
        {
            AgendaOperativaEstadoGeneral.Produciendo => "fa-gears",
            AgendaOperativaEstadoGeneral.Preparacion => "fa-screwdriver-wrench",
            AgendaOperativaEstadoGeneral.ListaParaSerie => "fa-circle-play",
            AgendaOperativaEstadoGeneral.EsperandoCalidad => "fa-shield-halved",
            AgendaOperativaEstadoGeneral.Reliberacion => "fa-arrows-rotate",
            AgendaOperativaEstadoGeneral.Pausada => "fa-circle-pause",
            AgendaOperativaEstadoGeneral.InterrumpidaUrgente => "fa-bolt",
            AgendaOperativaEstadoGeneral.Bloqueada => "fa-lock",
            AgendaOperativaEstadoGeneral.MaquinaLiberada => "fa-lock-open",
            AgendaOperativaEstadoGeneral.Terminada => "fa-circle-check",
            _ => "fa-clock"
        };
    }

    string TextoFecha(DateTime? fecha)
    {
        return fecha.HasValue
            ? fecha.Value.ToString("dd/MM/yyyy HH:mm")
            : "—";
    }

    string TextoRetraso(int minutos)
    {
        if (minutos <= 0) return "En tiempo";
        if (minutos < 60) return $"{minutos} min";

        var horas = minutos / 60;
        var mins = minutos % 60;

        if (horas < 24)
            return mins == 0 ? $"{horas} h" : $"{horas} h {mins} min";

        var dias = horas / 24;
        var horasRestantes = horas % 24;

        return horasRestantes == 0
            ? $"{dias} d"
            : $"{dias} d {horasRestantes} h";
    }

    string UrlDetalle(AgendaOperativaItemVm item)
    {
        var returnUrl = returnUrlActual;

        if (item.EjecucionProduccionID.HasValue)
        {
            return Url.Action(
                "Detalle",
                "Produccion",
                new
                {
                    id = item.EjecucionProduccionID.Value,
                    returnUrl
                }) ?? "#";
        }

        return Url.Action(
            "Index",
            "ProduccionCalendario",
            new
            {
                vista = Model.VistaNormalizada,
                fecha = Model.FechaReferencia?.ToString("yyyy-MM-dd"),
                rangoInicio = Model.RangoInicio?.ToString("yyyy-MM-dd"),
                rangoFin = Model.RangoFin?.ToString("yyyy-MM-dd")
            }) ?? "#";
    }

    string UrlAccion(AgendaOperativaItemVm item, AgendaOperativaAccionVm? accion)
    {
        if (accion == null || EsAccionCalidad(accion))
            return UrlDetalle(item);

        var returnUrl = returnUrlActual;

        if (string.Equals(
            accion.Clave,
            "INICIAR_PREPARACION",
            StringComparison.OrdinalIgnoreCase))
        {
            return Url.Action(
                "Index",
                "Produccion",
                new
                {
                    prepararProgramaId = item.ProgramaProduccionID,
                    returnUrl
                }) ?? "#";
        }

        if (string.Equals(
            accion.Clave,
            "LHRH_INCONSISTENTE",
            StringComparison.OrdinalIgnoreCase))
        {
            return Url.Action(
                "Index",
                "PlaneacionCalendarioMaquinas",
                new
                {
                    programaProduccionId = item.ProgramaProduccionID,
                    returnUrl
                }) ?? "#";
        }

        if (string.IsNullOrWhiteSpace(accion.Controlador)
            || string.IsNullOrWhiteSpace(accion.Accion))
            return UrlDetalle(item);

        var valores = new RouteValueDictionary();

        foreach (var parametro in accion.ParametrosRuta)
        {
            if (!string.IsNullOrWhiteSpace(parametro.Value))
                valores[parametro.Key] = parametro.Value;
        }

        if (!string.IsNullOrWhiteSpace(accion.ParametroId)
            && accion.IdDestino.HasValue)
        {
            valores[accion.ParametroId] = accion.IdDestino.Value;
        }
        else if (string.Equals(
            accion.Controlador,
            "ProduccionPersonal",
            StringComparison.OrdinalIgnoreCase)
            && accion.IdDestino.HasValue)
        {
            valores["programaProduccionId"] = accion.IdDestino.Value;
        }
        else if (string.Equals(
            accion.Controlador,
            "PlaneacionCalendarioMaquinas",
            StringComparison.OrdinalIgnoreCase)
            && accion.IdDestino.HasValue)
        {
            valores["programaProduccionId"] = accion.IdDestino.Value;
        }

        valores["returnUrl"] = returnUrl;

        return Url.Action(
            accion.Accion,
            accion.Controlador,
            valores) ?? UrlDetalle(item);
    }

    Func<DateTime, string> UrlPeriodo = fecha =>
    {
        if (Model.EsVistaRango)
        {
            var finRango = fecha.AddDays(totalDias - 1).ToString("yyyy-MM-dd");

            return Url.Action(
                "Index",
                "ProduccionCalendario",
                new
                {
                    vista = "rango",
                    rangoInicio = fecha.ToString("yyyy-MM-dd"),
                    rangoFin = finRango
                }) ?? "#";
        }

        return Url.Action(
            "Index",
            "ProduccionCalendario",
            new
            {
                vista = Model.VistaNormalizada,
                fecha = fecha.ToString("yyyy-MM-dd")
            }) ?? "#";
    };
}

@section Styles {
    @* Reutilizamos el mismo CSS del calendario de Planeación para conservar exactamente la base visual. *@
    <link rel="stylesheet"
          href="~/css/PlaneacionCalendarioMaquinas/index.css"
          asp-append-version="true" />

    <style>
        .production-calendar-readonly .block {
            cursor: pointer !important;
        }

            .production-calendar-readonly .block.no-drag {
                opacity: 1 !important;
            }

        .production-calendar-readonly .track {
            cursor: default !important;
        }

        .production-calendar-readonly .block {
            user-select: none;
        }

        .operativa-summary {
            display: grid;
            grid-template-columns: repeat(4, minmax(0, 1fr));
            gap: 12px;
            margin-bottom: 16px;
        }

