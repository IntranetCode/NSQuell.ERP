@model ERP.NSQuell.Models.ProduccionPersonalV7IndexVm
@using System.Globalization

@{
    Layout = "~/Views/Shared/_Layout.cshtml";
    ViewData["Title"] = "Centro Operativo de Programación de Personal";

    var cultura = new CultureInfo("es-MX");

    var maquinas = Model.Segmentos
        .GroupBy(x => new { x.MaquinaID, x.MaquinaCodigo, x.MaquinaNombre })
        .Select(x => x.Key)
        .OrderBy(x => x.MaquinaCodigo)
        .ThenBy(x => x.MaquinaNombre)
        .ToList();

    var personas = new Dictionary<int, string>();

    void AgregarPersona(int id, string? nombre)
    {
        if (id <= 0 || string.IsNullOrWhiteSpace(nombre)) return;
        personas[id] = nombre.Trim();
    }

    foreach (var p in Model.Operadores) AgregarPersona(p.PersonaID, p.Nombre);
    foreach (var p in Model.Tecnicos) AgregarPersona(p.PersonaID, p.Nombre);
    foreach (var p in Model.SmedYTecnicos) AgregarPersona(p.PersonaID, p.Nombre);
    foreach (var p in Model.Auxiliares) AgregarPersona(p.PersonaID, p.Nombre);

    string NombrePersona(IEnumerable<ERP.NSQuell.Models.ProduccionPersonalPersonaOpcionVm> lista, int? id, string vacio = "Sin asignar")
    {
        if (!id.HasValue) return vacio;
        return lista.FirstOrDefault(x => x.PersonaID == id.Value)?.Nombre ?? $"Persona #{id.Value}";
    }

    DateTime anterior;
    DateTime siguiente;

    if (Model.Vista == "mes")
    {
        anterior = Model.FechaReferencia.AddMonths(-1);
        siguiente = Model.FechaReferencia.AddMonths(1);
    }
    else if (Model.Vista == "semana")
    {
        anterior = Model.FechaReferencia.AddDays(-7);
        siguiente = Model.FechaReferencia.AddDays(7);
    }
    else if (Model.Vista == "rango")
    {
        var diasRango = Math.Max(1, (Model.FinPeriodo - Model.InicioPeriodo).Days);
        anterior = Model.InicioPeriodo.AddDays(-diasRango);
        siguiente = Model.InicioPeriodo.AddDays(diasRango);
    }
    else
    {
        anterior = Model.FechaReferencia.AddDays(-1);
        siguiente = Model.FechaReferencia.AddDays(1);
    }

    string FechaParam(DateTime d) => d.ToString("yyyy-MM-dd");

    string TextoPeriodo()
    {
        if (Model.Vista == "dia")
            return Model.FechaReferencia.ToString("dddd dd 'de' MMMM yyyy", cultura);
        if (Model.Vista == "semana")
            return $"{Model.InicioPeriodo:dd MMM} — {Model.FinPeriodoVisible:dd MMM yyyy}";
        if (Model.Vista == "mes")
            return Model.FechaReferencia.ToString("MMMM yyyy", cultura);
        return $"{Model.InicioPeriodo:dd/MM/yyyy} — {Model.FinPeriodoVisible:dd/MM/yyyy}";
    }

    var totalDiasCalendario = Math.Max(1, (Model.FinPeriodoVisible.Date - Model.InicioPeriodo.Date).Days + 1);
    var diasCalendario = Enumerable.Range(0, totalDiasCalendario)
        .Select(i => Model.InicioPeriodo.Date.AddDays(i))
        .ToList();

    string panelActual = Context.Request.Query["panel"].ToString().Trim().ToLowerInvariant();
    if (panelActual != "planner" &&
        panelActual != "support" &&
        panelActual != "people" &&
        panelActual != "pending")
    {
        panelActual = "planner";
    }
}

@section Styles {
    <link rel="stylesheet" href="~/css/ProduccionPersonal/semanal.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/ProduccionPersonal/v7.css" asp-append-version="true" />
}

<div class="ppv3-page" id="ppv3Root">
    <!-- NSQ_PRODUCCION_PERSONAL_V11_HEADER_SUPERIOR_REMOVIDO -->

    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger mt-2 mb-0 fw-semibold">@TempData["Error"]</div>
    }
    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success mt-2 mb-0 fw-semibold">@TempData["Success"]</div>
    }
    @if (!Model.Configurado)
    {
        <div class="alert alert-warning mt-2 mb-0 fw-semibold ppv7-db-warning">
            <i class="fa-solid fa-database me-1"></i>
            <strong>Falta terminar V7 en la BD de pruebas.</strong>
            El ERP puede mostrar la programación heredada, pero para guardar por turno e historial deben existir
            <code>Produccion_ProgramaPersonalAsignaciones</code> y <code>Produccion_PersonalAsignacionHistorial</code>.
        </div>
    }

    <!-- NSQ_PRODUCCION_PERSONAL_V11_HOY_NAVEGACION -->
    <section class="ppv7-period-shell ppv11-period-shell">
        <div class="ppv11-module-brand">
            <a href="@Url.Action("Grupo","Menu",new { id = 2 })"
               class="ppv11-module-back"
               title="Volver a Producción">
                <i class="fa-solid fa-arrow-left"></i>
            </a>
            <div>
                <span>PRODUCCIÓN · PERSONAL</span>
                <strong>Centro Operativo de Programación</strong>
            </div>
        </div>

        <div class="ppv7-period-tabs" role="group" aria-label="Periodo de consulta">
            <a class="ppv7-period-tab @(Model.Vista=="dia" ? "active" : "")"
               href="@Url.Action("Index",new { vista="dia", fechaDesde=FechaParam(Model.FechaReferencia), panel=panelActual })">
                <span class="ppv7-period-icon"><i class="fa-solid fa-calendar-day"></i></span>
                <span><strong>Día</strong><small>Jornada actual</small></span>
            </a>
            <a class="ppv7-period-tab @(Model.Vista=="semana" ? "active" : "")"
               href="@Url.Action("Index",new { vista="semana", fechaDesde=FechaParam(Model.FechaReferencia), panel=panelActual })">
                <span class="ppv7-period-icon"><i class="fa-solid fa-calendar-week"></i></span>
                <span><strong>Semana</strong><small>Semana ISO @Model.NumeroSemana</small></span>
            </a>
            <a class="ppv7-period-tab @(Model.Vista=="mes" ? "active" : "")"
               href="@Url.Action("Index",new { vista="mes", fechaDesde=FechaParam(Model.FechaReferencia), panel=panelActual })">
                <span class="ppv7-period-icon"><i class="fa-solid fa-calendar-days"></i></span>
                <span><strong>Mes</strong><small>@Model.FechaReferencia.ToString("MMM", cultura)</small></span>
            </a>
            <!-- NSQ_PRODUCCION_PERSONAL_V10_COBERTURA_PERIODOS_HEADER_PEOPLE -->
            <a class="ppv7-period-tab @(Model.Vista=="rango" ? "active" : "")"
               href="@Url.Action("Index",new {
                    vista="rango",
                    fechaDesde=FechaParam(Model.InicioPeriodo),
                    fechaHasta=FechaParam(Model.FinPeriodoVisible),
                    panel=panelActual
               })">
                <span class="ppv7-period-icon"><i class="fa-solid fa-calendar"></i></span>
                <span><strong>Rango</strong><small>Personalizado</small></span>
            </a>
        </div>

        @{
            var hoyV11 = DateTime.Today;
            var periodoIncluyeHoyV11 =
                hoyV11 >= Model.InicioPeriodo.Date &&
                hoyV11 < Model.FinPeriodo.Date;

            var etiquetaActualV11 =
                Model.Vista == "dia" ? "HOY" :
                Model.Vista == "semana" ? "SEMANA ACTUAL" :
                Model.Vista == "mes" ? "MES ACTUAL" :
                "HOY EN ESTE RANGO";
        }

        <div class="ppv11-period-nav @(periodoIncluyeHoyV11 ? "is-current" : "")">
            <a class="ppv11-period-arrow"
               href="@Url.Action("Index","ProduccionPersonal",new {
                    vista = Model.Vista,
                    fechaDesde = FechaParam(anterior),
                    fechaHasta = Model.Vista == "rango"
                        ? FechaParam(anterior.AddDays(Math.Max(1,(Model.FinPeriodo-Model.InicioPeriodo).Days)-1))
                        : null,
                    panel = panelActual
               })"
               title="Periodo anterior">
                <i class="fa-solid fa-chevron-left"></i>
            </a>

            <div class="ppv11-period-display">
                <span>PERIODO MOSTRADO</span>
                <strong>
                    @if (periodoIncluyeHoyV11)
                    {
                        <b class="ppv11-current-label">@etiquetaActualV11</b>
                    }
                    @TextoPeriodo()
                </strong>
                <small>
                    @if (Model.Vista == "dia")
                    {
                        <text>Fecha de trabajo</text>
                    }
                    else if (Model.Vista == "semana")
                    {
                        <text>Semana ISO @Model.NumeroSemana</text>
                    }
                    else if (Model.Vista == "mes")
                    {
                        <text>@Model.FechaReferencia.ToString("MMMM yyyy", cultura)</text>
                    }
                    else
                    {
                        <text>Rango personalizado</text>
                    }
                </small>
            </div>

            <a class="ppv11-period-arrow"
               href="@Url.Action("Index","ProduccionPersonal",new {
                    vista = Model.Vista,
                    fechaDesde = FechaParam(siguiente),
                    fechaHasta = Model.Vista == "rango"
                        ? FechaParam(siguiente.AddDays(Math.Max(1,(Model.FinPeriodo-Model.InicioPeriodo).Days)-1))
                        : null,
                    panel = panelActual
               })"
               title="Periodo siguiente">
                <i class="fa-solid fa-chevron-right"></i>
            </a>
        </div>

        @if (Model.Vista == "rango")
        {
            <form method="get" class="ppv10-range-inline">
                <input type="hidden" name="vista" value="rango" />
                <input type="hidden" name="panel" value="@panelActual" />

                <label>
                    <span>Desde</span>
                    <input type="date"
                           name="fechaDesde"
                           value="@Model.InicioPeriodo.ToString("yyyy-MM-dd")"
                           class="form-control form-control-sm" />
                </label>

                <label>
                    <span>Hasta</span>
                    <input type="date"
                           name="fechaHasta"
                           value="@Model.FinPeriodoVisible.ToString("yyyy-MM-dd")"
                           class="form-control form-control-sm" />
                </label>

                <button class="btn btn-sm btn-primary fw-bold">
                    <i class="fa-solid fa-filter"></i>
                    Aplicar
                </button>
            </form>
        }
        else
        {
            <form method="get" class="ppv7-date-go">
                <input type="hidden" name="vista" value="@Model.Vista" />
                <input type="hidden" name="panel" value="@panelActual" />

                <input type="date"
                       name="fechaDesde"
                       value="@Model.FechaReferencia.ToString("yyyy-MM-dd")"
                       class="form-control form-control-sm" />

                <button class="btn btn-sm btn-primary fw-bold">
                    <i class="fa-solid fa-arrow-right"></i>
                    Ir
                </button>
            </form>
        }
    </section>

    <div class="collapse @(Model.Vista=="rango" ? "show" : "")" id="ppv7Range">
        <form method="get" class="ppv7-range-form">
            <input type="hidden" name="vista" value="rango" />
            <input type="hidden" name="panel" value="@panelActual" />
            <label>Desde<input type="date" name="fechaDesde" class="form-control form-control-sm" value="@Model.InicioPeriodo.ToString("yyyy-MM-dd")" /></label>
            <label>Hasta<input type="date" name="fechaHasta" class="form-control form-control-sm" value="@Model.FinPeriodoVisible.ToString("yyyy-MM-dd")" /></label>
            <button class="btn btn-sm btn-primary fw-bold"><i class="fa-solid fa-filter"></i> Aplicar rango</button>
        </form>
    </div>

    <section class="ppv3-filterbar">
        <div class="ppv3-search-wrap">
            <i class="fa-solid fa-magnifying-glass"></i>
            <input id="ppv3Search" type="search" class="form-control" placeholder="Buscar OF, pieza, máquina o persona..." />
        </div>
        <select id="ppv3MachineFilter" class="form-select form-select-sm">
            <option value="">Todas las máquinas</option>
            @foreach (var m in maquinas)
            {
                <option value="@m.MaquinaID">@m.MaquinaCodigo · @m.MaquinaNombre</option>
            }
        </select>
        <select id="ppv3TurnFilter" class="form-select form-select-sm">
            <option value="">Todos los turnos</option>
            @foreach (var t in Model.Segmentos.GroupBy(x => new { x.TurnoID, x.TurnoNombre }).Select(x => x.Key).OrderBy(x => x.TurnoID))
            {
                <option value="@t.TurnoID">@t.TurnoNombre</option>
            }
        </select>
        <select id="ppv3RoleFilter" class="form-select form-select-sm">
            <option value="">Todos los roles</option>
            <option value="OPERADOR">Operador</option>
            <option value="TECNICO">Técnico</option>
            <option value="SMED">SMED</option>
            <option value="AUXILIAR">Auxiliar</option>
        </select>
        <select id="ppv3PersonFilter" class="form-select form-select-sm">
            <option value="">Todas las personas</option>
            @foreach (var persona in personas.OrderBy(x => x.Value))
            {
                <option value="@persona.Key">@persona.Value</option>
            }
        </select>
        <button type="button" class="btn btn-sm btn-outline-secondary fw-bold" id="ppv3ClearFilters">
            <i class="fa-solid fa-eraser"></i> Limpiar
        </button>
    </section>

    <section class="ppv3-kpis">
        <button type="button" class="ppv3-kpi" data-kpi="all"><span>TURNOS / OF</span><strong>@Model.TotalSegmentos</strong></button>
        <button type="button" class="ppv3-kpi danger" data-kpi="red"><span>SIN OPERADOR</span><strong>@Model.TotalSinOperador</strong></button>
        <button type="button" class="ppv3-kpi warning" data-kpi="yellow"><span>PRODUCIENDO</span><strong>@Model.TotalProduciendo</strong></button>
        <button type="button" class="ppv3-kpi danger" data-kpi="conflict"><span>CONFLICTOS</span><strong>@Model.TotalConflictos</strong></button>
        <button type="button" class="ppv3-kpi success" data-kpi="green"><span>PROGRAMADOS</span><strong>@Model.TotalCompletos</strong></button>
    </section>

    <nav class="ppv3-tabs">
        <button type="button" class="ppv3-tab @(panelActual=="planner" ? "active" : "")" data-view="planner"><i class="fa-solid fa-table-cells-large"></i> Programación</button>
        <button type="button" class="ppv3-tab @(panelActual=="support" ? "active" : "")" data-view="support"><i class="fa-solid fa-people-group"></i> Cobertura por turno</button>
        <button type="button" class="ppv3-tab @(panelActual=="people" ? "active" : "")" data-view="people"><i class="fa-solid fa-users-viewfinder"></i> Vista por persona</button>
        <button type="button" class="ppv3-tab @(panelActual=="pending" ? "active" : "")" data-view="pending"><i class="fa-solid fa-triangle-exclamation"></i> Pendientes <span class="ppv3-tab-count">@Model.TotalSinOperador</span></button>
    </nav>

    <section class="ppv3-view @(panelActual=="planner" ? "active" : "")" data-view-panel="planner">
        <div class="ppv3-view-head ppv75-planner-head">
            <div>
                <h2>Programación por OF y turno</h2>
                <p>Una OF se divide por los turnos que cruza. El horario mostrado es únicamente el tiempo real trabajado dentro de esa OF.</p>
            </div>
            <div class="ppv75-planner-actions">
                <!-- NSQ_PRODUCCION_PERSONAL_V8_PERIODO -->
                <form asp-action="SugerirPeriodoV8"
                      method="post"
                      class="m-0 ppv8-suggest-form"
                      data-periodo="@TextoPeriodo()"
                      data-vista="@Model.Vista">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="vista" value="@Model.Vista" />
                    <input type="hidden" name="fechaDesde" value="@Model.InicioPeriodo.ToString("yyyy-MM-dd")" />
                    <input type="hidden" name="fechaHasta" value="@(Model.Vista == "rango" ? Model.FinPeriodoVisible.ToString("yyyy-MM-dd") : "")" />
                    <input type="hidden" name="panel" value="planner" />
                    <button class="btn btn-sm btn-primary fw-bold ppv8-suggest-btn"
                            @(Model.Configurado ? null : "disabled")
                            title="Redistribuye automaticamente los horarios futuros no iniciados del periodo. No modifica produccion activa ni historial pasado.">
                        <i class="fa-solid fa-wand-magic-sparkles"></i>
                        @(Model.Vista == "dia"
                            ? "Sugerir operadores del día"
                            : Model.Vista == "semana"
                                ? "Sugerir operadores de la semana"
                                : Model.Vista == "mes"
                                    ? "Sugerir operadores del mes"
                                    : "Sugerir operadores del rango")
                    </button>
                </form>
                <div class="ppv7-semaphore-legend">
                    <span><i class="ppv7-light rojo"></i> Falta operador</span>
                    <span><i class="ppv7-light amarillo"></i> Produciendo</span>
                    <span><i class="ppv7-light verde"></i> Programado</span>
                    <span><i class="ppv7-light ppv931-light-finished"></i> Horario finalizado</span>
                </div>
            </div>
        </div>

        <div class="table-responsive ppv3-table-wrap">
            <table class="ppv3-planner" id="ppv3PlannerTable">
                <thead>
                    <tr>
                        <th>Fecha</th>
                        <th>OF</th>
                        <th>Pieza</th>
                        <th>Máquina</th>
                        <th>Turno</th>
                        <th class="ppv7-work-head">Horario en OF</th>
                        <th class="ppv3-operator-head">Operador planeado</th>
                        <th>Nivel</th>
                        <th>Hist.</th>
                    </tr>
                </thead>
                <tbody>
                @{
                    DateTime? plannerFechaAnterior = null;
                    var plannerGrupos = Model.Segmentos
                        // NSQ_PRODUCCION_PERSONAL_V9_4_FECHA_TURNO_NOCTURNO
                        .GroupBy(x => new { Dia = x.FechaTrabajo.Date, x.TurnoID, x.TurnoNombre })
                        .OrderBy(x => x.Key.Dia)
                        .ThenBy(x => x.Min(y => y.Inicio))
                        .ThenBy(x => x.Key.TurnoID)
                        .ToList();
                }

                @foreach (var grupoPlanner in plannerGrupos)
                {
                    var plannerDia = grupoPlanner.Key.Dia;

                    @if (!plannerFechaAnterior.HasValue || plannerFechaAnterior.Value != plannerDia)
                    {
                        <!-- NSQ_PRODUCCION_PERSONAL_V8_7_DISENO_TURNOS_Y_DIA -->
                        <tr class="ppv8-planner-day ppv87-day-row @(plannerDia.Date == DateTime.Today ? "ppv11-today-day" : "")"
                            data-planner-day-header
                            data-planner-date="@plannerDia.ToString("yyyy-MM-dd")">
                            <td colspan="9">
                                <div class="ppv87-day-banner">
                                    <div class="ppv87-day-icon">
                                        <i class="fa-regular fa-calendar"></i>
                                    </div>

                                    <div class="ppv87-day-copy">
                                        <span>DÍA DE PRODUCCIÓN @(plannerDia.Date == DateTime.Today ? " · HOY" : "")</span>
                                        <strong>@plannerDia.ToString("dddd dd 'de' MMMM 'de' yyyy", cultura)</strong>
                                    </div>

                                    <div class="ppv87-day-count">
                                        <b>@Model.Segmentos.Count(x => x.FechaTrabajo.Date == plannerDia)</b>
                                        <span>trabajos / OF</span>
                                    </div>
                                </div>
                            </td>
                        </tr>
                    }

                    plannerFechaAnterior = plannerDia;

                    // NSQ_PRODUCCION_PERSONAL_V8_5_CARDS_TURNO
                    var turnoInfoV85 = Model.TurnosApoyo.FirstOrDefault(x => x.TurnoID == grupoPlanner.Key.TurnoID);
                    var horarioTurnoV85 = turnoInfoV85?.HorarioTexto ?? "Horario no definido";
                    var produciendoTurnoV85 = grupoPlanner.Count(x => x.ProduccionActiva);
                    var pendientesTurnoV85 = grupoPlanner.Count(x => !x.OperadorEfectivoID.HasValue);
                    var grupoKeyV85 = $"{plannerDia:yyyy-MM-dd}|{grupoPlanner.Key.TurnoID}";

                    <!-- NSQ_PRODUCCION_PERSONAL_V8_7_DISENO_TURNOS_Y_DIA -->
                    <tr class="ppv8-planner-turn ppv87-turn-row collapsed @(plannerDia.Date == DateTime.Today ? "ppv11-today-turn" : "")"
                        data-planner-turn-header
                        data-planner-date="@plannerDia.ToString("yyyy-MM-dd")"
                        data-planner-turn="@grupoPlanner.Key.TurnoID"
                        data-turn-card-key="@grupoKeyV85">
                        <td colspan="9">
                            <button type="button"
                                    class="ppv87-turn-card"
                                    data-turn-card-toggle
                                    data-turn-card-key="@grupoKeyV85"
                                    aria-expanded="false">
                                <div class="ppv87-turn-identity">
                                    <div class="ppv87-turn-icon">
                                        <i class="fa-solid fa-people-group"></i>
                                    </div>

                                    <div class="ppv87-turn-copy">
                                        <span class="ppv87-turn-label">TURNO</span>
                                        <strong>@grupoPlanner.Key.TurnoNombre</strong>

                                        @if (!string.Equals(
                                            horarioTurnoV85,
                                            grupoPlanner.Key.TurnoNombre,
                                            StringComparison.OrdinalIgnoreCase))
                                        {
                                            <small>
                                                <i class="fa-regular fa-clock"></i>
                                                @horarioTurnoV85
                                            </small>
                                        }
                                    </div>
                                </div>

                                <div class="ppv87-turn-stats">
                                    <div class="ppv87-stat jobs">
                                        <i class="fa-solid fa-list-check"></i>
                                        <div>
                                            <b>@grupoPlanner.Count()</b>
                                            <span>Trabajos</span>
                                        </div>
                                    </div>

                                    <div class="ppv87-stat producing">
                                        <i class="fa-solid fa-gears"></i>
                                        <div>
                                            <b>@produciendoTurnoV85</b>
                                            <span>Produciendo</span>
                                        </div>
                                    </div>

                                    <div class="ppv87-stat pending">
                                        <i class="fa-solid fa-user-clock"></i>
                                        <div>
                                            <b>@pendientesTurnoV85</b>
                                            <span>Pendientes</span>
                                        </div>
                                    </div>
                                </div>

                                <div class="ppv87-turn-action">
                                    <span data-turn-card-action-text>Abrir</span>
                                    <i class="fa-solid fa-chevron-right" data-turn-card-chevron></i>
                                </div>
                            </button>
                        </td>
                    </tr>

                    @foreach (var s in grupoPlanner.OrderBy(x => x.Inicio).ThenBy(x => x.MaquinaCodigo).ThenBy(x => x.OF))
                    {
                        var search = ($"{s.OF} {s.MaquinaCodigo} {s.MaquinaNombre} {s.NumeroParte} {s.DescripcionParte} {s.TurnoNombre} {s.OperadorEfectivoNombre}").ToLowerInvariant();
                        // NSQ_PRODUCCION_PERSONAL_V9_3_1_HORARIOS_FINALIZADOS
                    var horarioFinalizadoV931 =
                        DateTime.Now >= s.Fin;

                    var semaforoClase =
                        horarioFinalizadoV931
                            ? "ppv931-operator-finished"
                            : $"ppv7-operator-{s.Semaforo.ToLowerInvariant()}";

                    <tr class="ppv3-program-row @(s.TieneConflicto ? "has-conflict" : "") @(horarioFinalizadoV931 ? "ppv931-segment-finished" : "") @(s.FechaTrabajo.Date == DateTime.Today ? "ppv11-today-row" : "")"
                        data-search="@search"
                        data-planner-date="@s.FechaTrabajo.ToString("yyyy-MM-dd")"
                        data-turn-card-key="@($"{s.Inicio:yyyy-MM-dd}|{s.TurnoID}")"
                        data-machine-id="@s.MaquinaID"
                        data-turn-id="@s.TurnoID"
                        data-person-id="@(s.OperadorEfectivoID?.ToString() ?? "")"
                        data-status="@(horarioFinalizadoV931 ? "finalizado" : s.Semaforo.ToLowerInvariant())"
