                        data-role="OPERADOR">
                        <td class="ppv3-time-cell">
                            <strong>@s.FechaTrabajo.ToString("ddd dd/MM", cultura)</strong>

                            @if (s.Fin.Date > s.FechaTrabajo.Date)
                            {
                                <span>
                                    Turno @s.FechaTrabajo.ToString("dd/MM")
                                    → @s.Fin.ToString("dd/MM")
                                </span>
                            }
                            else
                            {
                                <span>Turno @s.FechaTrabajo.ToString("dd/MM")</span>
                            }
                        </td>
                        <td>
                            <strong class="ppv3-of">@s.OF</strong>

                            @if (horarioFinalizadoV931)
                            {
                                <span class="ppv3-mini-badge ppv931-finished-badge">
                                    <i class="fa-solid fa-lock me-1"></i>
                                    HORARIO FINALIZADO
                                </span>
                            }
                            else if (s.ProduccionActiva)
                            {
                                <span class="ppv3-mini-badge ppv7-producing-badge">EN PRODUCCIÓN</span>
                            }
                            else if (!s.TieneAsignacionEspecifica && s.OperadorBaseID.HasValue)
                            {
                                <span class="ppv3-mini-badge ppv7-inherited-badge">Heredado de OF</span>
                            }
                            else if (s.TieneAsignacionEspecifica)
                            {
                                <span class="ppv3-mini-badge ppv7-turn-badge">Por turno</span>
                            }
                        </td>
                        <td class="ppv3-part-cell">
                            <strong>@(string.IsNullOrWhiteSpace(s.NumeroParte) ? "Sin parte" : s.NumeroParte)</strong>
                            <span>@s.DescripcionParte</span>
                        </td>
                        <td class="ppv3-machine-cell"><strong>@s.MaquinaCodigo</strong><span>@s.MaquinaNombre</span></td>
                        <td><span class="ppv3-turn-chip">@s.TurnoNombre</span></td>
                        <td>
                            <div class="ppv7-work-window" title="OF completa: @s.InicioPrograma.ToString("dd/MM HH:mm") → @s.FinPrograma.ToString("dd/MM HH:mm")">
                                <strong>@s.Inicio.ToString("HH:mm") — @s.Fin.ToString("HH:mm")</strong>
                                <span>@((s.Fin - s.Inicio).TotalHours.ToString("0.##")) h en esta OF</span>
                            </div>
                        </td>
                        <td>
                            <button type="button"
                                    class="ppv3-assign-cell ppv7-operator-cell @semaforoClase @(s.OperadorEfectivoID.HasValue ? "" : "pending") @(horarioFinalizadoV931 ? "ppv931-readonly" : "")"
                                    disabled="@(horarioFinalizadoV931 ? "disabled" : null)"
                                    title="@(horarioFinalizadoV931 ? "Horario finalizado · solo lectura" : "Cambiar operador")"
                                    data-finished="@(horarioFinalizadoV931 ? "1" : "0")"
                                    data-assign
                                    data-program="@s.ProgramaProduccionID"
                                    data-turn="@s.TurnoID"
                                    data-date="@s.FechaTrabajo.ToString("yyyy-MM-dd")"
                                    data-current="@(s.OperadorEfectivoID?.ToString() ?? "")"
                                    data-name="@s.OperadorEfectivoNombre"
                                    data-producing="@(s.ProduccionActiva ? "1" : "0")"
                                    data-execution="@(s.EjecucionProduccionID?.ToString() ?? "")"
                                    data-of="@s.OF">
                                <span class="ppv3-assign-name">
                                    @if (horarioFinalizadoV931)
                                    {
                                        <i class="fa-solid fa-lock ppv931-lock"></i>
                                    }
                                    else
                                    {
                                        <i class="ppv7-operator-dot"></i>
                                    }

                                    @(s.OperadorEfectivoID.HasValue
                                        ? s.OperadorEfectivoNombre
                                        : horarioFinalizadoV931
                                            ? "Sin operador registrado"
                                            : "Asignar operador")
                                </span>
                                <span class="ppv3-assign-meta">
                                    @(horarioFinalizadoV931
                                        ? (s.OperadorEfectivoID.HasValue
                                            ? "Horario finalizado · solo lectura"
                                            : "Horario finalizado · quedó sin operador")
                                        : s.Semaforo == "ROJO"
                                        ? "Falta operador · clic para asignar"
                                        : s.Semaforo == "AMARILLO"
                                            ? "OF produciendo · cambio mediante relevo"
                                            : s.TieneAsignacionEspecifica
                                                ? "Programado para este horario"
                                                : "Programado · heredado de la OF")
                                </span>
                            </button>
                        </td>
                        <td>
                            @if (s.NivelOperador.HasValue)
                            {
                                <span class="ppv7-level n@(s.NivelOperador.Value)">@($"N{s.NivelOperador.Value}")</span>
                            }
                            else
                            {
                                <span class="text-muted">—</span>
                            }
                        </td>
                        <td>
                            <button type="button" class="btn btn-sm btn-outline-secondary" data-history data-program="@s.ProgramaProduccionID" data-of="@s.OF" title="Ver historial">
                                <i class="fa-solid fa-clock-rotate-left"></i>
                            </button>
                        </td>
                    </tr>
                    }
                }
                </tbody>
            </table>
        </div>
        @if (!Model.Segmentos.Any())
        {
            <div class="ppv3-empty-state">No hay OF que crucen el periodo seleccionado.</div>
        }
    </section>

