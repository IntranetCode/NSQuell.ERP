            {
                <div class="ppv10-support-weeks">
                    @foreach (var periodoV10 in Model.CoberturasSoporteV10)
                    {
                        var semanaFinV10 = periodoV10.SemanaInicio.AddDays(6);
                        var esSemanaActualV11 =
                            DateTime.Today.Date >= periodoV10.SemanaInicio.Date &&
                            DateTime.Today.Date <= semanaFinV10.Date;
                        var abrirSemanaV10 =
                            Model.FechaReferencia.Date >= periodoV10.SemanaInicio.Date &&
                            Model.FechaReferencia.Date <= semanaFinV10.Date;

                        <details class="ppv10-support-week-card @(esSemanaActualV11 ? "ppv11-current-week" : "")"
                                 open="@(abrirSemanaV10 ? "open" : null)">
                            <summary>
                                <div class="ppv10-week-summary-main">
                                    <span>SEMANA</span>
                                    <strong>@periodoV10.NumeroSemana</strong>
                                </div>

                                <div class="ppv10-week-summary-range">
                                    <strong>
                                        @periodoV10.SemanaInicio.ToString("dd MMM",cultura)
                                        —
                                        @semanaFinV10.ToString("dd MMM yyyy",cultura)
                                    </strong>
                                    <span>Haz clic para abrir/cerrar la semana</span>
                                </div>

                                <div class="ppv10-week-summary-badges">
                                    @if (esSemanaActualV11)
                                    {
                                        <span class="ppv11-current-week-badge">
                                            <i class="fa-solid fa-location-dot"></i>
                                            SEMANA ACTUAL
                                        </span>
                                    }
                                    @if (periodoV10.EscalaID.HasValue)
                                    {
                                        <span class="ppv10-scale-badge @(string.Equals(periodoV10.EscalaEstado,"Publicada",StringComparison.OrdinalIgnoreCase) ? "published" : "draft")">
                                            <i class="fa-solid fa-users-gear"></i>
                                            @periodoV10.EscalaFolio · @periodoV10.EscalaEstado
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="ppv10-scale-badge missing">
                                            <i class="fa-solid fa-circle-info"></i>
                                            Sin escala RRHH vinculada
                                        </span>
                                    }

                                    @if (periodoV10.AjustesDiarios > 0)
                                    {
                                        <span class="ppv10-source-badge daily">
                                            <i class="fa-solid fa-calendar-day"></i>
                                            @periodoV10.AjustesDiarios ajuste(s) diario(s)
                                        </span>
                                    }

                                    <i class="fa-solid fa-chevron-down ppv10-week-chevron"></i>
                                </div>
                            </summary>

                            <form asp-action="GuardarCoberturaV7"
                                  method="post"
                                  class="ppv10-support-form">
                                @Html.AntiForgeryToken()

                                <input type="hidden"
                                       name="SemanaInicio"
                                       value="@periodoV10.SemanaInicio.ToString("yyyy-MM-dd")" />

                                <input type="hidden"
                                       name="Vista"
                                       value="@Model.Vista" />

                                <input type="hidden"
                                       name="Panel"
                                       value="support" />

                                <input type="hidden"
                                       name="FechaDesde"
                                       value="@Model.InicioPeriodo.ToString("yyyy-MM-dd")" />

                                <input type="hidden"
                                       name="FechaHasta"
                                       value="@(Model.Vista=="rango" ? Model.FinPeriodoVisible.ToString("yyyy-MM-dd") : "")" />

                                <div class="ppv3-table-wrap ppv10-support-table-wrap">
                                    <table class="ppv3-support-table">
                                        <thead>
                                            <tr>
                                                <th>Turno</th>
                                                <th>Tipo</th>
                                                <th data-role-col="TECNICO">Técnico</th>
                                                <th data-role-col="SMED">SMED</th>
                                                <th data-role-col="AUXILIAR">Auxiliar</th>
                                            </tr>
                                        </thead>
                                        <tbody>
                                        @for (var i = 0; i < periodoV10.Turnos.Count; i++)
                                        {
                                            var t = periodoV10.Turnos[i];
                                            var tipoClass = (t.TipoTurno ?? "").Contains("12",StringComparison.OrdinalIgnoreCase) ? "x12" : "regular";
                                            var supportKey = $"W-{periodoV10.SemanaInicio:yyyyMMdd}-{t.TurnoID}";

                                            <tr>
                                                <td>
                                                    <input type="hidden"
                                                           name="Coberturas[@i].TurnoID"
                                                           value="@t.TurnoID" />

                                                    <div class="ppv3-support-turn">
                                                        <i class="ppv3-turn-dot"
                                                           style="--turn-color:@t.Color"></i>
                                                        <div>
                                                            <strong>@t.Nombre</strong>
                                                            <span>@t.HorarioTexto</span>
                                                        </div>
                                                    </div>
                                                </td>

                                                <td>
                                                    <span class="ppv3-type-chip @tipoClass">
                                                        @(string.IsNullOrWhiteSpace(t.TipoTurno) ? "Regular" : t.TipoTurno)
                                                    </span>
                                                </td>

                                                <td data-role-cell="TECNICO">
                                                    <select class="d-none ppv3-support-hidden"
                                                            name="Coberturas[@i].TecnicoProduccionID"
                                                            data-support-key="@supportKey"
                                                            data-turno-id="@t.TurnoID"
                                                            data-role="TECNICO">
                                                        <option value="">Sin asignar</option>
                                                        @foreach (var p in Model.Tecnicos)
                                                        {
                                                            <option value="@p.PersonaID"
                                                                    selected="@(t.TecnicoProduccionID == p.PersonaID ? "selected" : null)">
                                                                @p.Nombre
                                                            </option>
                                                        }
                                                    </select>

                                                    <button type="button"
                                                            class="ppv3-support-cell @(t.TecnicoProduccionID.HasValue ? "assigned" : "unassigned")"
                                                            data-support-open
                                                            data-support-key="@supportKey"
                                                            data-support-scope="SEMANA"
                                                            data-support-scope-label="@($"Semana {periodoV10.NumeroSemana}")"
                                                            data-turno-id="@t.TurnoID"
                                                            data-role="TECNICO">
                                                        <span>@NombrePersona(Model.Tecnicos,t.TecnicoProduccionID)</span>
                                                        <small class="ppv3-support-status">
                                                            @(t.TecnicoProduccionID.HasValue
                                                                ? "Asignado como Técnico · clic para modificar"
                                                                : "Sin técnico · clic para modificar")
                                                        </small>
                                                    </button>
                                                </td>

                                                <td data-role-cell="SMED">
                                                    <select class="d-none ppv3-support-hidden"
                                                            name="Coberturas[@i].SmedID"
                                                            data-support-key="@supportKey"
                                                            data-turno-id="@t.TurnoID"
                                                            data-role="SMED">
                                                        <option value="">Sin asignar</option>
                                                        @foreach (var p in Model.SmedYTecnicos)
                                                        {
                                                            <option value="@p.PersonaID"
                                                                    selected="@(t.SmedID == p.PersonaID ? "selected" : null)">
                                                                @p.Nombre
                                                            </option>
                                                        }
                                                    </select>

                                                    <button type="button"
                                                            class="ppv3-support-cell @(t.SmedID.HasValue ? "assigned" : "unassigned")"
                                                            data-support-open
                                                            data-support-key="@supportKey"
                                                            data-support-scope="SEMANA"
                                                            data-support-scope-label="@($"Semana {periodoV10.NumeroSemana}")"
                                                            data-turno-id="@t.TurnoID"
                                                            data-role="SMED">
                                                        <span>@NombrePersona(Model.SmedYTecnicos,t.SmedID)</span>
                                                        <small class="ppv3-support-status">
                                                            @(t.SmedID.HasValue
                                                                ? "Asignado · SMED o Técnico · clic para modificar"
                                                                : "Sin SMED · SMED o Técnico · clic para modificar")
                                                        </small>
                                                    </button>
                                                </td>

                                                <td data-role-cell="AUXILIAR">
                                                    <select class="d-none ppv3-support-hidden"
                                                            name="Coberturas[@i].AuxiliarID"
                                                            data-support-key="@supportKey"
                                                            data-turno-id="@t.TurnoID"
                                                            data-role="AUXILIAR">
                                                        <option value="">Sin asignar</option>
                                                        @foreach (var p in Model.Auxiliares)
                                                        {
                                                            <option value="@p.PersonaID"
                                                                    selected="@(t.AuxiliarID == p.PersonaID ? "selected" : null)">
                                                                @p.Nombre
                                                            </option>
                                                        }
                                                    </select>

                                                    <button type="button"
                                                            class="ppv3-support-cell @(t.AuxiliarID.HasValue ? "assigned" : "unassigned")"
                                                            data-support-open
                                                            data-support-key="@supportKey"
                                                            data-support-scope="SEMANA"
                                                            data-support-scope-label="@($"Semana {periodoV10.NumeroSemana}")"
                                                            data-turno-id="@t.TurnoID"
                                                            data-role="AUXILIAR">
                                                        <span>@NombrePersona(Model.Auxiliares,t.AuxiliarID)</span>
                                                        <small class="ppv3-support-status">
                                                            @(t.AuxiliarID.HasValue
                                                                ? "Asignado como Auxiliar · clic para modificar"
                                                                : "Sin auxiliar · clic para modificar")
                                                        </small>
                                                    </button>
                                                </td>
                                            </tr>
                                        }
                                        </tbody>
                                    </table>
                                </div>

                                <div class="ppv3-savebar ppv7-support-savebar ppv10-support-savebar">
                                    <div>
                                        <strong>
                                            Semana @periodoV10.NumeroSemana ·
                                            @periodoV10.SemanaInicio.ToString("dd/MM")
                                            —
                                            @semanaFinV10.ToString("dd/MM/yyyy")
                                        </strong>
                                        <span>
                                            Este guardado modifica únicamente esta semana.
                                        </span>
                                    </div>

                                    <button class="btn btn-primary fw-bold">
                                        <i class="fa-solid fa-floppy-disk"></i>
                                        Guardar semana @periodoV10.NumeroSemana
                                    </button>
                                </div>
                            </form>
                        </details>
                    }
                </div>
            }

            <div class="ppv10-scale-explanation">
                <i class="fa-solid fa-circle-info"></i>
                <span>
                    La escala de RRHH sólo se usa como referencia para proponer Técnico, SMED y Auxiliar.
                    Si no existe escala vinculada, la cobertura puede capturarse manualmente.
                </span>
            </div>
        }
    </section>

    <section class="ppv3-view @(panelActual=="people" ? "active" : "")" data-view-panel="people">
        <div class="ppv3-view-head">
            <div>
                <h2>Calendario de personal</h2>
                <p>Todos los operadores oficiales permanecen visibles, tengan o no programación. Usa el buscador superior para localizar a una persona al instante.</p>
            </div>
            <div class="ppv7-people-summary">
                <strong>@Model.Operadores.Count operadores</strong>
                <span>@Model.Operadores.Count(op => !Model.Segmentos.Any(s => s.OperadorEfectivoID == op.PersonaID)) sin programación</span>
            </div>
        </div>

        @if (Model.Vista == "dia")
        {
            var diaTimeline = Model.InicioPeriodo.Date;
            <div class="ppv75-timeline-help">
                <i class="fa-solid fa-circle-info"></i>
                Vista horaria del día. Los bloques muestran exactamente el intervalo trabajado dentro de la OF; haz clic para ver el detalle.
            </div>
            <div class="ppv75-person-timeline-scroll">
                <div class="ppv75-person-timeline">
                    <div class="ppv75-time-corner">PERSONA / CARGA</div>
                    <div class="ppv75-time-ruler">
                        @for (var h = 0; h <= 24; h += 2)
                        {
                            var pct = h / 24.0 * 100.0;
                            <span style="left:@pct.ToString("0.####", CultureInfo.InvariantCulture)%">@h.ToString("00"):00</span>
                        }
                    </div>

                    @foreach (var op in Model.Operadores.OrderBy(x => x.Nombre))
                    {
                        var trabajosPersona = Model.Segmentos
                            .Where(x => x.OperadorEfectivoID == op.PersonaID)
                            .OrderBy(x => x.Inicio)
                            .ToList();
                        var horasPersona = trabajosPersona.Sum(x => (x.Fin - x.Inicio).TotalHours);
                        var sinProgramacion = trabajosPersona.Count == 0;
                        var machineList = string.Join(",", trabajosPersona.Select(x => x.MaquinaID).Distinct());
                        var turnList = string.Join(",", trabajosPersona.Select(x => x.TurnoID).Distinct());

                        <div class="ppv75-time-person @(sinProgramacion ? "empty" : "")"
                             data-person-calendar="@op.PersonaID"
                             data-person-search="@($"{op.Nombre} {op.NumeroControl}".ToLowerInvariant())"
                             data-machine-list="@machineList"
                             data-turn-list="@turnList">
                            <strong>@op.Nombre</strong>
                            <span>@op.NumeroControl · @horasPersona.ToString("0.##") h</span>
                            <small class="@(sinProgramacion ? "empty" : trabajosPersona.Any(x => x.TieneConflicto) ? "conflict" : "ok")">
                                @(sinProgramacion ? "SIN PROGRAMACIÓN" : trabajosPersona.Any(x => x.TieneConflicto) ? "REVISAR CRUCE" : "PROGRAMADO")
                            </small>
                        </div>

                        <div class="ppv75-time-track"
                             data-person-cell="@op.PersonaID"
                             data-person-search="@($"{op.Nombre} {op.NumeroControl}".ToLowerInvariant())"
                             data-machine-list="@machineList"
                             data-turn-list="@turnList">
                            @for (var h = 0; h <= 24; h += 2)
                            {
                                var pct = h / 24.0 * 100.0;
                                <i class="ppv75-hour-line" style="left:@pct.ToString("0.####", CultureInfo.InvariantCulture)%"></i>
                            }

                            @if (!trabajosPersona.Any())
                            {
                                <span class="ppv75-timeline-free">Sin programación para este día</span>
                            }
                            else
                            {
                                @foreach (var s in trabajosPersona)
                                {
                                    var inicioClip = s.Inicio < diaTimeline ? diaTimeline : s.Inicio;
                                    var finClip = s.Fin > diaTimeline.AddDays(1) ? diaTimeline.AddDays(1) : s.Fin;
                                    var inicioMin = Math.Max(0, (inicioClip - diaTimeline).TotalMinutes);
                                    var finMin = Math.Min(1440, (finClip - diaTimeline).TotalMinutes);
                                    var left = inicioMin / 1440.0 * 100.0;
                                    var width = Math.Max(0.7, (finMin - inicioMin) / 1440.0 * 100.0);

                                    <button type="button"
                                            class="ppv75-time-job @s.Semaforo.ToLowerInvariant() @(s.TieneConflicto ? "conflict" : "")"
                                            style="left:@left.ToString("0.####", CultureInfo.InvariantCulture)%;width:@width.ToString("0.####", CultureInfo.InvariantCulture)%"
                                            data-person-job
                                            data-person="@op.Nombre"
                                            data-control="@op.NumeroControl"
                                            data-of="@s.OF"
                                            data-machine="@s.MaquinaCodigo"
                                            data-machine-name="@s.MaquinaNombre"
                                            data-part="@s.NumeroParte"
                                            data-part-desc="@s.DescripcionParte"
                                            data-turn="@s.TurnoNombre"
                                            data-start="@s.Inicio.ToString("O")"
                                            data-end="@s.Fin.ToString("O")"
                                            data-program-start="@s.InicioPrograma.ToString("O")"
                                            data-program-end="@s.FinPrograma.ToString("O")"
                                            data-status="@s.Semaforo"
                                            data-conflict="@(s.TieneConflicto ? "1" : "0")"
                                            data-calendar-date="@s.Inicio.ToString("yyyy-MM-dd")"
                                            title="@s.OF · @s.Inicio.ToString("HH:mm")–@s.Fin.ToString("HH:mm")">
                                        <strong>@s.OF</strong>
                                        <span>@s.Inicio.ToString("HH:mm")–@s.Fin.ToString("HH:mm")</span>
                                    </button>
                                }
                            }
                        </div>
                    }
                </div>
            </div>
        }
        else
        {
            <div class="ppv75-calendar-hint">
                <i class="fa-solid fa-clock"></i> Para revisar horas exactas en una línea de tiempo, abre el periodo <strong>Día</strong>. En Semana/Mes/Rango se mantiene la matriz por fechas.
            </div>
            <div class="ppv7-calendar-scroll">
                <div class="ppv7-person-calendar" style="--ppv7-days:@diasCalendario.Count">
                    <div class="ppv7-calendar-corner">PERSONA / CARGA</div>
                    @foreach (var dia in diasCalendario)
                    {
                        <button type="button" class="ppv7-calendar-day-head @(dia.Date == DateTime.Today ? "today" : "")" data-calendar-day="@dia.ToString("yyyy-MM-dd")">
                            <span>@dia.ToString("ddd", cultura)</span>
                            <strong>@dia.ToString("dd/MM")</strong>
                        </button>
                    }

                    @foreach (var op in Model.Operadores.OrderBy(x => x.Nombre))
                    {
                        var trabajosPersona = Model.Segmentos.Where(x => x.OperadorEfectivoID == op.PersonaID).OrderBy(x => x.Inicio).ToList();
                        var horasPersona = trabajosPersona.Sum(x => (x.Fin - x.Inicio).TotalHours);
                        var sinProgramacion = trabajosPersona.Count == 0;
                        var machineList = string.Join(",", trabajosPersona.Select(x => x.MaquinaID).Distinct());
                        var turnList = string.Join(",", trabajosPersona.Select(x => x.TurnoID).Distinct());

                        <div class="ppv7-calendar-person @(sinProgramacion ? "empty" : "")"
                             data-person-calendar="@op.PersonaID"
                             data-person-search="@($"{op.Nombre} {op.NumeroControl}".ToLowerInvariant())"
                             data-machine-list="@machineList"
                             data-turn-list="@turnList">
                            <strong>@op.Nombre</strong>
                            <span>@op.NumeroControl · @horasPersona.ToString("0.##") h</span>
                            <small class="@(sinProgramacion ? "empty" : trabajosPersona.Any(x => x.TieneConflicto) ? "conflict" : "ok")">
                                @(sinProgramacion ? "SIN PROGRAMACIÓN" : trabajosPersona.Any(x => x.TieneConflicto) ? "REVISAR CRUCE" : "PROGRAMADO")
                            </small>
                        </div>

                        @foreach (var dia in diasCalendario)
                        {
                            var finDia = dia.AddDays(1);
                            var trabajosDia = trabajosPersona.Where(x => x.Inicio < finDia && x.Fin > dia).OrderBy(x => x.Inicio).ToList();
                            <div class="ppv7-calendar-cell @(dia.Date == DateTime.Today ? "today" : "")"
                                 data-person-cell="@op.PersonaID"
                                 data-person-search="@($"{op.Nombre} {op.NumeroControl}".ToLowerInvariant())"
                                 data-machine-list="@machineList"
                                 data-turn-list="@turnList">
                                @if (!trabajosDia.Any())
                                {
                                    <span class="ppv7-calendar-free">Sin programación</span>
                                }
                                else
                                {
                                    @foreach (var s in trabajosDia)
                                    {
                                        var inicioDia = s.Inicio > dia ? s.Inicio : dia;
                                        var finEfectivo = s.Fin < finDia ? s.Fin : finDia;
                                        <button type="button"
                                                class="ppv7-calendar-job @s.Semaforo.ToLowerInvariant() @(s.TieneConflicto ? "conflict" : "")"
                                                data-person-job
                                                data-person="@op.Nombre"
                                                data-control="@op.NumeroControl"
                                                data-of="@s.OF"
                                                data-machine="@s.MaquinaCodigo"
                                                data-machine-name="@s.MaquinaNombre"
                                                data-part="@s.NumeroParte"
                                                data-part-desc="@s.DescripcionParte"
                                                data-turn="@s.TurnoNombre"
                                                data-start="@s.Inicio.ToString("O")"
                                                data-end="@s.Fin.ToString("O")"
                                                data-program-start="@s.InicioPrograma.ToString("O")"
                                                data-program-end="@s.FinPrograma.ToString("O")"
                                                data-status="@s.Semaforo"
                                                data-conflict="@(s.TieneConflicto ? "1" : "0")"
                                                data-calendar-date="@dia.ToString("yyyy-MM-dd")"
                                                title="Ver detalle">
                                            <span>@inicioDia.ToString("HH:mm")–@finEfectivo.ToString("HH:mm")</span>
                                            <strong>@s.OF</strong>
                                            <small>@s.MaquinaCodigo · @s.NumeroParte</small>
                                        </button>
                                    }
                                }
                            </div>
                        }
                    }
                </div>
            </div>
        }
    </section>

    <section class="ppv3-view @(panelActual=="pending" ? "active" : "")" data-view-panel="pending">
        <div class="ppv3-view-head"><div><h2>Pendientes de cobertura</h2><p>Turnos efectivos de OF que todavía no tienen operador.</p></div></div>
        <div class="table-responsive">
            <table class="ppv3-pending-table">
                <thead><tr><th>Prioridad</th><th>OF</th><th>Horario en OF</th><th>Máquina</th><th>Pieza</th><th>Turno</th><th></th></tr></thead>
                <tbody>
                @foreach (var s in Model.Segmentos.Where(x => !x.OperadorEfectivoID.HasValue).OrderBy(x => x.Inicio))
                {
                    <tr>
                        <td><span class="ppv3-priority high">ALTA</span></td><td><strong>@s.OF</strong></td>
                        <td>@s.Inicio.ToString("dd/MM HH:mm") — @s.Fin.ToString("dd/MM HH:mm")</td>
                        <td>@s.MaquinaCodigo</td><td>@s.NumeroParte</td><td>@s.TurnoNombre</td>
                        <td><button type="button" class="btn btn-sm btn-danger" data-assign data-program="@s.ProgramaProduccionID" data-turn="@s.TurnoID" data-date="@s.FechaTrabajo.ToString("yyyy-MM-dd")" data-current="" data-name="Sin asignar" data-producing="@(s.ProduccionActiva ? "1" : "0")" data-of="@s.OF">Asignar</button></td>
                    </tr>
                }
                </tbody>
            </table>
        </div>
    </section>
</div>

<div class="offcanvas offcanvas-end ppv3-availability" tabindex="-1" id="ppv3Availability">
    <div class="offcanvas-header">
        <div><div class="ppv3-eyebrow">PERSONAL DISPONIBLE</div><h5 class="offcanvas-title mb-0" id="ppv3DrawerTitle">Asignar operador</h5></div>
        <button type="button" class="btn-close" data-bs-dismiss="offcanvas"></button>
    </div>
    <div class="offcanvas-body">
        <div class="ppv3-drawer-summary" id="ppv3DrawerSummary"></div>
        <div class="ppv3-candidate-search-wrap">
            <i class="fa-solid fa-magnifying-glass"></i>
            <input type="search" id="ppv3CandidateSearch" class="form-control" autocomplete="off" placeholder="Buscar operador por nombre o No. control..." />
            <button type="button" id="ppv3CandidateSearchClear" class="ppv3-candidate-search-clear" title="Limpiar búsqueda"><i class="fa-solid fa-xmark"></i></button>
        </div>
        <div class="ppv3-candidate-search-meta"><span id="ppv3CandidateSearchCount"></span><span>Polivalencia, escala, carga y disponibilidad.</span></div>
        <div id="ppv3CandidateNoResults" class="ppv3-candidate-no-results d-none"><i class="fa-solid fa-user-slash"></i> No hay operadores que coincidan con la búsqueda.</div>
        <div class="ppv3-candidate-list" id="ppv3CandidateList"></div>
        <div class="ppv75-drawer-note">
            <i class="fa-solid fa-circle-info"></i> Selecciona una persona o <strong>Dejar sin operador</strong>. Antes de guardar verás un resumen del cambio.
        </div>
        <form asp-action="GuardarTurnoV7" method="post" id="ppv3AssignForm" class="d-none">
            @Html.AntiForgeryToken()
            <input type="hidden" name="ProgramaProduccionID" id="ppv3Program" />
            <input type="hidden" name="TurnoID" id="ppv3Turno" />
            <input type="hidden" name="FechaTrabajo" id="ppv3Fecha" />
            <input type="hidden" name="OperadorID" id="ppv3Operator" />
