@section Scripts {
<script>
(() => {
    const root = document.getElementById('ppv3Root');
    if (!root) return;
    const $ = (s, ctx = document) => ctx.querySelector(s);
    const $$ = (s, ctx = document) => Array.from(ctx.querySelectorAll(s));
    const normalize = v => (v || '').toString().toLowerCase().normalize('NFD').replace(/[\u0300-\u036f]/g, '');
    const initialPanel = '@panelActual';
    let currentPanel = initialPanel;

    const search = $('#ppv3Search');
    const machine = $('#ppv3MachineFilter');
    const turn = $('#ppv3TurnFilter');
    const role = $('#ppv3RoleFilter');
    const person = $('#ppv3PersonFilter');
    let activeKpi = 'all';

    function listContains(list, value) {
        if (!value) return true;
        return (list || '').split(',').map(x => x.trim()).includes(value);
    }

    function applyFilters() {
        const q = normalize(search?.value);
        const m = machine?.value || '';
        const t = turn?.value || '';
        const p = person?.value || '';

        $$('.ppv3-program-row').forEach(row => {
            let ok = (!q || normalize(row.dataset.search).includes(q)) &&
                     (!m || row.dataset.machineId === m) &&
                     (!t || row.dataset.turnId === t) &&
                     (!p || row.dataset.personId === p);
            if (activeKpi === 'red') ok = ok && row.dataset.status === 'rojo';
            else if (activeKpi === 'yellow') ok = ok && row.dataset.status === 'amarillo';
            else if (activeKpi === 'green') ok = ok && row.dataset.status === 'verde';
            else if (activeKpi === 'conflict') ok = ok && row.dataset.conflict === '1';
            row.style.display = ok ? '' : 'none';
        });

        const allPersonIds = new Set($$('[data-person-calendar]').map(x => x.dataset.personCalendar));
        allPersonIds.forEach(id => {
            const label = $(`[data-person-calendar="${id}"]`);
            if (!label) return;
            const personSearch = normalize(label.dataset.personSearch);
            const matches = (!q || personSearch.includes(q)) &&
                            (!p || id === p) &&
                            (!m || listContains(label.dataset.machineList, m)) &&
                            (!t || listContains(label.dataset.turnList, t));
            label.style.display = matches ? '' : 'none';
            $$(`[data-person-cell="${id}"]`).forEach(cell => cell.style.display = matches ? '' : 'none');
        });
    }

    [search, machine, turn, person].forEach(el => el?.addEventListener('input', applyFilters));
    $('#ppv3ClearFilters')?.addEventListener('click', () => {
        [search, machine, turn, role, person].forEach(el => { if (el) el.value = ''; });
        activeKpi = 'all'; root.dataset.roleFilter = ''; showView('planner'); applyFilters();
    });
    $$('.ppv3-kpi').forEach(button => button.addEventListener('click', () => {
        activeKpi = button.dataset.kpi || 'all'; showView('planner'); applyFilters();
    }));

    const tabs = $$('.ppv3-tab');
    function showView(name, updateUrl = true) {
        currentPanel = name;
        tabs.forEach(x => x.classList.toggle('active', x.dataset.view === name));
        $$('[data-view-panel]').forEach(x => x.classList.toggle('active', x.dataset.viewPanel === name));

        // Los href se renderizan inicialmente en servidor. Si el usuario cambia
        // de pestaña sin recargar, hay que actualizar tambien esos enlaces.
        $$('.ppv7-period-tab[href], .ppv3-week-nav a[href]').forEach(link => {
            const u = new URL(link.href, window.location.origin);
            u.searchParams.set('panel', name);
            link.href = u.toString();
        });

        $$('input[name="panel"], input[name="Panel"]').forEach(input => {
            input.value = name;
        });

        if (updateUrl) {
            const url = new URL(window.location.href);
            url.searchParams.set('panel', name);
            history.replaceState({}, '', url);
        }
    }
    tabs.forEach(button => button.addEventListener('click', () => showView(button.dataset.view)));
    role?.addEventListener('change', () => {
        root.dataset.roleFilter = role.value || '';
        showView(['TECNICO','SMED','AUXILIAR'].includes(role.value) ? 'support' : 'planner');
    });
    showView(initialPanel, false);

    // ------------------------------------------------------------
    // Asignación de operador
    // ------------------------------------------------------------
    const drawerEl = $('#ppv3Availability');
    const drawer = bootstrap.Offcanvas.getOrCreateInstance(drawerEl);
    const candidateList = $('#ppv3CandidateList');
    const candidateSearch = $('#ppv3CandidateSearch');
    const candidateSearchClear = $('#ppv3CandidateSearchClear');
    const candidateSearchCount = $('#ppv3CandidateSearchCount');
    const candidateNoResults = $('#ppv3CandidateNoResults');
    const confirmModal = bootstrap.Modal.getOrCreateInstance($('#ppv75ConfirmModal'));
    let assignmentContext = null;
    let pendingSelection = null;

    function filterCandidateCards() {
        const q = normalize(candidateSearch?.value);
        const cards = $$('.ppv3-candidate', candidateList);
        let visible = 0;
        cards.forEach(card => {
            const show = !q || normalize(card.dataset.candidateSearch || card.textContent).includes(q);
            card.classList.toggle('d-none', !show);
            if (show) visible++;
        });
        if (candidateSearchCount) candidateSearchCount.textContent = `${visible} de ${cards.length} operador(es)`;
        candidateNoResults?.classList.toggle('d-none', !(cards.length > 0 && visible === 0));
    }
    candidateSearch?.addEventListener('input', filterCandidateCards);
    candidateSearchClear?.addEventListener('click', () => {
        if (!candidateSearch) return; candidateSearch.value = ''; filterCandidateCards(); candidateSearch.focus();
    });
    drawerEl?.addEventListener('shown.bs.offcanvas', () => candidateSearch?.focus());
    function levelClass(n) { return n >= 4 ? 'n4' : n === 3 ? 'n3' : n === 2 ? 'n2' : n === 1 ? 'n1' : 'none'; }

    function fmtHour(value) {
        const d = new Date(value);
        return d.toLocaleTimeString([], { hour:'2-digit', minute:'2-digit' });
    }

    function prepareConfirmation(selection) {
        pendingSelection = selection;
        $('#ppv75ConfirmOld').textContent = assignmentContext?.currentName || 'Sin asignar';
        $('#ppv75ConfirmNew').textContent = selection.name || 'Sin asignar';
        $('#ppv75ConfirmContext').innerHTML = `<strong>${assignmentContext.of}</strong> · ${assignmentContext.turno}<br>${fmtHour(assignmentContext.inicio)} — ${fmtHour(assignmentContext.fin)}`;
        $('#ppv75ConflictWarning').classList.toggle('d-none', !selection.conflict);
        $('#ppv75ProductionWarning').classList.toggle('d-none', !assignmentContext.producing);
        $('#ppv75ConfirmReason').value = selection.conflict ? 'PROGRAMACIÓN CON CRUCE' : assignmentContext.producing ? 'CAMBIO DURANTE PRODUCCIÓN' : selection.id ? 'PROGRAMACIÓN' : 'SIN OPERADOR';
        $('#ppv75ConfirmJust').value = '';
        $('#ppv75ConfirmError').classList.add('d-none');
        confirmModal.show();
    }

    $('#ppv75ConfirmSave')?.addEventListener('click', () => {
        if (!assignmentContext || !pendingSelection) return;
        const reason = $('#ppv75ConfirmReason').value.trim();
        const just = $('#ppv75ConfirmJust').value.trim();
        const error = $('#ppv75ConfirmError');
        if (assignmentContext.producing && (!pendingSelection.id || reason.length < 3 || just.length < 5)) {
            error.textContent = !pendingSelection.id
                ? 'Una OF en producción no puede quedar sin operador.'
                : 'Motivo y justificación son obligatorios cuando la OF ya está produciendo.';
            error.classList.remove('d-none');
            return;
        }
        $('#ppv3Operator').value = pendingSelection.id || '';
        $('#ppv3Motivo').value = reason || (pendingSelection.conflict ? 'PROGRAMACIÓN CON CRUCE' : 'PROGRAMACIÓN');
        $('#ppv3Just').value = just;
        $('#ppv3AssignForm').requestSubmit();
    });

    async function openAssign(button) {
        const program = button.dataset.program, turno = button.dataset.turn, date = button.dataset.date;
        const producing = button.dataset.producing === '1', current = button.dataset.current || '';
        assignmentContext = { program, turnoId:turno, date, producing, current, currentName:button.dataset.name || 'Sin asignar', of:button.dataset.of, inicio:null, fin:null, turno:'' };
        $('#ppv3Program').value = program; $('#ppv3Turno').value = turno; $('#ppv3Fecha').value = date; $('#ppv3Operator').value = current;
        $('#ppv3DrawerTitle').textContent = `${button.dataset.of} · ${button.dataset.name || 'Sin asignar'}`;
        if (candidateSearch) candidateSearch.value = '';
        candidateList.innerHTML = '<div class="text-muted py-3"><i class="fa-solid fa-spinner fa-spin me-2"></i>Cargando candidatos...</div>';
        drawer.show();
        try {
            const url = `@Url.Action("CandidatosV7","ProduccionPersonal")?programaProduccionId=${encodeURIComponent(program)}&turnoId=${encodeURIComponent(turno)}&fechaTrabajo=${encodeURIComponent(date)}`;
            const response = await fetch(url), data = await response.json();
            if (!data.ok) throw new Error(data.mensaje || 'No fue posible consultar candidatos.');
            assignmentContext.turno = data.turno; assignmentContext.inicio = data.inicio; assignmentContext.fin = data.fin;
            $('#ppv3DrawerSummary').innerHTML = `<div><span>OF</span><strong>${data.of}</strong></div><div><span>Turno</span><strong>${data.turno}</strong></div><div><span>Horario en OF</span><strong>${fmtHour(data.inicio)} — ${fmtHour(data.fin)}</strong></div>`;
            candidateList.innerHTML = '';

            const clear = document.createElement('button');
            clear.type = 'button';
            clear.className = `ppv3-clear-assignment w-100 text-start mb-1 ${producing ? 'disabled' : ''}`;
            clear.innerHTML = producing
                ? '<strong>Dejar sin operador</strong><small class="d-block text-muted">No disponible mientras la OF está produciendo.</small>'
                : '<strong>Dejar sin operador</strong><small class="d-block text-muted">Marcar este horario como pendiente de cobertura.</small>';
            clear.disabled = producing;
            if (!producing) clear.addEventListener('click', () => prepareConfirmation({ id:null, name:'Sin asignar', conflict:false }));
            candidateList.appendChild(clear);

            data.candidatos.forEach(c => {
                const card = document.createElement('button'); card.type = 'button';
                const isCurrent = String(c.personaID) === String(current);
                card.className = `ppv3-candidate ${c.conflicto ? 'busy' : 'available'} ${isCurrent ? 'current' : ''}`;
                card.dataset.candidateSearch = [c.nombre||'',c.numeroControl||'',c.nivel?`N${c.nivel}`:'',c.enEscala?'en escala':'fuera de escala'].join(' ');
                card.innerHTML = `<div class="ppv3-candidate-main"><div class="ppv3-candidate-name"><span class="ppv3-level-badge ${levelClass(c.nivel)}">${c.nivel?'N'+c.nivel:'—'}</span><div><strong>${c.nombre || 'Persona sin nombre'}</strong><small>${c.numeroControl||''} · ${c.enEscala?'En escala':'Fuera de escala'}</small></div></div><div class="ppv3-candidate-load"><span>CARGA</span><strong>${Number(c.horasSemana||0).toFixed(1)} h</strong></div></div><div class="ppv3-availability-state ${c.conflicto?'busy':'ok'}"><i class="fa-solid ${c.conflicto?'fa-triangle-exclamation':'fa-circle-check'}"></i> ${c.conflicto?'Cruza con otra OF · permitido con advertencia':'Disponible durante todo el intervalo'}</div><div class="ppv7-candidate-action">${isCurrent?'Asignado actualmente':c.conflicto?'Asignar con aviso':'Asignar a este horario'}</div>`;
                card.addEventListener('click', () => prepareConfirmation({ id:c.personaID, name:c.nombre, conflict:!!c.conflicto }));
                candidateList.appendChild(card);
            });
            if (!data.candidatos.length) candidateList.innerHTML += '<div class="alert alert-warning mt-2">No hay candidatos con polivalencia válida para esta pieza.</div>';
            filterCandidateCards();
        } catch (e) { candidateList.innerHTML = `<div class="alert alert-danger">${e.message}</div>`; }
    }
    $$('[data-assign]').forEach(button => button.addEventListener('click', () => openAssign(button)));

    // ------------------------------------------------------------
    // Detalle del calendario de personal
    // ------------------------------------------------------------
    const jobModal = bootstrap.Modal.getOrCreateInstance($('#ppv75PersonJobModal'));
    $$('[data-person-job]').forEach(button => button.addEventListener('click', () => {
        const d = button.dataset;
        $('#ppv75JobTitle').textContent = `${d.of} · ${d.person}`;
        $('#ppv75JobPerson').innerHTML = `<strong>${d.person}</strong><span>${d.control || ''}</span>`;
        $('#ppv75JobOf').textContent = d.of || '—';
        $('#ppv75JobMachine').textContent = `${d.machine || '—'}${d.machineName ? ' · ' + d.machineName : ''}`;
        $('#ppv75JobPart').textContent = `${d.part || '—'}${d.partDesc ? ' · ' + d.partDesc : ''}`;
        $('#ppv75JobTurn').textContent = d.turn || '—';
        $('#ppv75JobSchedule').textContent = `${new Date(d.start).toLocaleString()} — ${new Date(d.end).toLocaleString()}`;
        $('#ppv75JobProgramSchedule').textContent = `${new Date(d.programStart).toLocaleString()} — ${new Date(d.programEnd).toLocaleString()}`;
        const alert = $('#ppv75JobAlert');
        alert.classList.toggle('d-none', d.conflict !== '1' && d.status !== 'AMARILLO');
        alert.textContent = d.conflict === '1' ? 'Este operador presenta cruce con otra OF en el mismo intervalo.' : d.status === 'AMARILLO' ? 'Esta OF se encuentra actualmente en producción.' : '';
        $('#ppv75OpenMachineCalendar').href = `/Produccion/Calendario?vista=dia&fecha=${encodeURIComponent(d.calendarDate)}`;
        jobModal.show();
    }));
    $$('[data-calendar-day]').forEach(button => button.addEventListener('click', () => {
        window.location.href = `/Produccion/Calendario?vista=dia&fecha=${encodeURIComponent(button.dataset.calendarDay)}`;
    }));

    // ------------------------------------------------------------
    // Cobertura semanal
    // ------------------------------------------------------------
    const supportModal = bootstrap.Modal.getOrCreateInstance($('#ppv3SupportModal'));
    const supportSelect = $('#ppv3SupportSelect'); let supportContext = null;
    function supportLabel(r) { return r === 'TECNICO' ? 'Técnico' : r === 'SMED' ? 'SMED' : 'Auxiliar'; }
    $$('[data-support-open]').forEach(button => button.addEventListener('click', () => {
        const turnoId = button.dataset.turnoId, roleName = button.dataset.role;
        const hidden = $(`.ppv3-support-hidden[data-turno-id="${turnoId}"][data-role="${roleName}"]`); if (!hidden) return;
        supportContext = { button, hidden, roleName }; $('#ppv3SupportTitle').textContent = `${supportLabel(roleName)} · turno ${turnoId}`;
        $('#ppv3SupportHelp').textContent = roleName === 'SMED' ? 'La lista incluye personal SMED y también Técnicos habilitados.' : 'La asignación aplica a la cobertura semanal de este turno.';
        supportSelect.innerHTML = hidden.innerHTML; supportSelect.value = hidden.value; supportModal.show();
    }));
    $('#ppv3SupportApply')?.addEventListener('click', () => {
        if (!supportContext) return; const { button, hidden, roleName } = supportContext; hidden.value = supportSelect.value;
        const selectedText = supportSelect.selectedOptions?.[0]?.textContent?.trim() || 'Sin asignar'; const value = Number(supportSelect.value || 0);
        $('span', button).textContent = value > 0 ? selectedText : 'Sin asignar'; const status = $('.ppv3-support-status', button);
        if (status) status.textContent = value > 0 ? (roleName === 'SMED' ? 'Asignado · SMED o Técnico · clic para modificar' : `Asignado como ${supportLabel(roleName)} · clic para modificar`) : (roleName === 'SMED' ? 'Sin SMED · SMED o Técnico · clic para modificar' : `Sin ${supportLabel(roleName).toLowerCase()} · clic para modificar`);
        button.classList.toggle('assigned', value > 0); button.classList.toggle('unassigned', value <= 0); supportModal.hide();
    });

    // ------------------------------------------------------------
    // Historial
    // ------------------------------------------------------------
    const historyModal = bootstrap.Modal.getOrCreateInstance($('#ppv3HistoryModal'));
    $$('[data-history]').forEach(button => button.addEventListener('click', async () => {
        $('#ppv3HistoryTitle').textContent = `Historial · ${button.dataset.of}`;
        $('#ppv3HistoryBody').innerHTML = '<div class="text-muted"><i class="fa-solid fa-spinner fa-spin"></i> Cargando...</div>';
        historyModal.show();
        try {
            const response = await fetch(`@Url.Action("HistorialV7","ProduccionPersonal")?programaProduccionId=${button.dataset.program}`), data = await response.json();
            if (!data.ok) throw new Error('No fue posible consultar el historial.');
            if (!data.historial.length) { $('#ppv3HistoryBody').innerHTML = '<div class="text-muted">Sin movimientos registrados.</div>'; return; }
            $('#ppv3HistoryBody').innerHTML = data.historial.map(x => `<div class="ppv7-history-item"><header><strong>${new Date(x.fechaMovimiento).toLocaleString()}</strong><span>${x.turno||''}</span></header><div>${x.anterior||'Sin asignar'} <i class="fa-solid fa-arrow-right mx-1"></i> <strong>${x.nuevo||'Sin asignar'}</strong></div><small>${x.motivo||''}${x.justificacion?' · '+x.justificacion:''}${x.produccionActiva?' · CAMBIO EN PRODUCCIÓN':''}</small></div>`).join('');
        } catch (e) { $('#ppv3HistoryBody').innerHTML = `<div class="alert alert-danger">${e.message}</div>`; }
    }));

    applyFilters();
})();
</script>
}
