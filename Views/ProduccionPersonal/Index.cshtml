@model ERP.NSQuell.Models.ProduccionPersonalSemanalIndexVm
@using System.Globalization
@using System.Text.Json

@{
    Layout = "~/Views/Shared/_Layout.cshtml";
    ViewData["Title"] = "Centro Operativo de Programación de Personal";

    var cultura = new CultureInfo("es-MX");
    var anterior = Model.SemanaInicio.AddDays(-7).ToString("yyyy-MM-dd");
    var siguiente = Model.SemanaInicio.AddDays(7).ToString("yyyy-MM-dd");
    var actual = DateTime.Today.ToString("yyyy-MM-dd");

    var maquinas = Model.Programas
        .GroupBy(x => new { x.MaquinaID, x.MaquinaCodigo, x.MaquinaNombre })
        .Select(x => x.Key)
        .OrderBy(x => x.MaquinaCodigo)
        .ThenBy(x => x.MaquinaNombre)
        .ToList();

    var personas = new Dictionary<int, string>();

    void AgregarPersona(int id, string? nombre)
    {
        if (id <= 0 || string.IsNullOrWhiteSpace(nombre)) return;
        personas[id] = nombre.Trim();
    }

    foreach (var p in Model.Tecnicos) AgregarPersona(p.PersonaID, p.Nombre);
    foreach (var p in Model.SmedYTecnicos) AgregarPersona(p.PersonaID, p.Nombre);
    foreach (var p in Model.Auxiliares) AgregarPersona(p.PersonaID, p.Nombre);

    foreach (var programa in Model.Programas)
    {
        if (programa.OperadorID.HasValue)
            AgregarPersona(programa.OperadorID.Value, programa.OperadorNombre);

        foreach (var candidato in programa.Candidatos)
            AgregarPersona(candidato.PersonaID, candidato.Nombre);
    }

    string NombrePersona(int? id, string vacio = "Sin asignar")
    {
        if (!id.HasValue) return vacio;
        return personas.TryGetValue(id.Value, out var nombre)
            ? nombre
            : $"Persona #{id.Value}";
    }

    var plannerData = Model.Programas.Select(p => new
    {
        programaID = p.ProgramaProduccionID,
        of = p.OF,
        parte = p.NumeroParte,
        descripcion = p.DescripcionParte,
        maquinaID = p.MaquinaID,
        maquina = p.MaquinaCodigo,
        maquinaNombre = p.MaquinaNombre,
        inicio = p.Inicio.ToString("O"),
        fin = p.Fin.ToString("O"),
        turnoID = Model.TurnoOperadorID(p.Inicio),
        turno = Model.TurnoOperadorNombre(p.Inicio),
        operadorID = p.OperadorID,
        operadorNombre = p.OperadorNombre,
        nivel = p.NivelOperador,
        tieneMatriz = p.TieneMatriz,
        excepcion = p.ExcepcionActiva,
        candidatos = p.Candidatos.Select(c => new
        {
            personaID = c.PersonaID,
            numeroControl = c.NumeroControl,
            nombre = c.Nombre,
            nivel = c.Nivel,
            enEscala = c.EnEscala,
            mismaMaquina = c.MismaMaquinaEscala,
            turnoEscala = c.TurnoEscala
        }).ToList()
    }).ToList();

    var turnosData = Model.TurnosApoyo.Select(t => new
    {
        turnoID = t.TurnoID,
        nombre = t.Nombre,
        tipo = t.TipoTurno,
        inicioMin = t.HoraInicio.HasValue ? (int?)Math.Round(t.HoraInicio.Value.TotalMinutes) : null,
        finMin = t.HoraFin.HasValue ? (int?)Math.Round(t.HoraFin.Value.TotalMinutes) : null,
        cruza = t.CruzaDiaSiguiente,
        tecnicoID = t.TecnicoProduccionID,
        smedID = t.SmedID,
        auxiliarID = t.AuxiliarID
    }).ToList();

    var personasData = personas
        .OrderBy(x => x.Value)
        .Select(x => new { personaID = x.Key, nombre = x.Value })
        .ToList();
}

@section Styles {
    <link rel="stylesheet"
          href="~/css/ProduccionPersonal/semanal.css"
          asp-append-version="true" />
}

<div class="ppv3-page" id="ppv3Root">
    <header class="ppv3-header">
        <div class="ppv3-title-block">
            <a href="@Url.Action("Grupo","Menu",new { id = 2 })" class="ppv3-back" title="Volver a Producción">
                <i class="fa-solid fa-arrow-left"></i>
            </a>
            <div>
                <div class="ppv3-eyebrow">PRODUCCIÓN · PERSONAL</div>
                <h1>Centro Operativo de Programación</h1>
            </div>
        </div>

        <div class="ppv3-week-block">
            <div class="ppv3-week-number">
                <span>SEMANA</span>
                <strong>@Model.NumeroSemana</strong>
            </div>
            <div class="ppv3-week-range">
                <strong>@Model.SemanaInicio.ToString("dd MMM", cultura) — @Model.SemanaFin.ToString("dd MMM yyyy", cultura)</strong>
                <span>
                    @if (Model.EscalaID.HasValue)
                    {
                        <i class="fa-solid fa-circle-check text-success"></i>
                        @Model.EscalaFolio
                        <text> · @Model.EscalaEstado</text>
                    }
                    else
                    {
                        <i class="fa-solid fa-triangle-exclamation text-warning"></i>
                        <text>Sin escala RRHH publicada</text>
                    }
                </span>
            </div>
        </div>

        <div class="ppv3-week-nav">
            <a class="btn btn-sm btn-outline-primary"
               href="@Url.Action("Index","ProduccionPersonal",new { fechaDesde = anterior })"
               title="Semana anterior">
                <i class="fa-solid fa-chevron-left"></i>
            </a>
            <a class="btn btn-sm btn-primary fw-bold"
               href="@Url.Action("Index","ProduccionPersonal",new { fechaDesde = actual })">
                Hoy
            </a>
            <a class="btn btn-sm btn-outline-primary"
               href="@Url.Action("Index","ProduccionPersonal",new { fechaDesde = siguiente })"
               title="Semana siguiente">
                <i class="fa-solid fa-chevron-right"></i>
            </a>
        </div>
    </header>

    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger mt-2 mb-0 fw-semibold">@TempData["Error"]</div>
    }
    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success mt-2 mb-0 fw-semibold">@TempData["Success"]</div>
    }
    @if (!Model.Configurado)
    {
        <div class="alert alert-warning mt-2 mb-0 fw-semibold">
            <i class="fa-solid fa-database me-1"></i>
            Falta completar la instalación SQL V2 de Programación de Personal.
        </div>
    }

    <section class="ppv3-filterbar">
        <div class="ppv3-search-wrap">
            <i class="fa-solid fa-magnifying-glass"></i>
            <input id="ppv3Search"
                   type="search"
                   class="form-control"
                   placeholder="Buscar OF, pieza, máquina o persona..." />
        </div>

        <select id="ppv3MachineFilter" class="form-select form-select-sm">
            <option value="">Todas las máquinas</option>
            @foreach (var m in maquinas)
            {
                <option value="@m.MaquinaID">@m.MaquinaCodigo · @m.MaquinaNombre</option>
            }
        </select>

        <select id="ppv3TurnFilter" class="form-select form-select-sm">
            <option value="">Todos los turnos</option>
            @foreach (var t in Model.TurnosOperador)
            {
                <option value="@t.TurnoID">@t.Nombre · @t.HorarioTexto</option>
            }
        </select>

        <select id="ppv3RoleFilter" class="form-select form-select-sm">
            <option value="">Todos los roles</option>
            <option value="OPERADOR">Operador</option>
            <option value="TECNICO">Técnico</option>
            <option value="SMED">SMED</option>
            <option value="AUXILIAR">Auxiliar</option>
        </select>

        <select id="ppv3PersonFilter" class="form-select form-select-sm">
            <option value="">Todas las personas</option>
            @foreach (var persona in personas.OrderBy(x => x.Value))
            {
                <option value="@persona.Key">@persona.Value</option>
            }
        </select>

        <button type="button" class="btn btn-sm btn-outline-secondary fw-bold" id="ppv3ClearFilters">
            <i class="fa-solid fa-eraser"></i> Limpiar
        </button>
    </section>

    <section class="ppv3-kpis" aria-label="Indicadores de cobertura">
        <button type="button" class="ppv3-kpi" data-kpi="all">
            <span>OF / PROGRAMAS</span>
            <strong id="kpiTotal">@Model.TotalProgramas</strong>
        </button>
        <button type="button" class="ppv3-kpi warning" data-kpi="operator">
            <span>SIN OPERADOR</span>
            <strong id="kpiSinOperador">@Model.TotalSinOperador</strong>
        </button>
        <button type="button" class="ppv3-kpi warning" data-kpi="technician">
            <span>SIN TÉCNICO</span>
            <strong id="kpiSinTecnico">@Model.TotalSinTecnico</strong>
        </button>
        <button type="button" class="ppv3-kpi danger" data-kpi="conflict">
            <span>CONFLICTOS</span>
            <strong id="kpiConflictos">@Model.TotalConflictos</strong>
        </button>
        <button type="button" class="ppv3-kpi success" data-kpi="complete">
            <span>COBERTURA COMPLETA</span>
            <strong id="kpiCompletas">@Model.TotalCoberturaCompleta</strong>
        </button>
    </section>

    <nav class="ppv3-tabs" aria-label="Vistas de programación">
        <button type="button" class="ppv3-tab active" data-view="planner">
            <i class="fa-solid fa-table-cells-large"></i>
            Programación
        </button>
        <button type="button" class="ppv3-tab" data-view="support">
            <i class="fa-solid fa-people-group"></i>
            Cobertura de turno
        </button>
        <button type="button" class="ppv3-tab" data-view="people">
            <i class="fa-solid fa-user-clock"></i>
            Vista por persona
        </button>
        <button type="button" class="ppv3-tab" data-view="pending">
            <i class="fa-solid fa-triangle-exclamation"></i>
            Pendientes
            <span class="ppv3-tab-count" id="pendingTabCount">0</span>
        </button>
    </nav>

    <form method="post"
          action="@Url.Action("GuardarSemana","ProduccionPersonal")"
          id="ppv3Form">
        @Html.AntiForgeryToken()
        <input type="hidden" name="SemanaInicio" value="@Model.SemanaInicio.ToString("yyyy-MM-dd")" />

        <section class="ppv3-view active" data-view-panel="planner">
            <div class="ppv3-view-head">
                <div>
                    <h2>Planner de OF / pieza</h2>
                    <p>Haz clic en la celda del operador para consultar disponibilidad, carga y polivalencia antes de asignar.</p>
                </div>
                <a class="btn btn-sm btn-outline-primary fw-bold"
                   href="@Url.Action("Index","ProduccionPersonal",new { fechaDesde = Model.SemanaInicio.ToString("yyyy-MM-dd"), sugerir = 1 })">
                    <i class="fa-solid fa-wand-magic-sparkles"></i>
                    Sugerir operadores
                </a>
            </div>

            @if (Model.SugerenciasAplicadas)
            {
                <div class="ppv3-inline-info">
                    <i class="fa-solid fa-wand-magic-sparkles"></i>
                    Se sugirieron únicamente OF sin operador. Revisa carga y disponibilidad antes de guardar.
                </div>
            }

            <div class="table-responsive ppv3-table-wrap">
                <table class="ppv3-planner" id="ppv3PlannerTable">
                    <thead>
                        <tr>
                            <th>Fecha / hora</th>
                            <th>OF</th>
                            <th>Pieza</th>
                            <th>Máquina</th>
                            <th>Turno</th>
                            <th class="ppv3-operator-head">Operador planeado</th>
                            <th>Carga</th>
                            <th>Cobertura</th>
                        </tr>
                    </thead>
                    <tbody>
                    @for (var i = 0; i < Model.Programas.Count; i++)
                    {
                        var p = Model.Programas[i];
                        var turno = Model.TurnoOperadorPara(p.Inicio);
                        var actualEnLista = p.OperadorID.HasValue &&
                            p.Candidatos.Any(x => x.PersonaID == p.OperadorID.Value);
                        var tecnica = Model.TieneCoberturaRol(p, "TECNICO");
                        var smed = Model.TieneCoberturaRol(p, "SMED");
                        var auxiliar = Model.TieneCoberturaRol(p, "AUXILIAR");
                        var completa = Model.TieneCoberturaCompleta(p);
                        var search = $"{p.OF} {p.NumeroParte} {p.DescripcionParte} {p.MaquinaCodigo} {p.MaquinaNombre} {p.OperadorNombre}".ToLowerInvariant();

                        <tr class="ppv3-program-row"
                            data-program-id="@p.ProgramaProduccionID"
                            data-machine-id="@p.MaquinaID"
                            data-turn-id="@(turno?.TurnoID ?? 0)"
                            data-person-id="@(p.OperadorID ?? 0)"
                            data-search="@search"
                            data-tech="@(tecnica ? "1" : "0")"
                            data-smed="@(smed ? "1" : "0")"
                            data-aux="@(auxiliar ? "1" : "0")"
                            data-complete="@(completa ? "1" : "0")">
                            <td class="ppv3-time-cell">
                                <strong>@p.Inicio.ToString("ddd dd/MM", cultura)</strong>
                                <span>@p.Inicio.ToString("HH:mm") — @p.Fin.ToString("HH:mm")</span>
                            </td>
                            <td>
                                <strong class="ppv3-of">@p.OF</strong>
                                @if (p.ExcepcionActiva)
                                {
                                    <span class="ppv3-mini-badge exception">Excepción</span>
                                }
                            </td>
                            <td class="ppv3-part-cell">
                                <strong>@(string.IsNullOrWhiteSpace(p.NumeroParte) ? "Sin parte" : p.NumeroParte)</strong>
                                <span>@p.DescripcionParte</span>
                            </td>
                            <td class="ppv3-machine-cell">
                                <strong>@p.MaquinaCodigo</strong>
                                <span>@p.MaquinaNombre</span>
                            </td>
                            <td>
                                <span class="ppv3-turn-chip">@(turno?.Nombre ?? "Sin turno")</span>
                            </td>
                            <td class="ppv3-operator-cell">
                                <input type="hidden"
                                       name="Operadores[@i].ProgramaProduccionID"
                                       value="@p.ProgramaProduccionID" />

                                <select name="Operadores[@i].OperadorID"
                                        class="d-none ppv3-operator-hidden"
                                        data-program-id="@p.ProgramaProduccionID"
                                        disabled="@(!Model.Configurado || p.ExcepcionActiva ? "disabled" : null)">
                                    <option value="">-- Sin operador --</option>
                                    @if (p.OperadorID.HasValue && !actualEnLista)
                                    {
                                        <option value="@p.OperadorID" selected>@p.OperadorNombre</option>
                                    }
                                    @foreach (var c in p.Candidatos)
                                    {
                                        if (p.OperadorID == c.PersonaID)
                                        {
                                            <option value="@c.PersonaID" selected>@c.Nombre</option>
                                        }
                                        else
                                        {
                                            <option value="@c.PersonaID">@c.Nombre</option>
                                        }
                                    }
                                </select>

                                <button type="button"
                                        class="ppv3-assign-cell @(p.OperadorID.HasValue ? "assigned" : "pending")"
                                        data-open-operator="@p.ProgramaProduccionID"
                                        disabled="@(p.ExcepcionActiva ? "disabled" : null)">
                                    <span class="ppv3-assign-name">
                                        @(p.OperadorID.HasValue ? p.OperadorNombre : "Asignar operador")
                                    </span>
                                    <small class="ppv3-assign-meta">
                                        @if (p.ExcepcionActiva)
                                        {
                                            <text>Cambio controlado desde Calendario</text>
                                        }
                                        else if (p.NivelOperador.HasValue)
                                        {
                                            <text>N@p.NivelOperador · @(p.OperadorEnEscala ? "en escala" : "fuera de escala")</text>
                                        }
                                        else if (!p.TieneMatriz)
                                        {
                                            <text>La pieza no tiene matriz</text>
                                        }
                                        else
                                        {
                                            <text>Consultar personal disponible</text>
                                        }
                                    </small>
                                </button>
                            </td>
                            <td>
                                <span class="ppv3-load" data-load-for="@p.ProgramaProduccionID">—</span>
                            </td>
                            <td>
                                <div class="ppv3-coverage-stack" data-coverage-for="@p.ProgramaProduccionID">
                                    <span class="ppv3-cov @(p.OperadorID.HasValue ? "ok" : "miss")" data-role-status="OPERADOR">OP</span>
                                    <span class="ppv3-cov @(tecnica ? "ok" : "miss")" data-role-status="TECNICO">T</span>
                                    <span class="ppv3-cov @(smed ? "ok" : "miss")" data-role-status="SMED">S</span>
                                    <span class="ppv3-cov @(auxiliar ? "ok" : "miss")" data-role-status="AUXILIAR">A</span>
                                </div>
                            </td>
                        </tr>
                    }
                    </tbody>
                </table>
            </div>
        </section>

        <section class="ppv3-view" data-view-panel="support">
            <div class="ppv3-view-head">
                <div>
                    <h2>Cobertura global por turno</h2>
                    <p>Técnico, SMED y Auxiliar cubren el turno completo. Los turnos 12x12 se mantienen disponibles para estos cargos.</p>
                </div>
                <div class="ppv3-rule-note">
                    <i class="fa-solid fa-circle-info"></i>
                    SMED acepta personal SMED <strong>o Técnico</strong>.
                </div>
            </div>

            <div class="table-responsive ppv3-table-wrap">
                <table class="ppv3-support-table" id="ppv3SupportTable">
                    <thead>
                        <tr>
                            <th>Turno</th>
                            <th>Tipo</th>
                            <th data-role-col="TECNICO">Técnico</th>
                            <th data-role-col="SMED">SMED</th>
                            <th data-role-col="AUXILIAR">Auxiliar</th>
                        </tr>
                    </thead>
                    <tbody>
                    @for (var i = 0; i < Model.TurnosApoyo.Count; i++)
                    {
                        var t = Model.TurnosApoyo[i];
                        <tr class="ppv3-support-row"
                            data-turn-id="@t.TurnoID"
                            data-tech-id="@(t.TecnicoProduccionID ?? 0)"
                            data-smed-id="@(t.SmedID ?? 0)"
                            data-aux-id="@(t.AuxiliarID ?? 0)">
                            <td class="ppv3-support-turn">
                                <span class="ppv3-turn-dot" style="--turn-color:@t.Color"></span>
                                <div>
                                    <strong>@t.Nombre</strong>
                                    <span>@t.HorarioTexto</span>
                                </div>
                            </td>
                            <td>
                                <span class="ppv3-type-chip @(ERP.NSQuell.Models.ProduccionPersonalSemanalIndexVm.EsTurno12x12(t) ? "x12" : "regular")">
                                    @t.TipoTurno
                                </span>
                            </td>
                            <td data-role-cell="TECNICO">
                                <input type="hidden" name="Coberturas[@i].TurnoID" value="@t.TurnoID" />
                                <select name="Coberturas[@i].TecnicoProduccionID"
                                        class="d-none ppv3-support-hidden"
                                        data-turno-id="@t.TurnoID"
                                        data-role="TECNICO"
                                        disabled="@(!Model.Configurado ? "disabled" : null)">
                                    <option value="">-- Sin cobertura --</option>
                                    @foreach (var p in Model.Tecnicos)
                                    {
                                        if (t.TecnicoProduccionID == p.PersonaID)
                                        {
                                            <option value="@p.PersonaID" selected>@p.Nombre</option>
                                        }
                                        else
                                        {
                                            <option value="@p.PersonaID">@p.Nombre</option>
                                        }
                                    }
                                </select>
                                <button type="button" class="ppv3-support-cell"
                                        data-support-open data-turno-id="@t.TurnoID" data-role="TECNICO">
                                    <span>@NombrePersona(t.TecnicoProduccionID)</span>
                                    <small class="ppv3-support-status">Sincronizado con programación · clic para modificar</small>
                                </button>
                            </td>
                            <td data-role-cell="SMED">
                                <select name="Coberturas[@i].SmedID"
                                        class="d-none ppv3-support-hidden"
                                        data-turno-id="@t.TurnoID"
                                        data-role="SMED"
                                        disabled="@(!Model.Configurado ? "disabled" : null)">
                                    <option value="">-- Sin cobertura --</option>
                                    @foreach (var p in Model.SmedYTecnicos)
                                    {
                                        var etiqueta = string.IsNullOrWhiteSpace(p.Puesto)
                                            ? p.Nombre
                                            : $"{p.Nombre} · {p.Puesto}";
                                        if (t.SmedID == p.PersonaID)
                                        {
                                            <option value="@p.PersonaID" selected>@etiqueta</option>
                                        }
                                        else
                                        {
                                            <option value="@p.PersonaID">@etiqueta</option>
                                        }
                                    }
                                </select>
                                <button type="button" class="ppv3-support-cell"
                                        data-support-open data-turno-id="@t.TurnoID" data-role="SMED">
                                    <span>@NombrePersona(t.SmedID)</span>
                                    <small class="ppv3-support-status">SMED o Técnico · clic para modificar</small>
                                </button>
                            </td>
                            <td data-role-cell="AUXILIAR">
                                <select name="Coberturas[@i].AuxiliarID"
                                        class="d-none ppv3-support-hidden"
                                        data-turno-id="@t.TurnoID"
                                        data-role="AUXILIAR"
                                        disabled="@(!Model.Configurado ? "disabled" : null)">
                                    <option value="">-- Sin cobertura --</option>
                                    @foreach (var p in Model.Auxiliares)
                                    {
                                        if (t.AuxiliarID == p.PersonaID)
                                        {
                                            <option value="@p.PersonaID" selected>@p.Nombre</option>
                                        }
                                        else
                                        {
                                            <option value="@p.PersonaID">@p.Nombre</option>
                                        }
                                    }
                                </select>
                                <button type="button" class="ppv3-support-cell"
                                        data-support-open data-turno-id="@t.TurnoID" data-role="AUXILIAR">
                                    <span>@NombrePersona(t.AuxiliarID)</span>
                                    <small class="ppv3-support-status">Sincronizado con programación · clic para modificar</small>
                                </button>
                            </td>
                        </tr>
                    }
                    </tbody>
                </table>
            </div>
        </section>

        <section class="ppv3-view" data-view-panel="people">
            <div class="ppv3-view-head">
                <div>
                    <h2>Vista por persona</h2>
                    <p>Consulta en una sola línea toda la semana de cada persona, su carga y posibles empalmes.</p>
                </div>
            </div>
            <div id="ppv3PeopleView" class="ppv3-people-view"></div>
        </section>

        <section class="ppv3-view" data-view-panel="pending">
            <div class="ppv3-view-head">
                <div>
                    <h2>Pendientes de cobertura</h2>
                    <p>OF que requieren atención por Operador, Técnico, SMED, Auxiliar o conflicto de personal.</p>
                </div>
            </div>
            <div class="table-responsive ppv3-table-wrap">
                <table class="ppv3-pending-table">
                    <thead>
                        <tr>
                            <th>Prioridad</th>
                            <th>Inicio</th>
                            <th>OF</th>
                            <th>Máquina</th>
                            <th>Pieza</th>
                            <th>Falta / conflicto</th>
                            <th></th>
                        </tr>
                    </thead>
                    <tbody id="ppv3PendingBody"></tbody>
                </table>
            </div>
        </section>

        <div class="ppv3-savebar">
            <div>
                <strong>Semana @Model.NumeroSemana · @Model.SemanaInicio.ToString("dd/MM") — @Model.SemanaFin.ToString("dd/MM/yyyy")</strong>
                <span>Las excepciones registradas desde Calendario no se sobrescriben.</span>
            </div>
            <button type="submit"
                    class="btn btn-success fw-bold"
                    disabled="@(!Model.Configurado ? "disabled" : null)">
                <i class="fa-solid fa-floppy-disk me-1"></i>
                Guardar programación
            </button>
        </div>
    </form>
</div>

<div class="offcanvas offcanvas-end ppv3-availability"
     tabindex="-1"
     id="ppv3Availability"
     aria-labelledby="ppv3AvailabilityTitle">
    <div class="offcanvas-header">
        <div>
            <div class="ppv3-eyebrow">PERSONAL DISPONIBLE</div>
            <h5 class="offcanvas-title" id="ppv3AvailabilityTitle">Selecciona una OF</h5>
            <small id="ppv3AvailabilityContext" class="text-muted"></small>
        </div>
        <button type="button" class="btn-close" data-bs-dismiss="offcanvas"></button>
    </div>
    <div class="offcanvas-body">
        <div class="ppv3-drawer-summary" id="ppv3DrawerSummary"></div>

        <div class="ppv3-candidate-search-wrap">
            <i class="fa-solid fa-magnifying-glass"></i>
            <input type="search"
                   id="ppv3CandidateSearch"
                   class="form-control"
                   autocomplete="off"
                   placeholder="Buscar operador por nombre o No. control..." />
            <button type="button"
                    id="ppv3CandidateSearchClear"
                    class="ppv3-candidate-search-clear"
                    title="Limpiar busqueda"
                    aria-label="Limpiar busqueda">
                <i class="fa-solid fa-xmark"></i>
            </button>
        </div>

        <div class="ppv3-candidate-search-meta">
            <span id="ppv3CandidateSearchCount"></span>
            <span>Filtra sin perder nivel, escala, carga ni disponibilidad.</span>
        </div>

        <div id="ppv3CandidateNoResults"
             class="ppv3-candidate-no-results d-none">
            <i class="fa-solid fa-user-slash"></i>
            No hay operadores que coincidan con la busqueda.
        </div>

        <div class="ppv3-candidate-list" id="ppv3CandidateList"></div>
    </div>
</div>

<div class="modal fade" id="ppv3SupportModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content border-0 rounded-4 shadow">
            <div class="modal-header">
                <div>
                    <div class="ppv3-eyebrow">COBERTURA DE TURNO</div>
                    <h5 class="modal-title" id="ppv3SupportTitle">Asignar responsable</h5>
                </div>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body">
                <input type="hidden" id="ppv3SupportTurnID" />
                <input type="hidden" id="ppv3SupportRole" />
                <label class="form-label fw-bold">Responsable</label>
                <select id="ppv3SupportSelect" class="form-select"></select>
                <div class="form-text mt-2" id="ppv3SupportHelp"></div>
            </div>
            <div class="modal-footer border-0">
                <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Cancelar</button>
                <button type="button" class="btn btn-primary fw-bold" id="ppv3SupportApply">
                    <i class="fa-solid fa-check me-1"></i> Aplicar
                </button>
            </div>
        </div>
    </div>
</div>

@section Scripts {
<script>
document.addEventListener('DOMContentLoaded', function () {
    const programs = @Html.Raw(JsonSerializer.Serialize(plannerData));
    const turnos = @Html.Raw(JsonSerializer.Serialize(turnosData));
    const peopleSeed = @Html.Raw(JsonSerializer.Serialize(personasData));
    const weekStart = new Date('@Model.SemanaInicio.ToString("yyyy-MM-dd")T00:00:00');

    const people = new Map((peopleSeed || []).map(x => [Number(x.personaID), x.nombre]));
    const programMap = new Map((programs || []).map(x => [Number(x.programaID), x]));

    const plannerRows = Array.from(document.querySelectorAll('.ppv3-program-row'));
    const search = document.getElementById('ppv3Search');
    const machineFilter = document.getElementById('ppv3MachineFilter');
    const turnFilter = document.getElementById('ppv3TurnFilter');
    const roleFilter = document.getElementById('ppv3RoleFilter');
    const personFilter = document.getElementById('ppv3PersonFilter');
    const supportModalEl = document.getElementById('ppv3SupportModal');
    const supportModal = supportModalEl ? bootstrap.Modal.getOrCreateInstance(supportModalEl) : null;
    const availabilityEl = document.getElementById('ppv3Availability');
    const availability = availabilityEl ? bootstrap.Offcanvas.getOrCreateInstance(availabilityEl) : null;
    const candidateSearch = document.getElementById('ppv3CandidateSearch');
    const candidateSearchClear = document.getElementById('ppv3CandidateSearchClear');
    const candidateSearchCount = document.getElementById('ppv3CandidateSearchCount');
    const candidateNoResults = document.getElementById('ppv3CandidateNoResults');

    function normalize(value) {
        return (value || '')
            .toString()
            .toLowerCase()
            .normalize('NFD')
            .replace(/[\u0300-\u036f]/g, '')
            .trim();
    }

    function toDate(value) {
        return new Date(value);
    }

    function localDateKey(value) {
        const d = value instanceof Date ? value : toDate(value);
        const y = d.getFullYear();
        const m = String(d.getMonth() + 1).padStart(2, '0');
        const day = String(d.getDate()).padStart(2, '0');
        return `${y}-${m}-${day}`;
    }

    function durationHours(program) {
        return Math.max(0, (toDate(program.fin) - toDate(program.inicio)) / 3600000);
    }

    function overlaps(a, b) {
        return toDate(a.inicio) < toDate(b.fin) && toDate(a.fin) > toDate(b.inicio);
    }

    function assignedPrograms(personID, excludeProgramID) {
        const id = Number(personID || 0);
        if (!id) return [];
        return programs.filter(p =>
            Number(p.operadorID || 0) === id &&
            Number(p.programaID) !== Number(excludeProgramID || 0));
    }

    function loadHours(personID, excludeProgramID) {
        return assignedPrograms(personID, excludeProgramID)
            .reduce((sum, p) => sum + durationHours(p), 0);
    }

    function conflictsFor(program, personID) {
        return assignedPrograms(personID, program.programaID)
            .filter(other => overlaps(program, other));
    }

    function minuteOfDay(dateValue) {
        const d = toDate(dateValue);
        return d.getHours() * 60 + d.getMinutes();
    }

    function turnCovers(turn, dateValue) {
        if (turn.inicioMin == null || turn.finMin == null) return false;
        const minute = minuteOfDay(dateValue);
        const start = Number(turn.inicioMin);
        const end = Number(turn.finMin);
        return turn.cruza || end <= start
            ? minute >= start || minute < end
            : minute >= start && minute < end;
    }

    function supportRoleID(turn, role) {
        if (role === 'TECNICO') return Number(turn.tecnicoID || 0);
        if (role === 'SMED') return Number(turn.smedID || 0);
        if (role === 'AUXILIAR') return Number(turn.auxiliarID || 0);
        return 0;
    }

    function hasSupport(program, role) {
        return turnos.some(t => turnCovers(t, program.inicio) && supportRoleID(t, role) > 0);
    }

    function programConflict(program) {
        const personID = Number(program.operadorID || 0);
        return personID > 0 && conflictsFor(program, personID).length > 0;
    }

    function programComplete(program) {
        const operatorOk = Number(program.operadorID || 0) > 0 &&
            !programConflict(program) &&
            (!program.tieneMatriz || Number(program.nivel || 0) > 0);
        return operatorOk &&
            hasSupport(program, 'TECNICO') &&
            hasSupport(program, 'SMED') &&
            hasSupport(program, 'AUXILIAR');
    }

    function getMissing(program) {
        const missing = [];
        if (!Number(program.operadorID || 0)) missing.push('Operador');
        else if (program.tieneMatriz && !Number(program.nivel || 0)) missing.push('Operador no apto');
        if (!hasSupport(program, 'TECNICO')) missing.push('Técnico');
        if (!hasSupport(program, 'SMED')) missing.push('SMED');
        if (!hasSupport(program, 'AUXILIAR')) missing.push('Auxiliar');
        if (programConflict(program)) missing.push('Conflicto de operador');
        return missing;
    }

    function programPriority(program) {
        const hours = (toDate(program.inicio) - new Date()) / 3600000;
        if (hours <= 24) return { text: 'ALTA', cls: 'high' };
        if (hours <= 72) return { text: 'MEDIA', cls: 'medium' };
        return { text: 'NORMAL', cls: 'normal' };
    }

    function updateProgramUI(program) {
        const row = document.querySelector(`.ppv3-program-row[data-program-id="${program.programaID}"]`);
        if (!row) return;

        row.dataset.personId = String(program.operadorID || 0);
        row.dataset.tech = hasSupport(program, 'TECNICO') ? '1' : '0';
        row.dataset.smed = hasSupport(program, 'SMED') ? '1' : '0';
        row.dataset.aux = hasSupport(program, 'AUXILIAR') ? '1' : '0';
        row.dataset.complete = programComplete(program) ? '1' : '0';
        row.dataset.conflict = programConflict(program) ? '1' : '0';

        const button = row.querySelector('[data-open-operator]');
        const name = button?.querySelector('.ppv3-assign-name');
        const meta = button?.querySelector('.ppv3-assign-meta');
        const candidate = (program.candidatos || []).find(x => Number(x.personaID) === Number(program.operadorID));

        if (button && !program.excepcion) {
            button.classList.toggle('assigned', !!program.operadorID);
            button.classList.toggle('pending', !program.operadorID);
        }

        if (name) {
            name.textContent = program.operadorID
                ? (candidate?.nombre || program.operadorNombre || people.get(Number(program.operadorID)) || `Persona #${program.operadorID}`)
                : 'Asignar operador';
        }

        if (meta && !program.excepcion) {
            if (program.operadorID && candidate) {
                meta.textContent = `${candidate.nivel ? `N${candidate.nivel} · ` : ''}${candidate.enEscala ? 'en escala' : 'fuera de escala'}`;
            } else if (!program.tieneMatriz) {
                meta.textContent = 'La pieza no tiene matriz';
            } else {
                meta.textContent = 'Consultar personal disponible';
            }
        }

        const load = row.querySelector(`[data-load-for="${program.programaID}"]`);
        if (load) {
            load.textContent = program.operadorID
                ? `${loadHours(program.operadorID).toFixed(1)} h/sem`
                : '—';
        }

        const coverage = row.querySelector(`[data-coverage-for="${program.programaID}"]`);
        if (coverage) {
            const states = {
                OPERADOR: !!program.operadorID && !programConflict(program),
                TECNICO: hasSupport(program, 'TECNICO'),
                SMED: hasSupport(program, 'SMED'),
                AUXILIAR: hasSupport(program, 'AUXILIAR')
            };
            coverage.querySelectorAll('[data-role-status]').forEach(el => {
                const ok = !!states[el.dataset.roleStatus];
                el.classList.toggle('ok', ok);
                el.classList.toggle('miss', !ok);
            });
        }

        row.classList.toggle('has-conflict', programConflict(program));
        row.classList.toggle('is-complete', programComplete(program));
    }

    function refreshKPIs() {
        const total = programs.length;
        const sinOperador = programs.filter(p => !Number(p.operadorID || 0)).length;
        const sinTecnico = programs.filter(p => !hasSupport(p, 'TECNICO')).length;
        const conflicts = programs.filter(programConflict).length + supportConflicts().length;
        const completas = programs.filter(programComplete).length;

        document.getElementById('kpiTotal').textContent = total;
        document.getElementById('kpiSinOperador').textContent = sinOperador;
        document.getElementById('kpiSinTecnico').textContent = sinTecnico;
        document.getElementById('kpiConflictos').textContent = conflicts;
        document.getElementById('kpiCompletas').textContent = completas;
    }

    function supportConflicts() {
        const assignments = [];
        turnos.forEach(t => {
            ['TECNICO', 'SMED', 'AUXILIAR'].forEach(role => {
                const id = supportRoleID(t, role);
                if (id) assignments.push({ personID: id, role, turn: t });
            });
        });

        const conflicts = [];
        for (let i = 0; i < assignments.length; i++) {
            for (let j = i + 1; j < assignments.length; j++) {
                const a = assignments[i];
                const b = assignments[j];
                if (a.personID !== b.personID) continue;
                if (turnsOverlap(a.turn, b.turn)) {
                    conflicts.push({ a, b });
                }
            }
        }
        return conflicts;
    }

    function turnsOverlap(a, b) {
        if (a.inicioMin == null || a.finMin == null || b.inicioMin == null || b.finMin == null)
            return false;

        function segments(t) {
            const start = Number(t.inicioMin);
            const end = Number(t.finMin);
            if (t.cruza || end <= start) return [[start, 1440], [0, end]];
            return [[start, end]];
        }

        return segments(a).some(sa =>
            segments(b).some(sb => sa[0] < sb[1] && sa[1] > sb[0]));
    }

    function applyFilters() {
        const q = normalize(search?.value);
        const machine = machineFilter?.value || '';
        const turn = turnFilter?.value || '';
        const person = personFilter?.value || '';

        plannerRows.forEach(row => {
            const matchesText = !q || normalize(row.dataset.search).includes(q);
            const matchesMachine = !machine || row.dataset.machineId === machine;
            const matchesTurn = !turn || row.dataset.turnId === turn;
            const matchesPerson = !person || row.dataset.personId === person;
            row.classList.toggle('d-none', !(matchesText && matchesMachine && matchesTurn && matchesPerson));
        });

        document.querySelectorAll('.ppv3-support-row').forEach(row => {
            const matchesTurn = !turn || row.dataset.turnId === turn;
            const matchesPerson = !person ||
                row.dataset.techId === person ||
                row.dataset.smedId === person ||
                row.dataset.auxId === person;
            row.classList.toggle('d-none', !(matchesTurn && matchesPerson));
        });

        document.getElementById('ppv3Root')?.setAttribute('data-role-filter', roleFilter?.value || '');
    }

    function activateView(view) {
        document.querySelectorAll('.ppv3-tab').forEach(btn =>
            btn.classList.toggle('active', btn.dataset.view === view));
        document.querySelectorAll('.ppv3-view').forEach(panel =>
            panel.classList.toggle('active', panel.dataset.viewPanel === view));

        if (view === 'people') renderPeopleView();
        if (view === 'pending') renderPending();
    }

    function renderPending(mode) {
        const body = document.getElementById('ppv3PendingBody');
        if (!body) return;

        let pending = programs
            .map(p => ({ program: p, missing: getMissing(p) }))
            .filter(x => x.missing.length > 0);

        if (mode === 'operator') pending = pending.filter(x => x.missing.includes('Operador'));
        if (mode === 'technician') pending = pending.filter(x => x.missing.includes('Técnico'));
        if (mode === 'conflict') pending = pending.filter(x => x.missing.some(m => m.includes('Conflicto')));

        body.innerHTML = '';

        if (!pending.length) {
            body.innerHTML = '<tr><td colspan="7"><div class="ppv3-empty-state">Sin pendientes para este filtro.</div></td></tr>';
        } else {
            pending
                .sort((a, b) => toDate(a.program.inicio) - toDate(b.program.inicio))
                .forEach(item => {
                    const p = item.program;
                    const priority = programPriority(p);
                    const tr = document.createElement('tr');
                    tr.innerHTML = `
                        <td><span class="ppv3-priority ${priority.cls}">${priority.text}</span></td>
                        <td><strong>${toDate(p.inicio).toLocaleDateString('es-MX',{weekday:'short',day:'2-digit',month:'2-digit'})}</strong><br><small>${toDate(p.inicio).toLocaleTimeString('es-MX',{hour:'2-digit',minute:'2-digit'})}</small></td>
                        <td><strong>${escapeHtml(p.of || '')}</strong></td>
                        <td>${escapeHtml(p.maquina || '')}</td>
                        <td>${escapeHtml(p.parte || '')}</td>
                        <td>${item.missing.map(x => `<span class="ppv3-missing-chip">${escapeHtml(x)}</span>`).join(' ')}</td>
                        <td><button type="button" class="btn btn-sm btn-outline-primary fw-bold" data-pending-action="${p.programaID}">Resolver</button></td>`;
                    body.appendChild(tr);
                });
        }

        document.getElementById('pendingTabCount').textContent = String(
            programs.filter(p => getMissing(p).length > 0).length
        );

        body.querySelectorAll('[data-pending-action]').forEach(btn => {
            btn.addEventListener('click', () => {
                const p = programMap.get(Number(btn.dataset.pendingAction));
                if (!p) return;
                if (!Number(p.operadorID || 0)) {
                    openAvailability(p.programaID);
                } else {
                    activateView('support');
                }
            });
        });
    }

    function escapeHtml(value) {
        return (value || '').toString()
            .replaceAll('&','&amp;')
            .replaceAll('<','&lt;')
            .replaceAll('>','&gt;')
            .replaceAll('"','&quot;')
            .replaceAll("'",'&#039;');
    }

    function filterCandidateCards() {
        const list = document.getElementById('ppv3CandidateList');
        if (!list) return;

        const query = normalize(candidateSearch?.value);
        const cards = Array.from(list.querySelectorAll('.ppv3-candidate'));
        let visible = 0;

        cards.forEach(card => {
            const haystack = normalize(card.dataset.candidateSearch || card.textContent || '');
            const show = !query || haystack.includes(query);
            card.classList.toggle('d-none', !show);
            if (show) visible++;
        });

        if (candidateSearchCount) {
            candidateSearchCount.textContent = cards.length
                ? `${visible} de ${cards.length} operador(es)`
                : '0 operadores';
        }

        if (candidateNoResults) {
            candidateNoResults.classList.toggle(
                'd-none',
                !(cards.length > 0 && visible === 0)
            );
        }
    }

    candidateSearch?.addEventListener('input', filterCandidateCards);

    candidateSearchClear?.addEventListener('click', function () {
        if (!candidateSearch) return;
        candidateSearch.value = '';
        filterCandidateCards();
        candidateSearch.focus();
    });

    availabilityEl?.addEventListener('shown.bs.offcanvas', function () {
        candidateSearch?.focus();
    });

    function openAvailability(programID) {
        const program = programMap.get(Number(programID));
        if (!program || !availability) return;

        const title = document.getElementById('ppv3AvailabilityTitle');
        const context = document.getElementById('ppv3AvailabilityContext');
        const summary = document.getElementById('ppv3DrawerSummary');
        const list = document.getElementById('ppv3CandidateList');

        if (candidateSearch) candidateSearch.value = '';
        if (candidateNoResults) candidateNoResults.classList.add('d-none');

        title.textContent = `OF ${program.of || program.programaID}`;
        context.textContent = `${program.parte || 'Sin parte'} · ${program.maquina || 'Sin máquina'} · ${program.turno || 'Sin turno'}`;

        summary.innerHTML = `
            <div><span>Inicio</span><strong>${toDate(program.inicio).toLocaleString('es-MX',{weekday:'short',day:'2-digit',month:'2-digit',hour:'2-digit',minute:'2-digit'})}</strong></div>
            <div><span>Fin</span><strong>${toDate(program.fin).toLocaleString('es-MX',{weekday:'short',day:'2-digit',month:'2-digit',hour:'2-digit',minute:'2-digit'})}</strong></div>
            <div><span>Actual</span><strong>${escapeHtml(program.operadorNombre || 'Sin operador')}</strong></div>`;

        const candidates = (program.candidatos || []).map(c => {
            const conflicts = conflictsFor(program, c.personaID);
            return {
                ...c,
                conflicts,
                load: loadHours(c.personaID, program.programaID),
                current: Number(program.operadorID || 0) === Number(c.personaID)
            };
        }).sort((a,b) =>
            Number(a.conflicts.length > 0) - Number(b.conflicts.length > 0) ||
            Number(b.nivel || 0) - Number(a.nivel || 0) ||
            Number(b.enEscala) - Number(a.enEscala) ||
            a.load - b.load ||
            (a.nombre || '').localeCompare(b.nombre || ''));

        list.innerHTML = '';

        if (!program.excepcion) {
            const clear = document.createElement('button');
            clear.type = 'button';
            clear.className = 'ppv3-clear-assignment';
            clear.innerHTML = '<i class="fa-regular fa-circle-xmark"></i><span><strong>Dejar sin operador</strong><small>Marcar esta OF como pendiente de cobertura</small></span>';
            clear.addEventListener('click', () => assignOperator(program, null, null));
            list.appendChild(clear);
        }

        if (!candidates.length) {
            const empty = document.createElement('div');
            empty.className = 'ppv3-empty-state';
            empty.textContent = program.tieneMatriz
                ? 'No hay operadores N1-N4 disponibles para esta pieza.'
                : 'No hay candidatos operativos activos.';
            list.appendChild(empty);
        }

        candidates.forEach(c => {
            const card = document.createElement('article');
            const busy = c.conflicts.length > 0;
            card.className = `ppv3-candidate ${busy ? 'busy' : 'available'} ${c.current ? 'current' : ''}`;
            card.dataset.candidateSearch = [
                c.nombre || '',
                c.numeroControl || '',
                c.nivel ? `N${c.nivel}` : '',
                c.enEscala ? 'en escala' : 'fuera de escala',
                c.turnoEscala || ''
            ].join(' ');

            const conflictText = busy
                ? `Ocupado: ${c.conflicts.map(x => `OF ${x.of} ${toDate(x.inicio).toLocaleTimeString('es-MX',{hour:'2-digit',minute:'2-digit'})}-${toDate(x.fin).toLocaleTimeString('es-MX',{hour:'2-digit',minute:'2-digit'})}`).join(', ')}`
                : 'Disponible durante todo el intervalo';

            card.innerHTML = `
                <div class="ppv3-candidate-main">
                    <div class="ppv3-candidate-name">
                        <span class="ppv3-level-badge ${c.nivel ? `n${c.nivel}` : 'none'}">${c.nivel ? `N${c.nivel}` : 'S/N'}</span>
                        <div>
                            <strong>${escapeHtml(c.nombre)}</strong>
                            <small>${escapeHtml(c.numeroControl || '')}${c.enEscala ? ` · ${escapeHtml(c.turnoEscala || 'En escala')}` : ' · Fuera de escala'}</small>
                        </div>
                    </div>
                    <div class="ppv3-candidate-load"><span>Carga</span><strong>${c.load.toFixed(1)} h</strong></div>
                </div>
                <div class="ppv3-availability-state ${busy ? 'busy' : 'ok'}">
                    <i class="fa-solid ${busy ? 'fa-clock' : 'fa-circle-check'}"></i>
                    ${escapeHtml(conflictText)}
                </div>
                <button type="button" class="btn btn-sm ${c.current ? 'btn-secondary' : 'btn-primary'} fw-bold w-100" ${busy || c.current ? 'disabled' : ''}>
                    ${c.current ? 'Asignado actualmente' : busy ? 'No disponible' : 'Asignar a esta OF'}
                </button>`;

            const assign = card.querySelector('button');
            if (!busy && !c.current) {
                assign.addEventListener('click', () => assignOperator(program, c.personaID, c));
            }
            list.appendChild(card);
        });

        filterCandidateCards();
        availability.show();
    }

    function assignOperator(program, personID, candidate) {
        if (program.excepcion) return;

        const select = document.querySelector(`.ppv3-operator-hidden[data-program-id="${program.programaID}"]`);
        if (!select) return;

        select.value = personID ? String(personID) : '';
        program.operadorID = personID ? Number(personID) : null;
        program.operadorNombre = personID
            ? (candidate?.nombre || people.get(Number(personID)) || '')
            : '';
        program.nivel = candidate?.nivel ?? null;

        recomputeAll();
        availability?.hide();
    }

    function renderPeopleView() {
        const container = document.getElementById('ppv3PeopleView');
        if (!container) return;

        const ids = new Set();
        programs.forEach(p => { if (p.operadorID) ids.add(Number(p.operadorID)); });
        turnos.forEach(t => {
            ['TECNICO','SMED','AUXILIAR'].forEach(role => {
                const id = supportRoleID(t, role);
                if (id) ids.add(id);
            });
        });

        const personFilterValue = Number(personFilter?.value || 0);
        let personIDs = Array.from(ids);
        if (personFilterValue) personIDs = personIDs.filter(x => x === personFilterValue);
        personIDs.sort((a,b) => (people.get(a)||'').localeCompare(people.get(b)||''));

        if (!personIDs.length) {
            container.innerHTML = '<div class="ppv3-empty-state">No hay personas programadas con los filtros actuales.</div>';
            return;
        }

        const days = Array.from({length:7}, (_,i) => {
            const d = new Date(weekStart);
            d.setDate(d.getDate()+i);
            return d;
        });

        let html = `<div class="ppv3-people-grid"><div class="ppv3-person-head">Persona</div>${days.map(d => `<div class="ppv3-day-head">${d.toLocaleDateString('es-MX',{weekday:'short'})}<small>${d.toLocaleDateString('es-MX',{day:'2-digit',month:'2-digit'})}</small></div>`).join('')}`;

        personIDs.forEach(id => {
            const opPrograms = programs.filter(p => Number(p.operadorID||0) === id);
            const support = [];
            turnos.forEach(t => {
                if (Number(t.tecnicoID||0) === id) support.push({ role:'Técnico', turn:t });
                if (Number(t.smedID||0) === id) support.push({ role:'SMED', turn:t });
                if (Number(t.auxiliarID||0) === id) support.push({ role:'Auxiliar', turn:t });
            });
            const conflictCount = opPrograms.filter(programConflict).length + supportConflicts().filter(x => x.a.personID === id).length;
            const roles = [opPrograms.length ? 'Operador' : null, ...support.map(x => x.role)].filter(Boolean);
            const uniqueRoles = [...new Set(roles)];

            html += `<div class="ppv3-person-name"><strong>${escapeHtml(people.get(id) || `Persona #${id}`)}</strong><span>${escapeHtml(uniqueRoles.join(' · '))}</span><small>${loadHours(id).toFixed(1)} h OF${conflictCount ? ` · <b>${conflictCount} conflicto(s)</b>` : ''}</small></div>`;

            days.forEach(day => {
                const dayKey = localDateKey(day);
                const dayPrograms = opPrograms.filter(p => localDateKey(p.inicio) === dayKey);
                const chips = [];
                support.forEach(s => chips.push(`<span class="ppv3-person-chip support">${escapeHtml(s.role)} · ${escapeHtml(s.turn.nombre)}</span>`));
                dayPrograms.forEach(p => chips.push(`<span class="ppv3-person-chip ${programConflict(p) ? 'conflict' : 'program'}">${toDate(p.inicio).toLocaleTimeString('es-MX',{hour:'2-digit',minute:'2-digit'})} · ${escapeHtml(p.of)} · ${escapeHtml(p.maquina)}</span>`));
                html += `<div class="ppv3-person-day">${chips.length ? chips.join('') : '<span class="ppv3-free">Libre</span>'}</div>`;
            });
        });

        html += '</div>';
        container.innerHTML = html;
    }

    function recomputeAll() {
        programs.forEach(updateProgramUI);
        refreshKPIs();
        renderPending();
        renderPeopleView();
        applyFilters();
        syncSupportRows();
    }

    function supportRoleLabel(role) {
        if (role === 'TECNICO') return 'Técnico';
        if (role === 'SMED') return 'SMED';
        return 'Auxiliar';
    }

    function refreshSupportCell(turnID, role) {
        const hidden = document.querySelector(
            `.ppv3-support-hidden[data-turno-id="${turnID}"][data-role="${role}"]`
        );
        const button = document.querySelector(
            `[data-support-open][data-turno-id="${turnID}"][data-role="${role}"]`
        );

        if (!hidden || !button) return;

        const value = Number(hidden.value || 0);
        const option = hidden.selectedOptions?.[0];
        const selectedText = option?.textContent?.trim() || '';

        const name = button.querySelector('span');
        const status = button.querySelector('.ppv3-support-status') || button.querySelector('small');

        if (name) {
            name.textContent = value > 0 && selectedText
                ? selectedText
                : 'Sin asignar';
        }

        button.classList.toggle('assigned', value > 0);
        button.classList.toggle('unassigned', value <= 0);

        if (status) {
            if (value > 0) {
                status.textContent = role === 'SMED'
                    ? 'Asignado · SMED o Técnico · clic para modificar'
                    : `Asignado como ${supportRoleLabel(role)} · clic para modificar`;
            } else {
                status.textContent = role === 'SMED'
                    ? 'Sin asignar · SMED o Técnico · clic para modificar'
                    : `Sin ${supportRoleLabel(role).toLowerCase()} · clic para modificar`;
            }
        }
    }

    function syncSupportRows() {
        document.querySelectorAll('.ppv3-support-row').forEach(row => {
            const turnID = Number(row.dataset.turnId);
            const turn = turnos.find(x => Number(x.turnoID) === turnID);
            if (!turn) return;

            row.dataset.techId = String(turn.tecnicoID || 0);
            row.dataset.smedId = String(turn.smedID || 0);
            row.dataset.auxId = String(turn.auxiliarID || 0);

            refreshSupportCell(turnID, 'TECNICO');
            refreshSupportCell(turnID, 'SMED');
            refreshSupportCell(turnID, 'AUXILIAR');
        });
    }

    document.querySelectorAll('[data-open-operator]').forEach(btn => {
        btn.addEventListener('click', () => openAvailability(Number(btn.dataset.openOperator)));
    });

    document.querySelectorAll('[data-support-open]').forEach(btn => {
        btn.addEventListener('click', function () {
            const turnID = Number(btn.dataset.turnoId);
            const role = btn.dataset.role;
            const hidden = document.querySelector(`.ppv3-support-hidden[data-turno-id="${turnID}"][data-role="${role}"]`);
            if (!hidden || !supportModal) return;

            document.getElementById('ppv3SupportTurnID').value = String(turnID);
            document.getElementById('ppv3SupportRole').value = role;
            document.getElementById('ppv3SupportTitle').textContent = `${role === 'TECNICO' ? 'Técnico' : role === 'SMED' ? 'SMED' : 'Auxiliar'} · ${turnos.find(x => Number(x.turnoID) === turnID)?.nombre || 'Turno'}`;

            const select = document.getElementById('ppv3SupportSelect');
            select.innerHTML = hidden.innerHTML;
            select.value = hidden.value;
            document.getElementById('ppv3SupportHelp').textContent = role === 'SMED'
                ? 'La lista incluye personal catalogado como SMED y también Técnicos habilitados.'
                : 'La cobertura aplica a todas las máquinas durante este turno.';
            supportModal.show();
        });
    });

    document.getElementById('ppv3SupportApply')?.addEventListener('click', function () {
        const turnID = Number(document.getElementById('ppv3SupportTurnID').value || 0);
        const role = document.getElementById('ppv3SupportRole').value;
        const select = document.getElementById('ppv3SupportSelect');
        const hidden = document.querySelector(`.ppv3-support-hidden[data-turno-id="${turnID}"][data-role="${role}"]`);
        const button = document.querySelector(`[data-support-open][data-turno-id="${turnID}"][data-role="${role}"]`);
        const turn = turnos.find(x => Number(x.turnoID) === turnID);
        if (!hidden || !button || !turn) return;

        hidden.value = select.value;
        const selectedText = select.selectedOptions[0]?.textContent?.trim() || 'Sin asignar';

        const id = Number(select.value || 0) || null;

        if (id && selectedText) {
            people.set(id, selectedText);
        }
        if (role === 'TECNICO') turn.tecnicoID = id;
        if (role === 'SMED') turn.smedID = id;
        if (role === 'AUXILIAR') turn.auxiliarID = id;

        refreshSupportCell(turnID, role);
        supportModal.hide();
        recomputeAll();
    });

    document.querySelectorAll('.ppv3-tab').forEach(btn =>
        btn.addEventListener('click', () => activateView(btn.dataset.view)));

    [search, machineFilter, turnFilter, personFilter].forEach(el => {
        el?.addEventListener(el === search ? 'input' : 'change', applyFilters);
    });

    roleFilter?.addEventListener('change', function () {
        const role = roleFilter.value;
        if (role === 'OPERADOR') activateView('planner');
        if (['TECNICO','SMED','AUXILIAR'].includes(role)) activateView('support');
        applyFilters();
    });

    document.getElementById('ppv3ClearFilters')?.addEventListener('click', function () {
        search.value = '';
        machineFilter.value = '';
        turnFilter.value = '';
        roleFilter.value = '';
        personFilter.value = '';
        applyFilters();
    });

    document.querySelectorAll('[data-kpi]').forEach(btn => {
        btn.addEventListener('click', function () {
            const mode = btn.dataset.kpi;
            if (mode === 'all') {
                activateView('planner');
                return;
            }
            if (mode === 'complete') {
                activateView('planner');
                plannerRows.forEach(row => row.classList.toggle('d-none', row.dataset.complete !== '1'));
                return;
            }
            activateView('pending');
            renderPending(mode);
        });
    });

    document.getElementById('ppv3Form')?.addEventListener('submit', function (event) {
        const conflicts = programs.filter(programConflict).length + supportConflicts().length;
        if (conflicts > 0) {
            event.preventDefault();
            alert(`No se puede guardar mientras existan ${conflicts} conflicto(s) de personal. Revísalos en Pendientes o Vista por persona.`);
            return;
        }

        if (!confirm(`¿Guardar la programación de personal de la semana @Model.NumeroSemana?`)) {
            event.preventDefault();
        }
    });

    recomputeAll();
});
</script>
}
