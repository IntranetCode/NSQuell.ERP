    .state-running, .state-ready {
        color: var(--green);
        background: var(--green-soft);
    }

    .state-preparing {
        color: var(--blue);
        background: var(--blue-soft);
    }

    .state-quality {
        color: var(--purple);
        background: var(--purple-soft);
    }

    .state-danger {
        color: var(--red);
        background: var(--red-soft);
    }

    .state-muted {
        color: var(--muted);
        background: #f2f4f7;
    }

    .ao-attention {
        display: inline-flex;
        align-items: center;
        gap: 5px;
        padding: 5px 9px;
        border-radius: 999px;
        color: var(--red);
        background: var(--red-soft);
        font-size: .57rem;
        font-weight: 900;
    }

    .ao-chevron {
        width: 29px;
        height: 29px;
