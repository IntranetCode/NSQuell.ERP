@using System
@using System.Collections.Generic
@using System.Globalization
@using System.Linq
@using ERP.NSQuell.Models
@using Microsoft.AspNetCore.Routing
@model AgendaOperativaVm

@{
    Layout = "_Layout";
    ViewData["Title"] = "Agenda Operativa";

    bool EsAccionCalidad(AgendaOperativaAccionVm? accion)
    {
        if (accion == null) return false;
        if (string.Equals(accion.Controlador, "Calidad", StringComparison.OrdinalIgnoreCase)) return true;
        if (string.Equals(accion.AreaResponsable, AgendaOperativaArea.Calidad, StringComparison.OrdinalIgnoreCase)) return true;
        return accion.Clave == AgendaOperativaPasoClave.Calidad
            || accion.Clave == AgendaOperativaPasoClave.PrimerasPiezas
            || accion.Clave == AgendaOperativaPasoClave.CalidadFinal;
    }

    bool EsPasoCalidad(AgendaOperativaPasoVm paso)
    {
        if (string.Equals(paso.AreaResponsable, AgendaOperativaArea.Calidad, StringComparison.OrdinalIgnoreCase)) return true;
        return paso.Clave == AgendaOperativaPasoClave.Calidad
            || paso.Clave == AgendaOperativaPasoClave.PrimerasPiezas
            || paso.Clave == AgendaOperativaPasoClave.CalidadFinal;
    }

    bool RequiereAtencionOperativa(AgendaOperativaItemVm item)
    {
        if (!item.RequiereAtencionInmediata) return false;
        if (item.AccionActual == null) return false;
        return !EsAccionCalidad(item.AccionActual);
    }

    bool EstaBloqueadaOperativamente(AgendaOperativaItemVm item)
    {
        return item.EstaBloqueada && !EsAccionCalidad(item.AccionActual);
    }

    var gruposMaquina = Model.Items
        .Where(x => x.MaquinaID.HasValue)
        .GroupBy(x => x.MaquinaID!.Value)
        .OrderBy(g => g.Any(RequiereAtencionOperativa) ? 0 : 1)
        .ThenBy(g => g.Where(RequiereAtencionOperativa).Select(x => x.OrdenPrioridad).DefaultIfEmpty(99).Min())
        .ThenBy(g => g.Min(x => x.FechaOrden))
        .ThenBy(g => g.First().MaquinaCodigo)
        .ToList();

    var grupoInicial = gruposMaquina.FirstOrDefault(x => x.Any(RequiereAtencionOperativa))
        ?? gruposMaquina.FirstOrDefault();

    var maquinaInicialId = grupoInicial?.Key;

    var totalMaquinas = gruposMaquina.Count;
    var maquinasAtencion = gruposMaquina.Count(g => g.Any(RequiereAtencionOperativa));
    var maquinasBloqueadas = gruposMaquina.Count(g => g.Any(EstaBloqueadaOperativamente));
    var maquinasProduciendo = gruposMaquina.Count(g => g.Any(x => x.EstaProduciendo));

    int OrdenEstado(AgendaOperativaItemVm item)
    {
        return item.EstadoGeneral switch
        {
            AgendaOperativaEstadoGeneral.InterrumpidaUrgente => 1,
            AgendaOperativaEstadoGeneral.Bloqueada => 2,
            AgendaOperativaEstadoGeneral.Pausada => 3,
            AgendaOperativaEstadoGeneral.Produciendo => 4,
            AgendaOperativaEstadoGeneral.Preparacion => 5,
            AgendaOperativaEstadoGeneral.ListaParaSerie => 6,
            AgendaOperativaEstadoGeneral.EsperandoCalidad => 7,
            AgendaOperativaEstadoGeneral.Reliberacion => 8,
            AgendaOperativaEstadoGeneral.MaquinaLiberada => 9,
            AgendaOperativaEstadoGeneral.Programada => 10,
            _ => 50
        };
    }

    AgendaOperativaItemVm ObtenerPrincipal(List<AgendaOperativaItemVm> items)
    {
        var activa = items
            .Where(x =>
                x.EjecucionProduccionID.HasValue &&
                !string.Equals(x.EstadoGeneral, AgendaOperativaEstadoGeneral.Terminada, StringComparison.OrdinalIgnoreCase))
            .OrderBy(OrdenEstado)
            .ThenBy(x => x.FechaInicioProgramada ?? DateTime.MaxValue)
            .FirstOrDefault();

        return activa
            ?? items
                .OrderBy(x => x.FechaInicioProgramada ?? DateTime.MaxValue)
                .ThenBy(x => x.ProgramaProduccionID)
                .First();
    }

    AgendaOperativaItemVm ObtenerAtencionPrincipal(List<AgendaOperativaItemVm> items, AgendaOperativaItemVm principal)
    {
        return items
            .Where(RequiereAtencionOperativa)
            .OrderBy(x => x.OrdenPrioridad)
            .ThenByDescending(EstaBloqueadaOperativamente)
            .ThenBy(x => x.FechaOrden)
            .FirstOrDefault()
            ?? principal;
    }

    List<AgendaOperativaPasoVm> ObtenerPasosVisibles(AgendaOperativaItemVm item)
    {
        return item.Pasos
            .Where(x => x.Aplica && !EsPasoCalidad(x))
            .OrderBy(x => x.Orden)
            .ToList();
    }

    string TextoEstado(AgendaOperativaItemVm item)
    {
        return item.EstadoGeneral switch
        {
            AgendaOperativaEstadoGeneral.EsperandoCalidad => "Esperando a Calidad",
            AgendaOperativaEstadoGeneral.Reliberacion => "Esperando a Calidad",
            _ => item.EstadoGeneralTexto
        };
    }

    string ClaseEstado(string? estado)
    {
        return (estado ?? string.Empty).Trim().ToUpperInvariant() switch
        {
            AgendaOperativaEstadoGeneral.Produciendo => "state-running",
            AgendaOperativaEstadoGeneral.ListaParaSerie => "state-ready",
            AgendaOperativaEstadoGeneral.Preparacion => "state-preparing",
            AgendaOperativaEstadoGeneral.EsperandoCalidad => "state-quality",
            AgendaOperativaEstadoGeneral.Reliberacion => "state-quality",
            AgendaOperativaEstadoGeneral.Pausada => "state-danger",
            AgendaOperativaEstadoGeneral.InterrumpidaUrgente => "state-danger",
            AgendaOperativaEstadoGeneral.Bloqueada => "state-danger",
            _ => "state-muted"
        };
    }

    string IconoEstado(string? estado)
    {
        return (estado ?? string.Empty).Trim().ToUpperInvariant() switch
        {
            AgendaOperativaEstadoGeneral.Produciendo => "bi-play-fill",
            AgendaOperativaEstadoGeneral.ListaParaSerie => "bi-play-circle-fill",
            AgendaOperativaEstadoGeneral.Preparacion => "bi-tools",
            AgendaOperativaEstadoGeneral.EsperandoCalidad => "bi-shield-hourglass",
            AgendaOperativaEstadoGeneral.Reliberacion => "bi-shield-hourglass",
            AgendaOperativaEstadoGeneral.Pausada => "bi-pause-fill",
            AgendaOperativaEstadoGeneral.InterrumpidaUrgente => "bi-lightning-charge-fill",
            AgendaOperativaEstadoGeneral.Bloqueada => "bi-lock-fill",
            _ => "bi-clock"
        };
    }

    string ClasePrioridad(string? prioridad)
    {
        return (prioridad ?? string.Empty).Trim().ToUpperInvariant() switch
        {
            AgendaOperativaPrioridad.Critica => "now-critical",
            AgendaOperativaPrioridad.Alta => "now-high",
            AgendaOperativaPrioridad.Media => "now-medium",
            _ => "now-normal"
        };
    }

    string ClasePaso(AgendaOperativaPasoVm paso)
    {
        if (paso.Completado) return "flow-done";
        if (paso.Bloqueado || paso.EstaVencido) return "flow-danger";
        if (paso.EnProceso) return "flow-current";
        if (paso.Estado == AgendaOperativaEstadoPaso.Listo) return "flow-ready";
        if (paso.Estado == AgendaOperativaEstadoPaso.Esperando) return "flow-wait";
        return "flow-pending";
    }

    string IconoPaso(AgendaOperativaPasoVm paso)
    {
        if (paso.Completado) return "bi-check-lg";
        if (paso.Bloqueado || paso.EstaVencido) return "bi-exclamation-lg";
        if (paso.EnProceso) return "bi-arrow-right";
        if (paso.Estado == AgendaOperativaEstadoPaso.Listo) return "bi-play-fill";
        if (paso.Estado == AgendaOperativaEstadoPaso.Esperando) return "bi-hourglass-split";
        return "bi-circle-fill";
    }

    string TextoFecha(DateTime? fecha)
    {
        return fecha.HasValue ? fecha.Value.ToString("dd/MM/yyyy HH:mm") : "—";
    }

    string TextoFechaCorta(DateTime? fecha)
    {
        return fecha.HasValue ? fecha.Value.ToString("dd/MM HH:mm") : "—";
    }

    string TextoHora(DateTime? fecha)
    {
        return fecha.HasValue ? fecha.Value.ToString("HH:mm") : "—";
    }

    string TextoRetraso(int minutos)
    {
        if (minutos <= 0) return "En tiempo";
        if (minutos < 60) return $"{minutos} min";

        var horas = minutos / 60;
        var mins = minutos % 60;

        if (horas < 24)
            return mins == 0 ? $"{horas} h" : $"{horas} h {mins} min";

        var dias = horas / 24;
        var horasRestantes = horas % 24;

        return horasRestantes == 0
            ? $"{dias} d"
            : $"{dias} d {horasRestantes} h";
    }

    string TextoActividadActual(AgendaOperativaItemVm item)
    {
        if (item.AccionActual != null && EsAccionCalidad(item.AccionActual))
            return "Esperando a Calidad";

        if (item.AccionActual != null)
            return item.AccionActual.Titulo;

        if (item.EstaProduciendo)
            return "Producción en serie";

        return TextoEstado(item);
    }

    string DescripcionActividadActual(AgendaOperativaItemVm item)
    {
        if (item.AccionActual != null && EsAccionCalidad(item.AccionActual))
        {
            if (!string.IsNullOrWhiteSpace(item.AccionActual.Descripcion))
                return item.AccionActual.Descripcion!;

            return "La producción se encuentra a la espera de la validación correspondiente de Calidad.";
        }

        if (item.AccionActual != null && !string.IsNullOrWhiteSpace(item.AccionActual.Descripcion))
            return item.AccionActual.Descripcion!;

        if (item.EstaProduciendo)
            return "La máquina se encuentra ejecutando la OF actualmente programada.";

        return "La máquina se encuentra dentro del flujo operativo de esta OF.";
    }

    string TextoActividadSiguiente(AgendaOperativaAccionVm? accion)
    {
        if (accion == null)
            return "Sin siguiente actividad pendiente";

        if (EsAccionCalidad(accion))
            return "Esperando a Calidad";

        return accion.Titulo;
    }

    string DescripcionActividadSiguiente(AgendaOperativaAccionVm? accion)
    {
        if (accion == null)
            return "La siguiente actividad se determinará conforme avance la operación.";

        if (EsAccionCalidad(accion))
            return "Después de completar la actividad actual, la OF quedará a la espera de Calidad.";

        if (!string.IsNullOrWhiteSpace(accion.Descripcion))
            return accion.Descripcion!;

        return $"Responsable: {accion.AreaResponsableTexto}.";
    }

    string UrlDetalle(AgendaOperativaItemVm item)
    {
        if (item.EjecucionProduccionID.HasValue)
        {
            return Url.Action(
                "Detalle",
                "Produccion",
                new
                {
                    id = item.EjecucionProduccionID.Value,
                    returnUrl = $"{Context.Request.Path}{Context.Request.QueryString}"
                }) ?? "#";
        }

        return Url.Action(
            "Index",
            "Produccion",
            new
            {
                maquinaId = item.MaquinaID,
                busqueda = item.OFTexto
            }) ?? "#";
    }

    string UrlAccion(AgendaOperativaItemVm item, AgendaOperativaAccionVm? accion)
    {
        if (accion == null || EsAccionCalidad(accion))
            return UrlDetalle(item);

        if (accion.Clave == "LHRH_INCONSISTENTE")
        {
            return Url.Action(
                "Index",
                "PlaneacionCalendarioMaquinas",
                new
                {
                    programaProduccionId = item.ProgramaProduccionID,
                    returnUrl = $"{Context.Request.Path}{Context.Request.QueryString}"
                }) ?? "#";
        }

        if (string.IsNullOrWhiteSpace(accion.Controlador) || string.IsNullOrWhiteSpace(accion.Accion))
            return UrlDetalle(item);

        var valores = new RouteValueDictionary();

        foreach (var parametro in accion.ParametrosRuta)
        {
            if (!string.IsNullOrWhiteSpace(parametro.Value))
                valores[parametro.Key] = parametro.Value;
        }

        if (!string.IsNullOrWhiteSpace(accion.ParametroId) && accion.IdDestino.HasValue)
        {
            valores[accion.ParametroId] = accion.IdDestino.Value;
        }
        else if (accion.Controlador == "ProduccionPersonal" && accion.IdDestino.HasValue)
        {
            valores["programaProduccionId"] = accion.IdDestino.Value;
        }
        else if (accion.Controlador == "PlaneacionCalendarioMaquinas" && accion.IdDestino.HasValue)
        {
            valores["programaProduccionId"] = accion.IdDestino.Value;
        }

        valores["returnUrl"] = $"{Context.Request.Path}{Context.Request.QueryString}";

        return Url.Action(accion.Accion, accion.Controlador, valores) ?? UrlDetalle(item);
    }
}

<style>
    .agenda-operativa {
        --bg: #f4f7fc;
        --surface: #ffffff;
        --surface2: #f8fafc;
        --line: #dfe6f0;
        --line2: #cfd9e8;
        --text: #14213d;
        --muted: #667085;
        --blue: #2563eb;
        --blue-dark: #1d4ed8;
        --blue-soft: #eff6ff;
        --cyan-soft: #ecfeff;
        --green: #067647;
        --green-soft: #ecfdf3;
        --red: #b42318;
        --red-soft: #fff1f0;
        --orange: #b54708;
        --orange-soft: #fff7ed;
        --purple: #6941c6;
        --purple-soft: #f5f3ff;
        --yellow: #b54708;
        --yellow-soft: #fffaeb;
        color: var(--text);
    }

    .ao-page {
        min-height: calc(100vh - 100px);
        padding: 18px;
        background: radial-gradient(circle at 100% 0,rgba(37,99,235,.06),transparent 24rem), var(--bg);
    }

    .ao-header {
        display: flex;
        justify-content: space-between;
        align-items: flex-end;
        gap: 18px;
        margin-bottom: 12px;
    }

    .ao-title {
        margin: 0;
        font-size: 1.55rem;
        font-weight: 950;
        letter-spacing: -.035em;
    }

    .ao-subtitle {
        margin-top: 3px;
        color: var(--muted);
        font-size: .75rem;
    }

    .ao-updated {
        margin-top: 5px;
        color: var(--muted);
        font-size: .61rem;
    }

    .ao-refresh {
        display: inline-flex;
        align-items: center;
        gap: 6px;
        min-height: 37px;
        padding: 7px 12px;
        border: 1px solid #bfd0f7;
        border-radius: 9px;
        background: var(--blue-soft);
        color: var(--blue-dark);
        text-decoration: none;
        font-size: .68rem;
        font-weight: 850;
    }

        .ao-refresh:hover {
            background: #dbeafe;
            color: var(--blue-dark);
        }

    .ao-summary {
        display: flex;
        align-items: center;
        overflow: auto;
        margin-bottom: 10px;
        border: 1px solid var(--line);
        border-radius: 11px;
        background: linear-gradient(90deg,#fff,#f8fbff);
    }

    .ao-summary-item {
        position: relative;
        display: flex;
        align-items: center;
        gap: 6px;
        padding: 9px 15px;
        color: var(--muted);
        font-size: .64rem;
        font-weight: 700;
        white-space: nowrap;
    }

        .ao-summary-item + .ao-summary-item::before {
            content: "";
            position: absolute;
            left: 0;
            top: 8px;
            bottom: 8px;
            width: 1px;
            background: var(--line);
        }

    .ao-summary-number {
        color: var(--text);
        font-size: .84rem;
        font-weight: 950;
    }

    .ao-dot {
        width: 7px;
        height: 7px;
        flex: 0 0 auto;
        border-radius: 50%;
    }

        .ao-dot.blue {
            background: #2e90fa;
        }

        .ao-dot.red {
            background: #f04438;
        }

        .ao-dot.orange {
            background: #f79009;
        }

        .ao-dot.green {
            background: #12b76a;
        }

    .ao-filters {
        margin-bottom: 17px;
        padding: 11px;
        border: 1px solid var(--line);
        border-radius: 11px;
        background: var(--surface);
    }

    .ao-filter-grid {
        display: grid;
        grid-template-columns: minmax(220px,1.5fr) repeat(3,minmax(145px,1fr)) auto;
        gap: 8px;
        align-items: end;
    }

    .ao-label {
        display: block;
        margin-bottom: 4px;
        color: var(--muted);
        font-size: .56rem;
        font-weight: 900;
        text-transform: uppercase;
        letter-spacing: .05em;
    }

    .agenda-operativa .form-control,
    .agenda-operativa .form-select {
        min-height: 38px;
        border-color: var(--line2);
        border-radius: 8px;
        font-size: .7rem;
        box-shadow: none;
    }

        .agenda-operativa .form-control:focus,
        .agenda-operativa .form-select:focus {
            border-color: #84adff;
            box-shadow: 0 0 0 3px rgba(37,99,235,.08);
        }

    .ao-filter-checks {
        display: flex;
        gap: 14px;
        margin-top: 8px;
        color: var(--muted);
        font-size: .63rem;
    }

    .ao-check {
        display: flex;
        align-items: center;
        gap: 5px;
        cursor: pointer;
    }

    .ao-list-header {
        display: flex;
        justify-content: space-between;
        align-items: center;
        margin-bottom: 7px;
    }

    .ao-list-title {
        margin: 0;
        font-size: .75rem;
        font-weight: 950;
        text-transform: uppercase;
        letter-spacing: .05em;
    }

    .ao-list-hint {
        color: var(--muted);
        font-size: .6rem;
    }

    .ao-machines {
        display: grid;
        gap: 8px;
    }

    .ao-machine {
        overflow: hidden;
        border: 1px solid var(--line);
        border-radius: 13px;
        background: var(--surface);
        transition: border-color .16s ease,box-shadow .16s ease;
    }

