        .ao-machine-header:hover {
            background: linear-gradient(90deg,#eaf2ff,#f8fbff);
        }

    .ao-machine-id {
        min-width: 0;
        display: flex;
        align-items: center;
        gap: 10px;
    }

    .ao-machine-icon {
        width: 38px;
        height: 38px;
        display: grid;
        place-items: center;
        flex: 0 0 auto;
        border-radius: 10px;
        background: linear-gradient(135deg,#dbeafe,#eff6ff);
        color: var(--blue);
        font-size: .92rem;
    }

    .ao-machine-name {
        overflow: hidden;
        text-overflow: ellipsis;
        white-space: nowrap;
        font-size: .84rem;
        font-weight: 950;
    }

    .ao-machine-info {
        margin-top: 2px;
        color: var(--muted);
        font-size: .58rem;
    }

    .ao-of-label {
        color: var(--muted);
        font-size: .51rem;
        font-weight: 900;
        text-transform: uppercase;
        letter-spacing: .05em;
    }

    .ao-of-current {
        margin-top: 2px;
        font-size: .72rem;
        font-weight: 950;
    }

    .ao-of-part {
        margin-top: 1px;
        color: var(--muted);
        font-size: .57rem;
    }

    .ao-badges {
        display: flex;
        align-items: center;
        justify-content: flex-end;
        gap: 5px;
        flex-wrap: wrap;
    }

    .ao-state {
        display: inline-flex;
        align-items: center;
        gap: 5px;
        padding: 5px 9px;
        border-radius: 999px;
        font-size: .57rem;
        font-weight: 900;
        white-space: nowrap;
