@using System
@using System.Collections.Generic
@using System.Globalization
@using System.Linq
@using ERP.NSQuell.Models
@using Microsoft.AspNetCore.Routing
@model AgendaOperativaVm

@{
    Layout = "_Layout";
    ViewData["Title"] = "Calendario Operativo";

    var ahora = Model.FechaConsulta;
    var ventanaHoras = Math.Clamp(Model.Filtros.VentanaHoras <= 0 ? 24 : Model.Filtros.VentanaHoras, 4, 72);
    var horasPrevias = ventanaHoras <= 12 ? 2 : 4;

    var inicioVentana = new DateTime(
        ahora.Year,
        ahora.Month,
        ahora.Day,
        ahora.Hour,
        0,
        0).AddHours(-horasPrevias);

    var finBase = ahora.AddHours(ventanaHoras);

    var finVentana = new DateTime(
        finBase.Year,
        finBase.Month,
        finBase.Day,
        finBase.Hour,
        0,
        0).AddHours(1);

    var minutosTotales = Math.Max(
        60d,
        (finVentana - inicioVentana).TotalMinutes);

    var pasoHoras = ventanaHoras switch
    {
        <= 12 => 1,
        <= 24 => 2,
        <= 48 => 4,
        _ => 6
    };

    var marcasTiempo = new List<DateTime>();

    for (var fecha = inicioVentana; fecha <= finVentana; fecha = fecha.AddHours(pasoHoras))
        marcasTiempo.Add(fecha);

    bool EsAccionCalidad(AgendaOperativaAccionVm? accion)
    {
        if (accion == null) return false;

        if (string.Equals(
            accion.Controlador,
            "Calidad",
            StringComparison.OrdinalIgnoreCase))
            return true;

        if (string.Equals(
            accion.AreaResponsable,
            AgendaOperativaArea.Calidad,
            StringComparison.OrdinalIgnoreCase))
            return true;

        return accion.Clave == AgendaOperativaPasoClave.Calidad
            || accion.Clave == AgendaOperativaPasoClave.PrimerasPiezas
            || accion.Clave == AgendaOperativaPasoClave.CalidadFinal;
    }

    bool EsPasoCalidad(AgendaOperativaPasoVm paso)
    {
        if (string.Equals(
            paso.AreaResponsable,
            AgendaOperativaArea.Calidad,
            StringComparison.OrdinalIgnoreCase))
            return true;

        return paso.Clave == AgendaOperativaPasoClave.Calidad
            || paso.Clave == AgendaOperativaPasoClave.PrimerasPiezas
            || paso.Clave == AgendaOperativaPasoClave.CalidadFinal;
    }

    bool EsEjecucionActiva(AgendaOperativaItemVm item)
    {
        return item.EjecucionProduccionID.HasValue
            && !string.Equals(
                item.EstadoGeneral,
                AgendaOperativaEstadoGeneral.Terminada,
                StringComparison.OrdinalIgnoreCase);
    }

    AgendaOperativaItemVm ObtenerPrincipal(
        List<AgendaOperativaItemVm> items)
    {
        return items
            .Where(EsEjecucionActiva)
            .OrderBy(x => x.FechaInicioProgramada ?? DateTime.MaxValue)
            .FirstOrDefault()
            ?? items
                .OrderBy(x => x.FechaInicioProgramada ?? DateTime.MaxValue)
                .ThenBy(x => x.ProgramaProduccionID)
                .First();
    }

    (DateTime Inicio, DateTime Fin) ObtenerRango(
        AgendaOperativaItemVm item)
    {
        var inicio =
            item.FechaInicioProgramada
            ?? item.FechaInicioReal
            ?? ahora;

        var fin =
            item.FechaFinProgramada
            ?? item.FechaFinReal
            ?? inicio.AddHours(1);

        if (EsEjecucionActiva(item) && fin < ahora)
            fin = ahora;

        if (fin <= inicio)
            fin = inicio.AddMinutes(30);

        return (inicio, fin);
    }

    List<AgendaOperativaItemVm> ObtenerOperacionesMaquina(
        IEnumerable<AgendaOperativaItemVm> origen)
    {
        var resultado = new List<AgendaOperativaItemVm>();
        var usados = new HashSet<int>();

        foreach (var item in origen
            .OrderBy(x => x.FechaInicioProgramada ?? DateTime.MaxValue)
            .ThenBy(x => x.ProgramaProduccionID))
        {
            if (usados.Contains(item.ProgramaProduccionID))
                continue;

            resultado.Add(item);
            usados.Add(item.ProgramaProduccionID);

            if (item.ProduccionLhRh?.EsPareja == true
                && item.ProduccionLhRh.ProgramaParejaID > 0)
            {
                usados.Add(
                    item.ProduccionLhRh.ProgramaParejaID);
            }
        }

        return resultado;
    }

    List<(AgendaOperativaItemVm Item, int Carril)> ObtenerOperacionesConCarril(
        IEnumerable<AgendaOperativaItemVm> origen)
    {
        var operaciones = ObtenerOperacionesMaquina(origen);
        var resultado = new List<(AgendaOperativaItemVm Item, int Carril)>();
        var finCarriles = new List<DateTime>();

        foreach (var item in operaciones)
        {
            var rango = ObtenerRango(item);
            var carril = -1;

            for (var i = 0; i < finCarriles.Count; i++)
            {
                if (rango.Inicio >= finCarriles[i])
                {
                    carril = i;
                    break;
                }
            }

            if (carril < 0)
            {
                carril = finCarriles.Count;
                finCarriles.Add(rango.Fin);
            }
            else
            {
                finCarriles[carril] = rango.Fin;
            }

            resultado.Add((item, carril));
        }

        return resultado;
    }

    double Posicion(DateTime fecha)
    {
        var minutos = (fecha - inicioVentana).TotalMinutes;
        var porcentaje = minutos / minutosTotales * 100d;

        return Math.Max(
            0d,
            Math.Min(100d, porcentaje));
    }

    string Pct(double valor)
    {
        return valor.ToString(
            "0.###",
            CultureInfo.InvariantCulture) + "%";
    }

    string ClaseBarra(AgendaOperativaItemVm item)
    {
        if (item.EstadoGeneral == AgendaOperativaEstadoGeneral.InterrumpidaUrgente
            || item.EstadoGeneral == AgendaOperativaEstadoGeneral.Pausada
            || item.EstadoGeneral == AgendaOperativaEstadoGeneral.Bloqueada)
        {
            return "cal-bar-danger";
        }

        if (EsAccionCalidad(item.AccionActual)
            || item.EstadoGeneral == AgendaOperativaEstadoGeneral.EsperandoCalidad
            || item.EstadoGeneral == AgendaOperativaEstadoGeneral.Reliberacion)
        {
            return "cal-bar-quality";
        }

        if (item.RequiereAtencionInmediata)
            return "cal-bar-attention";

        if (item.EstaProduciendo)
            return "cal-bar-running";

        if (item.EstadoGeneral == AgendaOperativaEstadoGeneral.Preparacion)
            return "cal-bar-preparing";

        if (item.EstadoGeneral == AgendaOperativaEstadoGeneral.ListaParaSerie)
            return "cal-bar-ready";

        return "cal-bar-scheduled";
    }

    string TextoEstado(AgendaOperativaItemVm item)
    {
        if (EsAccionCalidad(item.AccionActual)
            || item.EstadoGeneral == AgendaOperativaEstadoGeneral.EsperandoCalidad
            || item.EstadoGeneral == AgendaOperativaEstadoGeneral.Reliberacion)
        {
            return "Esperando a Calidad";
        }

        return item.EstadoGeneralTexto;
    }

    string TextoAhora(AgendaOperativaItemVm item)
    {
        if (EsAccionCalidad(item.AccionActual))
            return "Esperando a Calidad";

        if (item.AccionActual != null)
            return item.AccionActual.Titulo;

        if (item.EstaProduciendo)
            return "Producción en serie";

        return TextoEstado(item);
    }

    string DescripcionAhora(AgendaOperativaItemVm item)
    {
        if (EsAccionCalidad(item.AccionActual))
        {
            return !string.IsNullOrWhiteSpace(item.AccionActual?.Descripcion)
                ? item.AccionActual!.Descripcion!
                : "La OF se encuentra esperando la validación correspondiente de Calidad.";
        }

        if (!string.IsNullOrWhiteSpace(item.AccionActual?.Descripcion))
            return item.AccionActual!.Descripcion!;

        if (item.EstaProduciendo)
            return "La máquina está ejecutando actualmente esta OF.";

        return "La operación continúa dentro de su flujo programado.";
    }

    string TextoSiguiente(AgendaOperativaAccionVm? accion)
    {
        if (accion == null)
            return "Sin siguiente actividad pendiente";

        if (EsAccionCalidad(accion))
            return "Esperando a Calidad";

        return accion.Titulo;
    }

    string DescripcionSiguiente(AgendaOperativaAccionVm? accion)
    {
        if (accion == null)
            return "La siguiente actividad se determinará conforme avance la OF.";

        if (EsAccionCalidad(accion))
            return "Después de la actividad actual, la OF quedará esperando a Calidad.";

        if (!string.IsNullOrWhiteSpace(accion.Descripcion))
            return accion.Descripcion!;

        return $"Responsable: {accion.AreaResponsableTexto}.";
    }

    string TextoFecha(DateTime? fecha)
    {
        return fecha.HasValue
            ? fecha.Value.ToString("dd/MM/yyyy HH:mm")
            : "—";
    }

    string TextoFechaCorta(DateTime? fecha)
    {
        return fecha.HasValue
            ? fecha.Value.ToString("dd/MM HH:mm")
            : "—";
    }

    string UrlDetalle(AgendaOperativaItemVm item)
    {
        if (item.EjecucionProduccionID.HasValue)
        {
            return Url.Action(
                "Detalle",
                "Produccion",
                new
                {
                    id = item.EjecucionProduccionID.Value,
                    returnUrl = $"{Context.Request.Path}{Context.Request.QueryString}"
                }) ?? "#";
        }

        return Url.Action(
            "Index",
            "Produccion",
            new
            {
                maquinaId = item.MaquinaID,
                busqueda = item.OFTexto
            }) ?? "#";
    }

    string? UrlAccion(
        AgendaOperativaItemVm item,
        AgendaOperativaAccionVm? accion)
    {
        if (accion == null || EsAccionCalidad(accion))
            return null;

        if (accion.Clave == "LHRH_INCONSISTENTE")
        {
            return Url.Action(
                "Index",
                "PlaneacionCalendarioMaquinas",
                new
                {
                    programaProduccionId = item.ProgramaProduccionID,
                    returnUrl = $"{Context.Request.Path}{Context.Request.QueryString}"
                });
        }

        if (string.IsNullOrWhiteSpace(accion.Controlador)
            || string.IsNullOrWhiteSpace(accion.Accion))
        {
            return UrlDetalle(item);
        }

        var valores = new RouteValueDictionary();

        foreach (var parametro in accion.ParametrosRuta)
        {
            if (!string.IsNullOrWhiteSpace(parametro.Value))
                valores[parametro.Key] = parametro.Value;
        }

        if (!string.IsNullOrWhiteSpace(accion.ParametroId)
            && accion.IdDestino.HasValue)
        {
            valores[accion.ParametroId] = accion.IdDestino.Value;
        }
        else if (accion.Controlador == "ProduccionPersonal"
            && accion.IdDestino.HasValue)
        {
            valores["programaProduccionId"] = accion.IdDestino.Value;
        }
        else if (accion.Controlador == "PlaneacionCalendarioMaquinas"
            && accion.IdDestino.HasValue)
        {
            valores["programaProduccionId"] = accion.IdDestino.Value;
        }

        valores["returnUrl"] =
            $"{Context.Request.Path}{Context.Request.QueryString}";

        return Url.Action(
            accion.Accion,
            accion.Controlador,
            valores);
    }

    string EtiquetaTiempo(DateTime fecha)
    {
        if (fecha.Hour == 0)
            return fecha.ToString("dd/MM HH:mm");

        return fecha.ToString("HH:mm");
    }

    var gruposMaquina = Model.Items
        .Where(x => x.MaquinaID.HasValue)
        .GroupBy(x => x.MaquinaID!.Value)
        .OrderBy(x => x.First().MaquinaCodigo)
        .ToList();

    var ahoraPosicion = Posicion(ahora);
}

