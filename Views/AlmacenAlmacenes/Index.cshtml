@model List<ERP.NSQuell.Models.ViewModels.Almacen.AlmacenMaestroVm>
@{ Layout = "~/Views/Shared/_Layout.cshtml"; ViewData["Title"]="Alta de almacenes"; }

@section Styles {
    <link rel="stylesheet" href="~/css/Almacen/almacen-navegacion.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/nsquell-erp-theme.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/Almacen/almacen.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/Almacen/almacen-vistas.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/Almacen/almacen-temas.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/Almacen/almacen-operativo-v3.css" asp-append-version="true" />
}


@section Scripts {
    <script src="~/js/Almacen/almacen-vistas.js" asp-append-version="true"></script>
}


@await Html.PartialAsync("_AlmacenNavegacion")

@await Html.PartialAsync("_AlmacenMensajes")


@if(TempData["AlmacenOk"]!=null){<div class="alm-alert success">@TempData["AlmacenOk"]</div>}@if(TempData["AlmacenError"]!=null){<div class="alm-alert danger">@TempData["AlmacenError"]</div>}
<section class="ao-hero"><div><small>CATALOGO MAESTRO</small><h1>Alta de almacenes</h1><p>Crea almacenes antes de administrar racks, niveles y posiciones.</p></div></section>
<section class="ao-two"><form asp-action="Guardar" method="post" class="ao-panel ao-form">@Html.AntiForgeryToken()<h2>Nuevo almacen</h2><label>Codigo<input class="alm-input" name="Codigo" maxlength="30" required/></label><label>Nombre<input class="alm-input" name="Nombre" maxlength="120" required/></label><label>Tipo<select class="alm-select" name="TipoAlmacen"><option>GENERAL</option><option>MP</option><option>EMBALAJES</option><option>PT</option><option>REFACCIONES</option><option>INSUMOS</option><option>EPP</option><option>OTRO</option></select></label><label>Descripcion<textarea class="alm-textarea" name="Descripcion"></textarea></label><label class="ao-check"><input type="checkbox" name="PermiteNegativos" value="true"/> Permitir negativos</label><input type="hidden" name="Activo" value="true"/><button class="alm-btn" type="submit">Guardar almacen</button></form><section class="ao-panel"><h2>Almacenes registrados</h2><div class="ao-master-list">@foreach(var x in Model){<article><div class="ao-icon"><i class="fa-solid fa-warehouse"></i></div><div><strong>@x.Codigo · @x.Nombre</strong><span>@x.TipoAlmacen · @(x.Activo?"Activo":"Inactivo")</span><p>@x.Descripcion</p></div></article>}</div></section></section>
