@* LOGISTICA_DETALLE_PREMIUM_V2 *@
@using ERP.NSQuell.Models.ViewModels.Logistica
@model LogisticaDetalleVm
@{
    Layout = "~/Views/Shared/_Layout.cshtml";
    ViewData["Title"] = Model.Folio;

    string Fecha(DateTime? d) => d?.ToString("dd/MM/yyyy") ?? "—";
    string FechaHora(DateTime? d) => d?.ToString("dd/MM/yyyy HH:mm") ?? "—";
    string Hora(TimeSpan? t) => t?.ToString(@"hh\:mm") ?? "";
    bool editable = Model.Estatus is "Programado" or "Preparando";

    var pasos = new[] { "Programado", "Preparando", "Preparado", "Cargado", "En ruta", "Entregado" };
    var indiceActual = Array.IndexOf(pasos, Model.Estatus);
    var totalSolicitado = Model.Partidas.Sum(x => x.CantidadSolicitada);
    var totalAsignado = Model.Partidas.Sum(x => x.CantidadAsignada);
    var totalDespachado = Model.Partidas.Sum(x => x.CantidadDespachada);
    var totalCajas = Model.CajasAsignadas.Count;
    var completo = totalSolicitado > 0 && totalAsignado == totalSolicitado;
    var puedeDespachar = Model.PuedeSalir && Model.IncidenciasCriticas == 0;
    var checklistCompletos = Model.Checklist.Count(x => x.Completo || !x.Obligatorio);
    var checklistTotal = Model.Checklist.Count;

    string EstadoColor(string estado) => estado switch
    {
        "Atrasado" => "danger",
        "En riesgo" => "warning",
        "Entregado" => "success",
        "Cancelado" => "secondary",
        _ => "success"
    };
}

@section Scripts {
    <script src="~/js/shared/nsq-dynamic-style.js" asp-append-version="true"></script>
}


@section Styles {
    <link rel="stylesheet" href="~/css/logistica.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/Logistica/detalle.css" asp-append-version="true" />
}


@await Html.PartialAsync("_LogisticaNavegacion")


<div class="ld-page">
    <section class="ld-hero">
        <div class="ld-hero-row">
            <div>
                <a class="ld-back" asp-action="Index"><i class="fa-solid fa-arrow-left"></i>Operación logística</a>
                <span class="ld-kicker">Embarque</span>
                <h1>@Model.Folio</h1>
                <p>@Model.Cliente · @Model.Destino</p>
                <div class="ld-top-actions">
                    <a class="ld-btn ld-btn-ghost" asp-action="Calendario"><i class="fa-solid fa-calendar-days"></i>Calendario</a>
                </div>
            </div>
            <div data-nsq-style-id="nsq-si-ab0af48fd7">
                <div class="ld-state">
                    <i class="fa-solid @Model.EstadoGeneralIcono"></i>
                    @Model.EstadoGeneral
                </div>
                <small data-nsq-style-id="nsq-si-20b8767891">Estatus operativo: @Model.Estatus</small>
            </div>
        </div>
    </section>

    @if (TempData["LogisticaOk"] != null)
    {
        <div class="alert alert-success rounded-4 fw-bold mb-0">
            <i class="fa-solid fa-circle-check me-2"></i>@TempData["LogisticaOk"]
        </div>
    }

    @if (TempData["LogisticaError"] != null)
    {
        <div class="alert alert-danger rounded-4 fw-bold mb-0">
            <i class="fa-solid fa-triangle-exclamation me-2"></i>@TempData["LogisticaError"]
        </div>
    }


    <section class="ld-control-grid">
        <div class="ld-control-card">
            <span class="ld-control-label">Estado general</span>
            <div class="ld-executive-state">
                <strong>@Model.EstadoGeneral</strong>
                <span class="ld-pill ld-pill-@EstadoColor(Model.EstadoGeneral)">
                    <i class="fa-solid @Model.EstadoGeneralIcono"></i>
                    @Model.Estatus
                </span>
            </div>

            <div class="ld-big-progress">
                <div data-nsq-style="width:@Math.Clamp(Model.PorcentajeAvance, 0, 100)%"></div>
            </div>
            <div class="ld-progress-row">
                <span>Avance integral del embarque</span>
                <strong>@Model.PorcentajeAvance%</strong>
            </div>

            @if (!string.IsNullOrWhiteSpace(Model.MensajeRiesgo))
            {
                <div class="ld-risk-box @(Model.CargaAtrasada || Model.EntregaAtrasada ? "ld-risk-danger" : "ld-risk-warning")">
                    <i class="fa-solid fa-triangle-exclamation me-1"></i>@Model.MensajeRiesgo
                </div>
            }
        </div>

        <div class="ld-control-card">
            <span class="ld-control-label">Próxima acción</span>
            <div class="ld-next-action">
                <div class="ld-next-icon"><i class="fa-solid fa-arrow-right-long"></i></div>
                <div>
                    <strong>@Model.ProximaAccion</strong>
                    <div class="ld-control-copy">@Model.ProximaAccionDetalle</div>
                </div>
            </div>
        </div>

        <div class="ld-control-card">
            <span class="ld-control-label">Control operativo</span>
            <div class="ld-executive-state">
                <strong>@checklistCompletos/@checklistTotal</strong>
                <span class="ld-pill @(Model.IncidenciasCriticas > 0 ? "ld-pill-danger" : Model.IncidenciasAbiertas > 0 ? "ld-pill-warning" : "ld-pill-success")">
                    <i class="fa-solid fa-triangle-exclamation"></i>
                    @Model.IncidenciasAbiertas incidencia(s)
                </span>
            </div>
            <div class="ld-control-copy">
                @(Model.IncidenciasCriticas > 0
                                ? $"Hay {Model.IncidenciasCriticas} incidencia(s) crítica(s) que bloquean la salida."
                                : "Sin incidencias críticas que bloqueen la operación.")
            </div>
        </div>
    </section>

    <section class="ld-timeline">
        <div class="ld-timeline-track">
            @for (var i = 0; i < pasos.Length; i++)
            {
                var step = pasos[i];
                var done = indiceActual >= 0 && i < indiceActual;
                var current = Model.Estatus == step;
                <div class="ld-step @(done ? "done" : "") @(current ? "current" : "")">
                    <span class="ld-step-dot">
                        <i class="fa-solid @(done ? "fa-check" : current ? "fa-location-dot" : "fa-circle")"></i>
                    </span>
                    <strong>@step</strong>
                </div>
            }
        </div>
    </section>

    <section class="ld-summary">
        <div class="ld-summary-item">
            <span>Carga programada</span>
            <strong>@Fecha(Model.FechaCargaProgramada)</strong>
            <small>@Hora(Model.HoraCargaProgramada)</small>
        </div>
        <div class="ld-summary-item">
            <span>Entrega programada</span>
            <strong>@Fecha(Model.FechaEntregaProgramada)</strong>
            <small>@Hora(Model.HoraEntregaProgramada)</small>
        </div>
        <div class="ld-summary-item">
            <span>Carga real</span>
            <strong>@FechaHora(Model.FechaCarga)</strong>
        </div>
        <div class="ld-summary-item">
            <span>Salida real</span>
            <strong>@FechaHora(Model.FechaSalida)</strong>
        </div>
        <div class="ld-summary-item">
            <span>Preparado</span>
            <strong>@totalAsignado.ToString("N0") / @totalSolicitado.ToString("N0")</strong>
            <small>@totalCajas caja(s)</small>
        </div>
        <div class="ld-summary-item">
            <span>Despachado</span>
            <strong>@totalDespachado.ToString("N0") PZA</strong>
        </div>

    </section>

    <section class="ld-panel">
        <div class="ld-panel-head">
            <div class="ld-panel-title">
                <div class="ld-panel-icon"><i class="fa-solid fa-list-check"></i></div>
                <div>
                    <h2>Checklist operativo de salida</h2>
                    <small>Validaciones que deben cumplirse antes de liberar el embarque.</small>
                </div>
            </div>
            <span class="ld-pill @(checklistCompletos == checklistTotal ? "ld-pill-success" : "ld-pill-warning")">
                @checklistCompletos de @checklistTotal completos
            </span>
        </div>
        <div class="ld-panel-body">
            @if (Model.Checklist.Any())
            {
                <div class="ld-checklist">
                    @foreach (var item in Model.Checklist)
                    {
                        <div class="ld-check-item @(item.Completo ? "ld-check-ok" : "ld-check-no")">
                            <div class="ld-check-icon">
                                <i class="fa-solid @(item.Completo ? "fa-check" : "fa-xmark")"></i>
                            </div>
                            <div>
                                <strong>@item.Concepto</strong>
                                <small>@item.Descripcion</small>
                            </div>
                        </div>
                    }
                </div>
            }
            else
            {
                <div class="ld-empty-inline">No hay validaciones configuradas para este embarque.</div>
            }
        </div>
    </section>

    <section class="ld-panel">
        <div class="ld-panel-head">
            <div class="ld-panel-title">
                <div class="ld-panel-icon"><i class="fa-solid fa-boxes-stacked"></i></div>
                <div>
                    <h2>Partidas y producto terminado</h2>
                    <small>Release, OF, cajas reservadas y disponibilidad PT.</small>
                </div>
            </div>
        </div>

        <div class="ld-panel-body">
            <div class="ld-part-list">
                @foreach (var p in Model.Partidas)
                {
                    var pct = p.CantidadSolicitada <= 0 ? 0 : Math.Min(100, (int)Math.Round(p.CantidadAsignada * 100d / p.CantidadSolicitada));
                    var disponibles = Model.CajasDisponibles.Where(x => x.EmbarqueDetalleID == p.EmbarqueDetalleID).ToList();
                    var asignadas = Model.CajasAsignadas.Where(x => x.EmbarqueDetalleID == p.EmbarqueDetalleID).ToList();
                    var partidaCompleta = p.CantidadSolicitada > 0 && p.CantidadAsignada == p.CantidadSolicitada;

                    <article class="ld-part">
                        <div class="ld-part-head">
                            <div>
                                <small>@p.FolioRelease · Entrega @Fecha(p.FechaEntregaRelease)</small>
                                <h3>@p.NumeroParte</h3>
                                <p>@p.Descripcion</p>
                            </div>
                            <span class="ld-of">@(string.IsNullOrWhiteSpace(p.NumeroOF) ? "OF PENDIENTE" : p.NumeroOF)</span>
                        </div>

                        <div class="ld-part-body">
                            <div class="ld-progress @(partidaCompleta ? "complete" : "")">
                                <div data-nsq-style="width:@pct%"></div>
                            </div>

                            <div class="ld-progress-row">
                                <span>Preparado: @p.CantidadAsignada.ToString("N0") / @p.CantidadSolicitada.ToString("N0") PZA</span>
                                <strong>Pendiente @p.PendienteAsignar.ToString("N0")</strong>
                            </div>

                            @if (asignadas.Any())
                            {
                                <div class="ld-boxes">
                                    @foreach (var c in asignadas)
                                    {
                                        <div class="ld-box">
                                            <div>
                                                <strong>Lote @(string.IsNullOrWhiteSpace(c.Lote) ? c.Etiqueta : c.Lote)</strong>
                                                <small>@c.CantidadAsignada.ToString("N0") PZA · @c.NumeroParte · OF @c.NumeroOF · @c.Estatus</small>
                                                <small>Etiqueta @c.Etiqueta · Caja interna #@c.NumeroCaja</small>
                                            </div>

                                            @if (editable && c.Estatus != "Despachada")
                                            {
                                                <form asp-action="LiberarCaja" method="post">
                                                    @Html.AntiForgeryToken()
                                                    <input type="hidden" name="embarqueId" value="@Model.EmbarqueID" />
                                                    <input type="hidden" name="embarqueCajaId" value="@c.EmbarqueCajaID" />
                                                    <button class="ld-link-danger" type="submit">Liberar</button>
                                                </form>
                                            }
                                        </div>
                                    }
                                </div>
                            }

                            @if (editable)
                            {
                                <div class="ld-available">
                                    <h4>Lotes PT disponibles de esta OF</h4>

                                    @foreach (var c in disponibles)
                                    {
                                        <form asp-action="ReservarCaja" method="post" class="ld-available-row">
                                            @Html.AntiForgeryToken()
                                            <input type="hidden" name="embarqueId" value="@Model.EmbarqueID" />
                                            <input type="hidden" name="embarqueDetalleId" value="@p.EmbarqueDetalleID" />
                                            <input type="hidden" name="cajaId" value="@c.CajaID" />

                                            <div>
                                                <strong>Lote @(string.IsNullOrWhiteSpace(c.Lote) ? c.Etiqueta : c.Lote)</strong>
                                                <small>@c.Disponible.ToString("N0") PZA · @(string.IsNullOrWhiteSpace(c.Ubicacion) ? "Sin ubicación" : c.Ubicacion) · OF @c.NumeroOF</small>
                                                <small>Etiqueta @c.Etiqueta</small>
                                            </div>

                                            <button class="ld-btn ld-btn-sm" type="submit" disabled="@(c.Disponible > p.PendienteAsignar)">
                                                <i class="fa-solid fa-plus"></i>Reservar
                                            </button>
                                        </form>
                                    }

                                    @if (!disponibles.Any())
                                    {
                                        <div class="ld-empty-inline">
                                            @(p.SolicitudProduccionID.HasValue
                                                                            ? "No hay lotes PT liberados y disponibles para esta OF."
                                                                            : "La entrega todavía no tiene OF; no se pueden reservar cajas.")
                            </div>
                                                        }
                                </div>
                            }
                        </div>
                    </article>
                }
            </div>
        </div>
    </section>

    @if (editable && Model.DemandasDisponibles.Any())
    {
        <section class="ld-panel">
            <div class="ld-panel-head">
                <div class="ld-panel-title">
                    <div class="ld-panel-icon"><i class="fa-solid fa-layer-group"></i></div>
                    <div>
                        <h2>Consolidar carga</h2>
                        <small>Agrega otra entrega pendiente del mismo cliente al embarque actual.</small>
                    </div>
                </div>
            </div>

            <div class="ld-panel-body">
                <form asp-action="AgregarDetalle" method="post" class="ld-inline-form">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="EmbarqueID" value="@Model.EmbarqueID" />

                    <select name="ReleaseDetalleID" required>
                        <option value="">Selecciona Release / parte / fecha</option>
                        @foreach (var d in Model.DemandasDisponibles)
                        {
                            <option value="@d.ReleaseDetalleID">
                                @d.FechaCarga?.ToString("dd/MM") → @d.FechaEntrega.ToString("dd/MM") · @d.FolioRelease · @d.NumeroParte · @(string.IsNullOrWhiteSpace(d.NumeroOF) ? "OF pendiente" : d.NumeroOF) · pendiente @d.PendienteProgramar
                            </option>
                        }
                    </select>

                    <input name="CantidadSolicitada" type="number" min="1" placeholder="Cantidad" required />

                    <button class="ld-btn ld-btn-primary" type="submit">
                        <i class="fa-solid fa-plus"></i>Agregar partida
                    </button>
                </form>
            </div>
        </section>
    }

    <section class="ld-panel">
        <div class="ld-panel-head">
            <div class="ld-panel-title">
                <div class="ld-panel-icon"><i class="fa-solid fa-truck"></i></div>
                <div>
                    <h2>Transporte y destino</h2>
                    <small>Datos de la carga y entrega programada.</small>
                </div>
            </div>
        </div>

        <dl class="ld-definition">
            <div>
                <dt>Destino</dt>
                <dd>@Model.Destino</dd>
            </div>
            <div>
                <dt>Dirección</dt>
                <dd>@(string.IsNullOrWhiteSpace(Model.DireccionEntrega) ? "—" : Model.DireccionEntrega)</dd>
            </div>
            <div>
                <dt>Ruta</dt>
                <dd>@(string.IsNullOrWhiteSpace(Model.Ruta) ? "Sin asignar" : Model.Ruta)</dd>
            </div>
            <div>
                <dt>Unidad</dt>
                <dd>@(string.IsNullOrWhiteSpace(Model.Unidad) ? "Sin asignar" : Model.Unidad)</dd>
            </div>
            <div>
                <dt>Operador</dt>
                <dd>@(string.IsNullOrWhiteSpace(Model.Operador) ? "Sin asignar" : Model.Operador)</dd>
            </div>
            <div>
                <dt>Entrega real</dt>
                <dd>@FechaHora(Model.FechaEntrega)</dd>
            </div>
            <div>
                <dt>Retorno de unidad</dt>
                <dd>@(Model.UnidadRetornada? FechaHora(Model.FechaRetornoUnidad) : Model.Estatus == "Entregado" && !string.IsNullOrWhiteSpace(Model.Unidad) ? "Pendiente" : "—")</dd>
            </div>
            <div>
                <dt>Kilometraje retorno</dt>
                <dd>@(Model.KilometrajeRetorno.HasValue ? $"{Model.KilometrajeRetorno.Value:N0} km" : "—")</dd>
            </div>
            <div>
                <dt>Registró retorno</dt>
                <dd>@(string.IsNullOrWhiteSpace(Model.UsuarioRetorno) ? "—" : Model.UsuarioRetorno)</dd>
            </div>
        </dl>
    </section>

    <section class="ld-panel">
        <div class="ld-panel-head">
            <div class="ld-panel-title">
                <div class="ld-panel-icon"><i class="fa-solid fa-paperclip"></i></div>
                <div>
                    <h2>Evidencias y documentación</h2>
                    <small>Fotografías y PDF de carga, salida, entrega o incidencias. Máximo 10 MB por archivo.</small>
                </div>
            </div>
            <span class="ld-pill @(Model.Evidencias.Any() ? "ld-pill-success" : "ld-pill-secondary")">
                <i class="fa-solid fa-file-shield"></i>@Model.Evidencias.Count evidencia(s)
            </span>
        </div>
        <div class="ld-panel-body">
            @if (Model.Estatus != "Cancelado")
            {
                <form asp-action="SubirEvidencia" method="post" enctype="multipart/form-data" class="ld-evidence-upload" id="formEvidencia">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="embarqueId" value="@Model.EmbarqueID" />
                    <label>
                        <span>Tipo de evidencia</span>
                        <select name="tipoEvidencia" required>
                            <option value="">Selecciona</option>
                            @if (Model.Estatus is "Preparado" or "Cargado" or "En ruta" or "Entregado")
                            {
                                <option value="Carga">Carga</option>
                            }
                            @if (Model.Estatus is "Cargado" or "En ruta" or "Entregado")
                            {
                                <option value="Salida">Salida</option>
                            }
                            @if (Model.Estatus is "En ruta" or "Entregado")
                            {
                                <option value="Entrega">Entrega</option>
                            }
                            <option value="Incidencia">Incidencia</option>
                        </select>
                    </label>
                    <label>
                        <span>Archivo</span>
                        <input type="file" name="archivo" accept=".jpg,.jpeg,.png,.pdf,image/jpeg,image/png,application/pdf" required />
                    </label>
                    <label class="ld-evidence-full">
                        <span>Observaciones</span>
                        <textarea name="observaciones" maxlength="1000" placeholder="Describe brevemente qué acredita esta evidencia."></textarea>
                    </label>
                    <button class="ld-btn ld-btn-primary" type="submit" id="btnSubirEvidencia">
                        <i class="fa-solid fa-cloud-arrow-up"></i>Subir evidencia
                    </button>
                </form>
            }
            else
            {
                <div class="ld-empty-inline" data-nsq-style-id="nsq-si-2b583d7389">
                    <i class="fa-solid fa-lock me-1"></i>El embarque está cancelado. Las evidencias existentes permanecen disponibles para auditoría.
                </div>
            }

            @if (Model.Evidencias.Any())
            {
                <div class="ld-evidence-list">
                    @foreach (var evidencia in Model.Evidencias)
                    {
                        <article class="ld-evidence-card">
                            <div class="ld-evidence-main">
                                <div class="ld-evidence-icon"><i class="fa-solid @evidencia.Icono"></i></div>
                                <div class="ld-evidence-info">
                                    <span class="ld-pill ld-pill-info">@evidencia.TipoEvidencia</span>
                                    <strong title="@evidencia.NombreOriginal">@evidencia.NombreOriginal</strong>
                                    <small>@evidencia.TamanoTexto · @evidencia.FechaCarga.ToString("dd/MM/yyyy HH:mm")</small>
                                    <small><i class="fa-regular fa-user me-1"></i>@(string.IsNullOrWhiteSpace(evidencia.UsuarioNombre) ? "Usuario no identificado" : evidencia.UsuarioNombre)</small>
                                    @if (!string.IsNullOrWhiteSpace(evidencia.Observaciones))
                                    {
                                        <p>@evidencia.Observaciones</p>
                                    }
                                    @if (Model.Estatus != "Cancelado")
                                    {
                                        <details class="ld-evidence-remove">
                                            <summary>Retirar evidencia</summary>
                                            <form asp-action="EliminarEvidencia" method="post">
                                                @Html.AntiForgeryToken()
                                                <input type="hidden" name="evidenciaId" value="@evidencia.EvidenciaID" />
                                                <input type="hidden" name="embarqueId" value="@Model.EmbarqueID" />
                                                <input name="motivo" maxlength="500" required placeholder="Motivo de retiro" />
                                                <button class="ld-btn ld-btn-danger ld-btn-sm" type="submit"><i class="fa-solid fa-trash-can-arrow-up"></i>Retirar</button>
                                            </form>
                                        </details>
                                    }
                                </div>
                            </div>
                            <div class="ld-evidence-actions">
                                <a class="ld-btn ld-btn-sm" asp-action="VerEvidencia" asp-route-id="@evidencia.EvidenciaID" target="_blank" rel="noopener">
                                    <i class="fa-solid fa-eye"></i>Ver
                                </a>
                                <a class="ld-btn ld-btn-sm" asp-action="DescargarEvidencia" asp-route-id="@evidencia.EvidenciaID">
                                    <i class="fa-solid fa-download"></i>Descargar
                                </a>
                            </div>
                        </article>
                    }
                </div>
            }
            else
            {
                <div class="ld-empty-inline">
                    <i class="fa-regular fa-folder-open me-1"></i>Aún no hay evidencias registradas para este embarque.
                </div>
            }
        </div>
    </section>


    <section class="ld-panel">
        <div class="ld-panel-head">
            <div class="ld-panel-title">
                <div class="ld-panel-icon"><i class="fa-solid fa-triangle-exclamation"></i></div>
                <div>
                    <h2>Incidencias</h2>
                    <small>Desviaciones, responsables y seguimiento del embarque.</small>
                </div>
            </div>
            @if (Model.Estatus != "Cancelado")
            {
                <button type="button" class="ld-btn ld-btn-primary ld-btn-sm" id="btnAbrirIncidencia">
                    <i class="fa-solid fa-plus"></i>Registrar incidencia
                </button>
            }
        </div>

        <div class="ld-panel-body">
            @if (Model.Incidencias.Any())
            {
                <div class="ld-incidence-grid">
                    @foreach (var incidencia in Model.Incidencias)
                    {
                        var abierta = incidencia.Estatus is "Abierta" or "En seguimiento";
                        var claseSeveridad = incidencia.Severidad switch
                        {
                            "Crítica" => "ld-pill-danger",
                            "Alta" => "ld-pill-danger",
                            "Media" => "ld-pill-warning",
                            "Baja" => "ld-pill-info",
                            _ => "ld-pill-secondary"
                        };

                        <article class="ld-incidence @(abierta ? "open" : "closed")">
                            <div class="ld-incidence-top">
                                <div>
                                    <div data-nsq-style-id="nsq-si-ef1d8849a2">
                                        <span class="ld-pill @claseSeveridad">@incidencia.Severidad</span>
                                        <span class="ld-pill @(abierta ? "ld-pill-warning" : "ld-pill-success")">@incidencia.Estatus</span>
                                    </div>
                                    <h3>@incidencia.Folio · @incidencia.Tipo</h3>
                                </div>

                                @if (abierta)
                                {
                                    <button type="button"
                                            class="ld-btn ld-btn-sm btnCerrarIncidencia"
                                            data-id="@incidencia.IncidenciaID"
                                            data-folio="@incidencia.Folio">
                                        <i class="fa-solid fa-check"></i>Cerrar
                                    </button>
                                }
                            </div>

                            <p>@incidencia.Descripcion</p>

                            <div class="ld-incidence-meta">
                                <span><i class="fa-regular fa-clock me-1"></i>@incidencia.FechaRegistro.ToString("dd/MM/yyyy HH:mm")</span>
                                <span><i class="fa-regular fa-user me-1"></i>@(string.IsNullOrWhiteSpace(incidencia.Responsable) ? "Sin responsable" : incidencia.Responsable)</span>
                                @if (incidencia.FechaCompromiso.HasValue)
                                {
                                    <span><i class="fa-regular fa-calendar me-1"></i>Compromiso @incidencia.FechaCompromiso.Value.ToString("dd/MM/yyyy HH:mm")</span>
                                }
                            </div>

                            @if (!string.IsNullOrWhiteSpace(incidencia.Solucion))
                            {
                                <div class="ld-incidence-solution">
                                    <i class="fa-solid fa-circle-check me-1"></i>
                                    <strong>Solución:</strong> @incidencia.Solucion
                                </div>
                            }
                        </article>
                    }
                </div>
            }
            else
            {
                <div class="ld-empty-inline">
                    <i class="fa-solid fa-circle-check me-1"></i>No hay incidencias registradas para este embarque.
                </div>
            }
        </div>
    </section>

    <section class="ld-actions-panel">
        @if (Model.Estatus is "Programado" or "Preparando")
        {
            <div class="ld-actions-row">
                <div class="ld-action-copy">
                    <strong>Preparación del embarque</strong>
                    <small>@(completo ? "Las cantidades reservadas cubren lo solicitado." : "Aún existen partidas pendientes de completar.")</small>
                </div>
                <div class="ld-action-buttons">
                    <form asp-action="MarcarPreparado" method="post">
                        @Html.AntiForgeryToken()
                        <input type="hidden" name="embarqueId" value="@Model.EmbarqueID" />
                        <button class="ld-btn ld-btn-primary" type="submit">
                            <i class="fa-solid fa-circle-check"></i>Confirmar preparación completa
                        </button>
                    </form>
                </div>
            </div>
        }
        else if (Model.Estatus == "Preparado")
        {
            <div class="ld-actions-row">
                <div class="ld-action-copy">
                    <strong>Confirmación de carga física</strong>
                    <small>Confirma que todas las cajas reservadas se encuentran físicamente en la unidad.</small>
                </div>
                <form asp-action="MarcarCargado" method="post">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="embarqueId" value="@Model.EmbarqueID" />
                    <button class="ld-btn ld-btn-primary" type="submit">
                        <i class="fa-solid fa-truck-ramp-box"></i>Confirmar carga física
                    </button>
                </form>
            </div>
        }
        else if (Model.Estatus == "Cargado")
        {
            <div class="ld-actions-row">
                <div class="ld-action-copy">
                    <strong>Validar salida</strong>
                    <small>La salida descuenta PT y cambia el embarque a En ruta.</small>
                </div>

                @if (puedeDespachar)
                {
                    <button type="button" class="ld-btn ld-btn-danger" id="btnAbrirDespacho">
                        <i class="fa-solid fa-truck-fast"></i>Validar salida y descontar PT
                    </button>
                }
                else
                {
                    <button type="button" class="ld-btn" disabled>
                        <i class="fa-solid fa-lock"></i>Salida bloqueada
                    </button>
                }
            </div>

            @if (!puedeDespachar)
            {
                <div class="ld-blocked">
                    <i class="fa-solid fa-lock me-1"></i>
                    La salida está bloqueada. Revisa ruta, unidad, operador, preparación, carga e incidencias críticas en el checklist superior.
                </div>
            }
        }
        else if (Model.Estatus == "En ruta")
        {
            <form asp-action="Entregar" method="post" class="ld-form-grid">
                @Html.AntiForgeryToken()
                <input type="hidden" name="EmbarqueID" value="@Model.EmbarqueID" />

                <label>
                    <span>Recibe</span>
                    <input name="ReceptorNombre" required placeholder="Nombre de quien recibe" />
                </label>

                <label>
                    <span>Remisión</span>
                    <input name="FolioRemision" placeholder="Folio remisión" />
                </label>

                <label>
                    <span>Observaciones</span>
                    <input name="Observaciones" placeholder="Observaciones de entrega" />
                </label>

                <button class="ld-btn ld-btn-primary" type="submit">
                    <i class="fa-solid fa-location-dot"></i>Confirmar entrega
                </button>
            </form>
        }
        else if (Model.Estatus == "Entregado")
        {
            @if (!string.IsNullOrWhiteSpace(Model.Unidad) && !Model.UnidadRetornada)
            {
                <div class="ld-actions-row" data-nsq-style-id="nsq-si-da12f2858b">
                    <div class="ld-action-copy">
                        <strong>Entrega confirmada · retorno pendiente</strong>
                        <small>El embarque permanece Entregado. Registra el retorno cuando la unidad vuelva a planta.</small>
                    </div>
                    <span class="ld-state" data-nsq-style-id="nsq-si-dfe675af77">
                        <i class="fa-solid fa-truck-arrow-right"></i>Retorno pendiente
                    </span>
                </div>

                <form asp-action="RegistrarRetorno" method="post" class="ld-form-grid" id="formRetornoUnidad">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="EmbarqueID" value="@Model.EmbarqueID" />

                    <label>
                        <span>Fecha y hora de retorno</span>
                        <input name="FechaRetorno" type="datetime-local" value="@DateTime.Now.ToString("yyyy-MM-ddTHH:mm")" required />
                    </label>

                    <label>
                        <span>Kilometraje <small data-nsq-style-id="nsq-si-c18652ee29">opcional</small></span>
                        <input name="KilometrajeRetorno" type="number" min="0" step="1" placeholder="Kilometraje al regreso" />
                    </label>

                    <label>
                        <span>Observaciones</span>
                        <input name="Observaciones" maxlength="1000" placeholder="Condición de unidad, novedad o comentario" />
                    </label>

                    <button class="ld-btn ld-btn-primary" type="submit" id="btnRegistrarRetorno">
                        <i class="fa-solid fa-warehouse"></i>Registrar retorno
                    </button>
                </form>
            }
            else
            {
                <div class="ld-actions-row">
                    <div class="ld-action-copy">
                        <strong>@(Model.UnidadRetornada ? "Ciclo logístico completado" : "Embarque entregado")</strong>
                        <small>
                            @(Model.UnidadRetornada
                                                ? $"La entrega está cerrada y la unidad retornó el {Model.FechaRetornoUnidad:dd/MM/yyyy HH:mm}."
                                                : "La entrega al cliente ya fue confirmada y no hay una unidad pendiente de retorno.")
                </small>
                @if (Model.UnidadRetornada && !string.IsNullOrWhiteSpace(Model.ObservacionesRetorno))
                        {
                            <small data-nsq-style-id="nsq-si-6f28f390d0">@Model.ObservacionesRetorno</small>
                        }
                    </div>
                    <span class="ld-state" data-nsq-style-id="nsq-si-b8aaa348ac">
                        <i class="fa-solid fa-circle-check"></i>@(Model.UnidadRetornada ? "Unidad retornada" : "Entregado")
                    </span>
                </div>
            }
        }

        @if (Model.Estatus is "Programado" or "Preparando" or "Preparado")
        {
            <details class="ld-cancel">
                <summary>Cancelar programación</summary>
                <form asp-action="Cancelar" method="post">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="embarqueId" value="@Model.EmbarqueID" />
                    <input name="motivo" required placeholder="Motivo de cancelación" />
                    <button class="ld-btn ld-btn-danger" type="submit">
                        <i class="fa-solid fa-ban"></i>Cancelar y liberar cajas
                    </button>
                </form>
            </details>
        }
    </section>

    <section class="ld-panel">
        <div class="ld-panel-head">
            <div class="ld-panel-title">
                <div class="ld-panel-icon"><i class="fa-solid fa-clock-rotate-left"></i></div>
                <div>
                    <h2>Trazabilidad</h2>
                    <small>Historial completo del embarque.</small>
                </div>
            </div>
        </div>

        <div class="ld-panel-body">
            @if (Model.Historial.Any())
            {
                <div class="ld-history">
                    @foreach (var h in Model.Historial)
                    {
                        <div class="ld-history-item">
                            <time>@h.Fecha.ToString("dd/MM/yyyy HH:mm")</time>
                            <strong>@h.Evento</strong>
                            @if (!string.IsNullOrWhiteSpace(h.EstadoAnterior) || !string.IsNullOrWhiteSpace(h.EstadoNuevo))
                            {
                                <span class="ld-history-state">@h.EstadoAnterior → @h.EstadoNuevo</span>
                            }
                            @if (!string.IsNullOrWhiteSpace(h.Observaciones))
                            {
                                <p>@h.Observaciones</p>
                            }
                            <small>@h.Usuario</small>
                        </div>
                    }
                </div>
            }
            else
            {
                <div class="ld-empty-inline">Todavía no hay eventos registrados en el historial.</div>
            }
        </div>
    </section>
</div>


@if (Model.Estatus != "Cancelado")
{
    <div class="ld-modal" id="modalIncidencia" aria-hidden="true">
        <div class="ld-modal-box">
            <div class="ld-modal-head">
                <h3><i class="fa-solid fa-triangle-exclamation me-2"></i>Registrar incidencia</h3>
                <button type="button" class="ld-modal-close" data-close-modal="modalIncidencia"><i class="fa-solid fa-xmark"></i></button>
            </div>

            <form asp-action="RegistrarIncidencia" method="post">
                @Html.AntiForgeryToken()
                <input type="hidden" name="EmbarqueID" value="@Model.EmbarqueID" />

                <div class="ld-modal-body">
                    <div class="ld-modal-grid">
                        <label class="ld-field">
                            <span>Tipo</span>
                            <select name="Tipo" required>
                                <option value="">Selecciona</option>
                                <option>Producto incompleto</option>
                                <option>Caja dañada</option>
                                <option>Unidad no disponible</option>
                                <option>Operador</option>
                                <option>Producción</option>
                                <option>Calidad</option>
                                <option>Transporte</option>
                                <option>Dirección / cliente</option>
                                <option>Retraso</option>
                                <option>Rechazo de entrega</option>
                                <option>Diferencia de cantidades</option>
                                <option>Otro</option>
                            </select>
                        </label>

                        <label class="ld-field">
                            <span>Severidad</span>
                            <select name="Severidad" required>
                                <option>Baja</option>
                                <option selected>Media</option>
                                <option>Alta</option>
                                <option>Crítica</option>
                            </select>
                        </label>

                        <label class="ld-field">
                            <span>Responsable</span>
                            <input name="Responsable" maxlength="200" placeholder="Persona o área responsable" />
                        </label>

                        <label class="ld-field">
                            <span>Fecha compromiso</span>
                            <input name="FechaCompromiso" type="datetime-local" />
                        </label>

                        <label class="ld-field ld-field-full">
                            <span>Descripción</span>
                            <textarea name="Descripcion" maxlength="1200" required placeholder="Describe qué ocurrió, afectación y acción necesaria."></textarea>
                        </label>
                    </div>
                </div>

                <div class="ld-modal-actions">
                    <button type="button" class="ld-btn" data-close-modal="modalIncidencia">Cancelar</button>
                    <button type="submit" class="ld-btn ld-btn-primary">
                        <i class="fa-solid fa-floppy-disk"></i>Registrar incidencia
                    </button>
                </div>
            </form>
        </div>
    </div>
}

<div class="ld-modal" id="modalCerrarIncidencia" aria-hidden="true">
    <div class="ld-modal-box">
        <div class="ld-modal-head">
            <h3><i class="fa-solid fa-circle-check me-2"></i>Cerrar incidencia</h3>
            <button type="button" class="ld-modal-close" data-close-modal="modalCerrarIncidencia"><i class="fa-solid fa-xmark"></i></button>
        </div>

        <form asp-action="CerrarIncidencia" method="post">
            @Html.AntiForgeryToken()
            <input type="hidden" name="EmbarqueID" value="@Model.EmbarqueID" />
            <input type="hidden" name="IncidenciaID" id="incidenciaCerrarId" />

            <div class="ld-modal-body">
                <div class="ld-empty-inline" id="incidenciaCerrarFolio">Incidencia</div>
                <label class="ld-field" data-nsq-style-id="nsq-si-56f4356299">
                    <span>Solución aplicada</span>
                    <textarea name="Solucion" maxlength="1200" required placeholder="Describe cómo quedó resuelta la incidencia."></textarea>
                </label>
            </div>

            <div class="ld-modal-actions">
                <button type="button" class="ld-btn" data-close-modal="modalCerrarIncidencia">Cancelar</button>
                <button type="submit" class="ld-btn ld-btn-primary">
                    <i class="fa-solid fa-check"></i>Cerrar incidencia
                </button>
            </div>
        </form>
    </div>
</div>

@if (Model.Estatus == "Cargado" && puedeDespachar)
{
    <div class="ld-confirm-modal" id="modalDespacho" aria-hidden="true">
        <div class="ld-confirm-box">
            <div class="ld-confirm-head">
                <h3><i class="fa-solid fa-triangle-exclamation me-2"></i>Confirmar salida</h3>
            </div>
            <div class="ld-confirm-body">
                Al confirmar, el embarque será despachado y se generarán los movimientos de salida que descuentan producto terminado. Esta operación debe realizarse únicamente cuando la unidad esté realmente saliendo.
            </div>
            <div class="ld-confirm-actions">
                <button type="button" class="ld-btn" id="btnCancelarDespacho">Volver</button>
                <form asp-action="Despachar" method="post" id="formDespachar">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="embarqueId" value="@Model.EmbarqueID" />
                    <button class="ld-btn ld-btn-danger" type="submit" id="btnConfirmarDespacho">
                        <i class="fa-solid fa-truck-fast"></i>Confirmar salida
                    </button>
                </form>
            </div>
        </div>
    </div>
}

<script>
    (() => {
        const modal=document.getElementById('modalDespacho');
        const abrir=document.getElementById('btnAbrirDespacho');
        const cerrar=document.getElementById('btnCancelarDespacho');
        const form=document.getElementById('formDespachar');
        const confirmar=document.getElementById('btnConfirmarDespacho');

        function mostrar(){
            if(!modal)return;
            modal.classList.add('show');
            modal.setAttribute('aria-hidden','false');
        }

        function ocultar(){
            if(!modal)return;
            modal.classList.remove('show');
            modal.setAttribute('aria-hidden','true');
        }

        abrir?.addEventListener('click',mostrar);
        cerrar?.addEventListener('click',ocultar);

        modal?.addEventListener('click',e=>{
            if(e.target===modal)ocultar();
        });

        form?.addEventListener('submit',()=>{
            if(confirmar){
                confirmar.disabled=true;
                confirmar.innerHTML='<i class="fa-solid fa-spinner fa-spin"></i>Despachando...';
            }
        });

        const abrirIncidencia=document.getElementById('btnAbrirIncidencia');
        const modalIncidencia=document.getElementById('modalIncidencia');
        const modalCerrarIncidencia=document.getElementById('modalCerrarIncidencia');
        const incidenciaCerrarId=document.getElementById('incidenciaCerrarId');
        const incidenciaCerrarFolio=document.getElementById('incidenciaCerrarFolio');
        const formEvidencia=document.getElementById('formEvidencia');
        const btnSubirEvidencia=document.getElementById('btnSubirEvidencia');
        const formRetornoUnidad=document.getElementById('formRetornoUnidad');
        const btnRegistrarRetorno=document.getElementById('btnRegistrarRetorno');

        formEvidencia?.addEventListener('submit',()=>{
            if(btnSubirEvidencia){
                btnSubirEvidencia.disabled=true;
                btnSubirEvidencia.innerHTML='<i class="fa-solid fa-spinner fa-spin"></i>Subiendo...';
            }
        });

        formRetornoUnidad?.addEventListener('submit',()=>{
            if(btnRegistrarRetorno){
                btnRegistrarRetorno.disabled=true;
                btnRegistrarRetorno.innerHTML='<i class="fa-solid fa-spinner fa-spin"></i>Registrando retorno...';
            }
        });

        function abrirModal(elemento){
            if(!elemento)return;
            elemento.classList.add('show');
            elemento.setAttribute('aria-hidden','false');
        }

        function cerrarModal(elemento){
            if(!elemento)return;
            elemento.classList.remove('show');
            elemento.setAttribute('aria-hidden','true');
        }

        abrirIncidencia?.addEventListener('click',()=>abrirModal(modalIncidencia));

        document.querySelectorAll('[data-close-modal]').forEach(btn=>{
            btn.addEventListener('click',()=>{
                const id=btn.getAttribute('data-close-modal');
                cerrarModal(document.getElementById(id));
            });
        });

        document.querySelectorAll('.btnCerrarIncidencia').forEach(btn=>{
            btn.addEventListener('click',()=>{
                if(incidenciaCerrarId) incidenciaCerrarId.value=btn.dataset.id || '';
                if(incidenciaCerrarFolio) incidenciaCerrarFolio.textContent=btn.dataset.folio || 'Incidencia';
                abrirModal(modalCerrarIncidencia);
            });
        });

        [modalIncidencia,modalCerrarIncidencia].forEach(m=>{
            m?.addEventListener('click',e=>{
                if(e.target===m)cerrarModal(m);
            });
        });

        document.addEventListener('keydown',e=>{
            if(e.key==='Escape'){
                ocultar();
                cerrarModal(modalIncidencia);
                cerrarModal(modalCerrarIncidencia);
            }
        });
    })();
</script>
