        }

        @@media(max-width:1150px) {
            .log-toolbar {
                grid-template-columns: 1fr 1fr 1fr
            }

            .log-control-grid {
                grid-template-columns: repeat(3,1fr);
            }

            .log-priority-list {
                grid-template-columns: repeat(2,1fr);
            }
        }

        @@media(max-width:760px) {
            .log-toolbar {
                grid-template-columns: 1fr
            }

            .log-control-grid,
            .log-priority-list {
                grid-template-columns: 1fr;
