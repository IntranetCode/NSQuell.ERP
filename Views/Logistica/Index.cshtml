                                <td><span class="log-main">@e.Cliente</span><span class="log-sub">@e.Destino</span></td>
                                <td>@Fecha(e.FechaCargaProgramada)</td>
                                <td>@Fecha(e.FechaEntregaProgramada)</td>
                                <td>@e.TotalCajas</td>
                                <td>@e.TotalPiezasDespachadas.ToString("N0")</td>
                                <td><span class="log-state st-entregado"><i class="fa-solid fa-circle-check"></i>Entregado</span></td>
                                <td><a class="log-btn" asp-action="Detalle" asp-route-id="@e.EmbarqueID"><i class="fa-solid fa-eye"></i>Ver</a></td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
        else
        {
            <div class="log-empty"><i class="fa-solid fa-box-archive"></i>No hay entregas confirmadas.</div>
        }
    </section>

    <section class="log-panel log-hidden" id="panelTodos">
        <div class="log-panel-head">
            <div class="log-panel-title">
                <i class="fa-solid fa-list"></i>
                <div>
                    <h2>Todos los embarques</h2>
                    <small>Vista completa del tablero logístico actual.</small>
                </div>
            </div>
        </div>

        @if (embarques.Any())
        {
            <div class="log-table-wrap">
                <table class="log-table">
                    <thead>
                        <tr>
                            <th>Folio</th>
                            <th>Carga</th>
                            <th>Entrega</th>
                            <th>Cliente / destino</th>
                            <th>Partidas</th>
                            <th>Cajas</th>
                            <th>Piezas</th>
                            <th>Estatus</th>
                            <th>Estado general</th>
                            <th></th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var e in embarques)
                        {
                            <tr>
                                <td>
                                    <span class="log-main">@e.Folio</span>@if(e.TieneIncidencia){
                                    <span class="log-incidence"><i class="fa-solid fa-triangle-exclamation me-1"></i>Incidencia</span>
                                }
                            </td>
                            <td><span class="log-main">@Fecha(e.FechaCargaProgramada)</span><span class="log-sub">@Hora(e.HoraCargaProgramada)</span></td>
                            <td><span class="log-main">@Fecha(e.FechaEntregaProgramada)</span><span class="log-sub">@Hora(e.HoraEntregaProgramada)</span></td>
                            <td><span class="log-main">@e.Cliente</span><span class="log-sub">@e.Destino</span></td>
                            <td>@e.TotalPartidas</td>
                            <td>@e.TotalCajas</td>
                            <td><span class="log-main">@e.TotalPiezasSolicitadas.ToString("N0")</span><span class="log-sub">Despachadas @e.TotalPiezasDespachadas.ToString("N0")</span></td>
                            <td><span class="log-state @EstadoClase(e.Estatus)"><i class="fa-solid @EstadoIcono(e.Estatus)"></i>@e.Estatus</span></td>
                            <td><span class="log-risk @RiesgoClase(e)"><i class="fa-solid @RiesgoIcono(e)"></i>@RiesgoTexto(e)</span></td>
                            <td><a class="log-btn" asp-action="Detalle" asp-route-id="@e.EmbarqueID"><i class="fa-solid fa-arrow-up-right-from-square"></i>Abrir</a></td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
                }
                else
        {
            <div class="log-empty"><i class="fa-solid fa-inbox"></i>No hay embarques registrados.</div>
        }
    </section>

    <section class="log-panel" id="panelResumenClientes">
        <div class="log-panel-head">
            <div class="log-panel-title">
                <i class="fa-solid fa-building"></i>
                <div>
                    <h2>Resumen por cliente</h2>
                    <small>Movimientos y cumplimiento acumulados del tablero logístico.</small>
                </div>
            </div>
        </div>

        @if (resumenClientes.Any())
        {
            <div class="log-table-wrap">
                <table class="log-table">
                    <thead>
                        <tr>
                            <th>Cliente</th>
                            <th>Embarques</th>
                            <th>Preparados</th>
                            <th>Cargados</th>
                            <th>En ruta</th>
                            <th>Entregados</th>
                            <th>Incidencias</th>
                            <th>Cajas</th>
                            <th>Piezas</th>
                            <th>A tiempo</th>
                            <th>Atrasadas</th>
                            <th>Cumplimiento</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var r in resumenClientes)
                        {
                            <tr>
                                <td><span class="log-main">@r.Cliente</span></td>
                                <td>@r.TotalEmbarques</td>
                                <td>@r.Preparados</td>
                                <td>@r.Cargados</td>
                                <td>@r.EnRuta</td>
                                <td>@r.Entregados</td>
                                <td>
                                    @if (r.ConIncidencia > 0)
                                    {
                                        <span class="log-incidence" data-nsq-style-id="nsq-si-d462248a40"><i class="fa-solid fa-circle-exclamation me-1"></i>@r.ConIncidencia</span>
                                    }
                                    else
                                    {
                                        <span>0</span>
                                    }
                                </td>
                                <td>@r.TotalCajas.ToString("N0")</td>
                                <td>@r.TotalPiezas.ToString("N0")</td>
                                <td>@r.EntregasATiempo</td>
                                <td>@r.EntregasAtrasadas</td>
                                <td><strong>@r.PorcentajeCumplimiento.ToString("N1")%</strong></td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
        else
        {
            <div class="log-empty">
                <i class="fa-solid fa-chart-simple"></i>
                El resumen por cliente aparecerá cuando el controlador cargue los indicadores logísticos.
            </div>
        }
    </section>
</div>

<script>
    (() => {
        const botones=document.querySelectorAll('[data-panel]');
        const paneles={
            pendientes:document.getElementById('panelPendientes'),
            preparacion:document.getElementById('panelPreparacion'),
            listos:document.getElementById('panelListos'),
            ruta:document.getElementById('panelRuta'),
            entregados:document.getElementById('panelEntregados'),
            todos:document.getElementById('panelTodos')
        };

        function mostrarPanel(nombre){
            Object.entries(paneles).forEach(([clave,panel])=>{
                panel?.classList.toggle('log-hidden',clave!==nombre);
            });

            botones.forEach(btn=>{
                btn.classList.toggle('active',btn.dataset.panel===nombre);
            });

            try{
                sessionStorage.setItem('logistica.index.panel',nombre);
            }catch{}
        }

        botones.forEach(btn=>{
            btn.addEventListener('click',()=>mostrarPanel(btn.dataset.panel||'pendientes'));
        });

        let inicial='pendientes';

        try{
            const guardado=sessionStorage.getItem('logistica.index.panel');
            if(guardado&&paneles[guardado])inicial=guardado;
        }catch{}

        mostrarPanel(inicial);
    })();
</script>
