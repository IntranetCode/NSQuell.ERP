<div class="log-page">
    <section class="log-hero">
        <div class="log-hero-row">
            <div>
                <div class="log-kicker">Centro de operación logística</div>
                <h1>Programación, preparación y seguimiento de embarques</h1>
                <p>Administra releases pendientes, reserva producto terminado, prepara cargas y controla el avance hasta la entrega al cliente.</p>
            </div>
            <div class="log-actions">
                <a class="log-btn log-btn-hero" asp-action="Calendario"><i class="fa-solid fa-calendar-days"></i>Calendario</a>
                <a class="log-btn log-btn-hero" asp-action="Catalogos"><i class="fa-solid fa-route"></i>Rutas y unidades</a>
                <a class="log-btn log-btn-hero" asp-controller="AlmacenPT" asp-action="Cajas"><i class="fa-solid fa-warehouse"></i>Almacén PT</a>
            </div>
        </div>
    </section>

    @if (TempData["LogisticaOk"] != null)
    {
        <div class="alert alert-success rounded-4 fw-bold mb-0">
            <i class="fa-solid fa-circle-check me-2"></i>@TempData["LogisticaOk"]
        </div>
    }

    @if (TempData["LogisticaError"] != null)
    {
        <div class="alert alert-danger rounded-4 fw-bold mb-0">
            <i class="fa-solid fa-triangle-exclamation me-2"></i>@TempData["LogisticaError"]
        </div>
    }

    @if (ViewBag.ErrorConfiguracion != null)
    {
        <div class="alert alert-danger rounded-4 fw-bold mb-0">
            <i class="fa-solid fa-database me-2"></i>@ViewBag.ErrorConfiguracion
        </div>
    }

    <div class="log-strip" data-nsq-style-id="nsq-si-a3b88d64df">
        <span><strong>@preparados</strong> preparados</span>
        <span><strong>@cargados</strong> cargados</span>
        <span><strong>@enRuta</strong> en ruta</span>
        <span><strong>@entregados</strong> entregados</span>
        <span><strong>@conIncidenciaTotal</strong> con incidencia</span>
        <span><strong>@cajasMovilizadas.ToString("N0")</strong> cajas movilizadas</span>
        <span><strong>@piezasMovilizadas.ToString("N0")</strong> piezas movilizadas</span>
        @if (Model.EntregasAtrasadas > 0)
        {
            <span class="danger"><i class="fa-solid fa-triangle-exclamation me-1"></i><strong>@Model.EntregasAtrasadas</strong> entrega(s) atrasada(s)</span>
        }
    </div>

    <div class="log-operational-nav">
        <button type="button" class="log-nav-btn active" data-panel="pendientes">
            <i class="fa-solid fa-clock"></i>
            Por programar
            <span class="log-nav-count">@porProgramar</span>
        </button>

        <button type="button" class="log-nav-btn" data-panel="preparacion">
            <i class="fa-solid fa-boxes-packing"></i>
            Preparación
            <span class="log-nav-count">@enPreparacion</span>
        </button>

        <button type="button" class="log-nav-btn" data-panel="listos">
            <i class="fa-solid fa-truck-ramp-box"></i>
            Listos / cargados
            <span class="log-nav-count">@listos</span>
        </button>

        <button type="button" class="log-nav-btn" data-panel="ruta">
            <i class="fa-solid fa-truck-fast"></i>
            En ruta
            <span class="log-nav-count">@enRuta</span>
        </button>

        <button type="button" class="log-nav-btn" data-panel="entregados">
            <i class="fa-solid fa-circle-check"></i>
            Entregados
            <span class="log-nav-count">@entregados</span>
        </button>

        <button type="button" class="log-nav-btn" data-panel="todos">
            <i class="fa-solid fa-list"></i>
            Todos
            <span class="log-nav-count">@embarques.Count</span>
        </button>
    </div>

    <section class="log-panel" id="panelPendientes">
        <div class="log-panel-head">
            <div class="log-panel-title">
                <i class="fa-solid fa-clipboard-list"></i>
                <div>
                    <h2>Releases pendientes de programación</h2>
                    <small>@tituloPeriodoProgramacion</small>
                </div>
            </div>
            <div class="log-panel-actions">
                <a class="log-btn" asp-controller="PlaneacionRelease" asp-action="Index">
                    <i class="fa-solid fa-file-lines"></i>Ver releases
                </a>
            </div>
        </div>

        <div class="log-period-wrap">
            <div class="log-period-left">
                <a asp-action="Index" asp-route-periodo="vencidos" class="log-period-btn @(periodoProgramacion == "vencidos" ? "active danger" : "")">
                    <i class="fa-solid fa-triangle-exclamation"></i>Vencidos
                </a>
                <a asp-action="Index" asp-route-periodo="hoy" class="log-period-btn @(periodoProgramacion == "hoy" ? "active" : "")">
                    <i class="fa-solid fa-calendar-day"></i>Hoy
                </a>
                <a asp-action="Index" asp-route-periodo="semana" class="log-period-btn @(periodoProgramacion == "semana" ? "active" : "")">
                    <i class="fa-solid fa-calendar-week"></i>Esta semana
                </a>
                <a asp-action="Index" asp-route-periodo="mes" class="log-period-btn @(periodoProgramacion == "mes" ? "active" : "")">
                    <i class="fa-solid fa-calendar"></i>Este mes
                </a>
            </div>
            <form asp-action="Index" method="get" class="log-month-form">
                <input type="hidden" name="periodo" value="seleccionar_mes" />
                <select class="log-select" name="mes" aria-label="Mes">
                    @for (var i = 1; i <= 12; i++)
                    {
                        <option value="@i" selected="@(i == mesSeleccionado ? "selected" : null)">@mesesProgramacion[i - 1]</option>
                    }
                </select>
                <select class="log-select year" name="anio" aria-label="Año">
                    @foreach (var year in aniosProgramacion)
                    {
                        <option value="@year" selected="@(year == anioSeleccionado ? "selected" : null)">@year</option>
                    }
                </select>
                <button type="submit" class="log-btn @(periodoProgramacion == "seleccionar_mes" ? "log-btn-primary" : "")">
                    <i class="fa-solid fa-magnifying-glass"></i>Ver mes
                </button>
            </form>
        </div>

        <div class="log-period-summary">
            <span><i class="fa-solid fa-filter me-1"></i><strong>@tituloPeriodoProgramacion</strong></span>
            <span>·</span>
            <span><strong>@porProgramar.ToString("N0")</strong> release(s) pendiente(s)</span>
            <span>·</span>
            <span><strong>@Model.PiezasPendientes.ToString("N0")</strong> PZA por programar</span>
            <span>·</span>
            <span><strong>@Model.PiezasPTListas.ToString("N0")</strong> PZA disponibles en PT</span>
        </div>

        @if (demandasPendientes.Any())
        {
            <div class="log-table-wrap">
                <table class="log-table">
                    <thead>
                        <tr>
                            <th>Carga sugerida</th>
                            <th>Entrega cliente</th>
                            <th>Cliente</th>
                            <th>Release</th>
                            <th>Parte / OF</th>
                            <th>Demanda</th>
                            <th>Disponibilidad PT</th>
                            <th></th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var d in demandasPendientes)
                        {
                            var fechaCarga = (d.FechaCarga ?? d.FechaEntrega.AddDays(-1)).Date;
                            var hoy = DateTime.Today;
                            var claseFecha = d.FechaEntrega.Date < hoy ? "late" : d.FechaEntrega.Date == hoy ? "today" : "";
                            var ptCompleto = d.PiezasPTDisponibles >= d.PendienteProgramar && d.PendienteProgramar > 0;
                            var ptParcial = d.PiezasPTDisponibles > 0 && !ptCompleto;
                            var clasePt = ptCompleto ? "ok" : ptParcial ? "partial" : "none";

                            <tr>
                                <td>
                                    <div class="log-deadline">
                                        <span class="log-main">@fechaCarga.ToString("dd/MM/yyyy")</span>
                                        <span class="log-sub">Fecha de carga</span>
                                    </div>
                                </td>
                                <td>
                                    <div class="log-deadline @claseFecha">
                                        <span class="log-main">@d.FechaEntrega.ToString("dd/MM/yyyy")</span>
                                        <span class="log-sub">Entrega requerida</span>
                                    </div>
                                </td>
                                <td>
                                    <span class="log-main">@d.Cliente</span>
                                </td>
                                <td>
                                    <span class="log-main">@d.FolioRelease</span>
                                    <span class="log-sub">Secuencia @(d.SecuenciaEntrega?.ToString() ?? "—")</span>
                                </td>
                                <td>
                                    <span class="log-main">@d.NumeroParte</span>
                                    <span class="log-sub">OF @(string.IsNullOrWhiteSpace(d.NumeroOF) ? "Sin OF" : d.NumeroOF)</span>
                                </td>
                                <td>
                                    <span class="log-main">@d.PendienteProgramar.ToString("N0") PZA</span>
                                    <span class="log-sub">Requeridas @d.CantidadRequerida.ToString("N0")</span>
                                </td>
                                <td>
                                    <span class="log-pt @clasePt">
                                        <i class="fa-solid @(ptCompleto ? "fa-circle-check" : ptParcial ? "fa-circle-half-stroke" : "fa-circle-xmark")"></i>
                                        @d.PiezasPTDisponibles.ToString("N0") PZA
                                    </span>
                                    <span class="log-sub">@d.CajasPTDisponibles caja(s) disponible(s)</span>
                                </td>
                                <td>
                                    <div class="log-mini-action">
                                        <a class="log-btn log-btn-primary" asp-action="Crear" asp-route-releaseDetalleId="@d.ReleaseDetalleID">
                                            <i class="fa-solid fa-calendar-plus"></i>Programar
                                        </a>
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
        else
        {
            <div class="log-empty">
                <i class="fa-solid fa-circle-check text-success"></i>
                No hay releases pendientes para el periodo seleccionado.
                <span class="log-sub">@tituloPeriodoProgramacion</span>
            </div>
        }
    </section>

    <section class="log-panel log-hidden" id="panelPreparacion">
        <div class="log-panel-head">
            <div class="log-panel-title">
                <i class="fa-solid fa-boxes-packing"></i>
                <div>
                    <h2>Embarques en preparación</h2>
                    <small>Programados o con cajas PT actualmente en reserva y preparación.</small>
                </div>
            </div>
        </div>

        @{
            var listaPreparacion = embarques.Where(x => x.Estatus == "Programado" || x.Estatus == "Preparando").ToList();
        }

        @if (listaPreparacion.Any())
        {
            <div class="log-table-wrap">
                <table class="log-table">
                    <thead>
                        <tr>
                            <th>Folio</th>
                            <th>Carga</th>
                            <th>Entrega</th>
                            <th>Cliente / destino</th>
                            <th>Partidas</th>
                            <th>Cajas</th>
                            <th>Piezas</th>
                            <th>Estatus</th>
                            <th></th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var e in listaPreparacion)
                        {
                            <tr>
                                <td>
                                    <span class="log-main">@e.Folio</span>
                                    @if (e.TieneIncidencia)
                                    {
                                        <span class="log-incidence"><i class="fa-solid fa-triangle-exclamation me-1"></i>Incidencia</span>
                                    }
                                </td>
                                <td><span class="log-main">@Fecha(e.FechaCargaProgramada)</span><span class="log-sub">@Hora(e.HoraCargaProgramada)</span></td>
                                <td><span class="log-main">@Fecha(e.FechaEntregaProgramada)</span><span class="log-sub">@Hora(e.HoraEntregaProgramada)</span></td>
                                <td><span class="log-main">@e.Cliente</span><span class="log-sub">@e.Destino</span></td>
                                <td>@e.TotalPartidas</td>
                                <td>@e.TotalCajas</td>
                                <td><span class="log-main">@e.TotalPiezasSolicitadas.ToString("N0")</span><span class="log-sub">Despachadas @e.TotalPiezasDespachadas.ToString("N0")</span></td>
                                <td><span class="log-state @EstadoClase(e.Estatus)"><i class="fa-solid @EstadoIcono(e.Estatus)"></i>@e.Estatus</span></td>
                                <td><a class="log-btn" asp-action="Detalle" asp-route-id="@e.EmbarqueID"><i class="fa-solid fa-arrow-up-right-from-square"></i>Abrir</a></td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
        else
        {
            <div class="log-empty"><i class="fa-solid fa-box-open"></i>No hay embarques en preparación.</div>
        }
