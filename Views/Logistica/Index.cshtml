@using ERP.NSQuell.Models.ViewModels.Logistica
@model LogisticaIndexVm
@{
    Layout = "~/Views/Shared/_Layout.cshtml";
    ViewData["Title"] = "Operación Logística";

    string Fecha(DateTime? value) => value?.ToString("dd/MM/yyyy") ?? "—";
    string Hora(TimeSpan? value) => value?.ToString(@"hh\:mm") ?? "";
    string EstadoClase(string? estado)
    {
        var e = (estado ?? "").Trim().ToUpperInvariant();
        return e switch
        {
            "PROGRAMADO" => "st-programado",
            "PREPARANDO" => "st-preparando",
            "PREPARADO" => "st-preparado",
            "CARGADO" => "st-cargado",
            "EN RUTA" => "st-ruta",
            "ENTREGADO" => "st-entregado",
            "CANCELADO" => "st-cancelado",
            _ => "st-default"
        };
    }

    string EstadoIcono(string? estado)
    {
        var e = (estado ?? "").Trim().ToUpperInvariant();
        return e switch
        {
            "PROGRAMADO" => "fa-calendar-check",
            "PREPARANDO" => "fa-boxes-packing",
            "PREPARADO" => "fa-circle-check",
            "CARGADO" => "fa-truck-ramp-box",
            "EN RUTA" => "fa-truck-fast",
            "ENTREGADO" => "fa-location-dot",
            "CANCELADO" => "fa-ban",
            _ => "fa-circle"
        };
    }

    var demandasPendientes = (Model.Demandas ?? new List<LogisticaDemandaVm>())
        .Where(x => x.PendienteProgramar > 0)
        .OrderBy(x => (x.FechaCarga ?? x.FechaEntrega.AddDays(-1)).Date)
        .ThenBy(x => x.Cliente)
        .ThenBy(x => x.NumeroParte)
        .ToList();

    var embarques = (Model.Embarques ?? new List<LogisticaEmbarqueResumenVm>())
        .OrderBy(x => x.Estatus == "Entregado" || x.Estatus == "Cancelado" ? 1 : 0)
        .ThenBy(x => x.FechaCargaProgramada ?? DateTime.MaxValue)
        .ThenBy(x => x.HoraCargaProgramada)
        .ThenBy(x => x.Cliente)
        .ToList();

    var porProgramar = demandasPendientes.Count;
    var enPreparacion = embarques.Count(x => x.Estatus == "Programado" || x.Estatus == "Preparando");
    var listos = embarques.Count(x => x.Estatus == "Preparado" || x.Estatus == "Cargado");
    var enRuta = embarques.Count(x => x.Estatus == "En ruta");
    var entregados = embarques.Count(x => x.Estatus == "Entregado");
    var preparados = embarques.Count(x => x.Estatus == "Preparado");
    var cargados = embarques.Count(x => x.Estatus == "Cargado");
    var conIncidenciaTotal = embarques.Count(x => x.TieneIncidencia);
    var cajasMovilizadas = embarques
        .Where(x => x.Estatus is "Cargado" or "En ruta" or "Entregado")
        .Sum(x => (long)x.TotalCajas);
    var piezasMovilizadas = embarques.Sum(x => (long)x.TotalPiezasDespachadas);
    var resumenClientes = Model.ResumenClientes ?? new List<LogisticaResumenClienteVm>();

    DateTime? Combinar(DateTime? fecha, TimeSpan? hora)
        => fecha?.Date.Add(hora ?? TimeSpan.Zero);

    string RiesgoTexto(LogisticaEmbarqueResumenVm e)
    {
        if (e.Estatus == "Cancelado") return "Cancelado";
        if (e.Estatus == "Entregado") return "Entregado";

        var ahora = DateTime.Now;
        var carga = Combinar(e.FechaCargaProgramada, e.HoraCargaProgramada);
        var entrega = Combinar(e.FechaEntregaProgramada, e.HoraEntregaProgramada);

        if (entrega.HasValue && ahora > entrega.Value) return "Atrasado";
        if (carga.HasValue && e.Estatus is "Programado" or "Preparando" or "Preparado" && ahora > carga.Value) return "Atrasado";
        if (e.TieneIncidencia) return "En riesgo";
        if (carga.HasValue && e.Estatus is "Programado" or "Preparando" && carga.Value > ahora && (carga.Value - ahora).TotalMinutes <= 60) return "En riesgo";
        if (entrega.HasValue && e.Estatus != "En ruta" && entrega.Value > ahora && (entrega.Value - ahora).TotalMinutes <= 120) return "En riesgo";

        return "En tiempo";
    }

    string RiesgoClase(LogisticaEmbarqueResumenVm e)
        => RiesgoTexto(e) switch
        {
            "Atrasado" => "risk-danger",
            "En riesgo" => "risk-warning",
            "Entregado" => "risk-success",
            "Cancelado" => "risk-muted",
            _ => "risk-success"
        };

    string RiesgoIcono(LogisticaEmbarqueResumenVm e)
        => RiesgoTexto(e) switch
        {
            "Atrasado" => "fa-triangle-exclamation",
            "En riesgo" => "fa-clock",
            "Entregado" => "fa-circle-check",
            "Cancelado" => "fa-ban",
            _ => "fa-circle-check"
        };

    var activos = embarques.Where(x => x.Estatus is not "Entregado" and not "Cancelado").ToList();
    var atrasados = activos.Count(x => RiesgoTexto(x) == "Atrasado");
    var enRiesgo = activos.Count(x => RiesgoTexto(x) == "En riesgo");
    var conIncidencia = activos.Count(x => x.TieneIncidencia);
    var enTiempo = activos.Count(x => RiesgoTexto(x) == "En tiempo");
}

@section Styles {
    <link rel="stylesheet" href="~/css/logistica.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/Logistica/index.css" asp-append-version="true" />
}


@await Html.PartialAsync("_LogisticaNavegacion")


<div class="log-page">
    <section class="log-hero">
        <div class="log-hero-row">
            <div>
                <div class="log-kicker">Centro de operación logística</div>
                <h1>Programación, preparación y seguimiento de embarques</h1>
                <p>Administra releases pendientes, reserva producto terminado, prepara cargas y controla el avance hasta la entrega al cliente.</p>
            </div>
            <div class="log-actions">
                <a class="log-btn log-btn-hero" asp-action="Calendario"><i class="fa-solid fa-calendar-days"></i>Calendario</a>
                <a class="log-btn log-btn-hero" asp-action="Catalogos"><i class="fa-solid fa-route"></i>Rutas y unidades</a>
                <a class="log-btn log-btn-hero" asp-controller="AlmacenPT" asp-action="Cajas"><i class="fa-solid fa-warehouse"></i>Almacén PT</a>
            </div>
        </div>
    </section>

    @if (TempData["LogisticaOk"] != null)
    {
        <div class="alert alert-success rounded-4 fw-bold mb-0">
            <i class="fa-solid fa-circle-check me-2"></i>@TempData["LogisticaOk"]
        </div>
    }

    @if (TempData["LogisticaError"] != null)
    {
        <div class="alert alert-danger rounded-4 fw-bold mb-0">
            <i class="fa-solid fa-triangle-exclamation me-2"></i>@TempData["LogisticaError"]
        </div>
    }

    @if (ViewBag.ErrorConfiguracion != null)
    {
        <div class="alert alert-danger rounded-4 fw-bold mb-0">
            <i class="fa-solid fa-database me-2"></i>@ViewBag.ErrorConfiguracion
        </div>
    }

    <div class="log-strip" data-nsq-style-id="nsq-si-a3b88d64df">
        <span><strong>@preparados</strong> preparados</span>
        <span><strong>@cargados</strong> cargados</span>
        <span><strong>@enRuta</strong> en ruta</span>
        <span><strong>@entregados</strong> entregados</span>
        <span><strong>@conIncidenciaTotal</strong> con incidencia</span>
        <span><strong>@cajasMovilizadas.ToString("N0")</strong> cajas movilizadas</span>
        <span><strong>@piezasMovilizadas.ToString("N0")</strong> piezas movilizadas</span>
        @if (Model.EntregasAtrasadas > 0)
        {
            <span class="danger"><i class="fa-solid fa-triangle-exclamation me-1"></i><strong>@Model.EntregasAtrasadas</strong> entrega(s) atrasada(s)</span>
        }
    </div>

    <div class="log-operational-nav">
        <button type="button" class="log-nav-btn active" data-panel="pendientes">
            <i class="fa-solid fa-clock"></i>
            Por programar
            <span class="log-nav-count">@porProgramar</span>
        </button>

        <button type="button" class="log-nav-btn" data-panel="preparacion">
            <i class="fa-solid fa-boxes-packing"></i>
            Preparación
            <span class="log-nav-count">@enPreparacion</span>
        </button>

        <button type="button" class="log-nav-btn" data-panel="listos">
            <i class="fa-solid fa-truck-ramp-box"></i>
            Listos / cargados
            <span class="log-nav-count">@listos</span>
        </button>

        <button type="button" class="log-nav-btn" data-panel="ruta">
            <i class="fa-solid fa-truck-fast"></i>
            En ruta
            <span class="log-nav-count">@enRuta</span>
        </button>

        <button type="button" class="log-nav-btn" data-panel="entregados">
            <i class="fa-solid fa-circle-check"></i>
            Entregados
            <span class="log-nav-count">@entregados</span>
        </button>

        <button type="button" class="log-nav-btn" data-panel="todos">
            <i class="fa-solid fa-list"></i>
            Todos
            <span class="log-nav-count">@embarques.Count</span>
        </button>
    </div>

    <section class="log-panel" id="panelPendientes">
        <div class="log-panel-head">
            <div class="log-panel-title">
                <i class="fa-solid fa-clipboard-list"></i>
                <div>
                    <h2>Releases pendientes de programación</h2>
                    <small>Demanda todavía no cubierta por un embarque logístico.</small>
                </div>
            </div>
            <div class="log-panel-actions">
                <a class="log-btn" asp-controller="PlaneacionRelease" asp-action="Index">
                    <i class="fa-solid fa-file-lines"></i>Ver releases
                </a>
            </div>
        </div>

        @if (demandasPendientes.Any())
        {
            <div class="log-table-wrap">
                <table class="log-table">
                    <thead>
                        <tr>
                            <th>Carga sugerida</th>
                            <th>Entrega cliente</th>
                            <th>Cliente</th>
                            <th>Release</th>
                            <th>Parte / OF</th>
                            <th>Demanda</th>
                            <th>Disponibilidad PT</th>
                            <th></th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var d in demandasPendientes)
                        {
                            var fechaCarga = (d.FechaCarga ?? d.FechaEntrega.AddDays(-1)).Date;
                            var hoy = DateTime.Today;
                            var claseFecha = d.FechaEntrega.Date < hoy ? "late" : d.FechaEntrega.Date == hoy ? "today" : "";
                            var ptCompleto = d.PiezasPTDisponibles >= d.PendienteProgramar && d.PendienteProgramar > 0;
                            var ptParcial = d.PiezasPTDisponibles > 0 && !ptCompleto;
                            var clasePt = ptCompleto ? "ok" : ptParcial ? "partial" : "none";

                            <tr>
                                <td>
                                    <div class="log-deadline">
                                        <span class="log-main">@fechaCarga.ToString("dd/MM/yyyy")</span>
                                        <span class="log-sub">Fecha de carga</span>
                                    </div>
                                </td>
                                <td>
                                    <div class="log-deadline @claseFecha">
                                        <span class="log-main">@d.FechaEntrega.ToString("dd/MM/yyyy")</span>
                                        <span class="log-sub">Entrega requerida</span>
                                    </div>
                                </td>
                                <td>
                                    <span class="log-main">@d.Cliente</span>
                                </td>
                                <td>
                                    <span class="log-main">@d.FolioRelease</span>
                                    <span class="log-sub">Secuencia @(d.SecuenciaEntrega?.ToString() ?? "—")</span>
                                </td>
                                <td>
                                    <span class="log-main">@d.NumeroParte</span>
                                    <span class="log-sub">OF @(string.IsNullOrWhiteSpace(d.NumeroOF) ? "Sin OF" : d.NumeroOF)</span>
                                </td>
                                <td>
                                    <span class="log-main">@d.PendienteProgramar.ToString("N0") PZA</span>
                                    <span class="log-sub">Requeridas @d.CantidadRequerida.ToString("N0")</span>
                                </td>
                                <td>
                                    <span class="log-pt @clasePt">
                                        <i class="fa-solid @(ptCompleto ? "fa-circle-check" : ptParcial ? "fa-circle-half-stroke" : "fa-circle-xmark")"></i>
                                        @d.PiezasPTDisponibles.ToString("N0") PZA
                                    </span>
                                    <span class="log-sub">@d.CajasPTDisponibles caja(s) disponible(s)</span>
                                </td>
                                <td>
                                    <div class="log-mini-action">
                                        <a class="log-btn log-btn-primary" asp-action="Crear" asp-route-releaseDetalleId="@d.ReleaseDetalleID">
                                            <i class="fa-solid fa-calendar-plus"></i>Programar
                                        </a>
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
        else
        {
            <div class="log-empty">
                <i class="fa-solid fa-circle-check text-success"></i>
                No hay releases pendientes de programación.
            </div>
        }
    </section>

    <section class="log-panel log-hidden" id="panelPreparacion">
        <div class="log-panel-head">
            <div class="log-panel-title">
                <i class="fa-solid fa-boxes-packing"></i>
                <div>
                    <h2>Embarques en preparación</h2>
                    <small>Programados o con cajas PT actualmente en reserva y preparación.</small>
                </div>
            </div>
        </div>

        @{
            var listaPreparacion = embarques.Where(x => x.Estatus == "Programado" || x.Estatus == "Preparando").ToList();
        }

        @if (listaPreparacion.Any())
        {
            <div class="log-table-wrap">
                <table class="log-table">
                    <thead>
                        <tr>
                            <th>Folio</th>
                            <th>Carga</th>
                            <th>Entrega</th>
                            <th>Cliente / destino</th>
                            <th>Partidas</th>
                            <th>Cajas</th>
                            <th>Piezas</th>
                            <th>Estatus</th>
                            <th></th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var e in listaPreparacion)
                        {
                            <tr>
                                <td>
                                    <span class="log-main">@e.Folio</span>
                                    @if (e.TieneIncidencia)
                                    {
                                        <span class="log-incidence"><i class="fa-solid fa-triangle-exclamation me-1"></i>Incidencia</span>
                                    }
                                </td>
                                <td><span class="log-main">@Fecha(e.FechaCargaProgramada)</span><span class="log-sub">@Hora(e.HoraCargaProgramada)</span></td>
                                <td><span class="log-main">@Fecha(e.FechaEntregaProgramada)</span><span class="log-sub">@Hora(e.HoraEntregaProgramada)</span></td>
                                <td><span class="log-main">@e.Cliente</span><span class="log-sub">@e.Destino</span></td>
                                <td>@e.TotalPartidas</td>
                                <td>@e.TotalCajas</td>
                                <td><span class="log-main">@e.TotalPiezasSolicitadas.ToString("N0")</span><span class="log-sub">Despachadas @e.TotalPiezasDespachadas.ToString("N0")</span></td>
                                <td><span class="log-state @EstadoClase(e.Estatus)"><i class="fa-solid @EstadoIcono(e.Estatus)"></i>@e.Estatus</span></td>
                                <td><a class="log-btn" asp-action="Detalle" asp-route-id="@e.EmbarqueID"><i class="fa-solid fa-arrow-up-right-from-square"></i>Abrir</a></td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
        else
        {
            <div class="log-empty"><i class="fa-solid fa-box-open"></i>No hay embarques en preparación.</div>
        }
    </section>

    <section class="log-panel log-hidden" id="panelListos">
        <div class="log-panel-head">
            <div class="log-panel-title">
                <i class="fa-solid fa-truck-ramp-box"></i>
                <div>
                    <h2>Listos para salida / cargados</h2>
                    <small>Embarques preparados o cuya carga física ya fue confirmada.</small>
                </div>
            </div>
        </div>

        @{
            var listaListos = embarques.Where(x => x.Estatus == "Preparado" || x.Estatus == "Cargado").ToList();
        }

        @if (listaListos.Any())
        {
            <div class="log-table-wrap">
                <table class="log-table">
                    <thead>
                        <tr>
                            <th>Folio</th>
                            <th>Carga</th>
                            <th>Entrega</th>
                            <th>Cliente / destino</th>
                            <th>Cajas</th>
                            <th>Piezas</th>
                            <th>Estatus</th>
                            <th></th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var e in listaListos)
                        {
                            <tr>
                                <td><span class="log-main">@e.Folio</span></td>
                                <td><span class="log-main">@Fecha(e.FechaCargaProgramada)</span><span class="log-sub">@Hora(e.HoraCargaProgramada)</span></td>
                                <td><span class="log-main">@Fecha(e.FechaEntregaProgramada)</span><span class="log-sub">@Hora(e.HoraEntregaProgramada)</span></td>
                                <td><span class="log-main">@e.Cliente</span><span class="log-sub">@e.Destino</span></td>
                                <td>@e.TotalCajas</td>
                                <td>@e.TotalPiezasSolicitadas.ToString("N0")</td>
                                <td><span class="log-state @EstadoClase(e.Estatus)"><i class="fa-solid @EstadoIcono(e.Estatus)"></i>@e.Estatus</span></td>
                                <td><a class="log-btn log-btn-primary" asp-action="Detalle" asp-route-id="@e.EmbarqueID"><i class="fa-solid fa-arrow-up-right-from-square"></i>Abrir</a></td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
        else
        {
            <div class="log-empty"><i class="fa-solid fa-truck-ramp-box"></i>No hay embarques listos o cargados.</div>
        }
    </section>

    <section class="log-panel log-hidden" id="panelRuta">
        <div class="log-panel-head">
            <div class="log-panel-title">
                <i class="fa-solid fa-truck-fast"></i>
                <div>
                    <h2>Embarques en ruta</h2>
                    <small>Salidas despachadas pendientes de confirmación de entrega.</small>
                </div>
            </div>
        </div>

        @{
            var listaRuta = embarques.Where(x => x.Estatus == "En ruta").ToList();
        }

        @if (listaRuta.Any())
        {
            <div class="log-table-wrap">
                <table class="log-table">
                    <thead>
                        <tr>
                            <th>Folio</th>
                            <th>Salida / carga</th>
                            <th>Entrega programada</th>
                            <th>Cliente</th>
                            <th>Destino</th>
                            <th>Cajas</th>
                            <th>Piezas despachadas</th>
                            <th></th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var e in listaRuta)
                        {
                            var atrasado = e.FechaEntregaProgramada.HasValue && e.FechaEntregaProgramada.Value.Date < DateTime.Today;
                            <tr>
                                <td>
                                    <span class="log-main">@e.Folio</span>@if(e.TieneIncidencia){
                                    <span class="log-incidence"><i class="fa-solid fa-triangle-exclamation me-1"></i>Incidencia</span>
                                }
                            </td>
                            <td><span class="log-main">@Fecha(e.FechaCargaProgramada)</span><span class="log-sub">@Hora(e.HoraCargaProgramada)</span></td>
                            <td>
                                <div class="log-deadline @(atrasado ? "late" : "")">
                                    <span class="log-main">@Fecha(e.FechaEntregaProgramada)</span>
                                    <span class="log-sub">@Hora(e.HoraEntregaProgramada)</span>
                                </div>
                            </td>
                            <td><span class="log-main">@e.Cliente</span></td>
                            <td>@e.Destino</td>
                            <td>@e.TotalCajas</td>
                            <td>@e.TotalPiezasDespachadas.ToString("N0")</td>
                            <td><a class="log-btn log-btn-primary" asp-action="Detalle" asp-route-id="@e.EmbarqueID"><i class="fa-solid fa-location-arrow"></i>Seguimiento</a></td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
                }
                else
        {
            <div class="log-empty"><i class="fa-solid fa-route"></i>No hay embarques actualmente en ruta.</div>
        }
    </section>

    <section class="log-panel log-hidden" id="panelEntregados">
        <div class="log-panel-head">
            <div class="log-panel-title">
                <i class="fa-solid fa-circle-check"></i>
                <div>
                    <h2>Entregas confirmadas</h2>
                    <small>Historial de embarques completados con recepción del cliente.</small>
                </div>
            </div>
        </div>

        @{
            var listaEntregados = embarques.Where(x => x.Estatus == "Entregado").ToList();
        }

        @if (listaEntregados.Any())
        {
            <div class="log-table-wrap">
                <table class="log-table">
                    <thead>
                        <tr>
                            <th>Folio</th>
                            <th>Cliente / destino</th>
                            <th>Carga programada</th>
                            <th>Entrega programada</th>
                            <th>Cajas</th>
                            <th>Piezas</th>
                            <th>Estatus</th>
                            <th></th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var e in listaEntregados)
                        {
                            <tr>
                                <td><span class="log-main">@e.Folio</span></td>
                                <td><span class="log-main">@e.Cliente</span><span class="log-sub">@e.Destino</span></td>
                                <td>@Fecha(e.FechaCargaProgramada)</td>
                                <td>@Fecha(e.FechaEntregaProgramada)</td>
                                <td>@e.TotalCajas</td>
                                <td>@e.TotalPiezasDespachadas.ToString("N0")</td>
                                <td><span class="log-state st-entregado"><i class="fa-solid fa-circle-check"></i>Entregado</span></td>
                                <td><a class="log-btn" asp-action="Detalle" asp-route-id="@e.EmbarqueID"><i class="fa-solid fa-eye"></i>Ver</a></td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
        else
        {
            <div class="log-empty"><i class="fa-solid fa-box-archive"></i>No hay entregas confirmadas.</div>
        }
    </section>

    <section class="log-panel log-hidden" id="panelTodos">
        <div class="log-panel-head">
            <div class="log-panel-title">
                <i class="fa-solid fa-list"></i>
                <div>
                    <h2>Todos los embarques</h2>
                    <small>Vista completa del tablero logístico actual.</small>
                </div>
            </div>
        </div>

        @if (embarques.Any())
        {
            <div class="log-table-wrap">
                <table class="log-table">
                    <thead>
                        <tr>
                            <th>Folio</th>
                            <th>Carga</th>
                            <th>Entrega</th>
                            <th>Cliente / destino</th>
                            <th>Partidas</th>
                            <th>Cajas</th>
                            <th>Piezas</th>
                            <th>Estatus</th>
                            <th>Estado general</th>
                            <th></th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var e in embarques)
                        {
                            <tr>
                                <td>
                                    <span class="log-main">@e.Folio</span>@if(e.TieneIncidencia){
                                    <span class="log-incidence"><i class="fa-solid fa-triangle-exclamation me-1"></i>Incidencia</span>
                                }
                            </td>
                            <td><span class="log-main">@Fecha(e.FechaCargaProgramada)</span><span class="log-sub">@Hora(e.HoraCargaProgramada)</span></td>
                            <td><span class="log-main">@Fecha(e.FechaEntregaProgramada)</span><span class="log-sub">@Hora(e.HoraEntregaProgramada)</span></td>
                            <td><span class="log-main">@e.Cliente</span><span class="log-sub">@e.Destino</span></td>
                            <td>@e.TotalPartidas</td>
                            <td>@e.TotalCajas</td>
                            <td><span class="log-main">@e.TotalPiezasSolicitadas.ToString("N0")</span><span class="log-sub">Despachadas @e.TotalPiezasDespachadas.ToString("N0")</span></td>
                            <td><span class="log-state @EstadoClase(e.Estatus)"><i class="fa-solid @EstadoIcono(e.Estatus)"></i>@e.Estatus</span></td>
                            <td><span class="log-risk @RiesgoClase(e)"><i class="fa-solid @RiesgoIcono(e)"></i>@RiesgoTexto(e)</span></td>
                            <td><a class="log-btn" asp-action="Detalle" asp-route-id="@e.EmbarqueID"><i class="fa-solid fa-arrow-up-right-from-square"></i>Abrir</a></td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
                }
                else
        {
            <div class="log-empty"><i class="fa-solid fa-inbox"></i>No hay embarques registrados.</div>
        }
    </section>

    <section class="log-panel" id="panelResumenClientes">
        <div class="log-panel-head">
            <div class="log-panel-title">
                <i class="fa-solid fa-building"></i>
                <div>
                    <h2>Resumen por cliente</h2>
                    <small>Movimientos y cumplimiento acumulados del tablero logístico.</small>
                </div>
            </div>
        </div>

        @if (resumenClientes.Any())
        {
            <div class="log-table-wrap">
                <table class="log-table">
                    <thead>
                        <tr>
                            <th>Cliente</th>
                            <th>Embarques</th>
                            <th>Preparados</th>
                            <th>Cargados</th>
                            <th>En ruta</th>
                            <th>Entregados</th>
                            <th>Incidencias</th>
                            <th>Cajas</th>
                            <th>Piezas</th>
                            <th>A tiempo</th>
                            <th>Atrasadas</th>
                            <th>Cumplimiento</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var r in resumenClientes)
                        {
                            <tr>
                                <td><span class="log-main">@r.Cliente</span></td>
                                <td>@r.TotalEmbarques</td>
                                <td>@r.Preparados</td>
                                <td>@r.Cargados</td>
                                <td>@r.EnRuta</td>
                                <td>@r.Entregados</td>
                                <td>
                                    @if (r.ConIncidencia > 0)
                                    {
                                        <span class="log-incidence" data-nsq-style-id="nsq-si-d462248a40"><i class="fa-solid fa-circle-exclamation me-1"></i>@r.ConIncidencia</span>
                                    }
                                    else
                                    {
                                        <span>0</span>
                                    }
                                </td>
                                <td>@r.TotalCajas.ToString("N0")</td>
                                <td>@r.TotalPiezas.ToString("N0")</td>
                                <td>@r.EntregasATiempo</td>
                                <td>@r.EntregasAtrasadas</td>
                                <td><strong>@r.PorcentajeCumplimiento.ToString("N1")%</strong></td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
        else
        {
            <div class="log-empty">
                <i class="fa-solid fa-chart-simple"></i>
                El resumen por cliente aparecerá cuando el controlador cargue los indicadores logísticos.
            </div>
        }
    </section>
</div>

<script>
    (() => {
        const botones=document.querySelectorAll('[data-panel]');
        const paneles={
            pendientes:document.getElementById('panelPendientes'),
            preparacion:document.getElementById('panelPreparacion'),
            listos:document.getElementById('panelListos'),
            ruta:document.getElementById('panelRuta'),
            entregados:document.getElementById('panelEntregados'),
            todos:document.getElementById('panelTodos')
        };

        function mostrarPanel(nombre){
            Object.entries(paneles).forEach(([clave,panel])=>{
                panel?.classList.toggle('log-hidden',clave!==nombre);
            });

            botones.forEach(btn=>{
                btn.classList.toggle('active',btn.dataset.panel===nombre);
            });

            try{
                sessionStorage.setItem('logistica.index.panel',nombre);
            }catch{}
        }

        botones.forEach(btn=>{
            btn.addEventListener('click',()=>mostrarPanel(btn.dataset.panel||'pendientes'));
        });

        let inicial='pendientes';

        try{
            const guardado=sessionStorage.getItem('logistica.index.panel');
            if(guardado&&paneles[guardado])inicial=guardado;
        }catch{}

        mostrarPanel(inicial);
    })();
</script>
