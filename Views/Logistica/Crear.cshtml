</style>

<div class="lc-page">
    @if (demanda == null)
    {
        <div class="lc-empty-state">
            <strong>No se pudo cargar la salida seleccionada.</strong>
            <a class="lc-btn lc-btn-primary" asp-action="Index">
                <i class="fa-solid fa-arrow-left"></i>Volver a operación
            </a>
        </div>
    }
    else
    {
        <section class="lc-titlebar">
            <div class="lc-title-row">
                <div>
                    <a class="lc-back" asp-action="Index">
                        <i class="fa-solid fa-arrow-left"></i>Operación logística
                    </a>
                    <span class="lc-eyebrow">Preparar salida</span>
                    <h1>@demanda.Cliente</h1>
                    <p>@demanda.NumeroParte · @(string.IsNullOrWhiteSpace(demanda.NumeroOF) ? "OF pendiente" : $"OF {demanda.NumeroOF}")</p>
                </div>
                <div class="lc-big-date">
                    <span>CARGA PROGRAMADA</span>
                    <strong>@Fecha(Model.FechaCargaProgramada)</strong>
                    <small>Entrega @Fecha(Model.FechaEntregaProgramada)</small>
                </div>
            </div>
        </section>

        <form asp-action="Crear" method="post" id="programacionRapidaForm" class="lc-layout">
            @Html.AntiForgeryToken()
            <input asp-for="ReleaseDetalleID" type="hidden" />
            <input asp-for="CantidadSolicitada" type="hidden" />
            <input asp-for="FechaCargaProgramada" type="hidden" />
            <input asp-for="FechaEntregaProgramada" type="hidden" />

            <section class="lc-board lc-main">
                <div asp-validation-summary="All" class="lc-validation"></div>

                <div class="lc-facts">
                    <div class="lc-fact">
                        <span>Release</span>
                        <b>@demanda.FolioRelease</b>
                    </div>
                    <div class="lc-fact">
                        <span>Parte</span>
                        <b>@demanda.NumeroParte</b>
                    </div>
                    <div class="lc-fact">
                        <span>OF</span>
                        <b>@(string.IsNullOrWhiteSpace(demanda.NumeroOF) ? "Sin OF vinculada" : demanda.NumeroOF)</b>
                    </div>
                    <div class="lc-fact">
                        <span>Pendiente</span>
                        <b>@demanda.PendienteProgramar.ToString("N0") PZA</b>
                    </div>
                </div>

                <div class="lc-section-head">
                    <div>
                        <span class="lc-eyebrow">Producto terminado compatible</span>
                        <h2>Selecciona las cajas que realmente van a salir</h2>
                    </div>
                    <div class="lc-selection @(seleccionCompleta ? "is-complete" : "")" id="selectionCounter">
                        <span>Seleccionado</span>
                        <strong id="selectedPieces">@piezasSugeridas.ToString("N0")</strong>
                        <small>/ @demanda.PendienteProgramar.ToString("N0") PZA</small>
                    </div>
                </div>

                <p class="lc-help">
                    Solo aparecen cajas PT disponibles de la misma parte y OF. El sistema puede preseleccionar cajas completas sin exceder la cantidad pendiente. Programar una salida no descuenta inventario; el descuento ocurre al despachar.
                </p>

                <div class="lc-progress">
                    <div id="selectionProgress" class="lc-progress-bar @(seleccionCompleta ? "complete" : "")" style="width:@(demanda.PendienteProgramar > 0 ? Math.Min(100m, Math.Round((decimal)piezasSugeridas * 100m / demanda.PendienteProgramar, 2)) : 0)%"></div>
                </div>

                <div class="lc-lot-grid" id="lotGrid" data-target="@demanda.PendienteProgramar">
                    @foreach (var c in Model.CajasDisponibles)
                    {
                        var lote = string.IsNullOrWhiteSpace(c.Lote) ? c.Etiqueta : c.Lote;
                        var selected = seleccionadas.Contains(c.CajaID);

                        <label class="lc-lot-card @(selected ? "is-selected" : "")">
                            <input type="checkbox"
                                   name="CajaIDs"
                                   value="@c.CajaID"
                                   data-pieces="@c.Disponible"
                                   checked="@selected" />

                            <span class="lc-lot-check">
                                <i class="fa-solid fa-check"></i>
                            </span>

                            <div class="lc-lot-id">
                                <span>LOTE / CAJA</span>
                                <strong>@(string.IsNullOrWhiteSpace(lote) ? $"Caja {c.NumeroCaja}" : lote)</strong>
                                <small>@(string.IsNullOrWhiteSpace(c.Etiqueta) ? $"Caja #{c.NumeroCaja}" : c.Etiqueta)</small>
                            </div>

                            <div class="lc-lot-meta">
                                <span><i class="fa-solid fa-cubes"></i>@c.Disponible.ToString("N0") PZA</span>
                                <span><i class="fa-solid fa-location-dot"></i>@(string.IsNullOrWhiteSpace(c.Ubicacion) ? "Sin ubicación" : c.Ubicacion)</span>
                                <span><i class="fa-solid fa-file-circle-check"></i>@(string.IsNullOrWhiteSpace(c.NumeroOF) ? "Sin OF" : c.NumeroOF)</span>
                            </div>
                        </label>
                    }
                </div>

                @if (!Model.CajasDisponibles.Any())
                {
                    <div class="lc-empty-inline lc-empty-warning">
                        <i class="fa-solid fa-triangle-exclamation me-1"></i>
                        Todavía no hay cajas PT liberadas y disponibles para esta parte/OF. Puedes programar el embarque ahora y reservarlas después desde el detalle.
                    </div>
                }
            </section>

            <aside class="lc-board lc-aside">
                <div class="lc-aside-title">
                    <span class="lc-eyebrow">Datos del embarque</span>
                    <h2>Programación</h2>
                </div>

                <div id="mensajeFormulario" class="lc-inline-message error"></div>

                <label class="lc-field">
                    <span>Destino</span>
                    <input asp-for="Destino" autocomplete="off" />
                </label>

                <label class="lc-field">
                    <span>Hora de carga <small>opcional</small></span>
                    <input asp-for="HoraCargaProgramada" type="time" />
                </label>

                <details class="lc-advanced">
                    <summary>Transporte y observaciones</summary>
                    <div>
                        <label class="lc-field">
                            <span>Ruta <small>opcional</small></span>
                            <select asp-for="RutaID">
                                <option value="">Sin asignar</option>
                                @foreach (var r in Model.Rutas)
                                {
                                    <option value="@r.Id">@r.Texto</option>
                                }
                            </select>
                        </label>

                        <label class="lc-field">
                            <span>Unidad <small>opcional</small></span>
                            <select asp-for="UnidadID">
                                <option value="">Sin asignar</option>
                                @foreach (var u in Model.Unidades)
                                {
                                    <option value="@u.Id">@u.Texto</option>
                                }
                            </select>
                        </label>

                        <label class="lc-field">
                            <span>Operador <small>opcional</small></span>
                            <input asp-for="OperadorTexto" autocomplete="off" />
                        </label>

                        <label class="lc-field">
                            <span>Observaciones <small>opcional</small></span>
                            <textarea asp-for="Observaciones" rows="3"></textarea>
                        </label>
                    </div>
                </details>

                <div class="lc-summary">
                    <div>
                        <span>Parte</span>
                        <b>@demanda.NumeroParte</b>
                    </div>
                    <div>
                        <span>OF</span>
                        <b>@(string.IsNullOrWhiteSpace(demanda.NumeroOF) ? "Pendiente" : demanda.NumeroOF)</b>
                    </div>
                    <div>
                        <span>Carga</span>
                        <b>@Fecha(Model.FechaCargaProgramada)</b>
                    </div>
                    <div>
                        <span>Entrega</span>
                        <b>@Fecha(Model.FechaEntregaProgramada)</b>
                    </div>
                </div>

                <div id="selectionStatus" class="lc-selection-status @(seleccionCompleta ? "ok" : tieneSeleccion ? "warn" : "info")">
                    @if (seleccionCompleta)
                    {
                        <text><i class="fa-solid fa-circle-check me-1"></i>La selección PT cubre exactamente la cantidad programada.</text>
                    }
                    else if (tieneSeleccion)
                    {
                        <text><i class="fa-solid fa-circle-info me-1"></i>Faltan @faltanteInicial.ToString("N0") PZA por reservar. El embarque puede programarse y completarse después.</text>
                    }
                    else
                    {
                        <text><i class="fa-solid fa-circle-info me-1"></i>Sin cajas reservadas todavía. El embarque puede quedar programado y enlazar PT posteriormente.</text>
                    }
                </div>

                <button class="lc-btn lc-btn-primary lc-btn-wide" type="submit" id="btnProgramar">
                    <i class="fa-solid fa-truck-fast"></i>Programar salida
                </button>

                <small class="lc-submit-note">
                    Reservar cajas no descuenta PT. El inventario se descuenta únicamente cuando el embarque se despacha.
                </small>
            </aside>
        </form>
    }
</div>

@if (demanda != null)
{
    <script>
        (() => {
            const form=document.getElementById('programacionRapidaForm');
            const grid=document.getElementById('lotGrid');
            const counter=document.getElementById('selectedPieces');
            const counterWrap=document.getElementById('selectionCounter');
            const progress=document.getElementById('selectionProgress');
            const status=document.getElementById('selectionStatus');
            const msg=document.getElementById('mensajeFormulario');
            const btn=document.getElementById('btnProgramar');
            const destino=document.getElementById('Destino');

            if(!form||!grid||!counter)return;

            const target=Number(grid.dataset.target||0);
            const boxes=Array.from(grid.querySelectorAll('input[type="checkbox"][name="CajaIDs"]'));

            function mostrarMensaje(texto){
                if(!msg)return;
                msg.innerHTML='<i class="fa-solid fa-triangle-exclamation me-1"></i>'+texto;
                msg.classList.add('show');
            }

            function limpiarMensaje(){
                if(!msg)return;
                msg.innerHTML='';
                msg.classList.remove('show');
            }

            function totalSeleccionado(){
                return boxes.reduce((total,box)=>{
                    return total+(box.checked?Number(box.dataset.pieces||0):0);
                },0);
            }

            function actualizarEstado(total){
                const porcentaje=target>0?Math.min(100,(total*100)/target):0;

                counter.textContent=total.toLocaleString('es-MX');
                counterWrap?.classList.toggle('is-complete',total===target);

                if(progress){
                    progress.style.width=porcentaje+'%';
                    progress.classList.toggle('complete',total===target);
                }

                if(!status)return;

                status.classList.remove('ok','warn','info');

                if(total===target&&target>0){
                    status.classList.add('ok');
                    status.innerHTML='<i class="fa-solid fa-circle-check me-1"></i>La selección PT cubre exactamente la cantidad programada.';
                    return;
                }

                if(total>0){
                    const faltante=Math.max(0,target-total);
                    status.classList.add('warn');
                    status.innerHTML='<i class="fa-solid fa-circle-info me-1"></i>Faltan '+faltante.toLocaleString('es-MX')+' PZA por reservar. El embarque puede programarse y completarse después.';
                    return;
                }

                status.classList.add('info');
                status.innerHTML='<i class="fa-solid fa-circle-info me-1"></i>Sin cajas reservadas todavía. El embarque puede quedar programado y enlazar PT posteriormente.';
            }

            function refrescar(changed){
                limpiarMensaje();

                let total=totalSeleccionado();

                if(total>target&&changed?.checked){
                    changed.checked=false;
                    total=totalSeleccionado();
                    mostrarMensaje('Esa caja excede la cantidad pendiente del Release. Selecciona una combinación que no rebase '+target.toLocaleString('es-MX')+' PZA.');
                }

                boxes.forEach(box=>{
                    box.closest('.lc-lot-card')?.classList.toggle('is-selected',box.checked);
                });

                actualizarEstado(total);
            }

            boxes.forEach(box=>{
                box.addEventListener('change',()=>refrescar(box));
            });

            form.addEventListener('submit',e=>{
                limpiarMensaje();

                const destinoTexto=(destino?.value||'').trim();

                if(!destinoTexto){
                    e.preventDefault();
                    mostrarMensaje('Captura el destino del embarque antes de continuar.');
                    destino?.focus();
                    return;
                }

                const total=totalSeleccionado();

                if(total>target){
                    e.preventDefault();
                    mostrarMensaje('La selección de cajas excede la cantidad pendiente del Release.');
                    return;
                }

                if(btn){
                    btn.disabled=true;
                    btn.innerHTML='<i class="fa-solid fa-spinner fa-spin"></i>Programando salida...';
                }
            });

            refrescar();
        })();
    </script>
}
