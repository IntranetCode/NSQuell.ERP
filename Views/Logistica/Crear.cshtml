        --lg-green-soft: #ecfdf3;
        --lg-amber: #b76e00;
        --lg-amber-soft: #fff7e6;
        --lg-red: #b42318;
        --lg-red-soft: #fff3f1;
        --lg-purple: #6847c7;
        --lg-ink: #172033;
        --lg-muted: #667085;
        --lg-line: #d9e3ee;
        --lg-bg: #f3f6fa;
