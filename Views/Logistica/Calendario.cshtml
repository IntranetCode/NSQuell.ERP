@{
    Layout = "_LogisticaLayout";
    ViewData["Title"] = "Calendario Logístico";
}
<style>
    :root {
        --cal-navy: #071b31;
        --cal-blue: #0f4c81;
        --cal-blue2: #1f6fa6;
        --cal-cyan: #0e7490;
        --cal-green: #117a4b;
        --cal-amber: #b76e00;
        --cal-orange: #d97706;
        --cal-purple: #6847c7;
        --cal-red: #b42318;
        --cal-gray: #667085;
        --cal-line: #d9e3ee;
        --cal-bg: #f3f6fa;
        --cal-panel: #fff;
        --cal-shadow: 0 14px 34px rgba(15,23,42,.07)
    }

    .cal-page {
        display: flex;
        flex-direction: column;
        gap: 15px
    }

    .cal-hero {
        position: relative;
        overflow: hidden;
        background: linear-gradient(120deg,var(--cal-navy),#103d64 72%,#175f8c);
        color: #fff;
        border-radius: 22px;
        padding: 22px 24px;
        box-shadow: 0 20px 45px rgba(7,27,49,.18)
    }

        .cal-hero::after {
            content: "";
            position: absolute;
            width: 330px;
            height: 330px;
            right: -120px;
            top: -170px;
            border-radius: 50%;
            border: 1px solid rgba(255,255,255,.13);
            box-shadow: 0 0 0 35px rgba(255,255,255,.025),0 0 0 75px rgba(255,255,255,.018)
        }

    .cal-hero-row {
        position: relative;
        z-index: 1;
        display: flex;
        justify-content: space-between;
        align-items: flex-start;
        gap: 18px;
        flex-wrap: wrap
    }

    .cal-kicker {
        font-size: .7rem;
        font-weight: 950;
        text-transform: uppercase;
        letter-spacing: .16em;
        color: #a9d7ef
    }

    .cal-hero h1 {
        margin: 4px 0 6px;
        font-size: 1.9rem;
        font-weight: 950
    }

    .cal-hero p {
        margin: 0;
        max-width: 900px;
        color: rgba(255,255,255,.78);
        font-weight: 650
    }

    .cal-actions {
        display: flex;
        gap: 9px;
        flex-wrap: wrap
    }

    .cal-btn {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: 8px;
        border: 1px solid #cad7e5;
        background: #fff;
        color: #25364d;
        border-radius: 11px;
        min-height: 40px;
        padding: 8px 13px;
        text-decoration: none;
        font-weight: 900;
        cursor: pointer;
        transition: .15s ease;
        white-space: nowrap
    }

        .cal-btn:hover {
            transform: translateY(-1px);
            box-shadow: 0 8px 18px rgba(15,23,42,.10);
            color: var(--cal-blue)
        }

    .cal-btn-primary {
        background: var(--cal-blue);
        border-color: var(--cal-blue);
        color: #fff
    }

        .cal-btn-primary:hover {
            background: #0a3b65;
            border-color: #0a3b65;
            color: #fff
        }

    .cal-btn-hero {
        border-color: rgba(255,255,255,.28);
        background: rgba(255,255,255,.10);
        color: #fff
    }

        .cal-btn-hero:hover {
            background: #fff;
            color: var(--cal-blue)
        }

    .cal-toolbar {
        display: grid;
        grid-template-columns: minmax(260px,1fr) 190px auto auto;
        gap: 10px;
        align-items: end;
        background: #fff;
        border: 1px solid var(--cal-line);
        border-radius: 16px;
        padding: 12px 14px;
        box-shadow: 0 8px 20px rgba(15,23,42,.035)
    }

    .cal-field label {
        display: block;
        margin-bottom: 5px;
        color: #667085;
        font-size: .68rem;
        font-weight: 950;
        text-transform: uppercase;
        letter-spacing: .055em
    }

    .cal-input, .cal-select {
        width: 100%;
        height: 42px;
        border: 1px solid #ccd8e5;
        border-radius: 10px;
        background: #fff;
        color: #172033;
        padding: 0 11px;
        font-weight: 700
    }

    .cal-search {
        position: relative
    }

        .cal-search i {
            position: absolute;
            left: 12px;
            top: 50%;
            transform: translateY(-50%);
            color: #7b8ca2
        }

        .cal-search .cal-input {
            padding-left: 36px
        }

    .cal-panel {
        background: #fff;
        border: 1px solid var(--cal-line);
        border-radius: 18px;
        overflow: hidden;
        box-shadow: var(--cal-shadow)
    }

    .cal-panel-head {
        min-height: 62px;
        padding: 12px 16px;
        border-bottom: 1px solid var(--cal-line);
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 12px;
        flex-wrap: wrap;
        background: linear-gradient(180deg,#fff,#f9fbfd)
    }

    .cal-title-group {
        display: flex;
        align-items: center;
        gap: 11px
    }

    .cal-title-icon {
        width: 38px;
        height: 38px;
        border-radius: 11px;
        background: #edf5fb;
        color: var(--cal-blue);
        display: grid;
        place-items: center
    }

    .cal-title-group h2 {
        margin: 0;
        font-size: 1.08rem;
        font-weight: 950;
        color: #0b1f3a
    }

    .cal-title-group small {
        display: block;
        margin-top: 2px;
        color: #667085;
        font-weight: 650
    }

    .cal-controls {
        display: flex;
        align-items: center;
        gap: 8px;
        flex-wrap: wrap
    }

    .cal-view-switch {
        display: flex;
        gap: 5px;
        padding: 4px;
        border: 1px solid var(--cal-line);
        border-radius: 11px;
        background: #f8fafc
    }

    .cal-view-btn {
        border: 0;
        background: transparent;
        color: #667085;
        border-radius: 8px;
        padding: 7px 10px;
        font-size: .76rem;
        font-weight: 950;
        cursor: pointer
    }

        .cal-view-btn.active {
            background: #fff;
            color: var(--cal-blue);
            box-shadow: 0 3px 8px rgba(15,23,42,.08)
        }

    .cal-range-title {
        min-width: 210px;
        text-align: center;
        color: #0b1f3a;
        font-weight: 950
    }

    .cal-loading {
        padding: 36px;
        text-align: center;
        color: #667085;
        font-weight: 800
    }

    .cal-error {
        margin: 12px;
        border: 1px solid #fda29b;
        background: #fff3f1;
        color: #b42318;
        border-radius: 12px;
        padding: 12px 14px;
        font-weight: 850
    }

    .cal-month {
        padding: 12px
    }

    .cal-weekdays {
        display: grid;
        grid-template-columns: repeat(7,1fr);
        border: 1px solid var(--cal-line);
        border-bottom: 0;
        border-radius: 12px 12px 0 0;
        overflow: hidden
    }

        .cal-weekdays div {
            padding: 8px;
            text-align: center;
            background: #eef4f9;
            color: #4f6176;
            font-size: .7rem;
            font-weight: 950;
            text-transform: uppercase;
            letter-spacing: .04em;
            border-right: 1px solid var(--cal-line)
        }

            .cal-weekdays div:last-child {
                border-right: 0
            }

    .cal-month-grid {
        display: grid;
        grid-template-columns: repeat(7,1fr);
        border-left: 1px solid var(--cal-line);
        border-top: 1px solid var(--cal-line)
    }

    .cal-day {
        min-height: 154px;
        border-right: 1px solid var(--cal-line);
        border-bottom: 1px solid var(--cal-line);
        padding: 7px;
        background: #fff;
        position: relative
    }

        .cal-day.other {
            background: #f8fafc
        }

        .cal-day.today {
            background: #f1f8fd;
            box-shadow: inset 0 0 0 2px #7cb9dc
        }

    .cal-day-num {
        font-size: .76rem;
        font-weight: 950;
        color: #475467;
        margin-bottom: 6px
    }

    .cal-day.other .cal-day-num {
        color: #a4afbd
    }

    .cal-events {
        display: flex;
        flex-direction: column;
        gap: 4px
    }

    .cal-event {
        display: block;
        text-decoration: none;
        border-left: 4px solid var(--cal-blue);
        background: #eef5fb;
        color: #17324d;
        border-radius: 7px;
        padding: 5px 6px;
        min-width: 0;
        transition: .12s ease
    }

        .cal-event:hover {
            filter: brightness(.97);
            transform: translateX(1px)
        }

        .cal-event.pending {
            border-left-color: var(--cal-amber);
            background: #fff6e5;
            color: #694400
        }

        .cal-event.carga {
            border-left-color: var(--cal-blue);
            background: #eef5fb;
            color: #17324d
        }

        .cal-event.entrega {
            border-left-color: var(--cal-green);
            background: #ecfdf3;
            color: #0d603c
        }

        .cal-event.preparando {
            border-left-color: var(--cal-orange);
            background: #fff7ed;
            color: #8a4b06
        }

        .cal-event.preparado {
            border-left-color: #2563eb;
            background: #eff6ff;
            color: #1e40af
        }

        .cal-event.cargado {
            border-left-color: var(--cal-purple);
            background: #f3f0ff;
            color: #5035c9
        }

        .cal-event.ruta {
            border-left-color: #0891b2;
            background: #ecfeff;
            color: #0e6175
        }

        .cal-event.entregado {
            border-left-color: var(--cal-green);
            background: #ecfdf3;
            color: #0d603c
        }

        .cal-event.cancelado {
            border-left-color: #98a2b3;
            background: #f2f4f7;
            color: #667085;
            text-decoration: line-through
        }

        .cal-event.incident {
            box-shadow: inset 0 0 0 1px #fda29b
        }

    .cal-event-top {
        display: flex;
        justify-content: space-between;
        gap: 4px;
        font-size: .63rem;
        font-weight: 950
    }

    .cal-event-title {
        font-size: .69rem;
        font-weight: 950;
        white-space: nowrap;
        overflow: hidden;
        text-overflow: ellipsis
    }

    .cal-event-sub {
        font-size: .61rem;
        font-weight: 700;
        white-space: nowrap;
        overflow: hidden;
        text-overflow: ellipsis;
        opacity: .82
    }

    .cal-week-view {
        padding: 12px;
        overflow: auto
    }

    .cal-week-grid {
        min-width: 980px;
        border: 1px solid var(--cal-line);
        border-radius: 12px;
        overflow: hidden;
        background: #fff
    }

    .cal-week-head {
        display: grid;
        grid-template-columns: 90px repeat(7,1fr);
        background: #eef4f9;
        border-bottom: 1px solid var(--cal-line)
    }

        .cal-week-head div {
            padding: 9px;
            border-right: 1px solid var(--cal-line);
            font-size: .7rem;
            font-weight: 950;
            color: #4f6176;
            text-align: center
        }

            .cal-week-head div:last-child {
                border-right: 0
            }

    .cal-week-row {
        display: grid;
        grid-template-columns: 90px repeat(7,1fr);
        min-height: 78px;
        border-bottom: 1px solid var(--cal-line)
    }

        .cal-week-row:last-child {
            border-bottom: 0
        }

    .cal-week-label {
        padding: 9px;
        background: #f8fafc;
        border-right: 1px solid var(--cal-line);
        font-size: .69rem;
        font-weight: 950;
        color: #667085
    }

    .cal-week-cell {
        padding: 6px;
        border-right: 1px solid var(--cal-line);
        min-width: 0
    }

        .cal-week-cell:last-child {
            border-right: 0
        }

    .cal-legend {
        display: flex;
        gap: 12px;
        flex-wrap: wrap;
        padding: 0 14px 13px;
        color: #667085;
        font-size: .72rem;
        font-weight: 800
    }

        .cal-legend span {
            display: inline-flex;
            align-items: center;
            gap: 5px
        }

    .cal-dot {
        width: 9px;
        height: 9px;
        border-radius: 50%;
        display: inline-block
    }

    .cal-side-note {
        margin: 0 12px 12px;
        border: 1px solid #d8e6f0;
        background: #f7fbfe;
        border-radius: 12px;
        padding: 10px 12px;
        color: #53677c;
        font-size: .76rem;
        font-weight: 750
    }

    .cal-hidden {
        display: none !important
    }

    @@media(max-width:1000px) {
        .cal-toolbar {
            grid-template-columns: 1fr 1fr
        }
    }

    @@media(max-width:760px) {
        .cal-toolbar {
            grid-template-columns: 1fr
        }

        .cal-month {
            overflow: visible
        }

        .cal-weekdays, .cal-month-grid {
            min-width: 0
        }

            .cal-weekdays > *, .cal-month-grid > * {
                min-width: 0
            }

        .cal-day {
            min-height: 82px;
            padding: 4px
        }

        .cal-day-number {
            font-size: .68rem
        }

        .cal-event {
            padding: 4px 5px
        }

        .cal-event-title {
            font-size: .6rem
        }

        .cal-event-sub {
            display: none
        }

        .cal-hero {
            padding: 18px
        }

            .cal-hero h1 {
                font-size: 1.5rem
            }
    }
</style>

<div class="cal-page">
    <section class="cal-hero">
        <div class="cal-hero-row">
            <div>
                <div class="cal-kicker">Planeación visual de cargas</div>
                <h1>Calendario Logístico</h1>
                <p>Visualiza en un solo lugar los releases aún pendientes, las fechas de carga, entregas programadas y el avance real de cada embarque.</p>
            </div>
            <div class="cal-actions">
                <a class="cal-btn cal-btn-hero" asp-action="Index"><i class="fa-solid fa-arrow-left"></i>Operación</a>
                <a class="cal-btn cal-btn-hero" asp-action="Catalogos"><i class="fa-solid fa-route"></i>Rutas y unidades</a>
            </div>
        </div>
    </section>

    <section class="cal-toolbar">
        <div class="cal-field">
            <label>Buscar</label>
            <div class="cal-search">
                <i class="fa-solid fa-magnifying-glass"></i>
                <input id="filtroQ" class="cal-input" placeholder="Cliente, Release, embarque o destino" />
            </div>
        </div>
        <div class="cal-field">
            <label>Estatus</label>
            <select id="filtroEstatus" class="cal-select">
                <option value="">Todos</option>
                <option value="Programado">Programado</option>
                <option value="Preparando">Preparando</option>
                <option value="Preparado">Preparado</option>
                <option value="Cargado">Cargado</option>
                <option value="En ruta">En ruta</option>
                <option value="Entregado">Entregado</option>
                <option value="Cancelado">Cancelado</option>
            </select>
        </div>
        <button type="button" id="btnAplicar" class="cal-btn cal-btn-primary"><i class="fa-solid fa-filter"></i>Aplicar</button>
        <button type="button" id="btnLimpiar" class="cal-btn"><i class="fa-solid fa-rotate-left"></i>Limpiar</button>
    </section>

    <section class="cal-panel">
        <div class="cal-panel-head">
            <div class="cal-title-group">
                <div class="cal-title-icon"><i class="fa-solid fa-calendar-days"></i></div>
                <div>
                    <h2>Programación de cargas y entregas</h2>
                    <small>Los releases pendientes se muestran en la fecha sugerida de carga.</small>
                </div>
            </div>
            <div class="cal-controls">
                <div class="cal-view-switch">
                    <button type="button" class="cal-view-btn active" data-view="month">Mes</button>
                    <button type="button" class="cal-view-btn" data-view="week">Semana</button>
                </div>
                <button type="button" class="cal-btn" id="btnHoy"><i class="fa-solid fa-calendar-day"></i>Hoy</button>
                <button type="button" class="cal-btn" id="btnAnterior"><i class="fa-solid fa-chevron-left"></i></button>
                <div id="tituloRango" class="cal-range-title">Calendario</div>
                <button type="button" class="cal-btn" id="btnSiguiente"><i class="fa-solid fa-chevron-right"></i></button>
            </div>
        </div>

        <div id="mensajeError" class="cal-error cal-hidden"></div>
        <div id="loading" class="cal-loading cal-hidden"><i class="fa-solid fa-spinner fa-spin me-2"></i>Cargando programación logística...</div>

        <div id="vistaMes" class="cal-month">
            <div class="cal-weekdays">
                <div>Lunes</div><div>Martes</div><div>Miércoles</div><div>Jueves</div><div>Viernes</div><div>Sábado</div><div>Domingo</div>
            </div>
            <div id="gridMes" class="cal-month-grid"></div>
        </div>

        <div id="vistaSemana" class="cal-week-view cal-hidden">
            <div id="gridSemana" class="cal-week-grid"></div>
        </div>

        <div class="cal-legend">
            <span><i class="cal-dot" style="background:#b76e00"></i>Release pendiente</span>
            <span><i class="cal-dot" style="background:#0f4c81"></i>Carga programada</span>
            <span><i class="cal-dot" style="background:#117a4b"></i>Entrega programada</span>
            <span><i class="cal-dot" style="background:#d97706"></i>Preparando</span>
            <span><i class="cal-dot" style="background:#6847c7"></i>Cargado</span>
            <span><i class="cal-dot" style="background:#0891b2"></i>En ruta</span>
        </div>

        <div class="cal-side-note">
            <i class="fa-solid fa-circle-info me-1"></i>
            Un mismo embarque puede aparecer dos veces: una por su fecha de carga y otra por su fecha de entrega. Los releases sin embarque aparecen como pendientes de programación.
        </div>
    </section>
</div>

<script>
    (() => {
        const endpoint='@Url.Action("EventosCalendario", "Logistica")';
        const gridMes=document.getElementById('gridMes');
        const gridSemana=document.getElementById('gridSemana');
        const vistaMes=document.getElementById('vistaMes');
        const vistaSemana=document.getElementById('vistaSemana');
        const tituloRango=document.getElementById('tituloRango');
        const loading=document.getElementById('loading');
        const mensajeError=document.getElementById('mensajeError');
        const filtroQ=document.getElementById('filtroQ');
        const filtroEstatus=document.getElementById('filtroEstatus');

        let vista='month';
        let fechaReferencia=new Date();
        fechaReferencia=new Date(fechaReferencia.getFullYear(),fechaReferencia.getMonth(),fechaReferencia.getDate());
        let eventos=[];

        function claveFecha(d){
            const y=d.getFullYear();
            const m=String(d.getMonth()+1).padStart(2,'0');
            const day=String(d.getDate()).padStart(2,'0');
            return `${y}-${m}-${day}`;
        }

        function desdeIso(s){
            if(!s)return null;
            const [y,m,d]=s.split('-').map(Number);
            return new Date(y,m-1,d);
        }

        function inicioSemana(d){
            const x=new Date(d.getFullYear(),d.getMonth(),d.getDate());
            const offset=(x.getDay()+6)%7;
            x.setDate(x.getDate()-offset);
            return x;
        }

        function finSemana(d){
            const x=inicioSemana(d);
            x.setDate(x.getDate()+6);
            return x;
        }

        function rangoActual(){
            if(vista==='week'){
                return {desde:inicioSemana(fechaReferencia),hasta:finSemana(fechaReferencia)};
            }
            const primero=new Date(fechaReferencia.getFullYear(),fechaReferencia.getMonth(),1);
            const ultimo=new Date(fechaReferencia.getFullYear(),fechaReferencia.getMonth()+1,0);
            const desde=inicioSemana(primero);
            const hasta=finSemana(ultimo);
            return {desde,hasta};
        }

        function textoRango(){
            if(vista==='week'){
                const a=inicioSemana(fechaReferencia);
                const b=finSemana(fechaReferencia);
                const f=new Intl.DateTimeFormat('es-MX',{day:'2-digit',month:'short'});
                return `${f.format(a)} - ${f.format(b)} ${b.getFullYear()}`;
            }
            return new Intl.DateTimeFormat('es-MX',{month:'long',year:'numeric'})
                .format(fechaReferencia)
                .replace(/^./,c=>c.toUpperCase());
        }

        function claseEstado(ev){
            if(ev.tipo==='PENDIENTE')return 'pending';
            if(ev.tipo==='ENTREGA')return 'entrega';
            const e=(ev.estatus||'').toLowerCase();
            if(e==='preparando')return 'preparando';
            if(e==='preparado')return 'preparado';
            if(e==='cargado')return 'cargado';
            if(e==='en ruta')return 'ruta';
            if(e==='entregado')return 'entregado';
            if(e==='cancelado')return 'cancelado';
            return 'carga';
        }

        function textoTipo(ev){
            if(ev.tipo==='PENDIENTE')return 'PEND.';
            if(ev.tipo==='ENTREGA')return 'ENTREGA';
            if(ev.tipo==='CARGA')return 'CARGA';
            return ev.tipo||'';
        }

        function htmlEvento(ev){
            const clase=claseEstado(ev)+(ev.incidencia?' incident':'');
            const hora=ev.hora||'—';
            const destino=ev.destino?` · ${ev.destino}`:'';
            return `
                <a href="${ev.url||'#'}" class="cal-event ${clase}" title="${escapeHtml(ev.titulo||'')} | ${escapeHtml(ev.cliente||'')}">
                    <div class="cal-event-top"><span>${hora}</span><span>${textoTipo(ev)}</span></div>
                    <div class="cal-event-title">${escapeHtml(ev.titulo||'')}</div>
                    <div class="cal-event-sub">${escapeHtml((ev.cliente||'')+destino)}</div>
                </a>`;
        }

        function escapeHtml(value){
            return String(value??'')
                .replaceAll('&','&amp;')
                .replaceAll('<','&lt;')
                .replaceAll('>','&gt;')
                .replaceAll('"','&quot;')
                .replaceAll("'","&#039;");
        }

        function renderMes(){
            gridMes.innerHTML='';
            const primero=new Date(fechaReferencia.getFullYear(),fechaReferencia.getMonth(),1);
            const inicio=inicioSemana(primero);
            const hoy=claveFecha(new Date());

            for(let i=0;i<42;i++){
                const d=new Date(inicio);
                d.setDate(inicio.getDate()+i);
                const key=claveFecha(d);

                const celda=document.createElement('div');
                celda.className='cal-day';
                if(d.getMonth()!==fechaReferencia.getMonth())celda.classList.add('other');
                if(key===hoy)celda.classList.add('today');

                const numero=document.createElement('div');
                numero.className='cal-day-num';
                numero.textContent=d.getDate();

                const lista=document.createElement('div');
                lista.className='cal-events';

                eventos
                    .filter(x=>x.fecha===key)
                    .sort((a,b)=>(a.hora||'').localeCompare(b.hora||''))
                    .forEach(ev=>lista.insertAdjacentHTML('beforeend',htmlEvento(ev)));

                celda.appendChild(numero);
                celda.appendChild(lista);
                gridMes.appendChild(celda);
            }
        }

        function renderSemana(){
            const desde=inicioSemana(fechaReferencia);
            const dias=Array.from({length:7},(_,i)=>{
                const d=new Date(desde);
                d.setDate(desde.getDate()+i);
                return d;
            });

            const nombres=['Lun','Mar','Mié','Jue','Vie','Sáb','Dom'];
            let html='<div class="cal-week-head"><div>Tipo</div>';

            dias.forEach((d,i)=>{
                html+=`<div>${nombres[i]}<br>${String(d.getDate()).padStart(2,'0')}/${String(d.getMonth()+1).padStart(2,'0')}</div>`;
            });

            html+='</div>';

            const filas=[
                {key:'PENDIENTE',label:'Pendientes'},
                {key:'CARGA',label:'Cargas'},
                {key:'ENTREGA',label:'Entregas'}
            ];

            filas.forEach(f=>{
                html+=`<div class="cal-week-row"><div class="cal-week-label">${f.label}</div>`;
                dias.forEach(d=>{
                    const key=claveFecha(d);
                    const evs=eventos
                        .filter(x=>x.fecha===key&&x.tipo===f.key)
                        .sort((a,b)=>(a.hora||'').localeCompare(b.hora||''));

                    html+='<div class="cal-week-cell">';
                    evs.forEach(ev=>html+=htmlEvento(ev));
                    html+='</div>';
                });
                html+='</div>';
            });

            gridSemana.innerHTML=html;
        }

        function render(){
            tituloRango.textContent=textoRango();
            vistaMes.classList.toggle('cal-hidden',vista!=='month');
            vistaSemana.classList.toggle('cal-hidden',vista!=='week');
            document.querySelectorAll('.cal-view-btn').forEach(b=>{
                b.classList.toggle('active',b.dataset.view===vista);
            });

            if(vista==='month')renderMes();
            else renderSemana();
        }

        async function cargar(){
            const rango=rangoActual();
            const qs=new URLSearchParams({
                desde:claveFecha(rango.desde),
                hasta:claveFecha(rango.hasta)
            });

            const q=(filtroQ.value||'').trim();
            const estatus=(filtroEstatus.value||'').trim();

            if(q)qs.set('q',q);
            if(estatus)qs.set('estatus',estatus);

            loading.classList.remove('cal-hidden');
            mensajeError.classList.add('cal-hidden');
            mensajeError.textContent='';

            try{
                const response=await fetch(`${endpoint}?${qs.toString()}`,{
                    method:'GET',
                    headers:{'X-Requested-With':'XMLHttpRequest'}
                });

                const data=await response.json();

                if(!response.ok||!data.ok){
                    throw new Error(data.mensaje||'No fue posible cargar el calendario.');
                }

                eventos=Array.isArray(data.eventos)?data.eventos:[];
                render();
            }catch(error){
                eventos=[];
                render();
                mensajeError.textContent=error?.message||'No fue posible cargar el calendario.';
                mensajeError.classList.remove('cal-hidden');
            }finally{
                loading.classList.add('cal-hidden');
            }
        }

        document.querySelectorAll('.cal-view-btn').forEach(btn=>{
            btn.addEventListener('click',()=>{
                vista=btn.dataset.view||'month';
                cargar();
            });
        });

        document.getElementById('btnAnterior')?.addEventListener('click',()=>{
            if(vista==='month'){
                fechaReferencia=new Date(fechaReferencia.getFullYear(),fechaReferencia.getMonth()-1,1);
            }else{
                fechaReferencia.setDate(fechaReferencia.getDate()-7);
            }
            cargar();
        });

        document.getElementById('btnSiguiente')?.addEventListener('click',()=>{
            if(vista==='month'){
                fechaReferencia=new Date(fechaReferencia.getFullYear(),fechaReferencia.getMonth()+1,1);
            }else{
                fechaReferencia.setDate(fechaReferencia.getDate()+7);
            }
            cargar();
        });

        document.getElementById('btnHoy')?.addEventListener('click',()=>{
            const h=new Date();
            fechaReferencia=new Date(h.getFullYear(),h.getMonth(),h.getDate());
            cargar();
        });

        document.getElementById('btnAplicar')?.addEventListener('click',cargar);

        document.getElementById('btnLimpiar')?.addEventListener('click',()=>{
            filtroQ.value='';
            filtroEstatus.value='';
            cargar();
        });

        filtroQ?.addEventListener('keydown',e=>{
            if(e.key==='Enter'){
                e.preventDefault();
                cargar();
            }
        });

        cargar();
    })();
</script>
