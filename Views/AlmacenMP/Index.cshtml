@model ERP.NSQuell.Models.ViewModels.Almacen.AlmacenMPIndexVm
@{
    Layout = "~/Views/Shared/_AlmacenLayout.cshtml";
    ViewData["Title"] = "Inventario MP";

    var tipoFiltro = ViewData["TipoMPFiltro"]?.ToString() ?? string.Empty;

    var grupos = Model.Existencias
        .GroupBy(x => string.IsNullOrWhiteSpace(x.TipoMP) ? "VIRGEN" : x.TipoMP.Trim().ToUpperInvariant())
        .OrderBy(g => g.Key == "VIRGEN" ? 0 : 1)
        .ToList();

    string GrupoId(int indice) => $"mp_tipo_{indice}";
    string InicialTipo(string tipo) => tipo == "MOLIDO" ? "M" : "V";
    string EstadoTexto(string? estado) =>
        estado == "ROJO" ? "Cr&iacute;tico" :
        estado == "AMARILLO" ? "Aviso" :
        estado == "VERDE" ? "Disponible" :
        "Sin configurar";
}

<section class="alm-hero">
    <div>
        <small>MATERIA PRIMA</small>
        <h1>Inventario MP</h1>
        <p>
            Inventario separado por tipo de materia prima: VIRGEN y MOLIDO.
            Cada material conserva el mismo c&oacute;digo, pero sus movimientos y existencias se controlan por separado.
        </p>
    </div>

    <div class="alm-actions">
        <a class="alm-btn" asp-action="Movimiento" asp-route-tipo="Entrada">
            <i class="fa-solid fa-arrow-down"></i>
            Registrar entrada
        </a>
        <a class="alm-btn secondary" asp-action="Movimiento" asp-route-tipo="Salida">Registrar salida</a>
        <a class="alm-btn secondary" asp-action="Materiales">Cat&aacute;logo</a>
        <a class="alm-btn secondary" asp-action="NivelesStock">
            <i class="fa-solid fa-sliders"></i>
            Niveles de stock
        </a>
        <a class="alm-btn secondary" asp-action="Historial">
            <i class="fa-solid fa-clock-rotate-left"></i>
            Historial
        </a>
    </div>
</section>

@if (!Model.Configurado)
{
    <div class="alm-alert warning">@Model.MensajeConfiguracion</div>
}

<section class="alm-grid alm-grid-6">
    <div class="alm-kpi alm-kpi-demand">
        <small>SOLICITADO PENDIENTE</small>
        <strong>@Model.SolicitadoPendiente.ToString("0.###")</strong>
        <span>La OF todav&iacute;a no distingue entre VIRGEN y MOLIDO.</span>
    </div>
    <div class="alm-kpi">
        <small>OF PENDIENTES MP</small>
        <strong>@Model.OFPendientes</strong>
        <span>&Oacute;rdenes con materia prima pendiente de surtir.</span>
    </div>
    <div class="alm-kpi">
        <small>RECEPCIONES DE HOY</small>
        <strong>@Model.RecepcionesHoy</strong>
        <span>Entradas registradas durante el d&iacute;a.</span>
    </div>
    <div class="alm-kpi">
        <small>KG RECIBIDOS HOY</small>
        <strong>@Model.CantidadRecibidaHoy.ToString("0.###")</strong>
        <span>Total ingresado al almac&eacute;n de MP.</span>
    </div>
    <div class="alm-kpi alm-kpi-out">
        <small>SALIDAS DE HOY</small>
        <strong>@Model.SalidasHoy.ToString("0.###")</strong>
        <span>Salidas, consumos, scrap y ajustes negativos.</span>
    </div>
    <div class="alm-kpi alm-kpi-critical">
        <small>TIPOS CR&Iacute;TICOS</small>
        <strong>@Model.Criticos</strong>
        <span>Combinaciones material/tipo en sem&aacute;foro rojo.</span>
    </div>
</section>

<section class="alm-card pt-client-catalog mp-type-catalog">
    <header>
        <span>
            <i class="fa-solid fa-cubes-stacked"></i>
            Cat&aacute;logo MP por tipo
        </span>
        <span>@Model.Existencias.Count registro(s)</span>
    </header>

    <form method="get" class="alm-filter pt-client-filter">
        <div class="alm-field">
            <label for="q">C&oacute;digo o material</label>
            <input id="q"
                   class="alm-input"
                   type="search"
                   name="q"
                   value="@Model.Busqueda"
                   placeholder="Escribe un c&oacute;digo o nombre"
                   autocomplete="off" />
        </div>

        <div class="alm-field">
            <label for="estado">Nivel de stock</label>
            <select id="estado" class="alm-select" name="estado">
                @if (string.IsNullOrWhiteSpace(Model.Estado))
                {
                    <option value="" selected>Todos los niveles</option>
                }
                else
                {
                    <option value="">Todos los niveles</option>
                }
                <option value="ROJO" selected="@(Model.Estado == "ROJO")">Cr&iacute;tico</option>
                <option value="AMARILLO" selected="@(Model.Estado == "AMARILLO")">Aviso</option>
                <option value="VERDE" selected="@(Model.Estado == "VERDE")">Disponible</option>
                <option value="SIN_CONFIGURAR" selected="@(Model.Estado == "SIN_CONFIGURAR")">Sin configurar</option>
            </select>
        </div>

        <div class="alm-field">
            <label for="tipoMP">Tipo de MP</label>
            <select id="tipoMP" class="alm-select" name="tipoMP">
                @if (string.IsNullOrWhiteSpace(tipoFiltro))
                {
                    <option value="" selected>VIRGEN y MOLIDO</option>
                }
                else
                {
                    <option value="">VIRGEN y MOLIDO</option>
                }
                <option value="VIRGEN" selected="@(tipoFiltro == "VIRGEN")">VIRGEN</option>
                <option value="MOLIDO" selected="@(tipoFiltro == "MOLIDO")">MOLIDO</option>
            </select>
        </div>

        <button class="alm-btn" type="submit">
            <i class="fa-solid fa-filter"></i>
            Filtrar
        </button>
        <a class="alm-btn secondary" asp-action="Index">
            <i class="fa-solid fa-filter-circle-xmark"></i>
            Limpiar
        </a>
    </form>

    <div class="alm-alert mp-type-note">
        <i class="fa-solid fa-circle-info"></i>
        Los movimientos anteriores se consideran VIRGEN. El solicitado de las OF permanece como total general hasta que Planeaci&oacute;n capture el tipo de MP.
    </div>

    @if (grupos.Any())
    {
        <div class="pt-client-list">
            @{ var indice = 0; }
            @foreach (var grupo in grupos)
            {
                indice++;
                var collapseId = GrupoId(indice);
                var items = grupo.OrderBy(x => x.Nombre).ThenBy(x => x.Codigo).ToList();
                var existencia = items.Sum(x => x.Saldo);
                var conStock = items.Count(x => x.Saldo > 0.0005m);
                var criticos = items.Count(x => x.Semaforo == "ROJO");

                <article class="pt-client-card">
                    <button type="button"
                            class="pt-client-head"
                            data-bs-toggle="collapse"
                            data-bs-target="#@collapseId"
                            aria-expanded="false"
                            aria-controls="@collapseId">
                        <span class="pt-client-head-main">
                            <span class="pt-client-avatar">@InicialTipo(grupo.Key)</span>
                            <span class="pt-client-copy">
                                <strong>@grupo.Key</strong>
                                <small>@items.Count material(es)</small>
                            </span>
                        </span>

                        <span class="pt-client-metrics">
                            <span class="pt-client-pill">
                                <small>Materiales</small>
                                <strong>@items.Count</strong>
                            </span>
                            <span class="pt-client-pill is-available">
                                <small>Existencia</small>
                                <strong>@existencia.ToString("0.###") KG</strong>
                            </span>
                            <span class="pt-client-pill">
                                <small>Con stock</small>
                                <strong>@conStock</strong>
                            </span>
                            @if (criticos > 0)
                            {
                                <span class="pt-client-pill is-critical">
                                    <small>Cr&iacute;ticos</small>
                                    <strong>@criticos</strong>
                                </span>
                            }
                            <span class="pt-client-chevron"><i class="fa-solid fa-chevron-down"></i></span>
                        </span>
                    </button>

                    <div id="@collapseId" class="collapse">
                        <div class="pt-client-body">
                            <div class="alm-table-wrap pt-client-table-wrap">
                                <table class="alm-table alm-table-fit pt-client-table mp-type-table">
                                    <colgroup>
                                        <col class="mpc-col-code" />
                                        <col class="mpc-col-name" />
                                        <col class="mpc-col-stock" />
                                                                                <col class="ptc-col-requested" />
                                        <col class="mpc-col-last" />
                                        <col class="mpc-col-actions" />
                                    </colgroup>
                                    <thead>
                                        <tr>
                                            <th>C&oacute;digo</th>
                                            <th>Material</th>
                                            <th>Existencia</th>
                                                                                        <th>Solicitado</th>
                                            <th>&Uacute;ltimo movimiento</th>
                                            <th aria-label="Acciones"></th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        @foreach (var x in items)
                                        {
                                            <tr>
                                                <td data-label="C&oacute;digo">
                                                    <a class="pt-part-link"
                                                       asp-action="Historial"
                                                       asp-route-material="@x.Codigo">
                                                        <strong>@x.Codigo</strong>
                                                        <small>@x.TipoMP</small>
                                                    </a>
                                                </td>
                                                <td data-label="Material">
                                                    <a class="pt-truncate-link"
                                                       asp-action="Historial"
                                                       asp-route-material="@x.Codigo"
                                                       title="@x.Nombre">@x.Nombre</a>
                                                </td>
                                                <td class="pt-stock" data-label="Existencia">
                                                    <span class="pt-stock-badge @x.Semaforo">
                                                        <strong>@x.Saldo.ToString("0.###") KG</strong>
                                                    </span>
                                                    </td>
                                                                                                <!-- ALMACEN_MP_COLUMNA_SOLICITADO_V1_0 -->
                                                <td class="pt-requested" data-label="Solicitado">
                                                    @if (x.Solicitado > 0.0005m)
                                                    {
                                                        <strong>-@x.Solicitado.ToString("0.###") KG</strong>
                                                        <small>Pendiente</small>
                                                    }
                                                    else
                                                    {
                                                        <span class="pt-empty-value">0 KG</span>
                                                    }
                                                </td>                                                <td class="pt-last-movement" data-label="&Uacute;ltimo movimiento">
                                                    @if (x.UltimoMovimiento.HasValue)
                                                    {
                                                        <strong>@x.UltimoMovimiento.Value.ToString("dd/MM/yyyy")</strong>
                                                        <small>@x.UltimoMovimiento.Value.ToString("HH:mm")</small>
                                                    }
                                                    else
                                                    {
                                                        <span class="pt-empty-value">Sin movimientos</span>
                                                    }
                                                </td>
                                                <td data-label="Acciones">
                                                    <div class="pt-actions">
                                                        <a class="pt-action"
                                                           asp-action="Movimiento"
                                                           asp-route-materialId="@x.MaterialID"
                                                           asp-route-tipoMP="@x.TipoMP"
                                                           title="Registrar movimiento @x.TipoMP">
                                                            <i class="fa-solid fa-arrow-right-arrow-left"></i>
                                                        </a>
                                                        <a class="pt-action"
                                                           asp-action="NivelesStock"
                                                           asp-route-q="@x.Codigo"
                                                           title="Configurar niveles de stock">
                                                            <i class="fa-solid fa-sliders"></i>
                                                        </a>
                                                        <a class="pt-action"
                                                           asp-action="Historial"
                                                           asp-route-material="@x.Codigo"
                                                           title="Ver historial del material">
                                                            <i class="fa-solid fa-clock-rotate-left"></i>
                                                        </a>
                                                    </div>
                                                </td>
                                            </tr>
                                        }
                                    </tbody>
                                </table>
                            </div>
                        </div>
                    </div>
                </article>
            }
        </div>
    }
    else
    {
        <div class="alm-empty">No se encontraron materiales con los filtros seleccionados.</div>
    }
</section>

<section class="alm-card inv2-recent-card">
    <header>
        <span>5 movimientos recientes MP</span>
        <a class="alm-header-link" asp-action="Historial">
            Ver historial completo <i class="fa-solid fa-arrow-right"></i>
        </a>
    </header>
    <div class="inv2-recent-list">
        @foreach (var x in Model.Movimientos.Take(5))
        {
            <article class="inv2-recent-item">
                <div><small>FECHA</small><strong>@x.FechaMovimiento.ToString("dd/MM/yyyy")</strong><span>@x.FechaMovimiento.ToString("HH:mm")</span></div>
                <div class="inv2-recent-main"><small>MATERIAL</small><a asp-action="Historial" asp-route-material="@x.Codigo">@x.Codigo &middot; @x.Material</a></div>
                <div><small>MOVIMIENTO</small><strong>@x.TipoMovimiento</strong><span>@x.Cantidad.ToString("0.###") KG</span></div>
                <div><small>UBICACI&Oacute;N / OF</small><strong>@(string.IsNullOrWhiteSpace(x.Ubicacion) ? "Sin ubicaci&oacute;n" : x.Ubicacion)</strong><span>@(string.IsNullOrWhiteSpace(x.NumeroOF) ? "Sin OF" : x.NumeroOF)</span></div>
                <div><small>RESPONSABLE</small><strong>@(string.IsNullOrWhiteSpace(x.Responsable) ? "Sin responsable" : x.Responsable)</strong></div>
            </article>
        }
    </div>
</section>

<!-- ALMACEN_COMPRA_MP_V3_START -->
<script>
(() => {
  document.querySelectorAll('.pt-actions').forEach(actions => {
    if (actions.querySelector('[data-alm-buy]')) return;
    const movement = actions.querySelector('a[href*="materialId="]');
    if (!movement) return;
    const source = new URL(movement.href, location.origin);
    const id = source.searchParams.get('materialId');
    const tipo = source.searchParams.get('tipoMP') || 'VIRGEN';
    if (!id) return;
    const link = document.createElement('a');
    link.className='pt-action'; link.dataset.almBuy='1'; link.title='Solicitar compra';
    link.href=`/AlmacenCompras/Confirmar?modulo=MP&catalogoID=${encodeURIComponent(id)}&variante=${encodeURIComponent(tipo)}&returnUrl=${encodeURIComponent(location.pathname+location.search)}`;
    link.innerHTML='<i class="fa-solid fa-cart-plus"></i>';
    actions.appendChild(link);
  });
})();
</script>
<!-- ALMACEN_COMPRA_MP_V3_END -->
