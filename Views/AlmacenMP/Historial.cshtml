@model ERP.NSQuell.Models.ViewModels.Almacen.AlmacenMPHistorialVm
@{
    Layout = "~/Views/Shared/_Layout.cshtml";
    ViewData["Title"] = "Historial MP";
    var anterior = Math.Max(1, Model.Pagina - 1);
    var siguiente = Math.Min(Model.TotalPaginas, Model.Pagina + 1);
}

@section Styles {
    <link rel="stylesheet" href="~/css/Almacen/almacen-navegacion.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/nsquell-erp-theme.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/Almacen/almacen.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/Almacen/almacen-vistas.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/Almacen/almacen-temas.css" asp-append-version="true" />
}


@section Scripts {
    <script src="~/js/Almacen/almacen-vistas.js" asp-append-version="true"></script>
}


@await Html.PartialAsync("_AlmacenNavegacion")

@await Html.PartialAsync("_AlmacenMensajes")


<section class="alm-hero">
    <div>
        <small>TRAZABILIDAD DE MATERIA PRIMA</small>
        <h1>Historial MP</h1>
        <p>Consulta completa de entradas, salidas, consumos, retornos, scrap y ajustes. Cada registro conserva fecha, lote, ubicación, responsable y referencia.</p>
        @if (!string.IsNullOrWhiteSpace(Model.FiltroMaterial))
        {
            <span class="alm-focus-chip"><i class="fa-solid fa-filter"></i> Material filtrado: @Model.FiltroMaterial</span>
        }
    </div>
    <div class="alm-actions">
        <a class="alm-btn" asp-action="Movimiento"><i class="fa-solid fa-plus"></i>Nuevo movimiento</a>
        <a class="alm-btn secondary"
           asp-action="ExportarHistorialCsv"
           asp-route-material="@Model.FiltroMaterial"
           asp-route-q="@Model.Busqueda"
           asp-route-tipo="@Model.TipoMovimiento"
           asp-route-numeroOF="@Model.NumeroOF"
           asp-route-responsable="@Model.Responsable"
           asp-route-lote="@Model.Lote"
           asp-route-desde="@(Model.Desde?.ToString("yyyy-MM-dd"))"
           asp-route-hasta="@(Model.Hasta?.ToString("yyyy-MM-dd"))">
            <i class="fa-solid fa-file-csv"></i>Exportar CSV
        </a>
    </div>
</section>

<section class="alm-card">
    <header>
        <span>Filtros de auditoría</span>
        <span>@Model.TotalRegistros registro(s)</span>
    </header>
    <form method="get" class="alm-filter alm-filter-history">
        <div class="alm-field">
            <label for="material">Material MP</label>
            <input id="material" class="alm-input" type="search" name="material" value="@Model.FiltroMaterial"
                   list="materiales-mp-filtro" placeholder="Escribe o selecciona un material" autocomplete="off" />
            <datalist id="materiales-mp-filtro">
                @foreach (var item in Model.MaterialesFiltro)
                {
                    <option value="@item.Extra">@item.Texto</option>
                }
            </datalist>
            <small class="alm-filter-hint">Puedes elegir un código de la lista o escribir libremente.</small>
        </div>
        <div class="alm-field">
            <label for="q">Búsqueda libre</label>
            <input id="q" class="alm-input" type="search" name="q" value="@Model.Busqueda"
                   placeholder="Observación o referencia" />
        </div>
        <div class="alm-field">
            <label for="tipo">Movimiento</label>
            <select id="tipo" class="alm-select" name="tipo">
                <option value="">Todos</option>
                @foreach (var tipo in Model.TiposMovimiento)
                {
                    if (Model.TipoMovimiento == tipo)
                    {
                        <option value="@tipo" selected>@tipo</option>
                    }
                    else
                    {
                        <option value="@tipo">@tipo</option>
                    }
                }
            </select>
        </div>
        <div class="alm-field">
            <label for="numeroOF">Orden de fabricación</label>
            <input id="numeroOF" class="alm-input" type="search" name="numeroOF" value="@Model.NumeroOF"
                   list="ordenes-mp-filtro" placeholder="Escribe o selecciona una OF" autocomplete="off" />
            <datalist id="ordenes-mp-filtro">
                @foreach (var item in Model.OrdenesFiltro)
                {
                    <option value="@item"></option>
                }
            </datalist>
        </div>
        <div class="alm-field">
            <label for="responsable">Responsable</label>
            <input id="responsable" class="alm-input" type="search" name="responsable" value="@Model.Responsable"
                   list="responsables-mp-filtro" placeholder="Escribe o selecciona un responsable" autocomplete="off" />
            <datalist id="responsables-mp-filtro">
                @foreach (var item in Model.ResponsablesFiltro)
                {
                    <option value="@item"></option>
                }
            </datalist>
        </div>
        <div class="alm-field">
            <label for="lote">Lote</label>
            <input id="lote" class="alm-input" type="search" name="lote" value="@Model.Lote"
                   list="lotes-mp-filtro" placeholder="Escribe o selecciona un lote" autocomplete="off" />
            <datalist id="lotes-mp-filtro">
                @foreach (var item in Model.LotesFiltro)
                {
                    <option value="@item"></option>
                }
            </datalist>
        </div>
        <div class="alm-field">
            <label for="desde">Desde</label>
            <input id="desde" class="alm-input" type="date" name="desde" value="@(Model.Desde?.ToString("yyyy-MM-dd"))" />
        </div>
        <div class="alm-field">
            <label for="hasta">Hasta</label>
            <input id="hasta" class="alm-input" type="date" name="hasta" value="@(Model.Hasta?.ToString("yyyy-MM-dd"))" />
        </div>
        <div class="alm-filter-actions">
            <button class="alm-btn" type="submit"><i class="fa-solid fa-filter"></i>Filtrar</button>
            <a class="alm-btn secondary" asp-action="Historial">Limpiar</a>
        </div>
    </form>
</section>

<section class="alm-card">
    <header>
        <span>Movimientos MP</span>
        <span>Página @Model.Pagina de @Model.TotalPaginas</span>
    </header>
    <div class="alm-table-wrap">
        <table class="alm-table alm-table-history">
            <thead>
                <tr>
                    <th>Fecha</th>
                    <th>Material</th>
                    <th>Movimiento</th>
                    <th>Cantidad</th>
                    <th>Lote</th>
                    <th>Ubicación</th>
                    <th>OF</th>
                    <th>Responsable</th>
                    <th>Referencia</th>
                    <th>Observaciones</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var x in Model.Movimientos)
                {
                    var claseTipo = x.TipoMovimiento is "Entrada" or "Retorno" or "AjustePositivo" ? "entrada" : "salida";
                    <tr>
                        <td>@x.FechaMovimiento.ToString("dd/MM/yyyy HH:mm")</td>
                        <td>
                            <a class="alm-trace-link" asp-action="Historial" asp-route-material="@x.Codigo" title="Ver solamente la trazabilidad de @x.Codigo">
                                <strong>@x.Codigo</strong><small class="alm-subtext">@x.Material</small>
                            </a>
                        </td>
                        <td><span class="alm-movement-type @claseTipo">@x.TipoMovimiento</span></td>
                        <td class="alm-number">@x.Cantidad.ToString("0.###") @x.Unidad</td>
                        <td>@x.Lote</td>
                        <td>@x.Ubicacion</td>
                        <td>@x.NumeroOF</td>
                        <td>@x.Responsable</td>
                        <td>@x.ReferenciaOperacion</td>
                        <td class="alm-history-note">@x.Observaciones</td>
                    </tr>
                }
                @if (!Model.Movimientos.Any())
                {
                    <tr><td colspan="10" class="alm-empty">No se encontraron movimientos con los filtros seleccionados.</td></tr>
                }
            </tbody>
        </table>
    </div>

    @if (Model.TotalPaginas > 1)
    {
        <nav class="alm-pager" aria-label="Paginación del historial MP">
            <a class="alm-btn secondary small @(Model.Pagina <= 1 ? "disabled" : "")"
               asp-action="Historial" asp-route-pagina="@anterior"
               asp-route-material="@Model.FiltroMaterial"
               asp-route-q="@Model.Busqueda" asp-route-tipo="@Model.TipoMovimiento"
               asp-route-numeroOF="@Model.NumeroOF" asp-route-responsable="@Model.Responsable"
               asp-route-lote="@Model.Lote" asp-route-desde="@(Model.Desde?.ToString("yyyy-MM-dd"))"
               asp-route-hasta="@(Model.Hasta?.ToString("yyyy-MM-dd"))">Anterior</a>
            <span>Página <strong>@Model.Pagina</strong> de <strong>@Model.TotalPaginas</strong></span>
            <a class="alm-btn secondary small @(Model.Pagina >= Model.TotalPaginas ? "disabled" : "")"
               asp-action="Historial" asp-route-pagina="@siguiente"
               asp-route-material="@Model.FiltroMaterial"
               asp-route-q="@Model.Busqueda" asp-route-tipo="@Model.TipoMovimiento"
               asp-route-numeroOF="@Model.NumeroOF" asp-route-responsable="@Model.Responsable"
               asp-route-lote="@Model.Lote" asp-route-desde="@(Model.Desde?.ToString("yyyy-MM-dd"))"
               asp-route-hasta="@(Model.Hasta?.ToString("yyyy-MM-dd"))">Siguiente</a>
        </nav>
    }
</section>
