@using System.Globalization
@using ERP.NSQuell.Models.ViewModels.Almacen
@model ERP.NSQuell.Models.ViewModels.Almacen.AlmacenMPMovimientoFormVm
@{
    Layout = "~/Views/Shared/_Layout.cshtml";
    ViewData["Title"] = Model.EsEntregaOF ? "Entrega de MP a OF" : "Movimiento MP";

    var cantidadExacta = Model.Cantidad.ToString("0.###", CultureInfo.InvariantCulture);
    var cantidadVirgen = Model.CantidadVirgen.ToString("0.0000", CultureInfo.InvariantCulture);
    // NSQ_ALMACEN_MP_STEP_4_DECIMALES_V1
    var cantidadMolido = Model.CantidadMolido.ToString("0.0000", CultureInfo.InvariantCulture);
    var maximo = Model.CantidadPendienteOF.ToString("0.###", CultureInfo.InvariantCulture);

    var ordenes = ViewData["OrdenesFabricacion"]
        as System.Collections.Generic.IEnumerable<AlmacenSelectVm>
        ?? System.Linq.Enumerable.Empty<AlmacenSelectVm>();

    var materialSolicitadoID = Convert.ToInt32(ViewData["MaterialSolicitadoID"] ?? 0);
    var materialSolicitadoTexto = ViewData["MaterialSolicitadoTexto"]?.ToString()
        ?? "Material solicitado no encontrado";

    var stockPorMaterial = ViewData["StockPorMaterialMP"]
        as System.Collections.Generic.IReadOnlyDictionary<int, AlmacenMPStockSelectorVm>
        ?? new System.Collections.Generic.Dictionary<int, AlmacenMPStockSelectorVm>();

    stockPorMaterial.TryGetValue(Model.MaterialID, out var stockSeleccionado);
    var stockVInicial = stockSeleccionado?.StockV ?? 0m;
    var stockMInicial = stockSeleccionado?.StockM ?? 0m;

    // ALMACEN_MP_MOVIMIENTO_BUSQUEDA_V9_2
    var materialSeleccionado = Model.Materiales.FirstOrDefault(x => x.Id == Model.MaterialID);
    var materialSeleccionadoTexto = materialSeleccionado?.Texto ?? string.Empty;
}

@section Styles {
    <link rel="stylesheet" href="~/css/Almacen/almacen-navegacion.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/nsquell-erp-theme.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/Almacen/almacen.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/Almacen/almacen-vistas.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/Almacen/almacen-temas.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/AlmacenMP/movimiento.css" asp-append-version="true" />
}


@await Html.PartialAsync("_AlmacenNavegacion")

@await Html.PartialAsync("_AlmacenMensajes")


<section class="alm-hero mp-movement-hero">
    <div>
        <small>ALMACÉN MP</small>
        <h1>@(Model.EsEntregaOF ? "Entregar materia prima" : "Registrar movimiento")</h1>
        <p>
            @(Model.EsEntregaOF
                ? "La misma entrega puede descontar una parte de Virgen y otra de Molido. Uno de los dos puede quedar en 0.0000, pero no ambos."
                : "Los movimientos deben vincularse a una orden de fabricación, excepto Entrada Molido. Para Entrada Virgen también se exige folio de compra.")
        </p>
    </div>
</section>

<section class="alm-card mp-movement-card">
    <header>
        <span><i class="fa-solid fa-arrow-right-arrow-left"></i> Datos del movimiento</span>
        <span>Unidad fija: KG</span>
    </header>

    <form method="post" class="alm-form mp-movement-form" id="mpMovementForm">
        <div asp-validation-summary="ModelOnly" class="alm-field full"></div>

        <input asp-for="EsEntregaOF" type="hidden" />
        <input asp-for="OperacionToken" type="hidden" />
        <input asp-for="Unidad" type="hidden" value="KG" />

        @if (Model.EsEntregaOF)
        {
            <input asp-for="Lote" type="hidden" value="S/L" />
        }

        @if (Model.EsEntregaOF)
        {
            <input asp-for="SolicitudProduccionID" type="hidden" />
            <input asp-for="TipoMovimiento" type="hidden" />
            <input asp-for="NumeroOF" type="hidden" />
            <input asp-for="UbicacionID" type="hidden" />
            <input asp-for="TipoMP" type="hidden" value="V" />
            <input asp-for="Cantidad" type="hidden" value="0" />
            <input asp-for="CantidadPendienteOF" type="hidden" />
            <input type="hidden" name="materialSolicitadoId" value="@materialSolicitadoID" />

            <div class="mp-form-summary full">
                <div>
                    <small>MATERIAL SOLICITADO EN LA OF</small>
                    <strong>@materialSolicitadoTexto</strong>
                </div>
                <div>
                    <small>ORDEN DE FABRICACIÓN</small>
                    <strong>@Model.NumeroOF</strong>
                </div>
                <div>
                    <small>PENDIENTE ACTUAL</small>
                    <strong>@Model.CantidadPendienteOF.ToString("0.###") KG</strong>
                </div>
            </div>
        }

        <div class="alm-field full">
            <label for="MaterialSearch">@(Model.EsEntregaOF ? "Materia prima a entregar" : "Material MP")</label>

            <div class="alm-smart-search alm-smart-search--movement"
                 data-alm-smart-search
                 data-alm-smart-select-target="MaterialID">
                <input id="MaterialSearch"
                       class="alm-input"
                       type="search"
                       value="@materialSeleccionadoTexto"
                       placeholder="Busca por codigo o nombre de resina"
                       autocomplete="off"
                       data-alm-smart-input
                       required />

                <div class="alm-smart-search__menu" data-alm-smart-menu hidden>
                    @foreach (var item in Model.Materiales)
                    {
                        stockPorMaterial.TryGetValue(item.Id, out var stockItem);
                        var stockV = stockItem?.StockV ?? 0m;
                        var stockM = stockItem?.StockM ?? 0m;
                        var textoBusqueda = $"{item.Texto} Virgen {stockV:0.###} Molido {stockM:0.###}";

                        <button type="button"
                                class="alm-smart-search__option"
                                data-alm-smart-option
                                data-alm-smart-value="@item.Id"
                                data-alm-smart-display="@item.Texto"
                                data-alm-smart-text="@textoBusqueda">
                            <strong>@item.Texto</strong>
                            <span>Virgen: @stockV.ToString("0.###") KG</span>
                            <small>Molido: @stockM.ToString("0.###") KG</small>
                        </button>
                    }
                    <div class="alm-smart-search__empty" data-alm-smart-empty hidden>
                        No se encontraron resinas.
                    </div>
                </div>
            </div>

            <select asp-for="MaterialID"
                    class="alm-smart-native-select"
                    id="MaterialID"
                    tabindex="-1"
                    aria-hidden="true">
                <option value="">Selecciona un material</option>
                @foreach (var item in Model.Materiales)
                {
                    stockPorMaterial.TryGetValue(item.Id, out var stockItem);
                    var stockV = stockItem?.StockV ?? 0m;
                    var stockM = stockItem?.StockM ?? 0m;
                    <option value="@item.Id"
                            data-stock-v="@stockV.ToString("0.###", CultureInfo.InvariantCulture)"
                            data-stock-m="@stockM.ToString("0.###", CultureInfo.InvariantCulture)">
                        @item.Texto
                    </option>
                }
            </select>

            @if (Model.EsEntregaOF)
            {
                <small class="alm-filter-hint">
                    El material solicitado queda registrado. Se conserva la sustitucion cuando se seleccione otra resina.
                </small>
            }
            else
            {
                <small class="alm-filter-hint">Escribe codigo o nombre. Se muestran todas las resinas del catalogo.</small>
            }
            <span asp-validation-for="MaterialID"></span>
        </div>

        @if (Model.EsEntregaOF)
        {
            <div class="alm-field full">
                <label>Tipo de existencia y cantidad</label>

                <div class="mp-split-grid">
                    <div class="mp-split-row">
                        <div class="mp-split-row__head">
                            <strong>Virgen</strong>
                            <span class="mp-split-stock">Stock: <span id="stockDisponibleV">@stockVInicial.ToString("0.###") KG</span></span>
                        </div>
                        <div class="alm-unit-input">
                            <input asp-for="CantidadVirgen"
                                   class="alm-input"
                                   id="CantidadVirgen"
                                   type="number"
                                   value="@cantidadVirgen"
                                   min="0"
                                   max="@maximo"
                                   step="0.0001"
                                   inputmode="decimal" />
                            <span class="alm-unit-input__suffix">KG</span>
                        </div>
                        <span asp-validation-for="CantidadVirgen"></span>
                    </div>

                    <div class="mp-split-row">
                        <div class="mp-split-row__head">
                            <strong>Molido</strong>
                            <span class="mp-split-stock">Stock: <span id="stockDisponibleM">@stockMInicial.ToString("0.###") KG</span></span>
                        </div>
                        <div class="alm-unit-input">
                            <input asp-for="CantidadMolido"
                                   class="alm-input"
                                   id="CantidadMolido"
                                   type="number"
                                   value="@cantidadMolido"
                                   min="0"
                                   max="@maximo"
                                   step="0.0001"
                                   inputmode="decimal" />
                            <span class="alm-unit-input__suffix">KG</span>
                        </div>
                        <span asp-validation-for="CantidadMolido"></span>
                    </div>
                </div>

                <div class="mp-total-box" aria-live="polite">
                    <span>Total de la entrega</span>
                    <strong id="mpSplitTotal">0.0000 KG</strong>
                </div>
                <small class="alm-filter-hint">
                    Se permiten 0.0000 KG en Virgen o Molido, pero la suma debe ser mayor que cero y no puede exceder el pendiente de la OF.
                </small>
            </div>
        }
        else
        {
            <div class="alm-field">
                <label for="TipoMP">Tipo de existencia</label>
                <select asp-for="TipoMP" class="alm-select" id="TipoMP">
                    <option value="V">Virgen — Stock: @stockVInicial.ToString("0.###") KG</option>
                    <option value="M">Molido — Stock: @stockMInicial.ToString("0.###") KG</option>
                </select>
                <div class="mp-stock-selector-help" aria-live="polite">
                    <span>Virgen: <strong id="stockDisponibleV">@stockVInicial.ToString("0.###") KG</strong></span>
                    <span>Molido: <strong id="stockDisponibleM">@stockMInicial.ToString("0.###") KG</strong></span>
                </div>
                <span asp-validation-for="TipoMP"></span>
            </div>

            <div class="alm-field">
                <label for="TipoMovimiento">Tipo de movimiento</label>
                <select asp-for="TipoMovimiento" class="alm-select" id="TipoMovimiento">
                    @foreach (var item in Model.TiposMovimiento)
                    {
                        <option value="@item.Extra">@item.Texto</option>
                    }
                </select>
                <span asp-validation-for="TipoMovimiento"></span>
            </div>

            <div class="alm-field full">
                <label for="SolicitudProduccionID">Orden de fabricación</label>
                <select asp-for="SolicitudProduccionID" class="alm-select" id="SolicitudProduccionID">
                    <option value="">Selecciona una OF</option>
                    @foreach (var orden in ordenes)
                    {
                        <option value="@orden.Id">@orden.Texto</option>
                    }
                </select>
                <small class="alm-filter-hint mp-required-note" id="mpOfRequirementHelp">
                    Obligatorio excepto cuando el movimiento es Entrada de Molido.
                </small>
                <span asp-validation-for="SolicitudProduccionID"></span>
            </div>

            <!-- SCRAP_V15_MP_SCAN_UI -->
            <div class="alm-field full" id="LoteMolidoField">
                <label for="Lote">Lote / codigo de Scrap</label>
                <input asp-for="Lote"
                       class="alm-input"
                       id="Lote"
                       maxlength="500"
                       autocomplete="off"
                       placeholder="Escanea la etiqueta Scrap o captura el lote" />
                <small class="alm-filter-hint">
                    Se usa para Entrada de Molido. Si escaneas el codigo completo, el sistema extrae el lote y enlaza el movimiento con Scrap.
                </small>
                <span asp-validation-for="Lote"></span>
            </div>
            <div class="alm-field full" id="FolioCompraField">
                <label for="FolioCompra">Folio de compra</label>
                <input asp-for="FolioCompra"
                       class="alm-input"
                       id="FolioCompra"
                       maxlength="120"
                       placeholder="Folio de compra de la materia prima Virgen" />
                <small class="alm-filter-hint" id="FolioCompraHelp">
                    Obligatorio únicamente cuando el movimiento es Entrada y la existencia es Virgen.
                </small>
                <span asp-validation-for="FolioCompra"></span>
            </div>

            <div class="alm-field">
                <label for="Cantidad">Cantidad</label>
                <div class="alm-unit-input">
                    <input type="number"
                           class="alm-input"
                           id="Cantidad"
                           name="Cantidad"
                           value="@cantidadExacta"
                           required
                           min="0.001"
                           step="0.001"
                           inputmode="decimal"
                           placeholder="0.000" />
                    <span class="alm-unit-input__suffix">KG</span>
                </div>
                <span asp-validation-for="Cantidad"></span>
            </div>

            <div class="alm-field">
                <label for="UbicacionID">Ubicación</label>
                <select asp-for="UbicacionID" class="alm-select" id="UbicacionID">
                    <option value="">Sin ubicación</option>
                    @foreach (var item in Model.Ubicaciones)
                    {
                        <option value="@item.Id">@item.Texto</option>
                    }
                </select>
                <span asp-validation-for="UbicacionID"></span>
            </div>
        }

        <div class="alm-field full">
            <label for="Observaciones">Observaciones</label>
            <textarea asp-for="Observaciones"
                      class="alm-textarea"
                      id="Observaciones"
                      rows="4"
                      placeholder="@(Model.EsEntregaOF ? "Describe la entrega o el motivo de una sustitución" : "Describe el origen, destino o motivo del movimiento")"></textarea>
            <span asp-validation-for="Observaciones"></span>
        </div>

        <div class="mp-movement-help full">
            <span><i class="fa-solid fa-circle-plus"></i><strong>Entrada:</strong> suma existencia.</span>
            <span><i class="fa-solid fa-circle-minus"></i><strong>Salida o consumo:</strong> resta existencia.</span>
            <span><i class="fa-solid fa-scale-balanced"></i><strong>Ajuste:</strong> requiere explicar el motivo.</span>
        </div>

        <div class="alm-field full mp-form-submit">
            <button class="alm-btn" type="submit">
                <i class="fa-solid fa-floppy-disk"></i>
                @(Model.EsEntregaOF ? "Registrar entrega de MP" : "Guardar movimiento")
            </button>
        </div>
    </form>
</section>

@section Scripts {
    <script>
        (() => {
            const material = document.getElementById('MaterialID');
            const tipo = document.getElementById('TipoMP');
            const tipoMovimiento = document.getElementById('TipoMovimiento');
            const stockV = document.getElementById('stockDisponibleV');
            const stockM = document.getElementById('stockDisponibleM');
            const folioField = document.getElementById('FolioCompraField');
            const folio = document.getElementById('FolioCompra');
            const ofSelect = document.getElementById('SolicitudProduccionID');
            const ofHelp = document.getElementById('mpOfRequirementHelp');
            const cantidadV = document.getElementById('CantidadVirgen');
            const cantidadM = document.getElementById('CantidadMolido');
            const total = document.getElementById('mpSplitTotal');
            const pendiente = Number.parseFloat('@maximo' || '0');

            const number = value => {
                const parsed = Number.parseFloat(value || '0');
                return Number.isFinite(parsed) ? parsed : 0;
            };

            const formatStock = value =>
                `${number(value).toLocaleString('es-MX', { minimumFractionDigits: 3, maximumFractionDigits: 3 })} KG`;

            const formatFour = value =>
                `${number(value).toLocaleString('es-MX', { minimumFractionDigits: 4, maximumFractionDigits: 4 })} KG`;

            const updateStock = () => {
                if (!material) return;

                const option = material.options[material.selectedIndex];
                const valueV = option?.dataset.stockV || '0';
                const valueM = option?.dataset.stockM || '0';

                if (stockV) stockV.textContent = formatStock(valueV);
                if (stockM) stockM.textContent = formatStock(valueM);

                if (tipo) {
                    const optionV = tipo.querySelector('option[value="V"]');
                    const optionM = tipo.querySelector('option[value="M"]');
                    if (optionV) optionV.textContent = `Virgen — Stock: ${formatStock(valueV)}`;
                    if (optionM) optionM.textContent = `Molido — Stock: ${formatStock(valueM)}`;
                }

                if (cantidadV) {
                    cantidadV.max = String(Math.max(0, Math.min(number(valueV), pendiente)));
                }

                if (cantidadM) {
                    cantidadM.max = String(Math.max(0, Math.min(number(valueM), pendiente)));
                }
            };

            const updateFolio = () => {
                if (!folioField || !folio) return;

                const requires =
                    tipoMovimiento?.value === 'Entrada'
                    && tipo?.value === 'V';

                folioField.hidden = !requires;
                folio.required = requires;
                folio.setAttribute('aria-required', requires ? 'true' : 'false');
            };

            const updateOFRequirement = () => {
                if (!ofSelect) return;

                const libre =
                    tipoMovimiento?.value === 'Entrada'
                    && tipo?.value === 'M';

                ofSelect.required = !libre;
                ofSelect.setAttribute('aria-required', libre ? 'false' : 'true');

                if (ofHelp) {
                    ofHelp.textContent = libre
                        ? 'Opcional para Entrada de Molido. Si eliges una OF, el movimiento quedará vinculado.'
                        : 'Obligatorio. Selecciona una OF existente para este movimiento.';
                }
            };
            const updateTotal = () => {
                if (!total) return;
                total.textContent = formatFour(number(cantidadV?.value) + number(cantidadM?.value));
            };

            material?.addEventListener('change', updateStock);
            tipo?.addEventListener('change', updateFolio);
            tipo?.addEventListener('change', updateOFRequirement);
            tipoMovimiento?.addEventListener('change', updateFolio);
            tipoMovimiento?.addEventListener('change', updateOFRequirement);
            cantidadV?.addEventListener('input', updateTotal);
            cantidadM?.addEventListener('input', updateTotal);

            updateStock();
            updateFolio();
            updateOFRequirement();
            updateTotal();
        })();
    </script>
    <script src="~/js/Almacen/almacen-vistas.js" asp-append-version="true"></script>
}
