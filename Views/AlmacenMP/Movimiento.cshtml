@using System.Globalization
@using ERP.NSQuell.Models.ViewModels.Almacen
@model ERP.NSQuell.Models.ViewModels.Almacen.AlmacenMPMovimientoFormVm
@{
    Layout = "~/Views/Shared/_AlmacenLayout.cshtml";
    ViewData["Title"] = Model.EsEntregaOF ? "Entrega de MP a OF" : "Movimiento MP";

    var cantidadExacta = Model.Cantidad.ToString("0.###", CultureInfo.InvariantCulture);
    var maximo = Model.CantidadPendienteOF.ToString("0.###", CultureInfo.InvariantCulture); var ordenes =
    ViewData["OrdenesFabricacionMP"] as System.Collections.Generic.IEnumerable<string>
            ?? System.Linq.Enumerable.Empty<string>();
    var materialSolicitadoID = Convert.ToInt32(ViewData["MaterialSolicitadoID"] ?? 0);
    var materialSolicitadoTexto = ViewData["MaterialSolicitadoTexto"]?.ToString()
        ?? "Material solicitado no encontrado";
    var stockPorMaterial = ViewData["StockPorMaterialMP"]
        as System.Collections.Generic.IReadOnlyDictionary<int, AlmacenMPStockSelectorVm>
        ?? new System.Collections.Generic.Dictionary<int, AlmacenMPStockSelectorVm>();

    stockPorMaterial.TryGetValue(Model.MaterialID, out var stockSeleccionado);
    var stockVInicial = stockSeleccionado?.StockV ?? 0m;
    var stockMInicial = stockSeleccionado?.StockM ?? 0m;
}

<section class="alm-hero mp-movement-hero">
    <div>
        <small>ALMACÉN MP</small>
        <h1>@(Model.EsEntregaOF ? "Entregar materia prima" : "Registrar movimiento")</h1>
        <p>
            Selecciona la resina, consulta el stock V y M disponible e indica de cuál existencia se descontará la
            cantidad.
        </p>
    </div>
</section>

<section class="alm-card mp-movement-card">
    <header>
        <span><i class="fa-solid fa-arrow-right-arrow-left"></i> Datos del movimiento</span>
        <span>Unidad fija: KG</span>
    </header>

    <form method="post" class="alm-form mp-movement-form">
        <div asp-validation-summary="ModelOnly" class="alm-field full"></div>

        <input asp-for="EsEntregaOF" type="hidden" />
        <input asp-for="SolicitudProduccionID" type="hidden" />
        <input asp-for="OperacionToken" type="hidden" />
        <input type="hidden" id="CantidadPendienteOF" name="CantidadPendienteOF" value="@maximo" />
        <input asp-for="Unidad" type="hidden" value="KG" />
        <input asp-for="Lote" type="hidden" value="S/L" />

        @if (Model.EsEntregaOF)
        {
            <input asp-for="TipoMovimiento" type="hidden" />
            <input asp-for="NumeroOF" type="hidden" />
            <input asp-for="UbicacionID" type="hidden" />
            <input type="hidden" name="materialSolicitadoId" value="@materialSolicitadoID" />

            <div class="mp-form-summary full">
                <div>
                    <small>MATERIAL SOLICITADO EN LA OF</small>
                    <strong>@materialSolicitadoTexto</strong>
                </div>
                <div>
                    <small>ORDEN DE FABRICACIÓN</small>
                    <strong>@Model.NumeroOF</strong>
                </div>
                <div>
                    <small>PENDIENTE ACTUAL</small>
                    <strong>@Model.CantidadPendienteOF.ToString("0.###") KG</strong>
                </div>
            </div>
        }

        <div class="alm-field full">
            <label for="MaterialID">@(Model.EsEntregaOF ? "Materia prima a entregar" : "Material MP")</label>
            <select asp-for="MaterialID" class="alm-select" id="MaterialID" required>
                <option value="">Selecciona un material</option>
                @foreach (var item in Model.Materiales)
                {
                    stockPorMaterial.TryGetValue(item.Id, out var stockItem);
                    var stockV = stockItem?.StockV ?? 0m;
                    var stockM = stockItem?.StockM ?? 0m;
                    <option value="@item.Id" data-stock-v="@stockV.ToString("0.###", CultureInfo.InvariantCulture)"
                            data-stock-m="@stockM.ToString("0.###", CultureInfo.InvariantCulture)">
                        @item.Texto
                    </option>
                }
            </select>
            @if (Model.EsEntregaOF)
            {
                <small class="alm-filter-hint">
                    El material solicitado queda registrado. Puedes seleccionar otra resina cuando sea necesario para no
                    detener producción.
                </small>
            }
            else
            {
                <small class="alm-filter-hint">No se muestran cajas, bolsas ni embalajes.</small>
            }
            <span asp-validation-for="MaterialID"></span>
        </div>

        <div class="alm-field">
            <label for="TipoMP">Tipo de existencia</label>
            <select asp-for="TipoMP" class="alm-select" id="TipoMP">
                <option value="V">V — Stock: @stockVInicial.ToString("0.###") KG</option>
                <option value="M">M — Stock: @stockMInicial.ToString("0.###") KG</option>
            </select>
            <div class="mp-stock-selector-help" aria-live="polite">
                <span>V: <strong id="stockDisponibleV">@stockVInicial.ToString("0.###") KG</strong></span>
                <span>M: <strong id="stockDisponibleM">@stockMInicial.ToString("0.###") KG</strong></span>
            </div>
            <small class="alm-filter-hint">Selecciona la existencia de la que se descontarán los kilogramos.</small>
            <span asp-validation-for="TipoMP"></span>
        </div>

        @if (!Model.EsEntregaOF)
        {
            <div class="alm-field">
                <label for="TipoMovimiento">Tipo de movimiento</label>
                <select asp-for="TipoMovimiento" class="alm-select" id="TipoMovimiento">
                    @foreach (var item in Model.TiposMovimiento)
                    {
                        <option value="@item.Extra">@item.Texto</option>
                    }
                </select>
                <span asp-validation-for="TipoMovimiento"></span>
            </div>

            <div class="alm-field full">
                <label for="NumeroOF">Orden de fabricación</label>
                <select asp-for="NumeroOF" class="alm-select" id="NumeroOF">
                    <option value="">Sin OF / movimiento general</option>
                    @if (!string.IsNullOrWhiteSpace(Model.NumeroOF) && !ordenes.Contains(Model.NumeroOF))
                    {
                        <option value="@Model.NumeroOF">@Model.NumeroOF</option>
                    }
                    @foreach (var orden in ordenes)
                    {
                        <option value="@orden">@orden</option>
                    }
                </select>
                <small class="alm-filter-hint">Selecciona una OF existente cuando el movimiento corresponda a
                    producción.</small>
                </div>
            }

            <div class="alm-field">
                <label for="Cantidad">Cantidad</label>
                <div class="alm-unit-input">
                    <input type="number" class="alm-input" id="Cantidad" name="Cantidad" value="@cantidadExacta" required
                           min="0.001" max="@(Model.EsEntregaOF ? maximo : null)" step="0.001" inputmode="decimal"
                           placeholder="0.000" />
                    <span class="alm-unit-input__suffix">KG</span>
                </div>
                <span asp-validation-for="Cantidad"></span>
            </div>

            @if (!Model.EsEntregaOF)
            {
                <div class="alm-field">
                    <label for="UbicacionID">Ubicación</label>
                    <select asp-for="UbicacionID" class="alm-select" id="UbicacionID">
                        <option value="">Sin ubicación</option>
                        @foreach (var item in Model.Ubicaciones)
                        {
                            <option value="@item.Id">@item.Texto</option>
                        }
                    </select>
                    <span asp-validation-for="UbicacionID"></span>
                </div>
            }

            <div class="alm-field full">
                <label for="Observaciones">Observaciones</label>
                <textarea asp-for="Observaciones" class="alm-textarea" id="Observaciones" rows="4"
                          placeholder="@(Model.EsEntregaOF ? "Indica el motivo cuando se entregue una resina diferente a la solicitada" : "Describe el motivo, procedencia o destino del movimiento")"></textarea>
                <span asp-validation-for="Observaciones"></span>
            </div>

            <div class="mp-movement-help full">
                <span><i class="fa-solid fa-circle-plus"></i><strong>Entrada:</strong> suma existencia.</span>
                <span><i class="fa-solid fa-circle-minus"></i><strong>Salida o consumo:</strong> resta existencia.</span>
                <span><i class="fa-solid fa-scale-balanced"></i><strong>Ajuste:</strong> requiere explicar el motivo.</span>
            </div>

            <div class="alm-field full mp-form-submit">
                <button class="alm-btn" type="submit">
                    <i class="fa-solid fa-floppy-disk"></i>
                    @(Model.EsEntregaOF ? "Registrar entrega de MP" : "Guardar movimiento")
                </button>
            </div>
        </form>
    </section>

    @section Scripts {
        <script>
            (() => {
                const material = document.getElementById('MaterialID');
                const tipo = document.getElementById('TipoMP');
                const stockV = document.getElementById('stockDisponibleV');
                const stockM = document.getElementById('stockDisponibleM');

                if (!material || !tipo || !stockV || !stockM) return;

                const format = value => {
                    const number = Number.parseFloat(value || '0');
                    return `${Number.isFinite(number) ? number.toLocaleString('es-MX', { maximumFractionDigits: 3 }) : '0'} KG`;
                };

                const update = () => {
                    const option = material.options[material.selectedIndex];
                    const valueV = option?.dataset.stockV || '0';
                    const valueM = option?.dataset.stockM || '0';

                    stockV.textContent = format(valueV);
                    stockM.textContent = format(valueM);

                    const optionV = tipo.querySelector('option[value="V"]');
                    const optionM = tipo.querySelector('option[value="M"]');
                    if (optionV) optionV.textContent = `V — Stock: ${format(valueV)}`;
                    if (optionM) optionM.textContent = `M — Stock: ${format(valueM)}`;
                };

                material.addEventListener('change', update);
                update();
            })();
        </script>
    }
