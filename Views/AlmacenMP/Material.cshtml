@model ERP.NSQuell.Models.ViewModels.Almacen.AlmacenMaterialFormVm
@{ Layout = "~/Views/Shared/_AlmacenLayout.cshtml"; ViewData["Title"] = Model.MaterialID.HasValue ? "Editar material" : "Nuevo material"; }
<section class="alm-hero"><div><small>ERP_MATERIALES</small><h1>@ViewData["Title"]</h1><p>El nivel mínimo activa rojo; el nivel de aviso activa amarillo; arriba del aviso se muestra verde.</p></div><a class="alm-btn secondary" asp-action="Materiales">Volver</a></section><section class="alm-card"><form method="post" class="alm-form"><input asp-for="MaterialID" type="hidden"/><div asp-validation-summary="ModelOnly" class="alm-field full"></div><div class="alm-field"><label asp-for="Codigo"></label><input asp-for="Codigo" class="alm-input"/><span asp-validation-for="Codigo"></span></div><div class="alm-field"><label asp-for="Nombre"></label><input asp-for="Nombre" class="alm-input"/></div><div class="alm-field"><label asp-for="TipoMaterial"></label><input asp-for="TipoMaterial" class="alm-input" placeholder="MP, PIGMENTO, EMBALAJE..."/></div><div class="alm-field"><label asp-for="UnidadDefault"></label><input asp-for="UnidadDefault" class="alm-input"/></div><div class="alm-field"><label asp-for="Proveedor"></label><input asp-for="Proveedor" class="alm-input"/></div><div class="alm-field"><label><input asp-for="RequiereLote"/> Requiere lote</label></div><div class="alm-field"><label asp-for="StockMinimo"></label><input asp-for="StockMinimo" class="alm-input"/></div><div class="alm-field"><label asp-for="StockAviso"></label><input asp-for="StockAviso" class="alm-input"/></div><div class="alm-field"><label><input asp-for="Activo"/> Activo</label></div><div class="alm-field full"><button class="alm-btn">Guardar material</button></div></form></section>
