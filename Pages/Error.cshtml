@page
@model ERP.NSQuell.Pages.ErrorModel
@{
    Layout = null;
}
<!doctype html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Error - NSQuell ERP</title>
    <style>
        :root {
            color-scheme: light dark;
            font-family: "Segoe UI", Arial, sans-serif;
        }

        body {
            margin: 0;
            min-height: 100vh;
            display: grid;
            place-items: center;
            background: #f4f7fb;
            color: #172033;
        }

        .error-card {
            width: min(560px, calc(100% - 40px));
            box-sizing: border-box;
            padding: 32px;
            border: 1px solid #dce4ef;
            border-radius: 16px;
            background: #fff;
            box-shadow: 0 12px 32px rgba(15, 39, 71, .10);
        }

        h1 {
            margin: 0 0 12px;
            font-size: 28px;
            color: #003b82;
        }

        p {
            margin: 0 0 22px;
            line-height: 1.55;
        }

        .request {
            margin: -8px 0 22px;
            font-size: 12px;
            color: #667085;
            word-break: break-all;
        }

        a {
            display: inline-block;
            padding: 10px 16px;
            border-radius: 9px;
            background: #003b82;
            color: #fff;
            text-decoration: none;
            font-weight: 600;
        }

        @@media (prefers-color-scheme: dark) {
            body {
                background: #111827;
                color: #e5e7eb;
            }

            .error-card {
                background: #182233;
                border-color: #314057;
            }

            h1 {
                color: #8bbcff;
            }

            .request {
                color: #a8b3c4;
            }
        }
    </style>
</head>
<body>
    <main class="error-card">
        <h1>No fue posible completar la solicitud</h1>
        <p>Ocurrió un error inesperado. Puedes volver al inicio e intentar nuevamente.</p>

        @if (Model.ShowRequestId)
        {
            <div class="request">
                Referencia: @Model.RequestId
            </div>
        }

        <a href="/Login/Login">Volver al inicio</a>
    </main>
</body>
</html>
